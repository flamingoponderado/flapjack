elab "#fullProofClosureAudit" : command => do
  let env ← getEnv
  let started ← IO.monoMsNow
  let tags := Flapjack.HolRef.all env
  let mut missing : Nat := 0
  for name in expectedPins do
    if (Flapjack.HolRef.get? env name).isNone then
      missing := missing + 1
      logInfo m!"MISSING_PINNED_TAG {name}"
  for name in expectedCandidate do
    unless (Flapjack.HolRef.get? env name).isSome do
      throwError "Candidate tagged declaration not imported: {name}"
  logInfo m!"CANDIDATE_TAG_COVERAGE {expectedCandidate.size}/{expectedCandidate.size}; PINNED_TAG_COVERAGE {expectedPins.size - missing}/{expectedPins.size}; ACTUAL_TAGGED_ROOTS {tags.size}"
  if missing > 0 then throwError "Import coverage incomplete"
  let bad := [`Flapjack.holEl, `Flapjack.holHdNil, `Flapjack.holHd]
  -- Build the full reverse graph of actual imported constants. No namespace
  -- restriction: theorem/opaque values and private/generated nodes are included.
  let mut reverse : Std.HashMap Name (List Name) := {}
  let mut constantCount : Nat := 0
  let mut edgeCount : Nat := 0
  for (parent, info) in env.constants.toList do
    constantCount := constantCount + 1
    let edges := info.type.getUsedConstants ++
      (match info.value? (allowOpaque := true) with | some value => value.getUsedConstants | none => #[])
    for child in edges do
      edgeCount := edgeCount + 1
      reverse := reverse.insert child (parent :: (reverse[child]?).getD [])
  let graphFinished ← IO.monoMsNow
  liftIO <| IO.println s!"PROFILE graph_ms={graphFinished - started}; nodes={constantCount}; edges={edgeCount}"
  -- Monotone fixed point; no provisional false cache, so cycles cannot hide hits.
  let mut paths : Std.HashMap Name (List Name) := {}
  let mut todo : List Name := []
  for name in bad do
    paths := paths.insert name [name]
    todo := name :: todo
  while !todo.isEmpty do
    let child := todo.head!
    todo := todo.tail!
    for parent in (reverse[child]?).getD [] do
      unless paths.contains parent do
        paths := paths.insert parent (parent :: paths[child]!)
        todo := parent :: todo
  let mut taggedHits : Nat := 0
  for (name, _) in tags do
    if let some path := paths[name]? then
      taggedHits := taggedHits + 1
      logInfo m!"TAGGED_FORBIDDEN_PATH {name}: {path}"
  logInfo m!"ALL_NAMESPACE_CONSTANTS {constantCount}; PROOF_AND_TYPE_EDGES {edgeCount}; FORBIDDEN_CLOSURES {paths.size}; TAGGED_FORBIDDEN_CLOSURES {taggedHits}"
  for (name, path) in paths do
    logInfo m!"DEPENDENCY tagged={(Flapjack.HolRef.get? env name).isSome} {name}: {path}"
  if taggedHits > 0 then throwError "Tagged proof/opaque closure contains provisional EL/HD"
#fullProofClosureAudit
