term_typed=Term::num option -> term list -> term; Litv::lit -> term; RefPtr::num -> term; Other::term
dt_test_def_typed=dt_test (TagLenEq (t :num) (l :num)) (Term (SOME (c :num)) (args :term list)) = SOME (t = c ∧ l = LENGTH args) ∧ dt_test (LitEq (l1 :lit)) (Litv (l2 :lit) :term) = (if lit_same_type l1 l2 then SOME (l1 = l2) else (NONE :bool option)) ∧ dt_test (TagLenEq (v11 :num) (v12 :num)) (Term (NONE :num option) (v4 :term list)) = (NONE :bool option) ∧ dt_test (LitEq (v13 :lit)) (Term (v3 :num option) v4) = (NONE :bool option) ∧ dt_test (TagLenEq (v19 :num) (v20 :num)) (Litv (v5 :lit) :term) = (NONE :bool option) ∧ dt_test (v0 :dTest) (RefPtr (v6 :num)) = (NONE :bool option) ∧ dt_test v0 Other = (NONE :bool option)
<<HOL warning: Type.mk_type: more than one possibility>>
pat_typed=Any::pat; Cons::(num # (num # num) list option) option -> pat list -> pat; Or::pat -> pat -> pat; Lit::lit -> pat; Ref::pat -> pat
dTest_typed=TagLenEq::num -> num -> dTest; LitEq::lit -> dTest
dGuard_typed=PosTest::position -> dTest -> dGuard; Not::dGuard -> dGuard; Conj::dGuard -> dGuard -> dGuard; Disj::dGuard -> dGuard -> dGuard; True::dGuard
dTree_typed=Leaf::num -> dTree; Fail::dTree; TypeFail::dTree; If::dGuard -> dTree -> dTree -> dTree
is_sibling_def_typed=(∀(x :α). is_sibling x (NONE :α list option) ⇔ T) ∧ ∀(x :α) (l :α list). is_sibling x (SOME l) ⇔ MEM x l
pmatch_def_typed=(∀(t :term) (refs :num |-> term). (pmatch refs Any t :pmatchResult) = PMatchSuccess) ∧ (∀(refs :num |-> term) (l' :lit) (l :lit). (pmatch refs (Lit l :pat) (Litv l' :term) :pmatchResult) = if ¬lit_same_type l l' then PTypeFailure else if l = l' then PMatchSuccess else PMatchFailure) ∧ (∀(targs :term list) (tag :num) (t :num) (siblings :(num # num) list option) (refs :num |-> term) (pargs :pat list). (pmatch refs (Cons (SOME (tag,siblings)) pargs) (Term (SOME t) targs) :pmatchResult) = if tag = t ∧ LENGTH pargs = LENGTH targs then (pmatch_list refs pargs targs :pmatchResult) else if is_sibling (t,LENGTH targs) siblings then PMatchFailure else PTypeFailure) ∧ (∀(targs :term list) (refs :num |-> term) (pargs :pat list). (pmatch refs (Cons (NONE :(num # (num # num) list option) option) pargs) (Term (NONE :num option) targs) :pmatchResult) = (pmatch_list refs pargs targs :pmatchResult)) ∧ (∀(refs :num |-> term) (r :num) (p :pat). (pmatch refs (Ref p) (RefPtr r) :pmatchResult) = case FLOOKUP refs r of (NONE :term option) => PTypeFailure | SOME v => (pmatch refs p v :pmatchResult)) ∧ (∀(t :term) (refs :num |-> term) (p2 :pat) (p1 :pat). (pmatch refs (Or p1 p2 :pat) t :pmatchResult) = case (pmatch refs p1 t :pmatchResult) of PMatchSuccess => (case (pmatch refs p2 t :pmatchResult) of PMatchSuccess => PMatchSuccess | PMatchFailure => PMatchSuccess | PTypeFailure => PTypeFailure) | PMatchFailure => (pmatch refs p2 t :pmatchResult) | PTypeFailure => PTypeFailure) ∧ (∀(v9 :pat list) (v30 :num # (num # num) list option) (v21 :term list) (refs :num |-> term). (pmatch refs (Cons (SOME v30) v9) (Term (NONE :num option) v21) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v28 :num) (v21 :term list) (refs :num |-> term). (pmatch refs (Cons (NONE :(num # (num # num) list option) option) v9) (Term (SOME v28) v21) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (v22 :lit) (refs :num |-> term). (pmatch refs (Cons v8 v9) (Litv v22 :term) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (v23 :num) (refs :num |-> term). (pmatch refs (Cons v8 v9) (RefPtr v23) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (refs :num |-> term). (pmatch refs (Cons v8 v9) Other :pmatchResult) = PTypeFailure) ∧ (∀(v39 :term list) (v38 :num option) (v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) (Term v38 v39) :pmatchResult) = PTypeFailure) ∧ (∀(v41 :num) (v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) (RefPtr v41) :pmatchResult) = PTypeFailure) ∧ (∀(v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) Other :pmatchResult) = PTypeFailure) ∧ (∀(v47 :term list) (v46 :num option) (v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) (Term v46 v47) :pmatchResult) = PTypeFailure) ∧ (∀(v48 :lit) (v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) (Litv v48 :term) :pmatchResult) = PTypeFailure) ∧ (∀(v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) Other :pmatchResult) = PTypeFailure) ∧ (∀(refs :num |-> term). (pmatch_list refs ([] :pat list) ([] :term list) :pmatchResult) = PMatchSuccess) ∧ (∀(v63 :term list) (v62 :term) (refs :num |-> term). (pmatch_list refs ([] :pat list) (v62::v63) :pmatchResult) = PTypeFailure) ∧ (∀(v59 :pat list) (v58 :pat) (refs :num |-> term). (pmatch_list refs (v58::v59) ([] :term list) :pmatchResult) = PTypeFailure) ∧ ∀(ts :term list) (t :term) (refs :num |-> term) (ps :pat list) (p :pat). (pmatch_list refs (p::ps) (t::ts) :pmatchResult) = case (pmatch refs p t :pmatchResult) of PMatchSuccess => (pmatch_list refs ps ts :pmatchResult) | PMatchFailure => (case (pmatch_list refs ps ts :pmatchResult) of PMatchSuccess => PMatchFailure | PMatchFailure => PMatchFailure | PTypeFailure => PTypeFailure) | PTypeFailure => PTypeFailure
match_def_typed=(∀(v :term) (refs :num |-> term). match refs ([] :(pat # num) list) v = SOME MatchFailure) ∧ ∀(v :term) (rows :(pat # num) list) (refs :num |-> term) (p :pat) (e :num). match refs ((p,e)::rows) v = case (pmatch refs p v :pmatchResult) of PMatchSuccess => (case match refs rows v of (NONE :matchResult option) => (NONE :matchResult option) | SOME v' => SOME (MatchSuccess e)) | PMatchFailure => match refs rows v | PTypeFailure => (NONE :matchResult option)
app_pos_def_typed=(∀(v :term) (refs :num |-> term). app_pos refs EmptyPos v = SOME v) ∧ (∀(refs :num |-> term) (r :num) (pos :position). app_pos refs (Pos (0 :num) pos) (RefPtr r) = case FLOOKUP refs r of (NONE :term option) => (NONE :term option) | SOME v => app_pos refs pos v) ∧ (∀(xs :term list) (x :term) (refs :num |-> term) (pos :position) (c :num option). app_pos refs (Pos (0 :num) pos) (Term c (x::xs)) = app_pos refs pos x) ∧ (∀(xs :term list) (x :term) (refs :num |-> term) (pos :position) (n :num) (c :num option). app_pos refs (Pos (SUC n) pos) (Term c (x::xs)) = app_pos refs (Pos n pos) (Term c xs)) ∧ (∀(v11 :num option) (v1 :position) (refs :num |-> term). app_pos refs (Pos (0 :num) v1) (Term v11 ([] :term list)) = (NONE :term option)) ∧ (∀(v13 :lit) (v1 :position) (refs :num |-> term). app_pos refs (Pos (0 :num) v1) (Litv v13 :term) = (NONE :term option)) ∧ (∀(v1 :position) (refs :num |-> term). app_pos refs (Pos (0 :num) v1) Other = (NONE :term option)) ∧ (∀(v9 :num) (v23 :num option) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) (Term v23 ([] :term list)) = (NONE :term option)) ∧ (∀(v9 :num) (v25 :lit) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) (Litv v25 :term) = (NONE :term option)) ∧ (∀(v9 :num) (v26 :num) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) (RefPtr v26) = (NONE :term option)) ∧ ∀(v9 :num) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) Other = (NONE :term option)
dt_eval_guard_def_typed=(∀(refs :num |-> term) (v :term). dt_eval_guard refs v True = SOME T) ∧ (∀(refs :num |-> term) (v :term) (pos :position) (test :dTest). dt_eval_guard refs v (PosTest pos test) = case app_pos refs pos v of (NONE :term option) => (NONE :bool option) | SOME x => dt_test test x) ∧ (∀(refs :num |-> term) (v :term) (g :dGuard). dt_eval_guard refs v (Not g :dGuard) = case dt_eval_guard refs v g of (NONE :bool option) => (NONE :bool option) | SOME b => SOME (¬b)) ∧ (∀(refs :num |-> term) (v :term) (g1 :dGuard) (g2 :dGuard). dt_eval_guard refs v (Conj g1 g2) = case dt_eval_guard refs v g1 of (NONE :bool option) => (NONE :bool option) | SOME T => dt_eval_guard refs v g2 | SOME F => SOME F) ∧ ∀(refs :num |-> term) (v :term) (g1 :dGuard) (g2 :dGuard). dt_eval_guard refs v (Disj g1 g2) = case dt_eval_guard refs v g1 of (NONE :bool option) => (NONE :bool option) | SOME T => SOME T | SOME F => dt_eval_guard refs v g2
dt_eval_def_typed=(∀(v0 :term) (refs :num |-> term) (k :num). dt_eval refs v0 (Leaf k) = SOME (MatchSuccess k)) ∧ (∀(v1 :term) (refs :num |-> term). dt_eval refs v1 Fail = SOME MatchFailure) ∧ (∀(v2 :term) (refs :num |-> term). dt_eval refs v2 TypeFail = (NONE :matchResult option)) ∧ ∀(v :term) (refs :num |-> term) (guard :dGuard) (dt2 :dTree) (dt1 :dTree). dt_eval refs v (If guard dt1 dt2) = case dt_eval_guard refs v guard of (NONE :bool option) => (NONE :matchResult option) | SOME b => dt_eval refs v (if b then dt1 else dt2)
