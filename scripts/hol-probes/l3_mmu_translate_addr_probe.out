translateAddr_full_definition=∀vAddr ft ac. translateAddr (vAddr,ft,ac) = (λstate. (let v = privilege (if (MCSR state).mstatus.MMPRV ∧ ft = Data then (MCSR state).mstatus.MPRV1 else (MCSR state).mstatus.MPRV); (v0,s) = (let (v0,s) = vmType (MCSR state).mstatus.VM state in ((v0,v),s)) in case v0 of (Mbare,v2) => (SOME vAddr,s) | (Mbb,User) => (NONE,s) | (Mbb,Supervisor) => (NONE,s) | (Mbb,Hypervisor) => (NONE,s) | (Mbb,Machine) => (SOME vAddr,s) | (Mbbid,User) => (NONE,s) | (Mbbid,Supervisor) => (NONE,s) | (Mbbid,Hypervisor) => (NONE,s) | (Mbbid,Machine) => (SOME vAddr,s) | (Sv32,User) => (NONE,s) | (Sv32,Supervisor) => (NONE,s) | (Sv32,Hypervisor) => (NONE,s) | (Sv32,Machine) => (SOME vAddr,s) | (Sv39,User) => translate64 (vAddr,ft,ac,v,2) s | (Sv39,Supervisor) => translate64 (vAddr,ft,ac,v,2) s | (Sv39,Hypervisor) => translate64 (vAddr,ft,ac,v,2) s | (Sv39,Machine) => (SOME vAddr,s) | (Sv48,User) => translate64 (vAddr,ft,ac,v,3) s | (Sv48,Supervisor) => translate64 (vAddr,ft,ac,v,3) s | (Sv48,Hypervisor) => translate64 (vAddr,ft,ac,v,3) s | (Sv48,Machine) => (SOME vAddr,s) | (Sv57,User) => (NONE,s) | (Sv57,Supervisor) => (NONE,s) | (Sv57,Hypervisor) => (NONE,s) | (Sv57,Machine) => (SOME vAddr,s) | (Sv64,User) => (NONE,s) | (Sv64,Supervisor) => (NONE,s) | (Sv64,Hypervisor) => (NONE,s) | (Sv64,Machine) => (SOME vAddr,s)))
translateAddr_full_type=:word64 # fetchType # accessType -> riscv_state -> word64 option # riscv_state
