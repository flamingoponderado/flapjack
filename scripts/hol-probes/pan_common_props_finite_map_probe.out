ctxt_max_def_typed=∀(n :num) (fm :α |-> β # num list).
  ctxt_max n fm ⇔
  (0 :num) ≤ n ∧
  ∀(v :α) (a :β) (xs :num list).
    FLOOKUP fm v = SOME (a,xs) ⇒ ∀(x :num). MEM x xs ⇒ x ≤ n
ctxt_max_def_hypotheses=0
no_overlap_def_typed=∀(fm :α |-> β # γ list).
  no_overlap fm ⇔
  (∀(x :α) (a :β) (xs :γ list). FLOOKUP fm x = SOME (a,xs) ⇒ ALL_DISTINCT xs) ∧
  ∀(x :α) (y :α) (a :β) (b :β) (xs :γ list) (ys :γ list).
    FLOOKUP fm x = SOME (a,xs) ∧ FLOOKUP fm y = SOME (b,ys) ∧
    ¬DISJOINT (set xs) (set ys) ⇒
    x = y
no_overlap_def_hypotheses=0
update_eq_zip_flookup_typed=∀(xs :α list) (f :α |-> β) (ys :β list) (n :num).
  ALL_DISTINCT xs ∧ LENGTH xs = LENGTH ys ∧ n < LENGTH xs ⇒
  FLOOKUP (f |++ ZIP (xs,ys)) xs❲n❳ = SOME ys❲n❳
update_eq_zip_flookup_hypotheses=0
opt_mmap_some_eq_zip_flookup_typed=∀(xs :α list) (f :α |-> β) (ys :β list).
  ALL_DISTINCT xs ∧ LENGTH xs = LENGTH ys ⇒
  OPT_MMAP (FLOOKUP (f |++ ZIP (xs,ys))) xs = SOME ys
opt_mmap_some_eq_zip_flookup_hypotheses=0
opt_mmap_disj_zip_flookup_typed=∀(xs :α list) (f :α |-> β) (ys :α list) (zs :β list).
  distinct_lists xs ys ∧ LENGTH xs = LENGTH zs ⇒
  OPT_MMAP (FLOOKUP (f |++ ZIP (xs,zs))) ys = OPT_MMAP (FLOOKUP f) ys
opt_mmap_disj_zip_flookup_hypotheses=0
fm_empty_zip_alist_typed=∀(xs :α list) (ys :β list).
  LENGTH xs = LENGTH ys ∧ ALL_DISTINCT xs ⇒
  (FEMPTY :α |-> β) |++ ZIP (xs,ys) = alist_to_fmap (ZIP (xs,ys))
fm_empty_zip_alist_hypotheses=0
fm_empty_zip_flookup_typed=∀(xs :α list) (ys :β list) (x :α) (y :β).
  LENGTH xs = LENGTH ys ∧ ALL_DISTINCT xs ∧
  FLOOKUP ((FEMPTY :α |-> β) |++ ZIP (xs,ys)) x = SOME y ⇒
  ∃(n :num). n < LENGTH xs ∧ (ZIP (xs,ys))❲n❳ = (x,y)
fm_empty_zip_flookup_hypotheses=0
