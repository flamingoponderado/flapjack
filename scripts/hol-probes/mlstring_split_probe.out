splitl_aux_def_typed=∀(s :mlstring) (i :num) (P :char -> bool). splitl_aux P s i = if i < strlen s ∧ P (strsub s i) then splitl_aux P s (i + (1 :num)) else (extract s (0 :num) (SOME i),extract s i (NONE :num option))
splitl_def_typed=∀(P :char -> bool) (s :mlstring). splitl P s = splitl_aux P s (0 :num)
tokens_aux_def_typed=(∀(s :mlstring) (n :num) (f :char -> bool). tokens_aux f s ("" :string) n (0 :num) = ([] :mlstring list)) ∧ (∀(t :string) (s :mlstring) (n :num) (h :char) (f :char -> bool). tokens_aux f s (STRING h t) n (0 :num) = [implode (REVERSE (STRING h t))]) ∧ (∀(s :mlstring) (n :num) (len :num) (f :char -> bool). tokens_aux f s ("" :string) n (SUC len) = if f (strsub s n) then tokens_aux f s ("" :string) (n + (1 :num)) len else tokens_aux f s (STRING (strsub s n) ("" :string)) (n + (1 :num)) len) ∧ ∀(t :string) (s :mlstring) (n :num) (len :num) (h :char) (f :char -> bool). tokens_aux f s (STRING h t) n (SUC len) = if f (strsub s n) then implode (REVERSE (STRING h t))::tokens_aux f s ("" :string) (n + (1 :num)) len else tokens_aux f s (STRING (strsub s n) (STRING h t)) (n + (1 :num)) len
tokens_def_typed=∀(f :char -> bool) (s :mlstring). tokens f s = tokens_aux f s ("" :string) (0 :num) (strlen s)
tokens_filter_typed=∀(f :char -> bool) (s :mlstring). concat (tokens f s) = implode (FILTER ($¬ ∘ f) (explode s))
