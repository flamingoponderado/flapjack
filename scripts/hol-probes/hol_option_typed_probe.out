some_def_typed=∀(P :α -> bool). $some P = if ∃(x :α). P x then SOME (@(x :α). P x) else (NONE :α option)
the_def_typed=∀(x :α). THE (SOME x) = x
optrel_def_typed=∀(R :α -> β -> bool) (x :α option) (y :β option). OPTREL R x y ⇔ x = (NONE :α option) ∧ y = (NONE :β option) ∨ ∃(x0 :α) (y0 :β). x = SOME x0 ∧ y = SOME y0 ∧ R x0 y0
