comp_correct_loop_full_statement=∀ac names c exit_names s. (∀v res s1. cut_state (names,LN) s = SOME v ∧ (res,s1) = evaluate (c,v) ∧ cont_loop res ∧ s1.clock ≠ 0 ⇒ ∀k f f' res s1' t bs n bs' n' sprog lens. evaluate (STOP (Loop names c exit_names),dec_clock s1) = (res,s1') ∧ res ≠ SOME Error ∧ state_rel ac k f f' (dec_clock s1) t lens 0 ∧ post_alloc_conventions k (STOP (Loop names c exit_names)) ∧ flat_exp_conventions (STOP (Loop names c exit_names)) ∧ comp ac F (STOP (Loop names c exit_names)) (bs,n) (k,f,f') = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (STOP (Loop names c exit_names)) < 2 * f' + 2 * k ⇒ ∃ck t1 res1. evaluate (sprog,t with clock := t.clock + ck) = (res1,t1) ∧ if OPTION_MAP compile_result res ≠ res1 then res1 = SOME (Halt (Word 2w)) ∧ t1.ffi.io_events ≼ s1'.ffi.io_events ∧ the (s1'.stack_limit + 1) s1'.stack_max > s1'.stack_limit else case res of NONE => state_rel ac k f f' s1' t1 lens 0 | SOME (Result v8 ys) => state_rel ac k 0 0 s1' t1 lens (LENGTH ys − (k − 1)) ∧ ∀i. i < LENGTH ys ⇒ if i + 1 < k then FLOOKUP t1.regs (i + 1) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + 1)) = SOME ys❲i❳ | SOME (Exception v10 y) => ∃l0 l. state_rel ac k 0 0 (push_locals l0 l s1') t1 (LASTN ((dec_clock s1).handler + 1) lens) 0 ∧ s1'.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs 1 = SOME y | SOME (Break v12) => state_rel ac k f f' s1' t1 lens 0 | SOME (Continue v13) => state_rel ac k f f' s1' t1 lens 0 | SOME TimeOut => s1'.ffi = t1.ffi ∧ s1'.clock = t1.clock | SOME NotEnoughSpace => s1'.ffi = t1.ffi ∧ s1'.clock = t1.clock | SOME (FinalFFI v14) => s1'.ffi = t1.ffi ∧ s1'.clock = t1.clock | SOME Error => s1'.ffi = t1.ffi ∧ s1'.clock = t1.clock) ∧ (∀v. cut_state (names,LN) s = SOME v ⇒ ∀k f f' res s1 t bs n bs' n' sprog lens. evaluate (c,v) = (res,s1) ∧ res ≠ SOME Error ∧ state_rel ac k f f' v t lens 0 ∧ post_alloc_conventions k c ∧ flat_exp_conventions c ∧ comp ac F c (bs,n) (k,f,f') = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var c < 2 * f' + 2 * k ⇒ ∃ck t1 res1. evaluate (sprog,t with clock := t.clock + ck) = (res1,t1) ∧ if OPTION_MAP compile_result res ≠ res1 then res1 = SOME (Halt (Word 2w)) ∧ t1.ffi.io_events ≼ s1.ffi.io_events ∧ the (s1.stack_limit + 1) s1.stack_max > s1.stack_limit else case res of NONE => state_rel ac k f f' s1 t1 lens 0 | SOME (Result v8 ys) => state_rel ac k 0 0 s1 t1 lens (LENGTH ys − (k − 1)) ∧ ∀i. i < LENGTH ys ⇒ if i + 1 < k then FLOOKUP t1.regs (i + 1) = SOME ys❲i❳ else LLOOKUP (DROP t1.stack_space t1.stack) (LENGTH ys − (i + 1)) = SOME ys❲i❳ | SOME (Exception v10 y) => ∃l0 l. state_rel ac k 0 0 (push_locals l0 l s1) t1 (LASTN (v.handler + 1) lens) 0 ∧ s1.locals = union (fromAList l) (fromAList l0) ∧ FLOOKUP t1.regs 1 = SOME y | SOME (Break v12) => state_rel ac k f f' s1 t1 lens 0 | SOME (Continue v13) => state_rel ac k f f' s1 t1 lens 0 | SOME TimeOut => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME NotEnoughSpace => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME (FinalFFI v14) => s1.ffi = t1.ffi ∧ s1.clock = t1.clock | SOME Error => s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ⇒ ∀k f f' res s1 t bs n bs' n' sprog lens. evaluate (Loop names c exit_names,s) = (res,s1) ∧ res ≠ SOME Error ∧ state_rel ac k f f' s t lens 0 ∧ post_alloc_conventions k (Loop names c exit_names) ∧ flat_exp_conventions (Loop names c exit_names) ∧ comp ac F (Loop names c exit_names) (bs,n) (k,f,f') = (sprog,bs',n') ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ∧ get_labels sprog ⊆ loc_check t.code ∧ max_var (Loop names c exit_names) < 2 * f' + 2 * k ⇒ ∃ck t1 res1. evaluate (sprog,t with clock := t.clock + ck) = (res1,t1) ∧ if OPTION_M