find_v_globals_v_to_list_typed=∀(x :v) (reachable :sptree$num_set) (xs :v list). (domain (find_v_globals x) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ v_to_list x = SOME xs ⇒ (domain (find_v_globalsL xs) :num -> bool) ⊆ (domain reachable :num -> bool)
