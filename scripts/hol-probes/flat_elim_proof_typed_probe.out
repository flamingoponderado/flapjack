v_has_Eval_list_to_v_typed=v_has_Eval (list_to_v (xs :v list)) ⇔ EXISTS v_has_Eval xs
v_has_Eval_v_to_list_typed=∀(v :v) (xs :v list). v_to_list v = SOME xs ⇒ (v_has_Eval v ⇔ EXISTS v_has_Eval xs)
