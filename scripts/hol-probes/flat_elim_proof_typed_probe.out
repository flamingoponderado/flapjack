evaluate_sing_notKeep_flat_state_rel_typed=∀(env :α environment) (state :(β, γ) state) (exprL :exp list) (new_state :(β, γ) state) (result :(v list, v) result) (expr :exp) (reachable :sptree$num_set) (removed_state :(β, γ) state). (evaluate (env with v := ([] :(mlstring # v) list)) state exprL :(β, γ) state # (v list, v) result) = (new_state,result) ∧ exprL = [expr] ∧ ¬has_Eval expr ∧ ¬keep reachable expr ∧ flat_state_rel reachable state removed_state ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ flat_state_rel reachable new_state removed_state ∧ ∃(value :v). result = (Rval [value] :(v list, v) result)
