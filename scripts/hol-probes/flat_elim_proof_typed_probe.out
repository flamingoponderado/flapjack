globals_rel_def_typed=∀(reachable :sptree$num_set) (s_g :v option list) (t_g :v option list). globals_rel reachable s_g t_g ⇔ LENGTH s_g = LENGTH t_g ∧ (∀(n :num). n ∈ (domain reachable :num -> bool) ∧ n < LENGTH t_g ⇒ s_g❲n❳ = t_g❲n❳) ∧ (∀(n :num) (x :v). n < LENGTH t_g ∧ t_g❲n❳ = SOME x ⇒ s_g❲n❳ = SOME x) ∧ (∀(n :num). n < LENGTH t_g ∧ s_g❲n❳ = (NONE :v option) ⇒ t_g❲n❳ = (NONE :v option)) ∧ ∀(n :num) (x :v). n ∈ (domain reachable :num -> bool) ∧ n < LENGTH t_g ∧ t_g❲n❳ = SOME x ⇒ ¬v_has_Eval x ∧ (domain (find_v_globals x) :num -> bool) ⊆ (domain reachable :num -> bool)
