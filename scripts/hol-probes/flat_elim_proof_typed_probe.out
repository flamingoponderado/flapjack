find_refs_globals_APPEND_typed=∀(refs :v store_v list) (new :v store_v list). find_refs_globals (refs ++ new) = union (find_refs_globals refs) (find_refs_globals new)
find_v_globalsL_EL_typed=∀(n :num) (vs :v list). n < LENGTH vs ⇒ (domain (find_v_globals vs❲n❳) :num -> bool) ⊆ (domain (find_v_globalsL vs) :num -> bool)
find_refs_globals_EL_typed=(n :num) < LENGTH (refs :v store_v list) ∧ (domain (find_refs_globals refs) :num -> bool) ⊆ (R :num -> bool) ⇒ (∀(a :v). refs❲n❳ = Refv a ⇒ (domain (find_v_globals a) :num -> bool) ⊆ R) ∧ (∀(vs :v list). refs❲n❳ = Varray vs ⇒ (domain (find_v_globalsL vs) :num -> bool) ⊆ R) ∧ ∀(m :thunk_mode) (a :v). refs❲n❳ = Thunk m a ⇒ (domain (find_v_globals a) :num -> bool) ⊆ R
EVERY_EL_IMP_typed=EVERY (P :α -> bool) (xs :α list) ∧ (n :num) < LENGTH xs ⇒ P xs❲n❳
find_v_globals_Unitv_typed=isEmpty (find_v_globals Unitv)
v_has_Eval_def_typed=(∀(v0 :mlstring) (env :v environment) (e :exp). v_has_Eval (Closure env v0 e :v) ⇔ has_Eval e ∨ EXISTS v_has_Eval (MAP (SND :mlstring # v -> v) env.v)) ∧ (∀(vl :v list) (v1 :(num # num option) option). v_has_Eval (Conv v1 vl) ⇔ EXISTS v_has_Eval vl) ∧ (∀(v2 :mlstring) (nm_es :(mlstring # mlstring # exp) list) (env :v environment). v_has_Eval (Recclosure env nm_es v2 :v) ⇔ EXISTS v_has_Eval (MAP (SND :mlstring # v -> v) env.v) ∨ EXISTS has_Eval (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) nm_es)) ∧ (∀(vl :v list). v_has_Eval (Vectorv vl) ⇔ EXISTS v_has_Eval vl) ∧ (∀(v :lit). v_has_Eval (Litv v :v) ⇔ F) ∧ ∀(v13 :num) (v12 :bool). v_has_Eval (Loc v12 v13 :v) ⇔ F
find_v_globalsL_LUPDATE_typed=∀(n :num) (vs :v list) (reachable :sptree$num_set) (v :v). n < LENGTH vs ∧ (domain (find_v_globalsL vs) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ (domain (find_v_globals v) :num -> bool) ⊆ (domain reachable :num -> bool) ⇒ (domain (find_v_globalsL vs❲n ↦ v❳) :num -> bool) ⊆ (domain reachable :num -> bool)
find_v_globalsL_REPLICATE_typed=∀(n :num) (v :v) (vs :α). (domain (find_v_globalsL (REPLICATE n v)) :num -> bool) ⊆ (domain (find_v_globals v) :num -> bool)
find_v_globals_MAP_Recclosure_typed=∀(funs :α list) (v :β) (l :(mlstring # mlstring # exp) list). (domain (find_v_globalsL (MAP (λ(x :α). (Recclosure (env :v environment) l ((f :α -> mlstring) x) :v)) funs)) :num -> bool) = if NULL funs then (∅ :num -> bool) else (domain (find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)) :num -> bool) ∪ (domain (find_lookupsL (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) l)) :num -> bool)
find_v_globalsL_MEM_typed=∀(k :α) (v :v) (vs :(α # v) list). MEM (k,v) vs ⇒ (domain (find_v_globals v) :num -> bool) ⊆ (domain (find_v_globalsL (MAP (SND :α # v -> v) vs)) :num -> bool)
find_loc_EVERY_isEmpty_typed=∀(l :exp list) (reachable :sptree$num_set). EVERY (λ(e :exp). isEmpty (inter (find_loc e) reachable)) l ⇔ isEmpty (inter (find_locL l) reachable)
SUM_MAP_v3_size_typed=∀(xs :(mlstring # v) list). (SUM (MAP v3_size xs) :num) = LENGTH xs + (SUM (MAP (mlstring_size ∘ (FST :mlstring # v -> mlstring)) xs) :num) + (SUM (MAP (v_size ∘ (SND :mlstring # v -> v)) xs) :num)
