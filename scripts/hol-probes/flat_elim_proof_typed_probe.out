decs_closed_reduce_typed=∀(reachable :sptree$num_set) (e :exp) (t :exp list). decs_closed reachable (e::t) ⇒ decs_closed reachable t
decs_closed_reduce_HD_typed=∀(reachable :sptree$num_set) (e :exp) (t :exp list). decs_closed reachable (e::t) ⇒ decs_closed reachable [e]
