evaluate_sing_keep_flat_state_rel_eq_typed=∀(env :α environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (expr :exp) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate (env with v := ([] :(mlstring # v) list)) state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ flat_state_rel reachable state removed_state ∧ exprL = [expr] ∧ keep reachable expr ∧ (domain (find_lookups expr) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ ¬has_Eval expr ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). (evaluate (env with v := ([] :(mlstring # v) list)) removed_state exprL :(γ, 'ffi) state # (v list, v) result) = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state
