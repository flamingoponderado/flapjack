flat_state_rel_pmatch_typed=(∀(new_state :(γ, 'ffi) state) (p :pat) (a :v) (env :(mlstring # v) list). flat_state_rel (reachable :sptree$num_set) new_state (new_removed_state :(γ, 'ffi) state) ⇒ (pmatch new_removed_state p a env :(mlstring # v) list match_result) = (pmatch new_state p a env :(mlstring # v) list match_result)) ∧ ∀(new_state :(γ, 'ffi) state) (p :pat list) (a :v list) (env :(mlstring # v) list). flat_state_rel reachable new_state new_removed_state ⇒ (pmatch_list new_removed_state p a env :(mlstring # v) list match_result) = (pmatch_list new_state p a env :(mlstring # v) list match_result)
