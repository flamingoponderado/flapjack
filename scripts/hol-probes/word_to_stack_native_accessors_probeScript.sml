     IS_SOME (wordSem$get_vars xs s) ⇔ EVERY (λx. IS_SOME (get_var x s)) xs``,   Induct \\ simp[get_vars_def,EVERY_MEM]
  \\ rw[] \\ every_case_tac \\ fs[EVERY_MEM]
  \\ metis_tac[IS_SOME_EXISTS,NOT_SOME_NONE,option_CASES]);
val _ = (if null(hyp IS_SOME_get_vars_EVERY) then () else raise Fail "open premise"; print "na_full_IS_SOME_get_vars_EVERY="; print_thm IS_SOME_get_vars_EVERY; print "\n");
val get_vars_eq = prove(``∀ls z.
    get_vars ls st = SOME z ⇒
    let lookups = MAP (\x. lookup x st.locals) ls in
      EVERY IS_SOME lookups ∧
      z = MAP THE lookups``,   Induct>>fs[get_vars_def,get_var_def]>>rw[]>>unabbrev_all_tac>>
  EVERY_CASE_TAC>>fs[]>>
  metis_tac[]);
val _ = (if null(hyp get_vars_eq) then () else raise Fail "open premise"; print "na_full_get_vars_eq="; print_thm get_vars_eq; print "\n");
