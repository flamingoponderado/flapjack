val IS_SOME_get_vars_set_var = prove(``∀ls s.
    IS_SOME (wordSem$get_vars ls s) ⇒
    IS_SOME (get_vars ls (set_var k v s))``,   Induct \\ simp[get_vars_def]
  \\ rw[] \\ every_case_tac \\ fs[IS_SOME_EXISTS,PULL_EXISTS]
  \\ rpt (pop_assum mp_tac)
  \\ EVAL_TAC \\ simp[lookup_insert] \\ rw[]
  \\ res_tac \\ fs[]);
