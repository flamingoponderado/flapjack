do_app_with_code_err_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ⇒ (domain (c :(num # bvl$exp) sptree$num_map) :num -> bool) = (domain s.code :num -> bool) ∨ e ≠ (Rabort Rtype_error :v error_result) ⇒ (do_app op vs (s with code := c) :(v # (α, β) state, v) result) = (Rerr e :(v # (α, β) state, v) result)
initial_state_simp_typed=(initial_state (f :β ffi_state) (c :(num # bvl$exp) sptree$num_map) (co :num -> α # (num # num # bvl$exp) list) (cc :α -> (num # num # bvl$exp) list -> (word8 list # word64 list # α) option) (k :num) :(α, β) state).code = c ∧ (initial_state f c co cc k :(α, β) state).ffi = f ∧ (initial_state f c co cc k :(α, β) state).clock = k ∧ (initial_state f c co cc k :(α, β) state).compile = cc ∧ (initial_state f c co cc k :(α, β) state).compile_oracle = co ∧ (initial_state f c co cc k :(α, β) state).refs = (FEMPTY :num |-> v ref) ∧ (initial_state f c co cc k :(α, β) state).globals = ([] :v option list)
initial_state_with_simp_typed=(initial_state (f :β ffi_state) (c :(num # bvl$exp) sptree$num_map) (co :num -> α # (num # num # bvl$exp) list) (cc :α -> (num # num # bvl$exp) list -> (word8 list # word64 list # α) option) (k :num) :(α, β) state) with clock := (k1 :num) = (initial_state f c co cc k1 :(α, β) state) ∧ (initial_state f c co cc k :(α, β) state) with code := (c1 :(num # bvl$exp) sptree$num_map) = (initial_state f c1 co cc k :(α, β) state)
bool_to_tag_11_typed=bool_to_tag (b1 :bool) = bool_to_tag (b2 :bool) ⇔ (b1 ⇔ b2)
Boolv_11_typed=(Boolv (b1 :bool) :v) = (Boolv (b2 :bool) :v) ⇔ (b1 ⇔ b2)
evaluate_code_typed=∀(xs :bvl$exp list) (env :v list) (s1 :(α, β) state) (vs :(v list, v) result) (s2 :(α, β) state). evaluate (xs,env,s1) = (vs,s2) ⇒ ∃(n :num). s2.compile_oracle = shift_seq n s1.compile_oracle ∧ s2.code = FOLDL (union :(num # bvl$exp) sptree$num_map -> (num # bvl$exp) sptree$num_map -> (num # bvl$exp) sptree$num_map) s1.code (MAP ((fromAList :(num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map) ∘ (SND :α # (num # num # bvl$exp) list -> (num # num # bvl$exp) list)) (GENLIST s1.compile_oracle n))
evaluate_MAP_Const_typed=∀(exps :α list). evaluate (MAP (K (Op (IntOp (Const (i :int))) ([] :bvl$exp list) :bvl$exp) :α -> bvl$exp) exps,(env :v list),(t1 :(β, γ) state)) = ((Rval (MAP (K (Number i :v) :α -> v) exps) :(v list, v) result),t1)
evaluate_Bool_typed=evaluate ([(Bool (b :bool) :bvl$exp)],(env :v list),(s :(α, β) state)) = ((Rval [(Boolv b :v)] :(v list, v) result),s)
inc_clock_code_typed=∀(n :num) (s :(γ, 'ffi) state). (inc_clock n s).code = s.code
inc_clock_refs_typed=∀(n :num) (s :(γ, 'ffi) state). (inc_clock n s).refs = s.refs
inc_clock_ffi_typed=∀(n :num) (s :(γ, 'ffi) state). (inc_clock n s).ffi = s.ffi
inc_clock_clock_typed=∀(n :num) (s :(γ, 'ffi) state). (inc_clock n s).clock = s.clock + n
inc_clock0_typed=∀(n :α) (s :(γ, 'ffi) state). inc_clock (0 :num) s = s
inc_clock_add_typed=inc_clock (k1 :num) (inc_clock (k2 :num) (s :(α, β) state)) = inc_clock (k1 + k2) s
dec_clock_code_typed=∀(n :num) (s :(γ, 'ffi) state). (dec_clock n s).code = s.code
dec_clock_refs_typed=∀(n :num) (s :(γ, 'ffi) state). (dec_clock n s).refs = s.refs
dec_clock_ffi_typed=∀(n :num) (s :(γ, 'ffi) state). (dec_clock n s).ffi = s.ffi
dec_clock0_typed=∀(n :α) (s :(γ, 'ffi) state). dec_clock (0 :num) s = s
evaluate_Var_list_typed=∀(l :bvl$exp list). EVERY isVar l ⇒ evaluate (l,(env :v list),(s :(α, β) state)) = ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) ∨ ∃(vs :v list). evaluate (l,env,s) = ((Rval vs :(v list, v) result),s) ∧ get_vars (MAP destVar l) env = SOME vs ∧ LENGTH vs = LENGTH l
bVarBound_EVERY_typed=∀(ls :bvl$exp list). bVarBound (P :num) ls ⇔ EVERY (λ(e :bvl$exp). bVarBound P [e]) ls
mk_tick_code_labels_typed=∀(n :num) (x :bvl$exp). get_code_labels (mk_tick n x) = get_code_labels x
do_app_split_list_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (res :(v # (α, β) state, v) result) ⇔ vs = ([] :v list) ∧ (do_app op ([] :v list) s :(v # (α, β) state, v) result) = res ∨ ∃(v :v) (vs1 :v list). vs = v::vs1 ∧ (do_app op (v::vs1) s :(v # (α, β) state, v) result) = res
pair_lam_lem_typed=∀(f :α -> β -> γ) (v :γ) (z :α # β). (let ((x :α),(y :β)) = z in f x y) = v ⇔ ∃(x1 :α) (x2 :β). z = (x1,x2) ∧ f x1 x2 = v
do_app_inc_clock_typed=(do_app (op :closLang$op) (vs :v list) (inc_clock (x :num) (y :(α, β) state)) :(v # (α, β) state, v) result) = map_result (λ((v :v),(s :(α, β) state)). (v,s with clock := x + y.clock)) (I :v -> v) (do_app op vs y :(v # (α, β) state, v) result)
dec_clock_1_inc_clock_typed=(x :num) ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock x (s :(α, β) state)) = inc_clock (x − (1 :num)) s
dec_clock_1_inc_clock2_typed=(s :(α, β) state).clock ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock (x :num) s) = inc_clock x (dec_clock (1 :num) s)
dec_clock_inc_clock_typed=¬((s :(α, β) state).clock < (n :num)) ⇒ dec_clock n (inc_clock (x :num) s) = inc_clock x (dec_clock n s)
take_drop_lem_typed=∀(skip :num) (env :α list). skip < LENGTH env ∧ skip + SUC (n :num) ≤ LENGTH env ∧ DROP skip env ≠ ([] :α list) ⇒ env❲skip❳::TAKE n (DROP ((1 :num) + skip) env) = TAKE (n + (1 :num)) (DROP skip env)
do_build_SUBSET_typed=∀(m :num -> v) (n :num) (parts :const_part list) (refs :num |-> v ref) (q :v) (rs :num |-> v ref). do_build m n parts refs = (q,rs) ⇒ FDOM refs ⊆ FDOM rs
evaluate_refs_SUBSET_lemma_typed=∀(xs :bvl$exp list) (env :v list) (s :(α, β) state). FDOM s.refs ⊆ FDOM (SND (evaluate (xs,env,s))).refs
