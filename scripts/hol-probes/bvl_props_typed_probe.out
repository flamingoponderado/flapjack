get_code_labels_def_typed=(∀(v0 :num). get_code_labels (Var v0 :bvl$exp) = (∅ :num -> bool)) ∧ (∀(e3 :bvl$exp) (e2 :bvl$exp) (e1 :bvl$exp). get_code_labels (If e1 e2 e3 :bvl$exp) = get_code_labels e1 ∪ get_code_labels e2 ∪ get_code_labels e3) ∧ (∀(es :bvl$exp list) (e :bvl$exp). get_code_labels (Let es e :bvl$exp) = BIGUNION (set (MAP get_code_labels es)) ∪ get_code_labels e) ∧ (∀(e :bvl$exp). get_code_labels (Raise e :bvl$exp) = get_code_labels e) ∧ (∀(e2 :bvl$exp) (e1 :bvl$exp). get_code_labels (Handle e1 e2 :bvl$exp) = get_code_labels e1 ∪ get_code_labels e2) ∧ (∀(e :bvl$exp). get_code_labels (Tick e :bvl$exp) = get_code_labels e) ∧ (∀(v :num) (loc :num). get_code_labels (Force loc v :bvl$exp) = {loc}) ∧ (∀(v1 :num) (es :bvl$exp list) (d :num option). get_code_labels (Call v1 d es :bvl$exp) = (case d of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}) ∪ BIGUNION (set (MAP get_code_labels es))) ∧ ∀(op :closLang$op) (es :bvl$exp list). get_code_labels (Op op es :bvl$exp) = assign_get_code_label op ∪ BIGUNION (set (MAP get_code_labels es))
find_code_EVERY_IMP_typed=(find_code (dest :num option) (a :v list) (r :(γ, 'ffi) state).code :(v list # bvl$exp) option) = SOME ((q :v list),(t :bvl$exp)) ⇒ EVERY (P :v -> bool) a ⇒ EVERY P q
do_app_err_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ⇒ e = (Rabort Rtype_error :v error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :v error_result)
evaluate_CONS_typed=evaluate ((x :bvl$exp)::(xs :bvl$exp list),(env :v list),(s :(α, β) state)) = case evaluate ([x],env,s) of ((Rval v :(v list, v) result),s2) => (case evaluate (xs,env,s2) of ((Rval vs :(v list, v) result),s1) => ((Rval (HD v::vs) :(v list, v) result),s1) | ((Rerr v8 :(v list, v) result),s1) => ((Rerr v8 :(v list, v) result),s1)) | ((Rerr v10 :(v list, v) result),s2) => ((Rerr v10 :(v list, v) result),s2)
evaluate_APPEND_typed=∀(xs :bvl$exp list) (env :v list) (s :(α, β) state) (ys :bvl$exp list). evaluate (xs ++ ys,env,s) = case evaluate (xs,env,s) of ((Rval vs :(v list, v) result),s2) => (case evaluate (ys,env,s2) of ((Rval ws :(v list, v) result),s1) => ((Rval (vs ++ ws) :(v list, v) result),s1) | ((Rerr v7 :(v list, v) result),s1) => ((Rerr v7 :(v list, v) result),s1)) | ((Rerr v9 :(v list, v) result),s2) => ((Rerr v9 :(v list, v) result),s2)
evaluate_SNOC_typed=∀(xs :bvl$exp list) (env :v list) (s :(α, β) state) (x :bvl$exp). evaluate (SNOC x xs,env,s) = case evaluate (xs,env,s) of ((Rval vs :(v list, v) result),s2) => (case evaluate ([x],env,s2) of ((Rval v :(v list, v) result),s1) => ((Rval (vs ++ v) :(v list, v) result),s1) | ((Rerr v8 :(v list, v) result),s1) => ((Rerr v8 :(v list, v) result),s1)) | ((Rerr v10 :(v list, v) result),s2) => ((Rerr v10 :(v list, v) result),s2)
evaluate_LENGTH_typed=∀(xs :bvl$exp list) (s :v list) (env :(α, β) state). case evaluate (xs,s,env) of ((Rval res :(v list, v) result),s1) => LENGTH xs = LENGTH res | ((Rerr v7 :(v list, v) result),s1) => T
evaluate_IMP_LENGTH_typed=evaluate ((xs :bvl$exp list),(s :v list),(env :(α, β) state)) = ((Rval (res :v list) :(v list, v) result),(s1 :(α, β) state)) ⇒ LENGTH xs = LENGTH res
evaluate_SING_typed=evaluate ([(x :bvl$exp)],(env :v list),(s :(α, β) state)) = ((Rval (a :v list) :(v list, v) result),(p1 :(α, β) state)) ⇒ ∃(d1 :v). a = [d1]
do_app_change_clock_typed=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((res :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ (do_app op args (s1 with clock := (ck :num)) :(v # (α, β) state, v) result) = (Rval (res,s2 with clock := ck) :(v # (α, β) state, v) result)
do_app_change_clock_err_typed=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ⇒ (do_app op args (s1 with clock := (ck :num)) :(v # (α, β) state, v) result) = (Rerr e :(v # (α, β) state, v) result)
do_app_io_events_mono_typed=(do_app (op :closLang$op) (vs :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((x :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
inc_clock_def_typed=∀(ck :num) (s :(α, β) state). inc_clock ck s = s with clock := s.clock + ck
evaluate_add_clock_typed=∀(exps :bvl$exp list) (env :v list) (s1 :(α, β) state) (res :(v list, v) result) (s2 :(α, β) state). evaluate (exps,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ ∀(ck :num). evaluate (exps,env,inc_clock ck s1) = (res,inc_clock ck s2)
evaluate_io_events_mono_typed=∀(exps :bvl$exp list) (env :v list) (s1 :(α, β) state) (res :(v list, v) result) (s2 :(α, β) state). evaluate (exps,env,s1) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_add_to_clock_io_events_mono_typed=∀(exps :bvl$exp list) (env :v list) (s :(α, β) state) (extra :num). (SND (evaluate (exps,env,s))).ffi.io_events ≼ (SND (evaluate (exps,env,inc_clock extra s))).ffi.io_events
do_app_with_code_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((r :v),(s' :(α, β) state)) :(v # (α, β) state, v) result) ∧ op ≠ Install ⇒ (domain s.code :num -> bool) ⊆ (domain (c :(num # bvl$exp) sptree$num_map) :num -> bool) ⇒ (do_app op vs (s with <|code := c; compile := (cc :α -> (num # num # bvl$exp) list -> (word8 list # word64 list # α) option); compile_oracle := (co :num -> α # (num # num # bvl$exp) list)|>) :(v # (α, β) state, v) result) = (Rval (r,s' with <|code := c; compile := cc; compile_oracle := co|>) :(v # (α, β) state, v) result)
do_app_with_code_err_not_Install_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ∧ op ≠ Install ⇒ (domain (c :(num # bvl$exp) sptree$num_map) :num -> bool) ⊆ (domain s.code :num -> bool) ∨ e ≠ (Rabort Rtype_error :v error_result) ⇒ (do_app op vs (s with <|code := c; compile := (cc :α -> (num # num # bvl$exp) list -> (word8 list # word64 list # α) option); compile_oracle := (co :num -> α # (num # num # bvl$exp) list)|>) :(v # (α, β) state, v) result) = (Rerr e :(v # (α, β) state, v) result)
do_app_Rval_swap_typed=(do_app (op :closLang$op) (a :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((x0 :v),(x1 :(α, β) state)) :(v # (α, β) state, v) result) ∧ op ≠ Install ∧ (domain s1.code :num -> bool) ⊆ (domain (t1 :(γ, δ) state).code :num -> bool) ⇒ (do_app op a (t1 with <|globals := s1.globals; refs := s1.refs; clock := s1.clock; ffi := s1.ffi|>) :(v # (γ, β) state, v) result) = (Rval (x0,t1 with <|globals := x1.globals; refs := x1.refs; clock := x1.clock; ffi := x1.ffi|>) :(v # (γ, β) state, v) result)
do_app_Rerr_swap_typed=(do_app (op :closLang$op) (a :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ∧ op ≠ Install ∧ (domain (t1 :(γ, δ) state).code :num -> bool) ⊆ (domain s1.code :num -> bool) ⇒ (do_app op a (t1 with <|globals := s1.globals; refs := s1.refs; clock := s1.clock; ffi := s1.ffi|>) :(v # (γ, β) state, v) result) = (Rerr e :(v # (γ, β) state, v) result)
evaluate_mk_tick_typed=∀(exp :bvl$exp) (env :v list) (s :(α, β) state) (n :num). evaluate ([mk_tick n exp],env,s) = if s.clock < n then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with clock := (0 :num)) else evaluate ([exp],env,dec_clock n s)
evaluate_mono_typed=∀(xs :bvl$exp list) (env :v list) (s1 :(α, β) state) (vs :(v list, v) result) (s2 :(α, β) state). evaluate (xs,env,s1) = (vs,s2) ⇒ subspt s1.code s2.code
evaluate_expand_env_typed=∀(xs :bvl$exp list) (a :v list) (s :(α, β) state) (env :v list). FST (evaluate (xs,a,s)) ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate (xs,a ++ env,s) = evaluate (xs,a,s)
isVar_def_typed=(isVar (Var (n :num) :bvl$exp) ⇔ T) ∧ (isVar (If (v1 :bvl$exp) (v2 :bvl$exp) (v3 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Let (v4 :bvl$exp list) (v5 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Raise (v6 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Handle (v7 :bvl$exp) (v8 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Tick (v9 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Call (v10 :num) (v11 :num option) (v12 :bvl$exp list) :bvl$exp) ⇔ F) ∧ (isVar (Force (v13 :num) (v14 :num) :bvl$exp) ⇔ F) ∧ (isVar (Op (v15 :closLang$op) (v16 :bvl$exp list) :bvl$exp) ⇔ F)
bVarBound_def_typed=(∀(n :num). bVarBound n ([] :bvl$exp list) ⇔ T) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (n :num). bVarBound n (x::y::xs) ⇔ bVarBound n [x] ∧ bVarBound n (y::xs)) ∧ (∀(v :num) (n :num). bVarBound n [(Var v :bvl$exp)] ⇔ v < n) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (n :num). bVarBound n [(If x1 x2 x3 :bvl$exp)] ⇔ bVarBound n [x1] ∧ bVarBound n [x2] ∧ bVarBound n [x3]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (n :num). bVarBound n [(Let xs x2 :bvl$exp)] ⇔ bVarBound n xs ∧ bVarBound (n + LENGTH xs) [x2]) ∧ (∀(x1 :bvl$exp) (n :num). bVarBound n [(Raise x1 :bvl$exp)] ⇔ bVarBound n [x1]) ∧ (∀(x1 :bvl$exp) (n :num). bVarBound n [(Tick x1 :bvl$exp)] ⇔ bVarBound n [x1]) ∧ (∀(xs :bvl$exp list) (op :closLang$op) (n :num). bVarBound n [(Op op xs :bvl$exp)] ⇔ bVarBound n xs) ∧ (∀(v :num) (n :num) (loc :num). bVarBound n [(Force loc v :bvl$exp)] ⇔ v < n) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (n :num). bVarBound n [(Handle x1 x2 :bvl$exp)] ⇔ bVarBound n [x1] ∧ bVarBound (n + (1 :num)) [x2]) ∧ ∀(xs :bvl$exp list) (ticks :num) (n :num) (dest :num option). bVarBound n [(Call ticks dest xs :bvl$exp)] ⇔ bVarBound n xs
do_app_refs_SUBSET_typed=(do_app (op :closLang$op) (a :v list) (r :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((q :v),(t :(α, β) state)) :(v # (α, β) state, v) result) ⇒ FDOM r.refs ⊆ FDOM t.refs
evaluate_refs_SUBSET_typed=evaluate ((xs :bvl$exp list),(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(t :(α, β) state)) ⇒ FDOM s.refs ⊆ FDOM t.refs
