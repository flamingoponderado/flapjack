generalise_type=:num -> num -> (num |-> num) -> infer_t -> num # (num |-> num) # infer_t
generalise_list_type=:num -> num -> (num |-> num) -> infer_t list -> num # (num |-> num) # infer_t list
generalise_def_typed=(∀(m :num) (n :num) (s :num |-> num) (ts :infer_t list) (tc :num). generalise m n s (Infer_Tapp ts tc) = (let ((num_gen :num),(s' :num |-> num),(ts' :infer_t list)) = generalise_list m n s ts in (num_gen,s',Infer_Tapp ts' tc))) ∧ (∀(m :num) (n :num) (s :num |-> num) (uv :num). generalise m n s (Infer_Tuvar uv) = case FLOOKUP s uv of (NONE :num option) => if m ≤ uv then ((1 :num),s⟨uv ↦ n⟩,Infer_Tvar_db n) else ((0 :num),s,Infer_Tuvar uv) | SOME v => ((0 :num),s,Infer_Tvar_db v)) ∧ (∀(m :num) (n :num) (s :num |-> num) (k :num). generalise m n s (Infer_Tvar_db k) = ((0 :num),s,Infer_Tvar_db k)) ∧ (∀(m :num) (n :num) (s :num |-> num). generalise_list m n s ([] :infer_t list) = ((0 :num),s,([] :infer_t list))) ∧ ∀(m :num) (n :num) (s :num |-> num) (t :infer_t) (ts :infer_t list). generalise_list m n s (t::ts) = (let ((num_gen :num),(s' :num |-> num),(t' :infer_t)) = generalise m n s t; ((num_gen' :num),(s'' :num |-> num),(ts' :infer_t list)) = generalise_list m (num_gen + n) s' ts in (num_gen + num_gen',s'',t'::ts'))
generalise_list_length_typed=∀(a :num) (b :num) (c :num |-> num) (d :infer_t list) (e :num) (f :num |-> num) (g :infer_t list). generalise_list a b c d = (e,f,g) ⇒ LENGTH g = LENGTH d
