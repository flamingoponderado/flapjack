generalise_type=:num -> num -> (num |-> num) -> infer_t -> num # (num |-> num) # infer_t
generalise_list_type=:num -> num -> (num |-> num) -> infer_t list -> num # (num |-> num) # infer_t list
generalise_def_typed=(∀(m :num) (n :num) (s :num |-> num) (ts :infer_t list) (tc :num). generalise m n s (Infer_Tapp ts tc) = (let ((num_gen :num),(s' :num |-> num),(ts' :infer_t list)) = generalise_list m n s ts in (num_gen,s',Infer_Tapp ts' tc))) ∧ (∀(m :num) (n :num) (s :num |-> num) (uv :num). generalise m n s (Infer_Tuvar uv) = case FLOOKUP s uv of (NONE :num option) => if m ≤ uv then ((1 :num),s⟨uv ↦ n⟩,Infer_Tvar_db n) else ((0 :num),s,Infer_Tuvar uv) | SOME v => ((0 :num),s,Infer_Tvar_db v)) ∧ (∀(m :num) (n :num) (s :num |-> num) (k :num). generalise m n s (Infer_Tvar_db k) = ((0 :num),s,Infer_Tvar_db k)) ∧ (∀(m :num) (n :num) (s :num |-> num). generalise_list m n s ([] :infer_t list) = ((0 :num),s,([] :infer_t list))) ∧ ∀(m :num) (n :num) (s :num |-> num) (t :infer_t) (ts :infer_t list). generalise_list m n s (t::ts) = (let ((num_gen :num),(s' :num |-> num),(t' :infer_t)) = generalise m n s t; ((num_gen' :num),(s'' :num |-> num),(ts' :infer_t list)) = generalise_list m (num_gen + n) s' ts in (num_gen + num_gen',s'',t'::ts'))
generalise_list_length_typed=∀(a :num) (b :num) (c :num |-> num) (d :infer_t list) (e :num) (f :num |-> num) (g :infer_t list). generalise_list a b c d = (e,f,g) ⇒ LENGTH g = LENGTH d
infer_subst_type=:(num |-> num) -> infer_t -> infer_t
infer_subst_def_typed=(∀(s :num |-> num) (n :num). infer_subst s (Infer_Tvar_db n) = Infer_Tvar_db n) ∧ (∀(ts :infer_t list) (tc :num) (s :num |-> num). infer_subst s (Infer_Tapp ts tc) = Infer_Tapp (MAP (λ(a :infer_t). infer_subst s a) ts) tc) ∧ ∀(s :num |-> num) (n :num). infer_subst s (Infer_Tuvar n) = case FLOOKUP s n of (NONE :num option) => Infer_Tuvar n | SOME m => Infer_Tvar_db m
infer_subst_submap_typed=(∀(t :infer_t) (s1 :num |-> num) (s2 :num |-> num) (m :num). s1 ⊑ s2 ∧ equiv_class $<= (t_vars t) m ⊆ FDOM s1 ∧ (∀(uv :num). uv ∈ FDOM s2 DIFF FDOM s1 ⇒ m ≤ uv) ⇒ infer_subst s1 t = infer_subst s2 t) ∧ ∀(ts :infer_t list) (s1 :num |-> num) (s2 :num |-> num) (m :num). s1 ⊑ s2 ∧ {uv | ∃(s :num -> bool). uv ∈ s ∧ MEM s (MAP t_vars ts) ∧ m ≤ uv} ⊆ FDOM s1 ∧ (∀(uv :num). uv ∈ FDOM s2 DIFF FDOM s1 ⇒ m ≤ uv) ⇒ MAP (infer_subst s1) ts = MAP (infer_subst s2) ts
infer_subst_FEMPTY_typed=(∀(t :infer_t). infer_subst (FEMPTY :num |-> num) t = t) ∧ ∀(ts :infer_t list). MAP (infer_subst (FEMPTY :num |-> num)) ts = ts
subst_infer_subst_swap_typed=(∀(t :t) (tvs :mlstring list) (s :num |-> infer_t) (uvar :num). t_wfs s ⇒ t_walkstar s (infer_type_subst (ZIP (tvs,MAP (λ(n :num). Infer_Tuvar (uvar + n)) (COUNT_LIST (LENGTH tvs)))) t) = infer_type_subst (ZIP (tvs,MAP (λ(n :num). t_walkstar s (Infer_Tuvar (uvar + n))) (COUNT_LIST (LENGTH tvs)))) t) ∧ ∀(ts :t list) (tvs :mlstring list) (s :num |-> infer_t) (uvar :num). t_wfs s ⇒ MAP (t_walkstar s) (MAP (infer_type_subst (ZIP (tvs,MAP (λ(n :num). Infer_Tuvar (uvar + n)) (COUNT_LIST (LENGTH tvs))))) ts) = MAP (infer_type_subst (ZIP (tvs,MAP (λ(n :num). t_walkstar s (Infer_Tuvar (uvar + n))) (COUNT_LIST (LENGTH tvs))))) ts
