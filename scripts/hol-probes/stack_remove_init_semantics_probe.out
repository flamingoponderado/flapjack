make_init_opt_SOME_semantics_statement=∀start s2 off max_heap k jump gen_gc data_sp coracle code bitmaps. init_pre gen_gc max_heap bitmaps data_sp k start s2 ∧ s2.compile_oracle = (I ## MAP (prog_comp jump off k) ## I) ∘ coracle ∧ (∀n i p. MEM (i,p) (FST (SND (coracle n))) ⇒ reg_bound p k ∧ num_stubs ≤ i + 1) ∧ code_rel jump off k code s2.code ∧ lookup stack_err_lab s2.code = SOME (halt_inst 2w) ⇒ ∃s1. make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k code s2 = SOME s1 ∧ (semantics start s1 ≠ Fail ⇒ semantics 0 s2 = semantics start s1)
