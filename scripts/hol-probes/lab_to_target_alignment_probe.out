line_aligned_def=∀(m :num) (l :α line).
  line_aligned m l ⇔
  line_len l MOD m = (0 :num) ∧ line_length l MOD m = (0 :num)
line_aligned_def_types=(m :num)::num;(l :α line)::α line;
sec_aligned_def=∀(noplen :num) (v0 :num) (ls :α line list).
  sec_aligned noplen (Section v0 ls) ⇔
  EVERY (line_aligned noplen :α line -> bool) ls
sec_aligned_def_types=(noplen :num)::num;(v0 :num)::num;(ls :α line list)::α line list;
all_encd0_aligned=∀(c :α asm_config) (enc :α asm -> word8 list) (code :α sec list).
  enc_ok c ∧ enc = c.encode ∧ all_encd0 enc code ∧
  EVERY (sec_label_zero :α sec -> bool) code ⇒
  EVERY
    (sec_aligned (LENGTH (enc (Inst (Skip :α inst) :α asm))) :α sec -> bool)
    code
all_encd0_aligned_types=(c :α asm_config)::α asm_config;(enc :α asm -> word8 list)::α asm -> word8 list;(code :α sec list)::α sec list;
enc_lines_again_simp_aligned=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (ls :α line list) (res :α line list)
    (ok :bool).
  (∀(a :α asm). LENGTH (enc a) MOD (len :num) = (0 :num)) ∧
  enc_lines_again_simp labs ffis pos enc ls = (res,ok) ∧
  EVERY (line_aligned len :α line -> bool) ls ⇒
  EVERY (line_aligned len :α line -> bool) res
enc_lines_again_simp_aligned_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(ls :α line list)::α line list;(res :α line list)::α line list;(ok :bool)::bool;(len :num)::num;
enc_secs_again_aligned=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (enc :α asm -> word8 list) (lines :α sec list) (res :α sec list)
    (ok :bool).
  (∀(a :α asm). LENGTH (enc a) MOD (len :num) = (0 :num)) ∧
  enc_secs_again pos labs ffis enc lines = (res,ok) ∧
  EVERY (sec_aligned len :α sec -> bool) lines ⇒
  EVERY (sec_aligned len :α sec -> bool) res
enc_secs_again_aligned_types=(pos :num)::num;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α sec list)::α sec list;(res :α sec list)::α sec list;(ok :bool)::bool;(len :num)::num;
MOD_0_source=(k :num) MOD (0 :num) = k ∧ (0 :num) MOD (n :num) = (0 :num)
MOD_0_source_types=(n :num)::num;(k :num)::num;
zero_label_aligned=T
nonzero_label_not_aligned=T
both_lengths_required=T
annotation_required=T
empty_section_aligned=T
modulus_zero_empty_line=T
modulus_zero_nonempty_rejected=T
false_flag_full=T
false_flag_both_aligned=T
full_sections_false=T
modulus_zero_actual_update=T
