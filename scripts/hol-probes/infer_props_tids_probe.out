set_tids_def_typed=(∀(ts :t list) (tn :num). set_tids (Tapp ts tn) = tn INSERT BIGUNION (set (MAP (λ(a :t). set_tids a) ts))) ∧ (∀(v :mlstring). set_tids (Tvar v) = (∅ :num -> bool)) ∧ ∀(v1 :num). set_tids (Tvar_db v1) = (∅ :num -> bool)
unconvert_t_def_typed=(∀(n :num). unconvert_t (Tvar_db n) = Infer_Tvar_db n) ∧ (∀(ts :t list) (tc :num). unconvert_t (Tapp ts tc) = Infer_Tapp (MAP (λ(a :t). unconvert_t a) ts) tc) ∧ ∀(v :mlstring). unconvert_t (Tvar v) = Infer_Tuvar (ARB :num)
inf_set_tids_def_typed=(∀(ts :infer_t list) (tn :num). inf_set_tids (Infer_Tapp ts tn) = tn INSERT BIGUNION (set (MAP (λ(a :infer_t). inf_set_tids a) ts))) ∧ (∀(v :num). inf_set_tids (Infer_Tvar_db v) = (∅ :num -> bool)) ∧ ∀(v3 :num). inf_set_tids (Infer_Tuvar v3) = (∅ :num -> bool)
inf_set_tids_subset_def_typed=∀(tids :num -> bool) (t :infer_t). inf_set_tids_subset tids t ⇔ inf_set_tids t ⊆ tids
inf_set_tids_ienv_def_typed=∀(tids :num -> bool) (ienv :inf_env). inf_set_tids_ienv tids ienv ⇔ nsAll (λ(i :(mlstring, mlstring) id) ((ls :mlstring list),(t :t)). inf_set_tids_subset tids (unconvert_t t)) ienv.inf_t ∧ nsAll (λ(i :(mlstring, mlstring) id) ((ls :mlstring list),(ts :t list),(tid :num)). EVERY (λ(t :t). inf_set_tids_subset tids (unconvert_t t)) ts ∧ tid ∈ tids) ienv.inf_c ∧ nsAll (λ(i :(mlstring, mlstring) id) ((n :num),(t :infer_t)). inf_set_tids_subset tids t) ienv.inf_v
inf_set_tids_unconvert_typed=∀(t :t). inf_set_tids (unconvert_t t) = set_tids t
check_t_def_typed=(∀(v :num) (uvars :num -> bool) (n :num). check_t n uvars (Infer_Tuvar v) ⇔ v ∈ uvars) ∧ (∀(uvars :num -> bool) (n' :num) (n :num). check_t n uvars (Infer_Tvar_db n') ⇔ n' < n) ∧ ∀(uvars :num -> bool) (ts :infer_t list) (tc :num) (n :num). check_t n uvars (Infer_Tapp ts tc) ⇔ EVERY (λ(a :infer_t). check_t n uvars a) ts
ienv_val_ok_def_typed=∀(uvars :num -> bool) (env :(α, β, num # infer_t) namespace). ienv_val_ok uvars env ⇔ nsAll (λ(x :(α, β) id) ((tvs :num),(t :infer_t)). check_t tvs uvars t) env
ienv_ok_def_typed=∀(uvars :num -> bool) (ienv :inf_env). ienv_ok uvars ienv ⇔ ienv_val_ok uvars ienv.inf_v ∧ tenv_ctor_ok ienv.inf_c ∧ tenv_abbrev_ok ienv.inf_t
infer_deBruijn_subst_id_typed=(∀(t :infer_t). infer_deBruijn_subst ([] :infer_t list) t = t) ∧ ∀(ts :infer_t list). MAP (infer_deBruijn_subst ([] :infer_t list)) ts = ts
infer_deBruijn_subst_id2_typed=(∀(t :infer_t). check_t (tvs :num) (∅ :num -> bool) t ⇒ infer_deBruijn_subst (GENLIST Infer_Tvar_db tvs) t = t) ∧ ∀(ts :infer_t list). EVERY (check_t tvs (∅ :num -> bool)) ts ⇒ MAP (infer_deBruijn_subst (GENLIST Infer_Tvar_db tvs)) ts = ts
check_t_infer_deBruijn_subst_typed=∀(subst :infer_t list) (t :infer_t) (tvs :num) (uvs :num -> bool). check_t (tvs + LENGTH subst) uvs t ∧ EVERY (check_t tvs uvs) subst ⇒ check_t tvs uvs (infer_deBruijn_subst subst t)
infer_deBruijn_subst_uncheck_typed=∀(s :infer_t list) (t :infer_t) (max_tvs :num) (uvs :num -> bool). check_t max_tvs uvs (infer_deBruijn_subst s t) ⇒ check_t (max_tvs + LENGTH s) uvs t
check_t_more5_typed=(∀(t :infer_t) (uvs :num -> bool) (tvs :num). check_t tvs uvs t ⇒ ∀(uvs' :num -> bool). uvs ⊆ uvs' ⇒ check_t tvs uvs' t) ∧ ∀(ts :infer_t list) (uvs :num -> bool) (tvs :num). EVERY (check_t tvs uvs) ts ⇒ ∀(uvs' :num -> bool). uvs ⊆ uvs' ⇒ EVERY (check_t tvs uvs') ts
