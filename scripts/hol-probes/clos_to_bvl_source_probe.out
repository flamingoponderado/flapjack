generate_generic_app_def_typed=∀(max_app :num) (n :num). generate_generic_app max_app n = (Let [(Op (IntOp Sub) [mk_const (n + (1 :num)); mk_elem_at (Var (n + (1 :num)) :exp) (1 :num)] :exp)] (If (Op (IntOp Less) [mk_const (0 :num); (Var (0 :num) :exp)] :exp) (Jump (mk_elem_at (Var (n + (2 :num)) :exp) (1 :num)) (GENLIST (λ(num_args :num). (Let [(Call num_args (NONE :num option) (GENLIST (λ(arg :num). (Var (arg + (2 :num) + n − num_args) :exp)) (num_args + (1 :num)) ++ [(Var (n + (3 :num)) :exp)] ++ [mk_elem_at (Var (n + (3 :num)) :exp) (0 :num)]) :exp)] (mk_cl_call (Var (0 :num) :exp) (GENLIST (λ(n :num). (Var (n + (3 :num)) :exp)) (n − num_args))) :exp)) max_app)) (mk_tick n (If (Op (BlockOp (TagEq closure_tag)) [(Var (n + (2 :num)) :exp)] :exp) (Op (BlockOp (Cons partial_app_tag :block_op)) (REVERSE (mk_el (Op (GlobOp (Global (0 :num))) ([] :exp list) :exp) (partial_app_fn_location_code max_app (mk_elem_at (Var (n + (2 :num)) :exp) (1 :num)) (mk_const n))::(Var (0 :num) :exp)::(Var (n + (2 :num)) :exp)::GENLIST (λ(n :num). (Var (n + (1 :num)) :exp)) (n + (1 :num)))) :exp) (Let [(Op (IntOp Sub) [mk_const (3 :num); (Op (BlockOp LengthBlock) [(Var (n + (2 :num)) :exp)] :exp)] :exp)] (Op (BlockOp (ConsExtend partial_app_tag)) (REVERSE ((Var (n + (3 :num)) :exp)::mk_const (3 :num)::(Var (0 :num) :exp)::(Op (IntOp Add) [(Var (0 :num) :exp); mk_const (n + (4 :num))] :exp)::mk_el (Op (GlobOp (Global (0 :num))) ([] :exp list) :exp) (partial_app_fn_location_code max_app (Op (IntOp Add) [(Var (0 :num) :exp); (Op (IntOp Add) [mk_const (n + (1 :num)); (Var (1 :num) :exp)] :exp)] :exp) (Op (IntOp Add) [(Var (1 :num) :exp); mk_const n] :exp))::(Var (1 :num) :exp)::mk_elem_at (Var (n + (3 :num)) :exp) (2 :num)::GENLIST (λ(this_arg :num). (Var (this_arg + (2 :num)) :exp)) (n + (1 :num)))) :exp) :exp) :exp)) :exp) :exp)
check_closure_def_typed=∀(v :num) (e :exp). check_closure v e = (If (Op (BlockOp (TagEq closure_tag)) [(Var v :exp)] :exp) (Bool T) (If (Op (BlockOp (TagEq partial_app_tag)) [(Var v :exp)] :exp) (Bool T) e :exp) :exp)
init_code_def_typed=∀(max_app :num). init_code max_app = (fromList (GENLIST (λ(n :num). (n + (2 :num),generate_generic_app max_app n)) max_app ++ FLAT (GENLIST (λ(tot :num). GENLIST (λ(prev :num). (tot − prev + (1 :num),generate_partial_app_closure_fn tot prev)) tot) max_app)) :(num # exp) sptree$num_map)
init_globals_def_typed=∀(max_app :num) (start_loc :num). init_globals max_app start_loc = (Let [(Op (GlobOp AllocGlobal) [(Op (IntOp (Const (1 :int))) ([] :exp list) :exp)] :exp)] (Let [(Op (GlobOp (SetGlobal partial_app_label_table_loc)) [(Op (BlockOp (Cons tuple_tag :block_op)) (REVERSE (FLAT (GENLIST (λ(tot :num). GENLIST (λ(prev :num). mk_label (partial_app_fn_location max_app tot prev)) tot) max_app))) :exp)] :exp)] (Call (0 :num) (SOME start_loc) ([] :exp list) :exp) :exp) :exp)
force_thunk_code_def_typed=force_thunk_code = (If (Op (BlockOp (EqualConst (Int (0 :int) :const_part))) [mk_elem_at (Var (1 :num) :exp) (1 :num)] :exp) (Let [(Call (0 :num) (NONE :num option) [mk_unit; (Var (1 :num) :exp); mk_elem_at (Var (1 :num) :exp) (0 :num)] :exp)] (Let [(Op (ThunkOp (UpdateThunk Evaluated) :op) [(Var (0 :num) :exp); (Var (1 :num) :exp)] :exp)] (Var (1 :num) :exp) :exp) :exp) (Let [(Call (0 :num) (SOME (0 :num)) [mk_unit; (Var (1 :num) :exp)] :exp)] (Let [(Op (ThunkOp (UpdateThunk Evaluated) :op) [(Var (0 :num) :exp); (Var (1 :num) :exp)] :exp)] (Var (1 :num) :exp) :exp) :exp) :exp)
build_aux_acc_typed=∀(k :(num # exp) list) (n :num) (aux :(num # num # exp) list). ∃(aux1 :(num # num # exp) list). SND (build_aux n k aux) = aux1 ++ aux
build_aux_LENGTH_typed=∀(l :(num # exp) list) (n :num) (aux :(num # num # exp) list) (n1 :num) (t :(num # num # exp) list). build_aux n l aux = (n1,t) ⇒ n1 = n + (2 :num) * LENGTH l
build_aux_MEM_typed=∀(c :(num # exp) list) (n :num) (aux :(num # num # exp) list) (n7 :num) (aux7 :(num # num # exp) list). build_aux n c aux = (n7,aux7) ⇒ ∀(k :num). k < LENGTH c ⇒ ∃(d :num # exp). MEM (n + (2 :num) * k,d) aux7
build_aux_MOVE_typed=∀(xs :(num # exp) list) (n :num) (aux :(num # num # exp) list) (n1 :num) (aux1 :(num # num # exp) list). build_aux n xs aux = (n1,aux1) ⇔ ∃(aux2 :(num # num # exp) list). build_aux n xs ([] :(num # num # exp) list) = (n1,aux2) ∧ aux1 = aux2 ++ aux
compile_exps_acc_typed=∀(max_app :num) (xs :closLang$exp list) (aux :(num # num # exp) list). (let ((c :exp list),(aux1 :(num # num # exp) list)) = compile_exps max_app xs aux in LENGTH c = LENGTH xs ∧ ∃(ys :(num # num # exp) list). aux1 = ys ++ aux)
compile_exps_LENGTH_typed=compile_exps (max_app :num) (xs :closLang$exp list) (aux :(num # num # exp) list) = ((c :exp list),(aux1 :(num # num # exp) list)) ⇒ LENGTH c = LENGTH xs
compile_inc_def_typed=∀(max_app :num) (es :closLang$exp list) (prog :(num # num # closLang$exp) list). (compile_inc max_app (es,prog) :(num # num # exp) list) = (let ((n :num),(real_es :closLang$exp list)) = extract_name es in compile_prog max_app (chain_exps n real_es ++ prog))
