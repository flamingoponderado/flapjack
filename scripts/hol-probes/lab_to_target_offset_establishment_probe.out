enc_lines_again_simp_offset_ok=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (lines :α line list) (res :α line list)
    (ok :bool).
  enc_lines_again_simp labs ffis pos enc lines = (res,ok) ⇒
  lines_offset_ok labs ffis pos res
