stack_to_lab_compile_all_enc_ok_typed=EVERY (λ((n :num),(p :α prog)). stack_asm_name (c :α asm_config) p) (prog :(num # α prog) list) ∧ EVERY (λ((n :num),(p :α prog)). stack_asm_remove c p) prog ∧ names_ok (c1 :stack_to_lab$config).reg_names c.reg_count c.avoid_regs ∧ fixed_names c1.reg_names c ∧ addr_offset_ok c (0w :α word) ∧ good_dimindex (:α) ∧ byte_offset_ok c (0w :α word) ∧ (∀(n :num). n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ c.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)) ∧ c.valid_imm (INL Add :binop + cmp) (1w :α word) ∧ c.valid_imm (INL Sub :binop + cmp) (1w :α word) ∧ c.valid_imm (INL Add :binop + cmp) (4w :α word) ∧ c.valid_imm (INL Add :binop + cmp) (8w :α word) ∧ (∀(s :store_name). addr_offset_ok c (store_offset s :α word)) ∧ reg_name (10 :num) c ∧ reg_name ((sp :num) + (2 :num)) c ∧ reg_name (sp + (1 :num)) c ∧ reg_name sp c ∧ conf_ok (:α) (c2 :data_to_word$config) ∧ sp ≠ (0 :num) ⇒ all_enc_ok_pre c (compile c1 c2 (c3 :num) sp c.addr_offset prog :α sec list)
flatten_call_correct_typed=(evaluate ((Call (NONE :(α prog # num # num # num) option) (INL (start :num) :num + num) (NONE :(α prog # num # num) option) :α prog),(s1 :(α, γ, 'ffi) stackSem$state)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((res :α stackSem$result option),(s2 :(α, γ, 'ffi) stackSem$state)) ∧ (state_rel s1 (t1 :(α, γ, 'ffi) labSem$state) :bool) ∧ loc_to_pc start (0 :num) t1.code = SOME t1.pc ∧ res ≠ SOME (Error :α stackSem$result) ∧ (res ≠ SOME (TimeOut :α stackSem$result) ⇒ (∃(w :α word). res = SOME (Halt (Word w) :α stackSem$result)) ∨ (∃(f :final_event). res = SOME (FinalFFI f :α stackSem$result)) ∨ ∃(n :num). res = SOME (Result (Loc n (0 :num) :α word_loc) :α stackSem$result) ∧ ∀(s :(α, γ, 'ffi) stackSem$state). subspt s1.code s.code ∧ s.clock ≠ (0 :num) ⇒ ∃(t :(α, γ, 'ffi) stackSem$state). (evaluate ((Call (NONE :(α prog # num # num # num) option) (INL n :num + num) (NONE :(α prog # num # num) option) :α prog),s) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (SOME (Halt (Word (0w :α word)) :α stackSem$result),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − (1 :num)) ⇒ ∃(ck :num) (r2 :machine_result) (t2 :(α, γ, 'ffi) labSem$state). (evaluate (t1 with clock := t1.clock − (1 :num) + ck) :machine_result # (α, γ, 'ffi) labSem$state) = (r2,t2) ∧ (∀(f :final_event). res = SOME (FinalFFI f :α stackSem$result) ⇒ r2 = (Halt (FFI_outcome f) :machine_result)) ∧ (∀(w :α word_loc). res = SOME (Halt w :α stackSem$result) ⇒ r2 = case w of Word (0w :α word) => (Halt Success :machine_result) | Word v6 => (Halt Resource_limit_hit :machine_result) | (Loc v4 v5 :α word_loc) => Error) ∧ (∀(n :num). res = SOME (Result (Loc n (0 :num) :α word_loc) :α stackSem$result) ⇒ r2 = (Halt Success :machine_result)) ∧ t2.ffi = s2.ffi ∧ r2 ≠ Error ∧ (res = SOME (TimeOut :α stackSem$result) ⇒ r2 = TimeOut)
halt_assum_def_typed=∀(code :α prog sptree$num_map). halt_assum (:'ffi # γ) code ⇔ ∀(s :(α, γ, 'ffi) stackSem$state). subspt code s.code ∧ s.clock ≠ (0 :num) ⇒ ∃(t :(α, γ, 'ffi) stackSem$state). (evaluate ((Call (NONE :(α prog # num # num # num) option) (INL (1 :num) :num + num) (NONE :(α prog # num # num) option) :α prog),s) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (SOME (Halt (Word (0w :α word)) :α stackSem$result),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − (1 :num)
flatten_correct_typed=∀(prog :α prog) (s1 :(α, γ, 'ffi) stackSem$state) (t :bool) (r :α stackSem$result option) (s2 :(α, γ, 'ffi) stackSem$state) (n :num) (l :num) (cs :num list) (bs :num list) (t1 :(α, γ, 'ffi) labSem$state). (evaluate (prog,s1) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (r,s2) ∧ r ≠ SOME (Error :α stackSem$result) ∧ (state_rel s1 t1 :bool) ∧ call_args prog t1.ptr_reg t1.len_reg t1.ptr2_reg t1.len2_reg t1.link_reg ∧ code_installed t1.pc (append (FST (flatten t prog n l cs bs))) t1.code ∧ EVERY (λ(k :num). IS_SOME (loc_to_pc n k t1.code)) (cs ++ bs ++ [(0 :num)]) ⇒ ∃(ck :num) (t2 :(α, γ, 'ffi) labSem$state). case halt_view r of (NONE :machine_result option) => (∀(ck1 :num). (evaluate (t1 with clock := t1.clock + ck + ck1) :machine_result # (α, γ, 'ffi) labSem$state) = (evaluate (t2 with clock := t2.clock + ck1) :machine_result # (α, γ, 'ffi) labSem$state)) ∧ t2.len_reg = t1.len_reg ∧ t2.ptr_reg = t1.ptr_reg ∧ t2.len2_reg = t1.len2_reg ∧ t2.ptr2_reg = t1.ptr2_reg ∧ t2.link_reg = t1.link_reg ∧ t1.code ≼ t2.code ∧ (case OPTION_MAP (λ(w :α stackSem$result). result_view w n cs bs) r of (NONE :result_view option) => t2.pc = t1.pc + LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) (append (FST (flatten t prog n l cs bs)))) ∧ (state_rel s2 t2 :bool) | SOME (Vloc n1 n2) => (∀(n :num). IS_SOME (lookup n s2.code :α prog option) ⇒ IS_SOME (loc_to_pc n (0 :num) t2.code)) ∧ ∀(w :num). loc_to_pc n1 n2 t2.code = SOME w ⇒ w = t2.pc ∧ (state_rel s2 t2 :bool) | SOME (Vcont n1' n2') => (state_rel s2 t2 :bool) ∧ code_installed t2.pc [LabAsm (Jump (Lab n1' n2') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] t2.code | SOME Vtimeout => t2.ffi = s2.ffi ∧ t2.clock = (0 :num) | SOME Verr => F) | SOME res => (evaluate (t1 with clock := t1.clock + ck) :machine_result # (α, γ, 'ffi) labSem$state) = (res,t2) ∧ t2.ffi = s2.ffi
result_view_typed=Vloc::num -> num -> result_view; Vcont::num -> num -> result_view; Vtimeout::result_view; Verr::result_view
compile_jump_correct_typed=asm_fetch_aux (pc :num) (code :α sec list) = SOME (compile_jump (dest :num + num) :α line) ∧ loc_to_pc (dest_to_loc' (regs :num -> α word_loc) dest) (0 :num) code = SOME (pc' :num) ∧ (∀(r :num). dest = (INR r :num + num) ⇒ ∃(p :num). (read_reg r (s :(α, γ, 'ffi) labSem$state) :α word_loc) = (Loc p (0 :num) :α word_loc)) ∧ s.pc = pc ∧ s.code = code ∧ s.regs = regs ∧ s.clock ≠ (0 :num) ⇒ (evaluate s :machine_result # (α, γ, 'ffi) labSem$state) = (evaluate (upd_pc pc' (dec_clock s :(α, γ, 'ffi) labSem$state)) :machine_result # (α, γ, 'ffi) labSem$state)
every_is_some_loc_to_pc_prefix_typed=EVERY (λ(k :num). IS_SOME (loc_to_pc (n :num) k (c1 :α sec list))) (cs :num list) ∧ c1 ≼ (c2 :α sec list) ⇒ EVERY (λ(k :num). IS_SOME (loc_to_pc n k c2)) cs
flatten_leq_typed=∀(t :bool) (x :α prog) (y :num) (z :num) (cs :num list) (bs :num list). z ≤ SND (SND (flatten t x y z cs bs))
flatten_T_F_typed=¬is_Seq (p_2 :α prog) ⇒ flatten T p_2 (p_1 :num) (m :num) (cs :num list) (bs :num list) = flatten F p_2 p_1 m cs bs
halt_view_def_typed=halt_view (SOME (Halt (w :α word_loc) :α stackSem$result)) = SOME (halt_word_view w) ∧ halt_view (SOME (FinalFFI (outcome :final_event) :α stackSem$result)) = SOME (Halt (FFI_outcome outcome) :machine_result) ∧ halt_view (NONE :α stackSem$result option) = (NONE :machine_result option) ∧ halt_view (SOME (Result (v2 :α word_loc) :α stackSem$result)) = (NONE :machine_result option) ∧ halt_view (SOME (Exception (v3 :α word_loc) :α stackSem$result)) = (NONE :machine_result option) ∧ halt_view (SOME (Break (v4 :num) :α stackSem$result)) = (NONE :machine_result option) ∧ halt_view (SOME (Continue (v5 :num) :α stackSem$result)) = (NONE :machine_result option) ∧ halt_view (SOME (TimeOut :α stackSem$result)) = (NONE :machine_result option) ∧ halt_view (SOME (Error :α stackSem$result)) = (NONE :machine_result option)
halt_word_view_def_typed=halt_word_view (Word (0w :α word)) = (Halt Success :machine_result) ∧ halt_word_view (Word (v7 :α word)) = (if v7 = (0w :α word) then (Halt Success :machine_result) else (Halt Resource_limit_hit :machine_result)) ∧ halt_word_view (Loc (v2 :num) (v3 :num) :α word_loc) = Error
is_some_loc_to_pc_prefix_typed=IS_SOME (loc_to_pc (n :num) (k :num) (c1 :α sec list)) ∧ c1 ≼ (c2 :α sec list) ⇒ IS_SOME (loc_to_pc n k c2)
no_ret_correct_typed=∀(t :bool) (p :α prog) (y :num) (z :num) (cs :num list) (bs :num list). FST (SND (flatten t p y z cs bs)) ⇒ ∀(s :(α, β, γ) stackSem$state). IS_SOME (FST (evaluate (p,s) :α stackSem$result option # (α, β, γ) stackSem$state))
NOT_MEM_find_lab_IMP_typed=∀(bs :num list) (n :num). ¬MEM (find_lab n bs) bs ⇒ find_lab n bs = (0 :num)
