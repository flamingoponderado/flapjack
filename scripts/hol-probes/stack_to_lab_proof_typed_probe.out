word_cmp_not_NONE_typed=(word_cmp (cmp :cmp) (Word (w1 :α word)) (Word (w2 :α word)) :bool option) ≠ (NONE :bool option)
word_sh_word_shift_typed=word_sh (a :ast$shift) (b :α word) (c :num) = SOME (z :α word) ⇒ c < dimindex (:α) ∧ z = (word_shift a b c :α word)
loc_check_IMP_loc_to_pc_typed=loc_check (s :(α, β, γ) stackSem$state).code ((l1 :num),(l2 :num)) ∧ (state_rel s (t1 :(α, β, γ) labSem$state) :bool) ⇒ ∃(v :num). loc_to_pc l1 l2 t1.code = SOME v
mem_store_upd_mem_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ∧ (mem_store (x :α word) (y :α word_loc) s :(α, β, γ) stackSem$state option) = SOME (s1 :(α, β, γ) stackSem$state) ⇒ (state_rel s1 (upd_mem x y t) :bool)
set_fp_var_upd_fp_reg_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ⇒ (state_rel (set_fp_var (a :num) (b :word64) s) (upd_fp_reg a b t) :bool)
set_var_upd_reg_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ⇒ (state_rel (set_var (a :num) (b :α word_loc) s) (upd_reg a b t) :bool)
set_var_Word_upd_reg_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ⇒ (state_rel (set_var (a :num) (Word (b :α word)) s) (upd_reg a (Word b) t) :bool)
state_rel_def_typed=∀(s :(α, γ, 'ffi) stackSem$state) (t :(α, γ, 'ffi) labSem$state). (state_rel s t :bool) ⇔ (∀(n :num) (v :α word_loc). FLOOKUP s.regs n = SOME v ⇒ (read_reg n t :α word_loc) = v) ∧ (∀(n :num) (v :word64). FLOOKUP s.fp_regs n = SOME v ⇒ (t.fp_regs n :word64) = v) ∧ t.mem = s.memory ∧ t.mem_domain = s.mdomain ∧ t.shared_mem_domain = s.sh_mdomain ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ t.clock = s.clock ∧ (∀(n :num) (prog :α prog). (lookup n s.code :α prog option) = SOME prog ⇒ call_args prog t.ptr_reg t.len_reg t.ptr2_reg t.len2_reg t.link_reg ∧ ∃(pc :num). code_installed pc (append (FST (flatten T prog n (next_lab prog (2 :num)) ([] :num list) ([] :num list)))) t.code ∧ loc_to_pc n (0 :num) t.code = SOME pc) ∧ (domain s.code :num -> bool) = set (MAP (Section_num :α sec -> num) t.code) ∧ EVERY (sec_labels_ok :α sec -> bool) t.code ∧ ¬t.failed ∧ t.link_reg ≠ t.len_reg ∧ t.link_reg ≠ t.ptr_reg ∧ t.link_reg ≠ t.len2_reg ∧ t.link_reg ≠ t.ptr2_reg ∧ t.link_reg ∉ s.ffi_save_regs ∧ (∀(k :num) (i :ffiname) (n :num). k ∈ s.ffi_save_regs ⇒ t.io_regs n i k = (NONE :α word option)) ∧ (∀(k :num) (n :num). k ∈ s.ffi_save_regs ⇒ t.cc_regs n k = (NONE :α word option)) ∧ (∀(x :α word). x ∈ s.mdomain ⇒ w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num)) ∧ (∀(x :α word). x ∈ s.sh_mdomain ⇒ w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num)) ∧ s.code_buffer = t.code_buffer ∧ s.compile = (λ(c :γ) (p :(num # α prog) list). (t.compile c (MAP (prog_to_section :num # α prog -> α sec) p) :(word8 list # γ) option)) ∧ t.compile_oracle = (λ(n :num). (let ((c :γ),(p :(num # α prog) list),(_0 :α word list)) = (s.compile_oracle n :γ # (num # α prog) list # α word list) in (c,MAP (prog_to_section :num # α prog -> α sec) p))) ∧ (∀(k :num). (let ((c :γ),(ps :(num # α prog) list),(_1 :α word list)) = (s.compile_oracle k :γ # (num # α prog) list # α word list) in EVERY (λ((n :num),(p :α prog)). call_args p t.ptr_reg t.len_reg t.ptr2_reg t.len2_reg t.link_reg ∧ EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p)) ps ∧ ALL_DISTINCT (MAP (FST :num # α prog -> num) ps))) ∧ ¬s.use_stack ∧ ¬s.use_store ∧ ¬s.use_alloc ∧ good_dimindex (:α)
state_rel_dec_clock_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ⇒ (state_rel (dec_clock s :(α, β, γ) stackSem$state) (dec_clock t :(α, β, γ) labSem$state) :bool)
state_rel_get_var_imm_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ∧ get_var_imm (r :α reg_imm) s = SOME (x :α word_loc) ⇒ (reg_imm r t :α word_loc) = x
state_rel_read_fp_reg_FLOOKUP_fp_regs_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ∧ get_fp_var (n :num) s = SOME (x :word64) ⇒ x = read_fp_reg n t
state_rel_read_reg_FLOOKUP_regs_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ∧ FLOOKUP s.regs (x :num) = SOME (y :α word_loc) ⇒ y = (read_reg x t :α word_loc)
state_rel_with_clock_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ⇒ (state_rel (s with clock := (k :num)) (t with clock := k) :bool)
state_rel_with_pc_typed=(state_rel (s :(α, β, γ) stackSem$state) (t :(α, β, γ) labSem$state) :bool) ⇒ (state_rel s (upd_pc (pc :num) t) :bool)
