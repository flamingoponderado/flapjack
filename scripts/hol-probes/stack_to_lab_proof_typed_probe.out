ALOOKUP_PARTITION_typed=∀(ls :(α # β) list) (n :α) (v :β). ALOOKUP ls n = SOME v ⇒ ∃(ls1 :(α # β) list) (ls2 :(α # β) list). ls = ls1 ++ [(n,v)] ++ ls2 ∧ ¬MEM n (MAP (FST :α # β -> α) ls1)
asm_fetch_aux_add_typed=∀(ys :α line list) (pc :num) (rest :α sec list). asm_fetch_aux (pc + LENGTH (FILTER (λ(x :α line). ¬is_Label x) ys)) (Section (pos :num) ys::rest) = asm_fetch_aux pc rest
asm_fetch_aux_SOME_append2_typed=∀(pc :num) (code :α sec list) (l :α line) (code2 :α sec list). asm_fetch_aux pc code2 = SOME l ⇒ asm_fetch_aux (LENGTH (FLAT (MAP (FILTER ($¬ ∘ (is_Label :α line -> bool)) ∘ (Section_lines :α sec -> α line list)) code)) + pc) (code ++ code2) = SOME l
code_installed_def_typed=(∀(n :num) (code :α sec list). code_installed n ([] :α line list) code ⇔ T) ∧ ∀(n :num) (x :α line) (xs :α line list) (code :α sec list). code_installed n (x::xs) code ⇔ if is_Label x then (case x of (Label l1 l2 v2 :α line) => loc_to_pc l1 l2 code = SOME n | Asm v3 v4 v5 => (ARB :bool) | LabAsm v9 v10 v11 v12 => (ARB :bool)) ∧ code_installed n xs code else asm_fetch_aux n code = SOME x ∧ code_installed (n + (1 :num)) xs code
code_installed_APPEND_typed=∀(ls :α line list) (pc :num) (code :α sec list) (code2 :α sec list). code_installed pc ls code ⇒ code_installed pc ls (code ++ code2)
code_installed_append2_typed=∀(lines :α line list) (pc :num) (c1 :α sec list) (c2 :α sec list) (k :num). ¬MEM k (MAP (Section_num :α sec -> num) c1) ∧ EVERY (sec_labels_ok :α sec -> bool) c1 ∧ EVERY (sec_label_ok k :α line -> bool) lines ∧ code_installed pc lines c2 ⇒ code_installed (LENGTH (FLAT (MAP (FILTER ($¬ ∘ (is_Label :α line -> bool)) ∘ (Section_lines :α sec -> α line list)) c1)) + pc) lines (c1 ++ c2)
code_installed_append_imp_typed=∀(l1 :α line list) (pc :num) (l2 :α line list) (code :α sec list). code_installed pc (l1 ++ l2) code ⇒ code_installed pc l1 code ∧ code_installed (pc + LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) l1)) l2 code
code_installed_cons_typed=∀(xs :α line list) (ys :α line list) (pos :num) (pc :num). code_installed' pc xs (rest :α sec list) ⇒ code_installed' (pc + LENGTH (FILTER (λ(x :α line). ¬is_Label x) ys)) xs (Section pos ys::rest)
code_installed_eq_typed=∀(pc :num) (xs :α line list) (code :α sec list). code_installed pc xs code ⇔ code_installed' pc xs code ∧ labs_correct pc xs code
code_installed_isPREFIX_typed=∀(ls :α line list) (pc :num) (code :α sec list) (code2 :α sec list). code_installed pc ls code ∧ code ≼ code2 ⇒ code_installed pc ls code2
code_installed_prog_to_section_typed=∀(prog4 :(num # α prog) list) (n :num) (prog3 :α prog). labels_ok (MAP (prog_to_section :num # α prog -> α sec) prog4) ∧ ALOOKUP prog4 n = SOME prog3 ⇒ ∃(pc :num). code_installed pc (append (FST (flatten T prog3 n (next_lab prog3 (2 :num)) ([] :num list) ([] :num list)))) (MAP (prog_to_section :num # α prog -> α sec) prog4) ∧ loc_to_pc n (0 :num) (MAP (prog_to_section :num # α prog -> α sec) prog4) = SOME pc
labels_ok_def_typed=∀(code :α sec list). labels_ok code ⇔ ALL_DISTINCT (MAP (λ(s :α sec). case s of Section n v1 => n) code) ∧ EVERY (λ(s :α sec). case s of Section n lines => (let (labs :(num # num) list) = extract_labels lines in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num)) labs ∧ ALL_DISTINCT labs)) code
labels_ok_imp_typed=∀(code :α sec list). labels_ok code ⇒ EVERY (sec_labels_ok :α sec -> bool) code ∧ ALL_DISTINCT (MAP (Section_num :α sec -> num) code) ∧ EVERY ((ALL_DISTINCT :(num # num) list -> bool) ∘ (extract_labels :α line list -> (num # num) list) ∘ (Section_lines :α sec -> α line list)) code
labels_ok_labs_correct_typed=∀(code :α sec list). labels_ok code ⇒ EVERY (λ(s :α sec). case s of Section n lines => case loc_to_pc n (0 :num) code of (NONE :num option) => T | SOME pc => labs_correct pc lines code) code
labs_correct_def_typed=(∀(n :num) (code :β sec list). labs_correct n ([] :α line list) code ⇔ T) ∧ ∀(n :num) (x :α line) (xs :α line list) (code :β sec list). labs_correct n (x::xs) code ⇔ if is_Label x then labs_correct n xs code ∧ case x of (Label l1 l2 v2 :α line) => loc_to_pc l1 l2 code = SOME n | Asm v14 v15 v16 => T | LabAsm v17 v18 v19 v20 => T else labs_correct (n + (1 :num)) xs code
labs_correct_append_typed=∀(ls :α line list) (pc :num). labs_correct pc (ls ++ (rest :α line list)) (code :β sec list) ⇒ labs_correct pc ls code
labs_correct_hd_typed=∀(extra :α line list) (l :α line list). ALL_DISTINCT (extract_labels (extra ++ l)) ∧ EVERY (λ((l1 :num),(l2 :num)). l1 = (n :num) ∧ l2 ≠ (0 :num)) (extract_labels (extra ++ l)) ⇒ labs_correct (LENGTH (FILTER (λ(x :α line). ¬is_Label x) extra)) l (Section n (extra ++ l)::(code :α sec list))
loc_to_pc_APPEND_typed=∀(n :num) (m :num) (code :α sec list) (pc :num) (code2 :α sec list). loc_to_pc n m code = SOME pc ⇒ loc_to_pc n m (code ++ code2) = SOME pc
loc_to_pc_append2_typed=∀(k :num) (ll :num) (code :α sec list) (code2 :α sec list) (pc :num). ¬MEM k (MAP (Section_num :α sec -> num) code) ∧ EVERY (sec_labels_ok :α sec -> bool) code ∧ loc_to_pc k ll code2 = SOME pc ⇒ loc_to_pc k ll (code ++ code2) = SOME (pc + LENGTH (FLAT (MAP (FILTER ($¬ ∘ (is_Label :α line -> bool)) ∘ (Section_lines :α sec -> α line list)) code)))
loc_to_pc_isPREFIX_typed=∀(n :num) (m :num) (code :α sec list) (pc :num) (code2 :α sec list). loc_to_pc n m code = SOME pc ∧ code ≼ code2 ⇒ loc_to_pc n m code2 = SOME pc
loc_to_pc_skip_section_typed=∀(lines :α line list). (n :num) ≠ (p :num) ⇒ loc_to_pc n (0 :num) (Section p lines::(xs :α sec list)) = case loc_to_pc n (0 :num) xs of (NONE :num option) => (NONE :num option) | SOME k => SOME (k + LENGTH (FILTER (λ(x :α line). ¬is_Label x) lines))
MAP_prog_to_section_Section_num_typed=MAP (Section_num :α sec -> num) (MAP (prog_to_section :num # α prog -> α sec) (prog :(num # α prog) list)) = MAP (FST :num # α prog -> num) prog
next_lab_non_zero_typed=∀(p :α prog). (1 :num) ≤ next_lab p (1 :num) ∧ (2 :num) ≤ next_lab p (2 :num)
stack_to_lab_compile_lab_pres_typed=EVERY (λ(n :num). n ≠ (0 :num) ∧ n ≠ (1 :num) ∧ n ≠ (2 :num) ∧ n ≠ gc_stub_location) (MAP (FST :num # α prog -> num) (prog :(num # α prog) list)) ∧ EVERY (λ((n :num),(p :α prog)). (let (labs :(num # num) list) = extract_labels p in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) labs ∧ ALL_DISTINCT labs)) prog ∧ ALL_DISTINCT (MAP (FST :num # α prog -> num) prog) ⇒ labels_ok (compile (c :stack_to_lab$config) (c2 :data_to_word$config) (c3 :num) (sp :num) (offset :α word # α word) prog :α sec list)
compile_all_enc_ok_pre_typed=byte_offset_ok (c :α asm_config) (0w :α word) ∧ EVERY (λ((n :num),(p :α prog)). stack_asm_ok c p) (prog :(num # α prog) list) ⇒ all_enc_ok_pre c (MAP (prog_to_section :num # α prog -> α sec) prog)
EVERY_sec_ends_with_label_MAP_prog_to_section_typed=∀(prog :(num # α prog) list). EVERY (sec_ends_with_label :α sec -> bool) (MAP (prog_to_section :num # α prog -> α sec) prog)
