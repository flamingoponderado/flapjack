IMP_init_state_ok_typed=(4 :num) < (kkk :num) ∧ (bitmaps :α word list) = (4w :α word)::(t :α word list) ∧ good_dimindex (:α) ∧ (∀(n :num). (λ(((bm0 :num),(cfg :β)),(progs :(num # num # α wordLang$prog) list)). EVERY ((post_alloc_conventions kkk :α wordLang$prog -> bool) ∘ (SND :num # α wordLang$prog -> α wordLang$prog) ∘ (SND :num # num # α wordLang$prog -> num # α wordLang$prog)) progs ∧ EVERY ((flat_exp_conventions :α wordLang$prog -> bool) ∘ (SND :num # α wordLang$prog -> α wordLang$prog) ∘ (SND :num # num # α wordLang$prog -> num # α wordLang$prog)) progs ∧ EVERY ((λ(y :num). raise_stub_location ≠ y) ∘ (FST :num # num # α wordLang$prog -> num)) progs ∧ EVERY ((λ(y :num). store_consts_stub_location ≠ y) ∘ (FST :num # num # α wordLang$prog -> num)) progs ∧ (n = (0 :num) ⇒ bm0 = LENGTH bitmaps)) ((word_oracle :num -> (num # β) # (num # num # α wordLang$prog) list) n)) ∧ (stack_oracle :num -> β # (num # α prog) list # α word list) = (λ(n :num). (λ(((bm0 :num),(cfg :β)),(progs :(num # num # α wordLang$prog) list)). (λ((progs :(num # α prog) list),(fs :num list),(bm :α word app_list # num)). (cfg,progs,append (FST bm))) (compile_word_to_stack (ac :α asm_config) F kkk progs ((Nil :α word app_list),bm0))) (word_oracle n)) ∧ full_make_init (scc :stack_to_lab$config) (dc :data_to_word$config) (max_heap :num) (stk :num) (stoff :α word # α word) bitmaps (p6 :(num # α prog) list) (lab_st :(α, β, γ) labSem$state) (save_regs :num -> bool) (data_sp :num) stack_oracle = ((fmis :(α, β, γ) stackSem$state),SOME (xxx :(α, β, γ) stackSem$state)) ⇒ init_state_ok ac kkk fmis word_oracle
