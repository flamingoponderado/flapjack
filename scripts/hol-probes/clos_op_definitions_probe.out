dest_op_typed=dest_Op (f :op -> α option) (Op (t :tra) (op :op) (xs :exp list)) = (case f op of (NONE :α option) => (NONE :(α # exp list) option) | SOME i => SOME (i,xs)) ∧ dest_Op f (Var (v2 :tra) (v3 :num) :exp) = (NONE :(α # exp list) option) ∧ dest_Op f (If (v4 :tra) (v5 :exp) (v6 :exp) (v7 :exp) :exp) = (NONE :(α # exp list) option) ∧ dest_Op f (Let (v8 :tra) (v9 :exp list) (v10 :exp)) = (NONE :(α # exp list) option) ∧ dest_Op f (Raise (v11 :tra) (v12 :exp) :exp) = (NONE :(α # exp list) option) ∧ dest_Op f (Handle (v13 :tra) (v14 :exp) (v15 :exp) :exp) = (NONE :(α # exp list) option) ∧ dest_Op f (Tick (v16 :tra) (v17 :exp)) = (NONE :(α # exp list) option) ∧ dest_Op f (Call (v18 :tra) (v19 :num) (v20 :num) (v21 :exp list)) = (NONE :(α # exp list) option) ∧ dest_Op f (App (v22 :tra) (v23 :num option) (v24 :exp) (v25 :exp list) :exp) = (NONE :(α # exp list) option) ∧ dest_Op f (Fn (v26 :mlstring) (v27 :num option) (v28 :num list option) (v29 :num) (v30 :exp)) = (NONE :(α # exp list) option) ∧ dest_Op f (Letrec (v31 :mlstring list) (v32 :num option) (v33 :num list option) (v34 :(num # exp) list) (v35 :exp) :exp) = (NONE :(α # exp list) option)
dest_op_nil_typed=∀(f :op -> α option) (x :exp). dest_Op_Nil f x = case dest_Op f x of (NONE :(α # exp list) option) => (NONE :α option) | SOME (i,xs) => if NULL xs then SOME i else (NONE :α option)
dest_op_consts_typed=∀(x :exp) (y :exp). dest_Op_Consts x y = case dest_Op_Nil dest_Const x of (NONE :int option) => (NONE :(int # int) option) | SOME i => case dest_Op_Nil dest_Const y of (NONE :int option) => (NONE :(int # int) option) | SOME j => SOME (i,j)
make_bool_typed=∀(b :bool). MakeBool b = Op None (BlockOp (Cons (if b then (1 :num) else (0 :num)) :block_op)) ([] :exp list)
make_int_typed=∀(i :int). MakeInt i = Op None (IntOp (Const i)) ([] :exp list)
int_op_typed=∀(op :op) (i :int) (j :int). int_op op i j = if op = IntOp Add then SOME (MakeInt (j + i)) else if op = IntOp Sub then SOME (MakeInt (j − i)) else if op = IntOp Mult then SOME (MakeInt (j * i)) else if op = IntOp Div then SOME (MakeInt (if i = (0 :int) then (0 :int) else j / i)) else if op = IntOp Mod then SOME (MakeInt (if i = (0 :int) then (0 :int) else j % i)) else if op = IntOp Less then SOME (MakeBool (j < i)) else if op = IntOp LessEq then SOME (MakeBool (j ≤ i)) else if op = IntOp Greater then SOME (MakeBool (i < j)) else if op = IntOp GreaterEq then SOME (MakeBool (i ≤ j)) else if op = BlockOp Equal then SOME (MakeBool (j = i)) else (NONE :exp option)
cons_op_typed=∀(op :op) (t :num) (xs :exp list). cons_op op t xs = case dest_ElemAt op of (NONE :num option) => (case dest_TagLenEq op of (NONE :(num # num) option) => (case dest_TagEq op of (NONE :num option) => (case dest_LenEq op of (NONE :num option) => (NONE :exp option) | SOME l => SOME (Let None xs (MakeBool (LENGTH xs = l)))) | SOME n => SOME (Let None xs (MakeBool (n = t)))) | SOME (n,l) => SOME (Let None xs (MakeBool (n = t ∧ LENGTH xs = l)))) | SOME n => if n < LENGTH xs then SOME (Let None xs (Var None (LENGTH xs − (n + (1 :num))) :exp)) else (NONE :exp option)
is_var_typed=(is_Var (Var (v0 :tra) (v1 :num) :exp) ⇔ T) ∧ (is_Var (If (v4 :tra) (v5 :exp) (v6 :exp) (v7 :exp) :exp) ⇔ F) ∧ (is_Var (Let (v8 :tra) (v9 :exp list) (v10 :exp)) ⇔ F) ∧ (is_Var (Raise (v11 :tra) (v12 :exp) :exp) ⇔ F) ∧ (is_Var (Handle (v13 :tra) (v14 :exp) (v15 :exp) :exp) ⇔ F) ∧ (is_Var (Tick (v16 :tra) (v17 :exp)) ⇔ F) ∧ (is_Var (Call (v18 :tra) (v19 :num) (v20 :num) (v21 :exp list)) ⇔ F) ∧ (is_Var (App (v22 :tra) (v23 :num option) (v24 :exp) (v25 :exp list) :exp) ⇔ F) ∧ (is_Var (Fn (v26 :mlstring) (v27 :num option) (v28 :num list option) (v29 :num) (v30 :exp)) ⇔ F) ∧ (is_Var (Letrec (v31 :mlstring list) (v32 :num option) (v33 :num list option) (v34 :(num # exp) list) (v35 :exp) :exp) ⇔ F) ∧ (is_Var (Op (v36 :tra) (v37 :op) (v38 :exp list)) ⇔ F)
eq_direct_nil_typed=∀(x :exp) (y :exp). eq_direct_nil x y = case dest_Op_Nil dest_Cons x of (NONE :num option) => (case dest_Op_Nil dest_Cons y of (NONE :num option) => (NONE :exp option) | SOME i => SOME (Op None (BlockOp (TagLenEq i (0 :num))) [x])) | SOME i => case dest_Op_Nil dest_Cons y of (NONE :num option) => SOME (Op None (BlockOp (TagLenEq i (0 :num))) [y]) | SOME j => SOME (MakeBool (i = j))
eq_direct_const_typed=∀(x :exp) (y :exp). eq_direct_const x y = case dest_Op_Nil dest_Const x of (NONE :int option) => (case dest_Op_Nil dest_Const y of (NONE :int option) => (NONE :exp option) | SOME i => SOME (Op None (BlockOp (EqualConst (Int i))) [x])) | SOME i => case dest_Op_Nil dest_Const y of (NONE :int option) => SOME (Op None (BlockOp (EqualConst (Int i))) [y]) | SOME j => SOME (MakeBool (i = j))
eq_direct_constant_typed=∀(x :exp) (y :exp). eq_direct_constant x y = case dest_Op_Nil dest_Constant x of (NONE :const_part option) => (case dest_Op_Nil dest_Constant y of (NONE :const_part option) => (NONE :exp option) | SOME p => SOME (Op None (BlockOp (EqualConst p)) [x])) | SOME p => case dest_Op_Nil dest_Constant y of (NONE :const_part option) => SOME (Op None (BlockOp (EqualConst p)) [y]) | SOME q => SOME (MakeBool (q = p))
eq_direct_typed=∀(x :exp) (y :exp). eq_direct x y = case eq_direct_const x y of (NONE :exp option) => (case eq_direct_constant x y of (NONE :exp option) => eq_direct_nil x y | SOME res => SOME res) | SOME res => SOME res
dont_lift_typed=∀(x :exp). dont_lift x ⇔ case dest_Op_Nil dest_Const x of (NONE :int option) => (case dest_Op_Nil dest_Cons x of (NONE :num option) => (case dest_Op_Nil dest_Constant x of (NONE :const_part option) => F | SOME t => T) | SOME t => T) | SOME i => T
