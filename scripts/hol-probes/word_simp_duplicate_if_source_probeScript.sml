load "bossLib"; load "preamble"; load "word_simpTheory";
open HolKernel Parse bossLib preamble word_simpTheory;
val _ = Globals.linewidth := 1000;
fun out label term = (print (label ^ "="); print_term (rhs (concl (EVAL term))); print "\n");
val rt = ``(Seq (If Less 1 (Reg 2) (Assign 3 (Const 1w)) (Assign 3 (Const 0w))) (Seq (Assign 4 (Var 3)) (If NotEqual 4 (Imm 0w) (Assign 5 (Const 7w)) Skip)):64 wordLang$prog)``;
val _ = out "duplicate_roundtrip" ``compile_exp ^rt``;
val _ = out "duplicate_must" ``compile_exp (MustTerminate ^rt)``;
val _ = out "duplicate_loop" ``compile_exp (Loop LN ^rt LN)``;
val _ = out "duplicate_call_return" ``compile_exp (Call (SOME([], (LN,LN),^rt,3,4)) (SOME 7) [1] NONE)``;
val _ = out "duplicate_call_handler" ``compile_exp (Call NONE (SOME 7) [1] (SOME(1,^rt,3,4)))``;
val _ = out "duplicate_call_both" ``compile_exp (Call (SOME([], (LN,LN),^rt,3,4)) (SOME 7) [1] (SOME(1,^rt,5,6)))``;
val _ = out "duplicate_if" ``compile_exp (If Equal 8 (Imm 0w) ^rt Tick)``;
val _ = out "duplicate_no_hoist" ``simp_duplicate_if (Seq Tick Skip:64 wordLang$prog)``;
val _ = out "duplicate_zero_bound" ``try_if_hoist2 0 ^rt Skip Tick Skip``;
val _ = out "duplicate_non_simple" ``is_simple (Store (Var 1) 2:64 wordLang$prog)``;
val _ = out "duplicate_move_simple" ``is_simple (Move 0 [(1,2)]:64 wordLang$prog)``;
val _ = out "duplicate_raise_other" ``dest_Raise_num (Tick:64 wordLang$prog)``;
val _ = out "duplicate_raise_zero" ``dest_Raise_num (Raise 0:64 wordLang$prog)``;
val _ = out "duplicate_raise_three" ``dest_Raise_num (Raise 3:64 wordLang$prog)``;
