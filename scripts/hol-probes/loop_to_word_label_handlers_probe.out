comp_l_invariant_source_replay=⊢ ∀ctxt prog l prog' l'. comp ctxt prog l = (prog',l') ⇒ FST l' = FST l
good_handlers_comp_source_replay=⊢ ∀ctxt prog l. word_good_handlers (FST l) (FST (comp ctxt prog l))
loop_to_word_good_handlers_source_replay=⊢ ∀prog' prog.
    compile_prog prog = prog' ⇒
    EVERY (λ(n,m,pp). word_good_handlers n pp) prog'
loop_to_word_comp_SND_LE_source_replay=⊢ ∀ctxt prog l p r. comp ctxt prog l = (p,r) ⇒ SND l ≤ SND r
