upshift_full_def=∀r n. upshift r n = if n ≤ max_stack_alloc then Inst (Arith (Binop Add r r (Imm (word_offset n)))) else Seq (Inst (Arith (Binop Add r r (Imm (word_offset max_stack_alloc))))) (upshift r (n − max_stack_alloc))
upshift_type=:num -> num -> α prog
downshift_full_def=∀r n. downshift r n = if n ≤ max_stack_alloc then Inst (Arith (Binop Sub r r (Imm (word_offset n)))) else Seq (Inst (Arith (Binop Sub r r (Imm (word_offset max_stack_alloc))))) (downshift r (n − max_stack_alloc))
downshift_type=:num -> num -> α prog
stack_store_full_def=∀k r n. stack_store k r n = Seq (upshift k n) (Seq (store_inst r k) (downshift k n))
stack_store_type=:num -> num -> num -> α prog
stack_load_full_def=∀r n. stack_load r n = Seq (upshift r n) (load_inst r r)
stack_load_type=:num -> num -> α prog
