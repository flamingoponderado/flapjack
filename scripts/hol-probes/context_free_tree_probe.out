merge_locs=⊢ merge_locs (Locs (l1 :locn) (l2 :locn)) (Locs (l3 :locn) (l4 :locn)) = Locs l1 l4
merge_list=⊢ merge_list_locs ([] :locs list) = unknown_loc ∧ (∀(h :locs). merge_list_locs [h] = h) ∧ (∀(h2 :locs) (h1 :locs). merge_list_locs [h1; h2] = merge_locs h1 h2) ∧ ∀(v5 :locs list) (v4 :locs) (h2 :locs) (h1 :locs). merge_list_locs (h1::h2::v4::v5) = merge_list_locs (h1::v4::v5)
is_tok=⊢ (∀(tok :α). isTOK (TOK tok :(α, β) symbol) ⇔ T) ∧ ∀(n :β + num). isTOK (NT n :(α, β) symbol) ⇔ F
dest_tok=⊢ destTOK ((TOK (tk :α) :(α, β) symbol),(v0 :γ)) = SOME tk ∧ destTOK ((NT (v6 :β + num) :(α, β) symbol),(v2 :γ)) = (NONE :α option)
ptree_loc=⊢ ptree_loc (Lf ((v0 :(β, γ) symbol),(l :α))) = l ∧ ptree_loc (Nd ((v1 :γ + num),l) (v2 :(β, γ, α) parsetree list)) = l
ptree_list_loc=⊢ ∀(l :(α, β, locs) parsetree list). ptree_list_loc l = merge_list_locs (MAP (ptree_loc :(α, β, locs) parsetree -> locs) l)
ptree_head=⊢ ptree_head (Lf ((tok :(α, β) symbol),(l :γ))) = tok ∧ ptree_head (Nd ((nt :β + num),l) (children :(α, β, γ) parsetree list)) = (NT nt :(α, β) symbol)
ptree_fringe=⊢ (∀(v0 :γ) (t :(α, β) symbol). ptree_fringe (Lf (t,v0)) = [t]) ∧ ∀(v1 :(β + num) # γ) (children :(α, β, γ) parsetree list). ptree_fringe (Nd v1 children) = FLAT (MAP (ptree_fringe :(α, β, γ) parsetree -> (α, β) symbol list) children)
real_fringe=⊢ (∀(t :(α, β) symbol # γ). real_fringe (Lf t) = [t]) ∧ ∀(ptl :(α, β, γ) parsetree list) (n :(β + num) # γ). real_fringe (Nd n ptl) = FLAT (MAP (λ(a :(α, β, γ) parsetree). real_fringe a) ptl)
valid_locs=⊢ (∀(v0 :(α, β) symbol # locs). valid_locs (Lf v0) ⇔ T) ∧ ∀(v1 :β + num) (l :locs) (children :(α, β, locs) parsetree list). valid_locs (Nd (v1,l) children) ⇔ l = merge_list_locs (MAP (ptree_loc :(α, β, locs) parsetree -> locs) children) ∧ ∀(pt :(α, β, locs) parsetree). MEM pt children ⇒ valid_locs pt
valid_ptree=⊢ (∀(v0 :(α, β) symbol # γ) (G :(α, β) grammar). valid_ptree G (Lf v0) ⇔ T) ∧ ∀(nt :β + num) (l :γ) (children :(α, β, γ) parsetree list) (G :(α, β) grammar). valid_ptree G (Nd (nt,l) children) ⇔ nt ∈ FDOM G.rules ∧ MAP (ptree_head :(α, β, γ) parsetree -> (α, β) symbol) children ∈ G.rules⟨nt⟩ ∧ ∀(pt :(α, β, γ) parsetree). MEM pt children ⇒ valid_ptree G pt
complete_ptree=⊢ ∀(G :(α, β) grammar) (pt :(α, β, γ) parsetree). complete_ptree G pt ⇔ valid_ptree G pt ∧ ptree_head pt = (NT G.start :(α, β) symbol) ∧ ∀(t :(α, β) symbol). MEM t (ptree_fringe pt) ⇒ isTOK t
valid_lptree=⊢ ∀(G :(α, β) grammar) (pt :(α, β, locs) parsetree). valid_lptree G pt ⇔ valid_locs pt ∧ valid_ptree G pt
merge_example=⊢ merge_list_locs [Locs (POSN (1 :num) (2 :num)) (POSN (1 :num) (3 :num)); Locs (POSN (4 :num) (5 :num)) (POSN (6 :num) (7 :num))] = Locs (POSN (1 :num) (2 :num)) (POSN (6 :num) (7 :num))
fringe_example=⊢ real_fringe (Nd ((INL (1 :num) :num + num),Locs (POSN (0 :num) (0 :num)) (POSN (0 :num) (2 :num))) [Lf ((TOK (7 :num) :(num, num) symbol),Locs (POSN (0 :num) (0 :num)) (POSN (0 :num) (0 :num))); Lf ((TOK (9 :num) :(num, num) symbol),Locs (POSN (0 :num) (2 :num)) (POSN (0 :num) (2 :num)))]) = [((TOK (7 :num) :(num, num) symbol),Locs (POSN (0 :num) (0 :num)) (POSN (0 :num) (0 :num))); ((TOK (9 :num) :(num, num) symbol),Locs (POSN (0 :num) (2 :num)) (POSN (0 :num) (2 :num)))]
valid_example=⊢ valid_ptree <|start := (INL (1 :num) :num + num); rules := (FEMPTY :num + num |-> ((num, num) symbol list -> bool))⟨(INL (1 :num) :num + num) ↦ {[(TOK (7 :num) :(num, num) symbol); (TOK (9 :num) :(num, num) symbol)]}⟩|> (Nd ((INL (1 :num) :num + num),(0 :num)) [Lf ((TOK (7 :num) :(num, num) symbol),(0 :num)); Lf ((TOK (9 :num) :(num, num) symbol),(2 :num))])
missing_rule=⊢ valid_ptree <|start := (INL (1 :num) :num + num); rules := (FEMPTY :num + num |-> ((num, num) symbol list -> bool))|> (Nd ((INL (1 :num) :num + num),(0 :num)) [Lf ((TOK (7 :num) :(num, num) symbol),(0 :num))]) ⇔ F
