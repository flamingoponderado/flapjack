var_corr_inter_typed=∀(t :α sptree$num_map) (p :β sptree$num_map) (vs :num list) (z :β list). var_corr z vs (inter p t) ⇒ var_corr z vs p
get_vars_mk_wf_typed=∀(vs :num list) (t :α sptree$num_map) (z :α list). (get_vars vs (mk_wf t) :α list option) = SOME z ⇔ (get_vars vs t :α list option) = SOME z
get_vars_inter_typed=∀(vs :num list) (p :α sptree$num_map) (t :β sptree$num_map) (z :α list). (get_vars vs (inter p t) :α list option) = SOME z ⇒ (get_vars vs p :α list option) = SOME z
data_to_bvi_result_def_typed=data_to_bvi_result (Rval (vs :v list) :(v list, v) result) = (Rval (MAP data_to_bvi_v vs) :(bvlSem$v list, exn_or_ret) result) ∧ data_to_bvi_result (Rerr (Rraise (v :v)) :(v list, v) result) = (Rerr (Rraise (Exn (data_to_bvi_v v))) :(bvlSem$v list, exn_or_ret) result) ∧ data_to_bvi_result (Rerr (Rabort (err :abort) :v error_result) :(v list, v) result) = (Rerr (Rabort err :exn_or_ret error_result) :(bvlSem$v list, exn_or_ret) result)
data_to_bvi_result_eq_typed=∀(x :(v list, v) result) (v :exn_or_ret). data_to_bvi_result x = (Rerr (Rraise v) :(bvlSem$v list, exn_or_ret) result) ⇔ ∃(z :v). x = (Rerr (Rraise z) :(v list, v) result) ∧ Exn (data_to_bvi_v z) = v
var_corr_map_typed=∀(p :α sptree$num_map) (f :α -> β) (vs :num list) (z :α list). var_corr z vs p ⇒ var_corr (MAP f z) vs (map f p :β sptree$num_map)
get_vars_lift_thm_typed=∀(vs :num list) (a :bvlSem$v list) (t2 :v sptree$num_map). var_corr a vs (map data_to_bvi_v t2 :bvlSem$v sptree$num_map) ⇒ ∃(z :v list). (get_vars vs t2 :v list option) = SOME z ∧ a = MAP data_to_bvi_v z
data_to_bvi_v_list_to_v_APPEND_typed=∀(l :v list) (vl :v list) (v :v) (ts :num). v_to_list v = SOME vl ⇒ data_to_bvi_v (list_to_v ts v l :v) = data_to_bvi_v (list_to_v ts Block_nil (l ++ vl) :v)
data_to_bvi_v_list_to_v_Nil_typed=∀(z :v list) (ts :num). data_to_bvi_v (list_to_v ts Block_nil z :v) = (list_to_v (MAP data_to_bvi_v z) :bvlSem$v)
v_to_bytes_eq_typed=∀(x :v). v_to_bytes (data_to_bvi_v x) = v_to_bytes x
v_to_words_eq_typed=∀(x :v). v_to_words (data_to_bvi_v x) = v_to_words x
code_rel_def_typed=∀(bvi_code :(num # bvi$exp) sptree$num_map) (data_code :(num # dataLang$prog) sptree$num_map). code_rel bvi_code data_code ⇔ wf bvi_code ∧ wf data_code ∧ (domain bvi_code :num -> bool) = (domain data_code :num -> bool) ∧ ∀(n :num) (exp :bvi$exp) (arg_count :num). (lookup n bvi_code :(num # bvi$exp) option) = SOME (arg_count,exp) ⇒ (lookup n data_code :(num # dataLang$prog) option) = SOME (arg_count,(compile_exp arg_count exp :dataLang$prog))
data_to_bvi_ref_def_typed=(∀(l :v list). data_to_bvi_ref (ValueArray l :v ref) = (ValueArray (MAP data_to_bvi_v l) :bvlSem$v ref)) ∧ (∀(b :bool) (bl :word8 list). data_to_bvi_ref (ByteArray b bl :v ref) = (ByteArray b bl :bvlSem$v ref)) ∧ (∀(m :thunk_mode) (v :v). data_to_bvi_ref (Thunk m v :v ref) = (Thunk m (data_to_bvi_v v) :bvlSem$v ref)) ∧ ∀(tg :num) (fin :bool) (ls :v list) (c :v) (rs :v list). data_to_bvi_ref (MutBlock tg fin ls c rs) = MutBlock tg fin (MAP data_to_bvi_v ls) (data_to_bvi_v c) (MAP data_to_bvi_v rs)
data_to_bvi_v_def_typed=(∀(i :int). data_to_bvi_v (Number i :v) = (Number i :bvlSem$v)) ∧ (∀(w :word64). data_to_bvi_v (Word64 w :v) = (Word64 w :bvlSem$v)) ∧ (∀(p :num). data_to_bvi_v (CodePtr p :v) = (CodePtr p :bvlSem$v)) ∧ (∀(r :num) (b :bool). data_to_bvi_v (RefPtr b r :v) = (RefPtr b r :bvlSem$v)) ∧ ∀(v0 :num) (tag :num) (l :v list). data_to_bvi_v (Block v0 tag l :v) = (Block tag (MAP (λ(a :v). data_to_bvi_v a) l) :bvlSem$v)
data_to_bvi_v_Boolv_typed=∀(b :bool). data_to_bvi_v (Boolv b :v) = (Boolv b :bvlSem$v)
data_to_bvi_v_Unit_typed=data_to_bvi_v Unit = Unit
