eval_distinct_lists_not_affect_prime_typed=∀(vs :num list) (s :(α, β) state) (e :α crepLang$exp) (w :α word_lab) (nvals :α word_lab list). (eval s e :α word_lab option) = SOME w ∧ LENGTH vs = LENGTH nvals ∧ distinct_lists vs (var_cexp e) ⇒ (eval (s with locals := s.locals |++ ZIP (vs,nvals)) e :α word_lab option) = SOME w
opt_mmap_eval_distinct_lists_not_affect_prime_typed=∀(es :α crepLang$exp list) (s :(α, β) state) (ws :γ) (vs :num list) (nvals :α word_lab list). LENGTH vs = LENGTH nvals ∧ distinct_lists vs (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ⇒ OPT_MMAP (eval (s with locals := s.locals |++ ZIP (vs,nvals)) :α crepLang$exp -> α word_lab option) es = OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es
