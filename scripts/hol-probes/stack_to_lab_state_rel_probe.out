state_rel_def_statement=∀s t. state_rel s t ⇔ (∀n v. FLOOKUP s.regs n = SOME v ⇒ read_reg n t = v) ∧ (∀n v. FLOOKUP s.fp_regs n = SOME v ⇒ t.fp_regs n = v) ∧ t.mem = s.memory ∧ t.mem_domain = s.mdomain ∧ t.shared_mem_domain = s.sh_mdomain ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ t.clock = s.clock ∧ (∀n prog. lookup n s.code = SOME prog ⇒ call_args prog t.ptr_reg t.len_reg t.ptr2_reg t.len2_reg t.link_reg ∧ ∃pc. code_installed pc (append (FST (flatten T prog n (next_lab prog 2) [] []))) t.code ∧ loc_to_pc n 0 t.code = SOME pc) ∧ domain s.code = set (MAP Section_num t.code) ∧ EVERY sec_labels_ok t.code ∧ ¬t.failed ∧ t.link_reg ≠ t.len_reg ∧ t.link_reg ≠ t.ptr_reg ∧ t.link_reg ≠ t.len2_reg ∧ t.link_reg ≠ t.ptr2_reg ∧ t.link_reg ∉ s.ffi_save_regs ∧ (∀k i n. k ∈ s.ffi_save_regs ⇒ t.io_regs n i k = NONE) ∧ (∀k n. k ∈ s.ffi_save_regs ⇒ t.cc_regs n k = NONE) ∧ (∀x. x ∈ s.mdomain ⇒ w2n x MOD (dimindex (:α) DIV 8) = 0) ∧ (∀x. x ∈ s.sh_mdomain ⇒ w2n x MOD (dimindex (:α) DIV 8) = 0) ∧ s.code_buffer = t.code_buffer ∧ s.compile = (λc p. t.compile c (MAP prog_to_section p)) ∧ t.compile_oracle = (λn. (let (c,p,_0) = s.compile_oracle n in (c,MAP prog_to_section p))) ∧ (∀k. (let (c,ps,_1) = s.compile_oracle k in EVERY (λ(n,p). call_args p t.ptr_reg t.len_reg t.ptr2_reg t.len2_reg t.link_reg ∧ EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p)) ps ∧ ALL_DISTINCT (MAP FST ps))) ∧ ¬s.use_stack ∧ ¬s.use_store ∧ ¬s.use_alloc ∧ good_dimindex (:α)
loc_check_IMP_loc_to_pc_statement=∀t1 s l2 l1. loc_check s.code (l1,l2) ∧ state_rel s t1 ⇒ ∃v. loc_to_pc l1 l2 t1.code = SOME v
state_rel_dec_clock_statement=∀t s. state_rel s t ⇒ state_rel (dec_clock s) (dec_clock t)
state_rel_with_pc_statement=∀t s pc. state_rel s t ⇒ state_rel s (upd_pc pc t)
state_rel_with_clock_statement=∀t s k. state_rel s t ⇒ state_rel (s with clock := k) (t with clock := k)
set_var_upd_reg_statement=∀t s b a. state_rel s t ⇒ state_rel (set_var a b s) (upd_reg a b t)
set_var_Word_upd_reg_statement=∀t s b a. state_rel s t ⇒ state_rel (set_var a (Word b) s) (upd_reg a (Word b) t)
set_fp_var_upd_fp_reg_statement=∀t s b a. state_rel s t ⇒ state_rel (set_fp_var a b s) (upd_fp_reg a b t)
mem_store_upd_mem_statement=∀y x t s1 s. state_rel s t ∧ mem_store x y s = SOME s1 ⇒ state_rel s1 (upd_mem x y t)
state_rel_read_reg_FLOOKUP_regs_statement=∀y x t s. state_rel s t ∧ FLOOKUP s.regs x = SOME y ⇒ y = read_reg x t
state_rel_read_fp_reg_FLOOKUP_fp_regs_statement=∀x t s n. state_rel s t ∧ get_fp_var n s = SOME x ⇒ x = read_fp_reg n t
state_rel_get_var_imm_statement=∀x t s r. state_rel s t ∧ get_var_imm r s = SOME x ⇒ reg_imm r t = x
