state_rel_cut_env_IMP_cut_env_typed=∀(t :(γ, α, β) wordSem$state) (s :(α, β) dataSem$state) (locs :(num # num) list) (l2 :num) (l1 :num) (kept_names :sptree$num_set) (c :data_to_word$config) (env :v sptree$num_map). (state_rel c l1 l2 s t (NONE :(v # γ word_loc) list option) locs :bool) ∧ cut_env kept_names s.locals = SOME env ⇒ ∃(y :γ word_loc sptree$num_map). cut_env (adjust_sets kept_names) t.locals = SOME y ∧ (state_rel c l1 l2 (s with locals := env) t (NONE :(v # γ word_loc) list option) locs :bool) ∧ (state_rel c l1 l2 (s with locals := env) (t with locals := y) (NONE :(v # γ word_loc) list option) locs :bool)
state_rel_get_var_RefPtr_Loc_typed=(state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(α, β) dataSem$state) (t :(γ, α, β) wordSem$state) (v1 :(v # γ word_loc) list option) (locs :(num # num) list) :bool) ∧ (get_var (n :num) s.locals :v option) = SOME (RefPtr (b :bool) (p :num) :v) ∧ (get_var (adjust_var n) t :γ word_loc option) = SOME (Loc (n1 :num) (n2 :num) :γ word_loc) ⇒ n2 = (0 :num)
state_rel_pop_env_set_vars_IMP_typed=(state_rel (c :data_to_word$config) (q :num) (l :num) (s1 :(γ, 'ffi) dataSem$state) (t1 :(α, γ, 'ffi) wordSem$state) (SOME (ZIP ((as :v list),(ws :α word_loc list)))) (locs :(num # num) list) :bool) ∧ LENGTH as = LENGTH ws ∧ LENGTH (ns :num list) = LENGTH as ∧ ALL_DISTINCT ns ∧ pop_env s1 = SOME (s2 :(γ, 'ffi) dataSem$state) ⇒ ∃(t2 :(α, γ, 'ffi) wordSem$state) (l8 :num) (l9 :num) (ll :(num # num) list). pop_env t1 = SOME t2 ∧ locs = (l8,l9)::ll ∧ (state_rel c l8 l9 (set_vars ns as s2) (set_vars (MAP adjust_var ns) ws t2) (NONE :(v # α word_loc) list option) ll :bool)
