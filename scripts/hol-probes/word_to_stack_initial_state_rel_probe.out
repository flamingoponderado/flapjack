init_state_ok_definition=∀ac k t coracle. init_state_ok ac k t coracle ⇔ 4 < k ∧ good_dimindex (:α) ∧ 8 ≤ dimindex (:α) ∧ t.use_stack ∧ t.use_store ∧ t.use_alloc ∧ gc_fun_ok t.gc_fun ∧ t.stack_space ≤ LENGTH t.stack ∧ FLOOKUP t.regs 0 = SOME (Loc 1 0) ∧ LENGTH t.bitmaps + 1 < dimword (:α) ∧ [4w] ≼ t.bitmaps ∧ LENGTH t.stack < dimword (:α) ∧ DROP t.stack_space t.stack = [Word 0w] ∧ Handler ∈ FDOM t.store ∧ LENGTH t.bitmaps + LENGTH t.data_buffer.buffer + t.data_buffer.space_left + 1 < dimword (:α) ∧ t.compile_oracle = (λn. (let ((bm0,cfg),progs) = coracle n; (progs,fs,bm) = compile_word_to_stack ac F k progs (Nil,bm0) in (cfg,progs,append (FST bm)))) ∧ ∀n. (let ((bm0,cfg),progs) = coracle n in EVERY (post_alloc_conventions k ∘ SND ∘ SND) progs ∧ EVERY (flat_exp_conventions ∘ SND ∘ SND) progs ∧ EVERY ((λy. raise_stub_location ≠ y) ∘ FST) progs ∧ EVERY ((λy. store_consts_stub_location ≠ y) ∘ FST) progs ∧ (n = 0 ⇒ bm0 = LENGTH t.bitmaps))
init_state_ok_hypotheses=0
init_state_ok_type=:α asm_config -> num -> (α, β, γ) stackSem$state -> (num -> (num # β) # (num # num # α prog) list) -> bool
initial_state_relation_statement=∀t k coracle code ac. lookup raise_stub_location t.code = SOME (raise_stub F k) ∧ lookup store_consts_stub_location t.code = SOME (store_consts_stub k) ∧ (∀n word_prog arg_count. lookup n code = SOME (arg_count,word_prog) ⇒ post_alloc_conventions k word_prog ∧ flat_exp_conventions word_prog ∧ ∃bs i bs2 i2 f stack_prog. compile_prog ac F word_prog arg_count k (bs,i) = (stack_prog,f,bs2,i2) ∧ LENGTH (append bs) ≤ i ∧ i − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs2 ≼ DROP (i − LENGTH (append bs)) t.bitmaps ∧ lookup n t.code = SOME stack_prog) ∧ domain t.code = raise_stub_location INSERT store_consts_stub_location INSERT domain code ∧ init_state_ok ac k t coracle ⇒ state_rel ac k 0 0 (make_init ac k t code coracle) t [] 0
initial_state_relation_proved=T
initial_state_relation_hypotheses=0
