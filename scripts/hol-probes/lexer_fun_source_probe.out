symbol_axiom_typed=∀(f0 :string -> α) (f1 :char -> α) (f2 :int -> α) (f3 :num -> α) (f4 :string list -> string -> α) (f5 :string -> α) (f6 :string -> α) (f7 :α). ∃(fn :symbol -> α). (∀(a :string). fn (StringS a) = f0 a) ∧ (∀(a :char). fn (CharS a) = f1 a) ∧ (∀(a :int). fn (NumberS a) = f2 a) ∧ (∀(a :num). fn (WordS a) = f3 a) ∧ (∀(a0 :string list) (a1 :string). fn (LongS a0 a1) = f4 a0 a1) ∧ (∀(a :string). fn (FFIS a) = f5 a) ∧ (∀(a :string). fn (OtherS a) = f6 a) ∧ fn ErrorS = f7
next_loc_def_typed=next_loc (n :num) (POSN (r :num) (c :num)) = POSN r (c + n) ∧ next_loc n UNKNOWNpt = UNKNOWNpt ∧ next_loc n EOFpt = EOFpt
next_line_def_typed=next_line (POSN (r :num) (c :num)) = POSN (r + (1 :num)) (0 :num) ∧ next_line UNKNOWNpt = UNKNOWNpt ∧ next_line EOFpt = EOFpt
get_token_def_typed=∀(s :string). get_token s = if s = "#" then HashT else if s = "(" then LparT else if s = ")" then RparT else if s = "*" then StarT else if s = "," then CommaT else if s = "->" then ArrowT else if s = "..." then DotsT else if s = ":" then ColonT else if s = ":>" then SealT else if s = ";" then SemicolonT else if s = "=" then EqualsT else if s = "=>" then DarrowT else if s = "[" then LbrackT else if s = "]" then RbrackT else if s = "_" then UnderbarT else if s = "{" then LbraceT else if s = "}" then RbraceT else if s = "|" then BarT else if s = "and" then AndT else if s = "andalso" then AndalsoT else if s = "as" then AsT else if s = "case" then CaseT else if s = "datatype" then DatatypeT else if s = "else" then ElseT else if s = "end" then EndT else if s = "eqtype" then EqtypeT else if s = "exception" then ExceptionT else if s = "fn" then FnT else if s = "fun" then FunT else if s = "handle" then HandleT else if s = "if" then IfT else if s = "in" then InT else if s = "include" then IncludeT else if s = "let" then LetT else if s = "local" then LocalT else if s = "of" then OfT else if s = "op" then OpT else if s = "open" then OpenT else if s = "orelse" then OrelseT else if s = "raise" then RaiseT else if s = "rec" then RecT else if s = "sharing" then SharingT else if s = "sig" then SigT else if s = "signature" then SignatureT else if s = "struct" then StructT else if s = "structure" then StructureT else if s = "then" then ThenT else if s = "type" then TypeT else if s = "val" then ValT else if s = "where" then WhereT else if s = "with" then WithT else if s = "withtype" then WithtypeT else if s ≠ ("" :string) ∧ HD s = #"'" then TyvarT (implode s) else processIdent s
to_path_def_typed=to_path ([] :mlstring list) = End ∧ ∀(x :mlstring) (xs :mlstring list). to_path (x::xs) = Mod x (to_path xs)
token_of_sym_def_typed=∀(s :symbol). token_of_sym s = case s of StringS s => StringT (implode s) | CharS c => CharT c | NumberS i => IntT i | WordS n => WordT n | LongS xs s' => LongidT (to_path (MAP implode xs)) (implode s') | FFIS s'' => FFIT (implode s'') | OtherS s'³' => get_token s'³' | ErrorS => LexErrorT
