stack_frames_def_typed=⊢ ∀(c :α asm_config) (word_prog :(num # num # β prog) list). probe_compute_stack_frame_sizes c word_prog = (let (reg_count :num) = c.reg_count − LENGTH c.avoid_regs − (5 :num) in (mapi (λ(n :num) ((arg_count :num),(prog :β prog)). (let (stack_arg_count :num) = arg_count − reg_count; (stack_var_count :num) = MAX (max_var prog DIV (2 :num) + (1 :num) − reg_count) stack_arg_count in if stack_var_count = (0 :num) then (0 :num) else stack_var_count + (1 :num))) (fromAList word_prog) :num sptree$num_map))
stack_frames_thm_typed=⊢ probe_compute_stack_frame_sizes (c :α asm_config) (word_prog :(num # num # α prog) list) = (let (k :num) = c.reg_count − LENGTH c.avoid_regs − (5 :num) in (mapi (λ(n :num) ((arg_count :num),(prog :α prog)). FST (SND (compile_prog c F prog arg_count k ((Nil :α word app_list),(0 :num))))) (fromAList word_prog) :num sptree$num_map))
