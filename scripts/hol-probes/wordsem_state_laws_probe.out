get_var_set_var_statement=∀x v2 v1 s. get_var v1 (set_var v2 x s) = if v1 = v2 then SOME x else get_var v1 s
get_var_set_var_hypotheses=0
get_vars_length_lemma_statement=∀ls s y. get_vars ls s = SOME y ⇒ LENGTH y = LENGTH ls
get_vars_length_lemma_hypotheses=0
stack_size_eq_statement=∀stack n handler _3 _2 _1 _0. stack_size (StackFrame n _0 _1 NONE::stack) = OPTION_MAP2 $+ n (stack_size stack) ∧ stack_size (StackFrame n _2 _3 (SOME handler)::stack) = OPTION_MAP2 $+ (OPTION_MAP ($+ 3) n) (stack_size stack) ∧ stack_size [] = SOME 1
stack_size_eq_hypotheses=0
stack_size_eq2_statement=∀stack sfrm. stack_size (sfrm::stack) = OPTION_MAP2 $+ (stack_size_frame sfrm) (stack_size stack) ∧ stack_size [] = SOME 1
stack_size_eq2_hypotheses=0
s_key_eq_def2_statement=∀l1 l2. s_key_eq l1 l2 ⇔ LIST_REL s_frame_key_eq l1 l2
s_key_eq_def2_hypotheses=0
LASTN_stack_size_SOME_statement=∀n stack stack' x. LASTN n stack = stack' ∧ stack_size stack = SOME x ∧ n ≤ LENGTH stack ⇒ ∃y. stack_size stack' = SOME y ∧ y ≤ x
LASTN_stack_size_SOME_hypotheses=0
