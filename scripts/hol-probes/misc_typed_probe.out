subspt_domain_SUBSET_typed=subspt (t1 :α sptree$num_map) (t2 :α sptree$num_map) ⇒ (domain t1 :num -> bool) ⊆ (domain t2 :num -> bool)
DISJOINT_IMAGE_SUC_typed=DISJOINT (IMAGE SUC (x :num -> bool)) (IMAGE SUC (y :num -> bool)) ⇔ DISJOINT x y
IMAGE_SUC_SUBSET_UNION_typed=IMAGE SUC (x :num -> bool) ⊆ IMAGE SUC (y :num -> bool) ∪ IMAGE SUC (z :num -> bool) ⇔ x ⊆ y ∪ z
toAList_domain_typed=∀(x :num). MEM x (MAP (FST :num # α -> num) (toAList (t :α sptree$num_map))) ⇔ x ∈ (domain t :num -> bool)
make_even_def_typed=∀(n :num). make_even n = if EVEN n then n else n + (1 :num)
EVEN_make_even_typed=EVEN (make_even (x :num))
opt_bind_def_typed=∀(n :α option) (v :β) (e :(α # β) list). opt_bind n v e = case n of (NONE :α option) => e | SOME n' => (n',v)::e
enumerate_def_typed=(∀(n :num). (enumerate n ([] :α list) :(num # α) list) = ([] :(num # α) list)) ∧ ∀(n :num) (x :α) (xs :α list). (enumerate n (x::xs) :(num # α) list) = (n,x)::(enumerate (n + (1 :num)) xs :(num # α) list)
lookup_vars_def_typed=(∀(env :α list). lookup_vars ([] :num list) env = SOME ([] :α list)) ∧ ∀(v :num) (vs :num list) (env :α list). lookup_vars (v::vs) env = if v < LENGTH env then case lookup_vars vs env of (NONE :α list option) => (NONE :α list option) | SOME xs => SOME (env❲v❳::xs) else (NONE :α list option)
anub_def_typed=(∀(acc :α list). anub ([] :(α # β) list) acc = ([] :(α # β) list)) ∧ ∀(v :β) (ls :(α # β) list) (k :α) (acc :α list). anub ((k,v)::ls) acc = if MEM k acc then anub ls acc else (k,v)::anub ls (k::acc)
anub_all_distinct_keys_typed=∀(ls :(α # β) list) (acc :α list). ALL_DISTINCT acc ⇒ ALL_DISTINCT (MAP (FST :α # β -> α) (anub ls acc) ++ acc)
app_list_typed=List::α list -> α app_list; Append::α app_list -> α app_list -> α app_list; Nil::α app_list
append_def_typed=∀(l :α app_list). append l = append_aux l ([] :α list)
append_thm_typed=append (Append (l1 :α app_list) (l2 :α app_list)) = append l1 ++ append l2 ∧ append (List (xs :β list)) = xs ∧ append (Nil :γ app_list) = ([] :γ list)
append_aux_def_typed=(∀(aux :α list). append_aux (Nil :α app_list) aux = aux) ∧ (∀(xs :α list) (aux :α list). append_aux (List xs) aux = xs ++ aux) ∧ ∀(l1 :α app_list) (l2 :α app_list) (aux :α list). append_aux (Append l1 l2) aux = append_aux l1 (append_aux l2 aux)
append_aux_thm_typed=∀(l :α app_list) (xs :α list). append_aux l xs = append_aux l ([] :α list) ++ xs
asm_write_bytearray_def_typed=(∀(a :α word) (m :α word -> word8). asm_write_bytearray a ([] :word8 list) m = m) ∧ ∀(a :α word) (x :word8) (xs :word8 list) (m :α word -> word8). asm_write_bytearray a (x::xs) m = (asm_write_bytearray (a + (1w :α word)) xs m)⦇a ↦ x⦈
bytes_in_mem_def_typed=(∀(a :α word) (m :α word -> β) (md :α word -> bool) (k :α word -> bool). bytes_in_mem a ([] :β list) m md k ⇔ T) ∧ ∀(a :α word) (b :β) (bs :β list) (m :α word -> β) (md :α word -> bool) (k :α word -> bool). bytes_in_mem a (b::bs) m md k ⇔ a ∈ md ∧ a ∉ k ∧ m a = b ∧ bytes_in_mem (a + (1w :α word)) bs m md k
bytes_in_mem_IMP_typed=∀(xs :word8 list) (p :α word). bytes_in_mem p xs (m :α word -> word8) (dm :α word -> bool) (dm1 :α word -> bool) ⇒ bytes_in_memory p xs m dm
bytes_in_memory_def_typed=(∀(a :α word) (m :α word -> word8) (dm :α word -> bool). bytes_in_memory a ([] :word8 list) m dm ⇔ T) ∧ ∀(a :α word) (x :word8) (xs :word8 list) (m :α word -> word8) (dm :α word -> bool). bytes_in_memory a (x::xs) m dm ⇔ m a = x ∧ a ∈ dm ∧ bytes_in_memory (a + (1w :α word)) xs m dm
bytes_in_memory_APPEND_typed=∀(l1 :word8 list) (l2 :word8 list) (pc :α word) (mem :α word -> word8) (mem_domain :α word -> bool). bytes_in_memory pc (l1 ++ l2) mem mem_domain ⇔ bytes_in_memory pc l1 mem mem_domain ∧ bytes_in_memory (pc + (n2w (LENGTH l1) :α word)) l2 mem mem_domain
bytes_in_memory_change_mem_typed=∀(a :α word) (bs :word8 list) (m1 :α word -> word8) (m2 :α word -> word8) (md :α word -> bool). bytes_in_memory a bs m1 md ∧ (∀(n :num). n < LENGTH bs ⇒ m1 (a + (n2w n :α word)) = m2 (a + (n2w n :α word))) ⇒ bytes_in_memory a bs m2 md
bytes_in_memory_in_domain_typed=∀(a :α word) (bs :word8 list) (m :α word -> word8) (md :α word -> bool) (k :num). bytes_in_memory a bs m md ∧ k < LENGTH bs ⇒ a + (n2w k :α word) ∈ md
find_index_def_typed=(∀(v0 :α) (v1 :num). find_index v0 ([] :α list) v1 = (NONE :num option)) ∧ ∀(y :α) (x :α) (xs :α list) (n :num). find_index y (x::xs) n = if x = y then SOME n else find_index y xs (n + (1 :num))
find_index_APPEND_typed=∀(l1 :α list) (l2 :α list) (x' :α) (n :num). find_index x' (l1 ++ l2) n = case find_index x' l1 n of (NONE :num option) => find_index x' l2 (n + LENGTH l1) | SOME x => SOME x
find_index_LESS_LENGTH_typed=∀(ls :α list) (n :α) (m :num) (i :num). find_index n ls m = SOME i ⇒ m ≤ i ∧ i < m + LENGTH ls
find_index_ALL_DISTINCT_EL_eq_typed=∀(ls :α list). ALL_DISTINCT ls ⇒ ∀(x :α) (m :num) (i :num). find_index x ls m = SOME i ⇔ ∃(j :num). i = m + j ∧ j < LENGTH ls ∧ x = ls❲j❳
find_index_MEM_typed=∀(ls :α list) (x :α) (n :num). MEM x ls ⇒ ∃(i :num). find_index x ls n = SOME (n + i) ∧ i < LENGTH ls ∧ ls❲i❳ = x
find_index_shift_typed=∀(ls :α list) (x :α) (k :num) (j :num). find_index x ls k = SOME j ⇒ j ≥ k ∧ ∀(n :num). find_index x ls n = SOME (j − k + n)
find_index_shift_0_typed=∀(ls :α list) (x :α) (k :num). find_index x ls k = OPTION_MAP (λ(x :num). x + k) (find_index x ls (0 :num))
find_index_is_MEM_typed=∀(x :α) (ls :α list) (n :num) (j :num). find_index x ls n = SOME j ⇒ MEM x ls
FLAT_REPLICATE_NIL_typed=∀(n :num). FLAT (REPLICATE n ([] :α list)) = ([] :α list)
FOLDR_MAX_0_MAX_LIST_typed=∀(ls :num list). FOLDR MAX (0 :num) ls = MAX_LIST ls
get_byte_set_byte_diff_typed=good_dimindex (:α) ∧ (a :α word) ≠ (a' :α word) ∧ byte_align a = byte_align a' ⇒ get_byte a (set_byte a' (b :word8) (w :α word) (be :bool)) be = get_byte a w be
good_dimindex_get_byte_set_byte_typed=good_dimindex (:α) ⇒ get_byte (a :α word) (set_byte a (b :word8) (w :α word) (be :bool)) be = b
good_dimindex_def_typed=good_dimindex (:α) ⇔ dimindex (:α) = (32 :num) ∨ dimindex (:α) = (64 :num)
LLOOKUP_def_typed=(∀(n :num). LLOOKUP ([] :α list) n = (NONE :α option)) ∧ ∀(n :num) (x :α) (xs :α list). LLOOKUP (x::xs) n = if n = (0 :num) then SOME x else LLOOKUP xs (n − (1 :num))
LLOOKUP_DROP_typed=LLOOKUP (DROP (m :num) (xs :α list)) (n :num) = LLOOKUP xs (m + n)
LLOOKUP_LUPDATE_typed=∀(xs :α list) (i :num) (n :num) (x :α). LLOOKUP xs❲i ↦ x❳ n = if i ≠ n then LLOOKUP xs n else if i < LENGTH xs then SOME x else (NONE :α option)
LLOOKUP_TAKE_IMP_typed=LLOOKUP (TAKE (m :num) (xs :α list)) (n :num) = SOME (x :α) ⇒ LLOOKUP xs n = SOME x
list_subset_def_typed=∀(l1 :α list) (l2 :α list). list_subset l1 l2 ⇔ EVERY (λ(x :α). MEM x l2) l1
lookup_any_def_typed=∀(x :num) (sp :α sptree$num_map) (d :α). lookup_any x sp d = case lookup x sp of (NONE :α option) => d | SOME m => m
max3_def_typed=∀(x :num) (y :num) (z :num). max3 x y z = if x > y then if z > x then z else x else if z > y then z else y
the_def_typed=(∀(v0 :α) (x :α). the v0 (SOME x) = x) ∧ ∀(x :α). the x (NONE :α option) = x
IMP_OPT_MMAP_EQ_typed=∀(l1 :α list) (l2 :β list). MAP (f1 :α -> γ option) l1 = MAP (f2 :β -> γ option) l2 ⇒ OPT_MMAP f1 l1 = OPT_MMAP f2 l2
OPT_MMAP_CONG_typed=∀(l1 :α list) (l2 :α list) (f :α -> β option) (f' :α -> β option). l1 = l2 ∧ (∀(x :α). MEM x l2 ⇒ f x = f' x) ⇒ OPT_MMAP f l1 = OPT_MMAP f' l2
PERM_PART_typed=∀(P :α -> bool) (L :α list) (l1 :α list) (l2 :α list) (p :α list) (q :α list). (p,q) = PART P L l1 l2 ⇒ PERM (L ++ (l1 ++ l2)) (p ++ q)
PERM_PARTITION_typed=∀(P :α -> bool) (L :α list) (A :α list) (B :α list). (A,B) = PARTITION P L ⇒ PERM L (A ++ B)
shift_seq_def_typed=∀(k :num) (s :num -> α). shift_seq k s = (λ(i :num). s (i + k))
fromList2_def_typed=∀(l :α list). fromList2 l = SND (FOLDL (λ((i :num),(t :α sptree$num_map)) (a :α). (i + (2 :num),insert i a t)) ((0 :num),(LN :α sptree$num_map)) l)
alist_insert_REVERSE_typed=∀(xs :num list) (ys :α list) (s :α sptree$num_map). ALL_DISTINCT xs ∧ LENGTH xs = LENGTH ys ⇒ alist_insert (REVERSE xs) (REVERSE ys) s = alist_insert xs ys s
domain_fromList2_typed=∀(q :α list). (domain (fromList2 q) :num -> bool) = set (GENLIST (λ(x :num). (2 :num) * x) (LENGTH q))
EVEN_fromList2_typed=∀(l :α list) (n :num). n ∈ (domain (fromList2 l) :num -> bool) ⇒ EVEN n
TAKE_FLAT_REPLICATE_LEQ_typed=∀(j :num) (k :num) (ls :α list) (len :num). len = LENGTH ls ∧ k ≤ j ⇒ TAKE (k * len) (FLAT (REPLICATE j ls)) = FLAT (REPLICATE k ls)
UNCURRY_eq_pair_typed=UNCURRY (f :β -> γ -> α) (v :β # γ) = (z :α) ⇔ ∃(a :β) (b :γ). v = (a,b) ∧ f a b = z
word_list_def_typed=(∀(a :α word). word_list a ([] :β list) = (emp :(α word # β -> bool) -> bool)) ∧ ∀(a :α word) (x :β) (xs :β list). word_list a (x::xs) = (one (a,x) :(α word # β -> bool) -> bool) * word_list (a + (bytes_in_word :α word)) xs
word_list_exists_def_typed=∀(a :α word) (n :num). (word_list_exists a n :(α word # β -> bool) -> bool) = SEP_EXISTS(xs :β list). word_list a xs * (cond (LENGTH xs = n) :(α word # β -> bool) -> bool)
read_bytearray_def_typed=(∀(a :β word) (get_byte :β word -> α option). read_bytearray a (0 :num) get_byte = SOME ([] :α list)) ∧ ∀(a :β word) (n :num) (get_byte :β word -> α option). read_bytearray a (SUC n) get_byte = case get_byte a of (NONE :α option) => (NONE :α list option) | SOME b => case read_bytearray (a + (1w :β word)) n get_byte of (NONE :α list option) => (NONE :α list option) | SOME bs => SOME (b::bs)
read_bytearray_LENGTH_typed=∀(n :num) (a :α word) (f :α word -> β option) (x :β list). read_bytearray a n f = SOME x ⇒ LENGTH x = n
fun2set_disjoint_union_typed=DISJOINT (d1 :α -> bool) (d2 :α -> bool) ∧ (p :(α # β -> bool) -> bool) (fun2set ((m :α -> β),d1)) ∧ (q :(α # β -> bool) -> bool) (fun2set (m,d2)) ⇒ (p * q) (fun2set (m,d1 ∪ d2))
UPDATE_LIST_def_typed=($=++ :(α -> β) -> (α # β) list -> α -> β) = FOLDL (flip (UNCURRY (UPDATE :α -> β -> (α -> β) -> α -> β)))
UPDATE_LIST_THM_typed=∀(f :α -> β). f =++ ([] :(α # β) list) = f ∧ ∀(h :α # β) (t :(α # β) list). f =++ (h::t) = f⦇FST h ↦ SND h⦈ =++ t
APPLY_UPDATE_LIST_ALOOKUP_typed=∀(ls :(α # β) list) (f :α -> β) (x :α). (f =++ ls) x = case ALOOKUP (REVERSE ls) x of (NONE :β option) => f x | SOME y => y
MOD_SUB_LEMMA_typed=(n :num) MOD (k :num) = (0 :num) ∧ (m :num) MOD k = (0 :num) ∧ (0 :num) < k ⇒ (n − m) MOD k = (0 :num)
DISJOINT_INTER_typed=DISJOINT (b :α -> bool) (c :α -> bool) ⇒ DISJOINT ((a :α -> bool) ∩ b) (a ∩ c)
IMP_MULT_DIV_LESS_typed=(m :num) ≠ (0 :num) ∧ (d :num) < (k :num) ⇒ m * (d DIV m) < k
DIV_LESS_DIV_typed=(n :num) MOD (k :num) = (0 :num) ∧ (m :num) MOD k = (0 :num) ∧ n < m ∧ (0 :num) < k ⇒ n DIV k < m DIV k
WORD_LS_IMP_typed=(a :α word) ≤₊ (b :α word) ⇒ ∃(k :num). Abbrev (b = a + (n2w k :α word)) ∧ w2n (b − a) = k ∧ ∀(w :α word). a ≤₊ w ∧ w <₊ b ⇔ ∃(i :num). w = a + (n2w i :α word) ∧ i < k
SmartAppend_def_typed=SmartAppend (Nil :α app_list) (l2 :α app_list) = l2 ∧ SmartAppend (List (v2 :α list)) (Nil :α app_list) = List v2 ∧ SmartAppend (Append (v3 :α app_list) (v4 :α app_list)) (Nil :α app_list) = Append v3 v4 ∧ SmartAppend (List (v5 :α list)) (List (v11 :α list)) = Append (List v5) (List v11) ∧ SmartAppend (List v5) (Append (v12 :α app_list) (v13 :α app_list)) = Append (List v5) (Append v12 v13) ∧ SmartAppend (Append (v6 :α app_list) (v7 :α app_list)) (List (v17 :α list)) = Append (Append v6 v7) (List v17) ∧ SmartAppend (Append v6 v7) (Append (v18 :α app_list) (v19 :α app_list)) = Append (Append v6 v7) (Append v18 v19)
FST_pair_typed=(λ((n :α),(v :β)). n) = (FST :α # β -> α)
SND_pair_typed=(λ((n :α),(v :β)). v) = (SND :α # β -> β)
FST_triple_typed=(λ((n :α),(ns :β),(b :γ)). n) = (FST :α # β # γ -> α)
SND_triple_typed=(λ((n :α),(ns :β),(b :γ)). (f :β -> γ -> δ) ns b) = UNCURRY f ∘ (SND :α # β # γ -> β # γ)
LESS_1_typed=(x :num) < (1 :num) ⇔ x = (0 :num)
MEM_REPLICATE_EQ_typed=∀(n :num) (x :α) (y :α). MEM x (REPLICATE n y) ⇔ x = y ∧ n ≠ (0 :num)
LENGTH_TAKE_EQ_MIN_typed=∀(n :num) (xs :α list). LENGTH (TAKE n xs) = MIN n (LENGTH xs)
w2n_lt_256_typed=∀(w :word8). w2n w < (256 :num)
IMP_IMP_typed=(P :bool) ∧ ((Q :bool) ⇒ (R :bool)) ⇒ (P ⇒ Q) ⇒ R
SUBSET_IMP_typed=(s :α -> bool) ⊆ (t :α -> bool) ⇒ (x :α) ∈ s ⇒ x ∈ t
DROP_NIL_typed=∀(n :num) (xs :α list). DROP n xs = ([] :α list) ⇔ LENGTH xs ≤ n
times_add_o_typed=(λ(n :num). (k :num) * n + (x :num)) = $+ x ∘ $* k
FST_5tup_typed=(λ((n :α),(ns :β),(b :γ),(x :δ),(y :ε)). n) = (FST :α # β # γ # δ # ε -> α)
SND_FST_pair_typed=(λ(((n :α),(m :β)),(c :γ)). m) = (SND :α # β -> β) ∘ (FST :(α # β) # γ -> α # β)
plus_compose_typed=∀(n :num) (m :num). $+ n ∘ $+ m = $+ (n + m)
option_case_NONE_F_typed=(case (X :α option) of (NONE :α option) => F | SOME x => (P :α -> bool) x) ⇔ ∃(x :α). X = SOME x ∧ P x
MAP_FST_I_PAIR_MAP_typed=∀(xs :(α # β) list). MAP (FST :α # γ -> α) (MAP ((I :α -> α) ## (f :β -> γ)) xs) = MAP (FST :α # β -> α) xs
FLAT_MAP_SING_typed=∀(ls :α list). FLAT (MAP (λ(x :α). [(f :α -> β) x]) ls) = MAP f ls
FLAT_MAP_NIL_typed=FLAT (MAP (λ(x :β). ([] :α list)) (ls :β list)) = ([] :α list)
ZIP_MAP_FST_SND_EQ_typed=∀(ls :(α # β) list). ZIP (MAP (FST :α # β -> α) ls,MAP (SND :α # β -> β) ls) = ls
MAP_EQ_ID_typed=∀(f :α -> α) (ls :α list). MAP f ls = ls ⇔ ∀(x :α). MEM x ls ⇒ f x = x
SUM_REPLICATE_typed=∀(n :num) (m :num). (SUM (REPLICATE n m) :num) = n * m
SUM_MAP_LENGTH_REPLICATE_typed=∀(n :num) (ls :α list). (SUM (MAP (LENGTH :α list -> num) (REPLICATE n ls)) :num) = n * LENGTH ls
EL_CONS_IF_typed=((x :α)::(xs :α list))❲(n :num)❳ = if n = (0 :num) then x else xs❲PRE n❳
EVERY_LAST_typed=∀(P :α -> bool) (l :α list). l ≠ ([] :α list) ∧ EVERY P l ⇒ P (LAST l)
revdroprev_typed=∀(l :α list) (n :num). n ≤ LENGTH l ⇒ REVERSE (DROP n (REVERSE l)) = TAKE (LENGTH l − n) l
o_PAIR_MAP_typed=(FST :γ # δ -> γ) ∘ ((f :α -> γ) ## (g :β -> δ)) = f ∘ (FST :α # β -> α) ∧ (SND :γ # δ -> δ) ∘ (f ## g) = g ∘ (SND :α # β -> β)
EVERY_FST_SND_typed=EVERY (λ((a :α),(b :β)). (P :α -> bool) a ∧ (Q :β -> bool) b) (ls :(α # β) list) ⇔ EVERY P (MAP (FST :α # β -> α) ls) ∧ EVERY Q (MAP (SND :α # β -> β) ls)
EVERY_ZIP_typed=∀(l :(α # β) list) (f :α -> bool). EVERY (λ((x :α),(y :β)). f x) l ⇔ EVERY f (MAP (FST :α # β -> α) l)
EXISTS_ZIP_typed=∀(l :(α # β) list) (f :α -> bool). EXISTS (λ((x :α),(y :β)). f x) l ⇔ EXISTS f (MAP (FST :α # β -> α) l)
TWOxDIV2_typed=(2 :num) * (x :num) DIV (2 :num) = x
DROP_EMPTY_typed=∀(ls :α list) (n :num). DROP n ls = ([] :α list) ⇒ n ≥ LENGTH ls
DROP_IMP_LESS_LENGTH_typed=∀(xs :α list) (n :num) (y :α) (ys :α list). DROP n xs = y::ys ⇒ n < LENGTH xs
MULT_DIV_MULT_LEMMA_typed=∀(m :num) (l :num) (k :num). (0 :num) < m ∧ (0 :num) < l ⇒ m * k DIV (l * m) = k DIV l
ADD_MOD_EQ_LEMMA_typed=(k :num) MOD (d :num) = (0 :num) ∧ (n :num) < d ⇒ (k + n) MOD d = n
SUM_MOD_typed=(k :num) > (0 :num) ⇒ (SUM (ls :num list) :num) MOD k = (SUM (MAP (λ(n :num). n MOD k) ls) :num) MOD k
LENGTH_enumerate_typed=∀(xs :α list) (k :num). LENGTH (enumerate k xs :(num # α) list) = LENGTH xs
MEM_enumerate_IMP_typed=∀(ls :α list) (k :num). MEM ((i :num),(e :α)) (enumerate k ls :(num # α) list) ⇒ MEM e ls
DROP_EQ_CONS_IMP_DROP_SUC_typed=∀(xs :α list) (n :num) (y :α) (ys :α list). DROP n xs = y::ys ⇒ DROP (SUC n) xs = ys
LUPDATE_APPEND_typed=∀(xs :α list) (n :num) (ys :α list) (x :α). (xs ++ ys)❲n ↦ x❳ = if n < LENGTH xs then xs❲n ↦ x❳ ++ ys else xs ++ ys❲n − LENGTH xs ↦ x❳
DROP_LUPDATE_typed=∀(n :num) (x :α) (m :num) (l :α list). n ≤ m ⇒ DROP n l❲m ↦ x❳ = (DROP n l)❲m − n ↦ x❳
ALOOKUP_SNOC_typed=∀(ls :(α # β) list) (p :α # β) (k :α). ALOOKUP (SNOC p ls) k = case ALOOKUP ls k of (NONE :β option) => if k = FST p then SOME (SND p) else (NONE :β option) | SOME v => SOME v
ALOOKUP_ZIP_FAIL_typed=∀(A :α list) (B :β list) (x :α). LENGTH A = LENGTH B ⇒ (ALOOKUP (ZIP (A,B)) x = (NONE :β option) ⇔ ¬MEM x A)
map_fst_typed=∀(l :(α # β) list) (f :β -> γ). MAP (FST :α # γ -> α) (MAP (λ((x :α),(y :β)). (x,f y)) l) = MAP (FST :α # β -> α) l
map_some_eq_typed=∀(l1 :α list) (l2 :α list). MAP (SOME :α -> α option) l1 = MAP (SOME :α -> α option) l2 ⇔ l1 = l2
MAP_EQ_MAP_IMP_typed=∀(xs :α list) (ys :α list) (f :α -> β). (∀(x :α) (y :α). MEM x xs ∧ MEM y ys ∧ f x = f y ⇒ x = y) ⇒ MAP f xs = MAP f ys ⇒ xs = ys
OPTION_MAP_INJ_typed=(∀(x :α) (y :α). (f :α -> β) x = f y ⇒ x = y) ⇒ ∀(o1 :α option) (o2 :α option). OPTION_MAP f o1 = OPTION_MAP f o2 ⇒ o1 = o2
the_OPTION_MAP_typed=∀(f :α -> α) (d :α) (opt :α option). f d = d ⇒ the d (OPTION_MAP f opt) = f (the d opt)
MEM_REPLICATE_IMP_typed=MEM (x :α) (REPLICATE (n :num) (y :α)) ⇒ x = y
MAP_K_REPLICATE_typed=MAP (K (x :α) :β -> α) (ls :β list) = REPLICATE (LENGTH ls) x
SUM_MAP_K_typed=∀(f :α -> num) (ls :α list) (c :num). (∀(x :α). f x = c) ⇒ (SUM (MAP f ls) :num) = LENGTH ls * c
OPTION_MAP_I_typed=OPTION_MAP (I :α -> α) (x :α option) = x
TL_DROP_SUC_typed=∀(x :num) (ls :α list). x < LENGTH ls ⇒ TL (DROP x ls) = DROP (SUC x) ls
ALL_DISTINCT_FLAT_EVERY_typed=∀(ls :α list list). ALL_DISTINCT (FLAT ls) ⇒ EVERY (ALL_DISTINCT :α list -> bool) ls
OPT_MMAP_SOME_typed=OPT_MMAP (SOME :α -> α option) (ls :α list) = SOME ls
insert_atI_def_typed=∀(l1 :α list) (n :num) (l2 :α list). insert_atI l1 n l2 = TAKE n l2 ++ l1 ++ DROP (n + LENGTH l1) l2
LENGTH_insert_atI_typed=(p :num) + LENGTH (l1 :α list) ≤ LENGTH (l2 :α list) ⇒ LENGTH (insert_atI l1 p l2) = LENGTH l2
insert_atI_NIL_typed=∀(n :num) (l :α list). insert_atI ([] :α list) n l = l
insert_atI_end_typed=insert_atI (l1 :α list) (LENGTH (l2 :α list)) l2 = l2 ++ l1
OPT_MMAP_MAP_o_typed=∀(ls :α list). OPT_MMAP (f :γ -> β option) (MAP (g :α -> γ) ls) = OPT_MMAP (f ∘ g) ls
list_inter_def_typed=∀(xs :α list) (ys :α list). list_inter xs ys = FILTER (λ(y :α). MEM y xs) ys
list_set_eq_def_typed=∀(l1 :α list) (l2 :α list). list_set_eq l1 l2 ⇔ list_subset l1 l2 ∧ list_subset l2 l1
any_el_def_typed=(∀(n :num) (d :α). any_el n ([] :α list) d = d) ∧ ∀(n :num) (x :α) (xs :α list) (d :α). any_el n (x::xs) d = if n = (0 :num) then x else any_el (n − (1 :num)) xs d
option_fold_def_typed=(∀(f :β -> α -> α) (x :α). option_fold f x (NONE :β option) = x) ∧ ∀(f :β -> α -> α) (x :α) (y :β). option_fold f x (SOME y) = f y x
steps_rel_def_typed=(∀(x :α) (R :α -> β -> α -> bool). steps_rel R x ([] :(β # α) list) ⇔ T) ∧ ∀(y :α) (x :α) (tr :(β # α) list) (j :β) (R :α -> β -> α -> bool). steps_rel R x ((j,y)::tr) ⇔ R x j y ∧ steps_rel R y tr
DROP_IMP_EL_typed=∀(xs :α list) (n :num) (h :α) (t :α list). DROP n xs = h::t ⇒ xs❲n❳ = h
HD_LUPDATE_typed=(0 :num) < LENGTH (l :α list) ⇒ HD l❲(p :num) ↦ (x :α)❳ = if p = (0 :num) then x else HD l
zlookup_def_typed=∀(m :num sptree$num_map) (k :num). zlookup m k = case lookup k m of (NONE :num option) => (0 :num) | SOME k => k
tlookup_def_typed=∀(m :num sptree$num_map) (k :num). tlookup m k = case lookup k m of (NONE :num option) => k | SOME v => v
steps_def_typed=(∀(f :β -> α -> β) (x :β). steps f x ([] :α list) = ([] :(α # β) list)) ∧ ∀(f :β -> α -> β) (x :β) (j :α) (js :α list). steps f x (j::js) = (let (y :β) = f x j; (tr :(α # β) list) = steps f y js in (j,y)::tr)
LAST_MAP_SND_steps_FOLDL_typed=∀(f :α -> β -> α) (x :α) (ls :β list). LAST (x::MAP (SND :β # α -> α) (steps f x ls)) = FOLDL f x ls
LLOOKUP_EQ_EL_typed=∀(xs :α list) (n :num) (y :α). LLOOKUP xs n = SOME y ⇔ n < LENGTH xs ∧ y = xs❲n❳
LLOOKUP_THM_typed=∀(xs :α list) (n :num). LLOOKUP xs n = if n < LENGTH xs then SOME xs❲n❳ else (NONE :α option)
IN_option_rwt2_typed=(x :α) ∈ (option_CASE (opt :β option) (∅ :α -> bool) (s :β -> α -> bool) :α -> bool) ⇔ ∃(y :β). opt = SOME y ∧ x ∈ s y
find_index_APPEND_same_typed=∀(l1 :α list) (n :α) (m :num) (i :num) (l2 :α list). find_index n l1 m = SOME i ⇒ find_index n (l1 ++ l2) m = SOME i
between_def_typed=∀(x :num) (y :num) (z :num). between x y z ⇔ x ≤ z ∧ z < y
IN_between_typed=(x :num) ∈ between (y :num) (z :num) ⇔ y ≤ x ∧ x < z
ALOOKUP_EXISTS_IFF_typed=(∃(v :α). ALOOKUP (alist :(β # α) list) (k :β) = SOME v) ⇔ ∃(v :α). MEM (k,v) alist
LAST_CONS_alt_typed=(P :α -> bool) (x :α) ⇒ ((ls :α list) ≠ ([] :α list) ⇒ P (LAST ls) ⇔ P (LAST (x::ls)))
NOT_MEM_findi_IFF_typed=¬MEM (e :α) (l :α list) ⇔ findi e l = LENGTH l
NOT_MEM_findi_typed=¬MEM (e :α) (l :α list) ⇒ findi e l = LENGTH l
EL_enumerate_typed=∀(xs :α list) (n :num) (k :num). n < LENGTH xs ⇒ (enumerate k xs :(num # α) list)❲n❳ = (n + k,xs❲n❳)
MEM_enumerate_typed=∀(xs :α list) (i :num) (e :α). i < LENGTH xs ⇒ (MEM (i,e) (enumerate (0 :num) xs :(num # α) list) ⇔ xs❲i❳ = e)
MAP_enumerate_MAPi_typed=∀(f :num # α -> β) (xs :α list). MAP f (enumerate (0 :num) xs :(num # α) list) = MAPi (λ(n :num) (e :α). f (n,e)) xs
MAPi_enumerate_MAP_typed=∀(f :num -> α -> β) (xs :α list). MAPi f xs = MAP (λ((i :num),(e :α)). f i e) (enumerate (0 :num) xs :(num # α) list)
ALOOKUP_enumerate_typed=∀(ls :α list) (k :num) (x :num). ALOOKUP (enumerate k ls :(num # α) list) x = if k ≤ x ∧ x < LENGTH ls + k then SOME ls❲x − k❳ else (NONE :α option)
EXP2_EVEN_typed=∀(n :num). EVEN ((2 :num) ** n) ⇔ n ≠ (0 :num)
OPTION_CHOICE_EQUALS_OPTION_typed=∀(x :α option) (y :α option) (z :α). OPTION_CHOICE x y = SOME z ⇔ x = SOME z ∨ x = (NONE :α option) ∧ y = SOME z
map_some_eq_append_typed=∀(l1 :α list) (l2 :α list) (l3 :α list). MAP (SOME :α -> α option) l1 ++ MAP (SOME :α -> α option) l2 = MAP (SOME :α -> α option) l3 ⇔ l1 ++ l2 = l3
the_nil_eq_cons_typed=the ([] :α list) (x :α list option) = (y :α)::(z :α list) ⇔ x = SOME (y::z)
find_index_INDEX_FIND_typed=∀(y :α) (xs :α list) (n :num). find_index y xs n = OPTION_MAP (FST :num # α -> num) (INDEX_FIND n ($= y) xs)
find_index_NOT_MEM_typed=∀(ls :α list) (x :α) (n :num). ¬MEM x ls ⇔ find_index x ls n = (NONE :num option)
find_index_MAP_inj_typed=∀(ls :α list) (x :α) (n :num) (f :α -> β). (∀(y :α). MEM y ls ⇒ f x = f y ⇒ x = y) ⇒ find_index (f x) (MAP f ls) n = find_index x ls n
INDEX_FIND_CONS_EQ_SOME_typed=INDEX_FIND (n :num) (f :α -> bool) ((x :α)::(xs :α list)) = SOME (y :num # α) ⇔ f x ∧ y = (n,x) ∨ ¬f x ∧ INDEX_FIND (n + (1 :num)) f xs = SOME y
THE_find_index_suff_typed=∀(P :num -> bool) (x :α) (ls :α list) (n :num). (∀(m :num). m < LENGTH ls ⇒ P (m + n)) ∧ MEM x ls ⇒ P (THE (find_index x ls n))
find_index_APPEND2_typed=∀(l1 :α list) (n :α) (l2 :α list) (m :num) (i :num). find_index n (l1 ++ l2) m = SOME i ∧ m + LENGTH l1 ≤ i ⇒ find_index n l2 (m + LENGTH l1) = SOME i
SmartAppend_thm_typed=∀(l1 :α app_list) (l2 :α app_list). SmartAppend l1 l2 = if l1 = (Nil :α app_list) then l2 else if l2 = (Nil :α app_list) then l1 else Append l1 l2
SmartAppend_Nil_typed=SmartAppend (l :α app_list) (Nil :α app_list) = l ∧ SmartAppend (Nil :α app_list) l = l
tlookup_id_typed=(x :num) ∉ (domain (names :num sptree$num_map) :num -> bool) ⇒ tlookup names x = x
every_shim_typed=∀(l :(α # β) list) (P :β -> bool). EVERY (λ((x :α),(y :β)). P y) l ⇔ EVERY P (MAP (SND :α # β -> β) l)
every_shim2_typed=∀(l :(α # β) list) (P :α -> bool) (Q :β -> bool). EVERY (λ((x :α),(y :β)). P x ∧ Q y) l ⇔ EVERY (λ(x :α # β). P (FST x)) l ∧ EVERY (λ(x :α # β). Q (SND x)) l
MEM_ZIP2_typed=∀(l1 :α list) (l2 :β list) (x :α # β). MEM x (ZIP (l1,l2)) ⇒ ∃(n :num). n < LENGTH l1 ∧ n < LENGTH l2 ∧ x = (l1❲n❳,l2❲n❳)
insert_atI_CONS_typed=∀(n :num) (l :α list) (h :α) (t :α list). n + LENGTH t < LENGTH l ⇒ insert_atI (h::t) n l = (insert_atI t (n + (1 :num)) l)❲n ↦ h❳
insert_atI_app_typed=∀(n :num) (l :α list) (c1 :α list) (c2 :α list). n + LENGTH c1 + LENGTH c2 ≤ LENGTH l ⇒ insert_atI (c1 ++ c2) n l = insert_atI c1 n (insert_atI c2 (n + LENGTH c1) l)
LESS_EQ_LENGTH_typed=∀(xs :α list) (k :num). k ≤ LENGTH xs ⇒ ∃(ys1 :α list) (ys2 :α list). xs = ys1 ++ ys2 ∧ LENGTH ys1 = k
LESS_LENGTH_typed=∀(xs :α list) (k :num). k < LENGTH xs ⇒ ∃(ys1 :α list) (y :α) (ys2 :α list). xs = ys1 ++ y::ys2 ∧ LENGTH ys1 = k
LIST_REL_MEM_typed=∀(xs :α list) (ys :β list) (P :α -> β -> bool). LIST_REL P xs ys ⇔ LIST_REL (λ(x :α) (y :β). MEM x xs ∧ MEM y ys ⇒ P x y) xs ys
LUPDATE_commutes_typed=∀(m :num) (n :num) (e1 :α) (e2 :α) (l :α list). m ≠ n ⇒ l❲m ↦ e1; n ↦ e2❳ = l❲n ↦ e2; m ↦ e1❳
revtakerev_typed=∀(n :num) (l :α list). n ≤ LENGTH l ⇒ REVERSE (TAKE n (REVERSE l)) = DROP (LENGTH l − n) l
any_el_ALT_typed=∀(l :α list) (n :num) (d :α). any_el n l d = if n < LENGTH l then l❲n❳ else d
SUM_MAP_BOUND_typed=(∀(x :α). (f :α -> num) x ≤ (c :num)) ⇒ (SUM (MAP f (ls :α list)) :num) ≤ LENGTH ls * c
anub_eq_nil_typed=anub (x :(α # β) list) (y :α list) = ([] :(α # β) list) ⇔ EVERY (flip (λ(x :α) (l :α list). MEM x l) y) (MAP (FST :α # β -> α) x)
anub_notin_acc_typed=∀(ls :(α # β) list) (acc :α list). MEM (x :α) acc ⇒ ¬MEM x (MAP (FST :α # β -> α) (anub ls acc))
find_index_APPEND1_typed=∀(l1 :α list) (n :α) (l2 :α list) (m :num) (i :num). find_index n (l1 ++ l2) m = SOME i ∧ i < m + LENGTH l1 ⇒ find_index n l1 m = SOME i
MAP_REVERSE_STEP_typed=∀(x :α list) (f :α -> β). x ≠ ([] :α list) ⇒ MAP f (REVERSE x) = f (LAST x)::MAP f (REVERSE (FRONT x))
MAPi_ID_typed=MAPi (λ(x :num) (y :α). y) = (I :α list -> α list)
ALL_DISTINCT_APPEND_APPEND_IMP_typed=ALL_DISTINCT ((xs :α list) ++ (ys :α list) ++ (zs :α list)) ⇒ ALL_DISTINCT (xs ++ ys) ∧ ALL_DISTINCT (xs ++ zs) ∧ ALL_DISTINCT (ys ++ zs)
FOLDR_CONS_triple_typed=∀(f :α -> β -> γ -> δ) (ls :(α # β # γ) list) (a :δ list). FOLDR (λ((x :α),(y :β),(z :γ)) (w :δ list). f x y z::w) a ls = MAP (λ((x :α),(y :β),(z :γ)). f x y z) ls ++ a
MAP_ZIP_SND_triple_typed=LENGTH (l1 :α list) = LENGTH (l2 :(β # γ) list) ⇒ MAP (λ((x :α),(y :β),(z :γ)). (f :β -> γ -> δ) y z) (ZIP (l1,l2)) = MAP (UNCURRY f) l2
