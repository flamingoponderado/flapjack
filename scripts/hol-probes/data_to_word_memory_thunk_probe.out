blocks_unique_thunk_typed=(lookup (p :num) (refs :v ref sptree$num_map) :v ref option) = SOME (Thunk (ev :thunk_mode) (x :v) :v ref) ∧ blocks_unique (ts :num) (all_vs refs ((RefPtr (bl :bool) p :v)::MAP (FST :v # α -> v) (vars :(v # α) list))) ⇒ blocks_unique ts (all_vs refs (x::MAP (FST :v # α -> v) vars))
blocks_unique_thunk2_typed=(lookup (p :num) (refs :v ref sptree$num_map) :v ref option) = SOME (Thunk (ev :thunk_mode) (v' :v) :v ref) ∧ blocks_unique (ts :num) (all_vs refs ((RefPtr F p :v)::MAP (FST :v # α -> v) (vars :(v # α) list))) ⇒ blocks_unique ts (all_vs refs (v'::(RefPtr F p :v)::MAP (FST :v # α -> v) vars))
blocks_unique_word64_typed=blocks_unique (ts :num) (all_vs (refs :v ref sptree$num_map) ((ws :v list) ++ (stack :v list))) ⇒ blocks_unique ts (all_vs refs ((Word64 (w64 :word64) :v)::stack))
