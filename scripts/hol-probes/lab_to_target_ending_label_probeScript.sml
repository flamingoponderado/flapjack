load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _ = capture "enc_lines_again_simp_ends_with_label" enc_lines_again_simp_ends_with_label;
val _ = types "enc_lines_again_simp_ends_with_label_types" enc_lines_again_simp_ends_with_label;
val _ = capture "enc_secs_again_ends_with_label" enc_secs_again_ends_with_label;
val _ = types "enc_secs_again_ends_with_label_types" enc_secs_again_ends_with_label;
val _ = capture "enc_sec_list_ends_with_label" enc_sec_list_ends_with_label;
val _ = types "enc_sec_list_ends_with_label_types" enc_sec_list_ends_with_label;
val _ = capture "sec_ends_with_label_def" labPropsTheory.sec_ends_with_label_def;
val _ = types "sec_ends_with_label_def_types" labPropsTheory.sec_ends_with_label_def;
val _ = show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc(EVAL q)); print "\n");
val grow = ``(λa:8 asm. case a of Jump w => if w = 0w then [0w] else [1w;1w;1w] | _ => [99w;99w]) : 8 asm -> word8 list``;
val labs = ``insert 3 (insert 4 10 LN) LN : num num_map num_map``;
val source = ``[LabAsm (Jump (Lab 3 4)) 0w [0w] 1;Label 3 0 999] : 8 labLang$line list``;
val _ = observe "empty_section_rejected" ``¬sec_ends_with_label (Section 3 [] : 8 labLang$sec)``;
val _ = observe "singleton_large_label" ``sec_ends_with_label (Section 3 [Label 3 0 999] : 8 labLang$sec)``;
val _ = observe "nonlabel_end_rejected" ``¬sec_ends_with_label (Section 3 [Label 3 0 0;Asm (Asmi (Inst Skip)) [] 999] : 8 labLang$sec)``;
val _ = observe "labasm_end_rejected" ``¬sec_ends_with_label (Section 3 [LabAsm (Jump (Lab 3 4)) 0w [] 999] : 8 labLang$sec)``;
val _ = observe "empty_full" ``enc_lines_again_simp ^labs [] 0 ^grow [] = ([],T)``;
val _ = observe "grow_false_full" ``enc_lines_again_simp ^labs [] 0 ^grow ^source = ([LabAsm (Jump (Lab 3 4)) 10w [1w;1w;1w] 3;Label 3 0 999],F)``;
val _ = observe "grow_false_end_preserved" ``sec_ends_with_label (Section 3 (FST(enc_lines_again_simp ^labs [] 0 ^grow ^source)))``;
val _ = observe "equal_word_invalid_cache_full" ``enc_lines_again_simp ^labs [] 0 ^grow [LabAsm (Jump (Lab 3 4)) 10w [] 77;Label 3 0 99] = ([LabAsm (Jump (Lab 3 4)) 10w [] 77;Label 3 0 99],T)``;
val _ = observe "label_only_full" ``enc_lines_again_simp ^labs [] 3 ^grow [Label 3 0 777] = ([Label 3 0 777],T)``;
val _ = observe "sections_false_end_preserved" ``EVERY sec_ends_with_label (FST(enc_secs_again 0 ^labs [] ^grow [Section 3 ^source;Section 4 [Label 4 0 7]]))``;
val _ = observe "empty_section_stays_invalid" ``¬EVERY sec_ends_with_label (FST(enc_secs_again 0 ^labs [] ^grow [Section 3 []]))``;
val _ = observe "initial_full" ``enc_sec_list ^grow [Section 3 [LabAsm (Jump (Lab 3 4)) 99w [] 77;Label 3 0 999]] = [Section 3 [LabAsm (Jump (Lab 3 4)) 0w [0w] 1;Label 3 0 2]]``;
val _ = observe "initial_end_preserved" ``EVERY sec_ends_with_label (enc_sec_list ^grow [Section 3 [LabAsm (Jump (Lab 3 4)) 99w [] 77;Label 3 0 999]])``;
val _ = observe "initial_empty_section_stays_invalid" ``¬EVERY sec_ends_with_label (enc_sec_list ^grow [Section 3 []])``;
