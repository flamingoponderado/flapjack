val _=observe "all_seven_opcodes_no_definitions" ``let ls=[LabAsm(Jump(Lab 3 4)) 99w [] 1;LabAsm(JumpCmp Equal 2 (Imm 1w) (Lab 3 4)) 99w [] 1;LabAsm(LocValue 2 (Lab 3 4)) 99w [] 1;LabAsm(Call(Lab 99 88)) 99w [] 1;LabAsm(CallFFI(strlit "")) 99w [] 1;LabAsm Install 99w [] 1;LabAsm Halt 99w [] 1]:8 labLang$line list in section_labels 13 ls ^aux=(20,^aux) /\ BIGUNION(IMAGE line_get_code_labels(set ls))={} ``;
val _=observe "width1_empty" ``section_labels 17 ([]:1 labLang$line list) []=(17,[])``;
val _=observe "width80_large_position" ``section_labels (2**80) ([Label 999 0 1;Label 888 5 2]:80 labLang$line list) [(0,2**90)]=(2**80+3,[(5,2**80+3);(0,2**90)])``;
