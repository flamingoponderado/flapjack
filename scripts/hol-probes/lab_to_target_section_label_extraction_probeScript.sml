load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "section_labels_line_get_code_labels" section_labels_line_get_code_labels;
val _=types "section_labels_line_get_code_labels_types" section_labels_line_get_code_labels;
val _=show_types:=false;
fun observe label q=(print(label ^ "=");print_term(rconc((QCONV(SIMP_CONV(srw_ss())[line_get_code_labels_def,pred_setTheory.IN_BIGUNION,pred_setTheory.IN_IMAGE]) THENC EVAL THENC QCONV(SIMP_CONV(srw_ss())[line_get_code_labels_def,pred_setTheory.IN_BIGUNION,pred_setTheory.IN_IMAGE]) THENC QCONV(SIMP_CONV(srw_ss())[pred_setTheory.EXTENSION,pred_setTheory.GSPECIFICATION,FORALL_PROD,EXISTS_PROD]) THENC EVAL THENC QCONV(SIMP_CONV(srw_ss())[line_get_code_labels_def,RIGHT_AND_OVER_OR,LEFT_AND_OVER_OR,EXISTS_OR_THM]) THENC EVAL) q));print "\n");
val aux=``[(0,999);(7,40);(7,80)]: (num#num) list``;
val lines=``[Label 1 2 0;Asm(Asmi(Inst Skip)) [] 3;Label 9 0 4;LabAsm Halt 99w [] 2;Label 88 2 1]:8 labLang$line list``;
val labs=``[(2,16);(2,6);(0,999);(7,40);(7,80)]: (num#num) list``;
val _=observe "mixed_full_tuple" ``section_labels 6 ^lines ^aux=(16,^labs)``;
