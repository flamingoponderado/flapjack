stack_names_stack_asm_ok_typed=EVERY (λ((n :α),(p :β stackLang$prog)). stack_asm_name (c :β asm_config) p) (prog :(α # β stackLang$prog) list) ∧ names_ok (f :num sptree$num_map) c.reg_count c.avoid_regs ∧ fixed_names f c ⇒ EVERY (λ((n :α),(p :β stackLang$prog)). stack_asm_ok c p) (compile f prog)
MAP_FST_compile_typed=MAP (FST :α # β stackLang$prog -> α) (compile (f :num sptree$num_map) (c :(α # β stackLang$prog) list)) = MAP (FST :α # β stackLang$prog -> α) c
compile_semantics_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ∧ ¬(s :(α, β, γ) state).use_alloc ∧ ¬s.use_store ∧ ¬s.use_stack ∧ s.compile = (λ(cfg :β). (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) cfg ∘ (compile f :(num # α stackLang$prog) list -> (num # α stackLang$prog) list)) ⇒ semantics (start :num) (rename_state c f s) = semantics start s
stack_names_call_args_typed=compile (f :num sptree$num_map) (p :(α # β stackLang$prog) list) = (p' :(α # β stackLang$prog) list) ∧ EVERY (λ(p :β stackLang$prog). call_args p (1 :num) (2 :num) (3 :num) (4 :num) (0 :num)) (MAP (SND :α # β stackLang$prog -> β stackLang$prog) p) ⇒ EVERY (λ(p :β stackLang$prog). call_args p (find_name f (1 :num)) (find_name f (2 :num)) (find_name f (3 :num)) (find_name f (4 :num)) (find_name f (0 :num))) (MAP (SND :α # β stackLang$prog -> β stackLang$prog) p')
stack_names_lab_pres_typed=∀(f :num sptree$num_map) (p :α stackLang$prog). extract_labels p = extract_labels (comp f p)
make_init_def_typed=∀(f :num sptree$num_map) (code :α stackLang$prog sptree$num_map) (oracle :num -> γ # (num # α stackLang$prog) list # α word list) (s :(α, γ, 'ffi) state). make_init f code oracle s = s with <|code := code; regs := MAP_KEYS (LINV (find_name f) 𝕌(:num)) s.regs; compile := (λ(cfg :γ). (s.compile cfg :(num # α stackLang$prog) list -> (word8 list # γ) option) ∘ (compile f :(num # α stackLang$prog) list -> (num # α stackLang$prog) list)); compile_oracle := oracle; ffi_save_regs := IMAGE (LINV (find_name f) 𝕌(:num)) s.ffi_save_regs|>
make_init_semantics_typed=¬(s :(α, β, γ) state).use_alloc ∧ ¬s.use_store ∧ ¬s.use_stack ∧ find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ∧ ALL_DISTINCT (MAP (FST :num # α stackLang$prog -> num) (code :(num # α stackLang$prog) list)) ∧ s.code = fromAList (compile f code) ∧ s.compile_oracle = ((I :β -> β) ## (compile f :(num # α stackLang$prog) list -> (num # α stackLang$prog) list) ## (I :α word list -> α word list)) ∘ (oracle :num -> β # (num # α stackLang$prog) list # α word list) ⇒ semantics (start :num) s = semantics start (make_init f (fromAList code) oracle s)
dec_clock_rename_state_typed=dec_clock (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (x :num sptree$num_map) (y :(α, β, γ) state)) = rename_state c x (dec_clock y)
domain_rename_state_code_typed=(domain (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) (s :(α, β, γ) state)).code :num -> bool) = (domain s.code :num -> bool)
find_code_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (find_code (dest_find_name f (dest :num + num)) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)).regs (rename_state c f s).code :α stackLang$prog option) = OPTION_MAP (comp f :α stackLang$prog -> α stackLang$prog) (find_code dest s.regs s.code :α stackLang$prog option)
get_var_imm_find_name_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ get_var_imm (ri_find_name f (ri :α reg_imm)) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) = get_var_imm ri s
get_var_find_name_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (get_var (find_name f (v :num)) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α word_loc option) = (get_var v s :α word_loc option)
inst_rename_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ inst (inst_find_name f (i :α inst)) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) = OPTION_MAP (rename_state c f :(α, β, γ) state -> (α, β, γ) state) (inst i s)
FLOOKUP_rename_state_find_name_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ FLOOKUP (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)).regs (find_name f (k :num)) = FLOOKUP s.regs k
mem_load_rename_state_typed=mem_load (x :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) (s :(α, β, γ) state)) = mem_load x s
mem_store_rename_state_typed=mem_store (x :α word) (y :α word_loc) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) (s :(α, β, γ) state)) = OPTION_MAP (rename_state c f :(α, β, γ) state -> (α, β, γ) state) (mem_store x y s)
rename_state_def_typed=∀(compile_rest :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) (s :(α, β, γ) state). rename_state compile_rest f s = s with <|regs := MAP_KEYS (find_name f) s.regs; code := fromAList (compile f (toAList s.code)); compile := compile_rest; compile_oracle := ((I :β -> β) ## (compile f :(num # α stackLang$prog) list -> (num # α stackLang$prog) list) ## (I :α word list -> α word list)) ∘ s.compile_oracle; ffi_save_regs := IMAGE (find_name f) s.ffi_save_regs|>
rename_state_const_typed=(rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) (s :(α, β, γ) state)).memory = s.memory ∧ ((rename_state c f s).be ⇔ s.be) ∧ (rename_state c f s).mdomain = s.mdomain ∧ (rename_state c f s).sh_mdomain = s.sh_mdomain ∧ (rename_state c f s).code_buffer = s.code_buffer ∧ (rename_state c f s).clock = s.clock ∧ (rename_state c f s).compile = c ∧ ((rename_state c f s).use_stack ⇔ s.use_stack) ∧ (rename_state c f s).fp_regs = s.fp_regs
rename_state_with_clock_typed=rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) ((s :(α, β, γ) state) with clock := (k :num)) = rename_state c f s with clock := k
rename_state_with_memory_typed=rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) ((s :(α, β, γ) state) with memory := (k :α word -> α word_loc)) = rename_state c f s with memory := k
set_fp_var_find_name_typed=rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) (f :num sptree$num_map) (set_fp_var (x :num) (y :word64) (z :(α, β, γ) state)) = set_fp_var x y (rename_state c f z)
set_var_find_name_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (set_var (x :num) (y :α word_loc) (z :(α, β, γ) state)) = set_var (find_name f x) y (rename_state c f z)
sh_mem_load16_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_load16 (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_load16 x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_load16 x y s :α result option # (α, β, γ) state)))
sh_mem_load32_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_load32 (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_load32 x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_load32 x y s :α result option # (α, β, γ) state)))
sh_mem_load_byte_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_load_byte (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_load_byte x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_load_byte x y s :α result option # (α, β, γ) state)))
sh_mem_load_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_load (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_load x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_load x y s :α result option # (α, β, γ) state)))
sh_mem_op_rename_store_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ sh_mem_op (op :memop) (find_name f (r :num)) (a :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) = (FST (sh_mem_op op r a s),rename_state c f (SND (sh_mem_op op r a s)))
sh_mem_store16_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_store16 (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_store16 x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_store16 x y s :α result option # (α, β, γ) state)))
sh_mem_store32_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_store32 (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_store32 x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_store32 x y s :α result option # (α, β, γ) state)))
sh_mem_store_byte_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_store_byte (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_store_byte x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_store_byte x y s :α result option # (α, β, γ) state)))
sh_mem_store_rename_state_typed=find_name (f :num sptree$num_map) PERMUTES 𝕌(:num) ⇒ (sh_mem_store (find_name f (x :num)) (y :α word) (rename_state (c :β -> (num # α stackLang$prog) list -> (word8 list # β) option) f (s :(α, β, γ) state)) :α result option # (α, β, γ) state) = (FST (sh_mem_store x y s :α result option # (α, β, γ) state),rename_state c f (SND (sh_mem_store x y s :α result option # (α, β, γ) state)))
