adjust_bv_def_typed=(∀(i :int) (b :num -> num). adjust_bv b (Number i :v) = (Number i :v)) ∧ (∀(w :word64) (b :num -> num). adjust_bv b (Word64 w :v) = (Word64 w :v)) ∧ (∀(r :num) (l :bool) (b :num -> num). adjust_bv b (RefPtr l r :v) = (RefPtr l (b r) :v)) ∧ (∀(c :num) (b :num -> num). adjust_bv b (CodePtr c) = CodePtr (bvl_num_stubs + bvl_to_bvi_namespaces * c)) ∧ ∀(vs :v list) (tag :num) (b :num -> num). adjust_bv b (Block tag vs) = Block tag (MAP (λ(a :v). adjust_bv b a) vs)
adjust_bv_Unit_typed=adjust_bv (x :num -> num) Unit = Unit
adjust_bv_Boolv_typed=adjust_bv (x :num -> num) (Boolv (b :bool) :v) = (Boolv b :v)
aux_code_installed_def_typed=(∀(t :(α # β) sptree$num_map). aux_code_installed ([] :(num # α # β) list) t ⇔ T) ∧ ∀(t :(α # β) sptree$num_map) (rest :(num # α # β) list) (name :num) (body :β) (arg_count :α). aux_code_installed ((name,arg_count,body)::rest) t ⇔ lookup name t = SOME (arg_count,body) ∧ aux_code_installed rest t
aux_code_installed_subspt_typed=∀(x :(num # α # β) list) (c1 :(α # β) sptree$num_map) (c2 :(α # β) sptree$num_map). aux_code_installed x c1 ∧ subspt c1 c2 ⇒ aux_code_installed x c2
names_ok_def_typed=∀(s_code :α sptree$num_map) (t_code :β sptree$num_map) (s_oracle :num -> (num # γ) # (δ # ε # bvl$exp) list). names_ok s_code t_code s_oracle ⇔ (∀(n :num) (k :num # γ) (prog :(δ # ε # bvl$exp) list). s_oracle n = (k,prog) ⇒ EVERY (λ((name :δ),(arity :ε),(exp :bvl$exp)). handle_ok [exp]) prog) ∧ (let (next :num) = FST (FST (s_oracle (0 :num))) in ∀(n :num). n ∈ (domain t_code :num -> bool) ∧ bvl_num_stubs ≤ n ⇒ if n MOD bvl_to_bvi_namespaces = (1 :num) then n < bvl_num_stubs + bvl_to_bvi_namespaces * next else n MOD bvl_to_bvi_namespaces = (0 :num) ∧ (n − bvl_num_stubs) DIV bvl_to_bvi_namespaces ∈ (domain s_code :num -> bool))
bv_ok_def_typed=(∀(refs :num |-> v ref) (r :num) (l :bool). bv_ok refs (RefPtr l r :v) ⇔ r ∈ FDOM refs) ∧ (∀(vs :v list) (tag :num) (refs :num |-> v ref). bv_ok refs (Block tag vs) ⇔ EVERY (λ(a :v). bv_ok refs a) vs) ∧ (∀(v2 :int) (refs :num |-> v ref). bv_ok refs (Number v2 :v) ⇔ T) ∧ (∀(v3 :word64) (refs :num |-> v ref). bv_ok refs (Word64 v3 :v) ⇔ T) ∧ ∀(v6 :num) (refs :num |-> v ref). bv_ok refs (CodePtr v6) ⇔ T
state_rel_def_typed=∀(b :num -> num) (s :(num # γ, 'ffi) bvlSem$state) (t :(γ, 'ffi) state). (state_rel b s t :bool) ⇔ INJ b (FDOM s.refs) (FDOM t.refs) ∧ (∀(k :num). case FLOOKUP s.refs k of (NONE :v ref option) => T | SOME (ValueArray vs :v ref) => FLOOKUP t.refs (b k) = SOME (ValueArray (MAP (adjust_bv b) vs) :v ref) | SOME (ByteArray v13 v14 :v ref) => FLOOKUP t.refs (b k) = SOME (ByteArray v13 v14 :v ref) | SOME (Thunk m v :v ref) => FLOOKUP t.refs (b k) = SOME (Thunk m (adjust_bv b v) :v ref) | SOME (MutBlock v17 v18 v19 v20 v21) => FLOOKUP t.refs (b k) = SOME (MutBlock v17 v18 v19 v20 v21)) ∧ s.ffi = t.ffi ∧ (∀(p :num). t.global = SOME p ⇒ p ∉ IMAGE b (FDOM s.refs) ∧ ∃(z :num). FLOOKUP t.refs p = SOME (ValueArray ((Number ((&SUC (LENGTH s.globals)) :int) :v)::(MAP (the (Number (0 :int) :v) ∘ OPTION_MAP (adjust_bv b)) s.globals ++ REPLICATE (z − SUC (LENGTH s.globals)) (Number (0 :int) :v))) :v ref) ∧ SUC (LENGTH s.globals) ≤ z) ∧ s.clock = t.clock ∧ t.compile_oracle = state_co compile_inc s.compile_oracle ∧ s.compile = state_cc compile_inc t.compile ∧ lookup AllocGlobal_location t.code = SOME AllocGlobal_code ∧ lookup CopyGlobals_location t.code = SOME CopyGlobals_code ∧ lookup ListLength_location t.code = SOME ListLength_code ∧ lookup FromListByte_location t.code = SOME FromListByte_code ∧ lookup ToListByte_location t.code = SOME ToListByte_code ∧ lookup SumListLength_location t.code = SOME SumListLength_code ∧ lookup ConcatByte_location t.code = SOME ConcatByte_code ∧ names_ok s.code t.code s.compile_oracle ∧ ∀(name :num) (arity :num) (exp :bvl$exp). lookup name s.code = SOME (arity,exp) ⇒ ∃(n :num). (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = (compile_exps n [exp] :bvi$exp list # (num # num # bvi$exp) app_list # num) in lookup (bvl_num_stubs + bvl_to_bvi_namespaces * name) t.code = SOME (arity,(compile_exp (HD c1) :bvi$exp)) ∧ aux_code_installed (append aux1) t.code ∧ handle_ok [exp])
state_rel_FLOOKUP_byteArray_typed=∀(b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) (m :bool) (l :word8 list) (n :num). (state_rel b s t :bool) ∧ FLOOKUP s.refs n = SOME (ByteArray m l :v ref) ⇒ FLOOKUP t.refs (b n) = SOME (ByteArray m l :v ref)
state_rel_FLOOKUP_valueArray_typed=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (ValueArray (vs :v list) :v ref) ⇒ FLOOKUP t.refs (b ptr) = SOME (ValueArray (MAP (adjust_bv b) vs) :v ref)
state_rel_FLOOKUP_MutBlock_typed=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (MutBlock (tg :num) (fin :bool) (l :v list) (c :v) (r :v list)) ⇒ FLOOKUP t.refs (b ptr) = SOME (MutBlock tg fin l c r)
state_rel_FLOOKUP_Thunk_typed=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (Thunk (m :thunk_mode) (v :v) :v ref) ⇒ FLOOKUP t.refs (b ptr) = SOME (Thunk m (adjust_bv b v) :v ref)
state_ok_def_typed=∀(s :(γ, 'ffi) bvlSem$state). state_ok s ⇔ EVERY (λ(x :v option). case x of (NONE :v option) => T | SOME v => bv_ok s.refs v) s.globals ∧ ∀(k :num). case FLOOKUP s.refs k of (NONE :v ref option) => T | SOME (ValueArray vs :v ref) => EVERY (bv_ok s.refs) vs | SOME (ByteArray v14 v15 :v ref) => T | SOME (Thunk v16 v :v ref) => bv_ok s.refs v | SOME (MutBlock v18 v19 v20 v21 v22) => T
list_to_v_ok_typed=∀(xs :v list). EVERY (bv_ok (refs :num |-> v ref)) xs ⇒ bv_ok refs (list_to_v xs)
list_to_v_ok_APPEND_typed=∀(xs :v list) (ys :v list). bv_ok (refs :num |-> v ref) (list_to_v xs) ∧ bv_ok refs (list_to_v ys) ⇒ bv_ok refs (list_to_v (xs ++ ys))
find_code_bv_ok_typed=(find_code (dest :num option) (vs :v list) (s :(num # α) sptree$num_map) :(v list # α) option) = SOME ((args :v list),(e2 :α)) ∧ EVERY (bv_ok (refs :num |-> v ref)) vs ⇒ EVERY (bv_ok refs) args
do_build_ok_typed=∀(parts :const_part list) (m :num -> v) (n :num) (r :(α, β) bvlSem$state) (q :v) (rs :num |-> v ref). do_build m n parts r.refs = (q,rs) ∧ state_ok r ∧ (∀(k :num). bv_ok r.refs (m k)) ⇒ state_ok (r with refs := rs) ∧ bv_ok rs q
do_app_ok_typed=state_ok (r :(α, β) bvlSem$state) ∧ EVERY (bv_ok r.refs) (a :v list) ∧ (do_app (op :closLang$op) a r :(v # (α, β) bvlSem$state, v) result) = (Rval ((q :v),(t :(α, β) bvlSem$state)) :(v # (α, β) bvlSem$state, v) result) ⇒ state_ok t ∧ bv_ok t.refs q ∧ (EVERY (bv_ok r.refs) (env :v list) ⇒ EVERY (bv_ok t.refs) env)
evaluate_ok_typed=∀(xs :bvl$exp list) (env :v list) (s :(α, β) bvlSem$state) (res :(v list, v) result) (t :(α, β) bvlSem$state). (evaluate (xs,env,s) :(v list, v) result # (α, β) bvlSem$state) = (res,t) ∧ state_ok s ∧ EVERY (bv_ok s.refs) env ⇒ state_ok t ∧ (case res of (Rval vs :(v list, v) result) => EVERY (bv_ok t.refs) vs | (Rerr (Rraise v) :(v list, v) result) => bv_ok t.refs v | (Rerr (Rabort v8 :v error_result) :(v list, v) result) => T) ∧ EVERY (bv_ok t.refs) env
compile_inc_no_mutcons_typed=(compile_inc (n :num) (prog :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list) = ((n1 :num),(prog1 :(num # num # bvi$exp) list)) ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog1
bvi_tailrec_compile_prog_no_mutcons_typed=∀(b :bool) (next :num) (prog :(num # num # bvi$exp) list) (next1 :num) (prog1 :(num # num # bvi$exp) list). (compile_prog b next prog :num # (num # num # bvi$exp) list) = (next1,prog1) ∧ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog1
