build_part_words_def_typed=(∀(c :data_to_word$config) (m :num -> α word_loc) (i :int) (offset :α word). build_part_words c m (Int i :const_part) offset = if small_int (:α) i then SOME (Word (Smallnum i :α word),([] :α word_loc list)) else (let ((sign :bool),(ws :α word list)) = (i2mw i :bool # α word list) in case (encode_header c (w2n ((b2w sign :α word) ≪ (2 :num) ‖ (3w :α word))) (LENGTH ws) :α word option) of (NONE :α word option) => (NONE :(α word_loc # α word_loc list) option) | SOME hd => SOME (make_ptr c offset (0w :α word) (LENGTH ws),MAP (Word :α word -> α word_loc) (hd::ws)))) ∧ (∀(c :data_to_word$config) (m :num -> α word_loc) (t :num) (ns :num list) (offset :α word). build_part_words c m (Con t ns :const_part) offset = if NULL ns then if t < dimword (:α) DIV (16 :num) then SOME (Word (n2w ((16 :num) * t + (2 :num)) :α word),([] :α word_loc list)) else (NONE :(α word_loc # α word_loc list) option) else case (encode_header c ((4 :num) * t) (LENGTH ns) :α word option) of (NONE :α word option) => (NONE :(α word_loc # α word_loc list) option) | SOME hd => SOME (make_cons_ptr c offset t (LENGTH ns),Word hd::MAP m ns)) ∧ (∀(c :data_to_word$config) (m :num -> α word_loc) (w :word64) (offset :α word). build_part_words c m (W64 w :const_part) offset = (let (ws :α word list) = if dimindex (:α) < (64 :num) then [(((63 :num) >< (32 :num)) w :α word); (((31 :num) >< (0 :num)) w :α word)] else [(((63 :num) >< (0 :num)) w :α word)] in case (encode_header c (3 :num) (LENGTH ws) :α word option) of (NONE :α word option) => (NONE :(α word_loc # α word_loc list) option) | SOME hd => SOME (make_ptr c offset (0w :α word) (LENGTH ws),MAP (Word :α word -> α word_loc) (hd::ws)))) ∧ ∀(c :data_to_word$config) (m :num -> α word_loc) (s :mlstring) (offset :α word). build_part_words c m (Str s) offset = (let (bytes :word8 list) = MAP ((n2w :num -> word8) ∘ ORD) (explode s); (n :num) = LENGTH bytes; (hd :α word) = (make_byte_header c T n :α word); (ws :α word list) = write_bytes bytes (REPLICATE (byte_len (:α) n) (0w :α word)) c.be in if byte_len (:α) n < (2 :num) ** (dimindex (:α) − (4 :num)) ∧ byte_len (:α) n < (2 :num) ** c.len_size then SOME (make_ptr c offset (0w :α word) (byte_len (:α) n),MAP (Word :α word -> α word_loc) (hd::ws)) else (NONE :(α word_loc # α word_loc list) option))
build_words_def_typed=(∀(c :data_to_word$config) (m :num -> α word_loc) (i :num) (off :α word). build_words c m i ([] :const_part list) off = SOME (m (i − (1 :num)),([] :α word_loc list))) ∧ ∀(c :data_to_word$config) (m :num -> α word_loc) (i :num) (x :const_part) (parts :const_part list) (off :α word). build_words c m i (x::parts) off = case build_part_words c m x off of (NONE :(α word_loc # α word_loc list) option) => (NONE :(α word_loc # α word_loc list) option) | SOME (w,xs) => case build_words c m⦇i ↦ w⦈ (i + (1 :num)) parts (off + (bytes_in_word :α word) * (n2w (LENGTH xs) :α word)) of (NONE :(α word_loc # α word_loc list) option) => (NONE :(α word_loc # α word_loc list) option) | SOME (r,ys) => SOME (r,xs ++ ys)
do_part_SOME_IMP_SOME_typed=(do_part (map0 :num -> v) (h :const_part) (refs :α ref sptree$num_map) (SOME (ts :num)) :v # α ref sptree$num_map # num option) = ((x :v),(s1 :α ref sptree$num_map),(ts1 :num option)) ⇒ ∃(ts' :num). ts1 = SOME ts'
least_notin_domain_typed=(LEAST(ptr :num). ptr ∉ (domain (refs :α sptree$num_map) :num -> bool)) ∉ (domain refs :num -> bool)
byte_aligned_bytes_in_word_typed=good_dimindex (:α) ⇒ byte_aligned (bytes_in_word :α word)
byte_align_mult_bytes_in_word_typed=good_dimindex (:α) ⇒ byte_aligned ((w :α word) * (bytes_in_word :α word)) ∧ byte_aligned ((bytes_in_word :α word) * w)
word_and_lsr_0_typed=(∀(i :num). (k :num) ≤ i ∧ i < dimindex (:α) ⇒ ¬(((w :α word) ' i) :bool)) ⇒ w && (n :α word) ≪ k = (0w :α word)
byte_aligned_IMP_shift_typed=byte_aligned (w :α word) ∧ good_dimindex (:α) ⇒ ∃(v :α word). w = v ≪ (shift (:α) :num)
make_cons_ptr_add_typed=byte_aligned (n :α word) ∧ good_dimindex (:α) ∧ (shift (:α) :num) ≤ shift_length (c :data_to_word$config) ⇒ make_cons_ptr c n (tag :num) (len :num) = Word (n ≪ (shift_length c − (shift (:α) :num)) + get_lowerbits c (Word (ptr_bits c tag len :α word)))
make_ptr_add_typed=byte_aligned (n :α word) ∧ good_dimindex (:α) ∧ (shift (:α) :num) ≤ shift_length (c :data_to_word$config) ⇒ make_ptr c n (tag :β) (len :γ) = Word (n ≪ (shift_length c − (shift (:α) :num)) + (1w :α word))
all_ones_bit_typed=(i :num) < dimindex (:α) ⇒ ((((all_ones (e :num) (b :num) :α word) ' i) :bool) ⇔ b ≤ i ∧ i < e)
