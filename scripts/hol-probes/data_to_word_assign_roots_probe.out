Compare1_code_thm_typed=∀(l :α word) (a1 :α word) (a2 :α word) (dm :α word -> bool) (m :α word -> α word_loc) (res :α word) (t :(α, γ, 'ffi) wordSem$state). word_cmp_loop l a1 a2 dm m = SOME res ∧ dm = t.mdomain ∧ m = t.memory ∧ (lookup Compare1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Compare1_code :α wordLang$prog)) ∧ (lookup Compare1_location t.stack_size :num option) = t.locals_size ∧ (get_var (0 :num) t :α word_loc option) = SOME (Loc (l1 :num) (l2 :num) :α word_loc) ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word l) ∧ (get_var (4 :num) t :α word_loc option) = SOME (Word a1) ∧ (get_var (6 :num) t :α word_loc option) = SOME (Word a2) ∧ w2n l ≤ t.clock ⇒ ∃(ck :num) (smx :num option). (evaluate ((Compare1_code :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [Word res] :α result),t with <|clock := ck; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); stack_max := smx|>) ∧ option_le smx (OPTION_MAP2 MAX t.stack_max (OPTION_MAP2 $+ (stack_size t.stack :num option) t.locals_size)) ∧ t.clock ≤ w2n l + ck
word_exp_insert_typed=((m :num) ≠ (n :num) ⇒ (word_exp ((t :(α, β, γ) wordSem$state) with locals := (insert n (w :α word_loc) t.locals :α word_loc sptree$num_map)) (real_addr (c :data_to_word$config) m :α wordLang$exp) :α word_loc option) = (word_exp t (real_addr c m :α wordLang$exp) :α word_loc option)) ∧ (m ∉ {n; (n1 :num)} ⇒ (word_exp (t with locals := (insert n w (insert n1 (w1 :α word_loc) t.locals :α word_loc sptree$num_map) :α word_loc sptree$num_map)) (real_addr c m :α wordLang$exp) :α word_loc option) = (word_exp t (real_addr c m :α wordLang$exp) :α word_loc option))
sane_locals_size_def_typed=∀(t :(α, β, γ) wordSem$state). sane_locals_size t ⇔ t.locals_size = (lookup Equal_location t.stack_size :num option) ∨ t.locals_size = (lookup Equal1_location t.stack_size :num option)
Equal_code_lemma_typed=(∀(c :data_to_word$config) (st :store_name |-> α word_loc) (dm :α word -> bool) (m :α word -> α word_loc) (l :num) (wck :num) (v1 :α word) (v2 :α word) (t :(α, γ, 'ffi) wordSem$state) (l1 :num) (l2 :num) (res :α word) (l' :num) (wck' :num). word_eq c st dm m l wck v1 v2 = SOME (res,l',wck') ∧ dm = t.mdomain ∧ m = t.memory ∧ st = t.store ∧ l ≤ t.clock ∧ shift_length c < dimindex (:α) ∧ (lookup Equal_location t.code :(num # α wordLang$prog) option) = SOME ((3 :num),(Equal_code c :α wordLang$prog)) ∧ (lookup Equal1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Equal1_code :α wordLang$prog)) ∧ (lookup Compare1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Compare1_code :α wordLang$prog)) ∧ (get_var (0 :num) t :α word_loc option) = SOME (Loc l1 l2 :α word_loc) ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word v1) ∧ (get_var (4 :num) t :α word_loc option) = SOME (Word v2) ∧ c.len_size ≠ (0 :num) ∧ c.len_size < dimindex (:α) ∧ sane_locals_size t ∧ good_dimindex (:α) ⇒ ∃(ck :num) (new_p :num -> num -> num) (smx :num option). (evaluate ((Equal_code c :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [Word res] :α result),t with <|clock := ck; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); permute := new_p; stack_max := smx|>) ∧ option_le smx (OPTION_MAP2 MAX t.stack_max (OPTION_MAP2 $+ (stack_size t.stack :num option) (eq_code_stack_max (wck + (1 :num)) t.stack_size))) ∧ l' ≤ ck) ∧ ∀(c :data_to_word$config) (st :store_name |-> α word_loc) (dm :α word -> bool) (m :α word -> α word_loc) (l :num) (wck :num) (w :α word) (a1 :α word) (a2 :α word) (t :(α, γ, 'ffi) wordSem$state) (l1 :num) (l2 :num) (res :α word) (l' :num) (wck' :num). word_eq_list c st dm m l wck w a1 a2 = SOME (res,l',wck') ∧ dm = t.mdomain ∧ m = t.memory ∧ st = t.store ∧ l ≤ t.clock ∧ shift_length c < dimindex (:α) ∧ (lookup Equal_location t.code :(num # α wordLang$prog) option) = SOME ((3 :num),(Equal_code c :α wordLang$prog)) ∧ (lookup Equal1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Equal1_code :α wordLang$prog)) ∧ (lookup Compare1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Compare1_code :α wordLang$prog)) ∧ (get_var (0 :num) t :α word_loc option) = SOME (Loc l1 l2 :α word_loc) ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word w) ∧ (get_var (4 :num) t :α word_loc option) = SOME (Word a1) ∧ (get_var (6 :num) t :α word_loc option) = SOME (Word a2) ∧ sane_locals_size t ∧ c.len_size ≠ (0 :num) ∧ c.len_size < dimindex (:α) ∧ good_dimindex (:α) ⇒ ∃(ck :num) (new_p :num -> num -> num) (smx :num option). (evaluate ((Equal1_code :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [Word res] :α result),t with <|clock := ck; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); permute := new_p; stack_max := smx|>) ∧ option_le smx (OPTION_MAP2 MAX t.stack_max (OPTION_MAP2 $+ (stack_size t.stack :num option) (eq_code_stack_max (wck + (1 :num)) t.stack_size))) ∧ l' ≤ ck
Equal_code_thm_typed=word_eq (c :data_to_word$config) (st :store_name |-> α word_loc) (dm :α word -> bool) (m :α word -> α word_loc) (l :num) (wck :num) (v1 :α word) (v2 :α word) = SOME ((res :α word),(l' :num),(wck' :num)) ∧ dm = (t :(α, γ, 'ffi) wordSem$state).mdomain ∧ m = t.memory ∧ st = t.store ∧ l ≤ t.clock ∧ shift_length c < dimindex (:α) ∧ t.locals_size = (lookup Equal_location t.stack_size :num option) ∧ (lookup Equal_location t.code :(num # α wordLang$prog) option) = SOME ((3 :num),(Equal_code c :α wordLang$prog)) ∧ (lookup Equal1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Equal1_code :α wordLang$prog)) ∧ (lookup Compare1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Compare1_code :α wordLang$prog)) ∧ (get_var (0 :num) t :α word_loc option) = SOME (Loc (l1 :num) (l2 :num) :α word_loc) ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word v1) ∧ (get_var (4 :num) t :α word_loc option) = SOME (Word v2) ∧ c.len_size ≠ (0 :num) ∧ c.len_size < dimindex (:α) ∧ good_dimindex (:α) ⇒ ∃(ck :num) (new_p :num -> num -> num) (smx :num option). (evaluate ((Equal_code c :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [Word res] :α result),t with <|clock := ck; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); permute := new_p; stack_max := smx|>) ∧ option_le smx (OPTION_MAP2 MAX t.stack_max (OPTION_MAP2 $+ (stack_size t.stack :num option) (eq_code_stack_max (wck + (1 :num)) t.stack_size))) ∧ l' ≤ ck
assign_Equal_typed=(op :closLang$op) = BlockOp Equal ⇒ (state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (NONE :(v # α word_loc) list option) (locs :(num # num) list) :bool) ∧ (op_requires_names op ⇎ (names_opt :sptree$num_set option) = (NONE :sptree$num_set option)) ∧ cut_state_opt names_opt s = SOME (x :(γ, 'ffi) dataSem$state) ∧ (get_vars (args :num list) s.locals :v list option) = SOME (vals :v list) ∧ t.termdep > (1 :num) ∧ (do_app op vals x :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) = (Rval ((v :v),(s2 :(γ, 'ffi) dataSem$state)) :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) ⇒ ∃(q :α result option) (r :(α, γ, 'ffi) wordSem$state). (evaluate (FST (assign c (n :num) (l :num) (dest :num) op args names_opt :α wordLang$prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (q,r) ∧ (q = SOME (NotEnoughSpace :α result) ⇒ r.ffi = t.ffi ∧ option_le r.stack_max s2.stack_max ∧ (c.gc_kind ≠ None ⇒ ¬s2.safe_for_space)) ∧ (q ≠ SOME (NotEnoughSpace :α result) ⇒ (state_rel c l1 l2 (set_var dest v s2) r (NONE :(v # α word_loc) list option) locs :bool) ∧ q = (NONE :α result option))
assign_EqualConst_typed=(∃(p :const_part). (op :closLang$op) = BlockOp (EqualConst p)) ⇒ (state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (NONE :(v # α word_loc) list option) (locs :(num # num) list) :bool) ∧ (op_requires_names op ⇎ (names_opt :sptree$num_set option) = (NONE :sptree$num_set option)) ∧ cut_state_opt names_opt s = SOME (x :(γ, 'ffi) dataSem$state) ∧ (get_vars (args :num list) s.locals :v list option) = SOME (vals :v list) ∧ t.termdep > (1 :num) ∧ (do_app op vals x :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) = (Rval ((v :v),(s2 :(γ, 'ffi) dataSem$state)) :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) ⇒ ∃(q :α result option) (r :(α, γ, 'ffi) wordSem$state). (evaluate (FST (assign c (n :num) (l :num) (dest :num) op args names_opt :α wordLang$prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (q,r) ∧ (q = SOME (NotEnoughSpace :α result) ⇒ r.ffi = t.ffi ∧ option_le r.stack_max s2.stack_max ∧ (c.gc_kind ≠ None ⇒ ¬s2.safe_for_space)) ∧ (q ≠ SOME (NotEnoughSpace :α result) ⇒ (state_rel c l1 l2 (set_var dest v s2) r (NONE :(v # α word_loc) list option) locs :bool) ∧ q = (NONE :α result option))
Compare_code_thm_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((Number (i1 :int) :v),Word (v1 :α word))::((Number (i2 :int) :v),Word (v2 :α word))::(vars :(v # α word_loc) list)) ∧ dm = (t :(α, γ, 'ffi) wordSem$state).mdomain ∧ m = t.memory ∧ st = t.store ∧ (¬word_bit (0 :num) v1 ⇒ word_bit (0 :num) v2) ∧ shift_length c < dimindex (:α) ∧ (lookup Compare1_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(Compare1_code :α wordLang$prog)) ∧ (get_var (0 :num) t :α word_loc option) = SOME (Loc (l1 :num) (l2 :num) :α word_loc) ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word v1) ∧ (get_var (4 :num) t :α word_loc option) = SOME (Word v2) ∧ dimword (:α) < t.clock ∧ c.len_size ≠ (0 :num) ∧ c.len_size < dimindex (:α) ∧ good_dimindex (:α) ⇒ ∃(ck :num) (smx :num option). (evaluate ((Compare_code c :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [Word (word_cmp_res i1 i2 :α word)] :α result),t with <|clock := ck; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); stack_max := smx|>) ∧ option_le smx (OPTION_MAP2 MAX t.stack_max (OPTION_MAP2 $+ (stack_size t.stack :num option) (lookup Compare1_location t.stack_size :num option)))
word_cmp_Less_word_cmp_res_typed=∀(i :int) (i' :int). good_dimindex (:α) ⇒ ((word_cmp Less (word_cmp_res i i' :α word) (1w :α word) :bool) ⇔ i < i')
word_cmp_NotLess_word_cmp_res_typed=∀(i :int) (i' :int). good_dimindex (:α) ⇒ ((word_cmp NotLess (1w :α word) (word_cmp_res i i' :α word) :bool) ⇔ i ≤ i')
word_cmp_not_NotLess_word_cmp_res_typed=∀(i :int) (i' :int). good_dimindex (:α) ⇒ (¬(word_cmp NotLess (1w :α word) (word_cmp_res i i' :α word) :bool) ⇔ i' < i)
