word_ml_inv_get_vars_IMP_lemma_typed=word_ml_inv ((heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) (c :data_to_word$config) (refs :v ref sptree$num_map) (join_env (ll :v sptree$num_map) (toAList (inter (t :(α, β, γ) wordSem$state).locals (adjust_set ll))) ++ (envs :(v # α word_loc) list)) ∧ (get_vars (n :num list) ll :v list option) = SOME (x :v list) ∧ (get_vars (MAP adjust_var n) t :α word_loc list option) = SOME (w :α word_loc list) ⇒ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c refs (ZIP (x,w) ++ join_env ll (toAList (inter t.locals (adjust_set ll))) ++ envs)
memory_rel_lookup_var_IMP_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (join_env (ll :v sptree$num_map) (toAList (inter (t :(α, γ, 'ffi) wordSem$state).locals (adjust_set ll))) ++ (envs :(v # α word_loc) list)) ∧ (get_vars (n :num list) ll :v list option) = SOME (x :v list) ∧ (get_vars (MAP adjust_var n) t :α word_loc list option) = SOME (w :α word_loc list) ⇒ memory_rel c be ts refs sp st m dm (ZIP (x,w) ++ join_env ll (toAList (inter t.locals (adjust_set ll))) ++ envs)
get_real_offset_lemma_typed=(get_var (v :num) (t :(α, β, γ) wordSem$state) :α word_loc option) = SOME (Word (i_w :α word)) ∧ good_dimindex (:α) ∧ get_real_offset i_w = SOME (y :α word) ⇒ (word_exp t (real_offset (c :data_to_word$config) v :α wordLang$exp) :α word_loc option) = SOME (Word y)
get_real_byte_offset_lemma_typed=(get_var (v :num) (t :(α, β, γ) wordSem$state) :α word_loc option) = SOME (Word (w :α word)) ∧ good_dimindex (:α) ⇒ (word_exp t (real_byte_offset v :α wordLang$exp) :α word_loc option) = SOME (Word ((bytes_in_word :α word) + w ⋙ (2 :num)))
reorder_lemma_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (x :(β, γ) dataSem$state).refs x.space (t :(α, δ, ε) wordSem$state).store t.memory t.mdomain ((x1 :v # α word_loc)::(x2 :v # α word_loc)::(x3 :v # α word_loc)::(xs :(v # α word_loc) list)) ⇒ memory_rel c be ts x.refs x.space t.store t.memory t.mdomain (x3::x1::x2::xs)
reorder_2_lemma_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (x :(β, γ) dataSem$state).refs x.space (t :(α, δ, ε) wordSem$state).store t.memory t.mdomain ((x1 :v # α word_loc)::(x2 :v # α word_loc)::(xs :(v # α word_loc) list)) ⇒ memory_rel c be ts x.refs x.space t.store t.memory t.mdomain (x2::x1::xs)
word_ml_inv_num_typed=word_ml_inv ((heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) (c :data_to_word$config) (s :(β, γ) dataSem$state).refs (ws :(v # α word_loc) list) ∧ good_dimindex (:α) ∧ small_enough_int ((&(n :num)) :int) ⇒ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c s.refs (((Number ((&n) :int) :v),Word (n2w ((4 :num) * n) :α word))::ws)
word_ml_inv_neg_num_typed=word_ml_inv ((heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) (c :data_to_word$config) (s :(β, γ) dataSem$state).refs (ws :(v # α word_loc) list) ∧ good_dimindex (:α) ∧ small_enough_int (-((&(n :num)) :int)) ∧ n ≠ (0 :num) ⇒ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c s.refs (((Number (-((&n) :int)) :v),Word (-(n2w ((4 :num) * n) :α word)))::ws)
word_ml_inv_zero_typed=word_ml_inv ((heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) (c :data_to_word$config) (s :(β, γ) dataSem$state).refs (ws :(v # α word_loc) list) ∧ good_dimindex (:α) ∧ small_enough_int (0 :int) ⇒ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c s.refs (((Number (0 :int) :v),Word (0w :α word))::ws)
memory_rel_Deref_prime_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((RefPtr (bl :bool) (nn :num) :v),(ptr :α word_loc))::(vars :(v # α word_loc) list)) ∧ (lookup nn refs :v ref option) = SOME (ValueArray (vals :v list) :v ref) ∧ good_dimindex (:α) ∧ (index :num) < LENGTH vals ⇒ ∃(ptr_w :α word) (x :α word). ptr = Word ptr_w ∧ get_real_addr c st ptr_w = SOME x ∧ x + (bytes_in_word :α word) + (bytes_in_word :α word) * (n2w index :α word) ∈ dm ∧ memory_rel c be ts refs sp st m dm ((vals❲index❳,m (x + (bytes_in_word :α word) + (bytes_in_word :α word) * (n2w index :α word)))::((RefPtr bl nn :v),ptr)::vars)
get_real_addr_lemma_typed=shift_length (c :data_to_word$config) < dimindex (:α) ∧ good_dimindex (:α) ∧ (get_var (v :num) (t :(α, γ, 'ffi) wordSem$state) :α word_loc option) = SOME (Word (ptr_w :α word)) ∧ get_real_addr c t.store ptr_w = SOME (x :α word) ⇒ (word_exp t (real_addr c v :α wordLang$exp) :α word_loc option) = SOME (Word x)
memcopy_def_typed=∀(m :α word -> β) (k :num) (dm :α word -> bool) (a2 :α word) (a1 :α word). memcopy k a1 a2 m dm = if k = (0 :num) then SOME m else if a1 ∈ dm ∧ a2 ∈ dm then memcopy (k − (1 :num)) (a1 + (bytes_in_word :α word)) (a2 + (bytes_in_word :α word)) m⦇a2 ↦ m a1⦈ dm else (NONE :(α word -> β) option)
MemCopy_thm_typed=∀(ret_val :α word_loc) (l1 :num) (l2 :num) (k :num) (a1 :α word) (a2 :α word) (s :(α, γ, 'ffi) wordSem$state) (m :α word -> α word_loc) (dm :α word -> bool) (m1 :α word -> α word_loc). memcopy k a1 a2 m dm = SOME m1 ∧ s.memory = m ∧ s.mdomain = dm ∧ (lookup MemCopy_location s.code :(num # α wordLang$prog) option) = SOME ((5 :num),(MemCopy_code :α wordLang$prog)) ∧ k ≤ s.clock ∧ (4 :num) * k < dimword (:α) ∧ (get_var (0 :num) s :α word_loc option) = SOME (Loc l1 l2 :α word_loc) ∧ (get_var (2 :num) s :α word_loc option) = SOME (Word (n2w ((4 :num) * k) :α word)) ∧ (get_var (4 :num) s :α word_loc option) = SOME (Word a1) ∧ (get_var (6 :num) s :α word_loc option) = SOME (Word a2) ∧ (get_var (8 :num) s :α word_loc option) = SOME ret_val ⇒ ∃(smx :num option). (evaluate ((MemCopy_code :α wordLang$prog),s) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [ret_val] :α result),s with <|clock := s.clock − k; memory := m1; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); stack_max := smx|>) ∧ option_le smx (OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack :num option) (lookup MemCopy_location s.stack_size :num option)))
memory_rel_IMP_free_space_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list) ⇒ ∃(nfree :α word) (curr :α word) (other :(α word # α word_loc -> bool) -> bool). FLOOKUP st NextFree = SOME (Word nfree) ∧ FLOOKUP st CurrHeap = SOME (Word curr) ∧ ((word_list_exists nfree sp :(α word # α word_loc -> bool) -> bool) * other) (fun2set (m,dm))
store_list_def_typed=(∀(a :α word) (m :α word -> α word_loc) (dm :α word -> bool). store_list a ([] :α word_loc list) m dm = SOME m) ∧ ∀(a :α word) (w :α word_loc) (ws :α word_loc list) (m :α word -> α word_loc) (dm :α word -> bool). store_list a (w::ws) m dm = if a ∈ dm then store_list (a + (bytes_in_word :α word)) ws m⦇a ↦ w⦈ dm else (NONE :(α word -> α word_loc) option)
IMP_store_list_SOME_typed=∀(ws :α word_loc list) (a :α word) (n :num) (m :α word -> α word_loc) (dm :α word -> bool) (other :(α word # α word_loc -> bool) -> bool). ((word_list_exists a n :(α word # α word_loc -> bool) -> bool) * other) (fun2set (m,dm)) ∧ LENGTH ws ≤ n ⇒ ∃(m1 :α word -> α word_loc). store_list a ws m dm = SOME m1 ∧ (word_list a ws * (word_list_exists (a + (bytes_in_word :α word) * (n2w (LENGTH ws) :α word)) (n − LENGTH ws) :(α word # α word_loc -> bool) -> bool) * other) (fun2set (m1,dm))
get_vars_cut_env_typed=∀(vs :num list) (bs :α list). cut_env (nms :sptree$num_set) (x1 :α sptree$num_map) = SOME (x2 :α sptree$num_map) ∧ (get_vars vs x1 :α list option) = SOME bs ∧ EVERY (λ(v :num). v ∈ (domain nms :num -> bool)) vs ⇒ (get_vars vs x2 :α list option) = SOME bs
