getWords_acc_typed=∀(ws :(α # β word_loc) list) (acc :(α # β word) list). getWords ws acc = (let ((cs :(α # β word) list),(c :(α # β word_loc) list)) = getWords ws ([] :(α # β word) list) in (REVERSE acc ++ cs,c))
