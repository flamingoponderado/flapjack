bignum_size_typed=good_dimindex (:α) ⇒ bignum_size (dimindex (:α) = (64 :num)) (i :int) = LENGTH (n2mw (Num (ABS i)) :α word list) + (1 :num)
LESS_EQ_num_size_typed=good_dimindex (:α) ⇒ ∀(m :num) (n :num). n ≤ m ⇒ SUC (LENGTH (n2mw n :α word list)) ≤ num_size m
part_to_words_LENGTH_typed=part_to_words (c :data_to_word$config) (m :(bool # α word_loc) sptree$num_map) (h :const_part) (a :α word) = SOME ((w :bool # α word_loc),(ws :(bool # α word_loc) list)) ∧ good_dimindex (:α) ⇒ LENGTH ws ≤ part_space_req h
