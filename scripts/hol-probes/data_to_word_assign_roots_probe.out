word_cond_add_def_typed=word_cond_add (c :data_to_word$config) (a :α word) (F,(x :α word_loc)) = x ∧ word_cond_add c a (T,Word (w :α word)) = Word (w + a ≪ (shift_length c − (shift (:α) :num))) ∧ word_cond_add c a (T,(Loc (v7 :num) (v8 :num) :α word_loc)) = (Loc v7 v8 :α word_loc)
store_list_word_cond_add_IMP_typed=∀(y2 :(bool # α word) list) (m :α word -> α word_loc) (a :α word) (m1 :α word -> α word_loc) (free :α word). store_list free (MAP (word_cond_add (c :data_to_word$config) a) (MAP (λ((b :bool),(c :α word)). (b,Word c)) y2)) m (dm :α word -> bool) = SOME m1 ⇒ const_addresses free y2 dm ∧ const_writes free (a ≪ (shift_length c − (shift (:α) :num))) y2 m = m1
