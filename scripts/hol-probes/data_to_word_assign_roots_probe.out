find_diff_str_cmp_thm1_typed=∀(vals1 :word8 list) (vals2 :word8 list). LENGTH vals1 = LENGTH vals2 ∧ good_dimindex (:α) ⇒ ∃(r1 :α word) (r2 :α word). find_diff vals1 vals2 (n2w (l :num) :α word) (n2w l :α word) = (r1,r2) ∧ (str_cmp T (cmp :opb) (implode (MAP (CHR ∘ (w2n :word8 -> num)) vals1)) (implode (MAP (CHR ∘ (w2n :word8 -> num)) vals2)) ⇔ (num_cmp cmp (w2n r1) (w2n r2) :bool))
find_diff_str_cmp_thm2_typed=∀(k :num) (vals1 :word8 list) (vals2 :word8 list) (l1 :num) (l2 :num). Abbrev (l1 = LENGTH vals1 + (2 :num) ** (shift (:α) :num)) ∧ Abbrev (l2 = LENGTH vals2 + (2 :num) ** (shift (:α) :num)) ∧ k + l1 < dimword (:α) ∧ k + l2 < dimword (:α) ∧ good_dimindex (:α) ⇒ ∃(r1 :α word) (r2 :α word). find_diff (TAKE (MIN (LENGTH vals1) (LENGTH vals2)) vals1) (TAKE (MIN (LENGTH vals1) (LENGTH vals2)) vals2) (n2w (k + l1) :α word) (n2w (k + l2) :α word) = (r1,r2) ∧ (str_cmp F (cmp :opb) (implode (MAP (CHR ∘ (w2n :word8 -> num)) vals1)) (implode (MAP (CHR ∘ (w2n :word8 -> num)) vals2)) ⇔ (num_cmp cmp (w2n r1) (w2n r2) :bool))
memory_rel_str_cmp_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((RefPtr (bl1 :bool) (p1 :num) :v),(v1 :α word_loc))::((RefPtr (bl2 :bool) (p2 :num) :v),(v2 :α word_loc))::(vars :(v # α word_loc) list)) ∧ (lookup p1 refs :v ref option) = SOME (ByteArray (fl1 :bool) (vals1 :word8 list) :v ref) ∧ (lookup p2 refs :v ref option) = SOME (ByteArray (fl2 :bool) (vals2 :word8 list) :v ref) ∧ good_dimindex (:α) ⇒ ∃(w1 :α word) (a1 :α word) (w2 :α word) (a2 :α word) (x1 :β) (m1 :γ) (r1 :α word) (r2 :α word). v1 = Word w1 ∧ v2 = Word w2 ∧ get_real_addr c st w1 = SOME a1 ∧ get_real_addr c st w2 = SOME a2 ∧ word_str_cmp (b :bool) a1 a2 dm m be c = SOME (r1,r2) ∧ (str_cmp b (cmp :opb) (implode (MAP (CHR ∘ (w2n :word8 -> num)) vals1)) (implode (MAP (CHR ∘ (w2n :word8 -> num)) vals2)) ⇔ (num_cmp cmp (w2n r1) (w2n r2) :bool))
evaluate_StringCmpLoop_typed=∀(a1 :α word) (a2 :α word) (r1 :α word) (r2 :α word) (len :α word) (be :bool) (ck :num) (dm :α word -> bool) (m :α word -> α word_loc) (l1 :num) (l2 :num) (t1 :(α, γ, 'ffi) wordSem$state) (x1 :α word) (x2 :α word). word_str_cmp_loop a1 a2 r1 r2 len dm m be ck = SOME (x1,x2) ∧ t1.memory = m ∧ t1.mdomain = dm ∧ (be ⇔ t1.be) ∧ ck < t1.clock ∧ good_dimindex (:α) ∧ (lookup StringCmpLoop_location t1.code :(num # α wordLang$prog) option) = SOME ((6 :num),(StringCmpLoop_code :α wordLang$prog)) ∧ (get_var (0 :num) t1 :α word_loc option) = SOME (Loc l1 l2 :α word_loc) ∧ (get_var (2 :num) t1 :α word_loc option) = SOME (Word a1) ∧ (get_var (4 :num) t1 :α word_loc option) = SOME (Word a2) ∧ (get_var (6 :num) t1 :α word_loc option) = SOME (Word len) ∧ (get_var (8 :num) t1 :α word_loc option) = SOME (Word r1) ∧ (get_var (10 :num) t1 :α word_loc option) = SOME (Word r2) ⇒ ∃(ck :num) (max_stack :num option). (evaluate ((StringCmpLoop_code :α wordLang$prog),t1) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [Word x1; Word x2] :α result),t1 with <|clock := ck; stack_max := max_stack; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num)|>) ∧ (max_stack ≠ t1.stack_max ⇒ max_stack = OPTION_MAP2 MAX t1.stack_max (OPTION_MAP2 $+ (stack_size t1.stack :num option) (lookup StringCmpLoop_location t1.stack_size :num option)))
