make_cons_ptr_thm_typed=make_cons_ptr (conf :data_to_word$config) (f :α word) (tag :num) (len :num) = Word (f ≪ (shift_length conf − (shift (:α) :num)) ‖ (1w :α word) ‖ (ptr_bits conf tag len :α word))
