evaluate_StoreAnyConsts_typed=∀(r1 :num) (r2 :num) (r3 :num) (vs :(bool # α word_loc) list) (w :bool # α word_loc) (s :(α, γ, 'ffi) wordSem$state) (free :α word) (m :α word -> α word_loc) (dm :α word -> bool) (m1 :α word -> α word_loc). store_list free (MAP (word_cond_add (c :data_to_word$config) (a :α word)) vs) m dm = SOME m1 ∧ m = s.memory ∧ dm = s.mdomain ∧ ALL_DISTINCT [r1; r2; r3] ∧ EVERY ((good_loc (domain s.code :num -> bool) :α word_loc -> bool) ∘ (SND :bool # α word_loc -> α word_loc)) (w::vs) ∧ (lookup r2 s.locals :α word_loc option) = SOME (Word free) ∧ (lookup r3 s.locals :α word_loc option) = SOME (Word (a ≪ (shift_length c − (shift (:α) :num)))) ⇒ ∃(ll :α word_loc sptree$num_map). (evaluate (StoreAnyConsts r1 r2 r3 vs w,s) :α result option # (α, γ, 'ffi) wordSem$state) = ((NONE :α result option),s with <|memory := m1; locals := ll; store := s.store⟨NextFree ↦ Word (free + (bytes_in_word :α word) * (n2w (LENGTH vs) :α word))⟩|>) ∧ (lookup r1 ll :α word_loc option) = SOME (word_cond_add c a w) ∧ ∀(n :num). ¬MEM n [r1; r2; r3] ⇒ (lookup n ll :α word_loc option) = (lookup n s.locals :α word_loc option)
