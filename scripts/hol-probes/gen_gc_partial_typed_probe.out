partial_gc_related_typed=roots_ok (roots :α heap_address list) (heap :(α, β) heap_element list) ∧ heap_ok heap (conf :β gen_gc_partial_conf).limit ∧ heap_gen_ok heap conf ⇒ ∃(state :(α, β) gc_state) (f :num |-> num). partial_gc conf (roots,heap) = (ADDR_MAP (FAPPLY f) roots,state) ∧ (∀(ptr :num) (u :α). MEM (Pointer ptr u) roots ⇒ ptr ∈ FDOM f) ∧ heap_ok (state.old ++ state.h1 ++ (heap_expand state.n :(α, β) heap_element list) ++ state.r1) conf.limit ∧ gc_related f heap (state.old ++ state.h1 ++ (heap_expand state.n :(α, β) heap_element list) ++ state.r1) ∧ state.ok
isSomeDataElement_heap_lookup_heap_expand_typed=¬isSomeDataElement (heap_lookup (x :num) (heap_expand (n :num) :(α, β) heap_element list))
new_f_def_typed=∀(f :num |-> num) (conf :α gen_gc_partial_conf) (heap :(β, γ) heap_element list). new_f f conf heap = FUN_FMAP (I :num -> num) (f_old_ptrs conf heap) ⊌ FUN_FMAP (λ(a :num). conf.gen_start + f⟨a − conf.gen_start⟩) (IMAGE ($+ conf.gen_start) (FDOM f))
f_old_ptrs_def_typed=∀(conf :α gen_gc_partial_conf) (heap :(β, γ) heap_element list). f_old_ptrs conf heap = {a | isSomeDataElement (heap_lookup a heap) ∧ (a < conf.gen_start ∨ conf.refs_start ≤ a)}
f_old_ptrs_finite_typed=∀(heap :(α, β) heap_element list) (conf :γ gen_gc_partial_conf). FINITE (f_old_ptrs conf heap)
isSomeDataElement_to_gen_heap_list_typed=∀(n :num) (heap :(α, β) heap_element list). isSomeDataElement (heap_lookup n (to_gen_heap_list (conf :γ gen_gc_partial_conf) heap)) ⇔ isSomeDataElement (heap_lookup n heap)
gc_move_ref_list_heap_length_typed=∀(h :(α, β) heap_element list) (x :(α, β) heap_element list) (state :(α, γ) gc_state) (state' :(α, γ) gc_state). gc_move_ref_list (conf :γ gen_gc_partial_conf) state h = (x,state') ⇒ heap_length state.heap = heap_length state'.heap
data_sort_typed=Protected::α -> (α, β) data_sort; Real::β -> (α, β) data_sort
to_gen_heap_address_def_typed=(∀(conf :β gen_gc_partial_conf) (a :α). to_gen_heap_address conf (Data a) = Data (Real a :(α heap_address, α) data_sort)) ∧ ∀(conf :β gen_gc_partial_conf) (ptr :num) (a :α). to_gen_heap_address conf (Pointer ptr a) = if ptr < conf.gen_start then Data (Protected (Pointer ptr a) :(α heap_address, α) data_sort) else if conf.refs_start ≤ ptr then Data (Protected (Pointer ptr a) :(α heap_address, α) data_sort) else Pointer (ptr − conf.gen_start) (Real a :(α heap_address, α) data_sort)
to_gen_conf_def_typed=∀(conf :α gen_gc_partial_conf). to_gen_conf conf = <|limit := conf.limit − conf.gen_start − (conf.limit − conf.refs_start); isRef := conf.isRef|>
to_gen_heap_element_def_typed=(∀(conf :γ gen_gc_partial_conf) (n :num). to_gen_heap_element conf (Unused n :(α, β) heap_element) = (Unused n :((α heap_address, α) data_sort, β) heap_element)) ∧ (∀(conf :γ gen_gc_partial_conf) (ptr :num) (a :α) (l :num). to_gen_heap_element conf (ForwardPointer ptr a l :(α, β) heap_element) = (ForwardPointer (ptr − conf.gen_start) (Real a :(α heap_address, α) data_sort) l :((α heap_address, α) data_sort, β) heap_element)) ∧ ∀(conf :γ gen_gc_partial_conf) (ptrs :α heap_address list) (l :num) (d :β). to_gen_heap_element conf (DataElement ptrs l d) = DataElement (MAP (to_gen_heap_address conf :α heap_address -> (α heap_address, α) data_sort heap_address) ptrs) l d
to_gen_heap_list_def_typed=∀(conf :γ gen_gc_partial_conf) (heap :(α, β) heap_element list). to_gen_heap_list conf heap = MAP (to_gen_heap_element conf :(α, β) heap_element -> ((α heap_address, α) data_sort, β) heap_element) heap
to_gen_heap_def_typed=∀(conf :γ gen_gc_partial_conf) (heap :(α, β) heap_element list). to_gen_heap conf heap = to_gen_heap_list conf (heap_restrict conf.gen_start conf.refs_start heap)
to_gen_state_def_typed=∀(conf :γ gen_gc_partial_conf) (state :(α, β) gc_state). to_gen_state conf state = (empty_state :((α heap_address, α) data_sort, β) gc_state) with <|h1 := to_gen_heap_list conf state.h1; h2 := to_gen_heap_list conf state.h2; r4 := ([] :((α heap_address, α) data_sort, β) heap_element list); r3 := ([] :((α heap_address, α) data_sort, β) heap_element list); r2 := ([] :((α heap_address, α) data_sort, β) heap_element list); r1 := ([] :((α heap_address, α) data_sort, β) heap_element list); a := state.a − conf.gen_start; n := state.n; ok := state.ok; heap := to_gen_heap conf state.heap; heap0 := to_gen_heap conf state.heap0|>
to_gen_roots_def_typed=∀(conf :β gen_gc_partial_conf) (roots :α heap_address list). to_gen_roots conf roots = MAP (to_gen_heap_address conf :α heap_address -> (α heap_address, α) data_sort heap_address) roots
refs_to_roots_def_typed=(∀(conf :β gen_gc_partial_conf). refs_to_roots conf ([] :(α, γ) heap_element list) = ([] :(α heap_address, α) data_sort heap_address list)) ∧ (∀(v1 :γ) (v0 :num) (refs :(α, γ) heap_element list) (ptrs :α heap_address list) (conf :β gen_gc_partial_conf). refs_to_roots conf (DataElement ptrs v0 v1::refs) = MAP (to_gen_heap_address conf :α heap_address -> (α heap_address, α) data_sort heap_address) ptrs ++ refs_to_roots conf refs) ∧ (∀(v6 :num) (refs :(α, γ) heap_element list) (conf :β gen_gc_partial_conf). refs_to_roots conf ((Unused v6 :(α, γ) heap_element)::refs) = refs_to_roots conf refs) ∧ ∀(v9 :num) (v8 :α) (v7 :num) (refs :(α, γ) heap_element list) (conf :β gen_gc_partial_conf). refs_to_roots conf ((ForwardPointer v7 v8 v9 :(α, γ) heap_element)::refs) = refs_to_roots conf refs
heap_element_is_ref_def_typed=(heap_element_is_ref (conf :α gen_gc_partial_conf) (DataElement (xs :β heap_address list) (l :num) (d :α)) ⇔ conf.isRef d) ∧ (heap_element_is_ref conf (Unused (v2 :num) :(β, α) heap_element) ⇔ F) ∧ (heap_element_is_ref conf (ForwardPointer (v3 :num) (v4 :β) (v5 :num) :(β, α) heap_element) ⇔ F)
heap_gen_ok_def_typed=∀(heap :(α, β) heap_element list) (conf :β gen_gc_partial_conf). heap_gen_ok heap conf ⇔ ∃(old :(α, β) heap_element list) (current :(α, β) heap_element list) (refs :(α, β) heap_element list). conf.gen_start ≤ conf.refs_start ∧ conf.refs_start ≤ conf.limit ∧ EVERY (isDataElement :(α, β) heap_element -> bool) old ∧ EVERY (isDataElement :(α, β) heap_element -> bool) refs ∧ SOME (old,current,refs) = heap_segment (conf.gen_start,conf.refs_start) heap ∧ (∀(ptr :num) (xs :α heap_address list) (l :num) (d :β) (u :α). MEM (DataElement xs l d) old ∧ MEM (Pointer ptr u) xs ⇒ ptr < conf.gen_start ∨ conf.refs_start ≤ ptr) ∧ (∀(xs :α heap_address list) (l :num) (d :β). MEM (DataElement xs l d) old ⇒ ¬conf.isRef d) ∧ (∀(xs :α heap_address list) (l :num) (d :β). MEM (DataElement xs l d) current ⇒ ¬conf.isRef d) ∧ ∀(xs :α heap_address list) (l :num) (d :β). MEM (DataElement xs l d) refs ⇒ conf.isRef d
gen_inv_def_typed=∀(conf :β gen_gc_partial_conf) (heap :(α, β) heap_element list). gen_inv conf heap ⇔ conf.gen_start ≤ conf.refs_start ∧ conf.refs_start ≤ conf.limit ∧ ∃(heap_old :(α, β) heap_element list) (heap_current :(α, β) heap_element list) (heap_refs :(α, β) heap_element list). heap_segment (conf.gen_start,conf.refs_start) heap = SOME (heap_old,heap_current,heap_refs) ∧ EVERY (λ(e :(α, β) heap_element). ¬heap_element_is_ref conf e) heap_old ∧ EVERY (λ(e :(α, β) heap_element). ¬heap_element_is_ref conf e) heap_current ∧ EVERY (isDataElement :(α, β) heap_element -> bool) heap_refs ∧ (∀(n :num) (a :α) (d :num). MEM (ForwardPointer n a d :(α, β) heap_element) heap ⇒ conf.gen_start ≤ n ∧ n < conf.refs_start) ∧ EVERY (isDataElement :(α, β) heap_element -> bool) heap_old ∧ ∀(xs :α heap_address list) (l :num) (d :β) (ptr :num) (u :α). MEM (DataElement xs l d) heap_old ∧ MEM (Pointer ptr u) xs ⇒ ptr < conf.gen_start ∨ conf.refs_start ≤ ptr
has_old_ptr_def_typed=∀(conf :α gen_gc_partial_conf) (hs :(β, γ) heap_element list) (ptr :num). has_old_ptr conf hs ptr ⇔ ∃(xs :β heap_address list) (l :num) (d :γ) (u :β). MEM (DataElement xs l d) hs ∧ MEM (Pointer ptr u) xs ∧ (ptr < conf.gen_start ∨ conf.refs_start ≤ ptr)
all_old_ptrs_def_typed=∀(conf :α gen_gc_partial_conf) (xs :β heap_address list) (ptr :num). all_old_ptrs conf xs ptr ⇔ ∃(u :β). MEM (Pointer ptr u) xs ∧ (ptr < conf.gen_start ∨ conf.refs_start ≤ ptr)
sim_inv_def_typed=∀(conf :β gen_gc_partial_conf) (heap0 :(α, β) heap_element list) (state :(α, β) gc_state). sim_inv conf heap0 state ⇔ gen_inv conf state.heap ∧ conf.gen_start ≤ state.a ∧ state.a + state.n ≤ conf.refs_start ∧ conf.gen_start + heap_length (state.h1 ++ state.h2) + state.n = conf.refs_start ∧ (conf.refs_start ≤ conf.gen_start ⇒ state.h1 = ([] :(α, β) heap_element list) ∧ state.h2 = ([] :(α, β) heap_element list)) ∧ has_old_ptr conf (state.heap ++ state.h1 ++ state.h2 ++ state.r1) ⊆ has_old_ptr conf heap0
heap_length_to_gen_heap_list_typed=∀(h2 :(α, β) heap_element list). heap_length (to_gen_heap_list (conf :γ gen_gc_partial_conf) h2) = heap_length h2
similar_ptr_def_typed=(similar_ptr (conf :α) (Pointer (p1 :num) (d1 :β)) (Pointer (p2 :num) (d2 :β)) ⇔ d2 = d1) ∧ (similar_ptr conf (Pointer (v4 :num) (v5 :β)) (Data (v12 :β)) ⇔ Pointer v4 v5 = Data v12) ∧ (similar_ptr conf (Data (v6 :β)) (x2 :β heap_address) ⇔ Data v6 = x2)
similar_data_def_typed=(similar_data (conf :α) (DataElement (xs1 :β heap_address list) (l1 :num) (d1 :γ)) (DataElement (xs2 :β heap_address list) (l2 :num) (d2 :γ)) ⇔ l2 = l1 ∧ d2 = d1 ∧ LIST_REL (similar_ptr conf :β heap_address -> β heap_address -> bool) xs1 xs2) ∧ (similar_data conf (Unused (v4 :num) :(β, γ) heap_element) (y :(β, γ) heap_element) ⇔ (Unused v4 :(β, γ) heap_element) = y) ∧ (similar_data conf (ForwardPointer (v5 :num) (v6 :β) (v7 :num) :(β, γ) heap_element) y ⇔ (ForwardPointer v5 v6 v7 :(β, γ) heap_element) = y) ∧ (similar_data conf (DataElement (v8 :β heap_address list) (v9 :num) (v10 :γ)) (Unused (v18 :num) :(β, γ) heap_element) ⇔ DataElement v8 v9 v10 = (Unused v18 :(β, γ) heap_element)) ∧ (similar_data conf (DataElement v8 v9 v10) (ForwardPointer (v19 :num) (v20 :β) (v21 :num) :(β, γ) heap_element) ⇔ DataElement v8 v9 v10 = (ForwardPointer v19 v20 v21 :(β, γ) heap_element))
LIST_REL_similar_data_IMP_typed=∀(xs :(α, β) heap_element list) (ys :(α, β) heap_element list). LIST_REL (similar_data (cc :γ) :(α, β) heap_element -> (α, β) heap_element -> bool) xs ys ⇒ heap_length xs = heap_length ys ∧ heap_length (FILTER (isDataElement :(α, β) heap_element -> bool) xs) = heap_length (FILTER (isDataElement :(α, β) heap_element -> bool) ys)
gc_move_list_heap_length_typed=∀(h :α heap_address list) (x :α heap_address list) (state :(α, β) gc_state) (state' :(α, β) gc_state). gc_move_list (conf :β gen_gc_partial_conf) state h = (x,state') ⇒ heap_length state.heap = heap_length state'.heap
gc_forward_ptr_heap_length_typed=∀(n :num) (h :(α, β) heap_element list) (m :num) (a :α) (ok :bool) (h' :(α, β) heap_element list) (ok' :bool). gc_forward_ptr n h m a ok = (h',ok') ⇒ heap_length h = heap_length h'
gc_move_heap_length_typed=gc_move (conf :β gen_gc_partial_conf) (state :(α, β) gc_state) (h :α heap_address) = ((x :α heap_address),(state' :(α, β) gc_state)) ⇒ heap_length state.heap = heap_length state'.heap
gen_gc_partial_conf_typed=recordtype.gen_gc_partial_conf::num -> (α -> bool) -> num -> num -> α gen_gc_partial_conf
gc_move_def_typed=(∀(conf :β gen_gc_partial_conf) (state :(α, β) gc_state) (d :α). gc_move conf state (Data d) = (Data d,state)) ∧ ∀(conf :β gen_gc_partial_conf) (state :(α, β) gc_state) (ptr :num) (d :α). gc_move conf state (Pointer ptr d) = (let (ok :bool) = (state.ok ∧ ptr < heap_length state.heap) in if ptr < conf.gen_start ∨ conf.refs_start ≤ ptr then (Pointer ptr d,state with ok := ok) else case heap_lookup ptr state.heap of (NONE :(α, β) heap_element option) => (Pointer ptr d,state with ok := F) | SOME (Unused v9 :(α, β) heap_element) => (Pointer ptr d,state with ok := F) | SOME (ForwardPointer v10 v11 v12 :(α, β) heap_element) => (Pointer v10 d,state) | SOME (DataElement xs l dd) => (let (ok :bool) = (ok ∧ l + (1 :num) ≤ state.n ∧ ¬conf.isRef dd); (n :num) = state.n − (l + (1 :num)); (h2 :(α, β) heap_element list) = state.h2 ++ [DataElement xs l dd]; ((heap :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr ptr state.heap state.a d ok; (a :num) = state.a + l + (1 :num) in (Pointer state.a d,state with <|h2 := h2; n := n; a := a; heap := heap; ok := ok|>)))
gc_move_list_def_typed=(∀(conf :β gen_gc_partial_conf) (state :(α, β) gc_state). gc_move_list conf state ([] :α heap_address list) = (([] :α heap_address list),state)) ∧ ∀(conf :β gen_gc_partial_conf) (state :(α, β) gc_state) (x :α heap_address) (xs :α heap_address list). gc_move_list conf state (x::xs) = (let ((x :α heap_address),(state :(α, β) gc_state)) = gc_move conf state x; ((xs :α heap_address list),(state :(α, β) gc_state)) = gc_move_list conf state xs in (x::xs,state))
gc_move_ref_list_def_typed=(∀(state :(α, γ) gc_state) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state ([] :(α, β) heap_element list) = (([] :(α, β) heap_element list),state)) ∧ (∀(xs :(α, β) heap_element list) (state :(α, γ) gc_state) (ptrs :α heap_address list) (l :num) (d :β) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state (DataElement ptrs l d::xs) = (let ((ptrs' :α heap_address list),(state' :(α, γ) gc_state)) = gc_move_list conf state ptrs; ((xs' :(α, β) heap_element list),(state'' :(α, γ) gc_state)) = gc_move_ref_list conf state' xs in (DataElement ptrs' l d::xs',state''))) ∧ (∀(xs :(α, β) heap_element list) (v6 :num) (state :(α, γ) gc_state) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state ((Unused v6 :(α, β) heap_element)::xs) = ((Unused v6 :(α, β) heap_element)::xs,state with ok := F)) ∧ ∀(xs :(α, β) heap_element list) (v9 :num) (v8 :α) (v7 :num) (state :(α, γ) gc_state) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state ((ForwardPointer v7 v8 v9 :(α, β) heap_element)::xs) = ((ForwardPointer v7 v8 v9 :(α, β) heap_element)::xs,state with ok := F)
gc_move_data_def_typed=∀(state :(α, β) gc_state) (conf :β gen_gc_partial_conf). gc_move_data conf state = case state.h2 of ([] :(α, β) heap_element list) => state | h::h2 => if conf.limit < heap_length (state.h1 ++ h::h2) then state with ok := F else case h of (Unused v7 :(α, β) heap_element) => state with ok := F | (ForwardPointer v8 v9 v10 :(α, β) heap_element) => state with ok := F | DataElement xs l d => (let ((xs' :α heap_address list),(state' :(α, β) gc_state)) = gc_move_list conf state xs; (h1 :(α, β) heap_element list) = state'.h1 ++ [DataElement xs' l d]; (h2' :(α, β) heap_element list) = TL state'.h2; (ok :bool) = (state'.ok ∧ state'.h2 ≠ ([] :(α, β) heap_element list) ∧ HD state'.h2 = h) in gc_move_data conf (state' with <|h1 := h1; h2 := h2'; ok := ok|>))
partial_gc_def_typed=∀(conf :β gen_gc_partial_conf) (roots :α heap_address list) (heap :(α, β) heap_element list). partial_gc conf (roots,heap) = case heap_segment (conf.gen_start,conf.refs_start) heap of (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) => (roots,(empty_state :(α, β) gc_state) with ok := F) | SOME (old,current,refs) => (let (n :num) = heap_length current; (state :(α, β) gc_state) = (empty_state :(α, β) gc_state) with <|heap := heap; old := old; r2 := refs; a := conf.gen_start; n := n|>; ((roots :α heap_address list),(state :(α, β) gc_state)) = gc_move_list conf state roots; ((refs' :(α, β) heap_element list),(state :(α, β) gc_state)) = gc_move_ref_list conf state refs; (state :(α, β) gc_state) = gc_move_data conf (state with <|r1 := refs'; r2 := ([] :(α, β) heap_element list)|>) in (roots,state))
