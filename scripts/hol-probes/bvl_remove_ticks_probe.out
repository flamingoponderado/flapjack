remove_ticks_sing=(∀(v :num). remove_ticks_sing (Var v :exp) = (Var v :exp)) ∧ (∀(x1 :exp) (x2 :exp) (x3 :exp). remove_ticks_sing (If x1 x2 x3 :exp) = (If (remove_ticks_sing x1) (remove_ticks_sing x2) (remove_ticks_sing x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp). remove_ticks_sing (Let xs x2 :exp) = (Let (remove_ticks_list xs) (remove_ticks_sing x2) :exp)) ∧ (∀(x1 :exp). remove_ticks_sing (Raise x1 :exp) = (Raise (remove_ticks_sing x1) :exp)) ∧ (∀(x1 :exp) (x2 :exp). remove_ticks_sing (Handle x1 x2 :exp) = (Handle (remove_ticks_sing x1) (remove_ticks_sing x2) :exp)) ∧ (∀(op :op) (xs :exp list). remove_ticks_sing (Op op xs :exp) = (Op op (remove_ticks_list xs) :exp)) ∧ (∀(x :exp). remove_ticks_sing (Tick x :exp) = remove_ticks_sing x) ∧ (∀(m :num) (n :num). remove_ticks_sing (Force m n :exp) = (Force m n :exp)) ∧ (∀(ticks :num) (dest :num option) (xs :exp list). remove_ticks_sing (Call ticks dest xs :exp) = (Call (0 :num) dest (remove_ticks_list xs) :exp)) ∧ remove_ticks_list ([] :exp list) = ([] :exp list) ∧ ∀(x :exp) (xs :exp list). remove_ticks_list (x::xs) = remove_ticks_sing x::remove_ticks_list xs
remove_ticks=remove_ticks ([] :exp list) = ([] :exp list) ∧ (∀(y :exp) (xs :exp list) (x :exp). remove_ticks (x::y::xs) = HD (remove_ticks [x])::remove_ticks (y::xs)) ∧ (∀(v :num). remove_ticks [(Var v :exp)] = [(Var v :exp)]) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp). remove_ticks [(If x1 x2 x3 :exp)] = [(If (HD (remove_ticks [x1])) (HD (remove_ticks [x2])) (HD (remove_ticks [x3])) :exp)]) ∧ (∀(xs :exp list) (x2 :exp). remove_ticks [(Let xs x2 :exp)] = [(Let (remove_ticks xs) (HD (remove_ticks [x2])) :exp)]) ∧ (∀(x1 :exp). remove_ticks [(Raise x1 :exp)] = [(Raise (HD (remove_ticks [x1])) :exp)]) ∧ (∀(x2 :exp) (x1 :exp). remove_ticks [(Handle x1 x2 :exp)] = [(Handle (HD (remove_ticks [x1])) (HD (remove_ticks [x2])) :exp)]) ∧ (∀(xs :exp list) (op :op). remove_ticks [(Op op xs :exp)] = [(Op op (remove_ticks xs) :exp)]) ∧ (∀(x :exp). remove_ticks [(Tick x :exp)] = remove_ticks [x]) ∧ (∀(n :num) (m :num). remove_ticks [(Force m n :exp)] = [(Force m n :exp)]) ∧ ∀(xs :exp list) (ticks :num) (dest :num option). remove_ticks [(Call ticks dest xs :exp)] = [(Call (0 :num) dest (remove_ticks xs) :exp)]
remove_ticks_equivalence=(∀(e :exp). remove_ticks [e] = [remove_ticks_sing e]) ∧ ∀(es :exp list). remove_ticks_list es = remove_ticks es
nested=(Call (0 :num) (SOME (8 :num)) [(Var (4 :num) :exp); (Force (2 :num) (9 :num) :exp)] :exp)
branches=[(If (Var (0 :num) :exp) (Var (1 :num) :exp) (Var (2 :num) :exp) :exp); (Let [(Var (3 :num) :exp)] (Raise (Var (4 :num) :exp) :exp) :exp)]
