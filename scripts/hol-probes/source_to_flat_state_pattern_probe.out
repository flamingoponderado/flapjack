store_rel_rules=(∀(genv :global_env) (v :semanticPrimitives$v) (v' :v). (v_rel genv v v' :bool) ⇒ sv_rel genv (Refv v) (Refv v')) ∧ (∀(genv :global_env) (w :word8 list). sv_rel genv (W8array w :semanticPrimitives$v store_v) (W8array w :v store_v)) ∧ (∀(genv :global_env) (vs :semanticPrimitives$v list) (vs' :v list). LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs' ⇒ sv_rel genv (Varray vs) (Varray vs')) ∧ ∀(genv :global_env) (m :thunk_mode) (v :semanticPrimitives$v) (v' :v). (v_rel genv v v' :bool) ⇒ sv_rel genv (Thunk m v) (Thunk m v')
state_rel_rules=∀(genv :global_env) (s :α semanticPrimitives$state) (s' :(β, α) flatSem$state). ¬NULL s'.refs ∧ LIST_REL (sv_rel genv :semanticPrimitives$v store_v -> v store_v -> bool) s.refs (TL s'.refs) ∧ s.clock = s'.clock ∧ s.ffi = s'.ffi ⇒ s_rel genv s s'
state_rel_cases=∀(a0 :global_env) (a1 :α semanticPrimitives$state) (a2 :(β, α) flatSem$state). s_rel a0 a1 a2 ⇔ ¬NULL a2.refs ∧ LIST_REL (sv_rel a0 :semanticPrimitives$v store_v -> v store_v -> bool) a1.refs (TL a2.refs) ∧ a1.clock = a2.clock ∧ a1.ffi = a2.ffi
match_result_def=(match_result_rel (genv :global_env) (env' :(mlstring # semanticPrimitives$v) list) (Match (env :(mlstring # semanticPrimitives$v) list)) (Match (env_i1 :(mlstring # v) list)) ⇔ ∃(env'' :(mlstring # semanticPrimitives$v) list). env = env'' ++ env' ∧ env_rel genv (alist_to_ns env'' :(mlstring, mlstring, semanticPrimitives$v) namespace) env_i1) ∧ (match_result_rel genv env' (No_match :(mlstring # semanticPrimitives$v) list match_result) (No_match :(mlstring # v) list match_result) ⇔ T) ∧ (match_result_rel genv env' (Match_type_error :(mlstring # semanticPrimitives$v) list match_result) (v0 :(mlstring # v) list match_result) ⇔ T) ∧ (match_result_rel genv env' (No_match :(mlstring # semanticPrimitives$v) list match_result) (Match_type_error :(mlstring # v) list match_result) ⇔ F) ∧ (match_result_rel genv env' (No_match :(mlstring # semanticPrimitives$v) list match_result) (Match (v10 :(mlstring # v) list)) ⇔ F) ∧ (match_result_rel genv env' (Match (v8 :(mlstring # semanticPrimitives$v) list)) (No_match :(mlstring # v) list match_result) ⇔ F) ∧ (match_result_rel genv env' (Match v8) (Match_type_error :(mlstring # v) list match_result) ⇔ F)
match_result_imp=match_result_rel (genv :global_env) (env :(mlstring # semanticPrimitives$v) list) (m1 :(mlstring # semanticPrimitives$v) list match_result) (m2 :(mlstring # v) list match_result) ⇒ m1 = (Match_type_error :(mlstring # semanticPrimitives$v) list match_result) ∨ m1 = (No_match :(mlstring # semanticPrimitives$v) list match_result) ∧ m2 = (No_match :(mlstring # v) list match_result) ∨ ∃(env1 :(mlstring # semanticPrimitives$v) list) (env2 :(mlstring # v) list). m1 = Match env1 ∧ m2 = Match env2
store_same_type=∀(v1 :α store_v) (v2 :α store_v). store_v_same_type v1 v2 ⇔ case (v1,v2) of (Refv v9,Refv v19) => T | (Refv v9,(W8array v20 :α store_v)) => F | (Refv v9,Varray v21) => F | (Refv v9,Thunk v22 v23) => F | ((W8array v10 :α store_v),Refv v29) => F | ((W8array v10 :α store_v),(W8array v30 :α store_v)) => T | ((W8array v10 :α store_v),Varray v31) => F | ((W8array v10 :α store_v),Thunk v32 v33) => F | (Varray v11,Refv v39) => F | (Varray v11,(W8array v40 :α store_v)) => F | (Varray v11,Varray v41) => T | (Varray v11,Thunk v42 v43) => F | (Thunk v12 v13,Refv v49) => F | (Thunk v12 v13,(W8array v50 :α store_v)) => F | (Thunk v12 v13,Varray v51) => F | (Thunk Evaluated v13,Thunk v52 v53) => F | (Thunk NotEvaluated v13,Thunk v52 v53) => T
store_assign=∀(n :num) (v :α store_v) (st :α store_v list). store_assign n v st = if n < LENGTH st ∧ store_v_same_type st❲n❳ v then SOME st❲n ↦ v❳ else (NONE :α store_v list option)
store_alloc=∀(v :α store_v) (st :α store_v list). store_alloc v st = (st ++ [v],LENGTH st)
allocate_ref=([Refv (Litv (IntLit 5))],0)
assign_ref=SOME [Refv (Litv (IntLit 9))]
assign_wrong_type=NONE
assign_missing=NONE
