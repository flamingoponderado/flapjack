config_typed=recordtype.config::num -> num sptree$num_map option list -> word_to_word$config
compile_def_typed=∀(stack_conf :config) (data_conf :data_to_word$config) (max_heap :num) (sp :num) (offset :α word # α word) (prog :(num # α stackLang$prog) list). (compile stack_conf data_conf max_heap sp offset prog :α sec list) = (let (prog :(num # α stackLang$prog) list) = (compile prog :(num # α stackLang$prog) list); (prog :(num # α stackLang$prog) list) = (compile data_conf prog :(num # α stackLang$prog) list); (prog :(num # α stackLang$prog) list) = (compile stack_conf.jump offset (is_gen_gc data_conf.gc_kind) max_heap sp InitGlobals_location prog :(num # α stackLang$prog) list); (prog :(num # α stackLang$prog) list) = (compile stack_conf.reg_names prog :(num # α stackLang$prog) list) in MAP (prog_to_section :num # α stackLang$prog -> α sec) prog)
compile_no_stubs_def_typed=∀(f :num sptree$num_map) (jump :bool) (offset :α word # α word) (sp :num) (prog :(num # α stackLang$prog) list). compile_no_stubs f jump offset sp prog = MAP (prog_to_section :num # α stackLang$prog -> α sec) (compile f (MAP (prog_comp jump offset sp :num # α stackLang$prog -> num # α stackLang$prog) (MAP (prog_comp :num # α stackLang$prog -> num # α stackLang$prog) prog)) :(num # α stackLang$prog) list)
is_gen_gc_def_typed=(is_gen_gc (Generational (l :num list)) ⇔ T) ∧ (is_gen_gc None ⇔ F) ∧ (is_gen_gc Simple ⇔ F)
compile_jump_def_typed=(∀(n :num). (compile_jump (INL n :num + num) :α line) = LabAsm (Jump (Lab n (0 :num)) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)) ∧ ∀(r :num). (compile_jump (INR r :num + num) :α line) = Asm (Asmi (JumpReg r :α asm)) ([] :word8 list) (0 :num)
find_lab_def_typed=∀(n :num) (labs :num list). find_lab n labs = case LLOOKUP labs n of (NONE :num option) => (0 :num) | SOME k => k
flatten_def_typed=∀(t :bool) (p :α stackLang$prog) (n :num) (m :num) (conts :num list) (breaks :num list). flatten t p n m conts breaks = case p of (Skip :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (Inst a :α stackLang$prog) => ((List [Asm (Asmi (Inst a :α asm)) ([] :word8 list) (0 :num)] :α line app_list),F,m) | (Get v70 v71 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (Set v72 v73 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (OpCurrHeap v74 v75 v76 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (Call (NONE :(α stackLang$prog # num # num # num) option) dest handler :α stackLang$prog) => ((List [(compile_jump dest :α line)] :α line app_list),T,m) | (Call (SOME (p1'³',lr,l1,l2)) dest handler :α stackLang$prog) => (let ((xs :α line app_list),(nr1 :bool),(m' :num)) = flatten F p1'³' n m conts breaks; (prefix :α line app_list) = (Append (List [LabAsm (LocValue lr (Lab l1 l2) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); (compile_jump dest :α line); (Label l1 l2 (0 :num) :α line)] :α line app_list) xs :α line app_list) in case handler of (NONE :(α stackLang$prog # num # num) option) => (prefix,nr1,m') | SOME (p2,k1,k2) => (let ((ys :α line app_list),(nr2 :bool),(m'' :num)) = flatten F p2 n m' conts breaks in ((Append prefix (Append (Append (List [LabAsm (Jump (Lab n m'') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); (Label k1 k2 (0 :num) :α line)] :α line app_list) ys :α line app_list) (List [(Label n m'' (0 :num) :α line)] :α line app_list) :α line app_list) :α line app_list),nr1 ∧ nr2,m'' + (1 :num)))) | Seq p1 p2 => (let ((xs :α line app_list),(nr1 :bool),(m' :num)) = flatten F p1 n m conts breaks; ((ys :α line app_list),(nr2 :bool),(m'' :num)) = flatten F p2 n m' conts breaks in if t then ((Append (Append xs (List [(Label n (1 :num) (0 :num) :α line)] :α line app_list) :α line app_list) ys :α line app_list),nr1 ∨ nr2,m'') else ((Append xs ys :α line app_list),nr1 ∨ nr2,m'')) | (If c r ri p1' p2' :α stackLang$prog) => (let ((xs :α line app_list),(nr1 :bool),(m' :num)) = flatten F p1' n m conts breaks; ((ys :α line app_list),(nr2 :bool),(m'' :num)) = flatten F p2' n m' conts breaks in if p1' = (Skip :α stackLang$prog) ∧ p2' = (Skip :α stackLang$prog) then ((List ([] :α line list) :α line app_list),F,m'') else if p1' = (Skip :α stackLang$prog) then ((Append (Append (List [LabAsm (JumpCmp c r ri (Lab n m'') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list) ys :α line app_list) (List [(Label n m'' (0 :num) :α line)] :α line app_list) :α line app_list),F,m'' + (1 :num)) else if p2' = (Skip :α stackLang$prog) then ((Append (Append (List [LabAsm (JumpCmp (negate c) r ri (Lab n m'') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list) xs :α line app_list) (List [(Label n m'' (0 :num) :α line)] :α line app_list) :α line app_list),F,m'' + (1 :num)) else if nr1 then ((Append (Append (Append (List [LabAsm (JumpCmp (negate c) r ri (Lab n m'') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list) xs :α line app_list) (List [(Label n m'' (0 :num) :α line)] :α line app_list) :α line app_list) ys :α line app_list),nr2,m'' + (1 :num)) else if nr2 then ((Append (Append (Append (List [LabAsm (JumpCmp c r ri (Lab n m'') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list) ys :α line app_list) (List [(Label n m'' (0 :num) :α line)] :α line app_list) :α line app_list) xs :α line app_list),nr1,m'' + (1 :num)) else ((Append (Append (Append (Append (List [LabAsm (JumpCmp c r ri (Lab n m'') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list) ys :α line app_list) (List [LabAsm (Jump (Lab n (m'' + (1 :num))) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); (Label n m'' (0 :num) :α line)] :α line app_list) :α line app_list) xs :α line app_list) (List [(Label n (m'' + (1 :num)) (0 :num) :α line)] :α line app_list) :α line app_list),nr1 ∧ nr2,m'' + (2 :num))) | (Loop p1'' :α stackLang$prog) => (let (cont_lab :num) = m; (break_lab :num) = m + (1 :num); ((xs :α line app_list),(_0 :bool),(m' :num)) = flatten F p1'' n (m + (2 :num)) (cont_lab::conts) (break_lab::breaks) in ((Append (Append (List [(Label n cont_lab (0 :num) :α line)] :α line app_list) xs :α line app_list) (List [LabAsm (Jump (Lab n cont_lab) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); (Label n break_lab (0 :num) :α line)] :α line app_list) :α line app_list),F,m')) | (JumpLower r1 r2 target :α stackLang$prog) => ((List [LabAsm (JumpCmp Lower r1 (Reg r2 :α reg_imm) (Lab target (0 :num)) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list),F,m) | (Alloc v91 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StoreConsts v92 v93 v94 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (Raise r' :α stackLang$prog) => ((List [Asm (Asmi (JumpReg r' :α asm)) ([] :word8 list) (0 :num)] :α line app_list),T,m) | (Return r'' :α stackLang$prog) => ((List [Asm (Asmi (JumpReg r'' :α asm)) ([] :word8 list) (0 :num)] :α line app_list),T,m) | (Break k :α stackLang$prog) => ((List [LabAsm (Jump (Lab n (find_lab k breaks)) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list),T,m) | (Continue k' :α stackLang$prog) => ((List [LabAsm (Jump (Lab n (find_lab k' conts)) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list),T,m) | (FFI ffi_index v100 v101 v102 v103 lr' :α stackLang$prog) => ((List [LabAsm (LocValue lr' (Lab n m) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); LabAsm (CallFFI ffi_index :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); (Label n m (0 :num) :α line)] :α line app_list),F,m + (1 :num)) | (Tick :α stackLang$prog) => ((List [Asm (Asmi (Inst (Skip :α inst) :α asm)) ([] :word8 list) (0 :num)] :α line app_list),F,m) | (LocValue i l1' l2' :α stackLang$prog) => ((List [LabAsm (LocValue i (Lab l1' l2') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list),F,m) | (Install v108 v109 v110 v111 ret :α stackLang$prog) => ((List [LabAsm (LocValue ret (Lab n m) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); LabAsm (Install :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num); (Label n m (0 :num) :α line)] :α line app_list),F,m + (1 :num)) | ShMemOp op r'³' ad => ((List [Asm (ShareMem op r'³' ad) ([] :word8 list) (0 :num)] :α line app_list),F,m) | (CodeBufferWrite r1' r2' :α stackLang$prog) => ((List [Asm (Cbw r1' r2' :α asm_or_cbw) ([] :word8 list) (0 :num)] :α line app_list),F,m) | (DataBufferWrite v118 v119 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (RawCall v120 :α stackLang$prog) => ((List [LabAsm (Jump (Lab v120 (1 :num)) :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list),T,m) | (StackAlloc v121 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackFree v122 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackStore v123 v124 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackStoreAny v125 v126 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackLoad v127 v128 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackLoadAny v129 v130 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackGetSize v131 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (StackSetSize v132 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (BitmapLoad v133 v134 :α stackLang$prog) => ((List ([] :α line list) :α line app_list),F,m) | (Halt v135 :α stackLang$prog) => ((List [LabAsm (Halt :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] :α line app_list),T,m)
is_Seq_def_typed=(is_Seq (Seq (p1 :α stackLang$prog) (p2 :α stackLang$prog)) ⇔ T) ∧ (is_Seq (Skip :α stackLang$prog) ⇔ F) ∧ (is_Seq (Inst (v :α inst) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Get (v1 :num) (v2 :store_name) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Set (v3 :store_name) (v4 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (OpCurrHeap (v5 :binop) (v6 :num) (v7 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Call (v8 :(α stackLang$prog # num # num # num) option) (v9 :num + num) (v10 :(α stackLang$prog # num # num) option) :α stackLang$prog) ⇔ F) ∧ (is_Seq (If (v13 :cmp) (v14 :num) (v15 :α reg_imm) (v16 :α stackLang$prog) (v17 :α stackLang$prog) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Loop (v18 :α stackLang$prog) :α stackLang$prog) ⇔ F) ∧ (is_Seq (JumpLower (v19 :num) (v20 :num) (v21 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Alloc (v22 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StoreConsts (v23 :num) (v24 :num) (v25 :num option) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Raise (v26 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Return (v27 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Break (v28 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Continue (v29 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (FFI (v30 :mlstring) (v31 :num) (v32 :num) (v33 :num) (v34 :num) (v35 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Tick :α stackLang$prog) ⇔ F) ∧ (is_Seq (LocValue (v36 :num) (v37 :num) (v38 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Install (v39 :num) (v40 :num) (v41 :num) (v42 :num) (v43 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (ShMemOp (v44 :memop) (v45 :num) (v46 :α addr)) ⇔ F) ∧ (is_Seq (CodeBufferWrite (v47 :num) (v48 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (DataBufferWrite (v49 :num) (v50 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (RawCall (v51 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackAlloc (v52 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackFree (v53 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackStore (v54 :num) (v55 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackStoreAny (v56 :num) (v57 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackLoad (v58 :num) (v59 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackLoadAny (v60 :num) (v61 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackGetSize (v62 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (StackSetSize (v63 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (BitmapLoad (v64 :num) (v65 :num) :α stackLang$prog) ⇔ F) ∧ (is_Seq (Halt (v66 :num) :α stackLang$prog) ⇔ F)
negate_def_typed=negate Less = NotLess ∧ negate Equal = NotEqual ∧ negate Lower = NotLower ∧ negate Test = NotTest ∧ negate NotLess = Less ∧ negate NotEqual = Equal ∧ negate NotLower = Lower ∧ negate NotTest = Test
prog_to_section_def_typed=∀(n :num) (p :α stackLang$prog). prog_to_section (n,p) = (let ((lines :α line app_list),(_0 :bool),(m :num)) = flatten T p n (next_lab p (2 :num)) ([] :num list) ([] :num list) in Section n (append (Append lines (List [(Label n (if is_Seq p then m else (1 :num)) (0 :num) :α line)] :α line app_list) :α line app_list)))
