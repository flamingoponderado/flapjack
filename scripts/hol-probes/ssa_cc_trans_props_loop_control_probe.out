spl_full=⊢ ∀names body exit_names ssa na lt. (∀setup_prog ssa_refreshed na_refreshed ssa_names ssa_exit ssa_body. (setup_prog,ssa_refreshed,na_refreshed) = loop_setup names exit_names ssa na ∧ ssa_names = apply_nummap_key (option_lookup ssa_refreshed) names ∧ ssa_exit = apply_nummap_key (option_lookup ssa_refreshed) exit_names ∧ ssa_body = inter ssa_refreshed names ⇒ ∀progOut ssaOut naOut. ssa_cc_trans body ssa_body na_refreshed ((ssa_refreshed,names,exit_names)::lt) = (progOut,ssaOut,naOut) ⇒ ssa_map_ok na_refreshed ssa_body ∧ is_alloc_var na_refreshed ⇒ na_refreshed ≤ naOut ∧ is_alloc_var naOut ∧ ssa_map_ok naOut ssaOut) ⇒ ∀progOut ssaOut naOut. ssa_cc_trans (Loop names body exit_names) ssa na lt = (progOut,ssaOut,naOut) ⇒ ssa_map_ok na ssa ∧ is_alloc_var na ⇒ na ≤ naOut ∧ is_alloc_var naOut ∧ ssa_map_ok naOut ssaOut
