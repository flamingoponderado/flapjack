is_small_eq_typed=!(limit :num) (e :exp). is_small limit e <=> is_small_sing limit e <> (0 :num)
must_inline_eq_typed=!(name :num) (limit :num) (e :exp). must_inline name limit e <=> is_small limit e /\ ((~is_rec_sing name e) :bool)
tick_inline_all_eq_typed=(!(limit :num) (cs :(num # exp) sptree$num_map) (aux :(num # num # exp) list). tick_inline_all limit cs ([] :(num # num # exp) list) aux = (cs,REVERSE aux)) /\ !(xs :(num # num # exp) list) (n :num) (limit :num) (e1 :exp) (cs :(num # exp) sptree$num_map) (aux :(num # num # exp) list) (arity :num). tick_inline_all limit cs ((n,arity,e1)::xs) aux = (let (e2 :exp) = tick_inline_sing cs e1; (cs2 :(num # exp) sptree$num_map) = if must_inline n limit e2 then insert n (arity,e2) cs else cs in tick_inline_all limit cs2 xs ((n,arity,e2)::aux))
LENGTH_tick_inline_typed=!(cs :('a # exp) sptree$num_map) (xs :exp list). LENGTH (tick_inline cs xs) = LENGTH xs
HD_tick_inline_typed=[HD (tick_inline (cs :('a # exp) sptree$num_map) [(x :exp)])] = tick_inline cs [x]
LENGTH_remove_ticks_typed=!(xs :exp list). LENGTH (remove_ticks xs) = LENGTH xs
remove_ticks_SING_typed=[HD (remove_ticks [(r :exp)])] = remove_ticks [r]
let_op_sing_eq_typed=!(x :exp). let_op_sing x = let_op_one x
