aaf_full_Skip=⊢ ∀c perf bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf Skip bs frame))
aaf_full_Move=⊢ ∀c perf priority moves bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Move priority moves) bs frame))
aaf_full_Assign=⊢ ∀c perf v exp bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Assign v exp) bs frame))
aaf_full_Get=⊢ ∀c perf v name bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Get v name) bs frame))
aaf_full_Set=⊢ ∀c perf name exp bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Set name exp) bs frame))
aaf_full_Store=⊢ ∀c perf exp v bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Store exp v) bs frame))
aaf_full_Alloc=⊢ ∀c perf v live bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Alloc v live) bs frame))
aaf_full_StoreConsts=⊢ ∀c perf r1 r2 r3 r4 ws bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (StoreConsts r1 r2 r3 r4 ws) bs frame))
aaf_full_Raise=⊢ ∀c perf v bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Raise v) bs frame))
aaf_full_Return=⊢ ∀c perf v vs bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Return v vs) bs frame))
aaf_full_Break=⊢ ∀c perf label bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Break label) bs frame))
aaf_full_Continue=⊢ ∀c perf label bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Continue label) bs frame))
aaf_full_Tick=⊢ ∀c perf bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf Tick bs frame))
aaf_full_OpCurrHeap=⊢ ∀c perf op v src bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (OpCurrHeap op v src) bs frame))
aaf_full_LocValue=⊢ ∀c perf v label bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (LocValue v label) bs frame))
aaf_full_Install=⊢ ∀c perf r1 r2 r3 r4 live bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (Install r1 r2 r3 r4 live) bs frame))
aaf_full_CodeBufferWrite=⊢ ∀c perf r1 r2 bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (CodeBufferWrite r1 r2) bs frame))
aaf_full_DataBufferWrite=⊢ ∀c perf r1 r2 bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (DataBufferWrite r1 r2) bs frame))
aaf_full_Ffi=⊢ ∀c perf name r1 r2 r3 r4 live bs frame. (perf ⇔ F) ⇒ alloc_arg (FST (comp c perf (FFI name r1 r2 r3 r4 live) bs frame))
