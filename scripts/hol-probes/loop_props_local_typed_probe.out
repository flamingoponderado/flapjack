(∀(v31 :num) (n :num). survives n (Break v31 :α prog) ⇔ T) ∧ (∀(v32 :num) (n :num). survives n (Continue v32 :α prog) ⇔ T) ∧ (∀(v33 :num) (n :num). survives n (Raise v33 :α prog) ⇔ T) ∧ (∀(v34 :num list) (n :num). survives n (Return v34 :α prog) ⇔ T) ∧ (∀(v37 :α exp) (v36 :num) (v35 :memop) (n :num). survives n (ShMem v35 v36 v37) ⇔ T) ∧ (∀(n :num). survives n (Tick :α prog) ⇔ T) ∧ (∀(n :num). survives n (Fail :α prog) ⇔ T) ∧ (∀(v40 :num) (v39 :num) (n :num). survives n (LocValue v39 v40 :α prog) ⇔ T) ∧ ∀(v44 :(num # α prog # α prog # sptree$num_set) option) (v43 :num list) (v42 :num option) (n :num). survives n (Call (NONE :(num list # sptree$num_set) option) v42 v43 v44 :α prog) ⇔ T
survives_nested_seq_intro_typed=∀(p :α prog list) (q :α prog list) (n :num). survives n (nested_seq p) ∧ survives n (nested_seq q) ⇒ survives n (nested_seq (p ++ q))
unassigned_vars_evaluate_same_typed=∀(p :α prog) (s :(α, β) state) (res :α result option) (t :(α, β) state) (n :num) (v :α word_loc). (evaluate (p,s) :α result option # (α, β) state) = (res,t) ∧ (res = (NONE :α result option) ∨ (∃(n :num). res = SOME (Continue n :α result)) ∨ ∃(n :num). res = SOME (Break n :α result)) ∧ lookup n s.locals = SOME v ∧ ¬MEM n (assigned_vars p) ∧ survives n p ⇒ lookup n t.locals = lookup n s.locals
