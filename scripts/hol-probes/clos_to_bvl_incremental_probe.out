clos_to_bvl_compile_inc_typed=∀(c :config) (p :closLang$exp list # (num # num # closLang$exp) list). clos_to_bvl_compile_inc c p = (let (p :closLang$exp list # (num # num # closLang$exp) list) = cond_mti_compile_inc c.do_mti c.max_app p; ((n :num),(p :closLang$exp list # (num # num # closLang$exp) list)) = ignore_table compile_inc c.next_loc p; (c :config) = c with next_loc := n; (spt :val_approx sptree$num_map) = option_val_approx_spt c.known_conf; ((spt :val_approx sptree$num_map),(p :closLang$exp list # (num # num # closLang$exp) list)) = known_compile_inc (known_static_conf c.known_conf) spt p; (c :config) = c with known_conf := option_upd_val_spt spt c.known_conf; ((c' :sptree$num_set),(p :closLang$exp list # (num # num # closLang$exp) list)) = cond_call_compile_inc c.do_call (FST c.call_state) p; (c :config) = c with call_state := (c',([] :(num # num # closLang$exp) list)); (p :closLang$exp list # (num # num # closLang$exp) list) = (compile_inc p :closLang$exp list # (num # num # closLang$exp) list); (p :(num # num # exp) list) = (compile_inc c.max_app p :(num # num # exp) list) in (c,p))
extract_name_def_typed=extract_name ([] :closLang$exp list) = ((0 :num),([] :closLang$exp list)) ∧ ∀(x :closLang$exp) (xs :closLang$exp list). extract_name (x::xs) = case some(n :num). ∃(t :tra). x = (Op t (IntOp (Const ((&n) :int))) ([] :closLang$exp list) :closLang$exp) of (NONE :num option) => ((0 :num),x::xs) | SOME n => (n,if xs = ([] :closLang$exp list) then [x] else xs)
extract_name_pmatch_typed=extract_name (xs :closLang$exp list) = case xs of ([] :closLang$exp list) => ((0 :num),xs) | v::v1 => PMATCH v [PMATCH_ROW (λ((t :tra),(i :int)). (Op t (IntOp (Const i)) ([] :closLang$exp list) :closLang$exp)) (λ((t :tra),(i :int)). T) (λ((t :tra),(i :int)). if i < (0 :int) then ((0 :num),v::v1) else (Num (ABS i),if v1 = ([] :closLang$exp list) then [v] else v1)); PMATCH_ROW (λ(_0 :closLang$exp). _0) (λ(_0 :closLang$exp). T) (λ(_0 :closLang$exp). ((0 :num),v::v1))]
compile_inc_def_typed=∀(max_app :num) (es :closLang$exp list) (prog :(num # num # closLang$exp) list). (compile_inc max_app (es,prog) :(num # num # exp) list) = (let ((n :num),(real_es :closLang$exp list)) = extract_name es in compile_prog max_app (chain_exps n real_es ++ prog))
