val _ = Globals.linewidth := 1000000;
fun theoremRow label th = let val th=GEN_ALL th in if null(hyp th) andalso null(free_vars(concl th)) then () else raise Fail "open theorem"; print(label ^ "="); print_thm th; print "\n" end;
fun tree t = if numSyntax.is_numeral t then Arbnum.toString(numSyntax.dest_numeral t) else let val (h,args)=strip_comb t; val {Thy,Name,...}=dest_thy_const h in "(" ^ Thy ^ "$" ^ Name ^ String.concat(map (fn a => " " ^ tree a) args) ^ ")" end;
fun out label q = let val th=EVAL q; val t=rhs(concl th) in if null(hyp th) andalso null(free_vars t) then () else raise Fail "non-ground observation"; print(label ^ "=" ^ tree t ^ "\n") end;
val the_words_EVERY_IS_SOME_Word = prove(``∀ls x. the_words ls = SOME x ⇒ ∀a. MEM a ls ⇒ ∃w. a = SOME (Word w)``,   Induct \\ EVAL_TAC \\ rw[] \\ every_case_tac \\ fs[]);
val _ = theoremRow "extract_full_the_words_EVERY_IS_SOME_Word" the_words_EVERY_IS_SOME_Word;
val the_words_SOME_eq = prove(``∀ls x. the_words ls = SOME x ⇒ x = MAP (λx. case x of SOME (Word y) => y) ls``,   Induct \\ EVAL_TAC \\ rw[] \\ every_case_tac \\ fs[]);
val _ = theoremRow "extract_full_the_words_SOME_eq" the_words_SOME_eq;
val the_words_MAP_exists = prove(``∀ls x a f.
  the_words (MAP f ls) = SOME x ∧
  MEM a ls ⇒
  ∃w. f a = SOME (Word w)``,   Induct>>EVAL_TAC>>rw[]>>
  every_case_tac>>fs[]);
val _ = theoremRow "extract_full_the_words_MAP_exists" the_words_MAP_exists;
