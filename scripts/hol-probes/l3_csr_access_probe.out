csr0_definition=∀p. privLevel p = case p of User => 0w | Supervisor => 1w | Hypervisor => 2w | Machine => 3w
csr0_type=:Privilege -> word2
csr1_definition=∀_. curPrivilege _ = (λstate. privilege (MCSR state).mstatus.MPRV)
csr1_type=:unit -> riscv_state -> Privilege
csr2_definition=∀csr. csrRW csr = (11 >< 10) csr
csr2_type=:word12 -> word2
csr3_definition=∀csr. csrPR csr = (9 >< 8) csr
csr3_type=:word12 -> word2
csr4_definition=∀rw pr p a. check_CSR_access (rw,pr,p,a) ⇔ (a = Read ∨ rw ≠ 3w) ∧ privLevel p ≥₊ pr
csr4_type=:word2 # word2 # Privilege # accessType -> bool
csr5_definition=∀csr. is_CSR_defined csr = (λstate. if csr ≥ 1w ∧ csr ≤ 3w then (T,state) else if csr ≥ 3072w ∧ csr ≤ 3074w then (T,state) else (let (v,s) = if csr ≥ 3200w then if csr ≤ 3202w then in32BitMode () state else (F,state) else (F,state) in if v then (T,s) else if csr ≥ 256w ∧ csr ≤ 257w then (T,s) else if csr = 260w then (T,s) else if csr = 289w then (T,s) else if csr = 3329w then (T,s) else (let (v,s) = if csr = 3457w then in32BitMode () s else (F,s) in if v then (T,s) else if csr ≥ 320w ∧ csr ≤ 321w then (T,s) else if csr = 324w then (T,s) else if csr ≥ 3394w ∧ csr ≤ 3395w then (T,s) else if csr ≥ 384w ∧ csr ≤ 385w then (T,s) else if csr ≥ 2304w ∧ csr ≤ 2306w then (T,s) else (let (v,s) = if csr ≥ 2432w then if csr ≤ 2434w then in32BitMode () s else (F,s) else (F,s) in if v then (T,s) else if csr ≥ 3840w ∧ csr ≤ 3841w then (T,s) else if csr = 3856w then (T,s) else if csr ≥ 768w ∧ csr ≤ 770w then (T,s) else if csr = 772w then (T,s) else if csr = 801w then (T,s) else if csr = 1793w then (T,s) else (let (v,s) = if csr = 1857w then in32BitMode () s else (F,s) in if v then (T,s) else if csr ≥ 832w ∧ csr ≤ 836w then (T,s) else if csr ≥ 896w ∧ csr ≤ 901w then (T,s) else if csr ≥ 2817w then (T,s) else (let (v,s) = if csr = 2945w then in32BitMode () s else (F,s) in (v ∨ csr ≥ 1920w ∧ csr ≤ 1923w ∧ csr ≠ 1922w,s)))))))
csr5_type=:word12 -> riscv_state -> bool # riscv_state
csr6_definition=∀csr rs1 a. checkCSROp (csr,rs1,a) = (λstate. (let (v,s) = is_CSR_defined csr state in (v ∧ check_CSR_access (csrRW csr,csrPR csr,curPrivilege () s,a),s)))
csr6_type=:word12 # word5 # accessType -> riscv_state -> bool # riscv_state
