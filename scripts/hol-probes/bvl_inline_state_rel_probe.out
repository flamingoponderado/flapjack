state_rel=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ t = s with <|code := map ((I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) s.code; compile := t.compile; compile_oracle := ((I :γ -> γ) ## MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x])))) ∘ s.compile_oracle|> ∧ s.compile = (λ(cfg :γ) (prog :(num # num # bvl$exp) list). t.compile cfg (MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) prog))
evaluate_remove_ticks=∀(k :num) (xs :bvl$exp list) (env :v list) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state) (res :(v list, v) result) (s' :(γ, 'ffi) state). state_rel t s ∧ s.clock = k ∧ evaluate (remove_ticks xs,env,s) = (res,s') ⇒ ∃(ck :num) (t' :(γ, 'ffi) state). evaluate (xs,env,t with clock := t.clock + ck) = (res,t') ∧ state_rel t' s'
remove_ticks_cc=∀(cc :α -> (β # γ # bvl$exp) list -> δ). remove_ticks_cc cc = (λ(cfg :α) (prog' :(β # γ # bvl$exp) list). cc cfg (MAP ((I :β -> β) ## (I :γ -> γ) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) prog'))
remove_ticks_co=(remove_ticks_co :α # (β # γ # bvl$exp) list -> α # (β # γ # bvl$exp) list) = (I :α -> α) ## MAP ((I :β -> β) ## (I :γ -> γ) ## (λ(x :bvl$exp). HD (remove_ticks [x])))
evaluate_compile_prog=evaluate ([(Call (0 :num) (SOME (start :num)) ([] :bvl$exp list) :bvl$exp)],([] :v list),(initial_state (ffi0 :'ffi ffi_state) (map ((I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) (prog :(num # bvl$exp) sptree$num_map)) ((remove_ticks_co :γ # (num # num # bvl$exp) list -> γ # (num # num # bvl$exp) list) ∘ (co :num -> γ # (num # num # bvl$exp) list)) (cc :γ -> (num # num # bvl$exp) list -> (word8 list # word64 list # γ) option) (k :num) :(γ, 'ffi) state)) = ((r :(v list, v) result),(s :(γ, 'ffi) state)) ⇒ ∃(ck :num) (s2 :(γ, 'ffi) state). evaluate ([(Call (0 :num) (SOME start) ([] :bvl$exp list) :bvl$exp)],([] :v list),(initial_state ffi0 prog co (remove_ticks_cc cc) (k + ck) :(γ, 'ffi) state)) = (r,s2) ∧ s2.ffi = s.ffi
mk_tick=∀(n :num) (e :bvl$exp). mk_tick n e = FUNPOW Tick n e
mk_tick_zero=mk_tick (0 :num) (Var (4 :num) :bvl$exp) = (Var (4 :num) :bvl$exp)
mk_tick_three=mk_tick (3 :num) (Var (4 :num) :bvl$exp) = (Tick (Tick (Tick (Var (4 :num) :bvl$exp) :bvl$exp) :bvl$exp) :bvl$exp)
exp_rel_rules=(∀(cs :(num # bvl$exp) sptree$num_map) (v :num). exp_rel cs [(Var v :bvl$exp)] [(Var v :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map). exp_rel cs ([] :bvl$exp list) ([] :bvl$exp list)) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (x :bvl$exp) (x1 :bvl$exp) (xs :bvl$exp list) (y :bvl$exp) (y1 :bvl$exp) (ys :bvl$exp list). exp_rel cs [x] [y] ∧ exp_rel cs (x1::xs) (y1::ys) ⇒ exp_rel cs (x::x1::xs) (y::y1::ys)) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (x1 :bvl$exp) (x2 :bvl$exp) (x3 :bvl$exp) (y1 :bvl$exp) (y2 :bvl$exp) (y3 :bvl$exp). exp_rel cs [x1] [y1] ∧ exp_rel cs [x2] [y2] ∧ exp_rel cs [x3] [y3] ⇒ exp_rel cs [(If x1 x2 x3 :bvl$exp)] [(If y1 y2 y3 :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (x :bvl$exp) (xs :bvl$exp list) (y :bvl$exp) (ys :bvl$exp list). exp_rel cs xs ys ∧ exp_rel cs [x] [y] ⇒ exp_rel cs [(Let xs x :bvl$exp)] [(Let ys y :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (x1 :bvl$exp) (x2 :bvl$exp) (y1 :bvl$exp) (y2 :bvl$exp). exp_rel cs [x1] [y1] ∧ exp_rel cs [x2] [y2] ⇒ exp_rel cs [(Handle x1 x2 :bvl$exp)] [(Handle y1 y2 :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (x :bvl$exp) (y :bvl$exp). exp_rel cs [x] [y] ⇒ exp_rel cs [(Raise x :bvl$exp)] [(Raise y :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (x :bvl$exp) (y :bvl$exp). exp_rel cs [x] [y] ⇒ exp_rel cs [(Tick x :bvl$exp)] [(Tick y :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (op :closLang$op) (xs :bvl$exp list) (ys :bvl$exp list). exp_rel cs xs ys ⇒ exp_rel cs [(Op op xs :bvl$exp)] [(Op op ys :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (loc :num) (n :num). exp_rel cs [(Force loc n :bvl$exp)] [(Force loc n :bvl$exp)]) ∧ (∀(cs :(num # bvl$exp) sptree$num_map) (dest :num option) (ticks :num) (xs :bvl$exp list) (ys :bvl$exp list). exp_rel cs xs ys ⇒ exp_rel cs [(Call ticks dest xs :bvl$exp)] [(Call ticks dest ys :bvl$exp)]) ∧ ∀(arity :num) (cs :(num # bvl$exp) sptree$num_map) (n :num) (ticks :num) (x :bvl$exp) (xs :bvl$exp list) (y :bvl$exp) (ys :bvl$exp list). exp_rel cs xs ys ∧ lookup n cs = SOME (arity,x) ∧ exp_rel cs [x] [y] ⇒ exp_rel cs [(Call ticks (SOME n) xs :bvl$exp)] [(Let ys (mk_tick (SUC ticks) y) :bvl$exp)]
subspt_exp_rel=∀(s1 :(num # bvl$exp) sptree$num_map) (s2 :(num # bvl$exp) sptree$num_map) (xs :bvl$exp list) (ys :bvl$exp list). subspt s1 s2 ∧ exp_rel s1 xs ys ⇒ exp_rel s2 xs ys
exp_rel_swap=∀(x1 :(num # bvl$exp) sptree$num_map) (x2 :bvl$exp list) (x3 :bvl$exp list) (y1 :(num # bvl$exp) sptree$num_map). (∀(k :num). lookup k x1 = lookup k y1) ⇒ (exp_rel x1 x2 x3 ⇔ exp_rel y1 x2 x3)
exp_rel_refl=∀(cs :(num # bvl$exp) sptree$num_map) (xs :bvl$exp list). exp_rel cs xs xs
tick_inline=(∀(cs :(α # bvl$exp) sptree$num_map). tick_inline cs ([] :bvl$exp list) = ([] :bvl$exp list)) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs (x::y::xs) = HD (tick_inline cs [x])::tick_inline cs (y::xs)) ∧ (∀(v :num) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Var v :bvl$exp)] = [(Var v :bvl$exp)]) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(If x1 x2 x3 :bvl$exp)] = [(If (HD (tick_inline cs [x1])) (HD (tick_inline cs [x2])) (HD (tick_inline cs [x3])) :bvl$exp)]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Let xs x2 :bvl$exp)] = [(Let (tick_inline cs xs) (HD (tick_inline cs [x2])) :bvl$exp)]) ∧ (∀(x1 :bvl$exp) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Raise x1 :bvl$exp)] = [(Raise (HD (tick_inline cs [x1])) :bvl$exp)]) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Handle x1 x2 :bvl$exp)] = [(Handle (HD (tick_inline cs [x1])) (HD (tick_inline cs [x2])) :bvl$exp)]) ∧ (∀(xs :bvl$exp list) (op :closLang$op) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Op op xs :bvl$exp)] = [(Op op (tick_inline cs xs) :bvl$exp)]) ∧ (∀(x :bvl$exp) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Tick x :bvl$exp)] = [(Tick (HD (tick_inline cs [x])) :bvl$exp)]) ∧ (∀(n :num) (m :num) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Force m n :bvl$exp)] = [(Force m n :bvl$exp)]) ∧ ∀(xs :bvl$exp list) (ticks :num) (dest :num option) (cs :(α # bvl$exp) sptree$num_map). tick_inline cs [(Call ticks dest xs :bvl$exp)] = case dest of (NONE :num option) => [(Call ticks dest (tick_inline cs xs) :bvl$exp)] | SOME n => case lookup n cs of (NONE :(α # bvl$exp) option) => [(Call ticks dest (tick_inline cs xs) :bvl$exp)] | SOME (arity,code) => [(Let (tick_inline cs xs) (mk_tick (SUC ticks) code) :bvl$exp)]
tick_inline_sing_def=(∀(cs :(α # bvl$exp) sptree$num_map) (v :num). tick_inline_sing cs (Var v :bvl$exp) = (Var v :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (x1 :bvl$exp) (x2 :bvl$exp) (x3 :bvl$exp). tick_inline_sing cs (If x1 x2 x3 :bvl$exp) = (If (tick_inline_sing cs x1) (tick_inline_sing cs x2) (tick_inline_sing cs x3) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (xs :bvl$exp list) (x2 :bvl$exp). tick_inline_sing cs (Let xs x2 :bvl$exp) = (Let (tick_inline_list cs xs) (tick_inline_sing cs x2) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (x1 :bvl$exp). tick_inline_sing cs (Raise x1 :bvl$exp) = (Raise (tick_inline_sing cs x1) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (x1 :bvl$exp) (x2 :bvl$exp). tick_inline_sing cs (Handle x1 x2 :bvl$exp) = (Handle (tick_inline_sing cs x1) (tick_inline_sing cs x2) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (op :closLang$op) (xs :bvl$exp list). tick_inline_sing cs (Op op xs :bvl$exp) = (Op op (tick_inline_list cs xs) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (x :bvl$exp). tick_inline_sing cs (Tick x :bvl$exp) = (Tick (tick_inline_sing cs x) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (m :num) (n :num). tick_inline_sing cs (Force m n :bvl$exp) = (Force m n :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map) (ticks :num) (dest :num option) (xs :bvl$exp list). tick_inline_sing cs (Call ticks dest xs :bvl$exp) = case dest of (NONE :num option) => (Call ticks dest (tick_inline_list cs xs) :bvl$exp) | SOME n => case lookup n cs of (NONE :(α # bvl$exp) option) => (Call ticks dest (tick_inline_list cs xs) :bvl$exp) | SOME (arity,code) => (Let (tick_inline_list cs xs) (mk_tick (SUC ticks) code) :bvl$exp)) ∧ (∀(cs :(α # bvl$exp) sptree$num_map). tick_inline_list cs ([] :bvl$exp list) = ([] :bvl$exp list)) ∧ ∀(cs :(α # bvl$exp) sptree$num_map) (x :bvl$exp) (xs :bvl$exp list). tick_inline_list cs (x::xs) = tick_inline_sing cs x::tick_inline_list cs xs
tick_inline_sing=(∀(e :bvl$exp). tick_inline (cs :(α # bvl$exp) sptree$num_map) [e] = [tick_inline_sing cs e]) ∧ ∀(es :bvl$exp list). tick_inline_list cs es = tick_inline cs es
exp_rel_tick_inline=∀(cs0 :(num # bvl$exp) sptree$num_map) (xs :bvl$exp list). (∀(k :num) (arity :num) (v :bvl$exp). lookup k cs0 = SOME (arity,v) ⇒ ∃(exp :bvl$exp). lookup k (src_code :(num # bvl$exp) sptree$num_map) = SOME (arity,exp) ∧ exp_rel src_code [exp] [v]) ⇒ exp_rel src_code xs (tick_inline cs0 xs)
is_small_aux=(∀(n :num). is_small_aux n ([] :bvl$exp list) = n) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (n :num). is_small_aux n (x::y::xs) = if n = (0 :num) then n else (let (n' :num) = is_small_aux n [x] in if n' = (0 :num) then n' else is_small_aux n' (y::xs))) ∧ (∀(v :num) (n :num). is_small_aux n [(Var v :bvl$exp)] = n) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (n :num). is_small_aux n [(If x1 x2 x3 :bvl$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = is_small_aux n' [x1] in if n'' = (0 :num) then (0 :num) else (let (n'³' :num) = is_small_aux n'' [x2] in if n'³' = (0 :num) then (0 :num) else is_small_aux n'³' [x3])))) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (n :num). is_small_aux n [(Let xs x2 :bvl$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = is_small_aux n' xs in if n'' = (0 :num) then (0 :num) else is_small_aux n'' [x2]))) ∧ (∀(x1 :bvl$exp) (n :num). is_small_aux n [(Raise x1 :bvl$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else is_small_aux n' [x1])) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (n :num). is_small_aux n [(Handle x1 x2 :bvl$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = is_small_aux n' [x1] in if n'' = (0 :num) then (0 :num) else is_small_aux n'' [x2]))) ∧ (∀(xs :bvl$exp list) (op :closLang$op) (n :num). is_small_aux n [(Op op xs :bvl$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else is_small_aux n' xs)) ∧ (∀(x :bvl$exp) (n :num). is_small_aux n [(Tick x :bvl$exp)] = is_small_aux n [x]) ∧ (∀(v1 :num) (v0 :num) (n :num). is_small_aux n [(Force v0 v1 :bvl$exp)] = n) ∧ ∀(xs :bvl$exp list) (ticks :num) (n :num) (dest :num option). is_small_aux n [(Call ticks dest xs :bvl$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else is_small_aux n' xs)
is_small_sing_def=(∀(n :num) (v :num). is_small_sing n (Var v :bvl$exp) = n) ∧ (∀(n :num) (x1 :bvl$exp) (x2 :bvl$exp) (x3 :bvl$exp). is_small_sing n (If x1 x2 x3 :bvl$exp) = (let (n :num) = n − (1 :num) in if n = (0 :num) then (0 :num) else (let (n :num) = is_small_sing n x1 in if n = (0 :num) then (0 :num) else (let (n :num) = is_small_sing n x2 in if n = (0 :num) then (0 :num) else is_small_sing n x3)))) ∧ (∀(n :num) (xs :bvl$exp list) (x2 :bvl$exp). is_small_sing n (Let xs x2 :bvl$exp) = (let (n :num) = n − (1 :num) in if n = (0 :num) then (0 :num) else (let (n :num) = is_small_list n xs in if n = (0 :num) then (0 :num) else is_small_sing n x2))) ∧ (∀(n :num) (x1 :bvl$exp). is_small_sing n (Raise x1 :bvl$exp) = (let (n :num) = n − (1 :num) in if n = (0 :num) then (0 :num) else is_small_sing n x1)) ∧ (∀(n :num) (x1 :bvl$exp) (x2 :bvl$exp). is_small_sing n (Handle x1 x2 :bvl$exp) = (let (n :num) = n − (1 :num) in if n = (0 :num) then (0 :num) else (let (n :num) = is_small_sing n x1 in if n = (0 :num) then (0 :num) else is_small_sing n x2))) ∧ (∀(n :num) (op :closLang$op) (xs :bvl$exp list). is_small_sing n (Op op xs :bvl$exp) = (let (n :num) = n − (1 :num) in if n = (0 :num) then (0 :num) else is_small_list n xs)) ∧ (∀(n :num) (x :bvl$exp). is_small_sing n (Tick x :bvl$exp) = is_small_sing n x) ∧ (∀(n :num) (v0 :num) (v1 :num). is_small_sing n (Force v0 v1 :bvl$exp) = n) ∧ (∀(n :num) (ticks :num) (dest :num option) (xs :bvl$exp list). is_small_sing n (Call ticks dest xs :bvl$exp) = (let (n :num) = n − (1 :num) in if n = (0 :num) then (0 :num) else is_small_list n xs)) ∧ (∀(n :num). is_small_list n ([] :bvl$exp list) = n) ∧ ∀(n :num) (x :bvl$exp) (xs :bvl$exp list). is_small_list n (x::xs) = if n = (0 :num) then n else (let (n :num) = is_small_sing n x in if n = (0 :num) then n else is_small_list n xs)
is_small_sing=(∀(e :bvl$exp) (n :num). is_small_aux n [e] = is_small_sing n e) ∧ ∀(es :bvl$exp list) (n :num). is_small_list n es = is_small_aux n es
is_small=∀(limit :num) (e :bvl$exp). is_small limit e ⇔ is_small_aux limit [e] ≠ (0 :num)
is_rec=(∀(n :num). is_rec n ([] :bvl$exp list) ⇔ F) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (n :num). is_rec n (x::y::xs) ⇔ if is_rec n [x] then T else is_rec n (y::xs)) ∧ (∀(v :num) (n :num). is_rec n [(Var v :bvl$exp)] ⇔ F) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (n :num). is_rec n [(If x1 x2 x3 :bvl$exp)] ⇔ if is_rec n [x1] then T else if is_rec n [x2] then T else is_rec n [x3]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (n :num). is_rec n [(Let xs x2 :bvl$exp)] ⇔ if is_rec n xs then T else is_rec n [x2]) ∧ (∀(x1 :bvl$exp) (n :num). is_rec n [(Raise x1 :bvl$exp)] ⇔ is_rec n [x1]) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (n :num). is_rec n [(Handle x1 x2 :bvl$exp)] ⇔ if is_rec n [x1] then T else is_rec n [x2]) ∧ (∀(xs :bvl$exp list) (op :closLang$op) (n :num). is_rec n [(Op op xs :bvl$exp)] ⇔ is_rec n xs) ∧ (∀(x :bvl$exp) (n :num). is_rec n [(Tick x :bvl$exp)] ⇔ is_rec n [x]) ∧ (∀(v1 :num) (v0 :num) (n :num). is_rec n [(Force v0 v1 :bvl$exp)] ⇔ F) ∧ ∀(xs :bvl$exp list) (ticks :num) (n :num) (dest :num option). is_rec n [(Call ticks dest xs :bvl$exp)] ⇔ if dest = SOME n then T else is_rec n xs
is_rec_sing_def=(∀(n :num) (v :num). is_rec_sing n (Var v :bvl$exp) ⇔ F) ∧ (∀(n :num) (x1 :bvl$exp) (x2 :bvl$exp) (x3 :bvl$exp). is_rec_sing n (If x1 x2 x3 :bvl$exp) ⇔ if is_rec_sing n x1 then T else if is_rec_sing n x2 then T else is_rec_sing n x3) ∧ (∀(n :num) (xs :bvl$exp list) (x2 :bvl$exp). is_rec_sing n (Let xs x2 :bvl$exp) ⇔ if is_rec_list n xs then T else is_rec_sing n x2) ∧ (∀(n :num) (x1 :bvl$exp). is_rec_sing n (Raise x1 :bvl$exp) ⇔ is_rec_sing n x1) ∧ (∀(n :num) (x1 :bvl$exp) (x2 :bvl$exp). is_rec_sing n (Handle x1 x2 :bvl$exp) ⇔ if is_rec_sing n x1 then T else is_rec_sing n x2) ∧ (∀(n :num) (op :closLang$op) (xs :bvl$exp list). is_rec_sing n (Op op xs :bvl$exp) ⇔ is_rec_list n xs) ∧ (∀(n :num) (x :bvl$exp). is_rec_sing n (Tick x :bvl$exp) ⇔ is_rec_sing n x) ∧ (∀(n :num) (v0 :num) (v1 :num). is_rec_sing n (Force v0 v1 :bvl$exp) ⇔ F) ∧ (∀(n :num) (ticks :num) (dest :num option) (xs :bvl$exp list). is_rec_sing n (Call ticks dest xs :bvl$exp) ⇔ if dest = SOME n then T else is_rec_list n xs) ∧ (∀(n :num). is_rec_list n ([] :bvl$exp list) ⇔ F) ∧ ∀(n :num) (x :bvl$exp) (xs :bvl$exp list). is_rec_list n (x::xs) ⇔ if is_rec_sing n x then T else is_rec_list n xs
is_rec_sing=(∀(e :bvl$exp) (n :num). is_rec n [e] ⇔ is_rec_sing n e) ∧ ∀(es :bvl$exp list) (n :num). is_rec_list n es ⇔ is_rec n es
must_inline=∀(name :num) (limit :num) (e :bvl$exp). must_inline name limit e ⇔ if is_small limit e then ¬is_rec name [e] else F
tick_inline_all=(∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (aux :(num # num # bvl$exp) list). tick_inline_all limit cs ([] :(num # num # bvl$exp) list) aux = (cs,REVERSE aux)) ∧ ∀(xs :(num # num # bvl$exp) list) (n :num) (limit :num) (e1 :bvl$exp) (cs :(num # bvl$exp) sptree$num_map) (aux :(num # num # bvl$exp) list) (arity :num). tick_inline_all limit cs ((n,arity,e1)::xs) aux = (let (e2 :bvl$exp) = HD (tick_inline cs [e1]); (cs2 :(num # bvl$exp) sptree$num_map) = if must_inline n limit e2 then insert n (arity,e2) cs else cs in tick_inline_all limit cs2 xs ((n,arity,e2)::aux))
tick_compile_prog=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (prog :(num # num # bvl$exp) list). tick_compile_prog limit cs prog = tick_inline_all limit cs prog ([] :(num # num # bvl$exp) list)
tick_inline_all_names=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (t :(num # num # bvl$exp) list) (aux :α) (cs1 :(num # bvl$exp) sptree$num_map) (xs :(num # num # bvl$exp) list) (aux :(num # num # bvl$exp) list). tick_inline_all limit cs t aux = (cs1,xs) ⇒ MAP (FST :num # num # bvl$exp -> num) (REVERSE aux) ++ MAP (FST :num # num # bvl$exp -> num) t = MAP (FST :num # num # bvl$exp -> num) xs
tick_compile_prog_res_range=∀(in1 :(num # num # bvl$exp) list) (limit :num) (in2 :(num # num # bvl$exp) list) (c :(num # bvl$exp) sptree$num_map) (cs0 :(num # bvl$exp) sptree$num_map) (cs1 :(num # bvl$exp) sptree$num_map). tick_compile_prog limit cs0 in1 = (cs1,in2) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) in1) ∧ subspt cs0 c ∧ (domain c :num -> bool) ∩ set (MAP (FST :num # num # bvl$exp -> num) in1) = (∅ :num -> bool) ⇒ subspt cs1 (union c (fromAList in2))
in_cc=∀(limit :num) (cc :α -> (num # num # bvl$exp) list -> (β # γ # δ) option). in_cc limit cc = (λ((cs :(num # bvl$exp) sptree$num_map),(cfg :α)) (prog :(num # num # bvl$exp) list). (let ((cs1 :(num # bvl$exp) sptree$num_map),(prog1 :(num # num # bvl$exp) list)) = tick_compile_prog limit cs prog in case cc cfg prog1 of (NONE :(β # γ # δ) option) => (NONE :(β # γ # (num # bvl$exp) sptree$num_map # δ) option) | SOME (code,data,cfg1) => SOME (code,data,cs1,cfg1)))
in_state_rel=∀(limit :num) (s :((num # bvl$exp) sptree$num_map # α, β) state) (t :(α, β) state). in_state_rel limit s t ⇔ t.globals = s.globals ∧ t.refs = s.refs ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ t.compile_oracle = (λ(n :num). (let (((cs :(num # bvl$exp) sptree$num_map),(cfg :α)),(progs :(num # num # bvl$exp) list)) = (s.compile_oracle n :((num # bvl$exp) sptree$num_map # α) # (num # num # bvl$exp) list); ((cs1 :(num # bvl$exp) sptree$num_map),(progs :(num # num # bvl$exp) list)) = tick_compile_prog limit cs progs in (cfg,progs))) ∧ subspt (FST (FST (s.compile_oracle (0 :num) :((num # bvl$exp) sptree$num_map # α) # (num # num # bvl$exp) list))) t.code ∧ s.compile = in_cc limit t.compile ∧ (domain t.code :num -> bool) = (domain s.code :num -> bool) ∧ ∀(k :num) (arity :num) (exp :bvl$exp). lookup k s.code = SOME (arity,exp) ⇒ ∃(exp2 :bvl$exp). lookup k t.code = SOME (arity,exp2) ∧ exp_rel s.code [exp] [exp2]
evaluate_inline=∀(es :bvl$exp list) (env :v list) (s1 :((num # bvl$exp) sptree$num_map # α, β) state) (res :(v list, v) result) (t1 :(α, β) state) (s2 :((num # bvl$exp) sptree$num_map # α, β) state) (es2 :bvl$exp list). in_state_rel (limit :num) s1 t1 ∧ exp_rel s1.code es es2 ∧ evaluate (es,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(t2 :(α, β) state). evaluate (es2,env,t1) = (res,t2) ∧ in_state_rel limit s2 t2
evaluate_mk_tick=∀(exp :bvl$exp) (env :v list) (s :(α, β) state) (n :num). evaluate ([mk_tick n exp],env,s) = if s.clock < n then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with clock := (0 :num)) else evaluate ([exp],env,dec_clock n s)
evaluate_mono=∀(xs :bvl$exp list) (env :v list) (s1 :(α, β) state) (vs :(v list, v) result) (s2 :(α, β) state). evaluate (xs,env,s1) = (vs,s2) ⇒ subspt s1.code s2.code
in_co=∀(limit :num) (co :α -> ((num # bvl$exp) sptree$num_map # β) # (num # num # bvl$exp) list). in_co limit co = (λ(n :α). (let (((cs :(num # bvl$exp) sptree$num_map),(cfg :β)),(progs :(num # num # bvl$exp) list)) = co n; ((cs1 :(num # bvl$exp) sptree$num_map),(progs :(num # num # bvl$exp) list)) = tick_compile_prog limit cs progs in (cfg,progs)))
MAP_FST_tick_inline_all=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (prog :(num # num # bvl$exp) list). MAP (FST :num # num # bvl$exp -> num) (SND (tick_inline_all limit cs prog ([] :(num # num # bvl$exp) list))) = MAP (FST :num # num # bvl$exp -> num) prog
do_app_Rval_swap=(do_app (op :closLang$op) (a :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((x0 :v),(x1 :(α, β) state)) :(v # (α, β) state, v) result) ∧ op ≠ Install ∧ (domain s1.code :num -> bool) ⊆ (domain (t1 :(γ, δ) state).code :num -> bool) ⇒ (do_app op a (t1 with <|globals := s1.globals; refs := s1.refs; clock := s1.clock; ffi := s1.ffi|>) :(v # (γ, β) state, v) result) = (Rval (x0,t1 with <|globals := x1.globals; refs := x1.refs; clock := x1.clock; ffi := x1.ffi|>) :(v # (γ, β) state, v) result)
do_app_Rerr_swap=(do_app (op :closLang$op) (a :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ∧ op ≠ Install ∧ (domain (t1 :(γ, δ) state).code :num -> bool) ⊆ (domain s1.code :num -> bool) ⇒ (do_app op a (t1 with <|globals := s1.globals; refs := s1.refs; clock := s1.clock; ffi := s1.ffi|>) :(v # (γ, β) state, v) result) = (Rerr e :(v # (γ, β) state, v) result)
must_inline_yes=must_inline (3 :num) (5 :num) (Call (0 :num) (SOME (4 :num)) [(Var (1 :num) :bvl$exp)] :bvl$exp) ⇔ T
must_inline_rec=must_inline (3 :num) (5 :num) (Call (0 :num) (SOME (3 :num)) [(Var (1 :num) :bvl$exp)] :bvl$exp) ⇔ F
must_inline_zero=must_inline (3 :num) (0 :num) (Var (1 :num) :bvl$exp) ⇔ F
tick_inline_generic_cache=tick_inline_sing (insert (3 :num) (T,(Var (8 :num) :bvl$exp)) (LN :(bool # bvl$exp) sptree$num_map)) (Call (2 :num) (SOME (3 :num)) [(Var (1 :num) :bvl$exp)] :bvl$exp) = (Let [(Var (1 :num) :bvl$exp)] (Tick (Tick (Tick (Var (8 :num) :bvl$exp) :bvl$exp) :bvl$exp) :bvl$exp) :bvl$exp)
tick_inline_uncached=tick_inline_sing (LN :(bool # bvl$exp) sptree$num_map) (Call (2 :num) (SOME (3 :num)) [(Var (1 :num) :bvl$exp)] :bvl$exp) = (Call (2 :num) (SOME (3 :num)) [(Var (1 :num) :bvl$exp)] :bvl$exp)
do_app_lemma_typed_goal=state_rel (t' :(α, β) state) (r :(α, β) state) ⇒ case (do_app (op :closLang$op) (REVERSE (a :v list)) r :(v # (α, β) state, v) result) of (Rval (v,r2) :(v # (α, β) state, v) result) => ∃(t2 :(α, β) state). state_rel t2 r2 ∧ (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # (α, β) state, v) result) => (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
tick_compile_prog_IMP_exp_rel_typed_goal=∀(limit :num) (cs0 :(num # bvl$exp) sptree$num_map) (in1 :(num # num # bvl$exp) list) (cs1 :(num # bvl$exp) sptree$num_map) (in2 :(num # num # bvl$exp) list) (k :num) (arity :num) (exp :bvl$exp) (src_code :(num # bvl$exp) sptree$num_map). tick_compile_prog limit cs0 in1 = (cs1,in2) ∧ ALOOKUP in1 k = SOME (arity,exp) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) in1) ∧ (∀(k :num) (arity :num) (v :bvl$exp). lookup k cs0 = SOME (arity,v) ⇒ ∃(exp :bvl$exp). lookup k src_code = SOME (arity,exp) ∧ exp_rel src_code [exp] [v]) ∧ DISJOINT (domain src_code :num -> bool) (set (MAP (FST :num # num # bvl$exp -> num) in1)) ∧ DISJOINT (domain cs0 :num -> bool) (set (MAP (FST :num # num # bvl$exp -> num) in1)) ⇒ ∃(exp2 :bvl$exp). ALOOKUP in2 k = SOME (arity,exp2) ∧ exp_rel (union src_code (fromAList in1)) [exp] [exp2]
tick_compile_prog_IMP_exp_rel_replay=∀(limit :num) (cs0 :(num # bvl$exp) sptree$num_map) (in1 :(num # num # bvl$exp) list) (cs1 :(num # bvl$exp) sptree$num_map) (in2 :(num # num # bvl$exp) list) (k :num) (arity :num) (exp :bvl$exp) (src_code :(num # bvl$exp) sptree$num_map). tick_compile_prog limit cs0 in1 = (cs1,in2) ∧ ALOOKUP in1 k = SOME (arity,exp) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) in1) ∧ (∀(k :num) (arity :num) (v :bvl$exp). lookup k cs0 = SOME (arity,v) ⇒ ∃(exp :bvl$exp). lookup k src_code = SOME (arity,exp) ∧ exp_rel src_code [exp] [v]) ∧ DISJOINT (domain src_code :num -> bool) (set (MAP (FST :num # num # bvl$exp -> num) in1)) ∧ DISJOINT (domain cs0 :num -> bool) (set (MAP (FST :num # num # bvl$exp -> num) in1)) ⇒ ∃(exp2 :bvl$exp). ALOOKUP in2 k = SOME (arity,exp2) ∧ exp_rel (union src_code (fromAList in1)) [exp] [exp2]
in_do_app_lemma_typed_goal=in_state_rel (limit :num) (s1 :((num # bvl$exp) sptree$num_map # α, β) state) (t1 :(α, β) state) ⇒ case (do_app (op :closLang$op) (a :v list) s1 :(v # ((num # bvl$exp) sptree$num_map # α, β) state, v) result) of (Rval (v,s2) :(v # ((num # bvl$exp) sptree$num_map # α, β) state, v) result) => ∃(t2 :(α, β) state). in_state_rel limit s2 t2 ∧ (do_app op a t1 :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # ((num # bvl$exp) sptree$num_map # α, β) state, v) result) => err ≠ (Rabort Rtype_error :v error_result) ⇒ (do_app op a t1 :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
in_do_app_lemma_replay=in_state_rel (limit :num) (s1 :((num # bvl$exp) sptree$num_map # α, β) state) (t1 :(α, β) state) ⇒ case (do_app (op :closLang$op) (a :v list) s1 :(v # ((num # bvl$exp) sptree$num_map # α, β) state, v) result) of (Rval (v,s2) :(v # ((num # bvl$exp) sptree$num_map # α, β) state, v) result) => ∃(t2 :(α, β) state). in_state_rel limit s2 t2 ∧ (do_app op a t1 :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # ((num # bvl$exp) sptree$num_map # α, β) state, v) result) => err ≠ (Rabort Rtype_error :v error_result) ⇒ (do_app op a t1 :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
do_app_lemma_replay=state_rel (t' :(α, β) state) (r :(α, β) state) ⇒ case (do_app (op :closLang$op) (REVERSE (a :v list)) r :(v # (α, β) state, v) result) of (Rval (v,r2) :(v # (α, β) state, v) result) => ∃(t2 :(α, β) state). state_rel t2 r2 ∧ (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # (α, β) state, v) result) => (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
