state_rel=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ t = s with <|code := map ((I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) s.code; compile := t.compile; compile_oracle := ((I :γ -> γ) ## MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x])))) ∘ s.compile_oracle|> ∧ s.compile = (λ(cfg :γ) (prog :(num # num # bvl$exp) list). t.compile cfg (MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) prog))
do_app_lemma_typed_goal=state_rel (t' :(α, β) state) (r :(α, β) state) ⇒ case (do_app (op :closLang$op) (REVERSE (a :v list)) r :(v # (α, β) state, v) result) of (Rval (v,r2) :(v # (α, β) state, v) result) => ∃(t2 :(α, β) state). state_rel t2 r2 ∧ (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # (α, β) state, v) result) => (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
do_app_lemma_replay=state_rel (t' :(α, β) state) (r :(α, β) state) ⇒ case (do_app (op :closLang$op) (REVERSE (a :v list)) r :(v # (α, β) state, v) result) of (Rval (v,r2) :(v # (α, β) state, v) result) => ∃(t2 :(α, β) state). state_rel t2 r2 ∧ (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # (α, β) state, v) result) => (do_app op (REVERSE a) t' :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
