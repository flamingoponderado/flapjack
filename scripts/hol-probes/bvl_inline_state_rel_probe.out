state_rel=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ t = s with <|code := map ((I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) s.code; compile := t.compile; compile_oracle := ((I :γ -> γ) ## MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x])))) ∘ s.compile_oracle|> ∧ s.compile = (λ(cfg :γ) (prog :(num # num # bvl$exp) list). t.compile cfg (MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) prog))
