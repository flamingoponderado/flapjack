clos_approx_typed=∀(max_size :num) (loc :num) (num_args :num) (body :closLang$exp). clos_approx max_size loc num_args body = case get_size_sc max_size body of (NONE :num option) => ClosNoInline loc num_args | SOME body_size => Clos loc num_args body body_size
