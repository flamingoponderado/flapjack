update_thunk_ssgc_free_statement_typed=ssgc_free (s :(α, β) state) ∧ EVERY vsgc_free (vs :v list) ∧ update_thunk [RefPtr (v :bool) (ptr :num)] s.refs vs = SOME (refs :num |-> v ref) ⇒ ssgc_free (s with refs := refs)
