known_length_eq_typed=known (limit :config) (es :closLang$exp list) (vs :val_approx list) (g0 :val_approx sptree$num_map) = ((alist :(closLang$exp # val_approx) list),(g :val_approx sptree$num_map)) ⇒ LENGTH alist = LENGTH es
known_sing_typed=∀(limit :config) (e :closLang$exp) (vs :val_approx list) (g :val_approx sptree$num_map). ∃(e' :closLang$exp) (a :val_approx) (g' :val_approx sptree$num_map). known limit [e] vs g = ([(e',a)],g')
known_sing_eq_typed=∀(limit :config) (e :closLang$exp) (vs :val_approx list) (g0 :val_approx sptree$num_map) (all :(closLang$exp # val_approx) list) (g :val_approx sptree$num_map). known limit [e] vs g0 = (all,g) ⇒ ∃(e' :closLang$exp) (apx :val_approx). all = [(e',apx)]
mapped_globals_typed=∀(g :α option list). mapped_globals g = {i | ∃(v :α). get_global i g = SOME (SOME v)}
mglobals_extend_typed=∀(g1 :α option list) (mgs :num -> bool) (g2 :α option list). mglobals_extend g1 mgs g2 ⇔ mapped_globals g2 ⊆ mapped_globals g1 ∪ mgs ∧ ∀(k :num) (v :α). get_global k g2 = SOME (SOME v) ∧ k ∉ mgs ⇒ get_global k g1 = SOME (SOME v)
mglobals_extend_refl_typed=mglobals_extend (s :α option list) (gs :num -> bool) s
mglobals_extend_trans_typed=∀(s0 :α option list) (s1 :α option list) (s2 :α option list) (g1 :num -> bool) (g2 :num -> bool). mglobals_extend s0 g1 s1 ∧ mglobals_extend s1 g2 s2 ⇒ mglobals_extend s0 (g1 ∪ g2) s2
mglobals_extend_subset_typed=∀(s0 :α option list) (s :α option list) (g1 :num -> bool) (g2 :num -> bool). mglobals_extend s0 g1 s ∧ g1 ⊆ g2 ⇒ mglobals_extend s0 g2 s
state_globals_approx_subspt_typed=∀(g0 :val_approx sptree$num_map) (g :val_approx sptree$num_map) (s :(α, β) state). subspt g0 g ∧ state_globals_approx s g ⇒ state_globals_approx s g0
known_op_changed_globals_typed=∀(opn :closLang$op) (aenv :val_approx list) (g0 :val_approx sptree$num_map) (a :val_approx) (g :val_approx sptree$num_map). known_op opn aenv g0 = (a,g) ⇒ ∀(i :num). i ∈ (domain g :num -> bool) ∧ (i ∈ (domain g0 :num -> bool) ⇒ lookup i g ≠ lookup i g0) ⇒ i ∈ SET_OF_BAG (op_gbag opn)
known_op_changed_globals_cases_typed=∀(opn :closLang$op) (aenv :val_approx list) (g0 :val_approx sptree$num_map) (ea :val_approx) (g :val_approx sptree$num_map). known_op opn aenv g0 = (ea,g) ⇒ ∀(k :num) (a :val_approx). lookup k g = SOME a ⇒ lookup k g0 = SOME a ∨ k ∈ SET_OF_BAG (op_gbag opn)
known_op_changed_globals_alt_set_typed=∀(opn :closLang$op) (aenv :val_approx list) (g0 :val_approx sptree$num_map) (a :val_approx) (g :val_approx sptree$num_map). known_op opn aenv g0 = (a,g) ⇒ (domain g :num -> bool) ⊆ (domain g0 :num -> bool) ∪ SET_OF_BAG (op_gbag opn)
do_app_ssgc_typed=∀(opn :closLang$op) (args :v list) (s0 :(α, β) state) (res :(v # (α, β) state, v) result). (do_app opn args s0 :(v # (α, β) state, v) result) = res ∧ EVERY vsgc_free args ∧ ssgc_free s0 ⇒ (∀(v :v) (s :(α, β) state). res = (Rval (v,s) :(v # (α, β) state, v) result) ⇒ vsgc_free v ∧ ssgc_free s ∧ s.compile_oracle = s0.compile_oracle ∧ mglobals_extend s0.globals (SET_OF_BAG (op_gbag opn)) s.globals) ∧ ∀(v :v). res = (Rerr (Rraise v) :(v # (α, β) state, v) result) ⇒ vsgc_free v
vsgc_free_typed=(∀(v1 :num) (v0 :num option) (body :closLang$exp) (VL2 :v list) (VL1 :v list). vsgc_free (Closure v0 VL1 VL2 v1 body :v) ⇔ set_globals body = ({||} :num -> num) ∧ EVERY vsgc_free VL1 ∧ EVERY vsgc_free VL2) ∧ (∀(v3 :num) (v2 :num option) (bods :(num # closLang$exp) list) (VL2 :v list) (VL1 :v list). vsgc_free (Recclosure v2 VL1 VL2 bods v3 :v) ⇔ elist_globals (MAP (SND :num # closLang$exp -> closLang$exp) bods) = ({||} :num -> num) ∧ EVERY vsgc_free VL1 ∧ EVERY vsgc_free VL2) ∧ (∀(v4 :num) (VL :v list). vsgc_free (Block v4 VL) ⇔ EVERY vsgc_free VL) ∧ (∀(v :int). vsgc_free (Number v)) ∧ (∀(v6 :word64). vsgc_free (Word64 v6 :v)) ∧ (∀(v9 :word8 list). vsgc_free (ByteVector v9)) ∧ ∀(v11 :num) (v10 :bool). vsgc_free (RefPtr v10 v11)
rsgc_free_typed=(rsgc_free (Rval (vs :v list) :(v list, v) result) ⇔ EVERY vsgc_free vs) ∧ (rsgc_free (Rerr (Rabort (v0 :abort) :v error_result) :(v list, v) result) ⇔ T) ∧ (rsgc_free (Rerr (Rraise (v :v)) :(v list, v) result) ⇔ vsgc_free v)
ssgc_free_typed=∀(s :(γ, 'ffi) state). ssgc_free s ⇔ (∀(n :num) (m :num) (e :closLang$exp). FLOOKUP s.code n = SOME (m,e) ⇒ set_globals e = ({||} :num -> num)) ∧ (∀(n :num) (vl :v list). FLOOKUP s.refs n = SOME (ValueArray vl) ⇒ EVERY vsgc_free vl) ∧ (∀(n :num) (m :thunk_mode) (v :v). FLOOKUP s.refs n = SOME (Thunk m v :v ref) ⇒ vsgc_free v) ∧ (∀(v :v). MEM (SOME v) s.globals ⇒ vsgc_free v) ∧ ∀(n :num) (exp :closLang$exp list) (aux :(num # num # closLang$exp) list). SND (s.compile_oracle n) = (exp,aux) ⇒ EVERY esgc_free exp ∧ elist_globals (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) aux) = ({||} :num -> num)
vsgc_free_unit_typed=vsgc_free Unit
vsgc_free_bool_typed=vsgc_free (Boolv (b :bool) :v)
ssgc_free_clock_typed=ssgc_free ((s :(α, β) state) with clock updated_by (f :num -> num)) ⇔ ssgc_free s
ssgc_free_dec_clock_typed=ssgc_free (dec_clock (n :num) (s :(α, β) state)) ⇔ ssgc_free s
