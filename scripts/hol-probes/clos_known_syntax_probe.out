unique_set_globals_evaluate_typed=∀(es :closLang$exp list) (xs :closLang$exp list) (env :v list) (s1 :(α, β) state) (s2 :(α, β) state) (res :(v list, v) result). unique_set_globals xs s1.compile_oracle ∧ evaluate (es,env,s1) = (res,s2) ⇒ unique_set_globals xs s2.compile_oracle
oracle_gapprox_disjoint_evaluate_typed=∀(g :α sptree$num_map) (s0 :(β, γ) state) (es :closLang$exp list) (env :v list) (res :(v list, v) result) (s1 :(β, γ) state). oracle_gapprox_disjoint g s0.compile_oracle ∧ evaluate (es,env,s0) = (res,s1) ⇒ oracle_gapprox_disjoint g s1.compile_oracle
