gapprox_disjoint_def_typed=∀(g :α sptree$num_map) (xs :closLang$exp list). gapprox_disjoint g xs ⇔ DISJOINT (domain g :num -> bool) (SET_OF_BAG (elist_globals xs))
gapprox_disjoint_rw_typed=(gapprox_disjoint (g :α sptree$num_map) ((x :closLang$exp)::(y :closLang$exp)::(xs :closLang$exp list)) ⇔ gapprox_disjoint g [x] ∧ gapprox_disjoint g (y::xs)) ∧ (gapprox_disjoint g [Op (tr :tra) (opn :closLang$op) xs] ⇔ gapprox_disjoint g xs ∧ DISJOINT (domain g :num -> bool) (SET_OF_BAG (op_gbag opn)))
