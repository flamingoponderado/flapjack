mem_first_n_exps_typed=∀(k :num) (n :num). k < n ⇒ ∀(co :num -> α # β # γ). MEM (FST (SND (co k))) (first_n_exps co n)
shift_seq_zero_typed=∀(co :num -> α). shift_seq (0 :num) co = co
shift_seq_add_typed=∀(co :num -> α) (k1 :num) (k2 :num). shift_seq k2 (shift_seq k1 co) = shift_seq (k1 + k2) co
