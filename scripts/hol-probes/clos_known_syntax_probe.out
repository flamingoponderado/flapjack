simple_val_rel_do_app_rev_typed=simple_val_rel (vr :v -> v -> bool) ∧ simple_state_rel vr (sr :(α, 'ffi) state -> (γ, 'ffi) state -> bool) ⇒ sr (s :(α, 'ffi) state) (t :(γ, 'ffi) state) ∧ LIST_REL vr (xs :v list) (ys :v list) ⇒ case (do_app (opp :closLang$op) ys t :(v # (γ, 'ffi) state, v) result) of (Rval (y,t1) :(v # (γ, 'ffi) state, v) result) => ∃(x :v) (s1 :(α, 'ffi) state). vr x y ∧ sr s1 t1 ∧ (do_app opp xs s :(v # (α, 'ffi) state, v) result) = (Rval (x,s1) :(v # (α, 'ffi) state, v) result) | (Rerr err2 :(v # (γ, 'ffi) state, v) result) => ∃(err1 :v error_result). (do_app opp xs s :(v # (α, 'ffi) state, v) result) = (Rerr err1 :(v # (α, 'ffi) state, v) result) ∧ exc_rel vr err1 err2
