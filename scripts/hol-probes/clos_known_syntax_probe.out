syntax_ok_typed=∀(xs :closLang$exp list). syntax_ok xs ⇔ every_Fn_vs_NONE xs ∧ BAG_ALL_DISTINCT (elist_globals xs) ∧ EVERY esgc_free xs
bag_all_distinct_typed=∀(b :α -> num). BAG_ALL_DISTINCT b ⇔ ∀(e :α). b e ≤ (1 :num)
option_val_approx_spt_typed=∀(kc :config option). option_val_approx_spt kc = case kc of (NONE :config option) => (LN :val_approx sptree$num_map) | SOME kcfg => kcfg.val_approx_spt
option_upd_val_spt_typed=(∀(spt :val_approx sptree$num_map). option_upd_val_spt spt (NONE :config option) = (NONE :config option)) ∧ ∀(spt :val_approx sptree$num_map) (kc :config). option_upd_val_spt spt (SOME kc) = SOME (kc with val_approx_spt := spt)
contains_closures_typed=(contains_closures ([] :closLang$exp list) ⇔ F) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). contains_closures (x::y::xs) ⇔ if contains_closures [x] then T else contains_closures (y::xs)) ∧ (∀(v :num) (t :tra). contains_closures [(Var t v :closLang$exp)] ⇔ F) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). contains_closures [(If t x1 x2 x3 :closLang$exp)] ⇔ if contains_closures [x1] then T else if contains_closures [x2] then T else contains_closures [x3]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). contains_closures [(Let t xs x2 :closLang$exp)] ⇔ if contains_closures xs then T else contains_closures [x2]) ∧ (∀(x1 :closLang$exp) (t :tra). contains_closures [(Raise t x1 :closLang$exp)] ⇔ contains_closures [x1]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). contains_closures [(Handle t x1 x2 :closLang$exp)] ⇔ if contains_closures [x1] then T else contains_closures [x2]) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). contains_closures [Op t op xs] ⇔ contains_closures xs) ∧ (∀(x :closLang$exp) (t :tra). contains_closures [Tick t x] ⇔ contains_closures [x]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). contains_closures [Call t ticks dest xs] ⇔ contains_closures xs) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). contains_closures [Fn t loc_opt ws_opt num_args x1] ⇔ T) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). contains_closures [(Letrec t loc_opt ws_opt fns x1 :closLang$exp)] ⇔ T) ∧ ∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). contains_closures [(App t loc_opt x1 xs :closLang$exp)] ⇔ if contains_closures [x1] then T else contains_closures xs
get_size_aux_typed=get_size_aux ([] :closLang$exp list) = (0 :num) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). get_size_aux (x::y::xs) = get_size_aux [x] + get_size_aux (y::xs)) ∧ (∀(v :num) (t :tra). get_size_aux [(Var t v :closLang$exp)] = (1 :num)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). get_size_aux [(If t x1 x2 x3 :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux [x2] + get_size_aux [x3]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). get_size_aux [(Let t xs x2 :closLang$exp)] = (1 :num) + get_size_aux xs + get_size_aux [x2]) ∧ (∀(x1 :closLang$exp) (t :tra). get_size_aux [(Raise t x1 :closLang$exp)] = (1 :num) + get_size_aux [x1]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). get_size_aux [(Handle t x1 x2 :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux [x2]) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). get_size_aux [Op t op xs] = (1 :num) + get_size_aux xs) ∧ (∀(x :closLang$exp) (t :tra). get_size_aux [Tick t x] = get_size_aux [x]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). get_size_aux [Call t ticks dest xs] = (1 :num) + get_size_aux xs) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). get_size_aux [Fn t loc_opt ws_opt num_args x1] = (1 :num) + get_size_aux [x1]) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). get_size_aux [(Letrec t loc_opt ws_opt fns x1 :closLang$exp)] = (1 :num) + get_size_aux (MAP (SND :num # closLang$exp -> closLang$exp) fns) + get_size_aux [x1]) ∧ ∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). get_size_aux [(App t loc_opt x1 xs :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux xs
get_size_typed=∀(e :closLang$exp). get_size e = get_size_aux [e]
get_size_sc_aux_correct_typed=∀(xs :closLang$exp list) (limit :num) (n :α). get_size_sc_aux limit xs = limit − get_size_aux xs
get_size_sc_some_typed=∀(exp :closLang$exp) (limit :num) (n :num). get_size_sc limit exp = SOME n ⇒ get_size exp = n
