known_op_typed=known_op (GlobOp (Global (n :num))) (as :val_approx list) (g :val_approx sptree$num_map) = (if NULL as then case lookup n g of (NONE :val_approx option) => (Other,g) | SOME x => (x,g) else (Other,g)) ∧ known_op (GlobOp (SetGlobal n)) as g = (case as of ([] :val_approx list) => (Other,g) | a::xs => case lookup n g of (NONE :val_approx option) => (Other,insert n a g) | SOME other => (Other,insert n (merge other a :val_approx) g)) ∧ known_op (BlockOp (Cons (tg :num) :block_op)) as g = (Tuple tg as,g) ∧ known_op (IntOp (Const (i :int))) as g = ((Int i :val_approx),g) ∧ known_op (MemOp El) as g = (case as of ([] :val_approx list) => (Other,g) | [ClosNoInline v22 v23] => (Other,g) | ClosNoInline v22 v23::ClosNoInline v44 v45::v34 => (Other,g) | ClosNoInline v22 v23::Clos v46 v47 v48 v49::v34 => (Other,g) | ClosNoInline v22 v23::Tuple v50 v51::v34 => (Other,g) | ClosNoInline v22 v23::(Int v52 :val_approx)::v34 => (Other,g) | ClosNoInline v22 v23::Other::v34 => (Other,g) | ClosNoInline v22 v23::Impossible::v34 => (Impossible,g) | [Clos v24 v25 v26 v27] => (Other,g) | Clos v24 v25 v26 v27::ClosNoInline v66 v67::v56 => (Other,g) | Clos v24 v25 v26 v27::Clos v68 v69 v70 v71::v56 => (Other,g) | Clos v24 v25 v26 v27::Tuple v72 v73::v56 => (Other,g) | Clos v24 v25 v26 v27::(Int v74 :val_approx)::v56 => (Other,g) | Clos v24 v25 v26 v27::Other::v56 => (Other,g) | Clos v24 v25 v26 v27::Impossible::v56 => (Impossible,g) | [Tuple v28 xs] => (Other,g) | Tuple v28 xs::ClosNoInline v88 v89::v78 => (Other,g) | Tuple v28 xs::Clos v90 v91 v92 v93::v78 => (Other,g) | Tuple v28 xs::Tuple v94 v95::v78 => (Other,g) | [Tuple v28 xs; (Int i :val_approx)] => if (0 :int) ≤ i ∧ i < ((&LENGTH xs) :int) then (xs❲Num i❳,g) else (Other,g) | Tuple v28 xs::(Int i :val_approx)::v99::v100 => (Other,g) | Tuple v28 xs::Other::v78 => (Other,g) | Tuple v28 xs::Impossible::v78 => (Impossible,g) | [(Int v30 :val_approx)] => (Other,g) | (Int v30 :val_approx)::ClosNoInline v114 v115::v104 => (Other,g) | (Int v30 :val_approx)::Clos v116 v117 v118 v119::v104 => (Other,g) | (Int v30 :val_approx)::Tuple v120 v121::v104 => (Other,g) | (Int v30 :val_approx)::(Int v122 :val_approx)::v104 => (Other,g) | (Int v30 :val_approx)::Other::v104 => (Other,g) | (Int v30 :val_approx)::Impossible::v104 => (Impossible,g) | [Other] => (Other,g) | Other::ClosNoInline v136 v137::v126 => (Other,g) | Other::Clos v138 v139 v140 v141::v126 => (Other,g) | Other::Tuple v142 v143::v126 => (Other,g) | Other::(Int v144 :val_approx)::v126 => (Other,g) | Other::Other::v126 => (Other,g) | Other::Impossible::v126 => (Impossible,g) | Impossible::xs' => (Impossible,g)) ∧ known_op (Label (v5 :num)) as g = (Other,g) ∧ known_op (FFI (v6 :mlstring) :closLang$op) as g = (Other,g) ∧ known_op (IntOp Add) as g = (Other,g) ∧ known_op (IntOp Sub) as g = (Other,g) ∧ known_op (IntOp Mult) as g = (Other,g) ∧ known_op (IntOp Div) as g = (Other,g) ∧ known_op (IntOp Mod) as g = (Other,g) ∧ known_op (IntOp Less) as g = (Other,g) ∧ known_op (IntOp LessEq) as g = (Other,g) ∧ known_op (IntOp Greater) as g = (Other,g) ∧ known_op (IntOp GreaterEq) as g = (Other,g) ∧ known_op (IntOp (LessConstSmall (v29 :num))) as g = (Other,g) ∧ known_op (WordOp (v8 :word_op)) as g = (Other,g) ∧ known_op (BlockOp (ElemAt (v36 :num))) as g = (Other,g) ∧ known_op (BlockOp (TagLenEq (v37 :num) (v38 :num) :block_op)) as g = (Other,g) ∧ known_op (BlockOp (LenEq (v39 :num) :block_op)) as g = (Other,g) ∧ known_op (BlockOp (TagEq (v40 :num))) as g = (Other,g) ∧ known_op (BlockOp LengthBlock) as g = (Other,g) ∧ known_op (BlockOp (BoolTest (v41 :test))) as g = (Other,g) ∧ known_op (BlockOp BoolNot) as g = (Other,g) ∧ known_op (BlockOp BoundsCheckBlock) as g = (Other,g) ∧ known_op (BlockOp (ConsExtend (v42 :num))) as g = (Other,g) ∧ known_op (BlockOp (FromList (v43 :num))) as g = (Other,g) ∧ known_op (BlockOp ListAppend) as g = (Other,g) ∧ known_op (BlockOp (Constant (v53 :const))) as g = (Other,g) ∧ known_op (BlockOp Equal) as g = (Other,g) ∧ kno