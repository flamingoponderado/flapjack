get_size_aux_typed=get_size_aux ([] :closLang$exp list) = (0 :num) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). get_size_aux (x::y::xs) = get_size_aux [x] + get_size_aux (y::xs)) ∧ (∀(v :num) (t :tra). get_size_aux [(Var t v :closLang$exp)] = (1 :num)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). get_size_aux [(If t x1 x2 x3 :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux [x2] + get_size_aux [x3]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). get_size_aux [(Let t xs x2 :closLang$exp)] = (1 :num) + get_size_aux xs + get_size_aux [x2]) ∧ (∀(x1 :closLang$exp) (t :tra). get_size_aux [(Raise t x1 :closLang$exp)] = (1 :num) + get_size_aux [x1]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). get_size_aux [(Handle t x1 x2 :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux [x2]) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). get_size_aux [Op t op xs] = (1 :num) + get_size_aux xs) ∧ (∀(x :closLang$exp) (t :tra). get_size_aux [Tick t x] = get_size_aux [x]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). get_size_aux [Call t ticks dest xs] = (1 :num) + get_size_aux xs) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). get_size_aux [Fn t loc_opt ws_opt num_args x1] = (1 :num) + get_size_aux [x1]) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). get_size_aux [(Letrec t loc_opt ws_opt fns x1 :closLang$exp)] = (1 :num) + get_size_aux (MAP (SND :num # closLang$exp -> closLang$exp) fns) + get_size_aux [x1]) ∧ ∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). get_size_aux [(App t loc_opt x1 xs :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux xs
