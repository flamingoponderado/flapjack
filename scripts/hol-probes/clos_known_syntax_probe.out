get_size_aux_typed=get_size_aux ([] :closLang$exp list) = (0 :num) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). get_size_aux (x::y::xs) = get_size_aux [x] + get_size_aux (y::xs)) ∧ (∀(v :num) (t :tra). get_size_aux [(Var t v :closLang$exp)] = (1 :num)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). get_size_aux [(If t x1 x2 x3 :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux [x2] + get_size_aux [x3]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). get_size_aux [(Let t xs x2 :closLang$exp)] = (1 :num) + get_size_aux xs + get_size_aux [x2]) ∧ (∀(x1 :closLang$exp) (t :tra). get_size_aux [(Raise t x1 :closLang$exp)] = (1 :num) + get_size_aux [x1]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). get_size_aux [(Handle t x1 x2 :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux [x2]) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). get_size_aux [Op t op xs] = (1 :num) + get_size_aux xs) ∧ (∀(x :closLang$exp) (t :tra). get_size_aux [Tick t x] = get_size_aux [x]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). get_size_aux [Call t ticks dest xs] = (1 :num) + get_size_aux xs) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). get_size_aux [Fn t loc_opt ws_opt num_args x1] = (1 :num) + get_size_aux [x1]) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). get_size_aux [(Letrec t loc_opt ws_opt fns x1 :closLang$exp)] = (1 :num) + get_size_aux (MAP (SND :num # closLang$exp -> closLang$exp) fns) + get_size_aux [x1]) ∧ ∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). get_size_aux [(App t loc_opt x1 xs :closLang$exp)] = (1 :num) + get_size_aux [x1] + get_size_aux xs
get_size_typed=∀(e :closLang$exp). get_size e = get_size_aux [e]
get_size_sc_aux_typed=(∀(n :num). get_size_sc_aux n ([] :closLang$exp list) = n) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp) (n :num). get_size_sc_aux n (x::y::xs) = if n = (0 :num) then n else (let (n' :num) = get_size_sc_aux n [x] in if n' = (0 :num) then n' else get_size_sc_aux n' (y::xs))) ∧ (∀(v :num) (t :tra) (n :num). get_size_sc_aux n [(Var t v :closLang$exp)] = n − (1 :num)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra) (n :num). get_size_sc_aux n [(If t x1 x2 x3 :closLang$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = get_size_sc_aux n' [x1] in if n'' = (0 :num) then (0 :num) else (let (n'³' :num) = get_size_sc_aux n'' [x2] in if n'³' = (0 :num) then (0 :num) else get_size_sc_aux n'³' [x3])))) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra) (n :num). get_size_sc_aux n [(Let t xs x2 :closLang$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = get_size_sc_aux n' xs in if n'' = (0 :num) then (0 :num) else get_size_sc_aux n'' [x2]))) ∧ (∀(x1 :closLang$exp) (t :tra) (n :num). get_size_sc_aux n [(Raise t x1 :closLang$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else get_size_sc_aux n' [x1])) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra) (n :num). get_size_sc_aux n [(Handle t x1 x2 :closLang$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = get_size_sc_aux n' [x1] in if n'' = (0 :num) then (0 :num) else get_size_sc_aux n'' [x2]))) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op) (n :num). get_size_sc_aux n [Op t op xs] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else get_size_sc_aux n' xs)) ∧ (∀(x :closLang$exp) (t :tra) (n :num). get_size_sc_aux n [Tick t x] = get_size_sc_aux n [x]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (n :num) (dest :num). get_size_sc_aux n [Call t ticks dest xs] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else get_size_sc_aux n' xs)) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring) (num_args :num) (n :num) (loc_opt :num option). get_size_sc_aux n [Fn t loc_opt ws_opt num_args x1] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else get_size_sc_aux n' [x1])) ∧ (∀(x1 :closLang$exp) (ws_opt :num list option) (t :mlstring list) (n :num) (loc_opt :num option) (fns :(num # closLang$exp) list). get_size_sc_aux n [(Letrec t loc_opt ws_opt fns x1 :closLang$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = get_size_sc_aux n' (MAP (SND :num # closLang$exp -> closLang$exp) fns) in if n'' = (0 :num) then (0 :num) else get_size_sc_aux n'' [x1]))) ∧ ∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (n :num) (loc_opt :num option). get_size_sc_aux n [(App t loc_opt x1 xs :closLang$exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = get_size_sc_aux n' [x1] in if n'' = (0 :num) then (0 :num) else get_size_sc_aux n'' xs))
get_size_sc_typed=∀(limit :num) (e :closLang$exp). get_size_sc limit e = (let (n :num) = get_size_sc_aux (limit + (1 :num)) [e] in if n = (0 :num) then (NONE :num option) else SOME (limit + (1 :num) − n))
clos_approx_typed=∀(max_size :num) (loc :num) (num_args :num) (body :closLang$exp). clos_approx max_size loc num_args body = case get_size_sc max_size body of (NONE :num option) => ClosNoInline loc num_args | SOME body_size => Clos loc num_args body body_size
clos_gen_noinline_typed=(∀(n :num) (i :num). clos_gen_noinline n i ([] :(num # α) list) = ([] :val_approx list)) ∧ ∀(xs :(num # α) list) (n :num) (i :num) (e :α) (a :num). clos_gen_noinline n i ((a,e)::xs) = ClosNoInline (n + (2 :num) * i) a::clos_gen_noinline n (i + (1 :num)) xs
mk_ticks_typed=∀(tc :num) (t :tra) (n :num) (e :closLang$exp). (mk_Ticks t tc n e :closLang$exp) = if n = (0 :num) then e else (mk_Ticks t (tc + (1 :num)) (n − (1 :num)) (Tick (t § tc) e) :closLang$exp)
