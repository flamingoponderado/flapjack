ret_to_tail_def_typed=ret_to_tail (Skip :α prog) = (Skip :α prog) ∧ (∀(v :mlstring) (s :shape) (q :α prog) (e :α exp). ret_to_tail (Dec v s e q) = Dec v s e (ret_to_tail q)) ∧ (∀(q :α prog) (p :α prog). ret_to_tail (Seq p q) = seq_call_ret (Seq (ret_to_tail p) (ret_to_tail q))) ∧ (∀(q :α prog) (p :α prog) (e :α exp). ret_to_tail (If e p q) = If e (ret_to_tail p) (ret_to_tail q)) ∧ (∀(p :α prog) (e :α exp). ret_to_tail (While e p) = While e (ret_to_tail p)) ∧ (∀(name :mlstring) (args :α exp list). ret_to_tail (TailCall name args) = TailCall name args) ∧ (∀(rv :(varkind # mlstring) option) (name :mlstring) (exp :(mlstring # mlstring # α prog) option) (args :α exp list). ret_to_tail (Call (SOME (rv,exp)) name args :α prog) = (Call (SOME (rv,case exp of (NONE :(mlstring # mlstring # α prog) option) => (NONE :(mlstring # mlstring # α prog) option) | SOME (eid,ev,ep) => SOME (eid,ev,ret_to_tail ep))) name args :α prog)) ∧ (∀(v :mlstring) (s :shape) (q :α prog) (es :α exp list) (e :mlstring). ret_to_tail (DecCall v s e es q) = DecCall v s e es (ret_to_tail q)) ∧ (∀(v8 :α exp) (v7 :mlstring) (v6 :varkind). ret_to_tail (Assign v6 v7 v8) = Assign v6 v7 v8) ∧ (∀(v9 :mlstring) (v11 :α exp list) (v10 :primop). ret_to_tail (Primitive v9 v10 v11) = Primitive v9 v10 v11) ∧ (∀(v13 :α exp) (v12 :α exp). ret_to_tail (Store v12 v13 :α prog) = (Store v12 v13 :α prog)) ∧ (∀(v15 :α exp) (v14 :α exp). ret_to_tail (Store32 v14 v15 :α prog) = (Store32 v14 v15 :α prog)) ∧ (∀(v17 :α exp) (v16 :α exp). ret_to_tail (StoreByte v16 v17) = StoreByte v16 v17) ∧ ret_to_tail (Break :α prog) = (Break :α prog) ∧ ret_to_tail (Continue :α prog) = (Continue :α prog) ∧ (∀(v37 :α exp) (v36 :α exp) (v35 :α exp) (v34 :α exp) (v33 :mlstring). ret_to_tail (ExtCall v33 v34 v35 v36 v37) = ExtCall v33 v34 v35 v36 v37) ∧ (∀(v39 :α exp) (v38 :mlstring). ret_to_tail (Raise v38 v39 :α prog) = (Raise v38 v39 :α prog)) ∧ (∀(v40 :α exp). ret_to_tail (Return v40) = Return v40) ∧ (∀(v44 :α exp) (v43 :mlstring) (v42 :varkind) (v41 :opsize). ret_to_tail (ShMemLoad v41 v42 v43 v44) = ShMemLoad v41 v42 v43 v44) ∧ (∀(v47 :α exp) (v46 :α exp) (v45 :opsize). ret_to_tail (ShMemStore v45 v46 v47) = ShMemStore v45 v46 v47) ∧ ret_to_tail (Tick :α prog) = (Tick :α prog) ∧ ∀(v49 :mlstring) (v48 :mlstring). ret_to_tail (Annot v48 v49 :α prog) = (Annot v48 v49 :α prog)
