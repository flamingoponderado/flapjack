seq_assoc_def_typed=(∀(p :α prog). seq_assoc p (Skip :α prog) = p) ∧ (∀(v :mlstring) (s :shape) (q :α prog) (p :α prog) (e :α exp). seq_assoc p (Dec v s e q) = SmartSeq p (Dec v s e (seq_assoc (Skip :α prog) q))) ∧ (∀(r :α prog) (q :α prog) (p :α prog). seq_assoc p (Seq q r) = seq_assoc (seq_assoc p q) r) ∧ (∀(r :α prog) (q :α prog) (p :α prog) (e :α exp). seq_assoc p (If e q r) = SmartSeq p (If e (seq_assoc (Skip :α prog) q) (seq_assoc (Skip :α prog) r))) ∧ (∀(q :α prog) (p :α prog) (e :α exp). seq_assoc p (While e q) = SmartSeq p (While e (seq_assoc (Skip :α prog) q))) ∧ (∀(p :α prog) (name :mlstring) (args :α exp list). seq_assoc p (TailCall name args) = SmartSeq p (TailCall name args)) ∧ (∀(rv :(varkind # mlstring) option) (p :α prog) (name :mlstring) (exp :(mlstring # mlstring # α prog) option) (args :α exp list). seq_assoc p (Call (SOME (rv,exp)) name args :α prog) = SmartSeq p (Call (case exp of (NONE :(mlstring # mlstring # α prog) option) => SOME (rv,(NONE :(mlstring # mlstring # α prog) option)) | SOME (eid,ev,ep) => SOME (rv,SOME (eid,ev,seq_assoc (Skip :α prog) ep))) name args :α prog)) ∧ (∀(v :mlstring) (s :shape) (q :α prog) (p :α prog) (es :α exp list) (e :mlstring). seq_assoc p (DecCall v s e es q) = SmartSeq p (DecCall v s e es (seq_assoc (Skip :α prog) q))) ∧ (∀(v1 :mlstring) (v0 :mlstring) (p :α prog). seq_assoc p (Annot v0 v1 :α prog) = p) ∧ (∀(v9 :varkind) (v11 :α exp) (v10 :mlstring) (p :α prog). seq_assoc p (Assign v9 v10 v11) = SmartSeq p (Assign v9 v10 v11)) ∧ (∀(v14 :α exp list) (v13 :primop) (v12 :mlstring) (p :α prog). seq_assoc p (Primitive v12 v13 v14) = SmartSeq p (Primitive v12 v13 v14)) ∧ (∀(v16 :α exp) (v15 :α exp) (p :α prog). seq_assoc p (Store v15 v16 :α prog) = SmartSeq p (Store v15 v16 :α prog)) ∧ (∀(v18 :α exp) (v17 :α exp) (p :α prog). seq_assoc p (Store32 v17 v18 :α prog) = SmartSeq p (Store32 v17 v18 :α prog)) ∧ (∀(v20 :α exp) (v19 :α exp) (p :α prog). seq_assoc p (StoreByte v19 v20) = SmartSeq p (StoreByte v19 v20)) ∧ (∀(p :α prog). seq_assoc p (Break :α prog) = SmartSeq p (Break :α prog)) ∧ (∀(p :α prog). seq_assoc p (Continue :α prog) = SmartSeq p (Continue :α prog)) ∧ (∀(v40 :α exp) (v39 :α exp) (v38 :α exp) (v37 :α exp) (v36 :mlstring) (p :α prog). seq_assoc p (ExtCall v36 v37 v38 v39 v40) = SmartSeq p (ExtCall v36 v37 v38 v39 v40)) ∧ (∀(v42 :α exp) (v41 :mlstring) (p :α prog). seq_assoc p (Raise v41 v42 :α prog) = SmartSeq p (Raise v41 v42 :α prog)) ∧ (∀(v43 :α exp) (p :α prog). seq_assoc p (Return v43) = SmartSeq p (Return v43)) ∧ (∀(v47 :α exp) (v46 :mlstring) (v45 :varkind) (v44 :opsize) (p :α prog). seq_assoc p (ShMemLoad v44 v45 v46 v47) = SmartSeq p (ShMemLoad v44 v45 v46 v47)) ∧ (∀(v50 :α exp) (v49 :α exp) (v48 :opsize) (p :α prog). seq_assoc p (ShMemStore v48 v49 v50) = SmartSeq p (ShMemStore v48 v49 v50)) ∧ ∀(p :α prog). seq_assoc p (Tick :α prog) = SmartSeq p (Tick :α prog)
seq_call_ret_def_typed=∀(prog :α prog). seq_call_ret prog = case prog of (Skip :α prog) => (Skip :α prog) | Dec v48 v49 v50 v51 => Dec v48 v49 v50 v51 | Assign v52 v53 v54 => Assign v52 v53 v54 | Primitive v55 v56 v57 => Primitive v55 v56 v57 | (Store v58 v59 :α prog) => (Store v58 v59 :α prog) | (Store32 v60 v61 :α prog) => (Store32 v60 v61 :α prog) | StoreByte v62 v63 => StoreByte v62 v63 | Seq v64 (Skip :α prog) => Seq v64 (Skip :α prog) | Seq v64 (Dec v144 v145 v146 v147) => Seq v64 (Dec v144 v145 v146 v147) | Seq v64 (Assign v148 v149 v150) => Seq v64 (Assign v148 v149 v150) | Seq v64 (Primitive v151 v152 v153) => Seq v64 (Primitive v151 v152 v153) | Seq v64 (Store v154 v155 :α prog) => Seq v64 (Store v154 v155 :α prog) | Seq v64 (Store32 v156 v157 :α prog) => Seq v64 (Store32 v156 v157 :α prog) | Seq v64 (StoreByte v158 v159) => Seq v64 (StoreByte v158 v159) | Seq v64 (Seq v160 v161) => Seq v64 (Seq v160 v161) | Seq v64 (If v162 v163 v164) => Seq v64 (If v162 v163 v164) | Seq v64 (While v165 v166) => Seq v64 (While v165 v166) | Seq v64 (Break :α prog) => Seq v64 (Break :α prog) | Seq v64 (Continue :α prog) => Seq v64 (Continue :α prog) | Seq v64 (Call v167 v168 v169 :α prog) => Seq v64 (Call v167 v168 v169 :α prog) | Seq v64 (DecCall v170 v171 v172 v173 v174) => Seq v64 (DecCall v170 v171 v172 v173 v174) | Seq v64 (ExtCall v175 v176 v177 v178 v179) => Seq v64 (ExtCall v175 v176 v177 v178 v179) | Seq v64 (Raise v180 v181 :α prog) => Seq v64 (Raise v180 v181 :α prog) | Seq (Skip :α prog) (Return v182) => Seq (Skip :α prog) (Return v182) | Seq (Dec v240 v241 v242 v243) (Return v182) => Seq (Dec v240 v241 v242 v243) (Return v182) | Seq (Assign v244 v245 v246) (Return v182) => Seq (Assign v244 v245 v246) (Return v182) | Seq (Primitive v247 v248 v249) (Return v182) => Seq (Primitive v247 v248 v249) (Return v182) | Seq (Store v250 v251 :α prog) (Return v182) => Seq (Store v250 v251 :α prog) (Return v182) | Seq (Store32 v252 v253 :α prog) (Return v182) => Seq (Store32 v252 v253 :α prog) (Return v182) | Seq (StoreByte v254 v255) (Return v182) => Seq (StoreByte v254 v255) (Return v182) | Seq (Seq v256 v257) (Return v182) => Seq (Seq v256 v257) (Return v182) | Seq (If v258 v259 v260) (Return v182) => Seq (If v258 v259 v260) (Return v182) | Seq (While v261 v262) (Return v182) => Seq (While v261 v262) (Return v182) | Seq (Break :α prog) (Return v182) => Seq (Break :α prog) (Return v182) | Seq (Continue :α prog) (Return v182) => Seq (Continue :α prog) (Return v182) | Seq (Call v263 trgt args :α prog) (Return (Const v312 :α exp)) => Seq (Call v263 trgt args :α prog) (Return (Const v312 :α exp)) | Seq (TailCall trgt args) (Return (Var v313 rv2 :α exp)) => Seq (TailCall trgt args) (Return (Var v313 rv2 :α exp)) | Seq (StandAloneCall (NONE :(mlstring # mlstring # α prog) option) trgt args) (Return (Var Local rv2 :α exp)) => Seq (StandAloneCall (NONE :(mlstring # mlstring # α prog) option) trgt args) (Return (Var Local rv2 :α exp)) | Seq (AssignCall (Local,rv1) (NONE :(mlstring # mlstring # α prog) option) trgt args) (Return (Var Local rv2 :α exp)) => if rv1 = rv2 then TailCall trgt args else prog | Seq (AssignCall (Global,rv1) (NONE :(mlstring # mlstring # α prog) option) trgt args) (Return (Var Local rv2 :α exp)) => Seq (AssignCall (Global,rv1) (NONE :(mlstring # mlstring # α prog) option) trgt args) (Return (Var Local rv2 :α exp)) | Seq (Call (SOME (v340,SOME v343)) trgt args :α prog) (Return (Var Local rv2 :α exp)) => Seq (Call (SOME (v340,SOME v343)) trgt args :α prog) (Return (Var Local rv2 :α exp)) | Seq (Call (SOME v337) trgt args :α prog) (Return (Var Global rv2 :α exp)) => Seq (Call (SOME v337) trgt args :α prog) (Return (Var Global rv2 :α exp)) | Seq (Call v263 trgt args :α prog) (Return (RStruct v315)) => Seq (Call v263 trgt args :α prog) (Return (RStruct v315)) | Seq (Call v263 trgt args :α prog) (Return (RField v316 v317)) => Seq (Call v263 trgt args :α prog) (Return (RField v316 v317)) | Seq (Call v263 trgt args :α prog) (Return (NStruct v318 v319)) => Seq (Call v263 trgt args :α prog) (Return (NStruct v318 v319)) | Seq (Call v263 trgt args :α prog) (Return (NField v320 v321)) => Seq (Call v263 trgt args :α prog) (Return (NField v320 v321)) | Seq (Call v263 trgt args :α prog) (Return (Load v322 v323 :α exp)) => Seq (Call v263 trgt args :α prog) (Return (Load v322 v323 :α exp)) | Seq (Call v263 trgt args :α prog) (Return (Load32 v324 :α exp)) => Seq (Call v263 trgt args :α prog) (Return (Load32 v324 :α exp)) | Seq (Call v263 trgt args :α prog) (Return (LoadByte v325)) => Seq (Call v263 trgt args :α prog) (Return (LoadByte v325)) | Seq (Call v263 trgt args :α prog) (Return (Op v326 v327)) => Seq (Call v263 trgt args :α prog) (Return (Op v326 v327)) | Seq (Call v263 trgt args :α prog) (Return (Panop v328 v329)) => Seq (Call v263 trgt args :α prog) (Return (Panop v328 v329)) | Seq (Call v263 trgt args :α prog) (Return (Cmp v330 v331 v332)) => Seq (Call v263 trgt args :α prog) (Return (Cmp v330 v331 v332)) | Seq (Call v263 trgt args :α prog) (Return (Shift v333 v334 v335 :α exp)) => Seq (Call v263 trgt args :α prog) (Return (Shift v333 v334 v335 :α exp)) | Seq (Call v263 trgt args :α prog) (Return (BaseAddr :α exp)) => Seq (Call v263 trgt args :α prog) (Return (BaseAddr :α exp)) | Seq (Call v263 trgt args :α prog) (Return (TopAddr :α exp)) => Seq (Call v263 trgt args :α prog) (Return (TopAddr :α exp)) | Seq (Call v263 trgt args :α prog) (Return (BytesInWord :α exp)) => Seq (Call v263 trgt args :α prog) (Return (BytesInWord :α exp)) | Seq (DecCall v266 v267 v268 v269 v270) (Return v182) => Seq (DecCall v266 v267 v268 v269 v270) (Return v182) | Seq (ExtCall v271 v272 v273 v274 v275) (Return v182) => Seq (ExtCall v271 v272 v273 v274 v275) (Return v182) | Seq (Raise v276 v277 :α prog) (Return v182) => Seq (Raise v276 v277 :α prog) (Return v182) | Seq (Return v278) (Return v182) => Seq (Return v278) (Return v182) | Seq (ShMemLoad v279 v280 v281 v282) (Return v182) => Seq (ShMemLoad v279 v280 v28