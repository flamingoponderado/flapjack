thunk_type=:thunk_mode -> v -> dest_thunk_ret
thunk_dest=(dest_thunk [(Loc (b :bool) (n :num) :v)] (st :v store_v list) :dest_thunk_ret) = (case store_lookup n st of (NONE :v store_v option) => BadRef | SOME (Refv v7) => NotThunk | SOME (W8array v8 :v store_v) => NotThunk | SOME (Varray v9) => NotThunk | SOME (Thunk Evaluated v) => if b then BadRef else (IsThunk Evaluated v :dest_thunk_ret) | SOME (Thunk NotEvaluated v) => if b then BadRef else (IsThunk NotEvaluated v :dest_thunk_ret)) ∧ (dest_thunk ([] :v list) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Litv (v12 :lit) :v)::(v5 :v list)) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Conv (v13 :(num # num option) option) (v14 :v list)::v5) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Closure (v15 :v environment) (v16 :mlstring) (v17 :exp) :v)::v5) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Recclosure (v18 :v environment) (v19 :(mlstring # mlstring # exp) list) (v20 :mlstring) :v)::v5) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Loc (v21 :bool) (v22 :num) :v)::(v36 :v)::(v37 :v list)) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Vectorv (v23 :v list)::v5) st :dest_thunk_ret) = NotThunk
thunk_update=update_thunk [(Loc F (n :num) :v)] (st :v store_v list) [(v :v)] = (case (dest_thunk [v] st :dest_thunk_ret) of BadRef => (NONE :v store_v list option) | NotThunk => store_assign n (Thunk Evaluated v) st | (IsThunk v3 v4 :dest_thunk_ret) => (NONE :v store_v list option)) ∧ update_thunk ([] :v list) st (v1 :v list) = (NONE :v store_v list option) ∧ update_thunk ((Litv (v12 :lit) :v)::(v7 :v list)) st v1 = (NONE :v store_v list option) ∧ update_thunk (Conv (v13 :(num # num option) option) (v14 :v list)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk ((Closure (v15 :v environment) (v16 :mlstring) (v17 :exp) :v)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk ((Recclosure (v18 :v environment) (v19 :(mlstring # mlstring # exp) list) (v20 :mlstring) :v)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk ((Loc T (v22 :num) :v)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk [(Loc F v22 :v)] st ([] :v list) = (NONE :v store_v list option) ∧ update_thunk [(Loc F v22 :v)] st ((v52 :v)::(v56 :v)::(v57 :v list)) = (NONE :v store_v list option) ∧ update_thunk ((Loc F v22 :v)::(v46 :v)::(v47 :v list)) st v1 = (NONE :v store_v list option) ∧ update_thunk (Vectorv (v23 :v list)::v7) st v1 = (NONE :v store_v list option)
thunk_bad=∀(m :thunk_mode) (v :v) (refs :v store_v list). bad_thunk_update m v refs ⇔ m = Evaluated ∧ (dest_thunk [v] refs :dest_thunk_ret) ≠ NotThunk
valid_thunk=IsThunk NotEvaluated (Litv (IntLit 7))
ref_flag=BadRef
bad_index=BadRef
ordinary_ref=NotThunk
nonlocation=NotThunk
update_value=SOME [Thunk Evaluated (Litv (IntLit 9))]
update_nested=NONE
