getOpClass_def_typed=∀(op :op). getOpClass op = case op of Arith v11 v12 => Simple | FromTo v13 v14 => Simple | Shift v15 v16 v17 => Simple | Equality => Simple | Test v18 v19 => Simple | Opapp => FunApp | Opassign => Simple | Opref => Simple | Opderef => Simple | Aw8alloc => Simple | Aw8sub => Simple | Aw8length => Simple | Aw8update => Simple | CopyStrStr => Simple | CopyStrAw8 => Simple | CopyAw8Str => Simple | CopyAw8Aw8 => Simple | XorAw8Str_unsafe => Simple | Implode => Simple | Explode => Simple | Strsub => Simple | Strlen => Simple | Strcat => Simple | VfromList => Simple | Vsub => Simple | Vlength => Simple | Aalloc => Simple | AallocEmpty => Simple | AallocFixed => Simple | Asub => Simple | Alength => Simple | Aupdate => Simple | Vsub_unsafe => Simple | Asub_unsafe => Simple | Aupdate_unsafe => Simple | Aw8sub_unsafe => Simple | Aw8update_unsafe => Simple | ThunkOp ForceThunk => Force | ThunkOp t => Simple | ListAppend => Simple | ConfigGC => Simple | FFI v21 => Simple | Eval => EvalOp | Env_id => Simple
lop_typed=Andalso::lop; Orelse::lop
ast_t_typed=Atvar::mlstring -> ast_t; Atfun::ast_t -> ast_t -> ast_t; Attup::ast_t list -> ast_t; Atapp::ast_t list -> (mlstring, mlstring) id -> ast_t
pat_typed=Pany::pat; Pvar::mlstring -> pat; Plit::lit -> pat; Pcon::(mlstring, mlstring) id option -> pat list -> pat; Pref::pat -> pat; Pas::pat -> mlstring -> pat; Ptannot::pat -> ast_t -> pat
exp_typed=Raise::exp -> exp; Handle::exp -> (pat # exp) list -> exp; Lit::lit -> exp; Con::(mlstring, mlstring) id option -> exp list -> exp; Var::(mlstring, mlstring) id -> exp; Fun::mlstring -> exp -> exp; App::op -> exp list -> exp; Log::lop -> exp -> exp -> exp; If::exp -> exp -> exp -> exp; Mat::exp -> (pat # exp) list -> exp; Let::mlstring option -> exp -> exp -> exp; Letrec::(mlstring # mlstring # exp) list -> exp -> exp; Tannot::exp -> ast_t -> exp; Lannot::exp -> locs -> exp
dec_typed=Dlet::locs -> pat -> exp -> dec; Dletrec::locs -> (mlstring # mlstring # exp) list -> dec; Dtype::locs -> (mlstring list # mlstring # (mlstring # ast_t list) list) list -> dec; Dtabbrev::locs -> mlstring list -> mlstring -> ast_t -> dec; Dexn::locs -> mlstring -> ast_t list -> dec; Dmod::mlstring -> dec list -> dec; Dlocal::dec list -> dec list -> dec; Denv::mlstring -> dec
pat_bindings_def_typed=pat_bindings Pany = ([] :mlstring list) ∧ (∀(n :mlstring). pat_bindings (Pvar n) = [n]) ∧ (∀(l :lit). pat_bindings (Plit l) = ([] :mlstring list)) ∧ (∀(v0 :(mlstring, mlstring) id option) (ps :pat list). pat_bindings (Pcon v0 ps) = pats_bindings ps) ∧ (∀(p :pat). pat_bindings (Pref p) = pat_bindings p) ∧ (∀(p :pat) (i :mlstring). pat_bindings (Pas p i) = pat_bindings p ++ [i]) ∧ (∀(p :pat) (v1 :ast_t). pat_bindings (Ptannot p v1) = pat_bindings p) ∧ pats_bindings ([] :pat list) = ([] :mlstring list) ∧ ∀(p :pat) (ps :pat list). pats_bindings (p::ps) = pats_bindings ps ++ pat_bindings p
every_exp_def_typed=(∀(p :exp -> bool) (e :exp). every_exp p (Raise e) ⇔ p (Raise e) ∧ every_exp p e) ∧ (∀(pes :(pat # exp) list) (p :exp -> bool) (e :exp). every_exp p (Handle e pes) ⇔ p (Handle e pes) ∧ every_exp p e ∧ EVERY (λ((pat :pat),(e' :exp)). every_exp p e') pes) ∧ (∀(p :exp -> bool) (l :lit). every_exp p (Lit l) ⇔ p (Lit l)) ∧ (∀(p :exp -> bool) (es :exp list) (cn :(mlstring, mlstring) id option). every_exp p (Con cn es) ⇔ p (Con cn es) ∧ EVERY (λ(a :exp). every_exp p a) es) ∧ (∀(v :(mlstring, mlstring) id) (p :exp -> bool). every_exp p (Var v) ⇔ p (Var v)) ∧ (∀(x :mlstring) (p :exp -> bool) (e :exp). every_exp p (Fun x e) ⇔ p (Fun x e) ∧ every_exp p e) ∧ (∀(p :exp -> bool) (op :op) (es :exp list). every_exp p (App op es) ⇔ p (App op es) ∧ EVERY (λ(a :exp). every_exp p a) es) ∧ (∀(p :exp -> bool) (lop :lop) (e2 :exp) (e1 :exp). every_exp p (Log lop e1 e2) ⇔ p (Log lop e1 e2) ∧ every_exp p e1 ∧ every_exp p e2) ∧ (∀(p :exp -> bool) (e3 :exp) (e2 :exp) (e1 :exp). every_exp p (If e1 e2 e3) ⇔ p (If e1 e2 e3) ∧ every_exp p e1 ∧ every_exp p e2 ∧ every_exp p e3) ∧ (∀(pes :(pat # exp) list) (p :exp -> bool) (e :exp). every_exp p (Mat e pes) ⇔ p (Mat e pes) ∧ every_exp p e ∧ EVERY (λ((pat :pat),(e' :exp)). every_exp p e') pes) ∧ (∀(x :mlstring option) (p :exp -> bool) (e2 :exp) (e1 :exp). every_exp p (Let x e1 e2) ⇔ p (Let x e1 e2) ∧ every_exp p e1 ∧ every_exp p e2) ∧ (∀(p :exp -> bool) (e :exp) (a :ast_t). every_exp p (Tannot e a) ⇔ p (Tannot e a) ∧ every_exp p e) ∧ (∀(p :exp -> bool) (e :exp) (a :locs). every_exp p (Lannot e a) ⇔ p (Lannot e a) ∧ every_exp p e) ∧ ∀(p :exp -> bool) (funs :(mlstring # mlstring # exp) list) (e :exp). every_exp p (Letrec funs e) ⇔ p (Letrec funs e) ∧ every_exp p e ∧ EVERY (λ((n :mlstring),(v :mlstring),(e' :exp)). every_exp p e') funs
