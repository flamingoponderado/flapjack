do_lim_safe=∀(s :(γ, 'ffi) state) (op :closLang$op) (vs :v list). do_lim_safe s op vs = s with safe_for_space := (lim_safe s.limits op vs ∧ s.safe_for_space)
ref_array_inside=lim_safe ((l :limits) with <|arch_64_bit := T; length_limit := (3 :num)|>) (MemOp RefArray) [(Number (7 :int) :v); (Number (0 :int) :v)] ⇔ T
ref_array_boundary=lim_safe ((l :limits) with <|arch_64_bit := T; length_limit := (3 :num)|>) (MemOp RefArray) [(Number (8 :int) :v); (Number (0 :int) :v)] ⇔ F
ref_array_negative=lim_safe ((l :limits) with <|arch_64_bit := T; length_limit := (3 :num)|>) (MemOp RefArray) [(Number (-(1 :int)) :v); (Number (0 :int) :v)] ⇔ F
ref_array_malformed=lim_safe ((l :limits) with <|arch_64_bit := T; length_limit := (3 :num)|>) (MemOp RefArray) [(Number (-(1 :int)) :v)] ⇔ T
nullary_tag_boundary=lim_safe ((l :limits) with <|arch_64_bit := T; length_limit := (3 :num)|>) (BlockOp (Cons ((2 :num) ** (60 :num)) :block_op)) ([] :v list) ⇔ F
