  TRY(Cases_on`f`)>>
  fs[reg_bound_inst_def]>>
  rpt(TOP_CASE_TAC>>fs[]));
val _ = (if null(hyp mono) then () else raise Fail "open premise"; print "rbm_full="; print_thm mono; print "\n");
