max_depth_Call_SOME_typed=evaluate ((Call (SOME ((n1 :num list),(n2 :sptree$num_set # sptree$num_set),(Skip :α prog),(n3 :num),(n4 :num))) (SOME (dest :num)) (args :num list) (NONE :(num # α prog # num # num) option) :α prog),(s :(α, β, γ) state)) = ((res :α result option),(s1 :(α, β, γ) state)) ∧ res ≠ SOME (Error :α result) ∧ subspt (funs :(num # α prog) sptree$num_map) s.code ⇒ option_le s1.stack_max (OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ s.locals_size (OPTION_MAP2 $+ (stack_size s.stack) (max_depth s.stack_size (full_call_graph dest funs)))))
