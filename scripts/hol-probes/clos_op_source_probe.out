dest_Const_pmatch_typed=dest_Const (x :op) = PMATCH x [PMATCH_ROW (λ(i :int). IntOp (Const i)) (λ(i :int). T) (λ(i :int). SOME i); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :int option))]
dest_Constant_pmatch_typed=dest_Constant (x :op) = PMATCH x [PMATCH_ROW (λ(c :mlstring). BlockOp (Constant (ConstStr c))) (λ(c :mlstring). T) (λ(c :mlstring). SOME (Str c)); PMATCH_ROW (λ(c :int). BlockOp (Constant (ConstInt c))) (λ(c :int). T) (λ(c :int). SOME (Int c)); PMATCH_ROW (λ(c :word64). BlockOp (Constant (ConstWord64 c))) (λ(c :word64). T) (λ(c :word64). SOME (W64 c :const_part)); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :const_part option))]
dest_Cons_pmatch_typed=dest_Cons (x :op) = PMATCH x [PMATCH_ROW (λ(i :num). BlockOp (Cons i :block_op)) (λ(i :num). T) (λ(i :num). SOME i); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :num option))]
dest_ElemAt_pmatch_typed=dest_ElemAt (x :op) = PMATCH x [PMATCH_ROW (λ(i :num). BlockOp (ElemAt i)) (λ(i :num). T) (λ(i :num). SOME i); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :num option))]
dest_TagEq_pmatch_typed=dest_TagEq (x :op) = PMATCH x [PMATCH_ROW (λ(i :num). BlockOp (TagEq i)) (λ(i :num). T) (λ(i :num). SOME i); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :num option))]
dest_LenEq_pmatch_typed=dest_LenEq (x :op) = PMATCH x [PMATCH_ROW (λ(i :num). BlockOp (LenEq i)) (λ(i :num). T) (λ(i :num). SOME i); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :num option))]
dest_TagLenEq_pmatch_typed=dest_TagLenEq (x :op) = PMATCH x [PMATCH_ROW (λ((i :num),(j :num)). BlockOp (TagLenEq i j)) (λ((i :num),(j :num)). T) (λ((i :num),(j :num)). SOME (i,j)); PMATCH_ROW (λ(_0 :op). _0) (λ(_0 :op). T) (λ(_0 :op). (NONE :(num # num) option))]
dest_Op_pmatch_typed=dest_Op (f :op -> α option) (x :exp) = PMATCH x [PMATCH_ROW (λ((t :tra),(op :op),(xs :exp list)). Op t op xs) (λ((t :tra),(op :op),(xs :exp list)). T) (λ((t :tra),(op :op),(xs :exp list)). case f op of (NONE :α option) => (NONE :(α # exp list) option) | SOME i => SOME (i,xs)); PMATCH_ROW (λ(_0 :exp). _0) (λ(_0 :exp). T) (λ(_0 :exp). (NONE :(α # exp list) option))]
is_Var_pmatch_typed=is_Var (x :exp) ⇔ PMATCH x [PMATCH_ROW (λ((_0 :tra),(_1 :num)). (Var _0 _1 :exp)) (λ((_0 :tra),(_1 :num)). T) (λ((_0 :tra),(_1 :num)). T); PMATCH_ROW (λ(_0 :exp). _0) (λ(_0 :exp). T) (λ(_0 :exp). F)]
