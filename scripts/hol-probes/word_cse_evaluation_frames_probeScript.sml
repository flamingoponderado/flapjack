load "preamble"; load "word_cseProofTheory";
open HolKernel Parse bossLib preamble word_cseProofTheory word_cseTheory wordSemTheory;
val _ = Globals.linewidth := 2000;
val replay_write = prove(``∀a r u w s.
    can_mem_arith a ∧ ¬MEM r (arithReads a) ⇒
    (evaluate (Inst (Arith a), set_var r u s) =
       (NONE, set_var (firstRegOfArith a) w (set_var r u s)) ⇔
     evaluate (Inst (Arith a), s) = (NONE, set_var (firstRegOfArith a) w s))``, rpt strip_tac
  \\ Cases_on ‘a’
  \\ gvs [can_mem_arith_def, arithReads_def, firstRegOfArith_def]
  >- (Cases_on ‘r'’ \\ gvs [can_mem_arith_def, arithReads_def]
      >- (gvs [evaluate_def, inst_def, assign_def, word_exp_def, the_words_def,
               get_var_def, set_var_def, lookup_insert]
          \\ Cases_on ‘lookup n0 s.locals’ \\ gvs []
          \\ Cases_on ‘x’ \\ gvs []
          \\ Cases_on ‘lookup n' s.locals’ \\ gvs []
          \\ Cases_on ‘x’ \\ gvs []
          \\ Cases_on ‘word_op b [c; c']’ \\ gvs [state_component_equality, insert_eq])
      \\ gvs [evaluate_def, inst_def, assign_def, word_exp_def, the_words_def,
              get_var_def, set_var_def, lookup_insert]
      \\ Cases_on ‘lookup n0 s.locals’ \\ gvs []
      \\ Cases_on ‘x’ \\ gvs []
      \\ Cases_on ‘word_op b [c'; c]’ \\ gvs [state_component_equality, insert_eq])
  >- (Cases_on ‘r'’ \\ gvs [can_mem_arith_def, arithReads_def]
      \\ gvs [evaluate_def, inst_def, assign_def, word_exp_def, the_words_def,
              get_var_def, set_var_def, lookup_insert]
      \\ Cases_on ‘lookup n0 s.locals’ \\ gvs []
      \\ Cases_on ‘x’ \\ gvs []
      \\ Cases_on ‘word_sh s' c' (w2n c)’ \\ gvs [state_component_equality, insert_eq])
  >- (gvs [evaluate_def, inst_def, assign_def, get_vars_def, get_var_def,
           set_var_def, lookup_insert]
      \\ Cases_on ‘lookup n1 s.locals’ \\ gvs []
      \\ Cases_on ‘x’ \\ gvs []
      \\ Cases_on ‘lookup n0 s.locals’ \\ gvs []
      \\ Cases_on ‘x’ \\ gvs [state_component_equality, insert_eq]
      \\ Cases_on ‘c = 0w’ \\ gvs [state_component_equality, insert_eq]));
val _ = (if null(hyp replay_write) then () else raise Fail "open replay premise"; print "fr_full_write="; print_thm replay_write; print "\n");
val replay_memory = prove(``∀a w s m.
    can_mem_arith a ⇒
    (evaluate (Inst (Arith a), s with memory := m) =
       (NONE, set_var (firstRegOfArith a) w s with memory := m) ⇔
     evaluate (Inst (Arith a), s) = (NONE, set_var (firstRegOfArith a) w s))``, rpt strip_tac \\ Cases_on ‘a’
  \\ gvs [can_mem_arith_def, firstRegOfArith_def, evaluate_def, inst_def,
          assign_def, word_exp_def, the_words_def, get_vars_def, get_var_def,
          set_var_def, AllCaseEqs()]
  \\ gvs [state_component_equality, insert_eq]
  \\ Cases_on ‘r’ \\ gvs [can_mem_arith_def, word_exp_def, get_var_def]);
val _ = (if null(hyp replay_memory) then () else raise Fail "open replay premise"; print "fr_full_memory="; print_thm replay_memory; print "\n");
val replay_arith_agree = prove(``∀a w (s1:('a,'c,'ffi) wordSem$state) (s2:('a,'c,'ffi) wordSem$state).
    evaluate (Inst (Arith a), s1) =
      (NONE, set_var (firstRegOfArith a) w s1) ∧
    can_mem_arith a ∧ s2.locals = s1.locals ⇒
    evaluate (Inst (Arith a), s2) = (NONE, set_var (firstRegOfArith a) w s2)``, rpt strip_tac \\ Cases_on ‘a’
  \\ gvs [can_mem_arith_def, firstRegOfArith_def, evaluate_def, inst_def,
          assign_def, word_exp_def, the_words_def, get_vars_def, get_var_def,
          set_var_def, AllCaseEqs(), insert_eq]
  \\ gvs [state_component_equality, insert_eq]
  \\ Cases_on ‘r’ \\ gvs [can_mem_arith_def, word_exp_def, get_var_def]
  \\ gvs [AllCaseEqs(), state_component_equality, insert_eq]);
val _ = (if null(hyp replay_arith_agree) then () else raise Fail "open replay premise"; print "fr_full_arith_agree="; print_thm replay_arith_agree; print "\n");
val replay_load_agree = prove(``∀op r a ofs w (s1:('a,'c,'ffi) wordSem$state) (s2:('a,'c,'ffi) wordSem$state).
    evaluate (Inst (Mem op r (Addr a ofs)), s1) = (NONE, set_var r w s1) ∧
    ¬is_store op ∧ s2.locals = s1.locals ∧ s2.memory = s1.memory ∧
    s2.mdomain = s1.mdomain ∧ s2.be = s1.be ⇒
    evaluate (Inst (Mem op r (Addr a ofs)), s2) = (NONE, set_var r w s2)``, rpt strip_tac \\ Cases_on ‘op’
  \\ gvs [is_store_def, evaluate_def, inst_def, word_exp_def, the_words_def,
          get_var_def, set_var_def, mem_load_def, AllCaseEqs(), insert_eq]
  \\ gvs [state_component_equality, insert_eq]);
val _ = (if null(hyp replay_load_agree) then () else raise Fail "open replay premise"; print "fr_full_load_agree="; print_thm replay_load_agree; print "\n");
fun typ label q = (print(label ^ "="); print_type(type_of q); print "\n");
val _ = typ "fr_type_arith" ``(a:'a arith)``;
val _ = typ "fr_type_state" ``(s:('a,'c,'ffi)wordSem$state)``;
val _ = typ "fr_type_value" ``(w:'a word_loc)``;
val _ = typ "fr_type_memory" ``(m:'a word -> 'a word_loc)``;
fun proved label q tac = let val th = prove(q,tac) in if null(hyp th) then () else raise Fail "open application premise"; print(label ^ "="); print_thm th; print "\n" end;
val _ = proved "fr_write_0_99_1" ``! (u:1 word_loc) (w:1 word_loc) (s:(1,'c,'ffi)wordSem$state). (evaluate (Inst (Arith (Binop Add 99 3 (Reg 5):1 arith)),set_var (firstRegOfArith (Binop Add 99 3 (Reg 5):1 arith)) u s) = (NONE,set_var (firstRegOfArith (Binop Add 99 3 (Reg 5):1 arith)) w (set_var (firstRegOfArith (Binop Add 99 3 (Reg 5):1 arith)) u s))) <=> evaluate (Inst (Arith (Binop Add 99 3 (Reg 5):1 arith)),s) = (NONE,set_var (firstRegOfArith (Binop Add 99 3 (Reg 5):1 arith)) w s)`` (rpt gen_tac >> match_mp_tac replay_write >> EVAL_TAC);
