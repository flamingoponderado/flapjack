sec_pos_val_0=∀(pos :num) (lines :α line list).
  ¬EVERY (is_Label :α line -> bool) lines ∧
  EVERY (label_zero :α line -> bool) lines ⇒
  sec_pos_val (0 :num) pos lines = SOME pos
sec_pos_val_0_types=(pos :num)::num;(lines :α line list)::α line list;
sec_pos_val_0_hypotheses=0
