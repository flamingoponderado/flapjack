fstep_def_typed=∀(st :(α option # α option) list # (α option # α option) list # (α option # α option) list). fstep st = case st of (([] :(α option # α option) list),([] :(α option # α option) list),l) => st | ((d,s)::t,([] :(α option # α option) list),l) => if s = d then (t,([] :(α option # α option) list),l) else (t,[(d,s)],l) | (t',(d',s')::b,l) => splitAtPki (λ(i :num) (p :α option # α option). SND p = d') (λ(t1 :(α option # α option) list) (rt2 :(α option # α option) list). case rt2 of ([] :(α option # α option) list) => if NULL b then (t',([] :(α option # α option) list),(d',s')::l) else (let ((b' :(α option # α option) list),(d'' :α option),(s'' :α option)) = (FRONT b,LAST b) in if s'' = d' then (t',SNOC (d'',(NONE :α option)) b',(d',s')::((NONE :α option),d')::l) else (t',b,(d',s')::l)) | rd::t2 => (t1 ++ t2,rd::(d',s')::b,l)) t'
parmove_def_typed=∀(xs :(α # α) list). parmove xs = REVERSE (SND (SND (pmov (MAP (λ((x :α),(y :α)). (SOME x,SOME y)) xs,([] :(α option # α option) list),([] :(α option # α option) list)))))
pmov_def_typed=∀(s :(α option # α option) list # (α option # α option) list # (α option # α option) list). pmov s = case s of (([] :(α option # α option) list),([] :(α option # α option) list),v11) => s | (([] :(α option # α option) list),v14::v15,v11) => pmov (fstep s) | (v6::v7,v3) => pmov (fstep s)
ALL_DISTINCT_parmove_typed=ALL_DISTINCT (MAP (FST :α # α -> α) (mvs :(α # α) list)) ⇒ ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (parmove mvs)))
ALL_DISTINCT_pmov_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list). ⊢ p ∧ ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (FST p ++ FST (SND p) ++ SND (SND p)))) ⇒ ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (FST (pmov p) ++ FST (SND (pmov p)) ++ SND (SND (pmov p)))))
ALL_DISTINCT_step_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷ s2 ⇒ ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (FST s1 ++ FST (SND s1) ++ SND (SND s1)))) ⇒ ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (FST s2 ++ FST (SND s2) ++ SND (SND s2))))
ALL_DISTINCT_steps_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). (λ(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (FST s1 ++ FST (SND s1) ++ SND (SND s1))))) s1 ∧ s1 ▷* s2 ⇒ (λ(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ALL_DISTINCT (FILTER (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) (FST s1 ++ FST (SND s1) ++ SND (SND s1))))) s2
parmove_correct_typed=windmill (xs :(α # α) list) ⇒ ∀(ρ :α option -> β). seqsem (parmove xs) ρ ≡ parsem (MAP (λ((x :α),(y :α)). (SOME x,SOME y)) xs) ρ
dstep_cases_typed=∀(a0 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (a1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). a0 ↪ a1 ⇔ (∃(r :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). a0 = ([(r,r)] ++ μ,([] :(α option # α option) list),τ) ∧ a1 = (μ,([] :(α option # α option) list),τ)) ∨ (∃(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). a0 = ([(d,s)] ++ μ,([] :(α option # α option) list),τ) ∧ a1 = (μ,[(d,s)],τ) ∧ s ≠ d) ∨ (∃(d :α option) (r :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ1 ++ [(r,d)] ++ μ2,[(d,s)] ++ σ,τ) ∧ a1 = (μ1 ++ μ2,[(r,d); (d,s)] ++ σ,τ) ∧ ¬MEM d (MAP (SND :α option # α option -> α option) μ1)) ∨ (∃(d :α option) (r :α option) (s :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ,[(r,s)] ++ σ ++ [(d,r)],τ) ∧ a1 = (μ,σ ++ [(d,(NONE :α option))],[(r,s); ((NONE :α option),r)] ++ τ) ∧ ¬MEM r (MAP (SND :α option # α option -> α option) μ)) ∨ (∃(d0 :α option) (dn :α option) (s0 :α option) (sn :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ,[(dn,sn)] ++ σ ++ [(d0,s0)],τ) ∧ a1 = (μ,σ ++ [(d0,s0)],[(dn,sn)] ++ τ) ∧ ¬MEM dn (MAP (SND :α option # α option -> α option) μ) ∧ dn ≠ s0) ∨ ∃(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ,[(d,s)],τ) ∧ a1 = (μ,([] :(α option # α option) list),[(d,s)] ++ τ) ∧ ¬MEM d (MAP (SND :α option # α option -> α option) μ)
dstep_ind_typed=∀(dstep' :(α option # α option) list # (α option # α option) list # (α option # α option) list -> (α option # α option) list # (α option # α option) list # (α option # α option) list -> bool). (∀(r :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). dstep' ([(r,r)] ++ μ,([] :(α option # α option) list),τ) (μ,([] :(α option # α option) list),τ)) ∧ (∀(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). s ≠ d ⇒ dstep' ([(d,s)] ++ μ,([] :(α option # α option) list),τ) (μ,[(d,s)],τ)) ∧ (∀(d :α option) (r :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM d (MAP (SND :α option # α option -> α option) μ1) ⇒ dstep' (μ1 ++ [(r,d)] ++ μ2,[(d,s)] ++ σ,τ) (μ1 ++ μ2,[(r,d); (d,s)] ++ σ,τ)) ∧ (∀(d :α option) (r :α option) (s :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM r (MAP (SND :α option # α option -> α option) μ) ⇒ dstep' (μ,[(r,s)] ++ σ ++ [(d,r)],τ) (μ,σ ++ [(d,(NONE :α option))],[(r,s); ((NONE :α option),r)] ++ τ)) ∧ (∀(d0 :α option) (dn :α option) (s0 :α option) (sn :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM dn (MAP (SND :α option # α option -> α option) μ) ∧ dn ≠ s0 ⇒ dstep' (μ,[(dn,sn)] ++ σ ++ [(d0,s0)],τ) (μ,σ ++ [(d0,s0)],[(dn,sn)] ++ τ)) ∧ (∀(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM d (MAP (SND :α option # α option -> α option) μ) ⇒ dstep' (μ,[(d,s)],τ) (μ,([] :(α option # α option) list),[(d,s)] ++ τ)) ⇒ ∀(a0 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (a1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). a0 ↪ a1 ⇒ dstep' a0 a1
dstep_rules_typed=(∀(r :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). ([(r,r)] ++ μ,([] :(α option # α option) list),τ) ↪ (μ,([] :(α option # α option) list),τ)) ∧ (∀(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). s ≠ d ⇒ ([(d,s)] ++ μ,([] :(α option # α option) list),τ) ↪ (μ,[(d,s)],τ)) ∧ (∀(d :α option) (r :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM d (MAP (SND :α option # α option -> α option) μ1) ⇒ (μ1 ++ [(r,d)] ++ μ2,[(d,s)] ++ σ,τ) ↪ (μ1 ++ μ2,[(r,d); (d,s)] ++ σ,τ)) ∧ (∀(d :α option) (r :α option) (s :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM r (MAP (SND :α option # α option -> α option) μ) ⇒ (μ,[(r,s)] ++ σ ++ [(d,r)],τ) ↪ (μ,σ ++ [(d,(NONE :α option))],[(r,s); ((NONE :α option),r)] ++ τ)) ∧ (∀(d0 :α option) (dn :α option) (s0 :α option) (sn :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM dn (MAP (SND :α option # α option -> α option) μ) ∧ dn ≠ s0 ⇒ (μ,[(dn,sn)] ++ σ ++ [(d0,s0)],τ) ↪ (μ,σ ++ [(d0,s0)],[(dn,sn)] ++ τ)) ∧ ∀(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM d (MAP (SND :α option # α option -> α option) μ) ⇒ (μ,[(d,s)],τ) ↪ (μ,([] :(α option # α option) list),[(d,s)] ++ τ)
dsteps_steps_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ↪* s2 ⇒ ⊢ s1 ⇒ s1 ▷* s2
MEM_MAP_FST_SND_SND_pmov_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list) (x :α). MEM (SOME x) (MAP (FST :α option # α option -> α option) (SND (SND (pmov p)))) ⇒ MEM (SOME x) (MAP (FST :α option # α option -> α option) (FST p ++ FST (SND p) ++ SND (SND p)))
MEM_MAP_FST_parmove_typed=MEM (SOME (x :α)) (MAP (FST :α option # α option -> α option) (parmove (mvs :(α # α) list))) ⇒ MEM x (MAP (FST :α # α -> α) mvs)
parsem_change_env_typed=(¬MEM (x :α) (MAP (FST :α # α -> α) (μ :(α # α) list)) ⇒ (ρ1 :α -> β) x = (ρ2 :α -> β) x) ∧ MAP (ρ1 ∘ (SND :α # α -> α)) μ = MAP (ρ2 ∘ (SND :α # α -> α)) μ ⇒ parsem μ ρ1 x = parsem μ ρ2 x
fstep_dstep_typed=(∀(τ :(α option # α option) list). (s :(α option # α option) list # (α option # α option) list # (α option # α option) list) ≠ (([] :(α option # α option) list),([] :(α option # α option) list),τ)) ⇒ s ↪ fstep s
fstep_MAP_INJ_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list). inj_on_state (f :α option -> β option) p ⇒ fstep (map_state f p) = map_state f (fstep p)
independence_typed=∀(μ1 :(α # α) list) (s :α) (d :α) (μ2 :(α # α) list) (μ :(α # α) list). windmill μ ∧ μ = μ1 ++ [(d,s)] ++ μ2 ⇒ (parsem μ :(α -> β) -> α -> β) = (parsem ([(d,s)] ++ μ1 ++ μ2) :(α -> β) -> α -> β)
parsem_nil_typed=(parsem ([] :(α # α) list) :(α -> β) -> α -> β) = (I :(α -> β) -> α -> β)
inj_on_state_def_typed=∀(f :α option -> β option) (p :(α option # α option) list # (α option # α option) list # (α option # α option) list). inj_on_state f p ⇔ (let (ls0 :(α option # α option) list) = state_to_list p; (ls :α option list) = MAP (FST :α option # α option -> α option) ls0 ++ MAP (SND :α option # α option -> α option) ls0 in (∀(x :α option) (y :α option). MEM x ls ∧ MEM y ls ∧ f x = f y ⇒ x = y) ∧ ∀(x :α option). f x = (NONE :β option) ⇔ x = (NONE :α option))
step_inj_on_state_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷ s2 ⇒ inj_on_state (f :α option -> β option) s1 ⇒ inj_on_state f s2
path_def_typed=(path ([] :(α # α) list) ⇔ T) ∧ (∀(v0 :α # α). path [v0] ⇔ T) ∧ ∀(p :(α # α) list) (c :α) (b' :α) (b :α) (a :α). path ((c,b')::(b,a)::p) ⇔ b = b' ∧ path ((b,a)::p)
path_tail_typed=∀(t :(α # α) list) (h :α # α). path (h::t) ⇒ path t
wf_def_typed=∀(μ :(α option # α option) list) (σ :(α option # α option) list) (τ :β). ⊢ (μ,σ,τ) ⇔ windmill (μ ++ σ) ∧ EVERY (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) μ) ∧ EVERY (IS_SOME :α option -> bool) (MAP (SND :α option # α option -> α option) μ) ∧ (¬NULL σ ⇒ EVERY (IS_SOME :α option -> bool) (MAP (SND :α option # α option -> α option) (FRONT σ))) ∧ EVERY (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) σ) ∧ path σ
wf_init_typed=windmill (μ :(α option # α option) list) ∧ EVERY (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) μ) ∧ EVERY (IS_SOME :α option -> bool) (MAP (SND :α option # α option -> α option) μ) ⇒ ⊢ (μ,([] :(α option # α option) list),([] :β list))
path_change_start_typed=∀(y :(α # α) list) (z :α # α) (x :α # α). path (SNOC x y) ∧ FST x = FST z ⇒ path (SNOC z y)
windmill_cons_typed=windmill ((x :α # α)::(ls :(α # α) list)) ⇔ ¬MEM (FST x) (MAP (FST :α # α -> α) ls) ∧ windmill ls
wf_step_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷ s2 ⇒ ⊢ s1 ⇒ ⊢ s2
wf_steps_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ⊢ s1 ∧ s1 ▷* s2 ⇒ ⊢ s2
parmove_MAP_INJ_typed=(let (ls1 :α list) = MAP (FST :α # α -> α) (ls :(α # α) list) ++ MAP (SND :α # α -> α) ls in ∀(x :α) (y :α). MEM x ls1 ∧ MEM y ls1 ∧ (f :α -> β) x = f y ⇒ x = y) ∧ windmill ls ⇒ parmove (MAP (f ## f) ls) = MAP (OPTION_MAP f ## OPTION_MAP f) (parmove ls)
pmov_MAP_INJ_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list). ⊢ p ∧ inj_on_state (f :α option -> β option) p ⇒ pmov (map_state f p) = map_state f (pmov p)
steps_inj_on_state_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). inj_on_state (f :α option -> β option) s1 ∧ s1 ▷* s2 ⇒ inj_on_state f s2
map_state_def_typed=∀(f :α -> β). map_state f = (let (m :(α # α) list -> (β # β) list) = MAP (f ## f) in m ## m ## m)
parsem_NoRead_typed=¬MEM (x :α) (MAP (SND :α # α -> α) (μ :(α # α) list)) ⇒ parsem ((x,(y :α))::μ) (ρ :α -> β) = parsem μ ρ⦇x ↦ ρ y⦈
parsem_MAP_INJ_typed=∀(ms :(α # α) list). windmill ms ∧ INJ (f :α -> β) (set (MAP (FST :α # α -> α) ms ++ MAP (SND :α # α -> α) ms)) 𝕌(:β) ⇒ ∀(x :α). MEM x (MAP (FST :α # α -> α) ms) ⇒ parsem (MAP (f ## f) ms) (r :β -> γ) (f x) = parsem ms (r ∘ f) x
parsem_perm_typed=windmill (l1 :(α # α) list) ∧ PERM l1 (l2 :(α # α) list) ⇒ (parsem l1 :(α -> β) -> α -> β) = (parsem l2 :(α -> β) -> α -> β)
pmov_dsteps_typed=∀(s :(α option # α option) list # (α option # α option) list # (α option # α option) list). s ↪* pmov s
pmov_final_typed=∀(s :(α option # α option) list # (α option # α option) list # (α option # α option) list). ∃(τ :(α option # α option) list). pmov s = (([] :(α option # α option) list),([] :(α option # α option) list),τ)
parmove_preserves_moves_typed=windmill (moves :(α # α) list) ∧ MEM ((x :α),(y :α)) moves ∧ x ≠ y ⇒ MEM (SOME x) (MAP (FST :α option # α option -> α option) (parmove moves))
pmov_preserves_moves_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list). ⊢ p ∧ MEM ((x :α option),(y :α option)) (state_to_list p) ∧ x ≠ y ⇒ MEM x (MAP (FST :α option # α option -> α option) (state_to_list (pmov p)))
step_preserves_moves_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷ s2 ⇒ ∀(x :α option). (∃(y :α option). MEM (x,y) (state_to_list s1) ∧ x ≠ y) ⇒ ∃(y :α option). MEM (x,y) (state_to_list s2) ∧ x ≠ y
steps_preserves_moves_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). (λ(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ∃(y :α option). MEM ((x :α option),y) (state_to_list s1) ∧ x ≠ y) s1 ∧ s1 ▷* s2 ⇒ (λ(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ∃(y :α option). MEM (x,y) (state_to_list s1) ∧ x ≠ y) s2
eqenv_def_typed=∀(ρ1 :α option -> β) (ρ2 :α option -> β). ρ1 ≡ ρ2 ⇔ ∀(r :α option). IS_SOME r ⇒ ρ1 r = ρ2 r
parsem_def_typed=∀(μ :(α # α) list) (ρ :α -> β). parsem μ ρ = ρ =++ ZIP (MAP (FST :α # α -> α) μ,MAP (ρ ∘ (SND :α # α -> α)) μ)
sem_def_typed=∀(μ :(α # α) list) (σ :(α # α) list) (τ :(α # α) list) (ρ :α -> β). sem (μ,σ,τ) ρ = parsem (μ ++ σ) (seqsem (REVERSE τ) ρ)
sem_final_typed=(sem (([] :(α # α) list),([] :(α # α) list),(τ :(α # α) list)) :(α -> β) -> α -> β) = (seqsem (REVERSE τ) :(α -> β) -> α -> β)
sem_init_typed=(sem ((μ :(α # α) list),([] :(α # α) list),([] :(α # α) list)) :(α -> β) -> α -> β) = (parsem μ :(α -> β) -> α -> β)
seqsem_def_typed=(∀(ρ :α -> β). seqsem ([] :(α # α) list) ρ = ρ) ∧ ∀(τ :(α # α) list) (ρ :α -> β) (s :α) (d :α). seqsem ((d,s)::τ) ρ = seqsem τ ρ⦇d ↦ ρ s⦈
seqsem_append_typed=∀(l1 :(α # α) list) (l2 :(α # α) list). (seqsem (l1 ++ l2) :(α -> β) -> α -> β) = (seqsem l2 :(α -> β) -> α -> β) ∘ (seqsem l1 :(α -> β) -> α -> β)
windmill_def_typed=∀(moves :(α # α) list). windmill moves ⇔ ALL_DISTINCT (MAP (FST :α # α -> α) moves)
seqsem_move_unchanged_typed=∀(ms :(α # α) list) (r :α -> β). ¬MEM (k :α) (MAP (FST :α # α -> α) ms) ⇒ seqsem ms r k = r k
MEM_MAP_SND_SND_SND_pmov_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list) (x :α). MEM (SOME x) (MAP (SND :α option # α option -> α option) (SND (SND (pmov p)))) ⇒ MEM (SOME x) (MAP (SND :α option # α option -> α option) (FST p ++ FST (SND p) ++ SND (SND p)))
MEM_MAP_SND_parmove_typed=MEM (SOME (x :α)) (MAP (SND :α option # α option -> α option) (parmove (mvs :(α # α) list))) ⇒ MEM x (MAP (SND :α # α -> α) mvs)
state_to_list_def_typed=∀(p :α list # α list # α list). state_to_list p = FST p ++ FST (SND p) ++ SND (SND p)
step_MAP_INJ_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷ s2 ⇒ inj_on_state (f :α option -> β option) s1 ⇒ map_state f s1 ▷ map_state f s2
step_cases_typed=∀(a0 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (a1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). a0 ▷ a1 ⇔ (∃(r :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ1 ++ [(r,r)] ++ μ2,σ,τ) ∧ a1 = (μ1 ++ μ2,σ,τ)) ∨ (∃(d :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ1 ++ [(d,s)] ++ μ2,([] :(α option # α option) list),τ) ∧ a1 = (μ1 ++ μ2,[(d,s)],τ)) ∨ (∃(d :α option) (r :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ1 ++ [(r,d)] ++ μ2,[(d,s)] ++ σ,τ) ∧ a1 = (μ1 ++ μ2,[(r,d); (d,s)] ++ σ,τ)) ∨ (∃(d :α option) (s :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ,σ ++ [(d,s)],τ) ∧ a1 = (μ,σ ++ [(d,(NONE :α option))],[((NONE :α option),s)] ++ τ)) ∨ (∃(d0 :α option) (dn :α option) (s0 :α option) (sn :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ,[(dn,sn)] ++ σ ++ [(d0,s0)],τ) ∧ a1 = (μ,σ ++ [(d0,s0)],[(dn,sn)] ++ τ) ∧ ¬MEM dn (MAP (SND :α option # α option -> α option) μ) ∧ dn ≠ s0) ∨ ∃(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). a0 = (μ,[(d,s)],τ) ∧ a1 = (μ,([] :(α option # α option) list),[(d,s)] ++ τ) ∧ ¬MEM d (MAP (SND :α option # α option -> α option) μ)
step_ind_typed=∀(step' :(α option # α option) list # (α option # α option) list # (α option # α option) list -> (α option # α option) list # (α option # α option) list # (α option # α option) list -> bool). (∀(r :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). step' (μ1 ++ [(r,r)] ++ μ2,σ,τ) (μ1 ++ μ2,σ,τ)) ∧ (∀(d :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (τ :(α option # α option) list). step' (μ1 ++ [(d,s)] ++ μ2,([] :(α option # α option) list),τ) (μ1 ++ μ2,[(d,s)],τ)) ∧ (∀(d :α option) (r :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). step' (μ1 ++ [(r,d)] ++ μ2,[(d,s)] ++ σ,τ) (μ1 ++ μ2,[(r,d); (d,s)] ++ σ,τ)) ∧ (∀(d :α option) (s :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). step' (μ,σ ++ [(d,s)],τ) (μ,σ ++ [(d,(NONE :α option))],[((NONE :α option),s)] ++ τ)) ∧ (∀(d0 :α option) (dn :α option) (s0 :α option) (sn :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM dn (MAP (SND :α option # α option -> α option) μ) ∧ dn ≠ s0 ⇒ step' (μ,[(dn,sn)] ++ σ ++ [(d0,s0)],τ) (μ,σ ++ [(d0,s0)],[(dn,sn)] ++ τ)) ∧ (∀(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM d (MAP (SND :α option # α option -> α option) μ) ⇒ step' (μ,[(d,s)],τ) (μ,([] :(α option # α option) list),[(d,s)] ++ τ)) ⇒ ∀(a0 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (a1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). a0 ▷ a1 ⇒ step' a0 a1
step_rules_typed=(∀(r :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). (μ1 ++ [(r,r)] ++ μ2,σ,τ) ▷ (μ1 ++ μ2,σ,τ)) ∧ (∀(d :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (τ :(α option # α option) list). (μ1 ++ [(d,s)] ++ μ2,([] :(α option # α option) list),τ) ▷ (μ1 ++ μ2,[(d,s)],τ)) ∧ (∀(d :α option) (r :α option) (s :α option) (μ1 :(α option # α option) list) (μ2 :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). (μ1 ++ [(r,d)] ++ μ2,[(d,s)] ++ σ,τ) ▷ (μ1 ++ μ2,[(r,d); (d,s)] ++ σ,τ)) ∧ (∀(d :α option) (s :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). (μ,σ ++ [(d,s)],τ) ▷ (μ,σ ++ [(d,(NONE :α option))],[((NONE :α option),s)] ++ τ)) ∧ (∀(d0 :α option) (dn :α option) (s0 :α option) (sn :α option) (μ :(α option # α option) list) (σ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM dn (MAP (SND :α option # α option -> α option) μ) ∧ dn ≠ s0 ⇒ (μ,[(dn,sn)] ++ σ ++ [(d0,s0)],τ) ▷ (μ,σ ++ [(d0,s0)],[(dn,sn)] ++ τ)) ∧ ∀(d :α option) (s :α option) (μ :(α option # α option) list) (τ :(α option # α option) list). ¬MEM d (MAP (SND :α option # α option -> α option) μ) ⇒ (μ,[(d,s)],τ) ▷ (μ,([] :(α option # α option) list),[(d,s)] ++ τ)
steps_correct_typed=windmill (μ :(α option # α option) list) ∧ EVERY (IS_SOME :α option -> bool) (MAP (FST :α option # α option -> α option) μ) ∧ EVERY (IS_SOME :α option -> bool) (MAP (SND :α option # α option -> α option) μ) ∧ (μ,([] :(α option # α option) list),([] :(α option # α option) list)) ▷* (([] :(α option # α option) list),([] :(α option # α option) list),(τ :(α option # α option) list)) ⇒ ∀(ρ :α option -> β). parsem μ ρ ≡ seqsem (REVERSE τ) ρ
steps_sem_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷* s2 ∧ ⊢ s1 ⇒ ∀(ρ :α option -> β). sem s1 ρ ≡ sem s2 ρ
not_use_temp_before_assign_def_typed=(not_use_temp_before_assign ([] :(α option # β option) list) ⇔ T) ∧ (∀(ls :(α option # β option) list) (d :α option). not_use_temp_before_assign ((d,(NONE :β option))::ls) ⇔ F) ∧ (∀(v4 :β) (ls :(α option # β option) list). not_use_temp_before_assign (((NONE :α option),SOME v4)::ls) ⇔ T) ∧ ∀(v7 :α) (v5 :β) (ls :(α option # β option) list). not_use_temp_before_assign ((SOME v7,SOME v5)::ls) ⇔ not_use_temp_before_assign ls
not_use_temp_before_assign_append_typed=∀(l1 :(α option # β option) list) (l2 :(α option # β option) list). not_use_temp_before_assign (l1 ++ l2) ⇔ not_use_temp_before_assign l1 ∧ (EVERY (IS_SOME :α option -> bool) (MAP (FST :α option # β option -> α option) l1) ⇒ not_use_temp_before_assign l2)
not_use_temp_before_assign_thm_typed=∀(ls :(α option # β option) list). not_use_temp_before_assign ls ⇔ ∀(i :num). find_index (NONE :β option) (MAP (SND :α option # β option -> β option) ls) (0 :num) = SOME i ⇒ ∃(j :num). find_index (NONE :α option) (MAP (FST :α option # β option -> α option) ls) (0 :num) = SOME j ∧ j < i
not_use_temp_before_assign_insert_typed=∀(l1 :(α option # β option) list) (l2 :(α option # β option) list). not_use_temp_before_assign (l1 ++ l2) ⇒ not_use_temp_before_assign (l1 ++ [(SOME (x :α),SOME (y :β))] ++ l2)
parmove_not_use_temp_before_assign_typed=windmill (mvs :(α # α) list) ⇒ case find_index (NONE :α option) (MAP (SND :α option # α option -> α option) (parmove mvs)) (0 :num) of (NONE :num option) => T | SOME i => case find_index (NONE :α option) (MAP (FST :α option # α option -> α option) (parmove mvs)) (0 :num) of (NONE :num option) => F | SOME j => ¬(i ≤ j)
pmov_not_use_temp_before_assign_typed=∀(p :(α option # α option) list # (α option # α option) list # (α option # α option) list) (i :β). ⊢ p ∧ not_use_temp_before_assign (REVERSE (FST (SND p) ++ SND (SND p))) ⇒ not_use_temp_before_assign (REVERSE (FST (SND (pmov p)) ++ SND (SND (pmov p))))
step_not_use_temp_before_assign_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). s1 ▷ s2 ⇒ ⊢ s1 ∧ not_use_temp_before_assign (REVERSE (FST (SND s1) ++ SND (SND s1))) ⇒ not_use_temp_before_assign (REVERSE (FST (SND s2) ++ SND (SND s2)))
steps_not_use_temp_before_assign_typed=∀(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list) (s2 :(α option # α option) list # (α option # α option) list # (α option # α option) list). (λ(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ⊢ s1 ∧ not_use_temp_before_assign (REVERSE (FST (SND s1) ++ SND (SND s1)))) s1 ∧ s1 ▷* s2 ⇒ (λ(s1 :(α option # α option) list # (α option # α option) list # (α option # α option) list). ⊢ s1 ∧ not_use_temp_before_assign (REVERSE (FST (SND s1) ++ SND (SND s1)))) s2
parsem_cons_typed=¬MEM (x :α) (MAP (FST :α # α -> α) (μ :(α # α) list)) ⇒ parsem ((x,(y :α))::μ) (ρ :α -> β) = (parsem μ ρ)⦇x ↦ ρ y⦈
parsem_untouched_typed=∀(ρ :α -> β) (μ :(α # α) list) (x :α). windmill μ ∧ ¬MEM x (MAP (FST :α # α -> α) μ) ⇒ parsem μ ρ x = ρ x
