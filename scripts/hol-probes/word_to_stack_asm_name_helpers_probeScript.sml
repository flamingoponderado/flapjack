val _ = print("anh_type=" ^ type_to_string(type_of ``stack_asm_name``) ^ "\n");
fun theoremRow label th = (if null(hyp th) then () else raise Fail "open premise"; print(label ^ "="); print_thm th; print "\n");
val call_dest_stack_asm_name = prove(``  call_dest d a k = (q0,d') ⇒
  stack_asm_name c q0 ∧
  case d' of
    INR r => r ≤ (FST k)+1
  | INL l => T``,
  Cases_on`d`>>EVAL_TAC>>rw[]>>
  EVAL_TAC>>
  pairarg_tac>>fs[]>>
  pop_assum mp_tac>>PairCases_on`k`>>
  EVAL_TAC>>rw[]>>
  EVAL_TAC>>rw[]);
val _ = theoremRow "anh_call_dest_stack_asm_name" call_dest_stack_asm_name;
val wLive_stack_asm_name = prove(``  (FST kf)+1 < c.reg_count - LENGTH c.avoid_regs ∧
  wLive q bs kf = (q1,bs') ⇒
  stack_asm_name c q1``,
  PairCases_on`kf`>>
  fs[wLive_def]>>
  rw[]>-EVAL_TAC>>
  rpt(pairarg_tac>>fs[])>>
  rveq>>EVAL_TAC>>fs[]);
val _ = theoremRow "anh_wLive_stack_asm_name" wLive_stack_asm_name;
val stack_move_stack_asm_name = prove(``  ∀n start offset i p.
  stack_asm_name c (stack_move n start offset i p) ⇔ stack_asm_name c p``,
  Induct>>
  rw[stack_move_def,stack_asm_name_def]);
val _ = theoremRow "anh_stack_move_stack_asm_name" stack_move_stack_asm_name;
val _ = augment_srw_ss [rewrites [stack_move_stack_asm_name]];
val copy_ret_aux_stack_asm_name = prove(``  ∀k f n. stack_asm_name c (copy_ret_aux k f n)``,
  ho_match_mp_tac copy_ret_aux_ind>>
  rw[]>>simp[Once copy_ret_aux_def]>>rw[]>>
  simp[stack_asm_name_def,stackLangTheory.list_Seq_def]);
val _ = theoremRow "anh_copy_ret_aux_stack_asm_name" copy_ret_aux_stack_asm_name;
val _ = augment_srw_ss [rewrites [copy_ret_aux_stack_asm_name]];
val copy_ret_stack_asm_name = prove(``  stack_asm_name c (copy_ret perf b kf vs kont) ⇔ stack_asm_name c kont``,
  PairCases_on`kf`>>rw[copy_ret_def,handler_slots_def]>>simp[stack_asm_name_def,SeqStackFree_def]);
val _ = theoremRow "anh_copy_ret_stack_asm_name" copy_ret_stack_asm_name;
val _ = augment_srw_ss [rewrites [copy_ret_stack_asm_name]];
