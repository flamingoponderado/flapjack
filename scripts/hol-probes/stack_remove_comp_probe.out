comp_full_def=∀p off k jump. comp jump off k p = case p of Skip => Skip | Inst v70 => Inst v70 | Get r CurrHeap => move r (k + 2) | Get r name => Inst (Mem Load r (Addr (k + 1) (store_offset name))) | Set CurrHeap r' => move (k + 2) r' | Set name' r' => Inst (Mem Store r' (Addr (k + 1) (store_offset name'))) | OpCurrHeap op r'' n => Inst (Arith (Binop op r'' n (Reg (k + 2)))) | Call ret dest exc => Call (case ret of NONE => NONE | SOME (p1,lr,l1,l2) => SOME (comp jump off k p1,lr,l1,l2)) dest (case exc of NONE => NONE | SOME (p2,l1,l2) => SOME (comp jump off k p2,l1,l2)) | Seq p1 p2 => Seq (comp jump off k p1) (comp jump off k p2) | If c r'¹⁰' ri p1' p2' => If c r'¹⁰' ri (comp jump off k p1') (comp jump off k p2') | Loop p1'' => Loop (comp jump off k p1'') | JumpLower v89 v90 v91 => JumpLower v89 v90 v91 | Alloc v92 => Alloc v92 | StoreConsts t1 t2 v95 => list_Seq [Inst (Mem Load t2 (Addr (k + 1) (store_offset BitmapBase))); add_inst t2 1; left_shift_inst t2 (word_shift (:α)); copy_loop t1 t2; move t1 1; move t2 1] | Raise v96 => Raise v96 | Return v97 => Return v97 | Break v98 => Break v98 | Continue v99 => Continue v99 | FFI v100 v101 v102 v103 v104 v105 => FFI v100 v101 v102 v103 v104 v105 | Tick => Tick | LocValue v106 v107 v108 => LocValue v106 v107 v108 | Install v109 v110 v111 v112 v113 => Install v109 v110 v111 v112 v113 | ShMemOp v114 v115 v116 => ShMemOp v114 v115 v116 | CodeBufferWrite v117 v118 => CodeBufferWrite v117 v118 | DataBufferWrite r1 r2 => store_inst r2 r1 | RawCall v121 => RawCall v121 | StackAlloc n'' => stack_alloc jump k n'' | StackFree n' => stack_free k n' | StackStore r'³' n'³' => (let w = word_offset n'³' in if offset_ok 0 off w then Inst (Mem Store r'³' (Addr k w)) else stack_store k r'³' n'³') | StackStoreAny r'⁶' i' => Seq (add_inst k i') (Seq (store_inst r'⁶' k) (sub_inst k i')) | StackLoad r'⁴' n'⁴' => (let w = word_offset n'⁴' in if offset_ok 0 off w then Inst (Mem Load r'⁴' (Addr k w)) else Seq (move r'⁴' k) (stack_load r'⁴' n'⁴')) | StackLoadAny r'⁵' i => Seq (Seq (move r'⁵' i) (add_inst r'⁵' k)) (load_inst r'⁵' r'⁵') | StackGetSize r'⁷' => Seq (Seq (move r'⁷' k) (sub_inst r'⁷' (k + 1))) (right_shift_inst r'⁷' (word_shift (:α))) | StackSetSize r'⁸' => Seq (left_shift_inst r'⁸' (word_shift (:α))) (Seq (move k (k + 1)) (add_inst k r'⁸')) | BitmapLoad r'⁹' v => list_Seq [Inst (Mem Load r'⁹' (Addr (k + 1) (store_offset BitmapBase))); add_inst r'⁹' v; left_shift_inst r'⁹' (word_shift (:α)); load_inst r'⁹' r'⁹'] | Halt v136 => Halt v136
