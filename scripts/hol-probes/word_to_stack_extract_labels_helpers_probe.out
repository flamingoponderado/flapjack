elh_extract_labels_wStackLoad_Skip=⊢ extract_labels (wStackLoad xs Skip) = []
elh_extract_labels_stack_move_StackAlloc=⊢ ∀n start offset i. extract_labels (stack_move n start offset i (StackAlloc k)) = []
