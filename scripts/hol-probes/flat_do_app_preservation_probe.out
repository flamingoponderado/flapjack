do_app_const_typed=do_app (s :(α, β) state) (op :op) (vs :v list) = SOME ((s' :(α, β) state),(r :(v, v) result)) ⇒ s.clock = s'.clock
do_app_state_unchanged_typed=∀(c :α) (s :(β, γ) state) (op :op) (vs :v list) (s' :(β, γ) state) (r :(v, v) result). do_app s op vs = SOME (s',r) ⇒ s'.eval_config = s.eval_config
pmatch_state_typed=(∀(st :(γ, 'ffi) state) (p :pat) (v :v) (l :(mlstring # v) list) (st' :(δ, 'ffi) state) (res :(mlstring # v) list match_result). (pmatch st p v l :(mlstring # v) list match_result) = res ∧ st.refs = st'.refs ⇒ (pmatch st' p v l :(mlstring # v) list match_result) = res) ∧ ∀(st :(γ, 'ffi) state) (p :pat list) (vs :v list) (l :(mlstring # v) list) (st' :(δ, 'ffi) state) (res :(mlstring # v) list match_result). (pmatch_list st p vs l :(mlstring # v) list match_result) = res ∧ st.refs = st'.refs ⇒ (pmatch_list st' p vs l :(mlstring # v) list match_result) = res
pmatch_ignore_clock_typed=(pmatch ((s :(α, β) state) with clock := (s' :num)) (p :pat) (v :v) (env :(mlstring # v) list) :(mlstring # v) list match_result) = (pmatch s p v env :(mlstring # v) list match_result) ∧ (pmatch_list (s with clock := s') (ps :pat list) (vs :v list) env :(mlstring # v) list match_result) = (pmatch_list s ps vs env :(mlstring # v) list match_result)
pmatch_rows_ignore_clock_typed=∀(pes :(pat # α) list) (s :(β, γ) state) (v :v) (c :num). pmatch_rows pes (s with clock := c) v = pmatch_rows pes s v
