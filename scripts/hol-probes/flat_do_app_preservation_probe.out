do_app_const_typed=do_app (s :(α, β) state) (op :op) (vs :v list) = SOME ((s' :(α, β) state),(r :(v, v) result)) ⇒ s.clock = s'.clock
do_app_state_unchanged_typed=∀(c :α) (s :(β, γ) state) (op :op) (vs :v list) (s' :(β, γ) state) (r :(v, v) result). do_app s op vs = SOME (s',r) ⇒ s'.eval_config = s.eval_config
pmatch_state_typed=(∀(st :(γ, 'ffi) state) (p :pat) (v :v) (l :(mlstring # v) list) (st' :(δ, 'ffi) state) (res :(mlstring # v) list match_result). (pmatch st p v l :(mlstring # v) list match_result) = res ∧ st.refs = st'.refs ⇒ (pmatch st' p v l :(mlstring # v) list match_result) = res) ∧ ∀(st :(γ, 'ffi) state) (p :pat list) (vs :v list) (l :(mlstring # v) list) (st' :(δ, 'ffi) state) (res :(mlstring # v) list match_result). (pmatch_list st p vs l :(mlstring # v) list match_result) = res ∧ st.refs = st'.refs ⇒ (pmatch_list st' p vs l :(mlstring # v) list match_result) = res
pmatch_ignore_clock_typed=(pmatch ((s :(α, β) state) with clock := (s' :num)) (p :pat) (v :v) (env :(mlstring # v) list) :(mlstring # v) list match_result) = (pmatch s p v env :(mlstring # v) list match_result) ∧ (pmatch_list (s with clock := s') (ps :pat list) (vs :v list) env :(mlstring # v) list match_result) = (pmatch_list s ps vs env :(mlstring # v) list match_result)
pmatch_rows_ignore_clock_typed=∀(pes :(pat # α) list) (s :(β, γ) state) (v :v) (c :num). pmatch_rows pes (s with clock := c) v = pmatch_rows pes s v
pmatch_extend_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (env' :(mlstring # v) list) (env'' :α). (pmatch s p v env :(mlstring # v) list match_result) = Match env' ⇒ ∃(env'' :(mlstring # v) list). env' = env'' ++ env ∧ MAP (FST :mlstring # v -> mlstring) env'' = pat_bindings p) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (env' :(mlstring # v) list) (env'' :β). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env' ⇒ ∃(env'' :(mlstring # v) list). env' = env'' ++ env ∧ MAP (FST :mlstring # v -> mlstring) env'' = pats_bindings ps
map_match_def_typed=map_match (f :α -> α) (Match (env :α)) = Match (f env) ∧ map_match f (No_match :α match_result) = (No_match :α match_result) ∧ map_match f (Match_type_error :α match_result) = (Match_type_error :α match_result)
semantic_shift_lookup_def_typed=(shift_lookup Lsl :α word -> num -> α word) = ($<< :α word -> num -> α word) ∧ (shift_lookup Lsr :α word -> num -> α word) = ($>>> :α word -> num -> α word) ∧ (shift_lookup Asr :α word -> num -> α word) = ($>> :α word -> num -> α word) ∧ (shift_lookup Ror :α word -> num -> α word) = ($#>> :α word -> num -> α word)
semantic_do_shift_def_typed=do_shift (sh :shift) (n :num) W8 (Word8 (w' :word8)) = SOME (Word8 (shift_lookup sh w' n)) ∧ do_shift sh n W64 (Word64 (w :word64)) = SOME (Word64 (shift_lookup sh w n)) ∧ do_shift (v0 :shift) (v1 :num) (v2 :word_size) (IntLit (v9 :int)) = (NONE :lit option) ∧ do_shift v0 v1 v2 (Char (v10 :char)) = (NONE :lit option) ∧ do_shift v0 v1 v2 (StrLit (v11 :mlstring)) = (NONE :lit option) ∧ do_shift v0 v1 W64 (Word8 (v12 :word8)) = (NONE :lit option) ∧ do_shift v0 v1 W8 (Word64 (v13 :word64)) = (NONE :lit option) ∧ do_shift v0 v1 v2 (Float64 (v14 :word64)) = (NONE :lit option)
pmatch_append_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (pred_env :α). map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) (tail_env :(mlstring # v) list)) (pmatch s p v env :(mlstring # v) list match_result) = (pmatch s p v (env ++ tail_env) :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (n :β). map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) tail_env) (pmatch_list s ps vs env :(mlstring # v) list match_result) = (pmatch_list s ps vs (env ++ tail_env) :(mlstring # v) list match_result)
pmatch_any_match_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (env' :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = Match env' ⇒ ∀(env :(mlstring # v) list). ∃(env' :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = Match env') ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (env' :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env' ⇒ ∀(env :(mlstring # v) list). ∃(env' :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env'
pmatch_any_no_match_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result)
pmatch_any_match_error_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)
pmatch_list_pairwise_typed=∀(ps :pat list) (vs :v list) (s :(γ, 'ffi) state) (env :(mlstring # v) list) (env' :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env' ⇒ LIST_REL (λ(p :pat) (v :v). ∀(env :(mlstring # v) list). ∃(env' :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = Match env') ps vs
pmatch_list_snoc_nil_typed=∀(p :pat) (ps :pat list) (v :v) (vs :v list) (s :(γ, 'ffi) state) (env :(mlstring # v) list). (pmatch_list s ([] :pat list) (SNOC v vs) env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result) ∧ (pmatch_list s (SNOC p ps) ([] :v list) env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)
pmatch_list_append_typed=∀(ps :pat list) (vs :v list) (ps' :pat list) (vs' :v list) (s :(α, β) state) (env :(mlstring # v) list). LENGTH ps = LENGTH vs ⇒ (pmatch_list s (ps ++ ps') (vs ++ vs') env :(mlstring # v) list match_result) = case (pmatch_list s ps vs env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (case (pmatch_list s ps' vs' env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match env' => (pmatch_list s ps' vs' env' :(mlstring # v) list match_result)
pmatch_list_snoc_typed=∀(ps :pat list) (vs :v list) (p :pat) (v :v) (s :(γ, 'ffi) state) (env :(mlstring # v) list). LENGTH ps = LENGTH vs ⇒ (pmatch_list s (SNOC p ps) (SNOC v vs) env :(mlstring # v) list match_result) = case (pmatch_list s ps vs env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (case (pmatch s p v env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match env' => (pmatch s p v env' :(mlstring # v) list match_result)
map_match_eq_case_typed=map_match (f :α -> α) (v :α match_result) = case v of (No_match :α match_result) => v | (Match_type_error :α match_result) => v | Match m => Match (f m)
pmatch_nil_typed=(∀(v :v) (tail_env :(mlstring # v) list) (s :(γ, 'ffi) state) (p :pat). (pmatch s p v tail_env :(mlstring # v) list match_result) = map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) tail_env) (pmatch s p v ([] :(mlstring # v) list) :(mlstring # v) list match_result)) ∧ ∀(vs :v list) (tail_env :(mlstring # v) list) (s :(γ, 'ffi) state) (ps :pat list). (pmatch_list s ps vs tail_env :(mlstring # v) list match_result) = map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) tail_env) (pmatch_list s ps vs ([] :(mlstring # v) list) :(mlstring # v) list match_result)
flat_build_rec_env_merge_typed=∀(funs :(mlstring # mlstring # exp) list) (funs' :α) (env :v environment) (env' :(mlstring # v) list). build_rec_env funs env env' = MAP (λ((fn :mlstring),(n :mlstring),(e :exp)). (fn,(Recclosure env funs fn :v))) funs ++ env'
flat_evaluate_cons_typed=(evaluate (env :v environment) (s :(α, β) state) ((e :exp)::(es :exp list)) :(α, β) state # (v list, v) result) = case (evaluate env s [e] :(α, β) state # (v list, v) result) of (s,(Rval v :(v list, v) result)) => (case (evaluate env s es :(α, β) state # (v list, v) result) of (s,(Rval vs :(v list, v) result)) => (s,(Rval (v ++ vs) :(v list, v) result)) | (s,(Rerr v8 :(v list, v) result)) => (s,(Rerr v8 :(v list, v) result))) | (s,(Rerr v10 :(v list, v) result)) => (s,(Rerr v10 :(v list, v) result))
flat_evaluate_append_typed=(evaluate (env :v environment) (s :(α, β) state) ((l1 :exp list) ++ (l2 :exp list)) :(α, β) state # (v list, v) result) = case (evaluate env s l1 :(α, β) state # (v list, v) result) of (s,(Rval v1 :(v list, v) result)) => (case (evaluate env s l2 :(α, β) state # (v list, v) result) of (s,(Rval v2 :(v list, v) result)) => (s,(Rval (v1 ++ v2) :(v list, v) result)) | (s,(Rerr v9 :(v list, v) result)) => (s,(Rerr v9 :(v list, v) result))) | (s,(Rerr v11 :(v list, v) result)) => (s,(Rerr v11 :(v list, v) result))
flat_build_rec_env_help_typed=∀(funs :(mlstring # α # β) list) (env :v environment) (funs' :(mlstring # mlstring # exp) list). FOLDR (λ((f :mlstring),(x :α),(e :β)) (env' :(mlstring # v) list). (f,(Recclosure env funs' f :v))::env') (env' :(mlstring # v) list) funs = MAP (λ((fn :mlstring),(n :α),(e :β)). (fn,(Recclosure env funs' fn :v))) funs ++ env'
flat_do_app_add_clock_typed=do_app (s :(α, 'ffi) state) (op :op) (es :v list) = SOME ((t :(α, 'ffi) state),(r :(v, v) result)) ⇒ do_app (s with clock := s.clock + (k :num)) op es = SOME (t with clock := t.clock + k,r)
flat_do_app_add_clock_none_typed=do_app (s :(α, 'ffi) state) (op :op) (es :v list) = (NONE :((α, 'ffi) state # (v, v) result) option) ⇒ do_app (s with clock := s.clock + (k :num)) op es = (NONE :((α, 'ffi) state # (v, v) result) option)
flat_with_clock_ffi_typed=((s :(β, α) state) with clock := (k :num)).ffi = s.ffi
flat_evaluate_sing_typed=(evaluate (env :v environment) (s :(α, β) state) [(e :exp)] :(α, β) state # (v list, v) result) = ((s' :(α, β) state),(Rval (vs :v list) :(v list, v) result)) ⇒ ∃(y :v). vs = [y]
flat_evaluate_add_clock_typed=(∀(env :v environment) (s :(γ, 'ffi) state) (es :exp list) (s' :(γ, 'ffi) state) (r :(v list, v) result). (evaluate env s es :(γ, 'ffi) state # (v list, v) result) = (s',r) ∧ r ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ (evaluate env (s with clock := s.clock + (extra :num)) es :(γ, 'ffi) state # (v list, v) result) = (s' with clock := s'.clock + extra,r)) ∧ (∀(s :(γ, 'ffi) state) (d :exp) (s' :(γ, 'ffi) state) (r :v error_result option). evaluate_dec s d = (s',r) ∧ r ≠ SOME (Rabort Rtimeout_error :v error_result) ⇒ evaluate_dec (s with clock := s.clock + extra) d = (s' with clock := s'.clock + extra,r)) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list) (s' :(γ, 'ffi) state) (r :v error_result option). (evaluate_decs s ds :(γ, 'ffi) state # v error_result option) = (s',r) ∧ r ≠ SOME (Rabort Rtimeout_error :v error_result) ⇒ (evaluate_decs (s with clock := s.clock + extra) ds :(γ, 'ffi) state # v error_result option) = (s' with clock := s'.clock + extra,r)
flat_evaluate_decs_add_clock_typed=∀(decs :exp list) (s :(α, β) state) (s' :(α, β) state) (r :v error_result option). r ≠ SOME (Rabort Rtimeout_error :v error_result) ∧ (evaluate_decs s decs :(α, β) state # v error_result option) = (s',r) ⇒ (evaluate_decs (s with clock := s.clock + (extra :num)) decs :(α, β) state # v error_result option) = (s' with clock := s'.clock + extra,r)
flat_do_app_io_events_mono_typed=do_app (s :(γ, 'ffi) state) (op :op) (vs :v list) = SOME ((t :(γ, 'ffi) state),(r :(v, v) result)) ⇒ s.ffi.io_events ≼ t.ffi.io_events
flat_evaluate_io_events_mono_typed=(∀(env :v environment) (s :(γ, 'ffi) state) (es :exp list). s.ffi.io_events ≼ (FST (evaluate env s es :(γ, 'ffi) state # (v list, v) result)).ffi.io_events) ∧ (∀(s :(γ, 'ffi) state) (d :exp). s.ffi.io_events ≼ (FST (evaluate_dec s d)).ffi.io_events) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list). s.ffi.io_events ≼ (FST (evaluate_decs s ds :(γ, 'ffi) state # v error_result option)).ffi.io_events
flat_evaluate_io_events_mono_imp_typed=((evaluate (env :v environment) (s :(α, β) state) (es :exp list) :(α, β) state # (v list, v) result) = ((s' :(α, β) state),(r :(v list, v) result)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events) ∧ (evaluate_dec s (d :exp) = (s',(r' :v error_result option)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events) ∧ ((evaluate_decs s (ds :exp list) :(α, β) state # v error_result option) = (s',(r'' :v error_result option)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events)
flat_evaluate_dec_io_events_mono_typed=∀(z :exp) (y :(α, β) state). y.ffi.io_events ≼ (FST (evaluate_dec y z)).ffi.io_events
flat_evaluate_decs_io_events_mono_typed=∀(ds :exp list) (s :(γ, 'ffi) state) (s' :(γ, 'ffi) state) (y :v error_result option). (evaluate_decs s ds :(γ, 'ffi) state # v error_result option) = (s',y) ⇒ s.ffi.io_events ≼ s'.ffi.io_events
flat_evaluate_add_clock_io_events_mono_typed=(∀(env :v environment) (s :(γ, 'ffi) state) (es :exp list). (FST (evaluate env s es :(γ, 'ffi) state # (v list, v) result)).ffi.io_events ≼ (FST (evaluate env (s with clock := s.clock + (extra :num)) es :(γ, 'ffi) state # (v list, v) result)).ffi.io_events) ∧ (∀(s :(γ, 'ffi) state) (d :exp). (FST (evaluate_dec s d)).ffi.io_events ≼ (FST (evaluate_dec (s with clock := s.clock + extra) d)).ffi.io_events) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list). (FST (evaluate_decs s ds :(γ, 'ffi) state # v error_result option)).ffi.io_events ≼ (FST (evaluate_decs (s with clock := s.clock + extra) ds :(γ, 'ffi) state # v error_result option)).ffi.io_events
flat_evaluate_dec_add_clock_io_events_mono_typed=∀(prog :exp) (s :(γ, 'ffi) state) (extra :num). (FST (evaluate_dec s prog)).ffi.io_events ≼ (FST (evaluate_dec (s with clock := s.clock + extra) prog)).ffi.io_events
flat_evaluate_decs_add_clock_io_events_mono_typed=∀(ds :exp list) (s :(γ, 'ffi) state) (extra :num). (FST (evaluate_decs s ds :(γ, 'ffi) state # v error_result option)).ffi.io_events ≼ (FST (evaluate_decs (s with clock := s.clock + extra) ds :(γ, 'ffi) state # v error_result option)).ffi.io_events
flat_evaluate_map_var_local_typed=MAP (ALOOKUP (env :v environment).v) (xs :mlstring list) = MAP (SOME :v -> v option) (vs :v list) ⇒ (evaluate env (s :(α, β) state) (MAP (Var_local (t :tra)) xs) :(α, β) state # (v list, v) result) = (s,(Rval vs :(v list, v) result))
flat_bind_locals_list_def_typed=∀(ts :tra list) (ks :mlstring list). bind_locals_list ts ks = (MAP2 (λ(t :tra) (x :mlstring). Var_local t x) ts ks :exp list)
flat_evaluate_vars_typed=∀(env :v environment) (s :(α, β) state) (kvs :(mlstring # v) list) (env' :(mlstring # v) list) (ks :mlstring list) (vs :v list) (ts :tra list). ALL_DISTINCT (MAP (FST :mlstring # v -> mlstring) kvs) ∧ DISJOINT (set (MAP (FST :mlstring # v -> mlstring) kvs)) (set (MAP (FST :mlstring # v -> mlstring) env')) ∧ env.v = env' ++ kvs ∧ ks = MAP (FST :mlstring # v -> mlstring) kvs ∧ vs = MAP (SND :mlstring # v -> v) kvs ∧ LENGTH ts = LENGTH ks ⇒ (evaluate env s (bind_locals_list ts ks) :(α, β) state # (v list, v) result) = (s,(Rval vs :(v list, v) result))
flat_pmatch_list_map_pvar_typed=∀(xs :mlstring list) (vs :v list). LENGTH xs = LENGTH vs ⇒ (pmatch_list (s :(α, β) state) (MAP Pvar xs) vs ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match (REVERSE (ZIP (xs,vs)))
flat_evaluate_decs_add_clock_initial_typed=(r :v error_result option) ≠ SOME (Rabort Rtimeout_error :v error_result) ∧ (evaluate_decs (initial_state (ffi :β ffi_state) (k :num) (ec :α install_config)) (decs :exp list) :(α, β) state # v error_result option) = ((s' :(α, β) state),r) ⇒ (evaluate_decs (initial_state ffi ((ck :num) + k) ec) decs :(α, β) state # v error_result option) = (s' with clock := s'.clock + ck,r)
flat_evaluate_decs_add_clock_initial_events_typed=(evaluate_decs (initial_state (ffi :β ffi_state) (k :num) (ec :α install_config)) (prog :exp list) :(α, β) state # v error_result option) = ((s' :(α, β) state),(r :v error_result option)) ⇒ s'.ffi.io_events ≼ (FST (evaluate_decs (initial_state ffi (k + (ck :num)) ec) prog :(α, β) state # v error_result option)).ffi.io_events
flat_initial_state_with_clock_typed=initial_state (ffi :β ffi_state) (k :num) (ec :α install_config) with clock := (initial_state ffi k ec).clock + (ck :num) = initial_state ffi (k + ck) ec
flat_imp_semantics_eq_typed=eval_sim (ffi :'ffi ffi_state) (ds1 :exp list) (ds2 :exp list) (ec :α install_config) (ec2 :β install_config) (rel :exp list -> exp list -> bool) F ∧ semantics ec ffi ds1 ≠ Fail ⇒ rel ds1 ds2 ⇒ semantics ec ffi ds1 = semantics ec2 ffi ds2
flat_elist_globals_foldr_typed=elist_globals (es :exp list) = FOLDR ($⊎ :(num -> num) -> (num -> num) -> num -> num) ({||} :num -> num) (MAP set_globals es)
flat_elist_globals_reverse_typed=elist_globals (REVERSE (es :exp list)) = elist_globals es
flat_initial_state_clock_typed=(initial_state (ffi :β ffi_state) (k :num) (ec :α install_config)).clock = k ∧ initial_state ffi k ec with clock := (k1 :num) = initial_state ffi k1 ec
flat_evaluate_decs_add_clock_io_events_mono_alt_typed=(evaluate_decs (s :(γ, 'ffi) state) (ds :exp list) :(γ, 'ffi) state # v error_result option) = ((s1 :(γ, 'ffi) state),(res :v error_result option)) ∧ (evaluate_decs (s with clock := s.clock + (extra :num)) ds :(γ, 'ffi) state # v error_result option) = ((s2 :(γ, 'ffi) state),(res2 :v error_result option)) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
flat_isClosure_simps_typed=¬isClosure (Litv (l :lit) :v) ∧ ¬isClosure (Conv (o' :(num # num option) option) (l :v list)) ∧ isClosure (Closure (e :v environment) (m :mlstring) (e0 :exp) :v) ∧ isClosure (Recclosure e (l :(mlstring # mlstring # exp) list) m :v) ∧ ¬isClosure (Loc (b :bool) (n :num) :v) ∧ ¬isClosure (Vectorv l)
flat_check_type_list_rel_same_typed=LIST_REL (vr :v -> v -> bool) (vs1 :v list) (vs2 :v list) ∧ EVERY (check_type (ty :prim_type) :semanticPrimitives$v -> bool) (MAP flat_to_v vs1) ∧ simple_val_rel vr ⇒ vs2 = vs1
flat_simple_do_app_typed=simple_val_rel (vr :v -> v -> bool) ∧ simple_state_rel vr (sr :(α, β) state -> (γ, β) state -> bool) ⇒ ∀(s1 :(α, β) state) (vs1 :v list) (t1 :(α, β) state) (r1 :(v, v) result) (s2 :(γ, β) state) (vs2 :v list). do_app s1 (op :op) vs1 = SOME (t1,r1) ⇒ sr s1 s2 ∧ LIST_REL vr vs1 vs2 ⇒ ∃(t2 :(γ, β) state) (r2 :(v, v) result). result_rel vr vr r1 r2 ∧ sr t1 t2 ∧ do_app s2 op vs2 = SOME (t2,r2)
