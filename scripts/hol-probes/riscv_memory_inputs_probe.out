alias_wrap=T
source_clause=asm_ok (Inst (Mem m r (Addr base w))) riscv_config ⇔ reg_ok r riscv_config ∧ reg_ok base riscv_config ∧ if m = Load ∨ m = Store ∨ m = Load32 ∨ m = Store32 then addr_offset_ok riscv_config w else if m = Load16 ∨ m = Store16 then hw_offset_ok riscv_config w ∧ riscv_config.ISA ≠ Ag32 else byte_offset_ok riscv_config w
source_hypotheses=0
source_types=w : :word64, base : :num, r : :num, m : :memop
native_clause=riscv_ast (Inst (Mem m r (Addr base w))) = case riscv_memop m of INL f => [Load (f (n2w r,n2w base,w2w w))] | INR f' => [Store (f' (n2w base,n2w r,w2w w))]
native_hypotheses=0
native_types=w : :word64, base : :num, r : :num, m : :memop
