every_Fn_vs_NONE_insert_interp_typed=every_Fn_vs_NONE (xs :closLang$exp list) ⇒ every_Fn_vs_NONE (insert_interp xs)
contains_App_SOME_insert_interp_typed=¬contains_App_SOME (max_app :num) (xs :closLang$exp list) ∧ (1 :num) ≤ max_app ⇒ ¬contains_App_SOME max_app (insert_interp xs)
opt_interp_lemma_replay_typed=opt_interp (x :closLang$exp) = SOME (x' :closLang$exp) ⇒ set_globals x' = ({||} :num -> num) ∧ set_globals x = ({||} :num -> num) ∧ ((1 :num) ≤ (max_app :num) ⇒ ¬contains_App_SOME max_app [x']) ∧ every_Fn_vs_NONE [x'] ∧ no_mti x' ∧ esgc_free x ∧ esgc_free x'
has_install_list_eq_replay_typed=∀(xs :closLang$exp list). has_install_list xs ⇔ EXISTS has_install xs
lookup_vars_ok_replay_typed=∀(vs :num list) (env :v list) (env' :v list). lookup_vars vs env = SOME env' ∧ EVERY v_ok env ⇒ EVERY v_ok env'
state_rel_prime_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel' s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ EVERY (OPTION_ALL v_ok) t.globals ∧ s.refs = t.refs ∧ FEVERY (λ((k :num),(v :v ref)). ∀(vs :v list). v = ValueArray vs ⇒ EVERY v_ok vs) t.refs ∧ FEVERY (λ((k :num),(v :v ref)). ∀(m :thunk_mode) (w :v). v = (Thunk m w :v ref) ⇒ v_ok w) t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
state_rel_prime_dec_clock_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ state_rel' (dec_clock (1 :num) s) (dec_clock (1 :num) t)
state_rel_prime_clock_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ t.clock = s.clock
state_rel_prime_refs_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ t.refs = s.refs
evaluate_change_oracle_typed=(∀(tmp :closLang$exp list # v list # (γ, 'ffi) state) (xs :closLang$exp list) (env :v list) (s1 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (n :α). tmp = (xs,env,s1) ∧ evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel' s1 t1 ∧ ¬has_install_list xs ∧ EVERY v_ok env ⇒ ∃(t2 :(γ, 'ffi) state). evaluate (xs,env,t1) = (res,t2) ∧ state_rel' s2 t2 ∧ res_ok res) ∧ ∀(loc :num option) (f :v) (args :v list) (s :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state). evaluate_app loc f args s = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel' s t1 ∧ EVERY v_ok args ∧ v_ok f ⇒ ∃(t2 :(γ, 'ffi) state). evaluate_app loc f args t1 = (res,t2) ∧ state_rel' s2 t2 ∧ res_ok res
state_rel_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ s.refs = t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle ∧ oHD s.globals = SOME (SOME (Closure (NONE :num option) ([] :v list) ([] :v list) (1 :num) clos_interpreter :v))
state_rel_1_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel_1 s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ s.refs = t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
evaluate_interp_lemma_typed=(∀(xs :closLang$exp list) (s1 :(γ, 'ffi) state) (env :v list) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate (xs,env,t1 with clock := t1.clock + ck) = (res,t2) ∧ state_rel s2 t2) ∧ ∀(args :v list) (s1 :(γ, 'ffi) state) (loc :num option) (f :v) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate_app loc f args s1 = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate_app loc f args (t1 with clock := t1.clock + ck) = (res,t2) ∧ state_rel s2 t2
evaluate_interp_thm_typed=∀(xs :closLang$exp list) (env :v list) (s1 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate (xs,env,t1 with clock := t1.clock + ck) = (res,t2) ∧ state_rel s2 t2
