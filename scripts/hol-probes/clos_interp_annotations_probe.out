every_Fn_vs_NONE_insert_interp_typed=every_Fn_vs_NONE (xs :closLang$exp list) ⇒ every_Fn_vs_NONE (insert_interp xs)
contains_App_SOME_insert_interp_typed=¬contains_App_SOME (max_app :num) (xs :closLang$exp list) ∧ (1 :num) ≤ max_app ⇒ ¬contains_App_SOME max_app (insert_interp xs)
opt_interp_lemma_replay_typed=opt_interp (x :closLang$exp) = SOME (x' :closLang$exp) ⇒ set_globals x' = ({||} :num -> num) ∧ set_globals x = ({||} :num -> num) ∧ ((1 :num) ≤ (max_app :num) ⇒ ¬contains_App_SOME max_app [x']) ∧ every_Fn_vs_NONE [x'] ∧ no_mti x' ∧ esgc_free x ∧ esgc_free x'
has_install_list_eq_replay_typed=∀(xs :closLang$exp list). has_install_list xs ⇔ EXISTS has_install xs
lookup_vars_ok_replay_typed=∀(vs :num list) (env :v list) (env' :v list). lookup_vars vs env = SOME env' ∧ EVERY v_ok env ⇒ EVERY v_ok env'
state_rel_prime_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel' s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ EVERY (OPTION_ALL v_ok) t.globals ∧ s.refs = t.refs ∧ FEVERY (λ((k :num),(v :v ref)). ∀(vs :v list). v = ValueArray vs ⇒ EVERY v_ok vs) t.refs ∧ FEVERY (λ((k :num),(v :v ref)). ∀(m :thunk_mode) (w :v). v = (Thunk m w :v ref) ⇒ v_ok w) t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
state_rel_prime_dec_clock_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ state_rel' (dec_clock (1 :num) s) (dec_clock (1 :num) t)
state_rel_prime_clock_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ t.clock = s.clock
state_rel_prime_refs_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ t.refs = s.refs
evaluate_change_oracle_typed=(∀(tmp :closLang$exp list # v list # (γ, 'ffi) state) (xs :closLang$exp list) (env :v list) (s1 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (n :α). tmp = (xs,env,s1) ∧ evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel' s1 t1 ∧ ¬has_install_list xs ∧ EVERY v_ok env ⇒ ∃(t2 :(γ, 'ffi) state). evaluate (xs,env,t1) = (res,t2) ∧ state_rel' s2 t2 ∧ res_ok res) ∧ ∀(loc :num option) (f :v) (args :v list) (s :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state). evaluate_app loc f args s = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel' s t1 ∧ EVERY v_ok args ∧ v_ok f ⇒ ∃(t2 :(γ, 'ffi) state). evaluate_app loc f args t1 = (res,t2) ∧ state_rel' s2 t2 ∧ res_ok res
state_rel_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ s.refs = t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle ∧ oHD s.globals = SOME (SOME (Closure (NONE :num option) ([] :v list) ([] :v list) (1 :num) clos_interpreter :v))
state_rel_1_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel_1 s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ s.refs = t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
evaluate_interp_lemma_typed=(∀(xs :closLang$exp list) (s1 :(γ, 'ffi) state) (env :v list) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate (xs,env,t1 with clock := t1.clock + ck) = (res,t2) ∧ state_rel s2 t2) ∧ ∀(args :v list) (s1 :(γ, 'ffi) state) (loc :num option) (f :v) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate_app loc f args s1 = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate_app loc f args (t1 with clock := t1.clock + ck) = (res,t2) ∧ state_rel s2 t2
evaluate_interp_thm_typed=∀(xs :closLang$exp list) (env :v list) (s1 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate (xs,env,t1 with clock := t1.clock + ck) = (res,t2) ∧ state_rel s2 t2
state_rel_refs_clocks_replay_typed=state_rel (s1 :(α, β) state) (s2 :(α, β) state) ⇒ s1.refs = s2.refs ∧ s1.clock = s2.clock
state_rel_update_thunk_replay_typed=state_rel (s1 :(α, β) state) (s2 :(α, β) state) ⇒ update_thunk [RefPtr (v :bool) (ptr :num)] s1.refs (vs :v list) = SOME (refs1 :num |-> v ref) ⇒ ∃(refs2 :num |-> v ref). update_thunk [RefPtr v ptr] s2.refs vs = SOME refs2 ∧ state_rel (s1 with refs := refs1) (s2 with refs := refs2)
interp_assum_def_typed=interp_assum (:γ) (:'ffi) (c :num) ⇔ (∀(xs :closLang$exp list) (s1 :(γ, 'ffi) state) (env :v list) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). s1.clock ≤ c ∧ evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate (xs,env,t1 with clock := ck + t1.clock) = (res,t2) ∧ state_rel s2 t2) ∧ ∀(args :v list) (s1 :(γ, 'ffi) state) (loc :num option) (f :v) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state). s1.clock ≤ c ∧ evaluate_app loc f args s1 = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ state_rel s1 t1 ⇒ ∃(ck :num) (t2 :(γ, 'ffi) state). evaluate_app loc f args (t1 with clock := ck + t1.clock) = (res,t2) ∧ state_rel s2 t2
interp_assum_leq_typed=interp_assum (:γ) (:'ffi) (c :num) ∧ (d :num) ≤ c ⇒ interp_assum (:γ) (:'ffi) d
evaluate_insert_interp1_typed=interp_assum (:γ) (:'ffi) (s4 :(γ, 'ffi) state).clock ∧ evaluate ([(e :closLang$exp)],([] :v list),s4) = ((r :(v list, v) result),(s5 :(γ, 'ffi) state)) ∧ state_rel s4 (t4 :(γ, 'ffi) state) ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(ck :num) (t5 :(γ, 'ffi) state). evaluate ([insert_interp1 e],([] :v list),t4 with clock := t4.clock + ck) = (r,t5) ∧ state_rel s5 t5
evaluate_insert_interp_typed=∀(exps :closLang$exp list) (s4 :(γ, 'ffi) state) (s5 :(γ, 'ffi) state) (r :(v list, v) result) (t4 :(γ, 'ffi) state). interp_assum (:γ) (:'ffi) s4.clock ∧ evaluate (exps,([] :v list),s4) = (r,s5) ∧ state_rel s4 t4 ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(ck :num) (t5 :(γ, 'ffi) state). evaluate (insert_interp exps,([] :v list),t4 with clock := t4.clock + ck) = (r,t5) ∧ state_rel s5 t5
opt_interp_thm_typed=opt_interp (e :closLang$exp) = SOME (x :closLang$exp) ∧ interp_assum (:γ) (:'ffi) (s4 :(γ, 'ffi) state).clock ∧ evaluate ([e],([] :v list),s4) = ((r :(v list, v) result),(s5 :(γ, 'ffi) state)) ∧ state_rel s4 (t4 :(γ, 'ffi) state) ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(ck :num) (t5 :(γ, 'ffi) state). evaluate ([x],([] :v list),t4 with clock := ck + t4.clock) = (r,t5) ∧ state_rel s5 t5
opt_interp1_thm_prime_typed=∀(l :closLang$exp) (s4 :(γ, 'ffi) state) (t4 :(γ, 'ffi) state) (s5 :(γ, 'ffi) state) (r :(v list, v) result). interp_assum (:γ) (:'ffi) s4.clock ∧ evaluate ([l],([] :v list),s4) = (r,s5) ∧ state_rel s4 t4 ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(ck :num) (t5 :(γ, 'ffi) state). evaluate ([opt_interp1 l],([] :v list),t4 with clock := t4.clock + ck) = (r,t5) ∧ state_rel s5 t5
opt_interp1_thm_typed=∀(l :closLang$exp list) (s4 :(γ, 'ffi) state) (t4 :(γ, 'ffi) state) (s5 :(γ, 'ffi) state) (r :(v list, v) result). interp_assum (:γ) (:'ffi) s4.clock ∧ evaluate (l,([] :v list),s4) = (r,s5) ∧ state_rel s4 t4 ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(ck :num) (t5 :(γ, 'ffi) state). evaluate (MAP opt_interp1 l,([] :v list),t4 with clock := t4.clock + ck) = (r,t5) ∧ state_rel s5 t5
clos_interpreter_correct_typed=(∀(e :closLang$exp) (env :v list) (s4 :(γ, 'ffi) state) (t4 :(γ, 'ffi) state) (r :(v list, v) result) (s5 :(γ, 'ffi) state). evaluate ([e],env,s4) = (r,s5) ∧ can_interpret e ∧ interp_assum (:γ) (:'ffi) s4.clock ∧ state_rel s4 t4 ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(c :num) (t5 :(γ, 'ffi) state). evaluate ([clos_interpreter_body],[make_const (to_constant e); Block (0 :num) ([] :v list); list_to_v env],t4 with clock := c + t4.clock) = (r,t5) ∧ state_rel s5 t5) ∧ ∀(es :closLang$exp list) (env :v list) (s4 :(γ, 'ffi) state) (t4 :(γ, 'ffi) state) (r :(v list, v) result) (s5 :(γ, 'ffi) state). evaluate (es,env,s4) = (r,s5) ∧ can_interpret_list es ∧ interp_assum (:γ) (:'ffi) s4.clock ∧ state_rel s4 t4 ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(c :num) (t5 :(γ, 'ffi) state) (r5 :(v list, v) result). evaluate ([clos_interpreter_body],[make_const (to_constant_list es); Block (1 :num) ([] :v list); list_to_v env],t4 with clock := c + t4.clock) = (r5,t5) ∧ state_rel s5 t5 ∧ case r of (Rval vs :(v list, v) result) => r5 = (Rval [list_to_v vs] :(v list, v) result) | (Rerr v3 :(v list, v) result) => r = r5
clos_interp_rev_thm_typed=∀(a :v list) (env :v list) (rest :v list) (cl_env :v list). (1 :num) ≤ (t4 :(α, β) state).max_app ⇒ evaluate ([clos_interp_rev],list_to_v env::list_to_v a::(Recclosure (NONE :num option) ([] :v list) cl_env [((1 :num),Fn «» (NONE :num option) (NONE :num list option) (1 :num) clos_interp_rev)] (0 :num) :v)::rest,t4 with clock := (2 :num) * LENGTH a + t4.clock) = ((Rval [list_to_v (REVERSE a ++ env)] :(v list, v) result),t4)
clos_interp_el_thm_typed=∀(n :num) (env :v list) (rest :v list) (cl_env :v list). n < LENGTH env ∧ (1 :num) ≤ (t4 :(α, β) state).max_app ⇒ ∃(c :num). evaluate ([clos_interp_el],list_to_v env::Number ((&n) :int)::(Recclosure (NONE :num option) ([] :v list) cl_env [((1 :num),Fn «» (NONE :num option) (NONE :num list option) (1 :num) clos_interp_el)] (0 :num) :v)::rest,t4 with clock := c + t4.clock) = ((Rval [env❲n❳] :(v list, v) result),t4)
evaluate_Constant_replay_typed=evaluate ([Op (t :tra) (BlockOp (Constant (c :const))) ([] :closLang$exp list)],(env :v list),(s :(α, β) state)) = ((Rval [make_const c] :(v list, v) result),s)
evaluate_Cons_nil_typed=evaluate ([Op (t :tra) (BlockOp (Cons (n :num) :block_op)) ([] :closLang$exp list)],(env :v list),(s :(α, β) state)) = ((Rval [Block n ([] :v list)] :(v list, v) result),s)
evaluate_Global_0_typed=state_rel (s :(α, β) state) (t :(α, β) state) ⇒ evaluate ([Op (tr :tra) (GlobOp (Global (0 :num))) ([] :closLang$exp list)],(env :v list),t with clock := (k :num)) = ((Rval [(Closure (NONE :num option) ([] :v list) ([] :v list) (1 :num) clos_interpreter :v)] :(v list, v) result),t with clock := k)
v_to_list_list_to_v_typed=∀(a :v list). v_to_list (list_to_v a) = SOME a
do_app_oHD_globals_typed=(do_app (p :closLang$op) (vs :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((v :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ oHD s1.globals = SOME (SOME (x :v)) ⇒ oHD s2.globals = SOME (SOME x)
list_rel_eq_replay_typed=∀(xs :α) (ys :β). LIST_REL (λ(v1 :γ) (v2 :γ). v1 = v2) = (λ(xs :γ list) (ys :γ list). xs = ys)
optrel_eq_replay_typed=OPTREL (λ(v1 :α) (v2 :α). v1 = v2) = (λ(x :α option) (y :α option). x = y)
