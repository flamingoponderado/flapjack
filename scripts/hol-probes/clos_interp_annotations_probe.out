every_Fn_vs_NONE_insert_interp_typed=every_Fn_vs_NONE (xs :closLang$exp list) ⇒ every_Fn_vs_NONE (insert_interp xs)
contains_App_SOME_insert_interp_typed=¬contains_App_SOME (max_app :num) (xs :closLang$exp list) ∧ (1 :num) ≤ max_app ⇒ ¬contains_App_SOME max_app (insert_interp xs)
opt_interp_lemma_replay_typed=opt_interp (x :closLang$exp) = SOME (x' :closLang$exp) ⇒ set_globals x' = ({||} :num -> num) ∧ set_globals x = ({||} :num -> num) ∧ ((1 :num) ≤ (max_app :num) ⇒ ¬contains_App_SOME max_app [x']) ∧ every_Fn_vs_NONE [x'] ∧ no_mti x' ∧ esgc_free x ∧ esgc_free x'
has_install_list_eq_replay_typed=∀(xs :closLang$exp list). has_install_list xs ⇔ EXISTS has_install xs
lookup_vars_ok_replay_typed=∀(vs :num list) (env :v list) (env' :v list). lookup_vars vs env = SOME env' ∧ EVERY v_ok env ⇒ EVERY v_ok env'
state_rel_prime_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel' s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ s.globals = t.globals ∧ EVERY (OPTION_ALL v_ok) t.globals ∧ s.refs = t.refs ∧ FEVERY (λ((k :num),(v :v ref)). ∀(vs :v list). v = ValueArray vs ⇒ EVERY v_ok vs) t.refs ∧ FEVERY (λ((k :num),(v :v ref)). ∀(m :thunk_mode) (w :v). v = (Thunk m w :v ref) ⇒ v_ok w) t.refs ∧ s.compile = pure_cc (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) t.compile ∧ t.compile_oracle = (pure_co (insert_interp ## (I :(num # num # closLang$exp) list -> (num # num # closLang$exp) list)) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
state_rel_prime_dec_clock_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ state_rel' (dec_clock (1 :num) s) (dec_clock (1 :num) t)
state_rel_prime_clock_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ t.clock = s.clock
state_rel_prime_refs_replay_typed=state_rel' (s :(α, β) state) (t :(α, β) state) ⇒ t.refs = s.refs
