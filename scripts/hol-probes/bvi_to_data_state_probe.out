code_rel=∀(bvi_code :(num # bvi$exp) sptree$num_map) (data_code :(num # dataLang$prog) sptree$num_map). code_rel bvi_code data_code ⇔ wf bvi_code ∧ wf data_code ∧ (domain bvi_code :num -> bool) = (domain data_code :num -> bool) ∧ ∀(n :num) (exp :bvi$exp) (arg_count :num). (lookup n bvi_code :(num # bvi$exp) option) = SOME (arg_count,exp) ⇒ (lookup n data_code :(num # dataLang$prog) option) = SOME (arg_count,(compile_exp arg_count exp :dataLang$prog))
state_rel=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) dataSem$state). (state_rel s t :bool) ⇔ s.clock = t.clock ∧ code_rel s.code t.code ∧ t.compile_oracle = ((I :γ -> γ) ## compile_prog) ∘ s.compile_oracle ∧ s.compile = (λ(cfg :γ) (prog :(num # num # bvi$exp) list). t.compile cfg (compile_prog prog :(num # num # dataLang$prog) list)) ∧ (∀(n :num). FLOOKUP s.refs n = (lookup n (map data_to_bvi_ref t.refs :bvlSem$v ref sptree$num_map) :bvlSem$v ref option)) ∧ s.ffi = t.ffi ∧ s.global = t.global
compile_correct=∀(xs' :bvi$exp list) (env :bvlSem$v list) (s1 :(α, β) state) (res :(bvlSem$v list, exn_or_ret) result) (s2 :(α, β) state) (t1 :(α, β) dataSem$state) (n :num) (corr :num list) (tail :bool) (live :num list). (evaluate (xs',env,s1) :(bvlSem$v list, exn_or_ret) result # (α, β) state) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(bvlSem$v list, exn_or_ret) result) ∧ var_corr env corr (map data_to_bvi_v t1.locals :bvlSem$v sptree$num_map) ∧ (LENGTH xs' ≠ (1 :num) ⇒ ¬tail) ∧ (∀(k :num). n ≤ k ⇒ (lookup k t1.locals :v option) = (NONE :v option)) ∧ (state_rel s1 t1 :bool) ∧ EVERY (λ(n :num). (lookup n t1.locals :v option) ≠ (NONE :v option)) live ∧ (isException res ⇒ jump_exc t1 ≠ (NONE :(α, β) dataSem$state option)) ⇒ ∃(t2 :(α, β) dataSem$state) (prog :dataLang$prog) (pres :(v list, v) result option) (vs :num list) (next_var :num) (ls :num option). (compile n corr tail live xs' :dataLang$prog # num list # num) = (prog,vs,next_var) ∧ (evaluate (prog,t1) :(v list, v) result option # (α, β) dataSem$state) = (pres,t2) ∧ (state_rel s2 t2 :bool) ∧ case pres of (NONE :(v list, v) result option) => ¬tail ∧ n ≤ next_var ∧ EVERY (λ(v :num). v < next_var) vs ∧ (∀(k :num). next_var ≤ k ⇒ (lookup k t2.locals :v option) = (NONE :v option)) ∧ var_corr env corr (map data_to_bvi_v t2.locals :bvlSem$v sptree$num_map) ∧ (∀(k :num) (x :v). (lookup k t2.locals :v option) = SOME x ⇒ k < next_var) ∧ (∀(k :num) (x :v). (lookup k t1.locals :v option) = SOME x ∧ (¬MEM k live ⇒ MEM k corr) ⇒ (lookup k t2.locals :v option) = SOME x) ∧ t1.stack = t2.stack ∧ t1.handler = t2.handler ∧ (jump_exc t1 ≠ (NONE :(α, β) dataSem$state option) ⇒ jump_exc t2 ≠ (NONE :(α, β) dataSem$state option)) ∧ (case res of (Rval xs :(bvlSem$v list, exn_or_ret) result) => var_corr xs vs (map data_to_bvi_v t2.locals :bvlSem$v sptree$num_map) | (Rerr v3 :(bvlSem$v list, exn_or_ret) result) => F) | SOME r => (¬isReturn res ⇒ data_to_bvi_result r = res) ∧ (isReturn res ⇒ ∃(vs' :v list). r = (Rval vs' :(v list, v) result) ∧ res = (Rerr (Rraise (Ret (MAP data_to_bvi_v vs'))) :(bvlSem$v list, exn_or_ret) result)) ∧ (isResult res ∨ isReturn res ⇒ t1.stack = t2.stack ∧ t1.handler = t2.handler) ∧ (isResult res ⇒ tail) ∧ (isException res ⇒ jump_exc (t2 with <|stack := t1.stack; handler := t1.handler|>) = SOME (t2 with locals_size := ls))
data_to_bvi_do_eq=(∀(t :v ref sptree$num_map) (v1 :v) (v2 :v) (r :num |-> bvlSem$v ref). (∀(n :num). FLOOKUP r n = (lookup n (map data_to_bvi_ref t :bvlSem$v ref sptree$num_map) :bvlSem$v ref option)) ⇒ (do_eq r (data_to_bvi_v v1) (data_to_bvi_v v2) :eq_result) = (do_eq t v1 v2 :eq_result)) ∧ ∀(t :v ref sptree$num_map) (l1 :v list) (l2 :v list) (r :num |-> bvlSem$v ref). (∀(n :num). FLOOKUP r n = (lookup n (map data_to_bvi_ref t :bvlSem$v ref sptree$num_map) :bvlSem$v ref option)) ⇒ (do_eq_list r (MAP data_to_bvi_v l1) (MAP data_to_bvi_v l2) :eq_result) = (do_eq_list t l1 l2 :eq_result)
data_to_bvi_do_app=∀(op :closLang$op) (t :(α, β) dataSem$state) (r :(α, β) state) (z :v list) (res :bvlSem$v) (s1 :(α, β) state). op ≠ Install ∧ op ≠ IntOp Greater ∧ op ≠ IntOp GreaterEq ∧ op ≠ WordOp (WordTest W8 (Compare Gt)) ∧ op ≠ WordOp (WordTest W8 (Compare Geq)) ∧ (∀(b :bool). op ≠ MemOp (CopyByte b)) ∧ op ≠ (ThunkOp ForceThunk :closLang$op) ∧ (state_rel r t :bool) ∧ (do_app op (MAP data_to_bvi_v z) r :(bvlSem$v # (α, β) state, exn_or_ret) result) = (Rval (res,s1) :(bvlSem$v # (α, β) state, exn_or_ret) result) ⇒ ∃(s2 :(α, β) dataSem$state) (pres :v). (do_app_aux op z t :(v # (α, β) dataSem$state, v) result) = (Rval (pres,s2) :(v # (α, β) dataSem$state, v) result) ∧ res = data_to_bvi_v pres ∧ (state_rel s1 s2 :bool)
data_to_bvi_v_list_to_v_APPEND=∀(l :v list) (vl :v list) (v :v) (ts :num). v_to_list v = SOME vl ⇒ data_to_bvi_v (list_to_v ts v l :v) = data_to_bvi_v (list_to_v ts Block_nil (l ++ vl) :v)
var_corr=∀(env :α list) (corr :num list) (t :α sptree$num_map). var_corr env corr t ⇔ LIST_REL (λ(v :num) (x :α). (get_var v t :α option) = SOME x) corr env
get_vars_thm=∀(vs :num list) (a :α list) (t2 :α sptree$num_map). var_corr a vs t2 ⇒ (get_vars vs t2 :α list option) = SOME a
get_vars_append=∀(l1 :num list) (l2 :num list) (s :α sptree$num_map). (get_vars (l1 ++ l2) s :α list option) = OPTION_BIND (get_vars l1 s :α list option) (λ(y1 :α list). OPTION_BIND (get_vars l2 s :α list option) (λ(y2 :α list). SOME (y1 ++ y2)))
get_vars_reverse=∀(ls :num list) (s :α sptree$num_map) (ys :α list). (get_vars ls s :α list option) = SOME ys ⇒ (get_vars (REVERSE ls) s :α list option) = SOME (REVERSE ys)
EVERY_get_vars=∀(args :num list) (s1 :α sptree$num_map) (s2 :α sptree$num_map). EVERY (λ(a :num). (lookup a s1 :α option) = (lookup a s2 :α option)) args ⇒ (get_vars args s1 :α list option) = (get_vars args s2 :α list option)
get_vars_IMP_domain=∀(args :num list) (x :num) (s :α sptree$num_map) (vs :α list). MEM x args ∧ (get_vars args s :α list option) = SOME vs ⇒ x ∈ (domain s :num -> bool)
do_app_aux_err=(do_app_aux (op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rerr (e :v error_result) :(v # (α, β) dataSem$state, v) result) ⇒ e = (Rabort Rtype_error :v error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :v error_result)
do_app_err=(do_app (op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rerr (e :v error_result) :(v # (α, β) dataSem$state, v) result) ⇒ e = (Rabort Rtype_error :v error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :v error_result)
do_app_aux_const=(do_app_aux (op :closLang$op) (vs :v list) (x :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((y :v),(z :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.stack = x.stack ∧ z.handler = x.handler ∧ z.locals = x.locals ∧ z.clock = x.clock ∧ z.compile = x.compile
do_app_const=(do_app (op :closLang$op) (vs :v list) (x :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((y :v),(z :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.stack = x.stack ∧ z.handler = x.handler ∧ z.locals = x.locals ∧ z.clock = x.clock ∧ z.compile = x.compile
do_app_io_events_mono=(do_app (x :closLang$op) (y :v list) (z :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((a :v),(b :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.ffi.io_events ≼ b.ffi.io_events
do_app_stack_max=(do_app (op :closLang$op) (xs :v list) (s1 :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((v :v),(s2 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ option_le s1.stack_max s2.stack_max
do_app_safe_for_space_mono=(do_app (op :closLang$op) (xs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((r :v),(s1 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ∧ s1.safe_for_space ⇒ s.safe_for_space
evaluate_io_events_mono=∀(exps :dataLang$prog) (s1 :(α, β) dataSem$state) (res :(v list, v) result option) (s2 :(α, β) dataSem$state). (evaluate (exps,s1) :(v list, v) result option # (α, β) dataSem$state) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_safe_for_space_mono=∀(prog :dataLang$prog) (s :(γ, 'ffi) dataSem$state) (res :(v list, v) result option) (s1 :(γ, 'ffi) dataSem$state). (evaluate (prog,s) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (res,s1) ∧ s1.safe_for_space ⇒ s.safe_for_space
evaluate_option_le_stack_max=∀(c2 :dataLang$prog) (s :(α, β) dataSem$state) (res :(v list, v) result option) (s1 :(α, β) dataSem$state). (evaluate (c2,s) :(v list, v) result option # (α, β) dataSem$state) = (res,s1) ⇒ option_le s.stack_max s1.stack_max
pop_env_const=pop_env (a :(α, β) dataSem$state) = SOME (b :(α, β) dataSem$state) ⇒ b.ffi = a.ffi ∧ b.clock = a.clock ∧ b.stack_max = a.stack_max
pop_env_safe_for_space=pop_env (s2 :(α, β) dataSem$state) = SOME (s1 :(α, β) dataSem$state) ⇒ (s1.safe_for_space ⇔ s2.safe_for_space)
var_corr_map=∀(p :α sptree$num_map) (f :α -> β) (vs :num list) (z :α list). var_corr z vs p ⇒ var_corr (MAP f z) vs (map f p :β sptree$num_map)
get_vars_lift_thm=∀(vs :num list) (a :bvlSem$v list) (t2 :v sptree$num_map). var_corr a vs (map data_to_bvi_v t2 :bvlSem$v sptree$num_map) ⇒ ∃(z :v list). (get_vars vs t2 :v list option) = SOME z ∧ a = MAP data_to_bvi_v z
var_corr_inter=∀(t :α sptree$num_map) (p :β sptree$num_map) (vs :num list) (z :β list). var_corr z vs (inter p t) ⇒ var_corr z vs p
get_vars_mk_wf=∀(vs :num list) (t :α sptree$num_map) (z :α list). (get_vars vs (mk_wf t) :α list option) = SOME z ⇔ (get_vars vs t :α list option) = SOME z
get_vars_inter=∀(vs :num list) (p :α sptree$num_map) (t :β sptree$num_map) (z :α list). (get_vars vs (inter p t) :α list option) = SOME z ⇒ (get_vars vs p :α list option) = SOME z
lookup_mk_wf=∀(x :num) (t :α sptree$num_map). (lookup x (mk_wf t) :α option) = (lookup x t :α option)
data_to_bvi_result=data_to_bvi_result (Rval (vs :v list) :(v list, v) result) = (Rval (MAP data_to_bvi_v vs) :(bvlSem$v list, exn_or_ret) result) ∧ data_to_bvi_result (Rerr (Rraise (v :v)) :(v list, v) result) = (Rerr (Rraise (Exn (data_to_bvi_v v))) :(bvlSem$v list, exn_or_ret) result) ∧ data_to_bvi_result (Rerr (Rabort (err :abort) :v error_result) :(v list, v) result) = (Rerr (Rabort err :exn_or_ret error_result) :(bvlSem$v list, exn_or_ret) result)
data_to_bvi_result_eq=∀(x :(v list, v) result) (v :exn_or_ret). data_to_bvi_result x = (Rerr (Rraise v) :(bvlSem$v list, exn_or_ret) result) ⇔ ∃(z :v). x = (Rerr (Rraise z) :(v list, v) result) ∧ Exn (data_to_bvi_v z) = v
missing_var=(compile_sing (4 :num) ([] :num list) F ([] :num list) (Var (5 :num) :bvi$exp) :dataLang$prog # num # num) = (Skip,(0 :num),(4 :num))
tail_var=(compile_sing (4 :num) [(7 :num)] T ([] :num list) (Var (0 :num) :bvi$exp) :dataLang$prog # num # num) = ((Return [(7 :num)] :dataLang$prog),(4 :num),(5 :num))
tail_letcall=(compile_sing (2 :num) ([] :num list) F ([] :num list) (LetCall (1 :num) (0 :num) (3 :num) ([] :bvi$exp list) (Return [(Var (0 :num) :bvi$exp)] :bvi$exp)) :dataLang$prog # num # num) = (Seq Skip (Call (NONE :(num list # sptree$num_set) option) (SOME (3 :num)) ([] :num list) (NONE :(num # dataLang$prog) option) :dataLang$prog),(2 :num),(3 :num))
FST_compile_part_typed=FST (compile_part (a :num # num # bvi$exp) :num # num # dataLang$prog) = FST a
evaluate_Return_GENLIST_Var_replay_typed=∀(rets :num) (ret_vs :bvlSem$v list) (env :bvlSem$v list) (s' :(α, β) state). LENGTH ret_vs = rets ⇒ (evaluate ([(Return (GENLIST Var rets) :bvi$exp)],ret_vs ++ env,s') :(bvlSem$v list, exn_or_ret) result # (α, β) state) = ((Rerr (Rraise (Ret ret_vs)) :(bvlSem$v list, exn_or_ret) result),s')
optimise_correct_typed=∀(c :dataLang$prog) (s :(α, β) dataSem$state). FST (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) ≠ SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ FST (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) ≠ (NONE :(v list, v) result option) ⇒ ∃(safe :bool) (peak :num) (smx :num option) (ls :num option). (evaluate (optimise c,s) :(v list, v) result option # (α, β) dataSem$state) = ((I :(v list, v) result option -> (v list, v) result option) ## (λ(x :(α, β) dataSem$state). x with <|locals_size := ls; safe_for_space := safe; peak_heap_length := peak; stack_max := smx|>)) (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state)
jump_exc_peak_safe_typed=∀(s :(α, β) dataSem$state) (t :(α, β) dataSem$state) (safe :bool) (peak :num) (ls :num option) (smx :num option). jump_exc s = SOME t ⇒ jump_exc (s with <|safe_for_space := safe; peak_heap_length := peak; locals_size := ls; stack_max := smx|>) = SOME (t with <|safe_for_space := safe; peak_heap_length := peak; stack_max := smx|>)
jump_exc_sfs_lss_peak_safe_typed=∀(s :(α, β) dataSem$state) (t :(α, β) dataSem$state) (safe :bool) (peak :num) (ls :num option) (sfs :num sptree$num_map) (smx :num option). jump_exc s = SOME t ⇒ jump_exc (s with <|safe_for_space := safe; peak_heap_length := peak; locals_size := ls; stack_frame_sizes := sfs; stack_max := smx|>) = SOME (t with <|safe_for_space := safe; peak_heap_length := peak; stack_frame_sizes := sfs; stack_max := smx|>)
jump_exc_lss_typed=∀(s :(α, β) dataSem$state) (t :(α, β) dataSem$state) (ls :num option). jump_exc s = SOME t ⇒ jump_exc (s with locals_size := ls) = SOME t
find_code_lemma_statement_typed=(state_rel (r :(α, β) state) (t2 :(α, β) dataSem$state) :bool) ∧ (find_code (dest :num option) (MAP data_to_bvi_v (a :v list)) r.code :(bvlSem$v list # bvi$exp) option) = SOME ((args :bvlSem$v list),(exp :bvi$exp)) ⇒ ∃(args' :v list) (ss :num option). args = MAP data_to_bvi_v args' ∧ (find_code dest a t2.code t2.stack_frame_sizes :(v list # dataLang$prog # num option) option) = SOME (args',(compile_exp (LENGTH args') exp :dataLang$prog),ss)
state_rel_dest_thunk_typed=(state_rel (s :(α, β) state) (t :(α, β) dataSem$state) :bool) ∧ (dest_thunk (data_to_bvi_v (z :v)) s.refs :dest_thunk_ret) = (IsThunk (ev :thunk_mode) (v :bvlSem$v) :dest_thunk_ret) ⇒ ∃(v' :v). (dest_thunk z t.refs :dataSem$dest_thunk_ret) = (IsThunk ev v' :dataSem$dest_thunk_ret) ∧ data_to_bvi_v v' = v
MAP_FST_compile_prog_typed=∀(prog :(num # num # bvi$exp) list). MAP (FST :num # num # dataLang$prog -> num) (compile_prog prog :(num # num # dataLang$prog) list) = MAP (FST :num # num # bvi$exp -> num) prog
state_rel_peak_safe_typed=∀(s :(α, β) state) (s' :(α, β) dataSem$state) (safe :bool) (peak :num) (ls :num option) (smx :num option). (state_rel s s' :bool) ⇔ (state_rel s (s' with <|locals_size := ls; safe_for_space := safe; peak_heap_length := peak; stack_max := smx|>) :bool)
