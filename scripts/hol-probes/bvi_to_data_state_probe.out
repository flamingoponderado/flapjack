i_assign=∀(n1 :num) (op :closLang$op) (vs :num list) (live :num list) (env :num list). iAssign n1 op vs live env = if op_requires_names op then (let (xs :sptree$num_set option) = SOME (list_to_num_set (vs ++ live ++ env)) in if op = IntOp Greater then (Assign n1 (IntOp Less) (REVERSE vs) xs :dataLang$prog) else if op = IntOp GreaterEq then (Assign n1 (IntOp LessEq) (REVERSE vs) xs :dataLang$prog) else (Assign n1 op vs xs :dataLang$prog)) else (let (k :num) = op_space_req op (LENGTH vs) in if k = (0 :num) then if op = WordOp (WordTest W8 (Compare Gt)) then (Assign n1 (WordOp (WordTest W8 (Compare Lt))) (REVERSE vs) (NONE :sptree$num_set option) :dataLang$prog) else if op = WordOp (WordTest W8 (Compare Geq)) then (Assign n1 (WordOp (WordTest W8 (Compare Leq))) (REVERSE vs) (NONE :sptree$num_set option) :dataLang$prog) else (Assign n1 op vs (NONE :sptree$num_set option) :dataLang$prog) else Seq (MakeSpace k (list_to_num_set (vs ++ live ++ env))) (Assign n1 op vs (NONE :sptree$num_set option) :dataLang$prog))
