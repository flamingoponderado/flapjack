dest xs (SOME handler) :bvi$exp) :dataLang$prog # num # num) = (let ((c1 :dataLang$prog),(vs :num list),(n1 :num)) = (compile_list n env live xs :dataLang$prog # num list # num); ((c2 :dataLang$prog),(v :num),(n2 :num)) = (compile_sing (n1 + (1 :num)) (n1::env) F live handler :dataLang$prog # num # num); (ret :(num list # sptree$num_set) option) = SOME ([n2],list_to_num_set (live ++ env)); (c3 :dataLang$prog) = if tail then (Return [n2] :dataLang$prog) else Skip in (Seq c1 (mk_ticks ticks (Seq (Call ret dest vs (SOME (n1,Seq c2 (Move n2 v :dataLang$prog))) :dataLang$prog) c3)),n2,n2 + (1 :num)))) ∧ (∀(y :bvi$exp) (xs :bvi$exp list) (ticks :num) (tail :bool) (rets :num) (n :num) (live :num list) (env :num list) (dest :num). (compile_sing n env tail live (LetCall rets ticks dest xs y) :dataLang$prog # num # num) = (let ((c1 :dataLang$prog),(vs :num list),(n1 :num)) = (compile_list n env live xs :dataLang$prog # num list # num) in if y = (Return (GENLIST Var rets) :bvi$exp) then (Seq c1 (mk_ticks ticks (Call (NONE :(num list # sptree$num_set) option) (SOME dest) vs (NONE :(num # dataLang$prog) option) :dataLang$prog)),n1,n1 + (1 :num)) else (let (rs :num list) = GENLIST (λ(i :num). n1 + i) rets; ((c2 :dataLang$prog),(v :num),(n2 :num)) = (compile_sing (n1 + rets) (rs ++ env) tail live y :dataLang$prog # num # num); (ret :(num list # sptree$num_set) option) = SOME (rs,list_to_num_set (live ++ env)) in (Seq (Seq c1 (mk_ticks ticks (Call ret (SOME dest) vs (NONE :(num # dataLang$prog) option) :dataLang$prog))) c2,v,n2)))) ∧ (∀(n :num) (live :num list) (env :num list). (compile_list n env live ([] :bvi$exp list) :dataLang$prog # num list # num) = (Skip,([] :num list),n)) ∧ ∀(xs :bvi$exp list) (x :bvi$exp) (n :num) (live :num list) (env :num list). (compile_list n env live (x::xs) :dataLang$prog # num list # num) = (let ((c1 :dataLang$prog),(v1 :num),(n1 :num)) = (compile_sing n env F live x :dataLang$prog # num # num) in if NULL xs then (c1,[v1],n1) else (let ((c2 :dataLan