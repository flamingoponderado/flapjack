every_inst_ok_less_pan_to_crep_compile_exp=∀(ctxt :α context) (e :β panLang$exp) (es :β crepLang$exp list) (sh :shape). every_exp (λ(x :β panLang$exp). ∀(op :panop) (es :β panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num)) e ∧ (compile_exp ctxt e :β crepLang$exp list # shape) = (es,sh) ⇒ EVERY (every_exp (λ(x :β crepLang$exp). ∀(op :crepop) (es :β crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) es
compile_exp_def=(∀(ctxt :β context) (c :α word). (compile_exp ctxt (Const c :α panLang$exp) :α crepLang$exp list # shape) = ([(Const c :α crepLang$exp)],One)) ∧ (∀(vname :mlstring) (ctxt :β context). (compile_exp ctxt (Var Local vname :α panLang$exp) :α crepLang$exp list # shape) = case FLOOKUP ctxt.vars vname of (NONE :(shape # num list) option) => ([(Const (0w :α word) :α crepLang$exp)],One) | SOME (shape,ns) => (MAP (Var :num -> α crepLang$exp) ns,shape)) ∧ (∀(vname :mlstring) (ctxt :β context). (compile_exp ctxt (Var Global vname :α panLang$exp) :α crepLang$exp list # shape) = ([(Const (0w :α word) :α crepLang$exp)],One)) ∧ (∀(es :α panLang$exp list) (ctxt :β context). (compile_exp ctxt (RStruct es) :α crepLang$exp list # shape) = (let (cexps :(α crepLang$exp list # shape) list) = MAP (λ(a :α panLang$exp). (compile_exp ctxt a :α crepLang$exp list # shape)) es in (FLAT (MAP (FST :α crepLang$exp list # shape -> α crepLang$exp list) cexps),Comb (MAP (SND :α crepLang$exp list # shape -> shape) cexps)))) ∧ (∀(index :num) (e :α panLang$exp) (ctxt :β context). (compile_exp ctxt (RField index e) :α crepLang$exp list # shape) = (let ((cexp :α crepLang$exp list),(shape :shape)) = (compile_exp ctxt e :α crepLang$exp list # shape) in case shape of One => ([(Const (0w :α word) :α crepLang$exp)],One) | Comb shapes => comp_field index shapes cexp | Named v3 => ([(Const (0w :α word) :α crepLang$exp)],One))) ∧ (∀(nm :mlstring) (flds :(mlstring # α panLang$exp) list) (ctxt :β context). (compile_exp ctxt (NStruct nm flds) :α crepLang$exp list # shape) = ([(Const (0w :α word) :α crepLang$exp)],One)) ∧ (∀(fld :mlstring) (e :α panLang$exp) (ctxt :β context). (compile_exp ctxt (NField fld e) :α crepLang$exp list # shape) = ([(Const (0w :α word) :α crepLang$exp)],One)) ∧ (∀(sh :shape) (e :α panLang$exp) (ctxt :β context). (compile_exp ctxt (Load sh e :α panLang$exp) :α crepLang$exp list # shape) = (let ((cexp :α crepLang$exp list),(shape :shape)) = (compile_exp ctxt e :α crepLang$exp list # shape) in case cexp of ([] :α crepLang$exp list) => ([(Const (0w :α word) :α crepLang$exp)],One) | e::es => (load_shape (0w :α word) (size_of_shape sh) e,sh))) ∧ (∀(e :α panLang$exp) (ctxt :β context). (compile_exp ctxt (Load32 e :α panLang$exp) :α crepLang$exp list # shape) = (let ((cexp :α crepLang$exp list),(shape :shape)) = (compile_exp ctxt e :α crepLang$exp list # shape) in case (cexp,shape) of (([] :α crepLang$exp list),One) => ([(Const (0w :α word) :α crepLang$exp)],One) | (e::es,One) => ([(Load32 e :α crepLang$exp)],One) | (v,Comb v4) => ([(Const (0w :α word) :α crepLang$exp)],One) | (v,Named v5) => ([(Const (0w :α word) :α crepLang$exp)],One))) ∧ (∀(e :α panLang$exp) (ctxt :β context). (compile_exp ctxt (LoadByte e :α panLang$exp) :α crepLang$exp list # shape) = (let ((cexp :α crepLang$exp list),(shape :shape)) = (compile_exp ctxt e :α crepLang$exp list # shape) in case (cexp,shape) of (([] :α crepLang$exp list),One) => ([(Const (0w :α word) :α crepLang$exp)],One) | (e::es,One) => ([(LoadByte e :α crepLang$exp)],One) | (v,Comb v4) => ([(Const (0w :α word) :α crepLang$exp)],One) | (v,Named v5) => ([(Const (0w :α word) :α crepLang$exp)],One))) ∧ (∀(es :α panLang$exp list) (ctxt :β context) (bop :binop). (compile_exp ctxt (Op bop es) :α crepLang$exp list # shape) = (let (cexps :α crepLang$exp list list) = MAP (FST :α crepLang$exp list # shape -> α crepLang$exp list) (MAP (λ(a :α panLang$exp). (compile_exp ctxt a :α crepLang$exp list # shape)) es) in case cexp_heads cexps of (NONE :α crepLang$exp list option) => ([(Const (0w :α word) :α crepLang$exp)],One) | SOME es => ([Op bop es],One))) ∧ (∀(pop :panop) (es :α panLang$exp list) (ctxt :β context). (compile_exp ctxt (Panop pop es) :α crepLang$exp list # shape) = (let (cexps :α crepLang$exp list list) = MAP (FST :α crepLang$exp list # shape -> α crepLang$exp list) (MAP (λ(a :α panLang$exp). (compile_exp ctxt a :α crepLang$exp list # shape)) es) in case cexp_heads cexps of (NONE :α crepLang$exp list option) => ([(Const (0w :α word) :α crepLang$exp)],One) | SOME es => ([Crepop (compile_panop pop) es],One))) ∧ (∀(e' :α panLang$exp) (e :α panLang$exp) (ctxt :β context) (cmp :cmp). (compile_exp ctxt (Cmp cmp e e') :α crepLang$exp list # shape) = (let (ce :α crepLang$exp list) = FST (compile_exp ctxt e :α crepLang$exp list # shape); (ce' :α crepLang$exp list) = FST (compile_exp ctxt e' :α crepLang$exp list # shape) in case (ce,ce') of (([] :α crepLang$exp list),v1) => ([(Const (0w :α word) :α crepLang$exp)],One) | (e::es,([] :α crepLang$exp list)) => ([(Const (0w :α word) :α crepLang$exp)],One) | (e::es,e'::es') => ([Cmp cmp e e'],One))) ∧ (∀(sh :ast$shift) (e' :α panLang$exp) (e :α panLang$exp) (ctxt :β context). (compile_exp ctxt (Shift sh e e' :α panLang$exp) :α crepLang$exp list # shape) = (let (ce :α crepLang$exp list) = FST (compile_exp ctxt e :α crepLang$exp list # shape); (ce' :α crepLang$exp list) = FST (compile_exp ctxt e' :α crepLang$exp list # shape) in case (ce,ce') of (([] :α crepLang$exp list),v3) => ([(Const (0w :α word) :α crepLang$exp)],One) | (e::es,([] :α crepLang$exp list)) => ([(Const (0w :α word) :α crepLang$exp)],One) | (e::es,e'::es') => ([(Shift sh e e' :α crepLang$exp)],One))) ∧ (∀(ctxt :β context). (compile_exp ctxt (BaseAddr :α panLang$exp) :α crepLang$exp list # shape) = ([(BaseAddr :α crepLang$exp)],One)) ∧ (∀(ctxt :β context). (compile_exp ctxt (TopAddr :α panLang$exp) :α crepLang$exp list # shape) = ([(TopAddr :α crepLang$exp)],One)) ∧ ∀(ctxt :β context). (compile_exp ctxt (BytesInWord :α panLang$exp) :α crepLang$exp list # shape) = ([(Const (bytes_in_word :α word) :α crepLang$exp)],One)
