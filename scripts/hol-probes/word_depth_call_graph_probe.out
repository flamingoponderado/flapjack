max_depth_call_graph_lemma_typed=∀(prog :α prog) (s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state) (funs :(num # α prog) sptree$num_map) (n :num) (ns :num list) (funs2 :(num # α prog) sptree$num_map). evaluate (prog,s) = (res,s1) ∧ subspt funs funs2 ∧ subspt funs2 s.code ∧ s.locals_size = lookup n s.stack_size ∧ res ≠ SOME (Error :α result) ∧ MEM n ns ∧ ALL_DISTINCT ns ∧ set ns ⊆ (domain funs2 :num -> bool) ⇒ option_le s1.stack_max (OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack) (OPTION_MAP2 MAX (max_depth_graphs s.stack_size ns ns funs funs2) (max_depth s.stack_size (call_graph funs n ns (size funs2) prog))))) ∧ (max_depth_graphs s.stack_size ns ns funs funs2 ≠ (NONE :num option) ∧ max_depth s.stack_size (call_graph funs n ns (size funs2) prog) ≠ (NONE :num option) ⇒ s1.stack_size = s.stack_size ∧ (res = (NONE :α result option) ∨ (∃(k :num). res = SOME (Break k :α result)) ∨ (∃(k :num). res = SOME (Continue k :α result)) ⇒ s1.locals_size = s.locals_size))
max_depth_call_graph_typed=∀(prog :α prog) (s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state) (funs :(num # α prog) sptree$num_map) (n :num) (a :num). evaluate (prog,s) = (res,s1) ∧ subspt funs s.code ∧ lookup n funs = SOME (a,prog) ∧ s.locals_size = lookup n s.stack_size ∧ res ≠ SOME (Error :α result) ⇒ option_le s1.stack_max (OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack) (max_depth s.stack_size (full_call_graph n funs))))
max_depth_Call_NONE_typed=evaluate ((Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME (dest :num)) (args :num list) (NONE :(num # α prog # num # num) option) :α prog),(s :(α, β, γ) state)) = ((res :α result option),(s1 :(α, β, γ) state)) ∧ res ≠ SOME (Error :α result) ∧ subspt (funs :(num # α prog) sptree$num_map) s.code ⇒ option_le s1.stack_max (OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack) (max_depth s.stack_size (full_call_graph dest funs))))
