model_fetch_full_definition=∀_. Fetch _ = (λstate. (let v = PC state in if word_bit 0 v then (F_Error (Internal (FETCH_MISALIGNED v)),state) else (let (v0,s) = translateAddr (v,Instruction,Read) state in case v0 of NONE => (F_Error (Internal (FETCH_FAULT v)),s) | SOME pPC => (let (v0,s) = rawReadInst pPC s in (F_Result v0,(let (v1,s) = (let s0 = write'Delta (Delta s with exc_taken := F) s in (Delta s0,s0)); (v1,s) = (let s0 = write'Delta (v1 with fetch_exc := F) s in (Delta s0,s0)); (v1,s) = (let s0 = write'Delta (v1 with pc := v) s in (Delta s0,s0)); (v,s) = (let s0 = write'Delta (v1 with rinstr := v0) s in (Delta s0,s0)); (v,s) = (let s0 = write'Delta (v with addr := NONE) s in (Delta s0,s0)); (v,s) = (let s0 = write'Delta (v with data1 := NONE) s in (Delta s0,s0)); (v,s) = (let s0 = write'Delta (v with data2 := NONE) s in (Delta s0,s0)); (v,s) = (let s0 = write'Delta (v with fp_data := NONE) s in (Delta s0,s0)) in write'Delta (v with st_width := NONE) s))))))
model_fetch_full_type=:unit -> riscv_state -> FetchResult # riscv_state
model_fetch_odd_generic_equation=word_bit 0 (PC s) ⇒ Fetch () s = (F_Error (Internal (FETCH_MISALIGNED (PC s))),s)
