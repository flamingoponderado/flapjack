enc_lines_again_simp_ends_with_label=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (ls :α line list) (res :α line list)
    (ok :bool).
  enc_lines_again_simp labs ffis pos enc ls = (res,ok) ∧ ¬NULL ls ∧
  is_Label (LAST ls) ⇒
  ¬NULL res ∧ is_Label (LAST res)
enc_lines_again_simp_ends_with_label_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(ls :α line list)::α line list;(res :α line list)::α line list;(ok :bool)::bool;
enc_secs_again_ends_with_label=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (enc :α asm -> word8 list) (lines :α sec list) (res :α sec list)
    (ok :bool).
  enc_secs_again pos labs ffis enc lines = (res,ok) ∧
  EVERY (sec_ends_with_label :α sec -> bool) lines ⇒
  EVERY (sec_ends_with_label :α sec -> bool) res
enc_secs_again_ends_with_label_types=(pos :num)::num;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α sec list)::α sec list;(res :α sec list)::α sec list;(ok :bool)::bool;
enc_sec_list_ends_with_label=∀(enc :α asm -> word8 list) (code :α sec list).
  EVERY (sec_ends_with_label :α sec -> bool) code ⇒
  EVERY (sec_ends_with_label :α sec -> bool) (enc_sec_list enc code)
enc_sec_list_ends_with_label_types=(enc :α asm -> word8 list)::α asm -> word8 list;(code :α sec list)::α sec list;
sec_ends_with_label_def=∀(v0 :num) (ls :α line list).
  sec_ends_with_label (Section v0 ls) ⇔ ¬NULL ls ∧ is_Label (LAST ls)
sec_ends_with_label_def_types=(v0 :num)::num;(ls :α line list)::α line list;
