value_rel=v_rel (:γ) (:'ffi) (a :bvl$exp) (x :v) (y :v) (xs :α) (ys :v list) ⇔ case a of (Var n :bvl$exp) => LLOOKUP ys n = SOME x | (If v18 v19 v20 :bvl$exp) => F | (Let v21 v22 :bvl$exp) => F | (Raise v23 :bvl$exp) => F | (Handle v24 v25 :bvl$exp) => F | (Tick v26 :bvl$exp) => F | (Call v27 v28 v29 :bvl$exp) => F | (Force v30 v31 :bvl$exp) => F | (Op v32 v33 :bvl$exp) => x = y ∧ ∀(s :(γ, 'ffi) state) (env :v list). evaluate ([a],env,s) = ((Rval [x] :(v list, v) result),s)
env_rel=(∀(e2 :v list) (e1 :v list). env_rel (:γ) (:'ffi) ([] :bvl$exp option list) e1 e2 ⇔ e1 = e2) ∧ (∀(y :v) (x :v) (rest :bvl$exp option list) (e2 :v list) (e1 :v list). env_rel (:γ) (:'ffi) ((NONE :bvl$exp option)::rest) (x::e1) (y::e2) ⇔ x = y ∧ env_rel (:γ) (:'ffi) rest e1 e2) ∧ (∀(y :v) (x :v) (rest :bvl$exp option list) (e2 :v list) (e1 :v list) (a :bvl$exp). env_rel (:γ) (:'ffi) (SOME a::rest) (x::e1) (y::e2) ⇔ v_rel (:γ) (:'ffi) a x y (x::e1) (y::e2) ∧ env_rel (:γ) (:'ffi) rest e1 e2) ∧ (∀(v4 :v list) (v13 :bvl$exp option list) (v12 :bvl$exp option). env_rel (:γ) (:'ffi) (v12::v13) ([] :v list) v4 ⇔ F) ∧ ∀(v17 :v list) (v16 :v) (v13 :bvl$exp option list) (v12 :bvl$exp option). env_rel (:γ) (:'ffi) (v12::v13) (v16::v17) ([] :v list) ⇔ F
env_rel_length=∀(ax :bvl$exp option list) (env :v list) (env2 :v list). env_rel (:γ) (:'ffi) ax env env2 ⇒ LENGTH env2 = LENGTH env
env_rel_LLOOKUP_NONE_replay=∀(ax :bvl$exp option list) (env :v list) (env2 :v list) (n :num). env_rel (:γ) (:'ffi) ax env env2 ∧ (LLOOKUP ax n = (NONE :bvl$exp option option) ∨ LLOOKUP ax n = SOME (NONE :bvl$exp option)) ⇒ env2❲n❳ = env❲n❳
env_rel_LOOKUP_SOME_replay=∀(env :v list) (env2 :v list) (ax :bvl$exp option list) (x :bvl$exp) (n :num). env_rel (:γ) (:'ffi) ax env env2 ∧ LLOOKUP ax n = SOME (SOME x) ⇒ v_rel (:γ) (:'ffi) x env❲n❳ env2❲n❳ (DROP n env) (DROP n env2)
evaluate_delete_var_Rerr_SING=∀(x :bvl$exp) (s :(α, β) state) (r :(α, β) state) (e :v error_result) (env2 :v list). evaluate ([x],env2,s) = ((Rerr e :(v list, v) result),r) ∧ e ≠ (Rabort Rtype_error :v error_result) ⇒ evaluate ([delete_var x],env2,s) = ((Rerr e :(v list, v) result),r)
evaluate_delete_var_Rerr_replay=∀(xs :bvl$exp list) (s :(α, β) state) (r :(α, β) state) (e :v error_result) (env2 :v list). evaluate (xs,env2,s) = ((Rerr e :(v list, v) result),r) ∧ e ≠ (Rabort Rtype_error :v error_result) ⇒ evaluate (MAP delete_var xs,env2,s) = ((Rerr e :(v list, v) result),r)
evaluate_delete_var_Rval_replay=∀(xs :bvl$exp list) (env2 :v list) (s :(γ, 'ffi) state) (a :v list) (r :(γ, 'ffi) state) (ax :bvl$exp option list) (env :v list). evaluate (xs,env2,s) = ((Rval a :(v list, v) result),r) ∧ env_rel (:γ) (:'ffi) ax env env2 ⇒ ∃(b :v list). evaluate (MAP delete_var xs,env2,s) = ((Rval b :(v list, v) result),r) ∧ env_rel (:γ) (:'ffi) (extract_list xs ++ ax) (a ++ env) (b ++ env2)
dest_simple_eq_replay=dest_simple (h :bvl$exp) = SOME (y :int) ⇔ h = (Op (IntOp (Const y)) ([] :bvl$exp list) :bvl$exp)
case_op_const_eq_replay=case_op_const (exp :bvl$exp) = SOME (x :closLang$op # bvl$exp # int) ⇔ ∃(op :closLang$op) (x1 :bvl$exp) (n2 :int). x = (op,x1,n2) ∧ exp = (Op op [x1; (Op (IntOp (Const n2)) ([] :bvl$exp list) :bvl$exp)] :bvl$exp)
SmartOp2_thm_replay=evaluate ([(Op (op :closLang$op) [(x1 :bvl$exp); (x2 :bvl$exp)] :bvl$exp)],(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([SmartOp2 (op,x1,x2)],env,s) = (res,s2)
SmartOp_flip_thm_replay=((op' :closLang$op),(x1' :bvl$exp),(x2' :bvl$exp)) = SmartOp_flip (op :closLang$op) (x1 :bvl$exp) (x2 :bvl$exp) ∧ evaluate ([(Op op [x1; x2] :bvl$exp)],(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([(Op op' [x1'; x2'] :bvl$exp)],env,s) = (res,s2)
SmartOp1_thm=evaluate ([(Op (op :closLang$op) [(x :bvl$exp)] :bvl$exp)],(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([SmartOp1 op x],env,s) = (res,s2)
SmartOp_thm=evaluate ([(Op (op :closLang$op) (xs :bvl$exp list) :bvl$exp)],(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([(SmartOp op xs :bvl$exp)],env,s) = (res,s2)
evaluate_env_rel=∀(xs :bvl$exp list) (env1 :v list) (s1 :(γ, 'ffi) state) (ax :bvl$exp option list) (env2 :v list) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (ys :α). evaluate (xs,env1,s1) = (res,s2) ∧ env_rel (:γ) (:'ffi) ax env1 env2 ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ((compile ax xs :bvl$exp list),env2,s1) = (res,s2)
