ALOOKUP_eq_afindi_typed=ALOOKUP (xs :(β # α) list) (nm :β) = OPTION_MAP (λ(i :num). SND xs❲i❳) (afindi nm xs)
FEVERY_res_var_typed=FEVERY (P :α # β -> bool) (res_var (fmap :α |-> β) ((k :α),(opt_v :β option))) ⇔ FEVERY P (DRESTRICT fmap (COMPL {k})) ∧ ∀(v :β). opt_v = SOME v ⇒ P (k,v)
afindi_EL_typed=∀(xs :(α # β) list) (i :num). afindi (k :α) xs = SOME i ⇒ FST xs❲i❳ = k
afindi_MAP_eq_typed=∀(xs :(α # β) list). (∀(x :α) (y :β). MEM (x,y) xs ⇒ FST ((f :α # β -> α # γ) (x,y)) = x) ⇒ afindi (kx :α) (MAP f xs) = afindi kx xs
afindi_append_typed=∀(k :α) (xs :(α # β) list) (ys :(α # β) list). afindi k (xs ++ ys) = case afindi k xs of (NONE :num option) => OPTION_MAP ($+ (LENGTH xs)) (afindi k ys) | SOME i => SOME i
afindi_less_length_typed=∀(xs :(α # β) list) (n :num). afindi (kx :α) xs = SOME n ⇒ n < LENGTH xs
compile_correct_typed=∀(p :α panLang$prog) (s :(α, β) state) (res :α result option) (s' :(α, β) state) (ctxt :context). evaluate (p,s) = (res,s') ∧ ctxt.structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ∧ struct_infos_ok s.structs ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.globals ∧ res ≠ SOME (Error :α result) ⇒ evaluate (compile ctxt p,convert_s ctxt s) = (convert_res res,convert_s ctxt s') ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s'.structs v) s'.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s'.structs v) s'.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s'.globals ∧ (is_cont_res res ⇒ alist_to_fmap ctxt.locals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s'.locals) ∧ EVERY (v_flds_ok s'.structs :α v -> bool) (res_vs res) ∧ EVERY (is_wf_shape_v s'.structs :α v -> bool) (res_vs res)
compile_decls_correct_typed=∀(s :(α, β) state) (decs :α decl list) (ctxt :context) (decs' :α decl list) (ctxt' :context). evaluate_decls s decs = SOME (s' :(α, β) state) ∧ ctxt.structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ∧ ctxt.locals = ([] :(mlstring # shape) list) ∧ struct_infos_ok s.structs ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.globals ∧ compile_decs ctxt decs = (decs',ctxt') ⇒ evaluate_decls (convert_s ctxt' s) decs' = SOME (convert_s ctxt' s') ∧ ∃(gb :(mlstring # shape) list). ctxt' = ctxt with globals := gb ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s'.globals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s'.globals ∧ s'.structs = s.structs ∧ s'.locals = s.locals ∧ alist_to_fmap gb = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s'.globals
compile_exp_correct_typed=∀(s :(α, β) state) (e :α panLang$exp) (v :α v). eval s e = SOME v ∧ alist_to_fmap (ctxt :context).locals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.globals ∧ ctxt.structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt e = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt e) = SOME (convert_v v)
compile_shape_n_def_typed=(∀(sctxt :(mlstring # (α # shape) list) list) (n :num). compile_shape_n sctxt n One = One) ∧ (∀(shs :shape list) (sctxt :(mlstring # (α # shape) list) list) (n :num). compile_shape_n sctxt n (Comb shs) = Comb (MAP (λ(a :shape). compile_shape_n sctxt n a) shs)) ∧ ∀(sctxt :(mlstring # (α # shape) list) list) (nm :mlstring) (n :num). compile_shape_n sctxt n (Named nm) = case afindi nm (DROP n sctxt) of (NONE :num option) => One | SOME j => (let ((nm' :mlstring),(flds :(α # shape) list)) = sctxt❲n + j❳ in Comb (MAP (λ(a :shape). compile_shape_n sctxt (n + j + (1 :num)) a) (MAP (SND :α # shape -> shape) flds)))
compile_shape_n_eq_typed=∀(sctxt :(mlstring # (α # shape) list) list) (n :num) (sh :shape). compile_shape_n sctxt n sh = compile_shape (DROP n sctxt) sh
compile_shape_n_no_name_typed=∀(ctxt :(mlstring # (α # shape) list) list) (n :num) (sh :shape). is_wf_shape_nil (compile_shape_n ctxt n sh)
compile_shape_no_name_typed=∀(ctxt :(mlstring # (α # shape) list) list) (sh :shape). is_wf_shape_nil (compile_shape ctxt sh)
compile_shapes_eq_map_typed=∀(shs :shape list). compile_shapes (sctxt :(mlstring # (α # shape) list) list) shs = MAP (compile_shape sctxt) shs
compile_top_no_names_typed=EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) (compile_top (pan_code :α decl list))
compile_top_semantics_decls_typed=semantics_decls (s :(α, β) state) (start :mlstring) (code :α decl list) ≠ Fail ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ s.globals = (FEMPTY :mlstring |-> α v) ⇒ semantics_decls s start code = semantics_decls (s with eshapes := FMAP_MAP2 (λ((eid :mlstring),(sh :shape)). compile_shape (get_names <|structs := ([] :(mlstring # (mlstring # shape) list) list)|> code).structs sh) s.eshapes) start (compile_top code)
convert_code_def_typed=∀(ctxt :context). (convert_code ctxt :(α |-> (mlstring # shape) list # β panLang$prog # shape) -> (α |-> (mlstring # shape) list # β panLang$prog # shape)) = FMAP_MAP2 (λ((nm :α),(params :(mlstring # shape) list),(prog :β panLang$prog),(rshape :shape)). (MAP ((I :mlstring -> mlstring) ## compile_shape ctxt.structs) params,compile (ctxt with locals := params) prog,compile_shape ctxt.structs rshape))
convert_eshapes_def_typed=∀(str_ctxt :(mlstring # (β # shape) list) list). (convert_eshapes str_ctxt :(α |-> shape) -> (α |-> shape)) = FMAP_MAP2 (λ((eid :α),(sh :shape)). compile_shape str_ctxt sh)
convert_res_def_typed=convert_res (SOME (Break :α result)) = SOME (Break :α result) ∧ convert_res (SOME (Return (v :α v) :α result)) = SOME (Return (convert_v v) :α result) ∧ convert_res (SOME (Exception (eid :mlstring) (ev :α v))) = SOME (Exception eid (convert_v ev)) ∧ convert_res (NONE :α result option) = (NONE :α result option) ∧ convert_res (SOME (Error :α result)) = SOME (Error :α result) ∧ convert_res (SOME (TimeOut :α result)) = SOME (TimeOut :α result) ∧ convert_res (SOME (Continue :α result)) = SOME (Continue :α result) ∧ convert_res (SOME (FinalFFI (v6 :final_event) :α result)) = SOME (FinalFFI v6 :α result)
convert_s_def_typed=∀(ctxt :context) (s :(α, β) state). convert_s ctxt s = s with <|locals := FMAP_MAP2 (λ((nm :mlstring),(v :α v)). convert_v v) s.locals; globals := FMAP_MAP2 (λ((nm :mlstring),(v :α v)). convert_v v) s.globals; structs := ([] :(mlstring # struct_info) list); code := convert_code ctxt s.code; eshapes := convert_eshapes ctxt.structs s.eshapes|>
convert_v_def_typed=(∀(x :α word_lab). convert_v (Val x) = Val x) ∧ (∀(xs :α v list). convert_v (RStruct xs) = RStruct (MAP (λ(a :α v). convert_v a) xs)) ∧ ∀(nm :mlstring) (flds :(mlstring # α v) list). convert_v (NStruct nm flds) = (let (vs :α v list) = MAP (λ((nm' :mlstring),(v :α v)). convert_v v) flds in RStruct vs)
decs_stcnames_compile_decs_typed=∀(ctxt :context) (decs :α decl list). decs_stcnames (acc :(mlstring # struct_info) list) (FST (compile_decs ctxt decs)) = SOME acc
decs_stcnames_infos_ok_typed=∀(acc :(mlstring # struct_info) list) (code :α decl list) (res :(mlstring # struct_info) list) (ctxt :β). decs_stcnames acc code = SOME res ∧ struct_infos_ok acc ⇒ struct_infos_ok res
decs_stcnames_to_get_names_typed=∀(acc :(mlstring # struct_info) list) (code :α decl list) (res :(mlstring # struct_info) list) (ctxt :context). decs_stcnames acc code = SOME res ∧ ctxt.structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) acc ⇒ get_names ctxt code = ctxt with structs := MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) res
dropWhile_MAP_helper_typed=∀(xs :α list). dropWhile (P :α -> bool) xs = (ys :α list) ∧ (∀(x :α). MEM x xs ⇒ (P x ⇔ (Q :β -> bool) ((f :α -> β) x))) ⇒ dropWhile Q (MAP f xs) = MAP f ys
dropWhile_afindi_typed=dropWhile (λ((k :α),(v :β)). k ≠ (kx :α)) (xs :(α # β) list) = case afindi kx xs of (NONE :num option) => ([] :(α # β) list) | SOME n => DROP n xs
fields_in_order_reorder_noop_typed=∀(eflds :(mlstring # α panLang$exp) list) (info_fields :(mlstring # β) list). MAP (FST :mlstring # β -> mlstring) info_fields = MAP (FST :mlstring # α panLang$exp -> mlstring) eflds ∧ ALL_DISTINCT (MAP (FST :mlstring # β -> mlstring) info_fields) ⇒ FLAT (MAP (λ((nm' :mlstring),(sh :β)). case ALOOKUP (compile_fields (ctxt :context) eflds) nm' of (NONE :α panLang$exp option) => ([] :α panLang$exp list) | SOME e => [e]) info_fields) = MAP ((compile_exp ctxt :α panLang$exp -> α panLang$exp) ∘ (SND :mlstring # α panLang$exp -> α panLang$exp)) eflds
flatten_convert_v_typed=∀(v :α v). flatten (convert_v v) = flatten v
is_cont_res_def_typed=(is_cont_res (NONE :α result option) ⇔ T) ∧ (is_cont_res (SOME (Break :α result)) ⇔ T) ∧ (is_cont_res (SOME (Continue :α result)) ⇔ T) ∧ (is_cont_res (SOME (Error :α result)) ⇔ F) ∧ (is_cont_res (SOME (TimeOut :α result)) ⇔ F) ∧ (is_cont_res (SOME (Return (v2 :α v) :α result)) ⇔ F) ∧ (is_cont_res (SOME (Exception (v3 :mlstring) (v4 :α v))) ⇔ F) ∧ (is_cont_res (SOME (FinalFFI (v5 :final_event) :α result)) ⇔ F)
is_wf_shape_compile_shape_typed=(∀(sh_ctxt :(mlstring # (mlstring # shape) list) list) (sh :shape). is_wf_shape (str_ctxt :(mlstring # α) list) (compile_shape sh_ctxt sh)) ∧ ∀(sh_ctxt :(mlstring # (mlstring # shape) list) list) (shs :shape list). EVERY (is_wf_shape str_ctxt) (compile_shapes sh_ctxt shs)
is_wf_shape_drop_typed=∀(sh_ctxt :(mlstring # α) list) (sh :shape) (n :num). is_wf_shape (DROP n sh_ctxt) sh ⇒ is_wf_shape sh_ctxt sh
mem_load_conversion_typed=∀(str2 :(mlstring # (mlstring # shape) list) list) (n :num) (shape :shape) (x :α word) (v :α v). mem_load shape x (madd :α word -> bool) (memry :α word -> α word_lab) (DROP n (str_ctxt :(mlstring # struct_info) list)) = SOME v ∧ str2 = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) str_ctxt ∧ is_wf_shape (DROP n str_ctxt) shape ∧ struct_infos_ok str_ctxt ⇒ mem_load (compile_shape_n str2 n shape) x madd memry ([] :(mlstring # struct_info) list) = SOME (convert_v v) ∧ v_flds_ok str_ctxt v
mem_load_flds_eq_typed=∀(fld_shs :(mlstring # shape) list) (vflds :(mlstring # α v) list) (x :α word). mem_load_flds fld_shs x (madd :α word -> bool) (memry :α word -> α word_lab) (stcs :(mlstring # struct_info) list) = SOME vflds ⇒ ∃(vs :α v list). mem_loads (MAP (SND :mlstring # shape -> shape) fld_shs) x madd memry stcs = SOME vs ∧ LENGTH vs = LENGTH fld_shs ∧ vflds = ZIP (MAP (FST :mlstring # shape -> mlstring) fld_shs,vs)
mem_loads_EL_typed=∀(shs :shape list) (vs :α v list) (x :α word) (i :num). mem_loads shs x (madd :α word -> bool) (memry :α word -> α word_lab) (stcs :(mlstring # struct_info) list) = SOME vs ∧ i < LENGTH shs ⇒ ∃(y :α word). mem_load shs❲i❳ y madd memry stcs = SOME vs❲i❳
mem_loads_mem_typed=∀(shs :shape list) (vs :α v list) (x :α word). mem_loads shs x (madd :α word -> bool) (memry :α word -> α word_lab) (stcs :(mlstring # struct_info) list) = SOME vs ∧ MEM (v :α v) vs ⇒ ∃(sh :shape) (y :α word). MEM sh shs ∧ mem_load sh y madd memry stcs = SOME v
opt_mmap_eq_some_el_typed=∀(xs :α list) (ys :β list). OPT_MMAP (f :α -> β option) xs = SOME ys ⇔ LENGTH xs = LENGTH ys ∧ ∀(n :num). n < LENGTH ys ⇒ f xs❲n❳ = SOME ys❲n❳
res_var_FMAP_MAP2_rev_typed=FMAP_MAP2 (f :α # γ -> β) (res_var (fmap :α |-> γ) ((nm :α),(x :γ option))) = res_var (FMAP_MAP2 f fmap) (nm,OPTION_MAP (λ(y :γ). f (nm,y)) x)
res_vs_def_typed=res_vs (SOME (Return (v :α v) :α result)) = [v] ∧ res_vs (SOME (Exception (eid :mlstring) (ev :α v))) = [ev] ∧ res_vs (NONE :α result option) = ([] :α v list) ∧ res_vs (SOME (Error :α result)) = ([] :α v list) ∧ res_vs (SOME (TimeOut :α result)) = ([] :α v list) ∧ res_vs (SOME (Break :α result)) = ([] :α v list) ∧ res_vs (SOME (Continue :α result)) = ([] :α v list) ∧ res_vs (SOME (FinalFFI (v6 :final_event) :α result)) = ([] :α v list)
semantics_eq_typed=semantics (s :(α, β) state) (start :mlstring) ≠ Fail ∧ (ctxt :context).structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ∧ ctxt.locals = ([] :(mlstring # shape) list) ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.globals ∧ struct_infos_ok s.structs ⇒ semantics (convert_s ctxt s) start = semantics s start
shape_of_convert_v_typed=∀(v :α v) (str_ctxt :(mlstring # (mlstring # shape) list) list) (n :β). v_flds_ok (ctxt :(mlstring # struct_info) list) v ∧ str_ctxt = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) ctxt ∧ is_wf_shape_v ctxt v ∧ struct_infos_ok ctxt ⇒ compile_shape str_ctxt (shape_of v) = shape_of (convert_v v)
size_of_compile_shape_typed=is_wf_shape (ctxt :(mlstring # struct_info) list) (sh :shape) ∧ struct_infos_ok ctxt ⇒ size_of_sh_with_ctxt ([] :(mlstring # struct_info) list) (compile_shape (MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) ctxt) sh) = size_of_sh_with_ctxt ctxt sh
size_of_sh_with_ctxt_drop_typed=∀(sh_ctxt :(mlstring # struct_info) list) (sh :shape). is_wf_shape (DROP (n :num) sh_ctxt) sh ∧ ALL_DISTINCT (MAP (FST :mlstring # struct_info -> mlstring) sh_ctxt) ⇒ size_of_sh_with_ctxt (DROP n sh_ctxt) sh = size_of_sh_with_ctxt sh_ctxt sh
size_of_shape_compile_pass_eq_typed=struct_infos_ok (s :(α, β) state).structs ∧ is_wf_shape s.structs (shape :shape) ∧ (str_ctxt :(mlstring # (mlstring # shape) list) list) = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ⇒ size_of_shape (compile_shape str_ctxt shape) = size_of_sh_with_ctxt s.structs shape
struct_infos_ok_append_typed=struct_infos_ok ((xs :(mlstring # struct_info) list) ++ (ys :(mlstring # struct_info) list)) ⇒ struct_infos_ok ys
struct_infos_ok_cons_typed=struct_infos_ok (xs :(mlstring # struct_info) list) ∧ ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) (info :struct_info).fields) ∧ ¬MEM (nm :mlstring) (MAP (FST :mlstring # struct_info -> mlstring) xs) ∧ EVERY (is_wf_shape xs) (MAP (SND :mlstring # shape -> shape) info.fields) ∧ info.size = size_of_sh_with_ctxt xs (Comb (MAP (SND :mlstring # shape -> shape) info.fields)) ⇒ struct_infos_ok ((nm,info)::xs)
struct_infos_ok_def_typed=∀(sh_ctxt :(mlstring # struct_info) list). struct_infos_ok sh_ctxt ⇔ EVERY (λ((nm :mlstring),(info :struct_info)). ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) info.fields)) sh_ctxt ∧ ALL_DISTINCT (MAP (FST :mlstring # struct_info -> mlstring) sh_ctxt) ∧ (∀(i :num) (nm :mlstring) (info :struct_info). i < LENGTH sh_ctxt ∧ sh_ctxt❲i❳ = (nm,info) ⇒ EVERY (is_wf_shape (DROP (i + (1 :num)) sh_ctxt)) (MAP (SND :mlstring # shape -> shape) info.fields)) ∧ EVERY (λ((nm :mlstring),(info :struct_info)). info.size = size_of_sh_with_ctxt sh_ctxt (Comb (MAP (SND :mlstring # shape -> shape) info.fields))) sh_ctxt
struct_infos_ok_drop_typed=struct_infos_ok (sh_ctxt :(mlstring # struct_info) list) ⇒ struct_infos_ok (DROP (n :num) sh_ctxt)
v_flds_ok_append_typed=∀(ctxt :(mlstring # struct_info) list) (v :α v). v_flds_ok ctxt v ∧ ALL_DISTINCT (MAP (FST :mlstring # struct_info -> mlstring) (pfx :(mlstring # struct_info) list) ++ MAP (FST :mlstring # struct_info -> mlstring) ctxt) ⇒ v_flds_ok (pfx ++ ctxt) v
v_flds_ok_def_typed=(∀(x :α word_lab) (v0 :(mlstring # struct_info) list). v_flds_ok v0 (Val x) ⇔ T) ∧ (∀(vs :α v list) (ctxt :(mlstring # struct_info) list). v_flds_ok ctxt (RStruct vs) ⇔ EVERY (λ(a :α v). v_flds_ok ctxt a) vs) ∧ ∀(nm :mlstring) (flds :(mlstring # α v) list) (ctxt :(mlstring # struct_info) list). v_flds_ok ctxt (NStruct nm flds) ⇔ EVERY (λ((nm' :mlstring),(v :α v)). v_flds_ok ctxt v) flds ∧ case ALOOKUP ctxt nm of (NONE :struct_info option) => F | SOME info => MAP (FST :mlstring # α v -> mlstring) flds = MAP (FST :mlstring # shape -> mlstring) info.fields ∧ MAP ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) flds = MAP (SND :mlstring # shape -> shape) info.fields
UNCURRY_EQ_o_SND_typed=UNCURRY (λ(x :α). (f :β -> γ)) = f ∘ (SND :α # β -> β)
alookup_drop_helper_typed=ALOOKUP (DROP (n :num) (xs :(β # α) list)) (k :β) = SOME (v :α) ∧ ALL_DISTINCT (MAP (FST :β # α -> β) xs) ⇒ ¬MEM k (MAP (FST :β # α -> β) (TAKE n xs)) ∧ ALOOKUP xs k = SOME v
alookup_map_structs_ok_typed=ALOOKUP (s_ctxt :(mlstring # struct_info) list) (nm :mlstring) = SOME (info :struct_info) ∧ struct_infos_ok s_ctxt ⇒ ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) info.fields)
compile_decs_no_names_typed=∀(ctxt :context) (decs :α decl list). EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) (FST (compile_decs ctxt decs))
compile_decs_structs_typed=∀(ctxt :context) (decs :α decl list) (decs' :α decl list) (ctxt' :context). compile_decs ctxt decs = (decs',ctxt') ⇒ ctxt'.structs = ctxt.structs
compile_exp_correct_mmap_helper_typed=∀(es :α panLang$exp list) (vs :α v list). OPT_MMAP (eval (s :(α, β) state)) es = SOME vs ∧ (∀(e :α panLang$exp). MEM e es ⇒ ∀(v :α v). eval s e = SOME v ⇒ eval (convert_s (ctxt :context) s) (compile_exp ctxt e) = SOME (convert_v v)) ⇒ OPT_MMAP (eval (convert_s ctxt s)) (compile_exps ctxt es) = SOME (MAP (convert_v :α v -> α v) vs)
convert_code_locals_upd_typed=convert_code ((ctxt :context) with locals updated_by (f :(mlstring # shape) list -> (mlstring # shape) list)) (code :α |-> (mlstring # shape) list # β panLang$prog # shape) = convert_code ctxt code
convert_res_eq_case1_typed=convert_res (res :α result option) = case res of (NONE :α result option) => (NONE :α result option) | SOME (Error :α result) => convert_res (SOME (Error :α result)) | SOME (TimeOut :α result) => convert_res (SOME (TimeOut :α result)) | SOME (Break :α result) => convert_res (SOME (Break :α result)) | SOME (Continue :α result) => convert_res (SOME (Continue :α result)) | SOME (Return v5 :α result) => convert_res (SOME (Return v5 :α result)) | SOME (Exception v6 v7) => convert_res (SOME (Exception v6 v7)) | SOME (FinalFFI v8 :α result) => convert_res (SOME (FinalFFI v8 :α result))
evaluate_structs_code_inv_typed=evaluate ((p :α panLang$prog),(s :(α, β) state)) = ((res :α result option),(s' :(α, β) state)) ⇒ s'.structs = s.structs ∧ s'.code = s.code
every_convert_v_eq_typed=EVERY (λ(w :α v). case w of Val v4 => T | RStruct v5 => F | NStruct v6 v7 => F) (vs :α v list) ⇒ MAP (convert_v :α v -> α v) vs = vs
fupdate_elim2_typed=FLOOKUP (fm :β |-> α) (x :β) = SOME (y :α) ⇒ fm⟨x ↦ y⟩ = fm
is_cont_res_eq_disj_typed=is_cont_res (res :α result option) ⇔ res = (NONE :α result option) ∨ res = SOME (Break :α result) ∨ res = SOME (Continue :α result)
lookup_code_flds_ok_typed=OPT_MMAP (eval (s :(α, β) state)) (argexps :α panLang$exp list) = SOME (args :α v list) ∧ lookup_code s.code (fname :mlstring) args = SOME ((prog :α panLang$prog),(newlocals :mlstring |-> α v),(rshape :shape)) ∧ alist_to_fmap (ctxt :context).locals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) s.globals ∧ ctxt.structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ OPT_MMAP (eval (convert_s ctxt s)) (compile_exps ctxt argexps) = SOME (MAP (convert_v :α v -> α v) args) ∧ EVERY (λ(v :α v). v_flds_ok s.structs v) args ∧ (∃(new_l :(mlstring # shape) list). lookup_code (convert_s ctxt s).code fname (MAP (convert_v :α v -> α v) args) = SOME (compile (ctxt with locals := new_l) prog,FMAP_MAP2 (λ((nm :mlstring),(v :α v)). convert_v v) newlocals,compile_shape ctxt.structs rshape) ∧ alist_to_fmap new_l = FMAP_MAP2 ((shape_of :α v -> shape) ∘ (SND :mlstring # α v -> α v)) newlocals) ∧ FEVERY (λ((nm :mlstring),(v :α v)). v_flds_ok s.structs v) newlocals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) newlocals
map_fst_eq_alookup_typed=∀(xs :(α # β) list) (ys :(α # γ) list). MAP (FST :α # β -> α) xs = MAP (FST :α # γ -> α) ys ∧ ALOOKUP xs (nm :α) = SOME (v :β) ⇒ ∃(i :num). afindi nm xs = SOME i ∧ afindi nm ys = SOME i ∧ i < LENGTH xs ∧ i < LENGTH ys ∧ v = SND xs❲i❳ ∧ ALOOKUP ys nm = SOME (SND ys❲i❳)
map_uncurry_zip_again_typed=LENGTH (xs :α list) = LENGTH (ys :β list) ⇒ MAP (λ((x :α),(y :β)). ((f :α -> γ) x,(g :β -> δ) y)) (ZIP (xs,ys)) = ZIP (MAP f xs,MAP g ys)
mem_loads_convert_helper_typed=∀(shs :shape list) (vs :α v list) (x :α word). mem_loads shs x (madd :α word -> bool) (memry :α word -> α word_lab) (stcs :(mlstring # struct_info) list) = SOME vs ∧ (∀(sh :shape) (y :α word) (v :α v). MEM sh shs ∧ mem_load sh y madd memry stcs = SOME v ⇒ size_of_sh_with_ctxt (stcs2 :(mlstring # struct_info) list) ((f :shape -> shape) sh) = size_of_sh_with_ctxt stcs sh ∧ mem_load (f sh) y madd memry stcs2 = SOME (convert_v v)) ⇒ mem_loads (MAP f shs) x madd memry stcs2 = SOME (MAP (convert_v :α v -> α v) vs)
opt_mmap_eq_every_typed=OPT_MMAP (f :β -> α option) (xs :β list) = SOME (ys :α list) ∧ (∀(x :β) (y :α). MEM x xs ∧ f x = SOME y ⇒ (P :α -> bool) y) ⇒ EVERY P ys
shape_of_convert_v_ind_typed=∀(str_ctxt :(mlstring # (mlstring # shape) list) list) (n :num) (sh :shape) (v :α v). struct_infos_ok (ctxt :(mlstring # struct_info) list) ∧ is_wf_shape (DROP n ctxt) sh ∧ v_flds_ok ctxt v ∧ str_ctxt = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) ctxt ∧ shape_of v = sh ⇒ compile_shape_n str_ctxt n sh = shape_of (convert_v v)
size_of_compile_shape_n_typed=∀(sh_ctxt :(mlstring # (mlstring # shape) list) list) (n :num) (sh :shape). sh_ctxt = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) (ctxt :(mlstring # struct_info) list) ∧ is_wf_shape (DROP n ctxt) sh ∧ struct_infos_ok ctxt ⇒ size_of_sh_with_ctxt ([] :(mlstring # struct_info) list) (compile_shape_n sh_ctxt n sh) = size_of_sh_with_ctxt ctxt sh
mem_load_conversion_inst_typed=∀(str2 :(mlstring # (mlstring # shape) list) list) (n :num) (shape :shape) (x :α word) (v :α v). mem_load shape x (madd :α word -> bool) (memry :α word -> α word_lab) (DROP n (str_ctxt :(mlstring # struct_info) list)) = SOME v ∧ str2 = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) str_ctxt ∧ is_wf_shape (DROP n str_ctxt) shape ∧ struct_infos_ok str_ctxt ⇒ mem_load (compile_shape_n str2 n shape) x madd memry ([] :(mlstring # struct_info) list) = SOME (convert_v v) ∧ v_flds_ok str_ctxt v
shape_of_convert_v_rev_typed=∀(v :α v) (str_ctxt :(mlstring # (mlstring # shape) list) list) (n :β). v_flds_ok (ctxt :(mlstring # struct_info) list) v ∧ str_ctxt = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) ctxt ∧ is_wf_shape_v ctxt v ∧ struct_infos_ok ctxt ⇒ compile_shape str_ctxt (shape_of v) = shape_of (convert_v v)
