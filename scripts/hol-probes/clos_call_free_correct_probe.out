free_def_typed=free ([] :closLang$exp list) = (([] :closLang$exp list),Empty) /\ (!(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). free (x::y::xs) = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x]; ((c2 :closLang$exp list),(l2 :db_var_set)) = free (y::xs) in (c1 ++ c2,mk_Union l1 l2))) /\ (!(v :num) (t :tra). free [(Var t v :closLang$exp)] = ([(Var t v :closLang$exp)],(Var v :db_var_set))) /\ (!(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). free [(If t x1 x2 x3 :closLang$exp)] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x1]; ((c2 :closLang$exp list),(l2 :db_var_set)) = free [x2]; ((c3 :closLang$exp list),(l3 :db_var_set)) = free [x3] in ([(If t (HD c1) (HD c2) (HD c3) :closLang$exp)],mk_Union l1 (mk_Union l2 l3)))) /\ (!(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). free [(Let t xs x2 :closLang$exp)] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free xs; ((c2 :closLang$exp list),(l2 :db_var_set)) = free [x2] in ([(Let t c1 (HD c2) :closLang$exp)],mk_Union l1 (Shift (LENGTH xs) l2 :db_var_set)))) /\ (!(x1 :closLang$exp) (t :tra). free [(Raise t x1 :closLang$exp)] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x1] in ([(Raise t (HD c1) :closLang$exp)],l1))) /\ (!(x1 :closLang$exp) (t :tra). free [Tick t x1] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x1] in ([Tick t (HD c1)],l1))) /\ (!(xs :closLang$exp list) (t :tra) (op :closLang$op). free [Op t op xs] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free xs in ([Op t op c1],l1))) /\ (!(xs2 :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). free [(App t loc_opt x1 xs2 :closLang$exp)] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x1]; ((c2 :closLang$exp list),(l2 :db_var_set)) = free xs2 in ([(App t loc_opt (HD c1) c2 :closLang$exp)],mk_Union l1 l2))) /\ (!(x1 :closLang$exp) (v0 :num list option) (t :mlstring) (num_args :num) (loc :num option). free [Fn t loc v0 num_args x1] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x1]; (l2 :db_var_set) = (Shift num_args l1 :db_var_set) in ([Fn t loc (SOME (vars_to_list l2)) num_args (HD c1)],l2))) /\ (!(x1 :closLang$exp) (v1 :num list option) (t :mlstring list) (loc :num option) (fns :(num # closLang$exp) list). free [(Letrec t loc v1 fns x1 :closLang$exp)] = (let (m :num) = LENGTH fns; (res :((num # closLang$exp) # db_var_set) list) = MAP (\((n :num),(x :closLang$exp)). (let ((c :closLang$exp list),(l :db_var_set)) = free [x] in ((n,HD c),(Shift (n + m) l :db_var_set)))) fns; (c1 :(num # closLang$exp) list) = MAP (FST :(num # closLang$exp) # db_var_set -> num # closLang$exp) res; (l1 :db_var_set) = list_mk_Union (MAP (SND :(num # closLang$exp) # db_var_set -> db_var_set) res); ((c2 :closLang$exp list),(l2 :db_var_set)) = free [x1] in ([(Letrec t loc (SOME (vars_to_list l1)) c1 (HD c2) :closLang$exp)],mk_Union l1 (Shift (LENGTH fns) l2 :db_var_set)))) /\ (!(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). free [(Handle t x1 x2 :closLang$exp)] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free [x1]; ((c2 :closLang$exp list),(l2 :db_var_set)) = free [x2] in ([(Handle t (HD c1) (HD c2) :closLang$exp)],mk_Union l1 (Shift (1 :num) l2 :db_var_set)))) /\ !(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). free [Call t ticks dest xs] = (let ((c1 :closLang$exp list),(l1 :db_var_set)) = free xs in ([Call t ticks dest c1],l1))
closed_def_typed=!(x :closLang$exp). (closed x :bool) <=> isEmpty (db_to_set (SND (free [x])))
free_thm=!(xs :closLang$exp list). (let ((ys :closLang$exp list),(l :db_var_set)) = free xs in !(n :num). (fv n ys <=> has_var n l) /\ (fv n xs <=> has_var n l))
closed_fn=(closed (Fn (t :mlstring) (loco :num option) (vs :num list option) (args :num) (e :closLang$exp)) :bool) <=> !(v :num). has_var v (SND (free [e])) ==> v < args
closed_fn_fv=(closed (Fn (t :mlstring) (loco :num option) (vs :num list option) (args :num) (e :closLang$exp)) :bool) <=> !(v :num). fv v [e] ==> v < args
closed_cases=(T,F,T,F)
group_cases=(T,F,F)
