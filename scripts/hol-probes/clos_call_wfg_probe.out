subg_type=:'a sptree$num_map # ('b # 'c) list -> 'a sptree$num_map # ('b # 'c) list -> bool
subg_def=!(g0 :'a sptree$num_map # ('b # 'c) list) (g1 :'a sptree$num_map # ('b # 'c) list). subg g0 g1 <=> subspt (FST g0) (FST g1) /\ (!(k :'b) (v :'c). ALOOKUP (SND g0) k = SOME v ==> ALOOKUP (SND g1) k = SOME v) /\ ALL_DISTINCT (MAP (FST :'b # 'c -> 'b) (SND g1))
subg_refl=!(g :'a sptree$num_map # ('b # 'c) list). ALL_DISTINCT (MAP (FST :'b # 'c -> 'b) (SND g)) ==> subg g g
subg_trans=!(g1 :'a sptree$num_map # ('b # 'c) list) (g2 :'a sptree$num_map # ('b # 'c) list) (g3 :'a sptree$num_map # ('b # 'c) list). subg g1 g2 /\ subg g2 g3 ==> subg g1 g3
calls_subg=!(xs :closLang$exp list) (g0 :sptree$num_set # (num # num # closLang$exp) list) (ys :closLang$exp list) (g :sptree$num_set # (num # num # closLang$exp) list). calls xs g0 = (ys,g) /\ ALL_DISTINCT (MAP (FST :num # num # closLang$exp -> num) (SND g0)) /\ ALL_DISTINCT (code_locs xs) /\ DISJOINT (IMAGE SUC (set (code_locs xs))) (set (MAP (FST :num # num # closLang$exp -> num) (SND g0))) ==> subg g0 g
code_locs_type=:closLang$exp list -> num list
code_locs_def=code_locs ([] :closLang$exp list) = ([] :num list) /\ (!(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). code_locs (x::y::xs) = (let (c1 :num list) = code_locs [x]; (c2 :num list) = code_locs (y::xs) in c1 ++ c2)) /\ (!(v0 :tra) (v :num). code_locs [(Var v0 v :closLang$exp)] = ([] :num list)) /\ (!(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (v1 :tra). code_locs [(If v1 x1 x2 x3 :closLang$exp)] = (let (c1 :num list) = code_locs [x1]; (c2 :num list) = code_locs [x2]; (c3 :num list) = code_locs [x3] in c1 ++ c2 ++ c3)) /\ (!(xs :closLang$exp list) (x2 :closLang$exp) (v2 :tra). code_locs [(Let v2 xs x2 :closLang$exp)] = (let (c1 :num list) = code_locs xs; (c2 :num list) = code_locs [x2] in c1 ++ c2)) /\ (!(x1 :closLang$exp) (v3 :tra). code_locs [(Raise v3 x1 :closLang$exp)] = code_locs [x1]) /\ (!(x1 :closLang$exp) (v4 :tra). code_locs [Tick v4 x1] = code_locs [x1]) /\ (!(xs :closLang$exp list) (v5 :tra) (op :closLang$op). code_locs [Op v5 op xs] = code_locs xs) /\ (!(xs :closLang$exp list) (x1 :closLang$exp) (v6 :tra) (loc_opt :num option). code_locs [(App v6 loc_opt x1 xs :closLang$exp)] = (let (c1 :num list) = code_locs [x1]; (c2 :num list) = code_locs xs in c1 ++ c2)) /\ (!(x1 :closLang$exp) (vs :num list option) (v7 :mlstring) (num_args :num) (loc_opt :num option). code_locs [Fn v7 loc_opt vs num_args x1] = (let (loc :num) = case loc_opt of (NONE :num option) => (0 :num) | SOME n => n; (c1 :num list) = code_locs [x1] in c1 ++ [loc])) /\ (!(x1 :closLang$exp) (vs :num list option) (v8 :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). code_locs [(Letrec v8 loc_opt vs fns x1 :closLang$exp)] = (let (loc :num) = case loc_opt of (NONE :num option) => (0 :num) | SOME n => n; (c1 :num list) = code_locs (MAP (SND :num # closLang$exp -> closLang$exp) fns); (c2 :num list) = code_locs [x1] in c1 ++ GENLIST (\(n :num). loc + (2 :num) * n) (LENGTH fns) ++ c2)) /\ (!(x2 :closLang$exp) (x1 :closLang$exp) (v9 :tra). code_locs [(Handle v9 x1 x2 :closLang$exp)] = (let (c1 :num list) = code_locs [x1]; (c2 :num list) = code_locs [x2] in c1 ++ c2)) /\ !(xs :closLang$exp list) (v10 :tra) (ticks :num) (dest :num). code_locs [Call v10 ticks dest xs] = code_locs xs
recclosure_wf_def=!(loc :num) (fns :('a # closLang$exp) list). recclosure_wf loc fns <=> every_Fn_SOME (MAP (SND :'a # closLang$exp -> closLang$exp) fns) /\ every_Fn_vs_NONE (MAP (SND :'a # closLang$exp -> closLang$exp) fns) /\ DISJOINT (set (GENLIST (\(i :num). (2 :num) * i + loc) (LENGTH fns))) (set (code_locs (MAP (SND :'a # closLang$exp -> closLang$exp) fns))) /\ ALL_DISTINCT (code_locs (MAP (SND :'a # closLang$exp -> closLang$exp) fns))
code_includes_type=:('a # 'b) list -> ('a |-> 'b) -> bool
code_includes_def=!(al :('a # 'b) list) (code :'a |-> 'b). code_includes al code <=> !(k :'a) (v :'b). ALOOKUP al k = SOME v ==> FLOOKUP code k = SOME v
wfg_type=:'a sptree$num_map # (num # 'b) list -> bool
wfg_prime_type=:'a sptree$num_map # (num # 'b) list -> bool
wfg_def=!(g :'a sptree$num_map # (num # 'b) list). wfg g <=> set (MAP (FST :num # 'b -> num) (SND g)) = IMAGE SUC (domain (FST g) :num -> bool) /\ ALL_DISTINCT (MAP (FST :num # 'b -> num) (SND g))
wfg_prime_def=!(g :'a sptree$num_map # (num # 'b) list). wfg' g <=> set (MAP (FST :num # 'b -> num) (SND g)) SUBSET IMAGE SUC (domain (FST g) :num -> bool)
wfg_prime_code_type=!(ls :('a # 'b) list) (g :'c sptree$num_map # (num # 'a # 'b) list) (loc :num). wfg' g /\ set (GENLIST (\(i :num). loc + (2 :num) * i) (LENGTH ls)) SUBSET (domain (FST g) :num -> bool) ==> wfg' (code_list loc ls g)
calls_wfg_type=!(xs :closLang$exp list) (g0 :sptree$num_set # (num # num # closLang$exp) list) (ys :closLang$exp list) (g :sptree$num_set # (num # num # closLang$exp) list). calls xs g0 = (ys,g) /\ ALL_DISTINCT (code_locs xs) /\ DISJOINT (IMAGE SUC (set (code_locs xs))) (set (MAP (FST :num # num # closLang$exp -> num) (SND g0))) /\ every_Fn_SOME xs /\ wfg g0 ==> wfg g
calls_wfg_prime_type=!(xs :closLang$exp list) (g0 :sptree$num_set # (num # num # closLang$exp) list) (ys :closLang$exp list) (g :sptree$num_set # (num # num # closLang$exp) list). calls xs g0 = (ys,g) /\ every_Fn_SOME xs /\ wfg' g0 ==> wfg' g
subg_cases=(T,F,F)
location_cases=([6; 10; 12; 20],[0])
recclosure_cases=(T,F)
code_includes_cases=(T,F,T)
