heap_restrict_def_typed=∀(start :num) (end :num) (heap :(α, β) heap_element list). heap_restrict start end heap = case heap_segment (start,end) heap of (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) => ([] :(α, β) heap_element list) | SOME (h1,h2,h3) => h2
heap_drop_def_typed=∀(n :num) (heap :(α, β) heap_element list). heap_drop n heap = case heap_split n heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (ARB :(α, β) heap_element list) | SOME (h1,h2) => h2
heap_take_def_typed=∀(n :num) (heap :(α, β) heap_element list). heap_take n heap = case heap_split n heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (ARB :(α, β) heap_element list) | SOME (h1,h2) => h1
heap_split_heap_length_typed=∀(heap :(α, β) heap_element list) (h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (a :num). heap_split a heap = SOME (h1,h2) ⇒ heap_length h1 = a ∧ heap_length (h1 ++ h2) = heap_length heap ∧ h1 ++ h2 = heap
heap_segment_IMP_typed=∀(heap :(α, β) heap_element list) (a :num) (b :num) (h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (h3 :(α, β) heap_element list). heap_segment (a,b) heap = SOME (h1,h2,h3) ⇒ h1 ++ h2 ++ h3 = heap ∧ heap_length h1 = a ∧ heap_length (h1 ++ h2) = b ∧ heap_length h3 = heap_length heap − b
gc_state_typed=recordtype.gc_state::(α, β) heap_element list -> (α, β) heap_element list -> (α, β) heap_element list -> (α, β) heap_element list -> (α, β) heap_element list -> (α, β) heap_element list -> (α, β) heap_element list -> num -> num -> bool -> (α, β) heap_element list -> (α, β) heap_element list -> (α, β) gc_state
empty_state_def_typed=(empty_state :(α, β) gc_state) = <|old := ([] :(α, β) heap_element list); h1 := ([] :(α, β) heap_element list); h2 := ([] :(α, β) heap_element list); r4 := ([] :(α, β) heap_element list); r3 := ([] :(α, β) heap_element list); r2 := ([] :(α, β) heap_element list); r1 := ([] :(α, β) heap_element list); a := (0 :num); n := (0 :num); ok := T; heap := ([] :(α, β) heap_element list); heap0 := ([] :(α, β) heap_element list)|>
heap_segment_def_typed=∀(a :num) (b :num) (heap :(α, β) heap_element list). heap_segment (a,b) heap = case heap_split a heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) | SOME (h1,heap') => if b < a then (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) else case heap_split (b − heap_length h1) heap' of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) | SOME (h2,h3) => SOME (h1,h2,h3)
heap_lookup_PREFIX_typed=∀(xs :(α, β) heap_element list). heap_lookup (heap_length xs) (xs ++ (x :(α, β) heap_element)::(ys :(α, β) heap_element list)) = SOME x
heap_lookup_EXTEND_typed=∀(xs :(α, β) heap_element list) (n :num) (ys :(α, β) heap_element list) (x :(α, β) heap_element). heap_lookup n xs = SOME x ⇒ heap_lookup n (xs ++ ys) = SOME x
isSomeDataOrForward_lemma_typed=∀(ha :(α, β) heap_element list) (ptr :num). isSomeDataOrForward (heap_lookup ptr (ha ++ DataElement (ys :α heap_address list) (l :num) (d :β)::(hb :(α, β) heap_element list))) ⇔ isSomeDataOrForward (heap_lookup ptr (ha ++ [(ForwardPointer (a :num) (u :α) l :(α, β) heap_element)] ++ hb))
isSomeForwardPointer_def_typed=∀(x :(α, β) heap_element option). isSomeForwardPointer x ⇔ ∃(ptr :num) (d :α) (l :num). x = SOME (ForwardPointer ptr d l :(α, β) heap_element)
isSomeDataOrForward_def_typed=∀(x :(α, β) heap_element option). isSomeDataOrForward x ⇔ isSomeForwardPointer x ∨ isSomeDataElement x
FILTER_LEMMA_typed=∀(heap :(α, β) heap_element list). FILTER (isForwardPointer :(α, β) heap_element -> bool) heap = ([] :(α, β) heap_element list) ⇒ FILTER (λ(h :(α, β) heap_element). ¬isForwardPointer h) heap = heap
heaps_similar_REFL_typed=∀(xs :(α, β) heap_element list). FILTER (isForwardPointer :(α, β) heap_element -> bool) xs = ([] :(α, β) heap_element list) ⇒ heaps_similar xs xs
heap_map_EMPTY_typed=∀(xs :(α, β) heap_element list) (n :num). FILTER (isForwardPointer :(α, β) heap_element -> bool) xs = ([] :(α, β) heap_element list) ⇒ FDOM (heap_map n xs) = (∅ :num -> bool)
heap_similar_Data_IMP_DataOrForward_typed=∀(heap0 :(α, β) heap_element list) (heap1 :(α, β) heap_element list) (ptr :num). heaps_similar heap0 heap1 ∧ isSomeDataElement (heap_lookup ptr heap0) ⇒ isSomeDataOrForward (heap_lookup ptr heap1)
heaps_similar_def_typed=∀(heap0 :(α, β) heap_element list) (heap :(α, β) heap_element list). heaps_similar heap0 heap ⇔ LIST_REL (λ(h0 :(α, β) heap_element) (h :(α, β) heap_element). if isForwardPointer h then el_length h = el_length h0 ∧ isDataElement h0 else h = h0) heap0 heap
heaps_similar_IMP_heap_length_typed=∀(xs :(α, β) heap_element list) (ys :(α, β) heap_element list). heaps_similar xs ys ⇒ heap_length xs = heap_length ys
heap_similar_Data_IMP_typed=heaps_similar (heap0 :(α, β) heap_element list) ((ha :(α, β) heap_element list) ++ DataElement (ys :α heap_address list) (l :num) (d :β)::(hb :(α, β) heap_element list)) ⇒ ∃(ha0 :(α, β) heap_element list) (hb0 :(α, β) heap_element list). heap0 = ha0 ++ DataElement ys l d::hb0 ∧ heap_length ha = heap_length ha0
heaps_similar_lemma_typed=∀(ha :(α, β) heap_element list) (heap0 :(α, β) heap_element list). heaps_similar heap0 (ha ++ DataElement (ys :α heap_address list) (l :num) (d :β)::(hb :(α, β) heap_element list)) ⇒ heaps_similar heap0 (ha ++ [(ForwardPointer (heap_length ((h1 :(γ, δ) heap_element list) ++ (h2 :(γ, δ) heap_element list))) (u :α) l :(α, β) heap_element)] ++ hb)
NOT_IN_heap_map_typed=heap_length (ha :(α, β) heap_element list) ∉ FDOM (heap_map (0 :num) (ha ++ DataElement (ys :α heap_address list) (l :num) (d :β)::(hb :(α, β) heap_element list)))
IN_heap_map_IMP_typed=∀(heap :(α, β) heap_element list) (n :num) (k :num). n ∈ FDOM (heap_map k heap) ⇒ k ≤ n
heap_lookup_FLOOKUP_typed=heap_lookup (n :num) (heap :(α, β) heap_element list) = SOME (ForwardPointer (ptr :num) (u :α) (l :num) :(α, β) heap_element) ⇒ FLOOKUP (heap_map (0 :num) heap) n = SOME ptr
heap_map_def_typed=(∀(a :num). heap_map a ([] :(α, β) heap_element list) = (FEMPTY :num |-> num)) ∧ (∀(xs :(α, β) heap_element list) (ptr :num) (l :num) (d :α) (a :num). heap_map a ((ForwardPointer ptr d l :(α, β) heap_element)::xs) = (heap_map (a + l + (1 :num)) xs)⟨a ↦ ptr⟩) ∧ (∀(xs :(α, β) heap_element list) (v4 :num) (a :num). heap_map a ((Unused v4 :(α, β) heap_element)::xs) = heap_map (a + el_length (Unused v4 :(α, β) heap_element)) xs) ∧ ∀(xs :(α, β) heap_element list) (v9 :num) (v8 :α heap_address list) (v10 :β) (a :num). heap_map a (DataElement v8 v9 v10::xs) = heap_map (a + el_length (DataElement v8 v9 v10)) xs
heap_addresses_APPEND_typed=∀(xs :(α, β) heap_element list) (ys :(α, β) heap_element list) (n :num). heap_addresses n (xs ++ ys) = heap_addresses n xs ∪ heap_addresses (n + heap_length xs) ys
heap_addresses_LESS_heap_length_typed=∀(heap :(α, β) heap_element list) (n :num) (k :num). k ∈ heap_addresses n heap ⇒ k < n + heap_length heap
heap_addresses_LESS_typed=∀(heap :(α, β) heap_element list) (n :num) (k :num). k ∈ heap_addresses n heap ⇒ n ≤ k
MEM_IMP_heap_lookup_typed=∀(xs :(α, β) heap_element list) (x :(α, β) heap_element). MEM x xs ⇒ ∃(j :num). heap_lookup j xs = SOME x
heap_addresses_def_typed=(∀(a :num). heap_addresses a ([] :(α, β) heap_element list) = (∅ :num -> bool)) ∧ ∀(a :num) (x :(α, β) heap_element) (xs :(α, β) heap_element list). heap_addresses a (x::xs) = a INSERT heap_addresses (a + el_length x) xs
gc_related_def_typed=∀(f :num |-> num) (heap1 :(α, β) heap_element list) (heap2 :(α, β) heap_element list). gc_related f heap1 heap2 ⇔ INJ (FAPPLY f) (FDOM f) {a | isSomeDataElement (heap_lookup a heap2)} ∧ (∀(i :num). i ∈ FDOM f ⇒ isSomeDataElement (heap_lookup i heap1)) ∧ ∀(i :num) (xs :α heap_address list) (l :num) (d :β). i ∈ FDOM f ∧ heap_lookup i heap1 = SOME (DataElement xs l d) ⇒ heap_lookup f⟨i⟩ heap2 = SOME (DataElement (ADDR_MAP (FAPPLY f) xs) l d) ∧ ∀(ptr :num) (u :α). MEM (Pointer ptr u) xs ⇒ ptr ∈ FDOM f
ADDR_MAP_def_typed=(∀(f :num -> num). ADDR_MAP f ([] :α heap_address list) = ([] :α heap_address list)) ∧ (∀(xs :α heap_address list) (x :α) (f :num -> num). ADDR_MAP f (Data x::xs) = Data x::ADDR_MAP f xs) ∧ ∀(xs :α heap_address list) (f :num -> num) (d :α) (a :num). ADDR_MAP f (Pointer a d::xs) = Pointer (f a) d::ADDR_MAP f xs
ADDR_APPLY_def_typed=(∀(f :num -> num) (x :num) (d :α). ADDR_APPLY f (Pointer x d) = Pointer (f x) d) ∧ ∀(f :num -> num) (y :α). ADDR_APPLY f (Data y) = Data y
ADDR_MAP_EQ_typed=∀(xs :α heap_address list). (∀(p :num) (d :α). MEM (Pointer p d) xs ⇒ (f :num -> num) p = (g :num -> num) p) ⇒ ADDR_MAP f xs = ADDR_MAP g xs
ADDR_MAP_LENGTH_typed=∀(xs :α heap_address list) (f :num -> num). LENGTH xs = LENGTH (ADDR_MAP f xs)
ADDR_MAP_APPEND_typed=∀(h1 :α heap_address list) (h2 :α heap_address list) (f :num -> num). ADDR_MAP f (h1 ++ h2) = ADDR_MAP f h1 ++ ADDR_MAP f h2
MEM_ADDR_MAP_typed=∀(xs :α heap_address list) (f :num -> num) (ptr :num) (u :α). MEM (Pointer ptr u) (ADDR_MAP f xs) ⇒ ∃(y :num). MEM (Pointer y u) xs ∧ f y = ptr
gc_edge_def_typed=∀(heap :(α, β) heap_element list) (x :num) (y :num). gc_edge heap x y ⇔ ∃(xs :α heap_address list) (l :num) (d :β) (t :α). heap_lookup x heap = SOME (DataElement xs l d) ∧ MEM (Pointer y t) xs
reachable_addresses_def_typed=∀(roots :α heap_address list) (heap :(β, γ) heap_element list) (y :num). reachable_addresses roots heap y ⇔ ∃(t :α) (x :num). MEM (Pointer x t) roots ∧ (gc_edge heap)꙳ x y
heap_length_heap_expand_typed=∀(n :num). heap_length (heap_expand n :(α, β) heap_element list) = n
heap_length_heap_filter_eq_typed=∀(s :num -> bool) (t :num -> bool) (f :num -> num) (heap :(α, β) heap_element list) (heap2 :(γ, β) heap_element list). BIJ f s t ∧ FINITE s ∧ FINITE t ∧ (∀(i :num). i ∈ s ⇒ ∃(xs :α heap_address list) (xs2 :γ heap_address list) (l :num) (d :δ) (d :β). heap_lookup i heap = SOME (DataElement xs l d) ∧ heap_lookup (f i) heap2 = SOME (DataElement xs2 l d)) ⇒ heap_length (heap_filter t heap2) = heap_length (heap_filter s heap)
heap_filter_aux_heap_addresses_UNION_typed=∀(xs :(α, β) heap_element list) (n :num) (s :num -> bool). heap_filter_aux n (heap_addresses n xs ∪ s) xs = xs
heap_length_heap_filter_typed=∀(heap :(α, β) heap_element list). heap_length (heap_filter (heap_addresses (0 :num) heap) heap) = heap_length heap
heap_filter_aux_APPEND_typed=∀(xs :(α, β) heap_element list) (ys :(α, β) heap_element list) (n :num) (s :num -> bool). heap_filter_aux n s (xs ++ ys) = heap_filter_aux n s xs ++ heap_filter_aux (n + heap_length xs) s ys
heap_filter_aux_def_typed=(∀(n :num) (P :num -> bool). heap_filter_aux n P ([] :(α, β) heap_element list) = ([] :(α, β) heap_element list)) ∧ ∀(n :num) (P :num -> bool) (x :(α, β) heap_element) (xs :(α, β) heap_element list). heap_filter_aux n P (x::xs) = (if n ∈ P then [x] else ([] :(α, β) heap_element list)) ++ heap_filter_aux (n + el_length x) P xs
heap_filter_def_typed=(heap_filter :(num -> bool) -> (α, β) heap_element list -> (α, β) heap_element list) = (heap_filter_aux (0 :num) :(num -> bool) -> (α, β) heap_element list -> (α, β) heap_element list)
heap_filter_EMPTY_typed=∀(heap :(α, β) heap_element list). heap_filter (∅ :num -> bool) heap = ([] :(α, β) heap_element list)
gc_forward_ptr_thm_typed=∀(ha :(α, β) heap_element list). gc_forward_ptr (heap_length ha) (ha ++ DataElement (ys :α heap_address list) (l :num) (d :β)::(hb :(α, β) heap_element list)) (a :num) (u :α) (c :bool) = (ha ++ (ForwardPointer a u l :(α, β) heap_element)::hb,c)
gc_forward_ptr_ok_typed=∀(heap :(α, β) heap_element list) (n :num) (a :num) (c :bool) (x :(α, β) heap_element list). gc_forward_ptr n heap a (d :α) c = (x,T) ⇒ c
gc_forward_ptr_def_typed=(∀(a :num) (ptr :num) (d :α) (ok :bool). gc_forward_ptr a ([] :(α, β) heap_element list) ptr d ok = (([] :(α, β) heap_element list),F)) ∧ ∀(a :num) (x :(α, β) heap_element) (xs :(α, β) heap_element list) (ptr :num) (d :α) (ok :bool). gc_forward_ptr a (x::xs) ptr d ok = if a = (0 :num) then ((ForwardPointer ptr d (el_length x − (1 :num)) :(α, β) heap_element)::xs,isDataElement x ∧ ok) else if a < el_length x then (x::xs,F) else (let ((xs :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr (a − el_length x) xs ptr d ok in (x::xs,ok))
heap_address_typed=Pointer::num -> α -> α heap_address; Data::α -> α heap_address
heap_element_typed=Unused::num -> (α, β) heap_element; ForwardPointer::num -> α -> num -> (α, β) heap_element; DataElement::α heap_address list -> num -> β -> (α, β) heap_element
heap_lookup_LESS_typed=∀(xs :(α, β) heap_element list) (n :num). heap_lookup n xs = SOME (x :(α, β) heap_element) ⇒ n < heap_length xs
el_length_def_typed=(∀(l :num). el_length (Unused l :(α, β) heap_element) = l + (1 :num)) ∧ (∀(n :num) (d :α) (l :num). el_length (ForwardPointer n d l :(α, β) heap_element) = l + (1 :num)) ∧ ∀(xs :α heap_address list) (l :num) (data :β). el_length (DataElement xs l data) = l + (1 :num)
heap_length_def_typed=∀(heap :(α, β) heap_element list). heap_length heap = (SUM (MAP (el_length :(α, β) heap_element -> num) heap) :num)
heap_length_APPEND_typed=heap_length ((xs :(α, β) heap_element list) ++ (ys :(α, β) heap_element list)) = heap_length xs + heap_length ys
heap_lookup_MEM_typed=∀(heap :(α, β) heap_element list) (n :num) (x :(α, β) heap_element). heap_lookup n heap = SOME x ⇒ MEM x heap
heap_lookup_SPLIT_typed=∀(heap :(α, β) heap_element list) (n :num) (x :(α, β) heap_element). heap_lookup n heap = SOME x ⇒ ∃(ha :(α, β) heap_element list) (hb :(α, β) heap_element list). heap = ha ++ x::hb ∧ n = heap_length ha
heap_expand_def_typed=∀(n :num). (heap_expand n :(α, β) heap_element list) = if n = (0 :num) then ([] :(α, β) heap_element list) else [(Unused (n − (1 :num)) :(α, β) heap_element)]
heap_lookup_def_typed=(∀(a :num). heap_lookup a ([] :(α, β) heap_element list) = (NONE :(α, β) heap_element option)) ∧ ∀(a :num) (x :(α, β) heap_element) (xs :(α, β) heap_element list). heap_lookup a (x::xs) = if a = (0 :num) then SOME x else if a < el_length x then (NONE :(α, β) heap_element option) else heap_lookup (a − el_length x) xs
heap_split_def_typed=(∀(a :num). heap_split a ([] :(α, β) heap_element list) = if a = (0 :num) then SOME (([] :(α, β) heap_element list),([] :(α, β) heap_element list)) else (NONE :((α, β) heap_element list # (α, β) heap_element list) option)) ∧ ∀(a :num) (el :(α, β) heap_element) (heap :(α, β) heap_element list). heap_split a (el::heap) = if a = (0 :num) then SOME (([] :(α, β) heap_element list),el::heap) else if a < el_length el then (NONE :((α, β) heap_element list # (α, β) heap_element list) option) else case heap_split (a − el_length el) heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list) option) | SOME (h1,h2) => SOME (el::h1,h2)
isDataElement_def_typed=∀(x :(α, β) heap_element). isDataElement x ⇔ ∃(ys :α heap_address list) (l :num) (d :β). x = DataElement ys l d
isSomeDataElement_def_typed=∀(x :(α, β) heap_element option). isSomeDataElement x ⇔ ∃(ys :α heap_address list) (l :num) (d :β). x = SOME (DataElement ys l d)
isForwardPointer_def_typed=(isForwardPointer (ForwardPointer (n :num) (d :α) (l :num) :(α, β) heap_element) ⇔ T) ∧ (isForwardPointer (Unused (v :num) :(α, β) heap_element) ⇔ F) ∧ (isForwardPointer (DataElement (v4 :α heap_address list) (v5 :num) (v6 :β)) ⇔ F)
roots_ok_def_typed=∀(roots :α heap_address list) (heap :(β, γ) heap_element list). roots_ok roots heap ⇔ ∀(ptr :num) (u :α). MEM (Pointer ptr u) roots ⇒ isSomeDataElement (heap_lookup ptr heap)
heap_ok_def_typed=∀(heap :(α, β) heap_element list) (limit :num). heap_ok heap limit ⇔ heap_length heap = limit ∧ FILTER (isForwardPointer :(α, β) heap_element -> bool) heap = ([] :(α, β) heap_element list) ∧ ∀(xs :α heap_address list) (l :num) (d :β) (ptr :num) (u :α). MEM (DataElement xs l d) heap ∧ MEM (Pointer ptr u) xs ⇒ isSomeDataElement (heap_lookup ptr heap)
