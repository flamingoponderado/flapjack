Tarray_num_def_typed=Tarray_num = (0 :num)
Tbool_num_def_typed=Tbool_num = (1 :num)
Tchar_num_def_typed=Tchar_num = (2 :num)
Texn_num_def_typed=Texn_num = (3 :num)
Tfn_num_def_typed=Tfn_num = (4 :num)
Tint_num_def_typed=Tint_num = (5 :num)
Tlist_num_def_typed=Tlist_num = (6 :num)
Tref_num_def_typed=Tref_num = (7 :num)
Tstring_num_def_typed=Tstring_num = (8 :num)
Ttup_num_def_typed=Ttup_num = (9 :num)
