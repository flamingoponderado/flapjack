is_value_def_typed=(∀(v0 :lit). is_value (Lit v0) ⇔ T) ∧ (∀(v1 :(mlstring, mlstring) id option) (es :exp list). is_value (Con v1 es) ⇔ EVERY (λ(a :exp). is_value a) es) ∧ (∀(v2 :(mlstring, mlstring) id). is_value (Var v2) ⇔ T) ∧ (∀(v4 :exp) (v3 :mlstring). is_value (Fun v3 v4) ⇔ T) ∧ (∀(v5 :ast_t) (e :exp). is_value (Tannot e v5) ⇔ is_value e) ∧ (∀(v6 :locs) (e :exp). is_value (Lannot e v6) ⇔ is_value e) ∧ (∀(v :exp). is_value (Raise v) ⇔ F) ∧ (∀(v9 :(pat # exp) list) (v8 :exp). is_value (Handle v8 v9) ⇔ F) ∧ (∀(v17 :exp list) (v16 :op). is_value (App v16 v17) ⇔ F) ∧ (∀(v20 :exp) (v19 :exp) (v18 :lop). is_value (Log v18 v19 v20) ⇔ F) ∧ (∀(v23 :exp) (v22 :exp) (v21 :exp). is_value (If v21 v22 v23) ⇔ F) ∧ (∀(v25 :(pat # exp) list) (v24 :exp). is_value (Mat v24 v25) ⇔ F) ∧ (∀(v28 :exp) (v27 :exp) (v26 :mlstring option). is_value (Let v26 v27 v28) ⇔ F) ∧ ∀(v30 :exp) (v29 :(mlstring # mlstring # exp) list). is_value (Letrec v29 v30) ⇔ F
check_ctor_tenv_def_typed=(∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_ctor_tenv tenvT ([] :(mlstring list # mlstring # (mlstring # ast_t list) list) list) ⇔ T) ∧ ∀(tvs :mlstring list) (tn :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (ctors :(mlstring # ast_t list) list). check_ctor_tenv tenvT ((tvs,tn,ctors)::tds) ⇔ check_dup_ctors (tvs,tn,ctors) ∧ ALL_DISTINCT tvs ∧ EVERY (λ((cn :mlstring),(ts :ast_t list)). EVERY (check_freevars_ast tvs) ts ∧ EVERY (check_type_names tenvT) ts) ctors ∧ ¬MEM tn (MAP (λ(p :mlstring list # mlstring # (mlstring # ast_t list) list). case p of (v,tn,v3) => tn) tds) ∧ check_ctor_tenv tenvT tds
