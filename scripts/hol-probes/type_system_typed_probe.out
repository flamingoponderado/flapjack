Tword64_num_def_typed=Tword64_num = (11 :num)
Tword8_num_def_typed=Tword8_num = (12 :num)
Tword8array_num_def_typed=Tword8array_num = (13 :num)
Tdouble_num_def_typed=Tdouble_num = (14 :num)
Tarray_def_typed=∀(t :t). Tarray t = Tapp [t] Tarray_num
Tbool_def_typed=Tbool = Tapp ([] :t list) Tbool_num
Tchar_def_typed=Tchar = Tapp ([] :t list) Tchar_num
Texn_def_typed=Texn = Tapp ([] :t list) Texn_num
Tfn_def_typed=∀(t1 :t) (t2 :t). Tfn t1 t2 = Tapp [t1; t2] Tfn_num
Tint_def_typed=Tint = Tapp ([] :t list) Tint_num
Tlist_def_typed=∀(t :t). Tlist t = Tapp [t] Tlist_num
Tref_def_typed=∀(t :t). Tref t = Tapp [t] Tref_num
Tstring_def_typed=Tstring = Tapp ([] :t list) Tstring_num
Ttup_def_typed=∀(ts :t list). Ttup ts = Tapp ts Ttup_num
Tvector_def_typed=∀(t :t). Tvector t = Tapp [t] Tvector_num
Tword64_def_typed=Tword64 = Tapp ([] :t list) Tword64_num
Tword8_def_typed=Tword8 = Tapp ([] :t list) Tword8_num
Tword8array_def_typed=Tword8array = Tapp ([] :t list) Tword8array_num
Tdouble_def_typed=Tdouble = Tapp ([] :t list) Tdouble_num
t_typed=Tvar::mlstring -> t; Tvar_db::num -> t; Tapp::t list -> num -> t
check_freevars_def_typed=(∀(tvs :mlstring list) (tv :mlstring) (dbmax :num). check_freevars dbmax tvs (Tvar tv) ⇔ MEM tv tvs) ∧ (∀(tvs :mlstring list) (ts :t list) (tn :num) (dbmax :num). check_freevars dbmax tvs (Tapp ts tn) ⇔ EVERY (λ(a :t). check_freevars dbmax tvs a) ts) ∧ ∀(tvs :mlstring list) (n :num) (dbmax :num). check_freevars dbmax tvs (Tvar_db n) ⇔ n < dbmax
check_freevars_ast_def_typed=(∀(tvs :mlstring list) (tv :mlstring). check_freevars_ast tvs (Atvar tv) ⇔ MEM tv tvs) ∧ (∀(tvs :mlstring list) (ts :ast_t list). check_freevars_ast tvs (Attup ts) ⇔ EVERY (λ(a :ast_t). check_freevars_ast tvs a) ts) ∧ (∀(tvs :mlstring list) (t2 :ast_t) (t1 :ast_t). check_freevars_ast tvs (Atfun t1 t2) ⇔ check_freevars_ast tvs t1 ∧ check_freevars_ast tvs t2) ∧ ∀(tvs :mlstring list) (ts :ast_t list) (tn :(mlstring, mlstring) id). check_freevars_ast tvs (Atapp ts tn) ⇔ EVERY (λ(a :ast_t). check_freevars_ast tvs a) ts
deBruijn_inc_def_typed=(∀(tv :mlstring) (skip :num) (n :num). deBruijn_inc skip n (Tvar tv) = Tvar tv) ∧ (∀(skip :num) (n :num) (m :num). deBruijn_inc skip n (Tvar_db m) = if m < skip then Tvar_db m else Tvar_db (m + n)) ∧ ∀(ts :t list) (tn :num) (skip :num) (n :num). deBruijn_inc skip n (Tapp ts tn) = Tapp (MAP (λ(a :t). deBruijn_inc skip n a) ts) tn
deBruijn_subst_def_typed=(∀(tv :mlstring) (ts :t list) (skip :num). deBruijn_subst skip ts (Tvar tv) = Tvar tv) ∧ (∀(ts :t list) (skip :num) (n :num). deBruijn_subst skip ts (Tvar_db n) = if ¬(n < skip) ∧ n < LENGTH ts + skip then ts❲n − skip❳ else if ¬(n < skip) then Tvar_db (n − LENGTH ts) else Tvar_db n) ∧ ∀(ts' :t list) (ts :t list) (tn :num) (skip :num). deBruijn_subst skip ts (Tapp ts' tn) = Tapp (MAP (λ(a :t). deBruijn_subst skip ts a) ts') tn
tenv_val_exp_typed=Empty::tenv_val_exp; Bind_tvar::num -> tenv_val_exp -> tenv_val_exp; Bind_name::mlstring -> num -> t -> tenv_val_exp -> tenv_val_exp
bind_tvar_def_typed=∀(tvs :num) (tenvE :tenv_val_exp). bind_tvar tvs tenvE = if tvs = (0 :num) then tenvE else Bind_tvar tvs tenvE
opt_bind_name_def_typed=∀(n :mlstring option) (tvs :num) (t :t) (tenvE :tenv_val_exp). opt_bind_name n tvs t tenvE = case n of (NONE :mlstring option) => tenvE | SOME n' => Bind_name n' tvs t tenvE
tveLookup_def_typed=(∀(n :mlstring) (inc :num). tveLookup n inc Empty = (NONE :(num # t) option)) ∧ (∀(n :mlstring) (inc :num) (tvs :num) (tenvE :tenv_val_exp). tveLookup n inc (Bind_tvar tvs tenvE) = tveLookup n (inc + tvs) tenvE) ∧ ∀(n :mlstring) (inc :num) (n' :mlstring) (tvs :num) (t :t) (tenvE :tenv_val_exp). tveLookup n inc (Bind_name n' tvs t tenvE) = if n' = n then SOME (tvs,deBruijn_inc tvs inc t) else tveLookup n inc tenvE
type_env_typed=recordtype.type_env::(mlstring, mlstring, num # t) namespace -> (mlstring, mlstring, mlstring list # t list # num) namespace -> (mlstring, mlstring, mlstring list # t) namespace -> type_env
extend_dec_tenv_def_typed=∀(tenv' :type_env) (tenv :type_env). extend_dec_tenv tenv' tenv = <|v := nsAppend tenv'.v tenv.v; c := nsAppend tenv'.c tenv.c; t := nsAppend tenv'.t tenv.t|>
lookup_varE_def_typed=∀(id :(mlstring, mlstring) id) (tenvE :tenv_val_exp). lookup_varE id tenvE = case id of (Short x :(mlstring, mlstring) id) => tveLookup x (0 :num) tenvE | Long v4 v5 => (NONE :(num # t) option)
lookup_var_def_typed=∀(id :(mlstring, mlstring) id) (tenvE :tenv_val_exp) (tenv :type_env). lookup_var id tenvE tenv = case lookup_varE id tenvE of (NONE :(num # t) option) => nsLookup tenv.v id | SOME x => SOME x
num_tvs_def_typed=num_tvs Empty = (0 :num) ∧ (∀(tvs :num) (tenvE :tenv_val_exp). num_tvs (Bind_tvar tvs tenvE) = tvs + num_tvs tenvE) ∧ ∀(n :mlstring) (tvs :num) (t :t) (tenvE :tenv_val_exp). num_tvs (Bind_name n tvs t tenvE) = num_tvs tenvE
bind_var_list_def_typed=(∀(tvs :num) (tenvE :tenv_val_exp). bind_var_list tvs ([] :(mlstring # t) list) tenvE = tenvE) ∧ ∀(tvs :num) (tenvE :tenv_val_exp) (t :t) (n :mlstring) (binds :(mlstring # t) list). bind_var_list tvs ((n,t)::binds) tenvE = Bind_name n tvs t (bind_var_list tvs binds tenvE)
type_subst_def_typed=(∀(tv :mlstring) (s :mlstring |-> t). type_subst s (Tvar tv) = case FLOOKUP s tv of (NONE :t option) => Tvar tv | SOME t => t) ∧ (∀(ts :t list) (tn :num) (s :mlstring |-> t). type_subst s (Tapp ts tn) = Tapp (MAP (λ(a :t). type_subst s a) ts) tn) ∧ ∀(s :mlstring |-> t) (n :num). type_subst s (Tvar_db n) = Tvar_db n
check_type_names_def_typed=(∀(tv :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Atvar tv) ⇔ T) ∧ (∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Attup ts) ⇔ EVERY (λ(a :ast_t). check_type_names tenvT a) ts) ∧ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (t2 :ast_t) (t1 :ast_t). check_type_names tenvT (Atfun t1 t2) ⇔ check_type_names tenvT t1 ∧ check_type_names tenvT t2) ∧ ∀(ts :ast_t list) (tn :(mlstring, mlstring) id) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Atapp ts tn) ⇔ (case nsLookup tenvT tn of (NONE :(mlstring list # t) option) => F | SOME (tvs,v2) => LENGTH tvs = LENGTH ts) ∧ EVERY (λ(a :ast_t). check_type_names tenvT a) ts
type_name_subst_def_typed=(∀(tv :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). type_name_subst tenvT (Atvar tv) = Tvar tv) ∧ (∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). type_name_subst tenvT (Attup ts) = Ttup (MAP (λ(a :ast_t). type_name_subst tenvT a) ts)) ∧ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (t2 :ast_t) (t1 :ast_t). type_name_subst tenvT (Atfun t1 t2) = Tfn (type_name_subst tenvT t1) (type_name_subst tenvT t2)) ∧ ∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tc :(mlstring, mlstring) id). type_name_subst tenvT (Atapp ts tc) = (let (args :t list) = MAP (λ(a :ast_t). type_name_subst tenvT a) ts in case nsLookup tenvT tc of (NONE :(mlstring list # t) option) => Ttup args | SOME (tvs,t) => type_subst (alist_to_fmap (ZIP (tvs,args))) t)
t_of_def_typed=t_of BoolT = Tbool ∧ t_of IntT = Tint ∧ t_of CharT = Tchar ∧ t_of StrT = Tstring ∧ t_of (WordT W8) = Tword8 ∧ t_of (WordT W64) = Tword64 ∧ t_of Float64T = Tdouble
supported_test_def_typed=(supported_test Equal (ty :prim_type) ⇔ T) ∧ (supported_test (Compare (v0 :opb)) ty ⇔ MEM ty [IntT; CharT; WordT W8; Float64T; StrT]) ∧ (supported_test (AltCompare (v4 :opb)) ty ⇔ ty = StrT)
supported_arith_def_typed=supported_arith (a :arith) IntT = (if MEM a [Add; Sub; Mul; Div; Mod] then SOME (2 :num) else (NONE :num option)) ∧ supported_arith a Float64T = (if MEM a [Abs; Neg; Sqrt] then SOME (1 :num) else if MEM a [Add; Sub; Mul; Div] then SOME (2 :num) else if MEM a [FMA] then SOME (3 :num) else (NONE :num option)) ∧ supported_arith a (WordT (v0 :word_size)) = (if MEM a [Add; Sub; And; Or; Xor] then SOME (2 :num) else (NONE :num option)) ∧ supported_arith a BoolT = (if MEM a [Not] then SOME (1 :num) else (NONE :num option)) ∧ supported_arith a CharT = (NONE :num option) ∧ supported_arith a StrT = (NONE :num option)
