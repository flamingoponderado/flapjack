tenv_add_tvs_def_typed=∀(tvs :num) (bindings :(mlstring # t) list). tenv_add_tvs tvs bindings = MAP (λ((n :mlstring),(t :t)). (n,tvs,t)) bindings
tscheme_inst_def_typed=∀(tvs_spec :num) (t_spec :t) (tvs_impl :num) (t_impl :t). tscheme_inst (tvs_spec,t_spec) (tvs_impl,t_impl) ⇔ ∃(subst :t list). LENGTH subst = tvs_impl ∧ check_freevars tvs_impl ([] :mlstring list) t_impl ∧ EVERY (check_freevars tvs_spec ([] :mlstring list)) subst ∧ deBruijn_subst (0 :num) subst t_impl = t_spec
