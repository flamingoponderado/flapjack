dont_lift_thm_typed=dont_lift (x :closLang$exp) ⇔ (∃(t :tra) (i :int). x = Op t (IntOp (Const i)) ([] :closLang$exp list)) ∨ (∃(t :tra) (n :num). x = Op t (BlockOp (Cons n :block_op)) ([] :closLang$exp list)) ∨ (∃(t :tra) (s :mlstring). x = Op t (BlockOp (Constant (ConstStr s))) ([] :closLang$exp list)) ∨ (∃(t :tra) (i :int). x = Op t (BlockOp (Constant (ConstInt i))) ([] :closLang$exp list)) ∨ ∃(t :tra) (w :word64). x = Op t (BlockOp (Constant (ConstWord64 w))) ([] :closLang$exp list)
dont_lift_pure_typed=dont_lift (x :closLang$exp) ⇒ pure x
lift_acc_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ⇒ ∃(binds1 :closLang$exp list). binds2 = binds ++ binds1
lift_n_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ∧ n = LENGTH binds ⇒ k = LENGTH binds2
lift_length_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ⇒ LENGTH xs = LENGTH ys
