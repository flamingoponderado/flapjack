dont_lift_thm_typed=dont_lift (x :closLang$exp) ⇔ (∃(t :tra) (i :int). x = Op t (IntOp (Const i)) ([] :closLang$exp list)) ∨ (∃(t :tra) (n :num). x = Op t (BlockOp (Cons n :block_op)) ([] :closLang$exp list)) ∨ (∃(t :tra) (s :mlstring). x = Op t (BlockOp (Constant (ConstStr s))) ([] :closLang$exp list)) ∨ (∃(t :tra) (i :int). x = Op t (BlockOp (Constant (ConstInt i))) ([] :closLang$exp list)) ∨ ∃(t :tra) (w :word64). x = Op t (BlockOp (Constant (ConstWord64 w))) ([] :closLang$exp list)
dont_lift_pure_typed=dont_lift (x :closLang$exp) ⇒ pure x
lift_acc_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ⇒ ∃(binds1 :closLang$exp list). binds2 = binds ++ binds1
lift_n_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ∧ n = LENGTH binds ⇒ k = LENGTH binds2
lift_length_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ⇒ LENGTH xs = LENGTH ys
simple_exp_rules_typed=(∀(t :tra) (i :num). simple_exp (Var t i :closLang$exp)) ∧ (∀(t :tra) (x :closLang$exp) (y :closLang$exp) (z :closLang$exp). simple_exp x ∧ simple_exp y ∧ simple_exp z ⇒ simple_exp (If t x y z :closLang$exp)) ∧ (∀(t :tra) (i :int). simple_exp (Op t (IntOp (Const i)) ([] :closLang$exp list))) ∧ (∀(t :tra) (i :int). simple_exp (Op t (BlockOp (Constant (ConstInt i))) ([] :closLang$exp list))) ∧ (∀(t :tra) (i :mlstring). simple_exp (Op t (BlockOp (Constant (ConstStr i))) ([] :closLang$exp list))) ∧ (∀(t :tra) (i :word64). simple_exp (Op t (BlockOp (Constant (ConstWord64 i))) ([] :closLang$exp list))) ∧ (∀(t :tra) (i :num) (xs :closLang$exp list). EVERY simple_exp xs ⇒ simple_exp (Op t (BlockOp (Cons i :block_op)) xs)) ∧ (∀(t :tra) (i :int) (x :closLang$exp). simple_exp x ⇒ simple_exp (Op t (BlockOp (EqualConst (Int i))) [x])) ∧ (∀(t :tra) (i :mlstring) (x :closLang$exp). simple_exp x ⇒ simple_exp (Op t (BlockOp (EqualConst (Str i))) [x])) ∧ (∀(t :tra) (i :word64) (x :closLang$exp). simple_exp x ⇒ simple_exp (Op t (BlockOp (EqualConst (W64 i :const_part))) [x])) ∧ (∀(t :tra) (i :num) (x :closLang$exp). simple_exp x ⇒ simple_exp (Op t (BlockOp (ElemAt i)) [x])) ∧ (∀(t :tra) (x :closLang$exp) (y :closLang$exp). simple_exp x ∧ simple_exp y ⇒ simple_exp (Op t (BlockOp Equal) [x; y])) ∧ ∀(t :tra) (l :num) (y :num) (x :closLang$exp). simple_exp x ⇒ simple_exp (Op t (BlockOp (TagLenEq l y :block_op)) [x])
simple_exp_pure_typed=∀(x :closLang$exp). simple_exp x ⇒ pure x
simple_exp_pure_every_typed=EVERY simple_exp (xs :closLang$exp list) ⇒ EVERY pure xs
lift_simple_exp_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ⇒ EVERY simple_exp ys
eq_direct_simple_exp_typed=eq_direct (x :closLang$exp) (y :closLang$exp) = SOME (z :closLang$exp) ∧ simple_exp x ∧ simple_exp y ⇒ simple_exp z
simple_exp_eq_pure_list_typed=∀(xs :(closLang$exp # closLang$exp) list). EVERY (λ((x :closLang$exp),(y :closLang$exp)). simple_exp x ∧ simple_exp y) xs ⇒ EVERY simple_exp (append (eq_pure_list xs))
red_rel_rules_typed=(∀(n :num) (xs :closLang$exp list) (ys :closLang$exp list) (t :tra) (op :closLang$op) (iop :int_op) (i :int) (tag :num) (t1 :num) (t2 :num) (s :mlstring) (w :word64). red_rel xs ys ∧ MEM op [IntOp iop; BlockOp Equal; BlockOp (Cons tag :block_op); BlockOp (ElemAt t1); BlockOp (TagLenEq t1 t2 :block_op); BlockOp (LenEq n :block_op); BlockOp (TagEq tag); BlockOp (EqualConst (Str s)); BlockOp (EqualConst (W64 w :const_part)); BlockOp (EqualConst (Int i)); BlockOp (Constant (ConstInt i)); BlockOp (Constant (ConstStr s)); BlockOp (Constant (ConstWord64 w))] ⇒ red_rel [Op t op xs] ys) ∧ red_rel ([] :closLang$exp list) ([] :closLang$exp list) ∧ (∀(x :closLang$exp). red_rel [x] [x]) ∧ (∀(v :num) (t :tra). red_rel [(Var t v :closLang$exp)] ([] :closLang$exp list)) ∧ (∀(x :closLang$exp) (y :closLang$exp) (zs :closLang$exp list) (x1 :closLang$exp list) (x2 :closLang$exp list). red_rel [x] x1 ∧ red_rel (y::zs) x2 ⇒ red_rel (x::y::zs) (x1 ++ x2)) ∧ (∀(xs :closLang$exp list) (x :closLang$exp) (x1 :closLang$exp list) (t :tra). red_rel xs x1 ∧ red_rel [x] ([] :closLang$exp list) ⇒ red_rel [(Let t xs x :closLang$exp)] x1) ∧ ∀(t :tra) (x :closLang$exp) (y :closLang$exp) (z :closLang$exp) (x1 :closLang$exp list) (x2 :closLang$exp list) (x3 :closLang$exp list). red_rel [x] x1 ∧ red_rel [y] x2 ∧ red_rel [z] x3 ⇒ red_rel [(If t x y z :closLang$exp)] (x1 ++ x2 ++ x3)
red_rel_nil_typed=red_rel ([] :closLang$exp list) (ys :closLang$exp list) ⇔ ys = ([] :closLang$exp list)
red_rel_conj_typed=∀(xs :closLang$exp list). red_rel xs ([] :closLang$exp list) ⇒ red_rel [ConjList xs] ([] :closLang$exp list)
red_rel_every_typed=∀(xs :closLang$exp list). EVERY (λ(h :closLang$exp). red_rel [h] ([] :closLang$exp list)) xs ⇒ red_rel xs ([] :closLang$exp list)
simple_exp_red_rel_typed=∀(xs :closLang$exp list). EVERY simple_exp xs ⇒ red_rel xs ([] :closLang$exp list)
red_rel_eq_pure_typed=simple_exp (x :closLang$exp) ∧ simple_exp (y :closLang$exp) ⇒ red_rel [eq_pure x y] ([] :closLang$exp list)
red_rel_cons_zero_typed=red_rel [(x :closLang$exp)] (ys :closLang$exp list) ∧ red_rel (xs :closLang$exp list) (zs :closLang$exp list) ⇒ red_rel (x::xs) (ys ++ zs)
red_rel_exists_append_typed=red_rel ((h :closLang$exp)::(xs :closLang$exp list)) (ys :closLang$exp list) ⇔ ∃(ys1 :closLang$exp list) (ys2 :closLang$exp list). red_rel [h] ys1 ∧ red_rel xs ys2 ∧ ys = ys1 ++ ys2
red_rel_append_typed=∀(xs :closLang$exp list) (ys :closLang$exp list) (xs1 :closLang$exp list) (ys1 :closLang$exp list). red_rel xs ys ∧ red_rel xs1 ys1 ⇒ red_rel (xs ++ xs1) (ys ++ ys1)
red_rel_cons_typed=red_rel [(x :closLang$exp)] ([] :closLang$exp list) ∧ red_rel (xs :closLang$exp list) (ys :closLang$exp list) ⇒ red_rel (x::xs) ys
red_rel_cons_one_typed=red_rel (xs :closLang$exp list) (ys :closLang$exp list) ⇒ red_rel ((x :closLang$exp)::xs) (x::ys)
lift_red_rel_typed=∀(xs :closLang$exp list) (n :num) (binds :closLang$exp list) (ys :closLang$exp list) (k :num) (binds2 :closLang$exp list). lift_exps xs n binds = (ys,k,binds2) ⇒ ∃(zs :closLang$exp list). red_rel xs zs ∧ red_rel (DROP (LENGTH binds) binds2) zs
eq_direct_red_rel_typed=eq_direct (x :closLang$exp) (y :closLang$exp) = SOME (z :closLang$exp) ⇒ ∃(ys :closLang$exp list). red_rel [x; y] ys ∧ red_rel [z] ys
red_rel_refl_typed=∀(xs :closLang$exp list). red_rel xs xs
smart_red_rel_typed=∀(t :tra) (op :closLang$op) (xs :closLang$exp list). ∃(ys :closLang$exp list). red_rel [Op t op xs] ys ∧ red_rel [SmartOp t op xs] ys
red_rel_pure_typed=∀(xs :closLang$exp list) (ys :closLang$exp list). red_rel xs ys ⇒ (EVERY pure xs ⇔ EVERY pure ys)
red_rel_globals_typed=∀(xs :closLang$exp list) (ys :closLang$exp list). red_rel xs ys ⇒ elist_globals xs = elist_globals ys
red_rel_esgc_typed=∀(xs :closLang$exp list) (ys :closLang$exp list). red_rel xs ys ⇒ (EVERY esgc_free xs ⇔ EVERY esgc_free ys)
smart_simp_typed=(pure (SmartOp (t :tra) (op :closLang$op) (xs :closLang$exp list)) ⇔ pure (Op t op xs)) ∧ set_globals (SmartOp t op xs) = set_globals (Op t op xs) ∧ (esgc_free (SmartOp t op xs) ⇔ esgc_free (Op t op xs))
