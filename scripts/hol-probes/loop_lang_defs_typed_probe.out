loop_arith_typed=LLongMul::num -> num -> num -> num -> loop_arith; LLongDiv::num -> num -> num -> num -> num -> loop_arith; LDiv::num -> num -> num -> loop_arith
acc_vars_def_typed=(∀(p2 :α prog) (p1 :α prog) (l :sptree$num_set). acc_vars (Seq p1 p2) l = acc_vars p1 (acc_vars p2 l)) ∧ (∀(v0 :num) (l :sptree$num_set). acc_vars (Break v0 :α prog) l = l) ∧ (∀(v6 :num) (l :sptree$num_set). acc_vars (Continue v6 :α prog) l = l) ∧ (∀(l2 :sptree$num_set) (l1 :sptree$num_set) (l :sptree$num_set) (body :α prog). acc_vars (Loop l1 body l2) l = acc_vars body l) ∧ (∀(x3 :α reg_imm) (x2 :num) (x1 :cmp) (p2 :α prog) (p1 :α prog) (l1 :sptree$num_set) (l :sptree$num_set). acc_vars (If x1 x2 x3 p1 p2 l1 :α prog) l = acc_vars p1 (acc_vars p2 l)) ∧ (∀(l :sptree$num_set) (arith :loop_arith). acc_vars (Arith arith :α prog) l = case arith of LLongMul v1 v2 v3 v4 => insert v1 () (insert v2 () l) | LLongDiv v1' v2' v3' v4' v5 => insert v1' () (insert v2' () l) | LDiv v1'' v2'' v3'' => insert v1'' () l) ∧ (∀(p1 :α prog) (l :sptree$num_set). acc_vars (Mark p1) l = acc_vars p1 l) ∧ (∀(l :sptree$num_set). acc_vars (Tick :α prog) l = l) ∧ (∀(l :sptree$num_set). acc_vars (Skip :α prog) l = l) ∧ (∀(l :sptree$num_set). acc_vars (Fail :α prog) l = l) ∧ (∀(v :num) (l :sptree$num_set). acc_vars (Raise v :α prog) l = l) ∧ (∀(v :num list) (l :sptree$num_set). acc_vars (Return v :α prog) l = l) ∧ (∀(ret :(num list # sptree$num_set) option) (l :sptree$num_set) (handler :(num # α prog # α prog # sptree$num_set) option) (dest :num option) (args :num list). acc_vars (Call ret dest args handler :α prog) l = case ret of (NONE :(num list # sptree$num_set) option) => l | SOME (vs,live) => (let (l' :sptree$num_set) = list_insert vs l in case handler of (NONE :(num # α prog # α prog # sptree$num_set) option) => l' | SOME (n,p1,p2,l1) => acc_vars p1 (acc_vars p2 (insert n () l')))) ∧ (∀(n :num) (m :num) (l :sptree$num_set). acc_vars (LocValue n m :α prog) l = insert n () l) ∧ (∀(n :num) (l :sptree$num_set) (exp :α exp). acc_vars (Assign n exp :α prog) l = insert n () l) ∧ (∀(rhss :num list) (pop :primop) (lhss :num list) (l :sptree$num_set). acc_vars (Primitive lhss pop rhss :α prog) l = list_insert lhss l) ∧ (∀(op :memop) (n :num) (l :sptree$num_set) (exp :α exp). acc_vars (ShMem op n exp) l = insert n () l) ∧ (∀(n :num) (l :sptree$num_set) (exp :α exp). acc_vars (Store exp n :α prog) l = l) ∧ (∀(w :word5) (l :sptree$num_set) (exp :α exp). acc_vars (SetGlobal w exp) l = l) ∧ (∀(n :num) (m :num) (l :sptree$num_set). acc_vars (Load32 n m :α prog) l = insert m () l) ∧ (∀(n :num) (m :num) (l :sptree$num_set). acc_vars (LoadByte n m :α prog) l = insert m () l) ∧ (∀(n :num) (m :num) (l :sptree$num_set). acc_vars (Store32 n m :α prog) l = l) ∧ (∀(n :num) (m :num) (l :sptree$num_set). acc_vars (StoreByte n m :α prog) l = l) ∧ ∀(name :mlstring) (n4 :num) (n3 :num) (n2 :num) (n1 :num) (live :sptree$num_set) (l :sptree$num_set). acc_vars (FFI name n1 n2 n3 n4 live :α prog) l = l
locals_touched_def_typed=(∀(w :α word). locals_touched (Const w :α exp) = ([] :num list)) ∧ (∀(v :num). locals_touched (Var v :α exp) = [v]) ∧ (∀(name :word5). locals_touched (Lookup name :α exp) = ([] :num list)) ∧ (∀(addr :α exp). locals_touched (Load addr :α exp) = locals_touched addr) ∧ (∀(wexps :α exp list) (op :binop). locals_touched (Op op wexps) = FLAT (MAP (λ(a :α exp). locals_touched a) wexps)) ∧ (∀(wexp2 :α exp) (wexp1 :α exp) (sh :ast$shift). locals_touched (Shift sh wexp1 wexp2 :α exp) = locals_touched wexp1 ++ locals_touched wexp2) ∧ locals_touched (BaseAddr :α exp) = ([] :num list) ∧ locals_touched (TopAddr :α exp) = ([] :num list)
