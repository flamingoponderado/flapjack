cc_seq_statement=∀p q s. (∀r s2 t1 k off jump. evaluate (p,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound p k ⇒ ∃ck t2. evaluate (comp jump off k p,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ∧ (∀middle. evaluate (p,s) = (NONE,middle) ⇒ ∀r s2 t1 k off jump. evaluate (q,middle) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k middle t1 ∧ reg_bound q k ⇒ ∃ck t2. evaluate (comp jump off k q,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ ∀r s2 t1 k off jump. evaluate (Seq p q,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound (Seq p q) k ⇒ ∃ck t2. evaluate (comp jump off k (Seq p q),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
cc_seq_proved=T
