load "bossLib";
load "preamble";
load "parmoveTheory";
open bossLib HolKernel Parse preamble parmoveTheory;
fun report label th term = if aconv (concl th) term then print (label ^ "=T\n") else raise Fail label;
val _ = let val term = ``(parsem (([]:(num#num)list) ++ [((0:num),(1:num))] ++ ([(2,3)]:(num#num)list)) : (num -> bool) -> num -> bool) = parsem ([((0:num),(1:num))] ++ ([]:(num#num)list) ++ ([(2,3)]:(num#num)list))``; val th = prove(term, match_mp_tac (ISPECL [``([]:(num#num)list)``,``(1:num)``,``(0:num)``,``([(2,3)]:(num#num)list)``,``([]:(num#num)list) ++ [((0:num),(1:num))] ++ ([(2,3)]:(num#num)list)``] independence) >> EVAL_TAC) in report "ind_head" th term end;
val _ = let val term = ``(parsem (([(0,1)]:(num#num)list) ++ [((2:num),(3:num))] ++ ([(4,5)]:(num#num)list)) : (num -> num) -> num -> num) = parsem ([((2:num),(3:num))] ++ ([(0,1)]:(num#num)list) ++ ([(4,5)]:(num#num)list))``; val th = prove(term, match_mp_tac (ISPECL [``([(0,1)]:(num#num)list)``,``(3:num)``,``(2:num)``,``([(4,5)]:(num#num)list)``,``([(0,1)]:(num#num)list) ++ [((2:num),(3:num))] ++ ([(4,5)]:(num#num)list)``] independence) >> EVAL_TAC) in report "ind_middle" th term end;
val _ = let val term = ``(parsem (([(0,1);(2,3)]:(num#num)list) ++ [((4:num),(5:num))] ++ ([]:(num#num)list)) : (num -> bool) -> num -> bool) = parsem ([((4:num),(5:num))] ++ ([(0,1);(2,3)]:(num#num)list) ++ ([]:(num#num)list))``; val th = prove(term, match_mp_tac (ISPECL [``([(0,1);(2,3)]:(num#num)list)``,``(5:num)``,``(4:num)``,``([]:(num#num)list)``,``([(0,1);(2,3)]:(num#num)list) ++ [((4:num),(5:num))] ++ ([]:(num#num)list)``] independence) >> EVAL_TAC) in report "ind_tail" th term end;
val _ = let val term = ``(parsem (([(0,1)]:(num#num)list) ++ [((1:num),(0:num))] ++ ([]:(num#num)list)) : (num -> num) -> num -> num) = parsem ([((1:num),(0:num))] ++ ([(0,1)]:(num#num)list) ++ ([]:(num#num)list))``; val th = prove(term, match_mp_tac (ISPECL [``([(0,1)]:(num#num)list)``,``(0:num)``,``(1:num)``,``([]:(num#num)list)``,``([(0,1)]:(num#num)list) ++ [((1:num),(0:num))] ++ ([]:(num#num)list)``] independence) >> EVAL_TAC) in report "ind_cycle" th term end;
val _ = let val term = ``(parsem (([(0,7)]:(num#num)list) ++ [((1:num),(7:num))] ++ ([(2,7)]:(num#num)list)) : (num -> bool) -> num -> bool) = parsem ([((1:num),(7:num))] ++ ([(0,7)]:(num#num)list) ++ ([(2,7)]:(num#num)list))``; val th = prove(term, match_mp_tac (ISPECL [``([(0,7)]:(num#num)list)``,``(7:num)``,``(1:num)``,``([(2,7)]:(num#num)list)``,``([(0,7)]:(num#num)list) ++ [((1:num),(7:num))] ++ ([(2,7)]:(num#num)list)``] independence) >> EVAL_TAC) in report "ind_fanout" th term end;
val _ = let val term = ``(parsem (([(0,1)]:(num#num)list) ++ [((2:num),(2:num))] ++ ([(4,5)]:(num#num)list)) : (num -> num) -> num -> num) = parsem ([((2:num),(2:num))] ++ ([(0,1)]:(num#num)list) ++ ([(4,5)]:(num#num)list))``; val th = prove(term, match_mp_tac (ISPECL [``([(0,1)]:(num#num)list)``,``(2:num)``,``(2:num)``,``([(4,5)]:(num#num)list)``,``([(0,1)]:(num#num)list) ++ [((2:num),(2:num))] ++ ([(4,5)]:(num#num)list)``] independence) >> EVAL_TAC) in report "ind_self" th term end;
val _ = let val term = ``(parsem (([(F,T)]:(bool#bool)list) ++ [((T:bool),(F:bool))] ++ ([]:(bool#bool)list)) : (bool -> num) -> bool -> num) = parsem ([((T:bool),(F:bool))] ++ ([(F,T)]:(bool#bool)list) ++ ([]:(bool#bool)list))``; val th = prove(term, match_mp_tac (ISPECL [``([(F,T)]:(bool#bool)list)``,``(F:bool)``,``(T:bool)``,``([]:(bool#bool)list)``,``([(F,T)]:(bool#bool)list) ++ [((T:bool),(F:bool))] ++ ([]:(bool#bool)list)``] independence) >> EVAL_TAC) in report "ind_bool" th term end;
val _ = let val term = ``(parsem (([]:(bool#bool)list) ++ [((F:bool),(T:bool))] ++ ([]:(bool#bool)list)) : (bool -> bool) -> bool -> bool) = parsem ([((F:bool),(T:bool))] ++ ([]:(bool#bool)list) ++ ([]:(bool#bool)list))``; val th = prove(term, match_mp_tac (ISPECL [``([]:(bool#bool)list)``,``(T:bool)``,``(F:bool)``,``([]:(bool#bool)list)``,``([]:(bool#bool)list) ++ [((F:bool),(T:bool))] ++ ([]:(bool#bool)list)``] independence) >> EVAL_TAC) in report "ind_empty_others" th term end;
val _ = let val term = ``(parsem ([]:(num#num)list) : (num -> bool) -> num -> bool) = I``; val th = prove(term, rw[parsem_nil]) in report "ind_nil_nat" th term end;
val _ = let val term = ``(parsem ([]:(bool#bool)list) : (bool -> num) -> bool -> num) = I``; val th = prove(term, rw[parsem_nil]) in report "ind_nil_bool" th term end;
