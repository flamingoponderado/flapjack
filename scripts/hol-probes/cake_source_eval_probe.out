compiler_agrees_definition=∀(f :(num # num) # v # dec list -> (v # word8 list # word64 list) option) (args :(num # num) # v # dec list) (st_v :v) (bs_v :v) (ws_v :v). compiler_agrees f args (st_v,bs_v,ws_v) ⇔ case (f args,args,v_to_word8_list bs_v,v_to_word64_list ws_v) of ((NONE :(v # word8 list # word64 list) option),v6,v7) => F | (SOME (st,v22),(v16,v18),v12,(NONE :word64 list option)) => F | (SOME (st,v22),(v16,v18),(NONE :word8 list option),SOME ws) => F | (SOME (st,c_bs,c_ws),(v16,prev_st_v,v30),SOME bs,SOME ws) => st = st_v ∧ c_bs = bs ∧ c_ws = ws ∧ concrete_v st_v ∧ concrete_v prev_st_v
do_eval_definition=∀(vs :v list) (es :eval_state option). do_eval vs es = case (es,vs) of ((NONE :eval_state option),vs) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),([] :v list)) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),Litv v30::v15) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),Conv v31 v32::v15) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),Closure v33 v34 v35::v15) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),Recclosure v36 v37 v38::v15) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),Loc v39 v40::v15) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),Vectorv v41::v15) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),[Env env id]) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),[Env env id; st_v]) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),[Env env id; st_v; decs_v]) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),[Env env id; st_v; decs_v; st_v2]) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),[Env env id; st_v; decs_v; st_v2; bs_v]) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalDecs s),[Env env id; st_v; decs_v; st_v2; bs_v; ws_v]) => (case s.decode_decs decs_v of (NONE :dec list option) => (NONE :(v sem_env # dec list # eval_state option) option) | SOME decs => if st_v = s.compiler_state ∧ concrete_v decs_v ∧ compiler_agrees s.compiler (id,st_v,decs) (st_v2,bs_v,ws_v) then SOME (env,decs,SOME (EvalDecs (add_decs_generation (s with compiler_state := st_v2)))) else (NONE :(v sem_env # dec list # eval_state option) option)) | (SOME (EvalDecs s),Env env id::st_v::decs_v::st_v2::bs_v::ws_v::v66::v67) => (NONE :(v sem_env # dec list # eval_state option) option) | (SOME (EvalOracle s'),vs) => case s'.custom_do_eval vs s'.oracle of (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) => (NONE :(v sem_env # dec list # eval_state option) option) | SOME (env_id,oracle,decs) => case lookup_env s' env_id of (NONE :v sem_env option) => (NONE :(v sem_env # dec list # eval_state option) option) | SOME env => SOME (env,decs,SOME (EvalOracle (add_env_generation (s' with oracle := oracle))))
do_eval_res_definition=∀(vs :v list) (s :α state). (do_eval_res vs s :α state # (v sem_env # dec list, β) result) = case do_eval vs s.eval_state of (NONE :(v sem_env # dec list # eval_state option) option) => (s,(Rerr (Rabort Rtype_error :β error_result) :(v sem_env # dec list, β) result)) | SOME (env1,decs,es1) => (s with eval_state := es1,(Rval (env1,decs) :(v sem_env # dec list, β) result))
list_type_num_definition=list_type_num = (1 :num)
value_to_list_definition=(∀(stamp :stamp). v_to_list (Conv (SOME stamp) ([] :v list)) = if stamp = TypeStamp «[]» list_type_num then SOME ([] :v list) else (NONE :v list option)) ∧ (∀(v2 :v) (v1 :v) (stamp :stamp). v_to_list (Conv (SOME stamp) [v1; v2]) = if stamp = TypeStamp «::» list_type_num then case v_to_list v2 of (NONE :v list option) => (NONE :v list option) | SOME vs => SOME (v1::vs) else (NONE :v list option)) ∧ (∀(v :lit). v_to_list (Litv v) = (NONE :v list option)) ∧ (∀(v4 :v list). v_to_list (Conv (NONE :stamp option) v4) = (NONE :v list option)) ∧ (∀(v32 :v) (v30 :stamp). v_to_list (Conv (SOME v30) [v32]) = (NONE :v list option)) ∧ (∀(v41 :v list) (v40 :v) (v36 :v) (v32 :v) (v30 :stamp). v_to_list (Conv (SOME v30) (v32::v36::v40::v41)) = (NONE :v list option)) ∧ (∀(v7 :exp) (v6 :mlstring) (v5 :v sem_env). v_to_list (Closure v5 v6 v7) = (NONE :v list option)) ∧ (∀(v9 :(mlstring # mlstring # exp) list) (v8 :v sem_env) (v10 :mlstring). v_to_list (Recclosure v8 v9 v10) = (NONE :v list option)) ∧ (∀(v12 :num) (v11 :bool). v_to_list (Loc v11 v12) = (NONE :v list option)) ∧ (∀(v13 :v list). v_to_list (Vectorv v13) = (NONE :v list option)) ∧ ∀(v15 :num # num) (v14 :v sem_env). v_to_list (Env v14 v15) = (NONE :v list option)
maybe_all_list_definition=∀(v :α option list). maybe_all_list v = case v of ([] :α option list) => SOME ([] :α list) | (NONE :α option)::vs => (NONE :α list option) | SOME x::vs => case maybe_all_list vs of (NONE :α list option) => (NONE :α list option) | SOME xs => SOME (x::xs)
value_to_word8_definition=∀(v :v). v_to_word8 v = case v of Litv (IntLit v34) => (NONE :word8 option) | Litv (Char v35) => (NONE :word8 option) | Litv (StrLit v36) => (NONE :word8 option) | Litv (Word8 w) => SOME w | Litv (Word64 v38) => (NONE :word8 option) | Litv (Float64 v39) => (NONE :word8 option) | Conv v15 v16 => (NONE :word8 option) | Closure v17 v18 v19 => (NONE :word8 option) | Recclosure v20 v21 v22 => (NONE :word8 option) | Loc v23 v24 => (NONE :word8 option) | Vectorv v25 => (NONE :word8 option) | Env v26 v27 => (NONE :word8 option)
value_to_word64_definition=∀(v :v). v_to_word64 v = case v of Litv (IntLit v34) => (NONE :word64 option) | Litv (Char v35) => (NONE :word64 option) | Litv (StrLit v36) => (NONE :word64 option) | Litv (Word8 v37) => (NONE :word64 option) | Litv (Word64 w) => SOME w | Litv (Float64 v39) => (NONE :word64 option) | Conv v15 v16 => (NONE :word64 option) | Closure v17 v18 v19 => (NONE :word64 option) | Recclosure v20 v21 v22 => (NONE :word64 option) | Loc v23 v24 => (NONE :word64 option) | Vectorv v25 => (NONE :word64 option) | Env v26 v27 => (NONE :word64 option)
value_to_word8_list_definition=∀(v :v). v_to_word8_list v = case v_to_list v of (NONE :v list option) => (NONE :word8 list option) | SOME xs => maybe_all_list (MAP v_to_word8 xs)
value_to_word64_list_definition=∀(v :v). v_to_word64_list v = case v_to_list v of (NONE :v list option) => (NONE :word64 list option) | SOME xs => maybe_all_list (MAP v_to_word64 xs)
concrete_value_definition=(∀(v :v). concrete_v v ⇔ case v of Litv v14 => T | Conv v_ vs => concrete_v_list vs | Closure v17 v18 v19 => F | Recclosure v20 v21 v22 => F | Loc v23 v24 => T | Vectorv vs' => concrete_v_list vs' | Env v26 v27 => F) ∧ (concrete_v_list ([] :v list) ⇔ T) ∧ ∀(vs :v list) (v :v). concrete_v_list (v::vs) ⇔ concrete_v v ∧ concrete_v_list vs
agrees_type=:((num # num) # v # dec list -> (v # word8 list # word64 list) option) -> (num # num) # v # dec list -> v # v # v -> bool
eval_type=:v list -> eval_state option -> (v sem_env # dec list # eval_state option) option
result_type=:v list -> α state -> α state # (v sem_env # dec list, β) result
missing=(NONE :(v sem_env # dec list # eval_state option) option)
oracle=SOME ((0 :num),(1 :num),(2 :num))
decs=SOME ((0 :num),(9 :num),(0 :num),(10 :num))
mismatch=F
abort=T
