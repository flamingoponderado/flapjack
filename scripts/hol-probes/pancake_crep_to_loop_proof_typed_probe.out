all_distinct_ctxt_lookup_all_distinct_typed=ALL_DISTINCT (rts :num list) ∧ distinct_vars (ctxt :context).vars ⇒ ALL_DISTINCT (rt_vars ctxt.vars rts (n :num))
assigned_vars_MAPi_Assign_typed=∀(les :α loopLang$exp list) (offset :num). assigned_vars (nested_seq (MAPi (λ(n :num). (Assign (n + offset) :α loopLang$exp -> α loopLang$prog)) les)) = GENLIST ($+ offset) (LENGTH les)
assigned_vars_nested_seq_assign_typed=∀(vs :num list) (es :α loopLang$exp list). LENGTH vs = LENGTH es ⇒ assigned_vars (nested_seq (MAP2 (Assign :num -> α loopLang$exp -> α loopLang$prog) vs es :α loopLang$prog list)) = vs
call_preserve_state_code_locals_rel_typed=∀(ns :num list) (lns :num list) (args :α word_lab list) (s :(α, β) crepSem$state) (st :(α, β) state) (ctxt :context) (nl :sptree$num_set) (fname :mlstring) (argexps :α crepLang$exp list) (prog :α crepLang$prog) (loc :num). ALL_DISTINCT ns ∧ ALL_DISTINCT lns ∧ LENGTH ns = LENGTH lns ∧ LENGTH args = LENGTH lns ∧ state_rel s st ∧ mem_rel s.memory st.memory s.memaddrs ∧ globals_rel s.globals st.globals ∧ code_rel ctxt s.code st.code ∧ locals_rel ctxt nl s.locals st.locals ∧ FLOOKUP s.code fname = SOME (ns,prog) ∧ FLOOKUP ctxt.funcs fname = SOME (loc,LENGTH lns) ∧ MAP (eval s :α crepLang$exp -> α word_lab option) argexps = MAP (SOME :α word_lab -> α word_lab option) args ⇒ (let (nctxt :context) = ctxt_fc ctxt.target ctxt.funcs ns lns in state_rel (s with <|locals := (FEMPTY :num |-> α word_lab) |++ ZIP (ns,args); clock := s.clock − (1 :num)|>) (st with <|locals := fromAList (ZIP (lns,MAP (wlab_wloc :α word_lab -> α word_loc) args)); clock := st.clock − (1 :num)|>) ∧ code_rel nctxt s.code st.code ∧ locals_rel nctxt (list_to_num_set lns) ((FEMPTY :num |-> α word_lab) |++ ZIP (ns,args)) (fromAList (ZIP (lns,MAP (wlab_wloc :α word_lab -> α word_loc) args))))
code_rel2_def_typed=∀(ctxt :context) (s_code :mlstring |-> num list # α crepLang$prog) (t_code :(num list # α loopLang$prog) sptree$num_map). code_rel2 ctxt s_code t_code ⇔ code_rel ctxt (FMAP_MAP2 (λ((s :mlstring),(n :num list),(p :α crepLang$prog)). (n,simp_prog p)) s_code) t_code
code_rel_def_typed=∀(ctxt :context) (s_code :mlstring |-> num list # α crepLang$prog) (t_code :(num list # α loopLang$prog) sptree$num_map). code_rel ctxt s_code t_code ⇔ distinct_funcs ctxt.funcs ∧ ∀(f :mlstring) (ns :num list) (prog :α crepLang$prog). FLOOKUP s_code f = SOME (ns,prog) ⇒ ∃(loc :num) (len :num). FLOOKUP ctxt.funcs f = SOME (loc,len) ∧ LENGTH ns = len ∧ (let (args :num list) = GENLIST (I :num -> num) len; (nctxt :context) = ctxt_fc ctxt.target ctxt.funcs ns args in lookup loc t_code = SOME (args,ocompile nctxt (list_to_num_set args) prog))
code_rel_evaluate_call_correct_typed=code_rel2 (nctxt :context) (s_code :mlstring |-> num list # α crepLang$prog) (t_code :(num list # α loopLang$prog) sptree$num_map) ⇒ (evaluate ((Call (NONE :(num list # (α word # α crepLang$prog) option) option) (start :mlstring) ([] :α crepLang$exp list) :α crepLang$prog),(s :(α, β) crepSem$state)) :α crepSem$result option # (α, β) crepSem$state) = ((res :α crepSem$result option),(s' :(α, β) crepSem$state)) ⇒ (s.be ⇔ (t :(α, β) state).be) ∧ s.sh_memaddrs = t.sh_mdomain ∧ s.memaddrs = t.mdomain ∧ s.clock = t.clock ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr ∧ mem_rel s.memory t.memory s.memaddrs ∧ globals_rel s.globals t.globals ∧ s.locals = (FEMPTY :num |-> α word_lab) ∧ s.code = s_code ∧ t.code = t_code ⇒ FLOOKUP (make_funcs (crep_code :(mlstring # num list # α crepLang$prog) list)) start = SOME (find_lab nctxt start,(0 :num)) ⇒ find_lab nctxt start = (lc :num) ∧ s.code = alist_to_fmap crep_code ∧ nctxt.funcs = make_funcs crep_code ∧ ALOOKUP crep_code start = SOME (([] :num list),(prog :α crepLang$prog)) ∧ distinct_vars nctxt.vars ∧ ctxt_max nctxt.vmax nctxt.vars ⇒ res ≠ SOME (Error :α crepSem$result) ⇒ ∃(k :num) (res' :α result option) (t' :(α, β) state). (evaluate ((Call (NONE :(num list # sptree$num_set) option) (SOME (find_lab nctxt start)) ([] :num list) (NONE :(num # α loopLang$prog # α loopLang$prog # sptree$num_set) option) :α loopLang$prog),t with clock := t.clock + k) :α result option # (α, β) state) = (res',t') ∧ state_rel s' t' ∧ res' = case res of (NONE :α crepSem$result option) => (NONE :α result option) | SOME (Error :α crepSem$result) => SOME (Error :α result) | SOME (TimeOut :α crepSem$result) => SOME (TimeOut :α result) | SOME (Break n :α crepSem$result) => SOME (Break n :α result) | SOME (Continue n' :α crepSem$result) => SOME (Continue n' :α result) | SOME (Return vs :α crepSem$result) => SOME (Result (MAP (wlab_wloc :α word_lab -> α word_loc) vs) :α result) | SOME (Exception eid :α crepSem$result) => SOME (Exception (Word eid :α word_loc) :α result) | SOME (FinalFFI f :α crepSem$result) => SOME (FinalFFI f :α result)
code_rel_intro_typed=code_rel (ctxt :context) (s_code :mlstring |-> num list # α crepLang$prog) (t_code :(num list # α loopLang$prog) sptree$num_map) ⇒ distinct_funcs ctxt.funcs ∧ ∀(f :mlstring) (ns :num list) (prog :α crepLang$prog). FLOOKUP s_code f = SOME (ns,prog) ⇒ ∃(loc :num) (len :num). FLOOKUP ctxt.funcs f = SOME (loc,len) ∧ LENGTH ns = len ∧ (let (args :num list) = GENLIST (I :num -> num) len; (nctxt :context) = ctxt_fc ctxt.target ctxt.funcs ns args in lookup loc t_code = SOME (args,ocompile nctxt (list_to_num_set args) prog))
comp_exp_assigned_vars_tmp_bound_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exp ct tmp l e = (p,le,ntmp,nl) ∧ MEM n (assigned_vars (nested_seq p)) ⇒ tmp ≤ n ∧ n < ntmp
comp_exp_assigned_vars_tmp_bound_cases_typed=(∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exp ct tmp l e = (p,le,ntmp,nl) ∧ MEM n (assigned_vars (nested_seq p)) ⇒ tmp ≤ n ∧ n < ntmp) ∧ ∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exps ct tmp l e = (p,le,ntmp,nl) ∧ MEM n (assigned_vars (nested_seq p)) ⇒ tmp ≤ n ∧ n < ntmp
comp_exp_preserves_eval_typed=∀(s :(α, β) crepSem$state) (e :α crepLang$exp) (v :α word_lab) (t :(α, β) state) (ctxt :context) (tmp :num) (l :sptree$num_set) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set). (eval s e :α word_lab option) = SOME v ∧ state_rel s t ∧ mem_rel s.memory t.memory s.memaddrs ∧ globals_rel s.globals t.globals ∧ code_rel ctxt s.code t.code ∧ locals_rel ctxt l s.locals t.locals ∧ compile_exp ctxt tmp l e = (p,le,ntmp,nl) ∧ ctxt.vmax < tmp ⇒ ∃(ck :num) (st :(α, β) state). (evaluate (nested_seq p,t with clock := t.clock + ck) :α result option # (α, β) state) = ((NONE :α result option),st) ∧ (eval st le :α word_loc option) = SOME (wlab_wloc v) ∧ state_rel s st ∧ mem_rel s.memory st.memory s.memaddrs ∧ globals_rel s.globals st.globals ∧ code_rel ctxt s.code st.code ∧ locals_rel ctxt nl s.locals st.locals
comp_exps_assigned_vars_tmp_bound_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exps ct tmp l e = (p,le,ntmp,nl) ∧ MEM n (assigned_vars (nested_seq p)) ⇒ tmp ≤ n ∧ n < ntmp
comp_exps_preserves_eval_typed=∀(es :α crepLang$exp list) (s :(α, β) crepSem$state) (vs :α word_lab list) (t :(α, β) state) (ctxt :context) (tmp :num) (l :sptree$num_set) (p :α loopLang$prog list) (les :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vs ∧ state_rel s t ∧ mem_rel s.memory t.memory s.memaddrs ∧ globals_rel s.globals t.globals ∧ code_rel ctxt s.code t.code ∧ locals_rel ctxt l s.locals t.locals ∧ compile_exps ctxt tmp l es = (p,les,ntmp,nl) ∧ ctxt.vmax < tmp ⇒ ∃(ck :num) (st :(α, β) state). (evaluate (nested_seq p,t with clock := t.clock + ck) :α result option # (α, β) state) = ((NONE :α result option),st) ∧ OPT_MMAP (eval st :α loopLang$exp -> α word_loc option) les = SOME (MAP (wlab_wloc :α word_lab -> α word_loc) vs) ∧ state_rel s st ∧ mem_rel s.memory st.memory s.memaddrs ∧ globals_rel s.globals st.globals ∧ code_rel ctxt s.code st.code ∧ locals_rel ctxt nl s.locals st.locals
compile_exp_le_tmp_domain_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (tmp' :num) (l' :sptree$num_set) (n :num). ctxt_max ct.vmax ct.vars ∧ compile_exp ct tmp l e = (p,le,tmp',l') ∧ ct.vmax < tmp ∧ (∀(n :num). MEM n (var_cexp e) ⇒ ∃(m :num). FLOOKUP ct.vars n = SOME m ∧ m ∈ (domain l :num -> bool)) ∧ MEM n (locals_touched le) ⇒ n < tmp' ∧ n ∈ (domain l' :num -> bool)
compile_exp_le_tmp_domain_cases_typed=(∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (tmp' :num) (l' :sptree$num_set) (n :num). ctxt_max ct.vmax ct.vars ∧ compile_exp ct tmp l e = (p,le,tmp',l') ∧ ct.vmax < tmp ∧ (∀(n :num). MEM n (var_cexp e) ⇒ ∃(m :num). FLOOKUP ct.vars n = SOME m ∧ m ∈ (domain l :num -> bool)) ∧ MEM n (locals_touched le) ⇒ n < tmp' ∧ n ∈ (domain l' :num -> bool)) ∧ ∀(ct :context) (tmp :num) (l :sptree$num_set) (es :α crepLang$exp list) (p :α loopLang$prog list) (les :α loopLang$exp list) (tmp' :num) (l' :sptree$num_set) (n :num). ctxt_max ct.vmax ct.vars ∧ compile_exps ct tmp l es = (p,les,tmp',l') ∧ ct.vmax < tmp ∧ (∀(n :num). MEM n (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ⇒ ∃(m :num). FLOOKUP ct.vars n = SOME m ∧ m ∈ (domain l :num -> bool)) ∧ MEM n (FLAT (MAP (locals_touched :α loopLang$exp -> num list) les)) ⇒ n < tmp' ∧ n ∈ (domain l' :num -> bool)
compile_exp_out_rel_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set). compile_exp ct tmp l e = (p,le,ntmp,nl) ⇒ comp_syntax_ok l (nested_seq p) ∧ tmp ≤ ntmp ∧ nl = cut_sets l (nested_seq p)
compile_exp_out_rel_cases_typed=(∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set). compile_exp ct tmp l e = (p,le,ntmp,nl) ⇒ comp_syntax_ok l (nested_seq p) ∧ tmp ≤ ntmp ∧ nl = cut_sets l (nested_seq p)) ∧ ∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set). compile_exps ct tmp l e = (p,le,ntmp,nl) ⇒ comp_syntax_ok l (nested_seq p) ∧ tmp ≤ ntmp ∧ nl = cut_sets l (nested_seq p) ∧ LENGTH le = LENGTH e
compile_exps_alt_typed=compile_exps (ctxt :context) (tmp :num) (l :sptree$num_set) ([] :α crepLang$exp list) = (([] :α loopLang$prog list),([] :α loopLang$exp list),tmp,l) ∧ compile_exps ctxt tmp l ((e :β crepLang$exp)::(es :β crepLang$exp list)) = (let ((p :β loopLang$prog list),(le :β loopLang$exp),(tmp' :num),(l' :sptree$num_set)) = compile_exp ctxt tmp l e; ((p1 :β loopLang$prog list),(les :β loopLang$exp list),(tmp'' :num),(l'' :sptree$num_set)) = compile_exps ctxt tmp' l' es in (p ++ p1,le::les,tmp'',l''))
compile_exps_le_tmp_domain_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (es :α crepLang$exp list) (p :α loopLang$prog list) (les :α loopLang$exp list) (tmp' :num) (l' :sptree$num_set) (n :num). ctxt_max ct.vmax ct.vars ∧ compile_exps ct tmp l es = (p,les,tmp',l') ∧ ct.vmax < tmp ∧ (∀(n :num). MEM n (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ⇒ ∃(m :num). FLOOKUP ct.vars n = SOME m ∧ m ∈ (domain l :num -> bool)) ∧ MEM n (FLAT (MAP (locals_touched :α loopLang$exp -> num list) les)) ⇒ n < tmp' ∧ n ∈ (domain l' :num -> bool)
compile_exps_out_rel_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set). compile_exps ct tmp l e = (p,le,ntmp,nl) ⇒ comp_syntax_ok l (nested_seq p) ∧ tmp ≤ ntmp ∧ nl = cut_sets l (nested_seq p) ∧ LENGTH le = LENGTH e
compile_prog_distinct_params_typed=∀(prog :(mlstring # num list # α crepLang$prog) list) (c :architecture). EVERY (λ((name :mlstring),(params :num list),(body :α crepLang$prog)). ALL_DISTINCT params) prog ⇒ EVERY (λ((name :num),(params :num list),(body :α loopLang$prog)). ALL_DISTINCT params) (compile_prog c prog)
crep_sem_is_wrapper_typed=semantics (s :(α, β) crepSem$state) (start :mlstring) = (let (prog :α crepLang$prog) = (Call (NONE :(num list # (α word # α crepLang$prog) option) option) start ([] :α crepLang$exp list) :α crepLang$prog) in semantics_wrapper (((λ(res :α crepSem$result option). case res of (NONE :α crepSem$result option) => (RunError :outcome semantics_run_res) | SOME (Error :α crepSem$result) => (RunError :outcome semantics_run_res) | SOME (TimeOut :α crepSem$result) => (Incomplete :outcome semantics_run_res) | SOME (Break v7 :α crepSem$result) => (RunError :outcome semantics_run_res) | SOME (Continue v8 :α crepSem$result) => (RunError :outcome semantics_run_res) | SOME (Return v9 :α crepSem$result) => (CompleteResult Success :outcome semantics_run_res) | SOME (Exception v10 :α crepSem$result) => (RunError :outcome semantics_run_res) | SOME (FinalFFI e :α crepSem$result) => (CompleteResult (FFI_outcome e) :outcome semantics_run_res)) ## (λ(s :(α, β) crepSem$state). s.ffi.io_events)) ∘ (λ(k :num). (evaluate (prog,s with clock := k) :α crepSem$result option # (α, β) crepSem$state))))
crep_to_loop_compile_prog_lab_min_typed=compile_prog (c :architecture) (cprog :(mlstring # num list # α crepLang$prog) list) = (lprog :(num # num list # α loopLang$prog) list) ⇒ EVERY (λ(prog :num # num list # α loopLang$prog). (60 :num) ≤ FST prog) lprog
ctxt_fc_def_typed=∀(c :architecture) (cvs :mlstring |-> num # num) (ns :num list) (args :num list). ctxt_fc c cvs ns args = <|vars := (FEMPTY :num |-> num) |++ ZIP (ns,args); funcs := cvs; vmax := MAX_LIST args; target := c|>
ctxt_max_def_typed=∀(n :num) (fm :α |-> num). ctxt_max n fm ⇔ ∀(v :α) (m :num). FLOOKUP fm v = SOME m ⇒ m ≤ n
cut_sets_MAPi_Assign_typed=∀(les :α loopLang$exp list) (cs :sptree$num_set) (offset :num). cut_sets cs (nested_seq (MAPi (λ(n :num). (Assign (n + offset) :α loopLang$exp -> α loopLang$prog)) les)) = list_insert (GENLIST ($+ offset) (LENGTH les)) cs
distinct_funcs_def_typed=∀(fm :α |-> β # γ). distinct_funcs fm ⇔ ∀(x :α) (y :α) (n :β) (m :β) (rm :γ) (rm' :γ). FLOOKUP fm x = SOME (n,rm) ∧ FLOOKUP fm y = SOME (m,rm') ∧ n = m ⇒ x = y
distinct_make_funcs_typed=∀(crep_code :(α # β list # γ) list). distinct_funcs (make_funcs crep_code)
distinct_vars_def_typed=∀(fm :α |-> β). distinct_vars fm ⇔ ∀(x :α) (y :α) (n :β) (m :β). FLOOKUP fm x = SOME n ∧ FLOOKUP fm y = SOME m ∧ n = m ⇒ x = y
evaluate_comb_seq_typed=∀(p :α loopLang$prog) (s :(α, β) state) (t :(α, β) state) (q :α loopLang$prog) (r :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = ((NONE :α result option),t) ∧ (evaluate (q,t) :α result option # (α, β) state) = ((NONE :α result option),r) ⇒ (evaluate (Seq p q,s) :α result option # (α, β) state) = ((NONE :α result option),r)
evaluate_nested_seq_append_first_typed=∀(p :α loopLang$prog list) (q :α loopLang$prog list) (s :(α, β) state) (st :(α, β) state) (t :(α, β) state). (evaluate (nested_seq (p ++ q),s) :α result option # (α, β) state) = ((NONE :α result option),t) ∧ (evaluate (nested_seq p,s) :α result option # (α, β) state) = ((NONE :α result option),st) ⇒ (evaluate (nested_seq q,st) :α result option # (α, β) state) = ((NONE :α result option),t)
evaluate_none_nested_seq_append_typed=∀(p :γ loopLang$prog list) (s :(γ, δ) state) (st :(γ, δ) state) (q :γ loopLang$prog list). (evaluate (nested_seq p,s) :γ result option # (γ, δ) state) = ((NONE :γ result option),st) ⇒ (evaluate (nested_seq (p ++ q),s) :γ result option # (γ, δ) state) = (evaluate (nested_seq q,st) :γ result option # (γ, δ) state)
evaluate_not_none_nested_seq_append_typed=∀(p :ε loopLang$prog list) (s :(ε, ζ) state) (res :ε result option) (st :(ε, ζ) state) (q :ε loopLang$prog list). (evaluate (nested_seq p,s) :ε result option # (ε, ζ) state) = (res,st) ∧ res ≠ (NONE :ε result option) ⇒ (evaluate (nested_seq (p ++ q),s) :ε result option # (ε, ζ) state) = (evaluate (nested_seq p,s) :ε result option # (ε, ζ) state)
first_compile_prog_all_distinct_typed=∀(c :architecture) (crep_code :(mlstring # num list # α crepLang$prog) list). ALL_DISTINCT (MAP (FST :num # num list # α loopLang$prog -> num) (compile_prog c crep_code))
globals_rel_def_typed=∀(sglobals :α |-> β word_lab) (tglobals :α |-> β word_loc). globals_rel sglobals tglobals ⇔ ∀(ad :α) (v :β word_lab). FLOOKUP sglobals ad = SOME v ⇒ FLOOKUP tglobals ad = SOME (wlab_wloc v)
globals_rel_intro_typed=globals_rel (sglobals :α |-> β word_lab) (tglobals :α |-> β word_loc) ⇒ ∀(ad :α) (v :β word_lab). FLOOKUP sglobals ad = SOME v ⇒ FLOOKUP tglobals ad = SOME (wlab_wloc v)
initial_prog_make_funcs_el_typed=∀(prog :(α # β list # γ) list) (start :α) (n :num). FLOOKUP (make_funcs prog) start = SOME (n + first_name,(0 :num)) ⇒ (start,([] :β list),((SND :β list # γ -> γ) ∘ (SND :α # β list # γ -> β list # γ)) prog❲n❳) = prog❲n❳ ∧ n < LENGTH prog
insert_insert_eq_typed=insert (a :num) (b :α) (insert a b (c :α sptree$num_map)) = insert a b c
list_insert_SNOC_typed=∀(y :num list) (l :sptree$num_set) (x :num). list_insert (SNOC x y) l = insert x () (list_insert y l)
list_insert_append_typed=∀(xs :num list) (ys :num list) (l :sptree$num_set). list_insert (xs ++ ys) l = list_insert xs (list_insert ys l)
list_insert_insert_typed=∀(x :num) (xs :num list) (l :sptree$num_set). insert x () (list_insert xs l) = list_insert xs (insert x () l)
locals_rel_cutset_prop_typed=∀(ct :context) (cset :sptree$num_set) (lcl :num |-> α word_lab) (lcl' :α word_loc sptree$num_map) (cset' :sptree$num_set) (lcl'' :α word_loc sptree$num_map). locals_rel ct cset lcl lcl' ∧ locals_rel ct cset' lcl lcl'' ∧ subspt cset cset' ⇒ locals_rel ct cset lcl lcl''
locals_rel_def_typed=∀(ctxt :context) (l :sptree$num_set) (s_locals :num |-> α word_lab) (t_locals :α word_loc sptree$num_map). locals_rel ctxt l s_locals t_locals ⇔ distinct_vars ctxt.vars ∧ ctxt_max ctxt.vmax ctxt.vars ∧ (domain l :num -> bool) ⊆ (domain t_locals :num -> bool) ∧ ∀(vname :num) (v :α word_lab). FLOOKUP s_locals vname = SOME v ⇒ ∃(n :num). FLOOKUP ctxt.vars vname = SOME n ∧ n ∈ (domain l :num -> bool) ∧ lookup n t_locals = SOME (wlab_wloc v)
locals_rel_insert_gt_vmax_typed=∀(ct :context) (cset :sptree$num_set) (lcl :num |-> α word_lab) (lcl' :α word_loc sptree$num_map) (n :num) (w :α word_loc). locals_rel ct cset lcl lcl' ∧ ct.vmax < n ⇒ locals_rel ct cset lcl (insert n w lcl')
locals_rel_intro_typed=locals_rel (ctxt :context) (l :sptree$num_set) (s_locals :num |-> α word_lab) (t_locals :α word_loc sptree$num_map) ⇒ distinct_vars ctxt.vars ∧ ctxt_max ctxt.vmax ctxt.vars ∧ (domain l :num -> bool) ⊆ (domain t_locals :num -> bool) ∧ ∀(vname :num) (v :α word_lab). FLOOKUP s_locals vname = SOME v ⇒ ∃(n :num). FLOOKUP ctxt.vars vname = SOME n ∧ n ∈ (domain l :num -> bool) ∧ lookup n t_locals = SOME (wlab_wloc v)
loop_sem_is_wrapper_typed=semantics (s :(α, β) state) (start :num) = (let (prog :α loopLang$prog) = (Call (NONE :(num list # sptree$num_set) option) (SOME start) ([] :num list) (NONE :(num # α loopLang$prog # α loopLang$prog # sptree$num_set) option) :α loopLang$prog) in semantics_wrapper (((λ(res :α result option). case res of (NONE :α result option) => (RunError :outcome semantics_run_res) | SOME (Result v7 :α result) => (CompleteResult Success :outcome semantics_run_res) | SOME (Exception v8 :α result) => (RunError :outcome semantics_run_res) | SOME (Break v9 :α result) => (RunError :outcome semantics_run_res) | SOME (Continue v10 :α result) => (RunError :outcome semantics_run_res) | SOME (TimeOut :α result) => (Incomplete :outcome semantics_run_res) | SOME (FinalFFI e :α result) => (CompleteResult (FFI_outcome e) :outcome semantics_run_res) | SOME (Error :α result) => (RunError :outcome semantics_run_res)) ## (λ(s :(α, β) state). s.ffi.io_events)) ∘ (λ(k :num). (evaluate (prog,s with clock := k) :α result option # (α, β) state))))
make_funcs_domain_compile_prog_typed=∀(start :mlstring) (lc :num) (crep_code :(mlstring # num list # α crepLang$prog) list) (c :architecture). FLOOKUP (make_funcs crep_code) start = SOME (lc,(0 :num)) ⇒ lc ∈ (domain (fromAList (compile_prog c crep_code)) :num -> bool)
map_map2_fst_typed=∀(xs :α list) (ys :(β # γ list # δ) list) (h :γ list -> δ -> ε). LENGTH xs = LENGTH ys ⇒ MAP (FST :α # num list # ε -> α) (MAP2 (λ(x :α) ((n :β),(p :γ list),(b :δ)). (x,GENLIST (I :num -> num) (LENGTH p),h p b)) xs ys :(α # num list # ε) list) = xs
mem_lookup_fromalist_some_typed=∀(xs :(num # α) list) (n :num) (x :α). ALL_DISTINCT (MAP (FST :num # α -> num) xs) ∧ MEM (n,x) xs ⇒ lookup n (fromAList xs) = SOME x
mem_rel_def_typed=∀(smem :α -> β word_lab) (tmem :α -> β word_loc) (dom :α -> bool). mem_rel smem tmem dom ⇔ ∀(ad :α). ad ∈ dom ⇒ wlab_wloc (smem ad) = tmem ad
mem_rel_intro_typed=mem_rel (smem :α -> β word_lab) (tmem :α -> β word_loc) (dm :α -> bool) ⇒ ∀(ad :α). ad ∈ dm ⇒ wlab_wloc (smem ad) = tmem ad
member_cutset_survives_comp_exp_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). n ∈ (domain l :num -> bool) ∧ compile_exp ct tmp l e = (p,le,ntmp,nl) ⇒ survives n (nested_seq p)
member_cutset_survives_comp_exp_cases_typed=(∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). n ∈ (domain l :num -> bool) ∧ compile_exp ct tmp l e = (p,le,ntmp,nl) ⇒ survives n (nested_seq p)) ∧ ∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). n ∈ (domain l :num -> bool) ∧ compile_exps ct tmp l e = (p,le,ntmp,nl) ⇒ survives n (nested_seq p)
member_cutset_survives_comp_exps_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). n ∈ (domain l :num -> bool) ∧ compile_exps ct tmp l e = (p,le,ntmp,nl) ⇒ survives n (nested_seq p)
member_cutset_survives_comp_prog_typed=∀(ctxt :context) (l :sptree$num_set) (p :α crepLang$prog) (n :num). n ∈ (domain l :num -> bool) ⇒ survives n (compile ctxt l p)
mk_ctxt_code_imp_code_rel2_typed=∀(c :architecture) (crep_code :(mlstring # num list # α crepLang$prog) list) (start :mlstring) (np :α crepLang$prog). ALL_DISTINCT (MAP (FST :mlstring # num list # α crepLang$prog -> mlstring) crep_code) ∧ ALOOKUP crep_code start = SOME (([] :num list),np) ⇒ code_rel2 (mk_ctxt c (FEMPTY :num |-> num) (make_funcs crep_code) (0 :num)) (alist_to_fmap crep_code) (fromAList (compile_prog c crep_code))
ncompile_correct_typed=∀(v :α crepLang$prog) (v1 :(α, β) crepSem$state) (res :α crepSem$result option) (s1 :(α, β) crepSem$state) (t :(α, β) state) (ctxt :context) (l :sptree$num_set). (evaluate (v,v1) :α crepSem$result option # (α, β) crepSem$state) = (res,s1) ∧ res ≠ SOME (Error :α crepSem$result) ∧ state_rel v1 t ∧ mem_rel v1.memory t.memory v1.memaddrs ∧ globals_rel v1.globals t.globals ∧ code_rel ctxt v1.code t.code ∧ locals_rel ctxt l v1.locals t.locals ⇒ ∃(ck :num) (res1 :α result option) (t1 :(α, β) state). (evaluate (compile ctxt l v,t with clock := t.clock + ck) :α result option # (α, β) state) = (res1,t1) ∧ state_rel s1 t1 ∧ mem_rel s1.memory t1.memory s1.memaddrs ∧ globals_rel s1.globals t1.globals ∧ code_rel ctxt s1.code t1.code ∧ res1 = (case res of (NONE :α crepSem$result option) => (NONE :α result option) | SOME (Error :α crepSem$result) => SOME (Error :α result) | SOME (TimeOut :α crepSem$result) => SOME (TimeOut :α result) | SOME (Break n :α crepSem$result) => SOME (Break n :α result) | SOME (Continue n' :α crepSem$result) => SOME (Continue n' :α result) | SOME (Return vs :α crepSem$result) => SOME (Result (MAP (wlab_wloc :α word_lab -> α word_loc) vs) :α result) | SOME (Exception eid :α crepSem$result) => SOME (Exception (Word eid :α word_loc) :α result) | SOME (FinalFFI f :α crepSem$result) => SOME (FinalFFI f :α result)) ∧ case res of (NONE :α crepSem$result option) => locals_rel ctxt l s1.locals t1.locals | SOME (Error :α crepSem$result) => F | SOME (TimeOut :α crepSem$result) => T | SOME (Break n :α crepSem$result) => locals_rel ctxt l s1.locals t1.locals | SOME (Continue n' :α crepSem$result) => locals_rel ctxt l s1.locals t1.locals | SOME (Return vs :α crepSem$result) => T | SOME (Exception v10 :α crepSem$result) => T | SOME (FinalFFI v11 :α crepSem$result) => T
not_mem_assigned_mem_gt_comp_exp_typed=∀(ctxt :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exp ctxt tmp l e = (p,le,ntmp,nl) ∧ ctxt_max ctxt.vmax ctxt.vars ∧ (∀(v :num) (m :num). FLOOKUP ctxt.vars v = SOME m ⇒ n ≠ m) ∧ n < tmp ⇒ ¬MEM n (assigned_vars (nested_seq p))
not_mem_assigned_mem_gt_comp_exp_cases_typed=(∀(ctxt :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exp ctxt tmp l e = (p,le,ntmp,nl) ∧ ctxt_max ctxt.vmax ctxt.vars ∧ (∀(v :num) (m :num). FLOOKUP ctxt.vars v = SOME m ⇒ n ≠ m) ∧ n < tmp ⇒ ¬MEM n (assigned_vars (nested_seq p))) ∧ ∀(ctxt :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exps ctxt tmp l e = (p,le,ntmp,nl) ∧ ctxt_max ctxt.vmax ctxt.vars ∧ (∀(v :num) (m :num). FLOOKUP ctxt.vars v = SOME m ⇒ n ≠ m) ∧ n < tmp ⇒ ¬MEM n (assigned_vars (nested_seq p))
not_mem_assigned_mem_gt_comp_exps_typed=∀(ctxt :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). compile_exps ctxt tmp l e = (p,le,ntmp,nl) ∧ ctxt_max ctxt.vmax ctxt.vars ∧ (∀(v :num) (m :num). FLOOKUP ctxt.vars v = SOME m ⇒ n ≠ m) ∧ n < tmp ⇒ ¬MEM n (assigned_vars (nested_seq p))
not_mem_context_assigned_mem_gt_typed=∀(ctxt :context) (l :sptree$num_set) (p :α crepLang$prog) (n :num). ctxt_max ctxt.vmax ctxt.vars ∧ (∀(v :num) (m :num). FLOOKUP ctxt.vars v = SOME m ⇒ n ≠ m) ∧ n ≤ ctxt.vmax ⇒ ¬MEM n (assigned_vars (compile ctxt l p))
ocompile_correct_typed=(evaluate ((p :α crepLang$prog),(s :(α, β) crepSem$state)) :α crepSem$result option # (α, β) crepSem$state) = ((res :α crepSem$result option),(s1 :(α, β) crepSem$state)) ∧ state_rel s (t :(α, β) state) ∧ mem_rel s.memory t.memory s.memaddrs ∧ globals_rel s.globals t.globals ∧ code_rel (ctxt :context) s.code t.code ∧ locals_rel ctxt (l :sptree$num_set) s.locals t.locals ∧ res ≠ SOME (Error :α crepSem$result) ∧ (∀(n :num). res ≠ SOME (Break n :α crepSem$result)) ∧ (∀(n :num). res ≠ SOME (Continue n :α crepSem$result)) ∧ res ≠ (NONE :α crepSem$result option) ⇒ ∃(ck :num) (res1 :α result option) (t1 :(α, β) state). (evaluate (ocompile ctxt l p,t with clock := t.clock + ck) :α result option # (α, β) state) = (res1,t1) ∧ state_rel s1 t1 ∧ mem_rel s1.memory t1.memory s1.memaddrs ∧ globals_rel s1.globals t1.globals ∧ code_rel ctxt s1.code t1.code ∧ case res of (NONE :α crepSem$result option) => F | SOME (Error :α crepSem$result) => F | SOME (TimeOut :α crepSem$result) => res1 = SOME (TimeOut :α result) | SOME (Break n :α crepSem$result) => F | SOME (Continue n' :α crepSem$result) => F | SOME (Return v :α crepSem$result) => res1 = SOME (Result (MAP (wlab_wloc :α word_lab -> α word_loc) v) :α result) | SOME (Exception eid :α crepSem$result) => res1 = SOME (Exception (Word eid :α word_loc) :α result) | SOME (FinalFFI f :α crepSem$result) => res1 = SOME (FinalFFI f :α result)
semantics_wrapper_def_typed=∀(f :num -> outcome semantics_run_res # io_event list). semantics_wrapper f = if ∃(k :num) (v :io_event list). f k = ((RunError :outcome semantics_run_res),v) then Fail else case some(res :behaviour). ∃(k :num) (r :outcome) (ev :io_event list). f k = ((CompleteResult r :outcome semantics_run_res),ev) ∧ res = Terminate r ev of (NONE :behaviour option) => Diverge (LUB (IMAGE ((fromList :io_event list -> io_event llist) ∘ (SND :outcome semantics_run_res # io_event list -> io_event list) ∘ f) 𝕌(:num))) | SOME res => res
semantics_wrapper_eq_typed=semantics_wrapper (absf :num -> outcome semantics_run_res # io_event list) ≠ Fail ⇒ (∀(k :num) (r :outcome semantics_run_res) (ev :io_event list). absf k = (r,ev) ∧ r ≠ (RunError :outcome semantics_run_res) ⇒ ∃(k' :num). (concf :num -> outcome semantics_run_res # io_event list) (k + k') = (r,ev)) ⇒ (∀(k :num) (k' :num) (r :outcome semantics_run_res) (ev :io_event list). concf k = (r,ev) ⇒ r ≠ (Incomplete :outcome semantics_run_res) ⇒ concf (k + k') = (r,ev)) ⇒ (∀(k :num) (k' :num) (r :outcome semantics_run_res) (ev :io_event list). absf k = (r,ev) ⇒ r ≠ (Incomplete :outcome semantics_run_res) ⇒ absf (k + k') = (r,ev)) ⇒ (∀(k :num) (k' :num) (ev :io_event list). absf (k + k') = ((Incomplete :outcome semantics_run_res),ev) ⇒ ∃(r' :outcome semantics_run_res) (ev' :io_event list). absf k = (r',ev') ∧ ev' ≼ ev) ⇒ (∀(k :num) (k' :num) (ev :io_event list). concf (k + k') = ((Incomplete :outcome semantics_run_res),ev) ⇒ ∃(r' :outcome semantics_run_res) (ev' :io_event list). concf k = (r',ev') ∧ ev' ≼ ev) ⇒ semantics_wrapper concf = semantics_wrapper absf
state_rel_clock_add_zero_typed=∀(s :(α, β) crepSem$state) (t :(α, β) state). state_rel s t ⇒ ∃(ck :num). state_rel s (t with clock := ck + t.clock)
state_rel_def_typed=∀(s :(α, 'ffi) crepSem$state) (t :(α, 'ffi) state). state_rel s t ⇔ s.memaddrs = t.mdomain ∧ s.sh_memaddrs = t.sh_mdomain ∧ s.clock = t.clock ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr
state_rel_imp_semantics_typed=∀(s :(α, β) crepSem$state) (t :(α, β) state) (crep_code :(mlstring # num list # α crepLang$prog) list) (start :mlstring) (lc :num) (c :architecture). s.memaddrs = t.mdomain ∧ (s.be ⇔ t.be) ∧ s.sh_memaddrs = t.sh_mdomain ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr ∧ mem_rel s.memory t.memory s.memaddrs ∧ globals_rel s.globals t.globals ∧ ALL_DISTINCT (MAP (FST :mlstring # num list # α crepLang$prog -> mlstring) crep_code) ∧ s.code = alist_to_fmap crep_code ∧ t.code = fromAList (compile_prog c crep_code) ∧ s.locals = (FEMPTY :num |-> α word_lab) ∧ FLOOKUP (make_funcs crep_code) start = SOME (lc,(0 :num)) ∧ semantics s start ≠ Fail ⇒ semantics t lc = semantics s start
state_rel_intro_typed=state_rel (s :(α, 'ffi) crepSem$state) (t :(α, 'ffi) state) ⇔ s.memaddrs = t.mdomain ∧ s.sh_memaddrs = t.sh_mdomain ∧ s.clock = t.clock ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr
survives_MAPi_Assign_typed=∀(n :num) (les :α loopLang$exp list) (offset :num). survives n (nested_seq (MAPi (λ(n :num). (Assign (n + offset) :α loopLang$exp -> α loopLang$prog)) les)) ⇔ T
wlab_wloc_def_typed=∀(w :α word). wlab_wloc (Word w :α word_lab) = (Word w :α word_loc)
write_bytearray_mem_rel_typed=∀(nb :word8 list) (sm :α word -> α word_lab) (tm :α word -> α word_loc) (w :α word) (dm :α word -> bool) (be :bool). mem_rel sm tm dm ⇒ mem_rel (write_bytearray w nb sm dm be) (write_bytearray w nb tm dm be) dm
ALOOKUP_EQ_EL_typed=(n :num) < LENGTH (xs :(α # β) list) ⇒ FST xs❲n❳ = (nm :α) ⇒ ALL_DISTINCT (MAP (FST :α # β -> α) xs) ⇒ (y :β) = SND xs❲n❳ ⇒ ALOOKUP xs nm = SOME y
OPT_MMAP_APPEND_typed=OPT_MMAP (f :β -> α option) ((xs :β list) ++ (ys :β list)) = OPTION_BIND (OPT_MMAP f xs) (λ(xsv :α list). OPTION_BIND (OPT_MMAP f ys) (λ(ysv :α list). SOME (xsv ++ ysv)))
PAIR_MAP_EQ_UNCURRY_typed=(f :α -> γ) ## (g :β -> δ) = (λ((x :α),(y :β)). (f x,g y))
UNCURRY_eq_case_typed=UNCURRY (f :β -> γ -> α) (x :β # γ) = case x of (a,b) => f a b
case_le_typed=(case (dest :α option) of (NONE :α option) => (1 :num) | SOME v1 => (0 :num)) ≤ (1 :num)
crep_eval_upd_clock_typed=(eval ((s :(α, β) crepSem$state) with clock := (v :num)) :α crepLang$exp -> α word_lab option) = (eval s :α crepLang$exp -> α word_lab option)
crep_primop_loop_primop_typed=∀(pop :primop) (ws :α word_lab list) (res_ws :α word_lab list). crep_primop pop ws = SOME res_ws ⇒ loop_primop pop (MAP (wlab_wloc :α word_lab -> α word_loc) ws) = SOME (MAP (wlab_wloc :α word_lab -> α word_loc) res_ws)
evaluate_Seq_Skip_typed=(evaluate (Seq (prog :α loopLang$prog) (Skip :α loopLang$prog),(s :(α, β) state)) :α result option # (α, β) state) = (evaluate (prog,s) :α result option # (α, β) state)
evaluate_less_clock_cases_typed=(evaluate ((prog :α loopLang$prog),(s :(α, β) state)) :α result option # (α, β) state) = ((res :α result option),(s2 :(α, β) state)) ⇒ (ck :num) ≤ s.clock ⇒ ∃(res2 :α result option) (s3 :(α, β) state). (evaluate (prog,s with clock := ck) :α result option # (α, β) state) = (res2,s3) ∧ (res = res2 ∧ (∃(ck2 :num). s3 = s2 with clock := ck2) ∨ res2 = SOME (TimeOut :α result))
evaluate_none_nested_seq_append_eq_typed=(evaluate (nested_seq (p :α loopLang$prog list),(s :(α, β) state)) :α result option # (α, β) state) = ((NONE :α result option),(s1 :(α, β) state)) ∧ (evaluate (nested_seq (q :α loopLang$prog list),s1) :α result option # (α, β) state) = (res_s :α result option # (α, β) state) ⇒ (evaluate (nested_seq (p ++ q),s) :α result option # (α, β) state) = res_s
evaluate_twice_cases_typed=(evaluate ((prog :α loopLang$prog),(s :(α, β) state)) :α result option # (α, β) state) = ((res :α result option),(s2 :(α, β) state)) ⇒ (evaluate (prog,(s3 :(α, β) state)) :α result option # (α, β) state) = ((res2 :α result option),(s4 :(α, β) state)) ⇒ s with clock := (0 :num) = s3 with clock := (0 :num) ⇒ s.clock ≤ s3.clock ∧ (res = SOME (TimeOut :α result) ∨ res = res2 ∧ ∃(ck :num). s2 = s4 with clock := ck) ∨ s3.clock ≤ s.clock ∧ (res2 = SOME (TimeOut :α result) ∨ res2 = res ∧ ∃(ck :num). s4 = s2 with clock := ck)
find_code_collapse_cases_typed=((dest :num option) ≠ (NONE :num option) ⇒ dest = SOME (loc :num)) ⇒ (find_code dest ((args1 :α word_loc list) ++ TAKE (case dest of (NONE :num option) => (1 :num) | SOME v => (0 :num)) [(Loc loc (0 :num) :α word_loc)]) (st :(β, γ) state).code :(α word_loc sptree$num_map # β loopLang$prog) option) = case lookup loc st.code of (NONE :(num list # β loopLang$prog) option) => (NONE :(α word_loc sptree$num_map # β loopLang$prog) option) | SOME (params,exp) => if LENGTH args1 = LENGTH params then SOME (fromAList (ZIP (params,args1)),exp) else (NONE :(α word_loc sptree$num_map # β loopLang$prog) option)
locals_rel_inter_helper_typed=locals_rel (ctxt :context) (l :sptree$num_set) (locs1 :num |-> α word_lab) (locs2 :α word_loc sptree$num_map) ⇒ EVERY (λ(i :num). lookup i l = (NONE :unit option)) (xs :num list) ⇒ LENGTH xs = LENGTH (ys :α word_loc list) ⇒ locals_rel ctxt l locs1 (inter (alist_insert xs ys locs2) l)
locals_rel_lookup_same_typed=locals_rel (ctxt :context) (l :sptree$num_set) (locs1 :num |-> α word_lab) (locs2 :α word_loc sptree$num_map) ⇒ (∀(n :num). lookup n locs2 = lookup n (locs3 :α word_loc sptree$num_map)) ⇒ locals_rel ctxt l locs1 locs3
loop_eval_upd_clock_typed=(eval ((s :(α, β) state) with clock := (v :num)) :α loopLang$exp -> α word_loc option) = (eval s :α loopLang$exp -> α word_loc option)
not_mem_nlhss_lemma_typed=∀(ctxt :context) (vname :num) (lhss :num list) (n :num) (nlhss :num list). distinct_vars ctxt.vars ∧ ¬MEM vname lhss ∧ FLOOKUP ctxt.vars vname = SOME n ∧ OPT_MMAP (FLOOKUP ctxt.vars) lhss = SOME nlhss ⇒ ¬MEM n nlhss
opt_mmap_lhss_locals_rel_typed=∀(lhss :num list) (s :(α, β) crepSem$state) (t :(α, γ) state) (ctxt :context) (l :sptree$num_set). EVERY (λ(v :num). IS_SOME (FLOOKUP s.locals v)) lhss ∧ ALL_DISTINCT lhss ∧ locals_rel ctxt l s.locals t.locals ⇒ ∃(nlhss :num list). OPT_MMAP (FLOOKUP ctxt.vars) lhss = SOME nlhss ∧ LENGTH nlhss = LENGTH lhss ∧ EVERY (λ(n :num). n ∈ (domain l :num -> bool)) nlhss ∧ ALL_DISTINCT nlhss
opt_mmap_rhss_locals_rel_typed=∀(rhss :num list) (ws :α word_lab list) (s :(α, β) crepSem$state) (t :(α, γ) state) (ctxt :context) (l :sptree$num_set). OPT_MMAP (FLOOKUP s.locals) rhss = SOME ws ∧ locals_rel ctxt l s.locals t.locals ⇒ ∃(nrhss :num list). OPT_MMAP (FLOOKUP ctxt.vars) rhss = SOME nrhss ∧ LENGTH nrhss = LENGTH rhss ∧ EVERY (λ(n :num). n ∈ (domain l :num -> bool)) nrhss ∧ (get_vars nrhss t :α word_loc list option) = SOME (MAP (wlab_wloc :α word_lab -> α word_loc) ws)
semantics_run_res_typed=RunError::α semantics_run_res; CompleteResult::α -> α semantics_run_res; Incomplete::α semantics_run_res
evaluate_io_mono_rephrases_typed=∀(exps :α crepLang$prog) (s :(α, β) crepSem$state) (extra :num). (SND (evaluate (exps,s) :α crepSem$result option # (α, β) crepSem$state)).ffi.io_events ≼ (SND (evaluate (exps,s with clock := s.clock + extra) :α crepSem$result option # (α, β) crepSem$state)).ffi.io_events
evaluate_add_clock_io_events_mono_loop_typed=∀(exps :α loopLang$prog) (s :(α, β) state) (extra :num). (SND (evaluate (exps,s) :α result option # (α, β) state)).ffi.io_events ≼ (SND (evaluate (exps,s with clock := s.clock + extra) :α result option # (α, β) state)).ffi.io_events
member_cutset_survives_comp_exp_flip_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp) (p :α loopLang$prog list) (le :α loopLang$exp) (ntmp :num) (nl :sptree$num_set) (n :num). n ∈ (domain l :num -> bool) ∧ compile_exp ct tmp l e = (p,le,ntmp,nl) ⇒ survives n (nested_seq p)
member_cutset_survives_comp_exps_flip_typed=∀(ct :context) (tmp :num) (l :sptree$num_set) (e :α crepLang$exp list) (p :α loopLang$prog list) (le :α loopLang$exp list) (ntmp :num) (nl :sptree$num_set) (n :num). n ∈ (domain l :num -> bool) ∧ compile_exps ct tmp l e = (p,le,ntmp,nl) ⇒ survives n (nested_seq p)
