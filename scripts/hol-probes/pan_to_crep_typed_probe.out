compile_to_crep_def_typed=∀(decls :α decl list). compile_to_crep decls = (let (prog :(mlstring # (mlstring # shape) list # α panLang$prog # shape) list) = functions decls; (comp :(mlstring # shape) list -> α panLang$prog -> α prog) = comp_func (make_funcs prog) (get_eids_from_decls decls) in MAP (λ((name :mlstring),(params :(mlstring # shape) list),(body :α panLang$prog),(return :shape)). (name,crep_vars params,comp params body)) prog)
