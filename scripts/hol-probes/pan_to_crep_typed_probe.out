cexp_heads_def_typed=cexp_heads ([] :α list list) = SOME ([] :α list) ∧ ∀(e :α list) (es :α list list). cexp_heads (e::es) = case (e,cexp_heads es) of (([] :α list),v1) => (NONE :α list option) | (x::xs,(NONE :α list option)) => (NONE :α list option) | (x::xs,SOME ys) => SOME (x::ys)
