context) (ad :α panLang$exp). compile ctxt (Store ad v :α panLang$prog) = case compile_exp ctxt ad of (([] :α exp list),sh') => (Skip :α prog) | (e::es',sh') => (let ((es :α exp list),(sh :shape)) = compile_exp ctxt v; (adv :num) = ctxt.vmax + (1 :num); (temps :num list) = GENLIST (λ(x :num). adv + SUC x) (size_of_shape sh) in if size_of_shape sh = LENGTH es then nested_decs (adv::temps) (e::es) (nested_seq (stores (Var adv :α exp) (MAP (Var :num -> α exp) temps) (0w :α word))) else (Skip :α prog))) ∧ (∀(src :α panLang$exp) (dest :α panLang$exp) (ctxt :α context). compile ctxt (Store32 dest src :α panLang$prog) = case (compile_exp ctxt dest,compile_exp ctxt src) of ((([] :α exp list),v7),v3) => (Skip :α prog) | ((ad::ads,v7),([] :α exp list),v15) => (Skip :α prog) | ((ad::ads,v7),e::es,v15) => (Store32 ad e :α prog)) ∧ (∀(src :α panLang$exp) (dest :α panLang$exp) (ctxt :α context). compile ctxt (StoreByte dest src :α panLang$prog) = case (compile_exp ctxt dest,compile_exp ctxt src) of ((([] :α exp list),v7),v3) => (Skip :α prog) | ((ad::ads,v7),([] :α exp list),v15) => (Skip :α prog) | ((ad::ads,v7),e::es,v15) => (StoreByte ad e :α prog)) ∧ (∀(rt :α panLang$exp) (ctxt :α context). compile ctxt (Return rt :α panLang$prog) = (let ((ces :α exp list),(sh :shape)) = compile_exp ctxt rt in if size_of_shape sh = (0 :num) then (Return ([] :α exp list) :α prog) else (Return ces :α prog))) ∧ (∀(excp :α panLang$exp) (eid :mlstring) (ctxt :α context). compile ctxt (Raise eid excp :α panLang$prog) = case FLOOKUP ctxt.eids eid of (NONE :α word option) => (Skip :α prog) | SOME n => (let ((ces :α exp list),(sh :shape)) = compile_exp ctxt excp; (temps :num list) = GENLIST (λ(x :num). ctxt.vmax + SUC x) (size_of_shape sh) in if size_of_shape sh = LENGTH ces then Seq (nested_decs temps ces (nested_seq (store_globals (0w :word5) (MAP (Var :num -> α exp) temps)))) (Raise n :α prog) else (Skip :α prog))) ∧ (∀(p' :α panLang$prog) (p :α panLang$prog) (ctxt :α context). compile ctxt (Seq p p') = Seq (compile ctxt p) (compile ctxt p')) ∧ (∀(p' :α panLang$prog) (p :α panLang$prog) (e :α panLang$exp) (ctxt :α context). compile ctxt (If e p p') = case compile_exp ctxt e of (([] :α exp list),v3) => (Skip :α prog) | (ce::ces,v3) => If ce (compile ctxt p) (compile ctxt p')) ∧ (∀(p :α panLang$prog) (e :α panLang$exp) (ctxt :α context). compile ctxt (While e p) = case compile_exp ctxt e of (([] :α exp list),v3) => (Skip :α prog) | (ce::ces,v3) => While ce (compile ctxt p)) ∧ (∀(ctxt :α context). compile ctxt (Break :α panLang$prog) = (Break (0 :num) :α prog)) ∧ (∀(ctxt :α context). compile ctxt (Continue :α panLang$prog) = (Continue (0 :num) :α prog)) ∧ (∀(rtyp :((varkind # mlstring) option # (mlstring # mlstring # α panLang$prog) option) option) (es :α panLang$exp list) (ctxt :α context) (ce :mlstring). compile ctxt (Call rtyp ce es :α panLang$prog) = (let (cexps :(α exp list # shape) list) = MAP (compile_exp ctxt :α panLang$exp -> α exp list # shape) es; (args' :α exp list) = FLAT (MAP (FST :α exp list # shape -> α exp list) cexps) in case rtyp of (NONE :((varkind # mlstring) option # (mlstring # mlstring # α panLang$prog) option) option) => (Call (NONE :(num list # (α word # α prog) option) option) ce args' :α prog) | SOME ((NONE :(varkind # mlstring) option),hdl) => (let (rts :num list) = case FLOOKUP ctxt.funcs ce of (NONE :((mlstring # shape) list # shape) option) => ([] :num list) | SOME (args,rshape) => GENLIST (λ(x :num). ctxt.vmax + SUC x) (size_of_shape rshape) in case hdl of (NONE :(mlstring # mlstring # α panLang$prog) option) => nested_decs rts (REPLICATE (LENGTH rts) (Const (0w :α word) :α exp)) (Call (SOME (rts,(NONE :(α word # α prog) option))) ce args' :α prog) | SOME (eid,evar,p) => case FLOOKUP ctxt.eids eid of (NONE :α word option) => nested_decs rts (REPLICATE (LENGTH rts) (Const (0w :α word) :α exp)) (Call (SOME (rts,(NONE :(α word # α prog) option))) ce args' :α prog) | SOME neid => (let (comp_hdl :α prog) = compile ctxt p; (hndlr :α pr