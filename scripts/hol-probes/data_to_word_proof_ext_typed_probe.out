state_rel_ext_def_typed=∀(c :data_to_word$config) (l1 :num) (l2 :num) (s :(α, β) dataSem$state) (u :(γ, α, β) wordSem$state). state_rel_ext c l1 l2 s u ⇔ ∃(t :(γ, α, β) wordSem$state) (l :(num # γ prog) sptree$num_map). (state_rel c l1 l2 s t (NONE :(v # γ word_loc) list option) ([] :(num # num) list) :bool) ∧ (domain t.code :num -> bool) = (domain l :num -> bool) ∧ t.termdep > (1 :num) ∧ (∃(tt :bool) (kk :num) (aa :num) (co :γ asm_config). u.compile_oracle = ((I :α -> α) ## MAP (λ(p :num # num # γ prog). full_compile_single tt kk aa co (p,(NONE :num sptree$num_map option)))) ∘ t.compile_oracle ∧ t.compile = (λ(conf :α) (progs :(num # num # γ prog) list). (u.compile conf (MAP (λ(p :num # num # γ prog). full_compile_single tt kk aa co (p,(NONE :num sptree$num_map option))) progs) :(word8 list # γ word list # α) option))) ∧ (∀(n :num) (v :num # γ prog). (lookup n t.code :(num # γ prog) option) = SOME v ⇒ ∃(t' :bool) (k' :num) (a' :num) (c' :γ asm_config) (col :num sptree$num_map option). (lookup n l :(num # γ prog) option) = SOME (SND (full_compile_single t' k' a' c' ((n,v),col)))) ∧ u = t with <|code := l; termdep := (0 :num); compile := u.compile; compile_oracle := u.compile_oracle|>
state_rel_ext_with_clock_typed=state_rel_ext (a :data_to_word$config) (b :num) (c :num) (s1 :(α, β) dataSem$state) (s2 :(γ, α, β) wordSem$state) ⇒ state_rel_ext a b c (s1 with clock := (k :num)) (s2 with clock := k)
