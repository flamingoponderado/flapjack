bf_full_drop=⊢ ∀ys xs. DROP m (list_LUPDATE ys m xs) = list_LUPDATE ys 0 (DROP m xs)
bf_full_not_nil=⊢ 8 ≤ dimindex (:α) ⇒ list_LUPDATE (MAP Word (write_bitmap names k f')) 0 xs ≠ [Word 0w]
bf_full_append=⊢ n1 + n2 + n3 ≤ LENGTH xs ⇒ ∃xs2 xs3. DROP n1 xs = xs2 ++ xs3 ∧ n2 = LENGTH xs2
bf_not_nil_types=xs
 : :α word_loc list
f'
 : :num
k
 : :num
names
 : :β sptree$num_map
