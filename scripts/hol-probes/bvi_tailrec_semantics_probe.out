input_condition_def_typed=∀(next :num) (prog :(num # α) list). input_condition next prog ⇔ EVERY (free_names next ∘ (FST :num # α -> num)) prog ∧ ALL_DISTINCT (MAP (FST :num # α -> num) prog) ∧ EVERY ($¬ ∘ (λ(n :num). n MOD bvl_to_bvi_namespaces = (2 :num)) ∘ (FST :num # α -> num)) (FILTER ($<= bvl_num_stubs ∘ (FST :num # α -> num)) prog) ∧ bvl_num_stubs ≤ next ∧ next MOD bvl_to_bvi_namespaces = (2 :num)
compile_prog_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (2 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_prog (b :bool) n prog :num # (num # num # bvi$exp) list) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) co) cc start :behaviour)
