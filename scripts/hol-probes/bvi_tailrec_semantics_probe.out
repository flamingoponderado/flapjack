input_condition_def_typed=∀(next :num) (prog :(num # α) list). input_condition next prog ⇔ EVERY (free_names next ∘ (FST :num # α -> num)) prog ∧ ALL_DISTINCT (MAP (FST :num # α -> num) prog) ∧ EVERY ($¬ ∘ (λ(n :num). n MOD bvl_to_bvi_namespaces = (2 :num)) ∘ (FST :num # α -> num)) (FILTER ($<= bvl_num_stubs ∘ (FST :num # α -> num)) prog) ∧ bvl_num_stubs ≤ next ∧ next MOD bvl_to_bvi_namespaces = (2 :num)
compile_prog_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (2 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_prog (b :bool) n prog :num # (num # num # bvi$exp) list) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) co) cc start :behaviour)
compile_each_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (2 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_each n prog) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc compile_each (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc compile_each cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co compile_each co) cc start :behaviour)
evaluate_compile_each_typed=input_condition (next :num) (prog :(num # num # bvi$exp) list) ∧ (∀(n :num) (next :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) n = ((next,cfg),prog) ⇒ input_condition next prog) ∧ (∀(n :num). MEM n (MAP (FST :num # num # bvi$exp -> num) (SND (compile_each next prog))) ∧ n MOD bvl_to_bvi_namespaces = (2 :num) ⇒ n < FST (FST (co (0 :num)))) ∧ (evaluate ([(Call (0 :num) (SOME (start :num)) ([] :bvi$exp list) (NONE :bvi$exp option) :bvi$exp)],([] :v list),(initial_state (ffi0 :β ffi_state) (fromAList prog) co (state_cc compile_each (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (k :num) :(num # α, β) state)) :(v list, exn_or_ret) result # (num # α, β) state) = ((r :(v list, exn_or_ret) result),(s :(num # α, β) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ ∃(s2 :(α, β) state). (evaluate ([(Call (0 :num) (SOME start) ([] :bvi$exp list) (NONE :bvi$exp option) :bvi$exp)],([] :v list),(initial_state ffi0 (fromAList (SND (compile_each next prog))) (state_co compile_each co) cc k :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = (r,s2) ∧ state_rel s s2
state_rel_def_typed=∀(s :(num # α, 'ffi) state) (t :(α, 'ffi) state). state_rel s t ⇔ t.refs = s.refs ∧ t.clock = s.clock ∧ t.global = s.global ∧ t.ffi = s.ffi ∧ t.compile_oracle = state_co compile_each s.compile_oracle ∧ s.compile = state_cc compile_each t.compile ∧ code_rel s.code t.code ∧ namespace_rel s.code t.code ∧ (∀(n :num). (let (((next :num),(cfg :α)),(prog :(num # num # bvi$exp) list)) = (s.compile_oracle n :(num # α) # (num # num # bvi$exp) list) in input_condition next prog)) ∧ ∀(n :num). n ∈ (domain t.code :num -> bool) ∧ n MOD bvl_to_bvi_namespaces = (2 :num) ⇒ n < FST (FST (s.compile_oracle (0 :num) :(num # α) # (num # num # bvi$exp) list))
state_rel_const_typed=state_rel (s :(num # α, β) state) (t :(α, β) state) ⇒ t.refs = s.refs ∧ t.clock = s.clock ∧ t.global = s.global ∧ t.ffi = s.ffi
state_rel_with_clock_typed=state_rel (s :(num # α, β) state) (t :(α, β) state) ⇒ state_rel (s with clock := (k :num)) (t with clock := k)
state_rel_code_rel_typed=state_rel (s :(num # α, β) state) (t :(α, β) state) ⇒ code_rel s.code t.code
