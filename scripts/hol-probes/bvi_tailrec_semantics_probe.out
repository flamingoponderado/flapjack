input_condition_def_typed=∀(next :num) (prog :(num # α) list). input_condition next prog ⇔ EVERY (free_names next ∘ (FST :num # α -> num)) prog ∧ ALL_DISTINCT (MAP (FST :num # α -> num) prog) ∧ EVERY ($¬ ∘ (λ(n :num). n MOD bvl_to_bvi_namespaces = (2 :num)) ∘ (FST :num # α -> num)) (FILTER ($<= bvl_num_stubs ∘ (FST :num # α -> num)) prog) ∧ bvl_num_stubs ≤ next ∧ next MOD bvl_to_bvi_namespaces = (2 :num)
compile_prog_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (2 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_prog (b :bool) n prog :num # (num # num # bvi$exp) list) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) co) cc start :behaviour)
compile_each_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (2 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_each n prog) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc compile_each (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc compile_each cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co compile_each co) cc start :behaviour)
evaluate_compile_each_typed=input_condition (next :num) (prog :(num # num # bvi$exp) list) ∧ (∀(n :num) (next :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) n = ((next,cfg),prog) ⇒ input_condition next prog) ∧ (∀(n :num). MEM n (MAP (FST :num # num # bvi$exp -> num) (SND (compile_each next prog))) ∧ n MOD bvl_to_bvi_namespaces = (2 :num) ⇒ n < FST (FST (co (0 :num)))) ∧ (evaluate ([(Call (0 :num) (SOME (start :num)) ([] :bvi$exp list) (NONE :bvi$exp option) :bvi$exp)],([] :v list),(initial_state (ffi0 :β ffi_state) (fromAList prog) co (state_cc compile_each (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (k :num) :(num # α, β) state)) :(v list, exn_or_ret) result # (num # α, β) state) = ((r :(v list, exn_or_ret) result),(s :(num # α, β) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ ∃(s2 :(α, β) state). (evaluate ([(Call (0 :num) (SOME start) ([] :bvi$exp list) (NONE :bvi$exp option) :bvi$exp)],([] :v list),(initial_state ffi0 (fromAList (SND (compile_each next prog))) (state_co compile_each co) cc k :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = (r,s2) ∧ state_rel s s2
state_rel_def_typed=∀(s :(num # α, 'ffi) state) (t :(α, 'ffi) state). state_rel s t ⇔ t.refs = s.refs ∧ t.clock = s.clock ∧ t.global = s.global ∧ t.ffi = s.ffi ∧ t.compile_oracle = state_co compile_each s.compile_oracle ∧ s.compile = state_cc compile_each t.compile ∧ code_rel s.code t.code ∧ namespace_rel s.code t.code ∧ (∀(n :num). (let (((next :num),(cfg :α)),(prog :(num # num # bvi$exp) list)) = (s.compile_oracle n :(num # α) # (num # num # bvi$exp) list) in input_condition next prog)) ∧ ∀(n :num). n ∈ (domain t.code :num -> bool) ∧ n MOD bvl_to_bvi_namespaces = (2 :num) ⇒ n < FST (FST (s.compile_oracle (0 :num) :(num # α) # (num # num # bvi$exp) list))
state_rel_const_typed=state_rel (s :(num # α, β) state) (t :(α, β) state) ⇒ t.refs = s.refs ∧ t.clock = s.clock ∧ t.global = s.global ∧ t.ffi = s.ffi
state_rel_with_clock_typed=state_rel (s :(num # α, β) state) (t :(α, β) state) ⇒ state_rel (s with clock := (k :num)) (t with clock := k)
state_rel_code_rel_typed=state_rel (s :(num # α, β) state) (t :(α, β) state) ⇒ code_rel s.code t.code
code_rel_def_typed=∀(c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map). code_rel c1 c2 ⇔ ∀(loc :num) (arity :num) (exp :bvi$exp) (op :assoc_op). lookup loc c1 = SOME (arity,exp) ⇒ (check_exp loc arity exp = (NONE :assoc_op option) ⇒ lookup loc c2 = SOME (arity,exp)) ∧ (check_exp loc arity exp = SOME op ⇒ ∃(n :num). ∀(exp_aux :bvi$exp) (exp_opt :bvi$exp). (compile_exp loc n arity exp :(bvi$exp # bvi$exp) option) = SOME (exp_aux,exp_opt) ⇒ lookup loc c2 = SOME (arity,exp_aux) ∧ lookup n c2 = SOME (arity + (1 :num),exp_opt))
code_rel_domain_typed=∀(c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map). code_rel c1 c2 ⇒ (domain c1 :num -> bool) ⊆ (domain c2 :num -> bool)
evaluate_let_wrap_typed=∀(x :bvi$exp) (op :assoc_op) (vs :v list) (s :(γ, 'ffi) state) (r :α) (t :β). op ≠ Noop ⇒ (evaluate ([let_wrap (LENGTH vs) (id_from_op op) x],vs,s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (evaluate ([x],vs ++ [op_id_val op] ++ vs,s) :(v list, exn_or_ret) result # (γ, 'ffi) state)
evaluate_complete_ind_typed=∀(P :bvi$exp list -> (num # γ, 'ffi) state -> bool). (∀(xs :bvi$exp list) (s :(num # γ, 'ffi) state). (∀(ys :bvi$exp list) (t :(num # γ, 'ffi) state). list_size exp_size ys < list_size exp_size xs ∧ t.clock ≤ s.clock ∨ t.clock < s.clock ⇒ P ys t) ⇒ P xs s) ⇒ ∀(xs :bvi$exp list) (s :(num # γ, 'ffi) state). P xs s
EVERY_LAST1_typed=∀(xs :α list) (y :α). EVERY (P :α -> bool) xs ∧ LAST1 xs = SOME y ⇒ P y
scan_expr_LENGTH_typed=∀(ts :v_ty list) (loc :num) (xs :bvi$exp list) (ys :(v_ty list # v_ty # bool # assoc_op option) list). scan_expr ts loc xs = ys ⇒ EVERY (λ(y :v_ty list # v_ty # bool # assoc_op option). LENGTH (FST y) = LENGTH ts) ys
LAST1_thm_typed=∀(xs :α list). LAST1 xs = (NONE :α option) ⇔ xs = ([] :α list)
try_update_LENGTH_typed=LENGTH (try_update (ty :v_ty) (idx :num option) (ts :v_ty list)) = LENGTH ts
update_context_LENGTH_typed=LENGTH (update_context (ty :v_ty) (ts :v_ty list) (x :bvi$exp) (y :bvi$exp)) = LENGTH ts
try_update_EL_typed=(n :num) < LENGTH (ts :v_ty list) ⇒ (try_update (ty :v_ty) (idx :num option) ts)❲n❳ = case idx of (NONE :num option) => ts❲n❳ | SOME m => if n < m then ts❲n❳ else if n > m then ts❲n❳ else if ts❲n❳ = Any ∨ ts❲n❳ = ty then ty else ts❲n❳
try_update_twice_typed=(n :num) < LENGTH (ts :v_ty list) ⇒ (try_update (ty :v_ty) (idx1 :num option) (try_update ty (idx2 :num option) ts))❲n❳ = case (idx1,idx2) of ((NONE :num option),(NONE :num option)) => ts❲n❳ | ((NONE :num option),SOME b) => if n ≠ b then ts❲n❳ else if ts❲n❳ = Any then ty else ts❲n❳ | (SOME a,(NONE :num option)) => if n ≠ a then ts❲n❳ else if ts❲n❳ = Any then ty else ts❲n❳ | (SOME a,SOME b') => if n ≠ a ∧ n ≠ b' then ts❲n❳ else if ts❲n❳ = Any then ty else ts❲n❳
index_of_simp_typed=index_of (exp :bvi$exp) = SOME (n :num) ⇔ exp = (Var n :bvi$exp)
scan_expr_ty_rel_typed=∀(ts :v_ty list) (loc :num) (xs :bvi$exp list) (env :v list) (ys :(v_ty list # v_ty # bool # assoc_op option) list) (s :(α, β) state) (vs :v list) (t :(α, β) state). ty_rel env ts ∧ scan_expr ts loc xs = ys ∧ (evaluate (xs,env,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval vs :(v list, exn_or_ret) result),t) ⇒ EVERY (ty_rel env ∘ (FST :v_ty list # v_ty # bool # assoc_op option -> v_ty list)) ys ∧ ty_rel vs (MAP ((FST :v_ty # bool # assoc_op option -> v_ty) ∘ (SND :v_ty list # v_ty # bool # assoc_op option -> v_ty # bool # assoc_op option)) ys)
check_op_thm_typed=check_op (ts :v_ty list) (opr :assoc_op) (loc :num) (exp :bvi$exp) = SOME (expr :bvi$exp) ⇒ ∃(x :bvi$exp) (y :bvi$exp). is_rec loc x ∧ term_ok ts (op_type opr) y ∧ expr = (Op (to_op opr) [y; x] :bvi$exp) ∧ (exp = (Op (to_op opr) [x; y] :bvi$exp) ∨ exp = (Op (to_op opr) [y; x] :bvi$exp))
optimized_code_def_typed=∀(loc :num) (arity :num) (exp :bvi$exp) (n :num) (c :(num # bvi$exp) sptree$num_map) (op :assoc_op). optimized_code loc arity exp n c op ⇔ ∃(exp_aux :bvi$exp) (exp_opt :bvi$exp). (compile_exp loc n arity exp :(bvi$exp # bvi$exp) option) = SOME (exp_aux,exp_opt) ∧ check_exp loc arity exp = SOME op ∧ lookup loc c = SOME (arity,exp_aux) ∧ lookup n c = SOME (arity + (1 :num),exp_opt)
code_rel_subspt_typed=code_rel (c1 :(num # bvi$exp) sptree$num_map) (x1 :(num # bvi$exp) sptree$num_map) ∧ subspt x1 (x2 :(num # bvi$exp) sptree$num_map) ⇒ code_rel c1 x2
compile_each_LENGTH_typed=∀(n :num) (prog :(num # num # bvi$exp) list). LENGTH (SND (compile_each n prog)) ≥ LENGTH prog
code_rel_find_code_SOME_replay_typed=∀(c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map) (args :v list) (a :v list) (exp :bvi$exp). code_rel c1 c2 ∧ (find_code (SOME (n :num)) args c1 :(v list # bvi$exp) option) = SOME (a,exp) ⇒ (find_code (SOME n) args c2 :(v list # bvi$exp) option) ≠ (NONE :(v list # bvi$exp) option)
code_rel_find_code_NONE_replay_typed=∀(c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map) (args :v list) (a :v list) (exp :bvi$exp). code_rel c1 c2 ∧ (find_code (NONE :num option) args c1 :(v list # bvi$exp) option) = SOME (a,exp) ⇒ (find_code (NONE :num option) args c2 :(v list # bvi$exp) option) ≠ (NONE :(v list # bvi$exp) option)
