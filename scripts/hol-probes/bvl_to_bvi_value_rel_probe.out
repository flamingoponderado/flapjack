adjust_bv_def=(∀(i :int) (b :num -> num). adjust_bv b (Number i :v) = (Number i :v)) ∧ (∀(w :word64) (b :num -> num). adjust_bv b (Word64 w :v) = (Word64 w :v)) ∧ (∀(r :num) (l :bool) (b :num -> num). adjust_bv b (RefPtr l r :v) = (RefPtr l (b r) :v)) ∧ (∀(c :num) (b :num -> num). adjust_bv b (CodePtr c) = CodePtr (bvl_num_stubs + bvl_to_bvi_namespaces * c)) ∧ ∀(vs :v list) (tag :num) (b :num -> num). adjust_bv b (Block tag vs) = Block tag (MAP (λ(a :v). adjust_bv b a) vs)
adjust_bv_Unit=adjust_bv (x :num -> num) Unit = Unit
adjust_bv_Boolv=adjust_bv (x :num -> num) (Boolv (b :bool) :v) = (Boolv b :v)
adjust_nested=adjust_bv (λ(n :num). n + (5 :num)) (Block (7 :num) [(Number (-(3 :int)) :v); (RefPtr T (2 :num) :v); CodePtr (3 :num); Block (8 :num) [(RefPtr F (9 :num) :v)]]) = Block (7 :num) [(Number (-(3 :int)) :v); (RefPtr T (7 :num) :v); CodePtr (84 :num); Block (8 :num) [(RefPtr F (14 :num) :v)]]
aux_code_installed=(∀(t :(α # β) sptree$num_map). aux_code_installed ([] :(num # α # β) list) t ⇔ T) ∧ ∀(t :(α # β) sptree$num_map) (rest :(num # α # β) list) (name :num) (body :β) (arg_count :α). aux_code_installed ((name,arg_count,body)::rest) t ⇔ lookup name t = SOME (arg_count,body) ∧ aux_code_installed rest t
aux_code_installed_APPEND_replay=∀(xs :(num # α # β) list) (ys :(num # α # β) list) (code :(α # β) sptree$num_map). aux_code_installed (xs ++ ys) code ⇒ aux_code_installed xs code ∧ aux_code_installed ys code
aux_code_installed_subspt=∀(x :(num # α # β) list) (c1 :(α # β) sptree$num_map) (c2 :(α # β) sptree$num_map). aux_code_installed x c1 ∧ subspt c1 c2 ⇒ aux_code_installed x c2
isVar_def=(isVar (Var (n :num) :bvl$exp) ⇔ T) ∧ (isVar (If (v1 :bvl$exp) (v2 :bvl$exp) (v3 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Let (v4 :bvl$exp list) (v5 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Raise (v6 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Handle (v7 :bvl$exp) (v8 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Tick (v9 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Call (v10 :num) (v11 :num option) (v12 :bvl$exp list) :bvl$exp) ⇔ F) ∧ (isVar (Force (v13 :num) (v14 :num) :bvl$exp) ⇔ F) ∧ (isVar (Op (v15 :closLang$op) (v16 :bvl$exp list) :bvl$exp) ⇔ F)
bVarBound_def=(∀(n :num). bVarBound n ([] :bvl$exp list) ⇔ T) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (n :num). bVarBound n (x::y::xs) ⇔ bVarBound n [x] ∧ bVarBound n (y::xs)) ∧ (∀(v :num) (n :num). bVarBound n [(Var v :bvl$exp)] ⇔ v < n) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (n :num). bVarBound n [(If x1 x2 x3 :bvl$exp)] ⇔ bVarBound n [x1] ∧ bVarBound n [x2] ∧ bVarBound n [x3]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (n :num). bVarBound n [(Let xs x2 :bvl$exp)] ⇔ bVarBound n xs ∧ bVarBound (n + LENGTH xs) [x2]) ∧ (∀(x1 :bvl$exp) (n :num). bVarBound n [(Raise x1 :bvl$exp)] ⇔ bVarBound n [x1]) ∧ (∀(x1 :bvl$exp) (n :num). bVarBound n [(Tick x1 :bvl$exp)] ⇔ bVarBound n [x1]) ∧ (∀(xs :bvl$exp list) (op :closLang$op) (n :num). bVarBound n [(Op op xs :bvl$exp)] ⇔ bVarBound n xs) ∧ (∀(v :num) (n :num) (loc :num). bVarBound n [(Force loc v :bvl$exp)] ⇔ v < n) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (n :num). bVarBound n [(Handle x1 x2 :bvl$exp)] ⇔ bVarBound n [x1] ∧ bVarBound (n + (1 :num)) [x2]) ∧ ∀(xs :bvl$exp list) (ticks :num) (n :num) (dest :num option). bVarBound n [(Call ticks dest xs :bvl$exp)] ⇔ bVarBound n xs
let_ok_def=(let_ok (Let (xs :bvl$exp list) (b :bvl$exp) :bvl$exp) ⇔ EVERY isVar xs ∧ bVarBound (LENGTH xs) [b]) ∧ (let_ok (Var (v :num) :bvl$exp) ⇔ F) ∧ (let_ok (If (v1 :bvl$exp) (v2 :bvl$exp) (v3 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Raise (v6 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Handle (v7 :bvl$exp) (v8 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Tick (v9 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Call (v10 :num) (v11 :num option) (v12 :bvl$exp list) :bvl$exp) ⇔ F) ∧ (let_ok (Force (v13 :num) (v14 :num) :bvl$exp) ⇔ F) ∧ (let_ok (Op (v15 :closLang$op) (v16 :bvl$exp list) :bvl$exp) ⇔ F)
handle_ok_def=(handle_ok ([] :bvl$exp list) ⇔ T) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp). handle_ok (x::y::xs) ⇔ handle_ok [x] ∧ handle_ok (y::xs)) ∧ (∀(v :num). handle_ok [(Var v :bvl$exp)] ⇔ T) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp). handle_ok [(If x1 x2 x3 :bvl$exp)] ⇔ handle_ok [x1] ∧ handle_ok [x2] ∧ handle_ok [x3]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp). handle_ok [(Let xs x2 :bvl$exp)] ⇔ if LENGTH xs = (0 :num) then let_ok x2 ∧ ∀(ys :bvl$exp list) (y :bvl$exp). x2 = (Let ys y :bvl$exp) ⇒ handle_ok [y] else handle_ok xs ∧ handle_ok [x2]) ∧ (∀(x1 :bvl$exp). handle_ok [(Raise x1 :bvl$exp)] ⇔ handle_ok [x1]) ∧ (∀(x1 :bvl$exp). handle_ok [(Tick x1 :bvl$exp)] ⇔ handle_ok [x1]) ∧ (∀(xs :bvl$exp list) (op :closLang$op). handle_ok [(Op op xs :bvl$exp)] ⇔ handle_ok xs) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp). handle_ok [(Handle x1 x2 :bvl$exp)] ⇔ case x1 of (Var v17 :bvl$exp) => F | (If v18 v19 v20 :bvl$exp) => F | (Let xs b :bvl$exp) => EVERY isVar xs ∧ bVarBound (LENGTH xs) [b] ∧ handle_ok [b] ∧ handle_ok [x2] | (Raise v23 :bvl$exp) => F | (Handle v24 v25 :bvl$exp) => F | (Tick v26 :bvl$exp) => F | (Call v27 v28 v29 :bvl$exp) => F | (Force v30 v31 :bvl$exp) => F | (Op v32 v33 :bvl$exp) => F) ∧ (∀(n :num) (loc :num). handle_ok [(Force loc n :bvl$exp)] ⇔ T) ∧ ∀(xs :bvl$exp list) (ticks :num) (dest :num option). handle_ok [(Call ticks dest xs :bvl$exp)] ⇔ handle_ok xs
handle_ok_CONS=∀(x :bvl$exp) (xs :bvl$exp list). handle_ok (x::xs) ⇔ handle_ok [x] ∧ handle_ok xs
handle_ok_EVERY=∀(xs :bvl$exp list). handle_ok xs ⇔ EVERY (λ(x :bvl$exp). handle_ok [x]) xs
handle_good=handle_ok [(Let ([] :bvl$exp list) (Let [(Var (0 :num) :bvl$exp)] (Var (0 :num) :bvl$exp) :bvl$exp) :bvl$exp)]
handle_bad=handle_ok [(Let ([] :bvl$exp list) (Let [(Var (0 :num) :bvl$exp)] (Var (1 :num) :bvl$exp) :bvl$exp) :bvl$exp)] ⇔ F
names_ok_def=∀(s_code :α sptree$num_map) (t_code :β sptree$num_map) (s_oracle :num -> (num # γ) # (δ # ε # bvl$exp) list). names_ok s_code t_code s_oracle ⇔ (∀(n :num) (k :num # γ) (prog :(δ # ε # bvl$exp) list). s_oracle n = (k,prog) ⇒ EVERY (λ((name :δ),(arity :ε),(exp :bvl$exp)). handle_ok [exp]) prog) ∧ (let (next :num) = FST (FST (s_oracle (0 :num))) in ∀(n :num). n ∈ (domain t_code :num -> bool) ∧ bvl_num_stubs ≤ n ⇒ if n MOD bvl_to_bvi_namespaces = (1 :num) then n < bvl_num_stubs + bvl_to_bvi_namespaces * next else n MOD bvl_to_bvi_namespaces = (0 :num) ∧ (n − bvl_num_stubs) DIV bvl_to_bvi_namespaces ∈ (domain s_code :num -> bool))
state_rel_def=∀(b :num -> num) (s :(num # γ, 'ffi) bvlSem$state) (t :(γ, 'ffi) state). (state_rel b s t :bool) ⇔ INJ b (FDOM s.refs) (FDOM t.refs) ∧ (∀(k :num). case FLOOKUP s.refs k of (NONE :v ref option) => T | SOME (ValueArray vs :v ref) => FLOOKUP t.refs (b k) = SOME (ValueArray (MAP (adjust_bv b) vs) :v ref) | SOME (ByteArray v13 v14 :v ref) => FLOOKUP t.refs (b k) = SOME (ByteArray v13 v14 :v ref) | SOME (Thunk m v :v ref) => FLOOKUP t.refs (b k) = SOME (Thunk m (adjust_bv b v) :v ref) | SOME (MutBlock v17 v18 v19 v20 v21) => FLOOKUP t.refs (b k) = SOME (MutBlock v17 v18 v19 v20 v21)) ∧ s.ffi = t.ffi ∧ (∀(p :num). t.global = SOME p ⇒ p ∉ IMAGE b (FDOM s.refs) ∧ ∃(z :num). FLOOKUP t.refs p = SOME (ValueArray ((Number ((&SUC (LENGTH s.globals)) :int) :v)::(MAP (the (Number (0 :int) :v) ∘ OPTION_MAP (adjust_bv b)) s.globals ++ REPLICATE (z − SUC (LENGTH s.globals)) (Number (0 :int) :v))) :v ref) ∧ SUC (LENGTH s.globals) ≤ z) ∧ s.clock = t.clock ∧ t.compile_oracle = state_co compile_inc s.compile_oracle ∧ s.compile = state_cc compile_inc t.compile ∧ lookup AllocGlobal_location t.code = SOME AllocGlobal_code ∧ lookup CopyGlobals_location t.code = SOME CopyGlobals_code ∧ lookup ListLength_location t.code = SOME ListLength_code ∧ lookup FromListByte_location t.code = SOME FromListByte_code ∧ lookup ToListByte_location t.code = SOME ToListByte_code ∧ lookup SumListLength_location t.code = SOME SumListLength_code ∧ lookup ConcatByte_location t.code = SOME ConcatByte_code ∧ names_ok s.code t.code s.compile_oracle ∧ ∀(name :num) (arity :num) (exp :bvl$exp). lookup name s.code = SOME (arity,exp) ⇒ ∃(n :num). (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = (compile_exps n [exp] :bvi$exp list # (num # num # bvi$exp) app_list # num) in lookup (bvl_num_stubs + bvl_to_bvi_namespaces * name) t.code = SOME (arity,(compile_exp (HD c1) :bvi$exp)) ∧ aux_code_installed (append aux1) t.code ∧ handle_ok [exp])
state_rel_FLOOKUP_byteArray=∀(b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) (m :bool) (l :word8 list) (n :num). (state_rel b s t :bool) ∧ FLOOKUP s.refs n = SOME (ByteArray m l :v ref) ⇒ FLOOKUP t.refs (b n) = SOME (ByteArray m l :v ref)
state_rel_FLOOKUP_valueArray=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (ValueArray (vs :v list) :v ref) ⇒ FLOOKUP t.refs (b ptr) = SOME (ValueArray (MAP (adjust_bv b) vs) :v ref)
state_rel_FLOOKUP_MutBlock=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (MutBlock (tg :num) (fin :bool) (l :v list) (c :v) (r :v list)) ⇒ FLOOKUP t.refs (b ptr) = SOME (MutBlock tg fin l c r)
state_rel_FLOOKUP_Thunk=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (Thunk (m :thunk_mode) (v :v) :v ref) ⇒ FLOOKUP t.refs (b ptr) = SOME (Thunk m (adjust_bv b v) :v ref)
bv_ok_def=(∀(refs :num |-> v ref) (r :num) (l :bool). bv_ok refs (RefPtr l r :v) ⇔ r ∈ FDOM refs) ∧ (∀(vs :v list) (tag :num) (refs :num |-> v ref). bv_ok refs (Block tag vs) ⇔ EVERY (λ(a :v). bv_ok refs a) vs) ∧ (∀(v2 :int) (refs :num |-> v ref). bv_ok refs (Number v2 :v) ⇔ T) ∧ (∀(v3 :word64) (refs :num |-> v ref). bv_ok refs (Word64 v3 :v) ⇔ T) ∧ ∀(v6 :num) (refs :num |-> v ref). bv_ok refs (CodePtr v6) ⇔ T
bv_ok_Unit=bv_ok (refs :num |-> v ref) Unit
