adjust_bv_def=(∀(i :int) (b :num -> num). adjust_bv b (Number i :v) = (Number i :v)) ∧ (∀(w :word64) (b :num -> num). adjust_bv b (Word64 w :v) = (Word64 w :v)) ∧ (∀(r :num) (l :bool) (b :num -> num). adjust_bv b (RefPtr l r :v) = (RefPtr l (b r) :v)) ∧ (∀(c :num) (b :num -> num). adjust_bv b (CodePtr c) = CodePtr (bvl_num_stubs + bvl_to_bvi_namespaces * c)) ∧ ∀(vs :v list) (tag :num) (b :num -> num). adjust_bv b (Block tag vs) = Block tag (MAP (λ(a :v). adjust_bv b a) vs)
adjust_bv_Unit=adjust_bv (x :num -> num) Unit = Unit
adjust_bv_Boolv=adjust_bv (x :num -> num) (Boolv (b :bool) :v) = (Boolv b :v)
adjust_nested=adjust_bv (λ(n :num). n + (5 :num)) (Block (7 :num) [(Number (-(3 :int)) :v); (RefPtr T (2 :num) :v); CodePtr (3 :num); Block (8 :num) [(RefPtr F (9 :num) :v)]]) = Block (7 :num) [(Number (-(3 :int)) :v); (RefPtr T (7 :num) :v); CodePtr (84 :num); Block (8 :num) [(RefPtr F (14 :num) :v)]]
aux_code_installed=(∀(t :(α # β) sptree$num_map). aux_code_installed ([] :(num # α # β) list) t ⇔ T) ∧ ∀(t :(α # β) sptree$num_map) (rest :(num # α # β) list) (name :num) (body :β) (arg_count :α). aux_code_installed ((name,arg_count,body)::rest) t ⇔ lookup name t = SOME (arg_count,body) ∧ aux_code_installed rest t
aux_code_installed_APPEND_replay=∀(xs :(num # α # β) list) (ys :(num # α # β) list) (code :(α # β) sptree$num_map). aux_code_installed (xs ++ ys) code ⇒ aux_code_installed xs code ∧ aux_code_installed ys code
aux_code_installed_subspt=∀(x :(num # α # β) list) (c1 :(α # β) sptree$num_map) (c2 :(α # β) sptree$num_map). aux_code_installed x c1 ∧ subspt c1 c2 ⇒ aux_code_installed x c2
isVar_def=(isVar (Var (n :num) :bvl$exp) ⇔ T) ∧ (isVar (If (v1 :bvl$exp) (v2 :bvl$exp) (v3 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Let (v4 :bvl$exp list) (v5 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Raise (v6 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Handle (v7 :bvl$exp) (v8 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Tick (v9 :bvl$exp) :bvl$exp) ⇔ F) ∧ (isVar (Call (v10 :num) (v11 :num option) (v12 :bvl$exp list) :bvl$exp) ⇔ F) ∧ (isVar (Force (v13 :num) (v14 :num) :bvl$exp) ⇔ F) ∧ (isVar (Op (v15 :closLang$op) (v16 :bvl$exp list) :bvl$exp) ⇔ F)
bVarBound_def=(∀(n :num). bVarBound n ([] :bvl$exp list) ⇔ T) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (n :num). bVarBound n (x::y::xs) ⇔ bVarBound n [x] ∧ bVarBound n (y::xs)) ∧ (∀(v :num) (n :num). bVarBound n [(Var v :bvl$exp)] ⇔ v < n) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (n :num). bVarBound n [(If x1 x2 x3 :bvl$exp)] ⇔ bVarBound n [x1] ∧ bVarBound n [x2] ∧ bVarBound n [x3]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (n :num). bVarBound n [(Let xs x2 :bvl$exp)] ⇔ bVarBound n xs ∧ bVarBound (n + LENGTH xs) [x2]) ∧ (∀(x1 :bvl$exp) (n :num). bVarBound n [(Raise x1 :bvl$exp)] ⇔ bVarBound n [x1]) ∧ (∀(x1 :bvl$exp) (n :num). bVarBound n [(Tick x1 :bvl$exp)] ⇔ bVarBound n [x1]) ∧ (∀(xs :bvl$exp list) (op :closLang$op) (n :num). bVarBound n [(Op op xs :bvl$exp)] ⇔ bVarBound n xs) ∧ (∀(v :num) (n :num) (loc :num). bVarBound n [(Force loc v :bvl$exp)] ⇔ v < n) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (n :num). bVarBound n [(Handle x1 x2 :bvl$exp)] ⇔ bVarBound n [x1] ∧ bVarBound (n + (1 :num)) [x2]) ∧ ∀(xs :bvl$exp list) (ticks :num) (n :num) (dest :num option). bVarBound n [(Call ticks dest xs :bvl$exp)] ⇔ bVarBound n xs
bEval_bVarBound_replay=∀(xs :bvl$exp list) (vs :v list) (s :(α, β) bvlSem$state) (env :v list). bVarBound (LENGTH vs) xs ⇒ (evaluate (xs,vs ++ env,s) :(v list, v) result # (α, β) bvlSem$state) = (evaluate (xs,vs,s) :(v list, v) result # (α, β) bvlSem$state)
EVERY_isVar_evaluate_Rval_MEM=∀(l :bvl$exp list) (env :v list) (a :v list) (s :(α, β) bvlSem$state) (r :(α, β) bvlSem$state). EVERY isVar l ∧ (evaluate (l,env,s) :(v list, v) result # (α, β) bvlSem$state) = ((Rval a :(v list, v) result),r) ⇒ EVERY (λ(x :v). MEM x env) a ∧ s = r
evaluate_Var_list=∀(l :bvl$exp list). EVERY isVar l ⇒ (evaluate (l,(env :v list),(s :(α, β) bvlSem$state)) :(v list, v) result # (α, β) bvlSem$state) = ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) ∨ ∃(vs :v list). (evaluate (l,env,s) :(v list, v) result # (α, β) bvlSem$state) = ((Rval vs :(v list, v) result),s) ∧ get_vars (MAP destVar l) env = SOME vs ∧ LENGTH vs = LENGTH l
let_ok_def=(let_ok (Let (xs :bvl$exp list) (b :bvl$exp) :bvl$exp) ⇔ EVERY isVar xs ∧ bVarBound (LENGTH xs) [b]) ∧ (let_ok (Var (v :num) :bvl$exp) ⇔ F) ∧ (let_ok (If (v1 :bvl$exp) (v2 :bvl$exp) (v3 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Raise (v6 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Handle (v7 :bvl$exp) (v8 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Tick (v9 :bvl$exp) :bvl$exp) ⇔ F) ∧ (let_ok (Call (v10 :num) (v11 :num option) (v12 :bvl$exp list) :bvl$exp) ⇔ F) ∧ (let_ok (Force (v13 :num) (v14 :num) :bvl$exp) ⇔ F) ∧ (let_ok (Op (v15 :closLang$op) (v16 :bvl$exp list) :bvl$exp) ⇔ F)
handle_ok_def=(handle_ok ([] :bvl$exp list) ⇔ T) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp). handle_ok (x::y::xs) ⇔ handle_ok [x] ∧ handle_ok (y::xs)) ∧ (∀(v :num). handle_ok [(Var v :bvl$exp)] ⇔ T) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp). handle_ok [(If x1 x2 x3 :bvl$exp)] ⇔ handle_ok [x1] ∧ handle_ok [x2] ∧ handle_ok [x3]) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp). handle_ok [(Let xs x2 :bvl$exp)] ⇔ if LENGTH xs = (0 :num) then let_ok x2 ∧ ∀(ys :bvl$exp list) (y :bvl$exp). x2 = (Let ys y :bvl$exp) ⇒ handle_ok [y] else handle_ok xs ∧ handle_ok [x2]) ∧ (∀(x1 :bvl$exp). handle_ok [(Raise x1 :bvl$exp)] ⇔ handle_ok [x1]) ∧ (∀(x1 :bvl$exp). handle_ok [(Tick x1 :bvl$exp)] ⇔ handle_ok [x1]) ∧ (∀(xs :bvl$exp list) (op :closLang$op). handle_ok [(Op op xs :bvl$exp)] ⇔ handle_ok xs) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp). handle_ok [(Handle x1 x2 :bvl$exp)] ⇔ case x1 of (Var v17 :bvl$exp) => F | (If v18 v19 v20 :bvl$exp) => F | (Let xs b :bvl$exp) => EVERY isVar xs ∧ bVarBound (LENGTH xs) [b] ∧ handle_ok [b] ∧ handle_ok [x2] | (Raise v23 :bvl$exp) => F | (Handle v24 v25 :bvl$exp) => F | (Tick v26 :bvl$exp) => F | (Call v27 v28 v29 :bvl$exp) => F | (Force v30 v31 :bvl$exp) => F | (Op v32 v33 :bvl$exp) => F) ∧ (∀(n :num) (loc :num). handle_ok [(Force loc n :bvl$exp)] ⇔ T) ∧ ∀(xs :bvl$exp list) (ticks :num) (dest :num option). handle_ok [(Call ticks dest xs :bvl$exp)] ⇔ handle_ok xs
handle_ok_CONS=∀(x :bvl$exp) (xs :bvl$exp list). handle_ok (x::xs) ⇔ handle_ok [x] ∧ handle_ok xs
handle_ok_EVERY=∀(xs :bvl$exp list). handle_ok xs ⇔ EVERY (λ(x :bvl$exp). handle_ok [x]) xs
handle_good=handle_ok [(Let ([] :bvl$exp list) (Let [(Var (0 :num) :bvl$exp)] (Var (0 :num) :bvl$exp) :bvl$exp) :bvl$exp)]
handle_bad=handle_ok [(Let ([] :bvl$exp list) (Let [(Var (0 :num) :bvl$exp)] (Var (1 :num) :bvl$exp) :bvl$exp) :bvl$exp)] ⇔ F
names_ok_def=∀(s_code :α sptree$num_map) (t_code :β sptree$num_map) (s_oracle :num -> (num # γ) # (δ # ε # bvl$exp) list). names_ok s_code t_code s_oracle ⇔ (∀(n :num) (k :num # γ) (prog :(δ # ε # bvl$exp) list). s_oracle n = (k,prog) ⇒ EVERY (λ((name :δ),(arity :ε),(exp :bvl$exp)). handle_ok [exp]) prog) ∧ (let (next :num) = FST (FST (s_oracle (0 :num))) in ∀(n :num). n ∈ (domain t_code :num -> bool) ∧ bvl_num_stubs ≤ n ⇒ if n MOD bvl_to_bvi_namespaces = (1 :num) then n < bvl_num_stubs + bvl_to_bvi_namespaces * next else n MOD bvl_to_bvi_namespaces = (0 :num) ∧ (n − bvl_num_stubs) DIV bvl_to_bvi_namespaces ∈ (domain s_code :num -> bool))
state_rel_def=∀(b :num -> num) (s :(num # γ, 'ffi) bvlSem$state) (t :(γ, 'ffi) state). (state_rel b s t :bool) ⇔ INJ b (FDOM s.refs) (FDOM t.refs) ∧ (∀(k :num). case FLOOKUP s.refs k of (NONE :v ref option) => T | SOME (ValueArray vs :v ref) => FLOOKUP t.refs (b k) = SOME (ValueArray (MAP (adjust_bv b) vs) :v ref) | SOME (ByteArray v13 v14 :v ref) => FLOOKUP t.refs (b k) = SOME (ByteArray v13 v14 :v ref) | SOME (Thunk m v :v ref) => FLOOKUP t.refs (b k) = SOME (Thunk m (adjust_bv b v) :v ref) | SOME (MutBlock v17 v18 v19 v20 v21) => FLOOKUP t.refs (b k) = SOME (MutBlock v17 v18 v19 v20 v21)) ∧ s.ffi = t.ffi ∧ (∀(p :num). t.global = SOME p ⇒ p ∉ IMAGE b (FDOM s.refs) ∧ ∃(z :num). FLOOKUP t.refs p = SOME (ValueArray ((Number ((&SUC (LENGTH s.globals)) :int) :v)::(MAP (the (Number (0 :int) :v) ∘ OPTION_MAP (adjust_bv b)) s.globals ++ REPLICATE (z − SUC (LENGTH s.globals)) (Number (0 :int) :v))) :v ref) ∧ SUC (LENGTH s.globals) ≤ z) ∧ s.clock = t.clock ∧ t.compile_oracle = state_co compile_inc s.compile_oracle ∧ s.compile = state_cc compile_inc t.compile ∧ lookup AllocGlobal_location t.code = SOME AllocGlobal_code ∧ lookup CopyGlobals_location t.code = SOME CopyGlobals_code ∧ lookup ListLength_location t.code = SOME ListLength_code ∧ lookup FromListByte_location t.code = SOME FromListByte_code ∧ lookup ToListByte_location t.code = SOME ToListByte_code ∧ lookup SumListLength_location t.code = SOME SumListLength_code ∧ lookup ConcatByte_location t.code = SOME ConcatByte_code ∧ names_ok s.code t.code s.compile_oracle ∧ ∀(name :num) (arity :num) (exp :bvl$exp). lookup name s.code = SOME (arity,exp) ⇒ ∃(n :num). (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = (compile_exps n [exp] :bvi$exp list # (num # num # bvi$exp) app_list # num) in lookup (bvl_num_stubs + bvl_to_bvi_namespaces * name) t.code = SOME (arity,(compile_exp (HD c1) :bvi$exp)) ∧ aux_code_installed (append aux1) t.code ∧ handle_ok [exp])
state_rel_FLOOKUP_byteArray=∀(b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) (m :bool) (l :word8 list) (n :num). (state_rel b s t :bool) ∧ FLOOKUP s.refs n = SOME (ByteArray m l :v ref) ⇒ FLOOKUP t.refs (b n) = SOME (ByteArray m l :v ref)
state_rel_FLOOKUP_valueArray=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (ValueArray (vs :v list) :v ref) ⇒ FLOOKUP t.refs (b ptr) = SOME (ValueArray (MAP (adjust_bv b) vs) :v ref)
state_rel_FLOOKUP_MutBlock=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (MutBlock (tg :num) (fin :bool) (l :v list) (c :v) (r :v list)) ⇒ FLOOKUP t.refs (b ptr) = SOME (MutBlock tg fin l c r)
state_rel_FLOOKUP_Thunk=(state_rel (b :num -> num) (s :(num # α, β) bvlSem$state) (t :(α, β) state) :bool) ∧ FLOOKUP s.refs (ptr :num) = SOME (Thunk (m :thunk_mode) (v :v) :v ref) ⇒ FLOOKUP t.refs (b ptr) = SOME (Thunk m (adjust_bv b v) :v ref)
bv_ok_def=(∀(refs :num |-> v ref) (r :num) (l :bool). bv_ok refs (RefPtr l r :v) ⇔ r ∈ FDOM refs) ∧ (∀(vs :v list) (tag :num) (refs :num |-> v ref). bv_ok refs (Block tag vs) ⇔ EVERY (λ(a :v). bv_ok refs a) vs) ∧ (∀(v2 :int) (refs :num |-> v ref). bv_ok refs (Number v2 :v) ⇔ T) ∧ (∀(v3 :word64) (refs :num |-> v ref). bv_ok refs (Word64 v3 :v) ⇔ T) ∧ ∀(v6 :num) (refs :num |-> v ref). bv_ok refs (CodePtr v6) ⇔ T
bv_ok_Unit=bv_ok (refs :num |-> v ref) Unit
bv_ok_Boolv=bv_ok (refs :num |-> v ref) (Boolv (b :bool) :v)
state_ok_def=∀(s :(γ, 'ffi) bvlSem$state). state_ok s ⇔ EVERY (λ(x :v option). case x of (NONE :v option) => T | SOME v => bv_ok s.refs v) s.globals ∧ ∀(k :num). case FLOOKUP s.refs k of (NONE :v ref option) => T | SOME (ValueArray vs :v ref) => EVERY (bv_ok s.refs) vs | SOME (ByteArray v14 v15 :v ref) => T | SOME (Thunk v16 v :v ref) => bv_ok s.refs v | SOME (MutBlock v18 v19 v20 v21 v22) => T
evaluate_ok_lemma_replay=(state_ok (dec_clock (n :num) (s :(α, β) bvlSem$state)) ⇔ state_ok s) ∧ (dec_clock n s).refs = s.refs
v_to_list_ok_replay=∀(v :v) (x :v list). v_to_list v = SOME x ∧ bv_ok (refs :num |-> v ref) v ⇒ EVERY (bv_ok refs) x
do_app_ok_lemma_derived=state_ok (r :(α, β) bvlSem$state) ∧ EVERY (bv_ok r.refs) (a :v list) ∧ (do_app (op :closLang$op) a r :(v # (α, β) bvlSem$state, v) result) = (Rval ((q :v),(t :(α, β) bvlSem$state)) :(v # (α, β) bvlSem$state, v) result) ⇒ state_ok t ∧ bv_ok t.refs q
dec_clock_inc_clock_replay=(c :num) ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock c (t :(γ, 'ffi) state)) = inc_clock (c − (1 :num)) t
evaluate_ListLength_code_typed=∀(lv :v) (vs :v list) (n :num). lookup ListLength_location (s :(α, β) state).code = SOME ((2 :num),SND ListLength_code) ∧ v_to_list lv = SOME vs ⇒ ∃(p1 :γ) (c :num). (evaluate ([SND ListLength_code],[lv; (Number ((&n) :int) :v)],inc_clock c s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [(Number ((&(n + LENGTH vs)) :int) :v)] :(v list, exn_or_ret) result),s)
evaluate_FromListByte_code_typed=∀(lv :v) (vs :num list) (n :num) (bs :word8 list) (s :(γ, 'ffi) state). v_to_list lv = SOME (MAP (Number ∘ $&) vs) ∧ LENGTH vs ≤ LENGTH bs ∧ lookup FromListByte_location s.code = SOME ((3 :num),SND FromListByte_code) ∧ EVERY (λ(n :num). n < (256 :num)) vs ∧ FLOOKUP s.refs (p :num) = SOME (ByteArray (fl :bool) bs :v ref) ∧ n = LENGTH bs − LENGTH vs ⇒ ∃(c :num). (evaluate ([SND FromListByte_code],[lv; (Number ((&n) :int) :v); (RefPtr (b :bool) p :v)],inc_clock c s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval [(RefPtr b p :v)] :(v list, exn_or_ret) result),s with refs := s.refs⟨p ↦ (ByteArray fl (TAKE n bs ++ MAP (n2w :num -> word8) vs) :v ref)⟩)
evaluate_ToListByte_code_typed=∀(bs :word8 list) (rest :word8 list) (p :num) (s :(γ, 'ffi) state). lookup ToListByte_location s.code = SOME ((3 :num),SND ToListByte_code) ∧ FLOOKUP s.refs p = SOME (ByteArray (fl :bool) (bs ++ rest) :v ref) ⇒ ∃(c :num). (evaluate ([SND ToListByte_code],[list_to_v (MAP (λ(b :word8). (Number ((&w2n b) :int) :v)) rest); (Number ((&LENGTH bs) :int) :v); (RefPtr (b :bool) p :v)],inc_clock c s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval [list_to_v (MAP (λ(b :word8). (Number ((&w2n b) :int) :v)) bs ++ MAP (λ(b :word8). (Number ((&w2n b) :int) :v)) rest)] :(v list, exn_or_ret) result),s with refs := s.refs⟨p ↦ (ByteArray fl (bs ++ rest) :v ref)⟩)
evaluate_SumListLength_code_typed=∀(lv :v) (ps :num list) (wss :word8 list list) (n :num). lookup SumListLength_location (s :(α, β) state).code = SOME ((2 :num),SND SumListLength_code) ∧ v_to_list lv = SOME (MAP (RefPtr T :num -> v) ps) ∧ MAP (FLOOKUP s.refs) ps = MAP ((SOME :v ref -> v ref option) ∘ (ByteArray T :word8 list -> v ref)) wss ⇒ ∃(c :num). (evaluate ([SND SumListLength_code],[lv; (Number ((&n) :int) :v)],inc_clock c s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [(Number ((&(n + LENGTH (FLAT wss))) :int) :v)] :(v list, exn_or_ret) result),s)
evaluate_ConcatByte_code_typed=∀(lv :v) (ps :num list) (wss :word8 list list) (s :(γ, 'ffi) state) (ds1 :word8 list) (ds2 :word8 list) (n :num). lookup SumListLength_location s.code = SOME ((2 :num),SND SumListLength_code) ∧ lookup ConcatByte_location s.code = SOME ((3 :num),SND ConcatByte_code) ∧ v_to_list lv = SOME (MAP (RefPtr T :num -> v) ps) ∧ ¬MEM (dst :num) ps ∧ MAP (FLOOKUP s.refs) ps = MAP ((SOME :v ref -> v ref option) ∘ (ByteArray T :word8 list -> v ref)) wss ∧ FLOOKUP s.refs dst = SOME (ByteArray T (ds1 ++ ds2) :v ref) ∧ n = LENGTH ds1 ∧ LENGTH (FLAT wss) = LENGTH ds2 ⇒ ∃(c :num). (evaluate ([SND ConcatByte_code],[lv; (Number ((&n) :int) :v); (RefPtr (b :bool) dst :v)],inc_clock c s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval [(RefPtr b dst :v)] :(v list, exn_or_ret) result),s with refs := s.refs⟨dst ↦ (ByteArray T (ds1 ++ FLAT wss) :v ref)⟩)
bvi_inc_clock_def=∀(n :num) (s :(γ, 'ffi) state). inc_clock n s = s with clock := s.clock + n
bvi_inc_clock_ZERO=∀(s :(α, β) state). inc_clock (0 :num) s = s
bvi_dec_clock_inv_clock1=(t1 :(α, β) state).clock ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock (c :num) t1) = inc_clock c (dec_clock (1 :num) t1)
bv_ok_SUBSET_IMP_replay=∀(refs :num |-> v ref) (x :v) (refs2 :num |-> v ref). bv_ok refs x ∧ FDOM refs ⊆ FDOM refs2 ⇒ bv_ok refs2 x
list_to_v_ok=∀(xs :v list). EVERY (bv_ok (refs :num |-> v ref)) xs ⇒ bv_ok refs (list_to_v xs)
list_to_v_ok_APPEND=∀(xs :v list) (ys :v list). bv_ok (refs :num |-> v ref) (list_to_v xs) ∧ bv_ok refs (list_to_v ys) ⇒ bv_ok refs (list_to_v (xs ++ ys))
do_app_refs_SUBSET=(do_app (op :closLang$op) (a :v list) (r :(α, β) bvlSem$state) :(v # (α, β) bvlSem$state, v) result) = (Rval ((q :v),(t :(α, β) bvlSem$state)) :(v # (α, β) bvlSem$state, v) result) ⇒ FDOM r.refs ⊆ FDOM t.refs
evaluate_refs_SUBSET=(evaluate ((xs :bvl$exp list),(env :v list),(s :(α, β) bvlSem$state)) :(v list, v) result # (α, β) bvlSem$state) = ((res :(v list, v) result),(t :(α, β) bvlSem$state)) ⇒ FDOM s.refs ⊆ FDOM t.refs
evaluate_IMP_bv_ok_replay=∀(xs :bvl$exp list) (env :v list) (s :(α, β) bvlSem$state) (res :(v list, v) result) (t :(α, β) bvlSem$state) (a1 :v) (vs :v list). (evaluate (xs,env,s) :(v list, v) result # (α, β) bvlSem$state) = (res,t) ⇒ (bv_ok s.refs a1 ⇒ bv_ok t.refs a1) ∧ (EVERY (bv_ok s.refs) vs ⇒ EVERY (bv_ok t.refs) vs)
find_code_bv_ok=(find_code (dest :num option) (vs :v list) (s :(num # α) sptree$num_map) :(v list # α) option) = SOME ((args :v list),(e2 :α)) ∧ EVERY (bv_ok (refs :num |-> v ref)) vs ⇒ EVERY (bv_ok refs) args
do_build_ok=∀(parts :const_part list) (m :num -> v) (n :num) (r :(α, β) bvlSem$state) (q :v) (rs :num |-> v ref). do_build m n parts r.refs = (q,rs) ∧ state_ok r ∧ (∀(k :num). bv_ok r.refs (m k)) ⇒ state_ok (r with refs := rs) ∧ bv_ok rs q
do_app_ok=state_ok (r :(α, β) bvlSem$state) ∧ EVERY (bv_ok r.refs) (a :v list) ∧ (do_app (op :closLang$op) a r :(v # (α, β) bvlSem$state, v) result) = (Rval ((q :v),(t :(α, β) bvlSem$state)) :(v # (α, β) bvlSem$state, v) result) ⇒ state_ok t ∧ bv_ok t.refs q ∧ (EVERY (bv_ok r.refs) (env :v list) ⇒ EVERY (bv_ok t.refs) env)
evaluate_ok=∀(xs :bvl$exp list) (env :v list) (s :(α, β) bvlSem$state) (res :(v list, v) result) (t :(α, β) bvlSem$state). (evaluate (xs,env,s) :(v list, v) result # (α, β) bvlSem$state) = (res,t) ∧ state_ok s ∧ EVERY (bv_ok s.refs) env ⇒ state_ok t ∧ (case res of (Rval vs :(v list, v) result) => EVERY (bv_ok t.refs) vs | (Rerr (Rraise v) :(v list, v) result) => bv_ok t.refs v | (Rerr (Rabort v8 :v error_result) :(v list, v) result) => T) ∧ EVERY (bv_ok t.refs) env
compile_exps_correct=∀(xs :bvl$exp list) (env :v list) (s1 :(num # γ, 'ffi) bvlSem$state) (n :num) (res :(v list, v) result) (s2 :(num # γ, 'ffi) bvlSem$state) (t1 :(γ, 'ffi) state) (n2 :num) (ys :bvi$exp list) (aux :(num # num # bvi$exp) app_list) (b1 :num -> num). (evaluate (xs,env,s1) :(v list, v) result # (num # γ, 'ffi) bvlSem$state) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ (compile_exps n xs :bvi$exp list # (num # num # bvi$exp) app_list # num) = (ys,aux,n2) ∧ (state_rel b1 s1 t1 :bool) ∧ state_ok s1 ∧ EVERY (bv_ok s1.refs) env ∧ aux_code_installed (append aux) t1.code ∧ handle_ok xs ∧ IS_SOME t1.global ⇒ ∃(t2 :(γ, 'ffi) state) (b2 :num -> num) (c :num). (evaluate (ys,MAP (adjust_bv b2) env,inc_clock c t1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (map_result (MAP (adjust_bv b2)) (λ(v :v). Exn (adjust_bv b2 v)) res,t2) ∧ (state_rel b2 s2 t2 :bool) ∧ MAP (adjust_bv b1) env = MAP (adjust_bv b2) env ∧ ∀(a :num). a ∈ FDOM s1.refs ⇒ b1 a = b2 a
bv_ok_IMP_adjust_bv_eq_replay=∀(b2 :num -> num) (a1 :v) (b3 :num -> num). bv_ok (refs :num |-> v ref) a1 ∧ (∀(a :num). a ∈ FDOM refs ⇒ b2 a = b3 a) ⇒ adjust_bv b2 a1 = adjust_bv b3 a1
destVar_def_typed=∀(n :num). destVar (Var n :bvl$exp) = n
destVar_tick_unconstrained=destVar (Tick (Var (0 :num) :bvl$exp) :bvl$exp) = destVar (Tick (Var (0 :num) :bvl$exp) :bvl$exp)
compile_exps_sing_typed=(∀(n :num) (e :bvl$exp). (compile_exps n [e] :bvi$exp list # (num # num # bvi$exp) app_list # num) = (let ((x :bvi$exp),(y :(num # num # bvi$exp) app_list),(z :num)) = compile_exps_sing n e in ([x],y,z))) ∧ ∀(n :num) (es :bvl$exp list). compile_exps_list n es = (compile_exps n es :bvi$exp list # (num # num # bvi$exp) app_list # num)
compile_exps_Var_list_replay=∀(l :bvl$exp list) (n :num). EVERY isVar l ⇒ ∃(aux :(num # num # bvi$exp) app_list). (compile_exps n l :bvi$exp list # (num # num # bvi$exp) app_list # num) = (MAP (Var ∘ destVar) l,aux,n) ∧ append aux = ([] :(num # num # bvi$exp) list)
compile_int_thm_replay=∀(i :int) (env :v list) (s :(α, β) state). (evaluate ([compile_int i],env,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [(Number i :v)] :(v list, exn_or_ret) result),s)
compile_string_thm_typed=∀(str :string) (ls :word8 list) (ptr :num) (s :(γ, 'ffi) state) (env :v list). FLOOKUP s.refs ptr = SOME (ByteArray T ls :v ref) ∧ STRLEN str = LENGTH ls ⇒ (evaluate (MAPi (λ(n :num) (c :char). (Op (MemOp UpdateByte) [(Op (IntOp (Const ((&ORD c) :int))) ([] :bvi$exp list) :bvi$exp); compile_int ((&n) :int); (Var (0 :num) :bvi$exp)] :bvi$exp)) str,(RefPtr (b :bool) ptr :v)::env,s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval (REPLICATE (LENGTH ls) Unit) :(v list, exn_or_ret) result),s with refs := s.refs⟨ptr ↦ (ByteArray T (MAP ((n2w :num -> word8) ∘ ORD) str) :v ref)⟩)
HD_APPEND3_typed=(0 :num) < LENGTH ((l1 :α list) ++ (l2 :α list)) ⇒ HD (l1 ++ l2 ++ (l3 :α list)) = HD (l1 ++ l2)
compile_exps_LENGTH_lemma_replay=∀(n :num) (xs :bvl$exp list). LENGTH (FST (compile_exps n xs :bvi$exp list # (num # num # bvi$exp) app_list # num)) = LENGTH xs
compile_exps_LENGTH_typed=(compile_exps (n :num) (xs :bvl$exp list) :bvi$exp list # (num # num # bvi$exp) app_list # num) = ((ys :bvi$exp list),(aux :(num # num # bvi$exp) app_list),(n1 :num)) ⇒ LENGTH ys = LENGTH xs
compile_exps_SING_typed=(compile_exps (n :num) [(x :bvl$exp)] :bvi$exp list # (num # num # bvi$exp) app_list # num) = ((c :bvi$exp list),(aux :(num # num # bvi$exp) app_list),(n1 :num)) ⇒ ∃(y :bvi$exp). c = [y]
evaluate_MAP_Var2_typed=bVarBound (LENGTH (vs :v list)) (args :bvl$exp list) ∧ EVERY isVar args ⇒ ∃(ts :v list). (evaluate (MAP (Var ∘ destVar) args,vs ++ (env :v list),(s :(γ, 'ffi) state)) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval ts :(v list, exn_or_ret) result),s) ∧ (evaluate (MAP (Var ∘ destVar) args,vs,s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval ts :(v list, exn_or_ret) result),s)
iEval_bVarBound_replay=∀(n :num) (xs :bvl$exp list) (n :num) (vs :v list) (s :(γ, 'ffi) state) (env :v list). bVarBound (LENGTH vs) xs ∧ handle_ok xs ⇒ (evaluate (FST (compile_exps n xs :bvi$exp list # (num # num # bvi$exp) app_list # num),vs ++ env,s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (evaluate (FST (compile_exps n xs :bvi$exp list # (num # num # bvi$exp) app_list # num),vs,s) :(v list, exn_or_ret) result # (γ, 'ffi) state)
v_to_list_adjust_replay=∀(x :v). v_to_list (adjust_bv (f :num -> num) x) = OPTION_MAP (MAP (adjust_bv f)) (v_to_list x)
do_eq_adjust_lemma_replay=(∀(refs :num |-> v ref) (x1 :v) (x2 :v) (b :bool). refs = (r :(num # α, β) bvlSem$state).refs ∧ (do_eq refs x1 x2 :eq_result) = Eq_val b ∧ (state_rel (b2 :num -> num) r (t2 :(α, β) state) :bool) ∧ bv_ok r.refs x1 ∧ bv_ok r.refs x2 ⇒ (do_eq t2.refs (adjust_bv b2 x1) (adjust_bv b2 x2) :eq_result) = Eq_val b) ∧ ∀(refs :num |-> v ref) (x1 :v list) (x2 :v list) (b :bool). refs = r.refs ∧ (do_eq_list refs x1 x2 :eq_result) = Eq_val b ∧ (state_rel b2 r t2 :bool) ∧ EVERY (bv_ok r.refs) x1 ∧ EVERY (bv_ok r.refs) x2 ⇒ (do_eq_list t2.refs (MAP (adjust_bv b2) x1) (MAP (adjust_bv b2) x2) :eq_result) = Eq_val b
do_eq_adjust_replay=(do_eq (r :(num # α, β) bvlSem$state).refs (x1 :v) (x2 :v) :eq_result) = Eq_val (b :bool) ∧ (state_rel (b2 :num -> num) r (t2 :(α, β) state) :bool) ∧ bv_ok r.refs x1 ∧ bv_ok r.refs x2 ⇒ (do_eq t2.refs (adjust_bv b2 x1) (adjust_bv b2 x2) :eq_result) = Eq_val b
list_to_v_adjust_typed=∀(xs :v list). list_to_v (MAP (adjust_bv (b :num -> num)) xs) = adjust_bv b (list_to_v xs)
list_to_v_adjust_APPEND_typed=∀(xs :v list) (ys :v list). list_to_v (MAP (adjust_bv (b :num -> num)) xs) = adjust_bv b (list_to_v xs) ∧ list_to_v (MAP (adjust_bv b) xs) = adjust_bv b (list_to_v xs) ⇒ list_to_v (MAP (adjust_bv b) (xs ++ ys)) = adjust_bv b (list_to_v (xs ++ ys))
do_app_adjust_term_typed=(state_rel (b2 :num -> num) (s5 :(num # α, β) bvlSem$state) (t2 :(α, β) state) :bool) ∧ (∀(i :int). (op :closLang$op) ≠ IntOp (Const i)) ∧ op ≠ MemOp Ref ∧ (∀(flag :bool). op ≠ MemOp (RefByte flag)) ∧ op ≠ MemOp RefArray ∧ (∀(n :num). op ≠ GlobOp (Global n)) ∧ (∀(n :num). op ≠ GlobOp (SetGlobal n)) ∧ op ≠ GlobOp AllocGlobal ∧ op ≠ Install ∧ (∀(t :thunk_op). op ≠ (ThunkOp t :closLang$op)) ∧ (∀(n :num). op ≠ BlockOp (FromList n)) ∧ op ≠ MemOp FromListByte ∧ op ≠ MemOp ToListByte ∧ (∀(c :const_part list). op ≠ BlockOp (Build c)) ∧ op ≠ MemOp XorByte ∧ (∀(b :bool). op ≠ MemOp (CopyByte b)) ∧ op ≠ MemOp ConcatByteVec ∧ (∀(n :num). op ≠ Label n) ∧ (do_app op (REVERSE (a :v list)) s5 :(v # (num # α, β) bvlSem$state, v) result) = (Rval ((q :v),(r :(num # α, β) bvlSem$state)) :(v # (num # α, β) bvlSem$state, v) result) ∧ EVERY (bv_ok s5.refs) (REVERSE a) ⇒ ∃(t3 :(α, β) state). (do_app op (MAP (adjust_bv b2) (REVERSE a)) t2 :(v # (α, β) state, exn_or_ret) result) = (Rval (adjust_bv b2 q,t3) :(v # (α, β) state, exn_or_ret) result) ∧ (state_rel b2 r t3 :bool)
bvl_exp_size_generated_typed=(∀(a :num). exp_size (Var a :bvl$exp) = (1 :num) + a) ∧ (∀(a0 :bvl$exp) (a1 :bvl$exp) (a2 :bvl$exp). exp_size (If a0 a1 a2 :bvl$exp) = (1 :num) + (exp_size a0 + (exp_size a1 + exp_size a2))) ∧ (∀(a0 :bvl$exp list) (a1 :bvl$exp). exp_size (Let a0 a1 :bvl$exp) = (1 :num) + (exp1_size a0 + exp_size a1)) ∧ (∀(a :bvl$exp). exp_size (Raise a :bvl$exp) = (1 :num) + exp_size a) ∧ (∀(a0 :bvl$exp) (a1 :bvl$exp). exp_size (Handle a0 a1 :bvl$exp) = (1 :num) + (exp_size a0 + exp_size a1)) ∧ (∀(a :bvl$exp). exp_size (Tick a :bvl$exp) = (1 :num) + exp_size a) ∧ (∀(a0 :num) (a1 :num option) (a2 :bvl$exp list). exp_size (Call a0 a1 a2 :bvl$exp) = (1 :num) + (a0 + (option_size (λ(x :num). x) a1 + exp1_size a2))) ∧ (∀(a0 :num) (a1 :num). exp_size (Force a0 a1 :bvl$exp) = (1 :num) + (a0 + a1)) ∧ (∀(a0 :closLang$op) (a1 :bvl$exp list). exp_size (Op a0 a1 :bvl$exp) = (1 :num) + (op_size a0 + exp1_size a1)) ∧ exp1_size ([] :bvl$exp list) = (0 :num) ∧ ∀(a0 :bvl$exp) (a1 :bvl$exp list). exp1_size (a0::a1) = (1 :num) + (exp_size a0 + exp1_size a1)
eval_ind_alt_typed=∀(P :bvl$exp list # v list # (γ, 'ffi) bvlSem$state -> bool). (∀(env :v list) (s :(γ, 'ffi) bvlSem$state). P (([] :bvl$exp list),env,s)) ∧ (∀(x :bvl$exp) (y :bvl$exp) (xs :bvl$exp list) (env :v list) (s :(γ, 'ffi) bvlSem$state). (∀(v3 :(v list, v) result) (s1 :(γ, 'ffi) bvlSem$state) (v1 :v list). (evaluate ([x],env,s) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v3,s1) ∧ v3 = (Rval v1 :(v list, v) result) ⇒ P (y::xs,env,s1)) ∧ P ([x],env,s) ⇒ P (x::y::xs,env,s)) ∧ (∀(n :num) (env :v list) (s :(γ, 'ffi) bvlSem$state). P ([(Var n :bvl$exp)],env,s)) ∧ (∀(x1 :bvl$exp) (x2 :bvl$exp) (x3 :bvl$exp) (env :v list) (s :(γ, 'ffi) bvlSem$state). (∀(v2 :(v list, v) result) (s1 :(γ, 'ffi) bvlSem$state) (vs :v list). (evaluate ([x1],env,s) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v2,s1) ∧ v2 = (Rval vs :(v list, v) result) ∧ (Boolv T :v) ≠ HD vs ∧ (Boolv F :v) = HD vs ⇒ P ([x3],env,s1)) ∧ (∀(v2 :(v list, v) result) (s1 :(γ, 'ffi) bvlSem$state) (vs :v list). (evaluate ([x1],env,s) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v2,s1) ∧ v2 = (Rval vs :(v list, v) result) ∧ (Boolv T :v) = HD vs ⇒ P ([x2],env,s1)) ∧ P ([x1],env,s) ⇒ P ([(If x1 x2 x3 :bvl$exp)],env,s)) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (env :v list) (s :(γ, 'ffi) bvlSem$state). (∀(ys :bvl$exp list) (v2 :(v list, v) result) (s1 :(γ, 'ffi) bvlSem$state) (vs :v list). list_size exp_size ys ≤ exp_size x2 ∧ (evaluate (xs,env,s) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v2,s1) ⇒ P (ys,vs,s1)) ∧ (∀(ys :bvl$exp list) (env :v list). list_size exp_size ys ≤ exp_size x2 ⇒ P (ys,env,s)) ∧ (∀(v2 :(v list, v) result) (s1 :(γ, 'ffi) bvlSem$state) (vs :v list). (evaluate (xs,env,s) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v2,s1) ∧ v2 = (Rval vs :(v list, v) result) ⇒ P ([x2],vs ++ env,s1)) ∧ P (xs,env,s) ⇒ P ([(Let xs x2 :bvl$exp)],env,s)) ∧ (∀(x1 :bvl$exp) (env :v list) (s :(γ, 'ffi) bvlSem$state). P ([x1],env,s) ⇒ P ([(Raise x1 :bvl$exp)],env,s)) ∧ (∀(op :closLang$op) (xs :bvl$exp list) (env :v list) (s :(γ, 'ffi) bvlSem$state). P (xs,env,s) ⇒ P ([(Op op xs :bvl$exp)],env,s)) ∧ (∀(x1 :bvl$exp) (x2 :bvl$exp) (env :v list) (s1 :(γ, 'ffi) bvlSem$state). (∀(v3 :(v list, v) result) (s :(γ, 'ffi) bvlSem$state) (v8 :v error_result) (v :v). (evaluate ([x1],env,s1) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v3,s) ∧ v3 = (Rerr v8 :(v list, v) result) ∧ v8 = Rraise v ⇒ P ([x2],v::env,s)) ∧ (∀(xs :bvl$exp list) (env :v list). list_size exp_size xs ≤ exp_size x1 ⇒ P (xs,env,s1)) ⇒ P ([(Handle x1 x2 :bvl$exp)],env,s1)) ∧ (∀(force_loc :num) (n :num) (env :v list) (s :(γ, 'ffi) bvlSem$state). (∀(thunk_v :v) (v1 :thunk_mode) (v :v) (v' :v list # bvl$exp) (args :v list) (exp :bvl$exp). n < LENGTH env ∧ thunk_v = env❲n❳ ∧ (dest_thunk thunk_v s.refs :dest_thunk_ret) = (IsThunk v1 v :dest_thunk_ret) ∧ v1 = NotEvaluated ∧ s.clock ≠ (0 :num) ∧ (find_code (SOME force_loc) [thunk_v; v] s.code :(v list # bvl$exp) option) = SOME v' ∧ v' = (args,exp) ∧ s.clock ≠ (0 :num) ⇒ P ([exp],args,dec_clock (1 :num) s)) ⇒ P ([(Force force_loc n :bvl$exp)],env,s)) ∧ (∀(x :bvl$exp) (env :v list) (s :(γ, 'ffi) bvlSem$state). (s.clock ≠ (0 :num) ⇒ P ([x],env,dec_clock (1 :num) s)) ⇒ P ([(Tick x :bvl$exp)],env,s)) ∧ (∀(ticks :num) (dest :num option) (xs :bvl$exp list) (env :v list) (s1 :(γ, 'ffi) bvlSem$state). (∀(v2 :(v list, v) result) (s :(γ, 'ffi) bvlSem$state) (vs :v list) (v :v list # bvl$exp) (args :v list) (exp :bvl$exp). (evaluate (xs,env,s1) :(v list, v) result # (γ, 'ffi) bvlSem$state) = (v2,s) ∧ v2 = (Rval vs :(v list, v) result) ∧ (find_code dest vs s.code :(v list # bvl$exp) option) = SOME v ∧ v = (args,exp) ∧ ¬(s.clock < ticks + (1 :num)) ⇒ P ([exp],args,dec_clock (ticks + (1 :num)) s)) ∧ P (xs,env,s1) ⇒ P ([(Call ticks dest xs :bvl$exp)],env,s1)) ⇒ ∀(v :bvl$exp list) (v1 :v list) (v2 :(γ, 'ffi) bvlSem$state). P (v,v1,v2)
bvl_size_var=exp_size (Var (7 :num) :bvl$exp) = (8 :num)
bvl_size_force=exp_size (Force (3 :num) (5 :num) :bvl$exp) = (9 :num)
bvl_size_call=exp_size (Call (4 :num) (SOME (8 :num)) [(Var (2 :num) :bvl$exp)] :bvl$exp) = (18 :num)
bvl_size_op=exp_size (Op (Label (9 :num)) [(Var (3 :num) :bvl$exp)] :bvl$exp) = (16 :num)
bvl_size_let=exp_size (Let [(Var (4 :num) :bvl$exp)] (Tick (Var (2 :num) :bvl$exp) :bvl$exp) :bvl$exp) = (11 :num)
do_app_Ref_replay=(do_app (MemOp Ref) (vs :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((RefPtr T (LEAST(ptr :num). ptr ∉ FDOM s.refs) :v),bvl_to_bvi (bvi_to_bvl s with refs := s.refs⟨(LEAST(ptr :num). ptr ∉ FDOM s.refs) ↦ (ValueArray vs :v ref)⟩) s) :(v # (α, β) state, exn_or_ret) result)
state_rel_add_bytearray_typed=(state_rel (b2 :num -> num) (s5 :(num # γ, 'ffi) bvlSem$state) (t2 :(γ, 'ffi) state) :bool) ∧ state_ok s5 ∧ (pp :num) ∉ FDOM s5.refs ∧ (qq :num) ∉ FDOM t2.refs ⇒ (state_rel b2⦇pp ↦ qq⦈ (s5 with refs := s5.refs⟨pp ↦ (ByteArray (fl :bool) (ws :word8 list) :v ref)⟩) (t2 with refs := t2.refs⟨qq ↦ (ByteArray fl ws :v ref)⟩) :bool)
state_rel_add_thunk_typed=(state_rel (b :num -> num) (s :(num # γ, 'ffi) bvlSem$state) (t :(γ, 'ffi) state) :bool) ∧ state_ok s ∧ (pp :num) ∉ FDOM s.refs ∧ (qq :num) ∉ FDOM t.refs ⇒ (state_rel b⦇pp ↦ qq⦈ (s with refs := s.refs⟨pp ↦ (Thunk (m :thunk_mode) (v :v) :v ref)⟩) (t with refs := t.refs⟨qq ↦ (Thunk m (adjust_bv b⦇pp ↦ qq⦈ v) :v ref)⟩) :bool)
state_rel_update_thunk_typed=(state_rel (b :num -> num) (s :(num # γ, 'ffi) bvlSem$state) (t :(γ, 'ffi) state) :bool) ∧ state_ok s ∧ (ptr :num) ∈ FDOM s.refs ⇒ (state_rel b (s with refs := s.refs⟨ptr ↦ (Thunk (m :thunk_mode) (v :v) :v ref)⟩) (t with refs := t.refs⟨b ptr ↦ (Thunk m (adjust_bv b v) :v ref)⟩) :bool)
iEval_bVarBound_extra_replay=∀(n :α) (xs :bvl$exp list) (n :num) (vs :v list) (s :(β, γ) state) (env :v list) (d :bvi$exp list). bVarBound (LENGTH vs) xs ∧ handle_ok xs ∧ d = FST (compile_exps n xs :bvi$exp list # (num # num # bvi$exp) app_list # num) ⇒ (evaluate (d,vs ++ env,s) :(v list, exn_or_ret) result # (β, γ) state) = (evaluate (d,vs,s) :(v list, exn_or_ret) result # (β, γ) state)
MAP_Num_11_replay=∀(ns :word8 list) (ns' :word8 list). MAP (λ(x :word8). (Number ((&w2n x) :int) :v)) ns = MAP (λ(x :word8). (Number ((&w2n x) :int) :v)) ns' ⇔ ns' = ns
MAP_Word_11_replay=∀(ns :word64 list) (ns' :word64 list). MAP Word64 ns = MAP Word64 ns' ⇔ ns' = ns
IMP_v_to_bytes_typed=∀(v1 :v) (ns :word8 list). v_to_list v1 = SOME (MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns) ⇒ v_to_bytes (adjust_bv (b2 :num -> num) v1) = SOME ns
IMP_v_to_words_typed=v_to_list (v2 :v) = SOME (MAP Word64 (ns' :word64 list)) ⇒ v_to_words (adjust_bv (b2 :num -> num) v2) = SOME ns'
aux_code_installed_sublist_typed=∀(aux :(num # α # β) list) (ls :(num # α # β) list). IS_SUBLIST ls aux ∧ ALL_DISTINCT (MAP (FST :num # α # β -> num) ls) ⇒ aux_code_installed aux (fromAList ls)
compile_exps_aux_sorted_typed=∀(n :num) (es :bvl$exp list) (c :bvi$exp list) (aux :(num # num # bvi$exp) app_list) (n1 :num). (compile_exps n es :bvi$exp list # (num # num # bvi$exp) app_list # num) = (c,aux,n1) ⇒ SORTED $< (MAP (FST :num # num # bvi$exp -> num) (append aux)) ∧ EVERY (λ(x :num). ∃(n :num). x = bvl_num_stubs + bvl_to_bvi_namespaces * n + (1 :num)) (MAP (FST :num # num # bvi$exp -> num) (append aux)) ∧ EVERY (between (bvl_num_stubs + bvl_to_bvi_namespaces * n) (bvl_num_stubs + bvl_to_bvi_namespaces * n1)) (MAP (FST :num # num # bvi$exp -> num) (append aux)) ∧ n ≤ n1
between_typed=∀(x :num) (y :num) (z :num). between x y z ⇔ x ≤ z ∧ z < y
in_ns_def_typed=∀(k :num) (n :num). in_ns k n ⇔ n MOD bvl_to_bvi_namespaces = k
nss_in_ns_typed=in_ns (k :num) bvl_to_bvi_namespaces ⇔ k = (0 :num)
mult_nss_in_ns_typed=in_ns (k :num) ((m :num) * bvl_to_bvi_namespaces) ⇔ k = (0 :num)
mult_nss_in_ns_1_typed=in_ns (k :num) ((m :num) * bvl_to_bvi_namespaces + (1 :num)) ⇔ k = (1 :num)
mult_nss_in_ns_2_typed=in_ns (k :num) ((m :num) * bvl_to_bvi_namespaces + (2 :num)) ⇔ k = (2 :num)
in_ns_1_add_1_typed=in_ns (0 :num) (x :num) ⇒ in_ns (1 :num) (x + (1 :num))
in_ns_add_num_stubs_typed=in_ns (k :num) (bvl_num_stubs + (x :num)) ⇔ in_ns k x
compile_list_imp_replay=∀(n :num) (prog :(num # num # bvl$exp) list) (code :(num # num # bvi$exp) app_list) (n' :num) (name :num) (arity :num) (exp :bvl$exp). (compile_list n prog :(num # num # bvi$exp) app_list # num) = (code,n') ∧ ALOOKUP prog name = SOME (arity,exp) ⇒ ∃(n0 :num) (c :bvi$exp) (aux :(num # num # bvi$exp) app_list) (n1 :num). (compile_exps n0 [exp] :bvi$exp list # (num # num # bvi$exp) app_list # num) = ([c],aux,n1) ∧ ALOOKUP (append code) (nss * name + num_stubs) = SOME (arity,(compile_exp c :bvi$exp)) ∧ IS_SUBLIST (append code) (append aux)
nss_lemma_replay=(n :num) * nss ≠ (k :num) * nss + (1 :num)
in_ns_0_simp_replay=in_ns (0 :num) (nss * (p_1 :num) + num_stubs)
compile_inc_lemma_typed=(compile_inc (next1 :num) (prog1 :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list) = ((next2 :num),(prog2 :(num # num # bvi$exp) list)) ⇒ (ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) prog1) ⇒ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) prog2)) ∧ next1 ≤ next2 ∧ (∀(p :num). MEM (num_stubs + p * nss) (MAP (FST :num # num # bvi$exp -> num) prog2) ⇒ MEM p (MAP (FST :num # num # bvl$exp -> num) prog1)) ∧ ∀(p :num). MEM p (MAP (FST :num # num # bvi$exp -> num) prog2) ⇒ if in_ns (0 :num) p then ∃(q :num). num_stubs + q * nss = p else in_ns (1 :num) p ∧ num_stubs + nss * next1 ≤ p ∧ p < num_stubs + nss * next2
compile_inc_next_typed=(compile_inc (next1 :num) (prog1 :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list) = ((next2 :num),(prog2 :(num # num # bvi$exp) list)) ⇒ next1 ≤ next2
compile_inc_DISTINCT_typed=(compile_inc (next1 :num) (prog1 :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list) = ((next2 :num),(prog2 :(num # num # bvi$exp) list)) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) prog1) ⇒ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) prog2)
compile_inc_next_range_typed=(compile_inc (next1 :num) (prog1 :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list) = ((next2 :num),(prog2 :(num # num # bvi$exp) list)) ∧ MEM (x :num) (MAP (FST :num # num # bvi$exp -> num) prog2) ⇒ if x MOD nss = (1 :num) then num_stubs + nss * next1 ≤ x ∧ x < num_stubs + nss * next2 else x MOD nss = (0 :num) ∧ num_stubs ≤ x ∧ MEM ((x − num_stubs) DIV nss) (MAP (FST :num # num # bvl$exp -> num) prog1)
