subglobals_type=:α option list -> α option list -> bool
subglobals_definition=⊢ ∀(g1 :α option list) (g2 :α option list). subglobals g1 g2 ⇔ LENGTH g1 ≤ LENGTH g2 ∧ ∀(n :num). n < LENGTH g1 ∧ IS_SOME g1❲n❳ ⇒ g1❲n❳ = g2❲n❳
submap_fresh=⊢ (x :α) ∉ FDOM (f :α |-> β) ⇒ (f⟨x ↦ (y :β)⟩ ⊑ (g :α |-> β) ⇔ FLOOKUP g x = SOME y ∧ f ⊑ g)
submap_update=⊢ (f :α |-> β)⟨(x :α) ↦ (y :β)⟩ ⊑ (g :α |-> β) ⇔ FLOOKUP g x = SOME y ∧ f \\ x ⊑ g
subglobals_none=⊢ subglobals (REPLICATE (n :num) (NONE :α option)) (g :α option list) ⇔ n ≤ LENGTH g
subglobals_add_none=⊢ subglobals (gs :α option list) (gs ++ REPLICATE (n :num) (NONE :α option))
idx_kind_type=:idx_types
idx_prev=⊢ ∀(idx :next_indices) (idx2 :next_indices). idx_prev idx idx2 ⇔ idx.vidx ≤ idx2.vidx ∧ idx.tidx ≤ idx2.tidx ∧ idx.eidx ≤ idx2.eidx
idx_prev_refl=⊢ idx_prev (idx :next_indices) idx
idx_prev_trans=⊢ idx_prev (idx :next_indices) (idx2 :next_indices) ∧ idx_prev idx2 (idx3 :next_indices) ⇒ idx_prev idx idx3
idx_block=⊢ ∀(start_idx :next_indices) (end_idx :next_indices). idx_block start_idx end_idx = {(i,Idx_Var) | start_idx.vidx ≤ i ∧ i < end_idx.vidx} ∪ {(i,Idx_Type) | start_idx.tidx ≤ i ∧ i < end_idx.tidx} ∪ {(i,Idx_Exn) | start_idx.eidx ≤ i ∧ i < end_idx.eidx}
idx_final_block=⊢ ∀(start_idx :next_indices). idx_final_block start_idx = {(i,Idx_Var) | start_idx.vidx ≤ i} ∪ {(i,Idx_Type) | start_idx.tidx ≤ i} ∪ {(i,Idx_Exn) | start_idx.eidx ≤ i}
idx_allocated=⊢ ∀(genv :global_env). genv_allocated_idxs genv = {(i,Idx_Var) | i < LENGTH genv.v ∧ genv.v❲i❳ ≠ (NONE :v option)} ∪ {(i,Idx_Type) | ∃(cn :num) (a :num). ((cn,SOME i),a) ∈ FDOM genv.c} ∪ {(i,Idx_Type) | i ∈ FDOM genv.tys} ∪ {(i,Idx_Exn) | ∃(a :num). ((i,(NONE :num option)),a) ∈ FDOM genv.c}
idx_disjoint=⊢ ∀(xs :(α -> bool) list). ALL_DISJOINT xs ⇔ ∀(i :num) (j :num). i < LENGTH xs ∧ j < LENGTH xs ∧ i ≠ j ⇒ xs❲i❳ ∩ xs❲j❳ = (∅ :α -> bool)
idx_finish=⊢ ∀(len :num) (end_idx :next_indices) (next_cfg :config option). fin_idx_match len end_idx next_cfg ⇔ case next_cfg of (NONE :config option) => end_idx.vidx ≤ len | SOME c => c.next.vidx = len
orac_next_inner=⊢ ∀(interp :(β -> (α # γ) option) option) (orac_0 :δ # β # ε). src_orac_next_cfg_inner interp orac_0 = case (interp,orac_0) of ((NONE :(β -> (α # γ) option) option),v4) => (NONE :α option) | (SOME dec,env_id,state_v,decs) => case dec state_v of (NONE :(α # γ) option) => (NONE :α option) | SOME (c,x) => SOME c
orac_next=⊢ ∀(interp :(semanticPrimitives$v -> (α # β) option) option) (eval_state :eval_state option). src_orac_next_cfg interp eval_state = case eval_state of (NONE :eval_state option) => (NONE :α option) | SOME (EvalDecs v4) => (NONE :α option) | SOME (EvalOracle s) => src_orac_next_cfg_inner interp (s.oracle (0 :num) :(num # num) # semanticPrimitives$v # dec list)
idx_range=⊢ ∀(interp :(semanticPrimitives$v -> (config # α) option) option) (genv :global_env) (s_n_ts :num) (s_n_en :num) (s_eval :eval_state option) (idxs :next_indices # next_indices # (num # idx_types -> bool)). idx_range_rel interp genv s_n_ts s_n_en s_eval idxs ⇔ ∃(idx :next_indices) (end_idx :next_indices) (fin_idx :next_indices) (other_blocks :num # idx_types -> bool). idxs = (idx,end_idx,other_blocks) ∧ (case src_orac_next_cfg interp s_eval of (NONE :config option) => T | SOME c => fin_idx = c.next) ∧ idx_prev end_idx fin_idx ∧ ALL_DISJOINT [idx_block idx end_idx; idx_final_block fin_idx; other_blocks; genv_allocated_idxs genv] ∧ (∀(cn :mlstring) (t :num). t ≥ s_n_ts ⇒ TypeStamp cn t ∉ FRANGE genv.c) ∧ ∀(cn :num). cn ≥ s_n_en ⇒ ExnStamp cn ∉ FRANGE genv.c
idx_blank=⊢ idx_range_rel (interp :(semanticPrimitives$v -> (config # α) option) option) (genv :global_env) (nts :num) (nes :num) (eval_state :eval_state option) ((idx :next_indices),(end_idx :next_indices),(others :num # idx_types -> bool)) ∧ fin_idx_match (LENGTH genv.v) end_idx (src_orac_next_cfg interp eval_state) ∧ (n :num) + idx.vidx ≤ end_idx.vidx ⇒ ∃(pre :v option list) (post :v option list). genv.v = pre ++ REPLICATE n (NONE :v option) ++ post ∧ LENGTH pre = idx.vidx
orac_step=⊢ ∀(ci :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (eval_state :eval_state option). src_orac_step_invs ci g eval_state ⇔ case (ci,eval_state) of ((NONE :(semanticPrimitives$v -> (config # α) option) option),(NONE :eval_state option)) => T | ((NONE :(semanticPrimitives$v -> (config # α) option) option),SOME v7) => F | (SOME dec,(NONE :eval_state option)) => F | (SOME dec,SOME (EvalDecs v12)) => F | (SOME dec,SOME (EvalOracle s)) => (∀(k :num) (env_id :num # num) (state_v :semanticPrimitives$v) (decs :dec list). (s.oracle k :(num # num) # semanticPrimitives$v # dec list) = (env_id,state_v,decs) ⇒ ∃(c :config) (x :α). dec state_v = SOME (c,x)) ∧ (let (c_orac :num -> config) = (FST :config # α -> config) ∘ (THE :(config # α) option -> config # α) ∘ dec ∘ (FST :semanticPrimitives$v # dec list -> semanticPrimitives$v) ∘ (SND :(num # num) # semanticPrimitives$v # dec list -> semanticPrimitives$v # dec list) ∘ s.oracle in ∀(k :num) (env_id :num # num) (state_v :semanticPrimitives$v) (decs :dec list). (s.oracle k :(num # num) # semanticPrimitives$v # dec list) = (env_id,state_v,decs) ⇒ c_orac (SUC k) = FST (inc_compile_prog env_id (c_orac k) (g decs)))
env_gen_inv=⊢ ∀(e :environment_generation_store). env_gen_inv e ⇔ (domain e.envs :num -> bool) ⊆ count e.next
env_store_inv=⊢ ∀(e :environment_store). env_store_inv e ⇔ (domain e.env_gens :num -> bool) ⊆ count e.next
env_gen_rel=⊢ ∀(gen :environment_generation_store) (eval_state :eval_state option). env_gen_rel gen eval_state ⇔ case eval_state of (NONE :eval_state option) => T | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => gen.generation = s.generation ∧ s.generation < LENGTH s.envs ∧ gen.next = LENGTH s.envs❲s.generation❳
env_gen_future=⊢ ∀(interp :(semanticPrimitives$v -> (config # α) option) option) (gen :environment_generation_store) (eval_state :eval_state option). env_gen_future_rel interp gen eval_state ⇔ case src_orac_next_cfg interp eval_state of (NONE :config option) => T | SOME c => ∃(gen_final :source_to_flat$environment sptree$num_map). lookup gen.generation c.envs.env_gens = SOME gen_final ∧ subspt gen.envs gen_final
orac_env_inv=⊢ ∀(interp :(semanticPrimitives$v -> (config # α) option) option) (genv :global_env) (eval_state :eval_state option). src_orac_env_invs interp genv eval_state ⇔ case eval_state of (NONE :eval_state option) => T | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => ∃(c :config). src_orac_next_cfg interp eval_state = SOME c ∧ env_store_inv c.envs ∧ c.envs.next = LENGTH s.envs ∧ ∀(g_id :num) (id :num). g_id < LENGTH s.envs ∧ id < LENGTH s.envs❲g_id❳ ⇒ ∃(comp_map_gen :source_to_flat$environment sptree$num_map) (comp_map :source_to_flat$environment). lookup g_id c.envs.env_gens = SOME comp_map_gen ∧ lookup id comp_map_gen = SOME comp_map ∧ global_env_inv genv comp_map (∅ :mlstring -> bool) s.envs❲g_id❳❲id❳
orac_gen_inv=⊢ ∀(eval_state :eval_state option). src_orac_gen_inv eval_state ⇔ case eval_state of (NONE :eval_state option) => T | SOME (EvalDecs v1) => (ARB :bool) | SOME (EvalOracle s) => s.generation < LENGTH s.envs
orac_invs=⊢ ∀(interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (genv :global_env) (eval_state :eval_state option). src_orac_invs interp g genv eval_state ⇔ src_orac_step_invs interp g eval_state ∧ src_orac_env_invs interp genv eval_state ∧ src_orac_gen_inv eval_state
orac_weak=⊢ src_orac_invs (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (genv :global_env) (src_eval :eval_state option) ∧ genv.c ⊑ (genv' :global_env).c ∧ genv.tys ⊑ genv'.tys ∧ subglobals genv.v genv'.v ⇒ src_orac_invs interp g genv' src_eval
orac_first_step=⊢ src_orac_step_invs (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (SOME (EvalOracle (es :eval_oracle_state))) ⇒ ∃(i_f :semanticPrimitives$v -> (config # α) option) (env_id0 :num # num) (st_v0 :semanticPrimitives$v) (decs0 :dec list) (fdecs0 :exp list) (c0 :config) (x0 :α) (env_id1 :num # num) (st_v1 :semanticPrimitives$v) (decs1 :dec list) (c1 :config) (x1 :α). interp = SOME i_f ∧ (es.oracle (0 :num) :(num # num) # semanticPrimitives$v # dec list) = (env_id0,st_v0,decs0) ∧ (es.oracle (1 :num) :(num # num) # semanticPrimitives$v # dec list) = (env_id1,st_v1,decs1) ∧ i_f st_v0 = SOME (c0,x0) ∧ i_f st_v1 = SOME (c1,x1) ∧ inc_compile_prog env_id0 c0 (g decs0) = (c1,fdecs0) ∧ src_orac_next_cfg (SOME i_f) (SOME (EvalOracle es)) = SOME c0
refl_replay=⊢ ∀(g :α option list). subglobals g g
trans_replay=⊢ ∀(g1 :α option list) (g2 :α option list) (g3 :α option list). subglobals g1 g2 ∧ subglobals g2 g3 ⇒ subglobals g1 g3
append_replay=⊢ ∀(g1 :α option list) (g2 :α option list) (g3 :α option list). (subglobals (g1 ++ g2) (g1 ++ g3) ⇔ subglobals g2 g3) ∧ (LENGTH g2 = LENGTH g3 ⇒ (subglobals (g2 ++ g1) (g3 ++ g1) ⇔ subglobals g2 g3))
empty=∀(n :num). T
fill_empty=∀(n :num). n < (2 :num) ∧ IS_SOME [SOME (1 :num); (NONE :num option)]❲n❳ ⇒ [SOME (1 :num); (NONE :num option)]❲n❳ = [SOME (1 :num); SOME (2 :num)]❲n❳
append=∀(n :num). n < (2 :num) ∧ IS_SOME [SOME (1 :num); (NONE :num option)]❲n❳ ⇒ [SOME (1 :num); (NONE :num option)]❲n❳ = [SOME (1 :num); SOME (2 :num); SOME (3 :num)]❲n❳
shorter=F
overwrite=∀(n :num). n < (2 :num) ∧ IS_SOME [SOME (1 :num); (NONE :num option)]❲n❳ ⇒ [SOME (1 :num); (NONE :num option)]❲n❳ = [SOME (2 :num); (NONE :num option)]❲n❳
remove=∀(n :num). n < (1 :num) ∧ IS_SOME [SOME (1 :num)]❲n❳ ⇒ [SOME (1 :num)]❲n❳ = [(NONE :num option)]❲n❳
