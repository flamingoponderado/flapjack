tree_union_definition=(∀(t2 :sptree$num_set sptree$num_map). num_set_tree_union (LN :sptree$num_set sptree$num_map) t2 = t2) ∧ (∀(a :sptree$num_set) (t :sptree$num_set sptree$num_map). num_set_tree_union ⦕ 0 ↦ a ⦖ t = case t of (LN :sptree$num_set sptree$num_map) => ⦕ 0 ↦ a ⦖ | ⦕ 0 ↦ b ⦖ => ⦕ 0 ↦ union a b ⦖ | BN t1 t2 => BS t1 a t2 | BS t1' b' t2' => BS t1' (union a b') t2') ∧ (∀(t1 :sptree$num_set sptree$num_map) (t2 :sptree$num_set sptree$num_map) (t :sptree$num_set sptree$num_map). num_set_tree_union (BN t1 t2) t = case t of (LN :sptree$num_set sptree$num_map) => BN t1 t2 | ⦕ 0 ↦ a ⦖ => BS t1 a t2 | BN t1' t2' => BN (num_set_tree_union t1 t1') (num_set_tree_union t2 t2') | BS t1'' a'' t2'' => BS (num_set_tree_union t1 t1'') a'' (num_set_tree_union t2 t2'')) ∧ ∀(t1 :sptree$num_set sptree$num_map) (a :sptree$num_set) (t2 :sptree$num_set sptree$num_map) (t :sptree$num_set sptree$num_map). num_set_tree_union (BS t1 a t2) t = case t of (LN :sptree$num_set sptree$num_map) => BS t1 a t2 | ⦕ 0 ↦ b ⦖ => BS t1 (union a b) t2 | BN t1' t2' => BS (num_set_tree_union t1 t1') a (num_set_tree_union t2 t2') | BS t1'' b' t2'' => BS (num_set_tree_union t1 t1'') (union a b') (num_set_tree_union t2 t2'')
analyse_exp_definition=∀(e :exp). analyse_exp e = (let (locs :sptree$num_set) = find_loc e; (lookups :sptree$num_set) = find_lookups e in if is_pure e then if is_hidden e then ((LN :sptree$num_set),map (K lookups :unit -> sptree$num_set) locs) else (locs,map (K lookups :unit -> sptree$num_set) locs) else (union locs lookups,map (K (LN :sptree$num_set) :unit -> sptree$num_set) (union locs lookups)))
analysis_union_definition=∀(r1 :α sptree$num_map) (t1 :sptree$num_set sptree$num_map) (r2 :α sptree$num_map) (t2 :sptree$num_set sptree$num_map). code_analysis_union (r1,t1) (r2,t2) = (union r1 r2,num_set_tree_union t1 t2)
analyse_code_definition=analyse_code ([] :exp list) = ((LN :sptree$num_set),(LN :sptree$num_set sptree$num_map)) ∧ ∀(e :exp) (cs :exp list). analyse_code (e::cs) = code_analysis_union (analyse_exp e) (analyse_code cs)
remove_unreachable_definition=∀(reachable :α sptree$num_map) (l :exp list). remove_unreachable reachable l = FILTER (keep reachable) l
has_eval_dec_definition=∀(e :exp). has_Eval_dec e ⇔ has_Eval e
remove_flat_prog_definition=∀(code :exp list). remove_flat_prog code = if EXISTS has_Eval_dec code then code else (let ((r :sptree$num_set),(t :sptree$num_set sptree$num_map)) = analyse_code code; (reachable :sptree$num_set) = closure_spt r t in remove_unreachable reachable code)
