call_return_full_statement=∀p s t i r s1. evaluate (p,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i p,t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i p,t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
call_return_full_hypotheses=0
call_return_case64=∀s t i r s1. evaluate (Call (SOME (returnProg,5,7,9)) returnDest returnHandler,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i (Call (SOME (returnProg,5,7,9)) returnDest returnHandler),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i (Call (SOME (returnProg,5,7,9)) returnDest returnHandler),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
