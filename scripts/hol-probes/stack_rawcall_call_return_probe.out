call_return_evaluate_ind_obligation=∀ret dest handler s. (∀v3 ret_handler v6 link_reg v8 l1 l2 prog v1 s2 v5 x' v h v2 l1' l2'. ret = SOME v3 ∧ v3 = (ret_handler,v6) ∧ v6 = (link_reg,v8) ∧ v8 = (l1,l2) ∧ find_code dest (s.regs \\ link_reg) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var link_reg (Loc l1 l2) s)) = (v1,s2) ∧ v1 = SOME v5 ∧ v5 = Exception x' ∧ handler = SOME v ∧ v = (h,v2) ∧ v2 = (l1',l2') ∧ x' = Loc l1' l2' ⇒ P (h,s2)) ∧ (∀v3 ret_handler v6 link_reg v8 l1 l2 prog v1 s2 v5 x. ret = SOME v3 ∧ v3 = (ret_handler,v6) ∧ v6 = (link_reg,v8) ∧ v8 = (l1,l2) ∧ find_code dest (s.regs \\ link_reg) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var link_reg (Loc l1 l2) s)) = (v1,s2) ∧ v1 = SOME v5 ∧ v5 = Result x ∧ x = Loc l1 l2 ⇒ P (ret_handler,s2)) ∧ (∀v3 ret_handler v6 link_reg v8 l1 l2 prog. ret = SOME v3 ∧ v3 = (ret_handler,v6) ∧ v6 = (link_reg,v8) ∧ v8 = (l1,l2) ∧ find_code dest (s.regs \\ link_reg) s.code = SOME prog ∧ s.clock ≠ 0 ⇒ P (prog,dec_clock (set_var link_reg (Loc l1 l2) s))) ∧ (∀prog. ret = NONE ∧ find_code dest s.regs s.code = SOME prog ∧ handler = NONE ∧ s.clock ≠ 0 ⇒ P (prog,dec_clock s)) ⇒ P (Call ret dest handler,s)
call_return_whole_case64=∀s t i r s1. evaluate (Call returnOption returnDest returnHandler,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i (Call returnOption returnDest returnHandler),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i (Call returnOption returnDest returnHandler),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
call_return_direct64=comp (insert 3 4 LN) (Call (SOME (Seq (StackFree 4) (Call NONE (INL 3) NONE),5,7,9)) (INL 3) NONE) = Call (SOME (RawCall 3,5,7,9)) (INL 3) NONE ⇔ T
call_return_handler64=comp (insert 3 4 LN) (Call (SOME (Seq (StackFree 4) (Call NONE (INL 3) NONE),5,7,9)) (INR 6) (SOME (Seq (StackFree 6) (Call NONE (INL 3) NONE),11,13))) = Call (SOME (RawCall 3,5,7,9)) (INR 6) (SOME (Seq (StackFree 2) (RawCall 3),11,13)) ⇔ T
call_return_link_erased64=find_code (INR 5) (FEMPTY⟨5 ↦ Loc 3 0⟩ \\ 5) (insert 3 Skip LN) = NONE ⇔ T
call_return_other_link64=find_code (INR 6) (FEMPTY⟨6 ↦ Loc 3 0⟩ \\ 5) (insert 3 Skip LN) = SOME Skip ⇔ T
