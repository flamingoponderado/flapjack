almost_balancedL_thm=⊢ ∀(l :num) (r :num). balanced l r ⇒ almost_balancedL l r ∧ almost_balancedL (l + (1 :num)) r ∧ almost_balancedL l (r − (1 :num))
almost_balancedR_thm=⊢ ∀(l :num) (r :num). balanced l r ⇒ almost_balancedR l r ∧ almost_balancedR l (r + (1 :num)) ∧ almost_balancedR (l − (1 :num)) r
