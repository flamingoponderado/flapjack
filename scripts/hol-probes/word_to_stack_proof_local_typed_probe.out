gc_state_rel_typed=gc (s1 :(α, num # γ, 'ffi) state) = SOME (s2 :(α, num # γ, 'ffi) state) ∧ state_rel (ac :α asm_config) (k :num) (0 :num) (0 :num) s1 (t1 :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ⇒ ∃(t2 :(α, γ, 'ffi) stackSem$state). gc t1 = SOME t2 ∧ state_rel ac k (0 :num) (0 :num) (s2 with locals := (LN :α word_loc sptree$num_map)) t2 lens (0 :num) ∧ LENGTH t2.stack = LENGTH t1.stack ∧ t2.stack_space = t1.stack_space
get_code_handler_labels_copy_ret_typed=(get_code_labels (copy_ret (perf :bool) (b :bool) (kf :num # num # β) (vs :γ list) (kont :α stackLang$prog)) :num # num -> bool) = (get_code_labels kont :num # num -> bool) ∧ stack_get_handler_labels (m :num) (copy_ret perf b kf vs kont) = stack_get_handler_labels m kont
get_code_handler_labels_copy_ret_aux_typed=∀(k :num) (f :num) (n :num). (get_code_labels (copy_ret_aux k f n :α stackLang$prog) :num # num -> bool) = (∅ :num # num -> bool) ∧ stack_get_handler_labels (m :num) (copy_ret_aux k f n :β stackLang$prog) = (∅ :num # num -> bool)
get_code_handler_labels_wStackLoad_typed=∀(ls :(num # num) list). (get_code_labels (wStackLoad ls (x :α stackLang$prog)) :num # num -> bool) = (get_code_labels x :num # num -> bool) ∧ stack_get_handler_labels (n :num) (wStackLoad ls x) = stack_get_handler_labels n x
get_code_labels_wReg_typed=(∀(n :num). (get_code_labels ((f :num -> α stackLang$prog) n) :num # num -> bool) = (∅ :num # num -> bool)) ⇒ (get_code_labels (wRegWrite1 f (n :num) (kf :num # num # num)) :num # num -> bool) = (∅ :num # num -> bool) ∧ (get_code_labels (wRegWrite2 f n kf) :num # num -> bool) = (∅ :num # num -> bool)
get_vars_eq_typed=∀(ls :num list) (z :α word_loc list). (get_vars ls (st :(α, β, γ) state) :α word_loc list option) = SOME z ⇒ (let (lookups :α word_loc option list) = MAP (λ(x :num). lookup x st.locals) ls in EVERY (IS_SOME :α word_loc option -> bool) lookups ∧ z = MAP (THE :α word_loc option -> α word_loc) lookups)
get_vars_fromList2_eq_typed=(get_vars (GENLIST (λ(x :num). (2 :num) * x) (LENGTH (args :δ list))) (s :(α, β, γ) state) :α word_loc list option) = SOME (x :α word_loc list) ∧ lookup (n :num) (fromList2 x) = SOME (y :α word_loc) ⇒ lookup n s.locals = SOME y
