copy_ret_stack_asm_remove_typed=reg_name (FST (kf :num # num # β)) (c :α asm_config) ⇒ (stack_asm_remove c (copy_ret F (b :bool) kf (vs :δ list) (kont :γ stackLang$prog)) ⇔ stack_asm_remove c kont)
dec_stack_lemma_typed=good_dimindex (:α) ∧ (1 :num) ≤ LENGTH (t1 :(α, γ, 'ffi) stackSem$state).bitmaps ∧ HD t1.bitmaps = (4w :α word) ∧ t1.stack_space ≤ LENGTH t1.stack ∧ (enc_stack t1.bitmaps (DROP t1.stack_space t1.stack) :α word_loc list option) = SOME (enc_stack (s1 :(α, num # γ, 'ffi) state).stack :α word_loc list) ∧ (dec_stack (x0 :α word_loc list) s1.stack :α stack_frame list option) = SOME (x :α stack_frame list) ∧ stack_rel (k :num) s1.handler s1.stack (SOME t1.store⟨Handler⟩) (DROP t1.stack_space t1.stack) (LENGTH t1.stack) t1.bitmaps (lens :num list) ∧ LENGTH (enc_stack s1.stack :α word_loc list) = LENGTH x0 ⇒ ∃(yy :α word_loc list). (dec_stack t1.bitmaps x0 (DROP t1.stack_space t1.stack) :α word_loc list option) = SOME yy ∧ t1.stack_space + LENGTH yy = LENGTH t1.stack ∧ stack_rel k s1.handler x (SOME t1.store⟨Handler⟩) yy (LENGTH t1.stack) t1.bitmaps lens
dec_stack_lemma1_typed=∀(bs :α word list) (wstack :α stack_frame list) (sstack :α word_loc list) (lens :num list) (astack :((α word_loc # α word_loc) option # bool list # α word_loc list) list) (wdec :α stack_frame list) (ls :α word_loc list). good_dimindex (:α) ∧ (1 :num) ≤ LENGTH bs ∧ HD bs = (4w :α word) ∧ abs_stack bs wstack sstack lens = SOME astack ∧ stack_rel_aux (k :num) (len :num) wstack astack ∧ (dec_stack ls wstack :α stack_frame list option) = SOME wdec ⇒ ∃(sdec :α word_loc list) (bstack :((α word_loc # α word_loc) option # bool list # α word_loc list) list). (dec_stack bs ls sstack :α word_loc list option) = SOME sdec ∧ abs_stack bs wdec sdec lens = SOME bstack ∧ stack_rel_aux k len wdec bstack ∧ LIST_REL (abs_frame_eq :(α word_loc # α word_loc) option # bool list # α word_loc list -> (α word_loc # α word_loc) option # bool list # α word_loc list -> bool) astack bstack
dec_stack_stack_size_typed=∀(xs :α word_loc list) (st :α stack_frame list) (st' :α stack_frame list). (dec_stack xs st :α stack_frame list option) = SOME st' ⇒ stack_size st = stack_size st'
enc_stack_lemma_typed=∀(bs :α word list) (wstack :α stack_frame list) (sstack :α word_loc list) (lens :num list) (astack :((α word_loc # α word_loc) option # bool list # α word_loc list) list) (bs' :β). good_dimindex (:α) ∧ LENGTH bs + (1 :num) < dimword (:α) ∧ abs_stack bs wstack sstack lens = SOME astack ∧ (1 :num) ≤ LENGTH bs ∧ HD bs = (4w :α word) ∧ stack_rel_aux (k :num) (len :num) wstack astack ⇒ (enc_stack bs sstack :α word_loc list option) = SOME (enc_stack wstack :α word_loc list)
env_to_list_K_I_IMP_typed=∀(env :α word_loc sptree$num_map) (l :(num # α word_loc) list) (oracle :num -> num -> num). env_to_list env (K (I :num -> num) :num -> num -> num) = (l,oracle) ⇒ SORTED (λ(x :num # α word_loc) (y :num # α word_loc). FST x > FST y) l ∧ oracle = (K (I :num -> num) :num -> num -> num) ∧ PERM (toAList env) l
evaluate_PushHandler_typed=(3 :num) ≤ (t :(α, γ, 'ffi) stackSem$state).stack_space ∧ state_rel (ac :α asm_config) (k :num) (0 :num) (0 :num) (push_env (x' :α word_loc sptree$num_map # α word_loc sptree$num_map) (NONE :(num # α prog # num # num) option) (s :(α, num # γ, 'ffi) state) with <|locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num)|>) t ((f' :num)::(lens :num list)) (0 :num) ∧ loc_check t.code ((x''2 :num),(x''3 :num)) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate ((PushHandler F x''2 x''3 (k,(f :num),f') :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ t' = t with <|stack_space := t'.stack_space; regs := t'.regs; stack := t'.stack; store := t'.store|> ∧ (∀(n :num). n < LENGTH t.stack − t.stack_space ⇒ (DROP t.stack_space t.stack)❲n❳ = (DROP t'.stack_space t'.stack)❲n + (3 :num)❳) ∧ (∀(i :num). i ≠ k ⇒ (get_var i t' :α word_loc option) = (get_var i t :α word_loc option)) ∧ t'.stack_space + (3 :num) = t.stack_space ∧ LENGTH t'.stack = LENGTH t.stack ∧ state_rel ac k (0 :num) (0 :num) (push_env x' (SOME ((x''0 :num),(x''1 :α prog),x''2,x''3)) s with <|locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num)|>) t' (f'::lens) (0 :num)
evaluate_PushHandler_clock_typed=∀(t :(α, γ, 'ffi) stackSem$state). (evaluate ((PushHandler F (a :num) (b :num) ((k :num),(f :num),(f' :num)) :α stackLang$prog),t with clock := (clk :num)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (FST (evaluate ((PushHandler F a b (k,f,f') :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state),SND (evaluate ((PushHandler F a b (k,f,f') :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) with clock := clk)
evaluate_call_dest_clock_typed=(call_dest (dest :num option) (args :num list) ((k :num),(f :num),(f' :num)) :α stackLang$prog # (num + num)) = ((q0 :α stackLang$prog),(dest' :num + num)) ⇒ (evaluate (q0,(t :(α, γ, 'ffi) stackSem$state) with clock := (clk :num)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((I :α stackSem$result option -> α stackSem$result option) ## (λ(t :(α, γ, 'ffi) stackSem$state). t with clock := clk)) (evaluate (q0,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state)
evaluate_const_inst_typed=state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) (s :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (extra :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (const_inst (k + (1 :num)) (i :α word),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ t.clock = t'.clock ∧ state_rel ac k f f' s t' lens extra ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ (get_var (k + (1 :num)) t' :α word_loc option) = SOME (Word i)
evaluate_const_inst_clock_typed=(evaluate (const_inst (k :num) (i :α word),(t :(α, β, γ) stackSem$state) with clock := (clk :num)) :α stackSem$result option # (α, β, γ) stackSem$state) = ((I :α stackSem$result option -> α stackSem$result option) ## (λ(t :(α, β, γ) stackSem$state). t with clock := clk)) (evaluate (const_inst k i,t) :α stackSem$result option # (α, β, γ) stackSem$state)
evaluate_cont_loop_handler_typed=(evaluate ((c :α prog),(s :(α, β, γ) state)) :α wordSem$result option # (α, β, γ) state) = ((res :α wordSem$result option),(s1 :(α, β, γ) state)) ∧ cont_loop res ⇒ s1.handler = s.handler
evaluate_stack_move_typed=∀(n :num) (tar :num) (t :(α, β, γ) stackSem$state) (offset :num). t.use_stack ∧ t.stack_space + tar + n + offset ≤ LENGTH t.stack ∧ n ≤ offset ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate (stack_move n tar offset (k :num) (Skip :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ ∃(t'_stack :α word_loc list) (t'_regs :num |-> α word_loc). t' = t with <|stack := t'_stack; regs := t'_regs|> ∧ (∀(i :num). i ≠ k ⇒ (get_var i t' :α word_loc option) = (get_var i t :α word_loc option)) ∧ LENGTH t.stack = LENGTH t'_stack ∧ t'.stack_space = t.stack_space ∧ DROP (t'.stack_space + tar + n) t'_stack = DROP (t.stack_space + tar + n) t.stack ∧ (let (stack' :α word_loc list) = DROP (t'.stack_space + tar) t'_stack; (stack :α word_loc list) = DROP (t.stack_space + tar) t.stack in ∀(x :num). x < n ⇒ stack❲x + offset❳ = stack'❲x❳)
evaluate_stack_move_clock_typed=∀(a :num) (b :num) (c :num) (d :num) (t :(α, γ, 'ffi) stackSem$state). (let (prog :α stackLang$prog) = stack_move a b c d (Skip :α stackLang$prog) in (evaluate (prog,t with clock := (clk :num)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (FST (evaluate (prog,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state),SND (evaluate (prog,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) with clock := clk))
evaluate_stack_move_seq_typed=∀(a :num) (b :num) (c :num) (d :num) (prog :α stackLang$prog) (t :(α, γ, 'ffi) stackSem$state). (evaluate (stack_move a b c d prog,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (evaluate (Seq prog (stack_move a b c d (Skip :α stackLang$prog)),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state)
evaluate_wLive_typed=wLive (names :sptree$num_set # sptree$num_set) ((bs :α word app_list),(n :num)) ((k :num),(f :num),(f' :num)) = ((wlive_prog :α stackLang$prog),(bs' :α word app_list),(n' :num)) ∧ (∀(x :num). x ∈ (domain (FST names) :num -> bool) ⇒ EVEN x ∧ k ≤ x DIV (2 :num)) ∧ (∀(x :num). x ∈ (domain (SND names) :num -> bool) ⇒ EVEN x ∧ k ≤ x DIV (2 :num)) ∧ state_rel (ac :α asm_config) k f f' (s :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ∧ (1 :num) ≤ f ∧ cut_envs names s.locals = SOME (envs :α word_loc sptree$num_map # α word_loc sptree$num_map) ∧ LENGTH (append bs) ≤ n ∧ n − LENGTH (append bs) ≤ LENGTH t.bitmaps ∧ append bs' ≼ DROP (n − LENGTH (append bs)) t.bitmaps ⇒ ∃(t5 :(α, γ, 'ffi) stackSem$state) (bs5 :β). (evaluate (wlive_prog,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t5) ∧ state_rel ac k (0 :num) (0 :num) (push_env envs (NONE :(num # α prog # num # num) option) s with <|locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num)|>) t5 (f'::lens) (0 :num) ∧ state_rel ac k f f' s t5 lens (0 :num) ∧ LENGTH t5.stack = LENGTH t.stack ∧ t5.stack_space = t.stack_space ∧ ∀(i :num). i ≠ k ⇒ (get_var i t5 :α word_loc option) = (get_var i t :α word_loc option)
evaluate_wLive_clock_typed=∀(x :sptree$num_set # sptree$num_set) (t :(α, γ, 'ffi) stackSem$state) (q :α stackLang$prog) (bs :α word app_list # num) (bs' :α word app_list # num). wLive x bs (kf :num # num # num) = (q,bs') ⇒ (evaluate (q,t with clock := (clk :num)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (FST (evaluate (q,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state),SND (evaluate (q,t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) with clock := clk)
evaluate_wStackLoad_clock_typed=∀(x :(num # num) list) (t :(α, β, γ) stackSem$state). (evaluate (wStackLoad x (Skip :α stackLang$prog),t with clock := (clk :num)) :α stackSem$result option # (α, β, γ) stackSem$state) = ((I :α stackSem$result option -> α stackSem$result option) ## (λ(s :(α, β, γ) stackSem$state). s with clock := clk)) (evaluate (wStackLoad x (Skip :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state)
evaluate_wStackLoad_wReg1_typed=wReg1 (r :num) ((k :num),(f :num),(f' :num)) = ((x :(num # num) list),(r' :num)) ∧ EVEN r ∧ (get_var r (s :(α, num # γ, 'ffi) state) :α word_loc option) = SOME (c :α word_loc) ∧ state_rel (ac :α asm_config) k f f' s (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackLoad x (Skip :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ t.clock = t'.clock ∧ state_rel ac k f f' s t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ t'.bitmaps = t.bitmaps ∧ (∀(r :num). r ≠ k ⇒ (get_var r t' :α word_loc option) = (get_var r t :α word_loc option)) ∧ r' ≠ k + (1 :num) ∧ (get_var r' t' :α word_loc option) = SOME c
evaluate_wStackLoad_wReg1_with_const_typed=wReg1 (r :num) ((k :num),(f :num),(f' :num)) = ((x :(num # num) list),(r' :num)) ∧ EVEN r ∧ (word_exp (s :(α, num # γ, 'ffi) state) (Op Add [(Var r :α exp); (Const (c :α word) :α exp)]) :α word_loc option) = SOME (Word (w :α word)) ∧ state_rel (ac :α asm_config) k f f' s (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackLoad x (Skip :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ t.clock = t'.clock ∧ state_rel ac k f f' s t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ r' ≠ k + (1 :num) ∧ (word_exp t' (Op Add [(Var r' :α exp); (Const c :α exp)]) :α word option) = SOME w
evaluate_wStackLoad_wReg2_typed=wReg2 (r :num) ((k :num),(f :num),(f' :num)) = ((x :(num # num) list),(r' :num)) ∧ EVEN r ∧ (get_var r (s :(α, num # γ, 'ffi) state) :α word_loc option) = SOME (c :α word_loc) ∧ state_rel (ac :α asm_config) k f f' s (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackLoad x (Skip :α stackLang$prog),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ t.clock = t'.clock ∧ t.bitmaps = t'.bitmaps ∧ state_rel ac k f f' s t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ (∀(r :num). r ≠ k + (1 :num) ⇒ (get_var r t' :α word_loc option) = (get_var r t :α word_loc option)) ∧ (∀(r :num) (c :α word). r ≠ k + (1 :num) ⇒ (word_exp t' (Op Add [(Var r :α exp); (Const c :α exp)]) :α word option) = (word_exp t (Op Add [(Var r :α exp); (Const c :α exp)]) :α word option)) ∧ (get_var r' t' :α word_loc option) = SOME c
evaluate_wStackStore_wReg1_typed=wReg1 (r :num) ((k :num),(f :num),(f' :num)) = ((x :(num # num) list),(r' :num)) ∧ EVEN r ∧ r < (2 :num) * f' + (2 :num) * k ∧ state_rel (ac :α asm_config) k f f' (s :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ∧ LENGTH t.stack = (LENGTH_t_stack :num) ∧ t.stack_space = (t_stack_space :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackStore x (Skip :α stackLang$prog),set_var r' (c :α word_loc) t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (set_var r c s) t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH_t_stack ∧ t'.stack_space = t_stack_space
evaluate_wStackStore_wReg1_0_typed=wReg1 (r :num) ((k :num),(f :num),(f' :num)) = ((x :(num # num) list),(r' :num)) ∧ EVEN r ∧ r < (2 :num) * f' + (2 :num) * k ∧ state_rel (ac :α asm_config) k f f' (s :(α, num # γ, 'ffi) state) (t :(α, γ, 'ffi) stackSem$state) (lens :num list) (0 :num) ∧ LENGTH t.stack = (LENGTH_t_stack :num) ∧ t.stack_space = (t_stack_space :num) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (wStackStore x (Skip :α stackLang$prog),set_var (0 :num) (c1 :α word_loc) (set_var r' (c :α word_loc) t)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (set_var (0 :num) c1 (set_var r c s)) t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH_t_stack ∧ t'.stack_space = t_stack_space
evaluate_wStackStore_wReg2_new_typed=wReg2 (r :num) ((k :num),(f :num),(f' :num)) = ((x :(num # num) list),(r' :num)) ∧ EVEN r ∧ r < (2 :num) * f' + (2 :num) * k ∧ (∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate ((kont :α stackLang$prog),(t :(α, γ, 'ffi) stackSem$state)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),set_var r' (c :α word_loc) t') ∧ state_rel (ac :α asm_config) k f f' (s :(α, num # γ, 'ffi) state) t' (lens :num list) (0 :num) ∧ LENGTH t'.stack = (LENGTH_t_stack :num) ∧ t'.stack_space = (t_stack_space :num)) ⇒ ∃(t' :(α, γ, 'ffi) stackSem$state). (evaluate (Seq kont (wStackStore x (Skip :α stackLang$prog)),t) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (set_var r c s) t' lens (0 :num) ∧ LENGTH t'.stack = LENGTH_t_stack ∧ t'.stack_space = t_stack_space
extract_labels_copy_ret_typed=extract_labels (copy_ret (perf :bool) (b :bool) (kf :num # num # β) (vs :γ list) (kont :α stackLang$prog)) = extract_labels kont
