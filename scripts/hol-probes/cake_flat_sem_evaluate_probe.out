evaluate_rebound_typed=(∀(s :(γ, 'ffi) state) (env :v environment). (evaluate env s ([] :exp list) :(γ, 'ffi) state # (v list, v) result) = (s,(Rval ([] :v list) :(v list, v) result))) ∧ (∀(s :(γ, 'ffi) state) (es :exp list) (env :v environment) (e2 :exp) (e1 :exp). (evaluate env s (e1::e2::es) :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s [e1] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval v :(v list, v) result)) => (case (evaluate env s' (e2::es) :(γ, 'ffi) state # (v list, v) result) of (s'',(Rval vs :(v list, v) result)) => (s'',(Rval (HD v::vs) :(v list, v) result)) | (s'',(Rerr v8 :(v list, v) result)) => (s'',(Rerr v8 :(v list, v) result))) | (s',(Rerr v10 :(v list, v) result)) => (s',(Rerr v10 :(v list, v) result))) ∧ (∀(v0 :tra) (s :(γ, 'ffi) state) (l :lit) (env :v environment). (evaluate env s [(Lit v0 l :exp)] :(γ, 'ffi) state # (v list, v) result) = (s,(Rval [(Litv l :v)] :(v list, v) result))) ∧ (∀(v1 :tra) (s :(γ, 'ffi) state) (env :v environment) (e :exp). (evaluate env s [(Raise v1 e :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s [e] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval v :(v list, v) result)) => (s',(Rerr (Rraise (HD v)) :(v list, v) result)) | (s',(Rerr v8 :(v list, v) result)) => (s',(Rerr v8 :(v list, v) result))) ∧ (∀(v2 :tra) (s :(γ, 'ffi) state) (pes :(pat # exp) list) (env :v environment) (e :exp). (evaluate env s [(Handle v2 e pes :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s [e] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval v9 :(v list, v) result)) => (s',(Rval v9 :(v list, v) result)) | (s',(Rerr (Rraise v) :(v list, v) result)) => (case pmatch_rows pes s' v of (No_match :((mlstring # v) list # pat # exp) match_result) => (s',(Rerr (Rraise v) :(v list, v) result)) | (Match_type_error :((mlstring # v) list # pat # exp) match_result) => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | Match (env',p',e') => if ALL_DISTINCT (pat_bindings p') then (evaluate (env with v := env' ++ env.v) s' [e'] :(γ, 'ffi) state # (v list, v) result) else (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) | (s',(Rerr (Rabort v14 :v error_result) :(v list, v) result)) => (s',(Rerr (Rabort v14 :v error_result) :(v list, v) result))) ∧ (∀(v3 :tra) (s :(γ, 'ffi) state) (es :exp list) (env :v environment). (evaluate env s [(Con v3 (NONE :(num # num option) option) es :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s (REVERSE es) :(γ, 'ffi) state # (v list, v) result) of (s',(Rval vs :(v list, v) result)) => (s',(Rval [Conv (NONE :(num # num option) option) (REVERSE vs)] :(v list, v) result)) | (s',(Rerr v7 :(v list, v) result)) => (s',(Rerr v7 :(v list, v) result))) ∧ (∀(v4 :tra) (s :(γ, 'ffi) state) (es :exp list) (env :v environment) (cn :num # num option). (evaluate env s [(Con v4 (SOME cn) es :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s (REVERSE es) :(γ, 'ffi) state # (v list, v) result) of (s',(Rval vs :(v list, v) result)) => (s',(Rval [Conv (SOME cn) (REVERSE vs)] :(v list, v) result)) | (s',(Rerr v7 :(v list, v) result)) => (s',(Rerr v7 :(v list, v) result))) ∧ (∀(v5 :tra) (s :(γ, 'ffi) state) (n :mlstring) (env :v environment). (evaluate env s [Var_local v5 n] :(γ, 'ffi) state # (v list, v) result) = (s,case ALOOKUP env.v n of (NONE :v option) => (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) | SOME v => (Rval [v] :(v list, v) result))) ∧ (∀(v6 :mlstring) (s :(γ, 'ffi) state) (n :mlstring) (env :v environment) (e :exp). (evaluate env s [(Fun v6 n e :exp)] :(γ, 'ffi) state # (v list, v) result) = (s,(Rval [(Closure env n e :v)] :(v list, v) result))) ∧ (∀(v7 :tra) (s :(γ, 'ffi) state) (op :op) (es :exp list) (env :v environment). (evaluate env s [(App v7 op es :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s (REVERSE es) :(γ, 'ffi) state # (v list, v) result) of (s',(Rval vs :(v list, v) result)) => if op = Src Opapp then case (do_opapp (REVERSE vs) :(v environment # exp) option) of (NONE :(v environment # exp) option) => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if s'.clock = (0 :num) then (s',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else (evaluate env' (dec_clock s') [e] :(γ, 'ffi) state # (v list, v) result) else if op = Src Eval then case (do_eval (REVERSE vs) s'.eval_config :(exp list # γ install_config # v) option) of (NONE :(exp list # γ install_config # v) option) => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (decs,eval_config,retv) => (let (s'' :(γ, 'ffi) state) = s' with eval_config := eval_config in if s''.clock = (0 :num) then (s'',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else case (evaluate_decs (dec_clock s'') decs :(γ, 'ffi) state # v error_result option) of (s'³',(NONE :v error_result option)) => (s'³',(Rval [retv] :(v list, v) result)) | (s'³',SOME e) => (s'³',(Rerr e :(v list, v) result))) else if op = Src (ThunkOp ForceThunk) then case (dest_thunk vs s'.refs :dest_thunk_ret) of BadRef => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | NotThunk => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (IsThunk Evaluated v :dest_thunk_ret) => (s',(Rval [v] :(v list, v) result)) | (IsThunk NotEvaluated v :dest_thunk_ret) => case (evaluate <|v := [(«f»,v)]|> s' [AppUnit (Var_local None «f»)] :(γ, 'ffi) state # (v list, v) result) of (s'',(Rval vs2 :(v list, v) result)) => (case update_thunk vs s''.refs vs2 of (NONE :v store_v list option) => (s'',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME refs => (s'' with refs := refs,(Rval vs2 :(v list, v) result))) | (s'',(Rerr e :(v list, v) result)) => (s'',(Rerr e :(v list, v) result)) else (case do_app s' op (REVERSE vs) of (NONE :((γ, 'ffi) state # (v, v) result) option) => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (s',r) => (s',list_result r)) | (s',(Rerr v11 :(v list, v) result)) => (s',(Rerr v11 :(v list, v) result))) ∧ (∀(v8 :tra) (s :(γ, 'ffi) state) (env :v environment) (e3 :exp) (e2 :exp) (e1 :exp). (evaluate env s [(If v8 e1 e2 e3 :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s [e1] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval vs :(v list, v) result)) => (case do_if (HD vs) e2 e3 of (NONE :exp option) => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME e => (evaluate env s' [e] :(γ, 'ffi) state # (v list, v) result)) | (s',(Rerr v7 :(v list, v) result)) => (s',(Rerr v7 :(v list, v) result))) ∧ (∀(v9 :tra) (s :(γ, 'ffi) state) (pes :(pat # exp) list) (env :v environment) (e :exp). (evaluate env s [(Mat v9 e pes :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s [e] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval v :(v list, v) result)) => (case pmatch_rows pes s' (HD v) of (No_match :((mlstring # v) list # pat # exp) match_result) => (s',(Rerr (Rraise bind_exn_v) :(v list, v) result)) | (Match_type_error :((mlstring # v) list # pat # exp) match_result) => (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | Match (env',p',e') => if ALL_DISTINCT (pat_bindings p') then (evaluate (env with v := env' ++ env.v) s' [e'] :(γ, 'ffi) state # (v list, v) result) else (s',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) | (s',(Rerr v9 :(v list, v) result)) => (s',(Rerr v9 :(v list, v) result))) ∧ (∀(v10 :tra) (s :(γ, 'ffi) state) (n :mlstring option) (env :v environment) (e2 :exp) (e1 :exp). (evaluate env s [(Let v10 n e1 e2 :exp)] :(γ, 'ffi) state # (v list, v) result) = case (evaluate env s [e1] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval vs :(v list, v) result)) => (evaluate (env with v updated_by opt_bind n (HD vs)) s' [e2] :(γ, 'ffi) state # (v list, v) result) | (s',(Rerr v7 :(v list, v) result)) => (s',(Rerr v7 :(v list, v) result))) ∧ (∀(v11 :mlstring) (s :(γ, 'ffi) state) (funs :(mlstring # mlstring # exp) list) (env :v environment) (e :exp). (evaluate env s [(Letrec v11 funs e :exp)] :(γ, 'ffi) state # (v list, v) result) = if ALL_DISTINCT (MAP (FST :mlstring # mlstring # exp -> mlstring) funs) then (evaluate (env with v := build_rec_env funs env env.v) s [e] :(γ, 'ffi) state # (v list, v) result) else (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(s :(γ, 'ffi) state) (e :exp). evaluate_dec s e = case (evaluate <|v := ([] :(mlstring # v) list)|> s [e] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval [Unitv] :(v list, v) result)) => (s',(NONE :v error_result option)) | (s',(Rval x :(v list, v) result)) => (s',SOME (Rabort Rtype_error :v error_result)) | (s',(Rerr e :(v list, v) result)) => (s',SOME e)) ∧ (∀(s :(γ, 'ffi) state). (evaluate_decs s ([] :exp list) :(γ, 'ffi) state # v error_result option) = (s,(NONE :v error_result option))) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list) (d :exp). (evaluate_decs s (d::ds) :(γ, 'ffi) state # v error_result option) = case evaluate_dec s d of (s',(NONE :v error_result option)) => (evaluate_decs s' ds :(γ, 'ffi) state # v error_result option) | (s',SOME e) => (s',SOME e)
