length_flatten_eq_size_of_shape_typed=∀(v :α v). is_wf_shape_nil (shape_of v) ⇒ LENGTH (flatten v) = size_of_shape (shape_of v)
functions_append_typed=functions ((prog1 :α decl list) ++ (prog2 :α decl list)) = functions prog1 ++ functions prog2
functions_eq_FILTER_typed=functions (prog :α decl list) = MAP (λ(x :α decl). case x of Function fi => (fi.name,fi.params,fi.body,fi.return) | Decl v9 v10 v11 => (ARB :mlstring # (mlstring # shape) list # α prog # shape) | (ExnDecl v12 v13 :α decl) => (ARB :mlstring # (mlstring # shape) list # α prog # shape) | (Name v14 v15 :α decl) => (ARB :mlstring # (mlstring # shape) list # α prog # shape)) (FILTER (is_function :α decl -> bool) prog)
