mem_load_some_shape_eq_typed=∀(sh :shape) (adr :α word) (dm :α word -> bool) (m :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α v). mem_load sh adr dm m stcs = SOME v ⇒ shape_of v = sh
nameless_exp_real_def_typed=(nameless_exp :α exp -> bool) = every_exp (λ(e :α exp). case e of (Const v24 :α exp) => T | (Var v25 v26 :α exp) => T | RStruct v27 => T | RField v28 v29 => T | NStruct v30 v31 => F | NField v32 v33 => F | (Load v34 v35 :α exp) => T | (Load32 v36 :α exp) => T | LoadByte v37 => T | Op v38 v39 => T | Panop v40 v41 => T | Cmp v42 v43 v44 => T | (Shift v45 v46 v47 :α exp) => T | (BaseAddr :α exp) => T | (TopAddr :α exp) => T | (BytesInWord :α exp) => T)
pan_primop_is_wf_shape_v_typed=∀(sctxt :(mlstring # α) list) (pop :primop) (args :β v list) (value :β v). pan_primop pop args = SOME value ⇒ is_wf_shape_v sctxt value
shape_of_val_typed=shape_of (Val (x :α word_lab)) = One
size_of_sh_with_ctxt_eq_typed=∀(sh :shape) (sctxt :(mlstring # struct_info) list). is_wf_shape_nil sh ⇒ size_of_sh_with_ctxt sctxt sh = size_of_shape sh
eval_empty_locals_IMP_typed=∀(s :(α, β) state) (e :α exp) (v :α v). eval (s with locals := (FEMPTY :mlstring |-> α v)) e = SOME v ⇒ eval s e = SOME v
eval_fresh_var_typed=∀(s :(α, β) state) (e :α exp) (n :mlstring) (w :α v). ¬MEM n (var_exp e) ⇒ eval (s with locals := s.locals⟨n ↦ w⟩) e = eval s e
eval_upd_clock_eq_typed=∀(t :(α, β) state) (e :α exp) (ck :num). eval (t with clock := ck) e = eval t e
eval_upd_code_eq_typed=∀(t :(α, β) state) (e :α exp) (code :mlstring |-> (mlstring # shape) list # α prog # shape). eval (t with code := code) e = eval t e
eval_upd_eshapes_eq_typed=∀(t :(α, β) state) (e :α exp) (esh :mlstring |-> shape). eval (t with eshapes := esh) e = eval t e
eval_is_wf_shape_v_typed=∀(s :(α, β) state) (exp :α exp) (v :α v). eval s exp = SOME v ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ⇒ is_wf_shape_v s.structs v
eval_swap_memaddrs_typed=∀(s :(α, β) state) (exp :α exp) (v :α v) (memaddrs :α word -> bool). eval s exp = SOME v ∧ s.memaddrs ⊆ memaddrs ⇒ eval (s with memaddrs := memaddrs) exp = SOME v
eval_swap_memory_typed=∀(s :(α, β) state) (exp :α exp) (v :α v) (mry :α word -> α word_lab). eval s exp = SOME v ∧ (∀(addr :α word). addr ∈ s.memaddrs ⇒ s.memory addr = mry addr) ⇒ eval (s with memory := mry) exp = SOME v
evaluate_clock_sub_typed=∀(p :α prog) (t :(α, β) state) (res :α result option) (st :(α, β) state) (ck :num). evaluate (p,t) = (res,st with clock := st.clock + ck) ∧ res ≠ SOME (TimeOut :α result) ⇒ evaluate (p,t with clock := t.clock − ck) = (res,st)
evaluate_decls_append_typed=∀(s :(α, β) state) (ds1 :α decl list) (ds2 :α decl list). evaluate_decls s (ds1 ++ ds2) = case evaluate_decls s ds1 of (NONE :(α, β) state option) => (NONE :(α, β) state option) | SOME s' => evaluate_decls s' ds2
evaluate_decl_commute_typed=evaluate_decls (s :(α, β) state) (Function (fi :α fun_decl)::Decl (sh :shape) (v' :mlstring) (e :α exp)::(ds :α decl list)) = evaluate_decls s (Decl sh v' e::Function fi::ds)
evaluate_decls_eshapes_typed=∀(s :(α, β) state) (ds :α decl list) (s' :(α, β) state). evaluate_decls s ds = SOME s' ⇒ s'.eshapes = s.eshapes |++ exceptions ds
evaluate_decls_exns_wf_typed=∀(s :(α, β) state) (ds :α decl list) (s' :(α, β) state). evaluate_decls s ds = SOME s' ⇒ ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) (exceptions ds)) ∧ EVERY (λ((eid :mlstring),(sh :shape)). FLOOKUP s.eshapes eid = (NONE :shape option)) (exceptions ds) ∧ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) (exceptions ds)
evaluate_decls_functions_typed=∀(s :(α, β) state) (pan_code :α decl list) (s' :(α, β) state). evaluate_decls s pan_code = SOME s' ⇒ s'.code = s.code |++ functions pan_code
evaluate_decls_memaddrs_mono_typed=∀(s :(α, β) state) (prog :α decl list) (s' :(α, β) state) (memaddrs :α word -> bool). evaluate_decls s prog = SOME s' ∧ s.memaddrs ⊆ memaddrs ⇒ evaluate_decls (s with memaddrs := memaddrs) prog = SOME (s' with memaddrs := memaddrs)
evaluate_decls_names_typed=∀(s :(α, β) state) (decs :α decl list). EVERY (is_name :α decl -> bool) decs ⇒ evaluate_decls s decs = SOME s
evaluate_decls_only_exn_decls_typed=∀(s :(α, β) state) (ds :α decl list) (s' :(α, β) state). EVERY (is_exn_decl :α decl -> bool) ds ∧ evaluate_decls s ds = SOME s' ⇒ s' = s with eshapes := s.eshapes |++ exceptions ds
evaluate_decls_only_functions_typed=∀(s :(α, β) state) (pan_code :α decl list) (s' :(α, β) state). EVERY (is_function :α decl -> bool) pan_code ∧ evaluate_decls s pan_code = SOME s' ⇒ s' = s with code := s.code |++ functions pan_code
evaluate_decls_only_funs_and_exn_decls_typed=∀(s :(α, β) state) (ds :α decl list) (s' :(α, β) state). EVERY (λ(d :α decl). is_function d ∨ is_exn_decl d) ds ∧ evaluate_decls s ds = SOME s' ⇒ s' = s with <|code := s.code |++ functions ds; eshapes := s.eshapes |++ exceptions ds|>
evaluate_decls_swap_locals_typed=∀(s :(α, β) state) (prog :α decl list) (s' :(α, β) state) (locals :mlstring |-> α v). evaluate_decls s prog = SOME s' ⇒ evaluate_decls (s with locals := locals) prog = SOME (s' with locals := locals)
evaluate_decls_swap_memaddrs_typed=∀(s :(α, β) state) (prog :α decl list) (s' :(α, β) state) (memaddrs :α word -> bool). evaluate_decls s prog = SOME s' ∧ s.memaddrs ⊆ memaddrs ⇒ evaluate_decls (s with memaddrs := memaddrs) prog = SOME (s' with memaddrs := memaddrs)
evaluate_decls_swap_memory_typed=∀(s :(α, β) state) (prog :α decl list) (s' :(α, β) state) (mry :α word -> α word_lab). evaluate_decls s prog = SOME s' ∧ (∀(addr :α word). addr ∈ s.memaddrs ⇒ s.memory addr = mry addr) ⇒ evaluate_decls (s with memory := mry) prog = SOME (s' with memory := mry)
evaluate_invariants_typed=∀(p :α prog) (t :(α, β) state) (res :α result option) (st :(α, β) state). evaluate (p,t) = (res,st) ⇒ st.memaddrs = t.memaddrs ∧ st.sh_memaddrs = t.sh_memaddrs ∧ (st.be ⇔ t.be) ∧ st.eshapes = t.eshapes ∧ st.base_addr = t.base_addr ∧ st.structs = t.structs ∧ st.code = t.code ∧ st.ffi.oracle = t.ffi.oracle
exns_wf_evaluate_decls_typed=∀(s :(α, β) state) (ds :α decl list) (s' :γ). EVERY (is_exn_decl :α decl -> bool) ds ∧ ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) (exceptions ds)) ∧ EVERY (λ((eid :mlstring),(sh :shape)). FLOOKUP s.eshapes eid = (NONE :shape option)) (exceptions ds) ∧ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) (exceptions ds) ⇒ evaluate_decls s ds = SOME (s with eshapes := s.eshapes |++ exceptions ds)
io_events_eq_imp_ffi_eq_typed=evaluate ((p :α prog),(s :(α, β) state)) = ((res :α result option),(t :(α, β) state)) ∧ s.ffi.io_events = t.ffi.io_events ⇒ t.ffi = s.ffi
lookup_code_wf_shape_invariant_step_typed=OPT_MMAP (eval (s :(α, β) state)) (argexps :α exp list) = SOME (args :α v list) ∧ lookup_code s.code (fname :mlstring) args = SOME ((prog :α prog),(newlocals :mlstring |-> α v),(return_sh :shape)) ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ⇒ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) newlocals
opt_mmap_eval_upd_clock_eq_typed=∀(es :α exp list) (s :(α, β) state) (ck :num). OPT_MMAP (eval (s with clock := ck + s.clock)) es = OPT_MMAP (eval s) es
OPT_MMAP_update_locals_not_vars_eval_eq_typed=∀(s :(α, β) state) (es :α exp list) (vs :α v list) (n :mlstring) (w :α v). ¬MEM n (FLAT (MAP (var_exp :α exp -> mlstring list) es)) ∧ OPT_MMAP (eval s) es = SOME vs ⇒ OPT_MMAP (eval (s with locals := s.locals⟨n ↦ w⟩)) es = SOME vs
update_locals_not_vars_eval_eq_eq_typed=∀(s :(α, β) state) (e :α exp) (v :γ) (n :mlstring) (w :α v). ¬MEM n (var_exp e) ⇒ eval (s with locals := s.locals⟨n ↦ w⟩) e = eval s e
update_locals_not_vars_eval_eq_typed=∀(s :(α, β) state) (e :α exp) (v :α v) (n :mlstring) (w :α v). ¬MEM n (var_exp e) ∧ eval s e = SOME v ⇒ eval (s with locals := s.locals⟨n ↦ w⟩) e = SOME v
update_locals_not_vars_eval_eq_NONE_typed=∀(s :(α, β) state) (e :α exp) (v :γ) (n :mlstring) (w :α v). ¬MEM n (var_exp e) ∧ eval s e = (NONE :α v option) ⇒ eval (s with locals := s.locals⟨n ↦ w⟩) e = (NONE :α v option)
evaluate_add_clock_eq_typed=∀(p :α prog) (t :(α, β) state) (res :α result option) (st :(α, β) state) (ck :num). evaluate (p,t) = (res,st) ∧ res ≠ SOME (TimeOut :α result) ⇒ evaluate (p,t with clock := t.clock + ck) = (res,st with clock := st.clock + ck)
evaluate_add_clock_io_events_mono_typed=∀(exps :α prog) (s :(α, β) state) (extra :num). (SND (evaluate (exps,s))).ffi.io_events ≼ (SND (evaluate (exps,s with clock := s.clock + extra))).ffi.io_events
evaluate_clock_sub1_typed=∀(p :α prog) (t :(α, β) state) (res :α result option) (st :(α, β) state) (t' :(α, β) state) (ck :num). evaluate (p,t) = (res,st) ∧ res ≠ SOME (TimeOut :α result) ∧ evaluate (p,t with clock := ck + t.clock) = evaluate (p,t') ⇒ evaluate (p,t) = evaluate (p,t' with clock := t'.clock − ck)
evaluate_min_clock_typed=evaluate ((prog :α prog),(s :(α, β) state)) = ((q :α result option),(r :(α, β) state)) ∧ q ≠ SOME (TimeOut :α result) ⇒ ∃(k :num). evaluate (prog,s with clock := k) = (q,r with clock := (0 :num))
evaluate_is_wf_shape_invariant_typed=∀(p :α prog) (s :(α, β) state) (res :α result option) (s' :(α, β) state). evaluate (p,s) = (res,s') ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.globals ⇒ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s'.structs v) s'.locals ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s'.structs v) s'.globals ∧ case res of (NONE :α result option) => T | SOME (Error :α result) => T | SOME (TimeOut :α result) => T | SOME (Break :α result) => T | SOME (Continue :α result) => T | SOME (Return retv :α result) => is_wf_shape_v s.structs retv | SOME (Exception eid exn) => is_wf_shape_v s.structs exn | SOME (FinalFFI v9 :α result) => T
list_rel_length_shape_of_flatten_typed=∀(vshs :(α # shape) list) (args :β v list). LIST_REL (λ(vsh :α # shape) (arg :β v). SND vsh = shape_of arg) vshs args ∧ EVERY is_wf_shape_v_nil args ⇒ size_of_shape (Comb (MAP (SND :α # shape -> shape) vshs)) = LENGTH (FLAT (MAP (flatten :β v -> β word_lab list) args))
localised_exp_simps_typed=localised_exp (Const (c :α word) :α exp) ∧ (localised_exp (Var (v :varkind) (m :mlstring) :α exp) ⇔ v = Local) ∧ (localised_exp (RStruct (l :α exp list)) ⇔ EVERY (localised_exp :α exp -> bool) l) ∧ (localised_exp (RField (n :num) (e :α exp)) ⇔ localised_exp e) ∧ (localised_exp (NStruct m (l :(mlstring # α exp) list)) ⇔ EVERY (localised_exp :α exp -> bool) (MAP (SND :mlstring # α exp -> α exp) l)) ∧ (localised_exp (NField m e) ⇔ localised_exp e) ∧ (localised_exp (Load (s :shape) e :α exp) ⇔ localised_exp e) ∧ (localised_exp (Load32 e :α exp) ⇔ localised_exp e) ∧ (localised_exp (LoadByte e) ⇔ localised_exp e) ∧ (localised_exp (Op (b :binop) l) ⇔ EVERY (localised_exp :α exp -> bool) l) ∧ (localised_exp (Panop (p :panop) l) ⇔ EVERY (localised_exp :α exp -> bool) l) ∧ (localised_exp (Cmp (c :cmp) e (e0 :α exp)) ⇔ localised_exp e ∧ localised_exp e0) ∧ (localised_exp (Shift (s :ast$shift) e e0 :α exp) ⇔ localised_exp e ∧ localised_exp e0) ∧ localised_exp (BaseAddr :α exp) ∧ localised_exp (TopAddr :α exp) ∧ localised_exp (BytesInWord :α exp)
nameless_exp_simps_typed=nameless_exp (Const (c :α word) :α exp) ∧ nameless_exp (Var (v :varkind) (m :mlstring) :α exp) ∧ (nameless_exp (RStruct (l :α exp list)) ⇔ EVERY (nameless_exp :α exp -> bool) l) ∧ (nameless_exp (RField (n :num) (e :α exp)) ⇔ nameless_exp e) ∧ ¬nameless_exp (NStruct m (l :(mlstring # α exp) list)) ∧ ¬nameless_exp (NField m e) ∧ (nameless_exp (Load (s :shape) e :α exp) ⇔ nameless_exp e) ∧ (nameless_exp (Load32 e :α exp) ⇔ nameless_exp e) ∧ (nameless_exp (LoadByte e) ⇔ nameless_exp e) ∧ (nameless_exp (Op (b :binop) l) ⇔ EVERY (nameless_exp :α exp -> bool) l) ∧ (nameless_exp (Panop (p :panop) l) ⇔ EVERY (nameless_exp :α exp -> bool) l) ∧ (nameless_exp (Cmp (c :cmp) e (e0 :α exp)) ⇔ nameless_exp e ∧ nameless_exp e0) ∧ (nameless_exp (Shift (s :ast$shift) e e0 :α exp) ⇔ nameless_exp e ∧ nameless_exp e0) ∧ nameless_exp (BaseAddr :α exp) ∧ nameless_exp (TopAddr :α exp) ∧ nameless_exp (BytesInWord :α exp)
pan_sem_is_wrapper_typed=semantics (s :(α, β) state) (start :mlstring) = (let (prog :α prog) = TailCall start ([] :α exp list) in semantics_wrapper (((λ(res :α result option). case res of (NONE :α result option) => (RunError :outcome semantics_run_res) | SOME (Error :α result) => (RunError :outcome semantics_run_res) | SOME (TimeOut :α result) => (Incomplete :outcome semantics_run_res) | SOME (Break :α result) => (RunError :outcome semantics_run_res) | SOME (Continue :α result) => (RunError :outcome semantics_run_res) | SOME (Return v6 :α result) => CompleteResult Success | SOME (Exception v7 v8) => (RunError :outcome semantics_run_res) | SOME (FinalFFI e :α result) => CompleteResult (FFI_outcome e)) ## (λ(s :(α, β) state). s.ffi.io_events)) ∘ (λ(k :num). evaluate (prog,s with clock := k))))
FLOOKUP_pan_res_var_thm_typed=FLOOKUP (res_var (l :β |-> α) ((m :β),(v :α option))) (n :β) = if n = m then v else FLOOKUP l n
flookup_res_var_diff_eq_org_typed=(n :α) ≠ (m :α) ⇒ FLOOKUP (res_var (lc :α |-> β) (n,(v :β option))) m = FLOOKUP lc m
flookup_res_var_some_eq_lookup_typed=FLOOKUP (res_var (lc :β |-> α) ((v :β),FLOOKUP (lc' :β |-> α) v)) v = SOME (value :α) ⇒ FLOOKUP lc' v = SOME value
length_with_shape_eq_shape_typed=∀(sh :shape list) (ns :α list). LENGTH ns = size_of_shape (Comb sh) ⇒ LENGTH sh = LENGTH (with_shape sh ns)
all_distinct_with_shape_typed=∀(sh :shape list) (ns :α list) (n :num). ALL_DISTINCT ns ∧ n < LENGTH sh ∧ LENGTH ns = size_of_shape (Comb sh) ⇒ ALL_DISTINCT (with_shape sh ns)❲n❳
el_mem_with_shape_typed=∀(sh :shape list) (ns :α list) (n :num) (x :α). n < LENGTH (with_shape sh ns) ∧ LENGTH ns = size_of_shape (Comb sh) ∧ MEM x (with_shape sh ns)❲n❳ ⇒ MEM x ns
mem_with_shape_length_typed=∀(sh :shape list) (ns :α list) (n :num). LENGTH ns = size_of_shape (Comb sh) ∧ n < LENGTH sh ⇒ MEM (with_shape sh ns)❲n❳ (with_shape sh ns)
with_shape_el_take_drop_eq_typed=∀(sh :shape list) (ns :α list) (n :num). LENGTH ns = size_of_shape (Comb sh) ∧ n < LENGTH sh ⇒ (with_shape sh ns)❲n❳ = TAKE (size_of_shape sh❲n❳) (DROP (size_of_shape (Comb (TAKE n sh))) ns)
all_distinct_with_shape_distinct_typed=∀(sh :shape list) (ns :α list) (x :α list) (y :α list). ALL_DISTINCT ns ∧ LENGTH ns = size_of_shape (Comb sh) ∧ MEM x (with_shape sh ns) ∧ MEM y (with_shape sh ns) ∧ x ≠ y ∧ x ≠ ([] :α list) ∧ y ≠ ([] :α list) ⇒ DISJOINT (set x) (set y)
all_distinct_disjoint_with_shape_typed=∀(sh :shape list) (ns :α list) (n :num) (n' :num). ALL_DISTINCT ns ∧ n < LENGTH sh ∧ n' < LENGTH sh ∧ n ≠ n' ∧ LENGTH ns = size_of_shape (Comb sh) ⇒ DISJOINT (set (with_shape sh ns)❲n❳) (set (with_shape sh ns)❲n'❳)
all_distinct_mem_zip_disjoint_with_shape_typed=LENGTH (l :α list) = LENGTH (sh :shape list) ∧ LENGTH sh = LENGTH (with_shape sh (ns :β list)) ∧ ALL_DISTINCT ns ∧ LENGTH ns = size_of_shape (Comb sh) ∧ MEM ((x :α),(a :shape),(xs :β list)) (ZIP (l,ZIP (sh,with_shape sh ns))) ∧ MEM ((y :α),(b :shape),(ys :β list)) (ZIP (l,ZIP (sh,with_shape sh ns))) ∧ x ≠ y ⇒ DISJOINT (set xs) (set ys)
el_el_with_shape_typed=LENGTH (xs :α list) = size_of_shape (Comb (shs :shape list)) ∧ (n :num) < LENGTH shs ∧ (n' :num) < size_of_shape shs❲n❳ ∧ EVERY is_wf_shape_nil shs ⇒ (with_shape shs xs)❲n❳❲n'❳ = xs❲n' + size_of_shape (Comb (TAKE n shs))❳
list_rel_flatten_with_shape_length_typed=∀(sh :shape list) (ns :α list) (args :β v list) (v :β v) (n :num). LENGTH ns = LENGTH (FLAT (MAP (flatten :β v -> β word_lab list) args)) ∧ size_of_shape (Comb sh) = LENGTH (FLAT (MAP (flatten :β v -> β word_lab list) args)) ∧ args❲n❳ = v ∧ n < LENGTH args ∧ LENGTH args = LENGTH sh ∧ LIST_REL (λ(sh :shape) (arg :β v). sh = shape_of arg) sh args ∧ EVERY is_wf_shape_v_nil args ⇒ LENGTH (with_shape sh ns)❲n❳ = LENGTH (flatten v)
list_rel_flatten_with_shape_flookup_typed=∀(sh :shape list) (ns :α list) (args :β v list) (v :β v) (n :num) (n' :num). ALL_DISTINCT ns ∧ LENGTH ns = LENGTH (FLAT (MAP (flatten :β v -> β word_lab list) args)) ∧ size_of_shape (Comb sh) = LENGTH (FLAT (MAP (flatten :β v -> β word_lab list) args)) ∧ args❲n❳ = v ∧ n < LENGTH args ∧ LENGTH args = LENGTH sh ∧ LIST_REL (λ(sh :shape) (arg :β v). sh = shape_of arg) sh args ∧ EVERY is_wf_shape_v_nil args ∧ LENGTH (with_shape sh ns)❲n❳ = LENGTH (flatten v) ∧ n' < LENGTH (with_shape sh ns)❲n❳ ⇒ FLOOKUP ((FEMPTY :α |-> β word_lab) |++ ZIP (ns,FLAT (MAP (flatten :β v -> β word_lab list) args))) (with_shape sh ns)❲n❳❲n'❳ = SOME (flatten v)❲n'❳
semantics_wrapper_def_typed=∀(f :num -> outcome semantics_run_res # io_event list). semantics_wrapper f = if ∃(k :num) (v :io_event list). f k = ((RunError :outcome semantics_run_res),v) then Fail else case some(res :behaviour). ∃(k :num) (r :outcome) (ev :io_event list). f k = (CompleteResult r,ev) ∧ res = Terminate r ev of (NONE :behaviour option) => Diverge (LUB (IMAGE ((fromList :io_event list -> io_event llist) ∘ (SND :outcome semantics_run_res # io_event list -> io_event list) ∘ f) 𝕌(:num))) | SOME res => res
semantics_wrapper_eq_typed=semantics_wrapper (absf :num -> outcome semantics_run_res # io_event list) ≠ Fail ⇒ (∀(k :num) (r :outcome semantics_run_res) (ev :io_event list). absf k = (r,ev) ∧ r ≠ (RunError :outcome semantics_run_res) ⇒ ∃(k' :num). (concf :num -> outcome semantics_run_res # io_event list) (k + k') = (r,ev)) ⇒ (∀(k :num) (k' :num) (r :outcome semantics_run_res) (ev :io_event list). concf k = (r,ev) ⇒ r ≠ (Incomplete :outcome semantics_run_res) ⇒ concf (k + k') = (r,ev)) ⇒ (∀(k :num) (k' :num) (r :outcome semantics_run_res) (ev :io_event list). absf k = (r,ev) ⇒ r ≠ (Incomplete :outcome semantics_run_res) ⇒ absf (k + k') = (r,ev)) ⇒ (∀(k :num) (k' :num) (ev :io_event list). absf (k + k') = ((Incomplete :outcome semantics_run_res),ev) ⇒ ∃(r' :outcome semantics_run_res) (ev' :io_event list). absf k = (r',ev') ∧ ev' ≼ ev) ⇒ (∀(k :num) (k' :num) (ev :io_event list). concf (k + k') = ((Incomplete :outcome semantics_run_res),ev) ⇒ ∃(r' :outcome semantics_run_res) (ev' :io_event list). concf k = (r',ev') ∧ ev' ≼ ev) ⇒ semantics_wrapper concf = semantics_wrapper absf
evaluate_add_clock_or_timeout_typed=evaluate ((p :α prog),(s :(α, β) state)) = ((q :α result option),(t :(α, β) state) with clock := (0 :num)) ∧ q ≠ SOME (TimeOut :α result) ⇒ evaluate (p,s with clock := (k :num)) = ((q' :α result option),(t' :(α, β) state)) ⇒ q' = SOME (TimeOut :α result) ∧ k < s.clock ∨ q' = q ∧ s.clock ≤ k ∧ t' = t with clock := k − s.clock
evaluate_io_events_mono_typed=∀(exps :α prog) (s1 :(α, β) state) (res :α result option) (s2 :(α, β) state). evaluate (exps,s1) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_global_shape_invariant_typed=∀(p :α prog) (s :(α, β) state) (res :α result option) (st :(α, β) state) (n :mlstring) (v :α v). evaluate (p,s) = (res,st) ∧ FLOOKUP s.globals n = SOME v ⇒ ∃(v' :α v). FLOOKUP st.globals n = SOME v' ∧ shape_of v' = shape_of v
