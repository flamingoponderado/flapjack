is_wf_shape_of_v_typed=∀(sctxt :(mlstring # α) list) (v :β v). is_wf_shape_v sctxt v ⇒ is_wf_shape sctxt (shape_of v)
localised_exp_real_def_typed=(localised_exp :α exp -> bool) = every_exp (λ(e :α exp). case e of (Const v24 :α exp) => T | (Var tp v26 :α exp) => tp = Local | RStruct v27 => T | RField v28 v29 => T | NStruct v30 v31 => T | NField v32 v33 => T | (Load v34 v35 :α exp) => T | (Load32 v36 :α exp) => T | LoadByte v37 => T | Op v38 v39 => T | Panop v40 v41 => T | Cmp v42 v43 v44 => T | (Shift v45 v46 v47 :α exp) => T | (BaseAddr :α exp) => T | (TopAddr :α exp) => T | (BytesInWord :α exp) => T)
localised_prog_def_typed=(∀(v0 :mlstring) (e :α exp). localised_prog (Raise v0 e :α prog) ⇔ localised_exp e) ∧ (∀(v2 :shape) (v1 :mlstring) (p :α prog) (e :α exp). localised_prog (Dec v1 v2 e p) ⇔ localised_exp e ∧ localised_prog p) ∧ (∀(q :α prog) (p :α prog). localised_prog (Seq p q) ⇔ localised_prog p ∧ localised_prog q) ∧ (∀(q :α prog) (p :α prog) (e :α exp). localised_prog (If e p q :α prog) ⇔ localised_exp e ∧ localised_prog p ∧ localised_prog q) ∧ (∀(p :α prog) (e :α exp). localised_prog (While e p :α prog) ⇔ localised_exp e ∧ localised_prog p) ∧ (∀(e2 :α exp) (e1 :α exp). localised_prog (Store e1 e2 :α prog) ⇔ localised_exp e1 ∧ localised_exp e2) ∧ (∀(e2 :α exp) (e1 :α exp). localised_prog (Store32 e1 e2 :α prog) ⇔ localised_exp e1 ∧ localised_exp e2) ∧ (∀(e2 :α exp) (e1 :α exp). localised_prog (StoreByte e1 e2) ⇔ localised_exp e1 ∧ localised_exp e2) ∧ (∀(fn :mlstring) (e4 :α exp) (e3 :α exp) (e2 :α exp) (e1 :α exp). localised_prog (ExtCall fn e1 e2 e3 e4 :α prog) ⇔ localised_exp e1 ∧ localised_exp e2 ∧ localised_exp e3 ∧ localised_exp e4) ∧ (∀(e :α exp). localised_prog (Return e :α prog) ⇔ localised_exp e) ∧ (∀(op :opsize) (e2 :α exp) (e1 :α exp). localised_prog (ShMemStore op e1 e2) ⇔ localised_exp e1 ∧ localised_exp e2) ∧ (∀(vk :varkind) (v :mlstring) (op :opsize) (e :α exp). localised_prog (ShMemLoad op vk v e) ⇔ vk = Local ∧ localised_exp e) ∧ (∀(hdl :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) (f :mlstring) (args :α exp list). localised_prog (Call hdl f args :α prog) ⇔ EVERY (localised_exp :α exp -> bool) args ∧ (case hdl of (NONE :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) => T | SOME (v4,(NONE :(mlstring # mlstring # α prog) option)) => T | SOME (v4,SOME (v10,v14,p)) => localised_prog p) ∧ case hdl of (NONE :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) => T | SOME ((NONE :(varkind # mlstring) option),v5) => T | SOME (SOME (Local,v11),v5) => T | SOME (SOME (Global,v11),v5) => F) ∧ (∀(vn :mlstring) (sh :shape) (p :α prog) (fn :mlstring) (args :α exp list). localised_prog (DecCall vn sh fn args p) ⇔ EVERY (localised_exp :α exp -> bool) args ∧ localised_prog p) ∧ (∀(v3 :mlstring) (e :α exp). localised_prog (Assign Local v3 e :α prog) ⇔ localised_exp e) ∧ (∀(v5 :α exp) (v4 :mlstring). localised_prog (Assign Global v4 v5 :α prog) ⇔ F) ∧ (∀(v7 :primop) (v6 :mlstring) (es :α exp list). localised_prog (Primitive v6 v7 es) ⇔ EVERY (localised_exp :α exp -> bool) es) ∧ (localised_prog (Skip :α prog) ⇔ T) ∧ (localised_prog (Break :α prog) ⇔ T) ∧ (localised_prog (Continue :α prog) ⇔ T) ∧ (localised_prog (Tick :α prog) ⇔ T) ∧ ∀(v59 :mlstring) (v58 :mlstring). localised_prog (Annot v58 v59 :α prog) ⇔ T
