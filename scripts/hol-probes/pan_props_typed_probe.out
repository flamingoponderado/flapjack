mem_load_swap_memory_typed=(∀(sh :shape) (addr :α word) (addrs :α word -> bool) (memory1 :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α v) (memory2 :α word -> α word_lab). mem_load sh addr addrs memory1 stcs = SOME v ∧ (∀(addr :α word). addr ∈ addrs ⇒ memory1 addr = memory2 addr) ⇒ mem_load sh addr addrs memory2 stcs = SOME v) ∧ (∀(shs :shape list) (addr :α word) (addrs :α word -> bool) (memory1 :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α v list) (memory2 :α word -> α word_lab). mem_loads shs addr addrs memory1 stcs = SOME v ∧ (∀(addr :α word). addr ∈ addrs ⇒ memory1 addr = memory2 addr) ⇒ mem_loads shs addr addrs memory2 stcs = SOME v) ∧ ∀(flds :(mlstring # shape) list) (addr :α word) (addrs :α word -> bool) (memory1 :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (vs :(mlstring # α v) list) (memory2 :α word -> α word_lab). mem_load_flds flds addr addrs memory1 stcs = SOME vs ∧ (∀(addr :α word). addr ∈ addrs ⇒ memory1 addr = memory2 addr) ⇒ mem_load_flds flds addr addrs memory2 stcs = SOME vs
