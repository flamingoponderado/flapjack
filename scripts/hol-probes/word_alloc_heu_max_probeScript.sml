load "bossLib";
load "preamble";
load "word_allocTheory";
open bossLib HolKernel Parse preamble word_allocTheory;
fun observe label term = let val th = EVAL term in print (label ^ "="); print_term (rhs (concl th)); print "\n" end;
val _ = observe "hm_tuple" ``heu_max (1,8,3,10,5) (6,2,9,4,7) = (6,8,9,10,7)``;
val _ = observe "hm_tuple_equal" ``heu_max (4,4,4,4,4) (4,4,4,4,4) = (4,4,4,4,4)``;
val _ = observe "hm_tuple_zero" ``heu_max (0,0,0,0,0) (6,2,9,4,7) = (6,2,9,4,7)``;
val _ = observe "hm_tuple_large" ``heu_max (18446744073709551616,0,2,0,4) (0,18446744073709551617,0,3,0) = (18446744073709551616,18446744073709551617,2,3,4)``;
val _ = observe "hm_empty" ``heu_max_all LN LN = LN``;
val _ = observe "hm_left" ``heu_max_all (insert 4 (1,8,3,10,5) LN) LN = (insert 4 (1,8,3,10,5) LN)``;
val _ = observe "hm_right" ``heu_max_all LN (insert 5 (6,2,9,4,7) LN) = (insert 5 (6,2,9,4,7) LN)``;
val _ = observe "hm_overlap" ``heu_max_all (insert 1 (1,8,3,10,5) LN) (insert 1 (6,2,9,4,7) LN) = (insert 1 (6,8,9,10,7) LN)``;
val _ = observe "hm_disjoint" ``heu_max_all (insert 1 (1,8,3,10,5) LN) (insert 2 (6,2,9,4,7) LN) = (insert 1 (1,8,3,10,5) (insert 2 (6,2,9,4,7) LN))``;
val _ = observe "hm_mixed" ``heu_max_all (insert 0 (1,8,3,10,5) (insert 1 (6,2,9,4,7) LN)) (insert 1 (4,4,4,4,4) (insert 2 (6,2,9,4,7) LN)) = (insert 0 (1,8,3,10,5) (insert 1 (6,4,9,4,7) (insert 2 (6,2,9,4,7) LN)))``;
val _ = observe "hm_nested" ``heu_max_all (insert 1 (1,8,3,10,5) (insert 2 (6,2,9,4,7) (insert 5 (4,4,4,4,4) (insert 6 (7,7,7,7,7) LN)))) (insert 1 (7,7,7,7,7) (insert 2 (4,4,4,4,4) (insert 3 (6,2,9,4,7) LN))) = (insert 1 (7,8,7,10,7) (insert 2 (6,4,9,4,7) (insert 3 (6,2,9,4,7) (insert 5 (4,4,4,4,4) (insert 6 (7,7,7,7,7) LN)))))``;
val _ = observe "hm_raw_left_bn" ``heu_max_all (BN LN LN) LN = (BN LN LN)``;
val _ = observe "hm_raw_right_bn" ``heu_max_all LN (BN LN LN) = LN``;
val _ = observe "hm_raw_both_bn" ``heu_max_all (BN LN LN) (BN LN LN) = LN``;
val _ = observe "hm_raw_left_bs" ``heu_max_all (BS LN (1,8,3,10,5) LN) LN = (BS LN (1,8,3,10,5) LN)``;
val _ = observe "hm_raw_right_bs" ``heu_max_all LN (BS LN (6,2,9,4,7) LN) = (LS (6,2,9,4,7))``;
val _ = observe "hm_raw_both_bs" ``heu_max_all (BS LN (1,8,3,10,5) LN) (BS LN (6,2,9,4,7) LN) = (LS (6,8,9,10,7))``;
val _ = observe "hm_raw_bs_leaf" ``heu_max_all (BS LN (1,8,3,10,5) LN) (LS (6,2,9,4,7)) = (BS LN (6,8,9,10,7) LN)``;
val _ = observe "hm_raw_leaf_bs" ``heu_max_all (LS (1,8,3,10,5)) (BS LN (6,2,9,4,7) LN) = (LS (6,8,9,10,7))``;
val _ = observe "hm_raw_empty_leaf" ``heu_max_all (BN LN LN) (LS (6,2,9,4,7)) = (BS LN (6,2,9,4,7) LN)``;
