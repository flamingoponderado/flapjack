MAP_FST_lemma_source_statement_typed=∀(moves :(α # num) list). MAP (FST :α # num -> α) (MAP (λ((a :α),(b :num)). (a,canonicalRegs (data :knowledge) b)) moves) = MAP (FST :α # num -> α) moves
MAP_SND_lemma_source_statement_typed=∀(moves :(α # num) list) (x :β word_loc list). get_vars (MAP (SND :α # num -> num) moves) (s :(β, γ, δ) state) = SOME x ∧ data_inv (data :knowledge) s ⇒ get_vars (MAP (SND :α # num -> num) (MAP (λ((a :α),(b :num)). (a,canonicalRegs data b)) moves)) s = SOME x
get_set_vars_not_in_source_statement_typed=∀(rs :num list) (vs :α word_loc list) (r :num) (s :(α, β, γ) state). ¬MEM r rs ⇒ get_var r (set_vars rs vs s) = get_var r s
get_set_vars_in_source_statement_typed=∀(moves :(num # num) list) (r :num) (p_2 :num) (x :α word_loc list) (s :(α, β, γ) state). MEM (r,p_2) moves ⇒ ALL_DISTINCT (MAP (FST :num # num -> num) moves) ⇒ get_vars (MAP (SND :num # num -> num) moves) s = SOME x ⇒ get_var r (set_vars (MAP (FST :num # num -> num) moves) x s) = get_var p_2 s
get_set_vars_in_2_source_statement_typed=∀(moves :(num # num) list) (r :num) (p_2 :num) (x' :num) (x :α word_loc list) (data :knowledge) (s :(α, β, γ) state). MEM (r,p_2) moves ⇒ ALL_DISTINCT (MAP (FST :num # num -> num) moves) ⇒ (lookup p_2 data.to_canonical :num option) = SOME x' ⇒ get_vars (MAP (SND :num # num -> num) (MAP (λ((a :num),(b :num)). (a,canonicalRegs data b)) moves)) s = SOME x ⇒ get_var r (set_vars (MAP (FST :num # num -> num) moves) x s) = get_var x' s
lookup_set_vars_not_in_source_statement_typed=∀(moves :(num # α) list) (v :num) (data :β) (c :γ word) (x :γ word_loc list). ¬MEM v (MAP (FST :num # α -> num) moves) ⇒ (lookup v (s :(γ, δ, ε) state).locals :γ word_loc option) = SOME (Word c) ⇒ (lookup v (set_vars (MAP (FST :num # α -> num) moves) x s).locals :γ word_loc option) = SOME (Word c)
list_insert_insert_source_statement_typed=∀(l :num list) (n :num) (an :sptree$num_set). list_insert l (insert n () an :sptree$num_set) = (insert n () (list_insert l an) :sptree$num_set)
data_inv_insert_canonical_pair_source_statement_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num) (tc :num sptree$num_map) (tl :num sptree$num_map). data_inv (data with <|to_canonical := tc; to_latest := tl|>) s ∧ (lookup x tc :num option) = (NONE :num option) ∧ (lookup y (insert x y tc :num sptree$num_map) :num option) = SOME y ∧ ODD x ∧ ODD y ∧ get_var x s = get_var y s ⇒ data_inv (data with <|to_canonical := (insert x y tc :num sptree$num_map); to_latest := tl|>) s
data_inv_insert_pair_source_statement_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num) (tc :num sptree$num_map) (tl :num sptree$num_map). data_inv (data with <|to_canonical := tc; to_latest := tl|>) s ∧ (lookup x tc :num option) = (NONE :num option) ∧ (lookup y tc :num option) = SOME y ∧ ODD x ∧ ODD y ∧ get_var x s = get_var y s ⇒ data_inv (data with <|to_canonical := (insert x y tc :num sptree$num_map); to_latest := (insert y x tl :num sptree$num_map)|>) s
data_inv_move_pairs_source_statement_typed=∀(ps :(num # num) list) (data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ∧ ALL_DISTINCT (MAP (FST :num # num -> num) ps) ∧ EVERY (λ((x :num),(y :num)). (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y data.to_canonical :num option) = SOME y ∧ ODD x ∧ get_var x s = get_var y s) ps ⇒ data_inv (data with <|to_canonical := map_insert ps data.to_canonical; to_latest := map_insert (MAP (λ((a :num),(b :num)). (b,a)) ps) data.to_latest|>) s
if_eq_rw_source_statement_typed=(if (x :α) = (y :α) then y else x) = x
evaluate_arith_clock_source_statement_typed=∀(a :α arith) (w :α word_loc) (s :(α, β, γ) state) (c :num) (td :num). can_mem_arith a ⇒ (evaluate ((Inst (Arith a :α inst) :α prog),s with <|clock := c; termdep := td|>) = ((NONE :α result option),set_var (firstRegOfArith a) w s with <|clock := c; termdep := td|>) ⇔ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s))
evaluate_load_clock_source_statement_typed=∀(op :memop) (r :num) (a :num) (ofs :α word) (w :α word_loc) (s :(α, β, γ) state) (c :num) (td :num). ¬is_store op ⇒ (evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s with <|clock := c; termdep := td|>) = ((NONE :α result option),set_var r w s with <|clock := c; termdep := td|>) ⇔ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s))
