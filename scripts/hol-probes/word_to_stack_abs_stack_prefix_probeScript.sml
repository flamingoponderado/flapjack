load "bossLib"; load "preamble"; load "word_to_stackProofTheory";
open HolKernel Parse bossLib preamble word_to_stackProofTheory;
fun print_eval label q = (print(label ^ "="); print_term(rconc(EVAL q)); print "\n");
val _ = print_eval "ap_base" ``(abs_stack ([3w]:8 word list) ([]:8 wordSem$stack_frame list) [wordLang$Word 0w] [] <> NONE) /\ (abs_stack (([3w]:8 word list) ++ [13w;3w]) ([]:8 wordSem$stack_frame list) [wordLang$Word 0w] [] = abs_stack ([3w]:8 word list) ([]:8 wordSem$stack_frame list) [wordLang$Word 0w] [])``;
val _ = print_eval "ap_plain" ``(abs_stack ([3w]:8 word list) [wordSem$StackFrame NONE [] [] NONE :8 wordSem$stack_frame] [wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 0w] [1] <> NONE) /\ (abs_stack (([3w]:8 word list) ++ [13w;3w]) [wordSem$StackFrame NONE [] [] NONE :8 wordSem$stack_frame] [wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 0w] [1] = abs_stack ([3w]:8 word list) [wordSem$StackFrame NONE [] [] NONE :8 wordSem$stack_frame] [wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 0w] [1])``;
val _ = print_eval "ap_handler" ``(abs_stack ([3w]:8 word list) [wordSem$StackFrame NONE [] [] (SOME(0,1,2)) :8 wordSem$stack_frame] [wordLang$Word 1w;wordLang$Loc 1 2;wordLang$Word 6w;wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 0w] [1] <> NONE) /\ (abs_stack (([3w]:8 word list) ++ [13w;3w]) [wordSem$StackFrame NONE [] [] (SOME(0,1,2)) :8 wordSem$stack_frame] [wordLang$Word 1w;wordLang$Loc 1 2;wordLang$Word 6w;wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 0w] [1] = abs_stack ([3w]:8 word list) [wordSem$StackFrame NONE [] [] (SOME(0,1,2)) :8 wordSem$stack_frame] [wordLang$Word 1w;wordLang$Loc 1 2;wordLang$Word 6w;wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 0w] [1])``;
val _ = print_eval "ap_nested" ``(abs_stack ([3w]:8 word list) [wordSem$StackFrame NONE [] [] NONE :8 wordSem$stack_frame;wordSem$StackFrame NONE [] [] NONE] [wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 1w;wordLang$Word 8w;wordLang$Word 0w] [1;1] <> NONE) /\ (abs_stack (([3w]:8 word list) ++ [13w;3w]) [wordSem$StackFrame NONE [] [] NONE :8 wordSem$stack_frame;wordSem$StackFrame NONE [] [] NONE] [wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 1w;wordLang$Word 8w;wordLang$Word 0w] [1;1] = abs_stack ([3w]:8 word list) [wordSem$StackFrame NONE [] [] NONE :8 wordSem$stack_frame;wordSem$StackFrame NONE [] [] NONE] [wordLang$Word 1w;wordLang$Word 7w;wordLang$Word 1w;wordLang$Word 8w;wordLang$Word 0w] [1;1])``;
