do_app_NONE_ffi_typed=do_app ((refs :v store_v list),(ffi :α ffi_state)) (op :op) (args :v list) = (NONE :((v store_v list # α ffi_state) # (v, v) result) option) ⇒ do_app (refs,(ffi' :β ffi_state)) op args = (NONE :((v store_v list # β ffi_state) # (v, v) result) option)
do_app_SOME_ffi_same_typed=do_app ((refs :v store_v list),(ffi :α ffi_state)) (op :op) (args :v list) = SOME (((refs' :v store_v list),ffi),(r :(v, v) result)) ∧ (∀(outcome :final_event). r ≠ (Rerr (Rabort (Rffi_error outcome) :v error_result) :(v, v) result)) ⇒ do_app (refs,(ffi' :β ffi_state)) op args = SOME ((refs',ffi'),r)
do_app_ffi_unchanged_typed=∀(st :v store_v list) (ffi :α ffi_state) (op :op) (vs :v list) (st' :v store_v list) (ffi' :α ffi_state) (res :(v, v) result). (∀(s :mlstring). op ≠ FFI s) ∧ do_app (st,ffi) op vs = SOME ((st',ffi'),res) ⇒ ffi = ffi'
do_app_ffi_changed_typed=do_app ((st :v store_v list),(ffi :α ffi_state)) (op :op) (vs :v list) = SOME (((st' :v store_v list),(ffi' :α ffi_state)),(res :(v, v) result)) ∧ ffi ≠ ffi' ⇒ ∃(s :mlstring) (conf :mlstring) (lnum :num) (ws :word8 list) (ffi_st :α) (ws' :word8 list) (b :bool). op = FFI s ∧ vs = [Litv (StrLit conf); Loc b lnum] ∧ store_lookup lnum st = SOME (W8array ws :v store_v) ∧ s ≠ «» ∧ (ffi.oracle (ExtCall s) ffi.ffi_state (MAP (λ(c :char). (n2w (ORD c) :word8)) (explode conf)) ws :α oracle_result) = Oracle_return ffi_st ws' ∧ LENGTH ws = LENGTH ws' ∧ st' = st❲lnum ↦ (W8array ws' :v store_v)❳ ∧ ffi'.oracle = ffi.oracle ∧ ffi'.ffi_state = ffi_st ∧ ffi'.io_events = ffi.io_events ++ [IO_event (ExtCall s) (MAP (λ(c :char). (n2w (ORD c) :word8)) (explode conf)) (ZIP (ws,ws'))]
do_app_not_timeout_typed=do_app (s :v store_v list # α ffi_state) (op :op) (vs :v list) = SOME ((s' :v store_v list # α ffi_state),(Rerr (Rabort (a :abort) :v error_result) :(v, v) result)) ⇒ a ≠ Rtimeout_error
do_app_type_error_typed=do_app (s :v store_v list # α ffi_state) (op :op) (es :v list) = SOME ((x :v store_v list # α ffi_state),(Rerr (Rabort (a :abort) :v error_result) :(v, v) result)) ⇒ x = s
dest_Refv_def_typed=∀(v :α). dest_Refv (Refv v) = v
sv_rel_O_typed=∀(R1 :α -> β -> bool) (R2 :γ -> α -> bool). sv_rel (R1 ∘ᵣ R2) = sv_rel R1 ∘ᵣ sv_rel R2
FV_def_typed=(∀(e :exp). FV (Raise e) = FV e) ∧ (∀(pes :(pat # exp) list) (e :exp). FV (Handle e pes) = FV e ∪ FV_pes pes) ∧ (∀(v0 :lit). FV (Lit v0) = (∅ :(mlstring, mlstring) id -> bool)) ∧ (∀(v1 :(mlstring, mlstring) id option) (ls :exp list). FV (Con v1 ls) = FV_list ls) ∧ (∀(id :(mlstring, mlstring) id). FV (Var id) = {id}) ∧ (∀(x :mlstring) (e :exp). FV (Fun x e) = FV e DIFF {(Short x :(mlstring, mlstring) id)}) ∧ (∀(v2 :op) (es :exp list). FV (App v2 es) = FV_list es) ∧ (∀(v3 :lop) (e2 :exp) (e1 :exp). FV (Log v3 e1 e2) = FV e1 ∪ FV e2) ∧ (∀(e3 :exp) (e2 :exp) (e1 :exp). FV (If e1 e2 e3) = FV e1 ∪ FV e2 ∪ FV e3) ∧ (∀(pes :(pat # exp) list) (e :exp). FV (Mat e pes) = FV e ∪ FV_pes pes) ∧ (∀(xo :mlstring option) (e :exp) (b :exp). FV (Let xo e b) = FV e ∪ (FV b DIFF case xo of (NONE :mlstring option) => (∅ :(mlstring, mlstring) id -> bool) | SOME x => {(Short x :(mlstring, mlstring) id)})) ∧ (∀(defs :(mlstring # mlstring # exp) list) (b :exp). FV (Letrec defs b) = FV_defs defs ∪ FV b DIFF set (MAP ((Short :mlstring -> (mlstring, mlstring) id) ∘ (FST :mlstring # mlstring # exp -> mlstring)) defs)) ∧ (∀(t :ast_t) (e :exp). FV (Tannot e t) = FV e) ∧ (∀(l :locs) (e :exp). FV (Lannot e l) = FV e) ∧ FV_list ([] :exp list) = (∅ :(mlstring, mlstring) id -> bool) ∧ (∀(es :exp list) (e :exp). FV_list (e::es) = FV e ∪ FV_list es) ∧ FV_pes ([] :(pat # exp) list) = (∅ :(mlstring, mlstring) id -> bool) ∧ (∀(pes :(pat # exp) list) (p :pat) (e :exp). FV_pes ((p,e)::pes) = FV e DIFF IMAGE (Short :mlstring -> (mlstring, mlstring) id) (set (pat_bindings p)) ∪ FV_pes pes) ∧ FV_defs ([] :(mlstring # mlstring # exp) list) = (∅ :(mlstring, mlstring) id -> bool) ∧ ∀(x :mlstring) (v4 :mlstring) (e :exp) (defs :(mlstring # mlstring # exp) list). FV_defs ((v4,x,e)::defs) = FV e DIFF {(Short x :(mlstring, mlstring) id)} ∪ FV_defs defs
FV_pes_MAP_typed=FV_pes (pes :(pat # exp) list) = BIGUNION (IMAGE (λ((p :pat),(e :exp)). FV e DIFF IMAGE (Short :mlstring -> (mlstring, mlstring) id) (set (pat_bindings p))) (set pes))
FV_defs_MAP_typed=∀(ls :(mlstring # mlstring # exp) list). FV_defs ls = BIGUNION (IMAGE (λ((f :mlstring),(x :mlstring),(e :exp)). FV e DIFF {(Short x :(mlstring, mlstring) id)}) (set ls))
FV_dec_def_typed=(∀(locs :locs) (p :pat) (e :exp). FV_dec (Dlet locs p e) = FV (Mat e [(p,Lit (ARB :lit))])) ∧ (∀(locs :locs) (defs :(mlstring # mlstring # exp) list). FV_dec (Dletrec locs defs) = FV (Letrec defs (Lit (ARB :lit)))) ∧ (∀(v0 :locs) (v1 :(mlstring list # mlstring # (mlstring # ast_t list) list) list). FV_dec (Dtype v0 v1) = (∅ :(mlstring, mlstring) id -> bool)) ∧ (∀(v2 :locs) (v3 :mlstring list) (v4 :mlstring) (v5 :ast_t). FV_dec (Dtabbrev v2 v3 v4 v5) = (∅ :(mlstring, mlstring) id -> bool)) ∧ ∀(v6 :locs) (v7 :mlstring) (v8 :ast_t list). FV_dec (Dexn v6 v7 v8) = (∅ :(mlstring, mlstring) id -> bool)
