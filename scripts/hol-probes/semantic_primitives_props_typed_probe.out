every_error_result_def_typed=(∀(P :α -> bool) (e :α). every_error_result P (Rraise e) ⇔ P e) ∧ ∀(P :α -> bool) (a :abort). every_error_result P (Rabort a :α error_result) ⇔ T
every_result_def_typed=(∀(P1 :α -> bool) (P2 :β -> bool) (v :α). every_result P1 P2 (Rval v :(α, β) result) ⇔ P1 v) ∧ ∀(P1 :α -> bool) (P2 :β -> bool) (e :β error_result). every_result P1 P2 (Rerr e :(α, β) result) ⇔ every_error_result P2 e
do_opapp_cases_typed=∀(env' :v sem_env) (vs :v list) (v :exp). do_opapp vs = SOME (env',v) ⇔ (∃(v2 :v) (env'' :v sem_env) (n :mlstring) (e :exp). vs = [Closure env'' n e; v2] ∧ env' = env'' with v := nsBind n v2 env''.v ∧ v = e) ∨ ∃(v2 :v) (env'' :v sem_env) (funs :(mlstring # mlstring # exp) list) (n' :mlstring) (n'' :mlstring) (e :exp). vs = [Recclosure env'' funs n'; v2] ∧ find_recfun n' funs = SOME (n'',e) ∧ ALL_DISTINCT (MAP (λ((f :mlstring),(x :mlstring),(e :exp)). f) funs) ∧ env' = env'' with v := nsBind n'' v2 (build_rec_env funs env'' env''.v) ∧ v = e
extend_dec_env_assoc_typed=∀(env1 :v sem_env) (env2 :v sem_env) (env3 :v sem_env). ((env1 +++ ((env2 +++ env3) :v sem_env)) :v sem_env) = ((((env1 +++ env2) :v sem_env) +++ env3) :v sem_env)
sv_rel_mono_typed=(∀(x :α) (y :β). (P :α -> β -> bool) x y ⇒ (Q :α -> β -> bool) x y) ⇒ sv_rel P (x :α store_v) (y :β store_v) ⇒ sv_rel Q x y
exc_rel_def_typed=(exc_rel (R :α -> β -> bool) (Rraise (v1 :α)) (Rraise (v2 :β)) ⇔ R v1 v2) ∧ (exc_rel (v0 :α -> β -> bool) (Rabort (a1 :abort) :α error_result) (Rabort (a2 :abort) :β error_result) ⇔ a1 = a2) ∧ (exc_rel (v3 :α -> β -> bool) (Rraise (v9 :α)) (Rabort (v14 :abort) :β error_result) ⇔ F) ∧ (exc_rel v3 (Rabort (v10 :abort) :α error_result) (Rraise (v17 :β)) ⇔ F)
result_rel_def_typed=(result_rel (R1 :α -> β -> bool) (v0 :γ -> δ -> bool) (Rval (v1 :α) :(α, γ) result) (Rval (v2 :β) :(β, δ) result) ⇔ R1 v1 v2) ∧ (result_rel (v3 :α -> β -> bool) (R2 :γ -> δ -> bool) (Rerr (e1 :γ error_result) :(α, γ) result) (Rerr (e2 :δ error_result) :(β, δ) result) ⇔ exc_rel R2 e1 e2) ∧ (result_rel (v4 :α -> β -> bool) (v5 :γ -> δ -> bool) (Rval (v13 :α) :(α, γ) result) (Rerr (v18 :δ error_result) :(β, δ) result) ⇔ F) ∧ (result_rel v4 v5 (Rerr (v14 :γ error_result) :(α, γ) result) (Rval (v21 :β) :(β, δ) result) ⇔ F)
sv_rel_cases_typed=∀(x :α store_v) (y :β store_v). sv_rel (R :α -> β -> bool) x y ⇔ (∃(v1 :α) (v2 :β). x = Refv v1 ∧ y = Refv v2 ∧ R v1 v2) ∨ (∃(w :word8 list). x = (W8array w :α store_v) ∧ y = (W8array w :β store_v)) ∨ (∃(m :thunk_mode) (v1 :α) (v2 :β). x = Thunk m v1 ∧ y = Thunk m v2 ∧ R v1 v2) ∨ ∃(vs1 :α list) (vs2 :β list). x = Varray vs1 ∧ y = Varray vs2 ∧ LIST_REL R vs1 vs2
sv_rel_def_typed=(sv_rel (R :α -> β -> bool) (Refv (v1 :α)) (Refv (v2 :β)) ⇔ R v1 v2) ∧ (sv_rel R (W8array (w1 :word8 list) :α store_v) (W8array (w2 :word8 list) :β store_v) ⇔ w1 = w2) ∧ (sv_rel R (Varray (vs1 :α list)) (Varray (vs2 :β list)) ⇔ LIST_REL R vs1 vs2) ∧ (sv_rel R (Thunk (m1 :thunk_mode) v1) (Thunk (m2 :thunk_mode) v2) ⇔ m1 = m2 ∧ R v1 v2) ∧ (sv_rel R (Refv (v7 :α)) (W8array (v18 :word8 list) :β store_v) ⇔ F) ∧ (sv_rel R (Refv v7) (Varray (v19 :β list)) ⇔ F) ∧ (sv_rel R (Refv v7) (Thunk (v20 :thunk_mode) (v21 :β)) ⇔ F) ∧ (sv_rel R (W8array (v8 :word8 list) :α store_v) (Refv (v27 :β)) ⇔ F) ∧ (sv_rel R (W8array v8 :α store_v) (Varray (v29 :β list)) ⇔ F) ∧ (sv_rel R (W8array v8 :α store_v) (Thunk (v30 :thunk_mode) (v31 :β)) ⇔ F) ∧ (sv_rel R (Varray (v9 :α list)) (Refv (v37 :β)) ⇔ F) ∧ (sv_rel R (Varray v9) (W8array (v38 :word8 list) :β store_v) ⇔ F) ∧ (sv_rel R (Varray v9) (Thunk (v40 :thunk_mode) (v41 :β)) ⇔ F) ∧ (sv_rel R (Thunk (v10 :thunk_mode) (v11 :α)) (Refv (v47 :β)) ⇔ F) ∧ (sv_rel R (Thunk v10 v11) (W8array (v48 :word8 list) :β store_v) ⇔ F) ∧ (sv_rel R (Thunk v10 v11) (Varray (v49 :β list)) ⇔ F)
map_error_result_def_typed=(∀(f :β -> α) (e :β). map_error_result f (Rraise e) = Rraise (f e)) ∧ ∀(f :β -> α) (a :abort). map_error_result f (Rabort a :β error_result) = (Rabort a :α error_result)
map_error_result_Rtype_error_typed=map_error_result (f :β -> α) (e :β error_result) = (Rabort (a :abort) :α error_result) ⇔ e = (Rabort a :β error_result)
map_error_result_I_typed=map_error_result (I :α -> α) (e :α error_result) = e
map_result_def_typed=(∀(f1 :γ -> α) (f2 :δ -> β) (v :γ). map_result f1 f2 (Rval v :(γ, δ) result) = (Rval (f1 v) :(α, β) result)) ∧ ∀(f1 :γ -> α) (f2 :δ -> β) (e :δ error_result). map_result f1 f2 (Rerr e :(γ, δ) result) = (Rerr (map_error_result f2 e) :(α, β) result)
map_result_Rval_typed=map_result (f1 :γ -> α) (f2 :δ -> β) (e :(γ, δ) result) = (Rval (x :α) :(α, β) result) ⇔ ∃(y :γ). e = (Rval y :(γ, δ) result) ∧ x = f1 y
map_result_Rerr_typed=map_result (f1 :γ -> α) (f2 :δ -> β) (e :(γ, δ) result) = (Rerr (e' :β error_result) :(α, β) result) ⇔ ∃(a :δ error_result). e = (Rerr a :(γ, δ) result) ∧ map_error_result f2 a = e'
build_rec_env_merge_typed=∀(funs :(mlstring # mlstring # exp) list) (funs' :α) (env :v sem_env) (env' :(mlstring, mlstring, v) namespace). build_rec_env funs env env' = nsAppend (alist_to_ns (MAP (λ((f :mlstring),(n :mlstring),(e :exp)). (f,Recclosure env funs f)) funs) :(mlstring, mlstring, v) namespace) env'
find_recfun_ALOOKUP_typed=∀(funs :(mlstring # α # β) list) (n :mlstring). find_recfun n funs = ALOOKUP funs n
lit_same_type_refl_typed=∀(l :lit). lit_same_type l l
lit_same_type_sym_typed=∀(l1 :lit) (l2 :lit). lit_same_type l1 l2 ⇒ lit_same_type l2 l1
map_match_def_typed=map_match (f :α -> α) (Match (env :α)) = Match (f env) ∧ map_match f (No_match :α match_result) = (No_match :α match_result) ∧ map_match f (Match_type_error :α match_result) = (Match_type_error :α match_result)
do_conversion_check_type_typed=do_conversion (v :v) (ty1 :prim_type) (ty2 :prim_type) = SOME (INR (res :v) :v + v) ⇒ check_type ty2 res
do_arith_check_type_typed=do_arith (a :arith) (ty :prim_type) (vs :v list) = SOME (INR (res :v) :v + v) ⇒ check_type ty res
shift_lookup_def_typed=(shift_lookup Lsl :α word -> num -> α word) = ($<< :α word -> num -> α word) ∧ (shift_lookup Lsr :α word -> num -> α word) = ($>>> :α word -> num -> α word) ∧ (shift_lookup Asr :α word -> num -> α word) = ($>> :α word -> num -> α word) ∧ (shift_lookup Ror :α word -> num -> α word) = ($#>> :α word -> num -> α word)
do_shift_def_typed=do_shift (sh :shift) (n :num) W8 (Word8 (w' :word8)) = SOME (Word8 (shift_lookup sh w' n)) ∧ do_shift sh n W64 (Word64 (w :word64)) = SOME (Word64 (shift_lookup sh w n)) ∧ do_shift (v0 :shift) (v1 :num) (v2 :word_size) (IntLit (v9 :int)) = (NONE :lit option) ∧ do_shift v0 v1 v2 (Char (v10 :char)) = (NONE :lit option) ∧ do_shift v0 v1 v2 (StrLit (v11 :mlstring)) = (NONE :lit option) ∧ do_shift v0 v1 W64 (Word8 (v12 :word8)) = (NONE :lit option) ∧ do_shift v0 v1 W8 (Word64 (v13 :word64)) = (NONE :lit option) ∧ do_shift v0 v1 v2 (Float64 (v14 :word64)) = (NONE :lit option)
