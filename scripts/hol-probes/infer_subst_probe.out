infer_type_subst_def_typed=(∀(s :(mlstring # infer_t) list) (tv :mlstring). infer_type_subst s (Tvar tv) = case ALOOKUP s tv of (NONE :infer_t option) => Infer_Tvar_db (0 :num) | SOME t => t) ∧ (∀(s :(mlstring # infer_t) list) (n :num). infer_type_subst s (Tvar_db n) = Infer_Tvar_db n) ∧ (∀(s :(mlstring # infer_t) list) (ts :t list) (tn :num). infer_type_subst s (Tapp ts tn) = Infer_Tapp (infer_type_subst_list s ts) tn) ∧ (∀(s :(mlstring # infer_t) list). infer_type_subst_list s ([] :t list) = ([] :infer_t list)) ∧ ∀(s :(mlstring # infer_t) list) (x :t) (xs :t list). infer_type_subst_list s (x::xs) = infer_type_subst s x::infer_type_subst_list s xs
infer_deBruijn_subst_def_typed=(∀(s :infer_t list) (n :num). infer_deBruijn_subst s (Infer_Tvar_db n) = if n < LENGTH s then s❲n❳ else Infer_Tvar_db (n − LENGTH s)) ∧ (∀(s :infer_t list) (ts :infer_t list) (tn :num). infer_deBruijn_subst s (Infer_Tapp ts tn) = Infer_Tapp (infer_deBruijn_subst_list s ts) tn) ∧ (∀(s :infer_t list) (n :num). infer_deBruijn_subst s (Infer_Tuvar n) = Infer_Tuvar n) ∧ (∀(s :infer_t list). infer_deBruijn_subst_list s ([] :infer_t list) = ([] :infer_t list)) ∧ ∀(s :infer_t list) (t :infer_t) (ts :infer_t list). infer_deBruijn_subst_list s (t::ts) = infer_deBruijn_subst s t::infer_deBruijn_subst_list s ts
inf_env_axiom_typed=∀(f :(mlstring, mlstring, num # infer_t) namespace -> (mlstring, mlstring, mlstring list # t list # num) namespace -> (mlstring, mlstring, mlstring list # t) namespace -> α). ∃(fn :inf_env -> α). ∀(a0 :(mlstring, mlstring, num # infer_t) namespace) (a1 :(mlstring, mlstring, mlstring list # t list # num) namespace) (a2 :(mlstring, mlstring, mlstring list # t) namespace). fn (inf_env a0 a1 a2) = f a0 a1 a2
init_config_def_typed=init_config = <|inf_c := prim_tenv.c; inf_v := (nsEmpty :(mlstring, mlstring, num # infer_t) namespace); inf_t := prim_tenv.t|>
