val _ = observe "hc_lhs_reg_repeat" ``add1_lhs_reg 2 (add1_lhs_reg 2 LN) = insert 2 (0, 2, 0, 0, 0) LN``;
val _ = observe "hc_lhs_reg_other" ``lookup 7 (add1_lhs_reg 2 (insert 7 (2, 3, 5, 7, 11) LN)) = SOME (2, 3, 5, 7, 11)``;
val _ = observe "hc_lhs_mem_absent" ``add1_lhs_mem 2 LN = insert 2 (0, 0, 1, 0, 0) LN``;
val _ = observe "hc_lhs_mem_present" ``add1_lhs_mem 2 (insert 2 (2, 3, 5, 7, 11) LN) = insert 2 (2, 3, 6, 7, 11) LN``;
val _ = observe "hc_lhs_mem_repeat" ``add1_lhs_mem 2 (add1_lhs_mem 2 LN) = insert 2 (0, 0, 2, 0, 0) LN``;
val _ = observe "hc_lhs_mem_other" ``lookup 7 (add1_lhs_mem 2 (insert 7 (2, 3, 5, 7, 11) LN)) = SOME (2, 3, 5, 7, 11)``;
val _ = observe "hc_rhs_reg_absent" ``add1_rhs_reg 2 LN = insert 2 (0, 0, 0, 1, 0) LN``;
val _ = observe "hc_rhs_reg_present" ``add1_rhs_reg 2 (insert 2 (2, 3, 5, 7, 11) LN) = insert 2 (2, 3, 5, 8, 11) LN``;
