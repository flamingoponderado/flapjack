load "bossLib";
load "preamble";
load "word_allocTheory";
open bossLib HolKernel Parse preamble word_allocTheory;
fun observe label term = let val th = EVAL term in print(label ^ "="); print_term(rhs(concl th)); print "\n" end;
val _ = observe "hc_lhs_const_absent" ``add1_lhs_const 2 LN = insert 2 (1, 0, 0, 0, 0) LN``;
val _ = observe "hc_lhs_const_present" ``add1_lhs_const 2 (insert 2 (2, 3, 5, 7, 11) LN) = insert 2 (3, 3, 5, 7, 11) LN``;
val _ = observe "hc_lhs_const_repeat" ``add1_lhs_const 2 (add1_lhs_const 2 LN) = insert 2 (2, 0, 0, 0, 0) LN``;
val _ = observe "hc_lhs_const_other" ``lookup 7 (add1_lhs_const 2 (insert 7 (2, 3, 5, 7, 11) LN)) = SOME (2, 3, 5, 7, 11)``;
val _ = observe "hc_lhs_reg_absent" ``add1_lhs_reg 2 LN = insert 2 (0, 1, 0, 0, 0) LN``;
