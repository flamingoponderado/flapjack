source_convert=⊢ ∀to_float from_float from_real_with_flags m w.
    convert to_float from_float from_real_with_flags m w =
    (let
       f = to_float w
     in
       case float_value f of
         Float r => from_real_with_flags m r
       | Infinity =>
         (clear_flags,
          from_float
            (if f.Sign = 0w then float_plus_infinity (:δ # ε)
             else float_minus_infinity (:δ # ε)))
       | NaN => (check_for_signalling [f],from_float (@fp. float_is_nan fp)))
widen_pinf=(<|DivideByZero := F; InvalidOp := F; Overflow := F; Precision := F;
   Underflow_BeforeRounding := F; Underflow_AfterRounding := F|>,
 0x7FF0000000000000w)
widen_ninf=(<|DivideByZero := F; InvalidOp := F; Overflow := F; Precision := F;
   Underflow_BeforeRounding := F; Underflow_AfterRounding := F|>,
 0xFFF0000000000000w)
widen_qnan=<|DivideByZero := F; InvalidOp := F; Overflow := F; Precision := F;
  Underflow_BeforeRounding := F; Underflow_AfterRounding := F|>
widen_snan=<|DivideByZero := F; InvalidOp := T; Overflow := F; Precision := F;
  Underflow_BeforeRounding := F; Underflow_AfterRounding := F|>
