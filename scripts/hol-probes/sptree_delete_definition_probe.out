mk_bn=isEmpty (mk_BN (LN :α num_map) (LN :α num_map)) ∧ mk_BN (LN :α num_map) ⦕ 0 ↦ (v14 :α) ⦖ = ⦕ 1 ↦ v14 ⦖ ∧ mk_BN (LN :α num_map) (BN (v15 :α num_map) (v16 :α num_map)) = BN (LN :α num_map) (BN v15 v16) ∧ mk_BN (LN :α num_map) (BS (v17 :α num_map) (v18 :α) (v19 :α num_map)) = BN (LN :α num_map) (BS v17 v18 v19) ∧ mk_BN ⦕ 0 ↦ (v2 :α) ⦖ (t2 :α num_map) = BN ⦕ 0 ↦ v2 ⦖ t2 ∧ mk_BN (BN (v3 :α num_map) (v4 :α num_map)) t2 = BN (BN v3 v4) t2 ∧ mk_BN (BS (v5 :α num_map) (v6 :α) (v7 :α num_map)) t2 = BN (BS v5 v6 v7) t2
mk_bs=mk_BS (LN :α num_map) (x :α) (LN :α num_map) = ⦕ 0 ↦ x ⦖ ∧ mk_BS ⦕ 0 ↦ (v16 :α) ⦖ x (LN :α num_map) = ⦕ 0 ↦ x; 2 ↦ v16 ⦖ ∧ mk_BS (BN (v17 :α num_map) (v18 :α num_map)) x (LN :α num_map) = BS (BN v17 v18) x (LN :α num_map) ∧ mk_BS (BS (v19 :α num_map) (v20 :α) (v21 :α num_map)) x (LN :α num_map) = BS (BS v19 v20 v21) x (LN :α num_map) ∧ mk_BS (t1 :α num_map) x ⦕ 0 ↦ (v4 :α) ⦖ = BS t1 x ⦕ 0 ↦ v4 ⦖ ∧ mk_BS t1 x (BN (v5 :α num_map) (v6 :α num_map)) = BS t1 x (BN v5 v6) ∧ mk_BS t1 x (BS (v7 :α num_map) (v8 :α) (v9 :α num_map)) = BS t1 x (BS v7 v8 v9)
delete=(∀(k :num). isEmpty (delete k (LN :α num_map))) ∧ (∀(k :num) (a :α). delete k ⦕ 0 ↦ a ⦖ = if k = (0 :num) then (LN :α num_map) else ⦕ 0 ↦ a ⦖) ∧ (∀(k :num) (t1 :α num_map) (t2 :α num_map). delete k (BN t1 t2) = if k = (0 :num) then BN t1 t2 else if EVEN k then mk_BN (delete ((k − (1 :num)) DIV (2 :num)) t1) t2 else mk_BN t1 (delete ((k − (1 :num)) DIV (2 :num)) t2)) ∧ ∀(k :num) (t1 :α num_map) (a :α) (t2 :α num_map). delete k (BS t1 a t2) = if k = (0 :num) then BN t1 t2 else if EVEN k then mk_BS (delete ((k − (1 :num)) DIV (2 :num)) t1) a t2 else mk_BS t1 a (delete ((k − (1 :num)) DIV (2 :num)) t2)
size=size (LN :α num_map) = (0 :num) ∧ (∀(a :α). size ⦕ 0 ↦ a ⦖ = (1 :num)) ∧ (∀(t1 :α num_map) (t2 :α num_map). size (BN t1 t2) = size t1 + size t2) ∧ ∀(t1 :α num_map) (a :α) (t2 :α num_map). size (BS t1 a t2) = size t1 + size t2 + (1 :num)
