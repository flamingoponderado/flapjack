cc_storeconsts_statement=∀t1 t2 stub s r s2 t1' k off jump. evaluate (StoreConsts t1 t2 stub,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1' ∧ reg_bound (StoreConsts t1 t2 stub) k ⇒ ∃ck t2'. evaluate (comp jump off k (StoreConsts t1 t2 stub),t1' with clock := ck + t1'.clock) = (r,t2') ∧ case r of NONE => state_rel jump off k s2 t2' | SOME (Result v8) => state_rel jump off k s2 t2' | SOME (Exception v9) => state_rel jump off k s2 t2' | SOME (Break v10) => state_rel jump off k s2 t2' | SOME (Continue v11) => state_rel jump off k s2 t2' | SOME (Halt v12) => t2'.ffi = s2.ffi | SOME TimeOut => t2'.ffi = s2.ffi | SOME (FinalFFI v13) => t2'.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2'
cc_storeconsts_proved=T
