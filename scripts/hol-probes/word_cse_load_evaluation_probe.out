ld_full_any=⊢ ∀op r0 a ofs w s r. ¬is_store op ∧ evaluate (Inst (Mem op r0 (Addr a ofs)),s) = (NONE,set_var r0 w s) ⇒ evaluate (Inst (Mem op r (Addr a ofs)),s) = (NONE,set_var r w s)
ld_full_write=⊢ ∀op r a ofs n u w s. ¬is_store op ∧ a ≠ n ⇒ (evaluate (Inst (Mem op r (Addr a ofs)),set_var n u s) = (NONE,set_var r w (set_var n u s)) ⇔ evaluate (Inst (Mem op r (Addr a ofs)),s) = (NONE,set_var r w s))
ld_full_addr=⊢ ∀op r a a' ofs w s. ¬is_store op ∧ lookup a' s.locals = lookup a s.locals ∧ evaluate (Inst (Mem op r (Addr a ofs)),s) = (NONE,set_var r w s) ⇒ evaluate (Inst (Mem op r (Addr a' ofs)),s) = (NONE,set_var r w s)
ld_type_state=:(α, γ, 'ffi) state
ld_type_word=:α word
ld_type_value=:α word_loc
ld_type_op=:memop
