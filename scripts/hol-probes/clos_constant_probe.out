cc_ALOOKUP_conses_ok_IMP=ALOOKUP (aux :(const_part # num) list) (x :const_part) = SOME (r :num) ∧ conses_ok aux ⇒ ∃(xs :(const_part # num) list) (ys :(const_part # num) list). MAP (FST :const_part # num -> const_part) (REVERSE aux) = MAP (FST :const_part # num -> const_part) (REVERSE xs) ++ [x] ++ MAP (FST :const_part # num -> const_part) (REVERSE ys) ∧ LENGTH xs = r ∧ r < LENGTH aux ∧ ∀(t :num) (ys :num list) (y :num). x = (Con t ys :const_part) ∧ MEM y ys ⇒ y < r
cc_IMP_conses_ok_CONS=(∀(n :num) (rs :num list). (x :const_part) = (Con n rs :const_part) ⇒ EVERY (λ(m :num). m < LENGTH (aux :(const_part # num) list)) rs) ⇒ conses_ok aux ⇒ conses_ok ((x,LENGTH aux)::aux)
cc_add_part_thm=add_part (n :num) (update_tag (x :const_part)) (m :(const_part # num) list sptree$num_map) (MAP (update_tag ∘ (FST :const_part # num -> const_part)) (aux :(const_part # num) list)) = ((n1 :num),(rs :num),(m1 :(const_part # num) list sptree$num_map),(acc1 :const_part list)) ∧ make_part n x aux = ((n2 :num),(rs1 :num),(aux1 :(const_part # num) list)) ∧ good_hash_table m aux ⇒ n1 = n2 ∧ rs = rs1 ∧ MAP (update_tag ∘ (FST :const_part # num -> const_part)) aux1 = acc1 ∧ good_hash_table m1 aux1
cc_add_parts_thm=(∀(l :const) (n :num) (m :(const_part # num) list sptree$num_map) (acc :const_part list) (n1 :num) (m1 :α) (rs :num) (m1 :(const_part # num) list sptree$num_map) (acc1 :const_part list) (aux :(const_part # num) list) (n2 :num) (rs1 :num) (aux1 :(const_part # num) list). add_parts l n m acc = (n1,rs,m1,acc1) ∧ parts l n aux = (n2,rs1,aux1) ∧ MAP (update_tag ∘ (FST :const_part # num -> const_part)) aux = acc ∧ good_hash_table m aux ⇒ n1 = n2 ∧ rs = rs1 ∧ MAP (update_tag ∘ (FST :const_part # num -> const_part)) aux1 = acc1 ∧ good_hash_table m1 aux1) ∧ ∀(l :const list) (n :num) (m :(const_part # num) list sptree$num_map) (acc :const_part list) (n1 :num) (m1 :β) (rs :num list) (m1 :(const_part # num) list sptree$num_map) (acc1 :const_part list) (aux :(const_part # num) list) (n2 :num) (rs1 :num list) (aux1 :(const_part # num) list). add_parts_list l n m acc = (n1,rs,m1,acc1) ∧ parts_list l n aux = (n2,rs1,aux1) ∧ MAP (update_tag ∘ (FST :const_part # num -> const_part)) aux = acc ∧ good_hash_table m aux ⇒ n1 = n2 ∧ rs = rs1 ∧ MAP (update_tag ∘ (FST :const_part # num -> const_part)) aux1 = acc1 ∧ good_hash_table m1 aux1
cc_build_prime_def=(∀(mem :num -> v) (i :num). build' mem i ([] :const_part list) = mem (i − (1 :num))) ∧ ∀(mem :num -> v) (i :num) (p :const_part) (rest :const_part list). build' mem i (p::rest) = build' mem⦇i ↦ build_part' mem p⦈ (i + (1 :num)) rest
cc_build_const_prime_def=∀(xs :const_part list). build_const' xs = build' (λ(x :num). Number (0 :int)) (0 :num) xs
cc_build_const_def=∀(xs :const_part list). build_const xs = build (λ(x :num). ConstInt (0 :int)) (0 :num) xs
cc_build_const_to_parts=∀(c :const). build_const (to_parts c) = c
cc_build_def=(∀(mem :num -> const) (i :num). build mem i ([] :const_part list) = mem (i − (1 :num))) ∧ ∀(mem :num -> const) (i :num) (p :const_part) (rest :const_part list). build mem i (p::rest) = build mem⦇i ↦ build_part mem p⦈ (i + (1 :num)) rest
cc_build_map_APPEND=∀(xs :const_part list) (ys :const_part list) (m :num -> const) (n :num). build_map m n (xs ++ ys) = build_map (build_map m n xs) (n + LENGTH xs) ys
cc_build_map_def=(∀(mem :num -> const) (i :num). build_map mem i ([] :const_part list) = mem) ∧ ∀(mem :num -> const) (i :num) (p :const_part) (rest :const_part list). build_map mem i (p::rest) = build_map mem⦇i ↦ build_part mem p⦈ (i + (1 :num)) rest
cc_build_map_ignore=∀(xs :const_part list) (m :num -> const) (n :num) (k :num). k < n ⇒ build_map m n xs k = m k
cc_build_mem_thm=∀(mem :num -> const) (i :num) (xs :const_part list) (y :const_part). build mem i (xs ++ [y]) = build (build_map mem i xs) (i + LENGTH xs) [y]
cc_build_part_prime_def=(∀(mem :num -> v) (i :int). build_part' mem (Int i :const_part) = Number i) ∧ (∀(mem :num -> v) (s :mlstring). build_part' mem (Str s) = ByteVector (MAP ((n2w :num -> word8) ∘ ORD) (explode s))) ∧ (∀(mem :num -> v) (w :word64). build_part' mem (W64 w :const_part) = (Word64 w :v)) ∧ ∀(mem :num -> v) (t :num) (ns :num list). build_part' mem (Con t ns :const_part) = Block t (MAP mem ns)
cc_build_part_def=(∀(mem :num -> const) (i :int). build_part mem (Int i :const_part) = ConstInt i) ∧ (∀(mem :num -> const) (s :mlstring). build_part mem (Str s) = ConstStr s) ∧ (∀(mem :num -> const) (w :word64). build_part mem (W64 w :const_part) = ConstWord64 w) ∧ ∀(mem :num -> const) (t :num) (ns :num list). build_part mem (Con t ns :const_part) = ConstCons t (MAP mem ns)
cc_compile_const_thm=(∀(i :int). (c :const) ≠ ConstInt i) ∧ (∀(t :num). c ≠ ConstCons t ([] :const list)) ⇒ compile_const c = BlockOp (Build (MAP update_tag (to_parts c)))
cc_conses_ok_def=∀(aux :(const_part # num) list). conses_ok aux ⇔ (∀(n :num). n < LENGTH aux ⇒ ∃(p :const_part). (REVERSE aux)❲n❳ = (p,n)) ∧ ∀(n :num) (rs :num list) (m :num) (r :num). MEM ((Con n rs :const_part),r) aux ∧ MEM m rs ⇒ m < r
cc_good_hash_table_def=∀(m :(const_part # α) list sptree$num_map) (aux :(const_part # α) list). good_hash_table m aux ⇔ ∀(k :const_part) (v :α). ALOOKUP aux k = SOME v ⇔ ∃(bucket :(const_part # α) list). lookup (part_hash (update_tag k)) m = SOME bucket ∧ ALOOKUP bucket (update_tag k) = SOME v
cc_make_const_thm=make_const (c :const) = build_const' (to_parts c)
cc_make_part_def=∀(n :num) (p :α) (aux :(α # num) list). make_part n p aux = case ALOOKUP aux p of (NONE :num option) => (n + (1 :num),n,(p,n)::aux) | SOME k => (n,k,aux)
cc_parts_acc=(∀(c :const) (n :num) (aux :(const_part # num) list) (m :num) (r :num) (res :(const_part # num) list). parts c n aux = (m,r,res) ⇒ ∃(a :(const_part # num) list). res = a ++ aux) ∧ ∀(cs :const list) (n :num) (aux :(const_part # num) list) (m :num) (rs :num list) (res :(const_part # num) list). parts_list cs n aux = (m,rs,res) ⇒ ∃(a :(const_part # num) list). res = a ++ aux
cc_parts_def=(∀(i :int) (n :num) (aux :(const_part # num) list). parts (ConstInt i) n aux = make_part n (Int i :const_part) aux) ∧ (∀(s :mlstring) (n :num) (aux :(const_part # num) list). parts (ConstStr s) n aux = make_part n (Str s) aux) ∧ (∀(w :word64) (n :num) (aux :(const_part # num) list). parts (ConstWord64 w) n aux = make_part n (W64 w :const_part) aux) ∧ (∀(t :num) (cs :const list) (n :num) (aux :(const_part # num) list). parts (ConstCons t cs) n aux = (let ((n :num),(rs :num list),(aux :(const_part # num) list)) = parts_list cs n aux in make_part n (Con t rs :const_part) aux)) ∧ (∀(n :num) (aux :(const_part # num) list). parts_list ([] :const list) n aux = (n,([] :num list),aux)) ∧ ∀(c :const) (cs :const list) (n :num) (aux :(const_part # num) list). parts_list (c::cs) n aux = (let ((n :num),(r :num),(aux :(const_part # num) list)) = parts c n aux; ((n :num),(rs :num list),(aux :(const_part # num) list)) = parts_list cs n aux in (n,r::rs,aux))
cc_parts_thm=(∀(c :const) (n :num) (aux :(const_part # num) list) (m :num) (r :num) (res :(const_part # num) list). parts c n aux = (m,r,res) ∧ ALL_DISTINCT (MAP (SND :const_part # num -> num) aux) ∧ conses_ok aux ∧ n = LENGTH aux ∧ EVERY (λ((p :const_part),(k :num)). k < n) aux ⇒ build_map (λ(x :num). ConstInt (0 :int)) (0 :num) (MAP (FST :const_part # num -> const_part) (REVERSE res)) r = c ∧ n ≤ m ∧ r < m ∧ ALL_DISTINCT (MAP (SND :const_part # num -> num) res) ∧ conses_ok res ∧ m = LENGTH res ∧ EVERY (λ((p :const_part),(k :num)). k < m) res) ∧ ∀(cs :const list) (n :num) (aux :(const_part # num) list) (m :num) (rs :num list) (res :(const_part # num) list). parts_list cs n aux = (m,rs,res) ∧ ALL_DISTINCT (MAP (SND :const_part # num -> num) aux) ∧ conses_ok aux ∧ n = LENGTH aux ∧ EVERY (λ((p :const_part),(k :num)). k < n) aux ⇒ LIST_REL (λ(c :const) (r :num). build_map (λ(x :num). ConstInt (0 :int)) (0 :num) (MAP (FST :const_part # num -> const_part) (REVERSE res)) r = c) cs rs ∧ n ≤ m ∧ ALL_DISTINCT (MAP (SND :const_part # num -> num) res) ∧ EVERY (λ(k :num). k < m) rs ∧ conses_ok res ∧ m = LENGTH res ∧ EVERY (λ((p :const_part),(k :num)). k < m) res
cc_to_parts_def=(∀(i :int). to_parts (ConstInt i) = [(Int i :const_part)]) ∧ (∀(s :mlstring). to_parts (ConstStr s) = [Str s]) ∧ (∀(w :word64). to_parts (ConstWord64 w) = [(W64 w :const_part)]) ∧ ∀(t :num) (cs :const list). to_parts (ConstCons t cs) = (let ((n :num),(rs :num list),(aux :(const_part # num) list)) = parts_list cs (0 :num) ([] :(const_part # num) list) in REVERSE ((Con t rs :const_part)::MAP (FST :const_part # num -> const_part) aux))
cc_update_tag_11=update_tag (x :const_part) = update_tag (y :const_part) ⇔ x = y
cc_update_tag_def=update_tag (Con (t :num) (ns :num list) :const_part) = (Con (clos_tag_shift t) ns :const_part) ∧ update_tag (Int (v2 :int) :const_part) = (Int v2 :const_part) ∧ update_tag (Str (v3 :mlstring)) = Str v3 ∧ update_tag (W64 (v4 :word64) :const_part) = (W64 v4 :const_part)
