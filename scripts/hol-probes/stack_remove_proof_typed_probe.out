init_code_thm_typed=init_code_pre (k :num) (bitmaps :α word list) (data_sp :num) (s :(α, β, γ) stackSem$state) ∧ code_rel (jump :bool) (off :α word # α word) k (code :α stackLang$prog sptree$num_map) s.code ∧ s.compile_oracle = ((I :β -> β) ## MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) ∘ (coracle :num -> β # (num # α stackLang$prog) list # α word list) ∧ (∀(n :num) (i :num) (p :α stackLang$prog). MEM (i,p) (FST (SND (coracle n))) ⇒ reg_bound p k ∧ stack_num_stubs ≤ i + (1 :num)) ∧ lookup stack_err_lab s.code = SOME (halt_inst (2w :α word)) ∧ max_stack_alloc ≤ (max_heap :num) ⇒ case (evaluate ((init_code (gen_gc :bool) max_heap k :α stackLang$prog),s) :α stackSem$result option # (α, β, γ) stackSem$state) of ((NONE :α stackSem$result option),t) => (∃(w2 :α word) (w3 :α word) (w4 :α word). FLOOKUP s.regs (2 :num) = SOME (Word w2) ∧ byte_aligned w2 ∧ FLOOKUP t.regs (k + (2 :num)) = SOME (Word w2) ∧ FLOOKUP s.regs (4 :num) = SOME (Word w4) ∧ byte_aligned w4 ∧ w2 <₊ w4 ∧ FLOOKUP t.regs k = SOME (Word (w4 − (bytes_in_word :α word))) ∧ (w2 + (n2w max_stack_alloc :α word) * (bytes_in_word :α word) ≤₊ w3 ∧ w3 ≤₊ w4 − (n2w max_stack_alloc :α word) * (bytes_in_word :α word) ∧ w2n (-(1w :α word) * w2 + w3) ≤ max_heap * w2n (bytes_in_word :α word) ∧ w2n (bytes_in_word :α word) * max_heap < dimword (:α) ⇒ FLOOKUP t.regs (k + (1 :num)) = SOME (Word ((w3 + -(1w :α word) * w2) ⋙ (shift (:α) + (1 :num)) ≪ (shift (:α) + (1 :num)) + w2 + (bytes_in_word :α word) * (n2w (LENGTH store_list) :α word)))) ∧ FLOOKUP s.regs (3 :num) = SOME (Word w3)) ∧ state_rel jump off k (init_reduce gen_gc jump off k code bitmaps data_sp coracle t) t ∧ t.ffi = s.ffi ∧ init_prop gen_gc max_heap data_sp (get_stack_heap_limit max_heap (read_pointers s)) (init_reduce gen_gc jump off k code bitmaps data_sp coracle t) ∧ s.mdomain = t.mdomain ∧ s.sh_mdomain = t.sh_mdomain ∧ (let (t0 :(α, β, γ) stackSem$state) = init_reduce gen_gc jump off k code bitmaps data_sp coracle t in fun2set (s.memory,t0.mdomain) = fun2set (t.memory,t0.mdomain)) | (SOME res,t) => F
init_code_pre_def_typed=∀(k :num) (bitmaps :α word list) (data_sp :num) (s :(α, β, γ) stackSem$state). init_code_pre k bitmaps data_sp s ⇔ ∃(ptr2 :α word) (ptr3 :α word) (ptr4 :α word) (bitmap_ptr :α word). good_dimindex (:α) ∧ (8 :num) ≤ k ∧ (1 :num) ∈ (domain s.code :num -> bool) ∧ {k; k + (1 :num); k + (2 :num)} ⊆ s.ffi_save_regs ∧ ¬s.use_stack ∧ ¬s.use_store ∧ ¬s.use_alloc ∧ FLOOKUP s.regs (2 :num) = SOME (Word ptr2) ∧ FLOOKUP s.regs (3 :num) = SOME (Word ptr3) ∧ FLOOKUP s.regs (4 :num) = SOME (Word ptr4) ∧ s.memory ptr2 = Word bitmap_ptr ∧ s.memory (ptr2 + (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ s.memory (ptr2 + (2w :α word) * (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word) + (bytes_in_word :α word) * (n2w data_sp :α word)) ∧ s.memory (ptr2 + (3w :α word) * (bytes_in_word :α word)) = Word s.code_buffer.position ∧ s.memory (ptr2 + (4w :α word) * (bytes_in_word :α word)) = Word (s.code_buffer.position + (n2w s.code_buffer.space_left :α word)) ∧ ptr2 ≤₊ ptr4 ∧ (1024w :α word) * (bytes_in_word :α word) ≤₊ ptr4 − ptr2 ∧ byte_aligned ptr2 ∧ byte_aligned ptr4 ∧ byte_aligned bitmap_ptr ∧ s.code_buffer.buffer = ([] :word8 list) ∧ (word_list bitmap_ptr (MAP (Word :α word -> α word_loc) bitmaps) * (word_list_exists (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) data_sp :(α word # α word_loc -> bool) -> bool) * (word_list_exists ptr2 (w2n (ptr4 − ptr2) DIV w2n (bytes_in_word :α word)) :(α word # α word_loc -> bool) -> bool)) (fun2set (s.memory,s.mdomain))
evaluate_init_code_ffi_typed=(evaluate ((init_code (gen_gc :bool) (max_heap :num) (k :num) :α stackLang$prog),(s :(α, γ, 'ffi) stackSem$state)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = ((res :α stackSem$result option),(t :(α, γ, 'ffi) stackSem$state)) ⇒ (evaluate ((init_code gen_gc max_heap k :α stackLang$prog),s with ffi := (c :'ffi ffi_state)) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (res,t with ffi := c)
