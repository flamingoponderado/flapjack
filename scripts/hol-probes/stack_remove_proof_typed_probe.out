stack_remove_comp_stack_asm_name_typed=∀(jump :bool) (off :α word # α word) (k :num) (p :α stackLang$prog). stack_asm_name (c :α asm_config) p ∧ stack_asm_remove c p ∧ addr_offset_ok c (0w :α word) ∧ good_dimindex (:α) ∧ (∀(n :num). n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ c.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)) ∧ (∀(s :store_name). addr_offset_ok c (store_offset s :α word)) ∧ reg_name (k + (2 :num)) c ∧ reg_name (k + (1 :num)) c ∧ reg_name k c ∧ k ≠ (0 :num) ∧ off = c.addr_offset ⇒ stack_asm_name c (comp jump off k p :α stackLang$prog)
stack_remove_stack_asm_name_typed=EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_name (c :α asm_config) p) (prog :(num # α stackLang$prog) list) ∧ EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_remove c p) prog ∧ addr_offset_ok c (0w :α word) ∧ good_dimindex (:α) ∧ (∀(n :num). n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ c.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)) ∧ c.valid_imm (INL Add :binop + cmp) (4w :α word) ∧ c.valid_imm (INL Add :binop + cmp) (8w :α word) ∧ (∀(s :store_name). addr_offset_ok c (store_offset s :α word)) ∧ reg_name (7 :num) c ∧ reg_name ((k :num) + (2 :num)) c ∧ reg_name (k + (1 :num)) c ∧ reg_name k c ∧ k ≠ (0 :num) ⇒ EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_name c p) (compile (jump :bool) c.addr_offset (gen_gc :bool) (max_heap :num) k (start :num) prog :(num # α stackLang$prog) list)
