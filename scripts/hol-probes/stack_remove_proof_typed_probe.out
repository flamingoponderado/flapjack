copy_each_thm_typed=∀(pattern :α word) (i :num) (a :α word) (off :α word) (bs :α word list) (d :α word -> bool) (m :α word -> α word_loc) (dm :α word -> bool) (i1 :num) (a1 :α word) (m1 :α word -> α word_loc) (x :α word) (t :(α, β, γ) stackSem$state). copy_words_for_pattern pattern i a off bs d m = SOME (i1,a1,m1) ∧ ALL_DISTINCT [(1 :num); (2 :num); (3 :num); (t1 :num); (t2 :num)] ∧ dm = t.mdomain ∧ good_dimindex (:α) ∧ (get_var (1 :num) t :α word_loc option) = SOME (Word pattern) ∧ d ⊆ dm ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word a) ∧ (get_var (3 :num) t :α word_loc option) = SOME (Word off) ∧ (get_var t2 t :α word_loc option) = SOME (Word (x + (bytes_in_word :α word) * (n2w i :α word))) ∧ (word_list x (MAP (Word :α word -> α word_loc) bs) * (rest :(α word # α word_loc -> bool) -> bool) * memory m d) (fun2set (t.memory,dm)) ⇒ ∃(ck :num) (y :α word) (m2 :α word -> α word_loc). (evaluate ((copy_each t1 t2 :α stackLang$prog),t with clock := t.clock + ck) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t with <|memory := m2; regs := (if pattern = (1w :α word) then t.regs else t.regs⟨t1 ↦ Word y⟩)⟨t2 ↦ Word (x + (bytes_in_word :α word) * (n2w i1 :α word)); (1 :num) ↦ Word (1w :α word); (2 :num) ↦ Word a1⟩|>) ∧ (word_list x (MAP (Word :α word -> α word_loc) bs) * rest * memory m1 d) (fun2set (m2,dm))
copy_loop_thm_typed=∀(i :num) (a :α word) (off :α word) (bs :α word list) (d :α word -> bool) (m :α word -> α word_loc) (dm :α word -> bool) (i1 :δ) (a1 :α word) (m1 :α word -> α word_loc) (x :α word) (t :(α, β, γ) stackSem$state). copy_words i a off bs d m = SOME (a1,m1) ∧ ALL_DISTINCT [(1 :num); (2 :num); (3 :num); (t1 :num); (t2 :num)] ∧ dm = t.mdomain ∧ good_dimindex (:α) ∧ d ⊆ dm ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word a) ∧ (get_var (3 :num) t :α word_loc option) = SOME (Word off) ∧ (get_var t2 t :α word_loc option) = SOME (Word (x + (bytes_in_word :α word) * (n2w i :α word))) ∧ (word_list x (MAP (Word :α word -> α word_loc) bs) * (rest :(α word # α word_loc -> bool) -> bool) * memory m d) (fun2set (t.memory,dm)) ⇒ ∃(ck :num) (b :bool) (y :α word) (y2 :α word) (m2 :α word -> α word_loc). (evaluate ((copy_loop t1 t2 :α stackLang$prog),t with clock := t.clock + ck) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t with <|memory := m2; regs := (if b then t.regs else t.regs⟨t1 ↦ Word y⟩)⟨t2 ↦ Word y2; (1 :num) ↦ Word (1w :α word); (2 :num) ↦ Word a1⟩|>) ∧ (word_list x (MAP (Word :α word -> α word_loc) bs) * rest * memory m1 d) (fun2set (m2,dm))
state_rel_word_exp_typed=∀(s :(α, β, γ) stackSem$state) (e :α exp) (w :α word). state_rel (jump :bool) (off :α word # α word) (k :num) s (t :(α, β, γ) stackSem$state) ∧ reg_bound_exp e k ∧ (word_exp s e :α word option) = SOME w ⇒ (word_exp t e :α word option) = SOME w
