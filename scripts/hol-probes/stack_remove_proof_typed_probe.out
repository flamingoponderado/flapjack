get_stack_heap_limit_def_typed=∀(max_heap :num) (ptr2 :α word) (ptr3 :α word) (ptr4 :α word). get_stack_heap_limit max_heap (ptr2,ptr3,ptr4) = (let (middle :α word) = ptr2 + (-(1w :α word) * ptr2 + ptr4) ⋙ (shift (:α) + (1 :num)) ≪ shift (:α); (adj_ptr2 :α word) = ptr2 + (bytes_in_word :α word) * (n2w max_stack_alloc :α word); (adj_ptr4 :α word) = ptr4 − (bytes_in_word :α word) * (n2w max_stack_alloc :α word); (adj_ptr3 :α word) = if adj_ptr2 ≤₊ ptr3 ∧ ptr3 ≤₊ adj_ptr4 then ptr3 else middle in get_stack_heap_limit' max_heap ptr2 adj_ptr3 ptr4)
read_pointers_def_typed=∀(s :(α, β, γ) stackSem$state). read_pointers s = (theWord (THE (FLOOKUP s.regs (2 :num))),theWord (THE (FLOOKUP s.regs (3 :num))),theWord (THE (FLOOKUP s.regs (4 :num))))
discharge_these_def_typed=∀(jump :bool) (off :α word # α word) (gen_gc :bool) (max_heap :num) (k :num) (start :num) (coracle :num -> β # (num # α stackLang$prog) list # α word list) (code :(num # α stackLang$prog) list) (s2 :(α, β, γ) stackSem$state). discharge_these jump off gen_gc max_heap k start coracle code s2 ⇔ EVERY (λ((n :num),(p :α stackLang$prog)). reg_bound p k ∧ stack_num_stubs ≤ n + (1 :num)) code ∧ (∀(n :num) (i :num) (p :α stackLang$prog). MEM (i,p) (FST (SND (coracle n))) ⇒ reg_bound p k ∧ stack_num_stubs ≤ i + (1 :num)) ∧ s2.compile_oracle = ((I :β -> β) ## MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) ∘ coracle ∧ s2.code = fromAList (compile jump off gen_gc max_heap k start code :(num # α stackLang$prog) list) ∧ (8 :num) ≤ k ∧ (1 :num) ∈ (domain s2.code :num -> bool) ∧ {k; k + (1 :num); k + (2 :num)} ⊆ s2.ffi_save_regs ∧ ¬s2.use_stack ∧ ¬s2.use_store ∧ ¬s2.use_alloc ∧ max_stack_alloc ≤ max_heap
init_pre_def_typed=∀(gen_gc :bool) (max_heap :num) (bitmaps :α word list) (data_sp :num) (k :num) (start :num) (s :(α, β, γ) stackSem$state). init_pre gen_gc max_heap bitmaps data_sp k start s ⇔ lookup (0 :num) s.code = SOME (Seq (init_code gen_gc max_heap k :α stackLang$prog) (Call (NONE :(α stackLang$prog # num # num # num) option) (INL start :num + num) (NONE :(α stackLang$prog # num # num) option) :α stackLang$prog)) ∧ init_code_pre k bitmaps data_sp s ∧ max_stack_alloc ≤ max_heap
make_init_any_def_typed=∀(gen_gc :bool) (max_heap :num) (bitmaps :α word list) (data_sp :num) (coracle :num -> β # (num # α stackLang$prog) list # α word list) (jump :bool) (off :α word # α word) (k :num) (code :α stackLang$prog sptree$num_map) (s :(α, β, γ) stackSem$state). make_init_any gen_gc max_heap bitmaps data_sp coracle jump off k code s = case make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k code s of (NONE :(α, β, γ) stackSem$state option) => s with <|regs := (FEMPTY :num |-> α word_loc)⟨(0 :num) ↦ (Loc (1 :num) (0 :num) :α word_loc)⟩; fp_regs := (FEMPTY :num |-> word64); mdomain := (∅ :α word -> bool); bitmaps := [(4w :α word)]; use_stack := T; use_store := T; use_alloc := F; stack := [Word (0w :α word)]; stack_space := (0 :num); compile := (λ(c :β) (p :(num # α stackLang$prog) list). (s.compile c (MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) p) :(word8 list # β) option)); compile_oracle := coracle; data_buffer := <|buffer := ([] :α word list); position := (0w :α word); space_left := (0 :num)|>; code_buffer := <|buffer := ([] :word8 list); position := (0w :α word); space_left := (0 :num)|>; code := code; store := (FEMPTY :store_name |-> α word_loc) |++ MAP (λ(x :store_name). (x,Word (0w :α word))) (CurrHeap::store_list)|> | SOME t => t
make_init_opt_def_typed=∀(gen_gc :bool) (max_heap :num) (bitmaps :α word list) (data_sp :num) (coracle :num -> γ # (num # α stackLang$prog) list # α word list) (jump :bool) (off :α word # α word) (k :num) (code :α stackLang$prog sptree$num_map) (s :(α, γ, 'ffi) stackSem$state). make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k code s = case (evaluate ((init_code gen_gc max_heap k :α stackLang$prog),s) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) of ((NONE :α stackSem$result option),t) => if init_prop gen_gc max_heap data_sp (get_stack_heap_limit max_heap (read_pointers s)) (init_reduce gen_gc jump off k code bitmaps data_sp coracle t) then SOME (init_reduce gen_gc jump off k code bitmaps data_sp coracle t) else (NONE :(α, γ, 'ffi) stackSem$state option) | (SOME v2,t) => (NONE :(α, γ, 'ffi) stackSem$state option)
propagate_these_def_typed=∀(s :(α, β, γ) stackSem$state) (bitmaps :α word list) (data_sp :num). propagate_these s bitmaps data_sp ⇔ good_dimindex (:α) ∧ ∃(ptr2 :α word) (ptr3 :α word) (ptr4 :α word) (bitmap_ptr :α word). FLOOKUP s.regs (2 :num) = SOME (Word ptr2) ∧ FLOOKUP s.regs (3 :num) = SOME (Word ptr3) ∧ FLOOKUP s.regs (4 :num) = SOME (Word ptr4) ∧ s.memory ptr2 = Word bitmap_ptr ∧ s.memory (ptr2 + (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ s.memory (ptr2 + (2w :α word) * (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word) + (bytes_in_word :α word) * (n2w data_sp :α word)) ∧ s.memory (ptr2 + (3w :α word) * (bytes_in_word :α word)) = Word s.code_buffer.position ∧ s.memory (ptr2 + (4w :α word) * (bytes_in_word :α word)) = Word (s.code_buffer.position + (n2w s.code_buffer.space_left :α word)) ∧ s.code_buffer.buffer = ([] :word8 list) ∧ ptr2 ≤₊ ptr4 ∧ byte_aligned ptr2 ∧ byte_aligned ptr4 ∧ byte_aligned bitmap_ptr ∧ (1024w :α word) * (bytes_in_word :α word) ≤₊ ptr4 − ptr2 ∧ (word_list bitmap_ptr (MAP (Word :α word -> α word_loc) bitmaps) * (word_list_exists (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) data_sp :(α word # α word_loc -> bool) -> bool) * (word_list_exists ptr2 (w2n (-(1w :α word) * ptr2 + ptr4) DIV w2n (bytes_in_word :α word)) :(α word # α word_loc -> bool) -> bool)) (fun2set (s.memory,s.mdomain))
init_prop_def_typed=∀(gen_gc :bool) (max_heap :num) (data_sp :num) (stack_heap_lim :num # num) (s :(α, γ, 'ffi) stackSem$state). init_prop gen_gc max_heap data_sp stack_heap_lim s ⇔ ∃(curr :α word) (other :α word) (bitmap_base :α word) (len :num). FLOOKUP s.store CurrHeap = SOME (Word curr) ∧ FLOOKUP s.store NextFree = SOME (Word curr) ∧ FLOOKUP s.store TriggerGC = SOME (Word (if gen_gc then curr else other)) ∧ FLOOKUP s.store EndOfHeap = SOME (Word other) ∧ FLOOKUP s.store OtherHeap = SOME (Word other) ∧ FLOOKUP s.store BitmapBase = SOME (Word bitmap_base) ∧ FLOOKUP s.store HeapLength = SOME (Word ((n2w len :α word) * (bytes_in_word :α word))) ∧ FLOOKUP s.store ProgStart = SOME (Word (0w :α word)) ∧ FLOOKUP s.store AllocSize = SOME (Word (0w :α word)) ∧ FLOOKUP s.store Globals = SOME (Word (0w :α word)) ∧ FLOOKUP s.store GlobReal = SOME (Word curr) ∧ FLOOKUP s.store Handler = SOME (Word (0w :α word)) ∧ FLOOKUP s.store GenStart = SOME (Word (0w :α word)) ∧ FLOOKUP s.store CodeBuffer = SOME (Word s.code_buffer.position) ∧ FLOOKUP s.store CodeBufferEnd = SOME (Word (s.code_buffer.position + (n2w s.code_buffer.space_left :α word))) ∧ FLOOKUP s.store BitmapBuffer = SOME (Word s.data_buffer.position) ∧ FLOOKUP s.store BitmapBufferEnd = SOME (Word (s.data_buffer.position + (bytes_in_word :α word) * (n2w s.data_buffer.space_left :α word))) ∧ stack_heap_limit_ok s stack_heap_lim ∧ s.code_buffer.buffer = ([] :word8 list) ∧ s.data_buffer.buffer = ([] :α word list) ∧ s.use_stack ∧ s.use_store ∧ FLOOKUP s.regs (0 :num) = SOME (Loc (1 :num) (0 :num) :α word_loc) ∧ LENGTH s.bitmaps + data_sp + (1 :num) < dimword (:α) ∧ LENGTH s.stack < dimword (:α) ∧ other = curr + (bytes_in_word :α word) * (n2w len :α word) ∧ byte_aligned curr ∧ LAST s.stack = Word (0w :α word) ∧ LENGTH s.stack = SUC s.stack_space ∧ LENGTH s.stack * (dimindex (:α) DIV (8 :num)) < dimword (:α) ∧ len + len ≤ max_heap ∧ ((word_list_exists curr len :(α word # α word_loc -> bool) -> bool) * (word_list_exists other len :(α word # α word_loc -> bool) -> bool)) (fun2set (s.memory,s.mdomain))
init_reduce_def_typed=∀(gen_gc :bool) (jump :bool) (off :α word # α word) (k :num) (code :α stackLang$prog sptree$num_map) (bitmaps :α word list) (data_sp :num) (coracle :num -> γ # (num # α stackLang$prog) list # α word list) (s :(α, γ, 'ffi) stackSem$state). init_reduce gen_gc jump off k code bitmaps data_sp coracle s = (let (heap_ptr :α word) = theWord s.regs⟨k + (2 :num)⟩; (bitmap_ptr :α word) = theWord s.regs⟨(3 :num)⟩ ≪ shift (:α); (stack_ptr :α word) = theWord s.regs⟨k⟩; (base_ptr :α word) = theWord s.regs⟨k + (1 :num)⟩; (heap_sp :num) = w2n (base_ptr − heap_ptr) DIV (dimindex (:α) DIV (8 :num)) − LENGTH store_list; (stack_sp :num) = w2n (stack_ptr − base_ptr) DIV (dimindex (:α) DIV (8 :num)) in s with <|use_stack := T; use_store := T; use_alloc := F; mdomain := addresses heap_ptr heap_sp; bitmaps := bitmaps; code := code; compile := (λ(c :γ) (p :(num # α stackLang$prog) list). (s.compile c (MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) p) :(word8 list # γ) option)); compile_oracle := coracle; data_buffer := <|buffer := ([] :α word list); position := bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word); space_left := data_sp|>; stack_space := stack_sp; stack := read_mem base_ptr s.memory (stack_sp + (1 :num)); store := (FEMPTY :store_name |-> α word_loc) |++ MAP (λ(n :store_name). case (store_init gen_gc k n :α word + num) of (INL w :α word + num) => (n,Word w) | (INR i :α word + num) => (n,s.regs⟨i⟩)) (CurrHeap::store_list)|>)
evaluate_init_code_typed=init_pre (gen_gc :bool) (max_heap :num) (bitmaps :α word list) (data_sp :num) (k :num) (start :num) (s :(α, β, γ) stackSem$state) ∧ s.compile_oracle = ((I :β -> β) ## MAP (prog_comp (jump :bool) (off :α word # α word) k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) ∘ (coracle :num -> β # (num # α stackLang$prog) list # α word list) ∧ (∀(n :num) (i :num) (p :α stackLang$prog). MEM (i,p) (FST (SND (coracle n))) ⇒ reg_bound p k ∧ stack_num_stubs ≤ i + (1 :num)) ∧ lookup stack_err_lab s.code = SOME (halt_inst (2w :α word)) ∧ code_rel jump off k (code :α stackLang$prog sptree$num_map) s.code ⇒ case (evaluate ((init_code gen_gc max_heap k :α stackLang$prog),s) :α stackSem$result option # (α, β, γ) stackSem$state) of ((NONE :α stackSem$result option),t) => ∃(r :(α, β, γ) stackSem$state). make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k code s = SOME r ∧ state_rel jump off k r t ∧ t.ffi = s.ffi | (SOME v5,t) => F
init_semantics_typed=lookup stack_err_lab (s :(α, β, γ) stackSem$state).code = SOME (halt_inst (2w :α word)) ∧ code_rel (jump :bool) (off :α word # α word) (k :num) (code :α stackLang$prog sptree$num_map) s.code ∧ init_pre (gen_gc :bool) (max_heap :num) (bitmaps :α word list) (data_sp :num) k (start :num) s ∧ s.compile_oracle = ((I :β -> β) ## MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) ∘ (coracle :num -> β # (num # α stackLang$prog) list # α word list) ∧ (∀(n :num) (i :num) (p :α stackLang$prog). MEM (i,p) (FST (SND (coracle n))) ⇒ reg_bound p k ∧ stack_num_stubs ≤ i + (1 :num)) ⇒ case (evaluate ((init_code gen_gc max_heap k :α stackLang$prog),s) :α stackSem$result option # (α, β, γ) stackSem$state) of ((NONE :α stackSem$result option),t) => (semantics (0 :num) s :behaviour) = (semantics start t :behaviour) ∧ ∃(r :(α, β, γ) stackSem$state). make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k code s = SOME r ∧ state_rel jump off k r t | (SOME v5,t) => F
make_init_opt_SOME_semantics_typed=init_pre (gen_gc :bool) (max_heap :num) (bitmaps :α word list) (data_sp :num) (k :num) (start :num) (s2 :(α, β, γ) stackSem$state) ∧ s2.compile_oracle = ((I :β -> β) ## MAP (prog_comp (jump :bool) (off :α word # α word) k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) ∘ (coracle :num -> β # (num # α stackLang$prog) list # α word list) ∧ (∀(n :num) (i :num) (p :α stackLang$prog). MEM (i,p) (FST (SND (coracle n))) ⇒ reg_bound p k ∧ stack_num_stubs ≤ i + (1 :num)) ∧ code_rel jump off k (code :α stackLang$prog sptree$num_map) s2.code ∧ lookup stack_err_lab s2.code = SOME (halt_inst (2w :α word)) ⇒ ∃(s1 :(α, β, γ) stackSem$state). make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k code s2 = SOME s1 ∧ ((semantics start s1 :behaviour) ≠ Fail ⇒ (semantics (0 :num) s2 :behaviour) = (semantics start s1 :behaviour))
make_init_semantics_typed=discharge_these (jump :bool) (off :α word # α word) (gen_gc :bool) (max_heap :num) (k :num) (start :num) (coracle :num -> β # (num # α stackLang$prog) list # α word list) (code :(num # α stackLang$prog) list) (s2 :(α, β, γ) stackSem$state) ∧ propagate_these s2 (bitmaps :α word list) (data_sp :num) ⇒ ∃(s1 :(α, β, γ) stackSem$state). make_init_opt gen_gc max_heap bitmaps data_sp coracle jump off k (fromAList code) s2 = SOME s1 ∧ ((semantics start s1 :behaviour) ≠ Fail ⇒ (semantics (0 :num) s2 :behaviour) = (semantics start s1 :behaviour))
state_rel_inst_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ reg_bound_inst (i :α inst) k ∧ inst i s = SOME (s' :(α, β, γ) stackSem$state) ⇒ ∃(t' :(α, β, γ) stackSem$state). inst i t = SOME t' ∧ state_rel jump off k s' t'
stack_remove_lab_pres_typed=∀(jump :bool) (off :α word # α word) (k :num) (p :α stackLang$prog). extract_labels p = extract_labels (comp jump off k p :α stackLang$prog)
code_rel_loc_check_typed=code_rel (jump :bool) (off :α word # α word) (k :num) (c1 :α stackLang$prog sptree$num_map) (c2 :α stackLang$prog sptree$num_map) ∧ loc_check c1 ((l1 :num),(l2 :num)) ⇒ loc_check c2 (l1,l2)
get_labels_comp_typed=∀(jump :bool) (off :α word # α word) (k :num) (e :α stackLang$prog). get_labels (comp jump off k e :α stackLang$prog) = get_labels e
mem_val_def_typed=(∀(regs :num |-> α word_loc) (w :α word). mem_val regs (INL w :α word + num) = Word w) ∧ ∀(regs :num |-> α word_loc) (n :num). mem_val regs (INR n :α word + num) = regs⟨n⟩
memory_def_typed=∀(m :α -> β) (dm :α -> bool). memory m dm = (λ(s :α # β -> bool). s = fun2set (m,dm))
state_rel_mem_load_imp_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ mem_load (x :α word) s = SOME (w :α word_loc) ⇒ mem_load x t = SOME w
state_rel_mem_store_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ mem_store (x :α word) (y :α word_loc) s = SOME (s' :(α, β, γ) stackSem$state) ∧ mem_store x y t = SOME (t' :(α, β, γ) stackSem$state) ⇒ state_rel jump off k s' t'
state_rel_mem_store_32_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ mem_store_32 s.memory s.mdomain s.be (a :α word) (b :word32) = SOME (z :α word -> α word_loc) ⇒ ∃(y :α word -> α word_loc). mem_store_32 t.memory t.mdomain t.be a b = SOME y ∧ state_rel jump off k (s with memory := z) (t with memory := y)
state_rel_mem_store_byte_aux_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ mem_store_byte_aux s.memory s.mdomain s.be (a :α word) (b :word8) = SOME (z :α word -> α word_loc) ⇒ ∃(y :α word -> α word_loc). mem_store_byte_aux t.memory t.mdomain t.be a b = SOME y ∧ state_rel jump off k (s with memory := z) (t with memory := y)
memory_fun2set_SUBSET_typed=(memory (m1 :α -> β) (d1 :α -> bool) * (rest :(α # β -> bool) -> bool)) (fun2set ((m2 :α -> β),(d2 :α -> bool))) ⇒ d1 ⊆ d2
memory_write_typed=(x :α) ∈ (sd :α -> bool) ∧ x ∈ (dm :α -> bool) ∧ (memory (sm :α -> β) sd * (p :(α # β -> bool) -> bool)) (fun2set ((m :α -> β),dm)) ⇒ (memory sm⦇x ↦ (y :β)⦈ sd * p) (fun2set (m⦇x ↦ y⦈,dm))
prog_comp_eta_typed=(prog_comp :bool -> α word # α word -> num -> β # α stackLang$prog -> β # α stackLang$prog) = (λ(jump :bool) (off :α word # α word) (k :num) ((n :β),(p :α stackLang$prog)). (n,(comp jump off k p :α stackLang$prog)))
state_rel_const_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ⇒ t.code_buffer = s.code_buffer ∧ t.sh_mdomain = s.sh_mdomain ∧ ¬t.use_stack ∧ s.use_stack ∧ t.ffi = s.ffi ∧ t.compile_oracle = (λ(n :num). ((I :β -> β) ## MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) (s.compile_oracle n :β # (num # α stackLang$prog) list # α word list)) ∧ s.compile = (λ(c :β) (p :(num # α stackLang$prog) list). (t.compile c (MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) p) :(word8 list # β) option))
evaluate_single_stack_alloc_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state) ∧ ((r :α stackSem$result option),(s2 :(α, β, γ) stackSem$state)) = (if s.stack_space < (n :num) then (SOME (Halt (Word (2w :α word)) :α stackSem$result),empty_env s) else ((NONE :α stackSem$result option),s with stack_space := s.stack_space − n)) ∧ n ≠ (0 :num) ∧ n ≤ max_stack_alloc ⇒ ∃(ck :num) (t2 :(α, β, γ) stackSem$state). (evaluate ((single_stack_alloc jump k n :α stackLang$prog),t1 with clock := t1.clock + ck) :α stackSem$result option # (α, β, γ) stackSem$state) = (r,t2) ∧ if s.stack_space < n then t2.ffi = s2.ffi else state_rel jump off k s2 t2
evaluate_stack_alloc_typed=∀(jump :bool) (k :num) (n :num) (r :α stackSem$result option) (s :(α, β, γ) stackSem$state) (s2 :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state). (evaluate ((StackAlloc n :α stackLang$prog),s) :α stackSem$result option # (α, β, γ) stackSem$state) = (r,s2) ∧ r ≠ SOME (Error :α stackSem$result) ∧ state_rel jump (off :α word # α word) k s t1 ⇒ ∃(ck :num) (t2 :(α, β, γ) stackSem$state). (evaluate ((stack_alloc jump k n :α stackLang$prog),t1 with clock := ck + t1.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (r,t2) ∧ if ∀(w :α word_loc). r ≠ SOME (Halt w :α stackSem$result) then state_rel jump off k s2 t2 else t2.ffi = s2.ffi
evaluate_single_stack_free_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state) ∧ ((r :α stackSem$result option),(s2 :(α, β, γ) stackSem$state)) = ((NONE :α stackSem$result option),s with stack_space := s.stack_space + (n :num)) ∧ ¬(LENGTH s.stack < s.stack_space + n) ∧ n ≠ (0 :num) ∧ n ≤ max_stack_alloc ⇒ ∃(ck :num) (t2 :(α, β, γ) stackSem$state). (evaluate ((single_stack_free k n :α stackLang$prog),t1 with clock := t1.clock + ck) :α stackSem$result option # (α, β, γ) stackSem$state) = (r,t2) ∧ state_rel jump off k s2 t2
evaluate_stack_free_typed=∀(k :num) (n :num) (r :α stackSem$result option) (s :(α, β, γ) stackSem$state) (s2 :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state). (evaluate ((StackFree n :α stackLang$prog),s) :α stackSem$result option # (α, β, γ) stackSem$state) = (r,s2) ∧ r ≠ SOME (Error :α stackSem$result) ∧ state_rel (jump :bool) (off :α word # α word) k s t1 ⇒ ∃(ck :num) (t2 :(α, β, γ) stackSem$state). (evaluate ((stack_free k n :α stackLang$prog),t1 with clock := ck + t1.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (r,t2) ∧ state_rel jump off k s2 t2
word_list_APPEND_typed=∀(xs :α list) (ys :α list) (a :β word). word_list a (xs ++ ys) = word_list a xs * word_list (a + (bytes_in_word :β word) * (n2w (LENGTH xs) :β word)) ys
stack_heap_limit_ok_def_typed=∀(t :(α, β, γ) stackSem$state) (stack_lim :num) (heap_lim :num). stack_heap_limit_ok t (stack_lim,heap_lim) ⇔ FLOOKUP t.store HeapLength = SOME (Word ((n2w heap_lim :α word) * (bytes_in_word :α word))) ∧ heap_lim * (dimindex (:α) DIV (8 :num)) < dimword (:α) ∧ stack_lim = LENGTH t.stack
stack_write_typed=∀(stack :α list) (base :β word) (p :(β word # α -> bool) -> bool) (m :β word -> α) (d :β word -> bool) (a :num) (v :α). (word_list base stack * p) (fun2set (m,d)) ∧ a < LENGTH stack ⇒ (word_list base stack❲a ↦ v❳ * p) (fun2set (m⦇base + (bytes_in_word :β word) * (n2w a :β word) ↦ v⦈,d))
state_rel_stack_store_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ (st :α word_loc list) = s.stack ∧ FLOOKUP t.regs k = SOME (Word (b :α word)) ∧ s.stack_space + (n :num) < LENGTH st ∧ b + (bytes_in_word :α word) * (n2w n :α word) = (a :α word) ⇒ state_rel jump off k (s with stack := st❲n + s.stack_space ↦ (x :α word_loc)❳) (t with memory := t.memory⦇a ↦ x⦈)
state_rel_get_var_k_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ⇒ ∃(c :α word). (get_var (k + (1 :num)) t :α word_loc option) = SOME (Word c) ∧ dimindex (:α) DIV (8 :num) * max_stack_alloc ≤ w2n c ∧ w2n c + w2n (bytes_in_word :α word) * LENGTH s.stack < dimword (:α) ∧ (get_var k t :α word_loc option) = SOME (Word (c + (bytes_in_word :α word) * (n2w s.stack_space :α word))) ∧ (memory s.memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP (Word :α word -> α word_loc) s.bitmaps ++ MAP (Word :α word -> α word_loc) s.data_buffer.buffer) * (word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + (bytes_in_word :α word) * (n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps) :α word)) s.data_buffer.space_left :(α word # α word_loc -> bool) -> bool) * word_store c s.store * word_list c s.stack) (fun2set (t.memory,t.mdomain))
state_rel_def_typed=∀(jump :bool) (off :α word # α word) (k :num) (s1 :(α, γ, 'ffi) stackSem$state) (s2 :(α, γ, 'ffi) stackSem$state). state_rel jump off k s1 s2 ⇔ s1.use_stack ∧ s1.use_store ∧ ¬s2.use_stack ∧ ¬s2.use_store ∧ ¬s2.use_alloc ∧ ¬s1.use_alloc ∧ (s2.be ⇔ s1.be) ∧ s2.gc_fun = s1.gc_fun ∧ s2.clock = s1.clock ∧ s2.ffi = s1.ffi ∧ s2.ffi_save_regs = s1.ffi_save_regs ∧ s2.fp_regs = s1.fp_regs ∧ s2.code_buffer = s1.code_buffer ∧ s2.sh_mdomain = s1.sh_mdomain ∧ s1.compile = (λ(c :γ) (p :(num # α stackLang$prog) list). (s2.compile c (MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) p) :(word8 list # γ) option)) ∧ s2.compile_oracle = (λ(n :num). ((I :γ -> γ) ## MAP (prog_comp jump off k :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) (s1.compile_oracle n :γ # (num # α stackLang$prog) list # α word list)) ∧ (∀(n :num) (i :num) (p :α stackLang$prog). MEM (i,p) (FST (SND (s1.compile_oracle n :γ # (num # α stackLang$prog) list # α word list))) ⇒ reg_bound p k ∧ stack_num_stubs ≤ i + (1 :num)) ∧ good_dimindex (:α) ∧ (∀(n :num). n < k ⇒ FLOOKUP s2.regs n = FLOOKUP s1.regs n) ∧ code_rel jump off k s1.code s2.code ∧ lookup stack_err_lab s2.code = SOME (halt_inst (2w :α word)) ∧ FLOOKUP s2.regs (k + (2 :num)) = FLOOKUP s1.store CurrHeap ∧ {k; k + (1 :num); k + (2 :num)} ⊆ s2.ffi_save_regs ∧ is_SOME_Word (FLOOKUP s1.store BitmapBase) ∧ s1.stack_space ≤ LENGTH s1.stack ∧ (let (bp :α word) = the_SOME_Word (FLOOKUP s1.store BitmapBase) ≪ shift (:α); (all_bitmaps :α word list) = s1.bitmaps ++ s1.data_buffer.buffer in s1.data_buffer.position = bp + (bytes_in_word :α word) * (n2w (LENGTH s1.bitmaps) :α word) ∧ case FLOOKUP s2.regs (k + (1 :num)) of (NONE :α word_loc option) => F | SOME (Word base) => dimindex (:α) DIV (8 :num) * max_stack_alloc ≤ w2n base ∧ w2n base + w2n (bytes_in_word :α word) * LENGTH s1.stack < dimword (:α) ∧ FLOOKUP s2.regs k = SOME (Word (base + (bytes_in_word :α word) * (n2w s1.stack_space :α word))) ∧ (memory s1.memory s1.mdomain * word_list bp (MAP (Word :α word -> α word_loc) all_bitmaps) * (word_list_exists (bp + (bytes_in_word :α word) * (n2w (LENGTH all_bitmaps) :α word)) s1.data_buffer.space_left :(α word # α word_loc -> bool) -> bool) * word_store base s1.store * word_list base s1.stack) (fun2set (s2.memory,s2.mdomain)) | SOME (Loc v6 v7 :α word_loc) => F)
state_rel_set_var_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state) ∧ (v :num) < k ⇒ state_rel jump off k (set_var v (x :α word_loc) s) (set_var v x t1)
store_list_code_thm_typed=∀(xs :(α word + num) list) (s :(α, β, γ) stackSem$state) (w :α word) (frame :(α word # α word_loc -> bool) -> bool) (ys :α word_loc list) (m :α word -> α word_loc) (dm :α word -> bool). (word_list w ys * frame) (fun2set (m,dm)) ∧ m = s.memory ∧ dm = s.mdomain ∧ LENGTH ys = LENGTH xs ∧ (a :num) ≠ (t :num) ∧ (get_var a s :α word_loc option) = SOME (Word w) ∧ t ∈ FDOM s.regs ∧ EVERY (λ(x :α word + num). ∀(n :num). (INR n :α word + num) = x ⇒ n ≠ a ∧ n ≠ t ∧ n ∈ FDOM s.regs) xs ⇒ ∃(r1 :α word_loc) (m1 :α word -> α word_loc). (word_list w (MAP (mem_val s.regs) xs) * frame) (fun2set (m1,s.mdomain)) ∧ (evaluate (store_list_code a t xs,s) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),s with <|memory := m1; regs := s.regs |++ [(a,Word (w + (bytes_in_word :α word) * (n2w (LENGTH xs) :α word))); (t,r1)]|>)
bytes_in_word_word_shift_typed=good_dimindex (:α) ∧ w2n (bytes_in_word :α word) * w2n (n :α word) < dimword (:α) ⇒ ((bytes_in_word :α word) * n) ⋙ shift (:α) = n
lsl_word_shift_typed=good_dimindex (:α) ⇒ (w :α word) ≪ shift (:α) = w * (bytes_in_word :α word)
word_offset_eq_typed=(word_offset (n :num) :α word) = (bytes_in_word :α word) * (n2w n :α word)
word_list_exists_thm_typed=(word_list_exists (a :α word) (0 :num) :(α word # β -> bool) -> bool) = (emp :(α word # β -> bool) -> bool) ∧ (word_list_exists a (SUC (n :num)) :(α word # γ -> bool) -> bool) = SEP_EXISTS(w :γ). (one (a,w) :(α word # γ -> bool) -> bool) * (word_list_exists (a + (bytes_in_word :α word)) n :(α word # γ -> bool) -> bool)
word_list_inj_typed=∀(xs :α list) (a :β word) (u :β word # α -> bool) (u' :β word # α -> bool). word_list a xs u ∧ word_list a xs u' ⇒ u = u'
word_list_EL_in_memory_typed=good_dimindex (:α) ∧ w2n (a :α word) + LENGTH (xs :β list) * w2n (bytes_in_word :α word) < dimword (:α) ∧ ((r1 :(α word # β -> bool) -> bool) * word_list a xs * (r2 :(α word # β -> bool) -> bool)) (fun2set ((m :α word -> β),(dm :α word -> bool))) ∧ (i :num) < LENGTH xs ⇒ m (a + (n2w i :α word) * (bytes_in_word :α word)) = xs❲i❳
word_list_exists_ADD_typed=∀(m :num) (n :num) (a :α word). (word_list_exists a (m + n) :(α word # β -> bool) -> bool) = (word_list_exists a m :(α word # β -> bool) -> bool) * (word_list_exists (a + (bytes_in_word :α word) * (n2w m :α word)) n :(α word # β -> bool) -> bool)
word_list_exists_addresses_typed=∀(n :num) (a :α word). dimindex (:α) DIV (8 :num) * n < dimword (:α) ∧ good_dimindex (:α) ⇒ word_list_exists a n (fun2set ((m1 :α word -> β),addresses a n))
word_list_in_memory_typed=((r1 :(α word # β -> bool) -> bool) * word_list (a :α word) (xs :β list) * (r2 :(α word # β -> bool) -> bool)) (fun2set ((m :α word -> β),(dm :α word -> bool))) ∧ good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n (bytes_in_word :α word) < dimword (:α) ⇒ memory m (addresses a (LENGTH xs)) = word_list a xs
word_list_set_typed=∀(xs :β list) (a :α word). good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n (bytes_in_word :α word) < dimword (:α) ⇒ word_list a xs (set (GENLIST (λ(i :num). (a + (n2w i :α word) * (bytes_in_word :α word),xs❲i❳)) (LENGTH xs)))
word_list_seteq_typed=∀(xs :β list) (a :α word). good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n (bytes_in_word :α word) < dimword (:α) ⇒ word_list a xs = (λ(s :α word # β -> bool). s = set (GENLIST (λ(i :num). (a + (n2w i :α word) * (bytes_in_word :α word),xs❲i❳)) (LENGTH xs)))
word_list_wrap_typed=good_dimindex (:α) ∧ dimword (:α) DIV (dimindex (:α) DIV (8 :num)) < LENGTH (ls :β list) ⇒ ∃(x :β) (xs :β list) (y :β) (ys :β list) (b :α word). word_list (a :α word) ls = word_list a (x::xs) * word_list b (y::ys) ∧ b = a
word_list_rev_def_typed=(∀(a :α word). word_list_rev a ([] :β list) = (emp :(α word # β -> bool) -> bool)) ∧ ∀(a :α word) (x :β) (xs :β list). word_list_rev a (x::xs) = (one (a − (bytes_in_word :α word),x) :(α word # β -> bool) -> bool) * word_list_rev (a − (bytes_in_word :α word)) xs
word_list_EQ_rev_typed=∀(xs :α list) (a :β word). word_list a xs = word_list_rev (a + (n2w (LENGTH xs) :β word) * (bytes_in_word :β word)) (REVERSE xs)
word_store_def_typed=∀(base :α word) (store :store_name |-> β word_loc). word_store base store = word_list_rev base (MAP (λ(name :store_name). case FLOOKUP store name of (NONE :β word_loc option) => Word (0w :β word) | SOME x => x) store_list)
