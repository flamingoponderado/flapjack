mmio_full_def=∀ffi_names. mmio_pcs_min_index ffi_names = some x. x ≤ LENGTH ffi_names ∧ (∀j. j < x ⇒ ∃s. ffi_names❲j❳ = ExtCall s) ∧ ∀j. x ≤ j ∧ j < LENGTH ffi_names ⇒ ∃op. ffi_names❲j❳ = SharedMem op
