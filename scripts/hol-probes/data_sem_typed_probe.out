result),s) else case cut_env names s.locals of (NONE :v sptree$num_map option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME env => (let (s1 :(γ, 'ffi) state) = call_env args1 ss (push_env env (IS_SOME handler) (dec_clock s :(γ, 'ffi) state)) in if s.clock = (0 :num) then (SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s1 with <|stack := ([] :stack list); locals := (LN :v sptree$num_map)|>) else case (evaluate (prog,s1) :(v list, v) result option # (γ, 'ffi) state) of ((NONE :(v list, v) result option),s2) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s2) | (SOME (Rval xs' :(v list, v) result),s2) => if LENGTH xs' = LENGTH ns then case pop_env s2 of (NONE :(γ, 'ffi) state option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s2) | SOME s1 => ((NONE :(v list, v) result option),set_vars ns xs' s1) else (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s2) | (SOME (Rerr (Rraise x) :(v list, v) result),s2) => (case handler of (NONE :(num # dataLang$prog) option) => (SOME (Rerr (Rraise x) :(v list, v) result),s2) | SOME (n,h) => (evaluate (h,set_var n x s2) :(v list, v) result option # (γ, 'ffi) state)) | (SOME (Rerr (Rabort v14 :v error_result) :(v list, v) result),s2) => (SOME (Rerr (Rabort v14 :v error_result) :(v list, v) result),s2))
finalise_cons_def_typed=(∀(ts :num option) (refs :v ref sptree$num_map) (ptr :num) (b :bool). finalise_cons (RefPtr b ptr :v) refs ts = case (lookup ptr refs :v ref option) of (NONE :v ref option) => (NONE :(v # v ref sptree$num_map # num option) option) | SOME (ValueArray v13 :v ref) => SOME ((RefPtr b ptr :v),refs,ts) | SOME (ByteArray v14 v15 :v ref) => SOME ((RefPtr b ptr :v),refs,ts) | SOME (Thunk v16 v17 :v ref) => SOME ((RefPtr b ptr :v),refs,ts) | SOME (MutBlock tag finalised l c r) => if ¬finalised then case finalise_cons c (delete ptr refs :v ref sptree$num_map) ts of (NONE :(v # v ref sptree$num_map # num option) option) => (NONE :(v # v ref sptree$num_map # num option) option) | SOME (c',refs',ts') => SOME ((Block (case ts' of (NONE :num option) => (0 :num) | SOME n => n) tag (l ++ [c'] ++ r) :v),(insert ptr (MutBlock tag T l c r) refs' :v ref sptree$num_map),OPTION_MAP SUC ts') else (NONE :(v # v ref sptree$num_map # num option) option)) ∧ (∀(v7 :int) (ts :num option) (refs :v ref sptree$num_map). finalise_cons (Number v7 :v) refs ts = SOME ((Number v7 :v),refs,ts)) ∧ (∀(v8 :word64) (ts :num option) (refs :v ref sptree$num_map). finalise_cons (Word64 v8 :v) refs ts = SOME ((Word64 v8 :v),refs,ts)) ∧ (∀(v9 :num) (v11 :v list) (v10 :num) (ts :num option) (refs :v ref sptree$num_map). finalise_cons (Block v9 v10 v11 :v) refs ts = SOME ((Block v9 v10 v11 :v),refs,ts)) ∧ ∀(v12 :num) (ts :num option) (refs :v ref sptree$num_map). finalise_cons (CodePtr v12 :v) refs ts = SOME ((CodePtr v12 :v),refs,ts)
add_space_def_typed=∀(s :(γ, 'ffi) state) (k :num). add_space s k = s with <|space := k; safe_for_space := add_space_safe k s; peak_heap_length := heap_peak k s|>
bignum_digits_def_typed=∀(n :num) (arch64 :bool). bignum_digits arch64 n = if n = (0 :num) then (0 :num) else (let (d :num) = if arch64 then (64 :num) else (32 :num) in (1 :num) + bignum_digits arch64 (n DIV (2 :num) ** d))
bignum_size_def_typed=∀(arch64 :bool) (i :int). bignum_size arch64 i = (1 :num) + bignum_digits arch64 (Num (ABS i))
check_res_def_typed=∀(r :β sptree$num_map) (n :α) (refs :β sptree$num_map) (seen :γ). check_res r (n,refs,seen) = if size refs ≤ size r then (n,refs,seen) else (n,r,seen)
