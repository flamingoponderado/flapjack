evaluate_def_typed=(∀(s :(γ, 'ffi) state). (evaluate (Skip,s) :(v list, v) result option # (γ, 'ffi) state) = ((NONE :(v list, v) result option),s)) ∧ (∀(src :num) (s :(γ, 'ffi) state) (dest :num). (evaluate ((Move dest src :dataLang$prog),s) :(v list, v) result option # (γ, 'ffi) state) = case (get_var src s.locals :v option) of (NONE :v option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME v => ((NONE :(v list, v) result option),set_var dest v s)) ∧ (∀(s :(γ, 'ffi) state) (op :closLang$op) (names_opt :sptree$num_set option) (dest :num) (args :num list). (evaluate ((Assign dest op args names_opt :dataLang$prog),s) :(v list, v) result option # (γ, 'ffi) state) = if op_requires_names op ⇔ IS_NONE names_opt then (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) else case get_vars args s.locals of (NONE :v list option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME xs => case cut_state_opt names_opt s of (NONE :(γ, 'ffi) state option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME v => case (do_app op xs v :(v # (γ, 'ffi) state, v) result) of (Rval (v3,v4) :(v # (γ, 'ffi) state, v) result) => ((NONE :(v list, v) result option),set_var dest v3 (install_sfs op v4)) | (Rerr e :(v # (γ, 'ffi) state, v) result) => (SOME (Rerr e :(v list, v) result),flush_state T (install_sfs op v))) ∧ (∀(s :(γ, 'ffi) state). (evaluate (Tick,s) :(v list, v) result option # (γ, 'ffi) state) = if s.clock = (0 :num) then (SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),flush_state T s) else ((NONE :(v list, v) result option),(dec_clock s :(γ, 'ffi) state))) ∧ (∀(s :(γ, 'ffi) state) (names :sptree$num_set) (k :num). (evaluate (MakeSpace k names,s) :(v list, v) result option # (γ, 'ffi) state) = case cut_env names s.locals of (NONE :v sptree$num_map option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME env => ((NONE :(v list, v) result option),add_space (s with locals := env) k)) ∧ (∀(s :(γ, 'ffi) state) (n :num). (evaluate ((Raise n :dataLang$prog),s) :(v list, v) result option # (γ, 'ffi) state) = case (get_var n s.locals :v option) of (NONE :v option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME x => case jump_exc s of (NONE :(γ, 'ffi) state option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME v => (SOME (Rerr (Rraise x) :(v list, v) result),v)) ∧ (∀(s :(γ, 'ffi) state) (ns :num list). (evaluate ((Return ns :dataLang$prog),s) :(v list, v) result option # (γ, 'ffi) state) = case get_vars ns s.locals of (NONE :v list option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME xs => (SOME (Rval xs :(v list, v) result),flush_state F s)) ∧ (∀(s :(γ, 'ffi) state) (c2 :dataLang$prog) (c1 :dataLang$prog). (evaluate (Seq c1 c2,s) :(v list, v) result option # (γ, 'ffi) state) = (let ((res :(v list, v) result option),(s1 :(γ, 'ffi) state)) = (evaluate (c1,s) :(v list, v) result option # (γ, 'ffi) state) in if res = (NONE :(v list, v) result option) then (evaluate (c2,s1) :(v list, v) result option # (γ, 'ffi) state) else (res,s1))) ∧ (∀(s :(γ, 'ffi) state) (n :num) (c2 :dataLang$prog) (c1 :dataLang$prog). (evaluate ((If n c1 c2 :dataLang$prog),s) :(v list, v) result option # (γ, 'ffi) state) = case (get_var n s.locals :v option) of (NONE :v option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME x => if isBool T x then (evaluate (c1,s) :(v list, v) result option # (γ, 'ffi) state) else if isBool F x then (evaluate (c2,s) :(v list, v) result option # (γ, 'ffi) state) else (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s)) ∧ (∀(src :num) (s :(γ, 'ffi) state) (ret :(num # sptree$num_set) option) (loc :num). (evaluate ((Force ret loc src :dataLang$prog),s) :(v list, v) result option # (γ, 'ffi) state) = case (get_var src s.locals :v option) of (NONE :v option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME thunk_v => case (dest_thunk thunk_v s.refs :dest_thunk_ret) of BadRef => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | NotThunk => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | (IsThunk Evaluated v :dest_thunk_ret) => (case ret of (NONE :(num # sptree$num_set) option) => (SOME (Rval [v] :(v list, v) result),flush_state F s) | SOME (dest,names) => case cut_env names s.locals of (NONE :v sptree$num_map option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME env => ((NONE :(v list, v) result option),set_var dest v (s with locals := env))) | (IsThunk NotEvaluated v :dest_thunk_ret) => case (find_code (SOME loc) [thunk_v; v] s.code s.stack_frame_sizes :(v list # dataLang$prog # num option) option) of (NONE :(v list # dataLang$prog # num option) option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME (args1,prog,ss) => case ret of (NONE :(num # sptree$num_set) option) => if s.clock = (0 :num) then (SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with <|stack := ([] :stack list); locals := (LN :v sptree$num_map)|>) else (case (evaluate (prog,call_env args1 ss (dec_clock s :(γ, 'ffi) state)) :(v list, v) result option # (γ, 'ffi) state) of ((NONE :(v list, v) result option),s') => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s') | (SOME res,s') => (SOME res,s')) | SOME (dest,names) => case cut_env names s.locals of (NONE :v sptree$num_map option) => (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME env => (let (s1 :(γ, 'ffi) state) = call_env args1 ss (push_env env F (dec_clock s :(γ, 'ffi) state)) in if s.clock = (0 :num) then (SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s1 with <|stack := ([] :stack list); locals :