lim_safe_part_def_typed=(∀(lims :limits) (tag :num) (xs :num list). lim_safe_part lims (Con tag xs :const_part) ⇔ if xs = ([] :num list) then tag < (2 :num) ** arch_size lims DIV (16 :num) else LENGTH xs < (2 :num) ** lims.length_limit ∧ LENGTH xs < (2 :num) ** (arch_size lims − (4 :num)) ∧ (4 :num) * tag < (2 :num) ** arch_size lims DIV (16 :num) ∧ (4 :num) * tag < (2 :num) ** (arch_size lims − lims.length_limit − (2 :num))) ∧ (∀(lims :limits) (i :int). lim_safe_part lims (Int i :const_part) ⇔ if small_num lims.arch_64_bit i then T else (let (il :num) = bignum_size lims.arch_64_bit i in il ≤ (2 :num) ** lims.length_limit)) ∧ (∀(lims :limits) (s :mlstring). lim_safe_part lims (Str s) ⇔ (let (i :num) = strlen s in i DIV (arch_size lims DIV (8 :num)) < (2 :num) ** arch_size lims DIV arch_size lims ∧ i DIV (arch_size lims DIV (8 :num)) + (1 :num) < (2 :num) ** lims.length_limit ∧ small_num lims.arch_64_bit ((&i) :int))) ∧ ∀(lims :limits) (w :word64). lim_safe_part lims (W64 w :const_part) ⇔ (1 :num) < lims.length_limit
compute_limits_def_typed=∀(len_bits :num) (a64 :bool) (fpops :bool) (fptops :bool) (stack_heap_limit :num # num). compute_limits len_bits a64 fpops fptops stack_heap_limit = <|stack_limit := FST stack_heap_limit; heap_limit := SND stack_heap_limit; length_limit := len_bits; arch_64_bit := a64; has_fp_ops := fpops; has_fp_tops := fptops|>
data_lang_safe_for_space_def_typed=∀(init_ffi :'ffi ffi_state) (code :(num # dataLang$prog) sptree$num_map) (lims :limits) (ss :num sptree$num_map) (start :num). data_lang_safe_for_space init_ffi code lims ss start ⇔ ∀(ck :num). (let (p :dataLang$prog) = (Call (NONE :(num list # sptree$num_set) option) (SOME start) ([] :num list) (NONE :(num # dataLang$prog) option) :dataLang$prog); (init :num -> (unit, 'ffi) state) = (initial_state init_ffi code (ARB :num -> unit # (num # num # dataLang$prog) list) (ARB :unit -> (num # num # dataLang$prog) list -> (word8 list # word64 list # unit) option) T lims ss :num -> (unit, 'ffi) state); ((res :(v list, v) result option),(s :(unit, 'ffi) state)) = (evaluate (p,init ck) :(v list, v) result option # (unit, 'ffi) state) in s.safe_for_space)
evaluate_peak_def_typed=∀(c :dataLang$prog) (s :(α, β) state). evaluate_peak c s = (let ((x :(v list, v) result option),(s1 :(α, β) state)) = (evaluate (c,s) :(v list, v) result option # (α, β) state) in s1.peak_heap_length)
evaluate_safe_def_typed=∀(c :dataLang$prog) (s :(α, β) state). evaluate_safe c s ⇔ (let ((x :(v list, v) result option),(s1 :(α, β) state)) = (evaluate (c,s) :(v list, v) result option # (α, β) state) in s1.safe_for_space)
semantics_def_typed=∀(init_ffi :α ffi_state) (code :(num # dataLang$prog) sptree$num_map) (coracle :num -> β # (num # num # dataLang$prog) list) (cc :β -> (num # num # dataLang$prog) list -> (word8 list # word64 list # β) option) (lims :limits) (ss :num sptree$num_map) (start :num). (semantics init_ffi code coracle cc lims ss start :behaviour) = (let (p :dataLang$prog) = (Call (NONE :(num list # sptree$num_set) option) (SOME start) ([] :num list) (NONE :(num # dataLang$prog) option) :dataLang$prog); (init :num -> (β, α) state) = (initial_state init_ffi code coracle cc T lims ss :num -> (β, α) state) in if ∃(k :num). case FST (evaluate (p,init k) :(v list, v) result option # (β, α) state) of (NONE :(v list, v) result option) => T | SOME (Rval v4 :(v list, v) result) => F | SOME (Rerr e :(v list, v) result) => e ≠ (Rabort Rtimeout_error :v error_result) ∧ ∀(f :final_event). e ≠ (Rabort (Rffi_error f) :v error_result) then Fail else case some(res :behaviour). ∃(k :num) (s :(β, α) state) (r :(v list, v) result) (outcome :outcome). (evaluate (p,init k) :(v list, v) result option # (β, α) state) = (SOME r,s) ∧ (case r of (Rval v2 :(v list, v) result) => outcome = Success | (Rerr (Rraise v6) :(v list, v) result) => F | (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) => F | (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) => F | (Rerr (Rabort (Rffi_error e) :v error_result) :(v list, v) result) => outcome = FFI_outcome e) ∧ res = Terminate outcome s.ffi.io_events of (NONE :behaviour option) => Diverge (LUB (IMAGE (λ(k :num). (fromList (SND (evaluate (p,init k) :(v list, v) result option # (β, α) state)).ffi.io_events :io_event llist)) 𝕌(:num))) | SOME res => res)
do_space_def_typed=∀(op :closLang$op) (vs :v list) (s :(γ, 'ffi) state). do_space op vs s = if op_space_reset op then SOME (s with <|space := (0 :num); safe_for_space := do_space_safe op vs s; peak_heap_length := do_space_peak op vs s|>) else if op_space_req op (LENGTH vs) = (0 :num) then SOME s else consume_space (op_space_req op (LENGTH vs)) s
