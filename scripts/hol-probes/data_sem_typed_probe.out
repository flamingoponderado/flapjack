size_of_def_typed=(∀(seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits). size_of lims ([] :v list) refs seen = ((0 :num),refs,seen)) ∧ (∀(ys :v list) (y :v) (x :v) (seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits). size_of lims (x::y::ys) refs seen = (let ((n1 :num),(refs1 :v ref sptree$num_map),(seen1 :sptree$num_set)) = size_of lims (y::ys) refs seen; ((n2 :num),(refs2 :v ref sptree$num_map),(seen2 :sptree$num_set)) = size_of lims [x] refs1 seen1 in (n1 + n2,refs2,seen2))) ∧ (∀(v0 :word64) (seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits). size_of lims [(Word64 v0 :v)] refs seen = ((3 :num),refs,seen)) ∧ (∀(seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits) (i :int). size_of lims [(Number i :v)] refs seen = (if small_num lims.arch_64_bit i then (0 :num) else bignum_size lims.arch_64_bit i,refs,seen)) ∧ (∀(v1 :num) (seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits). size_of lims [(CodePtr v1 :v)] refs seen = ((0 :num),refs,seen)) ∧ (∀(v2 :bool) (seen :sptree$num_set) (refs :v ref sptree$num_map) (r :num) (lims :limits). size_of lims [(RefPtr v2 r :v)] refs seen = case (lookup r refs :v ref option) of (NONE :v ref option) => ((0 :num),refs,seen) | SOME (ValueArray vs :v ref) => (let ((n :num),(refs' :v ref sptree$num_map),(seen' :sptree$num_set)) = size_of lims vs (delete r refs :v ref sptree$num_map) seen in (n + LENGTH vs + (1 :num),refs',seen')) | SOME (ByteArray v3 bs :v ref) => (LENGTH bs DIV (arch_size lims DIV (8 :num)) + (2 :num),(delete r refs :v ref sptree$num_map),seen) | SOME (Thunk v5 v :v ref) => (let ((n :num),(refs' :v ref sptree$num_map),(seen' :sptree$num_set)) = size_of lims [v] (delete r refs :v ref sptree$num_map) seen in (n + (2 :num),refs',seen')) | SOME (MutBlock tg fin ls c rs) => (let ((n :num),(refs' :v ref sptree$num_map),(seen' :sptree$num_set)) = size_of lims (ls ++ [c] ++ rs) (delete r refs :v ref sptree$num_map) seen in (n + LENGTH ls + LENGTH rs + (2 :num),refs',seen'))) ∧ (∀(ts :num) (tag :num) (seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits). size_of lims [(Block ts tag ([] :v list) :v)] refs seen = ((0 :num),refs,seen)) ∧ ∀(v24 :v list) (v23 :v) (ts :num) (tag :num) (seen :sptree$num_set) (refs :v ref sptree$num_map) (lims :limits). size_of lims [(Block ts tag (v23::v24) :v)] refs seen = if IS_SOME (lookup ts seen :unit option) then ((0 :num),refs,seen) else (let ((n :num),(refs' :v ref sptree$num_map),(seen' :sptree$num_set)) = size_of lims (v23::v24) refs (insert ts () seen :sptree$num_set) in (n + LENGTH (v23::v24) + (1 :num),refs',seen'))
stack_to_vs_def_typed=∀(s :(γ, 'ffi) state). stack_to_vs s = (toList s.locals :v list) ++ FLAT (MAP extract_stack s.stack) ++ global_to_vs s.global
do_int_app_def_typed=do_int_app (Const (n' :int) :int_op) ([] :v list) = (if small_enough_int n' then SOME (Number n' :v) else (NONE :v option)) ∧ do_int_app Add [(Number (n1 :int) :v); (Number (n2 :int) :v)] = SOME (Number (n1 + n2) :v) ∧ do_int_app Sub [(Number n1 :v); (Number n2 :v)] = SOME (Number (n1 − n2) :v) ∧ do_int_app Mult [(Number n1 :v); (Number n2 :v)] = SOME (Number (n1 * n2) :v) ∧ do_int_app Div [(Number n1 :v); (Number n2 :v)] = (if n2 = (0 :int) then (NONE :v option) else SOME (Number (n1 / n2) :v)) ∧ do_int_app Mod [(Number n1 :v); (Number n2 :v)] = (if n2 = (0 :int) then (NONE :v option) else SOME (Number (n1 % n2) :v)) ∧ do_int_app Less [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 < n2) :v) ∧ do_int_app LessEq [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 ≤ n2) :v) ∧ do_int_app Greater [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 > n2) :v) ∧ do_int_app GreaterEq [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 ≥ n2) :v) ∧ do_int_app (LessConstSmall (n :num)) [(Number (i :int) :v)] = (if (0 :int) ≤ i ∧ i ≤ (1000000 :int) ∧ n < (1000000 :num) then SOME (Boolv (i < ((&n) :int)) :v) else (NONE :v option)) ∧ do_int_app Add ([] :v list) = (NONE :v option) ∧ do_int_app Sub ([] :v list) = (NONE :v option) ∧ do_int_app Mult ([] :v list) = (NONE :v option) ∧ do_int_app Div ([] :v list) = (NONE :v option) ∧ do_int_app Mod ([] :v list) = (NONE :v option) ∧ do_int_app Less ([] :v list) = (NONE :v option) ∧ do_int_app LessEq ([] :v list) = (NONE :v option) ∧ do_int_app Greater ([] :v list) = (NONE :v option) ∧ do_int_app GreaterEq ([] :v list) = (NONE :v option) ∧ do_int_app (LessConstSmall (v7 :num)) ([] :v list) = (NONE :v option) ∧ do_int_app (Const (v30 :int) :int_op) [(Number (v14 :int) :v)] = (NONE :v option) ∧ do_int_app Add [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Sub [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Mult [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Div [(Number v14 :v)] = (NONE :v option) ∧ do_int_app 