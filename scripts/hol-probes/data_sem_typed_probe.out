jump_exc_def_typed=∀(s :(γ, 'ffi) state). jump_exc s = if s.handler < LENGTH s.stack then case LASTN (s.handler + (1 :num)) s.stack of ([] :stack list) => (NONE :(γ, 'ffi) state option) | (Env v9 v10 :stack)::xs => (NONE :(γ, 'ffi) state option) | Exc ss e n::xs => SOME (s with <|handler := n; locals := e; stack := xs; locals_size := ss|>) else (NONE :(γ, 'ffi) state option)
