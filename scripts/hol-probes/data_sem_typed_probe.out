push_env_def_typed=(∀(env :v sptree$num_map) (s :(γ, 'ffi) state). push_env env F s = (let (stack :stack list) = (Env s.locals_size env :stack)::s.stack; (stack_max :num option) = OPTION_MAP2 MAX s.stack_max (size_of_stack stack); (stack_safe :bool) = the F (OPTION_MAP ($> s.limits.stack_limit) stack_max) in s with <|stack := stack; stack_max := stack_max; safe_for_space := (s.safe_for_space ∧ stack_safe)|>)) ∧ ∀(env :v sptree$num_map) (s :(γ, 'ffi) state). push_env env T s = (let (stack :stack list) = Exc s.locals_size env s.handler::s.stack; (stack_max :num option) = OPTION_MAP2 MAX s.stack_max (size_of_stack stack); (stack_safe :bool) = the F (OPTION_MAP ($> s.limits.stack_limit) stack_max) in s with <|stack := stack; stack_max := stack_max; handler := LENGTH s.stack; safe_for_space := (s.safe_for_space ∧ stack_safe)|>)
set_vars_def_typed=∀(ns :num list) (vs :v list) (s :(α, β) state). set_vars ns vs s = s with locals := (union (fromAList (ZIP (ns,vs))) s.locals :v sptree$num_map)
size_of_stack_def_typed=size_of_stack = FOLDR (OPTION_MAP2 $+ ∘ size_of_stack_frame) (SOME (1 :num))
size_of_stack_frame_def_typed=(∀(n :num option) (v0 :v sptree$num_map). size_of_stack_frame (Env n v0 :stack) = n) ∧ ∀(n :num option) (v1 :v sptree$num_map) (v2 :num). size_of_stack_frame (Exc n v1 v2) = OPTION_MAP ($+ (3 :num)) n
