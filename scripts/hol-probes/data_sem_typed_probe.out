do_build_def_typed=(∀(m :num -> v) (i :num) (s :α ref sptree$num_map) (ts :num option). (do_build m i ([] :const_part list) s ts :v # α ref sptree$num_map # num option) = (m (i − (1 :num)),s,ts)) ∧ ∀(m :num -> v) (i :num) (p :const_part) (rest :const_part list) (s :α ref sptree$num_map) (ts :num option). (do_build m i (p::rest) s ts :v # α ref sptree$num_map # num option) = (let ((x :v),(s1 :α ref sptree$num_map),(ts1 :num option)) = (do_part m p s ts :v # α ref sptree$num_map # num option) in (do_build m⦇i ↦ x⦈ (i + (1 :num)) rest s1 ts1 :v # α ref sptree$num_map # num option))
do_build_const_def_typed=∀(xs :const_part list) (s :α ref sptree$num_map) (ts :num option). (do_build_const xs s ts :v # α ref sptree$num_map # num option) = (do_build (λ(x :num). (Number (0 :int) :v)) (0 :num) xs s ts :v # α ref sptree$num_map # num option)
do_part_def_typed=(∀(m :num -> v) (i :int) (s :α ref sptree$num_map) (ts :num option). (do_part m (Int i :const_part) s ts :v # α ref sptree$num_map # num option) = ((Number i :v),s,ts)) ∧ (∀(m :num -> v) (w :word64) (s :α ref sptree$num_map) (ts :num option). (do_part m (W64 w :const_part) s ts :v # α ref sptree$num_map # num option) = ((Word64 w :v),s,ts)) ∧ (∀(m :num -> v) (t :num) (ns :num list) (s :α ref sptree$num_map) (ts :num option). (do_part m (Con t ns :const_part) s ts :v # α ref sptree$num_map # num option) = if ns = ([] :num list) then ((Block (0 :num) t ([] :v list) :v),s,ts) else case ts of (NONE :num option) => ((Block (0 :num) t (MAP m ns) :v),s,ts) | SOME n => ((Block n t (MAP m ns) :v),s,SOME (n + (1 :num)))) ∧ ∀(m :num -> v) (t :mlstring) (s :α ref sptree$num_map) (ts :num option). (do_part m (Str t) s ts :v # α ref sptree$num_map # num option) = (let (ptr :num) = LEAST(ptr :num). ptr ∉ (domain s :num -> bool); (bytes :word8 list) = MAP ((n2w :num -> word8) ∘ ORD) (explode t) in ((RefPtr T ptr :v),(insert ptr (ByteArray T bytes :α ref) s :α ref sptree$num_map),ts))
list_to_v_def_typed=(∀(ts :num) (t :v). (list_to_v ts t ([] :v list) :v) = t) ∧ ∀(ts :num) (t :v) (h :v) (l :v list). (list_to_v ts t (h::l) :v) = (Block ts cons_tag [h; (list_to_v (ts + (1 :num)) t l :v)] :v)
with_fresh_ts_def_typed=∀(s :(γ, 'ffi) state) (n :num) (f :num -> (γ, 'ffi) state -> α). with_fresh_ts s n f = case s.tstamps of (NONE :num option) => f (0 :num) s | SOME ts => f ts (s with tstamps := SOME (ts + n))
