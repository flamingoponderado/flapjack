lim_safe_def_typed=(lim_safe (lims :limits) (BlockOp (Cons (tag :num) :block_op)) (xs :v list) ⇔ if xs = ([] :v list) then tag < (2 :num) ** arch_size lims DIV (16 :num) else LENGTH xs < (2 :num) ** lims.length_limit ∧ LENGTH xs < (2 :num) ** (arch_size lims − (4 :num)) ∧ (4 :num) * tag < (2 :num) ** arch_size lims DIV (16 :num) ∧ (4 :num) * tag < (2 :num) ** (arch_size lims − lims.length_limit − (2 :num))) ∧ (lim_safe lims (MemOp (MutCons tag (i' :num))) xs ⇔ LENGTH xs < (2 :num) ** lims.length_limit ∧ LENGTH xs < (2 :num) ** (arch_size lims − (4 :num)) ∧ (4 :num) * tag < (2 :num) ** arch_size lims DIV (16 :num) ∧ (4 :num) * tag < (2 :num) ** (arch_size lims − lims.length_limit − (2 :num))) ∧ (lim_safe lims (BlockOp (FromList tag)) xs ⇔ case xs of ([] :v list) => T | [len] => T | [len; lv] => (case v_to_list lv of (NONE :v list option) => T | SOME n => if len = (Number ((&LENGTH n) :int) :v) then small_num lims.arch_64_bit ((&LENGTH n) :int) ∧ LENGTH n < (2 :num) ** lims.length_limit ∧ LENGTH n < arch_size lims DIV (16 :num) ∧ (4 :num) * tag < (2 :num) ** (arch_size lims − lims.length_limit − (2 :num)) ∧ (4 :num) * tag < (2 :num) ** arch_size lims DIV (16 :num) else T) | len::lv::v10::v11 => T) ∧ (lim_safe lims (BlockOp ListAppend) [(x1 :v); (x2 :v)] ⇔ case (v_to_list x1,v_to_list x2) of ((NONE :v list option),v3) => T | (SOME xs,(NONE :v list option)) => T | (SOME xs,SOME ys) => (1 :num) < lims.length_limit ∧ (3 :num) * SUC (LENGTH xs) < (2 :num) ** arch_size lims DIV (8 :num)) ∧ (lim_safe lims (BlockOp (ConsExtend tag)) ((Block (v0 :num) (v1 :num) (xs' :v list) :v)::(Number (lower :int) :v)::(Number (len :int) :v)::(Number (tot :int) :v)::xs) ⇔ if lower < (0 :int) ∨ len < (0 :int) ∨ lower + len > ((&LENGTH xs') :int) ∨ tot = (0 :int) ∨ tot ≠ ((&LENGTH xs) :int) + len then T else LENGTH (xs ++ TAKE (Num len) (DROP (Num lower) xs')) < (2 :num) ** lims.length_limit ∧ LENGTH (xs ++ TAKE (Num len) (DROP (Num lower) xs')) < (2 :num) ** arch_size lims DIV (16 :num) ∧ (4 :num) * tag < (2 :num) ** arch_size lims DIV (16 :num) ∧ (4 :num) * tag < (2 :num) ** (arch_size lims − lims.length_limit − (2 :num))) ∧ (lim_safe lims (IntOp Add) [(Number (i1 :int) :v); (Number (i2 :int) :v)] ⇔ if small_num lims.arch_64_bit i1 ∧ small_num lims.arch_64_bit i2 ∧ small_num lims.arch_64_bit (i1 + i2) then T else (let (il :num) = bignum_size lims.arch_64_bit i1; (jl :num) = bignum_size lims.arch_64_bit i2 in il + jl ≤ (2 :num) ** lims.length_limit)) ∧ (lim_safe lims (IntOp Sub) [(Number i1 :v); (Number i2 :v)] ⇔ if small_num lims.arch_64_bit i1 ∧ small_num lims.arch_64_bit i2 ∧ small_num lims.arch_64_bit (i1 − i2) then T else (let (il :num) = bignum_size lims.arch_64_bit i1; (jl :num) = bignum_size lims.arch_64_bit i2 in il + jl ≤ (2 :num) ** lims.length_limit)) ∧ (lim_safe lims (IntOp Mult) [(Number i1 :v); (Number i2 :v)] ⇔ if small_num lims.arch_64_bit i1 ∧ (0 :int) ≤ i1 ∧ small_num lims.arch_64_bit i2 ∧ (0 :int) ≤ i2 ∧ small_num lims.arch_64_bit (i1 * i2) then T else (let (il :num) = bignum_size lims.arch_64_bit i1; (jl :num) = bignum_size lims.arch_64_bit i2 in il + jl ≤ (2 :num) ** lims.length_limit)) ∧ (lim_safe lims (IntOp Div) [(Number i1 :v); (Number i2 :v)] ⇔ if small_num lims.arch_64_bit i1 ∧ (0 :int) ≤ i1 ∧ small_num lims.arch_64_bit i2 ∧ (0 :int) ≤ i2 ∧ small_num lims.arch_64_bit (i1 / i2) then T else (let (il :num) = bignum_size lims.arch_64_bit i1; (jl :num) = bignum_size lims.arch_64_bit i2 in il + jl ≤ (2 :num) ** lims.length_limit)) ∧ (lim_safe lims (IntOp Mod) [(Number i1 :v); (Number i2 :v)] ⇔ if small_num lims.arch_64_bit i1 ∧ (0 :int) ≤ i1 ∧ small_num lims.arch_64_bit i2 ∧ (0 :int) ≤ i2 ∧ small_num lims.arch_64_bit (i1 % i2) then T else (let (il :num) = bignum_size lims.arch_64_bit i1; (jl :num) = bignum_size lims.arch_64_bit i2 in il + jl ≤ (2 :num) ** lims.length_limit)) ∧ (lim_safe lims (MemOp RefArray) [(Number (i :int) :v); (v :v)] ⇔ (0 :int) ≤ i ∧ Num i < (2 :num) ** arch_size lims DIV (16 :num) ∧ Num i < (2 :num) ** lims.length_limit) ∧ (lim_safe lims (MemOp (RefByte (v2 :bool))) ((Number i :v)::xs) ⇔ (0 :int) ≤ i ∧ Num i DIV (arch_size lims DIV (8 :num)) < (2 :num) ** arch_size lims DIV arch_size lims ∧ Num i DIV (arch_size lims DIV (8 :num)) + (1 :num) < (2 :num) ** lims.length_limit ∧ small_num lims.arch_64_bit i) ∧ (lim_safe lims (MemOp Ref) xs ⇔ LENGTH xs < (2 :num) ** lims.length_limit ∧ LENGTH xs < (2 :num) ** arch_size lims DIV (16 :num)) ∧ (lim_safe lims (BlockOp (Build (parts :const_part list))) (v3 :v list) ⇔ EVERY (lim_safe_part lims) parts) ∧ (lim_safe lims (WordOp WordToInt) (v4 :v list) ⇔ (1 :num) < lims.length_limit) ∧ (lim_safe lims (WordOp WordFromInt) (v5 :v list) ⇔ (1 :num) < lims.length_limit) ∧ (lim_safe lims (WordOp (WordOpw W64 (v6 :opw))) (v7 :v list) ⇔ (1 :num) < lims.length_limit) ∧ (lim_safe lims (WordOp (WordShift W64 (v8 :ast$shift) (v9 :num))) (v10 :v list) ⇔ (1 :num) < lims.length_limit) ∧ (lim_safe lims (WordOp (WordFromWord (v11 :bool))) (v12 :v list) ⇔ (1 :num) < lims.length_limit) ∧ (lim_safe lims (WordOp (FP_cmp (v13 :fp_cmp))) (v14 :v list) ⇔ lims.has_fp_ops) ∧ (lim_safe lims (WordOp (FP_uop (v15 :fp_uop))) (v16 :v list) ⇔ lims.has_fp_ops ∧ (lims.arch_64_bit ∨ (1 :num) < lims.length_limit)) ∧ (lim_safe lims (WordOp (FP_bop (v17 :fp_bop))) (v18 :v list) ⇔ lims.has_fp_ops ∧ (lims.arch_64_bit ∨ (1 :num) < lims.length_limit)) ∧ (lim_safe lims (WordOp (FP_top (v19 :fp_top))) (v20 :v list) ⇔ lims.has_fp_ops ∧ lims.has_fp_tops ∧ (lims.arch_64_bit ∨ (1 :num) < lims.length_limit)) ∧ (lim_safe lims (Label (v27 :num)) (v22 :v list) ⇔ T) ∧ (lim_safe lims (FFI (v28 :mlstring) :closLang$op) v22 ⇔ T) ∧ (lim_safe lims (IntOp (v29 :int_op)) ([] :v list) ⇔ T) ∧ (lim_safe lims (IntOp v29) [(v43 :v)] ⇔ T) ∧ (lim_safe lims (IntOp (Const (v87 :int) :int_op)) [(Number (v67 :int) :v); (Number (v51 :int) :v)] ⇔ T) ∧ (lim_safe lims (IntOp Less) [(Number v67 :v); (Number v51 :v)] ⇔ T) ∧ (lim_safe lims (IntOp LessEq) [(Number v67 :v); (Number v51 :v)] ⇔ T) ∧ (lim_safe lims