dest_thunk_ret_typed=BadRef::semanticPrimitives$dest_thunk_ret; NotThunk::semanticPrimitives$dest_thunk_ret; IsThunk::thunk_mode -> semanticPrimitives$v -> semanticPrimitives$dest_thunk_ret
allowed_op_def_typed=∀(op :closLang$op) (v0 :α). allowed_op op v0 ⇔ op ≠ Install ∧ ∀(t :num) (i :num). op ≠ MemOp (MutCons t i)
bad_thunk_update_def_typed=∀(m :thunk_mode) (v :v) (refs :v ref sptree$num_map). bad_thunk_update m v refs ⇔ m = Evaluated ∧ (dest_thunk v refs :dest_thunk_ret) ≠ NotThunk
call_env_def_typed=∀(args :v list) (size :num option) (s :(γ, 'ffi) state). call_env args size s = (let (new_stack_max :num option) = OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (size_of_stack s.stack) size); (stack_safe :bool) = the F (OPTION_MAP ($> s.limits.stack_limit) new_stack_max) in s with <|locals := (fromList args :v sptree$num_map); locals_size := size; stack_max := new_stack_max; safe_for_space := (s.safe_for_space ∧ stack_safe)|>)
cut_env_def_typed=∀(name_set :sptree$num_set) (env :α sptree$num_map). cut_env name_set env = if (domain name_set :num -> bool) ⊆ (domain env :num -> bool) then SOME (mk_wf (inter env name_set)) else (NONE :α sptree$num_map option)
cut_state_def_typed=∀(names :sptree$num_set) (s :(γ, 'ffi) state). cut_state names s = case cut_env names s.locals of (NONE :v sptree$num_map option) => (NONE :(γ, 'ffi) state option) | SOME env => SOME (s with locals := env)
cut_state_opt_def_typed=∀(names :sptree$num_set option) (s :(α, β) state). cut_state_opt names s = case names of (NONE :sptree$num_set option) => SOME s | SOME names => cut_state names s
dest_Boolv_def_typed=dest_Boolv (Block (v0 :num) (tag :num) (xs :v list) :v) = (if xs = ([] :v list) ∧ tag < (2 :num) then SOME (tag = (1 :num)) else (NONE :bool option)) ∧ dest_Boolv (Number (v :int) :v) = (NONE :bool option) ∧ dest_Boolv (Word64 (v2 :word64) :v) = (NONE :bool option) ∧ dest_Boolv (CodePtr (v6 :num) :v) = (NONE :bool option) ∧ dest_Boolv (RefPtr (v7 :bool) (v8 :num) :v) = (NONE :bool option)
dest_thunk_def_typed=(dest_thunk (RefPtr (b :bool) (ptr :num) :v) (refs :v ref sptree$num_map) :dest_thunk_ret) = (case (lookup ptr refs :v ref option) of (NONE :v ref option) => BadRef | SOME (ValueArray v12 :v ref) => NotThunk | SOME (ByteArray v13 v14 :v ref) => NotThunk | SOME (Thunk Evaluated v :v ref) => if b then BadRef else (IsThunk Evaluated v :dest_thunk_ret) | SOME (Thunk NotEvaluated v :v ref) => if b then BadRef else (IsThunk NotEvaluated v :dest_thunk_ret) | SOME (MutBlock v17 v18 v19 v20 v21) => NotThunk) ∧ (dest_thunk (Number (v4 :int) :v) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Word64 (v5 :word64) :v) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Block (v6 :num) (v7 :num) (v8 :v list) :v) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (CodePtr (v9 :num) :v) refs :dest_thunk_ret) = NotThunk
find_code_def_typed=(∀(p :num) (args :v list) (code :(num # α) sptree$num_map) (ssize :β sptree$num_map). (find_code (SOME p) args code ssize :(v list # α # β option) option) = case (lookup p code :(num # α) option) of (NONE :(num # α) option) => (NONE :(v list # α # β option) option) | SOME (arity,exp) => if LENGTH args = arity then SOME (args,exp,(lookup p ssize :β option)) else (NONE :(v list # α # β option) option)) ∧ ∀(args :v list) (code :(num # α) sptree$num_map) (ssize :β sptree$num_map). (find_code (NONE :num option) args code ssize :(v list # α # β option) option) = if args = ([] :v list) then (NONE :(v list # α # β option) option) else case LAST args of (Number v9 :v) => (NONE :(v list # α # β option) option) | (Word64 v10 :v) => (NONE :(v list # α # β option) option) | (Block v11 v12 v13 :v) => (NONE :(v list # α # β option) option) | (CodePtr loc :v) => (case (lookup loc code :(num # α) option) of (NONE :(num # α) option) => (NONE :(v list # α # β option) option) | SOME (arity,exp) => if LENGTH args = arity + (1 :num) then SOME (FRONT args,exp,(lookup loc ssize :β option)) else (NONE :(v list # α # β option) option)) | (RefPtr v15 v16 :v) => (NONE :(v list # α # β option) option)
flush_state_def_typed=(∀(s :(γ, 'ffi) state). flush_state T s = s with <|locals := (LN :v sptree$num_map); stack := ([] :stack list); locals_size := SOME (0 :num)|>) ∧ ∀(s :(γ, 'ffi) state). flush_state F s = s with <|locals := (LN :v sptree$num_map); locals_size := SOME (0 :num)|>
install_sfs_def_typed=∀(op :closLang$op) (s :(γ, 'ffi) state). install_sfs op s = s with safe_for_space := (op ≠ Install ∧ s.safe_for_space)
