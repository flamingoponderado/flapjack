evaluate_nil_typed=∀(s :'ffi state) (env :v sem_env). evaluate s env ([] :exp list) = (s,(Rval ([] :v list) :(v list, v) result))
evaluate_next_type_stamp_mono_typed=(evaluate (s :'ffi state) (env :v sem_env) (es :exp list) = ((s' :'ffi state),(res1 :(v list, v) result)) ⇒ s.next_type_stamp ≤ s'.next_type_stamp) ∧ (evaluate_match s env (v :v) (pes :(pat # exp) list) (err_v :v) = (s',(res2 :(v list, v) result)) ⇒ s.next_type_stamp ≤ s'.next_type_stamp) ∧ (evaluate_decs s env (ds :dec list) = (s',(res3 :(v sem_env, v) result)) ⇒ s.next_type_stamp ≤ s'.next_type_stamp)
evaluate_next_exn_stamp_mono_typed=(evaluate (s :'ffi state) (env :v sem_env) (es :exp list) = ((s' :'ffi state),(res1 :(v list, v) result)) ⇒ s.next_exn_stamp ≤ s'.next_exn_stamp) ∧ (evaluate_match s env (v :v) (pes :(pat # exp) list) (err_v :v) = (s',(res2 :(v list, v) result)) ⇒ s.next_exn_stamp ≤ s'.next_exn_stamp) ∧ (evaluate_decs s env (ds :dec list) = (s',(res3 :(v sem_env, v) result)) ⇒ s.next_exn_stamp ≤ s'.next_exn_stamp)
evaluate_refs_length_mono_typed=(∀(s :'ffi state) (env :v sem_env) (es :exp list) (s' :'ffi state) (r :(v list, v) result). evaluate s env es = (s',r) ⇒ LENGTH s.refs ≤ LENGTH s'.refs) ∧ ∀(s :'ffi state) (env :v sem_env) (v :v) (pes :(pat # exp) list) (err_v :v) (s' :'ffi state) (r :(v list, v) result). evaluate_match s env v pes err_v = (s',r) ⇒ LENGTH s.refs ≤ LENGTH s'.refs
eval_no_eval_simulation_typed=(∀(s :'ffi state) (env :v sem_env) (exps :exp list) (s' :'ffi state) (res :(v list, v) result). evaluate s env exps = (s',res) ∧ s.eval_state = (NONE :eval_state option) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ s'.eval_state = (NONE :eval_state option) ∧ evaluate (s with eval_state := (es :eval_state option)) env exps = (s' with eval_state := es,res)) ∧ (∀(s :'ffi state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi state) (res :(v list, v) result). evaluate_match s env x pes err_x = (s',res) ∧ s.eval_state = (NONE :eval_state option) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ s'.eval_state = (NONE :eval_state option) ∧ evaluate_match (s with eval_state := es) env x pes err_x = (s' with eval_state := es,res)) ∧ ∀(s :'ffi state) (env :v sem_env) (decs :dec list) (s' :'ffi state) (res :(v sem_env, v) result). evaluate_decs s env decs = (s',res) ∧ s.eval_state = (NONE :eval_state option) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ s'.eval_state = (NONE :eval_state option) ∧ evaluate_decs (s with eval_state := es) env decs = (s' with eval_state := es,res)
evaluate_length_typed=(∀(s :'ffi state) (e :v sem_env) (p :exp list) (s' :'ffi state) (r :v list). evaluate s e p = (s',(Rval r :(v list, v) result)) ⇒ LENGTH r = LENGTH p) ∧ (∀(s :'ffi state) (e :v sem_env) (v :v) (p :(pat # exp) list) (er :v) (s' :'ffi state) (r :v list). evaluate_match s e v p er = (s',(Rval r :(v list, v) result)) ⇒ LENGTH r = (1 :num)) ∧ ∀(s :'ffi state) (e :v sem_env) (ds :dec list) (s' :'ffi state) (r :v sem_env). evaluate_decs s e ds = (s',(Rval r :(v sem_env, v) result)) ⇒ T
evaluate_sing_typed=∀(s :'ffi state) (env :v sem_env) (e :exp) (s' :'ffi state) (vs :v list). evaluate s env [e] = (s',(Rval vs :(v list, v) result)) ⇒ ∃(v :v). vs = [v]
evaluate_decs_cons_typed=∀(s :'ffi state) (env :v sem_env) (d :dec) (ds :dec list). evaluate_decs s env (d::ds) = case evaluate_decs s env [d] of (s1,(Rval env1 :(v sem_env, v) result)) => (case evaluate_decs s1 ((env1 +++ env) :v sem_env) ds of (s2,r) => (s2,combine_dec_result env1 r)) | (s1,(Rerr v7 :(v sem_env, v) result)) => (s1,(Rerr v7 :(v sem_env, v) result))
evaluate_decs_append_typed=∀(ds1 :dec list) (s :α state) (env :v sem_env) (ds2 :dec list). evaluate_decs s env (ds1 ++ ds2) = case evaluate_decs s env ds1 of (s1,(Rval env1 :(v sem_env, v) result)) => (case evaluate_decs s1 ((env1 +++ env) :v sem_env) ds2 of (s2,r) => (s2,combine_dec_result env1 r)) | (s1,(Rerr v7 :(v sem_env, v) result)) => (s1,(Rerr v7 :(v sem_env, v) result))
call_FFI_rel_def_typed=∀(s1 :α ffi_state) (s2 :α ffi_state). call_FFI_rel s1 s2 ⇔ ∃(n :ffiname) (conf :word8 list) (bytes :word8 list) (t :word8 list). call_FFI s1 n conf bytes = FFI_return s2 t
call_FFI_LENGTH_typed=call_FFI (st :α ffi_state) (index :ffiname) (conf :word8 list) (x :word8 list) = FFI_return (new_st :α ffi_state) (new_bytes :word8 list) ⇒ LENGTH x = LENGTH new_bytes
call_FFI_rel_consts_typed=call_FFI_rel (s1 :α ffi_state) (s2 :α ffi_state) ⇒ s2.oracle = s1.oracle
RTC_call_FFI_rel_consts_typed=∀(s1 :α ffi_state) (s2 :α ffi_state). (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s1 s2 ⇒ s2.oracle = s1.oracle
io_events_mono_def_typed=∀(s1 :α ffi_state) (s2 :α ffi_state). io_events_mono s1 s2 ⇔ s1.io_events ≼ s2.io_events ∧ (s2.io_events = s1.io_events ⇒ s2 = s1)
io_events_mono_refl_typed=io_events_mono (ffi :α ffi_state) ffi
io_events_mono_trans_typed=io_events_mono (ffi1 :α ffi_state) (ffi2 :α ffi_state) ∧ io_events_mono ffi2 (ffi3 :α ffi_state) ⇒ io_events_mono ffi1 ffi3
io_events_mono_antisym_typed=io_events_mono (s1 :α ffi_state) (s2 :α ffi_state) ∧ io_events_mono s2 s1 ⇒ s1 = s2
call_FFI_rel_io_events_mono_typed=∀(s1 :α ffi_state) (s2 :α ffi_state). (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s1 s2 ⇒ io_events_mono s1 s2
do_app_call_FFI_rel_typed=do_app ((r :v store_v list),(ffi :α ffi_state)) (op :op) (vs :v list) = SOME (((r' :v store_v list),(ffi' :α ffi_state)),(res :(v, v) result)) ⇒ (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ ffi ffi'
do_app_io_events_mono_typed=do_app ((r :v store_v list),(ffi :α ffi_state)) (op :op) (vs :v list) = SOME (((r' :v store_v list),(ffi' :α ffi_state)),(res :(v, v) result)) ⇒ io_events_mono ffi ffi'
evaluate_call_FFI_rel_typed=(∀(s :'ffi state) (e :v sem_env) (exp :exp list). (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s.ffi (FST (evaluate s e exp)).ffi) ∧ (∀(s :'ffi state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v). (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s.ffi (FST (evaluate_match s e v pes errv)).ffi) ∧ ∀(s :'ffi state) (e :v sem_env) (ds :dec list). (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s.ffi (FST (evaluate_decs s e ds)).ffi
evaluate_io_events_mono_typed=(∀(s :'ffi state) (e :v sem_env) (exp :exp list). io_events_mono s.ffi (FST (evaluate s e exp)).ffi) ∧ (∀(s :'ffi state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v). io_events_mono s.ffi (FST (evaluate_match s e v pes errv)).ffi) ∧ ∀(s :α state) (e :v sem_env) (d :dec list). io_events_mono s.ffi (FST (evaluate_decs s e d)).ffi
evaluate_call_FFI_rel_imp_typed=(∀(s :α state) (e :v sem_env) (p :exp list) (s' :α state) (r :(v list, v) result). evaluate s e p = (s',r) ⇒ (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s.ffi s'.ffi) ∧ (∀(s :β state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v) (s' :β state) (r :(v list, v) result). evaluate_match s e v pes errv = (s',r) ⇒ (call_FFI_rel :β ffi_state -> β ffi_state -> bool)꙳ s.ffi s'.ffi) ∧ ∀(s :γ state) (e :v sem_env) (p :dec list) (s' :γ state) (r :(v sem_env, v) result). evaluate_decs s e p = (s',r) ⇒ (call_FFI_rel :γ ffi_state -> γ ffi_state -> bool)꙳ s.ffi s'.ffi
evaluate_decs_call_FFI_rel_imp_typed=∀(s :α state) (e :v sem_env) (p :dec list) (s' :α state) (r :(v sem_env, v) result). evaluate_decs s e p = (s',r) ⇒ (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s.ffi s'.ffi
evaluate_io_events_mono_imp_typed=(∀(s :α state) (e :v sem_env) (p :exp list) (s' :α state) (r :(v list, v) result). evaluate s e p = (s',r) ⇒ io_events_mono s.ffi s'.ffi) ∧ (∀(s :β state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v) (s' :β state) (r :(v list, v) result). evaluate_match s e v pes errv = (s',r) ⇒ io_events_mono s.ffi s'.ffi) ∧ ∀(s :γ state) (e :v sem_env) (p :dec list) (s' :γ state) (r :(v sem_env, v) result). evaluate_decs s e p = (s',r) ⇒ io_events_mono s.ffi s'.ffi
is_clock_io_mono_def_typed=∀(f :α state -> α state # (β, γ) result) (s :α state). is_clock_io_mono f s ⇔ case f s of (s',r) => io_events_mono s.ffi s'.ffi ∧ s'.clock ≤ s.clock ∧ s.next_type_stamp ≤ s'.next_type_stamp ∧ s.next_exn_stamp ≤ s'.next_exn_stamp ∧ LENGTH s.refs ≤ LENGTH s'.refs ∧ ∀(clk :num). case f (s with clock := clk) of (s'',r') => (r' ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ r' = r ∧ s'' = s' with clock := clk − (s.clock − s'.clock)) ∧ (r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ (clk ≥ s.clock − s'.clock ⇔ r' ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result))) ∧ (r' ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ clk ≤ s.clock ⇒ r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result)) ∧ (clk ≤ s.clock ⇒ io_events_mono s''.ffi s'.ffi)
is_clock_io_mono_return_typed=is_clock_io_mono (λ(s :α state). (s,(Rval (r :β) :(β, γ) result))) (s :α state)
is_clock_io_mono_err_typed=is_clock_io_mono (λ(s :α state). (s,(Rerr (r :γ error_result) :(β, γ) result))) (s :α state)
is_clock_io_mono_cong_typed=(s :α state) = (t :α state) ⇒ (∀(s :α state). s.eval_state = t.eval_state ∧ s.refs = t.refs ∧ s.ffi = t.ffi ⇒ (f :α state -> α state # (β, γ) result) s = (g :α state -> α state # (β, γ) result) s) ⇒ (is_clock_io_mono f s ⇔ is_clock_io_mono g t)
is_clock_io_mono_extra_typed=(∀(s :α state). is_clock_io_mono (f :α state -> α state # (β, γ) result) s) ⇒ f (s :α state) = ((s' :α state),(r :(β, γ) result)) ∧ r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ f (s with clock := s.clock + (extra :num)) = (s' with clock := s'.clock + extra,r)
is_clock_io_mono_extra_mono_typed=(∀(s :α state). is_clock_io_mono (f :α state -> α state # (β, γ) result) s) ⇒ io_events_mono (FST (f (s :α state))).ffi (FST (f (s with clock := s.clock + (extra :num)))).ffi
adj_clock_def_typed=∀(inc :num) (dec :num) (s :α state). adj_clock inc dec s = s with clock := s.clock + inc − dec
dec_inc_clock_typed=dec_clock (adj_clock (1 :num) (0 :num) (s :α state)) = s
is_clock_io_mono_check_typed=((s :α state).clock ≠ (0 :num) ⇒ is_clock_io_mono (λ(s :α state). (f :α state -> α state # (β, γ) result) (adj_clock (1 :num) (0 :num) s)) (dec_clock s)) ⇒ is_clock_io_mono (λ(s :α state). if s.clock = (0 :num) then (s,(Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result)) else f s) s
is_clock_io_mono_bind_typed=is_clock_io_mono (f :α state -> α state # (β, γ) result) (s :α state) ∧ (∀(s' :α state) (r :(β, γ) result). f s = (s',r) ⇒ is_clock_io_mono ((g :(β, γ) result -> α state -> α state # (δ, ε) result) r) s') ∧ (∀(s' :α state). g (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) s' = (s',(Rerr (Rabort Rtimeout_error :ε error_result) :(δ, ε) result))) ⇒ is_clock_io_mono (λ(s :α state). case f s of (s',r) => g r s') s
do_app_refs_length_typed=do_app (refs_ffi :v store_v list # α ffi_state) (op :op) (vs :v list) = SOME (res :(v store_v list # α ffi_state) # (v, v) result) ⇒ LENGTH (FST refs_ffi) ≤ LENGTH (FST (FST res))
is_clock_io_mono_do_app_simple_typed=∀(xs :v list) (st :'ffi state). is_clock_io_mono (λ(st' :'ffi state). case do_app (st'.refs,st'.ffi) (op :op) xs of (NONE :((v store_v list # 'ffi ffi_state) # (v, v) result) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME ((refs,ffi),r) => (st' with <|refs := refs; ffi := ffi|>,list_result r)) st
is_clock_io_mono_acc_safe_typed=∀(v :α) (g :α -> β state -> β state # (γ, δ) result). (∀(st :β state) (clk :num). (f :β state -> α) (st with clock := clk) = f st) ∧ (f (st :β state) = v ∨ f st ≠ v) ∧ is_clock_io_mono (λ(st' :β state). g (f st) st') st ⇒ is_clock_io_mono (λ(st' :β state). g (f st') st') st
is_clock_io_mono_if_safe_typed=(∀(st :β state) (clk :num). (f :β state -> bool) (st with clock := clk) ⇔ f st) ∧ is_clock_io_mono (λ(st' :β state). if f (st :β state) then (j :β state -> β state # (γ, δ) result) st' else (k :β state -> β state # (γ, δ) result) st') st ⇒ is_clock_io_mono (λ(st' :β state). if f st' then j st' else k st') st
is_clock_io_mono_option_case_safe_typed=(∀(st :β state) (clk :num). (f :β state -> α option) (st with clock := clk) = f st) ∧ is_clock_io_mono (λ(st' :β state). case f (st :β state) of (NONE :α option) => (g :β state -> β state # (γ, δ) result) st' | SOME x => (h :α -> β state -> β state # (γ, δ) result) x st') st ⇒ is_clock_io_mono (λ(st' :β state). case f st' of (NONE :α option) => g st' | SOME x => h x st') st
is_clock_io_mono_match_case_safe_typed=(∀(st :β state) (clk :num). (f :β state -> α match_result) (st with clock := clk) = f st) ∧ is_clock_io_mono (λ(st' :β state). case f (st :β state) of (No_match :α match_result) => (g :β state -> β state # (γ, δ) result) st' | (Match_type_error :α match_result) => (h :β state -> β state # (γ, δ) result) st' | Match env => (j :α -> β state -> β state # (γ, δ) result) env st') st ⇒ is_clock_io_mono (λ(st' :β state). case f st' of (No_match :α match_result) => g st' | (Match_type_error :α match_result) => h st' | Match env => j env st') st
is_clock_io_mono_match_case_pair_safe_typed=(∀(st :β state) (clk :num). (f :β state -> α match_result) (st with clock := clk) = f st) ∧ is_clock_io_mono (λ(st' :β state). (st',case f (st :β state) of (No_match :α match_result) => (g :β state -> (γ, δ) result) st' | (Match_type_error :α match_result) => (h :β state -> (γ, δ) result) st' | Match env => (j :α -> β state -> (γ, δ) result) env st')) st ⇒ is_clock_io_mono (λ(st' :β state). (st',case f st' of (No_match :α match_result) => g st' | (Match_type_error :α match_result) => h st' | Match env => j env st')) st
is_clock_io_mono_evaluate_typed=(∀(s :'ffi state) (env :v sem_env) (es :exp list). is_clock_io_mono (λ(s :'ffi state). evaluate s env es) s) ∧ (∀(s :'ffi state) (env :v sem_env) (v :v) (pes :(pat # exp) list) (err_v :v). is_clock_io_mono (λ(s :'ffi state). evaluate_match s env v pes err_v) s) ∧ ∀(s :'ffi state) (env :v sem_env) (ds :dec list). is_clock_io_mono (λ(s :'ffi state). evaluate_decs s env ds) s
is_clock_io_mono_evaluate_decs_typed=∀(s :α state) (e :v sem_env) (p :dec list). is_clock_io_mono (λ(s :α state). evaluate_decs s e p) s
evaluate_add_to_clock_typed=∀(s :'ffi state) (env :v sem_env) (es :exp list) (s' :'ffi state) (r :(v list, v) result) (extra :num). evaluate s env es = (s',r) ∧ r ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ evaluate (s with clock := s.clock + extra) env es = (s' with clock := s'.clock + extra,r)
evaluate_match_add_to_clock_typed=∀(s :'ffi state) (env :v sem_env) (v :v) (pes :(pat # exp) list) (err_v :v) (s' :'ffi state) (r :(v list, v) result) (extra :num). evaluate_match s env v pes err_v = (s',r) ∧ r ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ evaluate_match (s with clock := s.clock + extra) env v pes err_v = (s' with clock := s'.clock + extra,r)
evaluate_decs_add_to_clock_typed=∀(s :α state) (e :v sem_env) (p :dec list) (s' :α state) (r :(v sem_env, v) result) (extra :num). evaluate_decs s e p = (s',r) ∧ r ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs (s with clock := s.clock + extra) e p = (s' with clock := s'.clock + extra,r)
evaluate_add_to_clock_io_events_mono_typed=(∀(s :'ffi state) (e :v sem_env) (d :exp list) (extra :num). io_events_mono (FST (evaluate s e d)).ffi (FST (evaluate (s with clock := s.clock + extra) e d)).ffi) ∧ ∀(s :'ffi state) (e :v sem_env) (v :v) (d :(pat # exp) list) (er :v) (extra :num). io_events_mono (FST (evaluate_match s e v d er)).ffi (FST (evaluate_match (s with clock := s.clock + extra) e v d er)).ffi
evaluate_decs_add_to_clock_io_events_mono_typed=∀(s :α state) (e :v sem_env) (d :dec list). io_events_mono (FST (evaluate_decs s e d)).ffi (FST (evaluate_decs (s with clock := s.clock + (extra :num)) e d)).ffi
evaluate_decs_ffi_mono_clock_typed=∀(k1 :num) (k2 :num) (s :α state) (e :v sem_env) (p :dec list). k1 ≤ k2 ⇒ io_events_mono (FST (evaluate_decs (s with clock := k1) e p)).ffi (FST (evaluate_decs (s with clock := k2) e p)).ffi
evaluate_decs_clock_determ_typed=∀(s :α state) (e :v sem_env) (p :dec list) (s1 :α state) (r1 :(v sem_env, v) result) (s2 :α state) (r2 :(v sem_env, v) result) (k1 :num) (k2 :num). evaluate_decs (s with clock := k1) e p = (s1,r1) ∧ evaluate_decs (s with clock := k2) e p = (s2,r2) ⇒ case (r1,r2) of ((Rval v12 :(v sem_env, v) result),(Rval v8 :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rraise v16) :(v sem_env, v) result),(Rval v8 :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result),(Rval v8 :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result),(Rval v8 :(v sem_env, v) result)) => k1 < k2 | ((Rerr (Rabort (Rffi_error v19) :v error_result) :(v sem_env, v) result),(Rval v8 :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rval v24 :(v sem_env, v) result),(Rerr (Rraise v28) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rval v24 :(v sem_env, v) result),(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rval v24 :(v sem_env, v) result),(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result)) => k2 < k1 | ((Rval v24 :(v sem_env, v) result),(Rerr (Rabort (Rffi_error v31) :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rraise v40) :(v sem_env, v) result),(Rerr (Rraise v36) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result),(Rerr (Rraise v36) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result),(Rerr (Rraise v36) :(v sem_env, v) result)) => k1 < k2 | ((Rerr (Rabort (Rffi_error v43) :v error_result) :(v sem_env, v) result),(Rerr (Rraise v36) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rraise v48) :(v sem_env, v) result),(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rraise v48) :(v sem_env, v) result),(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result)) => k2 < k1 | ((Rerr (Rraise v48) :(v sem_env, v) result),(Rerr (Rabort (Rffi_error v51) :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result),(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result),(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) => k1 < k2 | ((Rerr (Rabort (Rffi_error v56) :v error_result) :(v sem_env, v) result),(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result),(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result)) => k2 < k1 | ((Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result),(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result)) => T | ((Rerr (Rabort (Rffi_error v59) :v error_result) :(v sem_env, v) result),(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result)) => k2 < k1 | ((Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result),(Rerr (Rabort (Rffi_error v54) :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2 | ((Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result),(Rerr (Rabort (Rffi_error v54) :v error_result) :(v sem_env, v) result)) => k1 < k2 | ((Rerr (Rabort (Rffi_error v61) :v error_result) :(v sem_env, v) result),(Rerr (Rabort (Rffi_error v54) :v error_result) :(v sem_env, v) result)) => s1.ffi = s2.ffi ∧ r1 = r2
