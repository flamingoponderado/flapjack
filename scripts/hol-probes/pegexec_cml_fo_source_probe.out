mk_linfix_fo_def_typed=(∀(tgt :β + num) (acc :(α, β, locs) parsetree). mk_linfix_fo tgt acc ([] :(α, β, locs) parsetree list) = acc) ∧ (∀(tgt :β + num) (t :(α, β, locs) parsetree) (acc :(α, β, locs) parsetree). mk_linfix_fo tgt acc [t] = acc) ∧ ∀(tgt :β + num) (t :(α, β, locs) parsetree) (rest :(α, β, locs) parsetree list) (opt :(α, β, locs) parsetree) (acc :(α, β, locs) parsetree). mk_linfix_fo tgt acc (opt::t::rest) = mk_linfix_fo tgt (mkNd_fo tgt [acc; opt; t]) rest
eval_binary_def_typed=(∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_first v2 v1 = v2) ∧ (∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_second v2 v1 = v1) ∧ (∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_append v2 v1 = v2 ++ v1) ∧ (∀(tgt :MMLnonT + num) (v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary (SemB_mklinfix tgt) v2 v1 = case v2 of ([] :(token, MMLnonT, locs) parsetree list) => ([] :(token, MMLnonT, locs) parsetree list) | h::v2 => [mk_linfix_fo tgt (mkNd_fo tgt [h]) v1]) ∧ (∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_foldl_Eapp v2 v1 = foldl_Eapp_fo (v2 ++ v1)) ∧ (∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_foldl_DType v2 v1 = foldl_DType_fo (v2 ++ v1)) ∧ (∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_papp_ctor_rpt v2 v1 = eval_papp_ctor_rpt_fo (v2 ++ v1)) ∧ (∀(v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary SemB_ebase_paren_apply v2 v1 = peg_Ebase_paren_fo v2) ∧ ∀(tgt :MMLnonT + num) (v2 :(token, MMLnonT, locs) parsetree list) (v1 :(token, MMLnonT, locs) parsetree list). eval_binary (SemB_bindNT0 tgt) v2 v1 = [mkNd_fo tgt (v2 ++ v1)]
