(* Complete ground result serialization: every constructor/payload is retained. *)
fun tree t = if numSyntax.is_numeral t then Arbnum.toString(numSyntax.dest_numeral t) else if wordsSyntax.is_word_literal t then "(word " ^ Arbnum.toString(wordsSyntax.dest_word_literal t) ^ ")" else let val (h,args) = strip_comb t; val {Thy,Name,...} = dest_thy_const h in "(" ^ Thy ^ "$" ^ Name ^ String.concat(map (fn a => " " ^ tree a) args) ^ ")" end;
fun out label q = let val th = EVAL q; val t = rconc th in if null(hyp th) andalso null(free_vars t) then () else raise Fail "non-ground result"; print(label ^ "="); print(tree t); print "\n" end;
fun theoremRow label th = (if null(hyp th) then () else raise Fail "open source hypothesis"; print(label ^ "="); print_thm th; print "\n");
