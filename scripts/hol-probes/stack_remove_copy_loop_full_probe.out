copy_loop_statement=∀i a off bs d m dm i1 a1 m1 x t. copy_words i a off bs d m = SOME (a1,m1) ∧ ALL_DISTINCT [1; 2; 3; t1; t2] ∧ dm = t.mdomain ∧ good_dimindex (:α) ∧ d ⊆ dm ∧ get_var 2 t = SOME (Word a) ∧ get_var 3 t = SOME (Word off) ∧ get_var t2 t = SOME (Word (x + bytes_in_word * n2w i)) ∧ (word_list x (MAP Word bs) * rest * memory m d) (fun2set (t.memory,dm)) ⇒ ∃ck b y y2 m2. evaluate (copy_loop t1 t2,t with clock := t.clock + ck) = (NONE,t with <|memory := m2; regs := (if b then t.regs else t.regs⟨t1 ↦ Word y⟩)⟨t2 ↦ Word y2; 1 ↦ Word 1w; 2 ↦ Word a1⟩|>) ∧ (word_list x (MAP Word bs) * rest * memory m1 d) (fun2set (m2,dm))
copy_loop_proved=T
