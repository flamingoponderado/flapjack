asm_step_IMP_evaluate_step_find_next_typed=∀(c :(α, 'state, β) machine_config) (s1 :α asm_state) (ms1 :'state) (io :γ ffi_state) (i :α asm). encoder_correct c.target ∧ c.prog_addresses = s1.mem_domain ∧ ffi_entry_pcs_disjoint c s1 (LENGTH (c.target.config.encode i)) ∧ interference_ok c.next_interfer (c.target.proj s1.mem_domain) ∧ asm_step c.target.config s1 i (asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word)) s1) ∧ target_state_rel c.target s1 ms1 ⇒ ∃(l :num) (ms2 :'state). ∀(k :num). (evaluate c io (k + l) ms1 :machine_result # 'state # γ ffi_state) = (evaluate (shift_interfer l c) io k ms2 :machine_result # 'state # γ ffi_state) ∧ find_next_interference c io (k + l) ms1 = find_next_interference (shift_interfer l c) io k ms2 ∧ target_state_rel c.target (asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word)) s1) ms2 ∧ l ≠ (0 :num)
asm_step_IMP_evaluate_step_typed=∀(c :(α, 'state, β) machine_config) (s1 :α asm_state) (ms1 :'state) (io :γ ffi_state) (i :α asm). encoder_correct c.target ∧ c.prog_addresses = s1.mem_domain ∧ ffi_entry_pcs_disjoint c s1 (LENGTH (c.target.config.encode i)) ∧ interference_ok c.next_interfer (c.target.proj s1.mem_domain) ∧ asm_step c.target.config s1 i (asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word)) s1) ∧ target_state_rel c.target s1 ms1 ⇒ ∃(l :num) (ms2 :'state). (∀(k :num). (evaluate c io (k + l) ms1 :machine_result # 'state # γ ffi_state) = (evaluate (shift_interfer l c) io k ms2 :machine_result # 'state # γ ffi_state)) ∧ target_state_rel c.target (asm i (s1.pc + (n2w (LENGTH (c.target.config.encode i)) :α word)) s1) ms2 ∧ l ≠ (0 :num)
target_cc_regs_callee_saved_typed=MEM (r :num) (mc :(α, β, γ) machine_config).callee_saved_regs ⇒ target_cc_regs mc (ffi :δ ffi_state) (ms :β) (k :num) r = (NONE :α word option)
target_io_regs_callee_saved_typed=MEM (r :num) (mc :(α, β, γ) machine_config).callee_saved_regs ⇒ target_io_regs mc (ffi :δ ffi_state) (ms :β) (k :num) (name :ffiname) r = (NONE :α word option)
constructed_oracles_cc_step_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME (CcApp (a1 :α word) (a2 :α word) (ms_pre :β) (ms_post :β),(mc' :(α, β, γ) machine_config),(ffi' :δ ffi_state)) ⇒ target_cc_regs mc ffi ms (0 :num) (r :num) = (if MEM r mc.callee_saved_regs ∨ r = mc.ptr_reg ∨ ¬(r < mc.target.config.reg_count) ∨ MEM r mc.target.config.avoid_regs then (NONE :α word option) else SOME (mc.target.get_reg ms_post r)) ∧ target_cc_fp_regs mc ffi ms (0 :num) (i :num) = mc.target.get_fp_reg ms_post i ∧ target_cc_regs mc ffi ms (SUC (k :num)) r = target_cc_regs mc' ffi' ms_post k r ∧ target_cc_fp_regs mc ffi ms (SUC k) i = target_cc_fp_regs mc' ffi' ms_post k i ∧ target_io_regs mc ffi ms k (name :ffiname) r = target_io_regs mc' ffi' ms_post k name r ∧ target_io_fp_regs mc ffi ms k i = target_io_fp_regs mc' ffi' ms_post k i
constructed_oracles_ffi_step_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((FfiApp (index :num) (new_bytes :word8 list) (ms_pre :β) (ms_post :β) :(α, β) interference_app),(mc' :(α, β, γ) machine_config),(ffi' :δ ffi_state)) ⇒ target_io_regs mc ffi ms (0 :num) (name :ffiname) (r :num) = (if MEM r mc.callee_saved_regs ∨ ¬(r < mc.target.config.reg_count) ∨ MEM r mc.target.config.avoid_regs then (NONE :α word option) else SOME (mc.target.get_reg ms_post r)) ∧ target_io_fp_regs mc ffi ms (0 :num) (i :num) = mc.target.get_fp_reg ms_post i ∧ target_io_regs mc ffi ms (SUC (k :num)) name r = target_io_regs mc' ffi' ms_post k name r ∧ target_io_fp_regs mc ffi ms (SUC k) i = target_io_fp_regs mc' ffi' ms_post k i ∧ target_cc_regs mc ffi ms k r = target_cc_regs mc' ffi' ms_post k r ∧ target_cc_fp_regs mc ffi ms k i = target_cc_fp_regs mc' ffi' ms_post k i
encoder_correct_asm_step_target_state_rel_typed=encoder_correct (t :(α, β, γ) target) ∧ target_state_rel t (s1 :α asm_state) (ms :β) ∧ asm_step t.config s1 (i :α asm) (s2 :α asm_state) ⇒ ∃(n :num). target_state_rel t s2 (FUNPOW t.next n ms) ∧ (∀(j :num). j < n ⇒ (∀(pc :α word). pc ∈ all_pcs (LENGTH (t.config.encode i)) s1.pc (0 :num) ⇒ t.get_byte (FUNPOW t.next j ms) pc = t.get_byte ms pc) ∧ t.get_pc (FUNPOW t.next j ms) ∈ all_pcs (LENGTH (t.config.encode i)) s1.pc t.config.code_alignment ∧ t.state_ok (FUNPOW t.next j ms)) ∧ ∀(j :num) (x :α word). j ≤ n ∧ x ∉ s1.mem_domain ⇒ t.get_byte (FUNPOW t.next j ms) x = t.get_byte ms x
encoder_correct_RTC_asm_step_target_state_rel_typed=encoder_correct (t :(α, β, γ) target) ∧ target_state_rel t (s1 :α asm_state) (ms :β) ∧ (λ(s1 :α asm_state) (s2 :α asm_state). ∃(i :α asm). asm_step t.config s1 i s2)꙳ s1 (s2 :α asm_state) ⇒ ∃(n :num). target_state_rel t s2 (FUNPOW t.next n ms)
evaluate_add_clock_typed=∀(mc_conf :(α, β, γ) machine_config) (ffi :δ ffi_state) (k :num) (ms :β) (k1 :num) (r :machine_result) (ms1 :β) (st1 :δ ffi_state). (evaluate mc_conf ffi k ms :machine_result # β # δ ffi_state) = (r,ms1,st1) ∧ r ≠ TimeOut ⇒ (evaluate mc_conf ffi (k + k1) ms :machine_result # β # δ ffi_state) = (r,ms1,st1)
evaluate_add_clock_io_events_mono_typed=∀(mc_conf :(α, β, γ) machine_config) (ffi :δ ffi_state) (k :num) (ms :β) (k' :num). k ≤ k' ⇒ (SND (SND (evaluate mc_conf ffi k ms :machine_result # β # δ ffi_state))).io_events ≼ (SND (SND (evaluate mc_conf ffi k' ms :machine_result # β # δ ffi_state))).io_events
evaluate_EQ_evaluate_lemma_typed=∀(n :num) (ms1 :α) (c :(β, α, γ) machine_config). c.target.get_pc ms1 ∈ c.prog_addresses DIFF set c.ffi_entry_pcs ∧ c.target.state_ok ms1 ∧ c.prog_addresses = (dm :β word -> bool) ∧ interference_ok c.next_interfer (c.target.proj dm) ∧ (∀(s :β asm_state) (ms :α). target_state_rel c.target s ms ⇒ c.target.state_ok ms) ∧ (∀(ms1 :α) (ms2 :α). c.target.proj dm ms1 = c.target.proj dm ms2 ⇒ (c.target.state_ok ms1 ⇔ c.target.state_ok ms2) ∧ c.target.get_pc ms1 = c.target.get_pc ms2 ∧ ∀(a :β word). a ∈ dm ⇒ c.target.get_byte ms1 a = c.target.get_byte ms2 a) ∧ (∀(env :num -> α -> α). interference_ok env (c.target.proj dm) ⇒ asserts n (λ(k :num) (s :α). env k (c.target.next s)) ms1 (λ(ms' :α). c.target.state_ok ms' ∧ (∀(pc :β word). pc ∈ all_pcs (LENGTH (c.target.config.encode (i :β asm))) (init_pc :β word) (0 :num) ⇒ c.target.get_byte ms' pc = c.target.get_byte ms1 pc) ∧ c.target.get_pc ms' ∈ all_pcs (LENGTH (c.target.config.encode i)) init_pc c.target.config.code_alignment) (λ(ms' :α). target_state_rel c.target (s2 :β asm_state) ms')) ∧ asserts2 (n + (1 :num)) (λ(k :num). c.next_interfer (n + (1 :num) − k)) c.target.next ms1 (λ(ms1 :α) (ms2 :α). ∀(x :β word). x ∉ dm ⇒ c.target.get_byte ms1 x = c.target.get_byte ms2 x) ∧ (∃(k :num). c.target.get_pc ms1 = init_pc + (n2w (k * (2 :num) ** c.target.config.code_alignment) :β word) ∧ k * (2 :num) ** c.target.config.code_alignment < LENGTH (c.target.config.encode i) ∧ bytes_in_memory init_pc (c.target.config.encode i) (c.target.get_byte ms1) (c.prog_addresses DIFF set c.ffi_entry_pcs)) ⇒ ∃(ms2 :α). ∀(k :num). (evaluate c (io :δ ffi_state) (k + (n + (1 :num))) ms1 :machine_result # α # δ ffi_state) = (evaluate (shift_interfer (n + (1 :num)) c) io k ms2 :machine_result # α # δ ffi_state) ∧ find_next_interference c io (k + (n + (1 :num))) ms1 = find_next_interference (shift_interfer (n + (1 :num)) c) io k ms2 ∧ target_state_rel c.target s2 ms2
evaluate_io_events_mono_typed=∀(mc_conf :(α, β, γ) machine_config) (ffi :δ ffi_state) (k :num) (ms :β). ffi.io_events ≼ (SND (SND (evaluate mc_conf ffi k ms :machine_result # β # δ ffi_state))).io_events
find_next_interference_def_typed=∀(ms :α) (mc :(β, α, γ) machine_config) (k :num) (ffi :'ffi ffi_state). find_next_interference mc ffi k ms = if k = (0 :num) then (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) else if mc.target.get_pc ms ∈ mc.prog_addresses DIFF set mc.ffi_entry_pcs then if encoded_bytes_in_mem mc.target.config (mc.target.get_pc ms) (mc.target.get_byte ms) mc.prog_addresses then (let (ms1 :α) = mc.target.next ms; ((ms2 :α),(new_oracle :num -> α -> α)) = apply_oracle mc.next_interfer ms1; (mc' :(β, α, γ) machine_config) = mc with next_interfer := new_oracle in if EVERY mc'.target.state_ok [ms; ms1; ms2] ∧ ∀(x :β word). x ∉ mc'.prog_addresses ⇒ mc'.target.get_byte ms1 x = mc'.target.get_byte ms x then find_next_interference mc' ffi (k − (1 :num)) ms2 else (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option)) else (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) else if mc.target.get_pc ms = mc.halt_pc then (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) else if mc.target.get_pc ms = mc.ccache_pc then (let ((ms1 :α),(new_oracle :num -> β word # β word # α -> α)) = apply_oracle mc.ccache_interfer (mc.target.get_reg ms mc.ptr_reg,mc.target.get_reg ms mc.len_reg,ms) in SOME (CcApp (mc.target.get_reg ms mc.ptr_reg) (mc.target.get_reg ms mc.len_reg) ms ms1,mc with ccache_interfer := new_oracle,ffi)) else case find_index (mc.target.get_pc ms) mc.ffi_entry_pcs (0 :num) of (NONE :num option) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) | SOME ffi_index => case mc.ffi_names❲ffi_index❳ of ExtCall v1 => (case ALOOKUP mc.mmio_info ffi_index of (NONE :(word8 # β addr # num # β word) option) => (case read_ffi_bytearrays mc ms of ((NONE :word8 list option),v3) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) | (SOME bytes,(NONE :word8 list option)) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) | (SOME bytes,SOME bytes2) => case call_FFI ffi mc.ffi_names❲ffi_index❳ bytes bytes2 of FFI_return new_ffi new_bytes => (let ((ms1 :α),(new_oracle :num -> num # word8 list # α -> α)) = apply_oracle mc.ffi_interfer (ffi_index,new_bytes,ms) in SOME ((FfiApp ffi_index new_bytes ms ms1 :(β, α) interference_app),mc with ffi_interfer := new_oracle,new_ffi)) | (FFI_final outcome :'ffi ffi_result) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option)) | SOME v => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option)) | SharedMem op => case ALOOKUP mc.mmio_info ffi_index of (NONE :(word8 # β addr # num # β word) option) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) | SOME (nb,a,reg,pc') => case op of MappedRead => (case a of Addr r off => (let (ad :β word) = mc.target.get_reg ms r + off in if (if nb = (0w :word8) then w2n ad MOD (dimindex (:β) DIV (8 :num)) = (0 :num) else T) ∧ ad ∈ mc.shared_addresses ∧ is_valid_mapped_read (mc.target.get_pc ms) nb a reg pc' mc.target ms mc.prog_addresses then case call_FFI ffi mc.ffi_names❲ffi_index❳ [nb] (word_to_bytes ad F) of FFI_return new_ffi new_bytes => (let ((ms1 :α),(new_oracle :num -> num # word8 list # α -> α)) = apply_oracle mc.ffi_interfer (ffi_index,new_bytes,ms) in SOME ((FfiApp ffi_index new_bytes ms ms1 :(β, α) interference_app),mc with ffi_interfer := new_oracle,new_ffi)) | (FFI_final outcome :'ffi ffi_result) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) else (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option))) | MappedWrite => case a of Addr r off => (let (ad :β word) = mc.target.get_reg ms r + off in if (if nb = (0w :word8) then w2n ad MOD (dimindex (:β) DIV (8 :num)) = (0 :num) else T) ∧ ad ∈ mc.shared_addresses ∧ is_valid_mapped_write (mc.target.get_pc ms) nb a reg pc' mc.target ms mc.prog_addresses then case call_FFI ffi mc.ffi_names❲ffi_index❳ [nb] ((let (w :β word) = mc.target.get_reg ms reg in if nb = (0w :word8) then word_to_bytes w F else word_to_bytes_aux (w2n nb) w F) ++ word_to_bytes ad F) of FFI_return new_ffi new_bytes => (let ((ms1 :α),(new_oracle :num -> num # word8 list # α -> α)) = apply_oracle mc.ffi_interfer (ffi_index,new_bytes,ms) in SOME ((FfiApp ffi_index new_bytes ms ms1 :(β, α) interference_app),mc with ffi_interfer := new_oracle,new_ffi)) | (FFI_final outcome :'ffi ffi_result) => (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option) else (NONE :((β, α) interference_app # (β, α, γ) machine_config # 'ffi ffi_state) option))
bytes_in_memory_DIFF_typed=∀(p :α word). (dm :α word -> bool) = (dm2 :α word -> bool) DIFF (pcs :α word -> bool) ∧ bytes_in_memory p (xs :word8 list) (m :α word -> word8) dm2 ∧ DISJOINT pcs {p + (n2w i :α word) | i < LENGTH xs} ⇒ bytes_in_memory p xs m dm
bytes_in_memory_SUBSET_typed=∀(p :α word). (dm :α word -> bool) ⊆ (dm2 :α word -> bool) ∧ bytes_in_memory p (xs :word8 list) (m :α word -> word8) dm ⇒ bytes_in_memory p xs m dm2
ffi_entry_pcs_disjoint_def_typed=∀(mc :(α, β, γ) machine_config) (s1 :α asm_state) (len :num). ffi_entry_pcs_disjoint mc s1 len ⇔ DISJOINT (set mc.ffi_entry_pcs) {s1.pc + (n2w a :α word) | a < len}
shift_interfer_def_typed=∀(k :num) (s :(α, β, γ) machine_config). shift_interfer k s = s with next_interfer := shift_seq k s.next_interfer
interference_app_typed=FfiApp::num -> word8 list -> 'state -> 'state -> (α, 'state) interference_app; CcApp::α word -> α word -> 'state -> 'state -> (α, 'state) interference_app
app_post_def_typed=(∀(index :num) (new_bytes :word8 list) (ms_pre :α) (ms_post :α). app_post (FfiApp index new_bytes ms_pre ms_post :(β, α) interference_app) = ms_post) ∧ ∀(a1 :β word) (a2 :β word) (ms_pre :α) (ms_post :α). app_post (CcApp a1 a2 ms_pre ms_post) = ms_post
is_ffi_app_def_typed=(∀(index :num) (new_bytes :word8 list) (ms_pre :β) (ms_post :β). is_ffi_app (FfiApp index new_bytes ms_pre ms_post :(α, β) interference_app) ⇔ T) ∧ ∀(a1 :α word) (a2 :α word) (ms_pre :β) (ms_post :β). is_ffi_app (CcApp a1 a2 ms_pre ms_post) ⇔ F
interference_app_seq_def_typed=(∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β). interference_app_seq mc ffi ms (0 :num) = next_interference mc ffi ms) ∧ ∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (n :num). interference_app_seq mc ffi ms (SUC n) = case next_interference mc ffi ms of (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) => (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) | SOME (app,mc',ffi') => interference_app_seq mc' ffi' (app_post app) n
interference_count_def_typed=(∀(P :(α, β) interference_app -> bool) (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β). interference_count P mc ffi ms (0 :num) = (0 :num)) ∧ ∀(P :(α, β) interference_app -> bool) (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (n :num). interference_count P mc ffi ms (SUC n) = interference_count P mc ffi ms n + case interference_app_seq mc ffi ms n of (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) => (0 :num) | SOME (v1,v2) => if P v1 then (1 :num) else (0 :num)
interference_pos_def_typed=∀(P :(α, β) interference_app -> bool) (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (k :num). interference_pos P mc ffi ms k = some(n :num). interference_count P mc ffi ms n = k ∧ ∃(app :(α, β) interference_app) (mc' :(α, β, γ) machine_config) (ffi' :δ ffi_state). interference_app_seq mc ffi ms n = SOME (app,mc',ffi') ∧ P app
next_interference_def_typed=∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β). next_interference mc ffi ms = some(res :(α, β) interference_app # (α, β, γ) machine_config # δ ffi_state). ∃(k :num). find_next_interference mc ffi k ms = SOME res
next_interference_ccache_typed=(mc :(α, β, γ) machine_config).target.get_pc (ms :β) ∉ mc.prog_addresses DIFF set mc.ffi_entry_pcs ∧ mc.target.get_pc ms ≠ mc.halt_pc ∧ mc.target.get_pc ms = mc.ccache_pc ⇒ next_interference mc (ffi :δ ffi_state) ms = SOME (CcApp (mc.target.get_reg ms mc.ptr_reg) (mc.target.get_reg ms mc.len_reg) ms (mc.ccache_interfer (0 :num) (mc.target.get_reg ms mc.ptr_reg,mc.target.get_reg ms mc.len_reg,ms)),mc with ccache_interfer := shift_seq (1 :num) mc.ccache_interfer,ffi)
next_interference_ExtCall_typed=(mc :(α, β, γ) machine_config).target.get_pc (ms :β) ∉ mc.prog_addresses DIFF set mc.ffi_entry_pcs ∧ mc.target.get_pc ms ≠ mc.halt_pc ∧ mc.target.get_pc ms ≠ mc.ccache_pc ∧ find_index (mc.target.get_pc ms) mc.ffi_entry_pcs (0 :num) = SOME (index :num) ∧ mc.ffi_names❲index❳ = ExtCall (name :mlstring) ∧ ALOOKUP mc.mmio_info index = (NONE :(word8 # α addr # num # α word) option) ∧ read_ffi_bytearrays mc ms = (SOME (bytes :word8 list),SOME (bytes2 :word8 list)) ∧ call_FFI (ffi :δ ffi_state) (ExtCall name) bytes bytes2 = FFI_return (new_ffi :δ ffi_state) (new_bytes :word8 list) ⇒ next_interference mc ffi ms = SOME ((FfiApp index new_bytes ms (mc.ffi_interfer (0 :num) (index,new_bytes,ms)) :(α, β) interference_app),mc with ffi_interfer := shift_seq (1 :num) mc.ffi_interfer,new_ffi)
next_interference_intro_typed=find_next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (k :num) (ms :β) = SOME (res :(α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) ⇒ next_interference mc ffi ms = SOME res
next_interference_shift_typed=(∀(k :num). find_next_interference (mc1 :(α, β, γ) machine_config) (ffi1 :δ ffi_state) (k + (l :num)) (ms1 :β) = find_next_interference (mc2 :(α, β, γ) machine_config) (ffi2 :δ ffi_state) k (ms2 :β)) ⇒ next_interference mc1 ffi1 ms1 = next_interference mc2 ffi2 ms2
next_interference_MappedRead_typed=(mc :(β, α, γ) machine_config).target.get_pc (ms :α) ∉ mc.prog_addresses DIFF set mc.ffi_entry_pcs ∧ mc.target.get_pc ms ≠ mc.halt_pc ∧ mc.target.get_pc ms ≠ mc.ccache_pc ∧ find_index (mc.target.get_pc ms) mc.ffi_entry_pcs (0 :num) = SOME (index :num) ∧ mc.ffi_names❲index❳ = SharedMem MappedRead ∧ ALOOKUP mc.mmio_info index = SOME ((nb :word8),Addr (r :num) (off :β word),(reg :num),(pc' :β word)) ∧ (nb = (0w :word8) ⇒ w2n (mc.target.get_reg ms r + off) MOD (dimindex (:β) DIV (8 :num)) = (0 :num)) ∧ mc.target.get_reg ms r + off ∈ mc.shared_addresses ∧ is_valid_mapped_read (mc.target.get_pc ms) nb (Addr r off) reg pc' mc.target ms mc.prog_addresses ∧ call_FFI (ffi :δ ffi_state) mc.ffi_names❲index❳ [nb] (word_to_bytes (mc.target.get_reg ms r + off) F) = FFI_return (new_ffi :δ ffi_state) (new_bytes :word8 list) ⇒ next_interference mc ffi ms = SOME ((FfiApp index new_bytes ms (mc.ffi_interfer (0 :num) (index,new_bytes,ms)) :(β, α) interference_app),mc with ffi_interfer := shift_seq (1 :num) mc.ffi_interfer,new_ffi)
next_interference_MappedWrite_typed=(mc :(β, α, γ) machine_config).target.get_pc (ms :α) ∉ mc.prog_addresses DIFF set mc.ffi_entry_pcs ∧ mc.target.get_pc ms ≠ mc.halt_pc ∧ mc.target.get_pc ms ≠ mc.ccache_pc ∧ find_index (mc.target.get_pc ms) mc.ffi_entry_pcs (0 :num) = SOME (index :num) ∧ mc.ffi_names❲index❳ = SharedMem MappedWrite ∧ ALOOKUP mc.mmio_info index = SOME ((nb :word8),Addr (r :num) (off :β word),(reg :num),(pc' :β word)) ∧ (nb = (0w :word8) ⇒ w2n (mc.target.get_reg ms r + off) MOD (dimindex (:β) DIV (8 :num)) = (0 :num)) ∧ mc.target.get_reg ms r + off ∈ mc.shared_addresses ∧ is_valid_mapped_write (mc.target.get_pc ms) nb (Addr r off) reg pc' mc.target ms mc.prog_addresses ∧ call_FFI (ffi :δ ffi_state) mc.ffi_names❲index❳ [nb] ((let (w :β word) = mc.target.get_reg ms reg in if nb = (0w :word8) then word_to_bytes w F else word_to_bytes_aux (w2n nb) w F) ++ word_to_bytes (mc.target.get_reg ms r + off) F) = FFI_return (new_ffi :δ ffi_state) (new_bytes :word8 list) ⇒ next_interference mc ffi ms = SOME ((FfiApp index new_bytes ms (mc.ffi_interfer (0 :num) (index,new_bytes,ms)) :(β, α) interference_app),mc with ffi_interfer := shift_seq (1 :num) mc.ffi_interfer,new_ffi)
next_interference_SharedMem_typed=(mc :(β, α, γ) machine_config).target.get_pc (ms :α) ∉ mc.prog_addresses DIFF set mc.ffi_entry_pcs ∧ mc.target.get_pc ms ≠ mc.halt_pc ∧ mc.target.get_pc ms ≠ mc.ccache_pc ∧ find_index (mc.target.get_pc ms) mc.ffi_entry_pcs (0 :num) = SOME (index :num) ∧ mc.ffi_names❲index❳ = SharedMem (op :shmem_op) ∧ ALOOKUP mc.mmio_info index = SOME ((nb :word8),Addr (r :num) (off :β word),(reg :num),(pc' :β word)) ∧ (nb = (0w :word8) ⇒ w2n (mc.target.get_reg ms r + off) MOD (dimindex (:β) DIV (8 :num)) = (0 :num)) ∧ mc.target.get_reg ms r + off ∈ mc.shared_addresses ∧ (op = MappedRead ⇒ is_valid_mapped_read (mc.target.get_pc ms) nb (Addr r off) reg pc' mc.target ms mc.prog_addresses ∧ call_FFI (ffi :δ ffi_state) mc.ffi_names❲index❳ [nb] (word_to_bytes (mc.target.get_reg ms r + off) F) = FFI_return (new_ffi :δ ffi_state) (new_bytes :word8 list)) ∧ (op = MappedWrite ⇒ is_valid_mapped_write (mc.target.get_pc ms) nb (Addr r off) reg pc' mc.target ms mc.prog_addresses ∧ call_FFI ffi mc.ffi_names❲index❳ [nb] ((let (w :β word) = mc.target.get_reg ms reg in if nb = (0w :word8) then word_to_bytes w F else word_to_bytes_aux (w2n nb) w F) ++ word_to_bytes (mc.target.get_reg ms r + off) F) = FFI_return new_ffi new_bytes) ⇒ next_interference mc ffi ms = SOME ((FfiApp index new_bytes ms (mc.ffi_interfer (0 :num) (index,new_bytes,ms)) :(β, α) interference_app),mc with ffi_interfer := shift_seq (1 :num) mc.ffi_interfer,new_ffi)
constructed_oracles_EQ_typed=next_interference (mc1 :(α, β, γ) machine_config) (ffi1 :δ ffi_state) (ms1 :β) = next_interference (mc2 :(α, β, γ) machine_config) (ffi2 :δ ffi_state) (ms2 :β) ∧ mc1.target = mc2.target ∧ mc1.callee_saved_regs = mc2.callee_saved_regs ∧ mc1.ptr_reg = mc2.ptr_reg ⇒ target_io_regs mc1 ffi1 ms1 = target_io_regs mc2 ffi2 ms2 ∧ target_io_fp_regs mc1 ffi1 ms1 = target_io_fp_regs mc2 ffi2 ms2 ∧ target_cc_regs mc1 ffi1 ms1 = target_cc_regs mc2 ffi2 ms2 ∧ target_cc_fp_regs mc1 ffi1 ms1 = target_cc_fp_regs mc2 ffi2 ms2
interference_count_EQ_typed=next_interference (mc1 :(α, β, γ) machine_config) (ffi1 :δ ffi_state) (ms1 :β) = next_interference (mc2 :(α, β, γ) machine_config) (ffi2 :δ ffi_state) (ms2 :β) ⇒ ∀(n :num). interference_count (P :(α, β) interference_app -> bool) mc1 ffi1 ms1 n = interference_count P mc2 ffi2 ms2 n
interference_count_tail_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((app0 :(α, β) interference_app),(mcc :(α, β, γ) machine_config),(ffic :δ ffi_state)) ⇒ ∀(n :num). interference_count (P :(α, β) interference_app -> bool) mc ffi ms (SUC n) = (if P app0 then (1 :num) else (0 :num)) + interference_count P mcc ffic (app_post app0) n
interference_pos_head_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((app0 :(α, β) interference_app),(mcc :(α, β, γ) machine_config),(ffic :δ ffi_state)) ∧ (P :(α, β) interference_app -> bool) app0 ⇒ interference_pos P mc ffi ms (0 :num) = SOME (0 :num)
interference_pos_tail_hit_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((app0 :(α, β) interference_app),(mcc :(α, β, γ) machine_config),(ffic :δ ffi_state)) ∧ (P :(α, β) interference_app -> bool) app0 ⇒ interference_pos P mc ffi ms (SUC (k :num)) = OPTION_MAP SUC (interference_pos P mcc ffic (app_post app0) k)
interference_pos_tail_miss_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((app0 :(α, β) interference_app),(mcc :(α, β, γ) machine_config),(ffic :δ ffi_state)) ∧ ¬(P :(α, β) interference_app -> bool) app0 ⇒ interference_pos P mc ffi ms (k :num) = OPTION_MAP SUC (interference_pos P mcc ffic (app_post app0) k)
interference_count_lt_typed=interference_app_seq (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (n :num) = SOME ((app :(α, β) interference_app),(mc' :(α, β, γ) machine_config),(ffi' :δ ffi_state)) ∧ (P :(α, β) interference_app -> bool) app ∧ n < (n2 :num) ⇒ interference_count P mc ffi ms n < interference_count P mc ffi ms n2
interference_pos_unique_typed=interference_app_seq (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (n1 :num) = SOME ((app1 :(α, β) interference_app),(mc1' :(α, β, γ) machine_config),(ffi1' :δ ffi_state)) ∧ (P :(α, β) interference_app -> bool) app1 ∧ interference_app_seq mc ffi ms (n2 :num) = SOME ((app2 :(α, β) interference_app),(mc2' :(α, β, γ) machine_config),(ffi2' :δ ffi_state)) ∧ P app2 ∧ interference_count P mc ffi ms n1 = interference_count P mc ffi ms n2 ⇒ n1 = n2
ccache_interfer_ok_post_ccache_asm_typed=ccache_interfer_ok (pc :α word) (mc_conf :(α, β, γ) machine_config) ∧ target_state_rel mc_conf.target ((t1 :α asm_state) with pc := -(n2w ((2 :num) * ffi_offset) :α word) + pc) (ms2 :β) ∧ aligned mc_conf.target.config.code_alignment (t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n)) ⇒ target_state_rel mc_conf.target (post_ccache_asm mc_conf t1 (mc_conf.ccache_interfer (k :num) ((a1 :α word),(a2 :α word),ms2))) (mc_conf.ccache_interfer k (a1,a2,ms2))
ffi_interfer_ok_post_ffi_asm_typed=ffi_interfer_ok (pc :α word) (mc_conf :(α, β, γ) machine_config) ∧ (index :num) < LENGTH mc_conf.ffi_names ∧ mmio_pcs_min_index mc_conf.ffi_names = SOME (i :num) ∧ index < i ∧ mc_conf.prog_addresses = (t1 :α asm_state).mem_domain ∧ read_ffi_bytearrays mc_conf (ms2 :β) = (SOME (bytes :word8 list),SOME (bytes2 :word8 list)) ∧ LENGTH (new_bytes :word8 list) = LENGTH bytes2 ∧ (mc_conf.ffi_names❲index❳ = ExtCall «» ⇒ new_bytes = bytes2) ∧ target_state_rel mc_conf.target (t1 with pc := -(n2w (((3 :num) + index) * ffi_offset) :α word) + pc) ms2 ∧ aligned mc_conf.target.config.code_alignment (t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n)) ⇒ target_state_rel mc_conf.target (post_ffi_asm mc_conf t1 new_bytes (mc_conf.ffi_interfer (k :num) (index,new_bytes,ms2))) (mc_conf.ffi_interfer k (index,new_bytes,ms2))
target_cc_fp_regs_def_typed=∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (k :num) (i :num). target_cc_fp_regs mc ffi ms k i = case interference_pos (λ(app :(α, β) interference_app). ¬is_ffi_app app) mc ffi ms k of (NONE :num option) => (0w :word64) | SOME n => case interference_app_seq mc ffi ms n of (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) => (0w :word64) | SOME ((FfiApp v18 v19 v20 v21 :(α, β) interference_app),v5) => (0w :word64) | SOME (CcApp v22 v23 v24 v25,v5) => mc.target.get_fp_reg v25 i
target_cc_regs_def_typed=∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (k :num) (r :num). target_cc_regs mc ffi ms k r = case interference_pos (λ(app :(α, β) interference_app). ¬is_ffi_app app) mc ffi ms k of (NONE :num option) => (NONE :α word option) | SOME n => case interference_app_seq mc ffi ms n of (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) => (NONE :α word option) | SOME ((FfiApp v18 v19 v20 v21 :(α, β) interference_app),v5) => (NONE :α word option) | SOME (CcApp v22 v23 v24 v25,v5) => if MEM r mc.callee_saved_regs ∨ r = mc.ptr_reg ∨ ¬(r < mc.target.config.reg_count) ∨ MEM r mc.target.config.avoid_regs then (NONE :α word option) else SOME (mc.target.get_reg v25 r)
target_io_fp_regs_def_typed=∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (k :num) (i :num). target_io_fp_regs mc ffi ms k i = case interference_pos (is_ffi_app :(α, β) interference_app -> bool) mc ffi ms k of (NONE :num option) => (0w :word64) | SOME n => case interference_app_seq mc ffi ms n of (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) => (0w :word64) | SOME ((FfiApp v18 v19 v20 v21 :(α, β) interference_app),v5) => mc.target.get_fp_reg v21 i | SOME (CcApp v22 v23 v24 v25,v5) => (0w :word64)
target_io_regs_def_typed=∀(mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (k :num) (name :ffiname) (r :num). target_io_regs mc ffi ms k name r = case interference_pos (is_ffi_app :(α, β) interference_app -> bool) mc ffi ms k of (NONE :num option) => (NONE :α word option) | SOME n => case interference_app_seq mc ffi ms n of (NONE :((α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) option) => (NONE :α word option) | SOME ((FfiApp v18 v19 v20 v21 :(α, β) interference_app),v5) => if MEM r mc.callee_saved_regs ∨ ¬(r < mc.target.config.reg_count) ∨ MEM r mc.target.config.avoid_regs then (NONE :α word option) else SOME (mc.target.get_reg v21 r) | SOME (CcApp v22 v23 v24 v25,v5) => (NONE :α word option)
find_next_interference_const_typed=∀(k :num) (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (app :(α, β) interference_app) (mc' :(α, β, γ) machine_config) (ffi' :δ ffi_state). find_next_interference mc ffi k ms = SOME (app,mc',ffi') ⇒ mc'.target = mc.target ∧ mc'.callee_saved_regs = mc.callee_saved_regs ∧ mc'.ptr_reg = mc.ptr_reg
next_interference_const_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((app :(α, β) interference_app),(mc' :(α, β, γ) machine_config),(ffi' :δ ffi_state)) ⇒ mc'.target = mc.target ∧ mc'.callee_saved_regs = mc.callee_saved_regs ∧ mc'.ptr_reg = mc.ptr_reg
find_next_interference_mono_typed=∀(k :num) (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) (res :(α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) (i :num). find_next_interference mc ffi k ms = SOME res ⇒ find_next_interference mc ffi (k + i) ms = SOME res
find_next_interference_unique_typed=find_next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (k1 :num) (ms :β) = SOME (res1 :(α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) ∧ find_next_interference mc ffi (k2 :num) ms = SOME (res2 :(α, β) interference_app # (α, β, γ) machine_config # δ ffi_state) ⇒ res1 = res2
interference_app_seq_EQ_typed=next_interference (mc1 :(α, β, γ) machine_config) (ffi1 :δ ffi_state) (ms1 :β) = next_interference (mc2 :(α, β, γ) machine_config) (ffi2 :δ ffi_state) (ms2 :β) ⇒ ∀(n :num). interference_app_seq mc1 ffi1 ms1 n = interference_app_seq mc2 ffi2 ms2 n
interference_app_seq_tail_typed=next_interference (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) = SOME ((app :(α, β) interference_app),(mc' :(α, β, γ) machine_config),(ffi' :δ ffi_state)) ⇒ ∀(n :num). interference_app_seq mc ffi ms (SUC n) = interference_app_seq mc' ffi' (app_post app) n
interference_count_mono_typed=∀(i :num) (m :num). interference_count (P :(α, β) interference_app -> bool) (mc :(α, β, γ) machine_config) (ffi :δ ffi_state) (ms :β) m ≤ interference_count P mc ffi ms (m + i)
