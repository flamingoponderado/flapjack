evaluate_add_clock_compile_state_typed=evaluate ((p :α prog),compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = ((res :α result option),compile_state (0 :num) c (s' :(α, β, γ) state)) ∧ res ≠ SOME (TimeOut :α result) ⇒ ∀(extra :num). evaluate (p,compile_state (clk + extra) c s) = (res,compile_state extra c s')
