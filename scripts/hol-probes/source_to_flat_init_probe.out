eval_state_ok=(init_eval_state_ok (NONE :eval_state option) ⇔ T) ∧ (init_eval_state_ok (SOME (EvalDecs (v0 :eval_decs_state))) ⇔ F) ∧ (init_eval_state_ok (SOME (EvalOracle (s :eval_oracle_state))) ⇔ s.generation = (0 :num) ∧ s.envs = [([] :semanticPrimitives$v sem_env list)])
type_entries=init_genv_ty_els = [(bool_id,[(false_tag,(0 :num),TypeStamp «False» bool_type_num); (true_tag,(0 :num),TypeStamp «True» bool_type_num)]); (list_id,REVERSE [(cons_tag,(2 :num),TypeStamp «::» list_type_num); (nil_tag,(0 :num),TypeStamp «[]» list_type_num)])]
constructor_entries=init_genv_els = FLAT (MAP (λ((id :num),(xs :(num # num # stamp) list)). MAP (λ((tag :num),(arity :num),(stamp :stamp)). (((tag,SOME id),arity),stamp)) xs) init_genv_ty_els) ++ [(((div_tag,(NONE :num option)),(0 :num)),div_stamp); (((chr_tag,(NONE :num option)),(0 :num)),chr_stamp); (((subscript_tag,(NONE :num option)),(0 :num)),subscript_stamp); (((bind_tag,(NONE :num option)),(0 :num)),bind_stamp)]
