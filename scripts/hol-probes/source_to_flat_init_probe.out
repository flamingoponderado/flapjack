precondition_stamp_helper_local=EVERY (λ((_0 :(num # num option) # num),(stamp :stamp)). case stamp of TypeStamp cn t => t < (type_stamp :num) | ExnStamp cn' => cn' < (exn_stamp :num)) init_genv_els ⇒ (∀(cn :mlstring) (t :num). t ≥ type_stamp ⇒ TypeStamp cn t ∉ FRANGE init_genv.c) ∧ ∀(cn :num). cn ≥ exn_stamp ⇒ ExnStamp cn ∉ FRANGE init_genv.c
