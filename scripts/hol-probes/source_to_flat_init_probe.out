precondition1=∀(interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (s1 :β semanticPrimitives$state) (env1 :γ sem_env) (conf :config) (eval_conf :α install_config) (prog :dec list). precondition1 interp g s1 env1 conf eval_conf prog ⇔ src_orac_step_invs interp g s1.eval_state ∧ orac_rel interp g s1.eval_state eval_conf ∧ (case src_orac_next_cfg interp s1.eval_state of (NONE :config option) => T | SOME cfg => cfg = FST (compile_prog conf prog)) ∧ conf.next.vidx = (0 :num) ∧ s1.refs = ([] :semanticPrimitives$v store_v list) ∧ init_global_env_inv init_genv conf.mod_env env1 ∧ init_eval_state_ok s1.eval_state ∧ idx_prev init_genv_next conf.next ∧ EVERY (λ((_0 :(num # num option) # num),(stamp :stamp)). case stamp of TypeStamp cn t => t < s1.next_type_stamp | ExnStamp cn' => cn' < s1.next_exn_stamp) init_genv_els ∧ conf.envs = empty_config.envs
precondition1_change_clock=precondition1 (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (s1 :β semanticPrimitives$state) (env1 :γ sem_env) (conf :config) (eval_conf :α install_config) (prog :dec list) ⇒ precondition1 interp g (s1 with clock := (k :num)) env1 conf eval_conf prog
precondition=∀(interp :(semanticPrimitives$v -> (config # α) option) option) (s :β semanticPrimitives$state) (env :γ sem_env) (cfg :config) (ec :α install_config) (prog :dec list). precondition interp s env cfg ec prog ⇔ ∃(ec1 :α install_config) (g :dec list -> dec list). precondition1 interp g s env cfg ec1 prog ∧ install_conf_rel cfg.pattern_cfg ec1 ec
