bool_value_injective_typed=(Boolv (b :bool) :v) = (Boolv (b' :bool) :v) ⇔ (b ⇔ b')
evaluate_bool_typed=s_rel (genv :global_env) (s :α semanticPrimitives$state) (s' :(β, α) flatSem$state) ∧ genv_c_ok genv.c ⇒ (evaluate (env :v environment) s' [Bool (t :tra) (b :bool)] :(β, α) flatSem$state # (v list, v) result) = (s',(Rval [(Boolv b :v)] :(v list, v) result))
opt_case_bool_eq_replay=(option_CASE (opt :α option) (nc :bool) (scc :α -> bool) :bool) ⇔ opt = (NONE :α option) ∧ nc ∨ ∃(x :α). opt = SOME x ∧ scc x
all_disjoint_move_typed=∀(i :num) (j :num) (mv_set :α -> bool) (xs :(α -> bool) list) (ys :(α -> bool) list). ALL_DISJOINT xs ∧ ys = xs❲i ↦ xs❲i❳ DIFF mv_set; j ↦ xs❲j❳ ∪ mv_set❳ ∧ mv_set ⊆ xs❲i❳ ∧ i < LENGTH xs ∧ j < LENGTH xs ⇒ ALL_DISJOINT ys
all_disjoint_subsets_typed=∀(xs :(α -> bool) list) (ys :(α -> bool) list). ALL_DISJOINT xs ∧ LIST_REL (λ(x :α -> bool) (y :α -> bool). y ⊆ x) xs ys ⇒ ALL_DISJOINT ys
pmatch_invariant_typed=invariant (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idxs :next_indices # next_indices # (num # idx_types -> bool)) (st :β semanticPrimitives$state) (st' :(α, β) flatSem$state) ∧ env_all_rel genv (comp_map2 :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (env' :v environment) (locals :mlstring list) ∧ comp_map2.c = (comp_map :source_to_flat$environment).c ∧ (v_rel genv (v :semanticPrimitives$v) (v' :v) :bool) ⇒ match_result_rel genv ([] :(mlstring # semanticPrimitives$v) list) (pmatch env.c st.refs (p :ast$pat) v ([] :(mlstring # semanticPrimitives$v) list) :(mlstring # semanticPrimitives$v) list match_result) (pmatch st' (compile_pat comp_map p) v' ([] :(mlstring # v) list) :(mlstring # v) list match_result)
alookup_alloc_defs_el_replay=∀(funs :(α # β # γ) list) (l :num) (n :num) (m :num). ALL_DISTINCT (MAP (λ((x :α),(y :β),(z :γ)). x) funs) ∧ n < LENGTH funs ⇒ ∃(tt :tra). ALOOKUP (alloc_defs m l (MAP (FST :α # β # γ -> α) (REVERSE funs))) (MAP (FST :α # β # γ -> α) funs)❲n❳ = SOME (Glob tt (l + LENGTH funs − (n + (1 :num))))
el_add_some_some_replay=((pre :α option list) ++ MAP (SOME :α -> α option) (xs :α list) ++ (post :α option list))❲(i :num)❳ ≠ (NONE :α option) ⇔ (pre ++ REPLICATE (LENGTH xs) (NONE :α option) ++ post)❲i❳ ≠ (NONE :α option) ∨ LENGTH pre ≤ i ∧ i < LENGTH pre + LENGTH xs
el_append_if_typed=((xs :α list) ++ (ys :α list))❲(i :num)❳ = if i < LENGTH xs then xs❲i❳ else ys❲i − LENGTH xs❳
all_disjoint_elem_typed=∀(x :α) (i :num). ALL_DISJOINT (xs :(α -> bool) list) ∧ i < LENGTH xs ∧ x ∈ xs❲i❳ ⇒ EVERY (I :bool -> bool) (MAPi (λ(j :num) (y :α -> bool). j = i ∨ x ∉ y) xs)
all_disjoint_definition_typed=∀(xs :(α -> bool) list). ALL_DISJOINT xs ⇔ ∀(i :num) (j :num). i < LENGTH xs ∧ j < LENGTH xs ∧ i ≠ j ⇒ xs❲i❳ ∩ xs❲j❳ = (∅ :α -> bool)
fst_snd_eq_case_replay=(FST :α # β -> α) = (λ((a :α),(b :β)). a) ∧ (SND :γ # δ -> δ) = (λ((a :γ),(b :δ)). b)
inj_definition_typed=∀(f :α -> β) (s :α -> bool) (t :β -> bool). INJ f s t ⇔ (∀(x :α). x ∈ s ⇒ f x ∈ t) ∧ ∀(x :α) (y :α). x ∈ s ∧ y ∈ s ⇒ f x = f y ⇒ x = y
some_f_inj_eq_typed=INJ (f :α -> β) 𝕌(:α) 𝕌(:β) ∧ (y :β) = f (x :α) ⇒ (some(x :α). y = f x) = SOME x
alloc_tags_invariant_typed=(alloc_tags (idx :next_indices).tidx (ctors :(mlstring # ast_t list) list) :(mlstring, mlstring, num # (num # (num # num) list) option) namespace # num sptree$num_map) = ((ns :(mlstring, mlstring, num # (num # (num # num) list) option) namespace),(cids :num sptree$num_map)) ∧ invariant (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idx,(end_idx :next_indices),(os :num # idx_types -> bool)) (st :β semanticPrimitives$state) (st' :(α, β) flatSem$state) ∧ global_env_inv genv (comp_map :source_to_flat$environment) (∅ :mlstring -> bool) (env :semanticPrimitives$v sem_env) ∧ ALL_DISTINCT (MAP (FST :mlstring # ast_t list -> mlstring) ctors) ∧ idx.tidx + (1 :num) ≤ end_idx.tidx ⇒ ∃(genv' :global_env). genv.c ⊑ genv'.c ∧ genv.tys ⊑ genv'.tys ∧ genv'.v = genv.v ∧ invariant interp g gen genv' (idx with tidx := idx.tidx + (1 :num),end_idx,os) (st with next_type_stamp := st.next_type_stamp + (1 :num)) st' ∧ (let (build_env :semanticPrimitives$v sem_env) = <|c := (alist_to_ns (REVERSE (build_constrs st.next_type_stamp ctors)) :(mlstring, mlstring, num # stamp) namespace); v := (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace)|> in global_env_inv genv' <|c := ns; v := (nsEmpty :(mlstring, mlstring, var_name) namespace)|> (∅ :mlstring -> bool) build_env ∧ env_domain_eq <|c := ns; v := (nsEmpty :(mlstring, mlstring, var_name) namespace)|> build_env)
alookup_map_3_typed=(∀(x :α # β). MEM x (xs :(α # β) list) ⇒ FST ((f :α # β -> α # γ) x) = FST x) ⇒ ALOOKUP (MAP f xs) (x :α) = OPTION_MAP (λ(y :β). SND (f (x,y))) (ALOOKUP xs x)
alloc_tags1_imp_typed=∀(ctors :(α # β list) list) (ns :(γ, α, num) namespace) (spt :num sptree$num_map) (tag_list :(num # num) list). (alloc_tags1 ctors :(γ, α, num) namespace # num sptree$num_map # (num # num) list) = (ns,spt,tag_list) ∧ ALL_DISTINCT (MAP (FST :α # β list -> α) ctors) ⇒ ∃(cn_tags :(α # num # num) list). ns = (alist_to_ns (MAP (λ((cn :α),(tag :num),(arity :num)). (cn,tag)) cn_tags) :(γ, α, num) namespace) ∧ set (MAP (SND :α # num # num -> num # num) cn_tags) = {(tag,arity) | ∃(max :num). lookup arity spt = SOME max ∧ tag < max} ∧ tag_list = MAP (SND :α # num # num -> num # num) cn_tags ∧ ALL_DISTINCT tag_list ∧ LIST_REL (λ((cn :α),(ts :β list)) ((cn' :α),(_0 :num),(arity :num)). cn = cn' ∧ arity = LENGTH ts) ctors cn_tags ∧ MAP (FST :α # β list -> α) ctors = MAP (FST :α # num # num -> α) cn_tags
nsAppend_foldl_prime_replay=∀(l :((α, β, γ) namespace # δ) list) (ns :(α, β, γ) namespace) (ns' :(α, β, γ) namespace). nsAppend (FOLDL (λ(ns :(α, β, γ) namespace) ((l :(α, β, γ) namespace),(cids :δ)). nsAppend l ns) ns' l) ns = FOLDL (λ(ns :(α, β, γ) namespace) ((l :(α, β, γ) namespace),(cids :δ)). nsAppend l ns) (nsAppend ns' ns) l
nsAppend_foldl_replay=∀(l :((α, β, γ) namespace # δ) list) (ns :(α, β, γ) namespace). FOLDL (λ(ns :(α, β, γ) namespace) ((l :(α, β, γ) namespace),(cids :δ)). nsAppend l ns) ns l = nsAppend (FOLDL (λ(ns :(α, β, γ) namespace) ((l :(α, β, γ) namespace),(cids :δ)). nsAppend l ns) (nsEmpty :(α, β, γ) namespace) l) ns
build_tdefs_no_mod_replay=∀(idx :num) (tdefs :(mlstring list # mlstring # (mlstring # ast_t list) list) list). nsDomMod (build_tdefs idx tdefs) = {([] :mlstring list)}
abort_simps_typed=(abort (Rerr (Rabort (a :abort) :β error_result) :(α, β) result) ⇔ T) ∧ (abort (Rerr (Rraise (e :δ)) :(γ, δ) result) ⇔ F) ∧ (abort (Rval (v :ε) :(ε, ζ) result) ⇔ F)
nsLookup_nsBind_If_typed=nsLookup (nsBind (n :γ) (v :α) (e :(β, γ, α) namespace)) (nm :(β, γ) id) = if nm = (Short n :(β, γ) id) then SOME v else nsLookup e nm
not_abort_imp_cases_replay=(¬abort (r :(α, β) result) ⇒ (P :bool)) ⇒ (∃(a :abort). r = (Rerr (Rabort a :β error_result) :(α, β) result)) ∨ ¬abort r ∧ P
eval_state_ok=(init_eval_state_ok (NONE :eval_state option) ⇔ T) ∧ (init_eval_state_ok (SOME (EvalDecs (v0 :eval_decs_state))) ⇔ F) ∧ (init_eval_state_ok (SOME (EvalOracle (s :eval_oracle_state))) ⇔ s.generation = (0 :num) ∧ s.envs = [([] :semanticPrimitives$v sem_env list)])
type_entries=init_genv_ty_els = [(bool_id,[(false_tag,(0 :num),TypeStamp «False» bool_type_num); (true_tag,(0 :num),TypeStamp «True» bool_type_num)]); (list_id,REVERSE [(cons_tag,(2 :num),TypeStamp «::» list_type_num); (nil_tag,(0 :num),TypeStamp «[]» list_type_num)])]
constructor_entries=init_genv_els = FLAT (MAP (λ((id :num),(xs :(num # num # stamp) list)). MAP (λ((tag :num),(arity :num),(stamp :stamp)). (((tag,SOME id),arity),stamp)) xs) init_genv_ty_els) ++ [(((div_tag,(NONE :num option)),(0 :num)),div_stamp); (((chr_tag,(NONE :num option)),(0 :num)),chr_stamp); (((subscript_tag,(NONE :num option)),(0 :num)),subscript_stamp); (((bind_tag,(NONE :num option)),(0 :num)),bind_stamp)]
initial_env=init_genv = <|v := ([] :v option list); c := (FEMPTY :(num # num option) # num |-> stamp) |++ init_genv_els; tys := (FEMPTY :num |-> (num # num) list) |++ MAP ((I :num -> num) ## MAP ((I :num -> num) ## (FST :num # stamp -> num))) init_genv_ty_els|>
initial_next=init_genv_next = <|vidx := (0 :num); tidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 i => i | ExnStamp v5 => (0 :num)) init_genv_els)); eidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 v4 => (0 :num) | ExnStamp i => i) init_genv_els))|>
initial_global_inv=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :α sem_env). init_global_env_inv genv comp_map env ⇔ env.v = (nsEmpty :(mlstring, mlstring, α) namespace) ∧ case env.c of Bind ns ms => ms = ([] :(mlstring # (mlstring, mlstring, num # stamp) namespace) list) ∧ EVERY (λ((x :mlstring),(arity :num),(stamp :stamp)). case nsLookup comp_map.c (Short x :(mlstring, mlstring) id) of (NONE :(num # (num # (num # num) list) option) option) => F | SOME (cn,ty_gp) => FLOOKUP genv.c ((cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),arity) = SOME stamp ∧ case ty_gp of (NONE :(num # (num # num) list) option) => T | SOME (ty_id,ctors) => FLOOKUP genv.tys ty_id = SOME ctors) ns
