do_app_rec_help_replay=∀(genv :global_env) (comp_map :source_to_flat$environment) (env_v_local :(mlstring, mlstring, semanticPrimitives$v) namespace) (env_v_local' :v environment) (env_v_top :α) (funs :(mlstring # mlstring # ast$exp) list) (t :mlstring list). env_rel genv env_v_local env_v_local'.v ∧ global_env_inv genv comp_map (set (MAP (FST :mlstring # v -> mlstring) env_v_local'.v)) (env' :semanticPrimitives$v sem_env) ∧ LENGTH (ts :tra list) = LENGTH (funs' :(mlstring # mlstring # ast$exp) list) + LENGTH env_v_local'.v ⇒ env_rel genv (alist_to_ns (MAP (λ((f :mlstring),(n :mlstring),(e :ast$exp)). (f,(Recclosure (env' with v := nsAppend env_v_local env'.v) funs' f :semanticPrimitives$v))) funs) :(mlstring, mlstring, semanticPrimitives$v) namespace) (MAP (λ((fn :mlstring),(n :mlstring),(e :exp)). (fn,(Recclosure env_v_local' (compile_funs t (comp_map with v := FOLDR (λ((x :mlstring),(v :var_name)) (e :(mlstring, mlstring, var_name) namespace). nsBind x v e) comp_map.v (MAP2 (λ(t :tra) (x :mlstring). (x,Local t x)) ts (MAP (FST :mlstring # mlstring # ast$exp -> mlstring) funs' ++ MAP (FST :mlstring # v -> mlstring) env_v_local'.v) :(mlstring # var_name) list)) funs') fn :v))) (compile_funs t (comp_map with v := FOLDR (λ((x :mlstring),(v :var_name)) (e :(mlstring, mlstring, var_name) namespace). nsBind x v e) comp_map.v (MAP2 (λ(t :tra) (x :mlstring). (x,Local t x)) ts (MAP (FST :mlstring # mlstring # ast$exp -> mlstring) funs' ++ MAP (FST :mlstring # v -> mlstring) env_v_local'.v) :(mlstring # var_name) list)) funs))
global_env_inv_add_locals_replay=∀(genv :global_env) (comp_map :source_to_flat$environment) (locals1 :mlstring -> bool) (locals2 :mlstring -> bool) (env :semanticPrimitives$v sem_env). global_env_inv genv comp_map locals1 env ⇒ global_env_inv genv comp_map (locals2 ∪ locals1) env
global_env_inv_extend2_typed=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (new_vars :(mlstring # var_name) list) (env' :(mlstring, mlstring, semanticPrimitives$v) namespace) (locals :mlstring -> bool) (env_c :(mlstring, mlstring, num # stamp) namespace). set (MAP ((Short :mlstring -> (mlstring, mlstring) id) ∘ (FST :mlstring # var_name -> mlstring)) new_vars) = nsDom env' ∧ global_env_inv genv comp_map locals env ∧ global_env_inv genv (comp_map with v := (alist_to_ns new_vars :(mlstring, mlstring, var_name) namespace)) locals <|v := env'; c := env_c|> ⇒ global_env_inv genv (comp_map with v := nsBindList new_vars comp_map.v) locals (env with v := nsAppend env' env.v)
global_env_inv_extend2_replay=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (new_vars :(mlstring # var_name) list) (env' :(mlstring, mlstring, semanticPrimitives$v) namespace) (locals :mlstring -> bool) (env_c :(mlstring, mlstring, num # stamp) namespace). set (MAP ((Short :mlstring -> (mlstring, mlstring) id) ∘ (FST :mlstring # var_name -> mlstring)) new_vars) = nsDom env' ∧ global_env_inv genv comp_map locals env ∧ global_env_inv genv (comp_map with v := (alist_to_ns new_vars :(mlstring, mlstring, var_name) namespace)) locals <|v := env'; c := env_c|> ⇒ global_env_inv genv (comp_map with v := nsBindList new_vars comp_map.v) locals (env with v := nsAppend env' env.v)
lookup_build_rec_env_lem_replay=∀(x :mlstring) (cl_env :semanticPrimitives$v sem_env) (funs' :(mlstring # mlstring # ast$exp) list) (funs :(mlstring # α # β) list). ALOOKUP (MAP (λ((fn :mlstring),(n :α),(e :β)). (fn,(Recclosure cl_env funs' fn :semanticPrimitives$v))) funs) x = SOME (v :semanticPrimitives$v) ⇒ v = (Recclosure cl_env funs' x :semanticPrimitives$v)
sem_env_eq_lemma_replay=∀(env :α sem_env) (x :(mlstring, mlstring, β) namespace). env with v := x = <|v := x; c := env.c|>
eta2_replay=∀(f :α -> β -> γ) (x :α). (λ(y :β). f x y) = f x
ctor_same_type_refl_replay=ctor_same_type (x :(α # β) option) x
ctor_same_type_snd_replay=ctor_same_type (SOME (x :α # β)) (SOME (y :γ # β)) ⇔ SND x = SND y
