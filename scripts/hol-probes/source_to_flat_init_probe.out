source_compile_prog=∀(c :config) (p :dec list). compile_prog c p = (let (next :next_indices) = c.next with vidx := c.next.vidx + (1 :num); (envs :environment_generation_store) = <|next := (0 :num); generation := c.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|>; ((_0 :num),(next :next_indices),(e :source_to_flat$environment),(gen :environment_generation_store),(p' :exp list)) = compile_decs ([] :mlstring list) (1 :num) next c.mod_env envs p; (envs2 :environment_store) = <|next := c.envs.next + (1 :num); env_gens := insert c.envs.next gen.envs c.envs.env_gens|> in (c with <|next := next; envs := envs2; mod_env := e|>,glob_alloc next c::alloc_env_ref::p'))
