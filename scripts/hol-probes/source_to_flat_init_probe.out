eval_state_ok=(init_eval_state_ok (NONE :eval_state option) ⇔ T) ∧ (init_eval_state_ok (SOME (EvalDecs (v0 :eval_decs_state))) ⇔ F) ∧ (init_eval_state_ok (SOME (EvalOracle (s :eval_oracle_state))) ⇔ s.generation = (0 :num) ∧ s.envs = [([] :semanticPrimitives$v sem_env list)])
type_entries=init_genv_ty_els = [(bool_id,[(false_tag,(0 :num),TypeStamp «False» bool_type_num); (true_tag,(0 :num),TypeStamp «True» bool_type_num)]); (list_id,REVERSE [(cons_tag,(2 :num),TypeStamp «::» list_type_num); (nil_tag,(0 :num),TypeStamp «[]» list_type_num)])]
constructor_entries=init_genv_els = FLAT (MAP (λ((id :num),(xs :(num # num # stamp) list)). MAP (λ((tag :num),(arity :num),(stamp :stamp)). (((tag,SOME id),arity),stamp)) xs) init_genv_ty_els) ++ [(((div_tag,(NONE :num option)),(0 :num)),div_stamp); (((chr_tag,(NONE :num option)),(0 :num)),chr_stamp); (((subscript_tag,(NONE :num option)),(0 :num)),subscript_stamp); (((bind_tag,(NONE :num option)),(0 :num)),bind_stamp)]
initial_env=init_genv = <|v := ([] :v option list); c := (FEMPTY :(num # num option) # num |-> stamp) |++ init_genv_els; tys := (FEMPTY :num |-> (num # num) list) |++ MAP ((I :num -> num) ## MAP ((I :num -> num) ## (FST :num # stamp -> num))) init_genv_ty_els|>
initial_next=init_genv_next = <|vidx := (0 :num); tidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 i => i | ExnStamp v5 => (0 :num)) init_genv_els)); eidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 v4 => (0 :num) | ExnStamp i => i) init_genv_els))|>
initial_global_inv=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :α sem_env). init_global_env_inv genv comp_map env ⇔ env.v = (nsEmpty :(mlstring, mlstring, α) namespace) ∧ case env.c of Bind ns ms => ms = ([] :(mlstring # (mlstring, mlstring, num # stamp) namespace) list) ∧ EVERY (λ((x :mlstring),(arity :num),(stamp :stamp)). case nsLookup comp_map.c (Short x :(mlstring, mlstring) id) of (NONE :(num # (num # (num # num) list) option) option) => F | SOME (cn,ty_gp) => FLOOKUP genv.c ((cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),arity) = SOME stamp ∧ case ty_gp of (NONE :(num # (num # num) list) option) => T | SOME (ty_id,ctors) => FLOOKUP genv.tys ty_id = SOME ctors) ns
initial_global_imp=init_global_env_inv (genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) ⇒ global_env_inv genv comp_map (∅ :mlstring -> bool) env
initial_env_ok=genv_c_ok init_genv.c
initial_types_ok=genv_c_tys_ok init_genv.c init_genv.tys
flat_initial_state=∀(ffi :'ffi ffi_state) (k :num) (ec :γ install_config). initial_state ffi k ec = <|clock := k; refs := ([] :v store_v list); ffi := ffi; globals := ([] :v option list); eval_config := ec|>
flat_semantics=∀(ec :γ install_config) (ffi :'ffi ffi_state) (prog :exp list). (semantics ec ffi prog :behaviour) = if ∃(k :num). SND (evaluate_decs (initial_state ffi k ec) prog :(γ, 'ffi) flatSem$state # v error_result option) = SOME (Rabort Rtype_error :v error_result) then Fail else case some(res :behaviour). ∃(k :num) (s :(γ, 'ffi) flatSem$state) (r :v error_result option) (outcome :outcome). (evaluate_decs (initial_state ffi k ec) prog :(γ, 'ffi) flatSem$state # v error_result option) = (s,r) ∧ (case r of (NONE :v error_result option) => outcome = Success | SOME (Rraise v4) => outcome = Success | SOME (Rabort Rtype_error :v error_result) => F | SOME (Rabort Rtimeout_error :v error_result) => F | SOME (Rabort (Rffi_error e) :v error_result) => outcome = FFI_outcome e) ∧ res = Terminate outcome s.ffi.io_events of (NONE :behaviour option) => Diverge (LUB (IMAGE (λ(k :num). (fromList (FST (evaluate_decs (initial_state ffi k ec) prog :(γ, 'ffi) flatSem$state # v error_result option)).ffi.io_events :io_event llist)) 𝕌(:num))) | SOME res => res
compile_flat=∀(pcfg :flat_pattern$config). compile_flat pcfg = MAP (compile_dec pcfg) ∘ remove_flat_prog
compile=∀(c :config) (p :dec list). compile c p = (let ((c' :config),(p' :exp list)) = compile_prog c p; (p' :exp list) = compile_flat c'.pattern_cfg p' in (c',p'))
incremental_compile=∀(env_id :num # num) (c :config) (p :dec list). inc_compile env_id c p = (let ((c' :config),(p' :exp list)) = inc_compile_prog env_id c p; (p' :exp list) = MAP (compile_dec c'.pattern_cfg) p' in (c',p'))
evaluated_entries=[((((0 :num),SOME (0 :num)),(0 :num)),TypeStamp «False» (0 :num)); ((((1 :num),SOME (0 :num)),(0 :num)),TypeStamp «True» (0 :num)); ((((0 :num),SOME (1 :num)),(0 :num)),TypeStamp «[]» (1 :num)); ((((0 :num),SOME (1 :num)),(2 :num)),TypeStamp «::» (1 :num)); ((((2 :num),(NONE :num option)),(0 :num)),ExnStamp (2 :num)); ((((1 :num),(NONE :num option)),(0 :num)),ExnStamp (1 :num)); ((((3 :num),(NONE :num option)),(0 :num)),ExnStamp (3 :num)); ((((0 :num),(NONE :num option)),(0 :num)),ExnStamp (0 :num))]
evaluated_next=<|vidx := (0 :num); tidx := (2 :num); eidx := (4 :num)|>
