eval_state_ok=(init_eval_state_ok (NONE :eval_state option) ⇔ T) ∧ (init_eval_state_ok (SOME (EvalDecs (v0 :eval_decs_state))) ⇔ F) ∧ (init_eval_state_ok (SOME (EvalOracle (s :eval_oracle_state))) ⇔ s.generation = (0 :num) ∧ s.envs = [([] :semanticPrimitives$v sem_env list)])
type_entries=init_genv_ty_els = [(bool_id,[(false_tag,(0 :num),TypeStamp «False» bool_type_num); (true_tag,(0 :num),TypeStamp «True» bool_type_num)]); (list_id,REVERSE [(cons_tag,(2 :num),TypeStamp «::» list_type_num); (nil_tag,(0 :num),TypeStamp «[]» list_type_num)])]
constructor_entries=init_genv_els = FLAT (MAP (λ((id :num),(xs :(num # num # stamp) list)). MAP (λ((tag :num),(arity :num),(stamp :stamp)). (((tag,SOME id),arity),stamp)) xs) init_genv_ty_els) ++ [(((div_tag,(NONE :num option)),(0 :num)),div_stamp); (((chr_tag,(NONE :num option)),(0 :num)),chr_stamp); (((subscript_tag,(NONE :num option)),(0 :num)),subscript_stamp); (((bind_tag,(NONE :num option)),(0 :num)),bind_stamp)]
initial_env=init_genv = <|v := ([] :v option list); c := (FEMPTY :(num # num option) # num |-> stamp) |++ init_genv_els; tys := (FEMPTY :num |-> (num # num) list) |++ MAP ((I :num -> num) ## MAP ((I :num -> num) ## (FST :num # stamp -> num))) init_genv_ty_els|>
initial_next=init_genv_next = <|vidx := (0 :num); tidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 i => i | ExnStamp v5 => (0 :num)) init_genv_els)); eidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 v4 => (0 :num) | ExnStamp i => i) init_genv_els))|>
initial_global_inv=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :α sem_env). init_global_env_inv genv comp_map env ⇔ env.v = (nsEmpty :(mlstring, mlstring, α) namespace) ∧ case env.c of Bind ns ms => ms = ([] :(mlstring # (mlstring, mlstring, num # stamp) namespace) list) ∧ EVERY (λ((x :mlstring),(arity :num),(stamp :stamp)). case nsLookup comp_map.c (Short x :(mlstring, mlstring) id) of (NONE :(num # (num # (num # num) list) option) option) => F | SOME (cn,ty_gp) => FLOOKUP genv.c ((cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),arity) = SOME stamp ∧ case ty_gp of (NONE :(num # (num # num) list) option) => T | SOME (ty_id,ctors) => FLOOKUP genv.tys ty_id = SOME ctors) ns
initial_global_imp=init_global_env_inv (genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) ⇒ global_env_inv genv comp_map (∅ :mlstring -> bool) env
precondition1=∀(interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (s1 :β semanticPrimitives$state) (env1 :γ sem_env) (conf :config) (eval_conf :α install_config) (prog :dec list). precondition1 interp g s1 env1 conf eval_conf prog ⇔ src_orac_step_invs interp g s1.eval_state ∧ orac_rel interp g s1.eval_state eval_conf ∧ (case src_orac_next_cfg interp s1.eval_state of (NONE :config option) => T | SOME cfg => cfg = FST (compile_prog conf prog)) ∧ conf.next.vidx = (0 :num) ∧ s1.refs = ([] :semanticPrimitives$v store_v list) ∧ init_global_env_inv init_genv conf.mod_env env1 ∧ init_eval_state_ok s1.eval_state ∧ idx_prev init_genv_next conf.next ∧ EVERY (λ((_0 :(num # num option) # num),(stamp :stamp)). case stamp of TypeStamp cn t => t < s1.next_type_stamp | ExnStamp cn' => cn' < s1.next_exn_stamp) init_genv_els ∧ conf.envs = empty_config.envs
precondition1_change_clock=precondition1 (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (s1 :β semanticPrimitives$state) (env1 :γ sem_env) (conf :config) (eval_conf :α install_config) (prog :dec list) ⇒ precondition1 interp g (s1 with clock := (k :num)) env1 conf eval_conf prog
precondition=∀(interp :(semanticPrimitives$v -> (config # α) option) option) (s :β semanticPrimitives$state) (env :γ sem_env) (cfg :config) (ec :α install_config) (prog :dec list). precondition interp s env cfg ec prog ⇔ ∃(ec1 :α install_config) (g :dec list -> dec list). precondition1 interp g s env cfg ec1 prog ∧ install_conf_rel cfg.pattern_cfg ec1 ec
source_compile_semantics=precondition (interp :(semanticPrimitives$v -> (config # α) option) option) (s :β semanticPrimitives$state) (env :semanticPrimitives$v sem_env) (cfg :config) (ec :α install_config) (prog :dec list) ⇒ ¬semantics_prog s env prog Fail ⇒ semantics_prog s env prog (semantics ec s.ffi (SND (compile cfg prog)) :behaviour)
source_compile_prog=∀(c :config) (p :dec list). compile_prog c p = (let (next :next_indices) = c.next with vidx := c.next.vidx + (1 :num); (envs :environment_generation_store) = <|next := (0 :num); generation := c.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|>; ((_0 :num),(next :next_indices),(e :source_to_flat$environment),(gen :environment_generation_store),(p' :exp list)) = compile_decs ([] :mlstring list) (1 :num) next c.mod_env envs p; (envs2 :environment_store) = <|next := c.envs.next + (1 :num); env_gens := insert c.envs.next gen.envs c.envs.env_gens|> in (c with <|next := next; envs := envs2; mod_env := e|>,glob_alloc next c::alloc_env_ref::p'))
source_glob_alloc=∀(next :next_indices) (c :config). glob_alloc next c = (Let om_tra (NONE :mlstring option) (App om_tra (GlobalVarAlloc (next.vidx − c.next.vidx)) ([] :exp list) :exp) (Con om_tra (NONE :(num # num option) option) ([] :exp list) :exp) :exp)
source_alloc_env_ref=alloc_env_ref = (App None (GlobalVarInit (0 :num)) [(App None (Src Opref) [(Con None (NONE :(num # num option) option) ([] :exp list) :exp)] :exp)] :exp)
source_lookup_env_id=∀(env_id :num # num) (envs :environment_store). lookup_env_id env_id envs = case lookup (FST env_id) envs.env_gens of (NONE :source_to_flat$environment sptree$num_map option) => empty_env | SOME gen => case lookup (SND env_id) gen of (NONE :source_to_flat$environment option) => empty_env | SOME env => env
source_store_env_id=∀(gen :num) (id :num). store_env_id gen id = (Let None (SOME «r») (App None (GlobalVarLookup (0 :num)) ([] :exp list) :exp) (App None (Src Opassign) [Var_local None «r»; env_id_tuple gen id] :exp) :exp)
source_inc_compile_prog=∀(env_id :num # num) (c :config) (p :dec list). inc_compile_prog env_id c p = (let (env :source_to_flat$environment) = lookup_env_id env_id c.envs; (envs :environment_generation_store) = <|next := (0 :num); generation := c.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|>; ((_0 :num),(next :next_indices),(e :source_to_flat$environment),(gen :environment_generation_store),(p' :exp list)) = compile_decs ([] :mlstring list) (1 :num) c.next env envs p; (gen_envs :source_to_flat$environment sptree$num_map) = insert gen.next (extend_env e env) gen.envs; (envs2 :environment_store) = <|next := c.envs.next + (1 :num); env_gens := insert c.envs.next gen_envs c.envs.env_gens|> in (c with <|next := next; envs := envs2|>,glob_alloc next c::p' ++ [store_env_id gen.generation gen.next]))
initial_env_ok=genv_c_ok init_genv.c
initial_types_ok=genv_c_tys_ok init_genv.c init_genv.tys
keep_global_allocation=keep (calc :α sptree$num_map) (glob_alloc (next :next_indices) (st :config))
elimination_keep=∀(reachable :α sptree$num_map) (e :exp). keep reachable e ⇔ if isEmpty (inter (find_loc e) reachable) then ¬is_pure e else T
incremental_nonempty=inc_compile_prog (env_id :num # num) (st :config) (decs :dec list) = ((st' :config),(fdecs :exp list)) ⇒ fdecs ≠ ([] :exp list)
flat_initial_state=∀(ffi :'ffi ffi_state) (k :num) (ec :γ install_config). initial_state ffi k ec = <|clock := k; refs := ([] :v store_v list); ffi := ffi; globals := ([] :v option list); eval_config := ec|>
flat_semantics=∀(ec :γ install_config) (ffi :'ffi ffi_state) (prog :exp list). (semantics ec ffi prog :behaviour) = if ∃(k :num). SND (evaluate_decs (initial_state ffi k ec) prog :(γ, 'ffi) flatSem$state # v error_result option) = SOME (Rabort Rtype_error :v error_result) then Fail else case some(res :behaviour). ∃(k :num) (s :(γ, 'ffi) flatSem$state) (r :v error_result option) (outcome :outcome). (evaluate_decs (initial_state ffi k ec) prog :(γ, 'ffi) flatSem$state # v error_result option) = (s,r) ∧ (case r of (NONE :v error_result option) => outcome = Success | SOME (Rraise v4) => outcome = Success | SOME (Rabort Rtype_error :v error_result) => F | SOME (Rabort Rtimeout_error :v error_result) => F | SOME (Rabort (Rffi_error e) :v error_result) => outcome = FFI_outcome e) ∧ res = Terminate outcome s.ffi.io_events of (NONE :behaviour option) => Diverge (LUB (IMAGE (λ(k :num). (fromList (FST (evaluate_decs (initial_state ffi k ec) prog :(γ, 'ffi) flatSem$state # v error_result option)).ffi.io_events :io_event llist)) 𝕌(:num))) | SOME res => res
compile_flat=∀(pcfg :flat_pattern$config). compile_flat pcfg = MAP (compile_dec pcfg) ∘ remove_flat_prog
compile=∀(c :config) (p :dec list). compile c p = (let ((c' :config),(p' :exp list)) = compile_prog c p; (p' :exp list) = compile_flat c'.pattern_cfg p' in (c',p'))
incremental_compile=∀(env_id :num # num) (c :config) (p :dec list). inc_compile env_id c p = (let ((c' :config),(p' :exp list)) = inc_compile_prog env_id c p; (p' :exp list) = MAP (compile_dec c'.pattern_cfg) p' in (c',p'))
