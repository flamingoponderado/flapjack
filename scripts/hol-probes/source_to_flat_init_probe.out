initial_next=init_genv_next = <|vidx := (0 :num); tidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 i => i | ExnStamp v5 => (0 :num)) init_genv_els)); eidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 v4 => (0 :num) | ExnStamp i => i) init_genv_els))|>
initial_global_inv=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :α sem_env). init_global_env_inv genv comp_map env ⇔ env.v = (nsEmpty :(mlstring, mlstring, α) namespace) ∧ case env.c of Bind ns ms => ms = ([] :(mlstring # (mlstring, mlstring, num # stamp) namespace) list) ∧ EVERY (λ((x :mlstring),(arity :num),(stamp :stamp)). case nsLookup comp_map.c (Short x :(mlstring, mlstring) id) of (NONE :(num # (num # (num # num) list) option) option) => F | SOME (cn,ty_gp) => FLOOKUP genv.c ((cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),arity) = SOME stamp ∧ case ty_gp of (NONE :(num # (num # num) list) option) => T | SOME (ty_id,ctors) => FLOOKUP genv.tys ty_id = SOME ctors) ns
initial_global_imp=init_global_env_inv (genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) ⇒ global_env_inv genv comp_map (∅ :mlstring -> bool) env
