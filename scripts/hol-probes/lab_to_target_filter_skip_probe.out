not_not_skip_IMP_Skip=¬not_skip (inst' :α line) ⇒
∃(l :word8 list) (n :num).
  inst' = Asm (Asmi (Inst (Skip :α inst) :α asm)) l n
not_not_skip_IMP_Skip_types=(inst' :α line)::α line;
