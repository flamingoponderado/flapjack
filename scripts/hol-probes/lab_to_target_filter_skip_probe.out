IMP_asm_fetch_aux_filter_skip=∀(p :num) (code :α sec list) (i :α line).
  asm_fetch_aux p code = SOME i ∧ not_skip i ⇒
  ∃(p' :num). asm_fetch_aux p' (filter_skip code) = SOME i
IMP_asm_fetch_aux_filter_skip_types=(p :num)::num;(code :α sec list)::α sec list;(i :α line)::α line;
