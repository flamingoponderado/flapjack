asm_fetch_aux_filter_skip=∀(code :α sec list) (p :num).
  asm_fetch_aux p (filter_skip code) = SOME (inst' :α line) ∧ not_skip inst' ⇒
  ∃(p' :num). asm_fetch_aux p' code = SOME inst'
asm_fetch_aux_filter_skip_types=(code :α sec list)::α sec list;(p :num)::num;(inst' :α line)::α line;
