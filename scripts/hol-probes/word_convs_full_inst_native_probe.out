fin_type=:α asm_config -> α prog -> bool
fin_full=⊢ (∀i c. full_inst_ok_less c (Inst i) ⇔ inst_ok_less c i) ∧ (∀p2 p1 c. full_inst_ok_less c (Seq p1 p2) ⇔ full_inst_ok_less c p1 ∧ full_inst_ok_less c p2) ∧ (∀p names exit_names c. full_inst_ok_less c (Loop names p exit_names) ⇔ full_inst_ok_less c p) ∧ (∀ri r1 cmp c2 c1 c. full_inst_ok_less c (If cmp r1 ri c1 c2) ⇔ full_inst_ok_less c c1 ∧ full_inst_ok_less c c2) ∧ (∀p c. full_inst_ok_less c (MustTerminate p) ⇔ full_inst_ok_less c p) ∧ (∀ret handler dest c args. full_inst_ok_less c (Call ret dest args handler) ⇔ case ret of NONE => T | SOME (v6,v8,v10,v11) => full_inst_ok_less c v10 ∧ case handler of NONE => T | SOME (v1,v3,v4) => full_inst_ok_less c v3) ∧ (∀r op c ad. full_inst_ok_less c (ShareInst op r ad) ⇔ case exp_to_addr ad of NONE => F | SOME (Addr v1 w) => if op ∈ {Load; Store; Load32; Store32} then addr_offset_ok c w else if op ∈ {Load16; Store16} then hw_offset_ok c w else byte_offset_ok c w) ∧ (∀c. full_inst_ok_less c Skip ⇔ T) ∧ (∀v15 v14 c. full_inst_ok_less c (Move v14 v15) ⇔ T) ∧ (∀v18 v17 c. full_inst_ok_less c (Assign v17 v18) ⇔ T) ∧ (∀v20 v19 c. full_inst_ok_less c (Get v19 v20) ⇔ T) ∧ (∀v22 v21 c. full_inst_ok_less c (Set v21 v22) ⇔ T) ∧ (∀v24 v23 c. full_inst_ok_less c (Store v23 v24) ⇔ T) ∧ (∀v41 v40 c. full_inst_ok_less c (Alloc v40 v41) ⇔ T) ∧ (∀v46 v45 v44 v43 v42 c. full_inst_ok_less c (StoreConsts v42 v43 v44 v45 v46) ⇔ T) ∧ (∀v47 c. full_inst_ok_less c (Raise v47) ⇔ T) ∧ (∀v49 v48 c. full_inst_ok_less c (Return v48 v49) ⇔ T) ∧ (∀v50 c. full_inst_ok_less c (Break v50) ⇔ T) ∧ (∀v51 c. full_inst_ok_less c (Continue v51) ⇔ T) ∧ (∀c. full_inst_ok_less c Tick ⇔ T) ∧ (∀v54 v53 v52 c. full_inst_ok_less c (OpCurrHeap v52 v53 v54) ⇔ T) ∧ (∀v56 v55 c. full_inst_ok_less c (LocValue v55 v56) ⇔ T) ∧ (∀v61 v60 v59 v58 v57 c. full_inst_ok_less c (Install v57 v58 v59 v60 v61) ⇔ T) ∧ (∀v63 v62 c. full_inst_ok_less c (CodeBufferWrite v62 v63) ⇔ T) ∧ (∀v65 v64 c. full_inst_ok_less c (DataBufferWrite v64 v65) ⇔ T) ∧ ∀v71 v70 v69 v68 v67 v66 c. full_inst_ok_less c (FFI v66 v67 v68 v69 v70 v71) ⇔ T
