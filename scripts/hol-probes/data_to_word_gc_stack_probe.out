gc_combined_thm_typed=abs_ml_inv (conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ ((do_partial :bool) ⇒ has_gen gens) ⇒ ∃(roots2 :α word_loc heap_address list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list) (gens2 :gen_state) (n2 :num) (a2 :num). gc_combined (make_gc_conf limit :(tag # α word_loc list) gen_gc_conf) conf.gc_kind (roots,heap,gens,a + sp + sp1,do_partial) = (roots2,heap2,a2,n2,gens2,T) ∧ abs_ml_inv conf stack refs (roots2,heap2,be,a2,n2,(0 :num),gens2) limit ts ∧ (conf.gc_kind ≠ None ∧ (conf.gc_kind ≠ Simple ⇒ ¬do_partial) ⇒ all_reachable_from_roots roots2 heap2 ∧ heap_length heap2 = data_length heap2 + n2)
reset_gens_typed=∀(conf :data_to_word$config) (a :num). reset_gens conf a = case conf.gc_kind of None => GenState (0 :num) ([] :num list) | Simple => GenState (0 :num) ([] :num list) | Generational sizes => GenState (0 :num) (MAP (K a :num -> num) sizes)
gen_gc_is_final_typed=∀(conf :α) (state :(β, γ) gc_state) (ptr :num). is_final conf state ptr ⇔ (let (h1end :num) = heap_length state.h1; (r3start :num) = state.a + state.n + heap_length state.r4; (r3end :num) = r3start + heap_length state.r3; (r1start :num) = r3end + heap_length state.r2 in ptr < h1end ∨ r1start ≤ ptr ∨ r3start ≤ ptr ∧ ptr < r3end)
