gen_move_len_inv_typed=∀(l :α heap_address) (s :(α, β) gc_state) (l1 :α heap_address) (s1 :(α, β) gc_state). (gc_move (gen_conf :β gen_gc_conf) s l :α heap_address # (α, β) gc_state) = (l1,s1) ∧ s1.ok ∧ len_inv s ⇒ len_inv s1
