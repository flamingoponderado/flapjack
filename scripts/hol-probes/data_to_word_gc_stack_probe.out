gen_gc_move_list_typed=(∀(conf :β gen_gc_conf) (state :(α, β) gc_state). (gc_move_list conf state ([] :α heap_address list) :α heap_address list # (α, β) gc_state) = (([] :α heap_address list),state)) ∧ ∀(conf :β gen_gc_conf) (state :(α, β) gc_state) (x :α heap_address) (xs :α heap_address list). (gc_move_list conf state (x::xs) :α heap_address list # (α, β) gc_state) = (let ((x :α heap_address),(state :(α, β) gc_state)) = (gc_move conf state x :α heap_address # (α, β) gc_state); ((xs :α heap_address list),(state :(α, β) gc_state)) = (gc_move_list conf state xs :α heap_address list # (α, β) gc_state) in (x::xs,state))
gen_gc_move_data_typed=∀(state :(α, β) gc_state) (conf :β gen_gc_conf). gc_move_data conf state = case state.h2 of ([] :(α, β) heap_element list) => state | h::h2 => if conf.limit < heap_length (state.h1 ++ h::h2) then state with ok := F else case h of (Unused v7 :(α, β) heap_element) => state with ok := F | (ForwardPointer v8 v9 v10 :(α, β) heap_element) => state with ok := F | DataElement xs l d => (let ((xs' :α heap_address list),(state' :(α, β) gc_state)) = (gc_move_list conf state xs :α heap_address list # (α, β) gc_state); (h1 :(α, β) heap_element list) = state'.h1 ++ [DataElement xs' l d]; (h2' :(α, β) heap_element list) = TL state'.h2; (ok :bool) = (state'.ok ∧ state'.h2 ≠ ([] :(α, β) heap_element list) ∧ HD state'.h2 = h) in gc_move_data conf (state' with <|h1 := h1; h2 := h2'; ok := ok|>))
