heap_drop_typed=∀(n :num) (heap :(α, β) heap_element list). heap_drop n heap = case heap_split n heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (ARB :(α, β) heap_element list) | SOME (h1,h2) => h2
heap_take_typed=∀(n :num) (heap :(α, β) heap_element list). heap_take n heap = case heap_split n heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (ARB :(α, β) heap_element list) | SOME (h1,h2) => h1
heap_split_heap_length_typed=∀(heap :(α, β) heap_element list) (h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (a :num). heap_split a heap = SOME (h1,h2) ⇒ heap_length h1 = a ∧ heap_length (h1 ++ h2) = heap_length heap ∧ h1 ++ h2 = heap
heap_segment_imp_typed=∀(heap :(α, β) heap_element list) (a :num) (b :num) (h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (h3 :(α, β) heap_element list). heap_segment (a,b) heap = SOME (h1,h2,h3) ⇒ h1 ++ h2 ++ h3 = heap ∧ heap_length h1 = a ∧ heap_length (h1 ++ h2) = b ∧ heap_length h3 = heap_length heap − b
heap_split_append_typed=heap_split (heap_length (h1 :(α, β) heap_element list)) (h1 ++ (h2 :(α, β) heap_element list)) = SOME (h1,h2)
heap_split_append_sum_typed=heap_split (SUM (MAP (el_length :(α, β) heap_element -> num) (h1 :(α, β) heap_element list)) :num) (h1 ++ (h2 :(α, β) heap_element list)) = SOME (h1,h2)
heap_drop_append_typed=heap_drop (heap_length (h1 :(α, β) heap_element list)) (h1 ++ (h2 :(α, β) heap_element list)) = h2
heap_take_append_typed=heap_take (heap_length (h1 :(α, β) heap_element list)) (h1 ++ (h2 :(α, β) heap_element list)) = h1
heap_drop_zero_typed=heap_drop (0 :num) (h :(α, β) heap_element list) = h
gc_forward_ptr_append_typed=∀(h1 :(α, β) heap_element list) (n :num) (h2 :(α, β) heap_element list) (a :num) (b :α) (ok :bool). gc_forward_ptr n (h1 ++ h2) a b ok = if n < heap_length h1 then (λ((h :(α, β) heap_element list),(ok :bool)). (h ++ h2,ok)) (gc_forward_ptr n h1 a b ok) else (λ((h :(α, β) heap_element list),(ok :bool)). (h1 ++ h,ok)) (gc_forward_ptr (n − heap_length h1) h2 a b ok)
