partial_gen_inv_typed=∀(conf :β gen_gc_partial_conf) (heap :(α, β) heap_element list). gen_inv conf heap ⇔ conf.gen_start ≤ conf.refs_start ∧ conf.refs_start ≤ conf.limit ∧ ∃(heap_old :(α, β) heap_element list) (heap_current :(α, β) heap_element list) (heap_refs :(α, β) heap_element list). heap_segment (conf.gen_start,conf.refs_start) heap = SOME (heap_old,heap_current,heap_refs) ∧ EVERY (λ(e :(α, β) heap_element). ¬heap_element_is_ref conf e) heap_old ∧ EVERY (λ(e :(α, β) heap_element). ¬heap_element_is_ref conf e) heap_current ∧ EVERY (isDataElement :(α, β) heap_element -> bool) heap_refs ∧ (∀(n :num) (a :α) (d :num). MEM (ForwardPointer n a d :(α, β) heap_element) heap ⇒ conf.gen_start ≤ n ∧ n < conf.refs_start) ∧ EVERY (isDataElement :(α, β) heap_element -> bool) heap_old ∧ ∀(xs :α heap_address list) (l :num) (d :β) (ptr :num) (u :α). MEM (DataElement xs l d) heap_old ∧ MEM (Pointer ptr u) xs ⇒ ptr < conf.gen_start ∨ conf.refs_start ≤ ptr
