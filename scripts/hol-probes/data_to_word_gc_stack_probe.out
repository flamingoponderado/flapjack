partial_gc_move_ref_list_typed=(∀(state :(α, γ) gc_state) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state ([] :(α, β) heap_element list) = (([] :(α, β) heap_element list),state)) ∧ (∀(xs :(α, β) heap_element list) (state :(α, γ) gc_state) (ptrs :α heap_address list) (l :num) (d :β) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state (DataElement ptrs l d::xs) = (let ((ptrs' :α heap_address list),(state' :(α, γ) gc_state)) = (gc_move_list conf state ptrs :α heap_address list # (α, γ) gc_state); ((xs' :(α, β) heap_element list),(state'' :(α, γ) gc_state)) = gc_move_ref_list conf state' xs in (DataElement ptrs' l d::xs',state''))) ∧ (∀(xs :(α, β) heap_element list) (v6 :num) (state :(α, γ) gc_state) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state ((Unused v6 :(α, β) heap_element)::xs) = ((Unused v6 :(α, β) heap_element)::xs,state with ok := F)) ∧ ∀(xs :(α, β) heap_element list) (v9 :num) (v8 :α) (v7 :num) (state :(α, γ) gc_state) (conf :γ gen_gc_partial_conf). gc_move_ref_list conf state ((ForwardPointer v7 v8 v9 :(α, β) heap_element)::xs) = ((ForwardPointer v7 v8 v9 :(α, β) heap_element)::xs,state with ok := F)
