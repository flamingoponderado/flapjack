s_in_word :α word) * (n2w (heap_length s1.h2) :α word) ∧ pb1 = pa1 + (bytes_in_word :α word) * (n2w s1.n :α word) ∧ EVERY (is_Ref gen_conf.isRef :(α word_loc, tag # α word_loc list) heap_element -> bool) (s1.r4 ++ s1.r3 ++ s1.r2 ++ s1.r1)
word_heap_parts_typed=∀(conf :data_to_word$config) (p :α word) (s :(β word_loc, tag # β word_loc list) gc_state) (xs :β word_loc list). word_heap_parts conf p s xs = word_heap p (s.h1 ++ s.h2) conf * word_list (p + (bytes_in_word :α word) * (n2w (heap_length (s.h1 ++ s.h2)) :α word)) xs * word_heap (p + (bytes_in_word :α word) * (n2w (heap_length (s.h1 ++ s.h2) + LENGTH xs) :α word)) (s.r4 ++ s.r3 ++ s.r2 ++ s.r1) conf
gc_move_const_typed=∀(l :α heap_address) (s :(α, β) gc_state) (xs' :α heap_address) (s' :(α, β) gc_state). (gc_move (gen_conf :β gen_gc_conf) s l :α heap_address # (α, β) gc_state) = (xs',s') ⇒ s'.h1 = s.h1 ∧ s'.r1 = s.r1 ∧ s'.r2 = s.r2 ∧ s'.r3 = s.r3
