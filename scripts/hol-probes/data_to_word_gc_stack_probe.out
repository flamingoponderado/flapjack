ptr_to_addr_get_addr_typed=(k :num) * (2 :num) ** shift_length (conf :data_to_word$config) < dimword (:α) ⇒ ptr_to_addr conf (curr :α word) (get_addr conf k (a :α word_loc)) = curr + (n2w k :α word) * (bytes_in_word :α word)
