gc_shared_heap_segment_typed=∀(a :num) (b :num) (heap :(α, β) heap_element list). heap_segment (a,b) heap = case heap_split a heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) | SOME (h1,heap') => if b < a then (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) else case heap_split (b − heap_length h1) heap' of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) | SOME (h2,h3) => SOME (h1,h2,h3)
gen_gc_move_typed=(∀(conf :β gen_gc_conf) (state :(α, β) gc_state) (d :α). (gc_move conf state (Data d) :α heap_address # (α, β) gc_state) = (Data d,state)) ∧ ∀(conf :β gen_gc_conf) (state :(α, β) gc_state) (ptr :num) (d :α). (gc_move conf state (Pointer ptr d) :α heap_address # (α, β) gc_state) = case heap_lookup ptr state.heap of (NONE :(α, β) heap_element option) => (Pointer ptr d,state with ok := F) | SOME (Unused v9 :(α, β) heap_element) => (Pointer ptr d,state with ok := F) | SOME (ForwardPointer v10 v11 v12 :(α, β) heap_element) => (Pointer v10 d,state) | SOME (DataElement xs l dd) => (let (ok :bool) = (state.ok ∧ l + (1 :num) ≤ state.n); (n :num) = state.n − (l + (1 :num)) in if conf.isRef dd then (let (r4 :(α, β) heap_element list) = DataElement xs l dd::state.r4; ((heap :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr ptr state.heap (state.a + n) d ok in (Pointer (state.a + n) d,state with <|r4 := r4; n := n; heap := heap; ok := ok|>)) else (let (h2 :(α, β) heap_element list) = state.h2 ++ [DataElement xs l dd]; ((heap :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr ptr state.heap state.a d ok; (a :num) = state.a + l + (1 :num) in (Pointer state.a d,state with <|h2 := h2; n := n; a := a; heap := heap; ok := ok|>)))
