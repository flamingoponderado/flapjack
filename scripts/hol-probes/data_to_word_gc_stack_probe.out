word_gen_gc_move_roots_thm_typed=∀(x :α word_loc heap_address list) (xs :α word_loc list) (x1 :α word_loc heap_address list) (w :α word_loc list) (s1 :(α word_loc, tag # α word_loc list) gc_state) (s :(α word_loc, tag # α word_loc list) gc_state) (pb1 :α word) (pa1 :α word) (pa :α word) (m1 :α word -> α word_loc) (m :α word -> α word_loc) (ib1 :α word) (i1 :α word) (frame :(α word # α word_loc -> bool) -> bool) (dm :α word -> bool) (curr :α word) (c1 :bool). (gc_move_list (gen_conf :(tag # α word_loc list) gen_gc_conf) s x :α word_loc heap_address list # (α word_loc, tag # α word_loc list) gc_state) = (x1,s1) ∧ s1.ok ∧ s.h2 = ([] :(α word_loc, tag # α word_loc list) heap_element list) ∧ s.r4 = ([] :(α word_loc, tag # α word_loc list) heap_element list) ∧ heap_length s.heap ≤ dimword (:α) DIV (2 :num) ** shift_length (conf :data_to_word$config) ∧ (∀(t :tag) (r :α word_loc list). gen_conf.isRef (t,r) ⇔ isMutTag t) ∧ conf.len_size + (5 :num) ≤ dimindex (:α) ∧ (word_heap curr s.heap conf * word_list pa xs * frame) (fun2set (m,dm)) ∧ word_gen_gc_move_roots conf (MAP (word_addr conf :α word_loc heap_address -> α word_loc) x,(n2w s.a :α word),pa,(n2w (s.a + s.n) :α word),pa + (bytes_in_word :α word) * (n2w s.n :α word),curr,m,dm) = (w,i1,pa1,ib1,pb1,m1,c1) ∧ EVERY (is_Ref gen_conf.isRef :(α word_loc, tag # α word_loc list) heap_element -> bool) (s.r4 ++ s.r3 ++ s.r2 ++ s.r1) ∧ LENGTH xs = s.n ∧ good_dimindex (:α) ⇒ ∃(xs1 :α word_loc list). (word_heap curr s1.heap conf * word_heap pa s1.h2 conf * word_heap pb1 s1.r4 conf * word_list pa1 xs1 * frame) (fun2set (m1,dm)) ∧ w = MAP (word_addr conf :α word_loc heap_address -> α word_loc) x1 ∧ heap_length s1.heap = heap_length s.heap ∧ c1 ∧ i1 = (n2w s1.a :α word) ∧ ib1 = (n2w (s1.a + s1.n) :α word) ∧ s1.n = LENGTH xs1 ∧ s.n = heap_length s1.h2 + s1.n + heap_length s1.r4 ∧ pa1 = pa + (bytes_in_word :α word) * (n2w (heap_length s1.h2) :α word) ∧ pb1 = pa1 + (bytes_in_word :α word) * (n2w s1.n :α word) ∧ EVERY (is_Ref gen_conf.isRef