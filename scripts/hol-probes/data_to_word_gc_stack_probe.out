gen_gc_typed=∀(conf :β gen_gc_conf) (roots :α heap_address list) (heap :(α, β) heap_element list). gen_gc conf (roots,heap) = (let (state :(α, β) gc_state) = (empty_state :(α, β) gc_state) with <|heap := heap; n := conf.limit; ok := (heap_length heap = conf.limit)|>; ((roots :α heap_address list),(state :(α, β) gc_state)) = (gc_move_list conf state roots :α heap_address list # (α, β) gc_state); (state :(α, β) gc_state) = (gc_move_loop conf state conf.limit :(α, β) gc_state) in (roots,state))
partial_gc_move_typed=(∀(conf :β gen_gc_partial_conf) (state :(α, β) gc_state) (d :α). (gc_move conf state (Data d) :α heap_address # (α, β) gc_state) = (Data d,state)) ∧ ∀(conf :β gen_gc_partial_conf) (state :(α, β) gc_state) (ptr :num) (d :α). (gc_move conf state (Pointer ptr d) :α heap_address # (α, β) gc_state) = (let (ok :bool) = (state.ok ∧ ptr < heap_length state.heap) in if ptr < conf.gen_start ∨ conf.refs_start ≤ ptr then (Pointer ptr d,state with ok := ok) else case heap_lookup ptr state.heap of (NONE :(α, β) heap_element option) => (Pointer ptr d,state with ok := F) | SOME (Unused v9 :(α, β) heap_element) => (Pointer ptr d,state with ok := F) | SOME (ForwardPointer v10 v11 v12 :(α, β) heap_element) => (Pointer v10 d,state) | SOME (DataElement xs l dd) => (let (ok :bool) = (ok ∧ l + (1 :num) ≤ state.n ∧ ¬conf.isRef dd); (n :num) = state.n − (l + (1 :num)); (h2 :(α, β) heap_element list) = state.h2 ++ [DataElement xs l dd]; ((heap :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr ptr state.heap state.a d ok; (a :num) = state.a + l + (1 :num) in (Pointer state.a d,state with <|h2 := h2; n := n; a := a; heap := heap; ok := ok|>)))
gen_gc_move_data_ok_typed=∀(conf :α gen_gc_conf) (s :(β, α) gc_state). (gc_move_data conf s).ok ⇒ s.ok
