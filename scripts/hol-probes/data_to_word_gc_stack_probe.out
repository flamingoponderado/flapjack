memcpy_thm_typed=∀(xs :β list) (a :α word) (c :bool) (b :α word) (m :α word -> β) (m1 :α word -> β) (dm :α word -> bool) (b1 :α word) (ys :β list) (frame :(α word # β -> bool) -> bool). memcpy (n2w (LENGTH xs) :α word) a b m dm = (b1,m1,c) ∧ LENGTH ys = LENGTH xs ∧ LENGTH xs < dimword (:α) ∧ (frame * word_list a xs * word_list b ys) (fun2set (m,dm)) ⇒ (frame * word_list a xs * word_list b xs) (fun2set (m1,dm)) ∧ b1 = b + (n2w (LENGTH xs) :α word) * (bytes_in_word :α word) ∧ c
memcpy_def_typed=∀(w :γ word) (m :α word -> β) (dm :α word -> bool) (b :α word) (a :α word). memcpy w a b m dm = if w = (0w :γ word) then (b,m,T) else (let ((b1 :α word),(m1 :α word -> β),(c1 :bool)) = memcpy (w − (1w :γ word)) (a + (bytes_in_word :α word)) (b + (bytes_in_word :α word)) m⦇b ↦ m a⦈ dm in (b1,m1,c1 ∧ a ∈ dm ∧ b ∈ dm))
