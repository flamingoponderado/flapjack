gc_combined_typed=gc_combined (conf :β gen_gc_conf) None ((roots :α heap_address list),(heap :(α, β) heap_element list),(gs :gen_state),(v0 :num),(v1 :bool)) = (roots,heap,(0 :num),(0 :num),gs,T) ∧ gc_combined conf Simple (roots,heap,gs,(v2 :num),(v3 :bool)) = (let ((roots :α heap_address list),(heap :(α, β) heap_element list),(a :num),(c :bool)) = full_gc (roots,heap,conf.limit) in (roots,heap ++ (heap_expand (conf.limit − a) :(α, β) heap_element list),a,conf.limit − a,gs,c)) ∧ gc_combined conf (Generational (limits :num list)) (roots,heap,gs,(rs :num),(do_partial :bool)) = if do_partial then (let (partial_conf :β gen_gc_partial_conf) = make_partial_conf conf gs rs; ((roots :α heap_address list),(state :(α, β) gc_state)) = partial_gc partial_conf (roots,heap) in (roots,state.old ++ state.h1 ++ (heap_expand state.n :(α, β) heap_element list) ++ state.r1,state.a,state.n,GenState (0 :num) (MAP (K state.a :num -> num) limits),state.ok)) else (let ((roots :α heap_address list),(state :(α, β) gc_state)) = gen_gc conf (roots,heap) in (roots,state.h1 ++ (heap_expand state.n :(α, β) heap_element list) ++ state.r1,state.a,state.n,GenState (0 :num) (MAP (K state.a :num -> num) limits),state.ok))
