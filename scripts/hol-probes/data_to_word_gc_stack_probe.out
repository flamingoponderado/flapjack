gen_gc_thm_typed=abs_ml_inv (conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ⇒ ∃(roots2 :α word_loc heap_address list) (state2 :(α word_loc, tag # α word_loc list) gc_state). gen_gc (make_gc_conf limit :(tag # α word_loc list) gen_gc_conf) (roots,heap) = (roots2,state2) ∧ abs_ml_inv conf stack refs (roots2,state2.h1 ++ (heap_expand state2.n :(α word_loc, tag # α word_loc list) heap_element list) ++ state2.r1,be,state2.a,state2.n,(0 :num),reset_gens conf state2.a) limit ts ∧ state2.ok ∧ heap_length (state2.h1 ++ state2.r1) = heap_length (heap_filter (reachable_addresses roots heap) heap) ∧ EVERY (isDataElement :(α word_loc, tag # α word_loc list) heap_element -> bool) state2.h1 ∧ EVERY (isDataElement :(α word_loc, tag # α word_loc list) heap_element -> bool) state2.r1 ∧ all_reachable_from_roots roots2 (state2.h1 ++ (heap_expand state2.n :(α word_loc, tag # α word_loc list) heap_element list) ++ state2.r1)
has_gen_typed=∀(v0 :num) (xs :num list). has_gen (GenState v0 xs) ⇔ xs ≠ ([] :num list)
