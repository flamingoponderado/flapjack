gc_shared_heap_segment_typed=∀(a :num) (b :num) (heap :(α, β) heap_element list). heap_segment (a,b) heap = case heap_split a heap of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) | SOME (h1,heap') => if b < a then (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) else case heap_split (b − heap_length h1) heap' of (NONE :((α, β) heap_element list # (α, β) heap_element list) option) => (NONE :((α, β) heap_element list # (α, β) heap_element list # (α, β) heap_element list) option) | SOME (h2,h3) => SOME (h1,h2,h3)
