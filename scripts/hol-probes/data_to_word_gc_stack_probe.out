partial_to_gen_state_typed=∀(conf :γ gen_gc_partial_conf) (state :(α, β) gc_state). to_gen_state conf state = (empty_state :((α heap_address, α) data_sort, β) gc_state) with <|h1 := to_gen_heap_list conf state.h1; h2 := to_gen_heap_list conf state.h2; r4 := ([] :((α heap_address, α) data_sort, β) heap_element list); r3 := ([] :((α heap_address, α) data_sort, β) heap_element list); r2 := ([] :((α heap_address, α) data_sort, β) heap_element list); r1 := ([] :((α heap_address, α) data_sort, β) heap_element list); a := state.a − conf.gen_start; n := state.n; ok := state.ok; heap := to_gen_heap conf state.heap; heap0 := to_gen_heap conf state.heap0|>
