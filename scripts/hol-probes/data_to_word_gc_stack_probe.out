partial_all_old_ptrs_typed=∀(conf :α gen_gc_partial_conf) (xs :β heap_address list) (ptr :num). all_old_ptrs conf xs ptr ⇔ ∃(u :β). MEM (Pointer ptr u) xs ∧ (ptr < conf.gen_start ∨ conf.refs_start ≤ ptr)
partial_sim_inv_typed=∀(conf :β gen_gc_partial_conf) (heap0 :(α, β) heap_element list) (state :(α, β) gc_state). sim_inv conf heap0 state ⇔ gen_inv conf state.heap ∧ conf.gen_start ≤ state.a ∧ state.a + state.n ≤ conf.refs_start ∧ conf.gen_start + heap_length (state.h1 ++ state.h2) + state.n = conf.refs_start ∧ (conf.refs_start ≤ conf.gen_start ⇒ state.h1 = ([] :(α, β) heap_element list) ∧ state.h2 = ([] :(α, β) heap_element list)) ∧ has_old_ptr conf (state.heap ++ state.h1 ++ state.h2 ++ state.r1) ⊆ has_old_ptr conf heap0
partial_f_old_ptrs_typed=∀(conf :α gen_gc_partial_conf) (heap :(β, γ) heap_element list). f_old_ptrs conf heap = {a | isSomeDataElement (heap_lookup a heap) ∧ (a < conf.gen_start ∨ conf.refs_start ≤ a)}
