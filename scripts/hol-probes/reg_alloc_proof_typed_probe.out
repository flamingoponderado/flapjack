check_clash_tree_INJ_typed=∀(ct :clash_tree) (f :num -> num) (g :num -> num) (live :sptree$num_set) (flive :sptree$num_set) (glive :sptree$num_set). INJ g 𝕌(:num) 𝕌(:num) ∧ (domain glive :num -> bool) = IMAGE g (domain flive :num -> bool) ⇒ case check_clash_tree f ct live flive of (NONE :(sptree$num_set # sptree$num_set) option) => check_clash_tree (g ∘ f) ct live glive = (NONE :(sptree$num_set # sptree$num_set) option) | SOME (liveout,fliveout) => ∃(gliveout :sptree$num_set). check_clash_tree (g ∘ f) ct live glive = SOME (liveout,gliveout) ∧ (domain gliveout :num -> bool) = IMAGE g (domain fliveout :num -> bool)
check_col_INJ_typed=INJ (g :num -> num) 𝕌(:num) 𝕌(:num) ⇒ case check_col (f :num -> num) (s :sptree$num_set) of (NONE :(sptree$num_set # sptree$num_set) option) => check_col (g ∘ f) s = (NONE :(sptree$num_set # sptree$num_set) option) | SOME (t,ft) => ∃(gt :sptree$num_set). check_col (g ∘ f) s = SOME (t,gt) ∧ (domain gt :num -> bool) = IMAGE g (domain ft :num -> bool)
check_partial_col_domain_typed=∀(ls :num list) (f :num -> num) (live :sptree$num_set) (flive :sptree$num_set) (v :sptree$num_set # sptree$num_set). check_partial_col f ls live flive = SOME v ⇒ (domain (FST v) :num -> bool) = set ls ∪ (domain live :num -> bool)
check_partial_col_INJ_typed=∀(ls :num list) (t :sptree$num_set) (ft :sptree$num_set) (gt :sptree$num_set). INJ (g :num -> num) 𝕌(:num) 𝕌(:num) ∧ (domain gt :num -> bool) = IMAGE g (domain ft :num -> bool) ⇒ case check_partial_col (f :num -> num) ls t ft of (NONE :(sptree$num_set # sptree$num_set) option) => check_partial_col (g ∘ f) ls t gt = (NONE :(sptree$num_set # sptree$num_set) option) | SOME (tt,ftt) => ∃(gtt :sptree$num_set). check_partial_col (g ∘ f) ls t gt = SOME (tt,gtt) ∧ (domain gtt :num -> bool) = IMAGE g (domain ftt :num -> bool)
check_partial_col_success_typed=∀(ls :num list) (live :sptree$num_set) (flive :sptree$num_set) (col :num -> num). (domain flive :num -> bool) = IMAGE col (domain live :num -> bool) ∧ INJ col (set ls ∪ (domain live :num -> bool)) 𝕌(:num) ⇒ ∃(livein :sptree$num_set) (flivein :sptree$num_set). check_partial_col col ls live flive = SOME (livein,flivein) ∧ (domain flivein :num -> bool) = IMAGE col (domain livein :num -> bool)
domain_numset_list_delete_typed=∀(l :num list) (live :α sptree$num_map). (domain (numset_list_delete l live) :num -> bool) = (domain live :num -> bool) DIFF set l
in_clash_tree_def_typed=(∀(w :num list) (r :num list) (x :num). in_clash_tree (Delta w r) x ⇔ MEM x w ∨ MEM x r) ∧ (∀(names :sptree$num_set) (x :num). in_clash_tree (Set names) x ⇔ x ∈ (domain names :num -> bool)) ∧ (∀(name_opt :sptree$num_set option) (t1 :clash_tree) (t2 :clash_tree) (x :num). in_clash_tree (Branch name_opt t1 t2) x ⇔ in_clash_tree t1 x ∨ in_clash_tree t2 x ∨ case name_opt of (NONE :sptree$num_set option) => F | SOME names => x ∈ (domain names :num -> bool)) ∧ ∀(t :clash_tree) (t' :clash_tree) (x :num). in_clash_tree (Seq t t') x ⇔ in_clash_tree t x ∨ in_clash_tree t' x
INJ_IMG_lookup_typed=∀(x :num). INJ (g :num -> num) 𝕌(:num) 𝕌(:num) ∧ (domain (gt :sptree$num_set) :num -> bool) = IMAGE g (domain (ft :sptree$num_set) :num -> bool) ⇒ lookup (g x) gt = lookup x ft
adj_ls_sub_eqn_typed=adj_ls_sub (n :num) (s :ra_state) = if n < LENGTH s.adj_ls then ((M_success s.adj_ls❲n❳ :(num list, state_exn) exc),s) else ((M_failure Subscript :(num list, state_exn) exc),s)
coalesced_sub_typed=coalesced_sub (n :num) (s :ra_state) = if n < LENGTH s.coalesced then ((M_success s.coalesced❲n❳ :(num, state_exn) exc),s) else ((M_failure Subscript :(num, state_exn) exc),s)
degrees_sub_eqn_typed=degrees_sub (n :num) (s :ra_state) = if n < LENGTH s.degrees then ((M_success s.degrees❲n❳ :(num, state_exn) exc),s) else ((M_failure Subscript :(num, state_exn) exc),s)
list_case_st_typed=∀(t :α list). (list_CASE t (a :γ -> β) (b :α -> α list -> γ -> β) (f :γ) :β) = case t of ([] :α list) => a f | x::y => b x y f
move_related_sub_typed=move_related_sub (n :num) (s :ra_state) = if n < LENGTH s.move_related then ((M_success s.move_related❲n❳ :(bool, state_exn) exc),s) else ((M_failure Subscript :(bool, state_exn) exc),s)
Msub_eqn_typed=∀(e :α) (n :num) (ls :β list) (v :γ). Msub e n ls = if n < LENGTH ls then (M_success ls❲n❳ :(β, α) exc) else (M_failure e :(β, α) exc)
Mupdate_eqn_typed=∀(e :α) (x :β) (n :num) (ls :β list). Mupdate e x n ls = if n < LENGTH ls then (M_success ls❲n ↦ x❳ :(β list, α) exc) else (M_failure e :(β list, α) exc)
node_tag_sub_eqn_typed=node_tag_sub (n :num) (s :ra_state) = if n < LENGTH s.node_tag then ((M_success s.node_tag❲n❳ :(tag, state_exn) exc),s) else ((M_failure Subscript :(tag, state_exn) exc),s)
st_ex_MAP_adj_ls_sub_typed=∀(ls :num list) (s :ra_state). EVERY (λ(v :num). v < LENGTH s.adj_ls) ls ⇒ st_ex_MAP adj_ls_sub ls s = ((M_success (MAP (λ(i :num). s.adj_ls❲i❳) ls) :(num list list, state_exn) exc),s)
st_ex_MAP_degrees_sub_typed=∀(ls :num list) (s :ra_state). EVERY (λ(v :num). v < LENGTH s.degrees) ls ⇒ st_ex_MAP degrees_sub ls s = ((M_success (MAP (λ(i :num). s.degrees❲i❳) ls) :(num list, state_exn) exc),s)
st_ex_MAP_node_tag_sub_typed=∀(ls :num list) (s :ra_state). EVERY (λ(v :num). v < LENGTH s.node_tag) ls ⇒ st_ex_MAP node_tag_sub ls s = ((M_success (MAP (λ(i :num). s.node_tag❲i❳) ls) :(tag list, state_exn) exc),s)
tag_case_st_typed=∀(t :tag). (tag_CASE t (a :num -> β -> α) (b :β -> α) (c :β -> α) (f :β) :α) = case t of Fixed n => a n f | Atemp => b f | Stemp => c f
update_adj_ls_eqn_typed=update_adj_ls (n :num) (t :num list) (s :ra_state) = if n < LENGTH s.adj_ls then ((M_success () :(unit, state_exn) exc),s with adj_ls := s.adj_ls❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_coalesced_eqn_typed=update_coalesced (n :num) (t :num) (s :ra_state) = if n < LENGTH s.coalesced then ((M_success () :(unit, state_exn) exc),s with coalesced := s.coalesced❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_degrees_eqn_typed=update_degrees (n :num) (t :num) (s :ra_state) = if n < LENGTH s.degrees then ((M_success () :(unit, state_exn) exc),s with degrees := s.degrees❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_move_related_eqn_typed=update_move_related (n :num) (t :bool) (s :ra_state) = if n < LENGTH s.move_related then ((M_success () :(unit, state_exn) exc),s with move_related := s.move_related❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_node_tag_eqn_typed=update_node_tag (n :num) (t :tag) (s :ra_state) = if n < LENGTH s.node_tag then ((M_success () :(unit, state_exn) exc),s with node_tag := s.node_tag❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
assign_Atemp_tag_correct_typed=good_ra_state (s :ra_state) ∧ no_clash s.adj_ls s.node_tag ∧ good_pref (pref :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) ∧ (n :num) < s.dim ⇒ ∃(s' :ra_state). assign_Atemp_tag (ks :num list) pref n s = ((M_success () :(unit, state_exn) exc),s') ∧ (∀(m :num). if n = m ∧ s.node_tag❲n❳ = Atemp then s'.node_tag❲n❳ ≠ Atemp else s'.node_tag❲m❳ = s.node_tag❲m❳) ∧ no_clash s'.adj_ls s'.node_tag ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag
assign_Atemps_correct_typed=∀(k :num) (ls :num list) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) (s :ra_state). good_ra_state s ∧ good_pref prefs ∧ no_clash s.adj_ls s.node_tag ⇒ ∃(s' :ra_state). assign_Atemps k ls prefs s = ((M_success () :(unit, state_exn) exc),s') ∧ no_clash s'.adj_ls s'.node_tag ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag ∧ EVERY (λ(n :tag). n ≠ Atemp) s'.node_tag ∧ ∀(m :num). m < LENGTH s.node_tag ∧ s.node_tag❲m❳ ≠ Atemp ⇒ s'.node_tag❲m❳ = s.node_tag❲m❳
coalesce_root_success_typed=∀(n :num) (s :ra_state). good_ra_state s ∧ n < s.dim ⇒ ∃(v :num). coalesce_root n s = ((M_success v :(num, state_exn) exc),s)
good_pref_biased_pref_typed=∀(t :num list sptree$num_map). good_pref (biased_pref t)
remove_colours_frame_typed=∀(adjs :num list) (ks :num list) (s :ra_state) (res :(num list, state_exn) exc) (s' :ra_state). remove_colours adjs ks s = (res,s') ⇒ s = s'
remove_colours_success_typed=∀(adjs :num list) (ks :num list) (s :ra_state) (ls :num list) (s' :ra_state). remove_colours adjs ks s = ((M_success ls :(num list, state_exn) exc),s') ⇒ Abbrev (set ls ⊆ set ks ∧ ∀(n :num). MEM n adjs ∧ n < LENGTH s'.node_tag ⇒ case s.node_tag❲n❳ of Fixed c => ¬MEM c ls | Atemp => T | Stemp => T)
check_clash_tree_domain_typed=∀(ct :clash_tree) (f :num -> num) (live :sptree$num_set) (flive :sptree$num_set) (live' :sptree$num_set) (flive' :sptree$num_set). check_clash_tree f ct live flive = SOME (live',flive') ⇒ (domain live' :num -> bool) ⊆ (domain live :num -> bool) ∪ {x | in_clash_tree ct x}
check_clash_tree_same_dom_typed=∀(ct :clash_tree) (f :num -> num) (g :num -> num) (live :sptree$num_set) (flive :sptree$num_set). (∀(x :num). in_clash_tree ct x ∨ x ∈ (domain live :num -> bool) ⇒ f x = g x) ⇒ check_clash_tree f ct live flive = check_clash_tree g ct live flive
check_partial_col_same_dom_typed=∀(ls :num list) (f :num -> num) (g :num -> num) (t :sptree$num_set) (ft :sptree$num_set). (∀(x :num). MEM x ls ⇒ f x = g x) ⇒ check_partial_col f ls t ft = check_partial_col g ls t ft
INJ_COMPOSE_IMAGE_typed=∀(a :α -> bool) (b :β -> bool) (u :γ -> bool). INJ (f :α -> β) a b ∧ INJ (g :β -> γ) (IMAGE f a) u ⇒ INJ (g ∘ f) a u
TWOxDIV2_typed=(2 :num) * (x :num) DIV (2 :num) = x
clique_insert_edge_succeeds_typed=∀(ls :num list) (s :ra_state). good_ra_state s ∧ EVERY (λ(y :num). y < s.dim) ls ⇒ ∃(s' :ra_state). clique_insert_edge ls s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with adj_ls := s'.adj_ls ∧ is_clique ls s'.adj_ls ∧ is_subgraph s.adj_ls s'.adj_ls
extend_clique_succeeds_typed=∀(ls :num list) (cli :num list) (s :ra_state). good_ra_state s ∧ is_clique cli s.adj_ls ∧ EVERY (λ(y :num). y < s.dim) ls ∧ ALL_DISTINCT cli ∧ EVERY (λ(y :num). y < s.dim) cli ⇒ ∃(cli' :num list) (s' :ra_state). extend_clique ls cli s = ((M_success cli' :(num list, state_exn) exc),s') ∧ good_ra_state s' ∧ ALL_DISTINCT cli' ∧ s' = s with adj_ls := s'.adj_ls ∧ set cli' = set (cli ++ ls) ∧ is_clique cli' s'.adj_ls ∧ is_subgraph s.adj_ls s'.adj_ls
extend_graph_succeeds_typed=∀(forced :(num # num) list) (f :num -> num) (s :ra_state). good_ra_state s ∧ EVERY (λ((x :num),(y :num)). f x < s.dim ∧ f y < s.dim) forced ⇒ ∃(s' :ra_state). extend_graph f forced s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with adj_ls := s'.adj_ls ∧ ∀(a :num) (b :num). has_edge s'.adj_ls a b ⇔ (∃(x :num) (y :num). f x = a ∧ f y = b ∧ MEM (y,x) forced) ∨ (∃(x :num) (y :num). f x = a ∧ f y = b ∧ MEM (x,y) forced) ∨ has_edge s.adj_ls a b
mk_graph_succeeds_typed=∀(ct :clash_tree) (ta :num -> num) (liveout :num list) (s :ra_state). good_ra_state s ∧ (∀(x :num). in_clash_tree ct x ⇒ ta x < s.dim) ∧ INJ ta {x | in_clash_tree ct x} (count (LENGTH s.adj_ls)) ∧ is_clique liveout s.adj_ls ∧ ALL_DISTINCT liveout ∧ EVERY (λ(y :num). y < s.dim) liveout ⇒ ∃(livein :num list) (s' :ra_state). mk_graph ta ct liveout s = ((M_success livein :(num list, state_exn) exc),s') ∧ good_ra_state s' ∧ is_clique livein s'.adj_ls ∧ s' = s with adj_ls := s'.adj_ls ∧ EVERY (λ(y :num). y < s.dim) livein ∧ ALL_DISTINCT livein ∧ set livein ⊆ set liveout ∪ IMAGE ta {x | in_clash_tree ct x} ∧ is_subgraph s.adj_ls s'.adj_ls
mk_tags_succeeds_typed=good_ra_state (s :ra_state) ∧ (n :num) = s.dim ⇒ ∃(s' :ra_state). mk_tags n (fs :sptree$num_set) (fa :num -> num) s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag ∧ ∀(x :num) (y :num). x < n ∧ y = fa x ⇒ if is_phy_var y then s'.node_tag❲x❳ = Fixed (y DIV (2 :num)) else if is_stack_var y then s'.node_tag❲x❳ = Stemp else s'.node_tag❲x❳ = Atemp ∨ s'.node_tag❲x❳ = Stemp
extract_color_succeeds_typed=good_ra_state (s :ra_state) ∧ (∀(x :num) (y :num). lookup x (ta :num sptree$num_map) = SOME y ⇒ y < s.dim) ∧ wf ta ⇒ extract_color ta s = ((M_success (map (λ(v :num). extract_tag s.node_tag❲v❳) ta) :(num sptree$num_map, state_exn) exc),s)
colouring_satisfactory_cliques_typed=∀(ls :num list) (g :num list list) (f :num -> num). ALL_DISTINCT ls ∧ EVERY (λ(x :num). x < LENGTH g) ls ∧ colouring_satisfactory f g ∧ is_clique ls g ⇒ ALL_DISTINCT (MAP f ls)
colouring_satisfactory_subgraph_typed=colouring_satisfactory (f :num -> α) (h :num list list) ∧ is_subgraph (g :num list list) h ⇒ colouring_satisfactory f g
no_clash_colouring_satisfactory_typed=no_clash (adjls :num list list) (node_tag :tag list) ∧ LENGTH adjls = LENGTH node_tag ∧ EVERY (λ(n :tag). n ≠ Stemp ∧ n ≠ Atemp) node_tag ⇒ colouring_satisfactory (λ(f :num). if f < LENGTH node_tag then extract_tag node_tag❲f❳ else (0 :num)) adjls
do_reg_alloc_correct_typed=∀(alg :algorithm) (scost :num sptree$num_map option) (k :num) (moves :(num # num # num) list) (ct :clash_tree) (forced :(num # num) list) (fs :sptree$num_set) (st :ra_state) (ta :num sptree$num_map) (fa :num sptree$num_map) (n :num). mk_bij ct = (ta,fa,n) ⇒ st.adj_ls = REPLICATE n ([] :num list) ⇒ st.node_tag = REPLICATE n Atemp ⇒ st.degrees = REPLICATE n (0 :num) ⇒ st.dim = n ⇒ st.simp_wl = ([] :num list) ⇒ st.spill_wl = ([] :num list) ⇒ st.freeze_wl = ([] :num list) ⇒ st.avail_moves_wl = ([] :(num # num # num) list) ⇒ st.unavail_moves_wl = ([] :(num # num # num) list) ⇒ st.coalesced = REPLICATE n (0 :num) ⇒ st.move_related = REPLICATE n F ⇒ EVERY (λ((x :num),(y :num)). in_clash_tree ct x ∧ in_clash_tree ct y) forced ⇒ ∃(spcol :num sptree$num_map) (st' :ra_state) (livein :sptree$num_set) (flivein :sptree$num_set). do_reg_alloc alg scost k moves ct forced fs (ta,fa,n) st = ((M_success spcol :(num sptree$num_map, state_exn) exc),st') ∧ check_clash_tree (sp_default spcol) ct (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein,flivein) ∧ (∀(x :num). in_clash_tree ct x ⇒ x ∈ (domain spcol :num -> bool) ∧ if is_phy_var x then sp_default spcol x = x DIV (2 :num) else if is_stack_var x then k ≤ sp_default spcol x else T) ∧ (∀(x :num). x ∈ (domain spcol :num -> bool) ⇒ in_clash_tree ct x) ∧ EVERY (λ((x :num),(y :num)). sp_default spcol x = sp_default spcol y ⇒ x = y) forced
reg_alloc_correct_typed=∀(alg :algorithm) (scost :num sptree$num_map option) (k :num) (moves :(num # num # num) list) (ct :clash_tree) (forced :(num # num) list) (fs :sptree$num_set). EVERY (λ((x :num),(y :num)). in_clash_tree ct x ∧ in_clash_tree ct y) forced ⇒ ∃(spcol :num sptree$num_map) (livein :sptree$num_set) (flivein :sptree$num_set). reg_alloc alg scost k moves ct forced fs = (M_success spcol :(num sptree$num_map, state_exn) exc) ∧ check_clash_tree (sp_default spcol) ct (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein,flivein) ∧ (∀(x :num). in_clash_tree ct x ⇒ x ∈ (domain spcol :num -> bool) ∧ if is_phy_var x then sp_default spcol x = x DIV (2 :num) else if is_stack_var x then k ≤ sp_default spcol x else T) ∧ (∀(x :num). x ∈ (domain spcol :num -> bool) ⇒ in_clash_tree ct x) ∧ EVERY (λ((x :num),(y :num)). sp_default spcol x = sp_default spcol y ⇒ x = y) forced
insert_edge_succeeds_typed=good_ra_state (s :ra_state) ∧ (y :num) < s.dim ∧ (x :num) < s.dim ⇒ ∃(s' :ra_state). insert_edge x y s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with adj_ls := s'.adj_ls ∧ ∀(a :num) (b :num). has_edge s'.adj_ls a b ⇔ a = x ∧ b = y ∨ a = y ∧ b = x ∨ has_edge s.adj_ls a b
list_insert_edge_succeeds_typed=∀(ys :num list) (x :num) (s :ra_state). good_ra_state s ∧ x < s.dim ∧ EVERY (λ(y :num). y < s.dim) ys ⇒ ∃(s' :ra_state). list_insert_edge x ys s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with adj_ls := s'.adj_ls ∧ ∀(a :num) (b :num). has_edge s'.adj_ls a b ⇔ a = x ∧ MEM b ys ∨ b = x ∧ MEM a ys ∨ has_edge s.adj_ls a b
sorted_insert_correct_typed=∀(ls :num list). SORTED $> ls ⇒ SORTED $> (sorted_insert (x :num) ([] :num list) ls) ∧ ∀(z :num). MEM z (sorted_insert x ([] :num list) ls) ⇔ x = z ∨ MEM z ls
sorted_mem_correct_typed=∀(ls :num list). SORTED $> ls ⇒ (sorted_mem (x :num) ls ⇔ MEM x ls)
colouring_satisfactory_def_typed=∀(col :num -> α) (adjls :num list list). colouring_satisfactory col adjls ⇔ ∀(x :num). x < LENGTH adjls ⇒ ∀(y :num). y < LENGTH adjls ∧ MEM y adjls❲x❳ ⇒ col x = col y ⇒ x = y
good_neg_pref_def_typed=∀(k :num) (pref :α -> num list -> ra_state -> (num option, β) exc # ra_state). good_neg_pref k pref ⇔ ∀(n :α) (bads :num list) (s :ra_state). good_ra_state s ⇒ ∃(res :num option). pref n bads s = ((M_success res :(num option, β) exc),s) ∧ case res of (NONE :num option) => T | SOME c => ¬MEM c bads ∧ k ≤ c
good_pref_def_typed=∀(pref :α -> β list -> ra_state -> (β option, γ) exc # ra_state). good_pref pref ⇔ ∀(n :α) (ks :β list) (s :ra_state). good_ra_state s ⇒ ∃(res :β option). pref n ks s = ((M_success res :(β option, γ) exc),s) ∧ case res of (NONE :β option) => T | SOME k => MEM k ks
good_ra_state_def_typed=∀(s :ra_state). good_ra_state s ⇔ LENGTH s.adj_ls = s.dim ∧ LENGTH s.node_tag = s.dim ∧ LENGTH s.degrees = s.dim ∧ LENGTH s.coalesced = s.dim ∧ LENGTH s.move_related = s.dim ∧ EVERY (λ(v :num). v < s.dim) s.coalesced ∧ EVERY (λ(ls :num list). EVERY (λ(v :num). v < s.dim) ls) s.adj_ls ∧ EVERY (λ(ls :num list). SORTED $> ls) s.adj_ls ∧ EVERY (λ(v :num). v < s.dim) s.simp_wl ∧ EVERY (λ(v :num). v < s.dim) s.spill_wl ∧ EVERY (λ(v :num). v < s.dim) s.freeze_wl ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) s.avail_moves_wl ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) s.unavail_moves_wl ∧ undirected s.adj_ls
has_edge_def_typed=∀(adjls :num list list) (x :num) (y :num). has_edge adjls x y ⇔ x < LENGTH adjls ∧ y < LENGTH adjls ∧ MEM y adjls❲x❳
hide_def_typed=∀(x :α). hide x = x
is_clique_def_typed=∀(ls :num list) (adjls :num list list). is_clique ls adjls ⇔ ∀(x :num) (y :num). MEM x ls ∧ MEM y ls ∧ x ≠ y ⇒ has_edge adjls x y
is_subgraph_def_typed=∀(g :num list list) (h :num list list). is_subgraph g h ⇔ ∀(x :num) (y :num). has_edge g x y ⇒ has_edge h x y
is_subgraph_refl_typed=is_subgraph (s :num list list) s
is_subgraph_trans_typed=is_subgraph (s :num list list) (s' :num list list) ∧ is_subgraph s' (s'' :num list list) ⇒ is_subgraph s s''
no_clash_def_typed=∀(adj_ls :num list list) (node_tag :tag list). no_clash adj_ls node_tag ⇔ ∀(x :num) (y :num). has_edge adj_ls x y ⇒ case (node_tag❲x❳,node_tag❲y❳) of (Fixed n,Fixed m) => n = m ⇒ x = y | (Fixed n,Atemp) => T | (Fixed n,Stemp) => T | (Atemp,v3) => T | (Stemp,v3) => T
undirected_def_typed=∀(adjls :num list list). undirected adjls ⇔ ∀(x :num) (y :num). has_edge adjls x y ⇒ has_edge adjls y x
mk_bij_aux_wf_typed=∀(ct :clash_tree) (ta :num sptree$num_map) (fa :num sptree$num_map) (n :num) (ta' :num sptree$num_map) (fa' :num sptree$num_map) (n' :num). mk_bij_aux ct (ta,fa,n) = (ta',fa',n') ∧ wf ta ∧ wf fa ⇒ Abbrev (wf ta' ∧ wf fa')
mk_graph_check_clash_tree_typed=∀(ct :clash_tree) (ta :num -> num) (livelist :num list) (s :ra_state) (livelist' :num list) (s' :ra_state) (col :num -> num) (live :sptree$num_set) (flive :sptree$num_set). mk_graph ta ct livelist s = ((M_success livelist' :(num list, state_exn) exc),s') ∧ colouring_satisfactory col s'.adj_ls ∧ INJ ta ({x | in_clash_tree ct x} ∪ (domain live :num -> bool)) (count (LENGTH s.adj_ls)) ∧ IMAGE ta (domain live :num -> bool) = set livelist ∧ ALL_DISTINCT livelist ∧ EVERY (λ(y :num). y < s.dim) livelist ∧ is_clique livelist s.adj_ls ∧ good_ra_state s ∧ (domain flive :num -> bool) = IMAGE (col ∘ ta) (domain live :num -> bool) ⇒ ∃(livein :sptree$num_set) (flivein :sptree$num_set). check_clash_tree (col ∘ ta) ct live flive = SOME (livein,flivein) ∧ IMAGE ta (domain livein :num -> bool) = set livelist' ∧ (domain flivein :num -> bool) = IMAGE (col ∘ ta) (domain livein :num -> bool)
sp_inverts_def_typed=∀(f :num sptree$num_map) (g :num sptree$num_map). sp_inverts f g ⇔ ∀(m :num) (fm :num). lookup m f = SOME fm ⇒ lookup fm g = SOME m
sp_inverts_insert_typed=sp_inverts (f :num sptree$num_map) (g :num sptree$num_map) ∧ (x :num) ∉ (domain f :num -> bool) ∧ (y :num) ∉ (domain g :num -> bool) ⇒ sp_inverts (insert x y f) (insert y x g)
assign_Stemp_tag_correct_typed=good_ra_state (s :ra_state) ∧ no_clash s.adj_ls s.node_tag ∧ (n :num) < s.dim ∧ good_neg_pref (k :num) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) ⇒ ∃(s' :ra_state). assign_Stemp_tag k prefs n s = ((M_success () :(unit, state_exn) exc),s') ∧ (∀(m :num). if n = m ∧ s.node_tag❲n❳ = Stemp then ∃(k' :num). s'.node_tag❲n❳ = Fixed k' ∧ k ≤ k' else s'.node_tag❲m❳ = s.node_tag❲m❳) ∧ no_clash s'.adj_ls s'.node_tag ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag
assign_Stemps_correct_typed=good_ra_state (s :ra_state) ∧ no_clash s.adj_ls s.node_tag ∧ good_neg_pref (k :num) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) ⇒ ∃(s' :ra_state). assign_Stemps k prefs s = ((M_success () :(unit, state_exn) exc),s') ∧ no_clash s'.adj_ls s'.node_tag ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag ∧ ∀(m :num). m < LENGTH s.node_tag ⇒ if s.node_tag❲m❳ = Stemp then ∃(k' :num). s'.node_tag❲m❳ = Fixed k' ∧ k ≤ k' else s'.node_tag❲m❳ = s.node_tag❲m❳
good_neg_pref_neg_biased_pref_typed=good_neg_pref (k :num) (neg_biased_pref k (t :num list sptree$num_map))
unbound_colour_correct_typed=∀(ls :num list) (k :num) (k' :α). SORTED (λ(x :num) (y :num). x ≤ y) ls ⇒ k ≤ unbound_colour k ls ∧ ¬MEM (unbound_colour k ls) ls
