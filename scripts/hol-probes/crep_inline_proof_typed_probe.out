OPT_MMAP_ALL_EQ_typed=∀(f :α -> β option) (g :α -> β option) (l :α list). (∀(x :α). MEM x l ⇒ f x = g x) ⇒ OPT_MMAP f l = OPT_MMAP g l
OPT_MMAP_SOME_ALL_typed=∀(f :α -> β option) (l :α list). (∃(x :β list). OPT_MMAP f l = SOME x) ⇔ ∀(x :α). MEM x l ⇒ ∃(y :β). f x = SOME y
cont_res_def_typed=(cont_res (NONE :α result option) ⇔ T) ∧ (cont_res (SOME (Break (n :num) :α result)) ⇔ T) ∧ (cont_res (SOME (Continue n :α result)) ⇔ T) ∧ (cont_res (SOME (Error :α result)) ⇔ T) ∧ (cont_res (SOME (TimeOut :α result)) ⇔ F) ∧ (cont_res (SOME (Return (v4 :α word_lab list) :α result)) ⇔ F) ∧ (cont_res (SOME (Exception (v5 :α word) :α result)) ⇔ F) ∧ (cont_res (SOME (FinalFFI (v6 :final_event) :α result)) ⇔ F)
code_inl_rel_def_typed=∀(inl_fs :mlstring |-> num list # α crepLang$prog) (s :(α, β) state) (t :(α, γ) state). code_inl_rel inl_fs s t ⇔ ∀(fname :mlstring) (args :num list) (prog :α crepLang$prog). FLOOKUP s.code fname = SOME (args,prog) ⇒ ∃(inl_bag :mlstring |-> num list # α crepLang$prog). inl_bag ⊑ inl_fs ∧ FLOOKUP t.code fname = SOME (args,inline_prog inl_bag prog)
locals_ext_rel_def_typed=∀(a :(α, β) state) (b :(γ, δ) state) (a' :(ε, ζ) state) (b' :(ε, η) state). locals_ext_rel a b a' b' ⇔ FDIFF a'.locals (FDOM a.locals) = FDIFF b'.locals (FDOM b.locals)
locals_rel_def_typed=∀(s :(α, β) state) (t :(α, γ) state). locals_rel s t ⇔ s.locals ⊑ t.locals
locals_rel_dec_clock_typed=∀(s :(α, β) state) (t :(α, β) state). locals_rel s t ∧ state_rel s t ⇒ locals_rel (dec_clock s) (dec_clock t) ∧ state_rel (dec_clock s) (dec_clock t)
locals_strong_rel_def_typed=∀(s :(α, β) state) (t :(α, γ) state). locals_strong_rel s t ⇔ s.locals = t.locals
state_rel_code_def_typed=∀(s :(α, β) state) (t :(α, β) state). state_rel_code s t ⇔ s.globals = t.globals ∧ s.memory = t.memory ∧ s.memaddrs = t.memaddrs ∧ s.sh_memaddrs = t.sh_memaddrs ∧ s.clock = t.clock ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr
state_rel_def_typed=∀(s :(α, β) state) (t :(α, β) state). state_rel s t ⇔ s.globals = t.globals ∧ s.code = t.code ∧ s.memory = t.memory ∧ s.memaddrs = t.memaddrs ∧ s.sh_memaddrs = t.sh_memaddrs ∧ s.clock = t.clock ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr
eval_code_inl_typed=∀(s :(α, β) state) (e :α crepLang$exp) (val :α word_lab) (s1 :(α, β) state) (inl_fs :mlstring |-> num list # α crepLang$prog). (eval s e :α word_lab option) = SOME val ∧ state_rel_code s s1 ∧ locals_strong_rel s s1 ∧ code_inl_rel inl_fs s s1 ⇒ (eval s1 e :α word_lab option) = SOME val
evaluate_locals_same_fdom_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ ((case r of (NONE :α result option) => T | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break n' :α result) => T | SOME (Continue n :α result) => T | SOME (Return v9 :α result) => F | SOME (Exception v10 :α result) => F | SOME (FinalFFI v11 :α result) => F) ⇔ T) ⇒ FDOM s.locals = FDOM s'.locals
flookup_res_var_is_mem_zip_eq_typed=∀(xs :α list) (x :α) (lc1 :α |-> β) (lc2 :α |-> β). MEM x xs ⇒ FLOOKUP (FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) lc1 (ZIP (xs,MAP (FLOOKUP lc2) xs))) x = FLOOKUP lc2 x
genlist_all_distinct_typed=∀(n :num) (a :num). ALL_DISTINCT (GENLIST (λ(x :num). a + SUC x) n)
genlist_less_than_typed=∀(n :num) (a :num) (v :num). MEM v (GENLIST (λ(x :num). a + SUC x) n) ⇒ a < v
genlist_not_in_typed=∀(n :num) (a :num) (v :num). v ≤ a ⇒ ¬MEM v (GENLIST (λ(x :num). a + SUC x) n)
inline_prog_correct_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (inl_fs :mlstring |-> num list # α crepLang$prog) (s1 :(α, β) state) (inl_bag :mlstring |-> num list # α crepLang$prog). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ r ≠ SOME (Error :α result) ∧ inl_fs ⊑ s.code ∧ inl_bag ⊑ inl_fs ∧ state_rel_code s s1 ∧ locals_strong_rel s s1 ∧ code_inl_rel inl_fs s s1 ⇒ ∃(s1' :(α, β) state). (evaluate (inline_prog inl_bag p,s1) :α result option # (α, β) state) = (r,s1') ∧ state_rel_code s' s1' ∧ code_inl_rel inl_fs s' s1' ∧ case r of (NONE :α result option) => locals_strong_rel s' s1' | SOME (Error :α result) => F | SOME (TimeOut :α result) => T | SOME (Break n :α result) => locals_strong_rel s' s1' | SOME (Continue n' :α result) => locals_strong_rel s' s1' | SOME (Return v9 :α result) => T | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
max_list_genlist_add_suc_val_typed=(n :num) ≠ (0 :num) ⇒ MAX_LIST (GENLIST (λ(x :num). SUC x + (k :num)) n) = n + k
MORE_THEN_NOT_MAX_LIST_typed=∀(l :num list) (x :num). MAX_LIST l < x ⇒ ¬MEM x l
not_some_is_none_typed=∀(a :α option). (∀(v :α). a ≠ SOME v) ⇔ a = (NONE :α option)
opt_mmap_eval_code_inl_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (s1 :(α, β) state) (inl_fs :mlstring |-> num list # α crepLang$prog). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ state_rel_code s s1 ∧ locals_strong_rel s s1 ∧ code_inl_rel inl_fs s s1 ⇒ OPT_MMAP (eval s1 :α crepLang$exp -> α word_lab option) es = SOME vals
MEM_MAP2_IMP_typed=∀(f :α -> β -> γ) (l1 :α list) (l2 :β list) (x :γ). MEM x (MAP2 f l1 l2 :γ list) ⇒ ∃(y1 :α) (y2 :β). x = f y1 y2 ∧ MEM y1 l1 ∧ MEM y2 l2
res_var_commutes_strong_typed=res_var (res_var (lc :α |-> β) ((h :α),FLOOKUP (lc' :α |-> β) h)) ((n :α),FLOOKUP lc' n) = res_var (res_var lc (n,FLOOKUP lc' n)) (h,FLOOKUP lc' h)
res_var_foldl_commutes_strong_typed=∀(h :α) (vs :α list) (lc1 :α |-> β) (lc2 :α |-> β). res_var (FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) lc1 (ZIP (vs,MAP (FLOOKUP lc2) vs))) (h,FLOOKUP lc2 h) = FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) (res_var lc1 (h,FLOOKUP lc2 h)) (ZIP (vs,MAP (FLOOKUP lc2) vs))
SUBMAP_IMP_DOMSUB_FUPDATE_typed=∀(f :α |-> β) (g :α |-> β) (x :α) (y :β). f ⊑ g ⇒ f \\ x ⊑ g⟨x ↦ y⟩
SUBMAP_IMP_DOMSUB_SUBMAP_typed=∀(f :α |-> β) (g :α |-> β) (x :α). f ⊑ g ⇒ f \\ x ⊑ g \\ x
SUBMAP_IMP_FUPDATE_SUBMAP_typed=∀(f :α |-> β) (g :α |-> β) (x :α) (y :β). f ⊑ g ⇒ f⟨x ↦ y⟩ ⊑ g⟨x ↦ y⟩
general_simulate_arg_load_correct_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ r ≠ SOME (Error :α result) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs tmp_vars es (nested_decs vs (MAP (Var :num -> α crepLang$exp) tmp_vars) p),s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t'
general_simulate_arg_load_preserve_locals_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ ((case r of (NONE :α result option) => T | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break n :α result) => T | SOME (Continue n' :α result) => T | SOME (Return v9 :α result) => F | SOME (Exception v10 :α result) => F | SOME (FinalFFI v11 :α result) => F) ⇔ T) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs tmp_vars es (nested_decs vs (MAP (Var :num -> α crepLang$exp) tmp_vars) p),s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals
arg_load_correct_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ r ≠ SOME (Error :α result) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ⇒ ∃(t' :(α, β) state). (evaluate (arg_load tmp_vars es vs p,s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ case r of (NONE :α result option) => FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Error :α result) => F | SOME (TimeOut :α result) => T | SOME (Break n :α result) => FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Continue n' :α result) => FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Return v9 :α result) => T | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
general_simulate_arg_load_strong_1_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ ((case r of (NONE :α result option) => T | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break n :α result) => T | SOME (Continue n' :α result) => T | SOME (Return v9 :α result) => F | SOME (Exception v10 :α result) => F | SOME (FinalFFI v11 :α result) => F) ⇔ T) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs tmp_vars es (nested_decs vs (MAP (Var :num -> α crepLang$exp) tmp_vars) p),s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals
general_simulate_arg_load_strong_all_drule_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list) (r1 :α result option) (t' :(α, β) state). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ r ≠ SOME (Error :α result) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ∧ (evaluate (nested_decs tmp_vars es (nested_decs vs (MAP (Var :num -> α crepLang$exp) tmp_vars) p),s) :α result option # (α, β) state) = (r1,t') ⇒ r1 = r ∧ state_rel s' t' ∧ case r of (NONE :α result option) => FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Error :α result) => F | SOME (TimeOut :α result) => T | SOME (Break n :α result) => FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Continue n' :α result) => FDIFF s.locals (FDOM t) ⊑ t'.locals ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Return v9 :α result) => T | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
