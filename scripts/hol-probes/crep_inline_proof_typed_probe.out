general_simulate_arg_load_strong_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ ((case r of (NONE :α result option) => T | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break n :α result) => T | SOME (Continue n' :α result) => T | SOME (Return v9 :α result) => F | SOME (Exception v10 :α result) => F | SOME (FinalFFI v11 :α result) => F) ⇔ T) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs tmp_vars es (nested_decs vs (MAP (Var :num -> α crepLang$exp) tmp_vars) p),s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ FDIFF s.locals (FDOM t) ⊑ t'.locals
arg_load_stronger_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vals :α word_lab list) (vs :num list) (t :num |-> α word_lab) (p :α crepLang$prog) (r :α result option) (s' :(α, β) state) (tmp_vars :num list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ t ⊑ s.locals ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (∀(v :num). MEM v vs ∨ MEM v tmp_vars ⇒ v ∉ FDOM t) ∧ r ≠ SOME (Error :α result) ∧ ALL_DISTINCT tmp_vars ∧ LENGTH tmp_vars = LENGTH vs ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x vs) ∧ (∀(x :num). MEM x tmp_vars ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ⇒ ∃(t' :(α, β) state). (evaluate (arg_load tmp_vars es vs p,s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ case r of (NONE :α result option) => FDIFF s.locals (FDOM t) = FDIFF t'.locals (FDOM t) ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Error :α result) => F | SOME (TimeOut :α result) => T | SOME (Break n :α result) => FDIFF s.locals (FDOM t) = FDIFF t'.locals (FDOM t) ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Continue n' :α result) => FDIFF s.locals (FDOM t) = FDIFF t'.locals (FDOM t) ∧ FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs)) ⊑ t'.locals | SOME (Return v9 :α result) => T | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
eval_dec_clock_eq_typed=∀(s :(α, β) state) (e :α crepLang$exp). (eval (dec_clock s) e :α word_lab option) = (eval s e :α word_lab option)
opt_mmap_eval_dec_clock_eq_typed=∀(s :(α, β) state) (es :α crepLang$exp list). OPT_MMAP (eval (dec_clock s) :α crepLang$exp -> α word_lab option) es = OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es
evaluate_state_locals_rel_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (t :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ⇒ r ≠ SOME (Error :α result) ⇒ locals_rel s t ∧ state_rel s t ⇒ ∃(t' :(α, β) state). (evaluate (p,t) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ case r of (NONE :α result option) => locals_rel s' t' | SOME (Error :α result) => F | SOME (TimeOut :α result) => T | SOME (Break n :α result) => locals_rel s' t' | SOME (Continue n' :α result) => locals_rel s' t' | SOME (Return v9 :α result) => T | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
evaluate_state_locals_rel_strong_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (t :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ r ≠ SOME (Error :α result) ∧ locals_rel s t ∧ state_rel s t ⇒ ∃(t' :(α, β) state). (evaluate (p,t) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ case r of (NONE :α result option) => locals_rel s' t' ∧ locals_ext_rel s s' t t' | SOME (Error :α result) => F | SOME (TimeOut :α result) => T | SOME (Break n :α result) => locals_rel s' t' ∧ locals_ext_rel s s' t t' | SOME (Continue n' :α result) => locals_rel s' t' ∧ locals_ext_rel s s' t t' | SOME (Return v9 :α result) => T | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
eval_state_locals_same_code_fdom_same_typed=∀(s :(α, β) state) (e :α crepLang$exp) (val :α word_lab) (s1 :(α, β) state). (eval s e :α word_lab option) = SOME val ∧ state_rel_code s s1 ∧ locals_strong_rel s s1 ∧ FDOM s.code ⊆ FDOM s1.code ⇒ (eval s1 e :α word_lab option) = SOME val
eval_optmmap_state_locals_rel_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (ws :α word_lab list) (t :(α, β) state). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME ws ∧ state_rel s t ∧ locals_rel s t ⇒ OPT_MMAP (eval t :α crepLang$exp -> α word_lab option) es = SOME ws
eval_original_extend_locals_rel_typed=∀(s :(α, β) state) (e :α crepLang$exp) (wl :α word_lab) (t :(α, β) state). (eval s e :α word_lab option) = SOME wl ⇒ locals_rel s t ∧ state_rel s t ⇒ (eval t e :α word_lab option) = SOME wl
eval_state_locals_rel_typed=∀(s :(α, β) state) (e :α crepLang$exp) (wl :α word_lab) (t :(α, β) state). (eval s e :α word_lab option) = SOME wl ∧ state_rel s t ∧ locals_rel s t ⇒ (eval t e :α word_lab option) = SOME wl
eval_original_extend_locals_typed=∀(s :(α, β) state) (e :α crepLang$exp) (wl :α word_lab) (l :num |-> α word_lab). (eval s e :α word_lab option) = SOME wl ∧ s.locals ⊑ l ⇒ (eval (s with locals := l) e :α word_lab option) = SOME wl
opt_mmap_flookup_some_then_same_fdom_typed=∀(vs :α list) (fm :α |-> β) (vals :β list) (upd_vals :β list). OPT_MMAP (FLOOKUP fm) vs = SOME vals ∧ LENGTH vs = LENGTH upd_vals ⇒ FDOM (fm |++ ZIP (vs,upd_vals)) = FDOM fm
SUBMAP_IMP_FUPDATE_LIST_SUBMAP_typed=∀(x :α list) (y :β list) (f :α |-> β) (g :α |-> β). f ⊑ g ∧ LENGTH x = LENGTH y ⇒ f |++ ZIP (x,y) ⊑ g |++ ZIP (x,y)
evaluate_nested_decs_locals_nested_res_var_drule_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (vs :num list) (es :α crepLang$exp list) (vals :α word_lab list) (r1 :α result option) (t' :(α, β) state). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH es ∧ ALL_DISTINCT vs ∧ (∀(v :num). MEM v vs ⇒ ∀(e :α crepLang$exp). MEM e es ⇒ ¬MEM v (var_cexp e)) ∧ (evaluate (p,s with locals := s.locals |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ (evaluate (nested_decs vs es p,s) :α result option # (α, β) state) = (r1,t') ⇒ r1 = r ∧ state_rel s' t' ∧ t'.locals = FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs))
evaluate_nested_decs_locals_nested_res_var_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (vs :num list) (es :α crepLang$exp list) (vals :α word_lab list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH es ∧ ALL_DISTINCT vs ∧ (∀(v :num). MEM v vs ⇒ ∀(e :α crepLang$exp). MEM e es ⇒ ¬MEM v (var_cexp e)) ∧ (evaluate (p,s with locals := s.locals |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs vs es p,s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ t'.locals = FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs))
nested_decs_evaluate_typed=∀(vs :num list) (es :α crepLang$exp list) (p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (vals :α word_lab list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH es ∧ ALL_DISTINCT vs ∧ (∀(v :num). MEM v vs ⇒ ∀(e :α crepLang$exp). MEM e es ⇒ ¬MEM v (var_cexp e)) ∧ (evaluate (p,s with locals := s.locals |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ r ≠ SOME (Error :α result) ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs vs es p,s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t'
single_dec_evaluate_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (v :num) (e :α crepLang$exp) (val :α word_lab). (eval s e :α word_lab option) = SOME val ∧ (evaluate (p,s with locals := s.locals⟨v ↦ val⟩) :α result option # (α, β) state) = (r,s') ∧ r ≠ SOME (Error :α result) ⇒ ∃(t' :(α, β) state). (evaluate ((Dec v e p :α crepLang$prog),s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t'
nested_decs_evaluate_sublocals_strong_typed=∀(vs :num list) (es :α crepLang$exp list) (p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (vals :α word_lab list) (t :num |-> α word_lab). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vals ∧ LENGTH vs = LENGTH es ∧ ALL_DISTINCT vs ∧ (∀(v :num). MEM v vs ⇒ ∀(e :α crepLang$exp). MEM e es ⇒ ¬MEM v (var_cexp e)) ∧ (∀(v :num). MEM v vs ⇒ v ∉ FDOM t) ∧ (evaluate (p,s with locals := t |++ ZIP (vs,vals)) :α result option # (α, β) state) = (r,s') ∧ t ⊑ s.locals ∧ ((case r of (NONE :α result option) => T | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break n :α result) => T | SOME (Continue n' :α result) => T | SOME (Return v9 :α result) => F | SOME (Exception v10 :α result) => F | SOME (FinalFFI v11 :α result) => F) ⇔ T) ⇒ ∃(t' :(α, β) state). (evaluate (nested_decs vs es p,s) :α result option # (α, β) state) = (r,t') ∧ state_rel s' t' ∧ FDIFF s.locals (FDOM t) ⊑ t'.locals
evaluate_nested_seq_assign_typed=∀(ns :num list) (s :(α, β) state) (es :α crepLang$exp list) (ws :α word_lab list) (vals :α word_lab list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME ws ∧ (∀(x :num). MEM x ns ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ∧ OPT_MMAP (FLOOKUP s.locals) ns = SOME vals ∧ LENGTH ns = LENGTH ws ∧ ALL_DISTINCT ns ⇒ ∃(s' :(α, β) state). (evaluate (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns es :α crepLang$prog list),s) :α result option # (α, β) state) = ((NONE :α result option),s') ∧ state_rel s s' ∧ (∀(x :num). ¬MEM x ns ⇒ FLOOKUP s'.locals x = FLOOKUP s.locals x) ∧ OPT_MMAP (FLOOKUP s'.locals) ns = SOME ws
evaluate_nested_seq_assign_drule_typed=∀(ns :num list) (s :(α, β) state) (es :α crepLang$exp list) (ws :α word_lab list) (vals :α word_lab list) (r :α result option) (s' :(α, β) state). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME ws ∧ (∀(x :num). MEM x ns ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ∧ OPT_MMAP (FLOOKUP s.locals) ns = SOME vals ∧ LENGTH ns = LENGTH ws ∧ ALL_DISTINCT ns ∧ (evaluate (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns es :α crepLang$prog list),s) :α result option # (α, β) state) = (r,s') ⇒ r = (NONE :α result option) ∧ state_rel s s' ∧ (∀(x :num). ¬MEM x ns ⇒ FLOOKUP s'.locals x = FLOOKUP s.locals x) ∧ OPT_MMAP (FLOOKUP s'.locals) ns = SOME ws
opt_mmap_flookup_not_mem_domsub_typed=∀(vs :α list) (fm :α |-> β) (vals :β list) (x :α). OPT_MMAP (FLOOKUP fm) vs = SOME vals ∧ ¬MEM x vs ⇒ OPT_MMAP (FLOOKUP (fm \\ x)) vs = SOME vals
opt_mmap_some_imp_fupdate_exist_some_typed=∀(vs :α list) (fm :α |-> β) (vals :β list) (nv :α # β). OPT_MMAP (FLOOKUP fm) vs = SOME vals ⇒ ∃(z :β list). OPT_MMAP (FLOOKUP (fm |+ nv)) vs = SOME z
opt_mmap_some_imp_fupdate_list_exist_some_typed=∀(xs :α list) (ys :β list) (vs :α list) (fm :α |-> β) (vals :β list). OPT_MMAP (FLOOKUP fm) vs = SOME vals ∧ LENGTH xs = LENGTH ys ⇒ ∃(z :β list). OPT_MMAP (FLOOKUP (fm |++ ZIP (xs,ys))) vs = SOME z
opt_mmap_update_locals_not_vars_eval_eq_typed=∀(es :α crepLang$exp list) (n :num) (vs :α word_lab list) (w :α word_lab) (s :(α, β) state). ¬MEM n (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ∧ OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vs ⇒ OPT_MMAP (eval (s with locals := s.locals⟨n ↦ w⟩) :α crepLang$exp -> α word_lab option) es = SOME vs
not_has_return_not_evaluate_return_typed=∀(p :α crepLang$prog) (s :(α, β) state). ¬has_return p ⇒ ∃(r :α result option) (s' :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ case r of (NONE :α result option) => T | SOME (Error :α result) => T | SOME (TimeOut :α result) => T | SOME (Break v7 :α result) => T | SOME (Continue v8 :α result) => T | SOME (Return retv :α result) => F | SOME (Exception v10 :α result) => T | SOME (FinalFFI v11 :α result) => T
not_branch_ret_evaluate_return_unreach_elim_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state). unreach_elim p = (p,(NONE :early_exit option)) ∧ not_branch_ret p ∧ (evaluate (p,s) :α result option # (α, β) state) = (r,s') ⇒ ∀(rv :α word_lab list). r ≠ SOME (Return rv :α result)
not_var_prog_flookup_eqn_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (x :num). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ ¬MEM x (var_prog p) ∧ ((case r of (NONE :α result option) => T | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break n :α result) => T | SOME (Continue n' :α result) => T | SOME (Return v9 :α result) => F | SOME (Exception v10 :α result) => F | SOME (FinalFFI v11 :α result) => F) ⇔ T) ⇒ FLOOKUP s'.locals x = FLOOKUP s.locals x
compile_inline_distinct_typed=∀(crep_code :(mlstring # α # β crepLang$prog) list) (inl_fs :mlstring |-> num list # β crepLang$prog). ALL_DISTINCT (MAP (FST :mlstring # α # β crepLang$prog -> mlstring) crep_code) ⇒ ALL_DISTINCT (MAP (FST :mlstring # α # β crepLang$prog -> mlstring) (compile_inl_prog inl_fs crep_code))
evaluate_call_same_result_state_typed=∀(e :mlstring) (args :α crepLang$exp list) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (t :(α, β) state) (inl_fs :mlstring |-> num list # α crepLang$prog). (evaluate ((Call (NONE :(num list # (α word # α crepLang$prog) option) option) e args :α crepLang$prog),s) :α result option # (α, β) state) = (r,s') ∧ state_rel_code s t ∧ inl_fs ⊑ s.code ∧ locals_strong_rel s t ∧ code_inl_rel inl_fs s t ∧ r ≠ SOME (Error :α result) ⇒ FST (evaluate ((Call (NONE :(num list # (α word # α crepLang$prog) option) option) e args :α crepLang$prog),t) :α result option # (α, β) state) = FST (evaluate ((Call (NONE :(num list # (α word # α crepLang$prog) option) option) e args :α crepLang$prog),s) :α result option # (α, β) state) ∧ state_rel_code (SND (evaluate ((Call (NONE :(num list # (α word # α crepLang$prog) option) option) e args :α crepLang$prog),s) :α result option # (α, β) state)) (SND (evaluate ((Call (NONE :(num list # (α word # α crepLang$prog) option) option) e args :α crepLang$prog),t) :α result option # (α, β) state))
fst_map_3_f_typed=∀(inl_fs :mlstring |-> num list # α crepLang$prog) (x :mlstring # β # α crepLang$prog). FST x = ((FST :mlstring # β # α crepLang$prog -> mlstring) ∘ (λ((name :mlstring),(params :β),(body :α crepLang$prog)). (name,params,inline_prog (inl_fs \\ name) body))) x
state_rel_imp_semantics_typed=∀(s :(α, β) state) (t :(α, β) state) (crep_code :(mlstring # num list # α crepLang$prog) list) (start :mlstring) (inl_fname :mlstring list) (ns :num list) (prog :α crepLang$prog). state_rel_code s t ∧ locals_strong_rel s t ∧ ALL_DISTINCT (MAP (FST :mlstring # num list # α crepLang$prog -> mlstring) crep_code) ∧ s.code = alist_to_fmap crep_code ∧ t.code = alist_to_fmap (compile_inl_top inl_fname crep_code) ∧ FLOOKUP s.code start = SOME (ns,prog) ∧ semantics s start ≠ Fail ⇒ semantics t start = semantics s start
state_rel_imp_semantics_local_typed=∀(s :(α, β) state) (t :(α, β) state) (crep_code :(mlstring # num list # α crepLang$prog) list) (start :mlstring) (inl_fs :mlstring |-> num list # α crepLang$prog) (ns :num list) (prog :α crepLang$prog). state_rel_code s t ∧ locals_strong_rel s t ∧ ALL_DISTINCT (MAP (FST :mlstring # num list # α crepLang$prog -> mlstring) crep_code) ∧ s.code = alist_to_fmap crep_code ∧ inl_fs ⊑ s.code ∧ t.code = alist_to_fmap (compile_inl_prog inl_fs crep_code) ∧ FLOOKUP s.code start = SOME (ns,prog) ∧ semantics s start ≠ Fail ⇒ semantics t start = semantics s start
transform_branch_correct_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (res' :γ) (ld :num) (rts :num list). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ (∀(retvs :α word_lab list). r = SOME (Return retvs :α result) ⇒ LENGTH rts = LENGTH retvs) ∧ (∀(x :num). MEM x rts ⇒ ¬MEM x (var_prog p)) ∧ (∃(z :α word_lab list). OPT_MMAP (FLOOKUP s.locals) rts = SOME z) ∧ ALL_DISTINCT rts ∧ r ≠ SOME (Error :α result) ⇒ ∃(r1 :α result option) (s1' :(α, β) state). (evaluate (transform_branch ld rts p,s) :α result option # (α, β) state) = (r1,s1') ∧ state_rel s' s1' ∧ case r of (NONE :α result option) => r1 = (NONE :α result option) ∧ locals_strong_rel s' s1' | SOME (Error :α result) => F | SOME (TimeOut :α result) => r1 = SOME (TimeOut :α result) | SOME (Break n :α result) => r1 = SOME (Break n :α result) ∧ locals_strong_rel s' s1' | SOME (Continue n' :α result) => r1 = SOME (Continue n' :α result) ∧ locals_strong_rel s' s1' | SOME (Return retvs :α result) => r1 = SOME (Break ld :α result) ∧ OPT_MMAP (FLOOKUP s1'.locals) rts = SOME retvs | SOME (Exception v10 :α result) => r1 = SOME (Exception v10 :α result) | SOME (FinalFFI v11 :α result) => r1 = SOME (FinalFFI v11 :α result)
transform_eoc_correct_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (res' :early_exit option) (rts :num list). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ unreach_elim p = (p,res') ∧ not_branch_ret p ∧ (∀(retvs :α word_lab list). r = SOME (Return retvs :α result) ⇒ LENGTH rts = LENGTH retvs) ∧ (∀(x :num). MEM x rts ⇒ ¬MEM x (var_prog p)) ∧ (∃(z :α word_lab list). OPT_MMAP (FLOOKUP s.locals) rts = SOME z) ∧ ALL_DISTINCT rts ∧ r ≠ SOME (Error :α result) ⇒ ∃(r1 :α result option) (s1' :(α, β) state). (evaluate (transform_eoc rts p,s) :α result option # (α, β) state) = (r1,s1') ∧ state_rel s' s1' ∧ case r of (NONE :α result option) => r1 = (NONE :α result option) ∧ locals_strong_rel s' s1' | SOME (Error :α result) => F | SOME (TimeOut :α result) => r1 = SOME (TimeOut :α result) | SOME (Break n :α result) => r1 = SOME (Break n :α result) ∧ locals_strong_rel s' s1' | SOME (Continue n' :α result) => r1 = SOME (Continue n' :α result) ∧ locals_strong_rel s' s1' | SOME (Return retvs :α result) => r1 = (NONE :α result option) ∧ OPT_MMAP (FLOOKUP s1'.locals) rts = SOME retvs | SOME (Exception v10 :α result) => r1 = SOME (Exception v10 :α result) | SOME (FinalFFI v11 :α result) => r1 = SOME (FinalFFI v11 :α result)
not_has_return_imp_not_branch_ret_typed=∀(p :α crepLang$prog). ¬has_return p ⇒ not_branch_ret p
unreach_elim_arg_load_typed=∀(p :α crepLang$prog) (tmp_vars :num list) (args :α crepLang$exp list) (args_vname :num list) (r :early_exit option). LENGTH tmp_vars = LENGTH args ∧ LENGTH args = LENGTH args_vname ∧ unreach_elim p = (p,r) ⇒ unreach_elim (arg_load tmp_vars args args_vname p) = (arg_load tmp_vars args args_vname p,r)
unreach_elim_arg_load_perm_typed=∀(p :α crepLang$prog) (tmp_vars :num list) (args :α crepLang$exp list) (args_vname :num list) (r :early_exit option). LENGTH tmp_vars = LENGTH args_vname ∧ LENGTH args = LENGTH args_vname ∧ unreach_elim p = (p,r) ⇒ unreach_elim (arg_load tmp_vars args args_vname p) = (arg_load tmp_vars args args_vname p,r)
unreach_elim_converge_typed=∀(p :α crepLang$prog) (q :α crepLang$prog) (r :early_exit option). unreach_elim p = (q,r) ⇒ unreach_elim q = (q,r)
unreach_elim_fix_point_typed=∀(q :α crepLang$prog) (r :early_exit option). (∃(p :α crepLang$prog). unreach_elim p = (q,r)) ⇔ unreach_elim q = (q,r)
unreach_elim_nested_decs_typed=∀(vs :num list) (es :α crepLang$exp list) (p :α crepLang$prog) (r :early_exit option). LENGTH vs = LENGTH es ∧ unreach_elim p = (p,r) ⇒ unreach_elim (nested_decs vs es p) = (nested_decs vs es p,r)
unreach_elim_correct_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (p1 :α crepLang$prog) (s1 :early_exit option). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ r ≠ SOME (Error :α result) ∧ unreach_elim p = (p1,s1) ⇒ (evaluate (p1,s) :α result option # (α, β) state) = (r,s')
unreach_elim_not_none_evaluate_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (p1 :α crepLang$prog) (e :early_exit). unreach_elim p = (p1,SOME e) ∧ (evaluate (p,s) :α result option # (α, β) state) = (r,s') ⇒ ∃(e :α result). r = SOME e
unreach_elim_preserve_has_return_typed=∀(p :α crepLang$prog) (q :α crepLang$prog) (r :early_exit option). ¬has_return p ∧ unreach_elim p = (q,r) ⇒ ¬has_return q
unreach_elim_preserve_not_branch_ret_typed=∀(p :α crepLang$prog) (q :α crepLang$prog) (r :early_exit option). not_branch_ret p ∧ unreach_elim p = (q,r) ⇒ not_branch_ret q
not_has_return_imp_unreach_elim_typed=∀(p :α crepLang$prog) (r :early_exit option). ¬has_return p ∧ unreach_elim p = (p,r) ⇒ r ≠ SOME Ret
opt_mmap_update_list_locals_not_vars_eval_eq_typed=∀(es :α crepLang$exp list) (vs :num list) (vals :α word_lab list) (s :(α, β) state) (res :α word_lab list option). (∀(x :num). MEM x vs ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ∧ OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = res ∧ LENGTH vs = LENGTH vals ⇒ OPT_MMAP (eval (s with locals := s.locals |++ ZIP (vs,vals)) :α crepLang$exp -> α word_lab option) es = res
SUBMAP_DIFF_LIST_typed=∀(l :α |-> β) (vs :α list) (vals :β list). LENGTH vs = LENGTH vals ∧ ALL_DISTINCT vs ∧ (∀(v :α). MEM v vs ⇒ v ∉ FDOM l) ⇒ l ⊑ l |++ ZIP (vs,vals)
update_list_locals_not_vars_eval_eq_typed=∀(vs :num list) (s :(α, β) state) (res :α word_lab option) (e :α crepLang$exp) (vals :α word_lab list). (∀(x :num). MEM x vs ⇒ ¬MEM x (var_cexp e)) ∧ (eval s e :α word_lab option) = res ∧ LENGTH vs = LENGTH vals ⇒ (eval (s with locals := s.locals |++ ZIP (vs,vals)) e :α word_lab option) = res
mem_var_prog_nested_seq_typed=∀(ps :α crepLang$prog list) (x :num). MEM x (var_prog (nested_seq ps)) ⇔ MEM x (FLAT (MAP (var_prog :α crepLang$prog -> num list) ps))
mem_var_prog_transform_branch_typed=∀(ld :num) (rts :num list) (p :α crepLang$prog) (x :num). MEM x (var_prog (transform_branch ld rts p)) ⇒ MEM x (var_prog p) ∨ MEM x rts
mem_var_prog_transform_eoc_typed=∀(rts :num list) (p :α crepLang$prog) (x :num). MEM x (var_prog (transform_eoc rts p)) ⇒ MEM x (var_prog p) ∨ MEM x rts
wrapped_transform_if_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (res' :early_exit option) (rts :num list) (loc :num |-> α word_lab). (evaluate (p,dec_clock s with locals := loc) :α result option # (α, β) state) = (r,s') ∧ unreach_elim p = (p,res') ∧ (∀(retvs :α word_lab list). r = SOME (Return retvs :α result) ⇒ LENGTH rts = LENGTH retvs) ∧ (∀(x :num). MEM x rts ⇒ ¬MEM x (var_prog p)) ∧ (∃(z :α word_lab list). OPT_MMAP (FLOOKUP loc) rts = SOME z) ∧ ALL_DISTINCT rts ∧ ¬cont_res r ∧ s.clock ≠ (0 :num) ∧ r ≠ SOME (Error :α result) ⇒ ∃(r1 :α result option) (s1' :(α, β) state). (evaluate (if not_branch_ret p then Seq (Tick :α crepLang$prog) (transform_eoc rts p) else (While (Const (1w :α word) :α crepLang$exp) (transform_branch (0 :num) rts p) :α crepLang$prog),s with locals := loc) :α result option # (α, β) state) = (r1,s1') ∧ state_rel s' s1' ∧ case r of (NONE :α result option) => F | SOME (Error :α result) => F | SOME (TimeOut :α result) => r1 = SOME (TimeOut :α result) | SOME (Break v7 :α result) => F | SOME (Continue v8 :α result) => F | SOME (Return retvs :α result) => r1 = (NONE :α result option) ∧ OPT_MMAP (FLOOKUP s1'.locals) rts = SOME retvs | SOME (Exception eid :α result) => r1 = SOME (Exception eid :α result) | SOME (FinalFFI ffi :α result) => r1 = SOME (FinalFFI ffi :α result)
exps_of_nested_decs_typed=∀(e :α crepLang$exp) (vs :num list) (es :α crepLang$exp list) (p :α crepLang$prog). MEM e (exps_of (nested_decs vs es p) :α crepLang$exp list) ⇒ MEM e es ∨ MEM e (exps_of p :α crepLang$exp list)
exps_of_nested_seq_assign_typed=∀(ns :num list) (es :α crepLang$exp list) (e :α crepLang$exp). MEM e (exps_of (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns es :α crepLang$prog list)) :α crepLang$exp list) ⇒ MEM e es
exps_of_arg_load_typed=∀(e :α crepLang$exp) (tmp_vars :num list) (args :α crepLang$exp list) (args_vname :num list) (p :α crepLang$prog). MEM e (exps_of (arg_load tmp_vars args args_vname p) :α crepLang$exp list) ⇒ MEM e args ∨ (∃(c :num). MEM c tmp_vars ∧ e = (Var c :α crepLang$exp)) ∨ MEM e (exps_of p :α crepLang$exp list)
exps_of_unreach_elim_typed=∀(p :α crepLang$prog) (q :α crepLang$prog) (r :early_exit option) (e :α crepLang$exp) (rt :β). unreach_elim p = (q,r) ∧ MEM e (exps_of q :α crepLang$exp list) ⇒ MEM e (exps_of p :α crepLang$exp list)
exps_of_transform_eoc_typed=∀(rts :num list) (p :α crepLang$prog) (e :α crepLang$exp). MEM e (exps_of (transform_eoc rts p) :α crepLang$exp list) ⇒ MEM e (exps_of p :α crepLang$exp list)
exps_of_transform_branch_typed=∀(ld :num) (rts :num list) (p :α crepLang$prog) (e :α crepLang$exp). MEM e (exps_of (transform_branch ld rts p) :α crepLang$exp list) ⇒ MEM e (exps_of p :α crepLang$exp list)
exps_of_inst_inline_typed=∀(inl_fs :mlstring |-> num list # α crepLang$prog) (prog :α crepLang$prog) (crep_code :(mlstring # num list # α crepLang$prog) list) (e :α crepLang$exp). inl_fs ⊑ alist_to_fmap crep_code ∧ MEM e (exps_of (inline_prog inl_fs prog) :α crepLang$exp list) ⇒ MEM e (exps_of prog :α crepLang$exp list) ∨ (∃(c :α word). e = (Const c :α crepLang$exp)) ∨ (∃(v :num). e = (Var v :α crepLang$exp)) ∨ ∃(name :mlstring) (params :num list) (body :α crepLang$prog). MEM (name,params,body) crep_code ∧ MEM e (exps_of body :α crepLang$exp list)
every_inst_crep_inline_typed=∀(crep_code :(mlstring # num list # α crepLang$prog) list) (inl_fs :mlstring |-> num list # α crepLang$prog). (∀(e :mlstring # num list # α crepLang$prog). MEM e crep_code ⇒ (λ((name :mlstring),(params :num list),(body :α crepLang$prog)). ∀(e :α crepLang$exp). MEM e (exps_of body :α crepLang$exp list) ⇒ every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)) e) e) ∧ inl_fs ⊑ alist_to_fmap crep_code ⇒ ∀(e :mlstring # num list # α crepLang$prog). MEM e (compile_inl_prog inl_fs crep_code) ⇒ (λ((name :mlstring),(params :num list),(body :α crepLang$prog)). ∀(e :α crepLang$exp). MEM e (exps_of body :α crepLang$exp list) ⇒ every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)) e) e
compile_inl_prog_def_typed=∀(inl_fs :mlstring |-> num list # β crepLang$prog) (prog :(mlstring # α # β crepLang$prog) list). compile_inl_prog inl_fs prog = MAP (λ((name :mlstring),(params :α),(body :β crepLang$prog)). (name,params,inline_prog (inl_fs \\ name) body)) prog
