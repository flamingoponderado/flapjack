arith_upd_consts_typed=(arith_upd (a :α arith) (x :α asm_state)).mem_domain = x.mem_domain ∧ (arith_upd a x).align = x.align ∧ (arith_upd a x).mem = x.mem ∧ (arith_upd a x).lr = x.lr ∧ ((arith_upd a x).be ⇔ x.be)
binop_upd_consts_typed=(binop_upd (a :num) (b :binop) (c :α word) (d :α word) (x :α asm_state)).mem_domain = x.mem_domain ∧ (binop_upd a b c d x).align = x.align ∧ ((binop_upd a b c d x).failed ⇔ x.failed) ∧ (binop_upd a b c d x).mem = x.mem ∧ (binop_upd a b c d x).lr = x.lr ∧ ((binop_upd a b c d x).be ⇔ x.be)
upd_pc_simps_typed=(upd_pc (x :α word) (s :α asm_state)).align = s.align ∧ (upd_pc x s).mem_domain = s.mem_domain ∧ ((upd_pc x s).failed ⇔ s.failed) ∧ ((upd_pc x s).be ⇔ s.be) ∧ (upd_pc x s).mem = s.mem ∧ (upd_pc x s).regs = s.regs ∧ (upd_pc x s).fp_regs = s.fp_regs ∧ (upd_pc x s).lr = s.lr ∧ (upd_pc x s).pc = x
asm_consts_typed=∀(i :α asm) (w :α word) (s :α asm_state). ((asm i w s).be ⇔ s.be) ∧ (asm i w s).lr = s.lr ∧ (asm i w s).align = s.align ∧ (asm i w s).mem_domain = s.mem_domain
asm_failed_ignore_new_pc_typed=∀(i :α asm) (v :α word) (w :α word) (s :α asm_state). (asm i w s).failed ⇔ (asm i v s).failed
asm_mem_ignore_new_pc_typed=∀(i :α asm) (v :α word) (w :α word) (s :α asm_state). (asm i w s).mem = (asm i v s).mem
asserts_def_typed=(∀(next :num -> α -> α) (ms :α) (v0 :α -> bool) (Q :α -> bool). asserts (0 :num) next ms v0 Q ⇔ Q (next (0 :num) ms)) ∧ ∀(n :num) (next :num -> α -> α) (ms :α) (P :α -> bool) (Q :α -> bool). asserts (SUC n) next ms P Q ⇔ (let (ms' :α) = next (SUC n) ms in P ms' ∧ asserts n next ms' P Q)
asserts2_def_typed=∀(n :num) (ms :β) (fi :num -> α -> β) (fc :β -> α) (P :β -> α -> bool). asserts2 n fi fc ms P ⇔ if n = (0 :num) then T else P ms (fc ms) ∧ asserts2 (n − (1 :num)) fi fc (fi n (fc ms)) P
asserts2_change_interfer_typed=asserts2 (n :num) (fi :num -> α -> β) (fc :β -> α) (ms :β) (P :β -> α -> bool) ∧ (∀(k :num). k ≤ n ⇒ fi k = (fi2 :num -> α -> β) k) ⇒ asserts2 n fi2 fc ms P
asserts2_every_typed=∀(n :num) (ms :α) (j :num). asserts2 n (λ(k :num). (f :β -> α)) (g :α -> β) ms (P :α -> β -> bool) ∧ j < n ⇒ P (FUNPOW (f ∘ g) j ms) (g (FUNPOW (f ∘ g) j ms))
asserts2_first_typed=(1 :num) ≤ (n :num) ∧ asserts2 n (fi :num -> α -> β) (fc :β -> α) (ms :β) (P :β -> α -> bool) ⇒ P ms (fc ms)
asserts_IMP_FOLDR_COUNT_LIST_typed=∀(n :num) (next :num -> α -> α) (ms :α) (P :α -> bool) (Q :α -> bool). asserts n next ms P Q ⇒ Q (FOLDR next (next n ms) (COUNT_LIST n))
asserts_IMP_FOLDR_COUNT_LIST_LESS_typed=∀(k :num) (n :num) (next :num -> α -> α) (ms :α) (P :α -> bool) (Q :α -> bool). asserts n next ms P Q ∧ k < n ⇒ P (FOLDR next ms (REVERSE (GENLIST ($- n) (SUC k))))
asserts_WEAKEN_typed=∀(n :num) (next :num -> α -> α) (s :α) (P :α -> bool) (Q :α -> bool). (∀(k :num). k ≤ n ⇒ next k = (next' :num -> α -> α) k ∧ (P (FOLDR next s (REVERSE (GENLIST ($- n) (SUC k)))) ⇒ (P' :α -> bool) (FOLDR next s (REVERSE (GENLIST ($- n) (SUC k)))))) ⇒ asserts n next s P Q ⇒ asserts n next' s P' Q
encoder_correct_def_typed=∀(t :(α, β, γ) target). encoder_correct t ⇔ target_ok t ∧ ∀(s1 :α asm_state) (i :α asm) (s2 :α asm_state) (ms :β). asm_step t.config s1 i s2 ∧ target_state_rel t s1 ms ⇒ ∃(n :num). ∀(env :num -> β -> β). interference_ok env (t.proj s1.mem_domain) ⇒ (let (pcs :num -> α word -> bool) = all_pcs (LENGTH (t.config.encode i)) s1.pc in asserts n (λ(k :num) (s :β). env (n − k) (t.next s)) ms (λ(ms' :β). t.state_ok ms' ∧ (∀(pc :α word). pc ∈ pcs (0 :num) ⇒ t.get_byte ms' pc = t.get_byte ms pc) ∧ t.get_pc ms' ∈ pcs t.config.code_alignment) (λ(ms' :β). target_state_rel t s2 ms') ∧ asserts2 (n + (1 :num)) (λ(k :num). env (n + (1 :num) − k)) t.next ms (λ(ms1 :β) (ms2 :β). ∀(x :α word). x ∉ s1.mem_domain ⇒ t.get_byte ms1 x = t.get_byte ms2 x))
enc_ok_def_typed=∀(c :α asm_config). enc_ok c ⇔ (2 :num) ** c.code_alignment = LENGTH (c.encode (Inst (Skip :α inst))) ∧ (∀(w :α asm). LENGTH (c.encode w) MOD (2 :num) ** c.code_alignment = (0 :num) ∧ LENGTH (c.encode w) ≠ (0 :num)) ∧ (∀(w1 :α word) (w2 :α word). offset_monotonic c.encode c w1 w2 (Jump w1) (Jump w2)) ∧ (∀(cmp :cmp) (r :num) (ri :α reg_imm) (w1 :α word) (w2 :α word). offset_monotonic c.encode c w1 w2 (JumpCmp cmp r ri w1) (JumpCmp cmp r ri w2)) ∧ (∀(w1 :α word) (w2 :α word). offset_monotonic c.encode c w1 w2 (Call w1) (Call w2)) ∧ ∀(w1 :α word) (w2 :α word) (r :num). offset_monotonic c.encode c w1 w2 (Loc r w1) (Loc r w2)
offset_monotonic_def_typed=∀(enc :α asm -> β list) (c :α asm_config) (a1 :γ word) (a2 :γ word) (i1 :α asm) (i2 :α asm). offset_monotonic enc c a1 a2 i1 i2 ⇔ asm_ok i1 c ∧ asm_ok i2 c ⇒ ((0w :γ word) ≤ a1 ∧ (0w :γ word) ≤ a2 ∧ a1 ≤ a2 ⇒ LENGTH (enc i1) ≤ LENGTH (enc i2)) ∧ (a1 < (0w :γ word) ∧ a2 < (0w :γ word) ∧ a2 ≤ a1 ⇒ LENGTH (enc i1) ≤ LENGTH (enc i2))
target_ok_def_typed=∀(t :(α, β, γ) target). target_ok t ⇔ enc_ok t.config ∧ ∀(ms1 :β) (ms2 :β) (s :α asm_state). t.proj s.mem_domain ms1 = t.proj s.mem_domain ms2 ⇒ (target_state_rel t s ms1 ⇔ target_state_rel t s ms2) ∧ (t.state_ok ms1 ⇔ t.state_ok ms2) ∧ t.get_pc ms1 = t.get_pc ms2 ∧ ∀(a :α word). a ∈ s.mem_domain ⇒ t.get_byte ms1 a = t.get_byte ms2 a
fp_upd_consts_typed=(fp_upd (a :fp) (x :α asm_state)).mem_domain = x.mem_domain ∧ (fp_upd a x).align = x.align ∧ (fp_upd a x).mem = x.mem ∧ (fp_upd a x).lr = x.lr ∧ ((fp_upd a x).be ⇔ x.be)
interference_ok_def_typed=∀(env :num -> α -> α) (proj :α -> β). interference_ok env proj ⇔ ∀(i :num) (ms :α). proj (env i ms) = proj ms
read_mem_word_IMP_mem_eq_typed=∀(a :α word) (k :num) (s :α asm_state) (w :β word) (s' :α asm_state). (read_mem_word a k s :β word # α asm_state) = (w,s') ⇒ s'.mem = s.mem
write_mem_word_mem_domain_typed=∀(k :num) (b :α word) (a :β word) (s :α asm_state). (write_mem_word b k a s).mem_domain = s.mem_domain
write_mem_word_mem_eq_typed=∀(k :num) (b :α word) (a :β word) (s :α asm_state) (x :α word). ¬(write_mem_word b k a s).failed ∧ x ∉ s.mem_domain ⇒ (write_mem_word b k a s).mem x = s.mem x
all_pcs_def_typed=(∀(k :num) (a :α word). all_pcs (0 :num) a k = (∅ :α word -> bool)) ∧ ∀(v2 :num) (k :num) (a :α word). all_pcs (SUC v2) a k = a INSERT all_pcs (SUC v2 − (2 :num) ** k) (a + (n2w ((2 :num) ** k) :α word)) k
all_pcs_thm_typed=all_pcs (n :num) (a :α word) (k :num) = {a + (n2w (i * (2 :num) ** k) :α word) | i | i * (2 :num) ** k < n}
bytes_in_memory_all_pcs_typed=∀(xs :word8 list) (pc :α word). bytes_in_memory pc xs (m :α word -> word8) (d :α word -> bool) ⇒ all_pcs (LENGTH xs) pc (k :num) ⊆ d
target_typed=recordtype.target::α asm_config -> (β -> β) -> (β -> α word) -> (β -> num -> α word) -> (β -> num -> word64) -> (β -> α word -> word8) -> (β -> bool) -> ((α word -> bool) -> β -> γ) -> (α, β, γ) target
target_state_rel_def_typed=∀(t :(α, β, γ) target) (s :α asm_state) (ms :β). target_state_rel t s ms ⇔ t.state_ok ms ∧ t.get_pc ms = s.pc ∧ (∀(a :α word). a ∈ s.mem_domain ⇒ t.get_byte ms a = s.mem a) ∧ (∀(i :num). i < t.config.reg_count ∧ ¬MEM i t.config.avoid_regs ⇒ t.get_reg ms i = s.regs i) ∧ ∀(i :num). i < t.config.fp_reg_count ⇒ t.get_fp_reg ms i = s.fp_regs i
