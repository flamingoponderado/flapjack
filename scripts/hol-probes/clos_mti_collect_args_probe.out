state_rel_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list) ∧ EVERY no_mti (FST (SND (s.compile_oracle n)))) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ LIST_REL (v_rel_opt s.max_app) s.globals t.globals ∧ FMAP_REL (ref_rel s.max_app :v ref -> v ref -> bool) s.refs t.refs ∧ s.compile = pure_cc (compile_inc s.max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) t.compile ∧ t.compile_oracle = (pure_co (compile_inc s.max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
is_closure_typed=(isClos (Closure (x1 :num option) (x2 :v list) (x3 :v list) (x4 :num) (x5 :closLang$exp) :v) ⇔ T) ∧ (isClos (Recclosure (y1 :num option) (y2 :v list) (y3 :v list) (y4 :(num # closLang$exp) list) (y5 :num) :v) ⇔ T) ∧ (isClos (Number (v :int)) ⇔ F) ∧ (isClos (Word64 (v1 :word64) :v) ⇔ F) ∧ (isClos (Block (v2 :num) (v3 :v list)) ⇔ F) ∧ (isClos (ByteVector (v4 :word8 list)) ⇔ F) ∧ (isClos (RefPtr (v5 :bool) (v6 :num)) ⇔ F)
simple_value_relation_typed=∀(vr :v -> v -> bool). simple_val_rel vr ⇔ (∀(x :v) (n :int). vr x (Number n) ⇔ x = Number n) ∧ (∀(x :v) (p :v list) (n :num). vr x (Block n p) ⇔ ∃(xs :v list). x = Block n xs ∧ LIST_REL vr xs p) ∧ (∀(x :v) (p :word64). vr x (Word64 p :v) ⇔ x = (Word64 p :v)) ∧ (∀(x :v) (p :word8 list). vr x (ByteVector p) ⇔ x = ByteVector p) ∧ (∀(x :v) (p :num) (b :bool). vr x (RefPtr b p) ⇔ x = RefPtr b p) ∧ (∀(x5 :closLang$exp) (x4 :num) (x3 :v list) (x2 :v list) (x1 :num option) (x :v). vr x (Closure x1 x2 x3 x4 x5 :v) ⇒ isClos x) ∧ ∀(y5 :num) (y4 :(num # closLang$exp) list) (y3 :v list) (y2 :v list) (y1 :num option) (x :v). vr x (Recclosure y1 y2 y3 y4 y5 :v) ⇒ isClos x
mti_simple_value_relation_typed=simple_val_rel (v_rel (max_app_n :num))
simple_state_relation_typed=∀(vr :v -> v -> bool) (sr :(δ, 'ffi) state -> (γ, 'ffi) state -> bool). simple_state_rel vr sr ⇔ (∀(s :(δ, 'ffi) state) (t :(γ, 'ffi) state) (ptr :num). FLOOKUP t.refs ptr = (NONE :v ref option) ∧ sr s t ⇒ FLOOKUP s.refs ptr = (NONE :v ref option)) ∧ (∀(w :word8 list) (t :(γ, 'ffi) state) (s :(δ, 'ffi) state) (ptr :num). FLOOKUP t.refs ptr = SOME (ByteArray w :v ref) ∧ sr s t ⇒ FLOOKUP s.refs ptr = SOME (ByteArray w :v ref)) ∧ (∀(w :v list) (t :(γ, 'ffi) state) (s :(δ, 'ffi) state) (ptr :num). FLOOKUP t.refs ptr = SOME (ValueArray w) ∧ sr s t ⇒ ∃(w1 :v list). FLOOKUP s.refs ptr = SOME (ValueArray w1) ∧ LIST_REL vr w1 w) ∧ (∀(m :thunk_mode) (v :v) (t :(γ, 'ffi) state) (s :(δ, 'ffi) state) (ptr :num). FLOOKUP t.refs ptr = SOME (Thunk m v :v ref) ∧ sr s t ⇒ ∃(w :v). FLOOKUP s.refs ptr = SOME (Thunk m w :v ref) ∧ vr w v) ∧ (∀(s :(δ, 'ffi) state) (t :(γ, 'ffi) state). sr s t ⇒ s.ffi = t.ffi ∧ FDOM s.refs = FDOM t.refs ∧ LIST_REL (OPTREL vr) s.globals t.globals) ∧ (∀(f :'ffi ffi_state) (s :(δ, 'ffi) state) (t :(γ, 'ffi) state). sr s t ⇒ sr (s with ffi := f) (t with ffi := f)) ∧ (∀(bs :word8 list) (s :(δ, 'ffi) state) (t :(γ, 'ffi) state) (p :num). sr s t ⇒ sr (s with refs := s.refs⟨p ↦ (ByteArray bs :v ref)⟩) (t with refs := t.refs⟨p ↦ (ByteArray bs :v ref)⟩)) ∧ (∀(s :(δ, 'ffi) state) (t :(γ, 'ffi) state) (p :num) (xs :v list) (ys :v list). sr s t ∧ LIST_REL vr xs ys ⇒ sr (s with refs := s.refs⟨p ↦ ValueArray xs⟩) (t with refs := t.refs⟨p ↦ ValueArray ys⟩)) ∧ (∀(s :(δ, 'ffi) state) (t :(γ, 'ffi) state) (p :num) (m :thunk_mode) (v :v) (w :v). sr s t ∧ vr v w ⇒ sr (s with refs := s.refs⟨p ↦ (Thunk m v :v ref)⟩) (t with refs := t.refs⟨p ↦ (Thunk m w :v ref)⟩)) ∧ ∀(s :(δ, 'ffi) state) (t :(γ, 'ffi) state) (xs :v option list) (ys :v option list). sr s t ∧ LIST_REL (OPTREL vr) xs ys ⇒ sr (s with globals := xs) (t with globals := ys)
mti_simple_state_relation_typed=simple_state_rel (v_rel (max_app_n :num)) (λ(s :(α, β) state) (t :(α, β) state). s.max_app = max_app_n ∧ state_rel s t)
vr_list_to_value_typed=∀(xs :v list) (vys :v). simple_val_rel (vr :v -> v -> bool) ⇒ (vr vys (list_to_v xs) ⇔ ∃(ys :v list). vys = list_to_v ys ∧ LIST_REL vr ys xs)
vr_list_none_typed=∀(x :v) (x1 :v) (vr :v -> v -> bool). simple_val_rel vr ∧ vr x x1 ∧ v_to_list x1 = (NONE :v list option) ⇒ v_to_list x = (NONE :v list option)
simple_value_append_typed=∀(xs1 :v list) (ys1 :v list) (xs2 :v list) (ys2 :v list) (vr :v -> v -> bool). simple_val_rel vr ∧ vr (list_to_v xs1) (list_to_v xs2) ∧ vr (list_to_v ys1) (list_to_v ys2) ⇒ vr (list_to_v (xs1 ++ ys1)) (list_to_v (xs2 ++ ys2))
list_to_value_inj_typed=∀(xs :v list) (ys :v list). list_to_v xs = list_to_v ys ⇔ xs = ys
simple_value_list_typed=∀(x :v) (x1 :v) (xs :v list) (vr :v -> v -> bool). simple_val_rel vr ∧ vr x x1 ∧ v_to_list x1 = SOME xs ⇒ ∃(xs1 :v list). vr (list_to_v xs1) (list_to_v xs) ∧ v_to_list x = SOME xs1
value_equality_relation_typed=simple_val_rel (vr :v -> v -> bool) ⇒ (∀(y1 :v) (y2 :v) (x1 :v) (x2 :v). vr x1 y1 ∧ vr x2 y2 ⇒ do_eq x1 x2 = do_eq y1 y2) ∧ ∀(y1 :v list) (y2 :v list) (x1 :v list) (x2 :v list). LIST_REL vr x1 y1 ∧ LIST_REL vr x2 y2 ⇒ do_eq_list x1 x2 = do_eq_list y1 y2
simple_value_to_bytes_typed=simple_val_rel (vr :v -> v -> bool) ∧ vr (x :v) (y :v) ⇒ v_to_bytes x = v_to_bytes y
simple_word_left_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(x :v) (w :word64). vr (Word64 w :v) x ⇔ x = (Word64 w :v)
simple_value_to_words_typed=∀(x :v) (y :v). simple_val_rel (vr :v -> v -> bool) ∧ vr x y ⇒ v_to_words x = v_to_words y
