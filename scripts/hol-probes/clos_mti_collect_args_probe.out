mk_fns_def_typed=(∀(e :closLang$exp). mk_Fns ([] :mlstring list) e = e) ∧ ∀(t :mlstring) (ts :mlstring list) (e :closLang$exp). mk_Fns (t::ts) e = Fn t (NONE :num option) (NONE :num list option) (1 :num) (mk_Fns ts e)
collect_args_def_typed=(∀(t :mlstring) (num_args' :num) (num_args :num) (max_app :num) (e :closLang$exp). collect_args max_app num_args (Fn t (NONE :num option) (NONE :num list option) num_args' e) = if num_args + num_args' ≤ max_app then collect_args max_app (num_args + num_args') e else (num_args,Fn t (NONE :num option) (NONE :num list option) num_args' e)) ∧ (∀(v5 :num) (v4 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Var v4 v5 :closLang$exp) = (num_args,(Var v4 v5 :closLang$exp))) ∧ (∀(v9 :closLang$exp) (v8 :closLang$exp) (v7 :closLang$exp) (v6 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (If v6 v7 v8 v9 :closLang$exp) = (num_args,(If v6 v7 v8 v9 :closLang$exp))) ∧ (∀(v12 :closLang$exp) (v11 :closLang$exp list) (v10 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Let v10 v11 v12 :closLang$exp) = (num_args,(Let v10 v11 v12 :closLang$exp))) ∧ (∀(v14 :closLang$exp) (v13 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Raise v13 v14 :closLang$exp) = (num_args,(Raise v13 v14 :closLang$exp))) ∧ (∀(v17 :closLang$exp) (v16 :closLang$exp) (v15 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Handle v15 v16 v17 :closLang$exp) = (num_args,(Handle v15 v16 v17 :closLang$exp))) ∧ (∀(v19 :closLang$exp) (v18 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Tick v18 v19) = (num_args,Tick v18 v19)) ∧ (∀(v23 :closLang$exp list) (v22 :num) (v21 :num) (v20 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Call v20 v21 v22 v23) = (num_args,Call v20 v21 v22 v23)) ∧ (∀(v27 :closLang$exp list) (v26 :closLang$exp) (v25 :num option) (v24 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (App v24 v25 v26 v27 :closLang$exp) = (num_args,(App v24 v25 v26 v27 :closLang$exp))) ∧ (∀(v80 :num list) (v32 :closLang$exp) (v31 :num) (v28 :mlstring) (num_args :num) (max_app :num). collect_args max_app num_args (Fn v28 (NONE :num option) (SOME v80) v31 v32) = (num_args,Fn v28 (NONE :num option) (SOME v80) v31 v32)) ∧ (∀(v78 :num) (v32 :closLang$exp) (v31 :num) (v30 :num list option) (v28 :mlstring) (num_args :num) (max_app :num). collect_args max_app num_args (Fn v28 (SOME v78) v30 v31 v32) = (num_args,Fn v28 (SOME v78) v30 v31 v32)) ∧ (∀(v37 :closLang$exp) (v36 :(num # closLang$exp) list) (v35 :num list option) (v34 :num option) (v33 :mlstring list) (num_args :num) (max_app :num). collect_args max_app num_args (Letrec v33 v34 v35 v36 v37 :closLang$exp) = (num_args,(Letrec v33 v34 v35 v36 v37 :closLang$exp))) ∧ ∀(v40 :closLang$exp list) (v39 :closLang$op) (v38 :tra) (num_args :num) (max_app :num). collect_args max_app num_args (Op v38 v39 v40) = (num_args,Op v38 v39 v40)
collect_args_imp_typed=∀(max_app :num) (k :num) (e1 :closLang$exp) (num_args :num) (e2 :closLang$exp). collect_args max_app k e1 = (num_args,e2) ∧ k ≤ max_app ⇒ k ≤ num_args ∧ num_args ≤ max_app
collect_args_ok_imp_typed=∀(max_app :num) (k :num) (e :closLang$exp) (num_args :num) (e2 :closLang$exp). collect_args max_app k e = (num_args,e2) ∧ no_mti e ⇒ ∃(ts :mlstring list). e = mk_Fns ts e2 ∧ num_args = k + LENGTH ts ∧ no_mti e2
