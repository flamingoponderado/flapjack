install_union_old=lookup 0 (union ⦕ 0 ↦ 7 ⦖ ⦕ 0 ↦ 9 ⦖) = SOME 7 ⇔ T
install_union_new=lookup 2 (union (fromAList [(0,7)]) (fromAList [(2,9)])) = SOME 9 ⇔ T
