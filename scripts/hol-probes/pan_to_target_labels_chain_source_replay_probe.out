pan_to_stack_first_ALL_DISTINCT_replay_statement=pan_to_word_compile_prog mc.target.config.ISA pan_code = wprog0 ∧ word_to_word_compile c.word_to_word_conf mc.target.config wprog0 = (col,wprog) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = (bitmaps,c'',fs,p) ∧ ALL_DISTINCT (MAP FST (functions pan_code)) ⇒ ALL_DISTINCT (MAP FST p)
pan_to_stack_first_ALL_DISTINCT_replay_typed=pan_to_word_compile_prog (mc :(α, β, γ) machine_config).target.config.ISA (pan_code :α decl list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ word_to_word_compile (c :config).word_to_word_conf mc.target.config wprog0 = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = ((bitmaps :α word list),(c'' :word_to_stack$config),(fs :num list),(p :(num # α prog) list)) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ⇒ ALL_DISTINCT (MAP (FST :num # α prog -> num) p)
pan_to_stack_compile_lab_pres_replay_statement=pan_to_word_compile_prog mc.target.config.ISA pan_code = wprog0 ∧ word_to_word_compile c.word_to_word_conf mc.target.config wprog0 = (col,wprog) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = (bitmaps,c'',fs,p) ∧ ALL_DISTINCT (MAP FST (functions pan_code)) ⇒ ALL_DISTINCT (MAP FST p) ∧ EVERY (λn. n ≠ 0 ∧ n ≠ 1 ∧ n ≠ 2 ∧ n ≠ gc_stub_location) (MAP FST p) ∧ EVERY (λ(n,p). (let labs = extract_labels p in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) labs ∧ ALL_DISTINCT labs)) p
pan_to_stack_compile_lab_pres_replay_typed=pan_to_word_compile_prog (mc :(α, β, γ) machine_config).target.config.ISA (pan_code :α decl list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ word_to_word_compile (c :config).word_to_word_conf mc.target.config wprog0 = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = ((bitmaps :α word list),(c'' :word_to_stack$config),(fs :num list),(p :(num # α prog) list)) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ⇒ ALL_DISTINCT (MAP (FST :num # α prog -> num) p) ∧ EVERY (λ(n :num). n ≠ (0 :num) ∧ n ≠ (1 :num) ∧ n ≠ (2 :num) ∧ n ≠ gc_stub_location) (MAP (FST :num # α prog -> num) p) ∧ EVERY (λ((n :num),(p :α prog)). (let (labs :(num # num) list) = extract_labels p in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) labs ∧ ALL_DISTINCT labs)) p
pan_to_lab_labels_ok_replay_statement=pan_to_word_compile_prog mc.target.config.ISA pan_code = wprog0 ∧ word_to_word_compile c.word_to_word_conf mc.target.config wprog0 = (col,wprog) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = (bitmaps,c'',fs,p) ∧ stack_to_lab_compile c.stack_conf c.data_conf max_heap sp mc.target.config.addr_offset p = lprog ∧ ALL_DISTINCT (MAP FST (functions pan_code)) ⇒ labels_ok lprog
pan_to_lab_labels_ok_replay_typed=pan_to_word_compile_prog (mc :(α, β, γ) machine_config).target.config.ISA (pan_code :α decl list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ word_to_word_compile (c :config).word_to_word_conf mc.target.config wprog0 = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = ((bitmaps :α word list),(c'' :word_to_stack$config),(fs :num list),(p :(num # α prog) list)) ∧ stack_to_lab_compile c.stack_conf c.data_conf (max_heap :num) (sp :num) mc.target.config.addr_offset p = (lprog :α sec list) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ⇒ labels_ok lprog
word_to_stack_good_code_lemma_replay_statement=word_to_word_compile c.word_to_word_conf mc.target.config (pan_to_word_compile_prog mc.target.config.ISA pan_code) = (col,wprog) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = (bitmaps,c'',fs,p) ∧ LENGTH mc.target.config.avoid_regs + 13 ≤ mc.target.config.reg_count ∧ ALL_DISTINCT (MAP FST (functions pan_code)) ⇒ good_code (mc.target.config.reg_count − (LENGTH mc.target.config.avoid_regs + 3)) p
word_to_stack_good_code_lemma_replay_typed=word_to_word_compile (c :config).word_to_word_conf (mc :(α, β, γ) machine_config).target.config (pan_to_word_compile_prog mc.target.config.ISA (pan_code :α decl list)) = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ mc.target.config.ISA ≠ Ag32 ∧ word_to_stack_compile mc.target.config F wprog = ((bitmaps :α word list),(c'' :word_to_stack$config),(fs :num list),(p :(num # α prog) list)) ∧ LENGTH mc.target.config.avoid_regs + (13 :num) ≤ mc.target.config.reg_count ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ⇒ (good_code (mc.target.config.reg_count − (LENGTH mc.target.config.avoid_regs + (3 :num))) p :bool)
from_pan_to_lab_no_install_replay_statement=ALL_DISTINCT (MAP FST (functions pan_code)) ∧ ac.ISA ≠ Ag32 ∧ pan_to_word_compile_prog isa pan_code = wprog0 ∧ word_to_word_compile wc ac wprog0 = (col,wprog) ∧ word_to_stack_compile ac F wprog = (bm,c,fs,p) ⇒ no_install (stack_to_lab_compile scc dc lim regc off p)
from_pan_to_lab_no_install_replay_typed=ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (pan_code :α decl list))) ∧ (ac :α asm_config).ISA ≠ Ag32 ∧ pan_to_word_compile_prog (isa :architecture) pan_code = (wprog0 :(num # num # α wordLang$prog) list) ∧ word_to_word_compile (wc :word_to_word$config) ac wprog0 = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ word_to_stack_compile ac F wprog = ((bm :α word list),(c :word_to_stack$config),(fs :num list),(p :(num # α prog) list)) ⇒ no_install (stack_to_lab_compile (scc :stack_to_lab$config) (dc :data_to_word$config) (lim :num) (regc :num) (off :α word # α word) p)
