var_list_code_labels_imp_typed=∀(n :num) (x :bvl$exp list) (y :α list). var_list n x y ⇒ BIGUNION (set (MAP get_code_labels x)) = (∅ :num -> bool)
let_op_code_labels_typed=∀(x :bvl$exp list). BIGUNION (set (MAP get_code_labels (let_op x))) = BIGUNION (set (MAP get_code_labels x))
let_op_sing_code_labels_typed=get_code_labels (let_op_sing (x :bvl$exp)) = get_code_labels x
remove_ticks_code_labels_typed=∀(x :bvl$exp list). BIGUNION (set (MAP get_code_labels (remove_ticks x))) = BIGUNION (set (MAP get_code_labels x))
optimise_get_code_labels_typed=∀(x :bool) (y :num) (z :α # num # bvl$exp). get_code_labels (SND (SND (optimise x y z))) ⊆ get_code_labels (SND (SND z))
tick_inline_code_labels_typed=∀(cs :(α # bvl$exp) sptree$num_map) (xs :bvl$exp list). BIGUNION (set (MAP get_code_labels (tick_inline cs xs))) ⊆ BIGUNION (set (MAP get_code_labels xs)) ∪ BIGUNION (set (MAP (get_code_labels ∘ (SND :α # bvl$exp -> bvl$exp)) (toList cs :(α # bvl$exp) list)))
tick_inline_all_code_labels_typed=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (xs :(num # num # bvl$exp) list) (aux :(num # num # bvl$exp) list) (cs1 :(num # bvl$exp) sptree$num_map) (xs1 :(num # num # bvl$exp) list). tick_inline_all limit cs xs aux = (cs1,xs1) ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) xs1)) ⊆ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) xs)) ∪ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) aux)) ∪ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp)) (toList cs :(num # bvl$exp) list)))
compile_prog_get_code_labels_typed=(compile_prog (x :num) (y :bool) (z :num) (p :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((inlines :(num # bvl$exp) sptree$num_map),(q :(num # num # bvl$exp) list)) ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) q)) ⊆ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) p))
MAP_FST_MAP_optimise_typed=MAP (FST :α # num # bvl$exp -> α) (MAP (optimise (x :bool) (y :num) :α # num # bvl$exp -> α # num # bvl$exp) (z :(α # num # bvl$exp) list)) = MAP (FST :α # num # bvl$exp -> α) z
compile_prog_names_typed=(compile_prog (l :num) (b :bool) (i :num) (prog :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((inlines :(num # bvl$exp) sptree$num_map),(prog3 :(num # num # bvl$exp) list)) ⇒ MAP (FST :num # num # bvl$exp -> num) prog3 = MAP (FST :num # num # bvl$exp -> num) prog
handle_ok_optimise_typed=∀(prog :(α # num # bvl$exp) list). handle_ok (MAP ((SND :num # bvl$exp -> bvl$exp) ∘ (SND :α # num # bvl$exp -> num # bvl$exp) ∘ (optimise (b :bool) (i :num) :α # num # bvl$exp -> α # num # bvl$exp)) prog)
compile_prog_handle_ok_typed=(compile_prog (l :num) (b :bool) (i :num) (prog :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((inlines :(num # bvl$exp) sptree$num_map),(prog3 :(num # num # bvl$exp) list)) ⇒ handle_ok (MAP ((SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) prog3)
map_fromAList_typed=∀(xs :(num # α) list) (f :α -> β). map f (fromAList xs) = fromAList (MAP ((I :num -> num) ## f) xs)
state_cc_compile_inc_eq_typed=state_cc (compile_inc (limit :num) (o1 :bool) (o2 :num) :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) (cc :α -> (num # num # bvl$exp) list -> (β # γ # δ) option) = in_cc limit (remove_ticks_cc (let_op_cc o1 o2 cc))
state_co_compile_inc_eq_typed=state_co (compile_inc (limit :num) (o1 :bool) (o2 :num) :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) (co :α -> ((num # bvl$exp) sptree$num_map # β) # (num # num # bvl$exp) list) = ((I :β -> β) ## MAP ((I :num -> num) ## let_opt o1 o2)) ∘ (remove_ticks_co :β # (num # num # bvl$exp) list -> β # (num # num # bvl$exp) list) ∘ in_co limit co
compile_prog_semantics_typed=(compile_prog (limit :num) (o1 :bool) (o2 :num) (prog :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((s1 :(num # bvl$exp) sptree$num_map),(prog1 :(num # num # bvl$exp) list)) ∧ FST (FST ((co :num -> ((num # bvl$exp) sptree$num_map # α) # (num # num # bvl$exp) list) (0 :num))) = s1 ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) prog) ⇒ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc (compile_inc limit o1 o2 :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) (cc :α -> (num # num # bvl$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog1) (state_co (compile_inc limit o1 o2 :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) co) cc start :behaviour) = (semantics ffi (fromAList prog) co (state_cc (compile_inc limit o1 o2 :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) cc) start :behaviour)
let_op_cc_def_typed=∀(q4 :bool) (l4 :num) (cc :α -> (β # num # bvl$exp) list -> γ). let_op_cc q4 l4 cc = (λ(cfg :α) (prog :(β # num # bvl$exp) list). cc cfg (MAP ((I :β -> β) ## let_opt q4 l4) prog))
let_opt_def_typed=∀(split_seq :bool) (cut_size :num) (arity :num) (prog :bvl$exp). let_opt split_seq cut_size (arity,prog) = (arity,compile_any split_seq cut_size arity (let_op_sing prog))
let_opt_remove_def_typed=∀(b :bool) (l :num) (arity :num) (prog :bvl$exp). let_opt_remove b l (arity,prog) = let_opt b l (arity,HD (remove_ticks [prog]))
let_state_rel_def_typed=∀(split_seq :bool) (cut_size :num) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). let_state_rel split_seq cut_size s t ⇔ t = s with <|code := map (let_opt split_seq cut_size) s.code; compile := t.compile; compile_oracle := ((I :γ -> γ) ## MAP ((I :num -> num) ## let_opt split_seq cut_size)) ∘ s.compile_oracle|> ∧ s.compile = (λ(cfg :γ) (prog :(num # num # bvl$exp) list). t.compile cfg (MAP ((I :num -> num) ## let_opt split_seq cut_size) prog))
evaluate_let_op_typed=∀(es :bvl$exp list) (env :v list) (s1 :(α, β) state) (res :(v list, v) result) (t1 :(α, β) state) (s2 :(α, β) state). let_state_rel (q4 :bool) (l4 :num) s1 t1 ∧ evaluate (es,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(t2 :(α, β) state). evaluate (let_op es,env,t1) = (res,t2) ∧ let_state_rel q4 l4 s2 t2
let_evaluate_Call_replay_typed=evaluate ([(Call (0 :num) (SOME (start :num)) ([] :bvl$exp list) :bvl$exp)],([] :v list),(initial_state (ffi0 :'ffi ffi_state) (prog :(num # bvl$exp) sptree$num_map) (co :num -> γ # (num # num # bvl$exp) list) (let_op_cc (q4 :bool) (l4 :num) (cc :γ -> (num # num # bvl$exp) list -> (word8 list # word64 list # γ) option)) (k :num) :(γ, 'ffi) state)) = ((r :(v list, v) result),(s :(γ, 'ffi) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(s2 :(γ, 'ffi) state). evaluate ([(Call (0 :num) (SOME start) ([] :bvl$exp list) :bvl$exp)],([] :v list),(initial_state ffi0 (map (let_opt q4 l4) prog) (((I :γ -> γ) ## MAP ((I :num -> num) ## let_opt q4 l4)) ∘ co) cc k :(γ, 'ffi) state)) = (r,s2) ∧ s2.ffi = s.ffi ∧ s.clock = s2.clock
let_do_app_lemma_replay_typed=let_state_rel (q4 :bool) (l4 :num) (s1 :(α, β) state) (t1 :(α, β) state) ⇒ case (do_app (op :closLang$op) (a :v list) s1 :(v # (α, β) state, v) result) of (Rval (v,s2) :(v # (α, β) state, v) result) => ∃(t2 :(α, β) state). let_state_rel q4 l4 s2 t2 ∧ (do_app op a t1 :(v # (α, β) state, v) result) = (Rval (v,t2) :(v # (α, β) state, v) result) | (Rerr err :(v # (α, β) state, v) result) => (do_app op a t1 :(v # (α, β) state, v) result) = (Rerr err :(v # (α, β) state, v) result)
