var_list_code_labels_imp_typed=∀(n :num) (x :bvl$exp list) (y :α list). var_list n x y ⇒ BIGUNION (set (MAP get_code_labels x)) = (∅ :num -> bool)
let_op_code_labels_typed=∀(x :bvl$exp list). BIGUNION (set (MAP get_code_labels (let_op x))) = BIGUNION (set (MAP get_code_labels x))
let_op_sing_code_labels_typed=get_code_labels (let_op_sing (x :bvl$exp)) = get_code_labels x
remove_ticks_code_labels_typed=∀(x :bvl$exp list). BIGUNION (set (MAP get_code_labels (remove_ticks x))) = BIGUNION (set (MAP get_code_labels x))
optimise_get_code_labels_typed=∀(x :bool) (y :num) (z :α # num # bvl$exp). get_code_labels (SND (SND (optimise x y z))) ⊆ get_code_labels (SND (SND z))
tick_inline_code_labels_typed=∀(cs :(α # bvl$exp) sptree$num_map) (xs :bvl$exp list). BIGUNION (set (MAP get_code_labels (tick_inline cs xs))) ⊆ BIGUNION (set (MAP get_code_labels xs)) ∪ BIGUNION (set (MAP (get_code_labels ∘ (SND :α # bvl$exp -> bvl$exp)) (toList cs :(α # bvl$exp) list)))
tick_inline_all_code_labels_typed=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (xs :(num # num # bvl$exp) list) (aux :(num # num # bvl$exp) list) (cs1 :(num # bvl$exp) sptree$num_map) (xs1 :(num # num # bvl$exp) list). tick_inline_all limit cs xs aux = (cs1,xs1) ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) xs1)) ⊆ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) xs)) ∪ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) aux)) ∪ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp)) (toList cs :(num # bvl$exp) list)))
compile_prog_get_code_labels_typed=(compile_prog (x :num) (y :bool) (z :num) (p :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((inlines :(num # bvl$exp) sptree$num_map),(q :(num # num # bvl$exp) list)) ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) q)) ⊆ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) p))
MAP_FST_MAP_optimise_typed=MAP (FST :α # num # bvl$exp -> α) (MAP (optimise (x :bool) (y :num) :α # num # bvl$exp -> α # num # bvl$exp) (z :(α # num # bvl$exp) list)) = MAP (FST :α # num # bvl$exp -> α) z
compile_prog_names_typed=(compile_prog (l :num) (b :bool) (i :num) (prog :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((inlines :(num # bvl$exp) sptree$num_map),(prog3 :(num # num # bvl$exp) list)) ⇒ MAP (FST :num # num # bvl$exp -> num) prog3 = MAP (FST :num # num # bvl$exp -> num) prog
handle_ok_optimise_typed=∀(prog :(α # num # bvl$exp) list). handle_ok (MAP ((SND :num # bvl$exp -> bvl$exp) ∘ (SND :α # num # bvl$exp -> num # bvl$exp) ∘ (optimise (b :bool) (i :num) :α # num # bvl$exp -> α # num # bvl$exp)) prog)
compile_prog_handle_ok_typed=(compile_prog (l :num) (b :bool) (i :num) (prog :(num # num # bvl$exp) list) :(num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) = ((inlines :(num # bvl$exp) sptree$num_map),(prog3 :(num # num # bvl$exp) list)) ⇒ handle_ok (MAP ((SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) prog3)
