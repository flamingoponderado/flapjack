copy_state_typed=recordtype.copy_state::num sptree$num_map -> num sptree$num_map -> (store_name # num) list -> num -> copy_state
copy_prop_def_typed=∀(e :α prog). copy_prop e = FST (copy_prop_prog e empty_eq)
copy_prop_inst_def_typed=copy_prop_inst (Skip :α inst) (cs :copy_state) = ((Skip :α prog),cs) ∧ copy_prop_inst (Const (reg :num) (w :α word) :α inst) cs = ((Inst (Const reg w :α inst) :α prog),remove_eq cs reg) ∧ copy_prop_inst (Arith (Binop (bop :binop) (r1 :num) (r2 :num) (ri :α reg_imm)) :α inst) cs = (let (cs' :copy_state) = remove_eq cs r1; (r2' :num) = lookup_eq cs r2; (ri' :α reg_imm) = lookup_eq_imm cs ri; (ri'' :α reg_imm) = if ri' = (Reg r1 :α reg_imm) then ri else ri' in ((Inst (Arith (Binop bop r1 r2' ri'') :α inst) :α prog),cs')) ∧ copy_prop_inst (Arith (Shift (shift :ast$shift) r1 r2 (n :α reg_imm) :α arith) :α inst) cs = (let (cs' :copy_state) = remove_eq cs r1; (r2' :num) = lookup_eq cs r2; (n' :α reg_imm) = lookup_eq_imm cs n; (n'' :α reg_imm) = if n' = (Reg r1 :α reg_imm) then n else n' in ((Inst (Arith (Shift shift r1 r2' n'' :α arith) :α inst) :α prog),cs')) ∧ copy_prop_inst (Arith (Div r1 r2 (r3 :num) :α arith) :α inst) cs = (let (r2' :num) = lookup_eq cs r2; (r3' :num) = lookup_eq cs r3 in ((Inst (Arith (Div r1 r2' r3' :α arith) :α inst) :α prog),remove_eq cs r1)) ∧ copy_prop_inst (Arith (AddCarry r1 r2 r3 (r4 :num) :α arith) :α inst) cs = (let (cs' :copy_state) = remove_eqs cs [r1; r4]; (r2' :num) = lookup_eq cs r2; (r3'' :num) = lookup_eq cs r3; (r3'' :num) = if r3'' = r1 then r3 else r3'' in ((Inst (Arith (AddCarry r1 r2' r3'' r4 :α arith) :α inst) :α prog),cs')) ∧ copy_prop_inst (Arith (AddOverflow r1 r2 r3 r4 :α arith) :α inst) cs = (let (cs' :copy_state) = remove_eqs cs [r1; r4]; (r2' :num) = lookup_eq cs r2; (r3' :num) = lookup_eq cs r3; (r3'' :num) = if r3' = r1 then r3 else r3' in ((Inst (Arith (AddOverflow r1 r2' r3'' r4 :α arith) :α inst) :α prog),cs')) ∧ copy_prop_inst (Arith (SubOverflow r1 r2 r3 r4 :α arith) :α inst) cs = (let (cs' :copy_state) = remove_eqs cs [r1; r4]; (r2' :num) = lookup_eq cs r2; (r3' :num) = lookup_eq cs r3; (r3'' :num) = if r3' = r1 then r3 else r3' in ((Inst (Arith (SubOverflow r1 r2' r3'' r4 :α arith) :α inst) :α prog),cs')) ∧ copy_prop_inst (Arith (LongMul r1 r2 r3 r4 :α arith) :α inst) cs = (let (r3' :num) = lookup_eq cs r3; (r4' :num) = lookup_eq cs r4 in ((Inst (Arith (LongMul r1 r2 r3 r4 :α arith) :α inst) :α prog),remove_eqs cs [r1; r2])) ∧ copy_prop_inst (Arith (LongDiv r1 r2 r3 r4 (r5 :num) :α arith) :α inst) cs = (let (r3' :num) = lookup_eq cs r3; (r4' :num) = lookup_eq cs r4; (r5' :num) = lookup_eq cs r5 in ((Inst (Arith (LongDiv r1 r2 r3' r4' r5' :α arith) :α inst) :α prog),remove_eqs cs [r2; r1])) ∧ copy_prop_inst (Mem Load (r :num) (Addr (a :num) w)) cs = (let (a' :num) = lookup_eq cs a in ((Inst (Mem Load r (Addr a' w)) :α prog),remove_eq cs r)) ∧ copy_prop_inst (Mem Store r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a; (r' :num) = lookup_eq cs r in ((Inst (Mem Store r' (Addr a' w)) :α prog),cs)) ∧ copy_prop_inst (Mem Load8 r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a in ((Inst (Mem Load8 r (Addr a' w)) :α prog),remove_eq cs r)) ∧ copy_prop_inst (Mem Store8 r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a; (r' :num) = lookup_eq cs r in ((Inst (Mem Store8 r' (Addr a' w)) :α prog),cs)) ∧ copy_prop_inst (Mem Load16 r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a in ((Inst (Mem Load16 r (Addr a' w)) :α prog),remove_eq cs r)) ∧ copy_prop_inst (Mem Store16 r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a; (r' :num) = lookup_eq cs r in ((Inst (Mem Store16 r' (Addr a' w)) :α prog),cs)) ∧ copy_prop_inst (Mem Load32 r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a in ((Inst (Mem Load32 r (Addr a' w)) :α prog),remove_eq cs r)) ∧ copy_prop_inst (Mem Store32 r (Addr a w)) cs = (let (a' :num) = lookup_eq cs a; (r' :num) = lookup_eq cs r in ((Inst (Mem Store32 r' (Addr a' w)) :α prog),cs)) ∧ copy_prop_inst (FP (FPLess r (f1 :num) (f2 :num)) :α inst) cs = ((Inst (FP (FPLess r f1 f2) :α inst) :α prog),remove_eq cs r) ∧ copy_prop_inst (FP (FPLessEqual r f1 f2) :α inst) cs = ((Inst (FP (FPLessEqual r f1 f2) :α inst) :α prog),remove_eq cs r) ∧ copy_prop_inst (FP (FPEqual r f1 f2) :α inst) cs = ((Inst (FP (FPEqual r f1 f2) :α inst) :α prog),remove_eq cs r) ∧ copy_prop_inst (FP (FPMovToReg r1 r2 (d :num)) :α inst) cs = ((Inst (FP (FPMovToReg r1 r2 d) :α inst) :α prog),remove_eqs cs [r1; r2]) ∧ copy_prop_inst (FP (FPMovFromReg d r1 r2) :α inst) cs = (let (r1' :num) = lookup_eq cs r1; (r2' :num) = lookup_eq cs r2; ((r1'' :num),(r2'' :num)) = if r1' = r2' then (r1,r2) else (r1',r2') in ((Inst (FP (FPMovFromReg d r1'' r2'') :α inst) :α prog),cs)) ∧ copy_prop_inst (FP (FPAbs (v93 :num) (v94 :num)) :α inst) cs = ((Inst (FP (FPAbs v93 v94) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPNeg (v95 :num) (v96 :num)) :α inst) cs = ((Inst (FP (FPNeg v95 v96) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPSqrt (v97 :num) (v98 :num)) :α inst) cs = ((Inst (FP (FPSqrt v97 v98) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPAdd (v99 :num) (v100 :num) (v101 :num)) :α inst) cs = ((Inst (FP (FPAdd v99 v100 v101) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPSub (v102 :num) (v103 :num) (v104 :num)) :α inst) cs = ((Inst (FP (FPSub v102 v103 v104) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPMul (v105 :num) (v106 :num) (v107 :num)) :α inst) cs = ((Inst (FP (FPMul v105 v106 v107) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPDiv (v108 :num) (v109 :num) (v110 :num)) :α inst) cs = ((Inst (FP (FPDiv v108 v109 v110) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPFma (v111 :num) (v112 :num) (v113 :num)) :α inst) cs = ((Inst (FP (FPFma v111 v112 v113) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPMov (v114 :num) (v115 :num)) :α inst) cs = ((Inst (FP (FPMov v114 v115) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPToInt (v122 :num) (v123 :num)) :α inst) cs = ((Inst (FP (FPToInt v122 v123) :α inst) :α prog),cs) ∧ copy_prop_inst (FP (FPFromInt (v124 :num) (v125 :num)) :α inst) cs = ((Inst (FP (FPFromInt v124 v125) :α inst) :α prog),cs)
copy_prop_move_def_typed=(∀(cs :copy_state). copy_prop_move ([] :(num # num) list) cs = (([] :(num # num) list),cs)) ∧ ∀(y :num) (xs :(num # num) list) (x :num) (cs :copy_state). copy_prop_move ((x,y)::xs) cs = (let (y' :num) = lookup_eq cs y; ((ms :(num # num) list),(cs' :copy_state)) = copy_prop_move xs cs; (cs'' :copy_state) = set_eq (remove_eq cs' x) x y in ((x,y')::ms,cs''))
copy_prop_prog_def_typed=(∀(cs :copy_state). copy_prop_prog (Skip :α prog) cs = ((Skip :α prog),cs)) ∧ (∀(xs :(num # num) list) (pri :num) (cs :copy_state). copy_prop_prog (Move pri xs :α prog) cs = (let (tt :num list) = MAP (FST :num # num -> num) xs; (ss :num list) = MAP (SND :num # num -> num) xs in if EVERY (λ(t :num). ¬MEM t ss) tt then (let ((xs' :(num # num) list),(cs' :copy_state)) = copy_prop_move xs cs in ((Move pri xs' :α prog),cs')) else ((Move pri xs :α prog),empty_eq))) ∧ (∀(i :α inst) (cs :copy_state). copy_prop_prog (Inst i :α prog) cs = copy_prop_inst i cs) ∧ (∀(v2 :num list) (v1 :num) (cs :copy_state). copy_prop_prog (Return v1 v2 :α prog) cs = (let (v1' :num) = lookup_eq cs v1; (v2' :num list) = MAP (lookup_eq cs) v2 in ((Return v1' v2' :α prog),cs))) ∧ (∀(v :num) (cs :copy_state). copy_prop_prog (Raise v :α prog) cs = (let (v' :num) = lookup_eq cs v in ((Raise v' :α prog),cs))) ∧ (∀(src :num) (dst :num) (cs :copy_state) (b :binop). copy_prop_prog (OpCurrHeap b dst src :α prog) cs = (let (src' :num) = lookup_eq cs src; (src'' :num) = if src' = dst then src else src' in ((OpCurrHeap b dst src'' :α prog),remove_eq cs dst))) ∧ (∀(cs :copy_state). copy_prop_prog (Tick :α prog) cs = ((Tick :α prog),cs)) ∧ (∀(p1 :α prog) (cs :copy_state). copy_prop_prog (MustTerminate p1) cs = (let ((p1' :α prog),(cs' :copy_state)) = copy_prop_prog p1 cs in (MustTerminate p1',cs'))) ∧ (∀(p2 :α prog) (p1 :α prog) (cs :copy_state). copy_prop_prog (Seq p1 p2) cs = (let ((q1 :α prog),(cs' :copy_state)) = copy_prop_prog p1 cs; ((q2 :α prog),(cs'' :copy_state)) = copy_prop_prog p2 cs' in (Seq q1 q2,cs''))) ∧ (∀(ri :α reg_imm) (r :num) (p2 :α prog) (p1 :α prog) (cs :copy_state) (cmp :cmp). copy_prop_prog (If cmp r ri p1 p2 :α prog) cs = (let (r' :num) = lookup_eq cs r; (ri' :α reg_imm) = lookup_eq_imm cs ri; ((q1 :α prog),(cs' :copy_state)) = copy_prop_prog p1 cs; ((q2 :α prog),(cs'' :copy_state)) = copy_prop_prog p2 cs in ((If cmp r' ri' q1 q2 :α prog),merge_eqs cs' cs''))) ∧ (∀(name :store_name) (exp :α exp) (cs :copy_state). copy_prop_prog (Set name exp :α prog) cs = case exp of (Const v9 :α exp) => ((Set name exp :α prog),empty_eq) | (Var n :α exp) => (let (n' :num) = lookup_eq cs n in ((Set name (Var n' :α exp) :α prog),set_store_eq cs name n)) | (Lookup v11 :α exp) => ((Set name exp :α prog),empty_eq) | (Load v12 :α exp) => ((Set name exp :α prog),empty_eq) | Op v13 v14 => ((Set name exp :α prog),empty_eq) | (Shift v15 v16 v17 :α exp) => ((Set name exp :α prog),empty_eq)) ∧ (∀(name :store_name) (n :num) (cs :copy_state). copy_prop_prog (Get n name :α prog) cs = case lookup_store_eq cs name of (NONE :num option) => ((Get n name :α prog),set_store_eq (remove_eq cs n) name n) | SOME v => if v ≠ n then (let ((xs' :(num # num) list),(cs' :copy_state)) = copy_prop_move [(n,v)] cs in ((Move (0 :num) xs' :α prog),cs')) else ((Skip :α prog),cs)) ∧ (∀(ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (handler :(num # α prog # num # num) option) (dest :num option) (cs :copy_state) (args :num list). copy_prop_prog (Call ret dest args handler :α prog) cs = ((Call ret dest args handler :α prog),empty_eq)) ∧ (∀(r :num) (live :sptree$num_set # sptree$num_set) (cs :copy_state). copy_prop_prog (Alloc r live :α prog) cs = ((Alloc r live :α prog),empty_eq)) ∧ (∀(ws :(bool # α word) list) (d :num) (cs :copy_state) (c :num) (b :num) (a :num). copy_prop_prog (StoreConsts a b c d ws :α prog) cs = ((StoreConsts a b c d ws :α prog),remove_eqs cs [a; b; c; d])) ∧ (∀(r :num) (l1 :num) (cs :copy_state). copy_prop_prog (LocValue r l1 :α prog) cs = ((LocValue r l1 :α prog),remove_eq cs r)) ∧ (∀(r4 :num) (r3 :num) (r2 :num) (r1 :num) (live :sptree$num_set # sptree$num_set) (cs :copy_state). copy_prop_prog (Install r1 r2 r3 r4 live :α prog) cs = ((Install r1 r2 r3 r4 live :α prog),empty_eq)) ∧ (∀(r2 :num) (r1 :num) (cs :copy_state). copy_prop_prog (CodeBufferWrite r1 r2 :α prog) cs = (let (r1' :num) = lookup_eq cs r1; (r2' :num) = lookup_eq cs r2 in ((CodeBufferWrite r1' r2' :α prog),cs))) ∧ (∀(r2 :num) (r1 :num) (cs :copy_state). copy_prop_prog (DataBufferWrite r1 r2 :α prog) cs = (let (r1' :num) = lookup_eq cs r1; (r2' :num) = lookup_eq cs r2 in ((DataBufferWrite r1' r2' :α prog),cs))) ∧ (∀(r4 :num) (r3 :num) (r2 :num) (r1 :num) (live :sptree$num_set # sptree$num_set) (i :mlstring) (cs :copy_state). copy_prop_prog (FFI i r1 r2 r3 r4 live :α prog) cs = ((FFI i r1 r2 r3 r4 live :α prog),empty_eq)) ∧ (∀(v :num) (op :memop) (exp :α exp) (cs :copy_state). copy_prop_prog (ShareInst op v exp) cs = (let (exp' :α exp) = copy_prop_share exp cs in (ShareInst op v exp',remove_eq cs v))) ∧ (∀(names :sptree$num_set) (exit_names :sptree$num_set) (cs :copy_state) (c :α prog). copy_prop_prog (Loop names c exit_names :α prog) cs = (let ((c' :α prog),(_0 :copy_state)) = copy_prop_prog c empty_eq in ((Loop names c' exit_names :α prog),empty_eq))) ∧ (∀(k :num) (cs :copy_state). copy_prop_prog (Break k :α prog) cs = ((Break k :α prog),cs)) ∧ (∀(k :num) (cs :copy_state). copy_prop_prog (Continue k :α prog) cs = ((Continue k :α prog),cs)) ∧ (∀(v8 :num) (v10 :α exp) (cs :copy_state). copy_prop_prog (Assign v8 v10) cs = (Assign v8 v10,empty_eq)) ∧ ∀(v23 :num) (v22 :α exp) (cs :copy_state). copy_prop_prog (Store v22 v23 :α prog) cs = ((Store v22 v23 :α prog),empty_eq)
copy_prop_share_def_typed=∀(exp :α exp) (cs :copy_state). copy_prop_share exp cs = case exp of (Const v9 :α exp) => exp | (Var r :α exp) => (Var (lookup_eq cs r) :α exp) | (Lookup v11 :α exp) => exp | (Load v12 :α exp) => exp | Op Add ([] :α exp list) => exp | Op Add ((Const v31 :α exp)::v21) => exp | Op Add [(Var r' :α exp)] => exp | Op Add [(Var r' :α exp); (Const c :α exp)] => Op Add [(Var (lookup_eq cs r') :α exp); (Const c :α exp)] | Op Add ((Var r' :α exp)::(Const c :α exp)::v64::v65) => exp | Op Add ((Var r' :α exp)::(Var v54 :α exp)::v43) => exp | Op Add ((Var r' :α exp)::(Lookup v55 :α exp)::v43) => exp | Op Add ((Var r' :α exp)::(Load v56 :α exp)::v43) => exp | Op Add ((Var r' :α exp)::Op v57 v58::v43) => exp | Op Add ((Var r' :α exp)::(Shift v59 v60 v61 :α exp)::v43) => exp | Op Add ((Lookup v33 :α exp)::v21) => exp | Op Add ((Load v34 :α exp)::v21) => exp | Op Add (Op v35 v36::v21) => exp | Op Add ((Shift v37 v38 v39 :α exp)::v21) => exp | Op Sub v14 => exp | Op And v14 => exp | Op Or v14 => exp | Op Xor v14 => exp | (Shift v15 v16 v17 :α exp) => exp
empty_eq_def_typed=empty_eq = <|to_eq := (LN :num sptree$num_map); from_eq := (LN :num sptree$num_map); store_to_eq := ([] :(store_name # num) list); next := (0 :num)|>
lookup_eq_def_typed=∀(cs :copy_state) (v :num). lookup_eq cs v = case lookup v cs.to_eq of (NONE :num option) => v | SOME c => case lookup c cs.from_eq of (NONE :num option) => v | SOME v' => v'
lookup_eq_imm_def_typed=∀(cs :copy_state) (vi :α reg_imm). lookup_eq_imm cs vi = case vi of (Reg v :α reg_imm) => (Reg (lookup_eq cs v) :α reg_imm) | Imm v4 => vi
lookup_store_eq_def_typed=∀(cs :copy_state) (s :store_name). lookup_store_eq cs s = case ALOOKUP cs.store_to_eq s of (NONE :num option) => (NONE :num option) | SOME c => case lookup c cs.from_eq of (NONE :num option) => (NONE :num option) | SOME v' => SOME v'
merge_eqs_def_typed=∀(cs :copy_state) (ds :copy_state). merge_eqs cs ds = <|to_eq := inter_eq cs.to_eq ds.to_eq; from_eq := inter_eq cs.from_eq ds.from_eq; store_to_eq := FILTER (λ((s :store_name),(c :num)). ALOOKUP cs.store_to_eq s = SOME c ∧ ALOOKUP ds.store_to_eq s = SOME c) cs.store_to_eq; next := MAX cs.next ds.next|>
remove_eq_def_typed=∀(cs :copy_state) (v :num). remove_eq cs v = case lookup v cs.to_eq of (NONE :num option) => cs | SOME c => empty_eq
remove_eqs_def_typed=(∀(cs :copy_state). remove_eqs cs ([] :num list) = cs) ∧ ∀(cs :copy_state) (v :num) (vs :num list). remove_eqs cs (v::vs) = remove_eqs (remove_eq cs v) vs
set_eq_def_typed=∀(cs :copy_state) (x :num) (y :num). set_eq cs x y = if is_alloc_var x ∧ is_alloc_var y then case case lookup y cs.to_eq of (NONE :num option) => (NONE :num option) | SOME c => if lookup c cs.from_eq = (NONE :num option) then (NONE :num option) else SOME c of (NONE :num option) => <|to_eq := insert x cs.next (insert y cs.next cs.to_eq); from_eq := insert cs.next x cs.from_eq; store_to_eq := cs.store_to_eq; next := cs.next + (1 :num)|> | SOME c => <|to_eq := insert x c cs.to_eq; from_eq := insert c x cs.from_eq; store_to_eq := cs.store_to_eq; next := cs.next|> else cs
set_store_eq_def_typed=∀(cs :copy_state) (s :store_name) (y :num). set_store_eq cs s y = if is_alloc_var y then case case lookup y cs.to_eq of (NONE :num option) => (NONE :num option) | SOME c => if lookup c cs.from_eq = (NONE :num option) then (NONE :num option) else SOME c of (NONE :num option) => <|to_eq := insert y cs.next cs.to_eq; from_eq := insert cs.next y cs.from_eq; store_to_eq := (s,cs.next)::cs.store_to_eq; next := cs.next + (1 :num)|> | SOME c => cs with store_to_eq := (s,c)::cs.store_to_eq else empty_eq
