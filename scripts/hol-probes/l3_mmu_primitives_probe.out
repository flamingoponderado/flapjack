scsr_full=⊢ SCSR s = s.c_SCSR s.procID
tlb_full=⊢ TLB s = s.c_tlb s.procID
tlb_write_full=⊢ write'TLB value s = s with c_tlb := s.c_tlb⦇s.procID ↦ value⦈
