supervisor0_definition=∀x. rec'sip x = sip (word_bit 1 x) (word_bit 5 x) ((0 >< 0) x @@ (4 >< 2) x @@ (63 >< 6) x)
supervisor1_definition=∀mip. lift_mip_sip mip = rec'sip 0w with <|SSIP := mip.SSIP; STIP := mip.STIP|>
supervisor2_definition=∀x. reg'sip x = case x of sip SSIP STIP sip'rst => (57 >< 0) sip'rst @@ v2w [STIP] @@ (60 >< 58) sip'rst @@ v2w [SSIP] @@ (61 >< 61) sip'rst
supervisor3_definition=∀x. rec'sie x = sie (word_bit 1 x) (word_bit 5 x) ((0 >< 0) x @@ (4 >< 2) x @@ (63 >< 6) x)
supervisor4_definition=∀mie. lift_mie_sie mie = rec'sie 0w with <|SSIE := mie.SSIE; STIE := mie.STIE|>
supervisor5_definition=∀x. reg'sie x = case x of sie SSIE STIE sie'rst => (57 >< 0) sie'rst @@ v2w [STIE] @@ (60 >< 58) sie'rst @@ v2w [SSIE] @@ (61 >< 61) sie'rst
supervisor6_definition=∀x. rec'sstatus x = sstatus ((13 >< 12) x) (word_bit 0 x) (word_bit 16 x) (word_bit 3 x) (word_bit 4 x) (word_bit 63 x) ((15 >< 14) x) ((2 >< 1) x @@ (11 >< 5) x @@ (62 >< 17) x)
supervisor7_definition=∀e. extStatus e = case e of 0w => Off | 1w => Initial | 2w => Clean | 3w => Dirty | v => ARB
supervisor8_definition=∀mst. lift_mstatus_sstatus mst = rec'sstatus 0w with <|SIE := mst.MIE; SPIE := mst.MIE1; SPS := (privilege mst.MPRV1 ≠ User); SSD := (extStatus mst.MXS = Dirty ∨ extStatus mst.MFS = Dirty); SFS := mst.MFS; SXS := mst.MXS; SMPRV := mst.MMPRV|>
supervisor9_definition=∀x. reg'sstatus x = case x of sstatus SFS SIE SMPRV SPIE SPS SSD SXS sstatus'rst => v2w [SSD] @@ (45 >< 0) sstatus'rst @@ v2w [SMPRV] @@ SXS @@ SFS @@ (52 >< 46) sstatus'rst @@ v2w [SPS] @@ v2w [SPIE] @@ (54 >< 53) sstatus'rst @@ v2w [SIE]
supervisor10_definition=∀vm. isValidVM vm ⇔ case vm of 0w => T | 1w => T | 2w => T | 8w => T | 9w => T | 10w => T | 11w => T | 12w => T | v => F
supervisor11_definition=∀orig v. update_mstatus (orig,v) = (let s0 = orig with <|MPRV3 := v.MPRV3; MIE3 := v.MIE3; MPRV2 := v.MPRV2; MIE2 := v.MIE2; MPRV1 := v.MPRV1; MIE1 := v.MIE1; MPRV := v.MPRV; MIE := v.MIE|> in (if isValidVM v.VM then s0 with VM := v.VM else s0) with <|MSD := (extStatus v.MXS = Dirty ∨ extStatus v.MFS = Dirty); MXS := v.MXS; MFS := v.MFS; MMPRV := v.MMPRV|>)
supervisor12_definition=∀sip mip. lower_sip_mip (sip,mip) = mip with <|SSIP := sip.SSIP; STIP := sip.STIP|>
supervisor13_definition=∀sie mie. lower_sie_mie (sie,mie) = mie with <|SSIE := sie.SSIE; STIE := sie.STIE|>
supervisor14_definition=∀sst mst. lower_sstatus_mstatus (sst,mst) = update_mstatus (mst,rec'mstatus (reg'mstatus mst) with <|MIE := sst.SIE; MIE1 := sst.SPIE; MPRV1 := privLevel (if sst.SPS then Supervisor else User); MFS := sst.SFS; MXS := sst.SXS; MMPRV := sst.SMPRV|>)
