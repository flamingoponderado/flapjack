v_rel=∀(a :num) (x :α) (y :β) (xs :γ) (ys :α list). v_rel a x y xs ys ⇔ LLOOKUP ys a = SOME x
env_rel=(∀(e2 :α list) (e1 :α list) (d :num). env_rel ([] :num list) d e1 e2 ⇔ e1 = DROP d e2) ∧ (∀(y :α) (x :α) (rest :num list) (e2 :α list) (e1 :α list) (d :num) (a :num). env_rel (a::rest) d (x::e1) (y::e2) ⇔ v_rel a x y (x::e1) (y::e2) ∧ env_rel rest d e1 e2) ∧ (∀(v9 :num) (v3 :α list) (v10 :num list) (v1 :num). env_rel (v9::v10) v1 ([] :α list) v3 ⇔ F) ∧ ∀(v9 :num) (v14 :α list) (v13 :α) (v10 :num list) (v1 :num). env_rel (v9::v10) v1 (v13::v14) ([] :α list) ⇔ F
env_rel_length=∀(ax :num list) (env :α list) (env2 :α list). env_rel ax (d :num) env env2 ⇒ LENGTH env ≤ LENGTH env2
env_rel_MAP=∀(ax :num list) (env1 :α list) (env2 :α list) (d :num) (a :α list). env_rel ax d env1 env2 ⇒ env_rel (MAP ($+ (LENGTH a)) ax) (d + LENGTH a) env1 (a ++ env2)
evaluate_env_rel=∀(xs :bvi$exp list) (env1 :v list) (s1 :(γ, 'ffi) state) (ax :num list) (env2 :v list) (res :(v list, exn_or_ret) result) (s2 :(γ, 'ffi) state) (ys :α) (d :num). (evaluate (xs,env1,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2) ∧ env_rel ax d env1 env2 ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ((compile ax d xs :bvi$exp list),env2,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2)
compile_thm=∀(xs :bvi$exp list) (s2 :(γ, 'ffi) state) (s1 :(γ, 'ffi) state) (res :(v list, exn_or_ret) result) (env :v list). (evaluate (xs,env,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ((compile ([] :num list) (0 :num) xs :bvi$exp list),env,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2)
evaluate_compile_exp=(evaluate ([(d :bvi$exp)],(env :v list),(s :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = ((r :(v list, exn_or_ret) result),(t :(α, β) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ([compile_exp d],env,s) :(v list, exn_or_ret) result # (α, β) state) = (r,t)
dest_var_code_labels=∀(x :bvi$exp). get_code_labels (delete_var x) = get_code_labels x
compile_code_labels=∀(x :num list) (y :num) (z :bvi$exp list). BIGUNION (set (MAP get_code_labels (compile x y z :bvi$exp list))) = BIGUNION (set (MAP get_code_labels z))
compile_exp_code_labels=∀(x :bvi$exp). get_code_labels (compile_exp x) = get_code_labels x
env_rel_REPLICATE_0_replay=∀(vs :α list) (ax :num list) (d :num) (env1 :α list) (env2 :α list). env_rel ax d env1 env2 ⇒ env_rel (REPLICATE (LENGTH vs) (0 :num) ++ ax) d (vs ++ env1) (vs ++ env2)
bvi_exp_size_def=(∀(a :num). exp_size (Var a :bvi$exp) = (1 :num) + a) ∧ (∀(a0 :bvi$exp) (a1 :bvi$exp) (a2 :bvi$exp). exp_size (If a0 a1 a2 :bvi$exp) = (1 :num) + (exp_size a0 + (exp_size a1 + exp_size a2))) ∧ (∀(a0 :bvi$exp list) (a1 :bvi$exp). exp_size (Let a0 a1 :bvi$exp) = (1 :num) + (exp2_size a0 + exp_size a1)) ∧ (∀(a :bvi$exp). exp_size (Raise a :bvi$exp) = (1 :num) + exp_size a) ∧ (∀(a :bvi$exp). exp_size (Tick a :bvi$exp) = (1 :num) + exp_size a) ∧ (∀(a0 :num) (a1 :num option) (a2 :bvi$exp list) (a3 :bvi$exp option). exp_size (Call a0 a1 a2 a3 :bvi$exp) = (1 :num) + (a0 + (option_size (λ(x :num). x) a1 + (exp2_size a2 + exp1_size a3)))) ∧ (∀(a0 :num) (a1 :num). exp_size (Force a0 a1 :bvi$exp) = (1 :num) + (a0 + a1)) ∧ (∀(a0 :closLang$op) (a1 :bvi$exp list). exp_size (Op a0 a1 :bvi$exp) = (1 :num) + (op_size a0 + exp2_size a1)) ∧ (∀(a0 :num) (a1 :num) (a2 :num) (a3 :bvi$exp list) (a4 :bvi$exp). exp_size (LetCall a0 a1 a2 a3 a4) = (1 :num) + (a0 + (a1 + (a2 + (exp2_size a3 + exp_size a4))))) ∧ (∀(a :bvi$exp list). exp_size (Return a) = (1 :num) + exp2_size a) ∧ exp1_size (NONE :bvi$exp option) = (0 :num) ∧ (∀(a :bvi$exp). exp1_size (SOME a) = (1 :num) + exp_size a) ∧ exp2_size ([] :bvi$exp list) = (0 :num) ∧ ∀(a0 :bvi$exp) (a1 :bvi$exp list). exp2_size (a0::a1) = (1 :num) + (exp_size a0 + exp2_size a1)
exp_size_APPEND=∀(xs :bvi$exp list) (ys :bvi$exp list). exp2_size (xs ++ ys) = exp2_size xs + exp2_size ys
IMP_COMM=(b1 :bool) ⇒ (b2 :bool) ⇒ (b3 :bool) ⇔ b2 ⇒ b1 ⇒ b3
compile_APPEND=∀(xs :bvi$exp list) (ys :bvi$exp list) (ax :num list) (d :num). (compile ax d (xs ++ ys) :bvi$exp list) = (compile ax d xs :bvi$exp list) ++ (compile ax d ys :bvi$exp list)
compile_CONS=(compile (ax :num list) (d :num) ((x :bvi$exp)::(xs :bvi$exp list)) :bvi$exp list) = (compile ax d [x] :bvi$exp list) ++ (compile ax d xs :bvi$exp list)
evaluate_SNOC_Rval=(evaluate (SNOC (x :bvi$exp) (y :bvi$exp list),(env :v list),(s :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = ((Rval (a :v list) :(v list, exn_or_ret) result),(r :(α, β) state)) ⇒ ∃(a1 :v) (a2 :v list) (r1 :(α, β) state). a = SNOC a1 a2 ∧ LENGTH y = LENGTH a2 ∧ (evaluate (y,env,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval a2 :(v list, exn_or_ret) result),r1) ∧ (evaluate ([x],env,r1) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [a1] :(v list, exn_or_ret) result),r)
env_rel_LOOKUP_SOME_replay=∀(env :α list) (env2 :α list) (ax :num list) (x :num) (n :num) (d :num). env_rel ax d env env2 ∧ LLOOKUP ax n = SOME x ⇒ v_rel x env❲n❳ env2❲n❳ (DROP n env) (DROP n env2)
env_rel_LLOOKUP_NONE_replay=∀(ax :num list) (env :α list) (env2 :α list) (n :num) (d :num). env_rel ax d env env2 ∧ LLOOKUP ax n = (NONE :num option) ∧ n < LENGTH env ⇒ n + d < LENGTH env2 ∧ env2❲n + d❳ = env❲n❳
evaluate_delete_var_Rerr_SING_typed=∀(x :bvi$exp) (s :(α, β) state) (r :(α, β) state) (e :exn_or_ret error_result) (env2 :v list). (evaluate ([x],env2,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rerr e :(v list, exn_or_ret) result),r) ∧ e ≠ (Rabort Rtype_error :exn_or_ret error_result) ⇒ (evaluate ([delete_var x],env2,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rerr e :(v list, exn_or_ret) result),r)
evaluate_delete_var_Rerr_local_typed=∀(xs :bvi$exp list) (s :(α, β) state) (r :(α, β) state) (e :exn_or_ret error_result) (env2 :v list). (evaluate (xs,env2,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rerr e :(v list, exn_or_ret) result),r) ∧ e ≠ (Rabort Rtype_error :exn_or_ret error_result) ⇒ (evaluate (MAP delete_var xs,env2,s) :(v list, exn_or_ret) result # (α, β) state) = ((Rerr e :(v list, exn_or_ret) result),r)
evaluate_delete_var_Rval_local_typed=∀(xs :bvi$exp list) (env2 :v list) (s :(γ, 'ffi) state) (a :v list) (r :(γ, 'ffi) state) (ax :num list) (env :v list) (d :num). (evaluate (xs,env2,s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval a :(v list, exn_or_ret) result),r) ∧ env_rel ax d env env2 ⇒ ∃(b :v list). (evaluate (MAP delete_var xs,env2,s) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval b :(v list, exn_or_ret) result),r) ∧ env_rel ((extract_list xs :num list) ++ ax) d (a ++ env) (b ++ env2)
