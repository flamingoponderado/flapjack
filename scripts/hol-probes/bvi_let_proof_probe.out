v_rel=∀(a :num) (x :α) (y :β) (xs :γ) (ys :α list). v_rel a x y xs ys ⇔ LLOOKUP ys a = SOME x
env_rel=(∀(e2 :α list) (e1 :α list) (d :num). env_rel ([] :num list) d e1 e2 ⇔ e1 = DROP d e2) ∧ (∀(y :α) (x :α) (rest :num list) (e2 :α list) (e1 :α list) (d :num) (a :num). env_rel (a::rest) d (x::e1) (y::e2) ⇔ v_rel a x y (x::e1) (y::e2) ∧ env_rel rest d e1 e2) ∧ (∀(v9 :num) (v3 :α list) (v10 :num list) (v1 :num). env_rel (v9::v10) v1 ([] :α list) v3 ⇔ F) ∧ ∀(v9 :num) (v14 :α list) (v13 :α) (v10 :num list) (v1 :num). env_rel (v9::v10) v1 (v13::v14) ([] :α list) ⇔ F
env_rel_length=∀(ax :num list) (env :α list) (env2 :α list). env_rel ax (d :num) env env2 ⇒ LENGTH env ≤ LENGTH env2
env_rel_MAP=∀(ax :num list) (env1 :α list) (env2 :α list) (d :num) (a :α list). env_rel ax d env1 env2 ⇒ env_rel (MAP ($+ (LENGTH a)) ax) (d + LENGTH a) env1 (a ++ env2)
evaluate_env_rel=∀(xs :bvi$exp list) (env1 :v list) (s1 :(γ, 'ffi) state) (ax :num list) (env2 :v list) (res :(v list, exn_or_ret) result) (s2 :(γ, 'ffi) state) (ys :α) (d :num). (evaluate (xs,env1,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2) ∧ env_rel ax d env1 env2 ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ((compile ax d xs :bvi$exp list),env2,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2)
compile_thm=∀(xs :bvi$exp list) (s2 :(γ, 'ffi) state) (s1 :(γ, 'ffi) state) (res :(v list, exn_or_ret) result) (env :v list). (evaluate (xs,env,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ((compile ([] :num list) (0 :num) xs :bvi$exp list),env,s1) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s2)
evaluate_compile_exp=(evaluate ([(d :bvi$exp)],(env :v list),(s :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = ((r :(v list, exn_or_ret) result),(t :(α, β) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ([compile_exp d],env,s) :(v list, exn_or_ret) result # (α, β) state) = (r,t)
