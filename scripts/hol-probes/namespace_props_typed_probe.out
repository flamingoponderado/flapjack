nsLookup_nsEmpty_typed=∀(id :(α, β) id). nsLookup (nsEmpty :(α, β, γ) namespace) id = (NONE :γ option)
nsLookupMod_nsEmpty_typed=∀(x :α) (y :α list). nsLookupMod (nsEmpty :(α, β, γ) namespace) (x::y) = (NONE :(α, β, γ) namespace option)
nsLookup_nsLift_typed=∀(mn :α) (e :(α, β, γ) namespace) (id :(α, β) id). nsLookup (nsLift mn e) id = case id of (Short v :(α, β) id) => (NONE :γ option) | Long mn' id' => if mn = mn' then nsLookup e id' else (NONE :γ option)
nsLookupMod_nsLift_typed=∀(mn :α) (e :(α, β, γ) namespace) (path :α list). nsLookupMod (nsLift mn e) path = case path of ([] :α list) => SOME (nsLift mn e) | mn'::path' => if mn = mn' then nsLookupMod e path' else (NONE :(α, β, γ) namespace option)
nsDom_nsLift_typed=∀(mn :α) (n :(α, β, γ) namespace). nsDom (nsLift mn n) = IMAGE (Long mn :(α, β) id -> (α, β) id) (nsDom n)
nsDomMod_nsLift_typed=∀(mn :α) (n :(α, β, γ) namespace). nsDomMod (nsLift mn n) = ([] :α list) INSERT IMAGE (CONS mn) (nsDomMod n)
nsDom_nsAppend_equal_typed=∀(n1 :(α, β, γ) namespace) (n2 :(α, β, γ) namespace) (n3 :(α, β, δ) namespace) (n4 :(α, β, δ) namespace). nsDom n1 = nsDom n3 ∧ nsDom n2 = nsDom n4 ∧ nsDomMod n1 = nsDomMod n3 ∧ nsDomMod n2 = nsDomMod n4 ⇒ nsDom (nsAppend n1 n2) = nsDom (nsAppend n3 n4) ∧ nsDomMod (nsAppend n1 n2) = nsDomMod (nsAppend n3 n4)
nsAppend_nsEmpty_typed=∀(env :(α, β, γ) namespace). nsAppend env (nsEmpty :(α, β, γ) namespace) = env ∧ nsAppend (nsEmpty :(α, β, γ) namespace) env = env
nsLookup_nsBind_typed=(∀(n :α) (v :β) (e :(γ, α, β) namespace). nsLookup (nsBind n v e) (Short n :(γ, α) id) = SOME v) ∧ ∀(n :(δ, ε) id) (n' :ε) (v :ζ) (e :(δ, ε, ζ) namespace). n ≠ (Short n' :(δ, ε) id) ⇒ nsLookup (nsBind n' v e) n = nsLookup e n
nsAppend_assoc_typed=∀(e1 :(α, β, γ) namespace) (e2 :(α, β, γ) namespace) (e3 :(α, β, γ) namespace). nsAppend e1 (nsAppend e2 e3) = nsAppend (nsAppend e1 e2) e3
nsAppend_to_nsBindList_typed=∀(l :(α # β) list). nsAppend (alist_to_ns l :(γ, α, β) namespace) (e :(γ, α, β) namespace) = nsBindList l e
nsAll_nsAppend_typed=∀(f :(α, β) id -> γ -> bool) (e1 :(α, β, γ) namespace) (e2 :(α, β, γ) namespace). nsAll f e1 ∧ nsAll f e2 ⇒ nsAll f (nsAppend e1 e2)
nsAll_nsBind_typed=∀(P :(α, β) id -> γ -> bool) (x :β) (v :γ) (e :(α, β, γ) namespace). P (Short x :(α, β) id) v ∧ nsAll P e ⇒ nsAll P (nsBind x v e)
nsAll_nsSing_typed=∀(R :(α, β) id -> γ -> bool) (n :β) (v :γ). nsAll R (nsSing n v :(α, β, γ) namespace) ⇔ R (Short n :(α, β) id) v
nsAll2_nsAppend_typed=∀(R :(α, β) id -> γ -> δ -> bool) (e1 :(α, β, γ) namespace) (e1' :(α, β, γ) namespace) (e2 :(α, β, δ) namespace) (e2' :(α, β, δ) namespace). nsAll2 R e1 e2 ∧ nsAll2 R e1' e2' ⇒ nsAll2 R (nsAppend e1 e1') (nsAppend e2 e2')
mk_id_11_typed=∀(a :α list) (b :β) (c :α list) (d :β). mk_id a b = mk_id c d ⇔ a = c ∧ b = d
id_to_mods_mk_id_typed=∀(mn :α list) (x :β). id_to_mods (mk_id mn x) = mn
id_to_namemods_mk_id_typed=∀(mn :α list) (x :β). id_to_n (mk_id mn x) = x
mk_id_surj_typed=∀(id :(α, β) id). ∃(p :α list) (n :β). id = mk_id p n
mk_id_thm_typed=∀(id :(α, β) id). mk_id (id_to_mods id) (id_to_n id) = id
alist_to_ns_nil_typed=(alist_to_ns ([] :(β # γ) list) :(α, β, γ) namespace) = (nsEmpty :(α, β, γ) namespace)
nsSub_nsEmpty_typed=∀(r :(α, β) id -> γ -> δ -> bool) (env :(α, β, δ) namespace). nsSub r (nsEmpty :(α, β, γ) namespace) env
nsAll_nsEmpty_typed=∀(f :(α, β) id -> γ -> bool). nsAll f (nsEmpty :(α, β, γ) namespace)
nsAll2_nsEmpty_typed=∀(f :(α, β) id -> γ -> δ -> bool). nsAll2 f (nsEmpty :(α, β, γ) namespace) (nsEmpty :(α, β, δ) namespace)
nsDom_nsEmpty_typed=nsDom (nsEmpty :(α, β, γ) namespace) = (∅ :(α, β) id -> bool)
nsDomMod_nsEmpty_typed=nsDomMod (nsEmpty :(α, β, γ) namespace) = {([] :α list)}
nsMap_nsEmpty_typed=∀(f :α -> β). nsMap f (nsEmpty :(γ, δ, α) namespace) = (nsEmpty :(γ, δ, β) namespace)
nsBind_nsEmpty_typed=∀(x :α) (y :β) (env :(γ, α, β) namespace). nsBind x y env ≠ (nsEmpty :(γ, α, β) namespace)
nsAll_mono_typed=(∀(id :(α, β) id) (x :γ). (P :(α, β) id -> γ -> bool) id x ⇒ (Q :(α, β) id -> γ -> bool) id x) ⇒ nsAll P (e :(α, β, γ) namespace) ⇒ nsAll Q e
alist_to_ns_cons_typed=∀(k :α) (v :β) (l :(α # β) list). (alist_to_ns ((k,v)::l) :(γ, α, β) namespace) = nsBind k v (alist_to_ns l :(γ, α, β) namespace)
nsAppend_nsBind_typed=∀(k :α) (v :β) (e1 :(γ, α, β) namespace) (e2 :(γ, α, β) namespace). nsAppend (nsBind k v e1) e2 = nsBind k v (nsAppend e1 e2)
nsAppend_alist_to_ns_typed=∀(al1 :(α # β) list) (al2 :(α # β) list). nsAppend (alist_to_ns al1 :(γ, α, β) namespace) (alist_to_ns al2 :(γ, α, β) namespace) = (alist_to_ns (al1 ++ al2) :(γ, α, β) namespace)
nsBind_11_typed=∀(x :α) (y :β) (n :(γ, α, β) namespace) (x' :α) (y' :β) (n' :(γ, α, β) namespace). nsBind x y n = nsBind x' y' n' ⇔ x = x' ∧ y = y' ∧ n = n'
nsLookupMod_alist_to_ns_typed=∀(l :(α # β) list) (x :γ) (y :γ list). nsLookupMod (alist_to_ns l :(γ, α, β) namespace) (x::y) = (NONE :(γ, α, β) namespace option)
alist_to_ns_11_typed=∀(l1 :(α # β) list) (l2 :(α # β) list). (alist_to_ns l1 :(γ, α, β) namespace) = (alist_to_ns l2 :(γ, α, β) namespace) ⇔ l1 = l2
nsAppend_nsSing_typed=∀(n :α) (x :β) (e :(γ, α, β) namespace). nsAppend (nsSing n x :(γ, α, β) namespace) e = nsBind n x e
nsLookup_nsSing_typed=∀(n :α) (v :β) (id :(γ, α) id). nsLookup (nsSing n v :(γ, α, β) namespace) id = if id = (Short n :(γ, α) id) then SOME v else (NONE :β option)
nsMap_nsSing_typed=∀(f :α -> β) (x :γ) (v :α). nsMap f (nsSing x v :(δ, γ, α) namespace) = (nsSing x (f v) :(δ, γ, β) namespace)
nsLookupMod_nsSing_typed=∀(n1 :α list) (n2 :β) (v :γ). nsLookupMod (nsSing n2 v :(α, β, γ) namespace) n1 = if n1 = ([] :α list) then SOME (nsSing n2 v :(α, β, γ) namespace) else (NONE :(α, β, γ) namespace option)
nsDom_nsSing_typed=∀(x :α) (y :β). nsDom (nsSing x y :(γ, α, β) namespace) = {(Short x :(γ, α) id)}
nsDomMod_nsSing_typed=∀(x :α) (y :β). nsDomMod (nsSing x y :(γ, α, β) namespace) = {([] :γ list)}
eALL_T_typed=∀(e :(α, β, γ) namespace). nsAll (λ(n :(α, β) id) (x :γ). T) e
nsLookup_nsAll_typed=∀(env :(α, β, γ) namespace) (x :(α, β) id) (P :(α, β) id -> γ -> bool) (v :γ). nsAll P env ∧ nsLookup env x = SOME v ⇒ P x v
nsLookup_nsDom_typed=∀(x :(α, β) id) (n :(α, β, γ) namespace). x ∈ nsDom n ⇔ ∃(v :γ). nsLookup n x = SOME v
nsLift_nsMap_typed=∀(f :α -> β) (n :(γ, δ, α) namespace) (mn :γ). nsLift mn (nsMap f n) = nsMap f (nsLift mn n)
nsLookup_Bind_v_some_typed=nsLookup (Bind (v :(γ # α) list) ([] :(β # (β, γ, α) namespace) list)) (k :(β, γ) id) = SOME (x :α) ⇔ ∃(y :γ). k = (Short y :(β, γ) id) ∧ ALOOKUP v y = SOME x
nsSub_refl_typed=∀(P :(α, β) id -> γ -> bool) (R :(α, β) id -> γ -> γ -> bool). (∀(n :(α, β) id) (x :γ). P n x ⇒ R n x x) ⇒ ∀(e :(α, β, γ) namespace). nsAll P e ⇒ nsSub R e e
nsDomMod_alist_to_ns_typed=∀(l :(α # β) list). nsDomMod (alist_to_ns l :(γ, α, β) namespace) = {([] :γ list)}
nsSub_nsBind_typed=∀(R :(α, β) id -> γ -> δ -> bool) (x :β) (v1 :γ) (v2 :δ) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace). R (Short x :(α, β) id) v1 v2 ∧ nsSub R e1 e2 ⇒ nsSub R (nsBind x v1 e1) (nsBind x v2 e2)
nsAll2_nsBind_typed=∀(R :(α, β) id -> γ -> δ -> bool) (x :β) (v1 :γ) (v2 :δ) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace). R (Short x :(α, β) id) v1 v2 ∧ nsAll2 R e1 e2 ⇒ nsAll2 R (nsBind x v1 e1) (nsBind x v2 e2)
nsSub_conj_typed=∀(P :(α, β) id -> γ -> δ -> bool) (Q :(α, β) id -> γ -> δ -> bool) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace). nsSub (λ(id :(α, β) id) (x :γ) (y :δ). P id x y ∧ Q id x y) e1 e2 ⇔ nsSub P e1 e2 ∧ nsSub Q e1 e2
nsAll2_conj_typed=∀(P :(α, β) id -> γ -> δ -> bool) (Q :(α, β) id -> γ -> δ -> bool) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace). nsAll2 (λ(id :(α, β) id) (x :γ) (y :δ). P id x y ∧ Q id x y) e1 e2 ⇔ nsAll2 P e1 e2 ∧ nsAll2 Q e1 e2
nsSub_mono_typed=(∀(x :(α, β) id) (y :γ) (z :δ). (R1 :(α, β) id -> γ -> δ -> bool) x y z ⇒ (R2 :(α, β) id -> γ -> δ -> bool) x y z) ⇒ nsSub R1 (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace) ⇒ nsSub R2 e1 e2
nsSub_mono2_typed=(∀(x :(α, β) id) (y :γ) (z :δ). nsLookup (e1 :(α, β, γ) namespace) x = SOME y ∧ nsLookup (e2 :(α, β, δ) namespace) x = SOME z ∧ (R1 :(α, β) id -> γ -> δ -> bool) x y z ⇒ (R2 :(α, β) id -> γ -> δ -> bool) x y z) ⇒ nsSub R1 e1 e2 ⇒ nsSub R2 e1 e2
nsAll2_mono_typed=(∀(x :(α, β) id) (y :γ) (z :δ). (R1 :(α, β) id -> γ -> δ -> bool) x y z ⇒ (R2 :(α, β) id -> γ -> δ -> bool) x y z) ⇒ nsAll2 R1 (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace) ⇒ nsAll2 R2 e1 e2
nsDom_nsBind_typed=∀(x :α) (y :β) (n :(γ, α, β) namespace). nsDom (nsBind x y n) = (Short x :(γ, α) id) INSERT nsDom n
nsDomMod_nsBind_typed=∀(x :α) (y :β) (n :(γ, α, β) namespace). nsDomMod (nsBind x y n) = nsDomMod n
nsAll2_nsLookup1_typed=∀(R :(α, β) id -> γ -> δ -> bool) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace) (n :(α, β) id) (v1 :γ). nsLookup e1 n = SOME v1 ∧ nsAll2 R e1 e2 ⇒ ∃(v2 :δ). nsLookup e2 n = SOME v2 ∧ R n v1 v2
nsAll2_nsLookup2_typed=∀(R :(α, β) id -> γ -> δ -> bool) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace) (n :(α, β) id) (v2 :δ). nsLookup e2 n = SOME v2 ∧ nsAll2 R e1 e2 ⇒ ∃(v1 :γ). nsLookup e1 n = SOME v1 ∧ R n v1 v2
nsAll2_nsLookup_none_typed=∀(R :(α, β) id -> γ -> δ -> bool) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace) (n :(α, β) id). nsAll2 R e1 e2 ⇒ (nsLookup e1 n = (NONE :γ option) ⇔ nsLookup e2 n = (NONE :δ option))
nsLookup_alist_to_ns_some_typed=∀(l :(α # β) list) (id :(γ, α) id) (v :β). nsLookup (alist_to_ns l :(γ, α, β) namespace) id = SOME v ⇔ ∃(x' :α). id = (Short x' :(γ, α) id) ∧ ALOOKUP l x' = SOME v
nsLookup_alist_to_ns_none_typed=∀(l :(α # β) list) (id :(γ, α) id). nsLookup (alist_to_ns l :(γ, α, β) namespace) id = (NONE :β option) ⇔ ∀(x' :α). id = (Short x' :(γ, α) id) ⇒ ALOOKUP l x' = (NONE :β option)
nsMap_alist_to_ns_typed=∀(f :α -> β) (l :(γ # α) list). nsMap f (alist_to_ns l :(δ, γ, α) namespace) = (alist_to_ns (MAP (λ((k :γ),(v :α)). (k,f v)) l) :(δ, γ, β) namespace)
nsSub_nsMap_typed=∀(R :(α, β) id -> γ -> γ -> bool) (f :δ -> γ) (n1 :(α, β, δ) namespace) (n2 :(α, β, δ) namespace). nsSub R (nsMap f n1) (nsMap f n2) ⇔ nsSub (λ(id :(α, β) id) (x :δ) (y :δ). R id (f x) (f y)) n1 n2
nsLookup_FOLDR_nsLift_typed=∀(e :(α, β, γ) namespace) (p :α list) (k :β). nsLookup (FOLDR (nsLift :α -> (α, β, γ) namespace -> (α, β, γ) namespace) e p) (mk_id p k) = nsLookup e (Short k :(α, β) id)
nsAll2_nsSing_typed=∀(R :(α, β) id -> γ -> δ -> bool) (n1 :β) (v1 :γ) (n2 :β) (v2 :δ). nsAll2 R (nsSing n1 v1 :(α, β, γ) namespace) (nsSing n2 v2 :(α, β, δ) namespace) ⇔ n1 = n2 ∧ R (Short n1 :(α, β) id) v1 v2
nsAll_nsOptBind_typed=∀(P :(α, β) id -> γ -> bool) (x :β option) (v :γ) (e :(α, β, γ) namespace). (x = (NONE :β option) ∨ ∃(n :β). x = SOME n ∧ P (Short n :(α, β) id) v) ∧ nsAll P e ⇒ nsAll P (nsOptBind x v e)
nsLookup_nsLift_append_typed=∀(m :α) (ns :(α, β, γ) namespace) (ns' :(α, β, γ) namespace) (m' :α) (id :(α, β) id) (n :β). nsLookup (nsAppend (nsLift m ns) ns') (Short n :(α, β) id) = nsLookup ns' (Short n :(α, β) id) ∧ nsLookup (nsAppend (nsLift m ns) ns') (Long m' id) = if m = m' then nsLookup ns id else nsLookup ns' (Long m' id)
nsAll2_alist_to_ns_typed=∀(R :(α, β) id -> γ -> δ -> bool) (l1 :(β # γ) list) (l2 :(β # δ) list). LIST_REL (λ((x :β),(y :γ)) ((x' :β),(y' :δ)). x = x' ∧ R (Short x :(α, β) id) y y') l1 l2 ⇒ nsAll2 R (alist_to_ns l1 :(α, β, γ) namespace) (alist_to_ns l2 :(α, β, δ) namespace)
nsAll2_nsBindList_typed=∀(R :(α, β) id -> γ -> δ -> bool) (l1 :(β # γ) list) (l2 :(β # δ) list) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace). LIST_REL (λ((x :β),(y :γ)) ((x' :β),(y' :δ)). x = x' ∧ R (Short x :(α, β) id) y y') l1 l2 ∧ nsAll2 R e1 e2 ⇒ nsAll2 R (nsBindList l1 e1) (nsBindList l2 e2)
alist_rel_restr_def_typed=(∀(R :α -> β -> γ -> bool) (l1 :(α # β) list) (l2 :(α # γ) list). alist_rel_restr R l1 l2 ([] :α list) ⇔ T) ∧ ∀(R :α -> β -> γ -> bool) (l1 :(α # β) list) (l2 :(α # γ) list) (k1 :α) (keys :α list). alist_rel_restr R l1 l2 (k1::keys) ⇔ case ALOOKUP l1 k1 of (NONE :β option) => F | SOME v1 => case ALOOKUP l2 k1 of (NONE :γ option) => F | SOME v2 => R k1 v1 v2 ∧ alist_rel_restr R l1 l2 keys
alist_rel_restr_thm_typed=∀(R :α -> β -> γ -> bool) (e1 :(α # β) list) (e2 :(α # γ) list) (keys :α list). alist_rel_restr R e1 e2 keys ⇔ ∀(k :α). MEM k keys ⇒ ∃(v1 :β) (v2 :γ). ALOOKUP e1 k = SOME v1 ∧ ALOOKUP e2 k = SOME v2 ∧ R k v1 v2
alistSub_def_typed=∀(R :α -> β -> γ -> bool) (e1 :(α # β) list) (e2 :(α # γ) list). alistSub R e1 e2 ⇔ alist_rel_restr R e1 e2 (MAP (FST :α # β -> α) e1)
alistSub_cong_typed=∀(l1 :(α # β) list) (l2 :(α # γ) list) (l1' :(α # β) list) (l2' :(α # γ) list) (R :α -> β -> γ -> bool) (R' :α -> β -> γ -> bool). l1 = l1' ∧ l2 = l2' ∧ (∀(n :α) (x :β) (y :γ). ALOOKUP l1' n = SOME x ∧ ALOOKUP l2' n = SOME y ⇒ (R n x y ⇔ R' n x y)) ⇒ (alistSub R l1 l2 ⇔ alistSub R' l1' l2')
nsLookup_to_nsLookupMod_typed=∀(n :(α, β, γ) namespace) (v :(α, β) id) (t :γ). nsLookup n v = SOME t ⇒ ∃(m :(α, β, γ) namespace). nsLookupMod n (id_to_mods v) = SOME m ∧ nsLookup m (Short (id_to_n v) :(α, β) id) = SOME t
nsDom_alist_to_ns_typed=∀(l :(α # β) list). nsDom (alist_to_ns l :(γ, α, β) namespace) = set (MAP ((Short :α -> (γ, α) id) ∘ (FST :α # β -> α)) l)
