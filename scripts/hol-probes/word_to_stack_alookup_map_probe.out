am_full_ALOOKUP_MAP_any=⊢ ∀f k h ls a x. INJ k (a INSERT set (MAP FST ls)) 𝕌(:γ) ∧ (∀x y. MEM (x,y) ls ⇒ f (x,y) = (k x,h (k x) y)) ∧ k a = x ⇒ ALOOKUP (MAP f ls) x = OPTION_MAP (h x) (ALOOKUP ls a)
am_full_ALOOKUP_MAP_INJ_FST=⊢ ∀ls f x k. INJ (FST ∘ f) (x INSERT set ls) 𝕌(:β) ∧ FST (f x) = k ⇒ ALOOKUP (MAP f ls) k = ALOOKUP (MAP (λx. (x,SND (f x))) ls) x
am_full_ALOOKUP_ID_TABULATE=⊢ ALOOKUP (MAP (λx. (x,x)) ls) x = if MEM x ls then SOME x else NONE
