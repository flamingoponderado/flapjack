every_inst_ok_arith_simp_exp_typed=∀(exp :α crepLang$exp). every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)) exp ⇒ every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)) (simp_exp exp)
every_inst_ok_arith_simp_prog_typed=∀(prog :α crepLang$prog). EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of prog :α crepLang$exp list) ⇒ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of (simp_prog prog) :α crepLang$exp list)
every_inst_ok_less_crep_to_loop_compile_prog_typed=EVERY (λ((name :mlstring),(params :num list),(body :α crepLang$prog)). EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of body :α crepLang$exp list)) (crep_code :(mlstring # num list # α crepLang$prog) list) ⇒ EVERY (λ((name :num),(params :num list),(body :α loopLang$prog)). every_prog (loop_inst_ok (c :β asm_config) :α loopLang$prog -> bool) body) (compile_prog c.ISA crep_code :(num # num list # α loopLang$prog) list)
