lo_definition=⊢ (∀tl2 tl1 hd2 hd1. listCmp (hd1::tl1) (hd2::tl2) = if hd1 = hd2 then listCmp tl1 tl2 else if hd1 > hd2 then Greater else Less) ∧ listCmp [] [] = Equal ∧ (∀tl1 hd1. listCmp (hd1::tl1) [] = Greater) ∧ ∀tl2 hd2. listCmp [] (hd2::tl2) = Less
lo_full_eq=⊢ ∀L1 L2. listCmp L1 L2 = Equal ⇔ L1 = L2
lo_full_reverse=⊢ ∀x y. listCmp x y = Greater ⇔ listCmp y x = Less
lo_full_transit=⊢ ∀x y z. listCmp x y = Less ∧ listCmp y z = Less ⇒ listCmp x z = Less
lo_value_0_0=⊢ listCmp [] [] = Equal
lo_eq_0_0=⊢ ∀xs ys. listCmp ([] ++ xs) ([] ++ ys) = Equal ⇔ [] ++ xs = [] ++ ys
lo_reverse_0_0=⊢ ∀xs ys. listCmp ([] ++ xs) ([] ++ ys) = Greater ⇔ listCmp ([] ++ ys) ([] ++ xs) = Less
