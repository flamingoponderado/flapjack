all_enc_with_nop_pad_code=∀(nop :word8 list) (code :α sec list) (pos :num).
  (0 :num) < LENGTH nop ∧
  nop = (enc :α asm -> word8 list) (Inst (Skip :α inst) :α asm) ∧
  (LENGTH nop ≠ (1 :num) ⇒
   EVERY (sec_aligned (LENGTH nop) :α sec -> bool) code ∧
   EVERY (sec_label_zero :α sec -> bool) code) ∧
  EVERY (sec_label_one :α sec -> bool) code ∧ all_length_leq code ∧
  EVERY (sec_label_prefix_zero :α sec -> bool) code ∧
  all_encd enc (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    pos code ⇒
  all_enc_with_nop enc labs ffis pos (pad_code nop code)
all_enc_with_nop_pad_code_types=(nop :word8 list)::word8 list;(code :α sec list)::α sec list;(pos :num)::num;(ffis :ffiname list)::ffiname list;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(enc :α asm -> word8 list)::α asm -> word8 list;
singlebyte_full_guards=T
singlebyte_full_encoding=T
singlebyte_full_tuple=T
singlebyte_section_lengths=T
multibyte_full_guards=T
multibyte_full_encoding=T
multibyte_full_tuple=T
multibyte_section_lengths=T
empty_code=T
only_empty_sections=T
