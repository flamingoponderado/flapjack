weport_get_store_def_typed=∀(st :store_name |-> α word_loc). (get_store st :sptree$num_set) = (let (locSet :α word_loc list) = SET_TO_LIST (FRANGE st); (locList :num list) = MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) (MAP (dest_word_loc :α word_loc -> num option) locSet)) in FOLDL (λ(acc :sptree$num_set) (loc :num). insert loc () acc) (LN :sptree$num_set) locList)
weport_domain_get_store_typed=∀(n :num) (store :store_name |-> α word_loc). n ∈ (domain (get_store store :sptree$num_set) :num -> bool) ⇔ ∃(k :store_name) (n1 :num). FLOOKUP store k = SOME (Loc n n1 :α word_loc)
weport_get_store_update_typed=∀(store :store_name |-> α word_loc) (k :store_name) (v :α word_loc). (domain (get_store store⟨k ↦ v⟩ :sptree$num_set) :num -> bool) ⊆ (domain (get_store store :sptree$num_set) :num -> bool) ∪ case dest_word_loc v of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}
weport_get_memory_def_typed=∀(mem :α word -> α word_loc) (mdom :α word -> bool). get_memory mem mdom = (let (locSet :α word_loc list) = SET_TO_LIST (IMAGE mem mdom); (locList :num list) = MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) (MAP (dest_word_loc :α word_loc -> num option) locSet)) in FOLDL (λ(acc :sptree$num_set) (loc :num). insert loc () acc) (LN :sptree$num_set) locList)
weport_domain_get_memory_typed=∀(mem :α word -> α word_loc) (mdom :α word -> bool) (n :num). n ∈ (domain (get_memory mem mdom) :num -> bool) ⇔ ∃(k :α word) (n1 :num). k ∈ mdom ∧ mem k = (Loc n n1 :α word_loc)
weport_get_memory_update_typed=∀(k :α word) (v :α word_loc) (memory :α word -> α word_loc) (mdomain :α word -> bool). (domain (get_memory memory⦇k ↦ v⦈ mdomain) :num -> bool) ⊆ (domain (get_memory memory mdomain) :num -> bool) ∪ case dest_word_loc v of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}
weport_find_loc_state_def_typed=∀(s :(α, β, γ) state). find_loc_state s = (let (loc :sptree$num_set) = get_locals s.locals; (sto :sptree$num_set) = (get_store s.store :sptree$num_set); (sta :sptree$num_set) = (get_stack s.stack :sptree$num_set); (mem :sptree$num_set) = get_memory s.memory s.mdomain in union (union loc sto) (union sta mem))
weport_domain_find_loc_state_typed=∀(s :(α, β, γ) state). (domain (find_loc_state s) :num -> bool) = (domain (get_locals s.locals) :num -> bool) ∪ (domain (get_store s.store :sptree$num_set) :num -> bool) ∪ (domain (get_stack s.stack :sptree$num_set) :num -> bool) ∪ (domain (get_memory s.memory s.mdomain) :num -> bool)
weport_gc_no_new_locs_def_typed=∀(g :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option). gc_no_new_locs g ⇔ ∀(sta :α stack_frame list) (mem :α word -> α word_loc) (mdom :α word -> bool) (sto :store_name |-> α word_loc) (wl :α word_loc list) (mem1 :α word -> α word_loc) (sto1 :store_name |-> α word_loc) (sta1 :α stack_frame list). g (enc_stack sta,mem,mdom,sto) = SOME (wl,mem1,sto1) ∧ dec_stack wl sta = SOME sta1 ⇒ (domain (get_stack sta1 :sptree$num_set) :num -> bool) ⊆ (domain (get_stack sta :sptree$num_set) :num -> bool) ∧ (domain (get_memory mem1 mdom) :num -> bool) ⊆ (domain (get_memory mem mdom) :num -> bool) ∧ (domain (get_store sto1 :sptree$num_set) :num -> bool) ⊆ (domain (get_store sto :sptree$num_set) :num -> bool)
weport_word_state_rel_def_typed=∀(reachable :sptree$num_set) (t :(α, β, γ) state) (s :(α, β, γ) state). word_state_rel reachable t s ⇔ s.locals = t.locals ∧ s.fp_regs = t.fp_regs ∧ s.store = t.store ∧ s.stack = t.stack ∧ s.memory = t.memory ∧ s.mdomain = t.mdomain ∧ s.sh_mdomain = t.sh_mdomain ∧ s.permute = t.permute ∧ s.compile = t.compile ∧ s.compile_oracle = t.compile_oracle ∧ s.code_buffer = t.code_buffer ∧ s.data_buffer = t.data_buffer ∧ s.gc_fun = t.gc_fun ∧ s.handler = t.handler ∧ s.clock = t.clock ∧ s.termdep = t.termdep ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.locals_size = t.locals_size ∧ s.stack_max = t.stack_max ∧ s.stack_limit = t.stack_limit ∧ s.stack_size = t.stack_size ∧ code_rel reachable s.code t.code ∧ (domain (find_loc_state t) :num -> bool) ⊆ (domain reachable :num -> bool)
weport_get_memory_write_bytearray_lemma_typed=∀(mem :α word -> α word_loc) (mdom :α word -> bool) (reachable :β sptree$num_map) (c :α word) (r :word8 list) (be :bool). (domain (get_memory mem mdom) :num -> bool) ⊆ (domain reachable :num -> bool) ⇒ (domain (get_memory (write_bytearray c r mem mdom be) mdom) :num -> bool) ⊆ (domain reachable :num -> bool)
weport_stack_list_rearrange_lemma_typed=∀(s :(α, β, γ) state) (dr :num -> bool) (locs :δ sptree$num_map) (opt :(num # num # num) option) (lsz :num option). (domain (get_locals s.locals) :num -> bool) ⊆ dr ∧ (domain (get_stack s.stack :sptree$num_set) :num -> bool) ⊆ dr ⇒ (domain (get_stack (StackFrame lsz (toAList (inter s.locals (n :ε sptree$num_map))) (list_rearrange (s.permute (0 :num)) (sort (key_val_compare :num # α word_loc -> num # α word_loc -> bool) (toAList (inter s.locals locs)))) opt::s.stack) :sptree$num_set) :num -> bool) ⊆ dr
weport_word_state_rel_get_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ get_var (v :num) t = get_var v s
weport_word_state_rel_get_store_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ (get_store (v :store_name) t :α word_loc option) = (get_store v s :α word_loc option)
weport_word_state_rel_get_vars_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ get_vars (vs :num list) t = get_vars vs s
weport_word_state_rel_set_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ∧ (case dest_word_loc (v :α word_loc) of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}) ⊆ (domain reachable :num -> bool) ⇒ word_state_rel reachable (set_var (n :num) v s) (set_var n v t)
weport_word_state_rel_set_var_word_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ word_state_rel reachable (set_var (n :num) (Word (w :α word)) s) (set_var n (Word w) t)
weport_word_state_rel_set_vars_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ∧ BIGUNION (set (MAP (λ(x' :α word_loc). case dest_word_loc x' of (NONE :num option) => (∅ :num -> bool) | SOME x => {x}) (l :α word_loc list))) ⊆ (domain reachable :num -> bool) ∧ LENGTH (l0 :num list) = LENGTH l ⇒ word_state_rel reachable (set_vars l0 l s) (set_vars l0 l t)
weport_word_state_rel_set_fp_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ word_state_rel reachable (set_fp_var (n :num) (v :word64) s) (set_fp_var n v t)
weport_word_state_rel_word_exp_typed=∀(s1 :(α, β, γ) state) (exp :α exp) (s2 :(α, β, γ) state) (reachable :sptree$num_set). word_state_rel reachable s1 s2 ⇒ (word_exp s2 exp :α word_loc option) = (word_exp s1 exp :α word_loc option)
weport_word_state_rel_mem_load_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ mem_load (addr :α word) t = mem_load addr s
weport_word_state_rel_mem_load_32_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ mem_load_32 s.memory s.mdomain s.be (c :α word) = mem_load_32 t.memory t.mdomain t.be c
weport_word_state_rel_get_fp_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ get_fp_var (v :num) s = get_fp_var v t
weport_word_state_rel_assign_NONE_typed=∀(reg :num) (exp :α exp) (s :(α, β, γ) state) (reachable :sptree$num_set) (t :(α, β, γ) state). word_state_rel reachable s t ⇒ (assign reg exp s = (NONE :(α, β, γ) state option) ⇔ assign reg exp t = (NONE :(α, β, γ) state option))
weport_word_state_rel_inst_NONE_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (i :α inst). word_state_rel reachable s t ⇒ (inst i s = (NONE :(α, β, γ) state option) ⇔ inst i t = (NONE :(α, β, γ) state option))
weport_word_state_rel_assign_SOME_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ assign (reg :num) (exp :α exp) s = SOME (s1 :(α, β, γ) state) ∧ assign reg exp t = SOME (t1 :(α, β, γ) state) ⇒ word_state_rel reachable s1 t1
weport_word_state_rel_inst_SOME_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (i :α inst) (s1 :(α, β, γ) state) (t1 :(α, β, γ) state). word_state_rel reachable s t ⇒ inst i s = SOME s1 ∧ inst i t = SOME t1 ⇒ word_state_rel reachable s1 t1
weport_word_state_rel_pop_env_NONE_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state). word_state_rel reachable s t ⇒ (pop_env s = (NONE :(α, β, γ) state option) ⇔ pop_env t = (NONE :(α, β, γ) state option))
weport_word_state_rel_pop_env_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (s1 :(α, β, γ) state) (l1 :δ) (l2 :ε). word_state_rel reachable s t ⇒ pop_env s = SOME s1 ⇒ ∃(t1 :(α, β, γ) state). pop_env t = SOME t1 ∧ word_state_rel reachable s1 t1
weport_word_state_rel_jump_exc_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (s1 :(α, β, γ) state) (l1 :num) (l2 :num). word_state_rel reachable s t ⇒ jump_exc s = SOME (s1,l1,l2) ⇒ ∃(t1 :(α, β, γ) state). jump_exc t = SOME (t1,l1,l2) ∧ word_state_rel reachable s1 t1
weport_word_state_rel_gc_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (s1 :(α, β, γ) state). word_state_rel reachable s t ∧ gc_no_new_locs s.gc_fun ⇒ gc s = SOME s1 ⇒ ∃(t1 :(α, β, γ) state). gc t = SOME t1 ∧ word_state_rel reachable s1 t1
weport_word_state_rel_alloc_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (res :α result option) (c :α word) (n :sptree$num_set # sptree$num_set) (s1 :(α, β, γ) state). word_state_rel reachable s t ∧ res ≠ SOME (Error :α result) ∧ gc_no_new_locs s.gc_fun ⇒ alloc c n s = (res,s1) ⇒ ∃(t1 :(α, β, γ) state). alloc c n t = (res,t1) ∧ word_state_rel reachable s1 t1 ∧ dest_result_loc res ⊆ (domain reachable :num -> bool)
weport_word_removal_lemma_typed=∀(program :α prog) (state :(α, β, γ) state) (result :α result option) (new_state :(α, β, γ) state) (reachable :sptree$num_set) (removed_state :(α, β, γ) state). evaluate (program,state) = (result,new_state) ∧ result ≠ SOME (Error :α result) ∧ word_state_rel reachable state removed_state ∧ gc_no_new_locs state.gc_fun ∧ no_install program ∧ no_install_code state.code ∧ no_install_code removed_state.code ∧ (domain (find_word_ref program) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ code_closed reachable state.code ⇒ ∃(s :(α, β, γ) state). evaluate (program,removed_state) = (result,s) ∧ word_state_rel reachable new_state s ∧ dest_result_loc result ⊆ (domain reachable :num -> bool)
weport_word_removal_thm_typed=∀(start :num) (state :(α, β, γ) state) (result :α result option) (new_state :(α, β, γ) state) (r :δ) (reachable :sptree$num_set) (code1 :(num # num # α prog) list). evaluate ((Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME start) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog),state) = (result,new_state) ∧ result ≠ SOME (Error :α result) ∧ state.code = fromAList code1 ∧ (domain (find_loc_state state) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ gc_no_new_locs state.gc_fun ∧ reachable = closure_spt (insert start () (LN :sptree$num_set)) (analyse_word_code code1) ∧ ALL_DISTINCT (MAP (FST :num # num # α prog -> num) code1) ∧ no_install_code state.code ⇒ ∃(s :(α, β, γ) state). evaluate ((Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME start) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog),state with code := fromAList (remove_word_code reachable code1)) = (result,s)
