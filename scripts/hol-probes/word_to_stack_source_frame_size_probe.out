ss_full_push_env_set_store=⊢ push_env env NONE (set_store AllocSize (Word c) s) = set_store AllocSize (Word c) (push_env env NONE s)
ss_full_dec_stack_stack_size=⊢ ∀xs st st'. dec_stack xs st = SOME st' ⇒ stack_size st = stack_size st'
ss_full_s_key_eq_stack_size=⊢ ∀stack stack'. s_key_eq stack stack' ⇒ stack_size stack = stack_size stack'
ss_full_s_key_eq_push_env_locals_size=⊢ s_key_eq (push_env env opt1 s).stack (StackFrame n l0 l opt2::stack') ⇒ n = s.locals_size ∧ stack_size s.stack = stack_size stack'
