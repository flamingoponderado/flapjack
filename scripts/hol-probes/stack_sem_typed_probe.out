copy_words_for_pattern_LESS_EQ_typed=∀(p :α word) (i :num) (a :α word) (f :α word) (bs :α word list) (dm :α word -> bool) (m :α word -> α word_loc) (j :num) (a1 :α word # (α word -> α word_loc)). copy_words_for_pattern p i a f bs dm m = SOME (j,a1) ⇒ i ≤ j
store_const_sem_def_typed=∀(t1 :num) (t2 :num) (s :(α, γ, 'ffi) state). (store_const_sem t1 t2 s :β result option # (α, γ, 'ffi) state) = if ¬ALL_DISTINCT [(0 :num); (1 :num); (2 :num); (3 :num); t1; t2] then (SOME (Error :β result),s) else case ((get_var (1 :num) s :α word_loc option),(get_var (2 :num) s :α word_loc option),(get_var (3 :num) s :α word_loc option)) of ((NONE :α word_loc option),v4) => (SOME (Error :β result),s) | (SOME (Word i),(NONE :α word_loc option),v16) => (SOME (Error :β result),s) | (SOME (Word i),SOME (Word a),(NONE :α word_loc option)) => (SOME (Error :β result),s) | (SOME (Word i),SOME (Word a),SOME (Word off)) => (case copy_words (w2n i) a off s.bitmaps s.mdomain s.memory of (NONE :(α word # (α word -> α word_loc)) option) => (SOME (Error :β result),s) | SOME (a,m) => ((NONE :β result option),((if s.use_alloc then unset_var (0 :num) else I) (set_var t1 (Word (1w :α word)) (set_var t2 (Word (1w :α word)) (set_var (1 :num) (Word (1w :α word)) (set_var (2 :num) (Word a) (s with memory := m))))) :(α, γ, 'ffi) state))) | (SOME (Word i),SOME (Word a),SOME (Loc v31 v32 :α word_loc)) => (SOME (Error :β result),s) | (SOME (Word i),SOME (Loc v23 v24 :α word_loc),v16) => (SOME (Error :β result),s) | (SOME (Loc v11 v12 :α word_loc),v4) => (SOME (Error :β result),s)
check_store_consts_opt_def_typed=(∀(t1 :num) (t2 :num) (v0 :α stackLang$prog sptree$num_map). check_store_consts_opt t1 t2 (NONE :num option) v0 ⇔ T) ∧ ∀(t1 :num) (t2 :num) (n :num) (c :α stackLang$prog sptree$num_map). check_store_consts_opt t1 t2 (SOME n) c ⇔ lookup n c = SOME (Seq (StoreConsts t1 t2 (NONE :num option) :α stackLang$prog) (Return (0 :num) :α stackLang$prog))
bit_length_def_typed=∀(w :α word). bit_length w = if w = (0w :α word) then (0 :num) else bit_length (w ⋙ (1 :num)) + (1 :num)
read_bitmap_def_typed=read_bitmap ([] :α word list) = (NONE :bool list option) ∧ ∀(w :α word) (ws :α word list). read_bitmap (w::ws) = if word_msb w then case read_bitmap ws of (NONE :bool list option) => (NONE :bool list option) | SOME bs => SOME (GENLIST (λ(i :num). ((w ' i) :bool)) (dimindex (:α) − (1 :num)) ++ bs) else SOME (GENLIST (λ(i :num). ((w ' i) :bool)) (bit_length w − (1 :num)))
