IS_SOME_lookup_db_to_set_typed=∀(n :num). IS_SOME (lookup n (db_to_set (l :db_var_set))) ⇔ has_var n l
handle_ok_SmartLet_typed=handle_ok [SmartLet (xs :bvl$exp list) (x :bvl$exp)] ⇔ handle_ok xs ∧ handle_ok [x]
can_raise_thm_typed=(∀(e :bvl$exp) (env :v list) (s :γ) (s :(α, β) state). evaluate ([e],env,s) = ((Rerr (Rraise (a :v)) :(v list, v) result),(r :(α, β) state)) ⇒ can_raise e) ∧ ∀(es :bvl$exp list) (env :v list) (s :δ) (s :(α, β) state). evaluate (es,env,s) = ((Rerr (Rraise a) :(v list, v) result),r) ⇒ can_raise1 es
handle_adj_vars_0_typed=(∀(x :bvl$exp) (l :num). handle_adj_vars l (0 :num) x = x) ∧ ∀(x :bvl$exp list) (l :num). handle_adj_vars1 l (0 :num) x = x
evaluate_handle_adj_vars_lemma_typed=(∀(x :bvl$exp) (xs :v list) (a :v list) (env :v list) (r :(α, β) state). evaluate ([handle_adj_vars (LENGTH xs) (LENGTH a) x],xs ++ (a ++ env),r) = evaluate ([x],xs ++ env,r)) ∧ ∀(x :bvl$exp list) (xs :v list) (a :v list) (env :v list) (r :(α, β) state). evaluate (handle_adj_vars1 (LENGTH xs) (LENGTH a) x,xs ++ (a ++ env),r) = evaluate (x,xs ++ env,r)
evaluate_handle_adj_vars_typed=∀(xs :v list) (l :num) (a :v list) (env :v list) (r :(α, β) state). l ≤ LENGTH env ⇒ evaluate ([handle_adj_vars (LENGTH xs) (l + LENGTH a) (x2 :bvl$exp)],xs ++ (a ++ env),r) = evaluate ([handle_adj_vars (LENGTH xs) l x2],xs ++ env,r)
handle_adj_vars_evaluate_typed=(∀(env :v list). evaluate ([(x1 :bvl$exp)],env,(r :(α, β) state)) = evaluate ([(x2 :bvl$exp)],env,r)) ∧ (d :num) + (l :num) ≤ LENGTH (env :v list) ⇒ evaluate ([handle_adj_vars d l x1],env,r) = evaluate ([handle_adj_vars d l x2],env,r)
evaluate_handle_simp_typed=(∀(x :bvl$exp) (env :v list) (s :(α, β) state). evaluate ([handle_simp x],env,s) = evaluate ([x],env,s)) ∧ (∀(xs :bvl$exp list) (env :v list) (s :(α, β) state). evaluate (handle_simp_list xs,env,s) = evaluate (xs,env,s)) ∧ ∀(x1 :bvl$exp) (x2 :bvl$exp) (l :num) (env :v list) (s :(α, β) state). l ≤ LENGTH env ⇒ evaluate ([make_handle x1 x2 l],env,s) = evaluate ([(Handle x1 (handle_adj_vars (1 :num) l x2) :bvl$exp)],env,s)
compile_correct_typed=evaluate ([(x :bvl$exp)],(env :v list),(s1 :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ (k :num) = LENGTH env ⇒ evaluate ([(compile_exp (l :num) k x :bvl$exp)],env,s1) = (res,s2)
compile_any_correct_typed=evaluate ([(x :bvl$exp)],(env :v list),(s1 :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ (k :num) = LENGTH env ⇒ evaluate ([compile_any (split_seq :bool) (l :num) k x],env,s1) = (res,s2)
compile_seqs_correct_typed=∀(l :num) (x :bvl$exp) (acc :bvl$exp option) (s1 :(α, β) state) (s2 :(α, β) state) (s3 :(α, β) state) (res :(v list, v) result) (res3 :(v list, v) result). evaluate ([x],([] :v list),s1) = (res,s2) ∧ (∀(y :bvl$exp) (r :v list). acc = SOME y ∧ res = (Rval r :(v list, v) result) ⇒ res3 ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ evaluate ([y],([] :v list),s2) = (res3,s3)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([compile_seqs l x acc],([] :v list),s1) = if acc = (NONE :bvl$exp option) then (res,s2) else case res of (Rval v2 :(v list, v) result) => (res3,s3) | (Rerr v3 :(v list, v) result) => (res,s2)
get_code_labels_handle_adj_vars_replay=(∀(x :bvl$exp) (d :num) (l :num). get_code_labels (handle_adj_vars d l x) = get_code_labels x) ∧ ∀(x :bvl$exp list) (d :num) (l :num). MAP get_code_labels (handle_adj_vars1 d l x) = MAP get_code_labels x
get_code_labels_dest_handle_Raise_replay=∀(c :bvl$exp) (x :bvl$exp). dest_handle_Raise c = SOME x ⇒ get_code_labels c = get_code_labels x
LetLet_code_labels_typed=get_code_labels (LetLet (x :num) (y :α sptree$num_map) (z :bvl$exp)) = get_code_labels z
handle_ok_EVERY_typed=∀(xs :bvl$exp list). handle_ok xs ⇔ EVERY (λ(x :bvl$exp). handle_ok [x]) xs
compile_handle_ok_typed=∀(l :num) (n :num) (xs :bvl$exp list). handle_ok (FST (compile l n xs :bvl$exp list # db_var_set # num # bool))
compile_exp_handle_ok_typed=handle_ok [(compile_exp (l :num) (n :num) (x :bvl$exp) :bvl$exp)]
compile_seqs_handle_ok_typed=∀(l :num) (x :bvl$exp) (acc :bvl$exp option). (∀(y :bvl$exp). acc = SOME y ⇒ handle_ok [y] ∧ bVarBound (0 :num) [y]) ⇒ handle_ok [compile_seqs l x acc]
compile_any_handle_ok_typed=handle_ok [compile_any (split_seq :bool) (l :num) (n :num) (x :bvl$exp)]
bVarBound_compile_typed=∀(l :num) (n :num) (xs :bvl$exp list) (m :num). n ≤ m ⇒ bVarBound m (FST (compile l n xs :bvl$exp list # db_var_set # num # bool))
compile_exp_bVarBound_typed=bVarBound (n :num) [(compile_exp (l :num) n (x :bvl$exp) :bvl$exp)]
compile_seqs_bVarBound_typed=∀(l :num) (x :bvl$exp) (acc :bvl$exp option). (∀(y :bvl$exp). acc = SOME y ⇒ bVarBound (0 :num) [y]) ⇒ bVarBound (0 :num) [compile_seqs l x acc]
bVarBound_OptionalLetLet_typed=bVarBound (m :num) [(e :bvl$exp)] ∧ (n :num) ≤ m ⇒ bVarBound m (FST (OptionalLetLet e n (l :db_var_set) (s :num) (limit :num) (nr :bool)))
compile_IMP_bVarBound_typed=(compile (l :num) (n :num) (xs :bvl$exp list) :bvl$exp list # db_var_set # num # bool) = ((ys :bvl$exp list),(l2 :db_var_set),(s2 :num # bool)) ⇒ bVarBound n ys
handle_ok_OptionalLetLet_typed=handle_ok [(e :bvl$exp)] ∧ bVarBound (n :num) [e] ⇒ handle_ok (FST (OptionalLetLet e n (lx :db_var_set) (s :num) (l :num) (nr :bool)))
handle_ok_Var_Const_list_typed=EVERY (λ(x :bvl$exp). ∃(v :num) (i :int). x = (Var v :bvl$exp) ∨ x = (Op (IntOp (Const i)) ([] :bvl$exp list) :bvl$exp)) (xs :bvl$exp list) ⇒ handle_ok xs
compile_length_typed=∀(l :num) (n :num) (xs :bvl$exp list). LENGTH (FST (compile l n xs :bvl$exp list # db_var_set # num # bool)) = LENGTH xs
compile_IMP_LENGTH_typed=(compile (l :num) (n :num) (xs :bvl$exp list) :bvl$exp list # db_var_set # num # bool) = ((ys :bvl$exp list),(l1 :db_var_set),(s1 :num # bool)) ⇒ LENGTH ys = LENGTH xs
compile_code_labels_typed=∀(a :num) (b :num) (c :bvl$exp list). BIGUNION (set (MAP get_code_labels (FST (compile a b c :bvl$exp list # db_var_set # num # bool)))) ⊆ BIGUNION (set (MAP get_code_labels c))
get_code_labels_handle_simp_typed=(∀(c :bvl$exp). get_code_labels (handle_simp c) ⊆ get_code_labels c) ∧ (∀(c :bvl$exp list). BIGUNION (set (MAP get_code_labels (handle_simp_list c))) ⊆ BIGUNION (set (MAP get_code_labels c))) ∧ ∀(c :bvl$exp) (d :bvl$exp) (l :num). get_code_labels (make_handle c d l) ⊆ get_code_labels c ∪ get_code_labels d
compile_exp_code_labels_typed=∀(a :num) (b :num) (c :bvl$exp). get_code_labels (compile_exp a b c :bvl$exp) ⊆ get_code_labels c
compile_seqs_code_labels_typed=∀(cut :num) (e :bvl$exp) (acc :bvl$exp option). get_code_labels (compile_seqs cut e acc) ⊆ get_code_labels e ∪ case acc of (NONE :bvl$exp option) => (∅ :num -> bool) | SOME r => get_code_labels r
bVarBound_SmartLet_typed=bVarBound (m :num) [SmartLet (x :bvl$exp list) (xs :bvl$exp)] ⇔ bVarBound m [(Let x xs :bvl$exp)]
bVarBound_CONS_typed=bVarBound (m :num) [(x :bvl$exp)] ∧ bVarBound m (xs :bvl$exp list) ⇒ bVarBound m (x::xs)
OptionalLetLet_nr_typed=((ys :bvl$exp list),(l :db_var_set),(s' :num),(nr' :bool)) = OptionalLetLet (e :bvl$exp) (LENGTH (env :α list)) (lx :db_var_set) (s1 :num) (limit :num) (nr :bool) ⇒ (nr' ⇔ nr)
env_rel_def_typed=∀(l :db_var_set) (env :α list) (env1 :α list). (env_rel l env env1 :bool) ⇔ LIST_RELi (λ(i :num) (v1 :α) (v2 :α). has_var i l ⇒ v1 = v2) env env1
LIST_RELi_EL_EQN_typed=LIST_RELi (R :num -> α -> β -> bool) (l1 :α list) (l2 :β list) ⇔ LENGTH l1 = LENGTH l2 ∧ ∀(i :num). i < LENGTH l1 ⇒ R i l1❲i❳ l2❲i❳
env_rel_refl_typed=(env_rel (l :db_var_set) (env :α list) env :bool)
env_rel_length_typed=(env_rel (l :db_var_set) (env :α list) (env1 :α list) :bool) ⇒ LENGTH env1 = LENGTH env
env_rel_mk_Union_typed=∀(env :α list) (env1 :α list). (env_rel (mk_Union (lx :db_var_set) (ly :db_var_set)) env env1 :bool) ⇔ (env_rel lx env env1 :bool) ∧ (env_rel ly env env1 :bool)
env_rel_MAPi_typed=(env_rel (l1 :db_var_set) (env :v list) (MAPi (λ(i :num) (v :v). if has_var i l1 then v else (Number (0 :int) :v)) env) :bool)
evaluate_LetLet_typed=(∀(env2 :v list) (extra :v list). (env_rel (l1 :db_var_set) (env :v list) env2 :bool) ⇒ evaluate ([(y :bvl$exp)],env2 ++ extra,(s1 :(α, β) state)) = (res :(v list, v) result # (α, β) state)) ∧ (env_rel l1 env (env1 :v list) :bool) ⇒ evaluate ([LetLet (LENGTH env) (db_to_set l1) y],env1 ++ (extra :v list),s1) = res
evaluate_SmartLet_typed=evaluate ([SmartLet (xs :bvl$exp list) (x :bvl$exp)],(env :v list),(s :(α, β) state)) = evaluate ([(Let xs x :bvl$exp)],env,s)
bVarBound_MEM_typed=bVarBound (n :num) (xs :bvl$exp list) ⇔ ∀(x :bvl$exp). MEM x xs ⇒ bVarBound n [x]
bVarBound_LESS_EQ_typed=∀(m :num) (xs :bvl$exp list) (n :num). bVarBound m xs ∧ m ≤ n ⇒ bVarBound n xs
bVarBound_LetLet_typed=bVarBound (m :num) [(y :bvl$exp)] ∧ (n :num) ≤ m ⇒ bVarBound m [LetLet n (l1 :sptree$num_set) y]
