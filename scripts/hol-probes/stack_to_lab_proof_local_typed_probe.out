FLOOKUP_regs_typed=∀(regs :num list) (n :num) (v :α word_loc) (f :β) (s :(α, γ, δ) labSem$state). FLOOKUP ((FEMPTY :num |-> α word_loc) |++ MAP (λ(r :num). (r,(read_reg r s :α word_loc))) regs) n = SOME v ⇒ (read_reg n s :α word_loc) = v
MAP_FST_compile_compile_typed=MAP (FST :num # α prog -> num) (compile (jump :bool) (off :α word # α word) (gen :bool) (max_heap :num) (k :num) InitGlobals_location (compile (c :data_to_word$config) (compile (code :(num # α prog) list) :(num # α prog) list) :(num # α prog) list) :(num # α prog) list) = (0 :num)::(1 :num)::(2 :num)::gc_stub_location::MAP (FST :num # α prog -> num) code
MAP_prog_to_section_FST_typed=MAP (λ(s :α sec). case s of Section n v => n) (MAP (prog_to_section :num # α prog -> α sec) (prog :(num # α prog) list)) = MAP (FST :num # α prog -> num) prog
NOT_bad_fun_return_IMP_SOME_typed=¬bad_fun_return (q :α stackSem$result option) ⇒ ∃(n :α stackSem$result). q = SOME n
UNCURRY_PAIR_ETA_typed=UNCURRY (f :α -> β -> γ) = (λ((p1 :α),(p2 :β)). f p1 p2)
asm_fetch_aux_SOME_append_typed=∀(pc :num) (code :α sec list) (l :α line) (code2 :α sec list). asm_fetch_aux pc code = SOME l ⇒ asm_fetch_aux pc (code ++ code2) = SOME l
asm_fetch_aux_SOME_isPREFIX_typed=∀(pc :num) (code :α sec list) (l :α line) (code2 :α sec list). asm_fetch_aux pc code = SOME l ∧ code ≼ code2 ⇒ asm_fetch_aux pc code2 = SOME l
code_installed_prime_cons_label_typed=∀(lines :α line list) (pos :num). is_Label (h :α line) ⇒ (code_installed' pos lines (Section (n :num) (h::(xs :α line list))::(other :α sec list)) ⇔ code_installed' pos lines (Section n xs::other))
code_installed_prime_cons_non_label_typed=∀(lines :α line list) (pos :num). ¬is_Label (h :α line) ⇒ (code_installed' (pos + (1 :num)) lines (Section (n :num) (h::(xs :α line list))::(other :α sec list)) ⇔ code_installed' pos lines (Section n xs::other))
code_installed_prime_def_typed=(∀(n :num) (code :α sec list). code_installed' n ([] :α line list) code ⇔ T) ∧ ∀(n :num) (x :α line) (xs :α line list) (code :α sec list). code_installed' n (x::xs) code ⇔ if is_Label x then code_installed' n xs code else asm_fetch_aux n code = SOME x ∧ code_installed' (n + (1 :num)) xs code
code_installed_prime_simp_typed=∀(lines :α line list). code_installed' (0 :num) lines (Section (n :num) (lines ++ (rest :α line list))::(other :α sec list))
code_installed_get_labels_IMP_typed=∀(top :bool) (e :α prog) (n :num) (q :num) (cs :num list) (bs :num list) (pc :num). code_installed pc (append (FST (flatten top e n q cs bs))) (c :α sec list) ∧ ((l1 :num),(l2 :num)) ∈ get_labels e ⇒ ∃(v :num). loc_to_pc l1 l2 c = SOME v
code_installed_prog_to_section_lemma_typed=∀(prog4 :(num # α prog) list) (n :num) (prog3 :α prog). ALOOKUP prog4 n = SOME prog3 ⇒ ∃(pc :num). code_installed' pc (append (FST (flatten T prog3 n (next_lab prog3 (2 :num)) ([] :num list) ([] :num list)))) (MAP (prog_to_section :num # α prog -> α sec) prog4) ∧ loc_to_pc n (0 :num) (MAP (prog_to_section :num # α prog -> α sec) prog4) = SOME pc
complex_flatten_labels_typed=∀(t :bool) (p :α prog) (n :num) (m :num) (cs :num list) (bs :num list). (let (pp :α line -> bool) = set (append (FST (flatten t p n m cs bs))) in BIGUNION (IMAGE (line_get_labels :α line -> num # num -> bool) pp) ⊆ (n,(0 :num)) INSERT (n,if t ∧ ∃(p1 :α prog) (p2 :α prog). p = Seq p1 p2 then (1 :num) else (0 :num)) INSERT set (MAP (λ(l :num). (n,l)) (cs ++ bs)) ∪ IMAGE (λ(n2 :num). (n,n2)) (BIGUNION (IMAGE (line_get_code_labels :α line -> num -> bool) pp)) ∪ complex_get_code_labels p)
dest_to_loc_prime_def_typed=∀(regs :α -> β word_loc) (dest :num + α). dest_to_loc' regs dest = case dest of (INL p :num + α) => p | (INR r :num + α) => case regs r of Word v => (ARB :num) | (Loc loc v3 :β word_loc) => loc
extract_label_store_list_code_typed=∀(a :num) (t :num) (ls :(α word + num) list). extract_labels (store_list_code a t ls) = ([] :(num # num) list)
flatten_labels_typed=∀(t :bool) (m :α prog) (n :num) (p :num) (cs :num list) (bs :num list) (l :α line app_list) (x :bool) (y :num). flatten t m n p cs bs = (l,x,y) ∧ EVERY (sec_label_ok n :α line -> bool) (append l) ⇒ BIGUNION (IMAGE (line_get_labels :α line -> num # num -> bool) (set (append l))) ⊆ set (MAP (λ(l :num). (n,l)) (cs ++ bs)) ∪ sec_get_code_labels (Section n (append l)) ∪ (get_code_labels m :num # num -> bool)
flatten_line_ok_pre_typed=∀(t :bool) (p :α prog) (n :num) (m :num) (cs :num list) (bs :num list) (ls :α line app_list) (a :bool) (b :num) (c :α asm_config). byte_offset_ok c (0w :α word) ∧ stack_asm_ok c p ∧ flatten t p n m cs bs = (ls,a,b) ⇒ EVERY (line_ok_pre c) (append ls)
get_code_labels_comp_typed=∀(f :num sptree$num_map) (p :α prog). complex_get_code_labels (comp f p :α prog) = complex_get_code_labels p
halt_assum_lemma_typed=halt_assum (:'ffi # γ) (fromAList (compile (f :num sptree$num_map) (compile (jump :bool) (off :α word # α word) (gen :bool) (max_heap :num) (k :num) (l :num) (code :(num # α prog) list) :(num # α prog) list) :(num # α prog) list))
init_stubs_labels_typed=EVERY (λ(p :α prog). (get_code_labels p :num # num -> bool) ⊆ set [((1 :num),(0 :num)); ((start :num),(0 :num))]) (MAP (SND :num # α prog -> α prog) (init_stubs (ggc :bool) (mh :num) (k :num) start :(num # α prog) list))
prog_to_section_preserves_MAP_FST_typed=∀(p :(num # α prog) list). IMAGE (λ(n :num). (n,(0 :num))) (set (MAP (FST :num # α prog -> num) p)) ⊆ (get_code_labels (MAP (prog_to_section :num # α prog -> α sec) p) :num # num -> bool)
stack_alloc_get_code_labels_comp_typed=∀(n :num) (m :num) (p :α prog) (pp :β) (mm :γ). (get_code_labels (FST (comp n m p :α prog # num)) :num # num -> bool) ⊆ (gc_stub_location,(0 :num)) INSERT (get_code_labels p :num # num -> bool)
stack_alloc_init_code_labels_typed=(get_code_labels (word_gc_code (c :data_to_word$config) :α prog) :num # num -> bool) = (∅ :num # num -> bool)
stack_alloc_stack_get_handler_labels_comp_typed=∀(n :num) (m :num) (p :α prog) (pp :β) (mm :γ). stack_get_handler_labels (i :num) (FST (comp n m p :α prog # num)) = stack_get_handler_labels i p
stack_names_get_code_labels_comp_typed=∀(f :num sptree$num_map) (p :α prog). (get_code_labels (comp f p :α prog) :num # num -> bool) = (get_code_labels p :num # num -> bool)
stack_names_stack_get_handler_labels_comp_typed=∀(f :num sptree$num_map) (p :α prog) (n :num). stack_get_handler_labels n (comp f p :α prog) = stack_get_handler_labels n p
stack_remove_get_code_labels_comp_typed=∀(a :bool) (b :α word # α word) (c :num) (p :α prog). (get_code_labels (comp a b c p :α prog) :num # num -> bool) ⊆ (stack_err_lab,(0 :num)) INSERT (get_code_labels p :num # num -> bool)
stack_remove_init_code_labels_typed=(x :num # num) ∈ (get_code_labels (init_code (ggc :bool) (mh :num) (sp :num) :α prog) :num # num -> bool) ⇒ x = ((1 :num),(0 :num))
stack_remove_stack_get_handler_labels_comp_typed=∀(a :bool) (b :α word # α word) (c :num) (p :α prog) (m :num). stack_get_handler_labels m (comp a b c p :α prog) = stack_get_handler_labels m p
