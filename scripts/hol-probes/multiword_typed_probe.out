multiword_probe_begin=1
multiword_DIV_thm1_typed=(0 :num) < (b :num) ∧ b ≤ (c :num) ⇒ (a :num) DIV c ≤ a DIV b
multiword_DIV_thm2_typed=(0 :num) < (b :num) ∧ (a :num) < (c :num) * b ⇒ a DIV b < c
multiword_DIV_thm3_typed=∀(a :num) (b :num). (0 :num) < b ⇒ a DIV b * b ≤ a
multiword_DIV_thm4_typed=∀(a :num) (b :num). (0 :num) < b ⇒ a − a DIV b * b < b
multiword_DIV_thm4_bis_typed=∀(a :num) (b :num). (0 :num) < b ⇒ a < b + a DIV b * b
multiword_DIV_thm5_typed=(0 :num) < (b :num) ∧ (a :num) − (q :num) * b < b ⇒ q ≥ a DIV b
multiword_EQ_A_S_R_2_typed=∀(c :num) (d :num) (a :num) (b :num). d ≤ c ∧ a + c < b + d ⇒ a < b
multiword_HD_eq_n2w_mw2n_typed=LENGTH (xs :α word list) ≠ (0 :num) ∧ mw2n xs < dimword (:α) ⇒ HD xs = (n2w (mw2n xs) :α word)
multiword_LAST_FRONT_mw_mul_by_single_NOT_ZERO_typed=mw_ok (ys :α word list) ∧ ys ≠ ([] :α word list) ∧ (2 :num) < dimword (:α) ⇒ LAST (FRONT (mw_mul_by_single (calc_d (LAST ys,(1w :α word))) ys)) ≠ (0w :α word)
multiword_LENGTH_LESS_IMP_mw2n_LESS_typed=∀(xs :α word list) (ys :α word list). mw_ok xs ∧ mw_ok ys ∧ LENGTH xs < LENGTH ys ⇒ mw2n xs < mw2n ys
multiword_LENGTH_k2mw_typed=∀(k :num) (n :num). LENGTH (k2mw k n :α word list) = k
multiword_LENGTH_mw_add_typed=∀(xs1 :α word list) (ys :α word list) (c :bool) (qs1 :α word list) (c1 :bool). mw_add xs1 ys c = (qs1,c1) ⇒ LENGTH xs1 = LENGTH qs1
multiword_LENGTH_mw_addv_typed=LENGTH (ys :α word list) ≤ LENGTH (xs :α word list) ⇒ LENGTH (mw_addv xs ys F) ≤ LENGTH xs + LENGTH ys
multiword_LENGTH_mw_div_aux_typed=∀(ts1 :α word list) (ts2 :α word list) (ys :α word list) (qs :α word list) (rs :α word list). mw_div_aux ts1 ts2 ys = (qs,rs) ∧ LENGTH ts2 = LENGTH ys ⇒ LENGTH rs = LENGTH ys ∧ LENGTH qs = LENGTH ts1
multiword_LENGTH_mw_fix_typed=∀(xs :α word list). LENGTH (mw_fix xs) ≤ LENGTH xs
multiword_LENGTH_mw_fix_IMP_typed=LENGTH (xs :α word list) = LENGTH (ys :β list) ⇒ LENGTH (mw_fix xs) ≤ LENGTH ys
multiword_LENGTH_mw_mul_typed=∀(xs :α word list) (ys :α word list) (zs :α word list). LENGTH zs = LENGTH ys ⇒ LENGTH (mw_mul xs ys zs) = LENGTH xs + LENGTH ys
multiword_LENGTH_mw_mul_by_single_typed=LENGTH (mw_mul_by_single (x :α word) (ys :α word list)) = LENGTH ys + (1 :num)
multiword_LENGTH_mw_mul_pass_typed=∀(ys :α word list) (zs :α word list) (x :α word) (k :α word). LENGTH (mw_mul_pass x ys zs k) = LENGTH ys + (1 :num)
multiword_LENGTH_mw_shift_typed=∀(xs :α word list). LENGTH (mw_shift xs) = LENGTH xs
multiword_LENGTH_mw_simple_div_typed=∀(xs :α word list) (x :α word) (ys :α word) (qs :α word list) (r :α word) (c :bool). mw_simple_div x xs ys = (qs,r,c) ⇒ LENGTH xs = LENGTH qs
multiword_LENGTH_mw_sub_typed=∀(xs1 :α word list) (ys :α word list) (c :bool) (qs1 :α word list) (c1 :bool). mw_sub xs1 ys c = (qs1,c1) ⇒ LENGTH xs1 = LENGTH qs1
multiword_LENGTH_mw_subv_typed=∀(ys :α word list) (xs :α word list). LENGTH xs ≤ LENGTH ys ⇒ LENGTH (mw_subv ys xs) ≤ LENGTH ys
multiword_LENGTH_n2mw_LESS_LENGTH_n2mw_typed=∀(m :num) (n :num). m ≤ n ⇒ LENGTH (n2mw m :α word list) ≤ LENGTH (n2mw n :α word list)
multiword_LESS_2_EXP_typed=∀(n :num). n < (2 :num) ** n
multiword_LESS_EQ_LENGTH_typed=∀(xs :α list) (n :num). n ≤ LENGTH xs ⇒ ∃(xs1 :α list) (xs2 :α list). xs = xs1 ⧺ xs2 ∧ LENGTH xs1 = n
multiword_LESS_EQ_LENGTH_ALT_typed=∀(xs :α list) (n :num). n ≤ LENGTH xs ⇒ ∃(ys1 :α list) (ys2 :α list). xs = ys1 ⧺ ys2 ∧ LENGTH ys2 = n
multiword_NOT_0w_bis_typed=(w :α word) ≠ (0w :α word) ⇒ (0 :num) < w2n w
multiword_REPLICATE_SNOC_typed=∀(n :num) (x :α). REPLICATE (SUC n) x = SNOC x (REPLICATE n x)
multiword_b2n_def_typed=b2n T = (1 :num) ∧ b2n F = (0 :num)
multiword_b2w_def_typed=∀(c :bool). (b2w c :α word) = (n2w (b2n c) :α word)
multiword_calc_d_def_typed=∀(v1 :α word) (d :α word). calc_d (v1,d) = if v1 = (0w :α word) ∨ word_msb v1 then d else calc_d (v1 * (2w :α word),d * (2w :α word))
multiword_calc_d_def_primitive_typed=(calc_d :α word # α word -> α word) = WFREC (@(R :α word # α word -> α word # α word -> bool). WF R ∧ ∀(d :α word) (v1 :α word). ¬(v1 = (0w :α word) ∨ word_msb v1) ⇒ R (v1 * (2w :α word),d * (2w :α word)) (v1,d)) (λ(calc_d :α word # α word -> α word) (a :α word # α word). case a of (v1,d) => I (if v1 = (0w :α word) ∨ word_msb v1 then d else calc_d (v1 * (2w :α word),d * (2w :α word))))
multiword_calc_d_ind_typed=∀(P :α word # α word -> bool). (∀(v1 :α word) (d :α word). (¬(v1 = (0w :α word) ∨ word_msb v1) ⇒ P (v1 * (2w :α word),d * (2w :α word))) ⇒ P (v1,d)) ⇒ ∀(v :α word) (v1 :α word). P (v,v1)
multiword_d_clauses_typed=∀(vs :α word list) (v1 :α word). (0 :num) < w2n v1 ⇒ (0 :num) < w2n (calc_d (v1,(1w :α word))) ∧ mw2n (mw_mul_by_single (calc_d (v1,(1w :α word))) (REVERSE (v1::vs))) = mw2n (FRONT (mw_mul_by_single (calc_d (v1,(1w :α word))) (REVERSE (v1::vs)))) ∧ dimword (:α) DIV (2 :num) ≤ w2n (LAST (FRONT (mw_mul_by_single (calc_d (v1,(1w :α word))) (REVERSE (v1::vs)))))
multiword_d_lemma1_typed=∀(v1 :α word) (d :α word) (x :α word). calc_d (FST (v1,d),SND (v1,d) * x) = calc_d (v1,d) * x
multiword_d_lemma2_typed=∀(v1 :α word) (d :α word). FST (v1,d) ≠ (0w :α word) ⇒ dimword (:α) DIV (2 :num) ≤ w2n (calc_d (FST (v1,d),(1w :α word)) * FST (v1,d))
multiword_d_lemma2_bis_typed=∀(v1 :α word) (d :α word). FST (v1,d) ≠ (0w :α word) ⇒ calc_d (FST (v1,d),(1w :α word)) ≠ (0w :α word)
multiword_d_lemma3_typed=∀(v1 :α word) (d :α word). w2n (calc_d (FST (v1,d),(1w :α word))) * w2n (FST (v1,d)) < dimword (:α)
multiword_d_lemma4_typed=∀(v1 :α word) (d :α word). ∃(n :num). w2n (calc_d (FST (v1,d),(1w :α word))) = (2 :num) ** n
multiword_d_lemma5_typed=∀(v1 :α word) (d :α word). (2 :num) ≤ w2n (calc_d (FST (v1,d),(1w :α word))) ⇒ w2n (calc_d (FST (v1,d),(1w :α word))) * SUC (w2n (FST (v1,d))) ≤ dimword (:α)
multiword_d_word_msb_typed=∀(a :α word). word_msb a ⇔ dimword (:α) DIV (2 :num) ≤ w2n a
multiword_datatype_mw_op_typed=DATATYPE ((mw_op :mw_op -> mw_op -> mw_op -> mw_op -> mw_op -> mw_op -> mw_op -> mw_op -> bool) Add Sub Mul Div Mod Lt Eq Dec)
multiword_dimwords_def_typed=∀(k :num) (n :α itself). dimwords k n = (2 :num) ** (k * dimindex n)
multiword_dimwords_dimword_typed=∀(n :num). dimwords n (:α) = dimword (:α) ** n
multiword_i2mw_11_typed=∀(i :int) (j :int). (i2mw i :bool # α word list) = (i2mw j :bool # α word list) ⇔ i = j
multiword_i2mw_def_typed=∀(i :int). (i2mw i :bool # α word list) = (i < (0 :int),(n2mw (Num (ABS i)) :α word list))
multiword_int_op_def_typed=(∀(i :int) (j :int). int_op Add i j = i + j) ∧ (∀(i :int) (j :int). int_op Sub i j = i − j) ∧ (∀(i :int) (j :int). int_op Mul i j = i * j) ∧ (∀(i :int) (j :int). int_op Div i j = i / j) ∧ (∀(i :int) (j :int). int_op Mod i j = i % j) ∧ (∀(i :int) (j :int). int_op Lt i j = if i < j then (1 :int) else (0 :int)) ∧ (∀(i :int) (j :int). int_op Eq i j = if i = j then (1 :int) else (0 :int)) ∧ ∀(i :int) (j :int). int_op Dec i j = (0 :int)
multiword_int_to_str_def_typed=∀(i :int). int_to_str i = STRCAT (if i < (0 :int) then "~" else ("" :string)) (toString (Num (ABS i)))
multiword_k2mw_EXISTS_typed=∀(xs :α word list). ∃(k :num). xs = (k2mw (LENGTH xs) k :α word list) ∧ k < dimwords (LENGTH xs) (:α)
multiword_k2mw_LENGTH_0_typed=∀(ys :α list). (k2mw (LENGTH ys) (0 :num) :β word list) = MAP (K (0w :β word) :α -> β word) ys
multiword_k2mw_SNOC_typed=∀(k :num) (n :num). (k2mw (SUC k) n :α word list) = SNOC (n2w (n DIV dimwords k (:α)) :α word) (k2mw k n :α word list)
multiword_k2mw_compute_typed=(∀(n :num). (k2mw (0 :num) n :α word list) = ([] :α word list)) ∧ (∀(l :num) (n :num). (k2mw <..num comp'n..> n :α word list) = (n2w n :α word)::(k2mw (<..num comp'n..> − (1 :num)) (n DIV dimword (:α)) :α word list)) ∧ ∀(l :num) (n :num). (k2mw <..num comp'n..> n :α word list) = (n2w n :α word)::(k2mw <..num comp'n..> (n DIV dimword (:α)) :α word list)
multiword_k2mw_def_typed=(∀(n :num). (k2mw (0 :num) n :α word list) = ([] :α word list)) ∧ ∀(l :num) (n :num). (k2mw (SUC l) n :α word list) = (n2w n :α word)::(k2mw l (n DIV dimword (:α)) :α word list)
multiword_mw2i_def_typed=mw2i (F,(xs :α word list)) = ((&mw2n xs) :int) ∧ mw2i (T,xs) = -((&mw2n xs) :int)
multiword_mw2i_def_primitive_typed=(mw2i :bool # α word list -> int) = WFREC (@(R :bool # α word list -> bool # α word list -> bool). WF R) (λ(mw2i :bool # α word list -> int) (a :bool # α word list). case a of (T,xs) => I (-((&mw2n xs) :int)) | (F,xs) => I ((&mw2n xs) :int))
multiword_mw2i_i2mw_typed=∀(i :int). mw2i (i2mw i :bool # α word list) = i
multiword_mw2i_ind_typed=∀(P :bool # α word list -> bool). (∀(xs :α word list). P (F,xs)) ∧ (∀(xs :α word list). P (T,xs)) ⇒ ∀(v :bool) (v1 :α word list). P (v,v1)
multiword_mw2n_0_typed=mw2n ([] :β word list) = (0 :num) ∧ mw2n ((0w :α word)::(xs :α word list)) = dimword (:α) * mw2n xs
multiword_mw2n_APPEND_typed=∀(xs :α word list) (ys :α word list). mw2n (xs ⧺ ys) = mw2n xs + dimwords (LENGTH xs) (:α) * mw2n ys
multiword_mw2n_LESS_typed=∀(xs :α word list) (ys :α word list). mw_ok xs ∧ mw_ok ys ∧ mw2n xs ≤ mw2n ys ⇒ LENGTH xs ≤ LENGTH ys
multiword_mw2n_LESS_IMP_LENGTH_LESS_EQ_typed=∀(xs :α word list) (ys :α word list). mw_ok xs ∧ mw_ok ys ∧ mw2n xs < mw2n ys ⇒ LENGTH xs ≤ LENGTH ys
multiword_mw2n_def_typed=mw2n ([] :α word list) = (0 :num) ∧ ∀(x :α word) (xs :α word list). mw2n (x::xs) = w2n x + dimword (:α) * mw2n xs
multiword_mw2n_k2mw_0_typed=∀(x :num). mw2n (k2mw x (0 :num) :α word list) = (0 :num)
multiword_mw2n_msf_typed=∀(x :α word) (xs :α word list). mw2n (xs ⧺ [x]) = mw2n xs + dimwords (LENGTH xs) (:α) * w2n x
multiword_mw2n_msf_NIL_typed=∀(xs :α word list). xs ≠ ([] :α word list) ∧ mw2n xs < dimwords (LENGTH (FRONT xs)) (:α) ⇒ mw2n xs = mw2n (FRONT xs)
multiword_mw2n_n2mw_typed=∀(n :num). mw2n (n2mw n :α word list) = n
multiword_mw_add_F_typed=∀(xs2 :α word list). mw_add xs2 (MAP (λ(x :α word). (0w :α word)) xs2) F = (xs2,F)
multiword_mw_add_def_typed=(∀(ys :α word list) (c :bool). mw_add ([] :α word list) ys c = (([] :α word list),c)) ∧ ∀(x :α word) (xs :α word list) (ys :α word list) (c :bool). mw_add (x::xs) ys c = (let ((z :α word),(c1 :bool)) = single_add x (HD ys) c; ((zs :α word list),(c2 :bool)) = mw_add xs (TL ys) c1 in (z::zs,c2))
multiword_mw_addv_EQ_mw_add_typed=∀(xs1 :α word list) (xs2 :α word list) (ys :α word list) (c1 :bool). LENGTH ys = LENGTH xs1 ⇒ mw_addv (xs1 ⧺ xs2) ys c1 = (let ((zs1 :α word list),(c2 :bool)) = mw_add xs1 ys c1; ((zs2 :α word list),(c3 :bool)) = mw_add xs2 (MAP (λ(x :α word). (0w :α word)) xs2) c2 in zs1 ⧺ zs2 ⧺ if c3 then [(1w :α word)] else ([] :α word list))
multiword_mw_addv_NIL_typed=mw_addv ([] :α word list) ([] :α word list) T = [(1w :α word)] ∧ (∀(xs :α word list). mw_addv xs ([] :α word list) F = xs) ∧ ∀(xs :α word list) (x :α word). mw_addv (x::xs) ([] :α word list) T = if x = ¬(0w :α word) then (0w :α word)::mw_addv xs ([] :α word list) T else x + (1w :α word)::xs
multiword_mw_addv_def_typed=(∀(ys :α word list) (c :bool). mw_addv ([] :α word list) ys c = if c then [(1w :α word)] else ([] :α word list)) ∧ ∀(x :α word) (xs :α word list) (ys :α word list) (c :bool). mw_addv (x::xs) ys c = (let ((y :α word),(ys2 :α word list)) = if ys = ([] :α word list) then ((0w :α word),ys) else (HD ys,TL ys); ((z :α word),(c1 :bool)) = single_add x y c in z::mw_addv xs ys2 c1)
multiword_mw_cmp_alt_def_typed=(∀(ys :α word list) (b :bool option). mw_cmp_alt ([] :α word list) ys b = b) ∧ ∀(x :α word) (xs :α word list) (ys :α word list) (b :bool option). mw_cmp_alt (x::xs) ys b = mw_cmp_alt xs (TL ys) (if x = HD ys then b else if x <₊ HD ys then SOME T else SOME F)
multiword_mw_cmp_alt_thm_typed=LENGTH (xs :α word list) = LENGTH (ys :α word list) ⇒ mw_cmp xs ys = mw_cmp_alt xs ys (NONE :bool option)
multiword_mw_cmp_def_typed=∀(ys :α word list) (xs :α word list). mw_cmp xs ys = if xs = ([] :α word list) then (NONE :bool option) else if LAST xs = LAST ys then mw_cmp (FRONT xs) (FRONT ys) else SOME (LAST xs <₊ LAST ys)
multiword_mw_cmp_ind_typed=∀(P :α word list -> α word list -> bool). (∀(xs :α word list) (ys :α word list). (xs ≠ ([] :α word list) ∧ LAST xs = LAST ys ⇒ P (FRONT xs) (FRONT ys)) ⇒ P xs ys) ⇒ ∀(v :α word list) (v1 :α word list). P v v1
multiword_mw_cmp_thm_typed=∀(xs :α word list) (ys :α word list). LENGTH ys = LENGTH xs ⇒ mw_cmp xs ys = if mw2n xs = mw2n ys then (NONE :bool option) else SOME (mw2n xs < mw2n ys)
multiword_mw_compare_def_typed=∀(xs :α word list) (ys :α word list). mw_compare xs ys = if LENGTH xs < LENGTH ys then SOME ((0 :num) < (1 :num)) else if LENGTH ys < LENGTH xs then SOME ((1 :num) < (0 :num)) else mw_cmp xs ys
multiword_mw_compare_thm_typed=∀(xs :α word list) (ys :α word list). mw_ok xs ∧ mw_ok ys ⇒ mw_compare xs ys = if mw2n xs = mw2n ys then (NONE :bool option) else SOME (mw2n xs < mw2n ys)
multiword_mw_div_adjust_def_typed=∀(q :α word) (zs :α word list) (ys :α word list). mw_div_adjust q zs ys = if mw_cmp zs (mw_mul_by_single q ys) = SOME T then (n2w (w2n q − (1 :num)) :α word) else q
multiword_mw_div_aux_def_typed=∀(zs2 :α word list) (zs1 :α word list) (ys :α word list). mw_div_aux zs1 zs2 ys = if zs1 = ([] :α word list) then (([] :α word list),zs2) else (let (zs2' :α word list) = LAST zs1::zs2; (zs1' :α word list) = FRONT zs1; (q :α word) = mw_div_guess (REVERSE zs2') (REVERSE ys); (q' :α word) = mw_div_adjust q zs2' ys; (zs2'' :α word list) = FST (mw_sub zs2' (mw_mul_by_single q' ys) T); ((qs :α word list),(rs :α word list)) = mw_div_aux zs1' (FRONT zs2'') ys in (q'::qs,rs))
multiword_mw_div_aux_ind_typed=∀(P :α word list -> α word list -> α word list -> bool). (∀(zs1 :α word list) (zs2 :α word list) (ys :α word list). (∀(zs2' :α word list) (zs1' :α word list) (q :α word) (q' :α word) (zs2'' :α word list). zs1 ≠ ([] :α word list) ∧ zs2' = LAST zs1::zs2 ∧ zs1' = FRONT zs1 ∧ q = mw_div_guess (REVERSE zs2') (REVERSE ys) ∧ q' = mw_div_adjust q zs2' ys ∧ zs2'' = FST (mw_sub zs2' (mw_mul_by_single q' ys) T) ⇒ P zs1' (FRONT zs2'') ys) ⇒ P zs1 zs2 ys) ⇒ ∀(v :α word list) (v1 :α word list) (v2 :α word list). P v v1 v2
multiword_mw_div_by_single_LENGTH_typed=∀(x :α word) (xs :α word list) (y :α word). w2n x < w2n y ⇒ LENGTH (mw_div_by_single (x::xs) y) = SUC (LENGTH xs)
multiword_mw_div_by_single_def_typed=(∀(y :α word). mw_div_by_single ([] :α word list) y = [(0w :α word)]) ∧ (∀(y :α word) (x :α word). mw_div_by_single [x] y = (λ((a :α word),(b :α word)). if w2n x < w2n y then [b] else [a; b]) (single_div (0w :α word) x y)) ∧ ∀(y :α word) (xs :α word list) (x2 :α word) (x1 :α word). mw_div_by_single (x1::x2::xs) y = if w2n x1 < w2n y ∨ w2n y = (0 :num) then (let ((q :α word),(r :α word)) = single_div x1 x2 y in q::mw_div_by_single (r::xs) y) else (let ((q :α word),(r :α word)) = single_div (0w :α word) x1 y in q::mw_div_by_single (r::x2::xs) y)
multiword_mw_div_by_single_ind_typed=∀(P :α word list -> α word -> bool). (∀(y :α word). P ([] :α word list) y) ∧ (∀(x :α word) (y :α word). P [x] y) ∧ (∀(x1 :α word) (x2 :α word) (xs :α word list) (y :α word). (∀(q :α word) (r :α word). ¬(w2n x1 < w2n y ∨ w2n y = (0 :num)) ∧ (q,r) = single_div (0w :α word) x1 y ⇒ P (r::x2::xs) y) ∧ (∀(q :α word) (r :α word). (w2n x1 < w2n y ∨ w2n y = (0 :num)) ∧ (q,r) = single_div x1 x2 y ⇒ P (r::xs) y) ⇒ P (x1::x2::xs) y) ⇒ ∀(v :α word list) (v1 :α word). P v v1
multiword_mw_div_by_single_thm_typed=∀(xs :α word list) (y :α word). (0 :num) < w2n y ⇒ mw2n (REVERSE xs) = mw2n (mw_mul_by_single y (REVERSE (FRONT (mw_div_by_single xs y)))) + w2n (LAST (mw_div_by_single xs y))
