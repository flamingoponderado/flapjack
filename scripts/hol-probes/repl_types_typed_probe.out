simple_type_typed=Bool::simple_type; Str::simple_type; Exn::simple_type
to_type_def_typed=to_type Bool = Infer_Tapp ([] :infer_t list) Tbool_num ∧ to_type Str = Infer_Tapp ([] :infer_t list) Tstring_num ∧ to_type Exn = Infer_Tapp ([] :infer_t list) Texn_num
to_type_TS_def_typed=to_type_TS Bool = Tapp ([] :t list) Tbool_num ∧ to_type_TS Str = Tapp ([] :t list) Tstring_num ∧ to_type_TS Exn = Tapp ([] :t list) Texn_num
roll_back_def_typed=∀(old_ienv :inf_env) (old_next_id :num) (new_ienv :inf_env) (new_next_id :num). (roll_back (old_ienv,old_next_id) (new_ienv,new_next_id) :inf_env # num) = (old_ienv,new_next_id)
FST_roll_back_typed=FST (roll_back (x :inf_env # num) (y :inf_env # num) :inf_env # num) = FST x
SND_roll_back_typed=SND (roll_back (x :inf_env # num) (y :inf_env # num) :inf_env # num) = SND y
convert_t_to_type_typed=convert_t (to_type (t :simple_type)) = to_type_TS t
DISJOINT_set_ids_typed=(tids :num -> bool) ⊆ count (id :num) ⇒ DISJOINT tids (set_ids id (id' :num))
set_ids_SUBSET_typed=set_ids (id :num) (id' :num) ⊆ count id'
set_ids_UNION_typed=(id :num) ≤ (id' :num) ∧ (sid :num) ≤ id ⇒ set_ids sid id' = set_ids sid id ∪ set_ids id id'
check_ref_types_def_typed=∀(types :inf_env) (env :v sem_env) (name :(mlstring, mlstring) id) (ty :simple_type) (loc :num). check_ref_types types env (name,ty,loc) ⇔ nsLookup types.inf_v name = SOME ((0 :num),Infer_Tapp [to_type ty] Tref_num) ∧ nsLookup env.v name = SOME (Loc T loc :v)
check_ref_types_TS_def_typed=∀(types :type_env) (env :v sem_env) (name :(mlstring, mlstring) id) (ty :simple_type) (loc :num). check_ref_types_TS types env (name,ty,loc) ⇔ nsLookup types.v name = SOME ((0 :num),Tapp [to_type_TS ty] Tref_num) ∧ nsLookup env.v name = SOME (Loc T loc :v)
