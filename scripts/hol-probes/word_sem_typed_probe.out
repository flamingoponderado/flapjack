is_word_def_typed=(is_word (Word (w :α word)) ⇔ T) ∧ (is_word (Loc (v1 :num) (v2 :num) :α word_loc) ⇔ F)
isWord_def_typed=(isWord (Word (w :α word)) ⇔ T) ∧ (isWord (Loc (v1 :num) (v2 :num) :α word_loc) ⇔ F)
theWord_def_typed=∀(w :α word). theWord (Word w) = w
word_cmp_def_typed=(word_cmp Equal (Word (w1 :α word)) (Word (w2 :α word)) :bool option) = SOME (w1 = w2) ∧ (word_cmp Less (Word w1) (Word w2) :bool option) = SOME (w1 < w2) ∧ (word_cmp Lower (Word w1) (Word w2) :bool option) = SOME (w1 <₊ w2) ∧ (word_cmp Test (Word w1) (Word w2) :bool option) = SOME (w1 && w2 = (0w :α word)) ∧ (word_cmp Test (Loc (v0 :num) (n :num) :α word_loc) (Word w2) :bool option) = (if n ≠ (0 :num) then (NONE :bool option) else if w2 = (1w :α word) then SOME T else (NONE :bool option)) ∧ (word_cmp NotEqual (Word w1) (Word w2) :bool option) = SOME (w1 ≠ w2) ∧ (word_cmp NotLess (Word w1) (Word w2) :bool option) = SOME (¬(w1 < w2)) ∧ (word_cmp NotLower (Word w1) (Word w2) :bool option) = SOME (¬(w1 <₊ w2)) ∧ (word_cmp NotTest (Word w1) (Word w2) :bool option) = SOME (w1 && w2 ≠ (0w :α word)) ∧ (word_cmp NotTest (Loc (v1 :num) n :α word_loc) (Word w2) :bool option) = (if n ≠ (0 :num) then (NONE :bool option) else if w2 = (1w :α word) then SOME F else (NONE :bool option)) ∧ (word_cmp (v2 :cmp) (Word (v8 :α word)) (Loc (v15 :num) (v16 :num) :α word_loc) :bool option) = (NONE :bool option) ∧ (word_cmp Equal (Loc (v9 :num) (v10 :num) :α word_loc) (Word (v20 :α word)) :bool option) = (NONE :bool option) ∧ (word_cmp Lower (Loc v9 v10 :α word_loc) (Word v20) :bool option) = (NONE :bool option) ∧ (word_cmp Less (Loc v9 v10 :α word_loc) (Word v20) :bool option) = (NONE :bool option) ∧ (word_cmp NotEqual (Loc v9 v10 :α word_loc) (Word v20) :bool option) = (NONE :bool option) ∧ (word_cmp NotLower (Loc v9 v10 :α word_loc) (Word v20) :bool option) = (NONE :bool option) ∧ (word_cmp NotLess (Loc v9 v10 :α word_loc) (Word v20) :bool option) = (NONE :bool option) ∧ (word_cmp v2 (Loc v9 v10 :α word_loc) (Loc (v21 :num) (v22 :num) :α word_loc) :bool option) = (NONE :bool option)
alloc_def_typed=∀(w :α word) (names :sptree$num_set # sptree$num_set) (s :(α, γ, 'ffi) state). alloc w names s = case cut_envs names s.locals of (NONE :(α word_loc sptree$num_map # α word_loc sptree$num_map) option) => (SOME (Error :α result),flush_state T s) | SOME envs => case gc (push_env envs (NONE :(num # α prog # num # num) option) (set_store AllocSize (Word w) s)) of (NONE :(α, γ, 'ffi) state option) => (SOME (Error :α result),flush_state T s) | SOME v2 => case pop_env v2 of (NONE :(α, γ, 'ffi) state option) => (SOME (Error :α result),flush_state T v2) | SOME v1 => case get_store AllocSize v1 of (NONE :α word_loc option) => (SOME (Error :α result),v1) | SOME w => case has_space w v1 of (NONE :bool option) => (SOME (Error :α result),v1) | SOME T => ((NONE :α result option),v1) | SOME F => (SOME (NotEnoughSpace :α result),flush_state T v1)
