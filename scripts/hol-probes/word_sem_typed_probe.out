mem_store_def_typed=∀(addr :α word) (w :α word_loc) (s :(α, γ, 'ffi) state). mem_store addr w s = if addr ∈ s.mdomain then SOME (s with memory := s.memory⦇addr ↦ w⦈) else (NONE :(α, γ, 'ffi) state option)
