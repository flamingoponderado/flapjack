word_exp_def_typed=(∀(w :α word) (s :(α, γ, 'ffi) state). (word_exp s (Const w :α exp) :α word_loc option) = SOME (Word w)) ∧ (∀(v :num) (s :(α, γ, 'ffi) state). (word_exp s (Var v :α exp) :α word_loc option) = get_var v s) ∧ (∀(s :(α, γ, 'ffi) state) (name :store_name). (word_exp s (Lookup name :α exp) :α word_loc option) = get_store name s) ∧ (∀(s :(α, γ, 'ffi) state) (addr :α exp). (word_exp s (Load addr :α exp) :α word_loc option) = case (word_exp s addr :α word_loc option) of (NONE :α word_loc option) => (NONE :α word_loc option) | SOME (Word w) => mem_load w s | SOME (Loc v6 v7 :α word_loc) => (NONE :α word_loc option)) ∧ (∀(wexps :α exp list) (s :(α, γ, 'ffi) state) (op :binop). (word_exp s (Op op wexps) :α word_loc option) = case the_words (MAP (λ(a :α exp). (word_exp s a :α word_loc option)) wexps) of (NONE :α word list option) => (NONE :α word_loc option) | SOME ws => OPTION_MAP (Word :α word -> α word_loc) (word_op op ws)) ∧ ∀(wexp1 :α exp) (wexp :α exp) (sh :ast$shift) (s :(α, γ, 'ffi) state). (word_exp s (Shift sh wexp wexp1 :α exp) :α word_loc option) = case ((word_exp s wexp :α word_loc option),(word_exp s wexp1 :α word_loc option)) of ((NONE :α word_loc option),v3) => (NONE :α word_loc option) | (SOME (Word w),(NONE :α word_loc option)) => (NONE :α word_loc option) | (SOME (Word w),SOME (Word w1)) => OPTION_MAP (Word :α word -> α word_loc) (word_sh sh w (w2n w1)) | (SOME (Word w),SOME (Loc v18 v19 :α word_loc)) => (NONE :α word_loc option) | (SOME (Loc v10 v11 :α word_loc),v3) => (NONE :α word_loc option)
get_word_def_typed=∀(w :α word). get_word (Word w) = w
