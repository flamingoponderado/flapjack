evaluate_ind_typed=∀(P :α prog # (α, γ, 'ffi) state -> bool). (∀(s :(α, γ, 'ffi) state). P ((Skip :α prog),s)) ∧ (∀(n :num) (names :sptree$num_set # sptree$num_set) (s :(α, γ, 'ffi) state). P ((Alloc n names :α prog),s)) ∧ (∀(t1 :num) (t2 :num) (addr :num) (offset :num) (words :(bool # α word) list) (s :(α, γ, 'ffi) state). P ((StoreConsts t1 t2 addr offset words :α prog),s)) ∧ (∀(pri :num) (moves :(num # num) list) (s :(α, γ, 'ffi) state). P ((Move pri moves :α prog),s)) ∧ (∀(i :α inst) (s :(α, γ, 'ffi) state). P ((Inst i :α prog),s)) ∧ (∀(v :num) (exp :α exp) (s :(α, γ, 'ffi) state). P (Assign v exp,s)) ∧ (∀(v :num) (name :store_name) (s :(α, γ, 'ffi) state). P ((Get v name :α prog),s)) ∧ (∀(v :store_name) (exp :α exp) (s :(α, γ, 'ffi) state). P ((Set v exp :α prog),s)) ∧ (∀(b :binop) (dst :num) (src :num) (s :(α, γ, 'ffi) state). P ((OpCurrHeap b dst src :α prog),s)) ∧ (∀(exp :α exp) (v :num) (s :(α, γ, 'ffi) state). P ((Store exp v :α prog),s)) ∧ (∀(s :(α, γ, 'ffi) state). P ((Tick :α prog),s)) ∧ (∀(p :α prog) (s :(α, γ, 'ffi) state). (s.termdep ≠ (0 :num) ⇒ P (p,s with <|clock := MustTerminate_limit (:α); termdep := s.termdep − (1 :num)|>)) ⇒ P (MustTerminate p,s)) ∧ (∀(c1 :α prog) (c2 :α prog) (s :(α, γ, 'ffi) state). (∀(res :α result option) (s1 :(α, γ, 'ffi) state). (res,s1) = evaluate (c1,s) ∧ res = (NONE :α result option) ⇒ P (c2,s1)) ∧ P (c1,s) ⇒ P (Seq c1 c2,s)) ∧ (∀(n :num) (ms :num list) (s :(α, γ, 'ffi) state). P ((Return n ms :α prog),s)) ∧ (∀(n :num) (s :(α, γ, 'ffi) state). P ((Raise n :α prog),s)) ∧ (∀(k :num) (s :(α, γ, 'ffi) state). P ((Break k :α prog),s)) ∧ (∀(k :num) (s :(α, γ, 'ffi) state). P ((Continue k :α prog),s)) ∧ (∀(cmp :cmp) (r1 :num) (ri :α reg_imm) (c1 :α prog) (c2 :α prog) (s :(α, γ, 'ffi) state). (∀(v3 :α word_loc option) (v4 :α word_loc option) (x :α word_loc) (y :α word_loc) (v :bool). (get_var r1 s,get_var_imm ri s) = (v3,v4) ∧ v3 = SOME x ∧ v4 = SOME y ∧ (word_cmp cmp x y :bool option) = SOME v ∧ v ⇒ P (c1,s)) ∧ (∀(v3 :α word_loc option) (v4 :α word_loc option) (x :α word_loc) (y :α word_loc) (v :bool). (get_var r1 s,get_var_imm ri s) = (v3,v4) ∧ v3 = SOME x ∧ v4 = SOME y ∧ (word_cmp cmp x y :bool option) = SOME v ∧ ¬v ⇒ P (c2,s)) ⇒ P ((If cmp r1 ri c1 c2 :α prog),s)) ∧ (∀(names :sptree$num_set) (c :α prog) (exit_names :sptree$num_set) (s :(α, γ, 'ffi) state). (∀(v :(α, γ, 'ffi) state) (res :α result option) (s1 :(α, γ, 'ffi) state). cut_state (names,(LN :sptree$num_set)) s = SOME v ∧ (res,s1) = evaluate (c,v) ∧ cont_loop res ∧ s1.clock ≠ (0 :num) ⇒ P (STOP (Loop names c exit_names :α prog),dec_clock s1)) ∧ (∀(v :(α, γ, 'ffi) state). cut_state (names,(LN :sptree$num_set)) s = SOME v ⇒ P (c,v)) ⇒ P ((Loop names c exit_names :α prog),s)) ∧ (∀(r :num) (l1 :num) (s :(α, γ, 'ffi) state). P ((LocValue r l1 :α prog),s)) ∧ (∀(ptr :num) (len :num) (dptr :num) (dlen :num) (names :sptree$num_set # sptree$num_set) (s :(α, γ, 'ffi) state). P ((Install ptr len dptr dlen names :α prog),s)) ∧ (∀(r1 :num) (r2 :num) (s :(α, γ, 'ffi) state). P ((CodeBufferWrite r1 r2 :α prog),s)) ∧ (∀(r1 :num) (r2 :num) (s :(α, γ, 'ffi) state). P ((DataBufferWrite r1 r2 :α prog),s)) ∧ (∀(ffi_index :mlstring) (ptr1 :num) (len1 :num) (ptr2 :num) (len2 :num) (names :sptree$num_set # sptree$num_set) (s :(α, γ, 'ffi) state). P ((FFI ffi_index ptr1 len1 ptr2 len2 names :α prog),s)) ∧ (∀(op :memop) (v :num) (exp :α exp) (s :(α, γ, 'ffi) state). P (ShareInst op v exp,s)) ∧ (∀(ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (dest :num option) (args :num list) (handler :(num # α prog # num # num) option) (s :(α, γ, 'ffi) state). (∀(xs :α word_loc list) (v3 :α word_loc list # α prog # num option) (args1 :α word_loc list) (v10 :α prog # num option) (prog :α prog) (ss :num option) (v1 :num list # (sptree$num_set # sptree$num_set) # α prog # num # num) (n :num list) (v6 :(sptree$num_set # sptree$num_set) # α prog # num # num) (names :sptree$num_set # sptree$num_set) (v9 :α prog # num # num) (ret_handler :α prog) (v11 :num # num) (l1 :num) (l2 :num) (envs :α word_loc sptree$num_map # α word_loc sptree$num_map) (v5 :α result option) (s2 :(α, γ, 'ffi) state) (v8 :α result) (x :α word_loc) (ys :α word_loc list) (s1 :(α, γ, 'ffi) state). get_vars args s = SOME xs ∧ ¬bad_dest_args dest args ∧ find_code dest (add_ret_loc ret xs) s.code s.stack_size = SOME v3 ∧ v3 = (args1,v10) ∧ v10 = (prog,ss) ∧ ret = SOME v1 ∧ v1 = (n,v6) ∧ v6 = (names,v9) ∧ v9 = (ret_handler,v11) ∧ v11 = (l1,l2) ∧ ¬((domain (FST names) :num -> bool) = (∅ :num -> bool) ∨ ¬ALL_DISTINCT n) ∧ cut_envs names s.locals = SOME envs ∧ s.clock ≠ (0 :num) ∧ evaluate (prog,call_env args1 ss (push_env envs handler (dec_clock s))) = (v5,s2) ∧ v5 = SOME v8 ∧ v8 = Result x ys ∧ ¬(x ≠ (Loc l1 l2 :α word_loc) ∨ LENGTH ys ≠ LENGTH n) ∧ pop_env s2 = SOME s1 ∧ (domain s1.locals :num -> bool) = (domain (FST envs) :num -> bool) ∪ (domain (SND envs) :num -> bool) ⇒ P (ret_handler,set_vars n ys s1)) ∧ (∀(xs :α word_loc list) (v3 :α word_loc list # α prog # num option) (args1 :α word_loc list) (v10 :α prog # num option) (prog :α prog) (ss :num option) (v1 :num list # (sptree$num_set # sptree$num_set) # α prog # num # num) (n :num list) (v6 :(sptree$num_set # sptree$num_set) # α prog # num # num) (names :sptree$num_set # sptree$num_set) (v9 :α prog # num # num) (ret_handler :α prog) (v11 :num # num) (l1 :num) (l2 :num) (envs :α word_loc sptree$num_map # α word_loc sptree$num_map) (v5 :α result option) (s2 :(α, γ, 'ffi) state) (v8 :α result) (x' :α word_loc) (y :α word_loc) (v :num # α prog # num # num) (n' :num) (v2 :α prog # num # num) (h :α prog) (v4 :num # num) (l1' :num) (l2' :num). get_vars args s = SOME xs ∧ ¬bad_dest_args dest args ∧ find_code dest (add_ret_loc ret xs) s.code s.stack_size = SOME v3 ∧ v3 = (args1,v10) ∧ v10 = (prog,ss) ∧ ret = SOME v1 ∧ v1 = (n,v6) ∧ v6 = (names,v9) ∧ v9 = (ret_handler,v11) ∧ v11 = (l1,l2) ∧ ¬((domain (FST names) :num -> bool) = (∅ :num -> bool) ∨ ¬ALL_DISTINCT n) ∧ cut_envs names s.locals = SOME envs ∧ s.clock ≠ (0 :num) ∧ evaluate (prog,call_env args1 ss (push_env envs handler (dec_clock s))) = (v5,s2) ∧ v5 = SOME v8 ∧ v8 = Exception x' y ∧ handler = SOME v ∧ v = (n',v2) ∧ v2 = (h,v4) ∧ v4 = (l1',l2') ∧ x' = (Loc l1' l2' :α word_loc) ∧ (domain s2.locals :num -> bool) = (domain (FST envs) :num -> bool) ∪ (domain (SND envs) :num -> bool) ⇒ P (h,set_var n' y s2)) ∧ (∀(xs :α word_loc list) (v3 :α word_loc list # α prog # num option) (args1 :α word_loc list) (v10 :α prog # num option) (prog :α prog) (ss :num option) (v1 :num list # (sptree$num_set # sptree$num_set) # α prog # num # num) (n :num list) (v6 :(sptree$num_set # sptree$num_set) # α prog # num # num) (names :sptree$num_set # sptree$num_set) (v9 :α prog # num # num) (ret_handler :α prog) (v11 :num # num) (l1 :num) (l2 :num) (envs :α word_loc sptree$num_map # α word_loc sptree$num_map). get_vars args s = SOME xs ∧ ¬bad_dest_args dest args ∧ find_code dest (add_ret_loc ret xs) s.code s.stack_size = SOME v3 ∧ v3 = (args1,v10) ∧ v10 = (prog,ss) ∧ ret = SOME v1 ∧ v1 = (n,v6) ∧ v6 = (names,v9) ∧ v9 = (ret_handler,v11) ∧ v11 = (l1,l2) ∧ ¬((domain (FST names) :num -> bool) = (∅ :num -> bool) ∨ ¬ALL_DISTINCT n) ∧ cut_envs names s.locals = SOME envs ∧ s.clock ≠ (0 :num) ⇒ P (prog,call_env args1 ss (push_env envs handler (dec_clock s)))) ∧ (∀(xs :α word_loc list) (v3 :α word_loc list # α prog # num option) (args1 :α word_loc list) (v10 :α prog # num option) (prog :α prog) (ss :num option). get_vars args s = SOME xs ∧ ¬bad_dest_args dest args ∧ find_code dest (add_ret_loc ret xs) s.code s.stack_size = SOME v3 ∧ v3 = (args1,v10) ∧ v10 = (prog,ss) ∧ ret = (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) ∧ handler = (NONE :(num # α prog # num # num) option) ∧ s.clock ≠ (0 :num) ⇒ P (prog,call_env args1 ss (dec_clock s))) ⇒ P ((Call ret dest args handler :α prog),s)) ⇒ ∀(v :α prog) (v1 :(α, γ, 'ffi) state). P (v,v1)
inst_def_typed=∀(i :α inst) (s :(α, γ, 'ffi) state). inst i s = case i of (Skip :α inst) => SOME s | (Const reg w :α inst) => assign reg (Const w :α exp) s | (Arith (Binop bop r1 r2 ri) :α inst) => assign r1 (Op bop [(Var r2 :α exp); case ri of (Reg r3 :α reg_imm) => (Var r3 :α exp) | Imm w => (Const w :α exp)]) s | (Arith (Shift sh r1' r2' ri' :α arith) :α inst) => assign r1' (Shift sh (Var r2' :α exp) (case ri' of (Reg r3 :α reg_imm) => (Var r3 :α exp) | Imm w => (Const w :α exp)) :α exp) s | (Arith (Div r1'' r2'' r3 :α arith) :α inst) => (let (vs :α word_loc list option) = get_vars [r3; r2''] s in case vs of (NONE :α word_loc list option) => (NONE :(α, γ, 'ffi) state option) | SOME ([] :α word_loc list) => (NONE :(α, γ, 'ffi) state option) | SOME [v4] => (NONE :(α, γ, 'ffi) state option) | SOME [Word q; Word w2] => if q ≠ (0w :α word) then SOME (set_var r1'' (Word (w2 / q)) s) else (NONE :(α, γ, 'ffi) state option) | SOME (Word q::Word w2::v24::v25) => (NONE :(α, γ, 'ffi) state option) | SOME ((Loc v20 v21 :α word_loc)::Word w2::v9) => (NONE :(α, γ, 'ffi) state option) | SOME (v4::(Loc v14 v15 :α word_loc)::v9) => (NONE :(α, γ, 'ffi) state option)) | (Arith (LongMul r1'⁶' r2'⁶' r3'⁴' r4'³' :α arith) :α inst) => (let (vs :α word_loc list option) = get_vars [r3'⁴'; r4'³'] s in case vs of (NONE :α word_loc list option) => (NONE :(α, γ, 'ffi) state option) | SOME ([] :α word_loc list) => (NONE :(α, γ, 'ffi) state option) | SOME [v4] => (NONE :(α, γ, 'ffi) state option) | SOME [Word w3; Word w4] => (let (r :num) = w2n w3 * w2n w4 in SOME (set_var r2'⁶' (Word (n2w r :α word)) (set_var r1'⁶' (Word (n2w (r DIV dimword (:α)) :α word)) s))) | SOME (Word w3::Word w4::v24::v25) => (NONE :(α, γ, 'ffi) state option) | SOME ((Loc v20 v21 :α word_loc)::Word w4::v9) => (NONE :(α, γ, 'ffi) state option) | SOME (v4::(Loc v14 v15 :α word_loc)::v9) => (NONE :(α, γ, 'ffi) state option)) | (Arith (LongDiv r1'⁷' r2'⁷' r3'⁵' r4'⁴' r5 :α arith) :α inst) => (let (vs :α word_loc list option) = get_vars [r3'⁵'; r4'⁴'; r5] s in case vs of (NONE :α word_loc list option) => (NONE :(α, γ, 'ffi) state option) | SOME ([] :α word_loc list) => (NONE :(α, γ, 'ffi) state option) | SOME [v4] => (NONE :(α, γ, 'ffi) state option) | SOME [v4; v8] => (NONE :(α, γ, 'ffi) state option) | SOME [Word w3; Word w4; Word w5] => (let (n :num) = w2n w3 * dimword (:α) + w2n w4; (d :num) = w2n w5; (q :num) = n DIV d in if d ≠ (0 :num) ∧ q < dimword (:α) then SOME (set_var r1'⁷' (Word (n2w q :α word)) (set_var r2'⁷' (Word (n2w (n MOD d) :α word)) s)) else (NONE :(α, γ, 'ffi) state option)) | SOME (Word w3::Word w4::Word w5::v34::v35) => (NONE :(α, γ, 'ffi) state option) | SOME ((Loc v30 v31 :α word_loc)::Word w4::Word w5::v13) => (NONE :(α, γ, 'ffi) state option) | SOME (v4::(Loc v24 v25 :α word_loc)::Word w5::v13) => (NONE :(α, γ, 'ffi) state option) | SOME (v4::v8::(Loc v18 v19 :α word_loc)::v13) => (NONE :(α, γ, 'ffi) state option)) | (Arith (AddCarry r1'³' r2'³' r3' r4 :α arith) :α inst) => (let (vs :α word_loc list option) = get_vars [r2'³'; r3'; r4] s in case vs of (NONE :α word_loc list option) => (NONE :(α, γ, 'ffi) state option) | SOME ([] :α word_loc list) => (NONE :(α, γ, 'ffi) state option) | SOME [v4] => (NONE :(α, γ, 'ffi) state option) | SOME [v4; v8] => (NONE :(α, γ, 'ffi) state option) | SOME [Word l; Word r; Word c] => (let ((res :α word),(co :α word)) = word_add_carry l r c in SOME (set_var r4 (Word co) (set_var r1'³' (Word res) s))) | SOME (Word l::Word r::Word c::v34::v35) => (NONE :(α, γ, 'ffi) state option) | SOME ((Loc v30 v31 :α word_loc)::Word r::Word c::v13) => (NONE :(α, γ, 'ffi) state option) | SOME (v4::(Loc v24 v25 :α word_loc)::Word c::v13) => (NONE :(α, γ, 'ffi) state option) | SOME (v4::v8::(Loc v18 v19 :α word_loc)::v13) => (NONE :(α, γ, 'ffi) state option)) | (Arith (AddOverflow r1'⁴' r2'⁴' r3'' r4' :α arith) :α inst) => (let (vs :α word_loc list option) = get_vars [r2'⁴'; r3''] s in case vs of (NONE :α word_loc list option) => (NONE :(α, γ, '