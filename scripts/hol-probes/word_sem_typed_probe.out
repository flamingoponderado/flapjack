mem_load_32_def_typed=∀(m :α word -> α word_loc) (dm :α word -> bool) (be :bool) (w :α word). mem_load_32 m dm be w = if aligned (2 :num) w then case m (byte_align w) of Word v => if byte_align w ∈ dm then SOME (word_of_bytes be (0w :word32) [get_byte w v be; get_byte (w + (1w :α word)) v be; get_byte (w + (2w :α word)) v be; get_byte (w + (3w :α word)) v be]) else (NONE :word32 option) | (Loc v2 v3 :α word_loc) => (NONE :word32 option) else (NONE :word32 option)
