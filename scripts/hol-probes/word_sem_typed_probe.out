dec_stack_def_typed=dec_stack ([] :α word_loc list) ([] :α stack_frame list) = SOME ([] :α stack_frame list) ∧ (∀(xs :α word_loc list) (st :α stack_frame list) (n :num option) (l0 :(num # α word_loc) list) (l :(num # α word_loc) list) (handler :(num # num # num) option). dec_stack xs (StackFrame n l0 l handler::st) = if LENGTH xs < LENGTH l then (NONE :α stack_frame list option) else case dec_stack (DROP (LENGTH l) xs) st of (NONE :α stack_frame list option) => (NONE :α stack_frame list option) | SOME s => SOME (StackFrame n l0 (ZIP (MAP (FST :num # α word_loc -> num) l,TAKE (LENGTH l) xs)) handler::s)) ∧ ∀(v8 :α word_loc list) (v7 :α word_loc). dec_stack (v7::v8) ([] :α stack_frame list) = (NONE :α stack_frame list option)
