e (res,s1 with <|clock := s.clock; termdep := s.termdep|>))) ∧ (∀(s :(α, γ, 'ffi) state) (c2 :α prog) (c1 :α prog). evaluate (Seq c1 c2,s) = (let ((res :α result option),(s1 :(α, γ, 'ffi) state)) = evaluate (c1,s) in if res = (NONE :α result option) then evaluate (c2,s1) else (res,s1))) ∧ (∀(s :(α, γ, 'ffi) state) (n :num) (ms :num list). evaluate ((Return n ms :α prog),s) = case (get_var n s,get_vars ms s) of ((NONE :α word_loc option),v3) => (SOME (Error :α result),s) | (SOME (Word v9),v3) => (SOME (Error :α result),s) | (SOME (Loc l1 l2 :α word_loc),(NONE :α word_loc list option)) => (SOME (Error :α result),s) | (SOME (Loc l1 l2 :α word_loc),SOME ys) => (SOME (Result (Loc l1 l2 :α word_loc) ys),flush_state F s)) ∧ (∀(s :(α, γ, 'ffi) state) (n :num). evaluate ((Raise n :α prog),s) = case get_var n s of (NONE :α word_loc option) => (SOME (Error :α result),s) | SOME w => case jump_exc s of (NONE :((α, γ, 'ffi) state # num # num) option) => (SOME (Error :α result),s) | SOME (v1,v3,v4) => (SOME (Exception (Loc v3 v4 :α word_loc) w),v1)) ∧ (∀(s :(α, γ, 'ffi) state) (k :num). evaluate ((Break k :α prog),s) = (SOME (Break k :α result),s)) ∧ (∀(s :(α, γ, 'ffi) state) (k :num). evaluate ((Continue k :α prog),s) = (SOME (Continue k :α result),s)) ∧ (∀(s :(α, γ, 'ffi) state) (ri :α reg_imm) (r1 :num) (cmp :cmp) (c2 :α prog) (c1 :α prog). evaluate ((If cmp r1 ri c1 c2 :α prog),s) = case (get_var r1 s,get_var_imm ri s) of ((NONE :α word_loc option),v4) => (SOME (Error :α result),s) | (SOME x,(NONE :α word_loc option)) => (SOME (Error :α result),s) | (SOME x,SOME y) => case (word_cmp cmp x y :bool option) of (NONE :bool option) => (SOME (Error :α result),s) | SOME T => evaluate (c1,s) | SOME F => evaluate (c2,s)) ∧ (∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (exit_names :sptree$num_set) (c :α prog). evaluate ((Loop names c exit_names :α prog),s) = case cut_state (names,(LN :sptree$num_set)) s of (NONE :(α, γ, 'ffi) state option) => (SOME (Error :α result),s) | SOME v => (