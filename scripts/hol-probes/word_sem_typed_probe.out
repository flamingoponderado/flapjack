jump_exc_def_typed=∀(s :(α, γ, 'ffi) state). jump_exc s = if s.handler < LENGTH s.stack then case LASTN (s.handler + (1 :num)) s.stack of ([] :α stack_frame list) => (NONE :((α, γ, 'ffi) state # num # num) option) | StackFrame m e0 e (NONE :(num # num # num) option)::xs => (NONE :((α, γ, 'ffi) state # num # num) option) | StackFrame m e0 e (SOME (n,l1,l2))::xs => SOME (s with <|handler := n; locals := union (fromAList e) (fromAList e0); stack := xs; locals_size := m|>,l1,l2) else (NONE :((α, γ, 'ffi) state # num # num) option)
