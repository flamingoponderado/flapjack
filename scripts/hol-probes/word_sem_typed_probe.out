semantics_def_typed=∀(s :(α, γ, 'ffi) state) (start :num). semantics s start = (let (prog :α prog) = (Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME start) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog) in if ∃(k :num). case FST (evaluate (prog,s with clock := k)) of (NONE :α result option) => T | SOME (Result ret v10) => ret ≠ (Loc (1 :num) (0 :num) :α word_loc) | SOME (Exception v11 v12) => T | SOME (Break v13 :α result) => F | SOME (Continue v14 :α result) => F | SOME (TimeOut :α result) => F | SOME (NotEnoughSpace :α result) => F | SOME (FinalFFI v15 :α result) => F | SOME (Error :α result) => T then Fail else case some(res :behaviour). ∃(k :num) (t :(α, γ, 'ffi) state) (r :α result option) (outcome :outcome). evaluate (prog,s with clock := k) = (r,t) ∧ (case r of (NONE :α result option) => F | SOME (Result v9 v10) => outcome = Success | SOME (Exception v11 v12) => F | SOME (Break v13 :α result) => F | SOME (Continue v14 :α result) => F | SOME (TimeOut :α result) => F | SOME (NotEnoughSpace :α result) => outcome = Resource_limit_hit | SOME (FinalFFI e :α result) => outcome = FFI_outcome e | SOME (Error :α result) => F) ∧ res = Terminate outcome t.ffi.io_events of (NONE :behaviour option) => Diverge (LUB (IMAGE (λ(k :num). (fromList (SND (evaluate (prog,s with clock := k))).ffi.io_events :io_event llist)) 𝕌(:num))) | SOME res => res)
word_lang_safe_for_space_def_typed=∀(s :(α, γ, 'ffi) state) (start :num). word_lang_safe_for_space s start ⇔ (let (prog :α prog) = (Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME start) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog) in ∀(k :num) (res :α result option) (t :(α, γ, 'ffi) state). evaluate (prog,s with clock := k) = (res,t) ⇒ ∃(max :num). t.stack_max = SOME max ∧ max ≤ t.stack_limit)
sh_mem_load_def_typed=∀(a :α word) (s :(α, γ, 'ffi) state). sh_mem_load a s = if a ∈ s.sh_mdomain then SOME (call_FFI s.ffi (SharedMem MappedRead) [(0w :word8)] (word_to_bytes a F)) else (NONE :'ffi ffi_result option)
sh_mem_load16_def_typed=∀(a :α word) (s :(α, γ, 'ffi) state). sh_mem_load16 a s = if byte_align a ∈ s.sh_mdomain then SOME (call_FFI s.ffi (SharedMem MappedRead) [(2w :word8)] (word_to_bytes a F)) else (NONE :'ffi ffi_result option)
sh_mem_load32_def_typed=∀(a :α word) (s :(α, γ, 'ffi) state). sh_mem_load32 a s = if byte_align a ∈ s.sh_mdomain then SOME (call_FFI s.ffi (SharedMem MappedRead) [(4w :word8)] (word_to_bytes a F)) else (NONE :'ffi ffi_result option)
sh_mem_load_byte_def_typed=∀(a :α word) (s :(α, γ, 'ffi) state). sh_mem_load_byte a s = if byte_align a ∈ s.sh_mdomain then SOME (call_FFI s.ffi (SharedMem MappedRead) [(1w :word8)] (word_to_bytes a F)) else (NONE :'ffi ffi_result option)
sh_mem_set_var_def_typed=(sh_mem_set_var (SOME (FFI_final (outcome :final_event) :'ffi ffi_result)) (v0 :num) (s :(α, γ, 'ffi) state) :β result option # (α, γ, 'ffi) state) = (SOME (FinalFFI outcome :β result),flush_state T s) ∧ (sh_mem_set_var (SOME (FFI_return (new_ffi :'ffi ffi_state) (new_bytes :word8 list))) (v :num) s :β result option # (α, γ, 'ffi) state) = ((NONE :β result option),set_var v (Word (word_of_bytes F (0w :α word) new_bytes)) (s with ffi := new_ffi)) ∧ (sh_mem_set_var (NONE :'ffi ffi_result option) (v2 :num) s :β result option # (α, γ, 'ffi) state) = (SOME (Error :β result),s)
sh_mem_store_def_typed=∀(a :α word) (w :α word) (s :(α, γ, 'ffi) state). (sh_mem_store a w s :β result option # (α, γ, 'ffi) state) = if a ∈ s.sh_mdomain then case call_FFI s.ffi (SharedMem MappedWrite) [(0w :word8)] (word_to_bytes w F ++ word_to_bytes a F) of FFI_return new_ffi new_bytes => ((NONE :β result option),s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),flush_state T s) else (SOME (Error :β result),s)
sh_mem_store16_def_typed=∀(a :α word) (w :α word) (s :(α, γ, 'ffi) state). (sh_mem_store16 a w s :β result option # (α, γ, 'ffi) state) = if byte_align a ∈ s.sh_mdomain then case call_FFI s.ffi (SharedMem MappedWrite) [(2w :word8)] (TAKE (2 :num) (word_to_bytes w F) ++ word_to_bytes a F) of FFI_return new_ffi new_bytes => ((NONE :β result option),s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),flush_state T s) else (SOME (Error :β result),s)
sh_mem_store32_def_typed=∀(a :α word) (w :α word) (s :(α, γ, 'ffi) state). (sh_mem_store32 a w s :β result option # (α, γ, 'ffi) state) = if byte_align a ∈ s.sh_mdomain then case call_FFI s.ffi (SharedMem MappedWrite) [(4w :word8)] (TAKE (4 :num) (word_to_bytes w F) ++ word_to_bytes a F) of FFI_return new_ffi new_bytes => ((NONE :β result option),s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),flush_state T s) else (SOME (Error :β result),s)
sh_mem_store_byte_def_typed=∀(a :α word) (w :α word) (s :(α, γ, 'ffi) state). (sh_mem_store_byte a w s :β result option # (α, γ, 'ffi) state) = if byte_align a ∈ s.sh_mdomain then case call_FFI s.ffi (SharedMem MappedWrite) [(1w :word8)] ([get_byte (0w :α word) w F] ++ word_to_bytes a F) of FFI_return new_ffi new_bytes => ((NONE :β result option),s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),flush_state T s) else (SOME (Error :β result),s)
share_inst_def_typed=(∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Load v ad s :α result option # (β, γ, δ) state) = (sh_mem_set_var (sh_mem_load ad s) v s :α result option # (β, γ, δ) state)) ∧ (∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Load8 v ad s :α result option # (β, γ, δ) state) = (sh_mem_set_var (sh_mem_load_byte ad s) v s :α result option # (β, γ, δ) state)) ∧ (∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Load16 v ad s :α result option # (β, γ, δ) state) = (sh_mem_set_var (sh_mem_load16 ad s) v s :α result option # (β, γ, δ) state)) ∧ (∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Load32 v ad s :α result option # (β, γ, δ) state) = (sh_mem_set_var (sh_mem_load32 ad s) v s :α result option # (β, γ, δ) state)) ∧ (∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Store v ad s :α result option # (β, γ, δ) state) = case get_var v s of (NONE :β word_loc option) => (SOME (Error :α result),s) | SOME (Word v) => (sh_mem_store ad v s :α result option # (β, γ, δ) state) | SOME (Loc v7 v8 :β word_loc) => (SOME (Error :α result),s)) ∧ (∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Store8 v ad s :α result option # (β, γ, δ) state) = case get_var v s of (NONE :β word_loc option) => (SOME (Error :α result),s) | SOME (Word v) => (sh_mem_store_byte ad v s :α result option # (β, γ, δ) state) | SOME (Loc v7 v8 :β word_loc) => (SOME (Error :α result),s)) ∧ (∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Store16 v ad s :α result option # (β, γ, δ) state) = case get_var v s of (NONE :β word_loc option) => (SOME (Error :α result),s) | SOME (Word v) => (sh_mem_store16 ad v s :α result option # (β, γ, δ) state) | SOME (Loc v7 v8 :β word_loc) => (SOME (Error :α result),s)) ∧ ∀(v :num) (ad :β word) (s :(β, γ, δ) state). (share_inst Store32 v ad s :α result option # (β, γ, δ) state) = case get_var v s of (NONE :β word_loc option) => (SOME (Error :α result),s) | SOME (Word v) => (sh_mem_store32 ad v s :α result option # (β, γ, δ) state) | SOME (Loc v7 v8 :β word_loc) => (SOME (Error :α result),s)
buffer_typed=recordtype.buffer::α word -> β word list -> num -> (α, β) buffer
result_typed=Result::χ word_loc -> χ word_loc list -> χ result; Exception::χ word_loc -> χ word_loc -> χ result; Break::num -> χ result; Continue::num -> χ result; TimeOut::χ result; NotEnoughSpace::χ result; FinalFFI::final_event -> χ result; Error::χ result
stack_frame_typed=StackFrame::num option -> (num # α word_loc) list -> (num # α word_loc) list -> (num # num # num) option -> α stack_frame
state_typed=recordtype.state::α word_loc sptree$num_map -> num option -> (num |-> word64) -> (store_name |-> α word_loc) -> α stack_frame list -> num -> num option -> num sptree$num_map -> (α word -> α word_loc) -> (α word -> bool) -> (α word -> bool) -> (num -> num -> num) -> (γ -> (num # num # α prog) list -> (word8 list # α word list # γ) option) -> (num -> γ # (num # num # α prog) list) -> (α, 8) buffer -> (α, α) buffer -> (α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) -> num -> num -> num -> (num # α prog) sptree$num_map -> bool -> 'ffi ffi_state -> (α, γ, 'ffi) state
buffer_flush_def_typed=∀(cb :(α, β) buffer) (w1 :α word) (w2 :α word). (buffer_flush cb w1 w2 :(β word list # (α, γ) buffer) option) = if cb.position = w1 ∧ cb.position + (n2w (dimindex (:β) DIV (8 :num)) :α word) * (n2w (LENGTH cb.buffer) :α word) = w2 then SOME (cb.buffer,cb with <|position := w2; buffer := ([] :γ word list)|>) else (NONE :(β word list # (α, γ) buffer) option)
buffer_write_def_typed=∀(cb :(α, β) buffer) (w :α word) (b :β word). buffer_write cb w b = if cb.position + (n2w (dimindex (:β) DIV (8 :num)) :α word) * (n2w (LENGTH cb.buffer) :α word) = w ∧ (0 :num) < cb.space_left then SOME (cb with <|buffer := cb.buffer ++ [b]; space_left := cb.space_left − (1 :num)|>) else (NONE :(α, β) buffer option)
isException_def_typed=(isException (Exception (a :α word_loc) (b :α word_loc)) ⇔ T) ∧ (isException (Result (v :α word_loc) (v1 :α word_loc list)) ⇔ F) ∧ (isException (Break (v4 :num) :α result) ⇔ F) ∧ (isException (Continue (v5 :num) :α result) ⇔ F) ∧ (isException (TimeOut :α result) ⇔ F) ∧ (isException (NotEnoughSpace :α result) ⇔ F) ∧ (isException (FinalFFI (v6 :final_event) :α result) ⇔ F) ∧ (isException (Error :α result) ⇔ F)
isResult_def_typed=(isResult (Result (a :α word_loc) (b :α word_loc list)) ⇔ T) ∧ (isResult (Exception (v2 :α word_loc) (v3 :α word_loc)) ⇔ F) ∧ (isResult (Break (v4 :num) :α result) ⇔ F) ∧ (isResult (Continue (v5 :num) :α result) ⇔ F) ∧ (isResult (TimeOut :α result) ⇔ F) ∧ (isResult (NotEnoughSpace :α result) ⇔ F) ∧ (isResult (FinalFFI (v6 :final_event) :α result) ⇔ F) ∧ (isResult (Error :α result) ⇔ F)
stack_size_def_typed=(stack_size :α stack_frame list -> num option) = FOLDR (OPTION_MAP2 $+ ∘ (stack_size_frame :α stack_frame -> num option)) (SOME (1 :num))
stack_size_frame_def_typed=stack_size_frame (StackFrame (n :num option) (v0 :(num # α word_loc) list) (v1 :(num # α word_loc) list) (NONE :(num # num # num) option)) = n ∧ stack_size_frame (StackFrame n (v2 :(num # α word_loc) list) (v3 :(num # α word_loc) list) (SOME (v4 :num # num # num))) = OPTION_MAP ($+ (3 :num)) n
