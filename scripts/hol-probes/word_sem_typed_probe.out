mem_store_32_def_typed=∀(m :α word -> α word_loc) (dm :α word -> bool) (be :bool) (w :α word) (hw :word32). mem_store_32 m dm be w hw = if aligned (2 :num) w then case m (byte_align w) of Word v => if byte_align w ∈ dm then (let (v0 :α word) = set_byte w (get_byte (0w :word32) hw be) v be; (v1 :α word) = set_byte (w + (1w :α word)) (get_byte (1w :word32) hw be) v0 be; (v2 :α word) = set_byte (w + (2w :α word)) (get_byte (2w :word32) hw be) v1 be; (v3 :α word) = set_byte (w + (3w :α word)) (get_byte (3w :word32) hw be) v2 be in SOME m⦇byte_align w ↦ Word v3⦈) else (NONE :(α word -> α word_loc) option) | (Loc v8 v9 :α word_loc) => (NONE :(α word -> α word_loc) option) else (NONE :(α word -> α word_loc) option)
