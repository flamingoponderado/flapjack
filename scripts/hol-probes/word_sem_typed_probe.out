bad_fun_return_def_typed=(bad_fun_return (NONE :α result option) ⇔ T) ∧ (bad_fun_return (SOME (Break (v0 :num) :α result)) ⇔ T) ∧ (bad_fun_return (SOME (Continue (v1 :num) :α result)) ⇔ T) ∧ (bad_fun_return (SOME (Result (v4 :α word_loc) (v5 :α word_loc list))) ⇔ F) ∧ (bad_fun_return (SOME (Exception (v6 :α word_loc) (v7 :α word_loc))) ⇔ F) ∧ (bad_fun_return (SOME (TimeOut :α result)) ⇔ F) ∧ (bad_fun_return (SOME (NotEnoughSpace :α result)) ⇔ F) ∧ (bad_fun_return (SOME (FinalFFI (v10 :final_event) :α result)) ⇔ F) ∧ (bad_fun_return (SOME (Error :α result)) ⇔ F)
