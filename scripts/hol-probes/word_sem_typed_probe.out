dec_clock_def_typed=∀(s :(α, γ, 'ffi) state). dec_clock s = s with clock := s.clock − (1 :num)
fix_clock_def_typed=∀(old_s :(ε, ζ, η) state) (res :α) (new_s :(β, γ, δ) state). fix_clock old_s (res,new_s) = (res,new_s with <|clock := if old_s.clock < new_s.clock then old_s.clock else new_s.clock; termdep := old_s.termdep|>)
