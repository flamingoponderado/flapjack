STOP_def_typed=∀(x :α). STOP x = x
call_env_def_typed=∀(args :α word_loc list) (size :num option) (s :(α, γ, 'ffi) state). call_env args size s = s with <|locals := fromList2 args; locals_size := size; stack_max := OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack) size)|>
cut_state_def_typed=∀(names :sptree$num_set # sptree$num_set) (s :(α, γ, 'ffi) state). cut_state names s = case cut_env names s.locals of (NONE :α word_loc sptree$num_map option) => (NONE :(α, γ, 'ffi) state option) | SOME env => SOME (s with locals := env)
