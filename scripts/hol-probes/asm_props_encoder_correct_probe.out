ec_def=∀(t :(α, β, γ) target). encoder_correct t ⇔ target_ok t ∧ ∀(s1 :α asm_state) (i :α asm) (s2 :α asm_state) (ms :β). asm_step t.config s1 i s2 ∧ target_state_rel t s1 ms ⇒ ∃(n :num). ∀(env :num -> β -> β). interference_ok env (t.proj s1.mem_domain) ⇒ (let (pcs :num -> α word -> bool) = all_pcs (LENGTH (t.config.encode i)) s1.pc in asserts n (λ(k :num) (s :β). env (n − k) (t.next s)) ms (λ(ms' :β). t.state_ok ms' ∧ (∀(pc :α word). pc ∈ pcs (0 :num) ⇒ t.get_byte ms' pc = t.get_byte ms pc) ∧ t.get_pc ms' ∈ pcs t.config.code_alignment) (λ(ms' :β). target_state_rel t s2 ms') ∧ asserts2 (n + (1 :num)) (λ(k :num). env (n + (1 :num) − k)) t.next ms (λ(ms1 :β) (ms2 :β). ∀(x :α word). x ∉ s1.mem_domain ⇒ t.get_byte ms1 x = t.get_byte ms2 x))
ec_target_ok=encoder_correct t ⇒ target_ok t
ec_no_interference=encoder_correct t ∧ asm_step t.config s1 i s2 ∧ target_state_rel t s1 ms ⇒ ∃n. asserts n (λk s. t.next s) ms (λms'. t.state_ok ms' ∧ (∀pc. pc ∈ all_pcs (LENGTH (t.config.encode i)) s1.pc 0 ⇒ t.get_byte ms' pc = t.get_byte ms pc) ∧ t.get_pc ms' ∈ all_pcs (LENGTH (t.config.encode i)) s1.pc t.config.code_alignment) (λms'. target_state_rel t s2 ms') ∧ asserts2 (n + 1) (λk x. x) t.next ms (λms1 ms2. ∀x. x ∉ s1.mem_domain ⇒ t.get_byte ms1 x = t.get_byte ms2 x)
