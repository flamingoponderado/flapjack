sp_statement=∀t s off k jump. state_rel jump off k s t ⇒ ∃c. get_var (k + 1) t = SOME (Word c) ∧ dimindex (:α) DIV 8 * max_stack_alloc ≤ w2n c ∧ w2n c + w2n bytes_in_word * LENGTH s.stack < dimword (:α) ∧ get_var k t = SOME (Word (c + bytes_in_word * n2w s.stack_space)) ∧ (memory s.memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP Word s.bitmaps ++ MAP Word s.data_buffer.buffer) * word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + bytes_in_word * n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps)) s.data_buffer.space_left * word_store c s.store * word_list c s.stack) (fun2set (t.memory,t.mdomain))
sp_proved=T
