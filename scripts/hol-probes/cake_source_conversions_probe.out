option_type_num_definition=option_type_num = (2 :num)
id_type_num_definition=id_type_num = (4 :num)
list_to_value_definition=list_to_v ([] :v list) = Conv (SOME (TypeStamp «[]» list_type_num)) ([] :v list) ∧ ∀(x :v) (xs :v list). list_to_v (x::xs) = Conv (SOME (TypeStamp «::» list_type_num)) [x; list_to_v xs]
value_to_chars_definition=(∀(stamp :stamp). v_to_char_list (Conv (SOME stamp) ([] :v list)) = if stamp = TypeStamp «[]» list_type_num then SOME ("" :string) else (NONE :string option)) ∧ (∀(v :v) (stamp :stamp) (c :char). v_to_char_list (Conv (SOME stamp) [Litv (Char c); v]) = if stamp = TypeStamp «::» list_type_num then case v_to_char_list v of (NONE :string option) => (NONE :string option) | SOME cs => SOME (STRING c cs) else (NONE :string option)) ∧ (∀(v1 :lit). v_to_char_list (Litv v1) = (NONE :string option)) ∧ (∀(v3 :v list). v_to_char_list (Conv (NONE :stamp option) v3) = (NONE :string option)) ∧ (∀(v63 :int) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Litv (IntLit v63)::v32)) = (NONE :string option)) ∧ (∀(v64 :char) (v29 :stamp). v_to_char_list (Conv (SOME v29) [Litv (Char v64)]) = (NONE :string option)) ∧ (∀(v80 :v list) (v79 :v) (v75 :v) (v64 :char) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Litv (Char v64)::v75::v79::v80)) = (NONE :string option)) ∧ (∀(v65 :mlstring) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Litv (StrLit v65)::v32)) = (NONE :string option)) ∧ (∀(v66 :word8) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Litv (Word8 v66)::v32)) = (NONE :string option)) ∧ (∀(v67 :word64) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Litv (Word64 v67)::v32)) = (NONE :string option)) ∧ (∀(v68 :word64) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Litv (Float64 v68)::v32)) = (NONE :string option)) ∧ (∀(v37 :v list) (v36 :stamp option) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Conv v36 v37::v32)) = (NONE :string option)) ∧ (∀(v40 :exp) (v39 :mlstring) (v38 :v sem_env) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Closure v38 v39 v40::v32)) = (NONE :string option)) ∧ (∀(v43 :mlstring) (v42 :(mlstring # mlstring # exp) list) (v41 :v sem_env) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Recclosure v41 v42 v43::v32)) = (NONE :string option)) ∧ (∀(v45 :num) (v44 :bool) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Loc v44 v45::v32)) = (NONE :string option)) ∧ (∀(v46 :v list) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Vectorv v46::v32)) = (NONE :string option)) ∧ (∀(v48 :num # num) (v47 :v sem_env) (v32 :v list) (v29 :stamp). v_to_char_list (Conv (SOME v29) (Env v47 v48::v32)) = (NONE :string option)) ∧ (∀(v6 :exp) (v5 :mlstring) (v4 :v sem_env). v_to_char_list (Closure v4 v5 v6) = (NONE :string option)) ∧ (∀(v9 :mlstring) (v8 :(mlstring # mlstring # exp) list) (v7 :v sem_env). v_to_char_list (Recclosure v7 v8 v9) = (NONE :string option)) ∧ (∀(v11 :num) (v10 :bool). v_to_char_list (Loc v10 v11) = (NONE :string option)) ∧ (∀(v12 :v list). v_to_char_list (Vectorv v12) = (NONE :string option)) ∧ ∀(v14 :num # num) (v13 :v sem_env). v_to_char_list (Env v13 v14) = (NONE :string option)
values_to_string_definition=vs_to_string ([] :v list) = SOME «» ∧ (∀(vs :v list) (s1 :mlstring). vs_to_string (Litv (StrLit s1)::vs) = case vs_to_string vs of (NONE :mlstring option) => (NONE :mlstring option) | SOME s2 => SOME (s1 ^ s2)) ∧ (∀(v31 :int) (v1 :v list). vs_to_string (Litv (IntLit v31)::v1) = (NONE :mlstring option)) ∧ (∀(v32 :char) (v1 :v list). vs_to_string (Litv (Char v32)::v1) = (NONE :mlstring option)) ∧ (∀(v34 :word8) (v1 :v list). vs_to_string (Litv (Word8 v34)::v1) = (NONE :mlstring option)) ∧ (∀(v35 :word64) (v1 :v list). vs_to_string (Litv (Word64 v35)::v1) = (NONE :mlstring option)) ∧ (∀(v36 :word64) (v1 :v list). vs_to_string (Litv (Float64 v36)::v1) = (NONE :mlstring option)) ∧ (∀(v5 :v list) (v4 :stamp option) (v1 :v list). vs_to_string (Conv v4 v5::v1) = (NONE :mlstring option)) ∧ (∀(v8 :exp) (v7 :mlstring) (v6 :v sem_env) (v1 :v list). vs_to_string (Closure v6 v7 v8::v1) = (NONE :mlstring option)) ∧ (∀(v9 :v sem_env) (v11 :mlstring) (v10 :(mlstring # mlstring # exp) list) (v1 :v list). vs_to_string (Recclosure v9 v10 v11::v1) = (NONE :mlstring option)) ∧ (∀(v13 :num) (v12 :bool) (v1 :v list). vs_to_string (Loc v12 v13::v1) = (NONE :mlstring option)) ∧ (∀(v14 :v list) (v1 :v list). vs_to_string (Vectorv v14::v1) = (NONE :mlstring option)) ∧ ∀(v16 :num # num) (v15 :v sem_env) (v1 :v list). vs_to_string (Env v15 v16::v1) = (NONE :mlstring option)
maybe_to_value_definition=maybe_to_v (NONE :v option) = Conv (SOME (TypeStamp «None» option_type_num)) ([] :v list) ∧ ∀(v :v). maybe_to_v (SOME v) = Conv (SOME (TypeStamp «Some» option_type_num)) [v]
value_to_id_definition=(∀(stamp :stamp) (s :mlstring). v_to_id (Conv (SOME stamp) [Litv (StrLit s)]) = if stamp = TypeStamp «Short» id_type_num then SOME (Short s :(mlstring, mlstring) id) else (NONE :(mlstring, mlstring) id option)) ∧ (∀(v :v) (stamp :stamp) (s :mlstring). v_to_id (Conv (SOME stamp) [Litv (StrLit s); v]) = if stamp = TypeStamp «Long» id_type_num then case v_to_id v of (NONE :(mlstring, mlstring) id option) => (NONE :(mlstring, mlstring) id option) | SOME id => SOME (Long s id) else (NONE :(mlstring, mlstring) id option)) ∧ (∀(v1 :lit). v_to_id (Litv v1) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v3 :v list). v_to_id (Conv (NONE :stamp option) v3) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v29 :stamp). v_to_id (Conv (SOME v29) ([] :v list)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v63 :int) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Litv (IntLit v63)::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v64 :char) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Litv (Char v64)::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v80 :v list) (v79 :v) (v75 :v) (v65 :mlstring) (v29 :stamp). v_to_id (Conv (SOME v29) (Litv (StrLit v65)::v75::v79::v80)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v66 :word8) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Litv (Word8 v66)::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v67 :word64) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Litv (Word64 v67)::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v68 :word64) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Litv (Float64 v68)::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v37 :v list) (v36 :stamp option) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Conv v36 v37::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v40 :exp) (v39 :mlstring) (v38 :v sem_env) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Closure v38 v39 v40::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v43 :mlstring) (v42 :(mlstring # mlstring # exp) list) (v41 :v sem_env) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Recclosure v41 v42 v43::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v45 :num) (v44 :bool) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Loc v44 v45::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v46 :v list) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Vectorv v46::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v48 :num # num) (v47 :v sem_env) (v32 :v list) (v29 :stamp). v_to_id (Conv (SOME v29) (Env v47 v48::v32)) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v6 :exp) (v5 :mlstring) (v4 :v sem_env). v_to_id (Closure v4 v5 v6) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v9 :mlstring) (v8 :(mlstring # mlstring # exp) list) (v7 :v sem_env). v_to_id (Recclosure v7 v8 v9) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v11 :num) (v10 :bool). v_to_id (Loc v10 v11) = (NONE :(mlstring, mlstring) id option)) ∧ (∀(v12 :v list). v_to_id (Vectorv v12) = (NONE :(mlstring, mlstring) id option)) ∧ ∀(v14 :num # num) (v13 :v sem_env). v_to_id (Env v13 v14) = (NONE :(mlstring, mlstring) id option)
list_roundtrip_all=∀(xs :v list). v_to_list (list_to_v xs) = SOME xs
id_type=:v -> (mlstring, mlstring) id option
chars_type=:v -> string option
word64_type=:v -> word64 list option
list_roundtrip=SOME [Litv (IntLit (1 :int)); Litv (IntLit (2 :int))]
malformed=(NONE :v list option)
chars=SOME "ab"
strings=SOME «ab»
identifier=SOME (Long «M» (Short «x» :(mlstring, mlstring) id))
word8=SOME [(3w :word8); (7w :word8)]
bad_word8=(NONE :word8 list option)
