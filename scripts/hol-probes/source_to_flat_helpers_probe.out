compile_var_def_typed=(∀(t :tra) (v0 :tra) (i :num). compile_var t (Glob v0 i) = (App t (GlobalVarLookup i) ([] :exp list) :exp)) ∧ ∀(t :tra) (v1 :tra) (s :mlstring). compile_var t (Local v1 s) = Var_local t s
compile_pat_def_typed=(∀(v :mlstring) (env :environment). compile_pat env (Pvar v :ast$pat) = (Pvar v :flatLang$pat)) ∧ (∀(env :environment). compile_pat env Pany = Pany) ∧ (∀(l :lit) (env :environment). compile_pat env (Plit l :ast$pat) = (Plit l :flatLang$pat)) ∧ (∀(ps :ast$pat list) (id :(mlstring, mlstring) id option) (env :environment). compile_pat env (Pcon id ps) = Pcon (OPTION_JOIN (OPTION_MAP (nsLookup env.c) id)) (MAP (λ(a :ast$pat). compile_pat env a) ps)) ∧ (∀(p :ast$pat) (env :environment). compile_pat env (Pref p) = Pref (compile_pat env p)) ∧ (∀(p :ast$pat) (i :mlstring) (env :environment). compile_pat env (Pas p i) = Pas (compile_pat env p) i) ∧ ∀(t :ast_t) (p :ast$pat) (env :environment). compile_pat env (Ptannot p t) = compile_pat env p
pat_tups_def_typed=(∀(t :tra). pat_tups t ([] :mlstring list) = ([] :(mlstring # var_name) list)) ∧ ∀(t :tra) (x :mlstring) (xs :mlstring list). pat_tups t (x::xs) = (let (t' :tra) = t § LENGTH xs + (1 :num) in (x,Local t' x)::pat_tups t xs)
astOp_to_flatOp_def_typed=∀(op :ast$op). astOp_to_flatOp op = case op of Arith v11 v12 => Src op | FromTo v13 v14 => Src op | Shift v15 v16 v17 => Src op | Equality => Src op | Test v18 v19 => Src op | Opapp => Src op | Opassign => Src op | Opref => Src op | Opderef => El (0 :num) | Aw8alloc => Src op | Aw8sub => Src op | Aw8length => Src op | Aw8update => Src op | CopyStrStr => Src op | CopyStrAw8 => Src op | CopyAw8Str => Src op | CopyAw8Aw8 => Src op | XorAw8Str_unsafe => Src op | Implode => Src op | Explode => Src op | Strsub => Src op | Strlen => Src op | Strcat => Src op | VfromList => Src op | Vsub => Src op | Vlength => Src op | Aalloc => Src op | AallocEmpty => Src op | AallocFixed => Src op | Asub => Src op | Alength => Src op | Aupdate => Src op | Vsub_unsafe => Src op | Asub_unsafe => Src op | Aupdate_unsafe => Src op | Aw8sub_unsafe => Src op | Aw8update_unsafe => Src op | ThunkOp v20 => Src op | ListAppend => Src op | ConfigGC => Src op | FFI v21 => Src op | Eval => Src op | Env_id => Src op
type_group_id_type_def_typed=type_group_id_type (NONE :(α # (β # γ) option) option) = (NONE :(α # β option) option) ∧ type_group_id_type (SOME ((cn :α),(NONE :(β # γ) option))) = SOME (cn,(NONE :β option)) ∧ type_group_id_type (SOME (cn,SOME ((ty_id :β),(ctors :γ)))) = SOME (cn,SOME ty_id)
str_sep_def_typed=str_sep = «_»
join_all_names_aux_def_typed=(∀(ys :mlstring list). join_all_names_aux ([] :mlstring list) ys = ys) ∧ ∀(x :mlstring) (xs :mlstring list) (ys :mlstring list). join_all_names_aux (x::xs) ys = case ys of ([] :mlstring list) => join_all_names_aux xs (x::ys) | v2::v3 => join_all_names_aux xs (x::str_sep::ys)
join_all_names_def_typed=∀(xs :mlstring list). join_all_names xs = case xs of ([] :mlstring list) => concat (join_all_names_aux xs ([] :mlstring list)) | [x] => x | x::v6::v7 => concat (join_all_names_aux xs ([] :mlstring list))
om_tra_def_typed=om_tra = orphan_trace ▷ (1 :num)
alloc_defs_def_typed=(∀(n :num) (next :num). alloc_defs n next ([] :α list) = ([] :(α # var_name) list)) ∧ ∀(n :num) (next :num) (x :α) (xs :α list). alloc_defs n next (x::xs) = (x,Glob om_tra next)::alloc_defs (n + (1 :num)) (next + (1 :num)) xs
make_varls_def_typed=(∀(t :tra) (n :num) (idx :num). make_varls n t idx ([] :mlstring list) = (Con None (NONE :(num # num option) option) ([] :exp list) :exp)) ∧ (∀(x :mlstring) (t :tra) (n :num) (idx :num). make_varls n t idx [x] = (App None (GlobalVarInit idx) [Var_local None x] :exp)) ∧ ∀(x :mlstring) (v9 :mlstring list) (v8 :mlstring) (t :tra) (n :num) (idx :num). make_varls n t idx (x::v8::v9) = (Let None (NONE :mlstring option) (App None (GlobalVarInit idx) [Var_local None x] :exp) (make_varls (n + (1 :num)) None (idx + (1 :num)) (v8::v9)) :exp)
empty_env_def_typed=empty_env = <|v := (nsEmpty :(mlstring, mlstring, var_name) namespace); c := (nsEmpty :(mlstring, mlstring, num # (num # (num # num) list) option) namespace)|>
extend_env_def_typed=∀(e1 :environment) (e2 :environment). extend_env e1 e2 = <|v := nsAppend e1.v e2.v; c := nsAppend e1.c e2.c|>
lift_env_def_typed=∀(mn :mlstring) (e :environment). lift_env mn e = <|v := nsLift mn e.v; c := nsLift mn e.c|>
lookup_inc_def_typed=∀(i :num) (t :num sptree$num_map). lookup_inc i t = case lookup i t of (NONE :num option) => ((0 :num),insert i (1 :num) t) | SOME n => (n,insert i (n + (1 :num)) t)
alloc_tags1_def_typed=(alloc_tags1 ([] :(β # γ list) list) :(α, β, num) namespace # num sptree$num_map # (num # num) list) = ((nsEmpty :(α, β, num) namespace),(LN :num sptree$num_map),([] :(num # num) list)) ∧ ∀(ts :γ list) (ctors :(β # γ list) list) (cn :β). (alloc_tags1 ((cn,ts)::ctors) :(α, β, num) namespace # num sptree$num_map # (num # num) list) = (let ((ns :(α, β, num) namespace),(cids :num sptree$num_map),(tag_list :(num # num) list)) = (alloc_tags1 ctors :(α, β, num) namespace # num sptree$num_map # (num # num) list); (arity :num) = LENGTH ts; ((tag :num),(new_cids :num sptree$num_map)) = lookup_inc arity cids in (nsBind cn tag ns,new_cids,(tag,arity)::tag_list))
alloc_tags_def_typed=∀(tid :γ) (ctors :(β # δ list) list). (alloc_tags tid ctors :(α, β, num # (γ # (num # num) list) option) namespace # num sptree$num_map) = (let ((con_ns :(α, β, num) namespace),(cid_spt :num sptree$num_map),(tag_list :(num # num) list)) = (alloc_tags1 (REVERSE ctors) :(α, β, num) namespace # num sptree$num_map # (num # num) list); (data :(γ # (num # num) list) option) = SOME (tid,REVERSE tag_list) in (nsMap (λ(tag :num). (tag,data)) con_ns,cid_spt))
env_id_tuple_def_typed=∀(gen :num) (id :num). env_id_tuple gen id = (Con None (NONE :(num # num option) option) [(Lit None (IntLit ((&gen) :int)) :exp); (Lit None (IntLit ((&id) :int)) :exp)] :exp)
simple_dlet_def_typed=∀(p :ast$pat) (e :ast$exp). simple_dlet p e = case p of Pany => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Pvar pv :ast$pat) => (case e of (Raise v29 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Handle v30 v31 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Lit v32 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Con v33 v34 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | Var v => SOME (pv,v) | (Fun v36 v37 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (App v38 v39 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | Log v40 v41 v42 => (NONE :(mlstring # (mlstring, mlstring) id) option) | (If v43 v44 v45 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Mat v46 v47 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Let v48 v49 v50 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | (Letrec v51 v52 :ast$exp) => (NONE :(mlstring # (mlstring, mlstring) id) option) | Tannot v53 v54 => (NONE :(mlstring # (mlstring, mlstring) id) option) | Lannot v55 v56 => (NONE :(mlstring # (mlstring, mlstring) id) option)) | (Plit v11 :ast$pat) => (NONE :(mlstring # (mlstring, mlstring) id) option) | Pcon v12 v13 => (NONE :(mlstring # (mlstring, mlstring) id) option) | Pref v14 => (NONE :(mlstring # (mlstring, mlstring) id) option) | Pas v15 v16 => (NONE :(mlstring # (mlstring, mlstring) id) option) | Ptannot v17 v18 => (NONE :(mlstring # (mlstring, mlstring) id) option)
concat_def_typed=∀(l :mlstring list). concat l = implode (CONCAT (MAP (λ(s :mlstring). case s of implode x => x) l))
