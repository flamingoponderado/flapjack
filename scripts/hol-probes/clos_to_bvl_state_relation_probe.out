state_rel_typed=∀(f :num |-> num) (s :(γ, 'ffi) closSem$state) (t :(γ, 'ffi) state). (state_rel f s t :bool) ⇔ s.ffi = t.ffi ∧ LIST_REL (OPTREL (v_rel s.max_app f t.refs t.code :closSem$v -> v -> bool)) s.globals (DROP num_added_globals t.globals) ∧ get_global (0 :num) t.globals = SOME (SOME (global_table s.max_app)) ∧ INJ (FAPPLY f) (FDOM f) (FRANGE f) ∧ (∀(x :num) (y :num) (bs :word8 list). FLOOKUP f x = SOME y ⇒ FLOOKUP t.refs y ≠ SOME (ByteArray T bs :v ref)) ∧ FDOM f = FDOM s.refs ∧ FRANGE f ⊆ FDOM t.refs ∧ (∀(n :num) (x :closSem$v closSem$ref). FLOOKUP s.refs n = SOME x ⇒ ∃(y :v ref) (m :num). FLOOKUP f n = SOME m ∧ FLOOKUP t.refs m = SOME y ∧ (ref_rel (v_rel s.max_app f t.refs t.code :closSem$v -> v -> bool) x y :bool)) ∧ (∀(n :num). n < s.max_app ⇒ lookup (generic_app_fn_location n) t.code = SOME (n + (2 :num),generate_generic_app s.max_app n)) ∧ (∀(tot :num) (n :num). tot < s.max_app ∧ n < tot ⇒ lookup (partial_app_fn_location s.max_app tot n) t.code = SOME (tot − n + (1 :num),generate_partial_app_closure_fn tot n)) ∧ lookup (num_stubs s.max_app − (2 :num)) t.code = SOME ((2 :num),force_thunk_code) ∧ compile_oracle_inv s.max_app s.code s.compile s.compile_oracle t.code t.compile t.compile_oracle ∧ ∀(name :num) (arity :num) (c :closLang$exp). FLOOKUP s.code name = SOME (arity,c) ⇒ ∃(aux1 :(num # num # bvl$exp) list) (c2 :bvl$exp) (aux2 :(num # num # bvl$exp) list). compile_exps s.max_app [c] aux1 = ([c2],aux2) ∧ lookup (name + num_stubs s.max_app) t.code = SOME (arity,c2) ∧ code_installed aux2 t.code
state_rel_clock_typed=(∀(f :num |-> num) (s :(α, β) closSem$state) (t :(α, β) state). (state_rel f s (t with clock := (x :num)) :bool) ⇔ (state_rel f s t :bool)) ∧ ∀(f :num |-> num) (s :(γ, δ) closSem$state) (t :(γ, δ) state). (state_rel f (s with clock := x) t :bool) ⇔ (state_rel f s t :bool)
state_rel_refs_lookup_typed=(state_rel (f :num |-> num) (s1 :(α, β) closSem$state) (s2 :(α, β) state) :bool) ∧ FLOOKUP s1.refs (p :num) = SOME (x :closSem$v closSem$ref) ∧ FLOOKUP f p = SOME (p' :num) ⇒ ∃(x' :v ref). FLOOKUP s2.refs p' = SOME x' ∧ (ref_rel (v_rel s1.max_app f s2.refs s2.code :closSem$v -> v -> bool) x x' :bool)
compile_exps_correct_typed=(∀(tmp :closLang$exp list # closSem$v list # (γ, 'ffi) closSem$state) (xs :closLang$exp list) (env :closSem$v list) (s1 :(γ, 'ffi) closSem$state) (aux1 :(num # num # bvl$exp) list) (t1 :(γ, 'ffi) state) (env' :v list) (f1 :num |-> num) (res :(closSem$v list, closSem$v) result) (s2 :(γ, 'ffi) closSem$state) (ys :bvl$exp list) (aux2 :(num # num # bvl$exp) list). tmp = (xs,env,s1) ∧ evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :closSem$v error_result) :(closSem$v list, closSem$v) result) ∧ compile_exps s1.max_app xs aux1 = (ys,aux2) ∧ every_Fn_SOME xs ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_SOME [SND (SND p)]) s1.code ∧ every_Fn_vs_SOME xs ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_vs_SOME [SND (SND p)]) s1.code ∧ code_installed aux2 t1.code ∧ (env_rel s1.max_app f1 t1.refs t1.code env env' :bool) ∧ (state_rel f1 s1 t1 :bool) ⇒ ∃(ck :num) (res' :(v list, v) result) (t2 :(γ, 'ffi) state) (f2 :num |-> num). evaluate (ys,env',t1 with clock := s1.clock + ck) = (res',t2) ∧ result_rel (LIST_REL (v_rel s1.max_app f2 t2.refs t2.code :closSem$v -> v -> bool)) (v_rel s1.max_app f2 t2.refs t2.code :closSem$v -> v -> bool) res res' ∧ (state_rel f2 s2 t2 :bool) ∧ f1 ⊑ f2 ∧ FDIFF t1.refs (FRANGE f1) ⊑ FDIFF t2.refs (FRANGE f2) ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_SOME [SND (SND p)]) s2.code ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_vs_SOME [SND (SND p)]) s2.code ∧ s2.clock = t2.clock) ∧ ∀(loc_opt :num option) (func :closSem$v) (args' :closSem$v list) (s1 :(γ, 'ffi) closSem$state) (res :(closSem$v list, closSem$v) result) (s2 :(γ, 'ffi) closSem$state) (env :v list) (t1 :(γ, 'ffi) state) (args'' :v list) (func' :v) (f1 :num |-> num). evaluate_app loc_opt func args' s1 = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :closSem$v error_result) :(closSem$v list, closSem$v) result) ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_SOME [SND (SND p)]) s1.code ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_vs_SOME [SND (SND p)]) s1.code ∧ (v_rel s1.max_app f1 t1.refs t1.code func func' :bool) ∧ LIST_REL (v_rel s1.max_app f1 t1.refs t1.code :closSem$v -> v -> bool) args' args'' ∧ (state_rel f1 s1 t1 :bool) ⇒ ∃(ck :num) (res' :(v list, v) result) (t2 :(γ, 'ffi) state) (f2 :num |-> num). (LENGTH args'' ≠ (0 :num) ⇒ case loc_opt of (NONE :num option) => evaluate ([mk_cl_call (Var (LENGTH args'') :bvl$exp) (GENLIST Var (LENGTH args''))],args'' ++ [func'] ++ env,t1 with clock := s1.clock + ck) = (res',t2) | SOME loc => (case (find_code (SOME (loc + num_stubs s1.max_app)) (args'' ++ [func']) t1.code :(v list # bvl$exp) option) of (NONE :(v list # bvl$exp) option) => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),t2) | SOME (args,exp) => if s1.clock + ck < LENGTH args'' then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),t1 with clock := (0 :num)) else evaluate ([exp],args,t1 with clock := s1.clock + ck − LENGTH args'')) = (res',t2)) ∧ result_rel (LIST_REL (v_rel s1.max_app f2 t2.refs t2.code :closSem$v -> v -> bool)) (v_rel s1.max_app f2 t2.refs t2.code :closSem$v -> v -> bool) res res' ∧ (state_rel f2 s2 t2 :bool) ∧ f1 ⊑ f2 ∧ FDIFF t1.refs (FRANGE f1) ⊑ FDIFF t2.refs (FRANGE f2) ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_SOME [SND (SND p)]) s2.code ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_vs_SOME [SND (SND p)]) s2.code ∧ s2.clock = t2.clock
