known_op_const_typed=known (a :clos_known$config) ((Op (tv :tra) (IntOp (Const ((&(n :num)) :int))) ([] :closLang$exp list) :closLang$exp)::(b :closLang$exp list)) (c :val_approx list) (d :val_approx sptree$num_map) = (CONS ((Op tv (IntOp (Const ((&n) :int))) ([] :closLang$exp list) :closLang$exp),(Int ((&n) :int) :val_approx)) ## (I :val_approx sptree$num_map -> val_approx sptree$num_map)) (known a b c d)
