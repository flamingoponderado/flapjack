val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "bytes_in_memory_eq_mem" bytes_in_memory_eq_mem;
val _=types "bytes_in_memory_eq_mem_types" bytes_in_memory_eq_mem;
val _=print("bytes_in_memory_eq_mem_hypotheses="^Int.toString(length(hyp bytes_in_memory_eq_mem))^"\n");
val _=show_types:=false;
fun observe label q = (print(label^"=");print_term(rconc(EVAL q));print "\n");
val base8=``255w:8 word``;
val src8=``λa:8 word. if a=^base8 then 11w else if a=^base8+1w then 22w else 99w:word8``;
val tgt8=``λa:8 word. if a=^base8 then 11w else if a=^base8+1w then 22w else 44w:word8``;
val dom8=``{^base8;^base8+1w}``;
val _=observe "wrap8" ``bytes_in_memory ^base8 [11w;22w] ^src8 ^dom8 /\ bytes_in_memory ^base8 [11w;22w] ^tgt8 ^dom8``;
