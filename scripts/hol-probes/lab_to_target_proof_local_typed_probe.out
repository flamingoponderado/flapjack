byte_align_32_IMP_typed=dimindex (:α) = (32 :num) ⇒ (byte_align (a :α word) = a ⇒ w2n a MOD (4 :num) = (0 :num)) ∧ (byte_align a + (1w :α word) = a ⇒ w2n a MOD (4 :num) = (1 :num)) ∧ (byte_align a + (2w :α word) = a ⇒ w2n a MOD (4 :num) = (2 :num)) ∧ (byte_align a + (3w :α word) = a ⇒ w2n a MOD (4 :num) = (3 :num))
