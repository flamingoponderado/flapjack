byte_align_64_IMP_typed=dimindex (:α) = (64 :num) ⇒ (byte_align (a :α word) + (7w :α word) = a ⇒ w2n a MOD (8 :num) = (7 :num)) ∧ (byte_align a + (6w :α word) = a ⇒ w2n a MOD (8 :num) = (6 :num)) ∧ (byte_align a + (5w :α word) = a ⇒ w2n a MOD (8 :num) = (5 :num)) ∧ (byte_align a + (4w :α word) = a ⇒ w2n a MOD (8 :num) = (4 :num)) ∧ (byte_align a + (3w :α word) = a ⇒ w2n a MOD (8 :num) = (3 :num)) ∧ (byte_align a + (2w :α word) = a ⇒ w2n a MOD (8 :num) = (2 :num)) ∧ (byte_align a + (1w :α word) = a ⇒ w2n a MOD (8 :num) = (1 :num)) ∧ (byte_align a = a ⇒ w2n a MOD (8 :num) = (0 :num))
