enc_lines_again_simp_EQ_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (ls :α line list) (acc :α line list) (b :bool). (let ((ls' :α line list),(flag :bool)) = enc_lines_again_simp labs ffis pos enc ls in enc_lines_again labs ffis pos enc ls (acc,b) = (REVERSE acc ++ ls',sec_length ls' pos,b ∧ flag))
enc_secs_again_all_enc_ok_pre_typed=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (enc :α asm -> word8 list) (ls :α sec list) (res :α sec list) (ok :bool) (c :α asm_config). enc_secs_again pos labs ffis enc ls = (res,ok) ∧ all_enc_ok_pre c ls ⇒ all_enc_ok_pre c res
enc_with_nop_thm_typed=enc_with_nop (enc :α asm -> β list) (b :α asm) (bytes :β list) ⇔ ∃(n :num). bytes = enc b ++ FLAT (REPLICATE n (enc (Inst (Skip :α inst) :α asm)))
evaluate_ignore_clocks_typed=(evaluate (mc_conf :(γ, α, δ) machine_config) (ffi :β ffi_state) (k :num) (ms :α) :machine_result # α # β ffi_state) = ((r1 :machine_result),(ms1 :α),(st1 :β ffi_state)) ∧ r1 ≠ TimeOut ∧ (evaluate mc_conf ffi (k' :num) ms :machine_result # α # β ffi_state) = ((r2 :machine_result),(ms2 :α),(st2 :β ffi_state)) ∧ r2 ≠ TimeOut ⇒ (r1,ms1,st1) = (r2,ms2,st2)
evaluate_nop_steps_typed=∀(n :num) (s1 :α asm_state) (ms1 :'state) (c :(α, 'state, β) machine_config). encoder_correct c.target ∧ c.prog_addresses = s1.mem_domain ∧ ffi_entry_pcs_disjoint c s1 (n * LENGTH (c.target.config.encode (Inst (Skip :α inst) :α asm))) ∧ interference_ok c.next_interfer (c.target.proj s1.mem_domain) ∧ bytes_in_memory s1.pc (FLAT (REPLICATE n (c.target.config.encode (Inst (Skip :α inst) :α asm)))) s1.mem s1.mem_domain ∧ (case c.target.config.link_reg of (NONE :num option) => T | SOME r => s1.lr = r) ∧ (s1.be ⇔ c.target.config.big_endian) ∧ s1.align = c.target.config.code_alignment ∧ ¬s1.failed ∧ target_state_rel c.target s1 ms1 ⇒ ∃(l :num) (ms2 :'state). ∀(k :num). (evaluate c (io :γ ffi_state) (k + l) ms1 :machine_result # 'state # γ ffi_state) = (evaluate (shift_interfer l c) io k ms2 :machine_result # 'state # γ ffi_state) ∧ find_next_interference c io (k + l) ms1 = find_next_interference (shift_interfer l c) io k ms2 ∧ target_state_rel c.target (upd_pc (s1.pc + (n2w (n * LENGTH (c.target.config.encode (Inst (Skip :α inst) :α asm))) :α word)) s1) ms2
find_ffi_names_append_typed=∀(l1 :α sec list) (l2 :α sec list). find_ffi_names (l1 ++ l2) = find_ffi_names l2 ++ FILTER (λ(n :ffiname). ¬MEM n (find_ffi_names l2)) (find_ffi_names l1)
