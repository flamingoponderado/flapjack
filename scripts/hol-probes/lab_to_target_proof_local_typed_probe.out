bytes_in_mem_asm_write_bytearray_lemma_typed=∀(xs :α list) (p :β word). (∀(a :β word). a ∉ (k :β word -> bool) ⇒ (m1 :β word -> α) a = (m2 :β word -> α) a) ⇒ bytes_in_mem p xs m1 (d :β word -> bool) k ⇒ bytes_in_mem p xs m2 d k
dimword_eq_32_imp_or_bytes_typed=dimindex (:α) = (32 :num) ⇒ (w2w (w2w (x :α word) :word8) :α word) ‖ (w2w (w2w (x ⋙ (8 :num)) :word8) :α word) ≪ (8 :num) ‖ (w2w (w2w (x ⋙ (16 :num)) :word8) :α word) ≪ (16 :num) ‖ (w2w (w2w (x ⋙ (24 :num)) :word8) :α word) ≪ (24 :num) = x
dimword_eq_64_imp_or_bytes_typed=dimindex (:α) = (64 :num) ⇒ (w2w (w2w (x :α word) :word8) :α word) ‖ (w2w (w2w (x ⋙ (8 :num)) :word8) :α word) ≪ (8 :num) ‖ (w2w (w2w (x ⋙ (16 :num)) :word8) :α word) ≪ (16 :num) ‖ (w2w (w2w (x ⋙ (24 :num)) :word8) :α word) ≪ (24 :num) ‖ (w2w (w2w (x ⋙ (32 :num)) :word8) :α word) ≪ (32 :num) ‖ (w2w (w2w (x ⋙ (40 :num)) :word8) :α word) ≪ (40 :num) ‖ (w2w (w2w (x ⋙ (48 :num)) :word8) :α word) ≪ (48 :num) ‖ (w2w (w2w (x ⋙ (56 :num)) :word8) :α word) ≪ (56 :num) = x
enc_lines_again_IMP_similar_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (lines :α line list) (acc :α line list) (ok :bool) (lines' :α line list) (ok' :num # bool) (curr :α line list). enc_lines_again labs ffis pos enc lines (acc,ok) = (lines',ok') ⇒ LIST_REL (line_similar :α line -> α line -> bool) curr (REVERSE acc) ⇒ LIST_REL (line_similar :α line -> α line -> bool) (curr ++ lines) lines'
enc_lines_again_all_enc_ok_pre_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (lines :α line list) (acc :α line list) (ok :bool) (res :α line list) (ok' :num # bool) (c :α asm_config). enc_lines_again labs ffis pos enc lines (acc,ok) = (res,ok') ∧ EVERY (line_ok_pre c) lines ∧ EVERY (line_ok_pre c) acc ⇒ EVERY (line_ok_pre c) res
