prog_to_bytes_lemma_typed=∀(code2 :α sec list) (code1 :α sec list) (pc :num) (i :α line) (pos :num). code_similar code1 code2 ∧ all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list) pos code2 ∧ asm_fetch_aux pc code1 = SOME i ⇒ ∃(bs :word8 list) (j :α line) (bs2 :word8 list). prog_to_bytes code2 = bs ++ line_bytes j ++ bs2 ∧ LENGTH bs + pos = pos_val pc pos code2 ∧ LENGTH bs + pos + LENGTH (line_bytes j) = pos_val (pc + (1 :num)) pos code2 ∧ line_similar i j ∧ line_ok mc_conf.target.config labs ffi_names (pos_val pc pos code2) j
