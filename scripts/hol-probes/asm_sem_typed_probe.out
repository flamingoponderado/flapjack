word_shift_def_typed=(∀(w :α word) (n :num). word_shift Lsl w n = w ≪ n) ∧ (∀(w :α word) (n :num). word_shift Lsr w n = w ⋙ n) ∧ (∀(w :α word) (n :num). word_shift Asr w n = w ≫ n) ∧ ∀(w :α word) (n :num). word_shift Ror w n = w ⇄ n
arith_upd_def_typed=(∀(b :binop) (r1 :num) (r2 :num) (ri :α reg_imm) (s :α asm_state). arith_upd (Binop b r1 r2 ri) s = binop_upd r1 b (read_reg r2 s) (reg_imm ri s) s) ∧ (∀(l :shift) (r1 :num) (r2 :num) (ri :α reg_imm) (s :α asm_state). arith_upd (Shift l r1 r2 ri :α arith) s = assert (case ri of (Reg r :α reg_imm) => w2n (read_reg r s) < dimindex (:α) | Imm v3 => T) (upd_reg r1 (word_shift l (read_reg r2 s) (w2n (reg_imm ri s))) s)) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (s :α asm_state). arith_upd (Div r1 r2 r3 :α arith) s = (let (q :α word) = read_reg r3 s in assert (q ≠ (0w :α word)) (upd_reg r1 (read_reg r2 s / q) s))) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :α asm_state). arith_upd (LongMul r1 r2 r3 r4 :α arith) s = (let (r :num) = w2n (read_reg r3 s) * w2n (read_reg r4 s) in upd_reg r2 (n2w r :α word) (upd_reg r1 (n2w (r DIV dimword (:α)) :α word) s))) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num) (s :α asm_state). arith_upd (LongDiv r1 r2 r3 r4 r5 :α arith) s = (let (n :num) = w2n (read_reg r3 s) * dimword (:α) + w2n (read_reg r4 s); (d :num) = w2n (read_reg r5 s); (q :num) = n DIV d in assert (d ≠ (0 :num) ∧ q < dimword (:α)) (upd_reg r1 (n2w q :α word) (upd_reg r2 (n2w (n MOD d) :α word) s)))) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :α asm_state). arith_upd (AddCarry r1 r2 r3 r4 :α arith) s = (let (r :num) = w2n (read_reg r2 s) + w2n (read_reg r3 s) + if read_reg r4 s = (0w :α word) then (0 :num) else (1 :num) in upd_reg r4 (if dimword (:α) ≤ r then (1w :α word) else (0w :α word)) (upd_reg r1 (n2w r :α word) s))) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :α asm_state). arith_upd (AddOverflow r1 r2 r3 r4 :α arith) s = (let (w2 :α word) = read_reg r2 s; (w3 :α word) = read_reg r3 s in upd_reg r4 (if w2i (w2 + w3) ≠ w2i w2 + w2i w3 then (1w :α word) else (0w :α word)) (upd_reg r1 (w2 + w3) s))) ∧ ∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :α asm_state). arith_upd (SubOverflow r1 r2 r3 r4 :α arith) s = (let (w2 :α word) = read_reg r2 s; (w3 :α word) = read_reg r3 s in upd_reg r4 (if w2i (w2 − w3) ≠ w2i w2 − w2i w3 then (1w :α word) else (0w :α word)) (upd_reg r1 (w2 − w3) s))
assert_def_typed=∀(b :bool) (s :α asm_state). assert b s = s with failed := (¬b ∨ s.failed)
binop_upd_def_typed=(∀(r :num) (w1 :α word) (w2 :α word). binop_upd r Add w1 w2 = upd_reg r (w1 + w2)) ∧ (∀(r :num) (w1 :α word) (w2 :α word). binop_upd r Sub w1 w2 = upd_reg r (w1 − w2)) ∧ (∀(r :num) (w1 :α word) (w2 :α word). binop_upd r And w1 w2 = upd_reg r (w1 && w2)) ∧ (∀(r :num) (w1 :α word) (w2 :α word). binop_upd r Or w1 w2 = upd_reg r (w1 ‖ w2)) ∧ ∀(r :num) (w1 :α word) (w2 :α word). binop_upd r Xor w1 w2 = upd_reg r (w1 ⊕ w2)
is_test_def_typed=∀(c :cmp). is_test c ⇔ c = Test ∨ c = NotTest
read_fp_reg_def_typed=∀(r :num) (s :α asm_state). read_fp_reg r s = s.fp_regs r
read_mem_def_typed=∀(a :α word) (s :α asm_state). read_mem a s = s.mem a
read_reg_def_typed=∀(r :num) (s :α asm_state). read_reg r s = s.regs r
reg_imm_def_typed=(∀(r :num) (s :α asm_state). reg_imm (Reg r :α reg_imm) s = read_reg r s) ∧ ∀(w :α word) (s :α asm_state). reg_imm (Imm w) s = w
upd_fp_reg_def_typed=∀(r :num) (v :word64) (s :α asm_state). upd_fp_reg r v s = s with fp_regs := s.fp_regs⦇r ↦ v⦈
upd_mem_def_typed=∀(a :α word) (b :word8) (s :α asm_state). upd_mem a b s = s with mem := s.mem⦇a ↦ b⦈
upd_pc_def_typed=∀(pc :α word) (s :α asm_state). upd_pc pc s = s with pc := pc
upd_reg_def_typed=∀(r :num) (v :α word) (s :α asm_state). upd_reg r v s = s with regs := s.regs⦇r ↦ v⦈
fp_upd_def_typed=(∀(r :num) (d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPLess r d1 d2) s = upd_reg r (if fp64_lessThan (read_fp_reg d1 s) (read_fp_reg d2 s) then (1w :α word) else (0w :α word)) s) ∧ (∀(r :num) (d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPLessEqual r d1 d2) s = upd_reg r (if fp64_lessEqual (read_fp_reg d1 s) (read_fp_reg d2 s) then (1w :α word) else (0w :α word)) s) ∧ (∀(r :num) (d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPEqual r d1 d2) s = upd_reg r (if fp64_equal (read_fp_reg d1 s) (read_fp_reg d2 s) then (1w :α word) else (0w :α word)) s) ∧ (∀(d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPMov d1 d2) s = upd_fp_reg d1 (read_fp_reg d2 s) s) ∧ (∀(d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPAbs d1 d2) s = upd_fp_reg d1 (fp64_abs (read_fp_reg d2 s)) s) ∧ (∀(d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPNeg d1 d2) s = upd_fp_reg d1 (fp64_negate (read_fp_reg d2 s)) s) ∧ (∀(d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPSqrt d1 d2) s = upd_fp_reg d1 (fp64_sqrt roundTiesToEven (read_fp_reg d2 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :α asm_state). fp_upd (FPAdd d1 d2 d3) s = upd_fp_reg d1 (fp64_add roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :α asm_state). fp_upd (FPSub d1 d2 d3) s = upd_fp_reg d1 (fp64_sub roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :α asm_state). fp_upd (FPMul d1 d2 d3) s = upd_fp_reg d1 (fp64_mul roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :α asm_state). fp_upd (FPDiv d1 d2 d3) s = upd_fp_reg d1 (fp64_div roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :α asm_state). fp_upd (FPFma d1 d2 d3) s = upd_fp_reg d1 (fp64_mul_add roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s) (read_fp_reg d1 s)) s) ∧ (∀(r1 :num) (r2 :num) (d :num) (s :α asm_state). fp_upd (FPMovToReg r1 r2 d) s = if dimindex (:α) = (64 :num) then upd_reg r1 (w2w (read_fp_reg d s) :α word) s else (let (v :word64) = read_fp_reg d s in upd_reg r2 (((63 :num) >< (32 :num)) v :α word) (upd_reg r1 (((31 :num) >< (0 :num)) v :α word) s))) ∧ (∀(d :num) (r1 :num) (r2 :num) (s :α asm_state). fp_upd (FPMovFromReg d r1 r2) s = upd_fp_reg d (if dimindex (:α) = (64 :num) then (w2w (read_reg r1 s) :word64) else ((read_reg r2 s @@ read_reg r1 s) :word64)) s) ∧ (∀(d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPToInt d1 d2) s = case fp64_to_int roundTiesToEven (read_fp_reg d2 s) of (NONE :int option) => assert F s | SOME i => (let (w :word32) = (i2w i :word32) in ((if dimindex (:α) = (64 :num) then upd_fp_reg d1 (w2w w :word64) else (let ((h :num),(l :num)) = if ODD d1 then ((63 :num),(32 :num)) else ((31 :num),(0 :num)) in upd_fp_reg (d1 DIV (2 :num)) (bit_field_insert h l w (read_fp_reg (d1 DIV (2 :num)) s)))) (assert (w2i w = i) s) :α asm_state))) ∧ ∀(d1 :num) (d2 :num) (s :α asm_state). fp_upd (FPFromInt d1 d2) s = (let (i :int) = if dimindex (:α) = (64 :num) then w2i (((31 :num) >< (0 :num)) (read_fp_reg d2 s) :word32) else (let (v :word64) = read_fp_reg (d2 DIV (2 :num)) s in w2i (if ODD d2 then (((63 :num) >< (32 :num)) v :α word) else (((31 :num) >< (0 :num)) v :α word))) in upd_fp_reg d1 (int_to_fp64 roundTiesToEven i) s)
mem_load_def_typed=∀(n :num) (r :num) (a :α addr) (s :α asm_state). mem_load n r a s = (let (a :α word) = addr a s; ((w :α word),(s :α asm_state)) = (read_mem_word (if s.be then a + (n2w (n − (1 :num)) :α word) else a) n s :α word # α asm_state); (s :α asm_state) = upd_reg r w s in assert (aligned (LOG2 n) a) s)
mem_op_def_typed=(∀(r :num) (a :α addr). mem_op Load r a = mem_load (dimindex (:α) DIV (8 :num)) r a) ∧ (∀(r :num) (a :α addr). mem_op Store r a = mem_store (dimindex (:α) DIV (8 :num)) r a) ∧ (∀(r :num) (a :α addr). mem_op Load8 r a = mem_load (1 :num) r a) ∧ (∀(r :num) (a :α addr). mem_op Store8 r a = mem_store (1 :num) r a) ∧ (∀(r :num) (a :α addr). mem_op Load16 r a = mem_load (2 :num) r a) ∧ (∀(r :num) (a :α addr). mem_op Store16 r a = mem_store (2 :num) r a) ∧ (∀(r :num) (a :α addr). mem_op Load32 r a = mem_load (4 :num) r a) ∧ ∀(r :num) (a :α addr). mem_op Store32 r a = mem_store (4 :num) r a
mem_store_def_typed=∀(n :num) (r :num) (a :α addr) (s :α asm_state). mem_store n r a s = (let (a :α word) = addr a s; (w :α word) = read_reg r s; (s :α asm_state) = write_mem_word (if s.be then a + (n2w (n − (1 :num)) :α word) else a) n w s in assert (aligned (LOG2 n) a) s)
addr_def_typed=∀(r :num) (offset :α word) (s :α asm_state). addr (Addr r offset) s = read_reg r s + offset
read_mem_word_def_typed=(∀(a :β word) (s :β asm_state). (read_mem_word a (0 :num) s :α word # β asm_state) = ((0w :α word),s)) ∧ ∀(a :β word) (n :num) (s :β asm_state). (read_mem_word a (SUC n) s :α word # β asm_state) = (let ((w :α word),(s1 :β asm_state)) = (read_mem_word (if s.be then a − (1w :β word) else (a + (1w :β word))) n s :α word # β asm_state) in (w ≪ (8 :num) ‖ (w2w (read_mem a s1) :α word),assert (a ∈ s1.mem_domain) s1))
write_mem_word_def_typed=(∀(a :α word) (w :β word) (s :α asm_state). write_mem_word a (0 :num) w s = s) ∧ ∀(a :α word) (n :num) (w :β word) (s :α asm_state). write_mem_word a (SUC n) w s = (let (s1 :α asm_state) = write_mem_word (if s.be then a − (1w :α word) else (a + (1w :α word))) n (w ⋙ (8 :num)) s in assert (a ∈ s1.mem_domain) (upd_mem a (w2w w :word8) s1))
asm_state_typed=recordtype.asm_state::(num -> α word) -> (num -> word64) -> (α word -> word8) -> (α word -> bool) -> α word -> num -> num -> bool -> bool -> α asm_state
asm_step_def_typed=∀(c :α asm_config) (s1 :α asm_state) (i :α asm) (s2 :α asm_state). asm_step c s1 i s2 ⇔ bytes_in_memory s1.pc (c.encode i) s1.mem s1.mem_domain ∧ (case c.link_reg of (NONE :num option) => T | SOME r => s1.lr = r) ∧ (s1.be ⇔ c.big_endian) ∧ s1.align = c.code_alignment ∧ asm i (s1.pc + (n2w (LENGTH (c.encode i)) :α word)) s1 = s2 ∧ ¬s2.failed ∧ asm_ok i c
asm_def_typed=(∀(i :α inst) (pc :α word) (s :α asm_state). asm (Inst i) pc s = upd_pc pc (inst i s)) ∧ (∀(l :α word) (pc :α word) (s :α asm_state). asm (Jump l) pc s = jump_to_offset l s) ∧ (∀(cmp :cmp) (r :num) (ri :α reg_imm) (l :α word) (pc :α word) (s :α asm_state). asm (JumpCmp cmp r ri l) pc s = if word_cmp cmp (read_reg r s) (reg_imm ri s) then jump_to_offset l s else upd_pc pc s) ∧ (∀(l :α word) (pc :α word) (s :α asm_state). asm (Call l) pc s = jump_to_offset l (upd_reg s.lr pc s)) ∧ (∀(r :num) (pc :α word) (s :α asm_state). asm (JumpReg r :α asm) pc s = (let (a :α word) = read_reg r s in upd_pc a (assert (aligned s.align a) s))) ∧ ∀(r :num) (l :α word) (pc :α word) (s :α asm_state). asm (Loc r l) pc s = upd_pc pc (upd_reg r (s.pc + l) s)
inst_def_typed=(∀(s :α asm_state). inst (Skip :α inst) s = s) ∧ (∀(r :num) (imm :α word) (s :α asm_state). inst (Const r imm) s = upd_reg r imm s) ∧ (∀(x :α arith) (s :α asm_state). inst (Arith x :α inst) s = arith_upd x s) ∧ (∀(m :memop) (r :num) (a :α addr) (s :α asm_state). inst (Mem m r a) s = mem_op m r a s) ∧ ∀(fp :fp) (s :α asm_state). inst (FP fp :α inst) s = fp_upd fp s
jump_to_offset_def_typed=∀(w :α word) (s :α asm_state). jump_to_offset w s = upd_pc (s.pc + w) s
