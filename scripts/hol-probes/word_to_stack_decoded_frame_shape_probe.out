dfs_full_word_stack_dec_stack_shape=⊢ ∀ls wstack res n. dec_stack ls wstack = SOME res ∧ n < LENGTH wstack ⇒ (is_handler_frame wstack❲n❳ ⇔ is_handler_frame res❲n❳)
dfs_full_sorted_env_zip=⊢ ∀l ls x n. sorted_env (StackFrame n l0 l x) ∧ LENGTH ls = LENGTH l ⇒ sorted_env (StackFrame n l0 (ZIP (MAP FST l,ls)) x)
dfs_full_word_stack_dec_stack_sorted=⊢ ∀ls wstack res. dec_stack ls wstack = SOME res ∧ EVERY sorted_env wstack ⇒ EVERY sorted_env res
