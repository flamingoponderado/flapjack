every_inst_ok_less_ret_to_tail=∀(p :α panLang$prog). EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) (exps_of (ret_to_tail p) :α panLang$exp list) ⇔ EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) (exps_of p :α panLang$exp list)
every_inst_ok_less_seq_assoc=∀(p :α panLang$prog) (q :α panLang$prog). EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) (exps_of (seq_assoc p q) :α panLang$exp list) ⇔ EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) ((exps_of p :α panLang$exp list) ++ (exps_of q :α panLang$exp list))
every_inst_ok_less_pan_simp_compile=∀(body :α panLang$prog). EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) (exps_of body :α panLang$exp list) ⇒ EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) (exps_of (compile body :α panLang$prog) :α panLang$exp list)
every_inst_ok_less_pan_simp_compile_prog=∀(pan_code :α decl list). EVERY (good_panops :α decl -> bool) pan_code ⇒ EVERY (good_panops :α decl -> bool) (compile_prog pan_code :α decl list)
