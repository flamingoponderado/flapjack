seq_full_statement=∀p s t i r s1. evaluate (p,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i p,t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i p,t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
seq_full_hypotheses=0
seq_case64=∀s t i r s1. evaluate (Seq seqLeftProg seqRightProg,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i (Seq seqLeftProg seqRightProg),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i (Seq seqLeftProg seqRightProg),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
seq_case80=∀s t i r s1. evaluate (Seq seqLeftProg seqRightProg,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i (Seq seqLeftProg seqRightProg),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i (Seq seqLeftProg seqRightProg),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
seq_evaluate_ind_obligation=∀c1 c2 s. (∀res s1. (res,s1) = evaluate (c1,s) ∧ res = NONE ⇒ P (c2,s1)) ∧ P (c1,s) ⇒ P (Seq c1 c2,s)
seq_equal64=comp (insert 3 4 LN) (Seq (StackFree 4) (Call NONE (INL 3) NONE)) = RawCall 3 ⇔ T
seq_equal80=comp (insert 3 4 LN) (Seq (StackFree 4) (Call NONE (INL 3) NONE)) = RawCall 3 ⇔ T
seq_less64=comp (insert 3 4 LN) (Seq (StackFree 6) (Call NONE (INL 3) NONE)) = Seq (StackFree 2) (RawCall 3) ⇔ T
seq_less80=comp (insert 3 4 LN) (Seq (StackFree 6) (Call NONE (INL 3) NONE)) = Seq (StackFree 2) (RawCall 3) ⇔ T
seq_greater64=comp (insert 3 4 LN) (Seq (StackFree 2) (Call NONE (INL 3) NONE)) = Seq Tick (Seq (StackAlloc 2) (RawCall 3)) ⇔ T
seq_greater80=comp (insert 3 4 LN) (Seq (StackFree 2) (Call NONE (INL 3) NONE)) = Seq Tick (Seq (StackAlloc 2) (RawCall 3)) ⇔ T
