load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "ALOOKUP_section_labels" ALOOKUP_section_labels;
val _=types "ALOOKUP_section_labels_types" ALOOKUP_section_labels;
val _=print "ALOOKUP_section_labels_hypotheses=";
val _=print(Int.toString(length(hyp ALOOKUP_section_labels)) ^ "\n");
val _=show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc((QCONV(SIMP_CONV(srw_ss())[sec_loc_to_pc_def]) THENC EVAL THENC QCONV(SIMP_CONV(srw_ss())[])) q)); print "\n");
val _=observe "empty" ``sec_loc_to_pc 7 ([]:8 line list) = NONE``;
val _=observe "boundary_duplicate_acc" ``sec_loc_to_pc 7 ([Label 1 7 0;Label 1 8 0]:8 line list) = SOME 0 /\ sec_pos_val 0 17 [Label 1 7 0;Label 1 8 0] = NONE /\ ALOOKUP (SND (section_labels 17 [Label 1 7 0;Label 1 8 0] [(7,99);(7,123)])) 7 = SOME 17 /\ SUM (MAP line_length [Label 1 7 0;Label 1 8 0]) = 0``;
val _=observe "head_success" ``sec_loc_to_pc 7 ([Label 1 7 0;Asm (Asmi (Inst Skip)) [1w;2w] 2]:8 line list) = SOME 0 /\ sec_pos_val 0 17 [Label 1 7 0;Asm (Asmi (Inst Skip)) [1w;2w] 2] = SOME 17 /\ ALOOKUP (SND (section_labels 17 [Label 1 7 0;Asm (Asmi (Inst Skip)) [1w;2w] 2] [])) 7 = SOME 17``;
val _=observe "asm_prefix" ``sec_loc_to_pc 7 ([Asm (Asmi (Inst Skip)) [1w;2w] 2;Label 1 7 0;Asm (Asmi (Inst Skip)) [3w] 1]:8 line list) = SOME 1 /\ sec_pos_val 1 17 [Asm (Asmi (Inst Skip)) [1w;2w] 2;Label 1 7 0;Asm (Asmi (Inst Skip)) [3w] 1] = SOME 19 /\ ALOOKUP (SND (section_labels 17 [Asm (Asmi (Inst Skip)) [1w;2w] 2;Label 1 7 0;Asm (Asmi (Inst Skip)) [3w] 1] [])) 7 = SOME 19``;
val _=observe "labasm_boundary" ``sec_loc_to_pc 7 ([LabAsm Halt 0w [1w;2w;3w] 3;Label 1 7 0]:8 line list) = SOME 1 /\ sec_pos_val 1 17 [LabAsm Halt 0w [1w;2w;3w] 3;Label 1 7 0] = NONE /\ ALOOKUP (SND (section_labels 17 [LabAsm Halt 0w [1w;2w;3w] 3;Label 1 7 0] [])) 7 = SOME 20 /\ SUM(MAP line_length [LabAsm Halt 0w [1w;2w;3w] 3;Label 1 7 0]) = 3``;
val _=observe "missing" ``sec_loc_to_pc 7 ([Label 1 8 0;Asm (Asmi (Inst Skip)) [1w] 1]:8 line list) = NONE``;
val _=observe "distinct_guard_needed" ``~ALL_DISTINCT (extract_labels ([Label 1 7 0;Asm (Asmi (Inst Skip)) [1w] 1;Label 1 7 0]:8 line list)) /\ sec_loc_to_pc 7 [Label 1 7 0;Asm (Asmi (Inst Skip)) [1w] 1;Label 1 7 0] = SOME 0 /\ ALOOKUP(SND(section_labels 17 [Label 1 7 0;Asm (Asmi (Inst Skip)) [1w] 1;Label 1 7 0] [])) 7 = SOME 18``;
val _=observe "owner_guard_false" ``~EVERY (sec_label_ok 1) ([Label 2 7 0]:8 line list)``;
val _=observe "length_guard_needed" ``~EVERY line_length_ok ([Asm (Asmi (Inst Skip)) [1w;2w] 99;Label 1 7 0]:8 line list) /\ ALOOKUP(SND(section_labels 17 [Asm (Asmi (Inst Skip)) [1w;2w] 99;Label 1 7 0] [])) 7 = SOME 116 /\ SUM(MAP line_length [Asm (Asmi (Inst Skip)) [1w;2w] 99;Label 1 7 0]) = 2``;
val _=observe "width1_large_pos" ``sec_loc_to_pc 7 ([Label 1 7 0]:1 line list) = SOME 0 /\ sec_pos_val 0 1208925819614629174706176 [Label 1 7 0] = NONE /\ ALOOKUP(SND(section_labels 1208925819614629174706176 [Label 1 7 0] [])) 7 = SOME 1208925819614629174706176``;
val _=observe "width80_large_pos" ``sec_loc_to_pc 7 ([Asm (Asmi (Inst Skip)) [1w;2w] 2;Label 1 7 0]:80 line list) = SOME 1 /\ ALOOKUP(SND(section_labels 1208925819614629174706176 [Asm (Asmi (Inst Skip)) [1w;2w] 2;Label 1 7 0] [])) 7 = SOME 1208925819614629174706178``;
