corestep_fo_body_def_typed=∀(anyE :string) (tokF :string) (tokE :string) (notF :string) (s :evalcase_fo). corestep_fo_body anyE tokF tokE notF s = case s of EV_fo (Empty_fo v) i r eo errs k fk => AP_fo k i (SOME v::r) eo errs | EV_fo (Any_fo m) i r eo errs k fk => (case i of ([] :(token # locs) list) => (let (err :locs # string) = (Locs EOFpt EOFpt,anyE) in AP_fo fk i r (merge_err_option eo (SOME err)) (err::errs)) | h::t => AP_fo k t (SOME (eval_tok_map m h)::r) eo errs) | EV_fo (Tok_fo p m') i r eo errs k fk => (case i of ([] :(token # locs) list) => (let (err :locs # string) = (Locs EOFpt EOFpt,tokE) in AP_fo fk i r (merge_err_option eo (SOME err)) (err::errs)) | h::t => if eval_token_check p h then AP_fo k t (SOME (eval_tok_map m' h)::r) eo errs else (let (err :locs # string) = (sloc_pexec i,tokF) in AP_fo fk i r (merge_err_option eo (SOME err)) (err::errs))) | EV_fo (Nt_fo n u) i r eo errs k fk => (case nt_rule_fo n of (NONE :pegsym_fo option) => Looped_fo | SOME sub => EV_fo sub i r eo errs (App1_plain_fo u k) fk) | EV_fo (Seq_fo e1 e2 b) i r eo errs k fk => EV_fo e1 i r eo errs (RestoreEO_fo eo (Ksym_fo e2 (App2_fo b k) (CmpEO_fo eo (ReturnTo_fo i r fk)))) fk | EV_fo (Choice_fo e1' e2') i r eo errs k fk => EV_fo e1' i r eo errs (App1_cl_fo k) (ReturnTo_fo i r (Ksym_fo e2' (DropErr_fo (App1_cr_fo k)) (CmpErrs_fo fk))) | EV_fo (Rpt_fo e) i r eo errs k fk => EV_fo e i ((NONE :(token, MMLnonT, locs) parsetree list option)::r) eo errs (RestoreEO_fo eo (Listsym_fo e k)) (Poplist_fo k) | EV_fo (Not_fo e' v') i r eo errs k fk => EV_fo e' i r eo errs (RestoreEO_fo eo (ReturnTo_fo i r (AddErr_fo (sloc_pexec i) notF fk))) (RestoreEO_fo eo (ReturnTo_fo i (SOME v'::r) (DropErr_fo k))) | EV_fo (Error_fo err) i r eo errs k fk => (let (err :locs # string) = (sloc_pexec i,err) in AP_fo fk i r (merge_err_option eo (SOME err)) (err::errs)) | AP_fo (Ksym_fo e'⁵' k'⁵' fk') i' r' eo' errs' => EV_fo e'⁵' i' r' eo' errs' k'⁵' fk' | AP_fo (App1_plain_fo u' k'⁶') i' ([] :(token, MMLnonT, locs) parsetree list option list) eo' errs' => Looped_fo | AP_fo (App1_plain_fo u' k'⁶') i' ((NONE :(token, MMLnonT, locs) parsetree list option)::r'') eo' errs' => Looped_fo | AP_fo (App1_plain_fo u' k'⁶') i' (SOME v''::r'') eo' errs' => AP_fo k'⁶' i' (SOME (eval_unary u' v'')::r'') eo' errs' | AP_fo (App1_cl_fo k'⁷') i' ([] :(token, MMLnonT, locs) parsetree list option list) eo' errs' => Looped_fo | AP_fo (App1_cl_fo k'⁷') i' ((NONE :(token, MMLnonT, locs) parsetree list option)::r'³') eo' errs' => Looped_fo | AP_fo (App1_cl_fo k'⁷') i' (SOME v'³'::r'³') eo' errs' => AP_fo k'⁷' i' (SOME (eval_combine (INL v'³' :(token, MMLnonT, locs) parsetree list + (token, MMLnonT, locs) parsetree list))::r'³') eo' errs' | AP_fo (App1_cr_fo k'⁸') i' ([] :(token, MMLnonT, locs) parsetree list option list) eo' errs' => Looped_fo | AP_fo (App1_cr_fo k'⁸') i' ((NONE :(token, MMLnonT, locs) parsetree list option)::r'⁴') eo' errs' => Looped_fo | AP_fo (App1_cr_fo k'⁸') i' (SOME v'⁴'::r'⁴') eo' errs' => AP_fo k'⁸' i' (SOME (eval_combine (INR v'⁴' :(token, MMLnonT, locs) parsetree list + (token, MMLnonT, locs) parsetree list))::r'⁴') eo' errs' | AP_fo (App2_fo b' k'⁹') i' ([] :(token, MMLnonT, locs) parsetree list option list) eo' errs' => Looped_fo | AP_fo (App2_fo b' k'⁹') i' [v75] eo' errs' => Looped_fo | AP_fo (App2_fo b' k'⁹') i' (v75::(NONE :(token, MMLnonT, locs) parsetree list option)::r'⁵') eo' errs' => Looped_fo | AP_fo (App2_fo b' k'⁹') i' ((NONE :(token, MMLnonT, locs) parsetree list option)::SOME v2::r'⁵') eo' errs' => Looped_fo | AP_fo (App2_fo b' k'⁹') i' (SOME v1::SOME v2::r'⁵') eo' errs' => AP_fo k'⁹' i' (SOME (eval_binary b' v2 v1)::r'⁵') eo' errs' | AP_fo (DropErr_fo k') i' r' eo' ([] :(locs # string) list) => AP_fo k' i' r' eo' ([] :(locs # string) list) | AP_fo (DropErr_fo k') i' r' eo' (v85::t') => AP_fo k' i' r' eo' t' | AP_fo (AddErr_fo l' e'³' k'') i' r' eo' errs' => AP_fo k'' i' r' (merge_err_option eo' (SOME (l',e'³'))) ((l',e'³')::errs') | AP_fo (CmpErrs_fo k'³') i' r' eo' ([] :(locs # string) list) => AP_fo k'³' i' r' eo' ([] :(locs # string) list) | AP_fo (CmpErrs_fo k'³') i' r' eo' [e'⁴'] => AP_fo k'³' i' r' eo' [e'⁴'] | AP_fo (CmpErrs_fo k'³') i' r' eo' ((v93,v94)::v89::v90) => AP_fo k'³' i' r' eo' ((v93,v94)::v90) | AP_fo (CmpEO_fo eo1 k'⁴') i' r' eo' ([] :(locs # string) list) => AP_fo k'⁴' i' r' (merge_err_option eo1 eo') ([] :(locs # string) list) | AP_fo (CmpEO_fo eo1 k'⁴') i' r' eo' ((l'',err')::rest) => AP_fo k'⁴' i' r' (merge_err_option eo1 (SOME (l'',err'))) ((l'',err')::rest) | AP_fo (ReturnTo_fo i'' r'⁶' k'¹⁰') i' r' eo' errs' => AP_fo k'¹⁰' i'' r'⁶' eo' errs' | AP_fo (RestoreEO_fo eo'' k'¹¹') i' r' eo' errs' => AP_fo k'¹¹' i' r' eo'' errs' | AP_fo (Poplist_fo k'¹³') i' r' eo' ([] :(locs # string) list) => AP_fo k'¹³' i' (poplistval r') eo' ([] :(locs # string) list) | AP_fo (Poplist_fo k'¹³') i' r' eo' (e'⁷'::errs'') => AP_fo k'¹³' i' (poplistval r') eo' errs'' | AP_fo (Listsym_fo e'⁶' k'¹²') i' r' eo' errs' => EV_fo e'⁶' i' r' eo' errs' (RestoreEO_fo eo' (Listsym_fo e'⁶' k'¹²')) (Poplist_fo k'¹²') | AP_fo Done_fo i' ([] :(token, MMLnonT, locs) parsetree list option list) eo' errs' => Looped_fo | AP_fo Done_fo i' ((NONE :(token, MMLnonT, locs) parsetree list option)::t) eo' errs' => Looped_fo | AP_fo Done_fo i' (SOME rv::t) eo' errs' => Result_fo (Success i' rv eo') | AP_fo Failed_fo i' r' (NONE :(locs # string) option) ([] :(locs # string) list) => Looped_fo | AP_fo Failed_fo i' r' (SOME (l,e)) ([] :(locs # string) list) => Result_fo (Failure l e :((token # locs) list, (token, MMLnonT, locs) parsetree list, string) pegresult) | AP_fo Failed_fo i' r' eo' ((l,e'')::v105) => Result_fo (Failure l e'' :((token # locs) list, (token, MMLnonT, locs) parsetree list, string) pegresult) | Result_fo r'⁷' => Result_fo r'⁷' | Looped_fo => Looped_fo
run_peg_fo_def_typed=(∀(anyE :string) (tokF :string) (tokE :string) (notF :string) (st :evalcase_fo). run_peg_fo (0 :num) anyE tokF tokE notF st = Looped_fo) ∧ ∀(n :num) (anyE :string) (tokF :string) (tokE :string) (notF :string) (st :evalcase_fo). run_peg_fo (SUC n) anyE tokF tokE notF st = case st of EV_fo v13 v14 v15 v16 v17 v18 v19 => run_peg_fo n anyE tokF tokE notF (corestep_fo_body anyE tokF tokE notF (EV_fo v13 v14 v15 v16 v17 v18 v19)) | AP_fo v20 v21 v22 v23 v24 => run_peg_fo n anyE tokF tokE notF (corestep_fo_body anyE tokF tokE notF (AP_fo v20 v21 v22 v23 v24)) | Result_fo r => Result_fo r | Looped_fo => Looped_fo
peg_exec_fuel_fo_def_typed=∀(fuel :num) (e :pegsym_fo) (i :(token # locs) list) (r :(token, MMLnonT, locs) parsetree list option list) (eo :(locs # string) option) (errs :(locs # string) list) (k :kont_fo) (fk :kont_fo). peg_exec_fuel_fo fuel e i r eo errs k fk = run_peg_fo fuel "Didn't expect an EOF" "Failed to see expected token" "Failed to see expected token; saw EOF instead" "Not combinator failed" (EV_fo e i r eo errs k fk)
peg_exec_core_fuel_def_typed=∀(fuel :num) (i :(token # locs) list). peg_exec_core_fuel fuel i = peg_exec_fuel_fo fuel (Nt_fo (mkNT nTopLevelDecs) SemU_id) i ([] :(token, MMLnonT, locs) parsetree list option list) (NONE :(locs # string) option) ([] :(locs # string) list) Done_fo Failed_fo
mlstring_nonempty_strlen_typed=∀(ms :mlstring). ms ≠ «» ⇔ (0 :num) < strlen ms
