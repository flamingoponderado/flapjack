:v ref sptree$num_map) (tf :num |-> num) (v :v) (x :α word_loc heap_address). (lookup n refs :v ref option) = SOME (Thunk ev v :v ref) ∧ (ev = Evaluated ⇒ (dest_thunk v refs :dest_thunk_ret) = NotThunk) ∧ n ∈ FDOM f ∧ heap_lookup f⟨n⟩ heap = SOME (ThunkBlock ev x :(α word_loc, tag # α word_loc list) heap_element) ∧ (ck ≠ (0 :num) ⇒ v_inv_ck (ck − (1 :num)) conf v refs (x,f,tf,heap)) ⇒ v_inv_ck ck conf (RefPtr F n :v) refs (Pointer f⟨n⟩ (Word (0w :α word)),f,tf,heap)) ∧ (∀(ck :num) (conf :data_to_word$config) (f :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (n :num) (refs :v ref sptree$num_map) (tf :num |-> num) (v :v) (x :α word_loc heap_address). (lookup n refs :v ref option) = SOME (Thunk Evaluated v :v ref) ∧ (dest_thunk v refs :dest_thunk_ret) = NotThunk ∧ (ck ≠ (0 :num) ⇒ v_inv_ck (ck − (1 :num)) conf v refs (x,f,tf,heap)) ⇒ v_inv_ck ck conf (RefPtr F n :v) refs (x,f,tf,heap)) ∧ (∀(ck :num) (conf :data_to_word$config) (f :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (n :num) (refs :v ref sptree$num_map) (tf :num |-> num) (ts :num) (vs :v list). vs = ([] :v list) ∧ n < dimword (:α) DIV (16 :num) ∧ ts = (0 :num) ⇒ v_inv_ck ck conf (Block ts n vs :v) refs (Data (Word (BlockNil n :α word)),f,tf,heap)) ∧ ∀(ck :num) (conf :data_to_word$config) (f :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (n :num) (ptr :num) (refs :v ref sptree$num_map) (tf :num |-> num) (ts :num) (vs :v list) (xs :α word_loc heap_address list). vs ≠ ([] :v list) ∧ (ck ≠ (0 :num) ⇒ LIST_REL (λ(v :v) (x :α word_loc heap_address). v_inv_ck (ck − (1 :num)) conf v refs (x,f,tf,heap)) vs xs) ∧ FLOOKUP tf ts = SOME ptr ∧ heap_lookup ptr heap = SOME (BlockRep n xs :(α word_loc, tag # α word_loc list) heap_element) ⇒ v_inv_ck ck conf (Block ts n vs :v) refs (Pointer ptr (Word (ptr_bits conf n (LENGTH xs) :α word)),f,tf,heap)
memory_rel_Block_Block_small_eq_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((Block (ts1 :num) (t1 :num) (v1 :v list) :v),Word (w1 :α word))::((Block (ts2 :num) (t2 :num) (v2 :v list) :v),Word (w2 :α word))::(vars :(v # α word_loc) list)) ∧ good_dimindex (:α) ∧ w1 ≠ w2 ∧ ¬word_bit (0 :num) w1 ⇒ LENGTH v1 ≠ LENGTH v2 ∨ t1 ≠ t2
do_eq_list_F_IMP_MEM_typed=∀(l :v list) (l' :v list). (do_eq_list (refs :α ref sptree$num_map) l l' :eq_result) = Eq_val F ∧ LENGTH l' = LENGTH l ⇒ ∃(i :num). i < LENGTH l ∧ (do_eq refs l❲i❳ l'❲i❳ :eq_result) = Eq_val F
word_cmp_loop_thm_typed=∀(xs1 :α word list) (xs2 :α word list) (f1 :(α word # α word_loc -> bool) -> bool) (f2 :(α word # α word_loc -> bool) -> bool) (a1 :α word) (a2 :α word). LENGTH xs1 = LENGTH xs2 ∧ LENGTH xs1 < dimword (:α) ∧ (word_list (a1 + (bytes_in_word :α word)) (MAP (Word :α word -> α word_loc) xs1) * f1) (fun2set ((m :α word -> α word_loc),(dm :α word -> bool))) ∧ (word_list (a2 + (bytes_in_word :α word)) (MAP (Word :α word -> α word_loc) xs2) * f2) (fun2set (m,dm)) ⇒ word_cmp_loop (n2w (LENGTH xs1) :α word) (a1 + (bytes_in_word :α word) * (n2w (LENGTH xs1) :α word)) (a2 + (bytes_in_word :α word) * (n2w (LENGTH xs1) :α word)) dm m = SOME (case mw_cmp xs1 xs2 of (NONE :bool option) => (1w :α word) | SOME T => (0w :α word) | SOME F => (2w :α word))
fix_clock_IMP_typed=∀(ck :num) (l :num) (x :(α # num # num) option). (fix_clock ck l x :(α # num # num) option) = SOME ((w :α),(l1 :num),(ck1 :num)) ⇒ ck1 ≤ ck ∧ l1 ≤ l
word_mem_eq_thm_typed=∀(xs :α word list) (ys :α word list) (a :β word) (ff :(β word # α word_loc -> bool) -> bool). (word_list a (MAP (Word :α word -> α word_loc) xs) * ff) (fun2set ((m :β word -> α word_loc),(dm :β word -> bool))) ∧ LENGTH xs = LENGTH ys ⇒ word_mem_eq a ys dm m = SOME (xs = ys)
memory_rel_MutBlock_IMP_F_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((RefPtr T (p :num) :v),(v :α word_loc))::(vars :(v # α word_loc) list)) ∧ (lookup p refs :v ref option) = SOME (MutBlock (tg :num) (fin :bool) (ls :v list) (cv :v) (rs :v list)) ⇒ F
memory_rel_isClos_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((Block (ts1 :num) (t1 :num) (v1 :v list) :v),Word (w1 :α word))::(vars :(v # α word_loc) list)) ∧ word_bit (0 :num) w1 ∧ get_real_addr c st w1 = SOME (a' :α word) ∧ m a' = Word (x' :α word) ∧ good_dimindex (:α) ⇒ (isClos t1 v1 ⇔ word_is_clos c x')
eq_explode_APPEND_typed=∀(xs :α list) (ys :α list) (a :β word). eq_explode a (m :β word -> γ) (dm :δ) (xs ++ ys) = eq_explode a m dm xs ++ eq_explode (a + (n2w (LENGTH xs) :β word) * (bytes_in_word :β word)) m dm ys
eq_assum_APPEND_typed=∀(xs :α list) (ys :α list) (a :β word). eq_assum a (m :γ) (dm :β word -> bool) (xs ++ ys) ⇔ eq_assum a m dm xs ∧ eq_assum (a + (n2w (LENGTH xs) :β word) * (bytes_in_word :β word)) m dm ys
fix_clock_word_eq_typed=(fix_clock (ck :num) (l :num) (word_eq (c :data_to_word$config) (st :store_name |-> α word_loc) (dm :α word -> bool) (m :α word -> α word_loc) l ck (w1 :α word) (w2 :α word)) :(α word # num # num) option) = word_eq c st dm m l ck w1 w2
