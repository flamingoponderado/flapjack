pMakeSpace_def_typed=pMakeSpace (INL (c :prog) :prog + num # sptree$num_set # prog) = c ∧ pMakeSpace (INR ((k :num),(names :sptree$num_set),c) :prog + num # sptree$num_set # prog) = Seq (MakeSpace k names) c
space_def_typed=(∀(names :sptree$num_set) (k :num). space (MakeSpace k names) = (INR (k,names,Skip) :prog + num # sptree$num_set # prog)) ∧ (∀(c2 :prog) (c1 :prog). space (Seq c1 c2) = (let (d1 :prog) = pMakeSpace (space c1); (x2 :prog + num # sptree$num_set # prog) = space c2 in case x2 of (INL c4 :prog + num # sptree$num_set # prog) => (case c1 of Skip => (INL c4 :prog + num # sptree$num_set # prog) | Move v22 v23 => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | (Call v24 v25 v26 v27 :prog) => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | Assign v28 v29 v30 v31 => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | Seq v32 v33 => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | (If v34 v35 v36 :prog) => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | MakeSpace k names => (INR (k,names,c4) :prog + num # sptree$num_set # prog) | (Raise v39 :prog) => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | Return v40 => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | Tick => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog) | (Force v41 v42 v43 :prog) => (INL (Seq d1 c4) :prog + num # sptree$num_set # prog)) | (INR (k2,names2,c4') :prog + num # sptree$num_set # prog) => case c1 of Skip => (INR (k2,names2,c4') :prog + num # sptree$num_set # prog) | Move dest src => (INR (k2,insert src () (delete dest names2),Seq (Move dest src) c4') :prog + num # sptree$num_set # prog) | (Call v24 v25 v26 v27 :prog) => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | Assign dest' op args (NONE :sptree$num_set option) => (INR (op_space_req op (LENGTH args) + k2,list_insert args (delete dest' names2),Seq (Assign dest' op args (NONE :sptree$num_set option)) c4') :prog + num # sptree$num_set # prog) | Assign dest' op args (SOME v45) => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | Seq v32 v33 => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | (If v34 v35 v36 :prog) => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | MakeSpace k1 names1 => (INR (k2,inter names1 names2,c4') :prog + num # sptree$num_set # prog) | (Raise v39 :prog) => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | Return v40 => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | Tick => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog) | (Force v41 v42 v43 :prog) => (INL (Seq d1 (pMakeSpace x2)) :prog + num # sptree$num_set # prog))) ∧ (∀(n :num) (c3 :prog) (c2 :prog). space (If n c2 c3 :prog) = (INL (If n (pMakeSpace (space c2)) (pMakeSpace (space c3)) :prog) :prog + num # sptree$num_set # prog)) ∧ space Skip = (INL Skip :prog + num # sptree$num_set # prog) ∧ (∀(v2 :num) (v :num). space (Move v v2) = (INL (Move v v2) :prog + num # sptree$num_set # prog)) ∧ (∀(v7 :(num # prog) option) (v6 :num list) (v5 :num option) (v4 :(num list # sptree$num_set) option). space (Call v4 v5 v6 v7 :prog) = (INL (Call v4 v5 v6 v7 :prog) :prog + num # sptree$num_set # prog)) ∧ (∀(v9 :op) (v8 :num) (v11 :sptree$num_set option) (v10 :num list). space (Assign v8 v9 v10 v11) = (INL (Assign v8 v9 v10 v11) :prog + num # sptree$num_set # prog)) ∧ (∀(v19 :num). space (Raise v19 :prog) = (INL (Raise v19 :prog) :prog + num # sptree$num_set # prog)) ∧ (∀(v20 :num list). space (Return v20) = (INL (Return v20) :prog + num # sptree$num_set # prog)) ∧ space Tick = (INL Tick :prog + num # sptree$num_set # prog) ∧ ∀(v38 :num) (v37 :num) (v21 :(num # sptree$num_set) option). space (Force v21 v37 v38 :prog) = (INL (Force v21 v37 v38 :prog) :prog + num # sptree$num_set # prog)
compile_def_typed=∀(c :prog). compile c = pMakeSpace (space c)
