> dfn'REM v140 state | MulDiv (REMU v141) => dfn'REMU v141 state | MulDiv (REMUW v142) => dfn'REMUW v142 state | MulDiv (REMW v143) => dfn'REMW v143 state | Shift (SLL v145) => dfn'SLL v145 state | Shift (SLLI v146) => dfn'SLLI v146 state | Shift (SLLIW v147) => dfn'SLLIW v147 state | Shift (SLLW v148) => dfn'SLLW v148 state | Shift (SRA v149) => dfn'SRA v149 state | Shift (SRAI v150) => dfn'SRAI v150 state | Shift (SRAIW v151) => dfn'SRAIW v151 state | Shift (SRAW v152) => dfn'SRAW v152 state | Shift (SRL v153) => dfn'SRL v153 state | Shift (SRLI v154) => dfn'SRLI v154 state | Shift (SRLIW v155) => dfn'SRLIW v155 state | Shift (SRLW v156) => dfn'SRLW v156 state | Store (SB v158) => dfn'SB v158 state | Store (SD v159) => dfn'SD v159 state | Store (SH v160) => dfn'SH v160 state | Store (SW v161) => dfn'SW v161 state | System (CSRRC v163) => dfn'CSRRC v163 state | System (CSRRCI v164) => dfn'CSRRCI v164 state | System (CSRRS v165) => dfn'CSRRS v165 state | System (CSRRSI v166) => dfn'CSRRSI v166 state | System (CSRRW v167) => dfn'CSRRW v167 state | System (CSRRWI v168) => dfn'CSRRWI v168 state | System EBREAK => dfn'EBREAK state | System ECALL => dfn'ECALL state | System ERET => dfn'ERET state | System MRTS => dfn'MRTS state | System (SFENCE_VM v169) => dfn'SFENCE_VM v169 state | System WFI => state | UnknownInstruction => dfn'UnknownInstruction state)
dfn_primeSLTIU_def_typed=∀(rd :word5) (rs1 :word5) (imm :word12). dfn'SLTIU (rd,rs1,imm) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state in write'GPR ((v2w [(if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) <₊ (sw2sw imm :word64)] :word64),rd) s))
dfn_primeSLTI_def_typed=∀(rd :word5) (rs1 :word5) (imm :word12). dfn'SLTI (rd,rs1,imm) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state in write'GPR ((v2w [(if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) < (sw2sw imm :word64)] :word64),rd) s))
dfn_primeSLTU_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'SLTU (rd,rs1,rs2) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s in write'GPR ((v2w [(if v then (w2w (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) <₊ if v0 then (w2w (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0] :word64),rd) s0))
dfn_primeSLT_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'SLT (rd,rs1,rs2) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s in write'GPR ((v2w [(if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) < if v0 then (sw2sw (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0] :word64),rd) s0))
extStatus_def_typed=∀(e :word2). extStatus e = case e of (0w :word2) => Off | (1w :word2) => Initial | (2w :word2) => Clean | (3w :word2) => Dirty | v => (ARB :ExtStatus)
isValidVM_def_typed=∀(vm :word5). isValidVM vm ⇔ case vm of (0w :word5) => T | (1w :word5) => T | (2w :word5) => T | (8w :word5) => T | (9w :word5) => T | (10w :word5) => T | (11w :word5) => T | (12w :word5) => T | v => F
lift_mie_sie_def_typed=∀(mie :mie). lift_mie_sie mie = rec'sie (0w :word64) with <|SSIE := mie.SSIE; STIE := mie.STIE|>
lift_mip_sip_def_typed=∀(mip :mip). lift_mip_sip mip = rec'sip (0w :word64) with <|SSIP := mip.SSIP; STIP := mip.STIP|>
lift_mstatus_sstatus_def_typed=∀(mst :mstatus). lift_mstatus_sstatus mst = rec'sstatus (0w :word64) with <|SIE := mst.MIE; SPIE := mst.MIE1; SPS := (privilege mst.MPRV1 ≠ User); SSD := (extStatus mst.MXS = Dirty ∨ extStatus mst.MFS = Dirty); SFS := mst.MFS; SXS := mst.MXS; SMPRV := mst.MMPRV|>
lower_sie_mie_def_typed=∀(sie :sie) (mie :mie). lower_sie_mie (sie,mie) = mie with <|SSIE := sie.SSIE; STIE := sie.STIE|>
lower_sip_mip_def_typed=∀(sip :sip) (mip :mip). lower_sip_mip (sip,mip) = mip with <|SSIP := sip.SSIP; STIP := sip.STIP|>
lower_sstatus_mstatus_def_typed=∀(sst :sstatus) (mst :mstatus). lower_sstatus_mstatus (sst,mst) = update_mstatus (mst,rec'mstatus (reg'mstatus mst) with <|MIE := sst.SIE; MIE1 := sst.SPIE; MPRV1 := privLevel (if sst.SPS then Supervisor else User); MFS := sst.SFS; MXS := sst.SXS; MMPRV := sst.SMPRV|>)
update_mstatus_def_typed=∀(orig :mstatus) (v :mstatus). update_mstatus (orig,v) = (let (s0 :mstatus) = orig with <|MPRV3 := v.MPRV3; MIE3 := v.MIE3; MPRV2 := v.MPRV2; MIE2 := v.MIE2; MPRV1 := v.MPRV1; MIE1 := v.MIE1; MPRV := v.MPRV; MIE := v.MIE|> in (if isValidVM v.VM then s0 with VM := v.VM else s0) with <|MSD := (extStatus v.MXS = Dirty ∨ extStatus v.MFS = Dirty); MXS := v.MXS; MFS := v.MFS; MMPRV := v.MMPRV|>)
rec_primesie_def_typed=∀(x :word64). rec'sie x = sie (word_bit (1 :num) x) (word_bit (5 :num) x) (((((0 :num) >< (0 :num)) x :word1) @@ (((((4 :num) >< (2 :num)) x :word3) @@ (((63 :num) >< (6 :num)) x :58 word)) :61 word)) :62 word)
