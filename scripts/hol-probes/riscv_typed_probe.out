dfn_primeMUL_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'MUL (rd,rs1,rs2) = (λ(state :riscv_state). write'GPR (GPR rs1 state * GPR rs2 state,rd) state)
PC_def_typed=∀(state :riscv_state). PC state = state.c_PC state.procID
rawReadInst_def_typed=∀(pAddr :word64). rawReadInst pAddr = (λ(state :riscv_state). (let ((b'7 :bool),(b'6 :bool),(b'5 :bool),(b'4 :bool),(b'3 :bool),(b'2 :bool),(b'1 :bool),(b'0 :bool)) = boolify8 (state.MEM8 pAddr) in if b'1 ∧ b'0 then (let (s :riscv_state) = write'Skip (4w :word64) state in (Word ((s.MEM8 (pAddr + (3w :word64)) @@ ((s.MEM8 (pAddr + (2w :word64)) @@ ((s.MEM8 (pAddr + (1w :word64)) @@ s.MEM8 pAddr) :word16)) :word24)) :word32),s)) else (let (s :riscv_state) = write'Skip (2w :word64) state in (Half ((s.MEM8 (pAddr + (1w :word64)) @@ s.MEM8 pAddr) :word16),s))))
write_primeSkip_def_typed=∀(value :word64). write'Skip value = (λ(state :riscv_state). state with c_Skip := state.c_Skip⦇state.procID ↦ value⦈)
