dfn_primeAND_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'AND (rd,rs1,rs2) = (λ(state :riscv_state). write'GPR (GPR rs1 state && GPR rs2 state,rd) state)
dfn_primeOR_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'OR (rd,rs1,rs2) = (λ(state :riscv_state). write'GPR (GPR rs1 state ‖ GPR rs2 state,rd) state)
dfn_primeSUB_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'SUB (rd,rs1,rs2) = (λ(state :riscv_state). write'GPR (GPR rs1 state − GPR rs2 state,rd) state)
