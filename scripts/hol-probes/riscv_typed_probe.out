rec_primesstatus_def_typed=∀(x :word64). rec'sstatus x = sstatus (((13 :num) >< (12 :num)) x :word2) (word_bit (0 :num) x) (word_bit (16 :num) x) (word_bit (3 :num) x) (word_bit (4 :num) x) (word_bit (63 :num) x) (((15 :num) >< (14 :num)) x :word2) (((((2 :num) >< (1 :num)) x :word2) @@ (((((11 :num) >< (5 :num)) x :word7) @@ (((62 :num) >< (17 :num)) x :46 word)) :53 word)) :55 word)
reg_primesie_def_typed=∀(x :sie). reg'sie x = case x of sie SSIE STIE sie'rst => (((((57 :num) >< (0 :num)) sie'rst :58 word) @@ (((v2w [STIE] :word1) @@ (((((60 :num) >< (58 :num)) sie'rst :word3) @@ (((v2w [SSIE] :word1) @@ (((61 :num) >< (61 :num)) sie'rst :word1)) :word2)) :word5)) :word6)) :word64)
reg_primesip_def_typed=∀(x :sip). reg'sip x = case x of sip SSIP STIP sip'rst => (((((57 :num) >< (0 :num)) sip'rst :58 word) @@ (((v2w [STIP] :word1) @@ (((((60 :num) >< (58 :num)) sip'rst :word3) @@ (((v2w [SSIP] :word1) @@ (((61 :num) >< (61 :num)) sip'rst :word1)) :word2)) :word5)) :word6)) :word64)
reg_primesstatus_def_typed=∀(x :sstatus). reg'sstatus x = case x of sstatus SFS SIE SMPRV SPIE SPS SSD SXS sstatus'rst => (((v2w [SSD] :word1) @@ (((((45 :num) >< (0 :num)) sstatus'rst :46 word) @@ (((v2w [SMPRV] :word1) @@ ((SXS @@ ((SFS @@ (((((52 :num) >< (46 :num)) sstatus'rst :word7) @@ (((v2w [SPS] :word1) @@ (((v2w [SPIE] :word1) @@ (((((54 :num) >< (53 :num)) sstatus'rst :word2) @@ (v2w [SIE] :word1)) :word3)) :word4)) :word5)) :word12)) :14 word)) :word16)) :17 word)) :63 word)) :word64)
signalEnvCall_def_typed=∀(_ :unit). signalEnvCall _ = (λ(state :riscv_state). signalException (case privilege (MCSR state).mstatus.MPRV of User => UMode_Env_Call | Supervisor => SMode_Env_Call | Hypervisor => HMode_Env_Call | Machine => MMode_Env_Call) state)
dfn_primeEBREAK_def_typed=∀(state :riscv_state). dfn'EBREAK state = signalException Breakpoint state
dfn_primeECALL_def_typed=∀(state :riscv_state). dfn'ECALL state = signalEnvCall () state
dfn_primeERET_def_typed=∀(state :riscv_state). dfn'ERET state = write'NextFetch (SOME Ereturn) state
dfn_primeUnknownInstruction_def_typed=∀(state :riscv_state). dfn'UnknownInstruction state = signalException Illegal_Instr state
Skip_def_typed=∀(state :riscv_state). Skip state = state.c_Skip state.procID
branchTo_def_typed=∀(newPC :word64). branchTo newPC = (λ(state :riscv_state). write'NextFetch (SOME (BranchTo newPC)) state)
