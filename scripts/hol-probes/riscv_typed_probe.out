dfn_primeSLL_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'SLL (rd,rs1,rs2) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state in if v then write'GPR (GPR rs1 s <<~ (w2w (((4 :num) >< (0 :num)) (GPR rs2 s) :word5) :word64),rd) s else write'GPR (GPR rs1 s <<~ (w2w (((5 :num) >< (0 :num)) (GPR rs2 s) :word6) :word64),rd) s))
