dfn_primeMULH_def_typed=∀(rd :word5) (rs1 :word5) (rs2 :word5). dfn'MULH (rd,rs1,rs2) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s; (prod :word128) = (sw2sw (if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) :word128) * (sw2sw (if v0 then (sw2sw (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0) :word128); ((v :bool),(s :riscv_state)) = in32BitMode () s0 in write'GPR (if v then (sw2sw (((63 :num) >< (32 :num)) prod :word32) :word64) else (sw2sw (((127 :num) >< (64 :num)) prod :word64) :word64),rd) s))
