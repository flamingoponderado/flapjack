dfn_primeJAL_def_typed=∀(rd :word5) (imm :word20). dfn'JAL (rd,imm) = (λ(state :riscv_state). (let (v :word64) = PC state + (sw2sw imm :word64) ≪ (1 :num) in if word_bit (0 :num) v then signalAddressException (Fetch_Misaligned,v) state else branchTo v (write'GPR (PC state + Skip state,rd) state)))
