constructor_compile_typed=(compile_exp (t :mlstring list) (env :source_to_flat$environment) (Con (cn :(mlstring, mlstring) id option) (es :ast$exp list) :ast$exp) :exp) = (Con None (OPTION_JOIN (OPTION_MAP ((type_group_id_type :(num # (num # (num # num) list) option) option -> (num # num option) option) ∘ nsLookup env.c) cn)) (compile_exps t env es :exp list) :exp)
constructor_check_typed=∀(cenv :(mlstring, mlstring, num # stamp) namespace) (n_opt :(mlstring, mlstring) id option) (l :num). do_con_check cenv n_opt l ⇔ case n_opt of (NONE :(mlstring, mlstring) id option) => T | SOME n => case nsLookup cenv n of (NONE :(num # stamp) option) => F | SOME (l',v2) => l = l'
constructor_build_typed=∀(envC :(mlstring, mlstring, num # stamp) namespace) (cn :(mlstring, mlstring) id option) (vs :semanticPrimitives$v list). build_conv envC cn vs = case cn of (NONE :(mlstring, mlstring) id option) => SOME (Conv (NONE :stamp option) vs) | SOME id => case nsLookup envC id of (NONE :(num # stamp) option) => (NONE :semanticPrimitives$v option) | SOME (len,stamp) => SOME (Conv (SOME stamp) vs)
