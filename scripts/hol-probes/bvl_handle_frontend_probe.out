simplify=[Let [Var 0] (Let [Var 0] (Var 2)); If (Var 0) (Let [Var 1] (Var 1)) (Var 2); Handle (Call 0 (SOME 2) []) (Force 9 1)]
compiled=[(Handle (Let [Var 0; Var 2] (Let [Var 0; Op (IntOp (Const 0)) []; Var 1] (Call 0 (SOME 2) [Var 2; Var 0]))) (Var 1),Union (Union (Var 2) (Var 0)) (Shift 1 (Var 1)),1,T); (Var 1,Var 1,1,T); (Op (IntOp (Const 0)) [],Empty,1,T)]
cut=(Let [] (Let [Var 0; Var 2] (Let [Var 0; Op (IntOp (Const 0)) []; Var 1] (Call 0 (SOME 4) [Var 2; Var 0]))),Union (Var 2) (Union (Var 0) Empty),0,F)
seq=Let [Call 0 (SOME 1) []] (Let [] (Let [] (Call 0 (SOME 2) [])))
can_raise=(∀(v :num). can_raise (Var v :exp) ⇔ F) ∧ (∀(x1 :exp) (x2 :exp) (x3 :exp). can_raise (If x1 x2 x3 :exp) ⇔ can_raise x1 ∨ can_raise x2 ∨ can_raise x3) ∧ (∀(xs :exp list) (x2 :exp). can_raise (Let xs x2 :exp) ⇔ can_raise x2 ∨ can_raise1 xs) ∧ (∀(x1 :exp) (x2 :exp). can_raise (Handle x1 x2 :exp) ⇔ can_raise x2) ∧ (∀(x1 :exp). can_raise (Raise x1 :exp) ⇔ T) ∧ (∀(op :op) (xs :exp list). can_raise (Op op xs :exp) ⇔ op = (ThunkOp ForceThunk :op) ∨ can_raise1 xs) ∧ (∀(x :exp). can_raise (Tick x :exp) ⇔ can_raise x) ∧ (∀(m :num) (n :num). can_raise (Force m n :exp) ⇔ T) ∧ (∀(t :num) (dest :num option) (xs :exp list). can_raise (Call t dest xs :exp) ⇔ T) ∧ (can_raise1 ([] :exp list) ⇔ F) ∧ ∀(x :exp) (xs :exp list). can_raise1 (x::xs) ⇔ can_raise x ∨ can_raise1 xs
dest_handle_Raise=dest_handle_Raise (Raise (x :exp) :exp) = (if can_raise x then (NONE :exp option) else SOME x) ∧ dest_handle_Raise (Var (v :num) :exp) = (NONE :exp option) ∧ dest_handle_Raise (If (v1 :exp) (v2 :exp) (v3 :exp) :exp) = (NONE :exp option) ∧ dest_handle_Raise (Let (v4 :exp list) (v5 :exp) :exp) = (NONE :exp option) ∧ dest_handle_Raise (Handle (v7 :exp) (v8 :exp) :exp) = (NONE :exp option) ∧ dest_handle_Raise (Tick (v9 :exp) :exp) = (NONE :exp option) ∧ dest_handle_Raise (Call (v10 :num) (v11 :num option) (v12 :exp list) :exp) = (NONE :exp option) ∧ dest_handle_Raise (Force (v13 :num) (v14 :num) :exp) = (NONE :exp option) ∧ dest_handle_Raise (Op (v15 :op) (v16 :exp list) :exp) = (NONE :exp option)
dest_handle_Let=dest_handle_Let (Let (xs :exp list) (x :exp) :exp) = (if can_raise1 xs then (NONE :(exp list # exp) option) else SOME (xs,x)) ∧ dest_handle_Let (Var (v :num) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (If (v1 :exp) (v2 :exp) (v3 :exp) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (Raise (v6 :exp) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (Handle (v7 :exp) (v8 :exp) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (Tick (v9 :exp) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (Call (v10 :num) (v11 :num option) (v12 :exp list) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (Force (v13 :num) (v14 :num) :exp) = (NONE :(exp list # exp) option) ∧ dest_handle_Let (Op (v15 :op) (v16 :exp list) :exp) = (NONE :(exp list # exp) option)
dest_handle_If=dest_handle_If (If (x1 :exp) (x2 :exp) (x3 :exp) :exp) = (if can_raise x1 then (NONE :(exp # exp # exp + exp # exp # exp) option) else if can_raise x2 then if can_raise x3 then (NONE :(exp # exp # exp + exp # exp # exp) option) else SOME (INL (x1,x2,x3) :exp # exp # exp + exp # exp # exp) else if can_raise x3 then if can_raise x2 then (NONE :(exp # exp # exp + exp # exp # exp) option) else SOME (INR (x1,x2,x3) :exp # exp # exp + exp # exp # exp) else (NONE :(exp # exp # exp + exp # exp # exp) option)) ∧ dest_handle_If (Var (v :num) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Let (v4 :exp list) (v5 :exp) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Raise (v6 :exp) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Handle (v7 :exp) (v8 :exp) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Tick (v9 :exp) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Call (v10 :num) (v11 :num option) (v12 :exp list) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Force (v13 :num) (v14 :num) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option) ∧ dest_handle_If (Op (v15 :op) (v16 :exp list) :exp) = (NONE :(exp # exp # exp + exp # exp # exp) option)
handle_adj_vars=(∀(l :num) (d :num) (v :num). handle_adj_vars l d (Var v :exp) = (Var (if v < l then v else v + d) :exp)) ∧ (∀(l :num) (d :num) (x1 :exp) (x2 :exp) (x3 :exp). handle_adj_vars l d (If x1 x2 x3 :exp) = (If (handle_adj_vars l d x1) (handle_adj_vars l d x2) (handle_adj_vars l d x3) :exp)) ∧ (∀(l :num) (d :num) (xs :exp list) (x2 :exp). handle_adj_vars l d (Let xs x2 :exp) = (Let (handle_adj_vars1 l d xs) (handle_adj_vars (l + LENGTH xs) d x2) :exp)) ∧ (∀(l :num) (d :num) (x1 :exp) (x2 :exp). handle_adj_vars l d (Handle x1 x2 :exp) = (Handle (handle_adj_vars l d x1) (handle_adj_vars (l + (1 :num)) d x2) :exp)) ∧ (∀(l :num) (d :num) (x1 :exp). handle_adj_vars l d (Raise x1 :exp) = (Raise (handle_adj_vars l d x1) :exp)) ∧ (∀(l :num) (d :num) (op :op) (xs :exp list). handle_adj_vars l d (Op op xs :exp) = (Op op (handle_adj_vars1 l d xs) :exp)) ∧ (∀(l :num) (d :num) (x :exp). handle_adj_vars l d (Tick x :exp) = (Tick (handle_adj_vars l d x) :exp)) ∧ (∀(l :num) (d :num) (m :num) (v :num). handle_adj_vars l d (Force m v :exp) = (Force m (if v < l then v else v + d) :exp)) ∧ (∀(l :num) (d :num) (t :num) (dest :num option) (xs :exp list). handle_adj_vars l d (Call t dest xs :exp) = (Call t dest (handle_adj_vars1 l d xs) :exp)) ∧ (∀(l :num) (d :num). handle_adj_vars1 l d ([] :exp list) = ([] :exp list)) ∧ ∀(l :num) (d :num) (x :exp) (xs :exp list). handle_adj_vars1 l d (x::xs) = handle_adj_vars l d x::handle_adj_vars1 l d xs
handle_size=(∀(v :num). handle_size (Var v :exp) = (1 :num)) ∧ (∀(x1 :exp) (x2 :exp) (x3 :exp). handle_size (If x1 x2 x3 :exp) = (1 :num) + handle_size x1 + handle_size x2 + handle_size x3) ∧ (∀(xs :exp list) (x2 :exp). handle_size (Let xs x2 :exp) = (1 :num) + handle_size x2 + handle_size1 xs) ∧ (∀(x1 :exp) (x2 :exp). handle_size (Handle x1 x2 :exp) = (1 :num) + (5 :num) * (handle_size x1 + handle_size x2)) ∧ (∀(x1 :exp). handle_size (Raise x1 :exp) = (1 :num) + handle_size x1) ∧ (∀(op :op) (xs :exp list). handle_size (Op op xs :exp) = (1 :num) + handle_size1 xs) ∧ (∀(x :exp). handle_size (Tick x :exp) = (1 :num) + handle_size x) ∧ (∀(m :num) (n :num). handle_size (Force m n :exp) = (1 :num)) ∧ (∀(t :num) (dest :num option) (xs :exp list). handle_size (Call t dest xs :exp) = (1 :num) + handle_size1 xs) ∧ handle_size1 ([] :exp list) = (1 :num) ∧ ∀(x :exp) (xs :exp list). handle_size1 (x::xs) = (1 :num) + handle_size x + handle_size1 xs
handle_simp=(∀(x2 :exp) (x1 :exp). handle_simp (Handle x1 x2 :exp) = make_handle x1 x2 (0 :num)) ∧ (∀(v :num). handle_simp (Var v :exp) = (Var v :exp)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp). handle_simp (If x1 x2 x3 :exp) = (If (handle_simp x1) (handle_simp x2) (handle_simp x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp). handle_simp (Let xs x2 :exp) = (Let (handle_simp_list xs) (handle_simp x2) :exp)) ∧ (∀(x1 :exp). handle_simp (Raise x1 :exp) = (Raise (handle_simp x1) :exp)) ∧ (∀(xs :exp list) (op :op). handle_simp (Op op xs :exp) = (Op op (handle_simp_list xs) :exp)) ∧ (∀(x :exp). handle_simp (Tick x :exp) = (Tick (handle_simp x) :exp)) ∧ (∀(n :num) (m :num). handle_simp (Force m n :exp) = (Force m n :exp)) ∧ (∀(xs :exp list) (t :num) (dest :num option). handle_simp (Call t dest xs :exp) = (Call t dest (handle_simp_list xs) :exp)) ∧ handle_simp_list ([] :exp list) = ([] :exp list) ∧ (∀(xs :exp list) (x :exp). handle_simp_list (x::xs) = handle_simp x::handle_simp_list xs) ∧ ∀(x2 :exp) (x1 :exp) (l :num). make_handle x1 x2 l = case dest_handle_Raise x1 of (NONE :exp option) => (case dest_handle_Let x1 of (NONE :(exp list # exp) option) => (case dest_handle_If x1 of (NONE :(exp # exp # exp + exp # exp # exp) option) => (Handle (handle_simp x1) (handle_adj_vars (1 :num) l (handle_simp x2)) :exp) | SOME (INL (b1',b2',b3') :exp # exp # exp + exp # exp # exp) => (If (handle_simp b1') (make_handle b2' x2 l) (handle_simp b3') :exp) | SOME (INR (b1,b2,b3) :exp # exp # exp + exp # exp # exp) => (If (handle_simp b1) (handle_simp b2) (make_handle b3 x2 l) :exp)) | SOME (xs,x) => (Let (handle_simp_list xs) (make_handle x x2 (l + LENGTH xs)) :exp)) | SOME r => (Let [r] (handle_adj_vars (1 :num) l (handle_simp x2)) :exp)
SmartLet=∀(xs :exp list) (x :exp). SmartLet xs x = if NULL xs then x else (Let xs x :exp)
LetLet=∀(env_length :num) (fvs :α sptree$num_map) (body :exp). LetLet env_length fvs body = (let (xs :num list) = GENLIST (I :num -> num) env_length; (zs :num list) = FILTER (λ(n :num). IS_SOME (lookup n fvs)) xs; (ys :(num # num) list) = MAPi (λ(i :num) (x :num). (x,i)) zs; (long_list :exp list) = GENLIST (λ(n :num). case ALOOKUP ys n of (NONE :num option) => (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) | SOME k => (Var k :exp)) env_length in (Let (MAP Var zs) (SmartLet long_list body) :exp))
OptionalLetLet=∀(e :exp) (env_size :num) (live :db_var_set) (s :num) (limit :num) (nr :bool). OptionalLetLet e env_size live s limit nr = if s < limit then ([e],live,s,nr) else (let (fvs :sptree$num_set) = db_to_set live; (flat_live :db_var_set) = vars_from_list (MAP (FST :num # unit -> num) (toAList fvs)) in ([(Let ([] :exp list) (LetLet env_size fvs e) :exp)],flat_live,(0 :num),nr))
OptionalLetLet_sing=∀(e :exp) (env_size :num) (live :db_var_set) (s :num) (limit :num) (nr :bool). OptionalLetLet_sing e env_size live s limit nr = if s < limit then (e,live,s,nr) else (let (fvs :sptree$num_set) = db_to_set live; (flat_live :db_var_set) = vars_from_list (MAP (FST :num # unit -> num) (toAList fvs)) in ((Let ([] :exp list) (LetLet env_size fvs e) :exp),flat_live,(0 :num),nr))
OptionalLetLet_sing_eq=OptionalLetLet (e :exp) (sz :num) (lv :db_var_set) (s :num) (lim :num) (nr :bool) = (λ((d :exp),(l :db_var_set),(s :num),(nr :bool)). ([d],l,s,nr)) (OptionalLetLet_sing e sz lv s lim nr)
handle_size_non_zero_replay=(0 :num) < handle_size (x :exp)
