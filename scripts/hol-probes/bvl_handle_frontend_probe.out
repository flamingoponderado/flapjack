compile_sing=(∀(l :num) (n :num) (v :num). (compile_sing l n (Var v :exp) :exp # db_var_set # num # bool) = if v < n then ((Var v :exp),(Var v :db_var_set),(1 :num),T) else ((Op (IntOp (Const (0 :int))) ([] :exp list) :exp),Empty,(1 :num),T)) ∧ (∀(l :num) (n :num) (x1 :exp) (x2 :exp) (x3 :exp). (compile_sing l n (If x1 x2 x3 :exp) :exp # db_var_set # num # bool) = (let ((x1 :exp),(l1 :db_var_set),(s1 :num),(nr1 :bool)) = (compile_sing l n x1 :exp # db_var_set # num # bool); ((x2 :exp),(l2 :db_var_set),(s2 :num),(nr2 :bool)) = (compile_sing l n x2 :exp # db_var_set # num # bool); ((x3 :exp),(l3 :db_var_set),(s3 :num),(nr3 :bool)) = (compile_sing l n x3 :exp # db_var_set # num # bool) in OptionalLetLet_sing (If x1 x2 x3 :exp) n (mk_Union l1 (mk_Union l2 l3)) (s1 + s2 + s3 + (1 :num)) l (nr1 ∧ nr2 ∧ nr3))) ∧ (∀(l :num) (n :num) (xs :exp list) (x2 :exp). (compile_sing l n (Let xs x2 :exp) :exp # db_var_set # num # bool) = if NULL xs then (compile_sing l n x2 :exp # db_var_set # num # bool) else (let (k :num) = LENGTH xs; ((xs :exp list),(l1 :db_var_set),(s1 :num),(nr1 :bool)) = (compile_list l n xs :exp list # db_var_set # num # bool); ((x2 :exp),(l2 :db_var_set),(s2 :num),(nr2 :bool)) = (compile_sing l (n + k) x2 :exp # db_var_set # num # bool) in OptionalLetLet_sing (Let xs x2 :exp) n (mk_Union l1 (Shift k l2 :db_var_set)) (s1 + s2 + (1 :num)) l (nr1 ∧ nr2))) ∧ (∀(l :num) (n :num) (x1 :exp) (x2 :exp). (compile_sing l n (Handle x1 x2 :exp) :exp # db_var_set # num # bool) = (let ((y1 :exp),(l1 :db_var_set),(s1 :num),(nr1 :bool)) = (compile_sing l n x1 :exp # db_var_set # num # bool) in if nr1 then (y1,l1,s1,T) else (let ((y2 :exp),(l2 :db_var_set),(s2 :num),(nr2 :bool)) = (compile_sing l (n + (1 :num)) x2 :exp # db_var_set # num # bool) in ((Handle (LetLet n (db_to_set l1) y1) y2 :exp),mk_Union l1 (Shift (1 :num) l2 :db_var_set),s2,nr2)))) ∧ (∀(l :num) (n :num) (x1 :exp). (compile_sing l n (Raise x1 :exp) :exp # db_var_set # num # bool) = (let ((dx :exp),(lx :db_var_set),(s1 :num),(nr1 :bool)) = (compile_sing l n x1 :exp # db_var_set # num # bool) in OptionalLetLet_sing (Raise dx :exp) n lx (s1 + (1 :num)) l F)) ∧ (∀(l :num) (n :num) (op :op) (xs :exp list). (compile_sing l n (Op op xs :exp) :exp # db_var_set # num # bool) = (let ((ys :exp list),(lx :db_var_set),(s1 :num),(nr1 :bool)) = (compile_list l n xs :exp list # db_var_set # num # bool) in if op = (ThunkOp ForceThunk :op) then ((Op op ys :exp),lx,s1 + (1 :num),F) else OptionalLetLet_sing (Op op ys :exp) n lx (s1 + (1 :num)) l nr1)) ∧ (∀(l :num) (n :num) (x :exp). (compile_sing l n (Tick x :exp) :exp # db_var_set # num # bool) = (let ((y :exp),(lx :db_var_set),(s1 :num),(nr1 :bool)) = (compile_sing l n x :exp # db_var_set # num # bool) in ((Tick y :exp),lx,s1,nr1))) ∧ (∀(l :num) (n :num) (m :num) (v :num). (compile_sing l n (Force m v :exp) :exp # db_var_set # num # bool) = if v < n then ((Force m v :exp),(Var v :db_var_set),(1 :num),F) else ((Op (IntOp (Const (0 :int))) ([] :exp list) :exp),Empty,(1 :num),T)) ∧ (∀(l :num) (n :num) (t :num) (dest :num option) (xs :exp list). (compile_sing l n (Call t dest xs :exp) :exp # db_var_set # num # bool) = (let ((ys :exp list),(lx :db_var_set),(s1 :num),(nr1 :bool)) = (compile_list l n xs :exp list # db_var_set # num # bool) in OptionalLetLet_sing (Call t dest ys :exp) n lx (s1 + (1 :num)) l F)) ∧ (∀(l :num) (n :num). (compile_list l n ([] :exp list) :exp list # db_var_set # num # bool) = (([] :exp list),Empty,(0 :num),T)) ∧ ∀(l :num) (n :num) (x :exp) (xs :exp list). (compile_list l n (x::xs) :exp list # db_var_set # num # bool) = (let ((dx :exp),(lx :db_var_set),(s1 :num),(nr1 :bool)) = (compile_sing l n x :exp # db_var_set # num # bool); ((dy :exp list),(ly :db_var_set),(s2 :num),(nr2 :bool)) = (compile_list l n xs :exp list # db_var_set # num # bool) in (dx::dy,mk_Union lx ly,s1 + s2,nr1 ∧ nr2))
compile_sing_eq=(∀(e :exp) (l :num) (n :num). (compile l n [e] :exp list # db_var_set # num # bool) = (λ((d :exp),(l :db_var_set),(s :num),(nr :bool)). ([d],l,s,nr)) (compile_sing l n e :exp # db_var_set # num # bool)) ∧ ∀(es :exp list) (l :num) (n :num). (compile l n es :exp list # db_var_set # num # bool) = (compile_list l n es :exp list # db_var_set # num # bool)
