function_compile_typed=(compile_exp (t :mlstring list) (env :source_to_flat$environment) (Fun (x :mlstring) (e :ast$exp) :ast$exp) :exp) = (Fun (join_all_names t) x (compile_exp t (env with v := nsBind x (Local None x) env.v) e :exp) :exp)
empty_match_typed=∀(v :semanticPrimitives$v) (st :'ffi semanticPrimitives$state) (err_v :semanticPrimitives$v) (env :semanticPrimitives$v sem_env). (evaluate_match st env v ([] :(ast$pat # ast$exp) list) err_v :'ffi semanticPrimitives$state # (semanticPrimitives$v list, semanticPrimitives$v) result) = (st,(Rerr (Rraise err_v) :(semanticPrimitives$v list, semanticPrimitives$v) result))
flat_rows_typed=(∀(v :v) (s :(β, γ) flatSem$state). pmatch_rows ([] :(flatLang$pat # α) list) s v = (No_match :((mlstring # v) list # flatLang$pat # α) match_result)) ∧ ∀(v :v) (s :(β, γ) flatSem$state) (pes :(flatLang$pat # α) list) (p :flatLang$pat) (e :α). pmatch_rows ((p,e)::pes) s v = case (pmatch s p v ([] :(mlstring # v) list) :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => pmatch_rows pes s v | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) | Match env => case pmatch_rows pes s v of (No_match :((mlstring # v) list # flatLang$pat # α) match_result) => Match (env,p,e) | (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) => (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) | Match v1 => Match (env,p,e)
