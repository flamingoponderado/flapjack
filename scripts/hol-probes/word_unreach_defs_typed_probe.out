SimpSeq_def_typed=∀(p1 :α prog) (p2 :α prog). SimpSeq p1 p2 = (let (default :α prog) = Seq p1 p2 in if p2 = (Skip :α prog) then p1 else case p1 of (Skip :α prog) => p2 | (Move n1 l1 :α prog) => (case dest_Seq_Move p2 of (NONE :(num # (num # num) list # α prog) option) => default | SOME (n2,l2,rest) => (let (l :(num # num) list) = merge_moves l1 l2 in if rest = (Skip :α prog) then (Move (MAX n1 n2) l :α prog) else Seq (Move (MAX n1 n2) l :α prog) rest)) | (Inst v65 :α prog) => default | Assign v66 v67 => default | (Get v68 v69 :α prog) => default | (Set v70 v71 :α prog) => default | (Store v72 v73 :α prog) => default | MustTerminate v74 => default | (Call v75 v76 v77 v78 :α prog) => default | Seq v79 v80 => default | (If v81 v82 v83 v84 v85 :α prog) => default | (Loop v86 v87 v88 :α prog) => default | (Alloc v89 v90 :α prog) => default | (StoreConsts v91 v92 v93 v94 v95 :α prog) => default | (Raise v96 :α prog) => p1 | (Return v97 v98 :α prog) => p1 | (Break v99 :α prog) => p1 | (Continue v100 :α prog) => p1 | (Tick :α prog) => default | (OpCurrHeap v101 v102 v103 :α prog) => default | (LocValue v104 v105 :α prog) => default | (Install v106 v107 v108 v109 v110 :α prog) => default | (CodeBufferWrite v111 v112 :α prog) => default | (DataBufferWrite v113 v114 :α prog) => default | (FFI v115 v116 v117 v118 v119 v120 :α prog) => default | ShareInst v121 v122 v123 => default)
Seq_assoc_right_def_typed=(∀(acc :α prog). Seq_assoc_right (Skip :α prog) acc = acc) ∧ (∀(q2 :α prog) (q1 :α prog) (acc :α prog). Seq_assoc_right (Seq q1 q2) acc = Seq_assoc_right q1 (Seq_assoc_right q2 acc)) ∧ (∀(v :cmp) (r :α reg_imm) (q2 :α prog) (q1 :α prog) (n :num) (acc :α prog). Seq_assoc_right (If v n r q1 q2 :α prog) acc = SimpSeq (If v n r (Seq_assoc_right q1 (Skip :α prog)) (Seq_assoc_right q2 (Skip :α prog)) :α prog) acc) ∧ (∀(q :α prog) (acc :α prog). Seq_assoc_right (MustTerminate q) acc = SimpSeq (MustTerminate (Seq_assoc_right q (Skip :α prog))) acc) ∧ (∀(ret_prog :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (handler :(num # α prog # num # num) option) (dest :num option) (args :num list) (acc :α prog). Seq_assoc_right (Call ret_prog dest args handler :α prog) acc = case ret_prog of (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) => (Call ret_prog dest args handler :α prog) | SOME (x1,x2,q1,x3,x4) => SimpSeq (Call (SOME (x1,x2,Seq_assoc_right q1 (Skip :α prog),x3,x4)) dest args (case handler of (NONE :(num # α prog # num # num) option) => (NONE :(num # α prog # num # num) option) | SOME (y1,q2,y2,y3) => SOME (y1,Seq_assoc_right q2 (Skip :α prog),y2,y3)) :α prog) acc) ∧ (∀(names :sptree$num_set) (exit_names :sptree$num_set) (body :α prog) (acc :α prog). Seq_assoc_right (Loop names body exit_names :α prog) acc = SimpSeq (Loop names (Seq_assoc_right body (Skip :α prog)) exit_names :α prog) acc) ∧ (∀(v8 :num) (v10 :(num # num) list) (acc :α prog). Seq_assoc_right (Move v8 v10 :α prog) acc = SimpSeq (Move v8 v10 :α prog) acc) ∧ (∀(v11 :α inst) (acc :α prog). Seq_assoc_right (Inst v11 :α prog) acc = SimpSeq (Inst v11 :α prog) acc) ∧ (∀(v13 :α exp) (v12 :num) (acc :α prog). Seq_assoc_right (Assign v12 v13) acc = SimpSeq (Assign v12 v13) acc) ∧ (∀(v15 :store_name) (v14 :num) (acc :α prog). Seq_assoc_right (Get v14 v15 :α prog) acc = SimpSeq (Get v14 v15 :α prog) acc) ∧ (∀(v17 :α exp) (v16 :store_name) (acc :α prog). Seq_assoc_right (Set v16 v17 :α prog) acc = SimpSeq (Set v16 v17 :α prog) acc) ∧ (∀(v19 :num) (v18 :α exp) (acc :α prog). Seq_assoc_right (Store v18 v19 :α prog) acc = SimpSeq (Store v18 v19 :α prog) acc) ∧ (∀(v36 :sptree$num_set # sptree$num_set) (v35 :num) (acc :α prog). Seq_assoc_right (Alloc v35 v36 :α prog) acc = SimpSeq (Alloc v35 v36 :α prog) acc) ∧ (∀(v41 :(bool # α word) list) (v40 :num) (v39 :num) (v38 :num) (v37 :num) (acc :α prog). Seq_assoc_right (StoreConsts v37 v38 v39 v40 v41 :α prog) acc = SimpSeq (StoreConsts v37 v38 v39 v40 v41 :α prog) acc) ∧ (∀(v42 :num) (acc :α prog). Seq_assoc_right (Raise v42 :α prog) acc = SimpSeq (Raise v42 :α prog) acc) ∧ (∀(v44 :num list) (v43 :num) (acc :α prog). Seq_assoc_right (Return v43 v44 :α prog) acc = SimpSeq (Return v43 v44 :α prog) acc) ∧ (∀(v45 :num) (acc :α prog). Seq_assoc_right (Break v45 :α prog) acc = SimpSeq (Break v45 :α prog) acc) ∧ (∀(v46 :num) (acc :α prog). Seq_assoc_right (Continue v46 :α prog) acc = SimpSeq (Continue v46 :α prog) acc) ∧ (∀(acc :α prog). Seq_assoc_right (Tick :α prog) acc = SimpSeq (Tick :α prog) acc) ∧ (∀(v49 :num) (v48 :num) (v47 :binop) (acc :α prog). Seq_assoc_right (OpCurrHeap v47 v48 v49 :α prog) acc = SimpSeq (OpCurrHeap v47 v48 v49 :α prog) acc) ∧ (∀(v51 :num) (v50 :num) (acc :α prog). Seq_assoc_right (LocValue v50 v51 :α prog) acc = SimpSeq (LocValue v50 v51 :α prog) acc) ∧ (∀(v56 :sptree$num_set # sptree$num_set) (v55 :num) (v54 :num) (v53 :num) (v52 :num) (acc :α prog). Seq_assoc_right (Install v52 v53 v54 v55 v56 :α prog) acc = SimpSeq (Install v52 v53 v54 v55 v56 :α prog) acc) ∧ (∀(v58 :num) (v57 :num) (acc :α prog). Seq_assoc_right (CodeBufferWrite v57 v58 :α prog) acc = SimpSeq (CodeBufferWrite v57 v58 :α prog) acc) ∧ (∀(v60 :num) (v59 :num) (acc :α prog). Seq_assoc_right (DataBufferWrite v59 v60 :α prog) acc = SimpSeq (DataBufferWrite v59 v60 :α prog) acc) ∧ (∀(v66 :sptree$num_set # sptree$num_set) (v65 :num) (v64 :num) (v63 :num) (v62 :num) (v61 :mlstring) (acc :α prog). Seq_assoc_right (FFI v61 v62 v63 v64 v65 v66 :α prog) acc = SimpSeq (FFI v61 v62 v63 v64 v65 v66 :α prog) acc) ∧ ∀(v69 :α exp) (v68 :num) (v67 :memop) (acc :α prog). Seq_assoc_right (ShareInst v67 v68 v69) acc = SimpSeq (ShareInst v67 v68 v69) acc
remove_unreach_def_typed=∀(e :α prog). remove_unreach e = Seq_assoc_right e (Skip :α prog)
