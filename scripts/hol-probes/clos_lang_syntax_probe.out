     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE ToListByte v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2
