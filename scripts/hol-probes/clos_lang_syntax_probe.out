∀(f :num -> α) (f1 :num -> α) (v :α) (v1 :α) (v2 :α).
  (glob_op_CASE SetGlobalsPtr f f1 v v1 v2 :α) = v2
glob_op_nchotomy=∀(gg :glob_op).
  (∃(n :num). gg = Global n) ∨ (∃(n :num). gg = SetGlobal n) ∨
  gg = AllocGlobal ∨ gg = GlobalsPtr ∨ gg = SetGlobalsPtr
mem_op_case_def=(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE Ref v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2 v13 v14
      f3 f4 v15 v16 v17 :α) = v) ∧
