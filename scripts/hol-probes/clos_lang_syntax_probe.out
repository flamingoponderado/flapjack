  (∃(w :word_size) (t :test). ww = WordTest w t) ∨ ww = WordFromInt ∨
  ww = WordToInt ∨ (∃(b :bool). ww = WordFromWord b) ∨
  (∃(f :fp_cmp). ww = FP_cmp f) ∨ (∃(f :fp_uop). ww = FP_uop f) ∨
  (∃(f :fp_bop). ww = FP_bop f) ∨ ∃(f :fp_top). ww = FP_top f
