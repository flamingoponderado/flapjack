(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE LengthByteVec v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12
      f2 v13 v14 f3 f4 v15 v16 v17 :α) = v11) ∧
(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE DerefByteVec v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2
      v13 v14 f3 f4 v15 v16 v17 :α) = v12) ∧
(∀(a0 :bool) (a1 :opb) (v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α)
     (v5 :α) (v6 :α) (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α)
     (v11 :α) (v12 :α) (f2 :bool -> opb -> α) (v13 :α) (v14 :α)
     (f3 :bool -> α) (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE (StringCmp a0 a1) v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11
      v12 f2 v13 v14 f3 f4 v15 v16 v17 :α) = f2 a0 a1) ∧
(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE XorByte v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2 v13
      v14 f3 f4 v15 v16 v17 :α) = v13) ∧
(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE BoundsCheckArray v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11
      v12 f2 v13 v14 f3 f4 v15 v16 v17 :α) = v14) ∧
(∀(a :bool) (v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α)
     (v6 :α) (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α)
     (v12 :α) (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE (BoundsCheckByte a) v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11
      v12 f2 v13 v14 f3 f4 v15 v16 v17 :α) = f3 a) ∧
(∀(a0 :num) (a1 :num) (v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α)
     (v5 :α) (v6 :α) (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α)
     (v11 :α) (v12 :α) (f2 :bool -> opb -> α) (v13 :α) (v14 :α)
     (f3 :bool -> α) (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE (MutCons a0 a1) v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12
      f2 v13 v14 f3 f4 v15 v16 v17 :α) = f4 a0 a1) ∧
(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE UpdateCons v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2
      v13 v14 f3 f4 v15 v16 v17 :α) = v15) ∧
(∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
     (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
     (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
     (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
   (mem_op_CASE FinaliseCons v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2
      v13 v14 f3 f4 v15 v16 v17 :α) = v16) ∧
∀(v :α) (v1 :α) (v2 :α) (v3 :α) (v4 :α) (f :bool -> α) (v5 :α) (v6 :α)
    (v7 :α) (v8 :α) (f1 :bool -> α) (v9 :α) (v10 :α) (v11 :α) (v12 :α)
    (f2 :bool -> opb -> α) (v13 :α) (v14 :α) (f3 :bool -> α)
    (f4 :num -> num -> α) (v15 :α) (v16 :α) (v17 :α).
  (mem_op_CASE ConfigGC v v1 v2 v3 v4 f v5 v6 v7 v8 f1 v9 v10 v11 v12 f2 v13
     v14 f3 f4 v15 v16 v17 :α) = v17
mem_op_nchotomy=∀(mm :mem_op).
  mm = Ref ∨ mm = Update ∨ mm = El ∨ mm = Length ∨ mm = LengthByte ∨
  (∃(b :bool). mm = RefByte b) ∨ mm = RefArray ∨ mm = DerefByte ∨
  mm = UpdateByte ∨ mm = ConcatByteVec ∨ (∃(b :bool). mm = CopyByte b) ∨
  mm = FromListByte ∨ mm = ToListByte ∨ mm = LengthByteVec ∨
  mm = DerefByteVec ∨ (∃(b :bool) ($o :opb). mm = StringCmp b $o) ∨
  mm = XorByte ∨ mm = BoundsCheckArray ∨
  (∃(b :bool). mm = BoundsCheckByte b) ∨
  (∃(n :num) (n0 :num). mm = MutCons n n0) ∨ mm = UpdateCons ∨
  mm = FinaliseCons ∨ mm = ConfigGC
op_case_def=(∀(a :num) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (Label a) f f1 f2 f3 f4 f5 f6 v f7 :α) = f a) ∧
(∀(a :mlstring) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (FFI a :op) f f1 f2 f3 f4 f5 f6 v f7 :α) = f1 a) ∧
(∀(a :int_op) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (IntOp a) f f1 f2 f3 f4 f5 f6 v f7 :α) = f2 a) ∧
(∀(a :word_op) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (WordOp a) f f1 f2 f3 f4 f5 f6 v f7 :α) = f3 a) ∧
(∀(a :block_op) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (BlockOp a) f f1 f2 f3 f4 f5 f6 v f7 :α) = f4 a) ∧
(∀(a :glob_op) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (GlobOp a) f f1 f2 f3 f4 f5 f6 v f7 :α) = f5 a) ∧
(∀(a :mem_op) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
     (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
     (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
   (op_CASE (MemOp a) f f1 f2 f3 f4 f5 f6 v f7 :α) = f6 a) ∧
(∀(f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α) (f3 :word_op -> α)
     (f4 :block_op -> α) (f5 :glob_op -> α) (f6 :mem_op -> α) (v :α)
     (f7 :thunk_op -> α). (op_CASE Install f f1 f2 f3 f4 f5 f6 v f7 :α) = v) ∧
∀(a :thunk_op) (f :num -> α) (f1 :mlstring -> α) (f2 :int_op -> α)
    (f3 :word_op -> α) (f4 :block_op -> α) (f5 :glob_op -> α)
    (f6 :mem_op -> α) (v :α) (f7 :thunk_op -> α).
  (op_CASE (ThunkOp a :op) f f1 f2 f3 f4 f5 f6 v f7 :α) = f7 a
op_nchotomy=∀(oo :op).
  (∃(n :num). oo = Label n) ∨ (∃(m :mlstring). oo = (FFI m :op)) ∨
  (∃(i :int_op). oo = IntOp i) ∨ (∃(w :word_op). oo = WordOp w) ∨
  (∃(b :block_op). oo = BlockOp b) ∨ (∃(g :glob_op). oo = GlobOp g) ∨
  (∃(m :mem_op). oo = MemOp m) ∨ oo = Install ∨
  ∃(t :thunk_op). oo = (ThunkOp t :op)
exp_case_def=(∀(a0 :tra) (a1 :num) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Var a0 a1 :exp) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) = f a0 a1) ∧
(∀(a0 :tra) (a1 :exp) (a2 :exp) (a3 :exp) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (If a0 a1 a2 a3 :exp) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f1 a0 a1 a2 a3) ∧
(∀(a0 :tra) (a1 :exp list) (a2 :exp) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Let a0 a1 a2) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f2 a0 a1 a2) ∧
(∀(a0 :tra) (a1 :exp) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Raise a0 a1 :exp) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f3 a0 a1) ∧
(∀(a0 :tra) (a1 :exp) (a2 :exp) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Handle a0 a1 a2 :exp) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f4 a0 a1 a2) ∧
(∀(a0 :tra) (a1 :exp) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Tick a0 a1) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) = f5 a0 a1) ∧
(∀(a0 :tra) (a1 :num) (a2 :num) (a3 :exp list) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Call a0 a1 a2 a3) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f6 a0 a1 a2 a3) ∧
(∀(a0 :tra) (a1 :num option) (a2 :exp) (a3 :exp list) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (App a0 a1 a2 a3 :exp) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f7 a0 a1 a2 a3) ∧
(∀(a0 :mlstring) (a1 :num option) (a2 :num list option) (a3 :num) (a4 :exp)
     (f :tra -> num -> α) (f1 :tra -> exp -> exp -> exp -> α)
     (f2 :tra -> exp list -> exp -> α) (f3 :tra -> exp -> α)
     (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Fn a0 a1 a2 a3 a4) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f8 a0 a1 a2 a3 a4) ∧
(∀(a0 :mlstring list) (a1 :num option) (a2 :num list option)
     (a3 :(num # exp) list) (a4 :exp) (f :tra -> num -> α)
     (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
     (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
     (f6 :tra -> num -> num -> exp list -> α)
     (f7 :tra -> num option -> exp -> exp list -> α)
     (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
     (f9 :mlstring list ->
          num option -> num list option -> (num # exp) list -> exp -> α)
     (f10 :tra -> op -> exp list -> α).
   (exp_CASE (Letrec a0 a1 a2 a3 a4 :exp) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) =
   f9 a0 a1 a2 a3 a4) ∧
∀(a0 :tra) (a1 :op) (a2 :exp list) (f :tra -> num -> α)
    (f1 :tra -> exp -> exp -> exp -> α) (f2 :tra -> exp list -> exp -> α)
    (f3 :tra -> exp -> α) (f4 :tra -> exp -> exp -> α) (f5 :tra -> exp -> α)
    (f6 :tra -> num -> num -> exp list -> α)
    (f7 :tra -> num option -> exp -> exp list -> α)
    (f8 :mlstring -> num option -> num list option -> num -> exp -> α)
    (f9 :mlstring list ->
         num option -> num list option -> (num # exp) list -> exp -> α)
    (f10 :tra -> op -> exp list -> α).
  (exp_CASE (Op a0 a1 a2) f f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 :α) = f10 a0 a1 a2
exp_nchotomy=∀(ee :exp).
  (∃(t :tra) (n :num). ee = (Var t n :exp)) ∨
  (∃(t :tra) (e :exp) (e0 :exp) (e1 :exp). ee = (If t e e0 e1 :exp)) ∨
  (∃(t :tra) (l :exp list) (e :exp). ee = Let t l e) ∨
  (∃(t :tra) (e :exp). ee = (Raise t e :exp)) ∨
  (∃(t :tra) (e :exp) (e0 :exp). ee = (Handle t e e0 :exp)) ∨
  (∃(t :tra) (e :exp). ee = Tick t e) ∨
  (∃(t :tra) (n0 :num) (n :num) (l :exp list). ee = Call t n0 n l) ∨
  (∃(t :tra) (o' :num option) (e :exp) (l :exp list).
     ee = (App t o' e l :exp)) ∨
  (∃(m :mlstring) (o0 :num option) (o' :num list option) (n :num) (e :exp).
     ee = Fn m o0 o' n e) ∨
  (∃(l0 :mlstring list) (o0 :num option) (o' :num list option)
       (l :(num # exp) list) (e :exp). ee = (Letrec l0 o0 o' l e :exp)) ∨
  ∃(t :tra) (o' :op) (l :exp list). ee = Op t o' l
