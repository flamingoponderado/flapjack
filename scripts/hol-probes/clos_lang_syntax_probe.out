block_op_nchotomy=∀(bb :block_op).
  (∃(n :num). bb = (Cons n :block_op)) ∨ (∃(n :num). bb = ElemAt n) ∨
  (∃(n :num) (n0 :num). bb = TagLenEq n n0) ∨ (∃(n :num). bb = LenEq n) ∨
  (∃(n :num). bb = TagEq n) ∨ bb = LengthBlock ∨
  (∃(t :test). bb = BoolTest t) ∨ bb = BoolNot ∨ bb = BoundsCheckBlock ∨
  (∃(n :num). bb = ConsExtend n) ∨ (∃(n :num). bb = FromList n) ∨
  bb = ListAppend ∨ (∃(c :const). bb = Constant c) ∨ bb = Equal ∨
  (∃(c :const_part). bb = EqualConst c) ∨ ∃(l :const_part list). bb = Build l
glob_op_case_def=(∀(a :num) (f :num -> α) (f1 :num -> α) (v :α) (v1 :α) (v2 :α).
   (glob_op_CASE (Global a) f f1 v v1 v2 :α) = f a) ∧
(∀(a :num) (f :num -> α) (f1 :num -> α) (v :α) (v1 :α) (v2 :α).
   (glob_op_CASE (SetGlobal a) f f1 v v1 v2 :α) = f1 a) ∧
