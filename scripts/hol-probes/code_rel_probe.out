code_rel_type=:α context ->
(mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ->
(mlstring |-> num list # α crepLang$prog) -> bool
compiled_return=Return [Var 0]
localised_return=T
localised_global_assignment=F
function_signature_lookup=SOME ([(«x»,One)],One)
target_function_lookup=SOME ([0],Return [Var 0])
code_rel_generated_initial=∀f vshs prog rsh.
  (if «f» = f then SOME ([],Skip,One) else NONE) = SOME (vshs,prog,rsh) ⇒
  localised_prog prog ∧
  (if «f» = f then SOME ([],One) else NONE) = SOME (vshs,rsh) ∧
  (if «f» = f then SOME ([],Skip) else NONE) =
  SOME
    (GENLIST I (SUM_ACC (MAP size_of_shape (MAP SND vshs)) 0),
     compile
       <|vars :=
           FOLDL $|+ FEMPTY
             (ZIP
                (MAP FST vshs,
                 ZIP
                   (MAP SND vshs,
                    with_shape (MAP SND vshs)
                      (GENLIST I
                         (SUM_ACC (MAP size_of_shape (MAP SND vshs)) 0)))));
         funcs := FEMPTY⟨«f» ↦ ([],One)⟩; eids := FEMPTY;
         vmax :=
           MAX_LIST
             (GENLIST I (SUM_ACC (MAP size_of_shape (MAP SND vshs)) 0))|>
       prog)
code_rel_matching=PASS
code_rel_generated_initial_proved=PASS
code_rel_rejects_wrong_body=PASS
code_rel_rejects_missing_function_signature=PASS
code_rel_rejects_unlocalised_source=PASS
