mem_sorted_append_typed=∀(R :α -> α -> bool) (l1 :α list) (l2 :α list) (x :α) (y :α). transitive R ∧ SORTED R (l1 ⧺ l2) ∧ MEM x l1 ∧ MEM y l2 ⇒ R x y
merge_def_typed=(∀(R :α -> α -> bool). merge R ([] :α list) ([] :α list) = ([] :α list)) ∧ (∀(v9 :α list) (v8 :α) (R :α -> α -> bool). merge R (v8::v9) ([] :α list) = v8::v9) ∧ (∀(v5 :α list) (v4 :α) (R :α -> α -> bool). merge R ([] :α list) (v4::v5) = v4::v5) ∧ ∀(y :α) (x :α) (l2 :α list) (l1 :α list) (R :α -> α -> bool). merge R (x::l1) (y::l2) = if R x y then x::merge R l1 (y::l2) else y::merge R (x::l1) l2
merge_empty_typed=∀(R :α -> α -> bool) (l :α list) (acc :β). merge R l ([] :α list) = l ∧ merge R ([] :α list) l = l
merge_last_lem1_typed=∀(R :α -> α -> bool) (l1 :α list) (l2 :α list) (x :α). (∀(y :α). MEM y l2 ⇒ ¬R x y) ⇒ merge R (l1 ⧺ [x]) l2 = merge R l1 l2 ⧺ [x]
merge_last_lem2_typed=∀(R :α -> α -> bool) (l1 :α list) (l2 :α list) (y :α). (∀(x :α). MEM x l1 ⇒ R x y) ⇒ merge R l1 (l2 ⧺ [y]) = merge R l1 l2 ⧺ [y]
merge_sorted_typed=∀(R :α -> α -> bool) (l1 :α list) (l2 :α list). transitive R ∧ total R ∧ SORTED R l1 ∧ SORTED R l2 ⇒ SORTED R (merge R l1 l2)
merge_tail_correct1_typed=∀(neg :bool) (R :α -> α -> bool) (l1 :α list) (l2 :α list) (acc :α list). (neg ⇔ F) ⇒ merge_tail neg R l1 l2 acc = REVERSE (merge R l1 l2) ⧺ acc
merge_tail_correct2_typed=∀(neg :bool) (R :α -> α -> bool) (l1 :α list) (l2 :α list) (acc :α list). (neg ⇔ T) ∧ transitive R ∧ SORTED R (REVERSE l1) ∧ SORTED R (REVERSE l2) ⇒ merge_tail neg R l1 l2 acc = merge R (REVERSE l1) (REVERSE l2) ⧺ acc
mergesortN_def_typed=(∀(l :α list) (R :α -> α -> bool). mergesortN R (0 :num) l = ([] :α list)) ∧ (∀(x :α) (l :α list) (R :α -> α -> bool). mergesortN R (1 :num) (x::l) = [x]) ∧ (∀(R :α -> α -> bool). mergesortN R (1 :num) ([] :α list) = ([] :α list)) ∧ (∀(y :α) (x :α) (l :α list) (R :α -> α -> bool). mergesortN R (2 :num) (x::y::l) = sort2 R x y) ∧ (∀(x :α) (R :α -> α -> bool). mergesortN R (2 :num) [x] = [x]) ∧ (∀(R :α -> α -> bool). mergesortN R (2 :num) ([] :α list) = ([] :α list)) ∧ (∀(z :α) (y :α) (x :α) (l :α list) (R :α -> α -> bool). mergesortN R (3 :num) (x::y::z::l) = sort3 R x y z) ∧ (∀(y :α) (x :α) (R :α -> α -> bool). mergesortN R (3 :num) [x; y] = sort2 R x y) ∧ (∀(x :α) (R :α -> α -> bool). mergesortN R (3 :num) [x] = [x]) ∧ (∀(R :α -> α -> bool). mergesortN R (3 :num) ([] :α list) = ([] :α list)) ∧ ∀(v4 :num) (l :α list) (R :α -> α -> bool). mergesortN R v4 l = if v4 = (0 :num) then ([] :α list) else if v4 = (1 :num) then case l of ([] :α list) => ([] :α list) | x::l' => [x] else if v4 = (2 :num) then case l of ([] :α list) => ([] :α list) | [x'] => [x'] | x'::y::l'' => sort2 R x' y else if v4 = (3 :num) then case l of ([] :α list) => ([] :α list) | [x''] => [x''] | [x''; y'] => sort2 R x'' y' | x''::y'::z::l'³' => sort3 R x'' y' z else (let (len1 :num) = DIV2 v4 in merge R (mergesortN R (DIV2 v4) l) (mergesortN R (v4 − len1) (DROP len1 l)))
mergesortN_correct_typed=∀(negate :bool) (R :α -> α -> bool) (n :num) (l :α list). total R ∧ transitive R ⇒ mergesortN_tail negate R n l = if negate then REVERSE (mergesortN R n l) else mergesortN R n l
mergesortN_sorted_typed=∀(R :α -> α -> bool) (n :num) (l :α list). total R ∧ transitive R ⇒ SORTED R (mergesortN R n l)
sort2_def_typed=∀(R :α -> α -> bool) (x :α) (y :α). sort2 R x y = if R x y then [x; y] else [y; x]
sort2_sorted_typed=∀(R :α -> α -> bool) (x :α) (y :α). total R ⇒ SORTED R (sort2 R x y)
sort2_tail_correct_typed=∀(neg :bool) (R :α -> α -> bool) (x :α) (y :α). sort2_tail neg R x y = if neg then REVERSE (sort2 R x y) else sort2 R x y
sort3_def_typed=∀(R :α -> α -> bool) (x :α) (y :α) (z :α). sort3 R x y z = if R x y then if R y z then [x; y; z] else if R x z then [x; z; y] else [z; x; y] else if R y z then if R x z then [y; x; z] else [y; z; x] else [z; y; x]
sort3_sorted_typed=∀(R :α -> α -> bool) (x :α) (y :α) (z :α). total R ⇒ SORTED R (sort3 R x y z)
sort3_tail_correct_typed=∀(neg :bool) (R :α -> α -> bool) (x :α) (y :α) (z :α). sort3_tail neg R x y z = if neg then REVERSE (sort3 R x y z) else sort3 R x y z
