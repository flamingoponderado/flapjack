compile_correct_typed=(!(env :v environment) (s :('c, 'ffi) state) (es :exp list) (m :mlstring option list) (db :closSem$v list) (res1 :(v list, v) result) (s1 :('c, 'ffi) state) (t :('c, 'ffi) closSem$state). (evaluate env s es :('c, 'ffi) state # (v list, v) result) = (s1,res1) /\ state_rel s t /\ env_rel env m db /\ EVERY no_Mat es /\ res1 <> (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ==> ?(res2 :(closSem$v list, closSem$v) result) (t1 :('c, 'ffi) closSem$state). (evaluate (compile m es,db,t) :(closSem$v list, closSem$v) result # ('c, 'ffi) closSem$state) = (res2,t1) /\ state_rel s1 t1 /\ result_rel (LIST_REL v_rel) v_rel res1 res2) /\ !(s :('c, 'ffi) state) (ds :exp list) (res1 :v error_result option) (s1 :('c, 'ffi) state) (t :('c, 'ffi) closSem$state). (evaluate_decs s ds :('c, 'ffi) state # v error_result option) = (s1,res1) /\ state_rel s t /\ no_Mat_decs ds /\ res1 <> SOME (Rabort Rtype_error :v error_result) ==> ?(res2 :(closSem$v list, closSem$v) result) (t1 :('c, 'ffi) closSem$state). (evaluate (compile_decs ds,([] :closSem$v list),t) :(closSem$v list, closSem$v) result # ('c, 'ffi) closSem$state) = (res2,t1) /\ state_rel s1 t1 /\ ?(v :'a list). (let (res1' :('a list, v) result) = case res1 of (NONE :v error_result option) => (Rval v :('a list, v) result) | SOME e => (Rerr e :('a list, v) result) in result_rel (LIST_REL (\(x :'a) (y :closSem$v). T)) v_rel res1' res2)
