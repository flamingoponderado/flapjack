val _ = observe "cm_dups" ``canonize_moves [(2,(1,3));(2,(1,3));(1,(1,3));(2,(1,3))] = [(4,2,(1,3))]``;
val _ = observe "cm_priority" ``canonize_moves [(9,(1,2));(1,(1,2));(7,(1,2));(0,(1,2));(9,(1,2))] = [(5,9,(1,2))]``;
val _ = observe "cm_x_first" ``canonize_moves [(0,(9,0));(99,(1,99));(0,(2,0))] = [(1,99,(1,99));(1,0,(0,9));(1,0,(0,2))]``;
val _ = observe "cm_y_second" ``canonize_moves [(0,(1,9));(99,(1,1));(0,(1,2))] = [(1,0,(1,9));(1,0,(1,2));(1,99,(1,1))]``;
