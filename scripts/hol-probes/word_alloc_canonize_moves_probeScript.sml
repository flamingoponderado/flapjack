val _ = observe "cm_four" ``canonize_moves [(5,(2,1));(2,(1,5));(9,(1,2));(3,(1,2))] = [(1,2,(1,5));(3,9,(1,2))]``;
val _ = observe "cm_five" ``canonize_moves [(7,(3,2));(1,(1,2));(4,(2,3));(5,(1,2));(2,(2,1))] = [(2,7,(2,3));(3,5,(1,2))]``;
val _ = observe "cm_odd" ``canonize_moves [(9,(3,5));(8,(2,4));(7,(1,3));(6,(3,2));(5,(2,1));(4,(1,2));(3,(1,1))] = [(1,9,(3,5));(1,8,(2,4));(1,6,(2,3));(1,7,(1,3));(2,5,(1,2));(1,3,(1,1))]``;
