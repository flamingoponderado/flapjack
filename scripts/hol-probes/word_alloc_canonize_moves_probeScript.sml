val _ = observe "cm_large" ``canonize_moves [(18446744073709551616,(1,2));(0,(18446744073709551616,2));(1,(1,2))] = [(1,0,(2,18446744073709551616));(2,18446744073709551616,(1,2))]``;
val _ = observe "cm_zeros" ``canonize_moves [(0,(0,0));(1,(0,0));(0,(1,0));(0,(0,1));(0,(0,0))] = [(2,0,(0,1));(3,1,(0,0))]``;
val _ = observe "cm_descending" ``canonize_moves [(0,(12,13));(1,(11,12));(2,(10,11));(3,(9,10));(4,(8,9));(5,(7,8));(6,(6,7));(7,(5,6));(8,(4,5));(9,(3,4));(10,(2,3));(11,(1,2))] = [(1,0,(12,13));(1,1,(11,12));(1,2,(10,11));(1,3,(9,10));(1,4,(8,9));(1,5,(7,8));(1,6,(6,7));(1,7,(5,6));(1,8,(4,5));(1,9,(3,4));(1,10,(2,3));(1,11,(1,2))]``;
