load "bossLib";
load "preamble";
load "word_allocTheory";
open bossLib HolKernel Parse preamble word_allocTheory;
fun observe label term = let val th = EVAL term in print (label ^ "="); print_term (rhs (concl th)); print "\n" end;
val _ = observe "cm_empty" ``canonize_moves [] = []``;
val _ = observe "cm_one" ``canonize_moves [(3,(7,2))] = [(1,3,(2,7))]``;
val _ = observe "cm_two" ``canonize_moves [(2,(3,4));(1,(1,2))] = [(1,2,(3,4));(1,1,(1,2))]``;
