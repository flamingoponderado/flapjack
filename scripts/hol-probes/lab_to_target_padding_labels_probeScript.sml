load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "pad_section_labels" pad_section_labels;
val _=types "pad_section_labels_types" pad_section_labels;
val _=print "pad_section_labels_hypotheses=";
val _=print(Int.toString(length(hyp pad_section_labels)) ^ "\n");
val _=show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc(EVAL q)); print "\n");
val _=observe "empty_arbitrary_acc" ``section_labels 3 (pad_section [0w;1w] ([]:8 line list) [Label 1 7 0;Asm (Asmi (Inst Skip)) [] 5]) [(7,99);(7,13)] = (8,[(7,8);(7,99);(7,13)])``;
val _=observe "even_zero_label" ``lab_len_pos_ok 0 ([Label 1 7 0]:8 line list) /\ section_labels 0 (pad_section [] ([Label 1 7 0]:8 line list) []) [(7,99);(7,13)] = (0,[(7,0);(7,99);(7,13)])``;
val _=observe "odd_asm_empty_nop" ``lab_len_pos_ok 1 ([Label 1 7 1]:8 line list) /\ section_labels 0 (pad_section [] ([Label 1 7 1]:8 line list) [Asm (Asmi (Inst Skip)) [0w] 1]) [(7,99)] = (2,[(7,2);(7,99)])``;
val _=observe "odd_labasm_wide_nop" ``section_labels 0 (pad_section [0w;1w;2w] ([Label 1 7 1]:8 line list) [LabAsm Halt 0w [] 1]) [(7,99)] = (2,[(7,2);(7,99)])``;
val _=observe "successive_boundaries" ``section_labels 0 (pad_section [0w] ([Label 1 7 1;Label 1 8 0;Asm (Asmi (Inst Skip)) [] 1;Label 1 7 1]:8 line list) [Asm (Asmi (Inst Skip)) [] 1]) [(7,99)] = (4,[(7,4);(8,2);(7,2);(7,99)])``;
val _=observe "annotation_not_bytes" ``section_labels 1 (pad_section [0w;1w] ([Asm (Asmi (Inst Skip)) [0w;0w;0w] 2;Label 1 7 0]:8 line list) [Asm (Asmi (Inst Skip)) [] 1]) [] = (4,[(7,4)])``;
val _=observe "boundary_guard_needed" ``lab_len_pos_ok 1 ([Label 1 7 1]:8 line list) /\ ~(section_labels 1 (pad_section [] ([Label 1 7 1]:8 line list) []) [] = section_labels 1 [Label 1 7 1] [])``;
val _=observe "line_parity_guard_needed" ``~lab_len_pos_ok 0 ([Label 1 7 2]:8 line list) /\ ~(section_labels 0 (pad_section [] ([Label 1 7 2]:8 line list) [Asm (Asmi (Inst Skip)) [] 0]) [] = section_labels 0 [Asm (Asmi (Inst Skip)) [] 0;Label 1 7 2] [])``;
val _=observe "aux_parity_guard_false" ``~lab_len_pos_ok 1 ([Label 1 7 0]:8 line list)``;
val _=observe "aux_zero_guard_false" ``lab_len_pos_ok 1 ([Label 1 7 1]:8 line list) /\ ~EVERY label_zero ([Label 1 7 1]:8 line list)``;
val _=observe "zero_label_id_ignored" ``section_labels 0 (pad_section [] ([Label 1 0 1]:8 line list) [Asm (Asmi (Inst Skip)) [] 1]) [(0,99)] = (2,[(0,99)])``;
