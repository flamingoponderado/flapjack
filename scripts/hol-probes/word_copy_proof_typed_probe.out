copy_prop_correct_typed=∀(prog :α prog) (cs :copy_state) (st :(α, β, γ) state) (prog' :α prog) (cs' :copy_state) (err :α result option) (st' :(α, β, γ) state). CPstate_inv cs ∧ CPstate_models cs st ∧ copy_prop_prog prog cs = (prog',cs') ∧ err ≠ SOME (Error :α result) ∧ evaluate (prog,st) = (err,st') ⇒ evaluate (prog',st) = (err,st') ∧ (err = (NONE :α result option) ⇒ CPstate_models cs' st')
evaluate_copy_prop_typed=FST (evaluate ((e :α prog),(s :(α, β, γ) state))) ≠ SOME (Error :α result) ⇒ evaluate (copy_prop e,s) = evaluate (e,s)
copy_prop_inst_correct_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ∧ copy_prop_inst (ins :α inst) cs = ((prog' :α prog),(cs' :copy_state)) ∧ evaluate ((Inst ins :α prog),st) = ((err :α result option),(st' :(α, β, γ) state)) ⇒ evaluate (prog',st) = (err,st') ∧ (err = (NONE :α result option) ⇒ CPstate_models cs' st')
copy_prop_inst_eval_typed=∀(ins :α inst) (cs :copy_state) (st :(α, β, γ) state) (prog' :α prog) (cs' :copy_state). CPstate_inv cs ⇒ CPstate_models cs st ⇒ (prog',cs') = copy_prop_inst ins cs ⇒ evaluate (prog',st) = evaluate ((Inst ins :α prog),st)
both_alloc_vars_def_typed=∀(t :num) (s :num). both_alloc_vars (t,s) ⇔ is_alloc_var t ∧ is_alloc_var s
CPstate_inv_def_typed=∀(cs :copy_state). CPstate_inv cs ⇔ (∀(v :num) (c :num). lookup v cs.to_eq = SOME c ⇒ c < cs.next) ∧ (∀(c :num). c ∈ (domain cs.from_eq :num -> bool) ⇒ c < cs.next) ∧ (∀(s :store_name) (c :num). ALOOKUP cs.store_to_eq s = SOME c ⇒ c < cs.next) ∧ ∀(c :num) (v :num). lookup c cs.from_eq = SOME v ⇒ lookup v cs.to_eq = SOME c
empty_eq_inv_typed=CPstate_inv empty_eq
lookup_eqI_typed=∀(cs :copy_state) (r :num) (v :num). r = v ∧ lookup v cs.to_eq = (NONE :num option) ∨ (∃(c :num). lookup v cs.to_eq = SOME c ∧ lookup c cs.from_eq = SOME r) ⇒ lookup_eq cs v = r
lookup_eq_remove_eq_t_typed=CPstate_inv (cs :copy_state) ∧ lookup_eq (remove_eq cs (t :num)) (x :num) = t ⇒ x = t
lookup_eq_set_eqD_typed=CPstate_inv (cs :copy_state) ⇒ lookup (t :num) cs.to_eq = (NONE :num option) ⇒ lookup_eq (set_eq cs t (s :num)) (v :num) = (r :num) ⇒ (r = t ⇒ v = t ∨ lookup_eq cs v = lookup_eq cs s) ∧ (r ≠ t ⇒ r = lookup_eq cs v)
lookup_eq_set_eq_is_alloc_var1_typed=CPstate_inv (cs :copy_state) ∧ both_alloc_vars ((t :num),(s :num)) ⇒ lookup t cs.to_eq = (NONE :num option) ⇒ lookup_eq cs s = lookup_eq cs (v :num) ⇒ lookup_eq (set_eq cs t s) v = t
lookup_eq_set_eq_is_alloc_var2_typed=CPstate_inv (cs :copy_state) ∧ both_alloc_vars ((t :num),(s :num)) ⇒ lookup t cs.to_eq = (NONE :num option) ⇒ (v :num) ≠ t ⇒ lookup_eq cs s ≠ lookup_eq cs v ⇒ lookup_eq (set_eq cs t s) v = lookup_eq cs v
lookup_eq_set_eq_not_alloc_var_typed=¬both_alloc_vars ((t :num),(s :num)) ⇒ lookup_eq (set_eq (cs :copy_state) t s) (v :num) = lookup_eq cs v
lookup_eq_set_eq_s_typed=CPstate_inv (cs :copy_state) ∧ both_alloc_vars ((t :num),(s :num)) ⇒ lookup t cs.to_eq = (NONE :num option) ⇒ lookup_eq (set_eq cs t s) s = t
lookup_eq_set_eq_t_typed=CPstate_inv (cs :copy_state) ∧ both_alloc_vars ((t :num),(s :num)) ⇒ lookup_eq (set_eq cs t s) t = t
lookup_store_eq_set_eqD_typed=CPstate_inv (cs :copy_state) ⇒ lookup (t :num) cs.to_eq = (NONE :num option) ⇒ lookup_store_eq (set_eq cs t (s :num)) (v :store_name) = SOME (r :num) ⇒ (r = t ⇒ lookup_store_eq cs v = SOME (lookup_eq cs s)) ∧ (r ≠ t ⇒ lookup_store_eq cs v = SOME r)
merge_eqs_inv_typed=CPstate_inv (cs1 :copy_state) ∧ CPstate_inv (cs2 :copy_state) ⇒ CPstate_inv (merge_eqs cs1 cs2)
remove_eq_inv_typed=∀(cs :copy_state) (v :num). CPstate_inv cs ⇒ CPstate_inv (remove_eq cs v)
remove_eqs_inv_typed=∀(vv :num list) (cs :copy_state). CPstate_inv cs ⇒ CPstate_inv (remove_eqs cs vv)
same_classD_typed=CPstate_inv (cs :copy_state) ∧ lookup_eq cs (x :num) = lookup_eq cs (y :num) ⇒ x = y ∨ x ≠ y ∧ ∃(c :num) (rep :num). lookup x cs.to_eq = SOME c ∧ lookup y cs.to_eq = SOME c ∧ lookup c cs.from_eq = SOME rep
set_eq_inv_typed=CPstate_inv (cs :copy_state) ∧ lookup (t :num) cs.to_eq = (NONE :num option) ⇒ CPstate_inv (set_eq cs t (s :num))
set_eq_store_to_eq_typed=(set_eq (cs :copy_state) (t :num) (s :num)).store_to_eq = cs.store_to_eq
set_store_eq_inv_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_inv (set_store_eq cs (name :store_name) (e :num))
CPstate_model_typed=CPstate_models (cs :copy_state) (st :(α, β, γ) state) ⇒ lookup (lookup_eq cs (v :num)) st.locals = lookup v st.locals
CPstate_models_def_typed=∀(cs :copy_state) (S :(α, β, γ) state). CPstate_models cs S ⇔ (∀(v :num) (c :num) (vrep :num). lookup v cs.to_eq = SOME c ⇒ lookup c cs.from_eq = SOME vrep ⇒ lookup v S.locals = lookup vrep S.locals) ∧ ∀(s :store_name) (c :num) (vrep :num). ALOOKUP cs.store_to_eq s = SOME c ⇒ lookup c cs.from_eq = SOME vrep ⇒ FLOOKUP S.store s = lookup vrep S.locals
CPstate_modelsD_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ⇒ (∀(x :num) (y :num). lookup_eq cs x = lookup_eq cs y ⇒ lookup x st.locals = lookup y st.locals) ∧ ∀(x :store_name) (y :num). lookup_store_eq cs x = SOME (lookup_eq cs y) ⇒ FLOOKUP st.store x = lookup y st.locals
CPstate_modelsI_typed=CPstate_inv (cs :copy_state) ∧ (∀(x :num) (y :num). lookup_eq cs x = lookup_eq cs y ⇒ lookup x (st :(α, β, γ) state).locals = lookup y st.locals) ∧ (∀(x :store_name) (y :num). lookup_store_eq cs x = SOME (lookup_eq cs y) ⇒ FLOOKUP st.store x = lookup y st.locals) ⇒ CPstate_models cs st
CPstate_models_same_typed=CPstate_models (cs :copy_state) (st :(α, β, γ) state) ∧ (st' :(α, δ, ε) state).locals = st.locals ∧ st'.store = st.store ⇒ CPstate_models cs st'
CPstate_models_with_const_typed=(CPstate_models (cs :copy_state) ((s :(α, β, γ) state) with locals_size := (ls :num option)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with fp_regs := (fp :num |-> word64)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with stack := (xs :α stack_frame list)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with stack_limit := (sl :num)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with stack_max := (sm :num option)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with stack_size := (ssize :num sptree$num_map)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with memory := (m :α word -> α word_loc)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with mdomain := (md :α word -> bool)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with sh_mdomain := (smd :α word -> bool)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with permute := (p :num -> num -> num)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with compile := (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with compile_oracle := (co :num -> β # (num # num # α prog) list)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with code_buffer := (cb :(α, 8) buffer)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with data_buffer := (db :(α, α) buffer)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with gc_fun := (g :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with handler := (hd :num)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with clock := (clk :num)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with termdep := (tdep :num)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with code := (cd :(num # α prog) sptree$num_map)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with be := (b :bool)) ⇔ CPstate_models cs s) ∧ (CPstate_models cs (s with ffi := (ffi :δ ffi_state)) ⇔ CPstate_models cs s)
merge_eqs_model1_typed=CPstate_models (cs1 :copy_state) (st :(α, β, γ) state) ⇒ CPstate_models (merge_eqs cs1 (cs2 :copy_state)) st
merge_eqs_model2_typed=CPstate_models (cs2 :copy_state) (st :(α, β, γ) state) ⇒ CPstate_models (merge_eqs (cs1 :copy_state) cs2) st
remove_eq_model_typed=CPstate_models (cs :copy_state) (st :(α, β, γ) state) ⇒ CPstate_models (remove_eq cs (t :num)) st
remove_eq_model_insert_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ CPstate_models (remove_eq cs (t :num)) (st with locals := insert t (val :α word_loc) st.locals)
remove_eq_model_set_var_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ⇒ CPstate_models (remove_eq cs (t :num)) (set_var t (val :α word_loc) st)
set_fp_var_model_typed=CPstate_models (cs :copy_state) (st :(α, β, γ) state) ⇒ CPstate_models cs (set_fp_var (t :num) (val :word64) st)
copy_prop_inst_inv_typed=CPstate_inv (cs :copy_state) ⇒ copy_prop_inst (ins :α inst) cs = ((prog' :α prog),(cs' :copy_state)) ⇒ CPstate_inv cs'
copy_prop_move_eval_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ copy_prop_move (moves :(num # num) list) cs = ((moves' :(num # num) list),(cs' :copy_state)) ⇒ evaluate ((Move (pri :num) moves :α prog),st) = ((err :α result option),(st' :(α, β, γ) state)) ⇒ evaluate ((Move pri moves' :α prog),st) = (err,st')
copy_prop_move_eval_aux1_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ ∀(moves' :(num # num) list) (cs' :copy_state). copy_prop_move (moves :(num # num) list) cs = (moves',cs') ⇒ MAP (λ(x :num). get_var x st) (MAP (SND :num # num -> num) moves') = MAP (λ(x :num). get_var x st) (MAP (SND :num # num -> num) moves)
copy_prop_move_eval_aux2_typed=MAP (FST :num # num -> num) (moves1 :(num # num) list) = MAP (FST :num # num -> num) (moves2 :(num # num) list) ⇒ get_vars (MAP (SND :num # num -> num) moves1) (st :(α, β, γ) state) = get_vars (MAP (SND :num # num -> num) moves2) st ⇒ evaluate ((Move (pri :num) moves1 :α prog),st) = evaluate ((Move pri moves2 :α prog),st)
copy_prop_move_eval_aux3_typed=∀(moves' :(num # num) list) (cs' :copy_state). copy_prop_move (moves :(num # num) list) (cs :copy_state) = (moves',cs') ⇒ MAP (FST :num # num -> num) moves' = MAP (FST :num # num -> num) moves
copy_prop_move_get_vars_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ copy_prop_move (moves :(num # num) list) cs = ((moves' :(num # num) list),(cs' :copy_state)) ⇒ get_vars (MAP (SND :num # num -> num) moves') st = get_vars (MAP (SND :num # num -> num) moves) st
copy_prop_move_inv_typed=CPstate_inv (cs :copy_state) ⇒ copy_prop_move (moves :(num # num) list) cs = ((moves' :(num # num) list),(cs' :copy_state)) ⇒ CPstate_inv cs'
copy_prop_move_model_aux_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ∧ both_alloc_vars ((t :num),(s :num)) ∧ lookup s st.locals = SOME (sval :α word_loc) ⇒ CPstate_models (set_eq (remove_eq cs t) t s) (st with locals := insert t sval st.locals)
copy_prop_prog_inv_typed=CPstate_inv (cs :copy_state) ∧ copy_prop_prog (prog :α prog) cs = ((prog' :α prog),(cs' :copy_state)) ⇒ CPstate_inv cs'
CPstate_modelsD_get_var_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ⇒ get_var (lookup_eq cs (x :num)) st = get_var x st
CPstate_modelsD_get_var_imm_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ⇒ get_var_imm (lookup_eq_imm cs (x :α reg_imm)) st = get_var_imm x st
CPstate_modelsD_get_vars_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ⇒ get_vars (MAP (lookup_eq cs) (xs :num list)) st = get_vars xs st
CPstate_modelsD_lookup_eq_imm_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ (word_exp st (case lookup_eq_imm cs (x :α reg_imm) of (Reg r :α reg_imm) => (Var r :α exp) | Imm w => (Const w :α exp)) :α word_loc option) = (word_exp st (case x of (Reg r :α reg_imm) => (Var r :α exp) | Imm w => (Const w :α exp)) :α word_loc option)
CPstate_modelsD_Var_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ⇒ (word_exp st (Var (lookup_eq cs (x :num)) :α exp) :α word_loc option) = (word_exp st (Var x :α exp) :α word_loc option)
empty_eq_model_typed=CPstate_models empty_eq (st :(α, β, γ) state)
lookup_alist_insert_same_typed=¬MEM (s :num) (tt :num list) ⇒ lookup s (alist_insert tt (values :α list) (locals :α sptree$num_map)) = lookup s locals
lookup_eq_idempotent_typed=CPstate_inv (cs :copy_state) ⇒ lookup_eq cs (lookup_eq cs (x :num)) = lookup_eq cs x
MAP_get_var_eqD_typed=MAP (λ(x :num). get_var x (st :(α, β, γ) state)) (xx :num list) = MAP (λ(x :num). get_var x st) (yy :num list) ⇒ get_vars xx st = get_vars yy st
set_eq_remove_eq_models_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ∧ lookup (s :num) st.locals = SOME (sval :α word_loc) ⇒ CPstate_models (set_eq (remove_eq cs (t :num)) t s) (st with locals := insert t sval st.locals)
copy_prop_move_correct_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ∧ copy_prop_prog (Move (pri :num) (moves :(num # num) list) :α prog) cs = ((prog' :α prog),(cs' :copy_state)) ∧ evaluate ((Move pri moves :α prog),st) = ((err :α result option),(st' :(α, β, γ) state)) ⇒ evaluate (prog',st) = (err,st') ∧ (err = (NONE :α result option) ⇒ CPstate_models cs' st')
copy_prop_move_model_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ set (MAP (FST :num # num -> num) (moves :(num # num) list)) ∩ set (MAP (SND :num # num -> num) moves) = (∅ :num -> bool) ⇒ copy_prop_move moves cs = ((moves' :(num # num) list),(cs' :copy_state)) ⇒ get_vars (MAP (SND :num # num -> num) moves) st = SOME (values :α word_loc list) ⇒ CPstate_models cs' (set_vars (MAP (FST :num # num -> num) moves) values st)
CPstate_modelsD_copy_prop_share_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ (word_exp st (copy_prop_share (e :α exp) cs) :α word_loc option) = (word_exp st e :α word_loc option)
evaluate_Loop_body_cong_err_typed=∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (c :α prog) (c' :α prog) (exit_names :sptree$num_set) (res :α result option) (s' :(α, γ, 'ffi) state). (∀(v :(α, γ, 'ffi) state) (res :α result option) (s' :(α, γ, 'ffi) state). evaluate (c,v) = (res,s') ∧ res ≠ SOME (Error :α result) ⇒ evaluate (c',v) = (res,s')) ∧ evaluate ((Loop names c exit_names :α prog),s) = (res,s') ∧ res ≠ SOME (Error :α result) ⇒ evaluate ((Loop names c' exit_names :α prog),s) = (res,s')
EVERY_NOT_MEM_D_typed=EVERY (λ(t :α). ¬MEM t (ss :α list)) (tt :α list) ⇒ set tt ∩ set ss = (∅ :α -> bool)
lookup_eq_remove_t_same_typed=lookup_eq (remove_eq (cs :copy_state) (t :num)) t = t
lookup_eq_set_store_eq_typed=CPstate_inv (cs :copy_state) ∧ is_alloc_var (x :num) ⇒ lookup_eq (set_store_eq cs (s :store_name) x) (y :num) = lookup_eq cs y
lookup_remove_eq_typed=lookup (n :num) (remove_eq (cs :copy_state) n).to_eq = (NONE :num option)
lookup_store_eq_set_store_eq_1_typed=CPstate_inv (cs :copy_state) ∧ is_alloc_var (x :num) ∧ lookup_store_eq (set_store_eq cs (s :store_name) x) s = SOME (y :num) ⇒ lookup_eq cs x = lookup_eq cs y
lookup_store_eq_set_store_eq_2_typed=CPstate_inv (cs :copy_state) ∧ is_alloc_var (x :num) ∧ (s :store_name) ≠ (t :store_name) ∧ lookup_store_eq (set_store_eq cs s x) t = SOME (y :num) ⇒ lookup_store_eq cs t = SOME y
lookup_store_eq_set_store_eq_same_typed=lookup (x :num) (cs :copy_state).to_eq = (NONE :num option) ∧ is_alloc_var x ⇒ lookup_store_eq (set_store_eq cs (s :store_name) x) s = SOME x
lookup_store_eq_SOME_typed=CPstate_models (cs :copy_state) (st :(α, β, γ) state) ∧ lookup_store_eq cs (s :store_name) = SOME (v :num) ⇒ FLOOKUP st.store s = lookup v st.locals
remove_eq_comm_typed=remove_eq (remove_eq (cs :copy_state) (x :num)) (y :num) = remove_eq (remove_eq cs y) x
remove_eq_model_unset_var_typed=CPstate_inv (cs :copy_state) ⇒ CPstate_models cs (st :(α, β, γ) state) ⇒ CPstate_models (remove_eq cs (t :num)) (unset_var t st)
set_store_eq_model_set_store_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ∧ get_var (n :num) st = SOME (w :α word_loc) ⇒ CPstate_models (set_store_eq cs (s :store_name) n) (set_store s w st)
set_store_eq_model_set_var_typed=CPstate_inv (cs :copy_state) ∧ CPstate_models cs (st :(α, β, γ) state) ∧ lookup_store_eq cs (s :store_name) = (NONE :num option) ∧ get_store s st = SOME (w :α word_loc) ⇒ CPstate_models (set_store_eq (remove_eq cs (n :num)) s n) (set_var n w st)
word_exp_cong_Load_typed=(word_exp (st :(α, β, γ) state) (addr' :α exp) :α word_loc option) = (word_exp st (addr :α exp) :α word_loc option) ⇒ (word_exp st (Load addr' :α exp) :α word_loc option) = (word_exp st (Load addr :α exp) :α word_loc option)
word_exp_cong_Op_typed=MAP (word_exp (st :(α, β, γ) state) :α exp -> α word_loc option) (aa' :α exp list) = MAP (word_exp st :α exp -> α word_loc option) (aa :α exp list) ⇒ (word_exp st (Op (op :binop) aa') :α word_loc option) = (word_exp st (Op op aa) :α word_loc option)
word_exp_cong_Shift_typed=(word_exp (st :(α, β, γ) state) (e' :α exp) :α word_loc option) = (word_exp st (e :α exp) :α word_loc option) ⇒ (word_exp st (e2' :α exp) :α word_loc option) = (word_exp st (e2 :α exp) :α word_loc option) ⇒ (word_exp st (Shift (sh :ast$shift) e' e2' :α exp) :α word_loc option) = (word_exp st (Shift sh e e2 :α exp) :α word_loc option)
word_exp_cong_Var_typed=get_var (x' :num) (st :(α, β, γ) state) = get_var (x :num) st ⇒ (word_exp st (Var x' :α exp) :α word_loc option) = (word_exp st (Var x :α exp) :α word_loc option)
