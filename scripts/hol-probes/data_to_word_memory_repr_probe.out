duplicate_thm_typed=abs_ml_inv (conf :data_to_word$config) ((xs :v list) ++ (stack :v list)) (refs :v ref sptree$num_map) ((rs :α word_loc heap_address list) ++ (roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ LENGTH xs = LENGTH rs ⇒ abs_ml_inv conf (xs ++ xs ++ stack) refs (rs ++ rs ++ roots,heap,be,a,sp,sp1,gens) limit ts
duplicate1_thm_typed=abs_ml_inv (conf :data_to_word$config) ((x1 :v)::(stack :v list)) (refs :v ref sptree$num_map) ((r1 :α word_loc heap_address)::(roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ⇒ abs_ml_inv conf (x1::x1::stack) refs (r1::r1::roots,heap,be,a,sp,sp1,gens) limit ts
move_thm_typed=∀(xs1 :v list) (rs1 :α word_loc heap_address list) (xs2 :v list) (rs2 :α word_loc heap_address list) (xs3 :v list) (rs3 :α word_loc heap_address list). abs_ml_inv (conf :data_to_word$config) (xs1 ++ xs2 ++ xs3 ++ (stack :v list)) (refs :v ref sptree$num_map) (rs1 ++ rs2 ++ rs3 ++ (roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ LENGTH xs1 = LENGTH rs1 ∧ LENGTH xs2 = LENGTH rs2 ∧ LENGTH xs3 = LENGTH rs3 ⇒ abs_ml_inv conf (xs1 ++ xs3 ++ xs2 ++ stack) refs (rs1 ++ rs3 ++ rs2 ++ roots,heap,be,a,sp,sp1,gens) limit ts
split1_thm_typed=abs_ml_inv (conf :data_to_word$config) ((xs1 :v list) ++ (stack :v list)) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ⇒ ∃(rs1 :α word_loc heap_address list) (roots1 :α word_loc heap_address list). roots = rs1 ++ roots1 ∧ LENGTH rs1 = LENGTH xs1
split2_thm_typed=abs_ml_inv (conf :data_to_word$config) ((xs1 :v list) ++ (xs2 :v list) ++ (stack :v list)) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ⇒ ∃(rs1 :α word_loc heap_address list) (rs2 :α word_loc heap_address list) (roots1 :α word_loc heap_address list). roots = rs1 ++ rs2 ++ roots1 ∧ LENGTH rs1 = LENGTH xs1 ∧ LENGTH rs2 = LENGTH xs2
split3_thm_typed=abs_ml_inv (conf :data_to_word$config) ((xs1 :v list) ++ (xs2 :v list) ++ (xs3 :v list) ++ (stack :v list)) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ⇒ ∃(rs1 :α word_loc heap_address list) (rs2 :α word_loc heap_address list) (rs3 :α word_loc heap_address list) (roots1 :α word_loc heap_address list). roots = rs1 ++ rs2 ++ rs3 ++ roots1 ∧ LENGTH rs1 = LENGTH xs1 ∧ LENGTH rs2 = LENGTH xs2 ∧ LENGTH rs3 = LENGTH xs3
word_ml_inv_rearrange_typed=(∀(x :v # α word_loc). MEM x (ys :(v # α word_loc) list) ⇒ MEM x (xs :(v # α word_loc) list)) ⇒ word_ml_inv ((heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) (c :data_to_word$config) (refs :v ref sptree$num_map) xs ⇒ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c refs ys
memory_rel_rearrange_typed=(∀(x :v # α word_loc). MEM x (ys :(v # α word_loc) list) ⇒ MEM x (xs :(v # α word_loc) list)) ⇒ memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) xs ⇒ memory_rel c be ts refs sp st m dm ys
memory_rel_tl_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((x :v # α word_loc)::(xs :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm xs
memory_rel_tail_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((v :v # α word_loc)::(vars :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm vars
memory_rel_drop_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((vs :(v # α word_loc) list) ++ (vars :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm vars
memory_rel_swap_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((x :v # α word_loc)::(y :v # α word_loc)::(z :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm (y::x::z)
v_inv_ck_mono_typed=∀(ck :num) (conf :data_to_word$config) (v :v) (refs :v ref sptree$num_map) (x :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list). v_inv_ck ck conf v refs (x,f,tf,heap) ⇒ ∀(ck' :num). ck' ≤ ck ⇒ v_inv_ck ck' conf v refs (x,f,tf,heap)
v_inv_def_typed=(v_inv (conf :data_to_word$config) (Number (i :int) :v) (refs :v ref sptree$num_map) ((x :α word_loc heap_address),(f :num |-> num),(tf :num |-> num),(heap :(α word_loc, tag # α word_loc list) heap_element list)) ⇔ if small_int (:α) i then x = Data (Word (Smallnum i :α word)) else ∃(ptr :num). x = Pointer ptr (Word (0w :α word)) ∧ heap_lookup ptr heap = SOME (Bignum i :(α word_loc, tag # α word_loc list) heap_element)) ∧ (v_inv conf (Word64 (w :word64) :v) refs (x,f,tf,heap) ⇔ ∃(ptr :num). x = Pointer ptr (Word (0w :α word)) ∧ heap_lookup ptr heap = SOME (Word64Rep (:α) w :(α word_loc, tag # α word_loc list) heap_element)) ∧ (v_inv conf (CodePtr (n :num) :v) refs (x,f,tf,heap) ⇔ x = Data (Loc n (0 :num) :α word_loc)) ∧ (v_inv conf (RefPtr (b :bool) n :v) refs (x,f,tf,heap) ⇔ n ∈ FDOM f ∧ (∀(ev :thunk_mode) (v :v). (lookup n refs :v ref option) ≠ SOME (Thunk ev v :v ref)) ∧ (∀(tg :num) (fin :bool) (l :v list) (c :v) (r :v list). (lookup n refs :v ref option) = SOME (MutBlock tg fin l c r) ⇒ ¬b) ∧ x = Pointer f⟨n⟩ (ref_ptr_annot conf (lookup n refs :v ref option) :α word_loc) ∨ (∃(ev :thunk_mode) (v :v) (y :α word_loc heap_address). (lookup n refs :v ref option) = SOME (Thunk ev v :v ref) ∧ (ev = Evaluated ⇒ (dest_thunk v refs :dest_thunk_ret) = NotThunk) ∧ n ∈ FDOM f ∧ heap_lookup f⟨n⟩ heap = SOME (ThunkBlock ev y :(α word_loc, tag # α word_loc list) heap_element) ∧ v_inv conf v refs (y,f,tf,heap) ∧ ¬b ∧ x = Pointer f⟨n⟩ (Word (0w :α word))) ∨ ∃(v :v). (lookup n refs :v ref option) = SOME (Thunk Evaluated v :v ref) ∧ (dest_thunk v refs :dest_thunk_ret) = NotThunk ∧ ¬b ∧ v_inv conf v refs (x,f,tf,heap)) ∧ (v_inv conf (Block (ts :num) n (vs :v list) :v) refs (x,f,tf,heap) ⇔ if vs = ([] :v list) then x = Data (Word (BlockNil n :α word)) ∧ n < dimword (:α) DIV (16 :num) ∧ ts = (0 :num) else ∃(ptr :num) (xs :α word_loc heap_address list). LIST_REL (λ(v :v) (x :α word_loc heap_address). v_inv conf v refs (x,f,tf,heap)) vs xs ∧ FLOOKUP tf ts = SOME ptr ∧ x = Pointer ptr (Word (ptr_bits conf n (LENGTH xs) :α word)) ∧ heap_lookup ptr heap = SOME (BlockRep n xs :(α word_loc, tag # α word_loc list) heap_element))
