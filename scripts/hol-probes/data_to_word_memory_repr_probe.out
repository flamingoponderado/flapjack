bc_ref_inv_typed=∀(conf :data_to_word$config) (n :num) (refs :v ref sptree$num_map) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (be :bool). bc_ref_inv conf n refs (f,tf,heap,be) ⇔ case (FLOOKUP f n,(lookup n refs :v ref option)) of ((NONE :num option),v4) => F | (SOME x,(NONE :v ref option)) => F | (SOME x,SOME (ValueArray ys :v ref)) => ∃(zs :α word_loc heap_address list). heap_lookup x heap = SOME (RefBlock zs :(α word_loc, tag # α word_loc list) heap_element) ∧ LIST_REL (λ(z :α word_loc heap_address) (y :v). v_inv conf y refs (z,f,tf,heap)) zs ys | (SOME x,SOME (ByteArray flag bs :v ref)) => (let (ws :num) = LENGTH bs DIV (dimindex (:α) DIV (8 :num)) + (1 :num) in heap_lookup x heap = SOME (Bytes be flag bs (REPLICATE ws (0w :α word)))) | (SOME x,SOME (Thunk ev v :v ref)) => ∃(z :α word_loc heap_address). heap_lookup x heap = SOME (ThunkBlock ev z :(α word_loc, tag # α word_loc list) heap_element) ∧ (ev = Evaluated ⇒ (dest_thunk v refs :dest_thunk_ret) = NotThunk) ∧ v_inv conf v refs (z,f,tf,heap) | (SOME x,SOME (MutBlock tg fin l c r)) => (∀(gs :num list). conf.gc_kind ≠ Generational gs) ∧ (¬fin ⇒ x ∉ IMAGE (FAPPLY tf) (FDOM tf)) ∧ ∃(zs :α word_loc heap_address list). heap_lookup x heap = SOME (BlockRep tg zs :(α word_loc, tag # α word_loc list) heap_element) ∧ LIST_REL (λ(z :α word_loc heap_address) (y :v). v_inv conf y refs (z,f,tf,heap)) zs (l ++ [c] ++ r)
