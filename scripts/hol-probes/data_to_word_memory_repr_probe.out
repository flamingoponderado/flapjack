block_rep_typed=∀(tag :num) (xs :α heap_address list). (BlockRep tag xs :(α, tag # β list) heap_element) = DataElement xs (LENGTH xs) (BlockTag tag,([] :β list))
block_nil_typed=∀(n :num). (BlockNil n :α word) = (n2w n :α word) ≪ (4 :num) + (2w :α word)
thunk_block_typed=∀(ev :thunk_mode) (x :α heap_address). (ThunkBlock ev x :(α, tag # β list) heap_element) = DataElement [x] (1 :num) (ThunkTag ev,([] :β list))
lower_bits_typed=get_lowerbits (conf :data_to_word$config) (Word (w :α word)) = (small_shift_length conf − (1 :num) -- (0 :num)) w ‖ (1w :α word) ∧ get_lowerbits conf (Loc (v3 :num) (v4 :num) :α word_loc) = (1w :α word)
get_addr_typed=∀(conf :data_to_word$config) (n :num) (w :α word_loc). get_addr conf n w = (n2w n :α word) ≪ shift_length conf ‖ get_lowerbits conf w
word_addr_typed=word_addr (conf :data_to_word$config) (Data (Loc (l1 :num) (l2 :num) :α word_loc)) = (Loc l1 (0 :num) :α word_loc) ∧ word_addr conf (Data (Word (v :α word))) = Word (v && ¬(1w :α word)) ∧ word_addr conf (Pointer (n :num) (w :α word_loc)) = Word (get_addr conf n w)
lower_bits_word8=get_lowerbits ((c :data_to_word$config) with <|len_bits := (2 :num); tag_bits := (1 :num)|>) (Word (255w :word8)) = (15w :word8)
lower_bits_wide=get_lowerbits ((c :data_to_word$config) with <|len_bits := (20 :num); tag_bits := (1 :num)|>) (Word (254w :word8)) = (255w :word8)
word_addr_loc=word_addr (c :data_to_word$config) (Data (Loc (7 :num) (9 :num) :word8 word_loc)) = (Loc (7 :num) (0 :num) :word8 word_loc)
lower_bits_word8_result=get_lowerbits ((c :data_to_word$config) with <|len_bits := (2 :num); tag_bits := (1 :num)|>) (Word (255w :word8)) = (15w :word8)
lower_bits_wide_result=get_lowerbits ((c :data_to_word$config) with <|len_bits := (20 :num); tag_bits := (1 :num)|>) (Word (254w :word8)) = (255w :word8)
make_byte_header_typed=∀(conf :data_to_word$config) (cmp_by_contents :bool) (len :num). (make_byte_header conf cmp_by_contents len :α word) = (let (tag :α word) = if cmp_by_contents then (7w :α word) else (23w :α word) in if dimindex (:α) = (32 :num) then (n2w (len + (4 :num)) :α word) ≪ (dimindex (:α) − (2 :num) − conf.len_size) ‖ tag else (n2w (len + (8 :num)) :α word) ≪ (dimindex (:α) − (3 :num) − conf.len_size) ‖ tag)
thunk_tag_to_bits_typed=(thunk_tag_to_bits Evaluated :α word) = (1w :α word) ∧ (thunk_tag_to_bits NotEvaluated :α word) = (0w :α word)
word_payload_typed=(∀(ys :β word_loc heap_address list) (l :num) (n :num) (qs :β word_loc list) (conf :data_to_word$config). (word_payload ys l (BlockTag n) qs conf :α word # β word_loc list # bool) = (make_header conf ((n2w n :α word) ≪ (2 :num)) (LENGTH ys),MAP (word_addr conf :β word_loc heap_address -> β word_loc) ys,qs = ([] :β word_loc list) ∧ LENGTH ys = l ∧ (encode_header conf (n * (4 :num)) (LENGTH ys) :α word option) = SOME (make_header conf ((n2w n :α word) ≪ (2 :num)) (LENGTH ys)))) ∧ (∀(ys :β word_loc heap_address list) (l :num) (qs :β word_loc list) (conf :data_to_word$config). (word_payload ys l RefTag qs conf :α word # β word_loc list # bool) = (make_header conf (2w :α word) (LENGTH ys),MAP (word_addr conf :β word_loc heap_address -> β word_loc) ys,qs = ([] :β word_loc list) ∧ LENGTH ys = l)) ∧ (∀(ys :β word_loc heap_address list) (l :num) (e :thunk_mode) (qs :β word_loc list) (conf :data_to_word$config). (word_payload ys l (ThunkTag e) qs conf :α word # β word_loc list # bool) = (make_header conf ((thunk_tag_to_bits e :α word) ≪ (3 :num) ‖ (6w :α word)) (LENGTH ys),MAP (word_addr conf :β word_loc heap_address -> β word_loc) ys,qs = ([] :β word_loc list) ∧ LENGTH ys = (1 :num) ∧ l = (1 :num))) ∧ (∀(ys :β word_loc heap_address list) (l :num) (qs :β word_loc list) (conf :data_to_word$config). (word_payload ys l Word64Tag qs conf :α word # β word_loc list # bool) = (make_header conf (3w :α word) l,qs,ys = ([] :β word_loc heap_address list) ∧ LENGTH qs = l ∧ IS_SOME (encode_header conf (3 :num) l :α word option))) ∧ (∀(ys :β word_loc heap_address list) (l :num) (b :bool) (qs :β word_loc list) (conf :data_to_word$config). (word_payload ys l (NumTag b) qs conf :α word # β word_loc list # bool) = (make_header conf ((b2w b :α word) ≪ (2 :num) ‖ (3w :α word)) (LENGTH qs),qs,ys = ([] :β word_loc heap_address list) ∧ LENGTH qs = l ∧ IS_SOME (encode_header conf (w2n ((b2w b :α word) ≪ (2 :num) ‖ (3w :α word))) (LENGTH qs) :α word option))) ∧ ∀(ys :β word_loc heap_address list) (l :num) (fl :bool) (n :num) (qs :β word_loc list) (conf :data_to_word$config). (word_payload ys l (BytesTag fl n) qs conf :α word # β word_loc list # bool) = ((make_byte_header conf fl n :α word),qs,ys = ([] :β word_loc heap_address list) ∧ LENGTH qs = l ∧ (let (k :num) = if dimindex (:α) = (32 :num) then (2 :num) else (3 :num) in n + (2 :num) ** k < (2 :num) ** (conf.len_size + k)))
