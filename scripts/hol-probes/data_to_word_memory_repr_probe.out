abs_ml_inv_stack_permute_typed=∀(xs :(v # α word_loc heap_address) list) (ys :(v # α word_loc heap_address) list). abs_ml_inv (conf :data_to_word$config) (MAP (FST :v # α word_loc heap_address -> v) xs ++ (stack :v list)) (refs :v ref sptree$num_map) (MAP (SND :v # α word_loc heap_address -> α word_loc heap_address) xs ++ (roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ set ys ⊆ set xs ⇒ abs_ml_inv conf (MAP (FST :v # α word_loc heap_address -> v) ys ++ stack) refs (MAP (SND :v # α word_loc heap_address -> α word_loc heap_address) ys ++ roots,heap,be,a,sp,sp1,gens) limit ts
