memory_rel_typed=∀(c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (space :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list). memory_rel c be ts refs space st m dm vars ⇔ ∃(heap :(α word_loc, tag # α word_loc list) heap_element list) (limit :num) (a :num) (sp :num) (sp1 :num) (gens :gen_state). heap_in_memory_store heap a sp sp1 gens c st m dm limit ∧ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c refs vars ∧ (limit + (3 :num)) * (dimindex (:α) DIV (8 :num)) + (1 :num) < dimword (:α) ∧ space ≤ sp
