su_setvar=∀jump off k s t v x. state_rel jump off k s t ∧ v < k ⇒ state_rel jump off k (set_var v x s) (set_var v x t)
su_setvar_types=jump:bool;off:α word # α word;k:num;s:(α, β, γ) stackSem$state;t:(α, β, γ) stackSem$state;v:num;x:α word_loc
su_setvar_proved=T
