pop_env_const_statement=∀y x. pop_env x = SOME y ⇒ y.clock = x.clock ∧ y.ffi = x.ffi ∧ (y.be ⇔ x.be) ∧ y.compile = x.compile ∧ y.compile_oracle = x.compile_oracle ∧ y.memory = x.memory ∧ y.mdomain = x.mdomain ∧ y.sh_mdomain = x.sh_mdomain ∧ y.store = x.store ∧ y.fp_regs = x.fp_regs ∧ y.gc_fun = x.gc_fun ∧ y.termdep = x.termdep ∧ y.permute = x.permute ∧ y.data_buffer = x.data_buffer ∧ y.code_buffer = x.code_buffer ∧ y.code = x.code ∧ y.stack_limit = x.stack_limit ∧ y.stack_max = x.stack_max ∧ y.stack_size = x.stack_size
pop_env_const_proved=T
pop_env_const_hypotheses=0
