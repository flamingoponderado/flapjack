hole_has_val_dec_typed=∀(f :num |-> num) (env :v list) (env' :v list) (s :(α, β) state) (c :v) (n :num). hole_has_val f env env' s.refs c ∧ s.clock = SUC n ⇒ hole_has_val f env env' (dec_clock (1 :num) s).refs c
only_fresh_refl_typed=∀(f :num |-> num) (refs :num |-> v ref). only_fresh f f refs
only_fresh_trans_typed=∀(f :num |-> num) (f' :num |-> num) (f'' :num |-> num) (refs :num |-> v ref) (refs' :num |-> v ref). only_fresh f f' refs ∧ only_fresh f' f'' refs' ∧ FDOM refs ⊆ FDOM refs' ⇒ only_fresh f f'' refs
only_fresh_submap_typed=∀(f :num |-> num) (f' :num |-> num) (f'' :num |-> num) (refs :num |-> v ref). only_fresh f f'' refs ∧ f' ⊑ f'' ⇒ only_fresh f f' refs
non_fresh_not_in_frange_typed=(ptr :num) ∈ FDOM (refs_old :num |-> v ref) ∧ ptr ∉ FRANGE (f :num |-> num) ∧ only_fresh f (f' :num |-> num) refs_old ⇒ ptr ∉ FRANGE f'
fresh_ptr_fresh_typed=∀(refs :num |-> α). (LEAST(ptr :num). ptr ∉ FDOM refs) ∉ FDOM refs
fresh_not_in_range_f_typed=∀(f :num |-> num) (s_refs :num |-> v ref) (t_refs :num |-> v ref). state_ref_rel f s_refs t_refs ⇒ (LEAST(ptr :num). ptr ∉ FDOM t_refs) ∉ FRANGE f
