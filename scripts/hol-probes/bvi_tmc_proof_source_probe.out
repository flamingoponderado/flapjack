env_rel_def_typed=∀(opt :bool) (f :num |-> num) (env1 :v list) (env2 :v list). env_rel opt f env1 env2 ⇔ ∃(xs :v list) (ys :v list). env2 = xs ++ ys ∧ LIST_REL (v_rel f) env1 xs ∧ (opt ⇒ LENGTH ys = (2 :num) ∧ ∃(hole_ptr :num) (hole_idx :int). ys❲(0 :num)❳ = (RefPtr F hole_ptr :v) ∧ ys❲(1 :num)❳ = (Number hole_idx :v) ∧ small_enough_int hole_idx)
state_ref_rel_def_typed=∀(f :num |-> num) (s_refs :num |-> v ref) (t_refs :num |-> v ref). state_ref_rel f s_refs t_refs ⇔ FDOM f = FDOM s_refs ∧ ∀(i :num) (v :v ref). FLOOKUP s_refs i = SOME v ⇒ ∃(j :num) (w :v ref). FLOOKUP f i = SOME j ∧ ref_rel f v w ∧ FLOOKUP t_refs j = SOME w
