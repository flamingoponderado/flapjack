free_names_def_typed=∀(n :num) (name :num). free_names n name ⇔ ∀(k :num). n + bvl_to_bvi_namespaces * k ≠ name
namespace_rel_def_typed=∀(c1 :α sptree$num_map) (c2 :α sptree$num_map). namespace_rel c1 c2 ⇔ (∀(n :num). n ∈ (domain c2 :num -> bool) ∧ bvl_num_stubs ≤ n ⇒ if n MOD bvl_to_bvi_namespaces = (3 :num) then n ∉ (domain c1 :num -> bool) else n ∈ (domain c1 :num -> bool)) ∧ (∀(n :num). n ∈ (domain c1 :num -> bool) ∧ bvl_num_stubs ≤ n ⇒ n MOD bvl_to_bvi_namespaces ≠ (3 :num)) ∧ ∀(n :num). n ∈ (domain c2 :num -> bool) ∧ n < bvl_num_stubs ⇒ n ∈ (domain c1 :num -> bool)
input_condition_def_typed=∀(next :num) (prog :(num # α # bvi$exp) list). input_condition next prog ⇔ EVERY (free_names next ∘ (FST :num # α # bvi$exp -> num)) prog ∧ EVERY (no_mutcons ∘ (SND :α # bvi$exp -> bvi$exp) ∘ (SND :num # α # bvi$exp -> α # bvi$exp)) prog ∧ ALL_DISTINCT (MAP (FST :num # α # bvi$exp -> num) prog) ∧ EVERY ($¬ ∘ (λ(n :num). n MOD bvl_to_bvi_namespaces = (3 :num)) ∘ (FST :num # α # bvi$exp -> num)) (FILTER ($<= bvl_num_stubs ∘ (FST :num # α # bvi$exp -> num)) prog) ∧ bvl_num_stubs ≤ next ∧ next MOD bvl_to_bvi_namespaces = (3 :num)
no_mutcons_def_typed=(∀(n :num). no_mutcons (Var n :bvi$exp) ⇔ T) ∧ (∀(x3 :bvi$exp) (x2 :bvi$exp) (x1 :bvi$exp). no_mutcons (If x1 x2 x3 :bvi$exp) ⇔ no_mutcons x1 ∧ no_mutcons x2 ∧ no_mutcons x3) ∧ (∀(xs :bvi$exp list) (x :bvi$exp). no_mutcons (Let xs x :bvi$exp) ⇔ EVERY (λ(a :bvi$exp). no_mutcons a) xs ∧ no_mutcons x) ∧ (∀(x :bvi$exp). no_mutcons (Raise x :bvi$exp) ⇔ no_mutcons x) ∧ (∀(x :bvi$exp). no_mutcons (Tick x :bvi$exp) ⇔ no_mutcons x) ∧ (∀(xs :bvi$exp list) (ticks :num) (handler :bvi$exp option) (dest :num option). no_mutcons (Call ticks dest xs handler :bvi$exp) ⇔ EVERY (λ(a :bvi$exp). no_mutcons a) xs ∧ case handler of (NONE :bvi$exp option) => T | SOME x => no_mutcons x) ∧ (∀(n :num) (loc :num). no_mutcons (Force loc n :bvi$exp) ⇔ T) ∧ (∀(y :bvi$exp) (xs :bvi$exp list) (ticks :num) (rets :num) (dest :num). no_mutcons (LetCall rets ticks dest xs y) ⇔ EVERY (λ(a :bvi$exp). no_mutcons a) xs ∧ no_mutcons y) ∧ (∀(xs :bvi$exp list). no_mutcons (Return xs) ⇔ EVERY (λ(a :bvi$exp). no_mutcons a) xs) ∧ ∀(xs :bvi$exp list) (op :closLang$op). no_mutcons (Op op xs :bvi$exp) ⇔ no_mutcons_op op ∧ EVERY (λ(a :bvi$exp). no_mutcons a) xs
no_mutcons_op_def_typed=∀(op :closLang$op). no_mutcons_op op ⇔ ∀(tag :num) (i :num). op ≠ MemOp (MutCons tag i)
code_rel_def_typed=∀(c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map). code_rel c1 c2 ⇔ ∀(loc :num) (arity :num) (exp :bvi$exp). lookup loc c1 = SOME (arity,exp) ⇒ no_mutcons exp ∧ ∃(n :num). ((compile_exp loc n arity exp :(bvi$exp # bvi$exp) option) = (NONE :(bvi$exp # bvi$exp) option) ⇒ lookup loc c2 = SOME (arity,exp)) ∧ ∀(wrap :bvi$exp) (work :bvi$exp). (compile_exp loc n arity exp :(bvi$exp # bvi$exp) option) = SOME (wrap,work) ⇒ lookup loc c2 = SOME (arity,wrap) ∧ lookup n c2 = SOME (arity + (2 :num),work)
code_rel_cases_typed=∀(loc :num) (arity :num) (body1 :bvi$exp) (c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map). lookup loc c1 = SOME (arity,body1) ∧ code_rel c1 c2 ⇒ no_mutcons body1 ∧ ∃(loc_opt :num) (body2 :bvi$exp). lookup loc c2 = SOME (arity,body2) ∧ (body1 ≠ body2 ⇒ optimised_code loc loc_opt c1 c2 ∧ rewrite_wrapper loc loc_opt arity body1 = SOME body2)
code_rel_domain_typed=∀(c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map). code_rel c1 c2 ⇒ (domain c1 :num -> bool) ⊆ (domain c2 :num -> bool)
code_rel_union_typed=code_rel (x :(num # bvi$exp) sptree$num_map) (y :(num # bvi$exp) sptree$num_map) ∧ code_rel (t :(num # bvi$exp) sptree$num_map) (s :(num # bvi$exp) sptree$num_map) ∧ DISJOINT (domain s :num -> bool) (domain y :num -> bool) ⇒ code_rel (union x t) (union y s)
compile_each_code_rel_typed=compile_each (next :num) (prog :(num # num # bvi$exp) list) = ((next1 :num),(prog2 :(num # num # bvi$exp) list)) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) prog) ∧ EVERY (free_names next ∘ (FST :num # num # bvi$exp -> num)) prog ∧ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog ⇒ code_rel (fromAList prog) (fromAList prog2)
compile_each_ALL_DISTINCT_typed=compile_each (n :num) (xs :(num # num # bvi$exp) list) = ((n1 :num),(ys :(num # num # bvi$exp) list)) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) xs) ∧ EVERY (free_names n ∘ (FST :num # num # bvi$exp -> num)) xs ⇒ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) ys) ∧ EVERY (free_names n1 ∘ (FST :num # num # bvi$exp -> num)) ys
compile_each_LENGTH_typed=∀(n :num) (prog :(num # num # bvi$exp) list). LENGTH (SND (compile_each n prog)) ≥ LENGTH prog
compile_each_MEM_typed=compile_each (n :num) (xs :(num # num # bvi$exp) list) = ((n1 :num),(ys :(num # num # bvi$exp) list)) ∧ MEM (e :num) (MAP (FST :num # num # bvi$exp -> num) ys) ⇒ MEM e (MAP (FST :num # num # bvi$exp -> num) xs) ∨ n ≤ e ∧ e < n1 ∧ ∃(k :num). e = n + k * bvl_to_bvi_namespaces
compile_each_namespace_rel_typed=compile_each (next :num) (prog :(num # num # bvi$exp) list) = ((next1 :num),(prog2 :(num # num # bvi$exp) list)) ∧ next MOD bvl_to_bvi_namespaces = (3 :num) ∧ bvl_num_stubs ≤ next ∧ EVERY ($¬ ∘ (λ(n :num). n MOD bvl_to_bvi_namespaces = (3 :num)) ∘ (FST :num # num # bvi$exp -> num)) (FILTER ($<= bvl_num_stubs ∘ (FST :num # num # bvi$exp -> num)) prog) ⇒ namespace_rel (fromAList prog) (fromAList prog2)
compile_each_next_mono_typed=∀(n :num) (xs :(num # num # bvi$exp) list) (n1 :num) (ys :(num # num # bvi$exp) list). compile_each n xs = (n1,ys) ⇒ ∃(k :num). n1 = n + bvl_to_bvi_namespaces * k
compile_prog_ALL_DISTINCT_typed=(compile_prog (b :bool) (n :num) (xs :(num # num # bvi$exp) list) :num # (num # num # bvi$exp) list) = ((n1 :num),(ys :(num # num # bvi$exp) list)) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) xs) ∧ EVERY (free_names n ∘ (FST :num # num # bvi$exp -> num)) xs ⇒ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) ys) ∧ EVERY (free_names n1 ∘ (FST :num # num # bvi$exp -> num)) ys
compile_prog_MEM_typed=(compile_prog (b :bool) (n :num) (xs :(num # num # bvi$exp) list) :num # (num # num # bvi$exp) list) = ((n1 :num),(ys :(num # num # bvi$exp) list)) ∧ MEM (e :num) (MAP (FST :num # num # bvi$exp -> num) ys) ⇒ MEM e (MAP (FST :num # num # bvi$exp -> num) xs) ∨ n ≤ e ∧ e < n1 ∧ ∃(k :num). e = n + k * bvl_to_bvi_namespaces
compile_prog_next_mono_typed=∀(b :bool) (n :num) (xs :(num # num # bvi$exp) list) (n1 :num) (ys :(num # num # bvi$exp) list). (compile_prog b n xs :num # (num # num # bvi$exp) list) = (n1,ys) ⇒ ∃(k :num). n1 = n + bvl_to_bvi_namespaces * k
namespace_rel_union_typed=namespace_rel (x :α sptree$num_map) (y :α sptree$num_map) ∧ namespace_rel (t :α sptree$num_map) (s :α sptree$num_map) ∧ DISJOINT (domain s :num -> bool) (domain y :num -> bool) ⇒ namespace_rel (union x t) (union y s)
optimised_code_def_typed=∀(loc :num) (loc_opt :num) (c1 :(num # bvi$exp) sptree$num_map) (c2 :(num # bvi$exp) sptree$num_map). optimised_code loc loc_opt c1 c2 ⇔ ∃(arity :num) (body :bvi$exp) (body_wrap :bvi$exp) (body_work :bvi$exp). lookup loc c1 = SOME (arity,body) ∧ lookup loc c2 = SOME (arity,body_wrap) ∧ lookup loc_opt c2 = SOME (arity + (2 :num),body_work) ∧ rewrite_wrapper loc loc_opt arity body = SOME body_wrap ∧ rewrite_worker loc loc_opt arity (arity + (1 :num)) arity body = body_work
list_rel_front_typed=∀(r :α -> β -> bool) (l1 :α list) (l2 :β list). LIST_REL r l1 l2 ⇒ LIST_REL r (FRONT l1) (FRONT l2)
list_rel_last_typed=∀(r :α -> β -> bool) (l1 :α list) (l2 :β list). LIST_REL r l1 l2 ∧ l1 ≠ ([] :α list) ⇒ r (LAST l1) (LAST l2)
wrapper_strip_if_else_typed=rewrite_wrapper (loc :num) (loc_opt :num) (n :num) (If (x1 :bvi$exp) (x2 :bvi$exp) (x3 :bvi$exp) :bvi$exp) = SOME (w :bvi$exp) ⇒ ∃(w2 :bvi$exp) (w3 :bvi$exp). w = (If x1 w2 w3 :bvi$exp) ∧ (rewrite_wrapper loc loc_opt n x3 = SOME w3 ∨ w3 = x3)
wrapper_strip_if_then_typed=rewrite_wrapper (loc :num) (loc_opt :num) (n :num) (If (x1 :bvi$exp) (x2 :bvi$exp) (x3 :bvi$exp) :bvi$exp) = SOME (w :bvi$exp) ⇒ ∃(w2 :bvi$exp) (w3 :bvi$exp). w = (If x1 w2 w3 :bvi$exp) ∧ (rewrite_wrapper loc loc_opt n x2 = SOME w2 ∨ w2 = x2)
wrapper_strip_let_typed=∀(n :num) (loc :num) (loc_opt :num) (xs :bvi$exp list) (x :bvi$exp) (w :bvi$exp). rewrite_wrapper loc loc_opt n (Let xs x :bvi$exp) = SOME w ⇒ ∃(w' :bvi$exp). w = (Let xs w' :bvi$exp) ∧ rewrite_wrapper loc loc_opt (n + LENGTH xs) x = SOME w'
wrapper_strip_tick_typed=∀(n :num) (loc :num) (loc_opt :num) (x :bvi$exp) (w :bvi$exp). rewrite_wrapper loc loc_opt n (Tick x :bvi$exp) = SOME w ⇒ ∃(w' :bvi$exp). w = (Tick w' :bvi$exp) ∧ rewrite_wrapper loc loc_opt n x = SOME w'
rewrite_wrapper_NONE_irrel_typed=∀(loc :num) (lo1 :num) (n :num) (exp :bvi$exp) (lo2 :num). rewrite_wrapper loc lo1 n exp = (NONE :bvi$exp option) ⇒ rewrite_wrapper loc lo2 n exp = (NONE :bvi$exp option)
compile_exp_next_addr_typed=∀(loc :num) (next :num) (args :num) (exp :bvi$exp). (compile_exp loc next args exp :(bvi$exp # bvi$exp) option) = (NONE :(bvi$exp # bvi$exp) option) ⇒ (compile_exp loc (next + bvl_to_bvi_namespaces) args exp :(bvi$exp # bvi$exp) option) = (NONE :(bvi$exp # bvi$exp) option)
compile_exp_SOME_irrel_typed=∀(loc :num) (next :num) (args :num) (exp :bvi$exp) (w :bvi$exp # bvi$exp). (compile_exp loc next args exp :(bvi$exp # bvi$exp) option) = SOME w ⇒ ∀(next2 :num). ∃(w' :bvi$exp # bvi$exp). (compile_exp loc next2 args exp :(bvi$exp # bvi$exp) option) = SOME w'
compile_each_keeps_names_typed=∀(next :num) (xs :(num # num # bvi$exp) list) (next' :num) (ys :(num # num # bvi$exp) list). compile_each next xs = (next',ys) ∧ MEM (x :num) (MAP (FST :num # num # bvi$exp -> num) xs) ⇒ MEM x (MAP (FST :num # num # bvi$exp -> num) ys)
compile_prog_keeps_names_typed=∀(b :bool) (next :num) (xs :(num # num # bvi$exp) list) (next' :num) (ys :(num # num # bvi$exp) list). (compile_prog b next xs :num # (num # num # bvi$exp) list) = (next',ys) ∧ MEM (x :num) (MAP (FST :num # num # bvi$exp -> num) xs) ⇒ MEM x (MAP (FST :num # num # bvi$exp -> num) ys)
get_code_labels_MAP_Var_replay_typed=BIGUNION (set (MAP get_code_labels (MAP (λ(n :num). (Var n :bvi$exp)) (vs :num list)))) = (∅ :num -> bool)
cb_to_bvi_worker_aux_code_labels_replay_typed=∀(cb :call_block) (loc_opt :num) (ptr :num) (idx :num). get_code_labels (cb_to_bvi_worker_aux cb loc_opt ptr idx) = {loc_opt}
cb_to_bvi_worker_code_labels_replay_typed=get_code_labels (cb_to_bvi_worker (cb :call_block) (loc_opt :num) (ptr :num) (idx :num)) = {loc_opt}
cb_to_bvi_wrapper_code_labels_replay_typed=get_code_labels (cb_to_bvi_wrapper (tag :num) (left :num list) (child :call_block) (right :num list) (loc_opt :num)) = {loc_opt}
bvi_to_cb_aux_code_labels_lemma_replay_typed=(∀(n :num) (loc :num) (tag :num) (exp :bvi$exp) (bs :bvi$exp list) (r :num list + call_block). bvi_to_cb_aux_sing n loc tag exp = SOME (bs,r) ⇒ BIGUNION (set (MAP get_code_labels bs)) ⊆ get_code_labels exp) ∧ ∀(n :num) (loc :num) (tag :num) (args :bvi$exp list) (bs :bvi$exp list) (r :num list + call_block). bvi_to_cb_aux n loc tag args = SOME (bs,r) ⇒ BIGUNION (set (MAP get_code_labels bs)) ⊆ BIGUNION (set (MAP get_code_labels args))
bvi_to_cb_code_labels_replay_typed=∀(n :num) (loc :num) (exp :bvi$exp) (bs :bvi$exp list) (cb :call_block). bvi_to_cb n loc exp = SOME (bs,cb) ⇒ BIGUNION (set (MAP get_code_labels bs)) ⊆ get_code_labels exp
rewrite_wrapper_code_labels_replay_typed=∀(loc :num) (loc_opt :num) (n :num) (exp :bvi$exp) (y :bvi$exp). rewrite_wrapper loc loc_opt n exp = SOME y ⇒ get_code_labels y ⊆ get_code_labels exp ∪ {loc_opt}
rewrite_worker_code_labels_replay_typed=∀(loc :num) (loc_opt :num) (p :num) (i :num) (n :num) (exp :bvi$exp). get_code_labels (rewrite_worker loc loc_opt p i n exp) ⊆ get_code_labels exp ∪ {loc_opt}
compile_exp_code_labels_replay_typed=(compile_exp (loc :num) (next :num) (arity :num) (exp :bvi$exp) :(bvi$exp # bvi$exp) option) = SOME ((exp_w :bvi$exp),(exp_k :bvi$exp)) ⇒ get_code_labels exp_w ⊆ get_code_labels exp ∪ {next} ∧ get_code_labels exp_k ⊆ get_code_labels exp ∪ {next}
compile_each_good_code_labels_typed=∀(n :num) (c :(num # num # bvi$exp) list) (n2 :num) (c2 :(num # num # bvi$exp) list). compile_each n c = (n2,c2) ∧ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) c)) ⊆ (all :num -> bool) ∧ {n + k * bvl_to_bvi_namespaces | k | n + k * bvl_to_bvi_namespaces < n2} ⊆ all ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) c2)) ⊆ all
compile_prog_good_code_labels_typed=∀(b :bool) (n :num) (c :(num # num # bvi$exp) list) (n2 :num) (c2 :(num # num # bvi$exp) list). (compile_prog b n c :num # (num # num # bvi$exp) list) = (n2,c2) ∧ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) c)) ⊆ (all :num -> bool) ∧ {n + k * bvl_to_bvi_namespaces | k | n + k * bvl_to_bvi_namespaces < n2} ⊆ all ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) c2)) ⊆ all
compile_prog_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (3 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_prog (b :bool) n prog :num # (num # num # bvi$exp) list) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co (compile_prog b :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) co) cc start :behaviour)
compile_each_semantics_typed=input_condition (n :num) (prog :(num # num # bvi$exp) list) ∧ (∀(k :num) (n :num) (cfg :α) (prog :(num # num # bvi$exp) list). (co :num -> (num # α) # (num # num # bvi$exp) list) k = ((n,cfg),prog) ⇒ input_condition n prog) ∧ (∀(k :num). MEM k (MAP (FST :num # num # bvi$exp -> num) (prog2 :(num # num # bvi$exp) list)) ∧ k MOD bvl_to_bvi_namespaces = (3 :num) ⇒ k < FST (FST (co (0 :num)))) ∧ SND (compile_each n prog) = prog2 ∧ (semantics (ffi :β ffi_state) (fromAList prog) co (state_cc compile_each (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option)) (start :num) :behaviour) ≠ Fail ⇒ (semantics ffi (fromAList prog) co (state_cc compile_each cc) start :behaviour) = (semantics ffi (fromAList prog2) (state_co compile_each co) cc start :behaviour)
