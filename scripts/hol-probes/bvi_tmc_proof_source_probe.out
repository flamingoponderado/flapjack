holes_unchanged_except_subset_typed=∀(f :α |-> β) (refs :β |-> γ ref) (refs' :β |-> γ ref) (changed :β -> bool) (changed' :β -> bool). holes_unchanged_except f refs refs' changed ∧ changed ⊆ changed' ⇒ holes_unchanged_except f refs refs' changed'
holes_unchanged_except_del_typed=∀(f :α |-> β) (refs_old :β |-> γ ref) (refs_new :β |-> γ ref) (changed :β -> bool) (ptr :β) (v :γ ref). holes_unchanged_except f refs_old⟨ptr ↦ v⟩ refs_new changed ∧ ptr ∉ FDOM refs_old ⇒ holes_unchanged_except f refs_old refs_new (changed DIFF {ptr})
holes_unchanged_except_del_SING_typed=∀(f :α |-> β) (refs_old :β |-> γ ref) (refs_new :β |-> γ ref) (changed :δ) (ptr :β) (v :γ ref). holes_unchanged_except f refs_old⟨ptr ↦ v⟩ refs_new {ptr} ∧ ptr ∉ FDOM refs_old ⇒ holes_unchanged_except f refs_old refs_new (∅ :β -> bool)
holes_unchanged_except_changed_typed=∀(f :α |-> β) (refs_old :β |-> γ ref) (refs_new :β |-> γ ref) (changed :δ) (ptr :β) (tag :num) (fin :bool) (l :γ list) (c :γ) (r :γ list). holes_unchanged_except f refs_old⟨ptr ↦ MutBlock tag fin l c r⟩ refs_new (∅ :β -> bool) ∧ FLOOKUP refs_old ptr = SOME (MutBlock tag (fin' :bool) l (c' :γ) r) ⇒ holes_unchanged_except f refs_old refs_new {ptr}
holes_unchanged_except_filled_typed=∀(f :α |-> β) (refs_old :β |-> γ ref) (refs_new :β |-> γ ref) (changed :δ) (ptr :β) (tag :num) (fin :bool) (l :γ list) (c :γ) (r :γ list). holes_unchanged_except f refs_old refs_new (∅ :β -> bool) ∧ FLOOKUP refs_old ptr = SOME (MutBlock tag (fin' :bool) l (c' :γ) r) ⇒ holes_unchanged_except f refs_old refs_new⟨ptr ↦ MutBlock tag fin l c r⟩ {ptr}
unchanged_hole_has_val_typed=∀(f :num |-> num) (f' :num |-> num) (env :v list) (env' :v list) (hole_ptr :num) (hole_idx :int) (refs :num |-> v ref) (refs' :num |-> v ref) (c :v) (changed :num -> bool). hole_has_val f env (env' ++ [(RefPtr F hole_ptr :v); (Number hole_idx :v)]) refs c ∧ only_fresh f f' refs ∧ holes_unchanged_except f refs refs' changed ∧ hole_ptr ∉ changed ⇒ hole_has_val f' env (env' ++ [(RefPtr F hole_ptr :v); (Number hole_idx :v)]) refs' c
hole_has_val_append_typed=∀(f :num |-> num) (env :v list) (env' :v list) (refs :num |-> v ref) (c :v) (vs :v list) (vs' :v list). hole_has_val f env env' refs c ∧ LIST_REL (v_rel f) vs vs' ⇒ hole_has_val f (vs ++ env) (vs' ++ env') refs c
