state_rel_def_typed=∀(f :num |-> num) (s :(num # α, 'ffi) state) (t :(α, 'ffi) state). state_rel f s t ⇔ state_ref_rel f s.refs t.refs ∧ t.clock = s.clock ∧ OPTREL (λ(p :num) (p' :num). FLOOKUP f p = SOME p') s.global t.global ∧ t.ffi = s.ffi ∧ t.compile_oracle = state_co compile_each s.compile_oracle ∧ s.compile = state_cc compile_each t.compile ∧ code_rel s.code t.code ∧ namespace_rel s.code t.code ∧ (∀(n :num). (let (((next :num),(cfg :α)),(prog :(num # num # bvi$exp) list)) = (s.compile_oracle n :(num # α) # (num # num # bvi$exp) list) in input_condition next prog)) ∧ (∀(n :num). n ∈ (domain t.code :num -> bool) ∧ n MOD bvl_to_bvi_namespaces = (3 :num) ⇒ n < FST (FST (s.compile_oracle (0 :num) :(num # α) # (num # num # bvi$exp) list))) ∧ fmap_inj f
state_rel_filled_typed=∀(f :num |-> num) (s :(num # α, β) state) (s' :(α, β) state) (k :num) (v :v ref). state_rel f s s' ∧ k ∉ FRANGE f ⇒ state_rel f s (s' with refs := s'.refs⟨k ↦ v⟩)
hole_has_val_def_typed=∀(f :num |-> num) (env1 :v list) (env2 :v list) (refs :num |-> v ref) (c :v). hole_has_val f env1 env2 refs c ⇔ LENGTH env2 = LENGTH env1 + (2 :num) ∧ ∃(hole_ptr :num) (tag :num) (finalised :bool) (left :v list) (right :v list). env2❲LENGTH env1❳ = (RefPtr F hole_ptr :v) ∧ env2❲LENGTH env1 + (1 :num)❳ = (Number ((&LENGTH left) :int) :v) ∧ small_enough_int ((&LENGTH left) :int) ∧ hole_ptr ∉ FRANGE f ∧ FLOOKUP refs hole_ptr = SOME (MutBlock tag finalised left c right)
holes_unchanged_except_def_typed=∀(f :α |-> β) (refs :β |-> γ ref) (refs' :β |-> γ ref) (changed :β -> bool). holes_unchanged_except f refs refs' changed ⇔ ∀(ptr :β) (tag :num) (finalised :bool) (left :γ list) (child :γ) (right :γ list). ptr ∉ FRANGE f ∧ FLOOKUP refs ptr = SOME (MutBlock tag finalised left child right) ⇒ ∃(finalised' :bool) (child' :γ). FLOOKUP refs' ptr = SOME (MutBlock tag finalised' left child' right) ∧ (ptr ∉ changed ⇒ child = child')
