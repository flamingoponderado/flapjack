flookup_com_neq_typed=∀(m :α |-> β) (k1 :α) (v1 :β) (k2 :α) (v2 :β). k1 ≠ k2 ⇒ m⟨k1 ↦ v1; k2 ↦ v2⟩ = m⟨k2 ↦ v2; k1 ↦ v1⟩
mb_rel_def_typed=(∀(xs :v list) (tag :num) (refs_old :num |-> v ref) (refs :num |-> v ref) (ptr :num) (f :num |-> num) (b :bool). mb_rel f refs_old refs (Block tag xs) (RefPtr b ptr :v) ⇔ if b ∨ ptr ∈ FRANGE f ∨ ptr ∈ FDOM refs_old then F else case FLOOKUP refs ptr of (NONE :v ref option) => F | SOME (ValueArray v12 :v ref) => F | SOME (ByteArray v13 v14 :v ref) => F | SOME (Thunk v15 v16 :v ref) => F | SOME (MutBlock tag' fin' left' child' right') => tag = tag' ∧ (fin' ⇔ F) ∧ ∃(left :v list) (child :v) (right :v list). xs = left ++ [child] ++ right ∧ LIST_REL (v_rel f) left left' ∧ mb_rel f refs_old (refs \\ ptr) child child' ∧ LIST_REL (v_rel f) right right') ∧ (∀(v2 :v) (v10 :int) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (Number v10 :v) v2 ⇔ v_rel f (Number v10 :v) v2) ∧ (∀(v2 :v) (v11 :word64) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (Word64 v11 :v) v2 ⇔ v_rel f (Word64 v11 :v) v2) ∧ (∀(v29 :int) (v18 :v list) (v17 :num) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (Block v17 v18) (Number v29 :v) ⇔ v_rel f (Block v17 v18) (Number v29 :v)) ∧ (∀(v30 :word64) (v18 :v list) (v17 :num) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (Block v17 v18) (Word64 v30 :v) ⇔ v_rel f (Block v17 v18) (Word64 v30 :v)) ∧ (∀(v32 :v list) (v31 :num) (v18 :v list) (v17 :num) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (Block v17 v18) (Block v31 v32) ⇔ v_rel f (Block v17 v18) (Block v31 v32)) ∧ (∀(v33 :num) (v18 :v list) (v17 :num) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (Block v17 v18) (CodePtr v33) ⇔ v_rel f (Block v17 v18) (CodePtr v33)) ∧ (∀(v2 :v) (v19 :num) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (CodePtr v19) v2 ⇔ v_rel f (CodePtr v19) v2) ∧ ∀(v21 :num) (v20 :bool) (v2 :v) (v0 :num |-> v ref) (refs :num |-> v ref) (f :num |-> num). mb_rel f v0 refs (RefPtr v20 v21 :v) v2 ⇔ v_rel f (RefPtr v20 v21 :v) v2
mb_rel_cons_typed=∀(refs_old :num |-> v ref) (refs :num |-> v ref) (ptr :num) (f :num |-> num) (tag :num) (left :v list) (left' :v list) (v :v) (v' :v) (right :v list) (right' :v list). mb_rel f refs_old (refs \\ ptr) v v' ∧ LIST_REL (v_rel f) left left' ∧ LIST_REL (v_rel f) right right' ∧ FLOOKUP refs ptr = SOME (MutBlock tag F left' v' right') ∧ ptr ∉ FRANGE f ∧ ptr ∉ FDOM refs_old ⇒ mb_rel f refs_old refs (Block tag (left ++ [v] ++ right)) (RefPtr F ptr :v)
