env_c_lemma_typed=((<|v := build_rec_env (q :(mlstring # mlstring # exp) list) (env :v sem_env) (env1 :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> +++ env) :v sem_env).c = env.c
evaluate_lift_start_typed=∀(ds :dec list) (d :dec) (s :α semanticPrimitives$state) (env :v sem_env) (s1 :α semanticPrimitives$state) (env1 :v sem_env) (s2 :α semanticPrimitives$state) (res :(v sem_env, v) result) (ds1 :dec list) (ds2 :dec). evaluate_decs s env (REVERSE ds) = (s1,(Rval env1 :(v sem_env, v) result)) ∧ evaluate_decs s1 ((env1 +++ env) :v sem_env) [d] = (s2,res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ∧ lift_lets ds d = SOME (ds1,ds2) ⇒ evaluate_decs s env [Dlocal ds1 [ds2]] = (s2,res)
lift_lets_mod_local_typed=(∀(ds1 :dec list) (ds2 :dec list). lift_lets ([] :dec list) (Dlocal ds1 ds2) = (NONE :(dec list # dec) option)) ∧ ∀(mn :mlstring) (ds :dec list). lift_lets ([] :dec list) (Dmod mn ds) = (NONE :(dec list # dec) option)
