data_compile_correct_hypotheses=0
data_compile_correct_typed=∀(prog :dataLang$prog) (s :(γ, 'ffi) dataSem$state) (c :data_to_word$config) (n :num) (l :num) (l1 :num) (l2 :num) (res :(v list, v) semanticPrimitives$result option) (s1 :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (locs :(num # num) list). (evaluate (prog,s) :(v list, v) semanticPrimitives$result option # (γ, 'ffi) dataSem$state) = (res,s1) ∧ res ≠ SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) semanticPrimitives$result) ∧ (state_rel c l1 l2 s t (NONE :(v # α word_loc) list option) locs :bool) ∧ t.termdep > (1 :num) ⇒ ∃(t1 :(α, γ, 'ffi) wordSem$state) (res1 :α result option). (evaluate (FST (comp c n l prog :α prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (res1,t1) ∧ option_le t1.stack_max s1.stack_max ∧ (res1 = SOME (NotEnoughSpace :α result) ⇒ t1.ffi.io_events ≼ s1.ffi.io_events ∧ (c.gc_kind ≠ None ⇒ ¬s1.safe_for_space)) ∧ (res1 ≠ SOME (NotEnoughSpace :α result) ⇒ case res of (NONE :(v list, v) semanticPrimitives$result option) => (state_rel c l1 l2 s1 t1 (NONE :(v # α word_loc) list option) locs :bool) ∧ res1 = (NONE :α result option) | SOME (Rval v :(v list, v) semanticPrimitives$result) => ∃(ws :α word_loc list). LENGTH ws = LENGTH v ∧ (state_rel c l1 l2 s1 t1 (SOME (ZIP (v,ws))) locs :bool) ∧ res1 = SOME (Result (Loc l1 l2 :α word_loc) ws :α result) | SOME (Rerr (Rraise v') :(v list, v) semanticPrimitives$result) => t1.ffi = s1.ffi ∧ ∃(w :α word_loc) (l5 :num) (l6 :num) (ll :(num # num) list). res1 = SOME (Exception (mk_loc (jump_exc t :((α, γ, 'ffi) wordSem$state # num # num) option) :α word_loc) w) ∧ ((jump_exc t :((α, γ, 'ffi) wordSem$state # num # num) option) ≠ (NONE :((α, γ, 'ffi) wordSem$state # num # num) option) ⇒ LASTN (LENGTH s1.stack + (1 :num)) locs = (l5,l6)::ll ∧ ∀(i :num). (state_rel c l5 l6 (set_var i v' s1) (set_var (adjust_var i) w t1) (NONE :(v # α word_loc) list option) ll :bool)) | SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) semanticPrimitives$result) => res1 = SOME (TimeOut :α result) ∧ t1.ffi = s1.ffi | SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) semanticPrimitives$result) => res1 = SOME (TimeOut :α result) ∧ t1.ffi = s1.ffi | SOME (Rerr (Rabort (Rffi_error f) :v error_result) :(v list, v) semanticPrimitives$result) => res1 = SOME (FinalFFI f :α result) ∧ t1.ffi = s1.ffi)
