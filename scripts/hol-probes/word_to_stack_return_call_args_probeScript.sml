val stack_move_call_args = prove(``∀n st off i p.
    call_args p 1 2 3 4 0 ⇒
    call_args (stack_move n st off i p) 1 2 3 4 0``, Induct>>rw[stack_move_def,call_args_def]);
val _ = theoremRow "rca_full_stack_move_call_args" stack_move_call_args;
val copy_ret_aux_call_args = prove(``∀k f n.
  call_args (copy_ret_aux k f n) 1 2 3 4 0``, ho_match_mp_tac copy_ret_aux_ind>>
  rw[]>>simp[Once copy_ret_aux_def]>>rw[]>>
  simp[call_args_def,stackLangTheory.list_Seq_def]);
val _ = theoremRow "rca_full_copy_ret_aux_call_args" copy_ret_aux_call_args;
val copy_ret_call_args = prove(``call_args (copy_ret perf b kf vs kont)  1 2 3 4 0 ⇔
  call_args kont 1 2 3 4 0``, PairCases_on`kf`>>rw[copy_ret_def]>>
  simp[call_args_def,SeqStackFree_def,copy_ret_aux_call_args]);
val _ = theoremRow "rca_full_copy_ret_call_args" copy_ret_call_args;
