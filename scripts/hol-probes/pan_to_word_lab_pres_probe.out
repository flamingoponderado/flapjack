pan_to_word_compile_prog_lab_min_typed=(compile_prog (c :architecture) (pprog :α decl list) :(num # num # α wordLang$prog) list) = (wprog :(num # num # α wordLang$prog) list) ⇒ EVERY (λ(prog :num # num # α wordLang$prog). (60 :num) ≤ FST prog) wprog
