loop_to_word_compile_lab_min_typed=(compile (prog :(num # num list # α loopLang$prog) list) :(num # num # α wordLang$prog) list) = (prog' :(num # num # α wordLang$prog) list) ∧ EVERY (λ(p :num # num list # α loopLang$prog). (x :num) ≤ FST p) prog ⇒ EVERY (λ(p :num # num # α wordLang$prog). x ≤ FST p) prog'
pan_to_word_good_handlers_statement=compile_prog c prog = prog' ⇒ EVERY (λ(n,m,pp). word_good_handlers n pp) prog'
pan_to_word_good_handlers_hypotheses=0
pan_to_word_good_handlers_typed=(compile_prog (c :architecture) (prog :α decl list) :(num # num # α wordLang$prog) list) = (prog' :(num # num # α wordLang$prog) list) ⇒ EVERY (λ((n :num),(m :num),(pp :α wordLang$prog)). word_good_handlers n pp) prog'
pan_to_word_compile_lab_pres_statement=compile_prog c prog = prog' ⇒ EVERY (λ(n,m,p). (let labs = extract_labels p in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) labs ∧ ALL_DISTINCT labs)) prog'
