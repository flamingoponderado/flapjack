val abs_stack_empty = prove(``∀bs ls stack lens.
  abs_stack bs [] ls lens = SOME stack ⇒ ls = [Word 0w] ∧ lens = []``,   rpt Cases>>fs[abs_stack_def]);
val _ = (if null(hyp abs_stack_empty) then () else raise Fail "open premise"; print "asl_full_abs_stack_empty="; print_thm abs_stack_empty; print "\n");
val abs_stack_CONS_NIL = prove(``abs_stack bm (x::rest) [] l = NONE``,   Cases_on `l` >> Cases_on `x` >>
  rename1 `StackFrame _ _ handler` >> Cases_on `handler` >>
  rw[abs_stack_def]);
val _ = (if null(hyp abs_stack_CONS_NIL) then () else raise Fail "open premise"; print "asl_full_abs_stack_CONS_NIL="; print_thm abs_stack_CONS_NIL; print "\n");
val abs_stack_LENGTH = prove(``!bitmaps wstack tstack lens astack.
  abs_stack bitmaps wstack tstack lens = SOME astack ==>
  handler_val astack = LENGTH tstack``,  recInduct abs_stack_ind >>
 rw[abs_stack_def,handler_val_def,CaseEq"bool",CaseEq"option",CaseEq"list"] >>
 rw[handler_val_def]);
val _ = (if null(hyp abs_stack_LENGTH) then () else raise Fail "open premise"; print "asl_full_abs_stack_LENGTH="; print_thm abs_stack_LENGTH; print "\n");
val abs_stack_empty' = prove(``abs_stack bs xs [] lens = SOME stack <=> F``,   rw[EQ_IMP_THM] >>
  strip_tac >>
  imp_res_tac abs_stack_LENGTH >>
  Cases_on `stack` >> fs[handler_val_def] >>
  PairCases_on `h` >> Cases_on `h0` >> fs[handler_val_def]);
val _ = (if null(hyp abs_stack_empty') then () else raise Fail "open premise"; print "asl_full_abs_stack_empty_prime="; print_thm abs_stack_empty'; print "\n");
