smd_def=∀(mc_conf :(α, β, γ) machine_config) (p :α word) (code2 :α sec list) (s1_shared_mem_domain :α word -> bool). share_mem_domain_code_rel mc_conf p code2 s1_shared_mem_domain ⇔ (∀(pc :num) (op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num) (i :num). asm_fetch_aux pc code2 = SOME (Asm (ShareMem op re a) inst len) ∧ mmio_pcs_min_index mc_conf.ffi_names = SOME i ⇒ ∃(index :num). i ≤ index ∧ find_index (p + (n2w (pos_val pc (0 :num) code2) :α word)) mc_conf.ffi_entry_pcs (0 :num) = SOME index ∧ (let ((name :shmem_op),(nb :word8)) = get_memop_info op in mc_conf.ffi_names❲index❳ = SharedMem name ∧ ALOOKUP mc_conf.mmio_info index = SOME (nb,a,re,p + (n2w (pos_val pc (0 :num) code2 + len) :α word)))) ∧ (∀(pc :num) (line :α line). asm_fetch_aux pc code2 = SOME line ∧ (∀(op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num). line ≠ Asm (ShareMem op re a) inst len) ⇒ DISJOINT (set mc_conf.ffi_entry_pcs) {p + (n2w a :α word) + (n2w (pos_val pc (0 :num) code2) :α word) | a < LENGTH (line_bytes line)}) ∧ (∀(a :α word). byte_align a ∈ s1_shared_mem_domain ⇒ a ∈ s1_shared_mem_domain) ∧ mc_conf.shared_addresses = s1_shared_mem_domain
smd_nil=share_mem_domain_code_rel mc p [] d ⇔ (∀a. byte_align a ∈ d ⇒ a ∈ d) ∧ mc.shared_addresses = d
smd_univ=∀mc p. mc.shared_addresses = 𝕌(:α word) ⇒ share_mem_domain_code_rel mc p [] 𝕌(:α word)
smd_singleton=∀mc p. ¬share_mem_domain_code_rel mc p [] {8w}
