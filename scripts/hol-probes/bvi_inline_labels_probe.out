list) (ys :bvi$exp list) (arity :num) (body :bvi$exp). LIST_REL (exp_rel' c) xs ys ∧ lookup n c = SOME (arity,body) ∧ LENGTH ys = arity ⇒ exp_rel' c (Call ticks (SOME n) xs (NONE :bvi$exp option) :bvi$exp) (Let ys (bvi_mk_tick (SUC ticks) body) :bvi$exp)) ⇒ ∀(a0 :(num # bvi$exp) sptree$num_map) (a1 :bvi$exp) (a2 :bvi$exp). exp_rel a0 a1 a2 ⇒ exp_rel' a0 a1 a2
inline_all_cache_subspt_typed=∀(prog :(num # num # bvi$exp) list) (cs :(num # bvi$exp) sptree$num_map) (old :(num # bvi$exp) sptree$num_map) (final_cache :(num # bvi$exp) sptree$num_map) (out :(num # num # bvi$exp) list). inline_all cs prog = (final_cache,out) ∧ subspt cs old ∧ DISJOINT (set (MAP (FST :num # num # bvi$exp -> num) prog)) (domain old :num -> bool) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) prog) ⇒ subspt final_cache (union old (fromAList out))
