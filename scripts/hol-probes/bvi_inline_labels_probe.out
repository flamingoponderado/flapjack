MAP_FST_remove_ticks_prog_typed=∀(prog :(α # β # bvi$exp) list). MAP (FST :α # β # bvi$exp -> α) (MAP (λ((name :α),(arity :β),(body :bvi$exp)). (name,arity,remove_ticks_exp body)) prog) = MAP (FST :α # β # bvi$exp -> α) prog
inline_all_def_typed=(∀(cs :(num # bvi$exp) sptree$num_map). inline_all cs ([] :(num # num # bvi$exp) list) = (cs,([] :(num # num # bvi$exp) list))) ∧ ∀(prog :(num # num # bvi$exp) list) (name :num) (cs :(num # bvi$exp) sptree$num_map) (body :bvi$exp) (arity :num). inline_all cs ((name,arity,body)::prog) = (let (body' :bvi$exp) = inline_exp cs body; (cs1 :(num # bvi$exp) sptree$num_map) = if wrapper_ok name arity body' then insert name (arity,body') cs else cs; ((cs2 :(num # bvi$exp) sptree$num_map),(prog2 :(num # num # bvi$exp) list)) = inline_all cs1 prog in (cs2,(name,arity,body')::prog2))
