in_cc_def_typed=∀(cc :α -> (num # num # bvi$exp) list -> (β # γ # δ) option). in_cc cc = (λ((cs :(num # bvi$exp) sptree$num_map),(cfg :α)) (prog :(num # num # bvi$exp) list). (let ((cs1 :(num # bvi$exp) sptree$num_map),(prog1 :(num # num # bvi$exp) list)) = inline_all cs prog in case cc cfg prog1 of (NONE :(β # γ # δ) option) => (NONE :(β # γ # (num # bvi$exp) sptree$num_map # δ) option) | SOME (code,data,cfg1) => SOME (code,data,cs1,cfg1)))
in_co_def_typed=∀(co :α -> ((num # bvi$exp) sptree$num_map # β) # (num # num # bvi$exp) list). in_co co = (λ(n :α). (let (((cs :(num # bvi$exp) sptree$num_map),(cfg :β)),(prog :(num # num # bvi$exp) list)) = co n; ((cs1 :(num # bvi$exp) sptree$num_map),(prog1 :(num # num # bvi$exp) list)) = inline_all cs prog in (cfg,prog1)))
in_cc_eq_state_cc_replay_typed=in_cc (cc :α -> (num # num # bvi$exp) list -> (β # γ # δ) option) = state_cc inline_all cc
in_co_eq_state_co_replay_typed=in_co (co :α -> ((num # bvi$exp) sptree$num_map # β) # (num # num # bvi$exp) list) = state_co inline_all co
state_cc_compile_inc_eq_typed=state_cc compile_inc (cc :α -> (num # num # bvi$exp) list -> (β # γ # δ) option) = state_cc inline_all (remove_ticks_cc cc)
state_co_compile_inc_eq_typed=state_co compile_inc (co :α -> ((num # bvi$exp) sptree$num_map # β) # (num # num # bvi$exp) list) = (remove_ticks_co :β # (num # num # bvi$exp) list -> β # (num # num # bvi$exp) list) ∘ state_co inline_all co
state_cc_compile_inc_eq_replay_typed=state_cc compile_inc (cc :α -> (num # num # bvi$exp) list -> (β # γ # δ) option) = state_cc inline_all (remove_ticks_cc cc)
state_co_compile_inc_eq_replay_typed=state_co compile_inc (co :α -> ((num # bvi$exp) sptree$num_map # β) # (num # num # bvi$exp) list) = (remove_ticks_co :β # (num # num # bvi$exp) list -> β # (num # num # bvi$exp) list) ∘ state_co inline_all co
evaluate_remove_ticks_typed=∀(k :num) (es :bvi$exp list) (env :v list) (t :(γ, 'ffi) state) (s :(γ, 'ffi) state) (res :(v list, exn_or_ret) result) (t1 :(γ, 'ffi) state). remove_state_rel s t ∧ t.clock = k ∧ (evaluate (remove_ticks_exps es,env,t) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,t1) ⇒ ∃(extra :num) (s1 :(γ, 'ffi) state). (evaluate (es,env,s with clock := s.clock + extra) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s1) ∧ remove_state_rel s1 t1
evaluate_remove_ticks_mutual_statement_typed=∀(k :num). (∀(e :bvi$exp) (env :v list) (t :(γ, 'ffi) state) (s :(γ, 'ffi) state) (res :(v list, exn_or_ret) result) (t1 :(γ, 'ffi) state). remove_state_rel s t ∧ t.clock ≤ k ∧ (evaluate ([remove_ticks_exp e],env,t) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,t1) ⇒ ∃(extra :num) (s1 :(γ, 'ffi) state). (evaluate ([e],env,s with clock := s.clock + extra) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s1) ∧ remove_state_rel s1 t1) ∧ ∀(es :bvi$exp list) (env :v list) (t :(γ, 'ffi) state) (s :(γ, 'ffi) state) (res :(v list, exn_or_ret) result) (t1 :(γ, 'ffi) state). remove_state_rel s t ∧ t.clock ≤ k ∧ (evaluate (remove_ticks_exps es,env,t) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,t1) ⇒ ∃(extra :num) (s1 :(γ, 'ffi) state). (evaluate (es,env,s with clock := s.clock + extra) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s1) ∧ remove_state_rel s1 t1
remove_state_rel_do_app_statement_typed=∀(op :closLang$op) (args :v list) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). remove_state_rel s t ⇒ case (do_app op args s :(v # (γ, 'ffi) state, exn_or_ret) result) of (Rval (value,s1) :(v # (γ, 'ffi) state, exn_or_ret) result) => ∃(t1 :(γ, 'ffi) state). (do_app op args t :(v # (γ, 'ffi) state, exn_or_ret) result) = (Rval (value,t1) :(v # (γ, 'ffi) state, exn_or_ret) result) ∧ remove_state_rel s1 t1 | (Rerr err :(v # (γ, 'ffi) state, exn_or_ret) result) => (do_app op args t :(v # (γ, 'ffi) state, exn_or_ret) result) = (Rerr err :(v # (γ, 'ffi) state, exn_or_ret) result)
remove_state_rel_do_install_statement_typed=∀(args :v list) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). remove_state_rel s t ⇒ case (do_install args s :(v # (γ, 'ffi) state, α) result) of (Rval (value,s1) :(v # (γ, 'ffi) state, α) result) => ∃(t1 :(γ, 'ffi) state). (do_install args t :(v # (γ, 'ffi) state, β) result) = (Rval (value,t1) :(v # (γ, 'ffi) state, β) result) ∧ remove_state_rel s1 t1 | (Rerr err :(v # (γ, 'ffi) state, α) result) => (do_install args t :(v # (γ, 'ffi) state, α) result) = (Rerr err :(v # (γ, 'ffi) state, α) result)
clean_prog_CONS_replay_typed=clean_prog ([] :(α # β # bvi$exp) list) = ([] :(α # β # bvi$exp) list) ∧ clean_prog ((p :γ # δ # bvi$exp)::(ps :(γ # δ # bvi$exp) list)) = ((I :γ -> γ) ## (I :δ -> δ) ## remove_ticks_exp) p::clean_prog ps
clean_prog_simps_replay_typed=MAP (FST :num # α # bvi$exp -> num) (clean_prog (prog :(num # α # bvi$exp) list)) = MAP (FST :num # α # bvi$exp -> num) prog ∧ map ((I :α -> α) ## remove_ticks_exp) (fromAList prog) = fromAList (clean_prog prog)
clock_sub_lt_replay_typed=∀(x :num) (k :num). x ≠ (0 :num) ∧ x ≤ k ⇒ x − (1 :num) < k
evaluate_add_extra_clock_replay_typed=∀(xs :bvi$exp list) (env :v list) (s :(γ, 'ffi) state) (res :(v list, exn_or_ret) result) (s1 :(γ, 'ffi) state) (extra :num) (extra' :num). (evaluate (xs,env,s with clock := extra + s.clock) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s1) ∧ res ≠ (Rerr (Rabort Rtimeout_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate (xs,env,s with clock := extra + extra' + s.clock) :(v list, exn_or_ret) result # (γ, 'ffi) state) = (res,s1 with clock := extra' + s1.clock)
remove_state_rel_find_code_eq_replay_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). remove_state_rel s t ⇒ ∀(dest :num option) (vs :v list). (find_code dest vs t.code :(v list # bvi$exp) option) = OPTION_MAP ((I :v list -> v list) ## remove_ticks_exp) (find_code dest vs s.code :(v list # bvi$exp) option)
remove_state_rel_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). remove_state_rel s t ⇔ t.refs = s.refs ∧ t.clock = s.clock ∧ t.global = s.global ∧ t.ffi = s.ffi ∧ t.code = map ((I :num -> num) ## remove_ticks_exp) s.code ∧ t.compile_oracle = (remove_ticks_co :γ # (num # num # bvi$exp) list -> γ # (num # num # bvi$exp) list) ∘ s.compile_oracle ∧ s.compile = remove_ticks_cc t.compile
remove_ticks_exps_NIL_typed=remove_ticks_exps ([] :bvi$exp list) = ([] :bvi$exp list)
evaluate_inline_typed=∀(es :bvi$exp list) (env :v list) (s :((num # bvi$exp) sptree$num_map # α, β) state) (res :(v list, exn_or_ret) result) (s1 :((num # bvi$exp) sptree$num_map # α, β) state) (t :(α, β) state) (es1 :bvi$exp list). in_state_rel s t ∧ LIST_REL (exp_rel t.code) es es1 ∧ (evaluate (es,env,s) :(v list, exn_or_ret) result # ((num # bvi$exp) sptree$num_map # α, β) state) = (res,s1) ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ ∃(t1 :(α, β) state). (evaluate (es1,env,t) :(v list, exn_or_ret) result # (α, β) state) = (res,t1) ∧ in_state_rel s1 t1
evaluate_inlined_call_replay_typed=lookup (n :num) (t :(α, β) state).code = SOME (LENGTH (ys :bvi$exp list),(body :bvi$exp)) ∧ FST (evaluate ([(Call (ticks :num) (SOME n) ys (NONE :bvi$exp option) :bvi$exp)],(env :v list),t) :(v list, exn_or_ret) result # (α, β) state) ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate ([(Let ys (bvi_mk_tick (SUC ticks) body) :bvi$exp)],env,t) :(v list, exn_or_ret) result # (α, β) state) = (evaluate ([(Call ticks (SOME n) ys (NONE :bvi$exp option) :bvi$exp)],env,t) :(v list, exn_or_ret) result # (α, β) state)
exp_rel_inv_replay_typed=(exp_rel (c :(num # bvi$exp) sptree$num_map) (Var (n :num) :bvi$exp) (y :bvi$exp) ⇔ y = (Var n :bvi$exp)) ∧ (exp_rel c (Force (loc :num) n :bvi$exp) y ⇔ y = (Force loc n :bvi$exp)) ∧ (exp_rel c (If (x1 :bvi$exp) (x2 :bvi$exp) (x3 :bvi$exp) :bvi$exp) y ⇔ ∃(y1 :bvi$exp) (y2 :bvi$exp) (y3 :bvi$exp). y = (If y1 y2 y3 :bvi$exp) ∧ exp_rel c x1 y1 ∧ exp_rel c x2 y2 ∧ exp_rel c x3 y3) ∧ (exp_rel c (Let (xs :bvi$exp list) (x :bvi$exp) :bvi$exp) y ⇔ ∃(ys :bvi$exp list) (y1 :bvi$exp). y = (Let ys y1 :bvi$exp) ∧ LIST_REL (exp_rel c) xs ys ∧ exp_rel c x y1) ∧ (exp_rel c (Raise x :bvi$exp) y ⇔ ∃(y1 :bvi$exp). y = (Raise y1 :bvi$exp) ∧ exp_rel c x y1) ∧ (exp_rel c (Tick x :bvi$exp) y ⇔ ∃(y1 :bvi$exp). y = (Tick y1 :bvi$exp) ∧ exp_rel c x y1) ∧ (exp_rel c (Op (op :closLang$op) xs :bvi$exp) y ⇔ ∃(ys :bvi$exp list). y = (Op op ys :bvi$exp) ∧ LIST_REL (exp_rel c) xs ys) ∧ (exp_rel c (Return xs) y ⇔ ∃(ys :bvi$exp list). y = Return ys ∧ LIST_REL (exp_rel c) xs ys) ∧ (exp_rel c (LetCall (rets :num) (ticks :num) (target :num) xs x) y ⇔ ∃(ys :bvi$exp list) (y1 :bvi$exp). y = LetCall rets ticks target ys y1 ∧ LIST_REL (exp_rel c) xs ys ∧ exp_rel c x y1) ∧ (exp_rel c (Call ticks (dest :num option) xs (handler :bvi$exp option) :bvi$exp) y ⇔ (∃(ys :bvi$exp list) (handler1 :bvi$exp option). y = (Call ticks dest ys handler1 :bvi$exp) ∧ LIST_REL (exp_rel c) xs ys ∧ OPTREL (exp_rel c) handler handler1) ∨ ∃(n :num) (ys :bvi$exp list) (arity :num) (body :bvi$exp). dest = SOME n ∧ handler = (NONE :bvi$exp option) ∧ y = (Let ys (bvi_mk_tick (SUC ticks) body) :bvi$exp) ∧ LIST_REL (exp_rel c) xs ys ∧ lookup n c = SOME (arity,body) ∧ LENGTH ys = arity)
in_do_app_lemma_statement_typed=in_state_rel (s1 :((num # bvi$exp) sptree$num_map # α, β) state) (t1 :(α, β) state) ⇒ case (do_app (op :closLang$op) (a :v list) s1 :(v # ((num # bvi$exp) sptree$num_map # α, β) state, exn_or_ret) result) of (Rval (v,s2) :(v # ((num # bvi$exp) sptree$num_map # α, β) state, exn_or_ret) result) => ∃(t2 :(α, β) state). in_state_rel s2 t2 ∧ (do_app op a t1 :(v # (α, β) state, exn_or_ret) result) = (Rval (v,t2) :(v # (α, β) state, exn_or_ret) result) | (Rerr err :(v # ((num # bvi$exp) sptree$num_map # α, β) state, exn_or_ret) result) => err ≠ (Rabort Rtype_error :exn_or_ret error_result) ⇒ (do_app op a t1 :(v # (α, β) state, exn_or_ret) result) = (Rerr err :(v # (α, β) state, exn_or_ret) result)
in_state_rel_do_install_statement_typed=in_state_rel (s1 :((num # bvi$exp) sptree$num_map # α, β) state) (t1 :(α, β) state) ⇒ case (do_install (a :v list) s1 :(v # ((num # bvi$exp) sptree$num_map # α, β) state, γ) result) of (Rval (v,s2) :(v # ((num # bvi$exp) sptree$num_map # α, β) state, γ) result) => ∃(t2 :(α, β) state). in_state_rel s2 t2 ∧ (do_install a t1 :(v # (α, β) state, δ) result) = (Rval (v,t2) :(v # (α, β) state, δ) result) | (Rerr err :(v # ((num # bvi$exp) sptree$num_map # α, β) state, γ) result) => err ≠ (Rabort Rtype_error :γ error_result) ⇒ (do_install a t1 :(v # (α, β) state, γ) result) = (Rerr err :(v # (α, β) state, γ) result)
do_install_Rerr_type_replay_typed=∀(args :v list) (s :(γ, 'ffi) state) (error :α error_result). (do_install args s :(v # (γ, 'ffi) state, α) result) = (Rerr error :(v # (γ, 'ffi) state, α) result) ⇒ error = (Rabort Rtype_error :α error_result)
inline_all_lookup_union_statement_typed=inline_all (cs :(num # bvi$exp) sptree$num_map) (prog :(num # num # bvi$exp) list) = ((final_cache :(num # bvi$exp) sptree$num_map),(out :(num # num # bvi$exp) list)) ∧ subspt cs (target :(num # bvi$exp) sptree$num_map) ∧ (domain target :num -> bool) = (domain (source :(num # bvi$exp) sptree$num_map) :num -> bool) ∧ (∀(k :num) (arity :num) (exp :bvi$exp). lookup k source = SOME (arity,exp) ⇒ ∃(exp1 :bvi$exp). lookup k target = SOME (arity,exp1) ∧ exp_rel target exp exp1) ∧ DISJOINT (set (MAP (FST :num # num # bvi$exp -> num) prog)) (domain target :num -> bool) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) prog) ⇒ ∀(k :num) (arity :num) (exp :bvi$exp). lookup k (union source (fromAList prog)) = SOME (arity,exp) ⇒ ∃(exp1 :bvi$exp). lookup k (union target (fromAList out)) = SOME (arity,exp1) ∧ exp_rel (union target (fromAList out)) exp exp1
inline_all_head_names_replay_typed=inline_all (cs :(num # bvi$exp) sptree$num_map) (((name :num),(arity :num),(body :bvi$exp))::(rest :(num # num # bvi$exp) list)) = ((final_cache :(num # bvi$exp) sptree$num_map),(out :(num # num # bvi$exp) list)) ⇒ ∃(tail :(num # num # bvi$exp) list). out = (name,arity,inline_exp cs body)::tail ∧ MAP (FST :num # num # bvi$exp -> num) tail = MAP (FST :num # num # bvi$exp -> num) rest
do_app_state_swap_Rerr_statement_typed=∀(op :closLang$op) (args :v list) (s :(γ, 'ffi) state) (t :(δ, 'ffi) state) (error :exn_or_ret error_result). op ≠ Install ∧ (do_app op args s :(v # (γ, 'ffi) state, exn_or_ret) result) = (Rerr error :(v # (γ, 'ffi) state, exn_or_ret) result) ∧ ((domain t.code :num -> bool) ⊆ (domain s.code :num -> bool) ∨ error ≠ (Rabort Rtype_error :exn_or_ret error_result)) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (δ, 'ffi) state, exn_or_ret) result) = (Rerr error :(v # (δ, 'ffi) state, exn_or_ret) result)
do_app_state_swap_Rval_statement_typed=∀(op :closLang$op) (args :v list) (s :(γ, 'ffi) state) (source_state :(γ, 'ffi) state) (t :(δ, 'ffi) state) (value :v). op ≠ Install ∧ (do_app op args s :(v # (γ, 'ffi) state, exn_or_ret) result) = (Rval (value,source_state) :(v # (γ, 'ffi) state, exn_or_ret) result) ∧ (domain s.code :num -> bool) ⊆ (domain t.code :num -> bool) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (δ, 'ffi) state, exn_or_ret) result) = (Rval (value,t with <|refs := source_state.refs; clock := source_state.clock; global := source_state.global; ffi := source_state.ffi|>) :(v # (δ, 'ffi) state, exn_or_ret) result)
do_app_state_swap_statement_typed=(op :closLang$op) ≠ Install ⇒ ((do_app op (args :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((value :v),(s1 :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) ∧ (domain s.code :num -> bool) ⊆ (domain (t :(γ, δ) state).code :num -> bool) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (γ, β) state, exn_or_ret) result) = (Rval (value,t with <|refs := s1.refs; clock := s1.clock; global := s1.global; ffi := s1.ffi|>) :(v # (γ, β) state, exn_or_ret) result)) ∧ ((do_app op args s :(v # (α, β) state, exn_or_ret) result) = (Rerr (error :exn_or_ret error_result) :(v # (α, β) state, exn_or_ret) result) ∧ ((domain t.code :num -> bool) ⊆ (domain s.code :num -> bool) ∨ error ≠ (Rabort Rtype_error :exn_or_ret error_result)) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (γ, β) state, exn_or_ret) result) = (Rerr error :(v # (γ, β) state, exn_or_ret) result))
inline_all_ALOOKUP_typed=∀(prog :(num # num # bvi$exp) list) (cs :(num # bvi$exp) sptree$num_map) (old_target :(num # bvi$exp) sptree$num_map) (final_cache :(num # bvi$exp) sptree$num_map) (out :(num # num # bvi$exp) list) (k :num) (wanted_arity :num) (wanted_body :bvi$exp). inline_all cs prog = (final_cache,out) ∧ subspt cs old_target ∧ DISJOINT (set (MAP (FST :num # num # bvi$exp -> num) prog)) (domain old_target :num -> bool) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) prog) ∧ ALOOKUP prog k = SOME (wanted_arity,wanted_body) ⇒ ∃(body1 :bvi$exp). ALOOKUP out k = SOME (wanted_arity,body1) ∧ exp_rel (union old_target (fromAList out)) wanted_body body1
in_state_rel_find_code_replay_typed=∀(s :((num # bvi$exp) sptree$num_map # α, β) state) (t :(α, β) state) (dest :num option) (vs :v list) (args :v list) (exp :bvi$exp). in_state_rel s t ∧ (find_code dest vs s.code :(v list # bvi$exp) option) = SOME (args,exp) ⇒ ∃(exp1 :bvi$exp). (find_code dest vs t.code :(v list # bvi$exp) option) = SOME (args,exp1) ∧ exp_rel t.code exp exp1
in_state_rel_def_typed=∀(s :((num # bvi$exp) sptree$num_map # γ, 'ffi) state) (t :(γ, 'ffi) state). in_state_rel s t ⇔ t.refs = s.refs ∧ t.clock = s.clock ∧ t.global = s.global ∧ t.ffi = s.ffi ∧ t.compile_oracle = in_co s.compile_oracle ∧ subspt (FST (FST (s.compile_oracle (0 :num) :((num # bvi$exp) sptree$num_map # γ) # (num # num # bvi$exp) list))) t.code ∧ s.compile = in_cc t.compile ∧ (domain t.code :num -> bool) = (domain s.code :num -> bool) ∧ ∀(k :num) (arity :num) (exp :bvi$exp). lookup k s.code = SOME (arity,exp) ⇒ ∃(exp1 :bvi$exp). lookup k t.code = SOME (arity,exp1) ∧ exp_rel t.code exp exp1
evaluate_expand_env_typed=∀(xs :bvi$exp list) (a :v list) (s :(α, β) state) (env :v list). FST (evaluate (xs,a,s) :(v list, exn_or_ret) result # (α, β) state) ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate (xs,a ++ env,s) :(v list, exn_or_ret) result # (α, β) state) = (evaluate (xs,a,s) :(v list, exn_or_ret) result # (α, β) state)
evaluate_bvi_mk_tick_typed=∀(exp :bvi$exp) (env :v list) (s :(α, β) state) (n :num). (evaluate ([bvi_mk_tick n exp],env,s) :(v list, exn_or_ret) result # (α, β) state) = if s.clock < n then ((Rerr (Rabort Rtimeout_error :exn_or_ret error_result) :(v list, exn_or_ret) result),s with clock := (0 :num)) else (evaluate ([exp],env,dec_clock n s) :(v list, exn_or_ret) result # (α, β) state)
inline_exp_rel_typed=subspt (cs :(num # bvi$exp) sptree$num_map) (c :(num # bvi$exp) sptree$num_map) ⇒ (∀(e :bvi$exp). exp_rel c e (inline_exp cs e)) ∧ ∀(es :bvi$exp list). LIST_REL (exp_rel c) es (inline_exps cs es)
inline_call_none_exp_rel_typed=subspt (cs :(num # bvi$exp) sptree$num_map) (c :(num # bvi$exp) sptree$num_map) ∧ LIST_REL (exp_rel c) (es :bvi$exp list) (inline_exps cs es) ⇒ exp_rel c (Call (ticks :num) (dest :num option) es (NONE :bvi$exp option) :bvi$exp) (inline_exp cs (Call ticks dest es (NONE :bvi$exp option) :bvi$exp))
exp_rel_refl_typed=∀(c :(num # bvi$exp) sptree$num_map) (x :bvi$exp). exp_rel c x x
exp_rel_evaluate_mono_replay_typed=((evaluate ((es :bvi$exp list),(env :v list),(t :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = ((res :(v list, exn_or_ret) result),(t1 :(α, β) state)) ∧ exp_rel t.code (x :bvi$exp) (y :bvi$exp) ⇒ exp_rel t1.code x y) ∧ ((evaluate (es,env,t) :(v list, exn_or_ret) result # (α, β) state) = (res,t1) ∧ LIST_REL (exp_rel t.code) (xs :bvi$exp list) (ys :bvi$exp list) ⇒ LIST_REL (exp_rel t1.code) xs ys)
exp_rel_mono_typed=∀(c :(num # bvi$exp) sptree$num_map) (x :bvi$exp) (y :bvi$exp). exp_rel c x y ⇒ ∀(c1 :(num # bvi$exp) sptree$num_map). subspt c c1 ⇒ exp_rel c1 x y
