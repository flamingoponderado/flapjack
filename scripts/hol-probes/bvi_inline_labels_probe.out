exp_rel_rules_typed=(∀(c :(num # bvi$exp) sptree$num_map) (n :num). exp_rel c (Var n :bvi$exp) (Var n :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (loc :num) (n :num). exp_rel c (Force loc n :bvi$exp) (Force loc n :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (x1 :bvi$exp) (x2 :bvi$exp) (x3 :bvi$exp) (y1 :bvi$exp) (y2 :bvi$exp) (y3 :bvi$exp). exp_rel c x1 y1 ∧ exp_rel c x2 y2 ∧ exp_rel c x3 y3 ⇒ exp_rel c (If x1 x2 x3 :bvi$exp) (If y1 y2 y3 :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (xs :bvi$exp list) (ys :bvi$exp list) (x :bvi$exp) (y :bvi$exp). LIST_REL (exp_rel c) xs ys ∧ exp_rel c x y ⇒ exp_rel c (Let xs x :bvi$exp) (Let ys y :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (x :bvi$exp) (y :bvi$exp). exp_rel c x y ⇒ exp_rel c (Raise x :bvi$exp) (Raise y :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (x :bvi$exp) (y :bvi$exp). exp_rel c x y ⇒ exp_rel c (Tick x :bvi$exp) (Tick y :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (op :closLang$op) (xs :bvi$exp list) (ys :bvi$exp list). LIST_REL (exp_rel c) xs ys ⇒ exp_rel c (Op op xs :bvi$exp) (Op op ys :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (ticks :num) (dest :num option) (xs :bvi$exp list) (ys :bvi$exp list) (handler :bvi$exp option) (handler1 :bvi$exp option). LIST_REL (exp_rel c) xs ys ∧ OPTREL (exp_rel c) handler handler1 ⇒ exp_rel c (Call ticks dest xs handler :bvi$exp) (Call ticks dest ys handler1 :bvi$exp)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (rets :num) (ticks :num) (dest :num) (xs :bvi$exp list) (ys :bvi$exp list) (x :bvi$exp) (y :bvi$exp). LIST_REL (exp_rel c) xs ys ∧ exp_rel c x y ⇒ exp_rel c (LetCall rets ticks dest xs x) (LetCall rets ticks dest ys y)) ∧ (∀(c :(num # bvi$exp) sptree$num_map) (xs :bvi$exp list) (ys :bvi$exp list). LIST_REL (exp_rel c) xs ys ⇒ exp_rel c (Return xs) (Return ys)) ∧ ∀(c :(num # bvi$exp) sptree$num_map) (ticks :num) (n :num) (xs :bvi$exp list) (ys :bvi$exp list) (arity :num) (body :bvi$exp). LIST_REL (exp_rel c) xs ys ∧ lookup n c = SOME (arity,body) ∧ LENGTH ys = arity ⇒ exp_rel c (Call ticks (SOME n) xs (NONE :bvi$exp option) :bvi$exp) (Let ys (bvi_mk_tick (SUC ticks) body) :bvi$exp)
exp_rel_cases_typed=∀(a0 :(num # bvi$exp) sptree$num_map) (a1 :bvi$exp) (a2 :bvi$exp). exp_rel a0 a1 a2 ⇔ (∃(n :num). a1 = (Var n :bvi$exp) ∧ a2 = (Var n :bvi$exp)) ∨ (∃(loc :num) (n :num). a1 = (Force loc n :bvi$exp) ∧ a2 = (Force loc n :bvi$exp)) ∨ (∃(x1 :bvi$exp) (x2 :bvi$exp) (x3 :bvi$exp) (y1 :bvi$exp) (y2 :bvi$exp) (y3 :bvi$exp). a1 = (If x1 x2 x3 :bvi$exp) ∧ a2 = (If y1 y2 y3 :bvi$exp) ∧ exp_rel a0 x1 y1 ∧ exp_rel a0 x2 y2 ∧ exp_rel a0 x3 y3) ∨ (∃(xs :bvi$exp list) (ys :bvi$exp list) (x :bvi$exp) (y :bvi$exp). a1 = (Let xs x :bvi$exp) ∧ a2 = (Let ys y :bvi$exp) ∧ LIST_REL (exp_rel a0) xs ys ∧ exp_rel a0 x y) ∨ (∃(x :bvi$exp) (y :bvi$exp). a1 = (Raise x :bvi$exp) ∧ a2 = (Raise y :bvi$exp) ∧ exp_rel a0 x y) ∨ (∃(x :bvi$exp) (y :bvi$exp). a1 = (Tick x :bvi$exp) ∧ a2 = (Tick y :bvi$exp) ∧ exp_rel a0 x y) ∨ (∃(op :closLang$op) (xs :bvi$exp list) (ys :bvi$exp list). a1 = (Op op xs :bvi$exp) ∧ a2 = (Op op ys :bvi$exp) ∧ LIST_REL (exp_rel a0) xs ys) ∨ (∃(ticks :num) (dest :num option) (xs :bvi$exp list) (ys :bvi$exp list) (handler :bvi$exp option) (handler1 :bvi$exp option). a1 = (Call ticks dest xs handler :bvi$exp) ∧ a2 = (Call ticks dest ys handler1 :bvi$exp) ∧ LIST_REL (exp_rel a0) xs ys ∧ OPTREL (exp_rel a0) handler handler1) ∨ (∃(rets :num) (ticks :num) (dest :num) (xs :bvi$exp list) (ys :bvi$exp list) (x :bvi$exp) (y :bvi$exp). a1 = LetCall rets ticks dest xs x ∧ a2 = LetCall rets ticks dest ys y ∧ LIST_REL (exp_rel a0) xs ys ∧ exp_rel a0 x y) ∨ (∃(xs :bvi$exp list) (ys :bvi$exp list). a1 = Return xs ∧ a2 = Return ys ∧ LIST_REL (exp_rel a0) xs ys) ∨ ∃(ticks :num) (n :num) (xs :bvi$exp list) (ys :bvi$exp list) (arity :num) (body :bvi$exp). a1 = (Call ticks (SOME n) xs (NONE :bvi$exp option) :bvi$exp) ∧ a2 = (Let ys (bvi_mk_tick (SUC ticks) body) :bvi$exp) ∧ LIST_REL (exp_rel a0) xs ys ∧ lookup n a0 = SOME (arity,body) ∧ LENGTH ys = arity
