inline_exp_def_typed=(∀(n :num) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Var n :bvi$exp) = (Var n :bvi$exp)) ∧ (∀(z :bvi$exp) (y :bvi$exp) (x :bvi$exp) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (If x y z :bvi$exp) = (If (inline_exp cs x) (inline_exp cs y) (inline_exp cs z) :bvi$exp)) ∧ (∀(y :bvi$exp) (xs :bvi$exp list) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Let xs y :bvi$exp) = (Let (inline_exps cs xs) (inline_exp cs y) :bvi$exp)) ∧ (∀(x :bvi$exp) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Raise x :bvi$exp) = (Raise (inline_exp cs x) :bvi$exp)) ∧ (∀(x :bvi$exp) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Tick x :bvi$exp) = (Tick (inline_exp cs x) :bvi$exp)) ∧ (∀(xs :bvi$exp list) (ticks :num) (handler :bvi$exp option) (dest :num option) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Call ticks dest xs handler :bvi$exp) = (let (xs' :bvi$exp list) = inline_exps cs xs in case handler of (NONE :bvi$exp option) => (case dest of (NONE :num option) => (Call ticks (NONE :num option) xs' (NONE :bvi$exp option) :bvi$exp) | SOME name => case lookup name cs of (NONE :(num # bvi$exp) option) => (Call ticks (SOME name) xs' (NONE :bvi$exp option) :bvi$exp) | SOME (arity,body) => if LENGTH xs' = arity then (Let xs' (bvi_mk_tick (SUC ticks) body) :bvi$exp) else (Call ticks (SOME name) xs' (NONE :bvi$exp option) :bvi$exp)) | SOME h => (Call ticks dest xs' (SOME (inline_exp cs h)) :bvi$exp))) ∧ (∀(n :num) (loc :num) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Force loc n :bvi$exp) = (Force loc n :bvi$exp)) ∧ (∀(xs :bvi$exp list) (op :closLang$op) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Op op xs :bvi$exp) = (Op op (inline_exps cs xs) :bvi$exp)) ∧ (∀(y :bvi$exp) (xs :bvi$exp list) (ticks :num) (rets :num) (dest :num) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (LetCall rets ticks dest xs y) = LetCall rets ticks dest (inline_exps cs xs) (inline_exp cs y)) ∧ (∀(xs :bvi$exp list) (cs :(num # bvi$exp) sptree$num_map). inline_exp cs (Return xs) = Return (inline_exps cs xs)) ∧ (∀(cs :(num # bvi$exp) sptree$num_map). inline_exps cs ([] :bvi$exp list) = ([] :bvi$exp list)) ∧ ∀(xs :bvi$exp list) (x :bvi$exp) (cs :(num # bvi$exp) sptree$num_map). inline_exps cs (x::xs) = inline_exp cs x::inline_exps cs xs
