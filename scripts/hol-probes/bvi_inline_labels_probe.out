remove_ticks_exp_def_typed=(∀(n :num). remove_ticks_exp (Var n :bvi$exp) = (Var n :bvi$exp)) ∧ (∀(z :bvi$exp) (y :bvi$exp) (x :bvi$exp). remove_ticks_exp (If x y z :bvi$exp) = (If (remove_ticks_exp x) (remove_ticks_exp y) (remove_ticks_exp z) :bvi$exp)) ∧ (∀(y :bvi$exp) (xs :bvi$exp list). remove_ticks_exp (Let xs y :bvi$exp) = (Let (remove_ticks_exps xs) (remove_ticks_exp y) :bvi$exp)) ∧ (∀(x :bvi$exp). remove_ticks_exp (Raise x :bvi$exp) = (Raise (remove_ticks_exp x) :bvi$exp)) ∧ (∀(x :bvi$exp). remove_ticks_exp (Tick x :bvi$exp) = remove_ticks_exp x) ∧ (∀(xs :bvi$exp list) (ticks :num) (handler :bvi$exp option) (dest :num option). remove_ticks_exp (Call ticks dest xs handler :bvi$exp) = (Call (0 :num) dest (remove_ticks_exps xs) (OPTION_MAP (λ(a :bvi$exp). remove_ticks_exp a) handler) :bvi$exp)) ∧ (∀(n :num) (loc :num). remove_ticks_exp (Force loc n :bvi$exp) = (Force loc n :bvi$exp)) ∧ (∀(xs :bvi$exp list) (op :closLang$op). remove_ticks_exp (Op op xs :bvi$exp) = (Op op (remove_ticks_exps xs) :bvi$exp)) ∧ (∀(y :bvi$exp) (xs :bvi$exp list) (ticks :num) (rets :num) (dest :num). remove_ticks_exp (LetCall rets ticks dest xs y) = LetCall rets (0 :num) dest (remove_ticks_exps xs) (remove_ticks_exp y)) ∧ (∀(xs :bvi$exp list). remove_ticks_exp (Return xs) = Return (remove_ticks_exps xs)) ∧ remove_ticks_exps ([] :bvi$exp list) = ([] :bvi$exp list) ∧ ∀(xs :bvi$exp list) (x :bvi$exp). remove_ticks_exps (x::xs) = remove_ticks_exp x::remove_ticks_exps xs
remove_ticks_get_code_labels_typed=(∀(e :bvi$exp). get_code_labels (remove_ticks_exp e) = get_code_labels e) ∧ ∀(es :bvi$exp list). BIGUNION (set (MAP get_code_labels (remove_ticks_exps es))) = BIGUNION (set (MAP get_code_labels es))
