compile_inc_code_labels_typed=(compile_inc (cs :(num # bvi$exp) sptree$num_map) (prog :(num # num # bvi$exp) list) :(num # bvi$exp) sptree$num_map # (num # num # bvi$exp) list) = ((cs1 :(num # bvi$exp) sptree$num_map),(prog1 :(num # num # bvi$exp) list)) ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog1)) = BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) (SND (inline_all cs prog))))
