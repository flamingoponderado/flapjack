lus_full_DROP_DROP_EQ=⊢ ∀n m xs. DROP m (DROP n xs) = DROP (m + n) xs
lus_full_TAKE_TAKE_MIN=⊢ ∀xs m n. TAKE n (TAKE m xs) = TAKE (MIN m n) xs
lus_full_TAKE_DROP_EQ=⊢ ∀xs n m. TAKE m (DROP n xs) = DROP n (TAKE (m + n) xs)
lus_full_DROP_TAKE_NIL=⊢ ∀xs n. DROP n (TAKE n xs) = []
lus_full_TAKE_LUPDATE=⊢ ∀xs n x i. TAKE n xs❲i ↦ x❳ = (TAKE n xs)❲i ↦ x❳
lus_full_DROP_LUPDATE_lemma1=⊢ ∀xs n m h. n ≤ m ⇒ DROP n xs❲m ↦ h❳ = (DROP n xs)❲m − n ↦ h❳
lus_full_DROP_LUPDATE_lemma2=⊢ ∀xs n m h. m < n ⇒ DROP n xs❲m ↦ h❳ = DROP n xs
lus_full_DROP_LUPDATE=⊢ ∀n h m xs. DROP n xs❲m ↦ h❳ = if m < n then DROP n xs else (DROP n xs)❲m − n ↦ h❳
lus_full_MIN_ADD=⊢ ∀n m2 m1. MIN m1 m2 + n = MIN (m1 + n) (m2 + n)
