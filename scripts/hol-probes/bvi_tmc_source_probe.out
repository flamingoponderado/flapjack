update_cons_def_typed=∀(exp_ptr :exp) (exp_idx :exp) (exp_val :exp). update_cons exp_ptr exp_idx exp_val = (Op (MemOp UpdateCons) [exp_val; exp_idx; exp_ptr] :exp)
cb_size_def_typed=(∀(x :call_block) (v2 :num list) (v1 :num list) (v0 :num). cb_size (CallBlock v0 v1 x v2) = cb_size x + (1 :num)) ∧ ∀(v8 :num list) (v7 :num). cb_size (RCall v7 v8) = (0 :num)
cb_to_bvi_worker_aux_def_typed=(∀(ptr :num) (loc_opt :num) (idx :num) (call_ts :num) (call_args :num list). cb_to_bvi_worker_aux (RCall call_ts call_args) loc_opt ptr idx = optimise_call call_ts loc_opt call_args (Var ptr :exp) (Op (IntOp (Const ((&idx) :int))) ([] :exp list) :exp)) ∧ ∀(tag :num) (right :num list) (ptr :num) (loc_opt :num) (left :num list) (idx :num) (child :call_block). cb_to_bvi_worker_aux (CallBlock tag left child right) loc_opt ptr idx = (Let [mut_cons tag left right] (Let [update_cons (Var (ptr + (1 :num)) :exp) (Op (IntOp (Const ((&idx) :int))) ([] :exp list) :exp) (Var (0 :num) :exp)] (cb_to_bvi_worker_aux (shift_cb (2 :num) child) loc_opt (1 :num) (LENGTH right)) :exp) :exp)
cb_to_bvi_worker_aux_alt_def_typed=(∀(sh :num) (call_ts :num) (call_args :num list) (loc_opt :num) (ptr :num) (idx :num). cb_to_bvi_worker_aux_alt sh (RCall call_ts call_args) loc_opt ptr idx = optimise_call call_ts loc_opt (shift_vars sh call_args) (Var ptr :exp) (Op (IntOp (Const ((&idx) :int))) ([] :exp list) :exp)) ∧ ∀(sh :num) (tag :num) (left :num list) (child :call_block) (right :num list) (loc_opt :num) (ptr :num) (idx :num). cb_to_bvi_worker_aux_alt sh (CallBlock tag left child right) loc_opt ptr idx = (Let [mut_cons tag (shift_vars sh left) (shift_vars sh right)] (Let [update_cons (Var (ptr + (1 :num)) :exp) (Op (IntOp (Const ((&idx) :int))) ([] :exp list) :exp) (Var (0 :num) :exp)] (cb_to_bvi_worker_aux_alt (sh + (2 :num)) child loc_opt (1 :num) (LENGTH right)) :exp) :exp)
cb_to_bvi_worker_aux_alt_thm_typed=∀(cb :call_block) (sh :num) (loc_opt :num) (ptr :num) (idx :num). cb_to_bvi_worker_aux_alt sh cb loc_opt ptr idx = cb_to_bvi_worker_aux (shift_cb sh cb) loc_opt ptr idx
cb_to_bvi_worker_def_typed=(∀(call_ts :num) (call_args :num list) (loc_opt :num) (ptr :num) (idx :num). cb_to_bvi_worker (RCall call_ts call_args) loc_opt ptr idx = optimise_call call_ts loc_opt call_args (Var ptr :exp) (Var idx :exp)) ∧ ∀(tag :num) (left :num list) (child :call_block) (right :num list) (loc_opt :num) (ptr :num) (idx :num). cb_to_bvi_worker (CallBlock tag left child right) loc_opt ptr idx = (Let [mut_cons tag left right] (Let [update_cons (Var (ptr + (1 :num)) :exp) (Var (idx + (1 :num)) :exp) (Var (0 :num) :exp)] (cb_to_bvi_worker_aux (shift_cb (2 :num) child) loc_opt (1 :num) (LENGTH right)) :exp) :exp)
cb_to_bvi_wrapper_def_typed=∀(tag :num) (left :num list) (child :call_block) (right :num list) (loc_opt :num). cb_to_bvi_wrapper tag left child right loc_opt = (Let [mut_cons tag left right] (Let [cb_to_bvi_worker_aux (shift_cb (1 :num) child) loc_opt (0 :num) (LENGTH right)] (finalise_cons (1 :num)) :exp) :exp)
rewrite_wrapper_def_typed=(∀(v0 :num) (n :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt v0 (Var n :exp) = (NONE :exp option)) ∧ (∀(xt :exp) (xi :exp) (xe :exp) (n :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt n (If xi xt xe :exp) = (let (opt_t :exp option) = rewrite_wrapper loc loc_opt n xt; (opt_e :exp option) = rewrite_wrapper loc loc_opt n xe in case (opt_t,opt_e) of ((NONE :exp option),(NONE :exp option)) => (NONE :exp option) | ((NONE :exp option),SOME ye) => SOME (If xi xt ye :exp) | (SOME yt,(NONE :exp option)) => SOME (If xi yt xe :exp) | (SOME yt,SOME ye') => SOME (If xi yt ye' :exp))) ∧ (∀(xs :exp list) (x :exp) (n :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt n (Let xs x :exp) = case rewrite_wrapper loc loc_opt (n + LENGTH xs) x of (NONE :exp option) => (NONE :exp option) | SOME y => SOME (Let xs y :exp)) ∧ (∀(x :exp) (v1 :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt v1 (Raise x :exp) = (NONE :exp option)) ∧ (∀(x :exp) (n :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt n (Tick x :exp) = OPTION_MAP Tick (rewrite_wrapper loc loc_opt n x)) ∧ (∀(v3 :num) (v2 :num) (n :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt v2 (Force v3 n :exp) = (NONE :exp option)) ∧ (∀(v4 :num) (t :num) (loc_opt :num) (loc :num) (h :exp option) (d :num option) (args :exp list). rewrite_wrapper loc loc_opt v4 (Call t d args h :exp) = (NONE :exp option)) ∧ (∀(op_args :exp list) (op :op) (n :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt n (Op op op_args :exp) = case bvi_to_cb n loc (Op op op_args :exp) of (NONE :(exp list # call_block) option) => (NONE :exp option) | SOME (bs,CallBlock tag left child right) => SOME (Let bs (cb_to_bvi_wrapper tag left child right loc_opt) :exp) | SOME (bs,RCall v16 v17) => (NONE :exp option)) ∧ (∀(v5 :num) (v35 :exp) (v34 :exp list) (v33 :num) (v32 :num) (v31 :num) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt v5 (LetCall v31 v32 v33 v34 v35) = (NONE :exp option)) ∧ ∀(v5 :num) (v36 :exp list) (loc_opt :num) (loc :num). rewrite_wrapper loc loc_opt v5 (Return v36) = (NONE :exp option)
rewrite_worker_def_typed=(∀(xt :exp) (xi :exp) (xe :exp) (n :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx n (If xi xt xe :exp) = (let (yt :exp) = rewrite_worker loc loc_opt i_old_ptr i_old_idx n xt; (ye :exp) = rewrite_worker loc loc_opt i_old_ptr i_old_idx n xe in (If xi yt ye :exp))) ∧ (∀(xs :exp list) (x :exp) (n :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx n (Let xs x :exp) = (let (offset :num) = LENGTH xs in (Let xs (rewrite_worker loc loc_opt (i_old_ptr + offset) (i_old_idx + offset) (n + offset) x) :exp))) ∧ (∀(x :exp) (v0 :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx v0 (Raise x :exp) = (Raise x :exp)) ∧ (∀(op_args :exp list) (op :op) (n :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx n (Op op op_args :exp) = case bvi_to_cb n loc (Op op op_args :exp) of (NONE :(exp list # call_block) option) => fill_hole i_old_ptr i_old_idx (Op op op_args :exp) | SOME (bs,cb) => (let (offset :num) = LENGTH bs in (Let bs (cb_to_bvi_worker cb loc_opt (offset + i_old_ptr) (offset + i_old_idx)) :exp))) ∧ (∀(x :exp) (n :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx n (Tick x :exp) = (Tick (rewrite_worker loc loc_opt i_old_ptr i_old_idx n x) :exp)) ∧ (∀(ts :num) (n :num) (loc_opt :num) (loc :num) (l :num option) (i_old_ptr :num) (i_old_idx :num) (h :exp option) (args :exp list). rewrite_worker loc loc_opt i_old_ptr i_old_idx n (Call ts l args h :exp) = case bvi_to_cb n loc (Call ts l args h :exp) of (NONE :(exp list # call_block) option) => fill_hole i_old_ptr i_old_idx (Call ts l args h :exp) | SOME (bs,cb) => (let (offset :num) = LENGTH bs in (Let bs (cb_to_bvi_worker cb loc_opt (offset + i_old_ptr) (offset + i_old_idx)) :exp))) ∧ (∀(v12 :num) (v1 :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx v1 (Var v12 :exp) = fill_hole i_old_ptr i_old_idx (Var v12 :exp)) ∧ (∀(v25 :num) (v24 :num) (v1 :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx v1 (Force v24 v25 :exp) = fill_hole i_old_ptr i_old_idx (Force v24 v25 :exp)) ∧ (∀(v32 :exp) (v31 :exp list) (v30 :num) (v29 :num) (v28 :num) (v1 :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx v1 (LetCall v28 v29 v30 v31 v32) = fill_hole i_old_ptr i_old_idx (LetCall v28 v29 v30 v31 v32)) ∧ ∀(v33 :exp list) (v1 :num) (loc_opt :num) (loc :num) (i_old_ptr :num) (i_old_idx :num). rewrite_worker loc loc_opt i_old_ptr i_old_idx v1 (Return v33) = fill_hole i_old_ptr i_old_idx (Return v33)
compile_exp_def_typed=∀(loc :num) (next :num) (arity :num) (exp :exp). compile_exp loc next arity exp = case rewrite_wrapper loc next arity exp of (NONE :exp option) => (NONE :(exp # exp) option) | SOME exp_wrapper => (let (exp_worker :exp) = rewrite_worker loc next arity (arity + (1 :num)) arity exp in SOME (exp_wrapper,exp_worker))
compile_each_def_typed=(∀(next :num). compile_each next ([] :(num # num # exp) list) = (next,([] :(num # num # exp) list))) ∧ ∀(xs :(num # num # exp) list) (next :num) (loc :num) (exp :exp) (arity :num). compile_each next ((loc,arity,exp)::xs) = case compile_exp loc next arity exp of (NONE :(exp # exp) option) => (let ((n :num),(ys :(num # num # exp) list)) = compile_each next xs in (n,(loc,arity,exp)::ys)) | SOME (exp_wrapper,exp_worker) => (let ((n :num),(ys :(num # num # exp) list)) = compile_each (next + bvl_to_bvi_namespaces) xs in (n,(loc,arity,exp_wrapper)::(next,arity + (2 :num),exp_worker)::ys))
compile_prog_def_typed=∀(do_it :bool) (next :num) (xs :(num # num # exp) list). compile_prog do_it next xs = if do_it then compile_each next xs else (next,xs)
