bvi_to_cb_aux_def_typed=(∀(tag :num) (t :num) (n :num) (loc' :num option) (loc :num) (h :exp option) (args :exp list). bvi_to_cb_aux_sing n loc tag (Call t loc' args h :exp) = case call_to_cb loc t loc' args h of (NONE :(exp list # call_block) option) => (NONE :(exp list # (num list + call_block)) option) | SOME (bs,cb) => SOME (bs,(INR (CallBlock tag ([] :num list) cb ([] :num list)) :num list + call_block))) ∧ (∀(tag :num) (op :op) (n :num) (loc :num) (args :exp list). bvi_to_cb_aux_sing n loc tag (Op op args :exp) = case dest_Cons op of (NONE :num option) => if pure_exp n (Op op args :exp) then SOME ([(Op op args :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option) | SOME tag' => case bvi_to_cb_aux n loc tag' args of (NONE :(exp list # (num list + call_block)) option) => (NONE :(exp list # (num list + call_block)) option) | SOME (bs,(INL vs :num list + call_block)) => if pure_exp n (Op op args :exp) then SOME ([(Op op args :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option) | SOME (bs,(INR cb :num list + call_block)) => SOME (bs,(INR (CallBlock tag ([] :num list) cb ([] :num list)) :num list + call_block))) ∧ (∀(v22 :num) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (Var v22 :exp) = if pure_exp n (Var v22 :exp) then SOME ([(Var v22 :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v27 :exp) (v26 :exp) (v23 :exp) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (If v23 v26 v27 :exp) = if pure_exp n (If v23 v26 v27 :exp) then SOME ([(If v23 v26 v27 :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v31 :exp) (v30 :exp list) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (Let v30 v31 :exp) = if pure_exp n (Let v30 v31 :exp) then SOME ([(Let v30 v31 :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v32 :exp) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (Raise v32 :exp) = if pure_exp n (Raise v32 :exp) then SOME ([(Raise v32 :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v33 :exp) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (Tick v33 :exp) = if pure_exp n (Tick v33 :exp) then SOME ([(Tick v33 :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v39 :num) (v38 :num) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (Force v38 v39 :exp) = if pure_exp n (Force v38 v39 :exp) then SOME ([(Force v38 v39 :exp)],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v46 :exp) (v45 :exp list) (v44 :num) (v43 :num) (v42 :num) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (LetCall v42 v43 v44 v45 v46) = if pure_exp n (LetCall v42 v43 v44 v45 v46) then SOME ([LetCall v42 v43 v44 v45 v46],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v47 :exp list) (v1 :num) (v0 :num) (n :num). bvi_to_cb_aux_sing n v0 v1 (Return v47) = if pure_exp n (Return v47) then SOME ([Return v47],(INL [(0 :num)] :num list + call_block)) else (NONE :(exp list # (num list + call_block)) option)) ∧ (∀(v4 :num) (v3 :num) (v2 :num). bvi_to_cb_aux v2 v3 v4 ([] :exp list) = SOME (([] :exp list),(INL ([] :num list) :num list + call_block))) ∧ (∀(tag :num) (n :num) (loc :num) (exp :exp). bvi_to_cb_aux n loc tag [exp] = bvi_to_cb_aux_sing n loc tag exp) ∧ ∀(v79 :exp list) (v78 :exp) (tag :num) (n :num) (loc :num) (h :exp). bvi_to_cb_aux n loc tag (h::v78::v79) = case bvi_to_cb_aux n loc tag (v78::v79) of (NONE :(exp list # (num list + call_block)) option) => (NONE :(exp list # (num list + call_block)) option) | SOME (bs2,(INL vs2 :num list + call_block)) => (case bvi_to_cb_aux_sing n loc tag h of (NONE :(exp list # (num list + call_block)) option) => (NONE :(exp list # (num list + call_block)) option) | SOME (bs1,(INL vs1 :num list + call_block)) => if small_enough_int ((&(LENGTH vs1 + LENGTH vs2)) :int) then (let (vs2' :num list) = shift_vars (LENGTH bs1) vs2 in SOME (bs1 ++ bs2,(INL (vs1 ++ vs2') :num list + call_block))) else (NONE :(exp list # (num list + call_block)) option) | SOME (bs1,(INR (CallBlock v16 ([] :num list) child ([] :num list)) :num list + call_block)) => (let (vs2' :num list) = shift_vars (LENGTH bs1) vs2 in SOME (bs1 ++ bs2,(INR (CallBlock tag ([] :num list) child vs2') :num list + call_block))) | SOME (bs1,(INR (CallBlock v16 ([] :num list) child (v28::v29)) :num list + call_block)) => (NONE :(exp list # (num list + call_block)) option) | SOME (bs1,(INR (CallBlock v16 (v24::v25) child v19) :num list + call_block)) => (NONE :(exp list # (num list + call_block)) option) | SOME (bs1,(INR (RCall v20 v21) :num list + call_block)) => (NONE :(exp list # (num list + call_block)) option)) | SOME (bs2,(INR cb :num list + call_block)) => case shift_cb (1 :num) cb of CallBlock tag l child r => (let (cb' :call_block) = CallBlock tag ((0 :num)::l) child r in SOME (h::bs2,(INR cb' :num list + call_block))) | RCall v10 v11 => (NONE :(exp list # (num list + call_block)) option)
wf_vars_def_typed=∀(n :num) (vs :num list). wf_vars n vs ⇔ EVERY (λ(v :num). v < n) vs
wf_vars_empty_typed=∀(n :num). wf_vars n ([] :num list)
wf_vars_expand_typed=∀(n1 :num) (n2 :num) (vs :num list). wf_vars n1 vs ∧ n1 ≤ n2 ⇒ wf_vars n2 vs
wf_vars_shift_typed=∀(n1 :num) (n2 :num) (vs :num list). wf_vars n1 vs ⇒ wf_vars (n2 + n1) (shift_vars n2 vs)
wf_vars_shift_sing_typed=∀(n :num) (vs :num list). wf_vars n vs ⇒ wf_vars (SUC n) (shift_vars (1 :num) vs)
wf_vars_append_typed=∀(n :num) (vs1 :num list) (vs2 :num list). wf_vars n vs1 ∧ wf_vars n vs2 ⇒ wf_vars n (vs1 ++ vs2)
wf_vars_cons_typed=∀(n :num) (v :num) (vs :num list). v < n ∧ wf_vars n vs ⇒ wf_vars n (v::vs)
wf_vars_bind_typed=∀(bs :α list) (vs :num list) (n :num) (n' :num). bind n bs = (vs,n') ⇒ wf_vars (n + LENGTH bs) vs
