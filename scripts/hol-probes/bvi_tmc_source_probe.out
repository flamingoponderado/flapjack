pure_exp_def_typed=(∀(n :num) (v :num). pure_exp n (Var v :exp) ⇔ v < n) ∧ (∀(n :num) (e1 :exp) (e2 :exp) (e3 :exp). pure_exp n (If e1 e2 e3 :exp) ⇔ F) ∧ (∀(n :num) (es :exp list) (e :exp). pure_exp n (Let es e :exp) ⇔ pure_exp n e ∧ pure_exps n es) ∧ (∀(n :num) (v0 :exp). pure_exp n (Raise v0 :exp) ⇔ F) ∧ (∀(n :num) (e :exp). pure_exp n (Tick e :exp) ⇔ F) ∧ (∀(n :num) (v1 :num) (v2 :num option) (v3 :exp list) (v4 :exp option). pure_exp n (Call v1 v2 v3 v4 :exp) ⇔ F) ∧ (∀(n :num) (v5 :num) (v6 :num). pure_exp n (Force v5 v6 :exp) ⇔ F) ∧ (∀(n :num) (v7 :num) (v8 :num) (v9 :num) (v10 :exp list) (v11 :exp). pure_exp n (LetCall v7 v8 v9 v10 v11) ⇔ F) ∧ (∀(n :num) (v12 :exp list). pure_exp n (Return v12) ⇔ F) ∧ (∀(n :num) (op :op) (args :exp list). pure_exp n (Op op args :exp) ⇔ (pure_op op args :bool) ∧ pure_exps n args) ∧ (∀(n :num). pure_exps n ([] :exp list) ⇔ T) ∧ ∀(n :num) (h :exp) (t :exp list). pure_exps n (h::t) ⇔ pure_exp n h ∧ pure_exps n t
