bvi_to_cb_aux_wf_inl_lemma_typed=(∀(n :num) (loc :num) (tag :num) (exp :exp) (bs :exp list) (vs :num list). bvi_to_cb_aux_sing n loc tag exp = SOME (bs,(INL vs :num list + call_block)) ⇒ pure_exps n bs ∧ wf_vars (LENGTH bs) vs ∧ small_enough_int ((&LENGTH vs) :int)) ∧ ∀(n :num) (loc :num) (tag :num) (args :exp list) (bs :exp list) (vs :num list). bvi_to_cb_aux n loc tag args = SOME (bs,(INL vs :num list + call_block)) ⇒ pure_exps n bs ∧ wf_vars (LENGTH bs) vs ∧ small_enough_int ((&LENGTH vs) :int)
bvi_to_cb_aux_wf_inr_lemma_typed=(∀(n :num) (loc :num) (tag :num) (exp :exp) (bs :exp list) (cb :call_block). bvi_to_cb_aux_sing n loc tag exp = SOME (bs,(INR cb :num list + call_block)) ⇒ wf_cb (LENGTH bs) cb ∧ ∃(l :num list) (child :call_block) (r :num list). cb = CallBlock tag l child r) ∧ ∀(n :num) (loc :num) (tag :num) (args :exp list) (bs :exp list) (cb :call_block). bvi_to_cb_aux n loc tag args = SOME (bs,(INR cb :num list + call_block)) ⇒ wf_cb (LENGTH bs) cb ∧ ∃(l :num list) (child :call_block) (r :num list). cb = CallBlock tag l child r
bvi_to_cb_def_typed=bvi_to_cb (n :num) (loc :num) (Call (call_ts :num) (call_loc :num option) (call_args :exp list) (call_h :exp option) :exp) = call_to_cb loc call_ts call_loc call_args call_h ∧ bvi_to_cb n loc (Op (op :op) (xs :exp list) :exp) = (case dest_Cons op of (NONE :num option) => (NONE :(exp list # call_block) option) | SOME tag => case bvi_to_cb_aux n loc tag xs of (NONE :(exp list # (num list + call_block)) option) => (NONE :(exp list # call_block) option) | SOME (bs,(INL v8 :num list + call_block)) => (NONE :(exp list # call_block) option) | SOME (bs,(INR cb :num list + call_block)) => SOME (bs,cb)) ∧ bvi_to_cb (v0 :num) (v1 :num) (Var (v7 :num) :exp) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (If (v9 :exp) (v10 :exp) (v11 :exp) :exp) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (Let (v12 :exp list) (v13 :exp) :exp) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (Raise (v14 :exp) :exp) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (Tick (v15 :exp) :exp) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (Force (v20 :num) (v21 :num) :exp) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (LetCall (v24 :num) (v25 :num) (v26 :num) (v27 :exp list) (v28 :exp)) = (NONE :(exp list # call_block) option) ∧ bvi_to_cb v0 v1 (Return (v29 :exp list)) = (NONE :(exp list # call_block) option)
