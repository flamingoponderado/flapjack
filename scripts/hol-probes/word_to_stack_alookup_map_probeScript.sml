val _ = Globals.linewidth := 1000000;
val _ = numLib.temp_prefer_num();
val ALOOKUP_MAP_any=prove(``∀f k h ls a x.
   (INJ k (a INSERT (set (MAP FST ls))) UNIV) ∧
   (∀x y. MEM (x,y) ls ⇒ f (x,y) = (k x, h (k x) y)) ∧ k a = x ⇒
   ALOOKUP (MAP f ls) x = OPTION_MAP (h x) (ALOOKUP ls a)``,  ntac 3 gen_tac
  \\ Induct \\ simp[]
  \\ Cases \\ simp[]
  \\ rw[]
  >- (
    `F` suffices_by rw[]
    \\ qhdtm_x_assum`INJ`mp_tac
    \\ simp[INJ_DEF]
    \\ PROVE_TAC[] )
  \\ first_x_assum match_mp_tac
  \\ simp[]
  \\ qhdtm_x_assum`INJ`mp_tac
  \\ REWRITE_TAC[INJ_DEF,IN_INSERT,MEM_MAP]
  \\ PROVE_TAC[FST,PAIR]);
val _ = (if null(hyp ALOOKUP_MAP_any) then () else raise Fail "open premise"; print "am_full_ALOOKUP_MAP_any="; print_thm ALOOKUP_MAP_any; print "\n");
val ALOOKUP_MAP_INJ_FST=prove(``∀ls f x k.
   INJ (FST o f) (x INSERT set ls) UNIV ∧
   FST (f x) = k
   ⇒
   ALOOKUP (MAP f ls) k =
   ALOOKUP (MAP (λx. (x, SND(f x))) ls) x``,  Induct \\ simp[]
  \\ rpt gen_tac \\ strip_tac
  \\ Cases_on`f h` \\ simp[]
  \\ Cases_on`f x` \\ fs[]
  \\ qmatch_assum_abbrev_tac`f h = v1`
  \\ qmatch_assum_abbrev_tac`f x = v2`
  \\ `h = x ⇔ FST v1 = FST v2`
  by (
    qhdtm_x_assum`INJ`mp_tac
    \\ REWRITE_TAC[INJ_DEF,IN_INSERT,IN_UNIV,o_DEF]
    \\ CONV_TAC(DEPTH_CONV BETA_CONV)
    \\ metis_tac[] )
  \\ fs[Abbr`v1`,Abbr`v2`]
  \\ IF_CASES_TAC \\ fs[]
  \\ first_x_assum(qspecl_then[`f`,`x`]mp_tac)
  \\ simp[] \\ disch_then match_mp_tac
  \\ qhdtm_x_assum`INJ`mp_tac
  \\ REWRITE_TAC[INJ_DEF,IN_INSERT,IN_UNIV]
  \\ metis_tac[]);
val _ = (if null(hyp ALOOKUP_MAP_INJ_FST) then () else raise Fail "open premise"; print "am_full_ALOOKUP_MAP_INJ_FST="; print_thm ALOOKUP_MAP_INJ_FST; print "\n");
val ALOOKUP_ID_TABULATE=prove(``ALOOKUP (MAP (λx. (x,x)) ls) x =
   if MEM x ls then SOME x else NONE``,  Induct_on`ls`\\simp[]\\rw[]\\fs[]);
val _ = (if null(hyp ALOOKUP_ID_TABULATE) then () else raise Fail "open premise"; print "am_full_ALOOKUP_ID_TABULATE="; print_thm ALOOKUP_ID_TABULATE; print "\n");
