load "bossLib"; load "preamble"; load "parmoveTheory";
open bossLib HolKernel Parse preamble parmoveTheory;
fun observe label term = let val th = SIMP_CONV (srw_ss()) [boolTheory.LEFT_AND_OVER_OR, boolTheory.RIGHT_AND_OVER_OR, boolTheory.EXISTS_OR_THM] (rhs (concl (EVAL term))) in print (label ^ "="); print_term (rhs (concl th)); print "\n" end;
val _ = observe "preserve_4_before" ``let s = (([(SOME 4,SOME 5)],[(SOME 6,SOME 7);(SOME 1,SOME 2)],[(SOME 8,SOME 9)]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) in ?y. MEM (SOME 4,y) (state_to_list s) /\ SOME 4 <> y``;
val _ = observe "preserve_4_after" ``let s = (([(SOME 4,SOME 5)],[(SOME 6,SOME 7);(SOME 1,NONE)],[(NONE,SOME 2);(SOME 8,SOME 9)]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) in ?y. MEM (SOME 4,y) (state_to_list s) /\ SOME 4 <> y``;
