compile_aux_def_typed=∀(k :num) (args :α) (p :bvi$exp). compile_aux (k,args,p) = (List [(bvl_num_stubs + bvl_to_bvi_namespaces * k + (1 :num),args,(compile_exp p :bvi$exp))] :(num # α # bvi$exp) app_list)
compile_exps_sing_def_typed=(∀(v :num) (n :num). compile_exps_sing n (Var v :exp) = ((Var v :bvi$exp),(Nil :(num # num # bvi$exp) app_list),n)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (n :num). compile_exps_sing n (If x1 x2 x3 :exp) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x1; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x2; ((c3 :bvi$exp),(aux3 :(num # num # bvi$exp) app_list),(n3 :num)) = compile_exps_sing n2 x3 in ((If c1 c2 c3 :bvi$exp),SmartAppend (SmartAppend aux1 aux2) aux3,n3))) ∧ (∀(xs :exp list) (x2 :exp) (n :num). compile_exps_sing n (Let xs x2 :exp) = if NULL xs then (let ((args :exp list),(x0 :exp)) = destLet x2; ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n args; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x0; (n3 :num) = n2 + (1 :num) in ((Call (0 :num) (SOME (bvl_num_stubs + bvl_to_bvi_namespaces * n2 + (1 :num))) c1 (NONE :bvi$exp option) :bvi$exp),SmartAppend (SmartAppend aux1 aux2) (compile_aux (n2,LENGTH args,c2)),n3)) else (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n xs; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x2 in ((Let c1 c2 :bvi$exp),SmartAppend aux1 aux2,n2))) ∧ (∀(x1 :exp) (n :num). compile_exps_sing n (Raise x1 :exp) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x1 in ((Raise c1 :bvi$exp),aux1,n1))) ∧ (∀(x1 :exp) (n :num). compile_exps_sing n (Tick x1 :exp) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x1 in ((Tick c1 :bvi$exp),aux1,n1))) ∧ (∀(v :num) (n :num) (loc :num). compile_exps_sing n (Force loc v :exp) = ((Force (bvl_num_stubs + bvl_to_bvi_namespaces * loc) v :bvi$exp),(Nil :(num # num # bvi$exp) app_list),n)) ∧ (∀(xs :exp list) (op :op) (n :num). compile_exps_sing n (Op op xs :exp) = (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n xs in (compile_op op c1,aux1,n1))) ∧ (∀(x2 :exp) (x1 :exp) (n :num). compile_exps_sing n (Handle x1 x2 :exp) = (let ((args :exp list),(x0 :exp)) = destLet x1; ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n args; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x0; ((c3 :bvi$exp),(aux3 :(num # num # bvi$exp) app_list),(n3 :num)) = compile_exps_sing n2 x2; (aux4 :(num # num # bvi$exp) app_list) = compile_aux (n3,LENGTH args,c2); (n4 :num) = n3 + (1 :num) in ((Call (0 :num) (SOME (bvl_num_stubs + bvl_to_bvi_namespaces * n3 + (1 :num))) c1 (SOME c3) :bvi$exp),SmartAppend (SmartAppend (SmartAppend aux1 aux2) aux3) aux4,n4))) ∧ (∀(xs :exp list) (ticks :num) (n :num) (dest :num option). compile_exps_sing n (Call ticks dest xs :exp) = (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n xs in ((Call ticks (case dest of (NONE :num option) => (NONE :num option) | SOME n => SOME (bvl_num_stubs + bvl_to_bvi_namespaces * n)) c1 (NONE :bvi$exp option) :bvi$exp),aux1,n1))) ∧ (∀(n :num). compile_exps_list n ([] :exp list) = (([] :bvi$exp list),(Nil :(num # num # bvi$exp) app_list),n)) ∧ ∀(xs :exp list) (x :exp) (n :num). compile_exps_list n (x::xs) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x; ((c2 :bvi$exp list),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_list n1 xs in (c1::c2,SmartAppend aux1 aux2,n2))
compile_single_def_typed=∀(n :num) (name :num) (arg_count :num) (exp :exp). compile_single n (name,arg_count,exp) = (let ((c :bvi$exp list),(aux :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps n [exp] in (SmartAppend (List [(bvl_num_stubs + bvl_to_bvi_namespaces * name,arg_count,(compile_exp (HD c) :bvi$exp))] :(num # num # bvi$exp) app_list) aux,n1))
compile_list_def_typed=(∀(n :num). (compile_list n ([] :(num # num # exp) list) :(num # num # bvi$exp) app_list # num) = ((List ([] :(num # num # bvi$exp) list) :(num # num # bvi$exp) app_list),n)) ∧ ∀(n :num) (p :num # num # exp) (progs :(num # num # exp) list). (compile_list n (p::progs) :(num # num # bvi$exp) app_list # num) = (let ((code1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_single n p; ((code2 :(num # num # bvi$exp) app_list),(n2 :num)) = (compile_list n1 progs :(num # num # bvi$exp) app_list # num) in (SmartAppend code1 code2,n2))
compile_inc_def_typed=∀(n :num) (prog :(num # num # exp) list). (compile_inc n prog :num # (num # num # bvi$exp) list) = (let ((p1 :(num # num # bvi$exp) app_list),(n1 :num)) = (compile_list n prog :(num # num # bvi$exp) app_list # num) in (n1,append p1))
