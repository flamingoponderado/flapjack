ISR1_actual_goal=∀(index :num).
  if
    (i :num) ≤ index ∧
    index < LENGTH (mc_conf :(α, 'state, β) machine_config).ffi_entry_pcs
  then
    ∃(info :word8 # α addr # num # α word).
      ALOOKUP
        (ZIP
           (GENLIST (λ(index :num). i + index)
              (LENGTH (shmem_info :shmem_info_num list)),
            MAP
              (λ(rec :shmem_info_num).
                   (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off :α word),
                    rec.reg,(n2w rec.exit_pc :α word)))
              (new_shmem_info :shmem_info_num list))) index = SOME info
  else
    ALOOKUP
      (ZIP
         (GENLIST (λ(index :num). i + index) (LENGTH shmem_info),
          MAP
            (λ(rec :shmem_info_num).
                 (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off :α word),
                  rec.reg,(n2w rec.exit_pc :α word))) new_shmem_info)) index =
    (NONE :(word8 # α addr # num # α word) option)
ISR2_actual_goal=∀(ms2 :'state) (k :num) (index :num) (new_bytes :word8 list)
    (t1 :α asm_state) (bytes :word8 list) (bytes2 :word8 list)
    (st :'ffi ffi_state) (new_st :'ffi ffi_state).
  index < (i :num) ∧
  read_ffi_bytearrays (mc_conf :(α, 'state, β) machine_config) ms2 =
  (SOME bytes,SOME bytes2) ∧
  (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳
    (ffi :'ffi ffi_state) st ∧
  call_FFI st mc_conf.ffi_names❲index❳ bytes bytes2 =
  FFI_return new_st new_bytes ∧ mc_conf.prog_addresses = t1.mem_domain ∧
  target_state_rel mc_conf.target
    (t1 with
     pc :=
       -(n2w (ffi_offset * (index + (3 :num))) :α word) +
       mc_conf.target.get_pc (ms :'state)) ms2 ∧
  aligned mc_conf.target.config.code_alignment
    (t1.regs
       (case mc_conf.target.config.link_reg of
          (NONE :num option) => (0 :num)
        | SOME n => n) :α word) ⇒
  target_state_rel mc_conf.target
    (t1 with
     <|regs :=
         (λ(a :num).
              if
                MEM a mc_conf.callee_saved_regs ∨
                ¬(a < mc_conf.target.config.reg_count) ∨
                MEM a mc_conf.target.config.avoid_regs
              then
                (t1.regs a :α word)
              else
                mc_conf.target.get_reg
                  (mc_conf.ffi_interfer k (index,new_bytes,ms2)) a);
       fp_regs :=
         (λ(n :num).
              mc_conf.target.get_fp_reg
                (mc_conf.ffi_interfer k (index,new_bytes,ms2)) n);
       mem :=
         asm_write_bytearray (t1.regs mc_conf.ptr2_reg :α word) new_bytes
           t1.mem;
       pc :=
         (t1.regs
            (case mc_conf.target.config.link_reg of
               (NONE :num option) => (0 :num)
             | SOME n => n) :α word)|>)
    (mc_conf.ffi_interfer k (index,new_bytes,ms2))
