next_label_filter_skip=∀(code :α sec list).
  (next_label code :β word_loc option) =
  (next_label (filter_skip code) :β word_loc option)
next_label_filter_skip_types=(code :α sec list)::α sec list;
next_label_filter_skip_hypotheses=0
next_label_filter_skip_proved=T
all_skips_get_lab_after=∀(code :α sec list) (k :num).
  all_skips (0 :num) code k ⇒
  (get_lab_after k code :β word_loc option) =
  (get_lab_after (0 :num) (filter_skip code) :β word_loc option)
all_skips_get_lab_after_types=(code :α sec list)::α sec list;(k :num)::num;
all_skips_get_lab_after_hypotheses=0
all_skips_get_lab_after_proved=T
get_lab_after_adjust=∀(pc :num) (code :α sec list) (k :num).
  all_skips pc code k ⇒
  (get_lab_after (pc + k) code :β word_loc option) =
  (get_lab_after (adjust_pc pc code) (filter_skip code) :β word_loc option)
get_lab_after_adjust_types=(pc :num)::num;(code :α sec list)::α sec list;(k :num)::num;
get_lab_after_adjust_hypotheses=0
get_lab_after_adjust_proved=T
