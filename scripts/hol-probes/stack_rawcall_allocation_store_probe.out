allocation_store_full_statement=∀p s t i r s1. evaluate (p,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i p,t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i p,t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
allocation_store_full_hypotheses=0
allocation_store_alloc=∀s t i r s1. evaluate (Alloc rawRegister,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp_top i (Alloc rawRegister),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)) ∧ ∃ck t1 k1. state_rel i s1 t1 ∧ evaluate (comp i (Alloc rawRegister),t with clock := t.clock + ck) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1.stack_space)
allocation_store_storeConsts=∀s t i r s1. evaluate (StoreConsts t1 t2 stubOpt,s) = (r,s1) ∧ r ≠ SOME Error ∧ state_rel i s t ⇒ (∃ck t1' k1. state_rel i s1 t1' ∧ evaluate (comp_top i (StoreConsts t1 t2 stubOpt),t with clock := t.clock + ck) = (r,t1' with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1'.stack_space)) ∧ ∃ck t1' k1. state_rel i s1 t1' ∧ evaluate (comp i (StoreConsts t1 t2 stubOpt),t with clock := t.clock + ck) = (r,t1' with stack_space := k1) ∧ (r ≠ SOME TimeOut ∧ r ≠ SOME (Halt (Word 2w)) ⇒ k1 = t1'.stack_space)
allocation_store_stub64=comp_top LN (Seq (StoreConsts 4 5 NONE) (Return 0)) = Seq (StoreConsts 4 5 NONE) (Return 0) ⇔ T
allocation_store_stub80=comp_top LN (Seq (StoreConsts 4 5 NONE) (Return 0)) = Seq (StoreConsts 4 5 NONE) (Return 0) ⇔ T
