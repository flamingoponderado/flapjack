LENGTH_anys_typed=∀(n :num). LENGTH (anys n) = n
LENGTH_dest_val_typed=dest_val (refs :num |-> term) (v :term) = SOME ((c :ctor),(as :term list)) ⇒ LENGTH as = ctor_arity c
LENGTH_expand_list_typed=∀(ps :pat list) (qs :pat list). MEM qs (expand_list ps) ⇒ LENGTH qs = LENGTH ps
MEM_add_head_typed=∀(yss :α list list) (x :α) (ys :α list). MEM ys (add_head x yss) ⇔ ∃(zs :α list). MEM zs yss ∧ ys = x::zs
MEM_ctor_keep_typed=∀(xs :α list) (ys :α list) (x :α). MEM x (ctor_keep xs ys) ⇔ MEM x xs ∧ MEM x ys
MEM_ctor_nub_typed=∀(l :α list) (x :α). MEM x (ctor_nub l) ⇔ MEM x l
MEM_mk_conses_typed=∀(pss :pat list list) (t :(num # (num # num) list option) option) (q :pat). MEM q (mk_conses t pss) ⇔ ∃(ps :pat list). MEM ps pss ∧ q = Cons t ps
MEM_mk_prods_typed=∀(xs :α list) (yss :α list list) (zs :α list). MEM zs (mk_prods xs yss) ⇔ ∃(x :α) (ys :α list). MEM x xs ∧ MEM ys yss ∧ zs = x::ys
MEM_mk_refs_typed=∀(ps :pat list) (q :pat). MEM q (mk_refs ps) ⇔ ∃(p :pat). MEM p ps ∧ q = Ref p
MEM_mk_rows_typed=∀(ps :α list) (r :α list). MEM r (mk_rows ps) ⇔ ∃(p :α). MEM p ps ∧ r = [p]
MEM_spec_mats_typed=∀(cs :ctor list) (c :ctor) (rows :pat list list). MEM c cs ⇒ MEM (spec_mat c rows) (spec_mats cs rows)
MEM_tag_ctors_typed=∀(sibs :(num # num) list) (t :num) (a :num). MEM (TagC t a) (tag_ctors sibs) ⇔ MEM (t,a) sibs
add_head_def_typed=(∀(x :α). add_head x ([] :α list list) = ([] :α list list)) ∧ ∀(x :α) (ys :α list) (yss :α list list). add_head x (ys::yss) = (x::ys)::add_head x yss
anys_def_typed=anys (0 :num) = ([] :pat list) ∧ ∀(n :num). anys (SUC n) = Any::anys n
col_ctors_def_typed=col_ctors ([] :pat list list) = (NONE :ctor list option) ∧ (∀(rows :pat list list). col_ctors (([] :pat list)::rows) = col_ctors rows) ∧ ∀(v0 :pat list) (rows :pat list list) (p :pat). col_ctors ((p::v0)::rows) = ctor_inter (ctors_of p) (col_ctors rows)
col_ctors_thm_typed=∀(M :pat list list) (cs :ctor list) (refs :num |-> term) (v :term) (vs :term list). col_ctors M = SOME cs ∧ EVERY (λ(r :pat list). (pmatch_list refs r (v::vs) :pmatchResult) ≠ PTypeFailure) M ⇒ ∃(c :ctor) (as :term list). dest_val refs v = SOME (c,as) ∧ MEM c cs
ctor_typed=TagC::num -> num -> ctor; TupC::num -> ctor; RefC::ctor
ctor_arity_def_typed=(∀(t :num) (a :num). ctor_arity (TagC t a) = a) ∧ (∀(a :num). ctor_arity (TupC a) = a) ∧ ctor_arity RefC = (1 :num)
ctor_inter_def_typed=ctor_inter (NONE :α list option) (ys' :α list option) = ys' ∧ ctor_inter (SOME (v2 :α list)) (NONE :α list option) = SOME v2 ∧ ctor_inter (SOME (xs :α list)) (SOME (ys :α list)) = SOME (ctor_keep xs ys)
ctor_keep_def_typed=(∀(ys :α list). ctor_keep ([] :α list) ys = ([] :α list)) ∧ ∀(x :α) (xs :α list) (ys :α list). ctor_keep (x::xs) ys = if MEM x ys then x::ctor_keep xs ys else ctor_keep xs ys
ctor_nub_def_typed=ctor_nub ([] :α list) = ([] :α list) ∧ ∀(x :α) (xs :α list). ctor_nub (x::xs) = if MEM x xs then ctor_nub xs else x::ctor_nub xs
ctors_of_def_typed=ctors_of Any = (NONE :ctor list option) ∧ ctors_of (Lit (v0 :lit) :pat) = (NONE :ctor list option) ∧ ctors_of (Or (v1 :pat) (v2 :pat) :pat) = (NONE :ctor list option) ∧ ctors_of (Ref (v3 :pat)) = SOME [RefC] ∧ ctors_of (Cons (NONE :(num # (num # num) list option) option) (qs :pat list)) = SOME [TupC (LENGTH qs)] ∧ ctors_of (Cons (SOME ((t :num),(NONE :(num # num) list option))) qs) = (NONE :ctor list option) ∧ ctors_of (Cons (SOME (t,SOME (sibs :(num # num) list))) qs) = SOME (ctor_nub (TagC t (LENGTH qs)::tag_ctors sibs))
ctors_of_thm_typed=ctors_of (p :pat) = SOME (xs :ctor list) ∧ (pmatch (refs :num |-> term) p (v :term) :pmatchResult) ≠ PTypeFailure ⇒ ∃(c :ctor) (as :term list). dest_val refs v = SOME (c,as) ∧ MEM c xs
default_mat_MEM_typed=∀(M :pat list list) (refs :num |-> term) (v :term) (vs :term list) (row :pat list). MEM row (default_mat M) ⇒ ∃(r :pat list). MEM r M ∧ (pmatch_list refs row vs :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
default_mat_def_typed=default_mat ([] :pat list list) = ([] :pat list list) ∧ ∀(r :pat list) (rows :pat list list). default_mat (r::rows) = default_row r ++ default_mat rows
default_row_def_typed=default_row (Any::(rest :pat list)) = [rest] ∧ default_row ([] :pat list) = ([] :pat list list) ∧ default_row (Cons (v4 :(num # (num # num) list option) option) (v5 :pat list)::(v1 :pat list)) = ([] :pat list list) ∧ default_row ((Or (v6 :pat) (v7 :pat) :pat)::v1) = ([] :pat list list) ∧ default_row ((Lit (v8 :lit) :pat)::v1) = ([] :pat list list) ∧ default_row (Ref (v9 :pat)::v1) = ([] :pat list list)
default_row_thm_typed=∀(r :pat list) (row :pat list) (refs :num |-> term) (v :term) (vs :term list). MEM row (default_row r) ⇒ (pmatch_list refs row vs :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
dest_val_def_typed=dest_val (refs :num |-> term) (Term (SOME (t :num)) (vs :term list)) = SOME (TagC t (LENGTH vs),vs) ∧ dest_val refs (Term (NONE :num option) vs) = SOME (TupC (LENGTH vs),vs) ∧ dest_val refs (RefPtr (r :num)) = (case FLOOKUP refs r of (NONE :term option) => (NONE :(ctor # term list) option) | SOME w => SOME (RefC,[w])) ∧ dest_val refs (Litv (l :lit) :term) = (NONE :(ctor # term list) option) ∧ dest_val refs Other = (NONE :(ctor # term list) option)
dest_val_eq_SOME_typed=dest_val (refs :num |-> term) (v :term) = SOME ((c :ctor),(as :term list)) ⇔ (∃(t :num). v = Term (SOME t) as ∧ c = TagC t (LENGTH as)) ∨ v = Term (NONE :num option) as ∧ c = TupC (LENGTH as) ∨ ∃(r :num) (w :term). v = RefPtr r ∧ FLOOKUP refs r = SOME w ∧ as = [w] ∧ c = RefC
exh_all_def_typed=(exh_all ([] :pat list list list) ⇔ T) ∧ (∀(ms :pat list list list). exh_all (([] :pat list list)::ms) ⇔ F) ∧ ∀(rows :pat list list) (r :pat list) (ms :pat list list list). exh_all ((r::rows)::ms) ⇔ if NULL r then exh_all ms else case col_ctors (r::rows) of (NONE :ctor list option) => exh_all (default_mat (r::rows)::ms) | SOME cs => exh_all (spec_mats cs (r::rows) ++ ms)
exh_all_thm_typed=∀(ms :pat list list list). exh_all ms ⇔ exh_mats ms
exh_matrix_def_typed=(exh_matrix ([] :pat list list) ⇔ F) ∧ (∀(rows :pat list list) (r :pat list). exh_matrix (r::rows) ⇔ if NULL r then T else case col_ctors (r::rows) of (NONE :ctor list option) => exh_matrix (default_mat (r::rows)) | SOME cs => exh_mats (spec_mats cs (r::rows))) ∧ (exh_mats ([] :pat list list list) ⇔ T) ∧ ∀(ms :pat list list list) (m :pat list list). exh_mats (m::ms) ⇔ exh_matrix m ∧ exh_mats ms
exh_matrix_thm_typed=(∀(M :pat list list) (refs :num |-> term) (vs :term list). exh_matrix M ∧ EVERY (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) ≠ PTypeFailure) M ⇒ EXISTS (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) = PMatchSuccess) M) ∧ ∀(ms :pat list list list) (m :pat list list) (refs :num |-> term) (vs :term list). exh_mats ms ∧ MEM m ms ∧ EVERY (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) ≠ PTypeFailure) m ⇒ EXISTS (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) = PMatchSuccess) m
exh_mats_append_typed=∀(xs :pat list list list) (ys :pat list list list). exh_mats (xs ++ ys) ⇔ exh_mats xs ∧ exh_mats ys
exh_rows_def_typed=∀(rows :(pat # α) list). exh_rows rows ⇔ exh_matrix (or_rows rows)
exh_rows_eq_typed=exh_rows (rows :(pat # α) list) ⇔ exh_all [or_rows rows]
exh_rows_thm_typed=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ∧ exh_rows rows ⇒ match refs rows v ≠ SOME MatchFailure
exh_steps_def_typed=exh_steps ([] :pat list list) = (1 :num) ∧ (∀(rows :pat list list) (r :pat list). exh_steps (r::rows) = if NULL r then (1 :num) else case col_ctors (r::rows) of (NONE :ctor list option) => (1 :num) + exh_steps (default_mat (r::rows)) | SOME cs => (1 :num) + exh_steps_list (spec_mats cs (r::rows))) ∧ exh_steps_list ([] :pat list list list) = (0 :num) ∧ ∀(ms :pat list list list) (m :pat list list). exh_steps_list (m::ms) = exh_steps m + exh_steps_list ms
exh_steps_list_append_typed=∀(xs :pat list list list) (ys :pat list list list). exh_steps_list (xs ++ ys) = exh_steps_list xs + exh_steps_list ys
expand_def_typed=expand Any = [Any] ∧ (∀(l :lit). expand (Lit l :pat) = [(Lit l :pat)]) ∧ (∀(p :pat) (q :pat). expand (Or p q :pat) = expand p ++ expand q) ∧ (∀(p :pat). expand (Ref p) = mk_refs (expand p)) ∧ (∀(t :(num # (num # num) list option) option) (ps :pat list). expand (Cons t ps) = mk_conses t (expand_list ps)) ∧ expand_list ([] :pat list) = [([] :pat list)] ∧ ∀(p :pat) (ps :pat list). expand_list (p::ps) = mk_prods (expand p) (expand_list ps)
expand_thm_typed=(∀(p :pat) (q :pat) (refs :num |-> term) (v :term). MEM q (expand p) ∧ (pmatch refs p v :pmatchResult) ≠ PTypeFailure ⇒ (pmatch refs q v :pmatchResult) ≠ PTypeFailure ∧ ((pmatch refs q v :pmatchResult) = PMatchSuccess ⇒ (pmatch refs p v :pmatchResult) = PMatchSuccess)) ∧ ∀(ps :pat list) (qs :pat list) (refs :num |-> term) (vs :term list). MEM qs (expand_list ps) ∧ (pmatch_list refs ps vs :pmatchResult) ≠ PTypeFailure ⇒ (pmatch_list refs qs vs :pmatchResult) ≠ PTypeFailure ∧ ((pmatch_list refs qs vs :pmatchResult) = PMatchSuccess ⇒ (pmatch_list refs ps vs :pmatchResult) = PMatchSuccess)
mat_len_append_typed=∀(xs :α list list) (ys :α list list). mat_len (xs ++ ys) = mat_len xs + mat_len ys
mat_len_def_typed=mat_len ([] :α list list) = (0 :num) ∧ ∀(r :α list) (rows :α list list). mat_len (r::rows) = LENGTH r + mat_len rows
mat_len_default_mat_typed=∀(rows :pat list list). mat_len (default_mat rows) ≤ mat_len rows
mat_len_default_mat_less_typed=∀(r :pat list) (rows :pat list list). r ≠ ([] :pat list) ⇒ mat_len (default_mat (r::rows)) < mat_len (r::rows)
mat_weight_append_typed=∀(xs :pat list list) (ys :pat list list). mat_weight (xs ++ ys) = mat_weight xs + mat_weight ys
mat_weight_def_typed=mat_weight ([] :pat list list) = (0 :num) ∧ ∀(r :pat list) (rows :pat list list). mat_weight (r::rows) = pats_weight r + mat_weight rows
mat_weight_default_mat_typed=∀(rows :pat list list). mat_weight (default_mat rows) ≤ mat_weight rows
mat_weight_spec_mat_typed=∀(c :ctor) (rows :pat list list). mat_weight (spec_mat c rows) ≤ mat_weight rows
mat_weight_spec_mat_less_typed=∀(c :ctor) (rows :pat list list) (cs :ctor list). col_ctors rows = SOME cs ⇒ mat_weight (spec_mat c rows) < mat_weight rows
mat_weight_spec_row_typed=∀(c :ctor) (r :pat list). mat_weight (spec_row c r) ≤ pats_weight r
mat_weight_spec_row_less_typed=∀(c :ctor) (p :pat) (r :pat list). ctors_of p ≠ (NONE :ctor list option) ⇒ mat_weight (spec_row c (p::r)) < pats_weight (p::r)
match_EXISTS_typed=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ∧ EXISTS (λ((p :pat),(e :num)). (pmatch refs p v :pmatchResult) = PMatchSuccess) rows ⇒ match refs rows v ≠ SOME MatchFailure
match_no_PTypeFailure_typed=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ EVERY (λ((p :pat),(e :num)). (pmatch refs p v :pmatchResult) ≠ PTypeFailure) rows
mats_len_def_typed=mats_len ([] :α list list list) = (0 :num) ∧ ∀(m :α list list) (ms :α list list list). mats_len (m::ms) = MAX (mat_len m) (mats_len ms)
mats_weight_def_typed=mats_weight ([] :pat list list list) = (0 :num) ∧ ∀(m :pat list list) (ms :pat list list list). mats_weight (m::ms) = MAX (mat_weight m) (mats_weight ms)
mats_weight_spec_mats_typed=∀(cs :ctor list) (rows :pat list list) (ds :ctor list). col_ctors rows = SOME ds ⇒ mats_weight (spec_mats cs rows) < mat_weight rows
mk_conses_def_typed=(∀(t :(num # (num # num) list option) option). mk_conses t ([] :pat list list) = ([] :pat list)) ∧ ∀(t :(num # (num # num) list option) option) (ps :pat list) (pss :pat list list). mk_conses t (ps::pss) = Cons t ps::mk_conses t pss
mk_prods_def_typed=(∀(ys :α list list). mk_prods ([] :α list) ys = ([] :α list list)) ∧ ∀(x :α) (xs :α list) (ys :α list list). mk_prods (x::xs) ys = add_head x ys ++ mk_prods xs ys
mk_refs_def_typed=mk_refs ([] :pat list) = ([] :pat list) ∧ ∀(p :pat) (ps :pat list). mk_refs (p::ps) = Ref p::mk_refs ps
mk_rows_def_typed=mk_rows ([] :α list) = ([] :α list list) ∧ ∀(p :α) (ps :α list). mk_rows (p::ps) = [p]::mk_rows ps
or_rows_def_typed=or_rows ([] :(pat # α) list) = ([] :pat list list) ∧ ∀(rows :(pat # α) list) (p :pat) (e :α). or_rows ((p,e)::rows) = mk_rows (expand p) ++ or_rows rows
or_rows_hit_typed=∀(rows :(pat # α) list). EVERY (λ((p :pat),(e :α)). (pmatch (refs :num |-> term) p (v :term) :pmatchResult) ≠ PTypeFailure) rows ∧ EXISTS (λ(r :pat list). (pmatch_list refs r [v] :pmatchResult) = PMatchSuccess) (or_rows rows) ⇒ EXISTS (λ((p :pat),(e :α)). (pmatch refs p v :pmatchResult) = PMatchSuccess) rows
or_rows_ok_typed=∀(rows :(pat # α) list). EVERY (λ((p :pat),(e :α)). (pmatch (refs :num |-> term) p (v :term) :pmatchResult) ≠ PTypeFailure) rows ⇒ EVERY (λ(r :pat list). (pmatch_list refs r [v] :pmatchResult) ≠ PTypeFailure) (or_rows rows)
pand_assoc_typed=pand (pand (x :pmatchResult) (y :pmatchResult)) (z :pmatchResult) = pand x (pand y z)
pand_def_typed=(∀(y :pmatchResult). pand PMatchSuccess y = y) ∧ (∀(y :pmatchResult). pand PMatchFailure y = if y = PTypeFailure then PTypeFailure else PMatchFailure) ∧ ∀(y :pmatchResult). pand PTypeFailure y = PTypeFailure
pand_eq_PMatchSuccess_typed=pand (x :pmatchResult) (y :pmatchResult) = PMatchSuccess ⇔ x = PMatchSuccess ∧ y = PMatchSuccess
pand_eq_PTypeFailure_typed=pand (x :pmatchResult) (y :pmatchResult) = PTypeFailure ⇔ x = PTypeFailure ∨ y = PTypeFailure
pand_simps_typed=pand PMatchSuccess (y :pmatchResult) = y ∧ pand (x :pmatchResult) PMatchSuccess = x ∧ pand PTypeFailure y = PTypeFailure ∧ pand x PTypeFailure = PTypeFailure
pat_weight_def_typed=pat_weight Any = (0 :num) ∧ (∀(l :lit). pat_weight (Lit l :pat) = (0 :num)) ∧ (∀(p :pat) (q :pat). pat_weight (Or p q :pat) = (1 :num) + pat_weight p + pat_weight q) ∧ (∀(p :pat). pat_weight (Ref p) = (1 :num) + pat_weight p) ∧ (∀(t :(num # (num # num) list option) option) (ps :pat list). pat_weight (Cons t ps) = (1 :num) + pats_weight ps) ∧ pats_weight ([] :pat list) = (0 :num) ∧ ∀(p :pat) (ps :pat list). pats_weight (p::ps) = pat_weight p + pats_weight ps
pats_weight_anys_typed=∀(n :num). pats_weight (anys n) = (0 :num)
pats_weight_append_typed=∀(xs :pat list) (ys :pat list). pats_weight (xs ++ ys) = pats_weight xs + pats_weight ys
pmatch_Any_typed=(pmatch (refs :num |-> term) Any (v :term) :pmatchResult) = PMatchSuccess
pmatch_list_LENGTH_typed=∀(ps :pat list) (vs :term list). (pmatch_list (refs :num |-> term) ps vs :pmatchResult) ≠ PTypeFailure ⇒ LENGTH ps = LENGTH vs
pmatch_list_anys_typed=∀(n :num) (as :term list) (refs :num |-> term). (pmatch_list refs (anys n) as :pmatchResult) = if LENGTH as = n then PMatchSuccess else PTypeFailure
pmatch_list_append_typed=∀(ps :pat list) (us :term list) (qs :pat list) (ws :term list) (refs :num |-> term). LENGTH ps = LENGTH us ⇒ (pmatch_list refs (ps ++ qs) (us ++ ws) :pmatchResult) = pand (pmatch_list refs ps us :pmatchResult) (pmatch_list refs qs ws :pmatchResult)
pmatch_list_cons_typed=(pmatch_list (refs :num |-> term) ((p :pat)::(ps :pat list)) ((v :term)::(vs :term list)) :pmatchResult) = pand (pmatch refs p v :pmatchResult) (pmatch_list refs ps vs :pmatchResult)
pmatch_list_nil_typed=(pmatch_list (refs :num |-> term) ([] :pat list) ([] :term list) :pmatchResult) = PMatchSuccess ∧ (pmatch_list refs ([] :pat list) ((v :term)::(vs :term list)) :pmatchResult) = PTypeFailure ∧ (pmatch_list refs ((p :pat)::(ps :pat list)) ([] :term list) :pmatchResult) = PTypeFailure
spec_mat_MEM_typed=∀(M :pat list list) (c :ctor) (as :term list) (refs :num |-> term) (v :term) (vs :term list) (row :pat list). dest_val refs v = SOME (c,as) ∧ MEM row (spec_mat c M) ⇒ ∃(r :pat list). MEM r M ∧ (pmatch_list refs row (as ++ vs) :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
spec_mat_def_typed=(∀(c :ctor). spec_mat c ([] :pat list list) = ([] :pat list list)) ∧ ∀(c :ctor) (r :pat list) (rows :pat list list). spec_mat c (r::rows) = spec_row c r ++ spec_mat c rows
spec_mats_def_typed=(∀(rows :pat list list). spec_mats ([] :ctor list) rows = ([] :pat list list list)) ∧ ∀(c :ctor) (cs :ctor list) (rows :pat list list). spec_mats (c::cs) rows = spec_mat c rows::spec_mats cs rows
spec_row_def_typed=spec_row (c :ctor) ([] :pat list) = ([] :pat list list) ∧ spec_row c (Any::(rest :pat list)) = [anys (ctor_arity c) ++ rest] ∧ spec_row c (Cons (NONE :(num # (num # num) list option) option) (qs :pat list)::rest) = (if c = TupC (LENGTH qs) then [qs ++ rest] else ([] :pat list list)) ∧ spec_row c (Cons (SOME (ts :num # (num # num) list option)) qs::rest) = (if c = TagC (FST ts) (LENGTH qs) then [qs ++ rest] else ([] :pat list list)) ∧ spec_row c (Ref (q :pat)::rest) = (if c = RefC then [q::rest] else ([] :pat list list)) ∧ spec_row c ((Lit (l :lit) :pat)::rest) = ([] :pat list list) ∧ spec_row c ((Or (p :pat) q :pat)::rest) = ([] :pat list list)
spec_row_thm_typed=∀(c :ctor) (r :pat list) (row :pat list) (refs :num |-> term) (v :term) (vs :term list) (as :term list). dest_val refs v = SOME (c,as) ∧ MEM row (spec_row c r) ⇒ (pmatch_list refs row (as ++ vs) :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
tag_ctors_def_typed=tag_ctors ([] :(num # num) list) = ([] :ctor list) ∧ ∀(t :num) (sibs :(num # num) list) (a :num). tag_ctors ((t,a)::sibs) = TagC t a::tag_ctors sibs
