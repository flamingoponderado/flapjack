fma_qnan_input=⊢ fp64_mul_add roundTiesToEven 0x3FF0000000000000w 0x3FF0000000000000w
    0x7FF8000000000000w =
  (float_some_qnan
     (FP_MulAdd roundTiesToEven
        <|Sign := 0w; Exponent := 1023w; Significand := 0w|>
        <|Sign := 0w; Exponent := 1023w; Significand := 0w|>
        <|Sign := 0w; Exponent := 2047w; Significand := 0x8000000000000w|>)).
  Sign @@ 2047w @@
