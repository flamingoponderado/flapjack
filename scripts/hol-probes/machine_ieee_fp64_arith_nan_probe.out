source_qnan_classification=⊢ ∀fp_op.
    (float_is_nan (float_some_qnan fp_op),
     float_is_signalling (float_some_qnan fp_op)) =
    (T,F)
add_qnan_input=⊢ fp64_add roundTiesToEven 0x7FF8000000000000w 0x3FF0000000000000w =
  (float_some_qnan
     (FP_Add roundTiesToEven
        <|Sign := 0w; Exponent := 2047w; Significand := 0x8000000000000w|>
        <|Sign := 0w; Exponent := 1023w; Significand := 0w|>)).Sign @@
  2047w @@
  (float_some_qnan
     (FP_Add roundTiesToEven
        <|Sign := 0w; Exponent := 2047w; Significand := 0x8000000000000w|>
        <|Sign := 0w; Exponent := 1023w; Significand := 0w|>)).Significand
