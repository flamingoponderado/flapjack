lu_ctx_DROP_DROP_EQ=⊢ ∀n m xs. DROP m (DROP n xs) = DROP (m + n) xs
lu_ctx_TAKE_TAKE_MIN=⊢ ∀xs m n. TAKE n (TAKE m xs) = TAKE (MIN m n) xs
lu_ctx_TAKE_DROP_EQ=⊢ ∀xs n m. TAKE m (DROP n xs) = DROP n (TAKE (m + n) xs)
lu_ctx_TAKE_LUPDATE=⊢ ∀xs n x i. TAKE n xs❲i ↦ x❳ = (TAKE n xs)❲i ↦ x❳
lu_ctx_DROP_LUPDATE_lemma1=⊢ ∀xs n m h. n ≤ m ⇒ DROP n xs❲m ↦ h❳ = (DROP n xs)❲m − n ↦ h❳
lu_ctx_DROP_LUPDATE_lemma2=⊢ ∀xs n m h. m < n ⇒ DROP n xs❲m ↦ h❳ = DROP n xs
lu_ctx_DROP_LUPDATE=⊢ ∀n h m xs. DROP n xs❲m ↦ h❳ = if m < n then DROP n xs else (DROP n xs)❲m − n ↦ h❳
lu_full_definition=⊢ (∀n ys. list_LUPDATE [] n ys = ys) ∧ ∀x xs n ys. list_LUPDATE (x::xs) n ys = list_LUPDATE xs (n + 1) ys❲n ↦ x❳
lu_full_LENGTH_list_LUPDATE=⊢ ∀xs n ys. LENGTH (list_LUPDATE xs n ys) = LENGTH ys
lu_full_TAKE_list_LUPDATE=⊢ ∀ys xs n i. TAKE n (list_LUPDATE ys i xs) = list_LUPDATE ys i (TAKE n xs)
lu_full_LLOOKUP_list_LUPDATE_IGNORE=⊢ ∀xs i n ys. i + LENGTH xs ≤ n ⇒ LLOOKUP (list_LUPDATE xs i ys) n = LLOOKUP ys n
lu_full_DROP_list_LUPDATE=⊢ ∀ys n m xs. n ≤ m ⇒ DROP n (list_LUPDATE ys m xs) = list_LUPDATE ys (m − n) (DROP n xs)
lu_full_DROP_list_LUPDATE_IGNORE=⊢ ∀xs i ys n. LENGTH xs + i ≤ n ⇒ DROP n (list_LUPDATE xs i ys) = DROP n ys
lu_full_list_LUPDATE_NIL=⊢ ∀xs i. list_LUPDATE xs i [] = []
lu_full_LUPDATE_TAKE_LEMMA=⊢ ∀xs n w. xs❲n ↦ w❳ = TAKE n xs ++ (DROP n xs)❲0 ↦ w❳
lu_full_list_LUPDATE_TAKE_DROP=⊢ ∀xs ys n. list_LUPDATE xs n ys = TAKE n ys ++ list_LUPDATE xs 0 (DROP n ys)
lu_full_list_LUPDATE_0_CONS=⊢ ∀xs x ys y. list_LUPDATE (x::xs) 0 (y::ys) = x::list_LUPDATE xs 0 ys
lu_full_list_LUPDATE_APPEND=⊢ ∀xs ys zs. LENGTH xs = LENGTH ys ⇒ list_LUPDATE xs 0 (ys ++ zs) = xs ++ zs
lu_output_0_0_0=⊢ list_LUPDATE [] 0 [] = [] ⇔ T
lu_laws_0_0_0=⊢ LENGTH (list_LUPDATE [] 0 []) = LENGTH [] ∧ TAKE 2 (list_LUPDATE [] 0 []) = list_LUPDATE [] 0 (TAKE 2 []) ∧ (LENGTH [] + 0 ≤ 2 ⇒ DROP 2 (list_LUPDATE [] 0 []) = DROP 2 []) ∧ (0 + LENGTH [] ≤ 2 ⇒ LLOOKUP (list_LUPDATE [] 0 []) 2 = LLOOKUP [] 2) ∧ (2 ≤ 0 ⇒ DROP 2 (list_LUPDATE [] 0 []) = list_LUPDATE [] (0 − 2) (DROP 2 [])) ∧ list_LUPDATE [] 0 [] = TAKE 0 [] ++ list_LUPDATE [] 0 (DROP 0 []) ⇔ T
