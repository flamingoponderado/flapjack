operator_global_flag=op_sets_globals (op :op) ⇔ op_gbag op ≠ ({||} :num -> num)
expression_global_flag=(∀(cfg :config) (x :exp). FST (SND (compile_exp cfg x)) ⇔ set_globals x ≠ ({||} :num -> num)) ∧ (∀(cfg :config) (xs :exp list). FST (SND (compile_exps cfg xs)) ⇔ elist_globals xs ≠ ({||} :num -> num)) ∧ ∀(cfg :config) (ps :(flatLang$pat # exp) list). FST (SND (compile_match cfg ps)) ⇔ elist_globals (MAP (SND :flatLang$pat # exp -> exp) ps) ≠ ({||} :num -> num)
tuple_global_flag=(∀(cfg :config) (x :exp) (i :num) (sg :bool) (y :exp). compile_exp cfg x = (i,sg,y) ⇒ (sg ⇔ set_globals x ≠ ({||} :num -> num))) ∧ (∀(cfg :config) (xs :exp list) (i :num) (sg :bool) (ys :exp list). compile_exps cfg xs = (i,sg,ys) ⇒ (sg ⇔ elist_globals xs ≠ ({||} :num -> num))) ∧ ∀(cfg :config) (ps :(flatLang$pat # exp) list) (i :num) (sg :bool) (ps2 :(flatLang$pat # exp) list). compile_match cfg ps = (i,sg,ps2) ⇒ (sg ⇔ elist_globals (MAP (SND :flatLang$pat # exp -> exp) ps) ≠ ({||} :num -> num))
global_bag_list_empty=elist_globals (l :exp list) = ({||} :num -> num) ⇔ ∀(e :exp). MEM e l ⇒ set_globals e = ({||} :num -> num)
sum_string_ords=sum_string_ords (i :num) (s :mlstring) = (SUM (MAP (λ(c :char). ORD c − (35 :num)) (DROP i (explode s))) :num)
generated_name_aux=∀(xs :string). dec_name_to_num (implode (enc_num_to_name_aux (i :num) xs)) = i + (SUM (MAP (λ(c :char). ORD c − (35 :num)) xs) :num)
generated_name_roundtrip=dec_name_to_num (enc_num_to_name (i :num)) = i
generated_name_injective=enc_num_to_name (i :num) = enc_num_to_name (j :num) ⇔ i = j
lookup_relation=∀(P :α -> bool) (R :β -> γ -> bool) (env1 :(α # β) list) (env2 :(α # γ) list). ALOOKUP_rel P R env1 env2 ⇔ ∀(x :α). P x ⇒ OPTREL R (ALOOKUP env1 x) (ALOOKUP env2 x)
lookup_relation_empty=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) ([] :(α # β) list) ([] :(α # γ) list)
lookup_relation_cons_false=(¬(P :α -> bool) (x :α) ⇒ (ALOOKUP_rel P (R :β -> β -> bool) ((x,(y :β))::(env1 :(α # β) list)) (env2 :(α # β) list) ⇔ ALOOKUP_rel P R env1 env2)) ∧ (¬P x ⇒ (ALOOKUP_rel P R env1 ((x,y)::env2) ⇔ ALOOKUP_rel P R env1 env2))
lookup_relation_append_false=EVERY ($¬ ∘ (P :α -> bool) ∘ (FST :α # β -> α)) (xs :(α # β) list) ⇒ (ALOOKUP_rel P (R :β -> γ -> bool) (xs ++ (ys :(α # β) list)) (zs :(α # γ) list) ⇔ ALOOKUP_rel P R ys zs)
lookup_relation_reflexive=(∀(x :α) (y :β). (P :α -> bool) x ∧ MEM (x,y) (xs :(α # β) list) ⇒ (R :β -> β -> bool) y y) ⇒ ALOOKUP_rel P R xs xs
lookup_relation_cons=((P :α -> bool) (x :α) ⇒ (R :β -> γ -> bool) (y :β) (z :γ)) ∧ ALOOKUP_rel P R (ys :(α # β) list) (zs :(α # γ) list) ⇒ ALOOKUP_rel P R ((x,y)::ys) ((x,z)::zs)
lookup_relation_mono=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) (xs :(α # β) list) (ys :(α # γ) list) ∧ (∀(x :α) (y :δ) (z :ε). (P' :α -> bool) x ⇒ P x) ∧ (∀(x :α) (y :β) (z :γ). P' x ∧ R y z ⇒ (R' :β -> γ -> bool) y z) ⇒ ALOOKUP_rel P' R' xs ys
lookup_relation_mono_rel=(∀(y :α) (z :β). (R :α -> β -> bool) y z ⇒ (R' :α -> β -> bool) y z) ⇒ ALOOKUP_rel (P :γ -> bool) R (xs :(γ # α) list) (ys :(γ # β) list) ⇒ ALOOKUP_rel P R' xs ys
lookup_relation_append=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) (xs1 :(α # β) list) (xs3 :(α # γ) list) ∧ ALOOKUP_rel P R (xs2 :(α # β) list) (xs4 :(α # γ) list) ⇒ ALOOKUP_rel P R (xs1 ++ xs2) (xs3 ++ xs4)
lookup_relation_equal=ALOOKUP_rel (P :α -> bool) ($= :β -> β -> bool) (xs :(α # β) list) (ys :(α # β) list) ∧ P (x :α) ⇒ ALOOKUP xs x = ALOOKUP ys x
lookup_relation_fst=∀(xs :(α # β) list) (ys :(α # γ) list). LIST_REL (λ(x :α # β) (y :α # γ). FST x = FST y ∧ ((P :α -> bool) (FST x) ⇒ (R :β -> γ -> bool) (SND x) (SND y))) xs ys ⇒ ALOOKUP_rel P R xs ys
environment_set_noop=(an_env :β environment) with v := (env :α environment).v = env
binding_fold_evaluation=∀(h :α -> v) (xs :α list). (∀(x :α). MEM x xs ⇒ IS_SOME ((f :α -> mlstring option) x)) ∧ (∀(x :β). IMAGE ((THE :mlstring option -> mlstring) ∘ f) (set xs) ⊆ (new_names :mlstring -> bool)) ∧ (∀(x :α). MEM x xs ⇒ ∀(env2 :v environment). ALOOKUP_rel (λ(x :mlstring). x ∉ new_names) ($= :v -> v -> bool) env2.v (env :v environment).v ⇒ (evaluate env2 (s :(γ, δ) state) [(g :α -> exp) x] :(γ, δ) state # (v list, v) result) = (s,(Rval [h x] :(v list, v) result))) ⇒ ∀(env2 :v environment). ALOOKUP_rel (λ(x :mlstring). x ∉ new_names) ($= :v -> v -> bool) env2.v env.v ⇒ (evaluate env2 s [FOLDR (λ(x :α) (exp :exp). (Let (t :tra) (f x) (g x) exp :exp)) (exp :exp) xs] :(γ, δ) state # (v list, v) result) = (evaluate (env2 with v := MAP (λ(x :α). (THE (f x),h x)) (REVERSE xs) ++ env2.v) s [exp] :(γ, δ) state # (v list, v) result)
every_mapi_simple=(∀(i :num) (j :num) (x :α). (P :β -> bool) ((f :num -> α -> β) i x) ⇔ P (f j x)) ⇒ (EVERY P (MAPi f (xs :α list)) ⇔ EVERY P (MAP (f (0 :num)) xs))
esgc_decode_pos=∀(p :position) (exp :exp). esgc_free exp ⇒ esgc_free (decode_pos (t :tra) exp p)
esgc_decode_test=esgc_free (exp :exp) ⇒ esgc_free (decode_test (t :tra) (d :dTest) exp)
esgc_decode_guard=esgc_free (exp :exp) ⇒ esgc_free (decode_guard (t :tra) exp (gd :dGuard))
esgc_bindings=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). esgc_free exp ∧ EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). esgc_free v_exp) n_bindings ⇒ esgc_free (SND (compile_pat_bindings t i n_bindings exp))
esgc_naive_match=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) xs) ⇒ esgc_free (naive_pattern_match t xs)
esgc_naive_matches=∀(t :tra) (x :exp) (xs :(flatLang$pat # exp) list) (dflt :exp). EVERY esgc_free (x::dflt::MAP (SND :flatLang$pat # exp -> exp) xs) ⇒ esgc_free (naive_pattern_matches t x xs dflt)
esgc_compile_pats=esgc_free (dflt :exp) ∧ EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) ⇒ esgc_free (compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) (Var_local (t' :tra) (nm :mlstring)) dflt ps)
globals_decode_pos=∀(p :position) (exp :exp). set_globals exp = ({||} :num -> num) ⇒ set_globals (decode_pos (t :tra) exp p) = ({||} :num -> num)
globals_decode_test=set_globals (exp :exp) = ({||} :num -> num) ⇒ set_globals (decode_test (t :tra) (d :dTest) exp) = ({||} :num -> num)
globals_decode_guard=set_globals (exp :exp) = ({||} :num -> num) ⇒ set_globals (decode_guard (t :tra) exp (gd :dGuard)) = ({||} :num -> num)
globals_bindings=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). set_globals v_exp = ({||} :num -> num)) n_bindings ⇒ set_globals (SND (compile_pat_bindings t i n_bindings exp)) = set_globals exp
globals_naive_match=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY (λ(v :flatLang$pat # exp). set_globals (SND v) = ({||} :num -> num)) xs ⇒ set_globals (naive_pattern_match t xs) = ({||} :num -> num)
globals_naive_matches=set_globals (x :exp) = ({||} :num -> num) ⇒ set_globals (naive_pattern_matches (t :tra) x (ps :(flatLang$pat # exp) list) (dflt :exp)) ≤ elist_globals (dflt::MAP (SND :flatLang$pat # exp -> exp) ps)
globals_compile_pats=(¬(naive :bool) ⇒ elist_globals ((dflt :exp)::MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) = ({||} :num -> num)) ∧ set_globals (x :exp) = ({||} :num -> num) ⇒ set_globals (compile_pats (cfg :config) naive (t :tra) (N :num) x dflt ps) ≤ elist_globals (dflt::MAP (SND :flatLang$pat # exp -> exp) ps)
