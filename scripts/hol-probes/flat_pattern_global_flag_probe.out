operator_global_flag=op_sets_globals (op :op) ⇔ op_gbag op ≠ ({||} :num -> num)
expression_global_flag=(∀(cfg :config) (x :exp). FST (SND (compile_exp cfg x)) ⇔ set_globals x ≠ ({||} :num -> num)) ∧ (∀(cfg :config) (xs :exp list). FST (SND (compile_exps cfg xs)) ⇔ elist_globals xs ≠ ({||} :num -> num)) ∧ ∀(cfg :config) (ps :(flatLang$pat # exp) list). FST (SND (compile_match cfg ps)) ⇔ elist_globals (MAP (SND :flatLang$pat # exp -> exp) ps) ≠ ({||} :num -> num)
tuple_global_flag=(∀(cfg :config) (x :exp) (i :num) (sg :bool) (y :exp). compile_exp cfg x = (i,sg,y) ⇒ (sg ⇔ set_globals x ≠ ({||} :num -> num))) ∧ (∀(cfg :config) (xs :exp list) (i :num) (sg :bool) (ys :exp list). compile_exps cfg xs = (i,sg,ys) ⇒ (sg ⇔ elist_globals xs ≠ ({||} :num -> num))) ∧ ∀(cfg :config) (ps :(flatLang$pat # exp) list) (i :num) (sg :bool) (ps2 :(flatLang$pat # exp) list). compile_match cfg ps = (i,sg,ps2) ⇒ (sg ⇔ elist_globals (MAP (SND :flatLang$pat # exp -> exp) ps) ≠ ({||} :num -> num))
global_bag_list_empty=elist_globals (l :exp list) = ({||} :num -> num) ⇔ ∀(e :exp). MEM e l ⇒ set_globals e = ({||} :num -> num)
