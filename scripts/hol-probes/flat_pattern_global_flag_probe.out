no_mat_decode_pos=∀(p :position) (exp :exp). no_Mat exp ⇒ no_Mat (decode_pos (t :tra) exp p)
no_mat_decode_test=no_Mat (exp :exp) ⇒ no_Mat (decode_test (t :tra) (d :dTest) exp)
no_mat_decode_guard=no_Mat (exp :exp) ⇒ no_Mat (decode_guard (t :tra) exp (gd :dGuard))
no_mat_compile_bindings=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). no_Mat exp ∧ EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). no_Mat v_exp) n_bindings ⇒ no_Mat (SND (compile_pat_bindings t i n_bindings exp))
no_mat_naive_match=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY (no_Mat ∘ (SND :flatLang$pat # exp -> exp)) xs ⇒ no_Mat (naive_pattern_match t xs)
no_mat_naive_matches=∀(t :tra) (x :exp) (xs :(flatLang$pat # exp) list) (dflt :exp). EVERY no_Mat (x::dflt::MAP (SND :flatLang$pat # exp -> exp) xs) ⇒ no_Mat (naive_pattern_matches t x xs dflt)
no_mat_compile_pats=no_Mat (dflt :exp) ∧ no_Mat (x :exp) ∧ EVERY no_Mat (MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) ⇒ no_Mat (compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) x dflt ps)
globals_decode_dtree=set_globals (x :exp) = ({||} :num -> num) ∧ set_globals (dflt :exp) = ({||} :num -> num) ∧ EVERY (λ(y :exp). set_globals y = ({||} :num -> num)) (toList (br_spt :exp sptree$num_map) :exp list) ⇒ set_globals (decode_dtree (t :tra) br_spt x dflt (dtree :dTree)) = ({||} :num -> num)
set_toList_fromList=set (toList (fromList (xs :α list) :α sptree$num_map) :α list) = set xs
no_mat_decode_dtree=no_Mat (v_exp :exp) ∧ no_Mat (dflt :exp) ∧ EVERY no_Mat (toList (br_spt :exp sptree$num_map) :exp list) ⇒ no_Mat (decode_dtree (t :tra) br_spt v_exp dflt (dtree :dTree))
esgc_decode_dtree=esgc_free (v_exp :exp) ∧ esgc_free (dflt :exp) ∧ EVERY (λ(y :exp). esgc_free y) (toList (br_spt :exp sptree$num_map) :exp list) ⇒ esgc_free (decode_dtree (t :tra) br_spt v_exp dflt (dtree :dTree))
operator_global_flag=op_sets_globals (op :op) ⇔ op_gbag op ≠ ({||} :num -> num)
operator_sets_globals_def=(op_sets_globals (GlobalVarInit (n :num)) ⇔ T) ∧ (op_sets_globals (Src (v :ast$op)) ⇔ F) ∧ (op_sets_globals (GlobalVarAlloc (v1 :num)) ⇔ F) ∧ (op_sets_globals (GlobalVarLookup (v3 :num)) ⇔ F) ∧ (op_sets_globals (TagLenEq (v4 :num) (v5 :num) :op) ⇔ F) ∧ (op_sets_globals (LenEq (v6 :num)) ⇔ F) ∧ (op_sets_globals (El (v7 :num)) ⇔ F) ∧ (op_sets_globals Id ⇔ F)
singleton_global_bag=∀(n :num). op_gbag (GlobalVarInit n) = (λ(x :num). if x = n then (1 :num) else (0 :num))
expression_global_flag=(∀(cfg :config) (x :exp). FST (SND (compile_exp cfg x)) ⇔ set_globals x ≠ ({||} :num -> num)) ∧ (∀(cfg :config) (xs :exp list). FST (SND (compile_exps cfg xs)) ⇔ elist_globals xs ≠ ({||} :num -> num)) ∧ ∀(cfg :config) (ps :(flatLang$pat # exp) list). FST (SND (compile_match cfg ps)) ⇔ elist_globals (MAP (SND :flatLang$pat # exp -> exp) ps) ≠ ({||} :num -> num)
tuple_global_flag=(∀(cfg :config) (x :exp) (i :num) (sg :bool) (y :exp). compile_exp cfg x = (i,sg,y) ⇒ (sg ⇔ set_globals x ≠ ({||} :num -> num))) ∧ (∀(cfg :config) (xs :exp list) (i :num) (sg :bool) (ys :exp list). compile_exps cfg xs = (i,sg,ys) ⇒ (sg ⇔ elist_globals xs ≠ ({||} :num -> num))) ∧ ∀(cfg :config) (ps :(flatLang$pat # exp) list) (i :num) (sg :bool) (ps2 :(flatLang$pat # exp) list). compile_match cfg ps = (i,sg,ps2) ⇒ (sg ⇔ elist_globals (MAP (SND :flatLang$pat # exp -> exp) ps) ≠ ({||} :num -> num))
fst_snd_eq_case_typed=(FST :α # β -> α) = (λ((a :α),(b :β)). a) ∧ (SND :γ # δ -> δ) = (λ((a :γ),(b :δ)). b)
sub_bag_2_typed=(x :α -> num) ≤ (y :α -> num) ∧ (x' :α -> num) ≤ (y' :α -> num) ⇒ x ⊎ x' ≤ y ⊎ y'
inv_on_foldr_typed=∀(f :α -> β). (∀(x :γ) (v :α). MEM x (xs :γ list) ⇒ f ((g :γ -> α -> α) x v) = f v) ⇒ f (FOLDR g (v :α) xs) = f v
evaluate_decs_sing_typed=(evaluate_decs (s :(α, β) state) [(d :exp)] :(α, β) state # v error_result option) = evaluate_dec s d
option_all_forall_typed=OPTION_ALL (P :α -> bool) (x :α option) ⇔ ∀(y :α). x = SOME y ⇒ P y
smart_if_thm_typed=SmartIf (t :tra) (e :exp) (p :exp) (q :exp) = if ∃(t :tra). e = Bool t T then p else if ∃(t :tra). e = Bool t F then q else (If t e p q :exp)
do_eq_boolv_typed=do_eq (Boolv (x :bool) :v) (Boolv (y :bool) :v) = Eq_val (x ⇔ y)
fold_boolv_typed=(∀(b :bool). Conv (SOME (bool_to_tag b,SOME bool_id)) ([] :v list) = (Boolv b :v)) ∧ ∀(b :bool). (if b then true_tag else false_tag) = bool_to_tag b
max_list_less_every_typed=MAX_LIST (xs :num list) < (N :num) ⇔ (0 :num) < N ∧ EVERY (λ(x :num). x < N) xs
do_if_helper_typed=do_if (b :v) (x :α) (y :α) = SOME (e :α) ∧ v_rel b (b' :v) ⇒ (b' = (Boolv T :v) ⇔ b = (Boolv T :v)) ∧ (b' = (Boolv F :v) ⇔ b = (Boolv F :v))
do_app_thm_reverse_typed=do_app (s1 :(α, β) state) (op :op) (REVERSE (vs1 :v list)) = SOME ((t1 :(α, β) state),(r1 :(v, v) result)) ∧ state_rel (cfg :config) s1 (s2 :(α, β) state) ∧ LIST_REL v_rel vs1 (vs2 :v list) ⇒ ∃(t2 :(α, β) state) (r2 :(v, v) result). result_rel v_rel v_rel r1 r2 ∧ state_rel cfg t1 t2 ∧ do_app s2 op (REVERSE vs2) = SOME (t2,r2)
global_bag_list_empty=elist_globals (l :exp list) = ({||} :num -> num) ⇔ ∀(e :exp). MEM e l ⇒ set_globals e = ({||} :num -> num)
sum_string_ords=sum_string_ords (i :num) (s :mlstring) = (SUM (MAP (λ(c :char). ORD c − (35 :num)) (DROP i (explode s))) :num)
sum_string_ords_def=∀(str :mlstring) (i :num). sum_string_ords i str = if i < strlen str then ORD (strsub str i) − (35 :num) + sum_string_ords (i + (1 :num)) str else (0 :num)
dec_name_to_num_def=∀(name :mlstring). dec_name_to_num name = if strlen name < (2 :num) then (0 :num) else if strsub name (0 :num) = #"." ∧ strsub name (1 :num) = #"." then sum_string_ords (2 :num) name else (0 :num)
dec_name_to_num_explode=∀(name :mlstring). dec_name_to_num name = case explode name of ("" :string) => (0 :num) | STRING a ("" :string) => (0 :num) | STRING a (STRING b rest) => if a = #"." ∧ b = #"." then sum_string_ords (2 :num) name else (0 :num)
dot_ord=ORD #"." = (46 :num)
enc_num_to_name_aux_def=∀(xs :string) (i :num). enc_num_to_name_aux i xs = if i < (90 :num) then STRING #"." (STRING #"." (STRING (CHR (i + (35 :num))) xs)) else enc_num_to_name_aux (i − (90 :num)) (STRING #"}" xs)
enc_num_to_name_def=∀(i :num). enc_num_to_name i = implode (enc_num_to_name_aux i ("" :string))
generated_name_aux=∀(xs :string). dec_name_to_num (implode (enc_num_to_name_aux (i :num) xs)) = i + (SUM (MAP (λ(c :char). ORD c − (35 :num)) xs) :num)
generated_name_roundtrip=dec_name_to_num (enc_num_to_name (i :num)) = i
generated_name_injective=enc_num_to_name (i :num) = enc_num_to_name (j :num) ⇔ i = j
list_rel_alookup_optrel=∀(xs :(α # β) list) (ys :(α # γ) list). LIST_REL (R :α # β -> α # γ -> bool) xs ys ∧ (∀(x :α # β) (y :α # γ). R x y ∧ MEM x xs ∧ MEM y ys ∧ ((v :α) = FST x ∨ v = FST y) ⇒ FST x = FST y ∧ (R2 :β -> γ -> bool) (SND x) (SND y)) ⇒ OPTREL R2 (ALOOKUP xs v) (ALOOKUP ys v)
list_rel_alookup=∀(xs :(α # β) list) (ys :(α # β) list). LIST_REL (R :α # β -> α # β -> bool) xs ys ∧ (∀(x :α # β) (y :α # β). R x y ∧ MEM x xs ∧ MEM y ys ∧ ((v :α) = FST x ∨ v = FST y) ⇒ x = y) ⇒ ALOOKUP xs v = ALOOKUP ys v
list_rel_filter_mono=∀(xs :α list) (ys :β list). LIST_REL (R :α -> β -> bool) (FILTER (P1 :α -> bool) xs) (FILTER (P2 :β -> bool) ys) ∧ (∀(x :α). MEM x xs ∧ (P3 :α -> bool) x ⇒ P1 x) ∧ (∀(y :β). MEM y ys ∧ (P4 :β -> bool) y ⇒ P2 y) ∧ (∀(x :α) (y :β). MEM x xs ∧ MEM y ys ∧ R x y ⇒ (P3 x ⇔ P4 y)) ⇒ LIST_REL R (FILTER P3 xs) (FILTER P4 ys)
cond_false=¬(P :bool) ⇒ (if P then (x :α) else (y :α)) = y
cond_true=(P :bool) ⇒ (if P then (x :α) else (y :α)) = x
filter_eq_mono=∀(xs :α list) (ys :α list). FILTER (P1 :α -> bool) xs = FILTER (P2 :α -> bool) ys ∧ (∀(x :α). MEM x xs ∧ (P3 :α -> bool) x ⇒ P1 x) ∧ (∀(y :α). MEM y ys ∧ (P4 :α -> bool) y ⇒ P2 y) ∧ (∀(x :α) (y :α). MEM x xs ∧ MEM y ys ∧ x = y ⇒ (P3 x ⇔ P4 y)) ⇒ FILTER P3 xs = FILTER P4 ys
filter_eq_mono_trans=∀(xs :α list) (ys :α list). FILTER (P1 :α -> bool) xs = ys ∧ (∀(x :α). MEM x xs ∧ (P3 :α -> bool) x ⇒ P1 x) ∧ (∀(x :α) (y :α). MEM x xs ∧ MEM y ys ∧ x = y ⇒ (P3 x ⇔ P3 y)) ⇒ FILTER P3 xs = FILTER P3 ys
filter_eq_alookup_eq=∀(xs :(α # β) list) (ys :(α # β) list). FILTER (P :α # β -> bool) xs = ys ∧ (∀(z :β). P ((x :α),z)) ⇒ ALOOKUP xs x = ALOOKUP ys x
alookup_filter_eq=∀(xs :(α # β) list). (∀(z :β). (P :α # β -> bool) ((x :α),z)) ⇒ ALOOKUP (FILTER P xs) x = ALOOKUP xs x
enumerate_def=(∀(n :num). (enumerate n ([] :α list) :(num # α) list) = ([] :(num # α) list)) ∧ ∀(n :num) (x :α) (xs :α list). (enumerate n (x::xs) :(num # α) list) = (n,x)::(enumerate (n + (1 :num)) xs :(num # α) list)
mem_enumerate_el=∀(xs :α list) (i :num) (x :num # α). MEM x (enumerate i xs :(num # α) list) ⇔ ∃(j :num). j < LENGTH xs ∧ x = (i + j,xs❲j❳)
all_distinct_enumerate=∀(xs :α list) (i :num). ALL_DISTINCT (enumerate i xs :(num # α) list)
pure_eval_to_def=∀(s :(α, β) state) (env :v environment) (exp :exp) (v :v). pure_eval_to s env exp v ⇔ (evaluate env s [exp] :(α, β) state # (v list, v) result) = (s,(Rval [v] :(v list, v) result))
append_length_eq=∀(xs :α list) (xs' :α list). LENGTH xs = LENGTH xs' ⇒ (xs ++ (ys :α list) = xs' ++ (ys' :α list) ⇔ xs = xs' ∧ ys = ys')
pmatch_list_append_match=(pmatch_list (s :(α, β) state) ((xs :flatLang$pat list) ++ (ys :flatLang$pat list)) (vs :v list) (pre_bindings :(mlstring # v) list) :(mlstring # v) list match_result) = Match (bindings :(mlstring # v) list) ⇔ ∃(vs1 :v list) (vs2 :v list) (bindings1 :(mlstring # v) list). vs = vs1 ++ vs2 ∧ (pmatch_list s xs vs1 pre_bindings :(mlstring # v) list match_result) = Match bindings1 ∧ (pmatch_list s ys vs2 bindings1 :(mlstring # v) list match_result) = Match bindings
alookup_def=(∀(q :β). ALOOKUP ([] :(β # α) list) q = (NONE :α option)) ∧ ∀(y :α) (x :β) (t :(β # α) list) (q :β). ALOOKUP ((x,y)::t) q = if x = q then SOME y else ALOOKUP t q
alookup_reversed_eq=(∀(q :α). ALOOKUP ([] :(α # β) list) q = (NONE :β option)) ∧ ∀(x :α) (y :β) (t :(α # β) list) (q :α). ALOOKUP ((x,y)::t) q = if q = x then SOME y else ALOOKUP t q
optrel_def=∀(R :α -> β -> bool) (x :α option) (y :β option). OPTREL R x y ⇔ x = (NONE :α option) ∧ y = (NONE :β option) ∨ ∃(x0 :α) (y0 :β). x = SOME x0 ∧ y = SOME y0 ∧ R x0 y0
optrel_clauses=(∀(R :α -> β -> bool). OPTREL R (NONE :α option) (NONE :β option)) ∧ (∀(R :α -> β -> bool) (x :α) (y :β). OPTREL R (SOME x) (SOME y) ⇔ R x y) ∧ (∀(R :α -> β -> bool) (x :α). ¬OPTREL R (SOME x) (NONE :β option)) ∧ ∀(R :α -> β -> bool) (y :β). ¬OPTREL R (NONE :α option) (SOME y)
lookup_relation=∀(P :α -> bool) (R :β -> γ -> bool) (env1 :(α # β) list) (env2 :(α # γ) list). ALOOKUP_rel P R env1 env2 ⇔ ∀(x :α). P x ⇒ OPTREL R (ALOOKUP env1 x) (ALOOKUP env2 x)
lookup_relation_empty=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) ([] :(α # β) list) ([] :(α # γ) list)
lookup_relation_cons_false=(¬(P :α -> bool) (x :α) ⇒ (ALOOKUP_rel P (R :β -> β -> bool) ((x,(y :β))::(env1 :(α # β) list)) (env2 :(α # β) list) ⇔ ALOOKUP_rel P R env1 env2)) ∧ (¬P x ⇒ (ALOOKUP_rel P R env1 ((x,y)::env2) ⇔ ALOOKUP_rel P R env1 env2))
lookup_relation_append_false=EVERY ($¬ ∘ (P :α -> bool) ∘ (FST :α # β -> α)) (xs :(α # β) list) ⇒ (ALOOKUP_rel P (R :β -> γ -> bool) (xs ++ (ys :(α # β) list)) (zs :(α # γ) list) ⇔ ALOOKUP_rel P R ys zs)
lookup_relation_reflexive=(∀(x :α) (y :β). (P :α -> bool) x ∧ MEM (x,y) (xs :(α # β) list) ⇒ (R :β -> β -> bool) y y) ⇒ ALOOKUP_rel P R xs xs
lookup_relation_cons=((P :α -> bool) (x :α) ⇒ (R :β -> γ -> bool) (y :β) (z :γ)) ∧ ALOOKUP_rel P R (ys :(α # β) list) (zs :(α # γ) list) ⇒ ALOOKUP_rel P R ((x,y)::ys) ((x,z)::zs)
lookup_relation_mono=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) (xs :(α # β) list) (ys :(α # γ) list) ∧ (∀(x :α) (y :δ) (z :ε). (P' :α -> bool) x ⇒ P x) ∧ (∀(x :α) (y :β) (z :γ). P' x ∧ R y z ⇒ (R' :β -> γ -> bool) y z) ⇒ ALOOKUP_rel P' R' xs ys
lookup_relation_mono_rel=(∀(y :α) (z :β). (R :α -> β -> bool) y z ⇒ (R' :α -> β -> bool) y z) ⇒ ALOOKUP_rel (P :γ -> bool) R (xs :(γ # α) list) (ys :(γ # β) list) ⇒ ALOOKUP_rel P R' xs ys
lookup_relation_append=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) (xs1 :(α # β) list) (xs3 :(α # γ) list) ∧ ALOOKUP_rel P R (xs2 :(α # β) list) (xs4 :(α # γ) list) ⇒ ALOOKUP_rel P R (xs1 ++ xs2) (xs3 ++ xs4)
lookup_relation_equal=ALOOKUP_rel (P :α -> bool) ($= :β -> β -> bool) (xs :(α # β) list) (ys :(α # β) list) ∧ P (x :α) ⇒ ALOOKUP xs x = ALOOKUP ys x
lookup_relation_fst=∀(xs :(α # β) list) (ys :(α # γ) list). LIST_REL (λ(x :α # β) (y :α # γ). FST x = FST y ∧ ((P :α -> bool) (FST x) ⇒ (R :β -> γ -> bool) (SND x) (SND y))) xs ys ⇒ ALOOKUP_rel P R xs ys
environment_set_noop=(an_env :β environment) with v := (env :α environment).v = env
sptree_lookup=(∀(k :num). lookup k (LN :α sptree$num_map) = (NONE :α option)) ∧ (∀(k :num) (a :α). lookup k ⦕ 0 ↦ a ⦖ = if k = (0 :num) then SOME a else (NONE :α option)) ∧ (∀(t2 :α sptree$num_map) (t1 :α sptree$num_map) (k :num). lookup k (BN t1 t2) = if k = (0 :num) then (NONE :α option) else lookup ((k − (1 :num)) DIV (2 :num)) (if EVEN k then t1 else t2)) ∧ ∀(t2 :α sptree$num_map) (t1 :α sptree$num_map) (k :num) (a :α). lookup k (BS t1 a t2) = if k = (0 :num) then SOME a else lookup ((k − (1 :num)) DIV (2 :num)) (if EVEN k then t1 else t2)
sptree_insert=(∀(k :num) (a :α). insert k a (LN :α sptree$num_map) = if k = (0 :num) then ⦕ 0 ↦ a ⦖ else if EVEN k then BN (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α sptree$num_map)) (LN :α sptree$num_map) else BN (LN :α sptree$num_map) (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α sptree$num_map))) ∧ (∀(k :num) (a' :α) (a :α). insert k a ⦕ 0 ↦ a' ⦖ = if k = (0 :num) then ⦕ 0 ↦ a ⦖ else if EVEN k then BS (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α sptree$num_map)) a' (LN :α sptree$num_map) else BS (LN :α sptree$num_map) a' (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α sptree$num_map))) ∧ (∀(t2 :α sptree$num_map) (t1 :α sptree$num_map) (k :num) (a :α). insert k a (BN t1 t2) = if k = (0 :num) then BS t1 a t2 else if EVEN k then BN (insert ((k − (1 :num)) DIV (2 :num)) a t1) t2 else BN t1 (insert ((k − (1 :num)) DIV (2 :num)) a t2)) ∧ ∀(t2 :α sptree$num_map) (t1 :α sptree$num_map) (k :num) (a' :α) (a :α). insert k a (BS t1 a' t2) = if k = (0 :num) then BS t1 a t2 else if EVEN k then BS (insert ((k − (1 :num)) DIV (2 :num)) a t1) a' t2 else BS t1 a' (insert ((k − (1 :num)) DIV (2 :num)) a t2)
sptree_domain_lookup=∀(t :α sptree$num_map) (k :num). k ∈ (domain t :num -> bool) ⇔ ∃(v :α). lookup k t = SOME v
sptree_even_mod2=∀(x :num). EVEN x ⇔ x MOD (2 :num) = (0 :num)
sptree_domain=(domain (LN :α sptree$num_map) :num -> bool) = (∅ :num -> bool) ∧ (∀(v0 :α). (domain ⦕ 0 ↦ v0 ⦖ :num -> bool) = {(0 :num)}) ∧ (∀(t1 :α sptree$num_map) (t2 :α sptree$num_map). (domain (BN t1 t2) :num -> bool) = IMAGE (λ(n :num). (2 :num) * n + (2 :num)) (domain t1 :num -> bool) ∪ IMAGE (λ(n :num). (2 :num) * n + (1 :num)) (domain t2 :num -> bool)) ∧ ∀(t1 :α sptree$num_map) (v1 :α) (t2 :α sptree$num_map). (domain (BS t1 v1 t2) :num -> bool) = {(0 :num)} ∪ IMAGE (λ(n :num). (2 :num) * n + (2 :num)) (domain t1 :num -> bool) ∪ IMAGE (λ(n :num). (2 :num) * n + (1 :num)) (domain t2 :num -> bool)
sptree_domain_is_some=∀(t :α sptree$num_map). (domain t :num -> bool) = {k | IS_SOME (lookup k t)}
sptree_lookup_distributed=(∀(k :num) (t1 :α sptree$num_map) (t2 :α sptree$num_map). lookup k (BN t1 t2) = if k = (0 :num) then (NONE :α option) else if k MOD (2 :num) = (0 :num) then lookup ((k − (1 :num)) DIV (2 :num)) t1 else lookup ((k − (1 :num)) DIV (2 :num)) t2) ∧ ∀(k :num) (a :β) (t1 :β sptree$num_map) (t2 :β sptree$num_map). lookup k (BS t1 a t2) = if k = (0 :num) then SOME a else if k MOD (2 :num) = (0 :num) then lookup ((k − (1 :num)) DIV (2 :num)) t1 else lookup ((k − (1 :num)) DIV (2 :num)) t2
binding_fold_evaluation=∀(h :α -> v) (xs :α list). (∀(x :α). MEM x xs ⇒ IS_SOME ((f :α -> mlstring option) x)) ∧ (∀(x :β). IMAGE ((THE :mlstring option -> mlstring) ∘ f) (set xs) ⊆ (new_names :mlstring -> bool)) ∧ (∀(x :α). MEM x xs ⇒ ∀(env2 :v environment). ALOOKUP_rel (λ(x :mlstring). x ∉ new_names) ($= :v -> v -> bool) env2.v (env :v environment).v ⇒ (evaluate env2 (s :(γ, δ) state) [(g :α -> exp) x] :(γ, δ) state # (v list, v) result) = (s,(Rval [h x] :(v list, v) result))) ⇒ ∀(env2 :v environment). ALOOKUP_rel (λ(x :mlstring). x ∉ new_names) ($= :v -> v -> bool) env2.v env.v ⇒ (evaluate env2 s [FOLDR (λ(x :α) (exp :exp). (Let (t :tra) (f x) (g x) exp :exp)) (exp :exp) xs] :(γ, δ) state # (v list, v) result) = (evaluate (env2 with v := MAP (λ(x :α). (THE (f x),h x)) (REVERSE xs) ++ env2.v) s [exp] :(γ, δ) state # (v list, v) result)
every_mapi_simple=(∀(i :num) (j :num) (x :α). (P :β -> bool) ((f :num -> α -> β) i x) ⇔ P (f j x)) ⇒ (EVERY P (MAPi f (xs :α list)) ⇔ EVERY P (MAP (f (0 :num)) xs))
compile_pat_bindings_def=(∀(v1 :num) (v0 :tra) (exp :exp). compile_pat_bindings v0 v1 ([] :(flatLang$pat # num # exp) list) exp = ((LN :sptree$num_set),exp)) ∧ (∀(v3 :exp) (v2 :num) (t :tra) (m :(flatLang$pat # num # exp) list) (i :num) (exp :exp). compile_pat_bindings t i ((Pany,v2,v3)::m) exp = compile_pat_bindings t i m exp) ∧ (∀(x :exp) (t :tra) (s :mlstring) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i (((Pvar s :flatLang$pat),k,x)::m) exp = (let ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t i m exp in (insert k () spt,(Let t (SOME s) x exp2 :exp)))) ∧ (∀(v6 :exp) (v5 :num) (v4 :lit) (t :tra) (m :(flatLang$pat # num # exp) list) (i :num) (exp :exp). compile_pat_bindings t i (((Plit v4 :flatLang$pat),v5,v6)::m) exp = compile_pat_bindings t i m exp) ∧ (∀(x :exp) (v7 :(num # (num # (num # num) list) option) option) (t :tra) (ps :flatLang$pat list) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i ((Pcon v7 ps,k,x)::m) exp = (let (j_nms :((num # mlstring) # flatLang$pat # num # exp) list) = MAP (λ((j :num),(p :flatLang$pat)). (let (k :num) = i + (1 :num) + j; (nm :mlstring) = enc_num_to_name k in ((j,nm),p,k,Var_local t nm))) (enumerate (0 :num) ps :(num # flatLang$pat) list); ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t (i + (2 :num) + LENGTH ps) (MAP (SND :(num # mlstring) # flatLang$pat # num # exp -> flatLang$pat # num # exp) j_nms ++ m) exp; (j_nms_used :((num # mlstring) # flatLang$pat # num # exp) list) = FILTER (λ((_1 :num # mlstring),(_2 :flatLang$pat),(k :num),(_3 :exp)). IS_SOME (lookup k spt)) j_nms; (exp3 :exp) = FOLDR (λ(((j :num),(nm :mlstring)),(_0 :flatLang$pat # num # exp)) (exp :exp). (Let t (SOME nm) (App t (El j) [x] :exp) exp :exp)) exp2 j_nms_used; (spt2 :sptree$num_set) = if NULL j_nms_used then spt else insert k () spt in (spt2,exp3))) ∧ (∀(x :exp) (v :mlstring) (t :tra) (p :flatLang$pat) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i ((Pas p v,k,x)::m) exp = (let (nm :mlstring) = enc_num_to_name (i + (1 :num)); ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t (i + (2 :num)) ((p,i + (1 :num),Var_local t nm)::m) exp in (insert k () spt,(Let t (SOME v) x (Let t (SOME nm) (Var_local t v) exp2 :exp) :exp)))) ∧ ∀(x :exp) (t :tra) (p :flatLang$pat) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i ((Pref p,k,x)::m) exp = (let (nm :mlstring) = enc_num_to_name (i + (1 :num)); ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t (i + (2 :num)) ((p,i + (1 :num),Var_local t nm)::m) exp in (insert k () spt,(Let t (SOME nm) (App t (El (0 :num)) [x] :exp) exp2 :exp)))
compile_pat_rhs_def=∀(t :tra) (i :num) (v :exp) (p :flatLang$pat) (exp :exp). compile_pat_rhs t i v (p,exp) = SND (compile_pat_bindings t (i + (1 :num)) [(p,i,v)] exp)
compile_pat_bindings_simulation=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp) (exp2 :exp) (spt :sptree$num_set) (s :(α, β) state) (vs :v list) (pre_bindings :(mlstring # v) list) (bindings :(mlstring # v) list) (env :v environment) (s2 :(α, β) state) (res :(v list, v) result) (vset :γ). compile_pat_bindings t i n_bindings exp = (spt,exp2) ∧ (pmatch_list s (MAP (FST :flatLang$pat # num # exp -> flatLang$pat) n_bindings) vs pre_bindings :(mlstring # v) list match_result) = Match bindings ∧ (evaluate env s [exp2] :(α, β) state # (v list, v) result) = (s2,res) ∧ LIST_REL (λ((_0 :flatLang$pat),(k :num),(v_exp :exp)) (v :v). ∀(env2 :v environment). k ∈ (domain spt :num -> bool) ∧ ALOOKUP_rel ((λ(k :num). k > (j :num) ∧ k < i) ∘ dec_name_to_num) ($= :v -> v -> bool) env2.v env.v ⇒ pure_eval_to s env2 v_exp v) n_bindings vs ∧ EVERY ((λ(k :num). k < j) ∘ dec_name_to_num ∘ (FST :mlstring # v -> mlstring)) pre_bindings ∧ j < i ∧ ALOOKUP_rel ((λ(k :num). k < j) ∘ dec_name_to_num) ($= :v -> v -> bool) env.v (pre_bindings ++ (base_vs :(mlstring # v) list)) ∧ EVERY (λ((p :flatLang$pat),(k :num),(_1 :exp)). EVERY (λ(nm :mlstring). dec_name_to_num nm < j) (pat_bindings p) ∧ j < k ∧ k < i) n_bindings ⇒ ∃(env2 :v environment). (evaluate env2 s [exp] :(α, β) state # (v list, v) result) = (s2,res) ∧ ALOOKUP_rel ((λ(k :num). k < j) ∘ dec_name_to_num) ($= :v -> v -> bool) env2.v (bindings ++ base_vs)
value_relation_left_cases=(v_rel (Litv (l :lit) :v) (v2 :v) ⇔ v2 = (Litv l :v) ∧ v_container_xs v2 = ([] :v list)) ∧ (v_rel (Conv (o' :(num # num option) option) (l :v list)) v2 ⇔ (∃(vs2 :v list). v2 = Conv o' vs2) ∧ LIST_REL v_rel l (v_container_xs v2)) ∧ (v_rel (Closure (e :v environment) (m :mlstring) (e0 :exp) :v) v2 ⇔ ∃(N :num) (env2 :v environment) (cfg :config). v2 = (Closure env2 m (SND (SND (compile_exp cfg e0))) :v) ∧ env_rel N e env2 ∧ FST (compile_exp cfg e0) < N) ∧ (v_rel (Recclosure e (l :(mlstring # mlstring # exp) list) m :v) v2 ⇔ ∃(N :num) (env2 :v environment) (cfg :config). v2 = (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) l) m :v) ∧ env_rel N e env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) l) ∧ (v_rel (Loc (b :bool) (n :num) :v) v2 ⇔ v2 = (Loc b n :v) ∧ v_container_xs v2 = ([] :v list)) ∧ (v_rel (Vectorv l) v2 ⇔ (∃(vs2 :v list). v2 = Vectorv vs2) ∧ LIST_REL v_rel l (v_container_xs v2))
esgc_decode_pos=∀(p :position) (exp :exp). esgc_free exp ⇒ esgc_free (decode_pos (t :tra) exp p)
esgc_decode_test=esgc_free (exp :exp) ⇒ esgc_free (decode_test (t :tra) (d :dTest) exp)
esgc_decode_guard=esgc_free (exp :exp) ⇒ esgc_free (decode_guard (t :tra) exp (gd :dGuard))
esgc_bindings=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). esgc_free exp ∧ EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). esgc_free v_exp) n_bindings ⇒ esgc_free (SND (compile_pat_bindings t i n_bindings exp))
esgc_naive_match=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) xs) ⇒ esgc_free (naive_pattern_match t xs)
esgc_naive_matches=∀(t :tra) (x :exp) (xs :(flatLang$pat # exp) list) (dflt :exp). EVERY esgc_free (x::dflt::MAP (SND :flatLang$pat # exp -> exp) xs) ⇒ esgc_free (naive_pattern_matches t x xs dflt)
esgc_compile_pats=esgc_free (dflt :exp) ∧ EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) ⇒ esgc_free (compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) (Var_local (t' :tra) (nm :mlstring)) dflt ps)
globals_decode_pos=∀(p :position) (exp :exp). set_globals exp = ({||} :num -> num) ⇒ set_globals (decode_pos (t :tra) exp p) = ({||} :num -> num)
globals_decode_test=set_globals (exp :exp) = ({||} :num -> num) ⇒ set_globals (decode_test (t :tra) (d :dTest) exp) = ({||} :num -> num)
globals_decode_guard=set_globals (exp :exp) = ({||} :num -> num) ⇒ set_globals (decode_guard (t :tra) exp (gd :dGuard)) = ({||} :num -> num)
globals_bindings=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). set_globals v_exp = ({||} :num -> num)) n_bindings ⇒ set_globals (SND (compile_pat_bindings t i n_bindings exp)) = set_globals exp
globals_naive_match=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY (λ(v :flatLang$pat # exp). set_globals (SND v) = ({||} :num -> num)) xs ⇒ set_globals (naive_pattern_match t xs) = ({||} :num -> num)
globals_naive_matches=set_globals (x :exp) = ({||} :num -> num) ⇒ set_globals (naive_pattern_matches (t :tra) x (ps :(flatLang$pat # exp) list) (dflt :exp)) ≤ elist_globals (dflt::MAP (SND :flatLang$pat # exp -> exp) ps)
globals_compile_pats=(¬(naive :bool) ⇒ elist_globals ((dflt :exp)::MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) = ({||} :num -> num)) ∧ set_globals (x :exp) = ({||} :num -> num) ⇒ set_globals (compile_pats (cfg :config) naive (t :tra) (N :num) x dflt ps) ≤ elist_globals (dflt::MAP (SND :flatLang$pat # exp -> exp) ps)
compile_global_bounds=(∀(cfg :config) (exp :exp) (N :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (N,sg,exp') ⇒ set_globals exp' ≤ set_globals exp) ∧ (∀(cfg :config) (exps :exp list) (N :num) (sg :bool) (exps' :exp list). compile_exps cfg exps = (N,sg,exps') ⇒ elist_globals exps' ≤ elist_globals exps) ∧ ∀(cfg :config) (m :(flatLang$pat # exp) list) (N :num) (sg :bool) (m' :(flatLang$pat # exp) list). compile_match cfg m = (N,sg,m') ⇒ elist_globals (MAP (SND :flatLang$pat # exp -> exp) m') ≤ elist_globals (MAP (SND :flatLang$pat # exp -> exp) m)
compile_decs_global_bounds=∀(decs :exp list). elist_globals (MAP (compile_dec (cfg :config)) decs) ≤ elist_globals decs
compile_exp_esgc=(∀(cfg :config) (exp :exp) (N :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (N,sg,exp') ∧ esgc_free exp ⇒ esgc_free exp') ∧ (∀(cfg :config) (exps :exp list) (N :num) (sg :bool) (exps' :exp list). compile_exps cfg exps = (N,sg,exps') ∧ EVERY esgc_free exps ⇒ EVERY esgc_free exps') ∧ ∀(cfg :config) (m :(flatLang$pat # exp) list) (N :num) (sg :bool) (m' :(flatLang$pat # exp) list). compile_match cfg m = (N,sg,m') ∧ EVERY (esgc_free ∘ (SND :flatLang$pat # exp -> exp)) m ⇒ EVERY (esgc_free ∘ (SND :flatLang$pat # exp -> exp)) m'
compile_decs_esgc=∀(decs :exp list). EVERY esgc_free decs ⇒ EVERY esgc_free (MAP (compile_dec (cfg :config)) decs)
no_mat_definition=(∀(t :tra) (e :exp). no_Mat (Raise t e :exp) ⇔ no_Mat e) ∧ (∀(t :tra) (l :lit). no_Mat (Lit t l :exp) ⇔ T) ∧ (∀(v :mlstring) (t :tra). no_Mat (Var_local t v) ⇔ T) ∧ (∀(t :tra) (n :(num # num option) option) (es :exp list). no_Mat (Con t n es :exp) ⇔ EVERY (λ(a :exp). no_Mat a) es) ∧ (∀(t :tra) (op :op) (es :exp list). no_Mat (App t op es :exp) ⇔ EVERY (λ(a :exp). no_Mat a) es) ∧ (∀(v :mlstring) (t :mlstring) (e :exp). no_Mat (Fun t v e :exp) ⇔ no_Mat e) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (t :tra). no_Mat (If t x1 x2 x3 :exp) ⇔ no_Mat x1 ∧ no_Mat x2 ∧ no_Mat x3) ∧ (∀(vo :mlstring option) (t :tra) (e2 :exp) (e1 :exp). no_Mat (Let t vo e1 e2 :exp) ⇔ no_Mat e1 ∧ no_Mat e2) ∧ (∀(t :tra) (pes :(flatLang$pat # exp) list) (e :exp). no_Mat (Mat t e pes :exp) ⇔ F) ∧ (∀(t :tra) (pes :(flatLang$pat # exp) list) (e :exp). no_Mat (Handle t e pes :exp) ⇔ no_Mat e ∧ EVERY (λ(a :exp). no_Mat a) (MAP (SND :flatLang$pat # exp -> exp) pes) ∧ case pes of ([] :(flatLang$pat # exp) list) => F | [(Pany,v11)] => F | [((Pvar v19 :flatLang$pat),v11)] => T | [((Plit v20 :flatLang$pat),v11)] => F | [(Pcon v21 v22,v11)] => F | [(Pas v23 v24,v11)] => F | [(Pref v25,v11)] => F | v2::v6::v7 => F) ∧ ∀(t :mlstring) (funs :(mlstring # mlstring # exp) list) (e :exp). no_Mat (Letrec t funs e :exp) ⇔ EVERY (λ(a :exp). no_Mat a) (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) funs) ∧ no_Mat e
no_mat_decs_definition=(no_Mat_decs ([] :exp list) ⇔ T) ∧ ∀(e :exp) (xs :exp list). no_Mat_decs (e::xs) ⇔ no_Mat e ∧ no_Mat_decs xs
compile_exp_no_mat=(∀(cfg :config) (exp :exp) (N :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (N,sg,exp') ⇒ no_Mat exp') ∧ (∀(cfg :config) (exps :exp list) (N :num) (sg :bool) (exps' :exp list). compile_exps cfg exps = (N,sg,exps') ⇒ EVERY no_Mat exps') ∧ ∀(cfg :config) (pats :(flatLang$pat # exp) list) (N :num) (sg :bool) (pats' :(flatLang$pat # exp) list). compile_match cfg pats = (N,sg,pats') ⇒ EVERY no_Mat (MAP (SND :flatLang$pat # exp -> exp) pats')
compile_decs_no_mat=∀(decs :exp list). no_Mat_decs (MAP (compile_dec (cfg :config)) decs)
decode_pos_definition=(∀(t :tra) (v :exp). decode_pos t v EmptyPos = v) ∧ ∀(t :tra) (v :exp) (i :num) (pos :position). decode_pos t v (Pos i pos) = decode_pos t (App t (El i) [v] :exp) pos
decode_test_definition=(∀(t :tra) (tag :num) (l :num) (v :exp). decode_test t (TagLenEq tag l :dTest) v = (App t (TagLenEq tag l :op) [v] :exp)) ∧ ∀(t :tra) (lit :lit) (v :exp). decode_test t (LitEq lit) v = (App t (Src Equality) [v; (Lit t lit :exp)] :exp)
simp_guard_definition=(∀(y :dGuard) (x :dGuard). simp_guard (Conj x y) = (let (v :dGuard) = simp_guard x; (w :dGuard) = simp_guard y in if v = (Not True :dGuard) ∨ w = (Not True :dGuard) then (Not True :dGuard) else if v = True then w else if w = True then v else Conj v w)) ∧ (∀(y :dGuard) (x :dGuard). simp_guard (Disj x y) = (let (v :dGuard) = simp_guard x; (w :dGuard) = simp_guard y in if v = True ∨ w = True then True else if v = (Not True :dGuard) then w else if w = (Not True :dGuard) then v else Disj v w)) ∧ (∀(x :dGuard). simp_guard (Not x :dGuard) = (let (v :dGuard) = simp_guard x in case v of PosTest v8 v9 => (Not v :dGuard) | (Not (PosTest v29 v30) :dGuard) => PosTest v29 v30 | (Not (Not v31 :dGuard) :dGuard) => (Not v31 :dGuard) | (Not (Conj v32 v33) :dGuard) => Conj v32 v33 | (Not (Disj v34 v35) :dGuard) => Disj v34 v35 | (Not True :dGuard) => True | Conj v11 v12 => (Not v :dGuard) | Disj v13 v14 => (Not v :dGuard) | True => (Not v :dGuard))) ∧ (∀(v2 :dTest) (v1 :position). simp_guard (PosTest v1 v2) = PosTest v1 v2) ∧ simp_guard True = True
decode_guard_definition=(∀(t :tra) (v :exp) (gd :dGuard). decode_guard t v (Not gd :dGuard) = (App t (Src Equality) [decode_guard t v gd; Bool t F] :exp)) ∧ (∀(t :tra) (v :exp) (gd1 :dGuard) (gd2 :dGuard). decode_guard t v (Conj gd1 gd2) = SmartIf t (decode_guard t v gd1) (decode_guard t v gd2) (Bool t F)) ∧ (∀(t :tra) (v :exp) (gd1 :dGuard) (gd2 :dGuard). decode_guard t v (Disj gd1 gd2) = SmartIf t (decode_guard t v gd1) (Bool t T) (decode_guard t v gd2)) ∧ (∀(t :tra) (v :exp). decode_guard t v True = Bool t T) ∧ ∀(t :tra) (v :exp) (pos :position) (test :dTest). decode_guard t v (PosTest pos test) = decode_test t test (decode_pos t v pos)
decode_dtree_definition=(∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp) (n :num). decode_dtree t br_spt v df (Leaf n) = case lookup n br_spt of (NONE :exp option) => df | SOME br => br) ∧ (∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp). decode_dtree t br_spt v df Fail = df) ∧ (∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp). decode_dtree t br_spt v df TypeFail = Var_local t «impossible-case») ∧ ∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp) (guard :dGuard) (dt1 :dTree) (dt2 :dTree). decode_dtree t br_spt v df (If guard dt1 dt2 :dTree) = (let (guard :dGuard) = simp_guard guard; (dec1 :exp) = decode_dtree t br_spt v df dt1; (dec2 :exp) = decode_dtree t br_spt v df dt2 in if guard = True then dec1 else if guard = (Not True :dGuard) then dec2 else SmartIf t (decode_guard t v guard) dec1 dec2)
encode_pat_definition=encode_pat Pany = Any ∧ (∀(l :lit). encode_pat (Plit l :flatLang$pat) = (Lit l :pat)) ∧ (∀(v0 :mlstring). encode_pat (Pvar v0 :flatLang$pat) = Any) ∧ (∀(stmp :(num # (num # (num # num) list) option) option) (ps :flatLang$pat list). encode_pat (Pcon stmp ps) = (Cons (case stmp of (NONE :(num # (num # (num # num) list) option) option) => (NONE :(num # (num # num) list option) option) | SOME (i,(NONE :(num # (num # num) list) option)) => SOME (i,(NONE :(num # num) list option)) | SOME (i,SOME (ty,ctors)) => SOME (i,SOME ctors)) (MAP (λ(a :flatLang$pat). encode_pat a) ps) :pat)) ∧ (∀(v :mlstring) (p :flatLang$pat). encode_pat (Pas p v) = encode_pat p) ∧ ∀(p :flatLang$pat). encode_pat (Pref p) = Ref (encode_pat p)
naive_match_definition=(∀(t :tra). naive_pattern_match t ([] :(flatLang$pat # exp) list) = Bool t T) ∧ (∀(v0 :exp) (t :tra) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pany,v0)::mats) = naive_pattern_match t mats) ∧ (∀(v2 :exp) (v1 :mlstring) (t :tra) (mats :(flatLang$pat # exp) list). naive_pattern_match t (((Pvar v1 :flatLang$pat),v2)::mats) = naive_pattern_match t mats) ∧ (∀(v :exp) (t :tra) (mats :(flatLang$pat # exp) list) (l :lit). naive_pattern_match t (((Plit l :flatLang$pat),v)::mats) = SmartIf t (App t (Src Equality) [v; (Lit t l :exp)] :exp) (naive_pattern_match t mats) (Bool t F)) ∧ (∀(v :exp) (t :tra) (ps :flatLang$pat list) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pcon (NONE :(num # (num # (num # num) list) option) option) ps,v)::mats) = naive_pattern_match t (MAPi (λ(i :num) (p :flatLang$pat). (p,(App t (El i) [v] :exp))) ps ++ mats)) ∧ (∀(v :exp) (t :tra) (p :flatLang$pat) (mats :(flatLang$pat # exp) list) (i :mlstring). naive_pattern_match t ((Pas p i,v)::mats) = naive_pattern_match t ((p,v)::mats)) ∧ (∀(v :exp) (t :tra) (stmp :num # (num # (num # num) list) option) (ps :flatLang$pat list) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pcon (SOME stmp) ps,v)::mats) = SmartIf t (App t (TagLenEq (FST stmp) (LENGTH ps) :op) [v] :exp) (naive_pattern_match t (MAPi (λ(i :num) (p :flatLang$pat). (p,(App t (El i) [v] :exp))) ps ++ mats)) (Bool t F)) ∧ ∀(v :exp) (t :tra) (p :flatLang$pat) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pref p,v)::mats) = naive_pattern_match t ((p,(App t (El (0 :num)) [v] :exp))::mats)
naive_matches_definition=(∀(v :exp) (t :tra) (dflt_x :exp). naive_pattern_matches t v ([] :(flatLang$pat # exp) list) dflt_x = dflt_x) ∧ ∀(x :exp) (v :exp) (t :tra) (ps :(flatLang$pat # exp) list) (p :flatLang$pat) (dflt_x :exp). naive_pattern_matches t v ((p,x)::ps) dflt_x = SmartIf t (naive_pattern_match t [(p,v)]) x (naive_pattern_matches t v ps dflt_x)
max_dec_name_definition=max_dec_name ([] :mlstring list) = (0 :num) ∧ ∀(nm :mlstring) (nms :mlstring list). max_dec_name (nm::nms) = MAX (dec_name_to_num nm) (max_dec_name nms)
alookup_rel_mono_typed=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) (xs :(α # β) list) (ys :(α # γ) list) ∧ (∀(x :α) (y :δ) (z :ε). (P' :α -> bool) x ⇒ P x) ∧ (∀(x :α) (y :β) (z :γ). P' x ∧ R y z ⇒ (R' :β -> γ -> bool) y z) ⇒ ALOOKUP_rel P' R' xs ys
alookup_rel_eq_typed=ALOOKUP_rel (P :α -> bool) ($= :β -> β -> bool) (xs :(α # β) list) (ys :(α # β) list) ∧ P (x :α) ⇒ ALOOKUP xs x = ALOOKUP ys x
alookup_rel_append_typed=ALOOKUP_rel (P :α -> bool) (R :β -> γ -> bool) (xs1 :(α # β) list) (xs3 :(α # γ) list) ∧ ALOOKUP_rel P R (xs2 :(α # β) list) (xs4 :(α # γ) list) ⇒ ALOOKUP_rel P R (xs1 ++ xs2) (xs3 ++ xs4)
