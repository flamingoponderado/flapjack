num_set_tree_union_def_typed=(∀(t2 :sptree$num_set sptree$num_map). num_set_tree_union (LN :sptree$num_set sptree$num_map) t2 = t2) ∧ (∀(a :sptree$num_set) (t :sptree$num_set sptree$num_map). num_set_tree_union ⦕ 0 ↦ a ⦖ t = case t of (LN :sptree$num_set sptree$num_map) => ⦕ 0 ↦ a ⦖ | ⦕ 0 ↦ b ⦖ => ⦕ 0 ↦ union a b ⦖ | BN t1 t2 => BS t1 a t2 | BS t1' b' t2' => BS t1' (union a b') t2') ∧ (∀(t1 :sptree$num_set sptree$num_map) (t2 :sptree$num_set sptree$num_map) (t :sptree$num_set sptree$num_map). num_set_tree_union (BN t1 t2) t = case t of (LN :sptree$num_set sptree$num_map) => BN t1 t2 | ⦕ 0 ↦ a ⦖ => BS t1 a t2 | BN t1' t2' => BN (num_set_tree_union t1 t1') (num_set_tree_union t2 t2') | BS t1'' a'' t2'' => BS (num_set_tree_union t1 t1'') a'' (num_set_tree_union t2 t2'')) ∧ ∀(t1 :sptree$num_set sptree$num_map) (a :sptree$num_set) (t2 :sptree$num_set sptree$num_map) (t :sptree$num_set sptree$num_map). num_set_tree_union (BS t1 a t2) t = case t of (LN :sptree$num_set sptree$num_map) => BS t1 a t2 | ⦕ 0 ↦ b ⦖ => BS t1 (union a b) t2 | BN t1' t2' => BS (num_set_tree_union t1 t1') a (num_set_tree_union t2 t2') | BS t1'' b' t2'' => BS (num_set_tree_union t1 t1'') (union a b') (num_set_tree_union t2 t2'')
domain_spt_fold_union_typed=∀(tree :α sptree$num_map sptree$num_map) (y :α sptree$num_map). (domain (spt_fold (union :α sptree$num_map -> α sptree$num_map -> α sptree$num_map) y tree) :num -> bool) = (domain y :num -> bool) ∪ {n | ∃(k :num) (aSet :α sptree$num_map). lookup k tree = SOME aSet ∧ n ∈ (domain aSet :num -> bool)}
closure_spt_def_typed=∀(tree :sptree$num_set sptree$num_map) (reachable :sptree$num_set). closure_spt reachable tree = (let (sets :sptree$num_set sptree$num_map) = inter tree reachable; (nodes :sptree$num_set) = spt_fold (union :sptree$num_set -> sptree$num_set -> sptree$num_set) (LN :sptree$num_set) sets in if subspt nodes reachable then reachable else closure_spt (union reachable nodes) tree)
is_adjacent_def_typed=∀(tree :sptree$num_set sptree$num_map) (x :num) (y :num). is_adjacent tree x y ⇔ ∃(aSetx :sptree$num_set). lookup x tree = SOME aSetx ∧ lookup y aSetx = SOME ()
is_reachable_def_typed=∀(tree :sptree$num_set sptree$num_map). is_reachable tree = (is_adjacent tree)꙳
num_set_tree_union_sym_typed=∀(t1 :sptree$num_set sptree$num_map) (t2 :sptree$num_set sptree$num_map). num_set_tree_union t1 t2 = num_set_tree_union t2 t1
lookup_num_set_tree_union_typed=∀(t1 :sptree$num_set sptree$num_map) (t2 :sptree$num_set sptree$num_map) (n :num). lookup n (num_set_tree_union t1 t2) = case lookup n t1 of (NONE :sptree$num_set option) => lookup n t2 | SOME x => case lookup n t2 of (NONE :sptree$num_set option) => SOME x | SOME y => SOME (union x y)
is_adjacent_num_set_tree_union_typed=∀(t1 :sptree$num_set sptree$num_map) (t2 :sptree$num_set sptree$num_map) (n :num) (m :num). is_adjacent t1 n m ⇒ is_adjacent (num_set_tree_union t1 t2) n m
is_reachable_num_set_tree_union_typed=∀(t1 :sptree$num_set sptree$num_map) (t2 :sptree$num_set sptree$num_map) (n :num) (m :num). is_reachable t1 n m ⇒ is_reachable (num_set_tree_union t1 t2) n m
closure_spt_thm_typed=∀(tree :sptree$num_set sptree$num_map) (start :sptree$num_set). (domain (closure_spt start tree) :num -> bool) = {a | ∃(n :num). n ∈ (domain start :num -> bool) ∧ is_reachable tree n a}
