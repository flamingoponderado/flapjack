return=Return [Const 7w]
multi_return=Return [Const 1w; Const 2w]
store32_clause=Store32 (Const 1w) (Const 2w)
store32_fallback=Skip
store_byte_clause=StoreByte (Const 3w) (Const 4w)
store_byte_fallback=Skip
if_clause=If (Const 1w) Skip (Break 0)
if_fallback=Skip
while_clause=While (Const 2w) (Break 0)
while_fallback=Skip
global_assign_fallback=Skip
global_shmem_load_fallback=Skip
local_assign_direct=Seq (Assign 7 (Var 8)) Skip
local_assign_overlap_temporaries=Dec 11 (Var 7) (Seq (Assign 7 (Var 11)) Skip)
local_assign_missing_destination=Skip
local_assign_length_fallback=Skip
struct_skip=Skip
struct_break=Break 0
struct_continue=Continue 0
struct_tick=Tick
struct_annot=Skip
struct_seq=Seq Skip (Seq (Break 0) (Continue 0))
missing_global=Call NONE «f» []
empty_one_global=Call NONE «f» []
extra_names_global=Call (SOME ([4; 5],NONE)) «f» []
missing_names_global=Call (SOME ([4],NONE)) «f» []
missing_local=Call NONE «f» []
empty_one_local=Call NONE «f» []
extra_names_local=Call (SOME ([4; 5],NONE)) «f» []
missing_names_local=Call (SOME ([4],NONE)) «f» []
valid_local=Call (SOME ([0; 1],NONE)) «f» []
empty_struct_return=Return []
finite_map_shadow_return=Return [Var 5]
extcall_high_tail=Dec 101 (Var 4)
  (Dec 102 (Var 5)
     (Dec 103 (Var 6) (Dec 104 (Var 7) (ExtCall «f» 101 102 103 104))))
extcall_shared_high_tail=Dec 100 (Var 1)
  (Dec 101 (Var 1)
     (Dec 102 (Var 1) (Dec 103 (Var 1) (ExtCall «f» 100 101 102 103))))
pair_load=Return
  (Load (Var 0)::
     if n2w (dimindex (:word64) DIV 8 MOD dimword (:word64)) = 0w then
       [Load (Var 0)]
     else
       [Load
          (Op Add
             [Var 0;
              Const (n2w (dimindex (:word64) DIV 8 MOD dimword (:word64)))])])
pair_store=Dec 3 (Var 0)
  (Dec 4 (Var 1)
     (Dec 5 (Var 2)
        (Seq (Store (Var 3) (Var 4))
           (nested_seq
              (if
                 n2w (dimindex (:word64) DIV 8 MOD dimword (:word64)) = 0w
               then
                 [Store (Var 3) (Var 5)]
               else
                 [Store
                    (Op Add
                       [Var 3;
                        Const
                          (n2w
                             (dimindex (:word64) DIV 8 MOD dimword (:word64)))])
                    (Var 5)])))))
fixed_stride64=([Const (n2w (dimindex (:word64) DIV 8))],One)
