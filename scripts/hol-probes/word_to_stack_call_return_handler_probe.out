handler_StackHandlerArgs_F=StackHandlerArgs F dest arg_count (k,f,f') = StackArgs dest arg_count (k,f + 3,f' + 3)
handler_StackHandlerArgs_F_hypotheses=0
handler_PushHandler_F=PushHandler F l1 l2 (k,f,f') = Seq (StackAlloc 3) (Seq (const_inst k 1w) (Seq (StackStore k 0) (Seq (LocValue k l1 l2) (Seq (StackStore k 1) (Seq (Get k Handler) (Seq (StackStore k 2) (Seq Skip (Seq (StackGetSize k) (Set Handler k)))))))))
handler_PushHandler_F_hypotheses=0
handler_PopHandler_F=PopHandler F (k,f,f') prog = Seq (StackLoad k 2) (Seq (Set Handler k) (Seq (StackFree 3) prog))
handler_PopHandler_F_hypotheses=0
handler_stack_rel_DROP_SOME=stack_rel k whandler (StackFrame n l0 l (SOME (whandler',b,c))::wstack) shandler sstack len bs (f'::lens) ⇒ stack_rel k whandler' wstack (SOME sstack❲2❳) (DROP (f' + 4) sstack) len bs lens
handler_stack_rel_DROP_SOME_hypotheses=0
handler_stack_rel_cons_LEN_SOME=stack_rel k whandler (StackFrame n l0 l (SOME (a,b,c))::wstack) shandler sstack len bs (f'::lens) ⇒ f' + 4 ≤ LENGTH sstack
handler_stack_rel_cons_LEN_SOME_hypotheses=0
handler_evaluate_PushHandler=3 ≤ t.stack_space ∧ state_rel ac k 0 0 (push_env x' NONE s with <|locals := LN; locals_size := SOME 0|>) t (f'::lens) 0 ∧ loc_check t.code (x''2,x''3) ⇒ ∃t'. evaluate (PushHandler F x''2 x''3 (k,f,f'),t) = (NONE,t') ∧ t' = t with <|stack_space := t'.stack_space; regs := t'.regs; stack := t'.stack; store := t'.store|> ∧ (∀n. n < LENGTH t.stack − t.stack_space ⇒ (DROP t.stack_space t.stack)❲n❳ = (DROP t'.stack_space t'.stack)❲n + 3❳) ∧ (∀i. i ≠ k ⇒ get_var i t' = get_var i t) ∧ t'.stack_space + 3 = t.stack_space ∧ LENGTH t'.stack = LENGTH t.stack ∧ state_rel ac k 0 0 (push_env x' (SOME (x''0,x''1,x''2,x''3)) s with <|locals := LN; locals_size := SOME 0|>) t' (f'::lens) 0
handler_evaluate_PushHandler_hypotheses=0
handler_evaluate_PushHandler_clock=∀t. evaluate (PushHandler F a b (k,f,f'),t with clock := clk) = (FST (evaluate (PushHandler F a b (k,f,f'),t)),SND (evaluate (PushHandler F a b (k,f,f'),t)) with clock := clk)
handler_evaluate_PushHandler_clock_hypotheses=0
