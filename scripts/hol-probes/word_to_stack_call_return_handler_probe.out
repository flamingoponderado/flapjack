handler_full_width80=3 ≤ t.stack_space ∧ state_rel ac k 0 0 (push_env x' NONE s with <|locals := LN; locals_size := SOME 0|>) t (f'::lens) 0 ∧ loc_check t.code (x''2,x''3) ⇒ ∃t'. evaluate (PushHandler F x''2 x''3 (k,f,f'),t) = (NONE,t') ∧ t' = t with <|stack_space := t'.stack_space; regs := t'.regs; stack := t'.stack; store := t'.store|> ∧ (∀n. n < LENGTH t.stack − t.stack_space ⇒ (DROP t.stack_space t.stack)❲n❳ = (DROP t'.stack_space t'.stack)❲n + 3❳) ∧ (∀i. i ≠ k ⇒ get_var i t' = get_var i t) ∧ t'.stack_space + 3 = t.stack_space ∧ LENGTH t'.stack = LENGTH t.stack ∧ state_rel ac k 0 0 (push_env x' (SOME (x''0,x''1,x''2,x''3)) s with <|locals := LN; locals_size := SOME 0|>) t' (f'::lens) 0
