op_space_reset_pmatch_typed=!(op :op). op_space_reset op <=> PMATCH op [PMATCH_ROW (\(_ :unit). IntOp Add) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp Sub) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp Mult) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp Div) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp Mod) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp Less) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp LessEq) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp Greater) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). IntOp GreaterEq) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). BlockOp Equal) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_ :unit). BlockOp ListAppend) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_0 :num). BlockOp (FromList _0)) (\(_0 :num). T) (\(_0 :num). T); PMATCH_ROW (\(_0 :num). BlockOp (ConsExtend _0)) (\(_0 :num). T) (\(_0 :num). T); PMATCH_ROW (\(_ :unit). MemOp RefArray) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_0 :bool). MemOp (RefByte _0)) (\(_0 :bool). T) (\(_0 :bool). T); PMATCH_ROW (\(new_flag :bool). MemOp (CopyByte new_flag)) (\(new_flag :bool). T) (\(new_flag :bool). new_flag); PMATCH_ROW (\(_ :unit). MemOp ConfigGC) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(_0 :mlstring). (FFI _0 :op)) (\(_0 :mlstring). T) (\(_0 :mlstring). T); PMATCH_ROW (\(_0 :op). _0) (\(_0 :op). T) (\(_0 :op). F)]
op_requires_names_eqn_typed=!(op :op). op_requires_names op <=> op_space_reset op \/ case op of Label v8 => F | (FFI n :op) => T | IntOp v10 => F | WordOp v11 => F | BlockOp v12 => F | GlobOp v13 => F | MemOp Ref => F | MemOp Update => F | MemOp El => F | MemOp Length => F | MemOp LengthByte => F | MemOp (RefByte v23) => F | MemOp RefArray => F | MemOp DerefByte => F | MemOp UpdateByte => F | MemOp ConcatByteVec => F | MemOp (CopyByte new_flag) => T | MemOp FromListByte => F | MemOp ToListByte => F | MemOp LengthByteVec => F | MemOp DerefByteVec => F | MemOp (StringCmp b cmp) => T | MemOp XorByte => T | MemOp BoundsCheckArray => F | MemOp (BoundsCheckByte v27) => F | MemOp (MutCons v28 v29) => F | MemOp UpdateCons => F | MemOp FinaliseCons => F | MemOp ConfigGC => F | Install => T | (ThunkOp v15 :op) => F
op_requires_names_pmatch_typed=!(op :op). op_requires_names op <=> op_space_reset op \/ PMATCH op [PMATCH_ROW (\(n :mlstring). (FFI n :op)) (\(n :mlstring). T) (\(n :mlstring). T); PMATCH_ROW (\(_ :unit). Install) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\(new_flag :bool). MemOp (CopyByte new_flag)) (\(new_flag :bool). T) (\(new_flag :bool). T); PMATCH_ROW (\(_ :unit). MemOp XorByte) (\(_ :unit). T) (\(_ :unit). T); PMATCH_ROW (\((b :bool),(cmp :opb)). MemOp (StringCmp b cmp)) (\((b :bool),(cmp :opb)). T) (\((b :bool),(cmp :opb)). T); PMATCH_ROW (\(_0 :op). _0) (\(_0 :op). T) (\(_0 :op). F)]
compile_LESS_EQ_lemma_typed=!(n :num) (env :num list) (tail :bool) (live :num list) (xs :exp list). n <= SND (SND (compile n env tail live xs :prog # num list # num))
compile_LENGTH_lemma_typed=!(n :num) (env :num list) (tail :bool) (live :num list) (xs :exp list). LENGTH (FST (SND (compile n env tail live xs :prog # num list # num))) = LENGTH xs
compile_SING_IMP_typed=(compile (n :num) (env :num list) (tail :bool) (live :num list) [(x :exp)] :prog # num list # num) = ((c :prog),(vs :num list),(new_var :num)) ==> ?(t :num). vs = [t]
compile_exp_eq_typed=compile_exp (arg_count :num) (exp :exp) = optimise (FST (compile_sing arg_count (COUNT_LIST arg_count) T ([] :num list) exp))
