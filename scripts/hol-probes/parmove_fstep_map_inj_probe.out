pfm_statement=∀p. inj_on_state f p ⇒ fstep (map_state f p) = map_state f (fstep p)
pfm_empty=(T,([],[],[]),[],[],[])
pfm_self=(T,([],[],[]),[],[],[])
pfm_start=(T,([],[(SOME F,SOME T)],[]),[],[(SOME F,SOME T)],[])
pfm_found=(T,([],[(SOME F,SOME T); (SOME T,SOME F)],[]),[],[(SOME F,SOME T); (SOME T,SOME F)],[])
pfm_emit=(T,([],[],[(SOME T,SOME F)]),[],[],[(SOME T,SOME F)])
pfm_cycle=(T,([],[(SOME F,NONE)],[(SOME T,SOME F); (NONE,SOME T)]),[],[(SOME F,NONE)],[(SOME T,SOME F); (NONE,SOME T)])
pfm_no_cycle=(T,([],[(SOME F,SOME F)],[(SOME T,SOME F)]),[],[(SOME F,SOME F)],[(SOME T,SOME F)])
pfm_temp=(T,([],[(NONE,SOME F)],[(SOME T,NONE)]),[],[(NONE,SOME F)],[(SOME T,NONE)])
