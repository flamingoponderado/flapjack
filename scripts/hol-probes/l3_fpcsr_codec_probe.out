fpcsr_definition_0=∀x. rec'FPCSR x = FPCSR (word_bit 3 x) ((7 >< 5) x) (word_bit 4 x) (word_bit 0 x) (word_bit 2 x) (word_bit 1 x) ((31 >< 8) x)
fpcsr_definition_1=∀x. reg'FPCSR x = case x of FPCSR DZ FRM NV NX OF UF fpcsr'rst => fpcsr'rst @@ FRM @@ v2w [NV] @@ v2w [DZ] @@ v2w [OF] @@ v2w [UF] @@ v2w [NX]
fpcsr_definition_2=∀_ x. write'reg'FPCSR (_,x) = rec'FPCSR x
fpcsr_definition_3=∀_ x. write'rec'FPCSR (_,x) = reg'FPCSR x
