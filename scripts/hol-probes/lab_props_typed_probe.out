share_mem_op_add_clock_same_typed=((s :(α, β, γ) labSem$state).clock ≠ (0 :num) ∧ share_mem_op (m :memop) (n :num) (a :α addr) s = (NONE :(γ ffi_result # (α, β, γ) labSem$state) option) ⇒ share_mem_op m n a (s with clock := (extra :num) + s.clock) = (NONE :(γ ffi_result # (α, β, γ) labSem$state) option)) ∧ (s.clock ≠ (0 :num) ∧ share_mem_op m n a s = SOME (FFI_return (f :γ ffi_state) (l' :word8 list),(r :(α, β, γ) labSem$state)) ⇒ share_mem_op m n a (s with clock := extra + s.clock) = SOME (FFI_return f l',r with clock := extra + r.clock)) ∧ (s.clock ≠ (0 :num) ∧ share_mem_op m n a s = SOME ((FFI_final (f2 :final_event) :γ ffi_result),(r2 :(α, β, γ) labSem$state)) ⇒ share_mem_op m n a (s with clock := extra + s.clock) = SOME ((FFI_final f2 :γ ffi_result),r2 with clock := extra + r2.clock))
no_install_def_typed=∀(code :α sec list). no_install code ⇔ ∀(p :num) (w :α word) (bytes :word8 list) (l :num). asm_fetch_aux p code ≠ SOME (LabAsm (Install :α asm_with_lab) w bytes l)
no_share_mem_inst_def_typed=∀(code :α sec list). no_share_mem_inst code ⇔ ∀(p :num) (op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num). asm_fetch_aux p code ≠ SOME (Asm (ShareMem op re a) inst len)
align_dm_def_typed=∀(s :(α, γ, 'ffi) labSem$state). align_dm s = s with mem_domain := s.mem_domain ∩ (byte_aligned :α word -> bool)
align_dm_const_typed=(align_dm (s :(α, β, γ) labSem$state)).clock = s.clock ∧ (align_dm s).pc = s.pc ∧ (align_dm s).code = s.code ∧ (align_dm s).mem = s.mem ∧ (align_dm s).shared_mem_domain = s.shared_mem_domain ∧ ((align_dm s).be ⇔ s.be) ∧ (align_dm s).len_reg = s.len_reg ∧ (align_dm s).link_reg = s.link_reg ∧ (align_dm s).ptr_reg = s.ptr_reg ∧ (align_dm s).ptr2_reg = s.ptr2_reg ∧ (align_dm s).len2_reg = s.len2_reg ∧ (align_dm s).io_regs = s.io_regs ∧ (align_dm s).io_fp_regs = s.io_fp_regs ∧ (align_dm s).code_buffer = s.code_buffer ∧ (align_dm s).compile = s.compile ∧ (align_dm s).compile_oracle = s.compile_oracle ∧ (align_dm s).ffi = s.ffi ∧ ((align_dm s).failed ⇔ s.failed)
align_dm_with_clock_typed=align_dm ((s :(α, β, γ) labSem$state) with clock := (k :num)) = align_dm s with clock := k
align_sdm_def_typed=∀(s :(α, γ, 'ffi) labSem$state). align_sdm s = s with shared_mem_domain := s.shared_mem_domain ∩ (byte_aligned :α word -> bool)
align_sdm_const_typed=(align_sdm (s :(α, β, γ) labSem$state)).clock = s.clock ∧ (align_sdm s).pc = s.pc ∧ (align_sdm s).code = s.code ∧ (align_sdm s).mem = s.mem ∧ (align_sdm s).mem_domain = s.mem_domain ∧ ((align_sdm s).be ⇔ s.be) ∧ (align_sdm s).len_reg = s.len_reg ∧ (align_sdm s).link_reg = s.link_reg ∧ (align_sdm s).ptr_reg = s.ptr_reg ∧ (align_sdm s).ptr2_reg = s.ptr2_reg ∧ (align_sdm s).len2_reg = s.len2_reg ∧ (align_sdm s).io_regs = s.io_regs ∧ (align_sdm s).io_fp_regs = s.io_fp_regs ∧ (align_sdm s).code_buffer = s.code_buffer ∧ (align_sdm s).compile = s.compile ∧ (align_sdm s).compile_oracle = s.compile_oracle ∧ (align_sdm s).ffi = s.ffi ∧ ((align_sdm s).failed ⇔ s.failed)
