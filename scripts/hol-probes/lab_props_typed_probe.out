evaluate_align_dm_typed=good_dimindex (:α) ⇒ ∀(s :(α, γ, 'ffi) labSem$state). (evaluate (align_dm s) :machine_result # (α, γ, 'ffi) labSem$state) = (let ((r :machine_result),(s' :(α, γ, 'ffi) labSem$state)) = (evaluate s :machine_result # (α, γ, 'ffi) labSem$state) in (r,align_dm s'))
implements_align_dm_typed=good_dimindex (:α) ⇒ implements' T {(semantics (s :(α, γ, 'ffi) labSem$state) :behaviour)} {(semantics (align_dm s) :behaviour)}
