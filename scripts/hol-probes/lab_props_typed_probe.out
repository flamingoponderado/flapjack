align_sdm_aligned_typed=good_dimindex (:α) ⇒ ((x :α word) ∈ (s :(α, β, γ) labSem$state).shared_mem_domain ∧ w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num) ⇔ x ∈ (align_sdm s).shared_mem_domain)
share_mem_load_align_sdm_typed=good_dimindex (:α) ⇒ (share_mem_load (r :num) (ad :α addr) (align_sdm (s :(α, γ, β) labSem$state)) (n :num) = (NONE :(β ffi_result # (α, γ, β) labSem$state) option) ⇔ share_mem_load r ad s n = (NONE :(β ffi_result # (α, γ, β) labSem$state) option)) ∧ (share_mem_load r ad s n = SOME ((res :β ffi_result),(s' :(α, γ, β) labSem$state)) ⇒ share_mem_load r ad (align_sdm s) n = SOME (res,align_sdm s'))
share_mem_op_align_sdm_simp_typed=good_dimindex (:α) ⇒ (share_mem_op (m :memop) (r :num) (a :α addr) (s :(α, γ, β) labSem$state) = (NONE :(β ffi_result # (α, γ, β) labSem$state) option) ⇔ share_mem_op m r a (align_sdm s) = (NONE :(β ffi_result # (α, γ, β) labSem$state) option)) ∧ (share_mem_op m r a s = SOME ((res :β ffi_result),(s' :(α, γ, β) labSem$state)) ⇒ share_mem_op m r a (align_sdm s) = SOME (res,align_sdm s'))
share_mem_store_align_sdm_typed=good_dimindex (:α) ⇒ (share_mem_store (r :num) (ad :α addr) (align_sdm (s :(α, γ, β) labSem$state)) (n :num) = (NONE :(β ffi_result # (α, γ, β) labSem$state) option) ⇔ share_mem_store r ad s n = (NONE :(β ffi_result # (α, γ, β) labSem$state) option)) ∧ (share_mem_store r ad s n = SOME ((res :β ffi_result),(s' :(α, γ, β) labSem$state)) ⇒ share_mem_store r ad (align_sdm s) n = SOME (res,align_sdm s'))
mem_load_align_dm_typed=good_dimindex (:α) ⇒ (mem_load (n :num) (a :α addr) (align_dm (s :(α, β, γ) labSem$state)) :(α, β, γ) labSem$state) = align_dm (mem_load n a s :(α, β, γ) labSem$state)
mem_store_align_dm_typed=good_dimindex (:α) ⇒ (mem_store (n :num) (a :α addr) (align_dm (s :(α, β, γ) labSem$state)) :(α, β, γ) labSem$state) = align_dm (mem_store n a s :(α, β, γ) labSem$state)
evaluate_ADD_clock_typed=∀(s :(α, β, γ) labSem$state) (res :machine_result) (r :(α, β, γ) labSem$state) (k :num). (evaluate s :machine_result # (α, β, γ) labSem$state) = (res,r) ∧ res ≠ TimeOut ⇒ (evaluate (s with clock := s.clock + k) :machine_result # (α, β, γ) labSem$state) = (res,r with clock := r.clock + k)
evaluate_add_clock_io_events_mono_typed=∀(s :(α, β, γ) labSem$state). (SND (evaluate s :machine_result # (α, β, γ) labSem$state)).ffi.io_events ≼ (SND (evaluate (s with clock := s.clock + (extra :num)) :machine_result # (α, β, γ) labSem$state)).ffi.io_events
evaluate_io_events_mono_typed=∀(s1 :(α, β, γ) labSem$state) (r :machine_result) (s2 :(α, β, γ) labSem$state). (evaluate s1 :machine_result # (α, β, γ) labSem$state) = (r,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
sec_label_ok_extract_labels_typed=EVERY (sec_label_ok (n1 :num) :α line -> bool) (lines :α line list) ∧ MEM ((n1' :num),(n2 :num)) (extract_labels lines) ⇒ n1' = n1 ∧ n2 ≠ (0 :num)
extract_labels_def_typed=extract_labels ([] :α line list) = ([] :(num # num) list) ∧ (∀(xs :α line list) (v0 :num) (l2 :num) (l1 :num). extract_labels ((Label l1 l2 v0 :α line)::xs) = (l1,l2)::extract_labels xs) ∧ (∀(xs :α line list) (v7 :num) (v6 :word8 list) (v5 :α asm_or_cbw). extract_labels (Asm v5 v6 v7::xs) = extract_labels xs) ∧ ∀(xs :α line list) (v9 :α word) (v8 :α asm_with_lab) (v11 :num) (v10 :word8 list). extract_labels (LabAsm v8 v9 v10 v11::xs) = extract_labels xs
extract_labels_append_typed=∀(A :α line list) (B :α line list). extract_labels (A ++ B) = extract_labels A ++ extract_labels B
get_code_labels_def_typed=∀(code :α sec list). get_code_labels code = BIGUNION (IMAGE (sec_get_code_labels :α sec -> num # num -> bool) (set code))
get_code_labels_cons_typed=get_code_labels ((s :α sec)::(secs :α sec list)) = sec_get_code_labels s ∪ get_code_labels secs
get_code_labels_nil_typed=get_code_labels ([] :α sec list) = (∅ :num # num -> bool)
get_labels_def_typed=∀(code :α sec list). get_labels code = BIGUNION (IMAGE (sec_get_labels :α sec -> num # num -> bool) (set code))
get_labels_cons_typed=get_labels ((x :α sec)::(xs :α sec list)) = sec_get_labels x ∪ get_labels xs
labs_of_def_typed=labs_of (LocValue (v0 :num) (Lab (n1 :num) (n2 :num)) :α asm_with_lab) = {(n1,n2)} ∧ labs_of (Jump (Lab n1 n2) :α asm_with_lab) = {(n1,n2)} ∧ labs_of (JumpCmp (v1 :cmp) (v2 :num) (v3 :α reg_imm) (Lab n1 n2) :α asm_with_lab) = {(n1,n2)} ∧ labs_of (Call (v9 :lab) :α asm_with_lab) = (∅ :num # num -> bool) ∧ labs_of (CallFFI (v12 :mlstring) :α asm_with_lab) = (∅ :num # num -> bool) ∧ labs_of (Install :α asm_with_lab) = (∅ :num # num -> bool) ∧ labs_of (Halt :α asm_with_lab) = (∅ :num # num -> bool)
line_get_code_labels_def_typed=line_get_code_labels (Label (v0 :num) (l :num) (v1 :num) :α line) = {l} ∧ line_get_code_labels (Asm (v5 :α asm_or_cbw) (v6 :word8 list) (v7 :num)) = (∅ :num -> bool) ∧ line_get_code_labels (LabAsm (v8 :α asm_with_lab) (v9 :α word) (v10 :word8 list) (v11 :num)) = (∅ :num -> bool)
line_get_labels_def_typed=line_get_labels (LabAsm (a :α asm_with_lab) (v0 :α word) (v1 :word8 list) (v2 :num)) = labs_of a ∧ line_get_labels (Label (v :num) (v4 :num) (v5 :num) :α line) = (∅ :num # num -> bool) ∧ line_get_labels (Asm (v6 :α asm_or_cbw) (v7 :word8 list) (v8 :num)) = (∅ :num # num -> bool)
sec_get_code_labels_def_typed=∀(n1 :num) (lines :α line list). sec_get_code_labels (Section n1 lines) = (n1,(0 :num)) INSERT IMAGE (λ(n2 :num). (n1,n2)) (BIGUNION (IMAGE (line_get_code_labels :α line -> num -> bool) (set lines)))
sec_get_labels_def_typed=∀(v0 :num) (lines :α line list). sec_get_labels (Section v0 lines) = BIGUNION (IMAGE (line_get_labels :α line -> num # num -> bool) (set lines))
sec_label_ok_def_typed=(sec_label_ok (k :num) (Label (l1 :num) (l2 :num) (len :num) :α line) ⇔ l1 = k ∧ l2 ≠ (0 :num)) ∧ (sec_label_ok (v0 :num) (Asm (v6 :α asm_or_cbw) (v7 :word8 list) (v8 :num)) ⇔ T) ∧ (sec_label_ok v0 (LabAsm (v9 :α asm_with_lab) (v10 :α word) (v11 :word8 list) (v12 :num)) ⇔ T)
sec_labels_ok_def_typed=∀(k :num) (ls :α line list). sec_labels_ok (Section k ls) ⇔ EVERY (sec_label_ok k :α line -> bool) ls
line_length_def_typed=(∀(k1 :num) (k2 :num) (l :num). line_length (Label k1 k2 l :α line) = if l = (0 :num) then (0 :num) else (1 :num)) ∧ (∀(b :α asm_or_cbw) (bytes :word8 list) (l :num). line_length (Asm b bytes l) = LENGTH bytes) ∧ ∀(a :α asm_with_lab) (w :α word) (bytes :word8 list) (l :num). line_length (LabAsm a w bytes l) = LENGTH bytes
line_ok_pre_def_typed=(line_ok_pre (c :α asm_config) (Asm (b :α asm_or_cbw) (bytes :word8 list) (l :num)) ⇔ asm_ok (cbw_to_asm b) c) ∧ (line_ok_pre c (Label (v2 :num) (v3 :num) (v4 :num) :α line) ⇔ T) ∧ (line_ok_pre c (LabAsm (v8 :α asm_with_lab) (v9 :α word) (v10 :word8 list) (v11 :num)) ⇔ T)
sec_ok_pre_def_typed=∀(c :α asm_config) (k :num) (ls :α line list). sec_ok_pre c (Section k ls) ⇔ EVERY (line_ok_pre c) ls
sec_ends_with_label_def_typed=∀(v0 :num) (ls :α line list). sec_ends_with_label (Section v0 ls) ⇔ ¬NULL ls ∧ is_Label (LAST ls)
EVERY_sec_label_ok_typed=EVERY (λ((l1 :num),(l2 :num)). l1 = (n :num) ∧ l2 ≠ (0 :num)) (extract_labels (l :α line list)) ⇔ EVERY (sec_label_ok n :α line -> bool) l
