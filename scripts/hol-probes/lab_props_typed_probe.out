evaluate_align_sdm_typed=good_dimindex (:α) ⇒ ∀(s :(α, γ, 'ffi) labSem$state). (evaluate (align_sdm s) :machine_result # (α, γ, 'ffi) labSem$state) = (let ((r :machine_result),(s' :(α, γ, 'ffi) labSem$state)) = (evaluate s :machine_result # (α, γ, 'ffi) labSem$state) in (r,align_sdm s'))
