read_bytearray_mem_load_byte_aux_align_sdm_typed=∀(y :num) (x :α word). read_bytearray x y (mem_load_byte_aux (s :(α, β, γ) labSem$state).mem (align_sdm s).mem_domain s.be) = read_bytearray x y (mem_load_byte_aux s.mem s.mem_domain s.be)
