share_mem_op_align_dm_simp_typed=(share_mem_op (m :memop) (r :num) (a :β addr) (s :(β, γ, α) labSem$state) = (NONE :(α ffi_result # (β, γ, α) labSem$state) option) ⇒ share_mem_op m r a (align_dm s) = (NONE :(α ffi_result # (β, γ, α) labSem$state) option)) ∧ (share_mem_op m r a s = SOME ((FFI_final (f :final_event) :α ffi_result),(s' :(β, γ, α) labSem$state)) ⇒ share_mem_op m r a (align_dm s) = SOME ((FFI_final f :α ffi_result),align_dm s')) ∧ (share_mem_op m r a s = SOME (FFI_return (fs :α ffi_state) (l :word8 list),s') ⇒ share_mem_op m r a (align_dm s) = SOME (FFI_return fs l,align_dm s'))
