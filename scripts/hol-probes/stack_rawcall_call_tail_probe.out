call_tail_evaluate_ind_obligation=∀ret dest handler s. (∀v3 ret_handler v6 link_reg v8 l1 l2 prog v1 s2 v5 x' v h v2 l1' l2'. ret = SOME v3 ∧ v3 = (ret_handler,v6) ∧ v6 = (link_reg,v8) ∧ v8 = (l1,l2) ∧ find_code dest (s.regs \\ link_reg) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var link_reg (Loc l1 l2) s)) = (v1,s2) ∧ v1 = SOME v5 ∧ v5 = Exception x' ∧ handler = SOME v ∧ v = (h,v2) ∧ v2 = (l1',l2') ∧ x' = Loc l1' l2' ⇒ P (h,s2)) ∧ (∀v3 ret_handler v6 link_reg v8 l1 l2 prog v1 s2 v5 x. ret = SOME v3 ∧ v3 = (ret_handler,v6) ∧ v6 = (link_reg,v8) ∧ v8 = (l1,l2) ∧ find_code dest (s.regs \\ link_reg) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var link_reg (Loc l1 l2) s)) = (v1,s2) ∧ v1 = SOME v5 ∧ v5 = Result x ∧ x = Loc l1 l2 ⇒ P (ret_handler,s2)) ∧ (∀v3 ret_handler v6 link_reg v8 l1 l2 prog. ret = SOME v3 ∧ v3 = (ret_handler,v6) ∧ v6 = (link_reg,v8) ∧ v8 = (l1,l2) ∧ find_code dest (s.regs \\ link_reg) s.code = SOME prog ∧ s.clock ≠ 0 ⇒ P (prog,dec_clock (set_var link_reg (Loc l1 l2) s))) ∧ (∀prog. ret = NONE ∧ find_code dest s.regs s.code = SOME prog ∧ handler = NONE ∧ s.clock ≠ 0 ⇒ P (prog,dec_clock s)) ⇒ P (Call ret dest handler,s)
call_tail_direct64=comp (insert 3 4 LN) (Call NONE (INL 3) NONE) = Call NONE (INL 3) NONE ⇔ T
call_tail_handler64=comp (insert 3 4 LN) (Call NONE (INR 5) (SOME (Seq (StackFree 4) (Call NONE (INL 3) NONE),7,9))) = Call NONE (INR 5) (SOME (Seq (StackFree 4) (Call NONE (INL 3) NONE),7,9)) ⇔ T
