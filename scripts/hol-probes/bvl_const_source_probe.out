SmartOp_pmatch_typed=∀(op :op) (xs :exp list). SmartOp op xs = PMATCH xs [PMATCH_ROW (λ((x1 :exp),(x2 :exp)). [x1; x2]) (λ((x1 :exp),(x2 :exp)). T) (λ((x1 :exp),(x2 :exp)). SmartOp2 (SmartOp_flip op x1 x2)); PMATCH_ROW (λ(x :exp). [x]) (λ(x :exp). T) (λ(x :exp). SmartOp1 op x); PMATCH_ROW (λ(_0 :exp list). _0) (λ(_0 :exp list). T) (λ(_0 :exp list). (Op op xs :exp))]
