fix_clock_evaluate_typed=fix_clock (s :(α, β) state) (evaluate ((prog :α prog),s)) = evaluate (prog,s)
evaluate_ind_typed=∀(P :α prog # (α, 'ffi) state -> bool). (∀(s :(α, 'ffi) state). P ((Skip :α prog),s)) ∧ (∀(v :mlstring) (sh :shape) (e :α exp) (prog :α prog) (s :(α, 'ffi) state). (∀(value :α v). eval s e = SOME value ∧ sh = shape_of value ⇒ P (prog,s with locals := s.locals⟨v ↦ value⟩)) ⇒ P (Dec v sh e prog,s)) ∧ (∀(vk :varkind) (v :mlstring) (src :α exp) (s :(α, 'ffi) state). P ((Assign vk v src :α prog),s)) ∧ (∀(v :mlstring) (pop :primop) (es :α exp list) (s :(α, 'ffi) state). P (Primitive v pop es,s)) ∧ (∀(dst :α exp) (src :α exp) (s :(α, 'ffi) state). P ((Store dst src :α prog),s)) ∧ (∀(dst :α exp) (src :α exp) (s :(α, 'ffi) state). P ((Store32 dst src :α prog),s)) ∧ (∀(dst :α exp) (src :α exp) (s :(α, 'ffi) state). P (StoreByte dst src,s)) ∧ (∀(op :opsize) (vk :varkind) (v :mlstring) (ad :α exp) (s :(α, 'ffi) state). P (ShMemLoad op vk v ad,s)) ∧ (∀(op :opsize) (ad :α exp) (e :α exp) (s :(α, 'ffi) state). P (ShMemStore op ad e,s)) ∧ (∀(c1 :α prog) (c2 :α prog) (s :(α, 'ffi) state). (∀(res :α result option) (s1 :(α, 'ffi) state). (res,s1) = evaluate (c1,s) ∧ res = (NONE :α result option) ⇒ P (c2,s1)) ∧ P (c1,s) ⇒ P (Seq c1 c2,s)) ∧ (∀(e :α exp) (c1 :α prog) (c2 :α prog) (s :(α, 'ffi) state). (∀(v1 :α v) (v6 :α word_lab) (w :α word). eval s e = SOME v1 ∧ v1 = Val v6 ∧ v6 = (Word w :α word_lab) ⇒ P (if w ≠ (0w :α word) then c1 else c2,s)) ⇒ P ((If e c1 c2 :α prog),s)) ∧ (∀(s :(α, 'ffi) state). P ((Break :α prog),s)) ∧ (∀(s :(α, 'ffi) state). P ((Continue :α prog),s)) ∧ (∀(e :α exp) (c :α prog) (s :(α, 'ffi) state). (∀(v2 :α v) (v11 :α word_lab) (w :α word) (res :α result option) (s1 :(α, 'ffi) state) (v1 :α result). eval s e = SOME v2 ∧ v2 = Val v11 ∧ v11 = (Word w :α word_lab) ∧ w ≠ (0w :α word) ∧ s.clock ≠ (0 :num) ∧ (res,s1) = evaluate (c,dec_clock s) ∧ res = SOME v1 ∧ v1 = (Continue :α result) ⇒ P ((While e c :α prog),s1)) ∧ (∀(v2 :α v) (v11 :α word_lab) (w :α word) (res :α result option) (s1 :(α, 'ffi) state). eval s e = SOME v2 ∧ v2 = Val v11 ∧ v11 = (Word w :α word_lab) ∧ w ≠ (0w :α word) ∧ s.clock ≠ (0 :num) ∧ (res,s1) = evaluate (c,dec_clock s) ∧ res = (NONE :α result option) ⇒ P ((While e c :α prog),s1)) ∧ (∀(v2 :α v) (v11 :α word_lab) (w :α word). eval s e = SOME v2 ∧ v2 = Val v11 ∧ v11 = (Word w :α word_lab) ∧ w ≠ (0w :α word) ∧ s.clock ≠ (0 :num) ⇒ P (c,dec_clock s)) ⇒ P ((While e c :α prog),s)) ∧ (∀(e :α exp) (s :(α, 'ffi) state). P ((Return e :α prog),s)) ∧ (∀(eid :mlstring) (e :α exp) (s :(α, 'ffi) state). P ((Raise eid e :α prog),s)) ∧ (∀(s :(α, 'ffi) state). P ((Tick :α prog),s)) ∧ (∀(v0 :mlstring) (v1 :mlstring) (s :(α, 'ffi) state). P ((Annot v0 v1 :α prog),s)) ∧ (∀(caltyp :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) (fname :mlstring) (argexps :α exp list) (s :(α, 'ffi) state). (∀(args :α v list) (v7 :α prog # (mlstring |-> α v) # shape) (prog :α prog) (v12 :(mlstring |-> α v) # shape) (newlocals :mlstring |-> α v) (return_sh :shape) (eval_prog :α result option # (α, 'ffi) state) (v4 :α result option) (st :(α, 'ffi) state) (v8 :α result) (eid :mlstring) (exn :α v) (v :(varkind # mlstring) option # (mlstring # mlstring # α prog) option) (v1 :(varkind # mlstring) option) (v2 :(mlstring # mlstring # α prog) option) (v3 :mlstring # mlstring # α prog) (eid' :mlstring) (v5 :mlstring # α prog) (evar :mlstring) (p :α prog) (sh :shape). OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v7 ∧ v7 = (prog,v12) ∧ v12 = (newlocals,return_sh) ∧ s.clock ≠ (0 :num) ∧ eval_prog = evaluate (prog,dec_clock s with locals := newlocals) ∧ eval_prog = (v4,st) ∧ v4 = SOME v8 ∧ v8 = Exception eid exn ∧ caltyp = SOME v ∧ v = (v1,v2) ∧ v2 = SOME v3 ∧ v3 = (eid',v5) ∧ v5 = (evar,p) ∧ eid = eid' ∧ FLOOKUP s.eshapes eid = SOME sh ∧ shape_of exn = sh ∧ is_valid_value s Local evar exn ⇒ P (p,set_var evar exn (st with locals := s.locals))) ∧ (∀(args :α v list) (v7 :α prog # (mlstring |-> α v) # shape) (prog :α prog) (v12 :(mlstring |-> α v) # shape) (newlocals :mlstring |-> α v) (return_sh :shape). OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v7 ∧ v7 = (prog,v12) ∧ v12 = (newlocals,return_sh) ∧ s.clock ≠ (0 :num) ⇒ P (prog,dec_clock s with locals := newlocals)) ⇒ P ((Call caltyp fname argexps :α prog),s)) ∧ (∀(rt :mlstring) (shape :shape) (fname :mlstring) (argexps :α exp list) (prog1 :α prog) (s :(α, 'ffi) state). (∀(args :α v list) (v2 :α prog # (mlstring |-> α v) # shape) (prog :α prog) (v7 :(mlstring |-> α v) # shape) (newlocals :mlstring |-> α v) (return_sh :shape) (eval_prog :α result option # (α, 'ffi) state) (v :α result option) (st :(α, 'ffi) state) (v3 :α result) (retv :α v). OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v2 ∧ v2 = (prog,v7) ∧ v7 = (newlocals,return_sh) ∧ s.clock ≠ (0 :num) ∧ eval_prog = evaluate (prog,dec_clock s with locals := newlocals) ∧ eval_prog = (v,st) ∧ v = SOME v3 ∧ v3 = (Return retv :α result) ∧ shape_of retv = shape ∧ shape_of retv = return_sh ⇒ P (prog1,set_var rt retv (st with locals := s.locals))) ∧ (∀(args :α v list) (v2 :α prog # (mlstring |-> α v) # shape) (prog :α prog) (v7 :(mlstring |-> α v) # shape) (newlocals :mlstring |-> α v) (return_sh :shape). OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v2 ∧ v2 = (prog,v7) ∧ v7 = (newlocals,return_sh) ∧ s.clock ≠ (0 :num) ⇒ P (prog,dec_clock s with locals := newlocals)) ⇒ P (DecCall rt shape fname argexps prog1,s)) ∧ (∀(ffi_index :mlstring) (ptr1 :α exp) (len1 :α exp) (ptr2 :α exp) (len2 :α exp) (s :(α, 'ffi) state). P ((ExtCall ffi_index ptr1 len1 ptr2 len2 :α prog),s)) ⇒ ∀(v :α prog) (v1 :(α, 'ffi) state). P (v,v1)
mem_load_32_alt_typed=mem_load_32 (m :α word -> α word_lab) (dm :α word -> bool) (be :bool) (w :α word) = if aligned (2 :num) w then case m (byte_align w) of (Word v :α word_lab) => if byte_align w ∈ dm then (let (b0 :word8) = get_byte w v be; (b1 :word8) = get_byte (w + (1w :α word)) v be; (b2 :word8) = get_byte (w + (2w :α word)) v be; (b3 :word8) = get_byte (w + (3w :α word)) v be; (v' :word32) = if be then (w2w b0 :word32) ≪ (24 :num) ‖ (w2w b1 :word32) ≪ (16 :num) ‖ (w2w b2 :word32) ≪ (8 :num) ‖ (w2w b3 :word32) else (w2w b0 :word32) ‖ (w2w b1 :word32) ≪ (8 :num) ‖ (w2w b2 :word32) ≪ (16 :num) ‖ (w2w b3 :word32) ≪ (24 :num) in SOME v') else (NONE :word32 option) else (NONE :word32 option)
mem_load_def_typed=(∀(stcs :(mlstring # struct_info) list) (sh :shape) (m :α word -> α word_lab) (dm :α word -> bool) (addr :α word). mem_load sh addr dm m stcs = case sh of One => if addr ∈ dm then SOME (Val (m addr)) else (NONE :α v option) | Comb shapes => (case mem_loads shapes addr dm m stcs of (NONE :α v list option) => (NONE :α v option) | SOME vs => SOME (RStruct vs)) | Named nm => case dropWhile (λ((n :mlstring),(i :struct_info)). n ≠ nm) stcs of ([] :(mlstring # struct_info) list) => (NONE :α v option) | (nm',info)::stcs' => case mem_load_flds info.fields addr dm m stcs' of (NONE :(mlstring # α v) list option) => (NONE :α v option) | SOME vflds => SOME (NStruct nm' vflds)) ∧ (∀(stcs :(mlstring # struct_info) list) (m :α word -> α word_lab) (dm :α word -> bool) (addr :α word). mem_loads ([] :shape list) addr dm m stcs = SOME ([] :α v list)) ∧ (∀(stcs :(mlstring # struct_info) list) (shapes :shape list) (shape :shape) (m :α word -> α word_lab) (dm :α word -> bool) (addr :α word). mem_loads (shape::shapes) addr dm m stcs = case (mem_load shape addr dm m stcs,mem_loads shapes (addr + (bytes_in_word :α word) * (n2w (size_of_sh_with_ctxt stcs shape) :α word)) dm m stcs) of ((NONE :α v option),v4) => (NONE :α v list option) | (SOME v,(NONE :α v list option)) => (NONE :α v list option) | (SOME v,SOME vs) => SOME (v::vs)) ∧ (∀(stcs :(mlstring # struct_info) list) (m :α word -> α word_lab) (dm :α word -> bool) (addr :α word). mem_load_flds ([] :(mlstring # shape) list) addr dm m stcs = SOME ([] :(mlstring # α v) list)) ∧ ∀(stcs :(mlstring # struct_info) list) (shape :shape) (m :α word -> α word_lab) (fld :mlstring) (fields :(mlstring # shape) list) (dm :α word -> bool) (addr :α word). mem_load_flds ((fld,shape)::fields) addr dm m stcs = case (mem_load shape addr dm m stcs,mem_load_flds fields (addr + (bytes_in_word :α word) * (n2w (size_of_sh_with_ctxt stcs shape) :α word)) dm m stcs) of ((NONE :α v option),v4) => (NONE :(mlstring # α v) list option) | (SOME v,(NONE :(mlstring # α v) list option)) => (NONE :(mlstring # α v) list option) | (SOME v,SOME vflds) => SOME ((fld,v)::vflds)
mem_store_32_alt_typed=mem_store_32 (m :α word -> α word_lab) (dm :α word -> bool) (be :bool) (w :α word) (hw :word32) = if aligned (2 :num) w then case m (byte_align w) of (Word v :α word_lab) => if byte_align w ∈ dm then if be then (let (v0 :α word) = set_byte w (w2w (hw ⋙ (24 :num)) :word8) v be; (v1 :α word) = set_byte (w + (1w :α word)) (w2w (hw ⋙ (16 :num)) :word8) v0 be; (v2 :α word) = set_byte (w + (2w :α word)) (w2w (hw ⋙ (8 :num)) :word8) v1 be; (v3 :α word) = set_byte (w + (3w :α word)) (w2w hw :word8) v2 be in SOME m⦇byte_align w ↦ (Word v3 :α word_lab)⦈) else (let (v0 :α word) = set_byte w (w2w hw :word8) v be; (v1 :α word) = set_byte (w + (1w :α word)) (w2w (hw ⋙ (8 :num)) :word8) v0 be; (v2 :α word) = set_byte (w + (2w :α word)) (w2w (hw ⋙ (16 :num)) :word8) v1 be; (v3 :α word) = set_byte (w + (3w :α word)) (w2w (hw ⋙ (24 :num)) :word8) v2 be in SOME m⦇byte_align w ↦ (Word v3 :α word_lab)⦈) else (NONE :(α word -> α word_lab) option) else (NONE :(α word -> α word_lab) option)
semantics_def_typed=∀(s :(α, 'ffi) state) (start :mlstring). semantics s start = (let (prog :α prog) = TailCall start ([] :α exp list) in if ∃(k :num). case FST (evaluate (prog,s with clock := k)) of (NONE :α result option) => T | SOME (Error :α result) => T | SOME (TimeOut :α result) => F | SOME (Break :α result) => T | SOME (Continue :α result) => T | SOME (Return v6 :α result) => F | SOME (Exception v7 v8) => T | SOME (FinalFFI v9 :α result) => F then Fail else case some(res :behaviour). ∃(k :num) (t :(α, 'ffi) state) (r :α result option) (outcome :outcome). evaluate (prog,s with clock := k) = (r,t) ∧ (case r of (NONE :α result option) => F | SOME (Error :α result) => F | SOME (TimeOut :α result) => F | SOME (Break :α result) => F | SOME (Continue :α result) => F | SOME (Return v6 :α result) => outcome = Success | SOME (Exception v7 v8) => F | SOME (FinalFFI e :α result) => outcome = FFI_outcome e) ∧ res = Terminate outcome t.ffi.io_events of (NONE :behaviour option) => Diverge (LUB (IMAGE (λ(k :num). (fromList (SND (evaluate (prog,s with clock := k))).ffi.io_events :io_event llist)) 𝕌(:num))) | SOME res => res)
semantics_decls_def_typed=∀(s :(α, 'ffi) state) (start :mlstring) (decls :α decl list). semantics_decls s start decls = case decs_stcnames ([] :(mlstring # struct_info) list) decls of (NONE :(mlstring # struct_info) list option) => Fail | SOME st_ctxt => case evaluate_decls (s with structs := st_ctxt) decls of (NONE :(α, 'ffi) state option) => Fail | SOME s' => semantics s' start
state_typed=recordtype.state::(mlstring |-> α v) -> (mlstring |-> α v) -> (mlstring # struct_info) list -> (mlstring |-> (mlstring # shape) list # α prog # shape) -> (mlstring |-> shape) -> (α word -> α word_lab) -> (α word -> bool) -> (α word -> bool) -> num -> bool -> 'ffi ffi_state -> α word -> α word -> (α, 'ffi) state
dec_clock_def_typed=∀(s :(α, 'ffi) state). dec_clock s = s with clock := s.clock − (1 :num)
empty_locals_def_typed=∀(s :(α, 'ffi) state). empty_locals s = s with locals := (FEMPTY :mlstring |-> α v)
eval_def_typed=(∀(w :α word) (s :(α, 'ffi) state). eval s (Const w :α exp) = SOME (ValWord w)) ∧ (∀(v :mlstring) (s :(α, 'ffi) state). eval s (Var Local v :α exp) = FLOOKUP s.locals v) ∧ (∀(v :mlstring) (s :(α, 'ffi) state). eval s (Var Global v :α exp) = FLOOKUP s.globals v) ∧ (∀(s :(α, 'ffi) state) (es :α exp list). eval s (RStruct es) = case OPT_MMAP (λ(a :α exp). eval s a) es of (NONE :α v list option) => (NONE :α v option) | SOME vs => SOME (RStruct vs)) ∧ (∀(s :(α, 'ffi) state) (index :num) (e :α exp). eval s (RField index e) = case eval s e of (NONE :α v option) => (NONE :α v option) | SOME (Val v6) => (NONE :α v option) | SOME (RStruct vs) => if index < LENGTH vs then SOME vs❲index❳ else (NONE :α v option) | SOME (NStruct v8 v9) => (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state) (nm :mlstring) (eflds :(mlstring # α exp) list). eval s (NStruct nm eflds) = (let ((field_names :mlstring list),(field_exps :α exp list)) = UNZIP eflds in case ALOOKUP s.structs nm of (NONE :struct_info option) => (NONE :α v option) | SOME info => (let ((field_names' :mlstring list),(field_shapes :shape list)) = UNZIP info.fields in if field_names' = field_names then case OPT_MMAP (λ(a :α exp). eval s a) field_exps of (NONE :α v list option) => (NONE :α v option) | SOME field_vals => if EVERY (λ((s :shape),(v :α v)). s = shape_of v) (ZIP (field_shapes,field_vals)) then SOME (NStruct nm (ZIP (field_names,field_vals))) else (NONE :α v option) else (NONE :α v option)))) ∧ (∀(s :(α, 'ffi) state) (fld :mlstring) (e :α exp). eval s (NField fld e) = case eval s e of (NONE :α v option) => (NONE :α v option) | SOME (Val v6) => (NONE :α v option) | SOME (RStruct v7) => (NONE :α v option) | SOME (NStruct nm vflds) => if ALOOKUP s.structs nm ≠ (NONE :struct_info option) then ALOOKUP vflds fld else (NONE :α v option)) ∧ (∀(shape :shape) (s :(α, 'ffi) state) (addr :α exp). eval s (Load shape addr :α exp) = if is_wf_shape s.structs shape then case eval s addr of (NONE :α v option) => (NONE :α v option) | SOME (ValWord w) => mem_load shape w s.memaddrs s.memory s.structs | SOME (RStruct v7) => (NONE :α v option) | SOME (NStruct v8 v9) => (NONE :α v option) else (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state) (addr :α exp). eval s (Load32 addr :α exp) = case eval s addr of (NONE :α v option) => (NONE :α v option) | SOME (ValWord w) => (case mem_load_32 s.memory s.memaddrs s.be w of (NONE :word32 option) => (NONE :α v option) | SOME w => SOME (ValWord (w2w w :α word))) | SOME (RStruct v7) => (NONE :α v option) | SOME (NStruct v8 v9) => (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state) (addr :α exp). eval s (LoadByte addr) = case eval s addr of (NONE :α v option) => (NONE :α v option) | SOME (ValWord w) => (case mem_load_byte s.memory s.memaddrs s.be w of (NONE :word8 option) => (NONE :α v option) | SOME w => SOME (ValWord (w2w w :α word))) | SOME (RStruct v7) => (NONE :α v option) | SOME (NStruct v8 v9) => (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state) (op :binop) (es :α exp list). eval s (Op op es) = case OPT_MMAP (λ(a :α exp). eval s a) es of (NONE :α v list option) => (NONE :α v option) | SOME ws => if EVERY (λ(w :α v). case w of Val v4 => T | RStruct v5 => F | NStruct v6 v7 => F) ws then OPTION_MAP (λ(w :α word). ValWord w) (word_op op (MAP (λ(w :α v). case w of ValWord n => n | RStruct v1 => (ARB :α word) | NStruct v3 v4 => (ARB :α word)) ws)) else (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state) (op :panop) (es :α exp list). eval s (Panop op es) = case OPT_MMAP (λ(a :α exp). eval s a) es of (NONE :α v list option) => (NONE :α v option) | SOME ws => if EVERY (λ(w :α v). case w of Val v4 => T | RStruct v5 => F | NStruct v6 v7 => F) ws then OPTION_MAP (λ(w :α word). ValWord w) (pan_op op (MAP (λ(w :α v). case w of ValWord n => n | RStruct v1 => (ARB :α word) | NStruct v3 v4 => (ARB :α word)) ws)) else (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state) (e2 :α exp) (e1 :α exp) (cmp :cmp). eval s (Cmp cmp e1 e2) = case (eval s e1,eval s e2) of ((NONE :α v option),v3) => (NONE :α v option) | (SOME (Val v10),(NONE :α v option)) => (NONE :α v option) | (SOME (ValWord w1),SOME (ValWord w2)) => SOME (ValWord (if word_cmp cmp w1 w2 then (1w :α word) else (0w :α word))) | (SOME (Val v10),SOME (RStruct v21)) => (NONE :α v option) | (SOME (Val v10),SOME (NStruct v22 v23)) => (NONE :α v option) | (SOME (RStruct v11),v3) => (NONE :α v option) | (SOME (NStruct v12 v13),v3) => (NONE :α v option)) ∧ (∀(sh :ast$shift) (s :(α, 'ffi) state) (e2 :α exp) (e1 :α exp). eval s (Shift sh e1 e2 :α exp) = case (eval s e1,eval s e2) of ((NONE :α v option),v3) => (NONE :α v option) | (SOME (Val v10),(NONE :α v option)) => (NONE :α v option) | (SOME (ValWord w1),SOME (ValWord w2)) => OPTION_MAP (λ(w :α word). ValWord w) (word_sh sh w1 (w2n w2)) | (SOME (Val v10),SOME (RStruct v21)) => (NONE :α v option) | (SOME (Val v10),SOME (NStruct v22 v23)) => (NONE :α v option) | (SOME (RStruct v11),v3) => (NONE :α v option) | (SOME (NStruct v12 v13),v3) => (NONE :α v option)) ∧ (∀(s :(α, 'ffi) state). eval s (BaseAddr :α exp) = SOME (ValWord s.base_addr)) ∧ (∀(s :(α, 'ffi) state). eval s (TopAddr :α exp) = SOME (ValWord s.top_addr)) ∧ ∀(s :(α, 'ffi) state). eval s (BytesInWord :α exp) = SOME (ValWord (bytes_in_word :α word))
evaluate_decls_def_typed=(∀(s :(α, 'ffi) state). evaluate_decls s ([] :α decl list) = SOME s) ∧ (∀(s :(α, 'ffi) state) (nm :mlstring) (flds :(mlstring # shape) list) (ds :α decl list). evaluate_decls s ((Name nm flds :α decl)::ds) = evaluate_decls s ds) ∧ (∀(v :mlstring) (sh :shape) (s :(α, 'ffi) state) (e :α exp) (ds :α decl list). evaluate_decls s (Decl sh v e::ds) = case eval (s with locals := (FEMPTY :mlstring |-> α v)) e of (NONE :α v option) => (NONE :(α, 'ffi) state option) | SOME res => if sh = shape_of res then evaluate_decls (s with globals := s.globals⟨v ↦ res⟩) ds else (NONE :(α, 'ffi) state option)) ∧ (∀(s :(α, 'ffi) state) (fi :α fun_decl) (ds :α decl list). evaluate_decls s (Function fi::ds) = if EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) fi.params ∧ is_wf_shape s.structs fi.return then evaluate_decls (s with code := s.code⟨fi.name ↦ (fi.params,fi.body,fi.return)⟩) ds else (NONE :(α, 'ffi) state option)) ∧ ∀(sh :shape) (s :(α, 'ffi) state) (eid :mlstring) (ds :α decl list). evaluate_decls s ((ExnDecl eid sh :α decl)::ds) = if FLOOKUP s.eshapes eid = (NONE :shape option) ∧ is_wf_shape s.structs sh then evaluate_decls (s with eshapes := s.eshapes⟨eid ↦ sh⟩) ds else (NONE :(α, 'ffi) state option)
fix_clock_def_typed=∀(old_s :(δ, ε) state) (res :α) (new_s :(β, γ) state). fix_clock old_s (res,new_s) = (res,new_s with clock := if old_s.clock < new_s.clock then old_s.clock else new_s.clock)
is_valid_value_def_typed=∀(s :(α, β) state) (vk :varkind) (v :mlstring) (value :γ v). is_valid_value s vk v value ⇔ case lookup_kvar vk v s of (NONE :α v option) => F | SOME w => shape_of value = shape_of w
lookup_code_def_typed=∀(code :ε |-> (β # shape) list # α # δ) (fname :ε) (args :γ v list). lookup_code code fname args = case FLOOKUP code fname of (NONE :((β # shape) list # α # δ) option) => (NONE :(α # (β |-> γ v) # δ) option) | SOME (vshapes,prog,rshape) => if ALL_DISTINCT (MAP (FST :β # shape -> β) vshapes) ∧ LIST_REL (λ(vshape :β # shape) (arg :γ v). SND vshape = shape_of arg) vshapes args then SOME (prog,(FEMPTY :β |-> γ v) |++ ZIP (MAP (FST :β # shape -> β) vshapes,args),rshape) else (NONE :(α # (β |-> γ v) # δ) option)
lookup_kvar_def_typed=∀(vk :varkind) (v :mlstring) (s :(α, 'ffi) state). lookup_kvar vk v s = case vk of Local => FLOOKUP s.locals v | Global => FLOOKUP s.globals v
set_global_def_typed=∀(v :mlstring) (value :α v) (s :(α, 'ffi) state). set_global v value s = s with globals := s.globals⟨v ↦ value⟩
set_kvar_def_typed=∀(vk :varkind) (v :mlstring) (value :α v) (s :(α, 'ffi) state). set_kvar vk v value s = case vk of Local => set_var v value s | Global => set_global v value s
set_var_def_typed=∀(v :mlstring) (value :α v) (s :(α, 'ffi) state). set_var v value s = s with locals := s.locals⟨v ↦ value⟩
sh_mem_load_def_typed=∀(vk :varkind) (v :mlstring) (addr :α word) (nb :num) (s :(α, 'ffi) state). (sh_mem_load vk v addr nb s :β result option # (α, 'ffi) state) = if nb = (0 :num) then if addr ∈ s.sh_memaddrs then case call_FFI s.ffi (SharedMem MappedRead) [(n2w nb :word8)] (word_to_bytes addr F) of FFI_return new_ffi new_bytes => ((NONE :β result option),set_kvar vk v (ValWord (word_of_bytes F (0w :α word) new_bytes)) s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),empty_locals s) else (SOME (Error :β result),s) else if byte_align addr ∈ s.sh_memaddrs then case call_FFI s.ffi (SharedMem MappedRead) [(n2w nb :word8)] (word_to_bytes addr F) of FFI_return new_ffi new_bytes => ((NONE :β result option),set_kvar vk v (ValWord (word_of_bytes F (0w :α word) new_bytes)) s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),empty_locals s) else (SOME (Error :β result),s)
v_typed=Val::α word_lab -> α v; RStruct::α v list -> α v; NStruct::mlstring -> (mlstring # α v) list -> α v
flatten_def_typed=(∀(w :α word_lab). flatten (Val w) = [w]) ∧ (∀(vs :α v list). flatten (RStruct vs) = FLAT (MAP (λ(a :α v). flatten a) vs)) ∧ ∀(nm :mlstring) (flds :(mlstring # α v) list). flatten (NStruct nm flds) = FLAT (MAP (λ(a :α v). flatten a) (MAP (SND :mlstring # α v -> α v) flds))
isValWord_def_typed=(isValWord (ValWord (v0 :α word)) ⇔ T) ∧ (isValWord (RStruct (v2 :α v list)) ⇔ F) ∧ (isValWord (NStruct (v3 :mlstring) (v4 :(mlstring # α v) list)) ⇔ F)
pan_primop_def_typed=∀(args :α v list). pan_primop AddCarry args = if LENGTH args = (3 :num) ∧ EVERY (isValWord :α v -> bool) args then (let (l :α word) = theValWord args❲(0 :num)❳; (r :α word) = theValWord args❲(1 :num)❳; (ci :α word) = theValWord args❲(2 :num)❳; ((res :α word),(co :α word)) = word_add_carry l r ci in SOME (RStruct [ValWord res; ValWord co])) else (NONE :α v option)
theValWord_def_typed=theValWord (ValWord (w :α word)) = w
isWord_def_typed=isWord (Word (v0 :α word) :α word_lab) ⇔ T
nb_op_def_typed=nb_op Op8 = (1 :num) ∧ nb_op Op16 = (2 :num) ∧ nb_op OpW = (0 :num) ∧ nb_op Op32 = (4 :num)
mem_load_32_def_typed=∀(m :α word -> α word_lab) (dm :α word -> bool) (be :bool) (w :α word). mem_load_32 m dm be w = if aligned (2 :num) w then case m (byte_align w) of (Word v :α word_lab) => if byte_align w ∈ dm then SOME (word_of_bytes be (0w :word32) [get_byte w v be; get_byte (w + (1w :α word)) v be; get_byte (w + (2w :α word)) v be; get_byte (w + (3w :α word)) v be]) else (NONE :word32 option) else (NONE :word32 option)
mem_load_byte_def_typed=∀(m :α word -> α word_lab) (dm :α word -> bool) (be :bool) (w :α word). mem_load_byte m dm be w = case m (byte_align w) of (Word v :α word_lab) => if byte_align w ∈ dm then SOME (get_byte w v be) else (NONE :word8 option)
mem_store_32_def_typed=∀(m :α word -> α word_lab) (dm :α word -> bool) (be :bool) (w :α word) (hw :word32). mem_store_32 m dm be w hw = if aligned (2 :num) w then case m (byte_align w) of (Word v :α word_lab) => if byte_align w ∈ dm then (let (v0 :α word) = set_byte w (get_byte (0w :word32) hw be) v be; (v1 :α word) = set_byte (w + (1w :α word)) (get_byte (1w :word32) hw be) v0 be; (v2 :α word) = set_byte (w + (2w :α word)) (get_byte (2w :word32) hw be) v1 be; (v3 :α word) = set_byte (w + (3w :α word)) (get_byte (3w :word32) hw be) v2 be in SOME m⦇byte_align w ↦ (Word v3 :α word_lab)⦈) else (NONE :(α word -> α word_lab) option) else (NONE :(α word -> α word_lab) option)
mem_store_byte_def_typed=∀(m :α word -> α word_lab) (dm :α word -> bool) (be :bool) (w :α word) (b :word8). mem_store_byte m dm be w b = case m (byte_align w) of (Word v :α word_lab) => if byte_align w ∈ dm then SOME m⦇byte_align w ↦ (Word (set_byte w b v be) :α word_lab)⦈ else (NONE :(α word -> α word_lab) option)
mem_store_def_typed=∀(addr :α word) (w :α word_lab) (dm :α word -> bool) (m :α word -> α word_lab). mem_store addr w dm m = if addr ∈ dm then SOME m⦇addr ↦ w⦈ else (NONE :(α word -> α word_lab) option)
mem_stores_def_typed=(∀(a :α word) (dm :α word -> bool) (m :α word -> α word_lab). mem_stores a ([] :α word_lab list) dm m = SOME m) ∧ ∀(a :α word) (w :α word_lab) (ws :α word_lab list) (dm :α word -> bool) (m :α word -> α word_lab). mem_stores a (w::ws) dm m = case mem_store a w dm m of (NONE :(α word -> α word_lab) option) => (NONE :(α word -> α word_lab) option) | SOME m' => mem_stores (a + (bytes_in_word :α word)) ws dm m'
pan_op_def_typed=pan_op Mul [(w1 :α word); (w2 :α word)] = SOME (w1 * w2) ∧ pan_op Mul ([] :α word list) = (NONE :α word option) ∧ pan_op Mul [(v3 :α word)] = (NONE :α word option) ∧ pan_op Mul (v3::(v7 :α word)::(v11 :α word)::(v12 :α word list)) = (NONE :α word option)
write_bytearray_def_typed=(∀(a :α word) (m :α word -> α word_lab) (dm :α word -> bool) (be :bool). write_bytearray a ([] :word8 list) m dm be = m) ∧ ∀(a :α word) (b :word8) (bs :word8 list) (m :α word -> α word_lab) (dm :α word -> bool) (be :bool). write_bytearray a (b::bs) m dm be = case mem_store_byte (write_bytearray (a + (1w :α word)) bs m dm be) dm be a b of (NONE :(α word -> α word_lab) option) => m | SOME v => v
theWord_def_typed=∀(w :α word). theWord (Word w :α word_lab) = w
kvar_simps_typed=set_kvar Local (v :mlstring) (value :α v) (s :(α, β) state) = set_var v value s ∧ set_kvar Global v value s = set_global v value s ∧ lookup_kvar Local v s = FLOOKUP s.locals v ∧ lookup_kvar Global v s = FLOOKUP s.globals v
is_valid_value_simps_typed=(is_valid_value (s :(α, β) state) Local (v :mlstring) (value :γ v) ⇔ case FLOOKUP s.locals v of (NONE :α v option) => F | SOME w => shape_of value = shape_of w) ∧ (is_valid_value s Global v value ⇔ case FLOOKUP s.globals v of (NONE :α v option) => F | SOME w => shape_of value = shape_of w)
upd_locals_def_typed=∀(varargs :(mlstring # α v) list) (s :(α, 'ffi) state). upd_locals varargs s = s with locals := (FEMPTY :mlstring |-> α v) |++ varargs
res_var_def_typed=res_var (lc :α |-> β) ((n :α),(NONE :β option)) = lc \\ n ∧ res_var lc (n,SOME (v :β)) = lc⟨n ↦ v⟩
sh_mem_store_def_typed=∀(w :γ word) (addr :α word) (nb :num) (s :(α, 'ffi) state). (sh_mem_store w addr nb s :β result option # (α, 'ffi) state) = if nb = (0 :num) then if addr ∈ s.sh_memaddrs then case call_FFI s.ffi (SharedMem MappedWrite) [(n2w nb :word8)] (word_to_bytes w F ++ word_to_bytes addr F) of FFI_return new_ffi new_bytes => ((NONE :β result option),s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),s) else (SOME (Error :β result),s) else if byte_align addr ∈ s.sh_memaddrs then case call_FFI s.ffi (SharedMem MappedWrite) [(n2w nb :word8)] (TAKE nb (word_to_bytes w F) ++ word_to_bytes addr F) of FFI_return new_ffi new_bytes => ((NONE :β result option),s with ffi := new_ffi) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :β result),s) else (SOME (Error :β result),s)
