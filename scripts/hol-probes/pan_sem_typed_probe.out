word_lab_typed=Word::α word -> α word_lab
vshapes_args_rel_imp_eq_len_MAP_typed=∀(vshapes :(α # shape) list) (args :β v list). LIST_REL (λ(vshape :α # shape) (arg :β v). SND vshape = shape_of arg) vshapes args ⇒ LENGTH vshapes = LENGTH args ∧ MAP (SND :α # shape -> shape) vshapes = MAP (shape_of :β v -> shape) args
result_typed=Error::α result; TimeOut::α result; Break::α result; Continue::α result; Return::α v -> α result; Exception::mlstring -> α v -> α result; FinalFFI::final_event -> α result
decs_stcnames_def_typed=(∀(st_ctxt :(mlstring # struct_info) list). decs_stcnames st_ctxt ([] :α decl list) = SOME st_ctxt) ∧ (∀(st_ctxt :(mlstring # struct_info) list) (nm :mlstring) (flds :(mlstring # shape) list) (ds :α decl list). decs_stcnames st_ctxt ((Name nm flds :α decl)::ds) = case ALOOKUP st_ctxt nm of (NONE :struct_info option) => if ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) flds) then (let (shs :shape list) = MAP (SND :mlstring # shape -> shape) flds in if EVERY (is_wf_shape st_ctxt) shs then (let (info :struct_info) = <|fields := flds; size := size_of_sh_with_ctxt st_ctxt (Comb shs)|> in decs_stcnames ((nm,info)::st_ctxt) ds) else (NONE :(mlstring # struct_info) list option)) else (NONE :(mlstring # struct_info) list option) | SOME info => (NONE :(mlstring # struct_info) list option)) ∧ (∀(v :mlstring) (st_ctxt :(mlstring # struct_info) list) (sh :shape) (e :α exp) (ds :α decl list). decs_stcnames st_ctxt (Decl sh v e::ds) = decs_stcnames st_ctxt ds) ∧ (∀(st_ctxt :(mlstring # struct_info) list) (fi :α fun_decl) (ds :α decl list). decs_stcnames st_ctxt (Function fi::ds) = decs_stcnames st_ctxt ds) ∧ ∀(st_ctxt :(mlstring # struct_info) list) (sh :shape) (eid :mlstring) (ds :α decl list). decs_stcnames st_ctxt ((ExnDecl eid sh :α decl)::ds) = decs_stcnames st_ctxt ds
eval_ind_typed=∀(P :(α, 'ffi) state -> α exp -> bool). (∀(s :(α, 'ffi) state) (w :α word). P s (Const w :α exp)) ∧ (∀(s :(α, 'ffi) state) (v :mlstring). P s (Var Local v :α exp)) ∧ (∀(s :(α, 'ffi) state) (v :mlstring). P s (Var Global v :α exp)) ∧ (∀(s :(α, 'ffi) state) (es :α exp list). (∀(a :α exp). MEM a es ⇒ P s a) ⇒ P s (RStruct es)) ∧ (∀(s :(α, 'ffi) state) (index :num) (e :α exp). P s e ⇒ P s (RField index e)) ∧ (∀(s :(α, 'ffi) state) (nm :mlstring) (eflds :(mlstring # α exp) list). (∀(field_names :mlstring list) (field_exps :α exp list) (info :struct_info) (field_names' :mlstring list) (field_shapes :shape list) (a :α exp). (field_names,field_exps) = UNZIP eflds ∧ ALOOKUP s.structs nm = SOME info ∧ (field_names',field_shapes) = UNZIP info.fields ∧ field_names' = field_names ∧ MEM a field_exps ⇒ P s a) ⇒ P s (NStruct nm eflds)) ∧ (∀(s :(α, 'ffi) state) (fld :mlstring) (e :α exp). P s e ⇒ P s (NField fld e)) ∧ (∀(s :(α, 'ffi) state) (shape :shape) (addr :α exp). (is_wf_shape s.structs shape ⇒ P s addr) ⇒ P s (Load shape addr :α exp)) ∧ (∀(s :(α, 'ffi) state) (addr :α exp). P s addr ⇒ P s (Load32 addr :α exp)) ∧ (∀(s :(α, 'ffi) state) (addr :α exp). P s addr ⇒ P s (LoadByte addr)) ∧ (∀(s :(α, 'ffi) state) (op :binop) (es :α exp list). (∀(a :α exp). MEM a es ⇒ P s a) ⇒ P s (Op op es)) ∧ (∀(s :(α, 'ffi) state) (op :panop) (es :α exp list). (∀(a :α exp). MEM a es ⇒ P s a) ⇒ P s (Panop op es)) ∧ (∀(s :(α, 'ffi) state) (cmp :cmp) (e1 :α exp) (e2 :α exp). P s e1 ∧ P s e2 ⇒ P s (Cmp cmp e1 e2)) ∧ (∀(s :(α, 'ffi) state) (sh :ast$shift) (e1 :α exp) (e2 :α exp). P s e1 ∧ P s e2 ⇒ P s (Shift sh e1 e2 :α exp)) ∧ (∀(s :(α, 'ffi) state). P s (BaseAddr :α exp)) ∧ (∀(s :(α, 'ffi) state). P s (TopAddr :α exp)) ∧ (∀(s :(α, 'ffi) state). P s (BytesInWord :α exp)) ⇒ ∀(v :(α, 'ffi) state) (v1 :α exp). P v v1
evaluate_def_typed=(∀(s :(α, 'ffi) state). evaluate ((Skip :α prog),s) = ((NONE :α result option),s)) ∧ (∀(v :mlstring) (sh :shape) (s :(α, 'ffi) state) (prog :α prog) (e :α exp). evaluate (Dec v sh e prog,s) = case eval s e of (NONE :α v option) => (SOME (Error :α result),s) | SOME value => if sh = shape_of value then (let ((res :α result option),(st :(α, 'ffi) state)) = evaluate (prog,s with locals := s.locals⟨v ↦ value⟩) in (res,st with locals := res_var st.locals (v,FLOOKUP s.locals v))) else (SOME (Error :α result),s)) ∧ (∀(vk :varkind) (v :mlstring) (src :α exp) (s :(α, 'ffi) state). evaluate ((Assign vk v src :α prog),s) = case eval s src of (NONE :α v option) => (SOME (Error :α result),s) | SOME value => if is_valid_value s vk v value then ((NONE :α result option),set_kvar vk v value s) else (SOME (Error :α result),s)) ∧ (∀(v :mlstring) (s :(α, 'ffi) state) (pop :primop) (es :α exp list). evaluate (Primitive v pop es,s) = case OPT_MMAP (eval s) es of (NONE :α v list option) => (SOME (Error :α result),s) | SOME vs => case pan_primop pop vs of (NONE :α v option) => (SOME (Error :α result),s) | SOME value => if is_valid_value s Local v value then ((NONE :α result option),set_var v value s) else (SOME (Error :α result),s)) ∧ (∀(src :α exp) (s :(α, 'ffi) state) (dst :α exp). evaluate ((Store dst src :α prog),s) = case (eval s dst,eval s src) of ((NONE :α v option),v3) => (SOME (Error :α result),s) | (SOME (Val v10),(NONE :α v option)) => (SOME (Error :α result),s) | (SOME (ValWord addr),SOME value) => (case mem_stores addr (flatten value) s.memaddrs s.memory of (NONE :(α word -> α word_lab) option) => (SOME (Error :α result),s) | SOME m => ((NONE :α result option),s with memory := m)) | (SOME (RStruct v11),v3) => (SOME (Error :α result),s) | (SOME (NStruct v12 v13),v3) => (SOME (Error :α result),s)) ∧ (∀(src :α exp) (s :(α, 'ffi) state) (dst :α exp). evaluate ((Store32 dst src :α prog),s) = case (eval s dst,eval s src) of ((NONE :α v option),v3) => (SOME (Error :α result),s) | (SOME (Val v10),(NONE :α v option)) => (SOME (Error :α result),s) | (SOME (ValWord adr),SOME (ValWord w)) => (case mem_store_32 s.memory s.memaddrs s.be adr (w2w w :word32) of (NONE :(α word -> α word_lab) option) => (SOME (Error :α result),s) | SOME m => ((NONE :α result option),s with memory := m)) | (SOME (Val v10),SOME (RStruct v21)) => (SOME (Error :α result),s) | (SOME (Val v10),SOME (NStruct v22 v23)) => (SOME (Error :α result),s) | (SOME (RStruct v11),v3) => (SOME (Error :α result),s) | (SOME (NStruct v12 v13),v3) => (SOME (Error :α result),s)) ∧ (∀(src :α exp) (s :(α, 'ffi) state) (dst :α exp). evaluate (StoreByte dst src,s) = case (eval s dst,eval s src) of ((NONE :α v option),v3) => (SOME (Error :α result),s) | (SOME (Val v10),(NONE :α v option)) => (SOME (Error :α result),s) | (SOME (ValWord adr),SOME (ValWord w)) => (case mem_store_byte s.memory s.memaddrs s.be adr (w2w w :word8) of (NONE :(α word -> α word_lab) option) => (SOME (Error :α result),s) | SOME m => ((NONE :α result option),s with memory := m)) | (SOME (Val v10),SOME (RStruct v21)) => (SOME (Error :α result),s) | (SOME (Val v10),SOME (NStruct v22 v23)) => (SOME (Error :α result),s) | (SOME (RStruct v11),v3) => (SOME (Error :α result),s) | (SOME (NStruct v12 v13),v3) => (SOME (Error :α result),s)) ∧ (∀(vk :varkind) (v :mlstring) (s :(α, 'ffi) state) (op :opsize) (ad :α exp). evaluate (ShMemLoad op vk v ad,s) = case eval s ad of (NONE :α v option) => (SOME (Error :α result),s) | SOME (ValWord addr) => (case lookup_kvar vk v s of (NONE :α v option) => (SOME (Error :α result),s) | SOME (Val v7) => (sh_mem_load vk v addr (nb_op op) s :α result option # (α, 'ffi) state) | SOME (RStruct v8) => (SOME (Error :α result),s) | SOME (NStruct v9 v10) => (SOME (Error :α result),s)) | SOME (RStruct v13) => (SOME (Error :α result),s) | SOME (NStruct v14 v15) => (SOME (Error :α result),s)) ∧ (∀(s :(α, 'ffi) state) (op :opsize) (e :α exp) (ad :α exp). evaluate (ShMemStore op ad e,s) = case (eval s ad,eval s e) of ((NONE :α v option),v3) => (SOME (Error :α result),s) | (SOME (Val v10),(NONE :α v option)) => (SOME (Error :α result),s) | (SOME (ValWord addr),SOME (ValWord bytes)) => (sh_mem_store bytes addr (nb_op op) s :α result option # (α, 'ffi) state) | (SOME (Val v10),SOME (RStruct v21)) => (SOME (Error :α result),s) | (SOME (Val v10),SOME (NStruct v22 v23)) => (SOME (Error :α result),s) | (SOME (RStruct v11),v3) => (SOME (Error :α result),s) | (SOME (NStruct v12 v13),v3) => (SOME (Error :α result),s)) ∧ (∀(s :(α, 'ffi) state) (c2 :α prog) (c1 :α prog). evaluate (Seq c1 c2,s) = (let ((res :α result option),(s1 :(α, 'ffi) state)) = evaluate (c1,s) in if res = (NONE :α result option) then evaluate (c2,s1) else (res,s1))) ∧ (∀(s :(α, 'ffi) state) (e :α exp) (c2 :α prog) (c1 :α prog). evaluate ((If e c1 c2 :α prog),s) = case eval s e of (NONE :α v option) => (SOME (Error :α result),s) | SOME (ValWord w) => evaluate (if w ≠ (0w :α word) then c1 else c2,s) | SOME (RStruct v7) => (SOME (Error :α result),s) | SOME (NStruct v8 v9) => (SOME (Error :α result),s)) ∧ (∀(s :(α, 'ffi) state). evaluate ((Break :α prog),s) = (SOME (Break :α result),s)) ∧ (∀(s :(α, 'ffi) state). evaluate ((Continue :α prog),s) = (SOME (Continue :α result),s)) ∧ (∀(s :(α, 'ffi) state) (e :α exp) (c :α prog). evaluate ((While e c :α prog),s) = case eval s e of (NONE :α v option) => (SOME (Error :α result),s) | SOME (ValWord w) => if w ≠ (0w :α word) then if s.clock = (0 :num) then (SOME (TimeOut :α result),empty_locals s) else (let ((res :α result option),(s1 :(α, 'ffi) state)) = evaluate (c,dec_clock s) in case res of (NONE :α result option) => evaluate ((While e c :α prog),s1) | SOME (Error :α result) => (res,s1) | SOME (TimeOut :α result) => (res,s1) | SOME (Break :α result) => ((NONE :α result option),s1) | SOME (Continue :α result) => evaluate ((While e c :α prog),s1) | SOME (Return v6 :α result) => (res,s1) | SOME (Exception v7 v8) => (res,s1) | SOME (FinalFFI v9 :α result) => (res,s1)) else ((NONE :α result option),s) | SOME (RStruct v12) => (SOME (Error :α result),s) | SOME (NStruct v13 v14) => (SOME (Error :α result),s)) ∧ (∀(s :(α, 'ffi) state) (e :α exp). evaluate ((Return e :α prog),s) = case eval s e of (NONE :α v option) => (SOME (Error :α result),s) | SOME value => if size_of_sh_with_ctxt s.structs (shape_of value) ≤ (32 :num) then (SOME (Return value :α result),empty_locals s) else (SOME (Error :α result),s)) ∧ (∀(s :(α, 'ffi) state) (eid :mlstring) (e :α exp). evaluate ((Raise eid e :α prog),s) = case (FLOOKUP s.eshapes eid,eval s e) of ((NONE :shape option),v3) => (SOME (Error :α result),s) | (SOME sh,(NONE :α v option)) => (SOME (Error :α result),s) | (SOME sh,SOME value) => if shape_of value = sh ∧ size_of_sh_with_ctxt s.structs (shape_of value) ≤ (32 :num) then (SOME (Exception eid value),empty_locals s) else (SOME (Error :α result),s)) ∧ (∀(s :(α, 'ffi) state). evaluate ((Tick :α prog),s) = if s.clock = (0 :num) then (SOME (TimeOut :α result),empty_locals s) else ((NONE :α result option),dec_clock s)) ∧ (∀(v1 :mlstring) (v0 :mlstring) (s :(α, 'ffi) state). evaluate ((Annot v0 v1 :α prog),s) = ((NONE :α result option),s)) ∧ (∀(s :(α, 'ffi) state) (fname :mlstring) (caltyp :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) (argexps :α exp list). evaluate ((Call caltyp fname argexps :α prog),s) = case OPT_MMAP (eval s) argexps of (NONE :α v list option) => (SOME (Error :α result),s) | SOME args => case lookup_code s.code fname args of (NONE :(α prog # (mlstring |-> α v) # shape) option) => (SOME (Error :α result),s) | SOME (prog,newlocals,return_sh) => if s.clock = (0 :num) then (SOME (TimeOut :α result),empty_locals s) else (let (eval_prog :α result option # (α, 'ffi) state) = evaluate (prog,dec_clock s with locals := newlocals) in case eval_prog of ((NONE :α result option),st) => (SOME (Error :α result),st) | (SOME (Error :α result),st) => (SOME (Error :α result),empty_locals st) | (SOME (TimeOut :α result),st) => (SOME (TimeOut :α result),empty_locals st) | (SOME (Break :α result),st) => (SOME (Error :α result),st) | (SOME (Continue :α result),st) => (SOME (Error :α result),st) | (SOME (Return retv :α result),st) => if shape_of retv ≠ return_sh then (SOME (Error :α result),st) else (case caltyp of (NONE :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) => (SOME (Return retv :α result),empty_locals st) | SOME ((NONE :(varkind # mlstring) option),v2) => ((NONE :α result option),st with locals := s.locals) | SOME (SOME (rk,rt),v2) => if is_valid_value s rk rt retv then ((NONE :α result option),set_kvar rk rt retv (st with locals := s.locals)) else (SOME (Error :α result),st)) | (SOME (Exception eid exn),st) => (case caltyp of (NONE :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) => (SOME (Exception eid exn),empty_locals st) | SOME (v1,(NONE :(mlstring # mlstring # α prog) option)) => (SOME (Exception eid exn),empty_locals st) | SOME (v1,SOME (eid',evar,p)) => if eid = eid' then case FLOOKUP s.eshapes eid of (NONE :shape option) => (SOME (Error :α result),st) | SOME sh => if shape_of exn = sh ∧ is_valid_value s Local evar exn then evaluate (p,set_var evar exn (st with locals := s.locals)) else (SOME (Error :α result),st) else (SOME (Exception eid exn),empty_locals st)) | (SOME (FinalFFI v16 :α result),st) => (SOME (FinalFFI v16 :α result),empty_locals st))) ∧ (∀(shape :shape) (s :(α, 'ffi) state) (rt :mlstring) (prog1 :α prog) (fname :mlstring) (argexps :α exp list). evaluate (DecCall rt shape fname argexps prog1,s) = case OPT_MMAP (eval s) argexps of (NONE :α v list option) => (SOME (Error :α result),s) | SOME args => case lookup_code s.code fname args of (NONE :(α prog # (mlstring |-> α v) # shape) option) => (SOME (Error :α result),s) | SOME (prog,newlocals,return_sh) => if s.clock = (0 :num) then (SOME (TimeOut :α result),empty_locals s) else (let (eval_prog :α result option # (α, 'ffi) state) = evaluate (prog,dec_clock s with locals := newlocals) in case eval_prog of ((NONE :α result option),st) => (SOME (Error :α result),st) | (SOME (Error :α result),st) => (SOME (Error :α result),empty_locals st) | (SOME (TimeOut :α result),st) => (SOME (TimeOut :α result),empty_locals st) | (SOME (Break :α result),st) => (SOME (Error :α result),st) | (SOME (Continue :α result),st) => (SOME (Error :α result),st) | (SOME (Return retv :α result),st) => if shape_of retv = shape ∧ shape_of retv = return_sh then (let ((res' :α result option),(st' :(α, 'ffi) state)) = evaluate (prog1,set_var rt retv (st with locals := s.locals)) in (res',st' with locals := res_var st'.locals (rt,FLOOKUP s.locals rt))) else (SOME (Error :α result),st) | (SOME (Exception v9 v10),st) => (SOME (Exception v9 v10),empty_locals st) | (SOME (FinalFFI v11 :α result),st) => (SOME (FinalFFI v11 :α result),empty_locals st))) ∧ ∀(s :(α, 'ffi) state) (ptr2 :α exp) (ptr1 :α exp) (len2 :α exp) (len1 :α exp) (ffi_index :mlstring). evaluate ((ExtCall ffi_index ptr1 len1 ptr2 len2 :α prog),s) = case (eval s ptr1,eval s len1,eval s ptr2,eval s len2) of ((NONE :α v option),v5) => (SOME (Error :α result),s) | (SOME (Val v12),(NONE :α v option),v19) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (Val v26),(NONE :α v option),v33) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (Val v26),SOME (Val v40),(NONE :α v option)) => (SOME (Error :α result),s) | (SOME (ValWord sz1),SOME (ValWord ad1),SOME (ValWord sz2),SOME (ValWord ad2)) => (case (read_bytearray sz1 (w2n ad1) (mem_load_byte s.memory s.memaddrs s.be),read_bytearray sz2 (w2n ad2) (mem_load_byte s.memory s.memaddrs s.be)) of ((NONE :word8 list option),v3) => (SOME (Error :α result),s) | (SOME bytes,(NONE :word8 list option)) => (SOME (Error :α result),s) | (SOME bytes,SOME bytes2) => case call_FFI s.ffi (ExtCall ffi_index :ffiname) bytes bytes2 of FFI_return new_ffi new_bytes => (let (nmem :α word -> α word_lab) = write_bytearray sz2 new_bytes s.memory s.memaddrs s.be in ((NONE :α result option),s with <|memory := nmem; ffi := new_ffi|>)) | (FFI_final outcome :'ffi ffi_result) => (SOME (FinalFFI outcome :α result),empty_locals s)) | (SOME (Val v12),SOME (Val v26),SOME (Val v40),SOME (RStruct v51)) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (Val v26),SOME (Val v40),SOME (NStruct v52 v53)) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (Val v26),SOME (RStruct v41),v33) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (Val v26),SOME (NStruct v42 v43),v33) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (RStruct v27),v19) => (SOME (Error :α result),s) | (SOME (Val v12),SOME (NStruct v28 v29),v19) => (SOME (Error :α result),s) | (SOME (RStruct v13),v5) => (SOME (Error :α result),s) | (SOME (NStruct v14 v15),v5) => (SOME (Error :α result),s)
