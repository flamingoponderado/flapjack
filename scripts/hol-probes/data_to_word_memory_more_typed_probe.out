update_thunk_thm_typed=abs_ml_inv (conf :data_to_word$config) ((h :v)::(RefPtr F (ptr :num) :v)::(stack :v list)) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ (lookup ptr refs :v ref option) = SOME (Thunk NotEvaluated (v :v) :v ref) ∧ ((ev :thunk_mode) = Evaluated ⇒ (dest_thunk h refs :dest_thunk_ret) = NotThunk) ⇒ ∃(p :num) (r :α word_loc heap_address) (roots2 :α word_loc heap_address list) (v1 :α word_loc heap_address list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list) (u :α word_loc). roots = r::Pointer p u::roots2 ∧ thunk_deref p heap = SOME v1 ∧ heap_store p [(ThunkBlock ev r :(α word_loc, tag # α word_loc list) heap_element)] heap = (heap2,T) ∧ abs_ml_inv conf (h::(RefPtr F ptr :v)::stack) (insert ptr (Thunk ev h :v ref) refs :v ref sptree$num_map) (roots,heap2,be,a,sp,sp1,gens) limit ts
