dtw_memory_more_begin=1
word_eq_typed=∀(w :α word) (v :α word). w = v ⇔ ∀(n :num). word_bit n w ⇔ word_bit n v
ZIP_REPLICATE_typed=∀(n :num). ZIP (REPLICATE n (x :α),REPLICATE n (y :β)) = REPLICATE n (x,y)
MEM_EL_APPEND_MID_typed=∀(n :num) (l :α list) (c :α) (r :α list). n < LENGTH l + (LENGTH r + (1 :num)) ⇒ MEM (l ++ [c] ++ r)❲n❳ l ∨ (l ++ [c] ++ r)❲n❳ = c ∨ MEM (l ++ [c] ++ r)❲n❳ r
MAX_LIST_sum_bound_typed=(SUM (ls :num list) :num) ≤ MAX_LIST ls * LENGTH ls
MAX_LIST_bounded_elements_typed=∀(l1 :num list) (l2 :num list). LIST_REL $<= l1 l2 ⇒ MAX_LIST l1 ≤ MAX_LIST l2
MAX_LIST_MAP_typed=∀(f :num -> num) (l :num list). (∀(x :num) (y :num). x < y ⇒ f x < f y) ⇒ MAX_LIST (MAP f l) = if NULL l then (0 :num) else f (MAX_LIST l)
w2i_i2w_IMP_typed=w2i (i2w (i :int) :α word) = i ⇒ (INT_MIN (:α) :int) ≤ i ∧ i ≤ (INT_MAX (:α) :int)
word_i2w_sub_typed=∀(a :int) (b :int). (i2w a :α word) − (i2w b :α word) = (i2w (a − b) :α word)
ThunkBlock_11_typed=(ThunkBlock (ev1 :thunk_mode) (x1 :α heap_address) :(α, tag # β list) heap_element) = (ThunkBlock (ev2 :thunk_mode) (x2 :α heap_address) :(α, tag # β list) heap_element) ⇔ ev1 = ev2 ∧ x1 = x2
MOD_EQ_0_0_typed=∀(n :num) (b :num). (0 :num) < b ⇒ n MOD b = (0 :num) ⇒ n < b ⇒ n = (0 :num)
EVERY2_IMP_EVERY_typed=∀(xs :α list) (ys :β list). LIST_REL (P :α -> β -> bool) xs ys ⇒ EVERY (λ((x :β),(y :α)). P y x) (ZIP (ys,xs))
EVERY2_IMP_EVERY2_typed=∀(xs :α list) (ys :β list) (P1 :α -> β -> bool) (P2 :α -> β -> bool). (∀(x :α) (y :β). MEM x xs ∧ MEM y ys ∧ P1 x y ⇒ P2 x y) ⇒ LIST_REL P1 xs ys ⇒ LIST_REL P2 xs ys
MEM_EVERY2_IMP_typed=∀(l :α list) (x :α) (zs :β list) (P :β -> α -> bool). MEM x l ∧ LIST_REL P zs l ⇒ ∃(z :β). MEM z zs ∧ P z x
EVERY2_APPEND_CONS_typed=∀(xs :α list) (y :α) (ys :α list) (zs :β list) (P :α -> β -> bool). LIST_REL P (xs ++ y::ys) zs ⇒ ∃(t1 :β list) (t :β) (t2 :β list). zs = t1 ++ t::t2 ∧ LENGTH t1 = LENGTH xs ∧ LIST_REL P xs t1 ∧ P y t ∧ LIST_REL P ys t2
EVERY2_SWAP_typed=∀(xs :α list) (ys :β list). LIST_REL (P :α -> β -> bool) xs ys ⇒ LIST_REL (λ(y :β) (x :α). P x y) ys xs
EVERY2_APPEND_IMP_APPEND_typed=∀(xs1 :α list) (xs2 :α list) (ys :β list) (P :α -> β -> bool). LIST_REL P (xs1 ++ xs2) ys ⇒ ∃(ys1 :β list) (ys2 :β list). ys = ys1 ++ ys2 ∧ LIST_REL P xs1 ys1 ∧ LIST_REL P xs2 ys2
EVERY2_MAP_FST_SND_typed=∀(xs :(α # β) list). LIST_REL (P :α -> β -> bool) (MAP (FST :α # β -> α) xs) (MAP (SND :α # β -> β) xs) ⇔ EVERY (λ((x :α),(y :β)). P x y) xs
heap_lookup_APPEND1_typed=∀(h1 :(α, β) heap_element list) (z :num) (h2 :(α, β) heap_element list). heap_length h1 ≤ z ⇒ heap_lookup z (h1 ++ h2) = heap_lookup (z − heap_length h1) h2
heap_lookup_APPEND2_typed=∀(h1 :(α, β) heap_element list) (z :num) (h2 :(α, β) heap_element list). z < heap_length h1 ⇒ heap_lookup z (h1 ++ h2) = heap_lookup z h1
heap_lookup_APPEND_typed=heap_lookup (a :num) ((h1 :(α, β) heap_element list) ++ (h2 :(α, β) heap_element list)) = if a < heap_length h1 then heap_lookup a h1 else heap_lookup (a − heap_length h1) h2
LENGTH_ADDR_MAP_typed=∀(xs :α heap_address list) (f :num -> num). LENGTH (ADDR_MAP f xs) = LENGTH xs
EL_ADDR_MAP_typed=∀(xs :α heap_address list) (n :num) (f :num -> num). n < LENGTH xs ⇒ (ADDR_MAP f xs)❲n❳ = ADDR_APPLY f xs❲n❳
dest_evaluated_thunk_rel_rules_typed=∀(x :α heap_address). dest_evaluated_thunk_rel (ThunkBlock Evaluated x :(α, tag # β list) heap_element) x
dest_evaluated_thunk_rel_cases_typed=∀(a0 :(α, tag # β list) heap_element) (a1 :α heap_address). dest_evaluated_thunk_rel a0 a1 ⇔ a0 = (ThunkBlock Evaluated a1 :(α, tag # β list) heap_element)
evaluated_thunk_ptr_def_typed=∀(refs :α ref sptree$num_map) (n :num). evaluated_thunk_ptr refs n ⇔ ∃(v :α). (lookup n refs :α ref option) = SOME (Thunk Evaluated v :α ref)
MAX_LIST_def_typed=MAX_LIST ([] :num list) = (0 :num) ∧ ∀(h :num) (t :num list). MAX_LIST (h::t) = MAX h (MAX_LIST t)
f_o_f_DEF_typed=∀(f :β |-> γ) (g :α |-> β). FDOM (f f_o_f g) = FDOM g ∩ {x | g⟨x⟩ ∈ FDOM f} ∧ ∀(x :α). x ∈ FDOM (f f_o_f g) ⇒ (f f_o_f g)⟨x⟩ = f⟨g⟨x⟩⟩
v_inv_related_lemma_typed=∀(ck :num) (w :v) (refs :v ref sptree$num_map) (x :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap1 :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) w refs (x,f,tf,heap1) ∧ gc_related (g :num |-> num) heap1 (heap2 :(α word_loc, tag # α word_loc list) heap_element list) ∧ (∀(ptr :num) (u :α word_loc). x = Pointer ptr u ⇒ ptr ∈ FDOM g) ⇒ v_inv_ck ck conf w refs (ADDR_APPLY (FAPPLY g) x,g f_o_f f,g f_o_f tf,heap2) ∧ EVERY (λ(n :num). n ∉ evaluated_thunk_ptr refs ⇒ f⟨n⟩ ∈ FDOM g) (get_refs w)
v_inv_related_typed=∀(w :v) (x :α word_loc heap_address) (f :num |-> num) (tf :num |-> num). gc_related (g :num |-> num) (heap1 :(α word_loc, tag # α word_loc list) heap_element list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list) ∧ (∀(ptr :num) (u :α word_loc). x = Pointer ptr u ⇒ ptr ∈ FDOM g) ∧ v_inv (conf :data_to_word$config) w (refs :v ref sptree$num_map) (x,f,tf,heap1) ⇒ v_inv conf w refs (ADDR_APPLY (FAPPLY g) x,g f_o_f f,g f_o_f tf,heap2) ∧ EVERY (λ(n :num). n ∉ evaluated_thunk_ptr refs ⇒ f⟨n⟩ ∈ FDOM g) (get_refs w)
EVERY2_ADDR_MAP_typed=∀(zs :α heap_address list) (l :β list). LIST_REL (P :α heap_address -> β -> bool) (ADDR_MAP (g :num -> num) zs) l ⇔ LIST_REL (λ(x :α heap_address) (y :β). P (ADDR_APPLY g x) y) zs l
bc_ref_inv_related_typed=gc_related (g :num |-> num) (heap1 :(α word_loc, tag # α word_loc list) heap_element list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list) ∧ bc_ref_inv (conf :data_to_word$config) (n :num) (refs :v ref sptree$num_map) ((f :num |-> num),(tf :num |-> num),heap1,(be :bool)) ∧ f⟨n⟩ ∈ FDOM g ⇒ bc_ref_inv conf n refs (g f_o_f f,g f_o_f tf,heap2,be)
gc_inline_rel_rules_typed=∀(inline :(α, β) heap_element -> γ heap_address -> bool) (h1 :(α, β) heap_element list). (∀(x :γ heap_address). gc_inline_rel inline h1 x x) ∧ ∀(block :(α, β) heap_element) (p :num) (u :γ) (x :γ heap_address). heap_lookup p h1 = SOME block ∧ inline block x ⇒ gc_inline_rel inline h1 (Pointer p u) x
gc_inline_rel_cases_typed=∀(inline :(α, β) heap_element -> γ heap_address -> bool) (h1 :(α, β) heap_element list) (a0 :γ heap_address) (a1 :γ heap_address). gc_inline_rel inline h1 a0 a1 ⇔ a1 = a0 ∨ ∃(block :(α, β) heap_element) (p :num) (u :γ). a0 = Pointer p u ∧ heap_lookup p h1 = SOME block ∧ inline block a1
gc_heap_inline_rel_rules_typed=∀(inline :(α, β) heap_element -> γ heap_address -> bool) (h1 :(α, β) heap_element list). (∀(x :(γ, δ) heap_element). gc_heap_inline_rel inline h1 x x) ∧ ∀(d :δ) (n :num) (xs :γ heap_address list) (ys :γ heap_address list). LIST_REL (gc_inline_rel inline h1) xs ys ⇒ gc_heap_inline_rel inline h1 (DataElement xs n d) (DataElement ys n d)
gc_heap_inline_rel_cases_typed=∀(inline :(α, β) heap_element -> γ heap_address -> bool) (h1 :(α, β) heap_element list) (a0 :(γ, δ) heap_element) (a1 :(γ, δ) heap_element). gc_heap_inline_rel inline h1 a0 a1 ⇔ a1 = a0 ∨ ∃(d :δ) (n :num) (xs :γ heap_address list) (ys :γ heap_address list). a0 = DataElement xs n d ∧ a1 = DataElement ys n d ∧ LIST_REL (gc_inline_rel inline h1) xs ys
gc_inline_def_typed=∀(inline :(α, β) heap_element -> α heap_address -> bool) (r1 :α heap_address list) (h1 :(α, β) heap_element list) (r2 :α heap_address list) (h2 :(α, β) heap_element list). gc_inline inline (r1,h1) (r2,h2) ⇔ LIST_REL (gc_inline_rel inline h1) r1 r2 ∧ LIST_REL (gc_heap_inline_rel inline h1 :(α, β) heap_element -> (α, β) heap_element -> bool) h1 h2
gc_related_roots_heap_def_typed=∀(f :num |-> num) (r1 :α heap_address list) (h1 :(β, γ) heap_element list) (r2 :α heap_address list) (h2 :(β, γ) heap_element list). gc_related_roots_heap f (r1,h1) (r2,h2) ⇔ gc_related f h1 h2 ∧ r2 = ADDR_MAP (FAPPLY f) r1 ∧ ∀(ptr :num) (u :α). MEM (Pointer ptr u) r1 ⇒ ptr ∈ FDOM f
gc_inline_related_def_typed=∀(inline :(α, β) heap_element -> α heap_address -> bool) (f :num |-> num) (r1 :α heap_address list) (h1 :(α, β) heap_element list) (r2 :α heap_address list) (h2 :(α, β) heap_element list). gc_inline_related inline f (r1,h1) (r2,h2) ⇔ ∃(ri :α heap_address list) (hi :(α, β) heap_element list). gc_inline inline (r1,h1) (ri,hi) ∧ gc_related_roots_heap f (ri,hi) (r2,h2)
gc_heap_inline_rel_heap_lookup_typed=∀(heap1 :(α, β) heap_element list) (heap2 :(α, β) heap_element list). LIST_REL (gc_heap_inline_rel (dest_evaluated_thunk_rel :(α, tag # γ list) heap_element -> α heap_address -> bool) (heap :(α, tag # γ list) heap_element list) :(α, β) heap_element -> (α, β) heap_element -> bool) heap1 heap2 ⇒ ∀(a :num). isSomeDataElement (heap_lookup a heap1) ⇔ isSomeDataElement (heap_lookup a heap2)
ThunkBlock_not_EQ_typed=(ThunkBlock (ev :thunk_mode) (x :β word_loc heap_address) :(β word_loc, tag # γ word_loc list) heap_element) ≠ (Bignum (i :int) :(β word_loc, tag # γ word_loc list) heap_element) ∧ (ThunkBlock ev x :(β word_loc, tag # α word_loc list) heap_element) ≠ (Word64Rep (:α) (w :word64) :(β word_loc, tag # α word_loc list) heap_element) ∧ (ThunkBlock ev x :(β word_loc, tag # δ list) heap_element) ≠ (BlockRep (n :num) (xs :β word_loc heap_address list) :(β word_loc, tag # δ list) heap_element) ∧ (ThunkBlock ev x :(β word_loc, tag # ε list) heap_element) ≠ (RefBlock (zs :β word_loc heap_address list) :(β word_loc, tag # ε list) heap_element) ∧ (ThunkBlock ev x :(β word_loc, tag # β word_loc list) heap_element) ≠ Bytes (be :bool) (flag :bool) (bs :word8 list) (ys :β word list)
LIST_REL_gc_heap_inline_DataElement_typed=∀(heap1 :(α, β) heap_element list) (heap2 :(α, β) heap_element list). LIST_REL (gc_heap_inline_rel (dest_evaluated_thunk_rel :(α, tag # γ list) heap_element -> α heap_address -> bool) (base :(α, tag # γ list) heap_element list) :(α, β) heap_element -> (α, β) heap_element -> bool) heap1 heap2 ⇒ ∀(ptr :num). heap_lookup ptr heap1 = SOME (DataElement (xs :α heap_address list) (n :num) (d :β)) ⇒ ∃(ys :α heap_address list). heap_lookup ptr heap2 = SOME (DataElement ys n d) ∧ LIST_REL (gc_inline_rel (dest_evaluated_thunk_rel :(α, tag # γ list) heap_element -> α heap_address -> bool) base) xs ys
gc_heap_inline_rel_v_inv_lemma_typed=∀(ck :num) (v :v) (refs :v ref sptree$num_map) (x1 :α word_loc heap_address) (x2 :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap1 :(α word_loc, tag # α word_loc list) heap_element list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) v refs (x1,f,tf,heap1) ⇒ LIST_REL (gc_heap_inline_rel (dest_evaluated_thunk_rel :(α word_loc, tag # α word_loc list) heap_element -> α word_loc heap_address -> bool) heap1 :(α word_loc, tag # α word_loc list) heap_element -> (α word_loc, tag # α word_loc list) heap_element -> bool) heap1 heap2 ∧ (∀(n :num). n ∈ FDOM f ∧ reachable_refs [v] refs n ⇒ bc_ref_inv conf n refs (f,tf,heap1,(be :bool))) ∧ gc_inline_rel (dest_evaluated_thunk_rel :(α word_loc, tag # α word_loc list) heap_element -> α word_loc heap_address -> bool) heap1 x1 x2 ⇒ v_inv_ck ck conf v refs (x2,f,tf,heap2)
gc_heap_inline_rel_v_inv_typed=LIST_REL (gc_heap_inline_rel (dest_evaluated_thunk_rel :(α word_loc, tag # α word_loc list) heap_element -> α word_loc heap_address -> bool) (heap1 :(α word_loc, tag # α word_loc list) heap_element list) :(α word_loc, tag # α word_loc list) heap_element -> (α word_loc, tag # α word_loc list) heap_element -> bool) heap1 (heap2 :(α word_loc, tag # α word_loc list) heap_element list) ∧ (∀(n :num). n ∈ FDOM (f :num |-> num) ∧ reachable_refs [(v :v)] (refs :v ref sptree$num_map) n ⇒ bc_ref_inv (conf :data_to_word$config) n refs (f,(tf :num |-> num),heap1,(be :bool))) ∧ v_inv conf v refs ((x1 :α word_loc heap_address),f,tf,heap1) ∧ gc_inline_rel (dest_evaluated_thunk_rel :(α word_loc, tag # α word_loc list) heap_element -> α word_loc heap_address -> bool) heap1 x1 (x2 :α word_loc heap_address) ⇒ v_inv conf v refs (x2,f,tf,heap2)
bc_stack_ref_inv_gc_inline_typed=gc_inline (dest_evaluated_thunk_rel :(α word_loc, tag # α word_loc list) heap_element -> α word_loc heap_address -> bool) ((roots1 :α word_loc heap_address list),(heap1 :(α word_loc, tag # α word_loc list) heap_element list)) ((roots2 :α word_loc heap_address list),(heap2 :(α word_loc, tag # α word_loc list) heap_element list)) ∧ bc_stack_ref_inv (conf :data_to_word$config) (ts :num) (stack :v list) (refs :v ref sptree$num_map) (roots1,heap1,(be :bool)) ⇒ bc_stack_ref_inv conf ts stack refs (roots2,heap2,be)
bc_stack_ref_inv_gc_related_roots_heap_typed=gc_related_roots_heap (g :num |-> num) ((roots1 :α word_loc heap_address list),(heap1 :(α word_loc, tag # α word_loc list) heap_element list)) ((roots2 :α word_loc heap_address list),(heap2 :(α word_loc, tag # α word_loc list) heap_element list)) ∧ bc_stack_ref_inv (conf :data_to_word$config) (ts :num) (stack :v list) (refs :v ref sptree$num_map) (roots1,heap1,(be :bool)) ⇒ bc_stack_ref_inv conf ts stack refs (roots2,heap2,be)
bc_stack_ref_inv_related_typed=gc_inline_related (dest_evaluated_thunk_rel :(α word_loc, tag # α word_loc list) heap_element -> α word_loc heap_address -> bool) (g :num |-> num) ((roots1 :α word_loc heap_address list),(heap1 :(α word_loc, tag # α word_loc list) heap_element list)) ((roots2 :α word_loc heap_address list),(heap2 :(α word_loc, tag # α word_loc list) heap_element list)) ∧ bc_stack_ref_inv (conf :data_to_word$config) (ts :num) (stack :v list) (refs :v ref sptree$num_map) (roots1,heap1,(be :bool)) ⇒ bc_stack_ref_inv conf ts stack refs (roots2,heap2,be)
data_up_to_APPEND_typed=data_up_to (heap_length (xs :(α, β) heap_element list)) (xs ++ (ys :(α, β) heap_element list)) ⇔ EVERY (isDataElement :(α, β) heap_element -> bool) xs
dtw_memory_more_end=1
