gc_related_roots_heap_def_typed=∀(f :num |-> num) (r1 :α heap_address list) (h1 :(β, γ) heap_element list) (r2 :α heap_address list) (h2 :(β, γ) heap_element list). gc_related_roots_heap f (r1,h1) (r2,h2) ⇔ gc_related f h1 h2 ∧ r2 = ADDR_MAP (FAPPLY f) r1 ∧ ∀(ptr :num) (u :α). MEM (Pointer ptr u) r1 ⇒ ptr ∈ FDOM f
gc_inline_related_def_typed=∀(inline :(α, β) heap_element -> α heap_address -> bool) (f :num |-> num) (r1 :α heap_address list) (h1 :(α, β) heap_element list) (r2 :α heap_address list) (h2 :(α, β) heap_element list). gc_inline_related inline f (r1,h1) (r2,h2) ⇔ ∃(ri :α heap_address list) (hi :(α, β) heap_element list). gc_inline inline (r1,h1) (ri,hi) ∧ gc_related_roots_heap f (ri,hi) (r2,h2)
