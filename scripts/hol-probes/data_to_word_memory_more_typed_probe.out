dtw_memory_more_begin=1
word_eq_typed=∀(w :α word) (v :α word). w = v ⇔ ∀(n :num). word_bit n w ⇔ word_bit n v
ZIP_REPLICATE_typed=∀(n :num). ZIP (REPLICATE n (x :α),REPLICATE n (y :β)) = REPLICATE n (x,y)
MEM_EL_APPEND_MID_typed=∀(n :num) (l :α list) (c :α) (r :α list). n < LENGTH l + (LENGTH r + (1 :num)) ⇒ MEM (l ++ [c] ++ r)❲n❳ l ∨ (l ++ [c] ++ r)❲n❳ = c ∨ MEM (l ++ [c] ++ r)❲n❳ r
MAX_LIST_sum_bound_typed=(SUM (ls :num list) :num) ≤ MAX_LIST ls * LENGTH ls
MAX_LIST_bounded_elements_typed=∀(l1 :num list) (l2 :num list). LIST_REL $<= l1 l2 ⇒ MAX_LIST l1 ≤ MAX_LIST l2
MAX_LIST_MAP_typed=∀(f :num -> num) (l :num list). (∀(x :num) (y :num). x < y ⇒ f x < f y) ⇒ MAX_LIST (MAP f l) = if NULL l then (0 :num) else f (MAX_LIST l)
w2i_i2w_IMP_typed=w2i (i2w (i :int) :α word) = i ⇒ (INT_MIN (:α) :int) ≤ i ∧ i ≤ (INT_MAX (:α) :int)
word_i2w_sub_typed=∀(a :int) (b :int). (i2w a :α word) − (i2w b :α word) = (i2w (a − b) :α word)
ThunkBlock_11_typed=(ThunkBlock (ev1 :thunk_mode) (x1 :α heap_address) :(α, tag # β list) heap_element) = (ThunkBlock (ev2 :thunk_mode) (x2 :α heap_address) :(α, tag # β list) heap_element) ⇔ ev1 = ev2 ∧ x1 = x2
MOD_EQ_0_0_typed=∀(n :num) (b :num). (0 :num) < b ⇒ n MOD b = (0 :num) ⇒ n < b ⇒ n = (0 :num)
EVERY2_IMP_EVERY_typed=∀(xs :α list) (ys :β list). LIST_REL (P :α -> β -> bool) xs ys ⇒ EVERY (λ((x :β),(y :α)). P y x) (ZIP (ys,xs))
EVERY2_IMP_EVERY2_typed=∀(xs :α list) (ys :β list) (P1 :α -> β -> bool) (P2 :α -> β -> bool). (∀(x :α) (y :β). MEM x xs ∧ MEM y ys ∧ P1 x y ⇒ P2 x y) ⇒ LIST_REL P1 xs ys ⇒ LIST_REL P2 xs ys
MEM_EVERY2_IMP_typed=∀(l :α list) (x :α) (zs :β list) (P :β -> α -> bool). MEM x l ∧ LIST_REL P zs l ⇒ ∃(z :β). MEM z zs ∧ P z x
EVERY2_APPEND_CONS_typed=∀(xs :α list) (y :α) (ys :α list) (zs :β list) (P :α -> β -> bool). LIST_REL P (xs ++ y::ys) zs ⇒ ∃(t1 :β list) (t :β) (t2 :β list). zs = t1 ++ t::t2 ∧ LENGTH t1 = LENGTH xs ∧ LIST_REL P xs t1 ∧ P y t ∧ LIST_REL P ys t2
EVERY2_SWAP_typed=∀(xs :α list) (ys :β list). LIST_REL (P :α -> β -> bool) xs ys ⇒ LIST_REL (λ(y :β) (x :α). P x y) ys xs
EVERY2_APPEND_IMP_APPEND_typed=∀(xs1 :α list) (xs2 :α list) (ys :β list) (P :α -> β -> bool). LIST_REL P (xs1 ++ xs2) ys ⇒ ∃(ys1 :β list) (ys2 :β list). ys = ys1 ++ ys2 ∧ LIST_REL P xs1 ys1 ∧ LIST_REL P xs2 ys2
EVERY2_MAP_FST_SND_typed=∀(xs :(α # β) list). LIST_REL (P :α -> β -> bool) (MAP (FST :α # β -> α) xs) (MAP (SND :α # β -> β) xs) ⇔ EVERY (λ((x :α),(y :β)). P x y) xs
heap_lookup_APPEND1_typed=∀(h1 :(α, β) heap_element list) (z :num) (h2 :(α, β) heap_element list). heap_length h1 ≤ z ⇒ heap_lookup z (h1 ++ h2) = heap_lookup (z − heap_length h1) h2
heap_lookup_APPEND2_typed=∀(h1 :(α, β) heap_element list) (z :num) (h2 :(α, β) heap_element list). z < heap_length h1 ⇒ heap_lookup z (h1 ++ h2) = heap_lookup z h1
heap_lookup_APPEND_typed=heap_lookup (a :num) ((h1 :(α, β) heap_element list) ++ (h2 :(α, β) heap_element list)) = if a < heap_length h1 then heap_lookup a h1 else heap_lookup (a − heap_length h1) h2
LENGTH_ADDR_MAP_typed=∀(xs :α heap_address list) (f :num -> num). LENGTH (ADDR_MAP f xs) = LENGTH xs
EL_ADDR_MAP_typed=∀(xs :α heap_address list) (n :num) (f :num -> num). n < LENGTH xs ⇒ (ADDR_MAP f xs)❲n❳ = ADDR_APPLY f xs❲n❳
