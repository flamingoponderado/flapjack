v_inv_MutBlock_insert_typed=∀(conf :data_to_word$config) (v1 :v) (refs :v ref sptree$num_map) (v2 :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (ptr :num) (tag :num) (fin :bool) (l :v list) (cv :v) (r :v list). v_inv conf v1 refs (v2,f,tf,heap) ∧ ptr ∉ (domain refs :num -> bool) ∧ FDOM f ⊆ (domain refs :num -> bool) ⇒ v_inv conf v1 (insert ptr (MutBlock tag fin l cv r) refs :v ref sptree$num_map) (v2,f,tf,heap)
v_inv_MutBlock_fin_lemma_typed=∀(ck :num) (v1 :v) (refs :v ref sptree$num_map) (y :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) v1 refs (y,f,tf,heap) ∧ (lookup (ptr :num) refs :v ref option) = SOME (MutBlock (tag :num) (fin1 :bool) (ll :v list) (cv :v) (rr :v list)) ⇒ v_inv_ck ck conf v1 (insert ptr (MutBlock tag (fin2 :bool) ll cv rr) refs :v ref sptree$num_map) (y,f,tf,heap)
v_inv_MutBlock_fin_typed=∀(cnf :data_to_word$config) (vv :v) (rfs :v ref sptree$num_map) (yy :α word_loc heap_address) (ff :num |-> num) (tff :num |-> num) (hp :(α word_loc, tag # α word_loc list) heap_element list) (pp :num) (tg :num) (b1 :bool) (b2 :bool) (l1 :v list) (c1 :v) (r1 :v list). v_inv cnf vv rfs (yy,ff,tff,hp) ∧ (lookup pp rfs :v ref option) = SOME (MutBlock tg b1 l1 c1 r1) ⇒ v_inv cnf vv (insert pp (MutBlock tg b2 l1 c1 r1) rfs :v ref sptree$num_map) (yy,ff,tff,hp)
all_ts_SUBSET_gen_typed=(∀(x :v). (∃(n :num) (r' :v ref). (lookup n (refs1 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x) ∨ MEM x (stack1 :v list) ⇒ (∃(n :num) (r' :v ref). (lookup n (refs2 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x) ∨ MEM x (stack2 :v list)) ⇒ all_ts refs1 stack1 ⊆ all_ts refs2 stack2
all_ts_SUBSET_ts_typed=(∀(x :v) (t :num). ((∃(n :num) (r' :v ref). (lookup n (refs1 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x) ∨ MEM x (stack1 :v list)) ∧ MEM t (v_all_ts x) ⇒ ∃(x' :v). ((∃(n :num) (r' :v ref). (lookup n (refs2 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x') ∨ MEM x' (stack2 :v list)) ∧ MEM t (v_all_ts x')) ⇒ all_ts refs1 stack1 ⊆ all_ts refs2 stack2
all_ts_mutcons_typed=(ptr :num) ∉ (domain (refs :v ref sptree$num_map) :num -> bool) ⇒ all_ts refs ((l :v list) ++ [(c :v)] ++ (r :v list) ++ (stack :v list)) ⊆ all_ts (insert ptr (MutBlock (tag :num) F l c r) refs :v ref sptree$num_map) ((RefPtr F ptr :v)::stack)
blocks_unique_mutcons_typed=blocks_unique (ts :num) (all_vs (refs :v ref sptree$num_map) ((l :v list) ++ [(c :v)] ++ (r :v list) ++ (stack :v list))) ⇒ blocks_unique ts (all_vs (insert (ptr :num) (MutBlock (tag :num) F l c r) refs :v ref sptree$num_map) ((RefPtr F ptr :v)::stack))
ref_edge_MutBlock_typed=ref_edge (insert (ptr :num) (MutBlock (tag :num) (fin :bool) (l :v list) (c :v) (r :v list)) (refs :v ref sptree$num_map) :v ref sptree$num_map) (x :num) (y :num) ⇔ if x = ptr then MEM y (get_refs (Block (0 :num) (ARB :num) (l ++ [c] ++ r) :v)) else ref_edge refs x y
reachable_refs_MutCons_lemma_typed=∀(r1 :num) (n :num). (ref_edge (insert (ptr :num) (MutBlock (tag :num) F (l :v list) (c :v) (r :v list)) (refs :v ref sptree$num_map) :v ref sptree$num_map))꙳ r1 n ⇒ n ≠ ptr ⇒ (ref_edge refs)꙳ r1 n ∨ ∃(s :num). MEM s (get_refs (Block (0 :num) (ARB :num) (l ++ [c] ++ r) :v)) ∧ (ref_edge refs)꙳ s n
reachable_refs_MutCons_typed=reachable_refs ((RefPtr F (ptr :num) :v)::(stack :v list)) (insert ptr (MutBlock (tag :num) F (l :v list) (c :v) (r :v list)) (refs :v ref sptree$num_map) :v ref sptree$num_map) (n :num) ∧ n ≠ ptr ∧ ptr ∉ (domain refs :num -> bool) ⇒ reachable_refs (l ++ [c] ++ r ++ stack) refs n
take_el_drop_typed=∀(index :num) (vals :α list). index < LENGTH vals ⇒ TAKE index vals ++ [vals❲index❳] ++ DROP (index + (1 :num)) vals = vals
dest_thunk_insert_fresh_typed=(ptr :num) ∉ (domain (refs :v ref sptree$num_map) :num -> bool) ∧ (dest_thunk (v :v) refs :dest_thunk_ret) = NotThunk ⇒ (dest_thunk v (insert ptr (x :v ref) refs :v ref sptree$num_map) :dest_thunk_ret) = NotThunk
heap_store_ThunkBlock_thm_typed=∀(ha :(α, tag # β list) heap_element list). heap_store (heap_length ha) [(ThunkBlock (ev1 :thunk_mode) (v1 :α heap_address) :(α, tag # β list) heap_element)] (ha ++ (ThunkBlock (ev2 :thunk_mode) (v2 :α heap_address) :(α, tag # β list) heap_element)::(hb :(α, tag # β list) heap_element list)) = (ha ++ (ThunkBlock ev1 v1 :(α, tag # β list) heap_element)::hb,T)
heap_lookup_ThunkBlock_lemma_typed=heap_lookup (n :num) ((ha :(α, tag # β list) heap_element list) ++ (ThunkBlock (ev :thunk_mode) (v :α heap_address) :(α, tag # β list) heap_element)::(hb :(α, tag # β list) heap_element list)) = SOME (x :(α, tag # β list) heap_element) ⇔ if n < heap_length ha then heap_lookup n ha = SOME x else if n = heap_length ha then x = (ThunkBlock ev v :(α, tag # β list) heap_element) else if heap_length ha + (2 :num) ≤ n then heap_lookup (n − heap_length ha − (2 :num)) hb = SOME x else F
heap_store_ThunkBlock_typed=heap_lookup (n :num) (heap :(α, tag # β list) heap_element list) = SOME (ThunkBlock NotEvaluated (y :α heap_address) :(α, tag # β list) heap_element) ⇒ ∃(heap2 :(α, tag # β list) heap_element list). heap_store n [(ThunkBlock (ev :thunk_mode) (h :α heap_address) :(α, tag # β list) heap_element)] heap = (heap2,T) ∧ heap_lookup n heap2 = SOME (ThunkBlock ev h :(α, tag # β list) heap_element) ∧ heap_length heap2 = heap_length heap ∧ FILTER (isForwardPointer :(α, tag # β list) heap_element -> bool) heap2 = FILTER (isForwardPointer :(α, tag # β list) heap_element -> bool) heap ∧ (∀(xs :α heap_address list) (l :num) (d :tag # β list). MEM (DataElement xs l d) heap2 ⇒ DataElement xs l d = (ThunkBlock ev h :(α, tag # β list) heap_element) ∨ MEM (DataElement xs l d) heap) ∧ (∀(a :num). isSomeDataElement (heap_lookup a heap2) ⇔ isSomeDataElement (heap_lookup a heap)) ∧ ∀(m :num) (x :(α, tag # β list) heap_element). m ≠ n ∧ heap_lookup m heap = SOME x ⇒ heap_lookup m heap2 = SOME x
INJ_NEQ_typed=INJ (FAPPLY (f :α |-> num)) (FDOM f) {a | isSomeDataElement (heap_lookup a (heap :(β, γ) heap_element list))} ∧ (n :α) ∈ FDOM f ∧ (ptr :α) ∈ FDOM f ∧ n ≠ ptr ⇒ f⟨n⟩ ≠ f⟨ptr⟩
heap_lookup_heap_split_typed=∀(heap :(α, β) heap_element list) (a :num) (b :num) (h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (x :(α, β) heap_element). heap_split a heap = SOME (h1,h2) ∧ heap_lookup b heap = SOME x ⇒ if b < a then MEM x h1 else MEM x h2
heap_store_heap_lookup_typed=∀(heap :(α, β) heap_element list) (heap2 :(α, β) heap_element list) (a :num) (x :(α, β) heap_element list) (n :num). heap_store a x heap = (heap2,T) ∧ n < a ⇒ heap_lookup n heap = heap_lookup n heap2
data_up_to_alt_typed=(data_up_to (n :num) ([] :(α, β) heap_element list) ⇔ n = (0 :num)) ∧ (data_up_to n ((x :(γ, δ) heap_element)::(xs :(γ, δ) heap_element list)) ⇔ if n = (0 :num) then T else if n < el_length x ∨ ¬isDataElement x then F else data_up_to (n − el_length x) xs)
data_up_to_heap_store_typed=∀(heap :(α, β) heap_element list) (a :num) (b :num) (heap2 :(α, β) heap_element list) (y :(α, β) heap_element). data_up_to a heap ∧ heap_store b [y] heap = (heap2,T) ∧ isDataElement y ⇒ data_up_to a heap2
dtw_memory_more_end=1
