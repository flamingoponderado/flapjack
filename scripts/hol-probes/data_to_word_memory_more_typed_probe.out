list_copy_bwd_eq_typed=∀(n :num) (xp :num) (xs :α list) (yp :num) (ys :α list). n ≤ xp + (1 :num) ∧ xp < LENGTH xs ∧ n ≤ yp + (1 :num) ∧ yp < LENGTH ys ⇒ list_copy_bwd n xp xs yp ys = SOME (TAKE (yp + (1 :num) − n) ys ++ TAKE n (DROP (xp + (1 :num) − n) xs) ++ DROP (yp + (1 :num)) ys)
list_copy_thm_typed=∀(xs :α list) (ys :α list) (xp :num) (yp :num) (n :num) (ys1 :α list). copy_array (xs,((&xp) :int)) ((&n) :int) (SOME (ys,((&yp) :int))) = SOME ys1 ⇒ list_copy n xp xs yp ys = SOME ys1
list_copy_fwd_alias_eq_typed=∀(n :num) (xp :num) (yp :num) (ys :α list). yp ≤ xp ∧ xp + n ≤ LENGTH ys ∧ yp + n ≤ LENGTH ys ⇒ list_copy_fwd_alias n xp yp ys = SOME (TAKE yp ys ++ TAKE n (DROP xp ys) ++ DROP (n + yp) ys)
list_copy_bwd_alias_eq_typed=∀(n :num) (xp :num) (yp :num) (ys :α list). xp ≤ yp ∧ n ≤ xp + (1 :num) ∧ xp < LENGTH ys ∧ n ≤ yp + (1 :num) ∧ yp < LENGTH ys ⇒ list_copy_bwd_alias n xp yp ys = SOME (TAKE (yp + (1 :num) − n) ys ++ TAKE n (DROP (xp + (1 :num) − n) ys) ++ DROP (yp + (1 :num)) ys)
list_copy_alias_thm_typed=∀(ys :α list) (xp :num) (yp :num) (n :num) (ys1 :α list). copy_array (ys,((&xp) :int)) ((&n) :int) (SOME (ys,((&yp) :int))) = SOME ys1 ⇒ list_copy_alias n xp yp ys = SOME ys1
copy_array_NONE_IMP_typed=∀(xs :α word list) (ys :α word list) (xp :num) (n :num). copy_array (xs,((&xp) :int)) ((&n) :int) (NONE :(α word list # int) option) = SOME ys ⇒ list_copy_fwd n xp xs (0 :num) (REPLICATE n (0w :α word)) = SOME ys
word_copy_array_def_typed=∀(be :bool) (n :α word) (a :α word) (a1 :α word) (b :α word) (b1 :α word) (m :α word -> α word_loc) (dm :α word -> bool). word_copy_array be n a a1 b b1 m dm = if b1 ≤₊ a1 then word_copy_fwd be n (a + a1) (b + b1) m dm else word_copy_bwd be n (a + a1 + n − (1w :α word)) (b + b1 + n − (1w :α word)) m dm
word_copy_bwd_0_typed=good_dimindex (:α) ⇒ word_copy_bwd (be :bool) (0w :α word) (a1 :α word) (a2 :α word) (m :α word -> α word_loc) (dm :α word -> bool) = SOME m
word_copy_array_thm_typed=∀(n :num) (xp :num) (yp :num) (xs :word8 list) (ys :word8 list) (ys1 :word8 list) (m :α word -> α word_loc). memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) m (dm :α word -> bool) (((RefPtr (bl1 :bool) (p1 :num) :v),(v1 :α word_loc))::((RefPtr (bl2 :bool) (p2 :num) :v),(v2 :α word_loc))::(vars :(v # α word_loc) list)) ∧ (lookup p1 refs :v ref option) = SOME (ByteArray (fl_xs :bool) xs :v ref) ∧ (lookup p2 refs :v ref option) = SOME (ByteArray (fl_ys :bool) ys :v ref) ∧ copy_array (xs,((&xp) :int)) ((&n) :int) (SOME (ys,((&yp) :int))) = SOME ys1 ∧ good_dimindex (:α) ∧ p1 ≠ p2 ⇒ ∃(w1 :α word) (w2 :α word) (a1 :α word) (a2 :α word) (m1 :α word -> α word_loc). v1 = Word w1 ∧ v2 = Word w2 ∧ get_real_addr c st w1 = SOME a1 ∧ get_real_addr c st w2 = SOME a2 ∧ word_copy_array be (n2w n :α word) (a1 + (bytes_in_word :α word)) (n2w xp :α word) (a2 + (bytes_in_word :α word)) (n2w yp :α word) m dm = SOME m1 ∧ memory_rel c be ts (insert p2 (ByteArray fl_ys ys1 :v ref) refs :v ref sptree$num_map) sp st m1 dm (((RefPtr bl1 p1 :v),v1)::((RefPtr bl2 p2 :v),v2)::vars)
word_copy_array_alias_thm_typed=∀(n :num) (xp :num) (yp :num) (ys :word8 list) (ys1 :word8 list) (m :α word -> α word_loc). memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) m (dm :α word -> bool) (((RefPtr (bl :bool) (p2 :num) :v),(v2 :α word_loc))::(vars :(v # α word_loc) list)) ∧ (lookup p2 refs :v ref option) = SOME (ByteArray (fl_ys :bool) ys :v ref) ∧ copy_array (ys,((&xp) :int)) ((&n) :int) (SOME (ys,((&yp) :int))) = SOME ys1 ∧ good_dimindex (:α) ⇒ ∃(w2 :α word) (a2 :α word) (m1 :α word -> α word_loc). v2 = Word w2 ∧ get_real_addr c st w2 = SOME a2 ∧ word_copy_array be (n2w n :α word) (a2 + (bytes_in_word :α word)) (n2w xp :α word) (a2 + (bytes_in_word :α word)) (n2w yp :α word) m dm = SOME m1 ∧ memory_rel c be ts (insert p2 (ByteArray fl_ys ys1 :v ref) refs :v ref sptree$num_map) sp st m1 dm (((RefPtr bl p2 :v),v2)::vars)
dtw_memory_more_end=1
