gc_heap_inline_rel_cases_typed=∀(inline :(α, β) heap_element -> γ heap_address -> bool) (h1 :(α, β) heap_element list) (a0 :(γ, δ) heap_element) (a1 :(γ, δ) heap_element). gc_heap_inline_rel inline h1 a0 a1 ⇔ a1 = a0 ∨ ∃(d :δ) (n :num) (xs :γ heap_address list) (ys :γ heap_address list). a0 = DataElement xs n d ∧ a1 = DataElement ys n d ∧ LIST_REL (gc_inline_rel inline h1) xs ys
