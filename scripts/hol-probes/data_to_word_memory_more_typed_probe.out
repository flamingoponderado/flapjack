v_inv_MutBlock_insert_typed=∀(conf :data_to_word$config) (v1 :v) (refs :v ref sptree$num_map) (v2 :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (ptr :num) (tag :num) (fin :bool) (l :v list) (cv :v) (r :v list). v_inv conf v1 refs (v2,f,tf,heap) ∧ ptr ∉ (domain refs :num -> bool) ∧ FDOM f ⊆ (domain refs :num -> bool) ⇒ v_inv conf v1 (insert ptr (MutBlock tag fin l cv r) refs :v ref sptree$num_map) (v2,f,tf,heap)
v_inv_MutBlock_fin_lemma_typed=∀(ck :num) (v1 :v) (refs :v ref sptree$num_map) (y :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) v1 refs (y,f,tf,heap) ∧ (lookup (ptr :num) refs :v ref option) = SOME (MutBlock (tag :num) (fin1 :bool) (ll :v list) (cv :v) (rr :v list)) ⇒ v_inv_ck ck conf v1 (insert ptr (MutBlock tag (fin2 :bool) ll cv rr) refs :v ref sptree$num_map) (y,f,tf,heap)
v_inv_MutBlock_fin_typed=∀(cnf :data_to_word$config) (vv :v) (rfs :v ref sptree$num_map) (yy :α word_loc heap_address) (ff :num |-> num) (tff :num |-> num) (hp :(α word_loc, tag # α word_loc list) heap_element list) (pp :num) (tg :num) (b1 :bool) (b2 :bool) (l1 :v list) (c1 :v) (r1 :v list). v_inv cnf vv rfs (yy,ff,tff,hp) ∧ (lookup pp rfs :v ref option) = SOME (MutBlock tg b1 l1 c1 r1) ⇒ v_inv cnf vv (insert pp (MutBlock tg b2 l1 c1 r1) rfs :v ref sptree$num_map) (yy,ff,tff,hp)
all_ts_SUBSET_gen_typed=(∀(x :v). (∃(n :num) (r' :v ref). (lookup n (refs1 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x) ∨ MEM x (stack1 :v list) ⇒ (∃(n :num) (r' :v ref). (lookup n (refs2 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x) ∨ MEM x (stack2 :v list)) ⇒ all_ts refs1 stack1 ⊆ all_ts refs2 stack2
all_ts_SUBSET_ts_typed=(∀(x :v) (t :num). ((∃(n :num) (r' :v ref). (lookup n (refs1 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x) ∨ MEM x (stack1 :v list)) ∧ MEM t (v_all_ts x) ⇒ ∃(x' :v). ((∃(n :num) (r' :v ref). (lookup n (refs2 :v ref sptree$num_map) :v ref option) = SOME r' ∧ find_ref r' x') ∨ MEM x' (stack2 :v list)) ∧ MEM t (v_all_ts x')) ⇒ all_ts refs1 stack1 ⊆ all_ts refs2 stack2
all_ts_mutcons_typed=(ptr :num) ∉ (domain (refs :v ref sptree$num_map) :num -> bool) ⇒ all_ts refs ((l :v list) ++ [(c :v)] ++ (r :v list) ++ (stack :v list)) ⊆ all_ts (insert ptr (MutBlock (tag :num) F l c r) refs :v ref sptree$num_map) ((RefPtr F ptr :v)::stack)
blocks_unique_mutcons_typed=blocks_unique (ts :num) (all_vs (refs :v ref sptree$num_map) ((l :v list) ++ [(c :v)] ++ (r :v list) ++ (stack :v list))) ⇒ blocks_unique ts (all_vs (insert (ptr :num) (MutBlock (tag :num) F l c r) refs :v ref sptree$num_map) ((RefPtr F ptr :v)::stack))
ref_edge_MutBlock_typed=ref_edge (insert (ptr :num) (MutBlock (tag :num) (fin :bool) (l :v list) (c :v) (r :v list)) (refs :v ref sptree$num_map) :v ref sptree$num_map) (x :num) (y :num) ⇔ if x = ptr then MEM y (get_refs (Block (0 :num) (ARB :num) (l ++ [c] ++ r) :v)) else ref_edge refs x y
reachable_refs_MutCons_lemma_typed=∀(r1 :num) (n :num). (ref_edge (insert (ptr :num) (MutBlock (tag :num) F (l :v list) (c :v) (r :v list)) (refs :v ref sptree$num_map) :v ref sptree$num_map))꙳ r1 n ⇒ n ≠ ptr ⇒ (ref_edge refs)꙳ r1 n ∨ ∃(s :num). MEM s (get_refs (Block (0 :num) (ARB :num) (l ++ [c] ++ r) :v)) ∧ (ref_edge refs)꙳ s n
reachable_refs_MutCons_typed=reachable_refs ((RefPtr F (ptr :num) :v)::(stack :v list)) (insert ptr (MutBlock (tag :num) F (l :v list) (c :v) (r :v list)) (refs :v ref sptree$num_map) :v ref sptree$num_map) (n :num) ∧ n ≠ ptr ∧ ptr ∉ (domain refs :num -> bool) ⇒ reachable_refs (l ++ [c] ++ r ++ stack) refs n
take_el_drop_typed=∀(index :num) (vals :α list). index < LENGTH vals ⇒ TAKE index vals ++ [vals❲index❳] ++ DROP (index + (1 :num)) vals = vals
dest_thunk_insert_fresh_typed=(ptr :num) ∉ (domain (refs :v ref sptree$num_map) :num -> bool) ∧ (dest_thunk (v :v) refs :dest_thunk_ret) = NotThunk ⇒ (dest_thunk v (insert ptr (x :v ref) refs :v ref sptree$num_map) :dest_thunk_ret) = NotThunk
heap_store_ThunkBlock_thm_typed=∀(ha :(α, tag # β list) heap_element list). heap_store (heap_length ha) [(ThunkBlock (ev1 :thunk_mode) (v1 :α heap_address) :(α, tag # β list) heap_element)] (ha ++ (ThunkBlock (ev2 :thunk_mode) (v2 :α heap_address) :(α, tag # β list) heap_element)::(hb :(α, tag # β list) heap_element list)) = (ha ++ (ThunkBlock ev1 v1 :(α, tag # β list) heap_element)::hb,T)
heap_lookup_ThunkBlock_lemma_typed=heap_lookup (n :num) ((ha :(α, tag # β list) heap_element list) ++ (ThunkBlock (ev :thunk_mode) (v :α heap_address) :(α, tag # β list) heap_element)::(hb :(α, tag # β list) heap_element list)) = SOME (x :(α, tag # β list) heap_element) ⇔ if n < heap_length ha then heap_lookup n ha = SOME x else if n = heap_length ha then x = (ThunkBlock ev v :(α, tag # β list) heap_element) else if heap_length ha + (2 :num) ≤ n then heap_lookup (n − heap_length ha − (2 :num)) hb = SOME x else F
heap_store_ThunkBlock_typed=heap_lookup (n :num) (heap :(α, tag # β list) heap_element list) = SOME (ThunkBlock NotEvaluated (y :α heap_address) :(α, tag # β list) heap_element) ⇒ ∃(heap2 :(α, tag # β list) heap_element list). heap_store n [(ThunkBlock (ev :thunk_mode) (h :α heap_address) :(α, tag # β list) heap_element)] heap = (heap2,T) ∧ heap_lookup n heap2 = SOME (ThunkBlock ev h :(α, tag # β list) heap_element) ∧ heap_length heap2 = heap_length heap ∧ FILTER (isForwardPointer :(α, tag # β list) heap_element -> bool) heap2 = FILTER (isForwardPointer :(α, tag # β list) heap_element -> bool) heap ∧ (∀(xs :α heap_address list) (l :num) (d :tag # β list). MEM (DataElement xs l d) heap2 ⇒ DataElement xs l d = (ThunkBlock ev h :(α, tag # β list) heap_element) ∨ MEM (DataElement xs l d) heap) ∧ (∀(a :num). isSomeDataElement (heap_lookup a heap2) ⇔ isSomeDataElement (heap_lookup a heap)) ∧ ∀(m :num) (x :(α, tag # β list) heap_element). m ≠ n ∧ heap_lookup m heap = SOME x ⇒ heap_lookup m heap2 = SOME x
INJ_NEQ_typed=INJ (FAPPLY (f :α |-> num)) (FDOM f) {a | isSomeDataElement (heap_lookup a (heap :(β, γ) heap_element list))} ∧ (n :α) ∈ FDOM f ∧ (ptr :α) ∈ FDOM f ∧ n ≠ ptr ⇒ f⟨n⟩ ≠ f⟨ptr⟩
heap_lookup_heap_split_typed=∀(heap :(α, β) heap_element list) (a :num) (b :num) (h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (x :(α, β) heap_element). heap_split a heap = SOME (h1,h2) ∧ heap_lookup b heap = SOME x ⇒ if b < a then MEM x h1 else MEM x h2
heap_store_heap_lookup_typed=∀(heap :(α, β) heap_element list) (heap2 :(α, β) heap_element list) (a :num) (x :(α, β) heap_element list) (n :num). heap_store a x heap = (heap2,T) ∧ n < a ⇒ heap_lookup n heap = heap_lookup n heap2
data_up_to_alt_typed=(data_up_to (n :num) ([] :(α, β) heap_element list) ⇔ n = (0 :num)) ∧ (data_up_to n ((x :(γ, δ) heap_element)::(xs :(γ, δ) heap_element list)) ⇔ if n = (0 :num) then T else if n < el_length x ∨ ¬isDataElement x then F else data_up_to (n − el_length x) xs)
data_up_to_heap_store_typed=∀(heap :(α, β) heap_element list) (a :num) (b :num) (heap2 :(α, β) heap_element list) (y :(α, β) heap_element). data_up_to a heap ∧ heap_store b [y] heap = (heap2,T) ∧ isDataElement y ⇒ data_up_to a heap2
blocks_unique_update_thunk_typed=blocks_unique (ts :num) (all_vs (refs :v ref sptree$num_map) ((h :v)::(RefPtr F (ptr :num) :v)::(stack :v list))) ⇒ blocks_unique ts (all_vs (insert ptr (Thunk (ev :thunk_mode) h :v ref) refs :v ref sptree$num_map) (h::(RefPtr F ptr :v)::stack))
thunk_deref_def_typed=∀(a :num) (heap :(α, tag # β list) heap_element list). thunk_deref a heap = case heap_lookup a heap of (NONE :(α, tag # β list) heap_element option) => (NONE :α heap_address list option) | SOME (Unused v9 :(α, tag # β list) heap_element) => (NONE :α heap_address list option) | SOME (ForwardPointer v10 v11 v12 :(α, tag # β list) heap_element) => (NONE :α heap_address list option) | SOME (DataElement xs l (BlockTag v25,v19)) => (NONE :α heap_address list option) | SOME (DataElement xs l (RefTag,v19)) => (NONE :α heap_address list option) | SOME (DataElement xs l (BytesTag v26 v27,v19)) => (NONE :α heap_address list option) | SOME (DataElement xs l (ThunkTag Evaluated,v19)) => (NONE :α heap_address list option) | SOME (DataElement xs l (ThunkTag NotEvaluated,([] :β list))) => SOME xs | SOME (DataElement xs l (ThunkTag NotEvaluated,v32::v33)) => (NONE :α heap_address list option) | SOME (DataElement xs l (NumTag v29,v19)) => (NONE :α heap_address list option) | SOME (DataElement xs l (Word64Tag,v19)) => (NONE :α heap_address list option)
heap_store_BlockRep_thm_typed=∀(ha :(α, tag # β list) heap_element list). LENGTH (x :α heap_address list) = LENGTH (y :α heap_address list) ⇒ heap_store (heap_length ha) [(BlockRep (tag :num) x :(α, tag # β list) heap_element)] (ha ++ (BlockRep tag y :(α, tag # β list) heap_element)::(hb :(α, tag # β list) heap_element list)) = (ha ++ (BlockRep tag x :(α, tag # β list) heap_element)::hb,T)
heap_lookup_BlockRep_lemma_typed=heap_lookup (n :num) ((ha :(α, tag # β list) heap_element list) ++ (BlockRep (tag :num) (y :α heap_address list) :(α, tag # β list) heap_element)::(hb :(α, tag # β list) heap_element list)) = SOME (x :(α, tag # β list) heap_element) ⇔ if n < heap_length ha then heap_lookup n ha = SOME x else if n = heap_length ha then x = (BlockRep tag y :(α, tag # β list) heap_element) else if heap_length ha + (LENGTH y + (1 :num)) ≤ n then heap_lookup (n − heap_length ha − (LENGTH y + (1 :num))) hb = SOME x else F
heap_store_BlockRep_typed=LENGTH (y :α heap_address list) = LENGTH (h :α heap_address list) ∧ heap_lookup (n :num) (heap :(α, tag # β list) heap_element list) = SOME (BlockRep (tag :num) y :(α, tag # β list) heap_element) ⇒ ∃(heap2 :(α, tag # β list) heap_element list). heap_store n [(BlockRep tag h :(α, tag # β list) heap_element)] heap = (heap2,T) ∧ heap_lookup n heap2 = SOME (BlockRep tag h :(α, tag # β list) heap_element) ∧ heap_length heap2 = heap_length heap ∧ FILTER (isForwardPointer :(α, tag # β list) heap_element -> bool) heap2 = FILTER (isForwardPointer :(α, tag # β list) heap_element -> bool) heap ∧ (∀(xs :α heap_address list) (l :num) (d :tag # β list). MEM (DataElement xs l d) heap2 ⇒ DataElement xs l d = (BlockRep tag h :(α, tag # β list) heap_element) ∨ MEM (DataElement xs l d) heap) ∧ (∀(a :num). isSomeDataElement (heap_lookup a heap2) ⇔ isSomeDataElement (heap_lookup a heap)) ∧ ∀(m :num) (x :(α, tag # β list) heap_element). m ≠ n ∧ heap_lookup m heap = SOME x ⇒ heap_lookup m heap2 = SOME x
v_inv_MutBlock_hole_lemma_typed=∀(ck :num) (v1 :v) (refs :v ref sptree$num_map) (y :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) v1 refs (y,f,tf,heap) ∧ (lookup (ptr :num) refs :v ref option) = SOME (MutBlock (tag :num) (fin1 :bool) (ll :v list) (cv1 :v) (rr :v list)) ⇒ v_inv_ck ck conf v1 (insert ptr (MutBlock tag (fin2 :bool) ll (cv2 :v) rr) refs :v ref sptree$num_map) (y,f,tf,heap)
v_inv_MutBlock_hole_typed=∀(cnf :data_to_word$config) (vv :v) (rfs :v ref sptree$num_map) (yy :α word_loc heap_address) (ff :num |-> num) (tff :num |-> num) (hp :(α word_loc, tag # α word_loc list) heap_element list) (pp :num) (tg :num) (b1 :bool) (b2 :bool) (l1 :v list) (c1 :v) (c2 :v) (r1 :v list). v_inv cnf vv rfs (yy,ff,tff,hp) ∧ (lookup pp rfs :v ref option) = SOME (MutBlock tg b1 l1 c1 r1) ⇒ v_inv cnf vv (insert pp (MutBlock tg b2 l1 c2 r1) rfs :v ref sptree$num_map) (yy,ff,tff,hp)
blocks_unique_update_mutblock_typed=(lookup (ptr :num) (refs :v ref sptree$num_map) :v ref option) = SOME (MutBlock (tag :num) (fin :bool) (l :v list) (cv :v) (r :v list)) ∧ blocks_unique (ts :num) (all_vs refs ((h :v)::(RefPtr F ptr :v)::(stack :v list))) ⇒ blocks_unique ts (all_vs (insert ptr (MutBlock tag fin l h r) refs :v ref sptree$num_map) (h::(RefPtr F ptr :v)::stack))
ref_edge_MutBlock_UPDATE_typed=(lookup (ptr :num) (refs :v ref sptree$num_map) :v ref option) = SOME (MutBlock (tg :num) (fin :bool) (ll :v list) (cc :v) (rr :v list)) ∧ ref_edge (insert ptr (MutBlock tg fin ll (h :v) rr) refs :v ref sptree$num_map) (r1 :num) (z :num) ∧ ¬MEM z (get_refs h) ⇒ ref_edge refs r1 z
reachable_refs_MutBlock_UPDATE_typed=(lookup (ptr :num) (refs :v ref sptree$num_map) :v ref option) = SOME (MutBlock (tg :num) (fin :bool) (ll :v list) (cc :v) (rr :v list)) ∧ reachable_refs ((h :v)::(RefPtr (b :bool) ptr :v)::(stack :v list)) (insert ptr (MutBlock tg fin ll h rr) refs :v ref sptree$num_map) (n :num) ⇒ reachable_refs (h::(RefPtr b ptr :v)::stack) refs n
LIST_REL_IMP_LIST_REL_typed=∀(xs :α list) (ys :β list). (∀(x :α) (y :β). MEM x xs ⇒ (P :α -> β -> bool) x y ⇒ (Q :α -> β -> bool) x y) ⇒ LIST_REL P xs ys ⇒ LIST_REL Q xs ys
v_inv_IMP_lemma_typed=∀(ck :num) (w :v) (refs :v ref sptree$num_map) (x :α word_loc heap_address) (f :num |-> num) (tf :num |-> num). v_inv (conf :data_to_word$config) w refs (x,f,tf,(ha :(α word_loc, tag # α word_loc list) heap_element list) ++ [Bytes (be :bool) (fl :bool) (xs :word8 list) (ws :α word list)] ++ (hb :(α word_loc, tag # α word_loc list) heap_element list)) ⇒ v_inv_ck ck conf w refs (x,f,tf,ha ++ [Bytes be fl (ys :word8 list) ws] ++ hb)
v_inv_IMP_typed=∀(y :v) (x :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (ha :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) y (refs :v ref sptree$num_map) (x,f,tf,ha ++ [Bytes (be :bool) (fl :bool) (xs :word8 list) (ws :α word list)] ++ (hb :(α word_loc, tag # α word_loc list) heap_element list)) ⇒ v_inv conf y refs (x,f,tf,ha ++ [Bytes be fl (ys :word8 list) ws] ++ hb)
gen_state_ok_update_byte_typed=gen_state_ok (a :num) (k :num) ((ha :(α word_loc, tag # α word_loc list) heap_element list) ++ [Bytes (be :bool) (fl :bool) (xs :word8 list) (ws :α word list)] ++ (hb :(α word_loc, tag # α word_loc list) heap_element list)) (gens :gen_state) ⇒ gen_state_ok a k (ha ++ [Bytes be fl (ys :word8 list) ws] ++ hb) gens
heap_length_Bytes_typed=heap_length [Bytes (be :bool) (fl :bool) (bs :word8 list) (ws :α word list)] = LENGTH ws + (1 :num)
unused_space_inv_byte_update_typed=unused_space_inv (a :num) ((sp :num) + (sp1 :num)) ((ha :(α word_loc, tag # α word_loc list) heap_element list) ++ [Bytes (be :bool) (fl :bool) (xs :word8 list) (REPLICATE (ws :num) (0w :α word))] ++ (hb :(α word_loc, tag # α word_loc list) heap_element list)) ⇒ unused_space_inv a (sp + sp1) (ha ++ [Bytes be fl (ys :word8 list) (REPLICATE ws (0w :α word))] ++ hb)
blocks_unique_deref1_typed=(lookup (ptr :num) (refs :v ref sptree$num_map) :v ref option) = SOME (Thunk NotEvaluated (a' :v) :v ref) ∧ blocks_unique (ts :num) (all_vs refs ((RefPtr F ptr :v)::(stack :v list))) ⇒ blocks_unique ts (all_vs refs (a'::(RefPtr F ptr :v)::stack))
blocks_unique_deref2_typed=(n :num) < LENGTH (l :v list) ∧ (lookup (ptr :num) (refs :v ref sptree$num_map) :v ref option) = SOME (ValueArray l :v ref) ∧ blocks_unique (ts :num) (all_vs refs ((RefPtr (b :bool) ptr :v)::(stack :v list))) ⇒ blocks_unique ts (all_vs refs (l❲n❳::(RefPtr b ptr :v)::stack))
small_int_IMP_MIN_MAX_typed=good_dimindex (:α) ∧ small_int (:α) (i :int) ⇒ (INT_MIN (:α) :int) ≤ (4 :int) * i ∧ (4 :int) * i ≤ (INT_MAX (:α) :int)
all_ts_permute_typed=∀(refs :v ref sptree$num_map) (stack :v list) (stack' :v list). PERM stack stack' ⇒ all_ts refs stack = all_ts refs stack'
pointer_bits_def_typed=∀(conf :data_to_word$config) (abs_heap :(β, tag # γ list) heap_element list) (n :num). (pointer_bits conf abs_heap n :α word) = case heap_lookup n abs_heap of (NONE :(β, tag # γ list) heap_element option) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (Unused v9 :(β, tag # γ list) heap_element) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (ForwardPointer v10 v11 v12 :(β, tag # γ list) heap_element) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (DataElement xs l (BlockTag tag,([] :γ list))) => (maxout_bits (LENGTH xs) conf.len_bits (conf.tag_bits + (2 :num)) :α word) ‖ (maxout_bits tag conf.tag_bits (2 :num) :α word) ‖ (1w :α word) | SOME (DataElement xs l (BlockTag tag,v32::v33)) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (DataElement xs l (RefTag,v19)) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (DataElement xs l (BytesTag v26 v27,v19)) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (DataElement xs l (ThunkTag v28,v19)) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (DataElement xs l (NumTag v29,v19)) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word) | SOME (DataElement xs l (Word64Tag,v19)) => (all_ones (conf.len_bits + conf.tag_bits + (1 :num)) (0 :num) :α word)
is_all_ones_def_typed=∀(m :num) (n :num) (w :α word). is_all_ones m n w ⇔ (all_ones m n :α word) && w = (all_ones m n :α word)
decode_maxout_def_typed=∀(l :num) (n :num) (w :α word). decode_maxout l n w = if is_all_ones (n + l) n w then (NONE :α word option) else SOME ((n + l -- n) w ≫ n)
decode_addr_def_typed=∀(conf :data_to_word$config) (w :α word). decode_addr conf w = (decode_maxout conf.len_bits (conf.tag_bits + (2 :num)) w,decode_maxout conf.tag_bits (2 :num) w)
heap_el_def_typed=heap_el (Pointer (a :num) (u :β)) (n :num) (heap :(α, γ) heap_element list) = (case heap_lookup a heap of (NONE :(α, γ) heap_element option) => ((ARB :α heap_address),F) | SOME (Unused v9 :(α, γ) heap_element) => ((ARB :α heap_address),F) | SOME (ForwardPointer v10 v11 v12 :(α, γ) heap_element) => ((ARB :α heap_address),F) | SOME (DataElement xs l d) => if n < LENGTH xs then (xs❲n❳,T) else ((ARB :α heap_address),F)) ∧ heap_el (Data (v6 :β)) (v1 :num) (v2 :(α, γ) heap_element list) = ((ARB :α heap_address),F)
