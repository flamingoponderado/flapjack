eval_ind=∀P. (∀s w. P s (Const w)) ∧ (∀s v. P s (Var Local v)) ∧
    (∀s v. P s (Var Global v)) ∧
    (∀s es. (∀a. MEM a es ⇒ P s a) ⇒ P s (RStruct es)) ∧
    (∀s index e. P s e ⇒ P s (RField index e)) ∧
    (∀s nm eflds.
       (∀field_names field_exps info field_names' field_shapes a.
          (field_names,field_exps) = UNZIP eflds ∧
          ALOOKUP s.structs nm = SOME info ∧
          (field_names',field_shapes) = UNZIP info.fields ∧
          field_names' = field_names ∧ MEM a field_exps ⇒
          P s a) ⇒
       P s (NStruct nm eflds)) ∧ (∀s fld e. P s e ⇒ P s (NField fld e)) ∧
    (∀s shape addr.
       (is_wf_shape s.structs shape ⇒ P s addr) ⇒ P s (Load shape addr)) ∧
    (∀s addr. P s addr ⇒ P s (Load32 addr)) ∧
    (∀s addr. P s addr ⇒ P s (LoadByte addr)) ∧
    (∀s op es. (∀a. MEM a es ⇒ P s a) ⇒ P s (Op op es)) ∧
    (∀s op es. (∀a. MEM a es ⇒ P s a) ⇒ P s (Panop op es)) ∧
    (∀s cmp e1 e2. P s e1 ∧ P s e2 ⇒ P s (Cmp cmp e1 e2)) ∧
    (∀s sh e1 e2. P s e1 ∧ P s e2 ⇒ P s (Shift sh e1 e2)) ∧
    (∀s. P s BaseAddr) ∧ (∀s. P s TopAddr) ∧ (∀s. P s BytesInWord) ⇒
    ∀v v1. P v v1
