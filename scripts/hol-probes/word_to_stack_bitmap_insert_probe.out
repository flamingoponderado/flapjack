bi_full=⊢ ∀bs n bs' n' i cur. i < dimword (:α) ∧ IS_SOME (read_bitmap bm) ∧ n = LENGTH cur + LENGTH (append bs) ∧ insert_bitmap bm (bs,n) = ((bs',n'),i) ⇒ read_bitmap (DROP (i MOD dimword (:α)) (cur ++ append bs')) = read_bitmap bm
bi_decode_0_0_0_1=⊢ read_bitmap (DROP (0 MOD dimword (:unit)) ([] ++ append (Append Nil (List [0w])))) = read_bitmap [0w] ⇔ T
