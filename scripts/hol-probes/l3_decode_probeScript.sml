fun q s = "\"" ^ String.toString s ^ "\"";
fun ty t =
  if is_vartype t then "(tv " ^ q (dest_vartype t) ^ ")"
  else let val {Thy, Tyop, Args} = dest_thy_type t
       in "(ty " ^ q Thy ^ " " ^ q Tyop ^ String.concat (map (fn a => " " ^ ty a) Args) ^ ")" end;
fun tm t =
  case dest_term t of
     VAR (n, y) => "(v " ^ q n ^ " " ^ ty y ^ ")"
   | CONST {Name, Thy, Ty} => "(c " ^ q Thy ^ " " ^ q Name ^ " " ^ ty Ty ^ ")"
   | COMB (f, x) => "(a " ^ tm f ^ " " ^ tm x ^ ")"
   | LAMB (v, b) => "(l " ^ tm v ^ " " ^ tm b ^ ")";

fun observe label q = let val th = (EVAL THENC DEPTH_CONV (TRY_CONV bitstringLib.v2w_n2w_CONV) THENC EVAL) q; val value = snd(dest_eq(concl th)) in if null(hyp th) andalso null(free_vars value) andalso (let val (h,_) = strip_comb value; val {Thy,Name,...} = dest_thy_const h in Thy="riscv" andalso mem Name ["AMO","ArithI","ArithR","Branch","FArith","FConv","FENCE","FENCE_I","FPLoad","FPStore","Internal","Load","MulDiv","Shift","Store","System","UnknownInstruction"] end) then (print(label^"=");print(tm value);print "\n") else raise Fail "incomplete evaluation" end;
