bytes_typed=∀(lv :v). v_to_bytes lv = some(ns :word8 list). v_to_list lv = SOME (MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns)
words_typed=∀(lv :v). v_to_words lv = some(ns :word64 list). v_to_list lv = SOME (MAP Word64 ns)
install_typed=∀(vs :v list) (s :(γ, 'ffi) state). do_install vs s = case vs of ([] :v list) => ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s) | [v1] => ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s) | [v1; v2] => (case (v_to_bytes v1,v_to_words v2) of ((NONE :word8 list option),v6) => ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s) | (SOME bytes,(NONE :word64 list option)) => ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s) | (SOME bytes,SOME data) => (let ((cfg :γ),(progs :closLang$exp list # (num # num # closLang$exp) list)) = s.compile_oracle (0 :num); (new_oracle :num -> γ # closLang$exp list # (num # num # closLang$exp) list) = shift_seq (1 :num) s.compile_oracle in if DISJOINT (FDOM s.code) (set (MAP (FST :num # num # closLang$exp -> num) (SND progs))) ∧ ALL_DISTINCT (MAP (FST :num # num # closLang$exp -> num) (SND progs)) then case (s.compile cfg progs,progs) of ((NONE :(word8 list # word64 list # γ) option),v3) => ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s) | (SOME (bytes',data',cfg'),exps,aux) => if bytes = bytes' ∧ data = data' ∧ FST (new_oracle (0 :num)) = cfg' ∧ exps ≠ ([] :closLang$exp list) then (let (s' :(γ, 'ffi) state) = s with <|code := s.code |++ aux; compile_oracle := new_oracle; clock := s.clock − (1 :num)|> in if s.clock = (0 :num) then ((Rerr (Rabort Rtimeout_error :v error_result) :(closLang$exp list, v) result),s') else ((Rval exps :(closLang$exp list, v) result),s')) else ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s) else ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s))) | v1::v2::v17::v18 => ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),s)
clock_typed=do_install (vs :v list) (s :(α, β) state) = ((Rval (e :closLang$exp list) :(closLang$exp list, v) result),(s' :(α, β) state)) ⇒ (0 :num) < s.clock ∧ s'.clock = s.clock − (1 :num)
clock_bound_typed=do_install (vs :v list) (s :(α, β) state) = ((res :(closLang$exp list, v) result),(s' :(α, β) state)) ⇒ s'.clock ≤ s.clock
wrong_arity=Rerr (Rabort Rtype_error)
one_arg=Rerr (Rabort Rtype_error)
