int_op_def_typed=∀(op_index :num) (i :int) (j :int). (int_op op_index i j :int option) = if op_index = (0 :num) then SOME (i + j) else if op_index = (1 :num) then SOME (i − j) else if op_index = (4 :num) then SOME (i * j) else if op_index = (5 :num) ∧ j ≠ (0 :int) then SOME (i / j) else if op_index = (6 :num) ∧ j ≠ (0 :int) then SOME (i % j) else (NONE :int option)
