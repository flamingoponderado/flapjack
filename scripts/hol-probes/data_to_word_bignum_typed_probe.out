 structure_le (Branch v15 v16 :call_tree) (Const v59 v60 :call_tree) ⇔ F) ∧ ∀(v62 :call_tree) (v61 :num) (v16 :call_tree) (v15 :call_tree). structure_le (Branch v15 v16 :call_tree) (Call v61 v62 :call_tree) ⇔ F
