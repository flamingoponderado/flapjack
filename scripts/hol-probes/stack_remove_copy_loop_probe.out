copy_each_full_def=∀t1 t2. copy_each t1 t2 = Loop (If NotEqual 1 (Imm 1w) (list_Seq [Inst (Mem Load t1 (Addr t2 0w)); Inst (Arith (Binop Add t2 t2 (Imm bytes_in_word))); If Test 1 (Imm 1w) Skip (Inst (Arith (Binop Add t1 t1 (Reg 3)))); Inst (Arith (Shift Lsr 1 1 (Imm 1w))); Inst (Mem Store t1 (Addr 2 0w)); Inst (Arith (Binop Add 2 2 (Imm bytes_in_word)))]) (Break 0))
copy_each_type=:num -> num -> α prog
copy_loop_full_def=∀t1 t2. copy_loop t1 t2 = list_Seq [Inst (Mem Load 1 (Addr t2 0w)); Inst (Arith (Binop Add t2 t2 (Imm bytes_in_word))); Loop (If Less 1 (Imm 0w) (list_Seq [copy_each t1 t2; Inst (Mem Load 1 (Addr t2 0w)); Inst (Arith (Binop Add t2 t2 (Imm bytes_in_word)))]) (Break 0)); copy_each t1 t2]
