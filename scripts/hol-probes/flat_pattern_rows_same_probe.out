pmatch_rows_same_FST_typed=∀(pats :(flatLang$pat # α) list) (pats2 :(flatLang$pat # β) list). MAP (FST :flatLang$pat # α -> flatLang$pat) pats = MAP (FST :flatLang$pat # β -> flatLang$pat) pats2 ⇒ case pmatch_rows pats (s :(γ, δ) state) (v :v) of (No_match :((mlstring # v) list # flatLang$pat # α) match_result) => pmatch_rows pats2 s v = (No_match :((mlstring # v) list # flatLang$pat # β) match_result) | (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) => pmatch_rows pats2 s v = (Match_type_error :((mlstring # v) list # flatLang$pat # β) match_result) | Match (env,p,e) => ∃(i :num). i < LENGTH pats2 ∧ pats❲i❳ = (p,e) ∧ pmatch_rows pats2 s v = Match (env,pats2❲i❳)
max_dec_name_LESS_EVERY_typed=max_dec_name (ns :mlstring list) < (N :num) ⇔ (0 :num) < N ∧ EVERY (λ(n :mlstring). dec_name_to_num n < N) ns
