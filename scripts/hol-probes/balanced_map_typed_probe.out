almost_balancedL_thm_typed=∀(l :num) (r :num). balanced l r ⇒ almost_balancedL l r ∧ almost_balancedL (l + (1 :num)) r ∧ almost_balancedL l (r − (1 :num))
almost_balancedR_thm_typed=∀(l :num) (r :num). balanced l r ⇒ almost_balancedR l r ∧ almost_balancedR l (r + (1 :num)) ∧ almost_balancedR (l − (1 :num)) r
almost_balancedL_def_typed=∀(l :num) (r :num). almost_balancedL l r ⇔ if l + r ≤ (1 :num) ∨ l ≤ delta * r then balanced l r else if r = (0 :num) then l < (5 :num) else if r = (1 :num) then l < (8 :num) else (2 :num) * l < ((2 :num) * delta + (3 :num)) * r + (2 :num)
almost_balancedR_def_typed=∀(l :num) (r :num). almost_balancedR l r ⇔ if l + r ≤ (1 :num) ∨ r ≤ delta * l then balanced l r else if l = (0 :num) then r < (5 :num) else if l = (1 :num) then r < (8 :num) else (2 :num) * r < ((2 :num) * delta + (3 :num)) * l + (2 :num)
balanced_lem1_typed=∀(l :num) (r :num). l + r ≤ (1 :num) ⇒ balanced l r
balanced_lem2_typed=∀(l :num) (r :num). ¬(l > delta * r) ∧ almost_balancedL l r ∧ ¬(l + r ≤ (1 :num)) ⇒ balanced l r
balanced_lem3_typed=∀(b :num) (b0 :num) (r :num). almost_balancedL (b + b0 + (1 :num)) r ∧ b + b0 + (1 :num) > delta * r ∧ b0 < ratio * b ∧ balanced b b0 ⇒ balanced b (b0 + r + (1 :num)) ∧ balanced b0 r
balanced_lem4_typed=∀(b :num) (b' :num) (b0' :num) (r :num). almost_balancedL (b + b' + b0' + (2 :num)) r ∧ b + b' + b0' + (2 :num) > delta * r ∧ ¬(b' + b0' + (1 :num) < ratio * b) ∧ balanced b (b' + b0' + (1 :num)) ∧ balanced b' b0' ⇒ balanced (b + b' + (1 :num)) (b0' + r + (1 :num)) ∧ balanced b b' ∧ balanced b0' r
balanced_lem5_typed=∀(l :num) (r :num). ¬(r > delta * l) ∧ almost_balancedR l r ⇒ balanced l r
balanced_lem6_typed=∀(b :num) (b0 :num) (l :num). almost_balancedR l (b + b0 + (1 :num)) ∧ b + b0 + (1 :num) > delta * l ∧ b < ratio * b0 ∧ balanced b b0 ⇒ balanced (b + l + (1 :num)) b0 ∧ balanced l b
balanced_lem7_typed=∀(b :α) (b0 :num) (b0' :num) (l :num) (b' :num). almost_balancedR l (b' + b0 + b0' + (2 :num)) ∧ b' + b0 + b0' + (2 :num) > delta * l ∧ ¬(b' + b0' + (1 :num) < ratio * b0) ∧ balanced (b' + b0' + (1 :num)) b0 ∧ balanced b' b0' ⇒ balanced (b' + l + (1 :num)) (b0 + b0' + (1 :num)) ∧ balanced l b' ∧ balanced b0' b0
size_thm_typed=∀(cmp :α -> α -> ordering) (t :(α, β) balanced_map). good_cmp cmp ∧ invariant cmp t ⇒ size t = FCARD (to_fmap cmp t)
structure_size_to_fmap_typed=∀(cmp :α -> α -> ordering) (t :(α, β) balanced_map). good_cmp cmp ∧ invariant cmp t ⇒ FCARD (to_fmap cmp t) = structure_size t
balanced_map_typed=Tip::('k, φ) balanced_map; Bin::num -> 'k -> φ -> ('k, φ) balanced_map -> ('k, φ) balanced_map -> ('k, φ) balanced_map
bin_def_typed=∀(k :α) (x :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). bin k x l r = Bin (size l + size r + (1 :num)) k x l r
delta_def_typed=delta = (3 :num)
empty_def_typed=(empty :(α, β) balanced_map) = (Tip :(α, β) balanced_map)
lookup_def_typed=(∀(cmp :β -> γ -> ordering) (k :β). lookup cmp k (Tip :(γ, α) balanced_map) = (NONE :α option)) ∧ ∀(cmp :β -> γ -> ordering) (k :β) (s :num) (k' :γ) (v :α) (l :(γ, α) balanced_map) (r :(γ, α) balanced_map). lookup cmp k (Bin s k' v l r) = case cmp k k' of Less => lookup cmp k l | Equal => SOME v | Greater => lookup cmp k r
member_def_typed=(∀(cmp :α -> β -> ordering) (k :α). member cmp k (Tip :(β, γ) balanced_map) ⇔ F) ∧ ∀(cmp :α -> β -> ordering) (k :α) (s :num) (k' :β) (v :γ) (l :(β, γ) balanced_map) (r :(β, γ) balanced_map). member cmp k (Bin s k' v l r) ⇔ case cmp k k' of Less => member cmp k l | Equal => T | Greater => member cmp k r
null_def_typed=(null (Tip :(α, β) balanced_map) ⇔ T) ∧ ∀(s :num) (k :α) (v :β) (m1 :(α, β) balanced_map) (m2 :(α, β) balanced_map). null (Bin s k v m1 m2) ⇔ F
ratio_def_typed=ratio = (2 :num)
singleton_def_typed=∀(k :α) (x :β). singleton k x = Bin (1 :num) k x (Tip :(α, β) balanced_map) (Tip :(α, β) balanced_map)
size_def_typed=size (Tip :(α, β) balanced_map) = (0 :num) ∧ ∀(s :num) (k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). size (Bin s k v l r) = s
to_fmap_key_set_typed=∀(cmp :α -> β -> ordering) (ks :β -> bool) (t :(α, γ) balanced_map). ks ∈ FDOM (to_fmap cmp t) ⇒ ∃(k :α). ks = key_set cmp k
insert_def_typed=(∀(cmp :α -> α -> ordering) (k :α) (v :β). insert cmp k v (Tip :(α, β) balanced_map) = singleton k v) ∧ ∀(cmp :α -> α -> ordering) (k :α) (v :β) (s :num) (k' :α) (v' :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). insert cmp k v (Bin s k' v' l r) = case cmp k k' of Less => balanceL k' v' (insert cmp k v l) r | Equal => Bin s k v l r | Greater => balanceR k' v' l (insert cmp k v r)
insert_thm_typed=∀*(v :β) (k :α) (cmp :α -> α -> ordering) . ∀(t :(α, β) balanced_map). good_cmp (cmp :α -> α -> ordering) ∧ invariant cmp t ⇒ invariant cmp (insert cmp (k :α) (v :β) t) ∧ to_fmap cmp (insert cmp k v t) = (to_fmap cmp t)⟨key_set cmp k ↦ v⟩
inv_props_typed=∀(cmp :α -> α -> ordering) (s :num) (k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). good_cmp cmp ∧ invariant cmp (Bin s k v l r) ⇒ DISJOINT (FDOM (to_fmap cmp l)) (FDOM (to_fmap cmp r)) ∧ (∀(x :α). key_set cmp x ∈ FDOM (to_fmap cmp l) ⇒ cmp k x = Greater) ∧ ∀(x :α). key_set cmp x ∈ FDOM (to_fmap cmp r) ⇒ cmp k x = Less
invariant_eq_typed=∀*(r :(α, γ) balanced_map) (l :(α, γ) balanced_map) (v :γ) (k :α) (s :num) (cmp :α -> α -> ordering) . (invariant (cmp :α -> α -> ordering) (Tip :(α, β) balanced_map) ⇔ T) ∧ (invariant cmp (Bin (s :num) (k :α) (v :γ) (l :(α, γ) balanced_map) (r :(α, γ) balanced_map)) ⇔ (good_cmp cmp ⇒ DISJOINT (FDOM (to_fmap cmp l)) (FDOM (to_fmap cmp r))) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp l)) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp r)) ∧ s = (1 :num) + structure_size l + structure_size r ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ balanced (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r)
balanced_def_typed=∀(l :num) (r :num). balanced l r ⇔ l + r ≤ (1 :num) ∨ MAX l r ≤ delta * MIN l r
invariant_def_typed=(∀(cmp :α -> α -> ordering). invariant cmp (Tip :(α, β) balanced_map) ⇔ T) ∧ ∀(cmp :α -> α -> ordering) (s :num) (k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). invariant cmp (Bin s k v l r) ⇔ s = (1 :num) + structure_size l + structure_size r ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ balanced (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r
key_ordered_def_typed=(∀(cmp :α -> β -> γ) (k :α) (res :γ). key_ordered cmp k (Tip :(β, δ) balanced_map) res ⇔ T) ∧ ∀(cmp :α -> β -> γ) (k :α) (n :num) (k' :β) (v :δ) (l :(β, δ) balanced_map) (r :(β, δ) balanced_map) (res :γ). key_ordered cmp k (Bin n k' v l r) res ⇔ cmp k k' = res ∧ key_ordered cmp k l res ∧ key_ordered cmp k r res
structure_size_def_typed=structure_size (Tip :(α, β) balanced_map) = (0 :num) ∧ ∀(n :num) (k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). structure_size (Bin n k v l r) = (1 :num) + structure_size l + structure_size r
key_ordered_to_fmap_typed=∀(cmp :α -> α -> ordering) (k :α) (t :(α, β) balanced_map) (res :ordering). good_cmp cmp ⇒ (key_ordered cmp k t res ⇔ ∀(ks :α -> bool). ks ∈ FDOM (to_fmap cmp t) ⇒ key_set_cmp cmp k ks res)
key_set_cmp_def_typed=∀(cmp :α -> β -> γ) (k :α) (ks :β -> bool) (res :γ). key_set_cmp cmp k ks res ⇔ ∀(k' :β). k' ∈ ks ⇒ cmp k k' = res
key_set_cmp2_def_typed=∀(cmp :α -> β -> γ) (ks1 :α -> bool) (ks2 :β -> bool) (res :γ). key_set_cmp2 cmp ks1 ks2 res ⇔ ∀(k1 :α) (k2 :β). k1 ∈ ks1 ∧ k2 ∈ ks2 ⇒ cmp k1 k2 = res
key_set_cmp_thm_typed=∀(cmp :α -> α -> ordering) (k :α) (k' :α) (res :ordering). good_cmp cmp ⇒ (key_set_cmp cmp k (key_set cmp k') res ⇔ cmp k k' = res)
key_set_eq_typed=∀(cmp :α -> α -> ordering) (k1 :α) (k2 :α). good_cmp cmp ⇒ (key_set cmp k1 = key_set cmp k2 ⇔ cmp k1 k2 = Equal)
key_set_equiv_typed=∀(cmp :α -> α -> ordering). good_cmp cmp ⇒ (∀(k :α). k ∈ key_set cmp k) ∧ (∀(k1 :α) (k2 :α). k1 ∈ key_set cmp k2 ⇒ k2 ∈ key_set cmp k1) ∧ ∀(k1 :α) (k2 :α) (k3 :α). k1 ∈ key_set cmp k2 ∧ k2 ∈ key_set cmp k3 ⇒ k1 ∈ key_set cmp k3
key_set_nonempty_typed=good_cmp (cmp :α -> α -> ordering) ⇒ key_set cmp (k :α) ≠ (∅ :α -> bool)
key_set_partition_typed=∀(cmp :α -> α -> ordering) (k1 :α) (k2 :α). good_cmp cmp ∧ key_set cmp k1 ≠ key_set cmp k2 ⇒ DISJOINT (key_set cmp k1) (key_set cmp k2)
lookup_thm_typed=∀(cmp :α -> α -> ordering) (k :α) (t :(α, β) balanced_map). good_cmp cmp ∧ invariant cmp t ⇒ lookup cmp k t = FLOOKUP (to_fmap cmp t) (key_set cmp k)
member_eq_lookup_typed=∀(cmp :α -> β -> ordering) (k :α) (t :(β, γ) balanced_map). member cmp k t ⇔ IS_SOME (lookup cmp k t)
null_thm_typed=∀(cmp :α -> β -> ordering) (t :(α, γ) balanced_map). null t ⇔ to_fmap cmp t = (FEMPTY :(β -> bool) |-> γ)
bal_def_typed=∀(k :α) (x :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). bal k x l r = if size l + size r ≤ (1 :num) then Bin (size l + size r + (1 :num)) k x l r else if size r > delta * size l then rotateL k x l r else if size l > delta * size r then rotateR k x l r else Bin (size l + size r + (1 :num)) k x l r
balL_def_typed=∀(k :α) (x :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). balL k x l r = if size l + size r ≤ (1 :num) then Bin (size l + size r + (1 :num)) k x l r else if size l > delta * size r then rotateR k x l r else Bin (size l + size r + (1 :num)) k x l r
balR_def_typed=∀(k :α) (x :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). balR k x l r = if size l + size r ≤ (1 :num) then Bin (size l + size r + (1 :num)) k x l r else if size r > delta * size l then rotateL k x l r else Bin (size l + size r + (1 :num)) k x l r
doubleL_def_typed=∀*(t4 :(α, β) balanced_map) (t3 :(α, β) balanced_map) (t2 :(α, β) balanced_map) (x3 :β) (k3 :α) (v1 :num) (x2 :β) (k2 :α) (v0 :num) (t1 :(α, β) balanced_map) (x1 :β) (k1 :α) . doubleL (k1 :α) (x1 :β) (t1 :(α, β) balanced_map) (Bin (v0 :num) (k2 :α) (x2 :β) (Bin (v1 :num) (k3 :α) (x3 :β) (t2 :(α, β) balanced_map) (t3 :(α, β) balanced_map)) (t4 :(α, β) balanced_map)) = bin k3 x3 (bin k1 x1 t1 t2) (bin k2 x2 t3 t4)
doubleR_def_typed=∀*(t4 :(α, β) balanced_map) (t3 :(α, β) balanced_map) (t2 :(α, β) balanced_map) (x3 :β) (k3 :α) (v1 :num) (t1 :(α, β) balanced_map) (x2 :β) (k2 :α) (v0 :num) (x1 :β) (k1 :α) . doubleR (k1 :α) (x1 :β) (Bin (v0 :num) (k2 :α) (x2 :β) (t1 :(α, β) balanced_map) (Bin (v1 :num) (k3 :α) (x3 :β) (t2 :(α, β) balanced_map) (t3 :(α, β) balanced_map))) (t4 :(α, β) balanced_map) = bin k3 x3 (bin k2 x2 t1 t2) (bin k1 x1 t3 t4)
rotateL_def_typed=(∀(k :α) (x :β) (l :(α, β) balanced_map) (s' :num) (k' :α) (x' :β) (ly :(α, β) balanced_map) (ry :(α, β) balanced_map). rotateL k x l (Bin s' k' x' ly ry) = if size ly < ratio * size ry then singleL k x l (Bin s' k' x' ly ry) else doubleL k x l (Bin s' k' x' ly ry)) ∧ ∀(k :α) (x :β) (l :(α, β) balanced_map). rotateL k x l (Tip :(α, β) balanced_map) = doubleL k x l (Tip :(α, β) balanced_map)
rotateR_def_typed=(∀(k :α) (x :β) (s' :num) (k' :α) (x' :β) (ly :(α, β) balanced_map) (ry :(α, β) balanced_map) (r :(α, β) balanced_map). rotateR k x (Bin s' k' x' ly ry) r = if size ry < ratio * size ly then singleR k x (Bin s' k' x' ly ry) r else doubleR k x (Bin s' k' x' ly ry) r) ∧ ∀(k :α) (x :β) (r :(α, β) balanced_map). rotateR k x (Tip :(α, β) balanced_map) r = doubleR k x (Tip :(α, β) balanced_map) r
singleL_def_typed=∀(k1 :α) (x1 :β) (t1 :(α, β) balanced_map) (v0 :num) (k2 :α) (x2 :β) (t2 :(α, β) balanced_map) (t3 :(α, β) balanced_map). singleL k1 x1 t1 (Bin v0 k2 x2 t2 t3) = bin k2 x2 (bin k1 x1 t1 t2) t3
singleR_def_typed=∀(k1 :α) (x1 :β) (v0 :num) (k2 :α) (x2 :β) (t1 :(α, β) balanced_map) (t2 :(α, β) balanced_map) (t3 :(α, β) balanced_map). singleR k1 x1 (Bin v0 k2 x2 t1 t2) t3 = bin k2 x2 t1 (bin k1 x1 t2 t3)
balanceL_balL_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ invariant cmp l ∧ invariant cmp r ⇒ balanceL k v l r = balL k v l r
balanceL_thm_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ almost_balancedL (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r ⇒ invariant cmp (balanceL k v l r) ∧ to_fmap cmp (balanceL k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
balanceR_balR_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ invariant cmp l ∧ invariant cmp r ⇒ balanceR k v l r = balR k v l r
balanceR_thm_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ key_ordered cmp k r Less ∧ key_ordered cmp k l Greater ∧ almost_balancedR (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r ⇒ invariant cmp (balanceR k v l r) ∧ to_fmap cmp (balanceR k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
doubleL_thm_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (cmp :α -> α -> ordering) (n :num) (k' :α) (v' :β) (b :(α, β) balanced_map) (b0 :(α, β) balanced_map). good_cmp cmp ∧ key_ordered cmp k (Bin n k' v' b b0) Less ∧ key_ordered cmp k l Greater ∧ almost_balancedR (size l) n ∧ ¬(n + size l ≤ (1 :num)) ∧ n > delta * size l ∧ ¬(size b < ratio * size b0) ∧ invariant cmp (Bin n k' v' b b0) ∧ invariant cmp l ⇒ invariant cmp (doubleL k v l (Bin n k' v' b b0)) ∧ to_fmap cmp (doubleL k v l (Bin n k' v' b b0)) = (to_fmap cmp l ⊌ to_fmap cmp (Bin n k' v' b b0))⟨key_set cmp k ↦ v⟩
doubleR_thm_typed=∀(k :α) (v :β) (r :(α, β) balanced_map) (cmp :α -> α -> ordering) (n :num) (k' :α) (v' :β) (b :(α, β) balanced_map) (b0 :(α, β) balanced_map). good_cmp cmp ∧ key_ordered cmp k (Bin n k' v' b b0) Greater ∧ key_ordered cmp k r Less ∧ almost_balancedL n (size r) ∧ ¬(size r + n ≤ (1 :num)) ∧ n > delta * size r ∧ ¬(size b0 < ratio * size b) ∧ invariant cmp (Bin n k' v' b b0) ∧ invariant cmp r ⇒ invariant cmp (doubleR k v (Bin n k' v' b b0) r) ∧ to_fmap cmp (doubleR k v (Bin n k' v' b b0) r) = (to_fmap cmp (Bin n k' v' b b0) ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
rotateL_thm_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ key_ordered cmp k r Less ∧ key_ordered cmp k l Greater ∧ ¬(size l + size r ≤ (1 :num)) ∧ size r > delta * size l ∧ almost_balancedR (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r ⇒ invariant cmp (rotateL k v l r) ∧ to_fmap cmp (rotateL k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
rotateR_thm_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ ¬(size l + size r ≤ (1 :num)) ∧ size l > delta * size r ∧ almost_balancedL (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r ⇒ invariant cmp (rotateR k v l r) ∧ to_fmap cmp (rotateR k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
singleL_thm_typed=∀(k :α) (v :β) (l :(α, β) balanced_map) (cmp :α -> α -> ordering) (n :num) (k' :α) (v' :β) (b :(α, β) balanced_map) (b0 :(α, β) balanced_map). good_cmp cmp ∧ key_ordered cmp k (Bin n k' v' b b0) Less ∧ key_ordered cmp k l Greater ∧ almost_balancedR (size l) n ∧ ¬(size l + n ≤ (1 :num)) ∧ n > delta * size l ∧ size b < ratio * size b0 ∧ invariant cmp (Bin n k' v' b b0) ∧ invariant cmp l ⇒ invariant cmp (singleL k v l (Bin n k' v' b b0)) ∧ to_fmap cmp (singleL k v l (Bin n k' v' b b0)) = (to_fmap cmp l ⊌ to_fmap cmp (Bin n k' v' b b0))⟨key_set cmp k ↦ v⟩
singleR_thm_typed=∀(k :α) (v :β) (r :(α, β) balanced_map) (cmp :α -> α -> ordering) (n :num) (k' :α) (v' :β) (b :(α, β) balanced_map) (b0 :(α, β) balanced_map). good_cmp cmp ∧ key_ordered cmp k (Bin n k' v' b b0) Greater ∧ key_ordered cmp k r Less ∧ almost_balancedL n (size r) ∧ ¬(size r + n ≤ (1 :num)) ∧ n > delta * size r ∧ size b0 < ratio * size b ∧ invariant cmp (Bin n k' v' b b0) ∧ invariant cmp r ⇒ invariant cmp (singleR k v (Bin n k' v' b b0) r) ∧ to_fmap cmp (singleR k v (Bin n k' v' b b0) r) = (to_fmap cmp (Bin n k' v' b b0) ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
