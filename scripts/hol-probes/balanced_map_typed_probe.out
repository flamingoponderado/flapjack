key_set_def_typed=∀(cmp :β -> α -> ordering) (k :β). key_set cmp k = {k' | cmp k k' = Equal}
to_fmap_def_typed=(∀(cmp :γ -> α -> ordering). to_fmap cmp (Tip :(γ, β) balanced_map) = (FEMPTY :(α -> bool) |-> β)) ∧ ∀(cmp :γ -> α -> ordering) (s :num) (k :γ) (v :β) (l :(γ, β) balanced_map) (r :(γ, β) balanced_map). to_fmap cmp (Bin s k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
structure_size_thm_typed=∀(cmp :α -> α -> ordering) (t :(α, β) balanced_map). invariant cmp t ⇒ size t = structure_size t
