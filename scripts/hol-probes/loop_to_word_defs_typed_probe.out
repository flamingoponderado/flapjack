comp_exp_def_typed=(∀(w :α word) (ctxt :num sptree$num_map). comp_exp ctxt (Const w :α exp) = (Const w :α wordLang$exp)) ∧ (∀(n :num) (ctxt :num sptree$num_map). comp_exp ctxt (Var n :α exp) = (Var (find_var ctxt n) :α wordLang$exp)) ∧ (∀(m :word5) (ctxt :num sptree$num_map). comp_exp ctxt (Lookup m :α exp) = (Lookup (Temp m) :α wordLang$exp)) ∧ (∀(ctxt :num sptree$num_map). comp_exp ctxt (BaseAddr :α exp) = (Lookup CurrHeap :α wordLang$exp)) ∧ (∀(ctxt :num sptree$num_map). comp_exp ctxt (TopAddr :α exp) = Op Add [(Lookup CurrHeap :α wordLang$exp); ShiftN Lsl (Lookup HeapLength :α wordLang$exp) (1 :num)]) ∧ (∀(exp :α exp) (ctxt :num sptree$num_map). comp_exp ctxt (Load exp :α exp) = (Load (comp_exp ctxt exp) :α wordLang$exp)) ∧ (∀(s :ast$shift) (exp2 :α exp) (exp1 :α exp) (ctxt :num sptree$num_map). comp_exp ctxt (Shift s exp1 exp2 :α exp) = (Shift s (comp_exp ctxt exp1) (comp_exp ctxt exp2) :α wordLang$exp)) ∧ ∀(wexps :α exp list) (op :binop) (ctxt :num sptree$num_map). comp_exp ctxt (Op op wexps) = (let (wexps' :α wordLang$exp list) = MAP (λ(a :α exp). comp_exp ctxt a) wexps in Op op wexps')
find_reg_imm_def_typed=(∀(ctxt :num sptree$num_map) (w :α word). find_reg_imm ctxt (Imm w) = Imm w) ∧ ∀(ctxt :num sptree$num_map) (n :num). find_reg_imm ctxt (Reg n :α reg_imm) = (Reg (find_var ctxt n) :α reg_imm)
find_var_def_typed=∀(ctxt :num sptree$num_map) (v :num). find_var ctxt v = case lookup v ctxt of (NONE :num option) => (0 :num) | SOME n => n
fromNumSet_def_typed=∀(t :α sptree$num_map). fromNumSet t = MAP (FST :num # α -> num) (toAList t)
mk_new_cutset_def_typed=∀(ctxt :num sptree$num_map) (l :sptree$num_set). mk_new_cutset ctxt l = insert (0 :num) () (toNumSet (MAP (find_var ctxt) (fromNumSet l)))
toNumSet_def_typed=isEmpty (toNumSet ([] :num list)) ∧ ∀(n :num) (ns :num list). toNumSet (n::ns) = insert n () (toNumSet ns)
make_ctxt_def_typed=(∀(n :num) (l :num sptree$num_map). make_ctxt n ([] :num list) l = l) ∧ ∀(n :num) (x :num) (xs :num list) (l :num sptree$num_map). make_ctxt n (x::xs) l = make_ctxt (n + (2 :num)) xs (insert x n l)
