backend_config_ok_def_typed=∀(asm_conf :α asm_config) (c :config). backend_config_ok asm_conf c ⇔ c.source_conf = prim_src_config ∧ (0 :num) < c.clos_conf.max_app ∧ c.bvl_conf.next_name2 = bvl_num_stubs + (2 :num) ∧ LENGTH asm_conf.avoid_regs + (13 :num) ≤ asm_conf.reg_count ∧ c.lab_conf.pos = (0 :num) ∧ isEmpty c.lab_conf.labels ∧ conf_ok (:α) c.data_conf ∧ (c.data_conf.has_longdiv ⇒ asm_conf.ISA = x86_64) ∧ (c.data_conf.has_div ⇒ asm_conf.ISA = ARMv8 ∨ asm_conf.ISA = MIPS ∨ asm_conf.ISA = RISC_V) ∧ (c.data_conf.has_fp_tern ⇔ asm_conf.ISA = ARMv7 ∧ (2 :num) < asm_conf.fp_reg_count) ∧ (c.data_conf.has_fp_ops ⇔ (1 :num) < asm_conf.fp_reg_count) ∧ max_stack_alloc ≤ (2 :num) * max_heap_limit (:α) c.data_conf − (1 :num) ∧ (c.stack_conf.perf_calls ⇔ F) ∧ addr_offset_ok asm_conf (0w :α word) ∧ hw_offset_ok asm_conf (0w :α word) ∧ (∀(w :α word). -(8w :α word) ≤ w ∧ w ≤ (8w :α word) ⇒ byte_offset_ok asm_conf w) ∧ asm_conf.valid_imm (INL Add :binop + cmp) (8w :α word) ∧ asm_conf.valid_imm (INL Add :binop + cmp) (4w :α word) ∧ asm_conf.valid_imm (INL Add :binop + cmp) (1w :α word) ∧ asm_conf.valid_imm (INL Sub :binop + cmp) (1w :α word) ∧ OPTION_ALL (EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s)) c.lab_conf.ffi_names ∧ find_name c.stack_conf.reg_names PERMUTES 𝕌(:num) ∧ names_ok c.stack_conf.reg_names asm_conf.reg_count asm_conf.avoid_regs ∧ fixed_names c.stack_conf.reg_names asm_conf ∧ (∀(s :store_name). addr_offset_ok asm_conf (store_offset s :α word)) ∧ (∀(s :store_name). hw_offset_ok asm_conf (store_offset s :α word)) ∧ ∀(n :num). n ≤ max_stack_alloc ⇒ asm_conf.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ asm_conf.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)
