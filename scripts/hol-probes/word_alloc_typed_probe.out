canonize_moves_def_typed=∀(ls :(num # num # num) list). canonize_moves ls = (let (can1 :(num # num # num) list) = MAP (λ((p :num),(x :num),(y :num)). if x ≤ y then (p,x,y) else (p,y,x)) ls; (can2 :(num # num # num) list) = sort (λ((p1 :num),(x1 :num),(y1 :num)) ((p2 :num),(x2 :num),(y2 :num)). if x1 = x2 then if y1 = y2 then p1 < p2 else y1 < y2 else x1 < x2) can1 in case can2 of ([] :(num # num # num) list) => ([] :(num # num # num # num) list) | (p,m)::xs => canonize_moves_aux p m (1 :num) xs ([] :(num # num # num # num) list))
canonize_moves_aux_def_typed=(∀(curp :num) (curm :α) (ctr :num) (acc :(num # num # α) list). canonize_moves_aux curp curm ctr ([] :(num # α) list) acc = (ctr,curp,curm)::acc) ∧ ∀(xs :(num # α) list) (p :num) (m :α) (curp :num) (curm :α) (ctr :num) (acc :(num # num # α) list). canonize_moves_aux curp curm ctr ((p,m)::xs) acc = if curm = m then canonize_moves_aux (MAX curp p) m (ctr + (1 :num)) xs acc else canonize_moves_aux p m (1 :num) xs ((ctr,curp,curm)::acc)
get_delta_inst_def_typed=get_delta_inst (Skip :α inst) = Delta ([] :num list) ([] :num list) ∧ get_delta_inst (Const (reg :num) (w :α word) :α inst) = Delta [reg] ([] :num list) ∧ get_delta_inst (Arith (Binop (bop :binop) (r1 :num) (r2 :num) (ri :α reg_imm)) :α inst) = (case ri of (Reg r3 :α reg_imm) => Delta [r1] [r2; r3] | Imm v3 => Delta [r1] [r2]) ∧ get_delta_inst (Arith (Shift (shift :ast$shift) r1 r2 ri :α arith) :α inst) = (case ri of (Reg r3 :α reg_imm) => Delta [r1] [r2; r3] | Imm v3 => Delta [r1] [r2]) ∧ get_delta_inst (Arith (Div r1 r2 (r3 :num) :α arith) :α inst) = Delta [r1] [r3; r2] ∧ get_delta_inst (Arith (AddCarry r1 r2 r3 (r4 :num) :α arith) :α inst) = Delta [r1; r4] [r4; r3; r2] ∧ get_delta_inst (Arith (AddOverflow r1 r2 r3 r4 :α arith) :α inst) = Delta [r1; r4] [r3; r2] ∧ get_delta_inst (Arith (SubOverflow r1 r2 r3 r4 :α arith) :α inst) = Delta [r1; r4] [r3; r2] ∧ get_delta_inst (Arith (LongMul r1 r2 r3 r4 :α arith) :α inst) = Delta [r1; r2] [r4; r3] ∧ get_delta_inst (Arith (LongDiv r1 r2 r3 r4 (r5 :num) :α arith) :α inst) = Delta [r1; r2] [r5; r4; r3] ∧ get_delta_inst (Mem Load (r :num) (Addr (a :num) w)) = Delta [r] [a] ∧ get_delta_inst (Mem Store r (Addr a w)) = Delta ([] :num list) [r; a] ∧ get_delta_inst (Mem Load32 r (Addr a w)) = Delta [r] [a] ∧ get_delta_inst (Mem Store32 r (Addr a w)) = Delta ([] :num list) [r; a] ∧ get_delta_inst (Mem Load8 r (Addr a w)) = Delta [r] [a] ∧ get_delta_inst (Mem Store8 r (Addr a w)) = Delta ([] :num list) [r; a] ∧ get_delta_inst (FP (FPLess r (f1 :num) (f2 :num)) :α inst) = Delta [r] ([] :num list) ∧ get_delta_inst (FP (FPLessEqual r f1 f2) :α inst) = Delta [r] ([] :num list) ∧ get_delta_inst (FP (FPEqual r f1 f2) :α inst) = Delta [r] ([] :num list) ∧ get_delta_inst (FP (FPMovToReg r1 r2 (d :num)) :α inst) = (if dimindex (:α) = (64 :num) then Delta [r1] ([] :num list) else Delta [r1; r2] ([] :num list)) ∧ get_delta_inst (FP (FPMovFromReg d r1 r2) :α inst) = (if dimindex (:α) = (64 :num) then Delta ([] :num l