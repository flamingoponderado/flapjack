priority_def_typed=priority (NONE :(unit + unit) option) (b :bool) = (1 :num) ∧ priority (SOME (INL () :unit + unit)) b = (if b then (2 :num) else (1 :num)) ∧ priority (SOME (INR () :unit + unit)) b = if b then (1 :num) else (2 :num)
force_rename_def_typed=(∀(ssa :α sptree$num_map). force_rename ([] :(num # α) list) ssa = ssa) ∧ ∀(y :α) (xs :(num # α) list) (x :num) (ssa :α sptree$num_map). force_rename ((x,y)::xs) ssa = force_rename xs (insert x y ssa)
list_next_var_rename_move_def_typed=∀(ssa :num sptree$num_map) (n :num) (ls :num list). (list_next_var_rename_move ssa n ls :α prog # num sptree$num_map # num) = (let (cur_ls :num list) = MAP (option_lookup ssa) ls; ((new_ls :num list),(ssa' :num sptree$num_map),(n' :num)) = list_next_var_rename ls ssa n in ((Move0 (ZIP (new_ls,cur_ls)) :α prog),ssa',n'))
loop_setup_def_typed=∀(names :sptree$num_set) (exit_names :sptree$num_set) (ssa :num sptree$num_map) (na :num). (loop_setup names exit_names ssa na :α prog # num sptree$num_map # num) = (let (all_vars_ls :num list) = MAP (FST :num # unit -> num) (toAList (union names exit_names)); (extend_ls :num list) = FILTER (λ(v :num). lookup v ssa = (NONE :num option)) all_vars_ls; (refresh_ls :num list) = FILTER (λ(v :num). IS_SOME (lookup v ssa)) all_vars_ls; ((fresh_pos_ls :num list),(ssa_ext :num sptree$num_map),(na_ext :num)) = list_next_var_rename extend_ls ssa na; (fake_prog :α prog) = FOLDR (Seq :α prog -> α prog -> α prog) (Skip :α prog) (MAP (λ(r :num). (fake_move r :α prog)) fresh_pos_ls); ((refresh_mov :α prog),(ssa_refreshed :num sptree$num_map),(na_refreshed :num)) = (list_next_var_rename_move ssa_ext na_ext refresh_ls :α prog # num sptree$num_map # num) in (Seq fake_prog refresh_mov,ssa_refreshed,na_refreshed))
mk_prio_def_typed=∀(el :α prog) (er :β prog). mk_prio el er = if el = (Skip :α prog) then SOME (INL () :unit + unit) else if er = (Skip :β prog) then SOME (INR () :unit + unit) else (NONE :(unit + unit) option)
ssa_reconcile_def_typed=∀(cur_ssa :num sptree$num_map) (tgt_ssa :num sptree$num_map) (ns :β sptree$num_map). (ssa_reconcile cur_ssa tgt_ssa ns :α prog) = (let (vars :num list) = MAP (FST :num # β -> num) (toAList ns); (moves :(num # num) list) = FILTER (λ((a :num),(b :num)). a ≠ b) (FLAT (MAP (λ(v :num). case lookup v cur_ssa of (NONE :num option) => ([] :(num # num) list) | SOME cur_v => [(option_lookup tgt_ssa v,cur_v)]) vars)) in if moves = ([] :(num # num) list) then (Skip :α prog) else (Move1 moves :α prog))
merge_moves_def_typed=(∀(ssa_L :num sptree$num_map) (ssa_R :num sptree$num_map) (na :num). merge_moves ([] :num list) ssa_L ssa_R na = (([] :(num # num) list),([] :(num # num) list),na,ssa_L,ssa_R)) ∧ ∀(x :num) (xs :num list) (ssa_L :num sptree$num_map) (ssa_R :num sptree$num_map) (na :num). merge_moves (x::xs) ssa_L ssa_R na = (let ((seqL :(num # num) list),(seqR :(num # num) list),(na' :num),(ssa_L' :num sptree$num_map),(ssa_R' :num sptree$num_map)) = merge_moves xs ssa_L ssa_R na; (optLx :num option) = lookup x ssa_L'; (optLy :num option) = lookup x ssa_R' in case (optLx,optLy) of ((NONE :num option),v3) => (seqL,seqR,na',ssa_L',ssa_R') | (SOME Lx,(NONE :num option)) => (seqL,seqR,na',ssa_L',ssa_R') | (SOME Lx,SOME Ly) => if Lx = Ly then (seqL,seqR,na',ssa_L',ssa_R') else (let (Lmove :num # num) = (na',Lx); (Rmove :num # num) = (na',Ly) in (Lmove::seqL,Rmove::seqR,na' + (4 :num),insert x na' ssa_L',insert x na' ssa_R')))
even_list_def_typed=even_list = GENLIST (λ(x :num). (2 :num) * x)
