ssa_cc_trans_exp_def_typed=(∀(t :num sptree$num_map) (num :num). ssa_cc_trans_exp t (Var num :α exp) = (Var (option_lookup t num) :α exp)) ∧ (∀(t :num sptree$num_map) (exp :α exp). ssa_cc_trans_exp t (Load exp :α exp) = (Load (ssa_cc_trans_exp t exp) :α exp)) ∧ (∀(wop :binop) (t :num sptree$num_map) (ls :α exp list). ssa_cc_trans_exp t (Op wop ls) = Op wop (MAP (λ(a :α exp). ssa_cc_trans_exp t a) ls)) ∧ (∀(t :num sptree$num_map) (sh :ast$shift) (nexp :α exp) (exp :α exp). ssa_cc_trans_exp t (Shift sh exp nexp :α exp) = (Shift sh (ssa_cc_trans_exp t exp) (ssa_cc_trans_exp t nexp) :α exp)) ∧ (∀(v2 :α word) (t :num sptree$num_map). ssa_cc_trans_exp t (Const v2 :α exp) = (Const v2 :α exp)) ∧ ∀(v4 :store_name) (t :num sptree$num_map). ssa_cc_trans_exp t (Lookup v4 :α exp) = (Lookup v4 :α exp)
ssa_cc_trans_inst_def_typed=ssa_cc_trans_inst (Skip :α inst) (ssa :num sptree$num_map) (na :num) = ((Skip :α prog),ssa,na) ∧ ssa_cc_trans_inst (Const (reg :num) (w :α word) :α inst) ssa na = (let ((reg' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename reg ssa na in ((Inst (Const reg' w :α inst) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (Arith (Binop (bop :binop) (r1 :num) (r2 :num) (ri :α reg_imm)) :α inst) ssa na = (case ri of (Reg r3 :α reg_imm) => (let (r3' :num) = option_lookup ssa r3; (r2' :num) = option_lookup ssa r2; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na in ((Inst (Arith (Binop bop r1' r2' (Reg r3' :α reg_imm)) :α inst) :α prog),ssa',na')) | Imm v3 => (let (r2' :num) = option_lookup ssa r2; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na in ((Inst (Arith (Binop bop r1' r2' ri) :α inst) :α prog),ssa',na'))) ∧ ssa_cc_trans_inst (Arith (Shift (shift :ast$shift) r1 r2 ri :α arith) :α inst) ssa na = (case ri of (Reg r3 :α reg_imm) => (let (r3' :num) = option_lookup ssa r3; (r2' :num) = option_lookup ssa r2; (mov_in :α prog) = (Move1 [((8 :num),r3')] :α prog); ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na in (Seq mov_in (Inst (Arith (Shift shift r1' r2' (Reg (8 :num) :α reg_imm) :α arith) :α inst) :α prog),ssa',na')) | Imm v3 => (let (r2' :num) = option_lookup ssa r2; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na in ((Inst (Arith (Shift shift r1' r2' ri :α arith) :α inst) :α prog),ssa',na'))) ∧ ssa_cc_trans_inst (Arith (Div r1 r2 (r3 :num) :α arith) :α inst) ssa na = (let (r2' :num) = option_lookup ssa r2; (r3' :num) = option_lookup ssa r3; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na in ((Inst (Arith (Div r1' r2' r3' :α arith) :α inst) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (Arith (AddCarry r1 r2 r3 (r4 :num) :α arith) :α inst) ssa na = (let (r2' :num) = option_lookup ssa r2; (r3' :num) = option_lookup ssa r3; (r4' :num) = option_lookup ssa r4; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na; (mov_in :α prog) = (Move1 [((0 :num),r4')] :α prog); ((r4'' :num),(ssa'' :num sptree$num_map),(na'' :num)) = next_var_rename r4 ssa' na'; (mov_out :α prog) = (Move1 [(r4'',(0 :num))] :α prog) in (Seq mov_in (Seq (Inst (Arith (AddCarry r1' r2' r3' (0 :num) :α arith) :α inst) :α prog) mov_out),ssa'',na'')) ∧ ssa_cc_trans_inst (Arith (AddOverflow r1 r2 r3 r4 :α arith) :α inst) ssa na = (let (r2' :num) = option_lookup ssa r2; (r3' :num) = option_lookup ssa r3; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na; ((r4'' :num),(ssa'' :num sptree$num_map),(na'' :num)) = next_var_rename r4 ssa' na'; (mov_out :α prog) = (Move1 [(r4'',(0 :num))] :α prog) in (Seq (Inst (Arith (AddOverflow r1' r2' r3' (0 :num) :α arith) :α inst) :α prog) mov_out,ssa'',na'')) ∧ ssa_cc_trans_inst (Arith (SubOverflow r1 r2 r3 r4 :α arith) :α inst) ssa na = (let (r2' :num) = option_lookup ssa r2; (r3' :num) = option_lookup ssa r3; ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na; ((r4'' :num),(ssa'' :num sptree$num_map),(na'' :num)) = next_var_rename r4 ssa' na'; (mov_out :α prog) = (Move1 [(r4'',(0 :num))] :α prog) in (Seq (Inst (Arith (SubOverflow r1' r2' r3' (0 :num) :α arith) :α inst) :α prog) mov_out,ssa'',na'')) ∧ ssa_cc_trans_inst (Arith (LongMul r1 r2 r3 r4 :α arith) :α inst) ssa na = (let (r3' :num) = option_lookup ssa r3; (r4' :num) = option_lookup ssa r4; (mov_in :α prog) = (Move1 [((0 :num),r3'); ((4 :num),r4')] :α prog); ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na; ((r2' :num),(ssa'' :num sptree$num_map),(na'' :num)) = next_var_rename r2 ssa' na'; (mov_out :α prog) = (Move1 [(r2',(0 :num)); (r1',(6 :num))] :α prog) in (Seq mov_in (Seq (Inst (Arith (LongMul (6 :num) (0 :num) (0 :num) (4 :num) :α arith) :α inst) :α prog) mov_out),ssa'',na'')) ∧ ssa_cc_trans_inst (Arith (LongDiv r1 r2 r3 r4 (r5 :num) :α arith) :α inst) ssa na = (let (r3' :num) = option_lookup ssa r3; (r4' :num) = option_lookup ssa r4; (r5' :num) = option_lookup ssa r5; (mov_in :α prog) = (Move1 [((6 :num),r3'); ((0 :num),r4')] :α prog); ((r2' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r2 ssa na; ((r1' :num),(ssa'' :num sptree$num_map),(na'' :num)) = next_var_rename r1 ssa' na'; (mov_out :α prog) = (Move1 [(r2',(6 :num)); (r1',(0 :num))] :α prog) in (Seq mov_in (Seq (Inst (Arith (LongDiv (0 :num) (6 :num) (6 :num) (0 :num) r5' :α arith) :α inst) :α prog) mov_out),ssa'',na'')) ∧ ssa_cc_trans_inst (Mem Load (r :num) (Addr (a :num) w)) ssa na = (let (a' :num) = option_lookup ssa a; ((r' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r ssa na in ((Inst (Mem Load r' (Addr a' w)) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (Mem Store r (Addr a w)) ssa na = (let (a' :num) = option_lookup ssa a; (r' :num) = option_lookup ssa r in ((Inst (Mem Store r' (Addr a' w)) :α prog),ssa,na)) ∧ ssa_cc_trans_inst (Mem Load32 r (Addr a w)) ssa na = (let (a' :num) = option_lookup ssa a; ((r' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r ssa na in ((Inst (Mem Load32 r' (Addr a' w)) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (Mem Store32 r (Addr a w)) ssa na = (let (a' :num) = option_lookup ssa a; (r' :num) = option_lookup ssa r in ((Inst (Mem Store32 r' (Addr a' w)) :α prog),ssa,na)) ∧ ssa_cc_trans_inst (Mem Load8 r (Addr a w)) ssa na = (let (a' :num) = option_lookup ssa a; ((r' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r ssa na in ((Inst (Mem Load8 r' (Addr a' w)) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (Mem Store8 r (Addr a w)) ssa na = (let (a' :num) = option_lookup ssa a; (r' :num) = option_lookup ssa r in ((Inst (Mem Store8 r' (Addr a' w)) :α prog),ssa,na)) ∧ ssa_cc_trans_inst (FP (FPLess r (f1 :num) (f2 :num)) :α inst) ssa na = (let ((r' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r ssa na in ((Inst (FP (FPLess r' f1 f2) :α inst) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (FP (FPLessEqual r f1 f2) :α inst) ssa na = (let ((r' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r ssa na in ((Inst (FP (FPLessEqual r' f1 f2) :α inst) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (FP (FPEqual r f1 f2) :α inst) ssa na = (let ((r' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r ssa na in ((Inst (FP (FPEqual r' f1 f2) :α inst) :α prog),ssa',na')) ∧ ssa_cc_trans_inst (FP (FPMovToReg r1 r2 (d :num)) :α inst) ssa na = (if dimindex (:α) = (64 :num) then (let ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na in ((Inst (FP (FPMovToReg r1' r2 d) :α inst) :α prog),ssa',na')) else (let ((r1' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r1 ssa na; ((r2' :num),(ssa'' :num sptree$num_map),(na'' :num)) = next_var_rename r2 ssa' na' in ((Inst (FP (FPMovToReg r1' r2' d) :α inst) :α prog),ssa'',na''))) ∧ ssa_cc_trans_inst (FP (FPMovFromReg d r1 r2) :α inst) ssa na = (if dimindex (:α) = (64 :num) then (let (r1' :num) = option_lookup ssa r1 in ((Inst (FP (FPMovFromReg d r1' (0 :num)) :α inst) :α prog),ssa,na)) else (let (r1' :num) = option_lookup ssa r1; (r2' :num) = option_lookup ssa r2 in if r1' = r2' then (let ((r2'' :num),(ssa' :num sptree$num_map),(na' :num)) = next_var_rename r2 ssa na; (mov_in :α prog) = (Move0 [(r2'',r2')] :α prog) in (Seq mov_in (Inst (FP (FPMovFromReg d r1' r2'') :α inst) :α prog),ssa',na')) else ((Inst (FP (FPMovFromReg d r1' r2') :α inst) :α prog),ssa,na))) ∧ ssa_cc_trans_inst (Mem Load16 (v9 :num) (Addr (v83 :num) (v84 :α word))) ssa na = ((Inst (Mem Load16 v9 (Addr v83 v84)) :α prog),ssa,na) ∧ ssa_cc_trans_inst (Mem Store16 v9 (Addr v83 v84)) ssa na = ((Inst (Mem Store16 v9 (Addr v83 v84)) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPAbs (v96 :num) (v97 :num)) :α inst) ssa na = ((Inst (FP (FPAbs v96 v97) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPNeg (v98 :num) (v99 :num)) :α inst) ssa na = ((Inst (FP (FPNeg v98 v99) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPSqrt (v100 :num) (v101 :num)) :α inst) ssa na = ((Inst (FP (FPSqrt v100 v101) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPAdd (v102 :num) (v103 :num) (v104 :num)) :α inst) ssa na = ((Inst (FP (FPAdd v102 v103 v104) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPSub (v105 :num) (v106 :num) (v107 :num)) :α inst) ssa na = ((Inst (FP (FPSub v105 v106 v107) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPMul (v108 :num) (v109 :num) (v110 :num)) :α inst) ssa na = ((Inst (FP (FPMul v108 v109 v110) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPDiv (v111 :num) (v112 :num) (v113 :num)) :α inst) ssa na = ((Inst (FP (FPDiv v111 v112 v113) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPFma (v114 :num) (v115 :num) (v116 :num)) :α inst) ssa na = ((Inst (FP (FPFma v114 v115 v116) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPMov (v117 :num) (v118 :num)) :α inst) ssa na = ((Inst (FP (FPMov v117 v118) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPToInt (v125 :num) (v126 :num)) :α inst) ssa na = ((Inst (FP (FPToInt v125 v126) :α inst) :α prog),ssa,na) ∧ ssa_cc_trans_inst (FP (FPFromInt (v127 :num) (v128 :num)) :α inst) ssa na = ((Inst (FP (FPFromInt v127 v128) :α inst) :α prog),ssa,na)
select_reg_alloc_def_typed=∀(alg :num) (spillcosts :num sptree$num_map option) (k :num) (heu_moves :(num # num # num) list) (tree :clash_tree) (forced :(num # num) list) (fs :sptree$num_set). select_reg_alloc alg spillcosts k heu_moves tree forced fs = if (4 :num) ≤ alg then linear_scan_reg_alloc k heu_moves tree forced else reg_alloc (if alg ≤ (1 :num) then Simple else IRC) spillcosts k heu_moves tree forced fs
merge_stack_only_def_typed=∀(x :num) (y :num) (ts :sptree$num_set) (fs :sptree$num_set). merge_stack_only (x,y) (ts,fs) = if lookup x ts = SOME () then (let (ts :sptree$num_set) = if is_alloc_var y then insert y () ts else ts; (fs :sptree$num_set) = if is_phy_var y then fs else insert x () fs in (ts,fs)) else if is_stack_var x then (let (ts :sptree$num_set) = if is_alloc_var y then insert y () ts else ts in (ts,fs)) else (delete y ts,fs)
remove_temp_stack_def_typed=∀(ls :num list) (ts :α sptree$num_map) (fs :β). remove_temp_stack ls (ts,fs) = (FOLDR (delete :num -> α sptree$num_map -> α sptree$num_map) ts ls,fs)
total_colour_def_typed=∀(col :num sptree$num_map) (x :num). total_colour col x = case lookup x col of (NONE :num option) => if is_phy_var x then x else (0 :num) | SOME v => (2 :num) * v
total_colour_alt_typed=total_colour (col :num sptree$num_map) = (λ(x :num). (2 :num) * x) ∘ sp_default col
word_alloc_def_typed=∀(fc :num) (c :α asm_config) (alg :num) (k :num) (prog :α prog) (col_opt :num sptree$num_map option). word_alloc fc c alg k prog col_opt = (let (tree :clash_tree) = get_clash_tree prog ([] :(sptree$num_set # sptree$num_set) list); (fs :sptree$num_set) = get_stack_only prog; (forced :(num # num) list) = get_forced c prog ([] :(num # num) list) in case oracle_colour_ok k col_opt tree prog forced of (NONE :α prog option) => (let ((heu_moves :(num # num # num) list),(spillcosts :num sptree$num_map option)) = get_heuristics alg fc prog in case select_reg_alloc alg spillcosts k heu_moves tree forced fs of (M_success col :(num sptree$num_map, state_exn) exc) => apply_colour (total_colour col) prog | (M_failure v1 :(num sptree$num_map, state_exn) exc) => prog) | SOME col_prog => col_prog)
