OME live_set) ret_tree handler_tree :clash_tree))))
get_coalescecost_def_typed=∀(spillcost :α sptree$num_map) (n :num) (p :num) (x :num) (y :num). get_coalescecost spillcost (n,p,x,y) = (let (xcost :num) = if lookup x spillcost = (NONE :α option) then (0 :num) else (1 :num); (ycost :num) = if lookup y spillcost = (NONE :α option) then (0 :num) else (1 :num) in (n * ((10 :num) * (p + (1 :num)) + xcost + ycost),x,y))
apply_colour_def_typed=(∀(f :num -> num). apply_colour f (Skip :α prog) = (Skip :α prog)) ∧ (∀(pri :num) (ls :(num # num) list) (f :num -> num). apply_colour f (Move pri ls :α prog) = (Move pri (ZIP (MAP (f ∘ (FST :num # num -> num)) ls,MAP (f ∘ (SND :num # num -> num)) ls)) :α prog)) ∧ (∀(i :α inst) (f :num -> num). apply_colour f (Inst i :α prog) = (Inst (apply_colour_inst f i) :α prog)) ∧ (∀(num :num) (f :num -> num) (exp :α exp). apply_colour f (Assign num exp) = Assign (f num) (apply_colour_exp f exp)) ∧ (∀(store :store_name) (num :num) (f :num -> num). apply_colour f (Get num store :α prog) = (Get (f num) store :α prog)) ∧ (∀(num :num) (f :num -> num) (exp :α exp). apply_colour f (Store exp num :α prog) = (Store (apply_colour_exp f exp) (f num) :α prog)) ∧ (∀(ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (h :(num # α prog # num # num) option) (f :num -> num) (dest :num option) (args :num list). apply_colour f (Call ret dest args h :α prog) = (let (ret' :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) = case ret of (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) => (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) | SOME (vs,cutset,ret_handler,l1,l2) => SOME (MAP f vs,apply_nummaps_key f cutset,apply_colour f ret_handler,l1,l2); (args' :num list) = MAP f args; (h' :(num # α prog # num # num) option) = case h of (NONE :(num # α prog # num # num) option) => (NONE :(num # α prog # num # num) option) | SOME (v,prog,l1,l2) => SOME (f v,apply_colour f prog,l1,l2) in (Call ret' dest args' h' :α prog))) ∧ (∀(s2 :α prog) (s1 :α prog) (f :num -> num). apply_colour f (Seq s1 s2) = Seq (apply_colour f s1) (apply_colour f s2)) ∧ (∀(s1 :α prog) (f :num -> num). apply_colour f (MustTerminate s1) = MustTerminate (apply_colour f s1)) ∧ (∀(ri :α reg_imm) (r1 :num) (f :num -> num) (e3 :α prog) (e2 :α prog) (cmp :cmp). apply_colour f (If cmp r1 ri e2 e