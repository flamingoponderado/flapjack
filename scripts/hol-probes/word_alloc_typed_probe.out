get_clash_tree_def_typed=(∀(lt :(sptree$num_set # sptree$num_set) list). get_clash_tree (Skip :α prog) lt = Delta ([] :num list) ([] :num list)) ∧ (∀(pri :num) (lt :(sptree$num_set # sptree$num_set) list) (ls :(num # num) list). get_clash_tree (Move pri ls :α prog) lt = Delta (MAP (FST :num # num -> num) ls) (MAP (SND :num # num -> num) ls)) ∧ (∀(lt :(sptree$num_set # sptree$num_set) list) (i :α inst). get_clash_tree (Inst i :α prog) lt = get_delta_inst i) ∧ (∀(num :num) (lt :(sptree$num_set # sptree$num_set) list) (exp :α exp). get_clash_tree (Assign num exp) lt = Delta [num] (get_reads_exp exp)) ∧ (∀(store :store_name) (num :num) (lt :(sptree$num_set # sptree$num_set) list). get_clash_tree (Get num store :α prog) lt = Delta [num] ([] :num list)) ∧ (∀(num :num) (lt :(sptree$num_set # sptree$num_set) list) (exp :α exp). get_clash_tree (Store exp num :α prog) lt = Delta ([] :num list) (num::get_reads_exp exp)) ∧ (∀(s2 :α prog) (s1 :α prog) (lt :(sptree$num_set # sptree$num_set) list). get_clash_tree (Seq s1 s2) lt = Seq (get_clash_tree s1 lt) (get_clash_tree s2 lt)) ∧ (∀(ri :α reg_imm) (r1 :num) (lt :(sptree$num_set # sptree$num_set) list) (e3 :α prog) (e2 :α prog) (cmp :cmp). get_clash_tree (If cmp r1 ri e2 e3 :α prog) lt = (let (e2t :clash_tree) = get_clash_tree e2 lt; (e3t :clash_tree) = get_clash_tree e3 lt in case ri of (Reg r2 :α reg_imm) => Seq (Delta ([] :num list) [r1; r2]) (Branch (NONE :sptree$num_set option) e2t e3t :clash_tree) | Imm v3 => Seq (Delta ([] :num list) [r1]) (Branch (NONE :sptree$num_set option) e2t e3t :clash_tree))) ∧ (∀(s :α prog) (lt :(sptree$num_set # sptree$num_set) list). get_clash_tree (MustTerminate s) lt = get_clash_tree s lt) ∧ (∀(numset :sptree$num_set # sptree$num_set) (num :num) (lt :(sptree$num_set # sptree$num_set) list). get_clash_tree (Alloc num numset :α prog) lt = Seq (Delta ([] :num list) [num]) (Set (union (FST numset) (SND numset)) :clash_tree)) ∧ (∀(r4 :num) (r3 :num) (r2 :num) (r1 :num) (numset :sptree$num_set # sptr