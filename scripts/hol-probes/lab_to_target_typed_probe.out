upd_lab_len_def_typed=(∀(pos :num). upd_lab_len pos ([] :α sec list) = ([] :α sec list)) ∧ ∀(s :num) (rest :α sec list) (pos :num) (lines :α line list). upd_lab_len pos (Section s lines::rest) = (let ((lines1 :α line list),(pos1 :num)) = lines_upd_lab_len pos lines ([] :α line list); (rest1 :α sec list) = upd_lab_len pos1 rest in Section s lines1::rest1)
