find_ffi_names_def_typed=find_ffi_names ([] :α sec list) = ([] :ffiname list) ∧ (∀(rest :α sec list) (k :num). find_ffi_names (Section k ([] :α line list)::rest) = find_ffi_names rest) ∧ ∀(xs :α line list) (x :α line) (rest :α sec list) (k :num). find_ffi_names (Section k (x::xs)::rest) = case x of (Label v10 v11 v12 :α line) => find_ffi_names (Section k xs::rest) | Asm v13 v14 v15 => find_ffi_names (Section k xs::rest) | LabAsm (Jump v29 :α asm_with_lab) v17 v18 v19 => find_ffi_names (Section k xs::rest) | LabAsm (JumpCmp v30 v31 v32 v33 :α asm_with_lab) v17 v18 v19 => find_ffi_names (Section k xs::rest) | LabAsm (Call v34 :α asm_with_lab) v17 v18 v19 => find_ffi_names (Section k xs::rest) | LabAsm (LocValue v35 v36 :α asm_with_lab) v17 v18 v19 => find_ffi_names (Section k xs::rest) | LabAsm (CallFFI s :α asm_with_lab) v17 v18 v19 => list_add_if_fresh (ExtCall s) (find_ffi_names (Section k xs::rest)) | LabAsm (Install :α asm_with_lab) v17 v18 v19 => find_ffi_names (Section k xs::rest) | LabAsm (Halt :α asm_with_lab) v17 v18 v19 => find_ffi_names (Section k xs::rest)
get_memop_info_def_typed=get_memop_info Load = (MappedRead,(0w :word8)) ∧ get_memop_info Load32 = (MappedRead,(4w :word8)) ∧ get_memop_info Load16 = (MappedRead,(2w :word8)) ∧ get_memop_info Load8 = (MappedRead,(1w :word8)) ∧ get_memop_info Store = (MappedWrite,(0w :word8)) ∧ get_memop_info Store32 = (MappedWrite,(4w :word8)) ∧ get_memop_info Store16 = (MappedWrite,(2w :word8)) ∧ get_memop_info Store8 = (MappedWrite,(1w :word8))
get_shmem_info_def_typed=(∀(shmem_info :shmem_info_num list) (pos :num) (ffi_names :ffiname list). get_shmem_info ([] :α sec list) pos ffi_names shmem_info = (ffi_names,shmem_info)) ∧ (∀(shmem_info :shmem_info_num list) (rest :α sec list) (pos :num) (k :num) (ffi_names :ffiname list). get_shmem_info (Section k ([] :α line list)::rest) pos ffi_names shmem_info = get_shmem_info rest pos ffi_names shmem_info) ∧ (∀(xs :α line list) (v2 :num) (v1 :num) (v0 :num) (shmem_info :shmem_info_num list) (rest :α sec list) (pos :num) (k :num) (ffi_names :ffiname list). get_shmem_info (Section k ((Label v0 v1 v2 :α line)::xs)::rest) pos ffi_names shmem_info = get_shmem_info (Section k xs::rest) pos ffi_names shmem_info) ∧ (∀(xs :α line list) (v3 :num) (shmem_info :shmem_info_num list) (rest :α sec list) (r :num) (pos :num) (m :memop) (k :num) (ffi_names :ffiname list) (bytes :word8 list) (ad :α addr). get_shmem_info (Section k (Asm (ShareMem m r ad) bytes v3::xs)::rest) pos ffi_names shmem_info = (let ((name :shmem_op),(nb :word8)) = get_memop_info m in get_shmem_info (Section k xs::rest) (pos + LENGTH bytes) (ffi_names ++ [SharedMem name]) (shmem_info ++ [<|entry_pc := pos; nbytes := nb; addr_reg := case ad of Addr r off => r; addr_off := case ad of Addr r off => w2n off; reg := r; exit_pc := pos + LENGTH bytes|>]))) ∧ (∀(xs :α line list) (v6 :num) (v5 :α word) (v4 :α asm_with_lab) (shmem_info :shmem_info_num list) (rest :α sec list) (pos :num) (k :num) (ffi_names :ffiname list) (bytes :word8 list). get_shmem_info (Section k (LabAsm v4 v5 bytes v6::xs)::rest) pos ffi_names shmem_info = get_shmem_info (Section k xs::rest) (pos + LENGTH bytes) ffi_names shmem_info) ∧ (∀(xs :α line list) (v8 :num) (v30 :α asm) (shmem_info :shmem_info_num list) (rest :α sec list) (pos :num) (k :num) (ffi_names :ffiname list) (bytes :word8 list). get_shmem_info (Section k (Asm (Asmi v30) bytes v8::xs)::rest) pos ffi_names shmem_info = get_shmem_info (Section k xs::rest) (pos + LENGTH bytes) ffi_names shmem_info) ∧ ∀(xs :α line list) (v8 :num) (v32 :num) (v31 :num) (shmem_info :shmem_info_num list) (rest :α sec list) (pos :num) (k :num) (ffi_names :ffiname list) (bytes :word8 list). get_shmem_info (Section k (Asm (Cbw v31 v32 :α asm_or_cbw) bytes v8::xs)::rest) pos ffi_names shmem_info = get_shmem_info (Section k xs::rest) (pos + LENGTH bytes) ffi_names shmem_info
list_add_if_fresh_def_typed=(∀(e :α). list_add_if_fresh e ([] :α list) = [e]) ∧ ∀(e :α) (f :α) (r :α list). list_add_if_fresh e (f::r) = if e = f then f::r else f::list_add_if_fresh e r
