load "bossLib"; load "preamble"; load "parmoveTheory"; open bossLib HolKernel Parse preamble parmoveTheory;
fun observe label term = let val th = EVAL term in print (label ^ "="); print_term (rhs (concl th)); print "\n" end;
val _ = observe "pts_remove" ``parmove$wf (([(SOME 1,SOME 1)],[],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([] ++ []))``;
val _ = observe "pts_start" ``parmove$wf (([(SOME 1,SOME 2)],[],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2)] ++ []))``;
val _ = observe "pts_extend" ``parmove$wf (([(SOME 3,SOME 1)],[(SOME 1,SOME 2)],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2)] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([(SOME 3,SOME 1);(SOME 1,SOME 2)] ++ []))``;
val _ = observe "pts_save_cycle" ``parmove$wf (([],[(SOME 1,SOME 2);(SOME 2,SOME 1)],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2);(SOME 2,SOME 1)] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2);(SOME 2,NONE)] ++ [(NONE,SOME 1)]))``;
val _ = observe "pts_emit_head" ``parmove$wf (([],[(SOME 3,SOME 1);(SOME 1,SOME 2)],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([(SOME 3,SOME 1);(SOME 1,SOME 2)] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2)] ++ [(SOME 3,SOME 1)]))``;
val _ = observe "pts_emit_last" ``parmove$wf (([],[(SOME 1,SOME 2)],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2)] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([] ++ [(SOME 1,SOME 2)]))``;
val _ = observe "pts_save_none" ``parmove$wf (([],[(SOME 1,NONE)],[(NONE,SOME 2)]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,NONE)] ++ [(NONE,SOME 2)])) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,NONE)] ++ [(NONE,NONE);(NONE,SOME 2)]))``;
val _ = observe "pts_emit_scratch" ``parmove$wf (([],[(SOME 1,SOME 2);(SOME 2,NONE)],[(NONE,SOME 1)]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) ∧ not_use_temp_before_assign (REVERSE ([(SOME 1,SOME 2);(SOME 2,NONE)] ++ [(NONE,SOME 1)])) ∧ not_use_temp_before_assign (REVERSE ([(SOME 2,NONE)] ++ [(SOME 1,SOME 2);(NONE,SOME 1)]))``;
val _ = observe "pts_bool" ``parmove$wf (([(SOME T,SOME T)],[],[]) : (bool option # bool option) list # (bool option # bool option) list # (bool option # bool option) list) ∧ not_use_temp_before_assign (REVERSE ([] ++ [])) ∧ not_use_temp_before_assign (REVERSE ([] ++ []))``;
