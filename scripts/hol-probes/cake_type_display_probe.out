get_tyname=⊢ (∀(n :num). get_tyname n (Bind ([] :(mlstring # α # t) list) ([] :(mlstring # (mlstring, mlstring, α # t) namespace) list)) = (NONE :mlstring option)) ∧ (∀(ys :(mlstring, mlstring, α # t) namespace) (xs :(mlstring # (mlstring, mlstring, α # t) namespace) list) (n :num) (m :mlstring). get_tyname n (Bind ([] :(mlstring # α # t) list) ((m,ys)::xs)) = case get_tyname n ys of (NONE :mlstring option) => get_tyname n (Bind ([] :(mlstring # α # t) list) xs) | SOME x => SOME (m ^ «.» ^ x)) ∧ ∀(xs :(mlstring # α # t) list) (v0 :α) (tyname :mlstring) (t :t) (n :num) (m :(mlstring # (mlstring, mlstring, α # t) namespace) list). get_tyname n (Bind ((tyname,v0,t)::xs) m) = if case t of Tvar v4 => F | Tvar_db v5 => F | Tapp v6 m => m = n then SOME tyname else get_tyname n (Bind xs m)
type_ident=⊢ ∀(tys :(mlstring, mlstring, α # t) namespace) (ti :num). type_ident_to_string tys ti = if ti = Tarray_num then «Array.array» else if ti = Tbool_num then «bool» else if ti = Tchar_num then «char» else if ti = Texn_num then «exn» else if ti = Tint_num then «int» else if ti = Tlist_num then «list» else if ti = Tref_num then «ref» else if ti = Tstring_num then «string» else if ti = Tvector_num then «Vector.vector» else if ti = Tword64_num then «Word64.word» else if ti = Tword8_num then «Word8.word» else if ti = Tword8array_num then «byte_array» else if ti = Tdouble_num then «Double.double» else case get_tyname ti tys of (NONE :mlstring option) => (toString ((&ti) :int) :mlstring) | SOME s => s
var_name=⊢ ∀(n :num). ty_var_name n = if n < (28 :num) then implode (STRCAT "'" (STRING (CHR (n + ORD #"a")) ("" :string))) else concat [«'»; (toString ((&n) :int) :mlstring)]
parentheses=⊢ ∀(threshold :num) (x :mlstring) (n :num). add_parens threshold (x,n) = if threshold < n then concat [«(»; x; «)»] else x
type_render=⊢ (∀(tys :(mlstring, mlstring, α # t) namespace) (n :num). inf_type_to_string_rec tys (Infer_Tuvar n) = (concat [«_»; (toString ((&n) :int) :mlstring)],(0 :num))) ∧ (∀(tys :(mlstring, mlstring, α # t) namespace) (n :num). inf_type_to_string_rec tys (Infer_Tvar_db n) = (concat [ty_var_name n],(0 :num))) ∧ (∀(tys :(mlstring, mlstring, α # t) namespace) (ts :infer_t list) (ti :num). inf_type_to_string_rec tys (Infer_Tapp ts ti) = if ti = Tfn_num then case ts of ([] :infer_t list) => («<bad function type>»,(0 :num)) | [t1] => («<bad function type>»,(0 :num)) | [t1; t2] => (concat [add_parens (2 :num) (inf_type_to_string_rec tys t1); « -> »; add_parens (3 :num) (inf_type_to_string_rec tys t2)],(3 :num)) | t1::t2::v10::v11 => («<bad function type>»,(0 :num)) else if ti = Ttup_num then case ts of ([] :infer_t list) => («unit»,(0 :num)) | [t] => inf_type_to_string_rec tys t | t::v6::v7 => (concat (commas « * » (MAP (add_parens (1 :num)) (inf_type_to_string_rec_list tys ts))),(2 :num)) else case ts of ([] :infer_t list) => (type_ident_to_string tys ti,(0 :num)) | [t] => (concat [add_parens (1 :num) (inf_type_to_string_rec tys t); « »; type_ident_to_string tys ti],(1 :num)) | t::v6::v7 => (concat ([«(»] ++ commas «, » (MAP (add_parens (5 :num)) (inf_type_to_string_rec_list tys ts)) ++ [«) »; type_ident_to_string tys ti]),(1 :num))) ∧ (∀(tys :(mlstring, mlstring, α # t) namespace). inf_type_to_string_rec_list tys ([] :infer_t list) = ([] :(mlstring # num) list)) ∧ ∀(tys :(mlstring, mlstring, α # t) namespace) (ts :infer_t list) (t :infer_t). inf_type_to_string_rec_list tys (t::ts) = inf_type_to_string_rec tys t::inf_type_to_string_rec_list tys ts
type_render_final=⊢ ∀(tys :(mlstring, mlstring, α # t) namespace) (t :infer_t). inf_type_to_string tys t = FST (inf_type_to_string_rec tys t)
alist_nub=⊢ alist_nub ([] :(α # β) list) = ([] :(α # β) list) ∧ ∀(y :β) (xs :(α # β) list) (x :α). alist_nub ((x,y)::xs) = (x,y)::alist_nub (FILTER (λ(t :α # β). x ≠ FST t) xs)
ns_nub=⊢ (∀(ys :(α # (α, β, γ) namespace) list) (xs :(β # γ) list). ns_nub (Bind xs ys) = Bind (alist_nub xs) (alist_nub (inner_ns_nubs ys))) ∧ inner_ns_nubs ([] :(α # (α, β, γ) namespace) list) = ([] :(α # (α, β, γ) namespace) list) ∧ ∀(y :(α, β, γ) namespace) (x :α) (tl :(α # (α, β, γ) namespace) list). inner_ns_nubs ((x,y)::tl) = (x,ns_nub y)::inner_ns_nubs tl
ns_alist=⊢ ns_to_alist (Bind ([] :(mlstring # α) list) ([] :(mlstring # (mlstring, mlstring, α) namespace) list)) = ([] :(mlstring # α) list) ∧ (∀(x :(mlstring, mlstring, α) namespace) (n :mlstring) (ms :(mlstring # (mlstring, mlstring, α) namespace) list). ns_to_alist (Bind ([] :(mlstring # α) list) ((n,x)::ms)) = MAP (λ((x' :mlstring),(y :α)). (n ^ «.» ^ x',y)) (ns_to_alist x) ++ ns_to_alist (Bind ([] :(mlstring # α) list) ms)) ∧ ∀(xs :(mlstring # α) list) (x :α) (s :mlstring) (m :(mlstring # (mlstring, mlstring, α) namespace) list). ns_to_alist (Bind ((s,x)::xs) m) = (s,x)::ns_to_alist (Bind xs m)
types_output=⊢ ∀(s :inf_env). inf_env_to_types_string s = (let (l :(mlstring # num # infer_t) list) = ns_to_alist (ns_nub s.inf_v); (xs :mlstring list) = MAP (λ((n :mlstring),(_0 :num),(t :infer_t)). concat [n; «: »; inf_type_to_string s.inf_t t; «\n»]) l in REVERSE xs)
type_function=⊢ inf_type_to_string (alist_to_ns ([] :(mlstring # α # t) list) :(mlstring, mlstring, α # t) namespace) (Infer_Tapp [Infer_Tvar_db (0 :num); Infer_Tvar_db (0 :num)] (4 :num)) = «'a -> 'a»
type_tuple=⊢ inf_type_to_string (alist_to_ns ([] :(mlstring # α # t) list) :(mlstring, mlstring, α # t) namespace) (Infer_Tapp [Infer_Tapp ([] :infer_t list) (5 :num); Infer_Tapp ([] :infer_t list) (1 :num)] (9 :num)) = «int * bool»
type_unknown=⊢ inf_type_to_string (alist_to_ns ([] :(mlstring # α # t) list) :(mlstring, mlstring, α # t) namespace) (Infer_Tapp ([] :infer_t list) (123 :num)) = «123»
