dest_Let_def_typed=dest_Let (Let (opt :mlstring option) (x :exp) (y :exp)) = SOME (opt,x,y) ∧ dest_Let (Raise (v :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Handle (v1 :exp) (v2 :(pat # exp) list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Lit (v3 :lit)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Con (v4 :(mlstring, mlstring) id option) (v5 :exp list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Var (v6 :(mlstring, mlstring) id)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Fun (v7 :mlstring) (v8 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (App (v9 :op) (v10 :exp list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Log (v11 :lop) (v12 :exp) (v13 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (If (v14 :exp) (v15 :exp) (v16 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Mat (v17 :exp) (v18 :(pat # exp) list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Letrec (v22 :(mlstring # mlstring # exp) list) (v23 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Tannot (v24 :exp) (v25 :ast_t)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Lannot (v26 :exp) (v27 :locs)) = (NONE :(mlstring option # exp # exp) option)
dest_Letrec_def_typed=dest_Letrec (Letrec (funs :(mlstring # mlstring # exp) list) (x :exp)) = SOME (funs,x) ∧ dest_Letrec (Raise (v :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Handle (v1 :exp) (v2 :(pat # exp) list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Lit (v3 :lit)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Con (v4 :(mlstring, mlstring) id option) (v5 :exp list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Var (v6 :(mlstring, mlstring) id)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Fun (v7 :mlstring) (v8 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (App (v9 :op) (v10 :exp list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Log (v11 :lop) (v12 :exp) (v13 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (If (v14 :exp) (v15 :exp) (v16 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Mat (v17 :exp) (v18 :(pat # exp) list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Let (v19 :mlstring option) (v20 :exp) (v21 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Tannot (v24 :exp) (v25 :ast_t)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Lannot (v26 :exp) (v27 :locs)) = (NONE :((mlstring # mlstring # exp) list # exp) option)
lift_let_def_typed=lift_let (Dlet (l :locs) (p :pat) (x :exp)) = (case dest_Let x of (NONE :(mlstring option # exp # exp) option) => (case dest_Letrec x of (NONE :((mlstring # mlstring # exp) list # exp) option) => (NONE :(dec # dec) option) | SOME (funs,x) => SOME (Dletrec l funs,Dlet l p x)) | SOME ((NONE :mlstring option),v4,v5) => SOME (Dlet l Pany v4,Dlet l p v5) | SOME (SOME v6,v4,v5) => SOME (Dlet l (Pvar v6) v4,Dlet l p v5)) ∧ lift_let (Dletrec (v10 :locs) (v11 :(mlstring # mlstring # exp) list)) = (NONE :(dec # dec) option) ∧ lift_let (Dtype (v12 :locs) (v13 :(mlstring list # mlstring # (mlstring # ast_t list) list) list)) = (NONE :(dec # dec) option) ∧ lift_let (Dtabbrev (v14 :locs) (v15 :mlstring list) (v16 :mlstring) (v17 :ast_t)) = (NONE :(dec # dec) option) ∧ lift_let (Dexn (v18 :locs) (v19 :mlstring) (v20 :ast_t list)) = (NONE :(dec # dec) option) ∧ lift_let (Dmod (v21 :mlstring) (v22 :dec list)) = (NONE :(dec # dec) option) ∧ lift_let (Dlocal (v23 :dec list) (v24 :dec list)) = (NONE :(dec # dec) option) ∧ lift_let (Denv (v25 :mlstring)) = (NONE :(dec # dec) option)
lift_lets_def_typed=∀(sofar :dec list) (d :dec). lift_lets sofar d = case lift_let d of (NONE :(dec # dec) option) => (case sofar of ([] :dec list) => (NONE :(dec list # dec) option) | v2::v3 => SOME (REVERSE sofar,d)) | SOME (d1,d2) => lift_lets (d1::sofar) d2
