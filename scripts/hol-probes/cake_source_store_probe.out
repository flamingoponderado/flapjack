type_stamp_type=:mlstring -> num -> stamp
exn_stamp_type=:num -> stamp
sem_env_v_type=:α sem_env -> (mlstring, mlstring, α) namespace
sem_env_c_type=:α sem_env -> (mlstring, mlstring, num # stamp) namespace
litv_type=:lit -> v
conv_type=:stamp option -> v list -> v
loc_type=:bool -> num -> v
vector_type=:v list -> v
env_type=:v sem_env -> num # num -> v
store_ref_type=:α -> α store_v
store_bytes_type=:word8 list -> α store_v
store_array_type=:α list -> α store_v
store_thunk_type=:thunk_mode -> α -> α store_v
decs_compiler_state_type=:eval_decs_state -> v
decs_env_counter_type=:eval_decs_state -> num # num # num
decs_decode_type=:eval_decs_state -> v -> dec list option
oracle_source_type=:eval_oracle_state -> num -> (num # num) # v # dec list
oracle_envs_type=:eval_oracle_state -> v sem_env list list
oracle_generation_type=:eval_oracle_state -> num
eval_decs_type=:eval_decs_state -> eval_state
eval_oracle_type=:eval_oracle_state -> eval_state
state_clock_type=:'ffi state -> num
state_refs_type=:'ffi state -> v store_v list
state_type_stamp_type=:'ffi state -> num
state_exn_stamp_type=:'ffi state -> num
closure_type=:v sem_env -> mlstring -> exp -> v
recclosure_type=:v sem_env -> (mlstring # mlstring # exp) list -> mlstring -> v
store_assign_type=:num -> α store_v -> α store_v list -> α store_v list option
compiler_type=:eval_decs_state -> (num # num) # v # dec list -> (v # word8 list # word64 list) option
oracle_type=:eval_oracle_state -> v list -> (num -> (num # num) # v # dec list) -> ((num # num) # (num -> (num # num) # v # dec list) # dec list) option
state_ffi_type=:'ffi state -> 'ffi ffi_state
state_eval_type=:'ffi state -> eval_state option
ref_same=T
thunk_update=T
thunk_final=F
allocation=([Refv (3 :num); Refv (7 :num)],(1 :num))
lookup=SOME (Refv (3 :num))
update=SOME [Refv (7 :num)]
invalid=(NONE :num store_v list option)
wrong_type=(NONE :num store_v list option)
