pm_audit_not_use_temp_before_assign_append=∀l1 l2.
  not_use_temp_before_assign (l1 ++ l2) ⇔
  not_use_temp_before_assign l1 ∧
  (EVERY IS_SOME (MAP FST l1) ⇒ not_use_temp_before_assign l2)
pm_audit_not_use_temp_before_assign_insert=∀l1 l2.
  not_use_temp_before_assign (l1 ++ l2) ⇒
  not_use_temp_before_assign (l1 ++ [(SOME x,SOME y)] ++ l2)
pm_audit_not_use_temp_before_assign_thm=∀ls.
  not_use_temp_before_assign ls ⇔
  ∀i. find_index NONE (MAP SND ls) 0 = SOME i ⇒
      ∃j. find_index NONE (MAP FST ls) 0 = SOME j ∧ j < i
pm_audit_step_not_use_temp_before_assign=∀s1 s2.
  s1 ▷ s2 ⇒
  ⊢ s1 ∧ not_use_temp_before_assign (REVERSE (FST (SND s1) ++ SND (SND s1))) ⇒
  not_use_temp_before_assign (REVERSE (FST (SND s2) ++ SND (SND s2)))
pm_audit_steps_not_use_temp_before_assign=∀s1 s2.
  (λs1.
       ⊢ s1 ∧
       not_use_temp_before_assign (REVERSE (FST (SND s1) ++ SND (SND s1))))
    s1 ∧ s1 ▷* s2 ⇒
  (λs1.
       ⊢ s1 ∧
       not_use_temp_before_assign (REVERSE (FST (SND s1) ++ SND (SND s1))))
    s2
pm_audit_pmov_not_use_temp_before_assign=∀p i.
  ⊢ p ∧ not_use_temp_before_assign (REVERSE (FST (SND p) ++ SND (SND p))) ⇒
  not_use_temp_before_assign
    (REVERSE (FST (SND (pmov p)) ++ SND (SND (pmov p))))
pm_audit_parmove_not_use_temp_before_assign=windmill mvs ⇒
case find_index NONE (MAP SND (parmove mvs)) 0 of
  NONE => T
| SOME i =>
  case find_index NONE (MAP FST (parmove mvs)) 0 of
    NONE => F
  | SOME j => ¬(i ≤ j)
pm_audit_ALL_DISTINCT_step=∀s1 s2.
  s1 ▷ s2 ⇒
  ALL_DISTINCT
    (FILTER IS_SOME (MAP FST (FST s1 ++ FST (SND s1) ++ SND (SND s1)))) ⇒
  ALL_DISTINCT
    (FILTER IS_SOME (MAP FST (FST s2 ++ FST (SND s2) ++ SND (SND s2))))
pm_audit_ALL_DISTINCT_steps=∀s1 s2.
  (λs1.
       ALL_DISTINCT
         (FILTER IS_SOME (MAP FST (FST s1 ++ FST (SND s1) ++ SND (SND s1)))))
    s1 ∧ s1 ▷* s2 ⇒
  (λs1.
       ALL_DISTINCT
         (FILTER IS_SOME (MAP FST (FST s1 ++ FST (SND s1) ++ SND (SND s1)))))
    s2
pm_audit_ALL_DISTINCT_pmov=∀p. ⊢ p ∧
    ALL_DISTINCT
      (FILTER IS_SOME (MAP FST (FST p ++ FST (SND p) ++ SND (SND p)))) ⇒
    ALL_DISTINCT
      (FILTER IS_SOME
         (MAP FST (FST (pmov p) ++ FST (SND (pmov p)) ++ SND (SND (pmov p)))))
pm_audit_ALL_DISTINCT_parmove=ALL_DISTINCT (MAP FST mvs) ⇒
ALL_DISTINCT (FILTER IS_SOME (MAP FST (parmove mvs)))
pm_audit_state_to_list_def=∀p. state_to_list p = FST p ++ FST (SND p) ++ SND (SND p)
pm_audit_step_preserves_moves=∀s1 s2.
  s1 ▷ s2 ⇒
  ∀x. (∃y. MEM (x,y) (state_to_list s1) ∧ x ≠ y) ⇒
      ∃y. MEM (x,y) (state_to_list s2) ∧ x ≠ y
pm_audit_steps_preserves_moves=∀s1 s2.
  (λs1. ∃y. MEM (x,y) (state_to_list s1) ∧ x ≠ y) s1 ∧ s1 ▷* s2 ⇒
  (λs1. ∃y. MEM (x,y) (state_to_list s1) ∧ x ≠ y) s2
pm_audit_pmov_preserves_moves=∀p. ⊢ p ∧ MEM (x,y) (state_to_list p) ∧ x ≠ y ⇒
    MEM x (MAP FST (state_to_list (pmov p)))
pm_audit_parmove_preserves_moves=windmill moves ∧ MEM (x,y) moves ∧ x ≠ y ⇒
MEM (SOME x) (MAP FST (parmove moves))
pm_audit_map_state_def=∀f. map_state f = (let m = MAP (f ## f) in m ## m ## m)
pm_audit_inj_on_state_def=∀f p.
  inj_on_state f p ⇔
  (let
     ls0 = state_to_list p;
     ls = MAP FST ls0 ++ MAP SND ls0
   in
     (∀x y. MEM x ls ∧ MEM y ls ∧ f x = f y ⇒ x = y) ∧
     ∀x. f x = NONE ⇔ x = NONE)
pm_audit_step_inj_on_state=∀s1 s2. s1 ▷ s2 ⇒ inj_on_state f s1 ⇒ inj_on_state f s2
pm_audit_steps_inj_on_state=∀s1 s2. inj_on_state f s1 ∧ s1 ▷* s2 ⇒ inj_on_state f s2
pm_audit_step_MAP_INJ=∀s1 s2. s1 ▷ s2 ⇒ inj_on_state f s1 ⇒ map_state f s1 ▷ map_state f s2
pm_audit_fstep_MAP_INJ=∀p. inj_on_state f p ⇒ fstep (map_state f p) = map_state f (fstep p)
pm_audit_pmov_MAP_INJ=∀p. ⊢ p ∧ inj_on_state f p ⇒ pmov (map_state f p) = map_state f (pmov p)
pm_audit_parmove_MAP_INJ=(let
   ls1 = MAP FST ls ++ MAP SND ls
 in
   ∀x y. MEM x ls1 ∧ MEM y ls1 ∧ f x = f y ⇒ x = y) ∧ windmill ls ⇒
parmove (MAP (f ## f) ls) = MAP (OPTION_MAP f ## OPTION_MAP f) (parmove ls)
pm_audit_type_state_to_list=:α list # α list # α list -> α list
pm_audit_type_map_state=:(α -> β) ->
(α # α) list # (α # α) list # (α # α) list ->
(β # β) list # (β # β) list # (β # β) list
pm_audit_type_inj_on_state=:(α option -> β option) ->
(α option # α option) list #
(α option # α option) list # (α option # α option) list -> bool
