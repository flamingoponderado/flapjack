do_install_replay_typed=state_rel (s :(α, β) state) (t :(α, β) state) ∧ LIST_REL (v_rel s.max_app) (xs :v list) (ys :v list) ⇒ case do_install xs s of ((Rval exps1 :(closLang$exp list, v) result),s1) => ∃(exps2 :closLang$exp list) (t1 :(α, β) state). (s1.max_app = s.max_app ∧ state_rel s1 t1) ∧ exps1 ≠ ([] :closLang$exp list) ∧ code_rel s.max_app exps1 exps2 ∧ do_install ys t = ((Rval exps2 :(closLang$exp list, v) result),t1) | ((Rerr err1 :(closLang$exp list, v) result),s1) => ∃(err2 :v error_result) (t1 :(α, β) state). do_install ys t = ((Rerr err2 :(closLang$exp list, v) result),t1) ∧ exc_rel (v_rel s.max_app) err1 err2 ∧ s1.max_app = s.max_app ∧ state_rel s1 t1
evaluate_apps_snoc_replay_typed=∀(xs :v list) (x :v) (f :v) (s :(α, β) state). evaluate_apps f (SNOC x xs) s = case evaluate_app (NONE :num option) f [x] s of ((Rval ([] :v list) :(v list, v) result),s) => ((Rval ([] :v list) :(v list, v) result),s) | ((Rval [v] :(v list, v) result),s) => evaluate_apps v xs s | ((Rval (v::v15::v16) :(v list, v) result),s) => ((Rval (v::v15::v16) :(v list, v) result),s) | ((Rerr v8 :(v list, v) result),s) => ((Rerr v8 :(v list, v) result),s)
evaluate_mk_apps_ok_replay_typed=∀(other :closLang$exp list) (ts :tra list) (env1 :v list) (s1 :(α, β) state) (vs :v list). evaluate ([(e :closLang$exp)],env1,(s3 :(α, β) state)) = ((Rval [(f :v)] :(v list, v) result),(s2' :(α, β) state)) ∧ evaluate (other,env1,s1) = ((Rval vs :(v list, v) result),s3) ∧ LENGTH other = LENGTH ts ⇒ evaluate ([mk_Apps e (ZIP (ts,other))],env1,s1) = evaluate_apps f vs s2'
dest_closure_none_apps_replay_typed=∀(xs :v list) (f1 :v) (s1 :(α, β) state). dest_closure s1.max_app (NONE :num option) f1 [LAST xs] = (NONE :app_kind option) ∧ xs ≠ ([] :v list) ⇒ evaluate_apps f1 xs s1 = ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s1)
evaluate_apps_long_replay_typed=∀(ys :v list) (ts :mlstring list) (s1 :(α, β) state) (e1 :closLang$exp) (env :v list). LENGTH ts < s1.clock ∧ LENGTH ts < LENGTH ys ∧ (1 :num) ≤ s1.max_app ⇒ evaluate_apps (Closure (NONE :num option) ([] :v list) env (1 :num) (mk_Fns ts e1) :v) ys s1 = case evaluate ([e1],REVERSE (TAKE ((1 :num) + LENGTH ts) (REVERSE ys)) ++ env,dec_clock ((1 :num) + LENGTH ts) s1) of ((Rval ([] :v list) :(v list, v) result),s) => ((Rval ([] :v list) :(v list, v) result),s) | ((Rval [v] :(v list, v) result),s) => evaluate_apps v (REVERSE (DROP ((1 :num) + LENGTH ts) (REVERSE ys))) s | ((Rval (v::v15::v16) :(v list, v) result),s) => ((Rval (v::v15::v16) :(v list, v) result),s) | ((Rerr v8 :(v list, v) result),s) => ((Rerr v8 :(v list, v) result),s)
evaluate_apps_timeout_replay_typed=∀(ys :v list) (ts :mlstring list) (s1 :(α, β) state) (e1 :closLang$exp) (env :v list). s1.clock < LENGTH ys ∧ LENGTH ys ≤ LENGTH ts ∧ (1 :num) ≤ s1.max_app ⇒ evaluate_apps (Closure (NONE :num option) ([] :v list) env (1 :num) (mk_Fns ts e1) :v) ys s1 = ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s1 with clock := (0 :num))
evaluate_apps_timeout_alt_replay_typed=∀(ys :v list) (ts :mlstring list) (s1 :(α, β) state) (e1 :closLang$exp) (env :v list). s1.clock ≤ LENGTH ts ∧ LENGTH ts < LENGTH ys ∧ (1 :num) ≤ s1.max_app ⇒ evaluate_apps (Closure (NONE :num option) ([] :v list) env (1 :num) (mk_Fns ts e1) :v) ys s1 = ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s1 with clock := (0 :num))
evaluate_apps_short_replay_typed=∀(ys :v list) (ts :mlstring list) (s1 :(α, β) state) (e1 :closLang$exp) (env :v list). LENGTH ys ≤ s1.clock ∧ LENGTH ys ≤ LENGTH ts ∧ (1 :num) ≤ s1.max_app ⇒ evaluate_apps (Closure (NONE :num option) ([] :v list) env (1 :num) (mk_Fns ts e1) :v) ys s1 = ((Rval [(Closure (NONE :num option) ([] :v list) (ys ++ env) (1 :num) (mk_Fns (DROP (LENGTH ys) ts) e1) :v)] :(v list, v) result),dec_clock (LENGTH ys) s1)
state_rel_opt_rel_refs_replay_typed=(state_rel (s1 :(α, β) state) (s2 :(α, β) state) ∧ FLOOKUP s1.refs (n :num) = (r1 :v ref option) ⇒ ∃(r2 :v ref option). FLOOKUP s2.refs n = r2 ∧ OPTREL (ref_rel s1.max_app :v ref -> v ref -> bool) r1 r2) ∧ (state_rel s1 s2 ∧ FLOOKUP s2.refs n = (r2 :v ref option) ⇒ ∃(r1 :v ref option). FLOOKUP s1.refs n = r1 ∧ OPTREL (ref_rel s1.max_app :v ref -> v ref -> bool) r1 r2)
rel_update_thunk_replay_typed=state_rel (s1 :(α, β) state) (s2 :(α, β) state) ∧ LIST_REL (v_rel s1.max_app) (vs :v list) (ys :v list) ⇒ (update_thunk [RefPtr (v :bool) (ptr :num)] s2.refs ys = (NONE :(num |-> v ref) option) ⇒ update_thunk [RefPtr v ptr] s1.refs vs = (NONE :(num |-> v ref) option)) ∧ (update_thunk [RefPtr v ptr] s2.refs ys = SOME (refs2 :num |-> v ref) ⇒ ∃(refs1 :num |-> v ref). update_thunk [RefPtr v ptr] s1.refs vs = SOME refs1 ∧ state_rel (s1 with refs := refs1) (s2 with refs := refs2))
