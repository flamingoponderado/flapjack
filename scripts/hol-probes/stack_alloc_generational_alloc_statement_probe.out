gen_alloc_typed_statement=(alloc (w :α word) (s :(α, γ, β) state) :α result option # (α, γ, β) state) = ((r :α result option),(t :(α, γ, β) state)) ∧ r ≠ SOME (Error :α result) ∧ s.gc_fun = (word_gc_fun (conf :config) :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) ∧ conf.gc_kind = Generational (gen_sizes :num list) ∧ LENGTH s.bitmaps < dimword (:α) − (1 :num) ∧ LENGTH s.stack * (dimindex (:α) DIV (8 :num)) < dimword (:α) ∧ FLOOKUP (l :num |-> α word_loc) (0 :num) = SOME (ret :α word_loc) ∧ FLOOKUP l (1 :num) = SOME (Word w) ⇒ ∃(ck :num) (l2 :num |-> α word_loc). (evaluate ((word_gc_code conf :α stackLang$prog),s with <|use_store := T; use_stack := T; use_alloc := F; clock := s.clock + ck; regs := l; gc_fun := (anything :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option); code := fromAList (compile (c :config) (toAList s.code) :(num # α stackLang$prog) list)|>) :α result option # (α, γ, β) state) = (r,t with <|use_store := T; use_stack := T; use_alloc := F; code := fromAList (compile c (toAList s.code) :(num # α stackLang$prog) list); regs := l2; gc_fun := anything|>) ∧ (r ≠ (NONE :α result option) ⇒ r = SOME (Halt (Word (1w :α word)) :α result)) ∧ t.regs ⊑ l2 ∧ (r = (NONE :α result option) ⇒ FLOOKUP l2 (0 :num) = SOME ret)
gen_alloc_free_vars=c::config,anything::α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option,ret::α word_loc,l::num |-> α word_loc,gen_sizes::num list,conf::config,t::(α, γ, β) state,r::α result option,s::(α, γ, β) state,w::α word
