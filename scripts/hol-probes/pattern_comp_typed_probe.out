is_const_row_def_typed=(is_const_row (Cons (v0 :(num # (num # num) list option) option) (pats :pat list),(x :α)) ⇔ NULL pats) ∧ (is_const_row (Any,(v2 :α)) ⇔ F) ∧ (is_const_row ((Or (v7 :pat) (v8 :pat) :pat),v2) ⇔ F) ∧ (is_const_row ((Lit (v9 :lit) :pat),v2) ⇔ F) ∧ (is_const_row (Ref (v10 :pat),v2) ⇔ F)
is_Any_def_typed=(is_Any Any ⇔ T) ∧ (∀(p2 :pat) (p1 :pat). is_Any (Or p1 p2 :pat) ⇔ is_Any p1 ∨ is_Any p2) ∧ (∀(v1 :pat list) (v :(num # (num # num) list option) option). is_Any (Cons v v1) ⇔ F) ∧ (∀(v4 :lit). is_Any (Lit v4 :pat) ⇔ F) ∧ ∀(v5 :pat). is_Any (Ref v5) ⇔ F
is_Or_row_def_typed=(is_Or_row ((Or (p1 :pat) (p2 :pat) :pat),(v0 :α)) ⇔ T) ∧ (is_Or_row (Any,(v2 :α)) ⇔ F) ∧ (is_Or_row (Cons (v5 :(num # (num # num) list option) option) (v6 :pat list),v2) ⇔ F) ∧ (is_Or_row ((Lit (v9 :lit) :pat),v2) ⇔ F) ∧ (is_Or_row (Ref (v10 :pat),v2) ⇔ F)
take_until_Any_def_typed=take_until_Any ([] :(pat # α) list) = ([] :(pat # α) list) ∧ ∀(xs :(pat # α) list) (x :α) (p :pat). take_until_Any ((p,x)::xs) = if is_Any p then [(p,x)] else (p,x)::take_until_Any xs
move_const_up_def_typed=∀(rows :(pat # α) list). move_const_up rows = (let (new_rows :(pat # α) list) = take_until_Any rows in if (5 :num) ≤ LENGTH new_rows ∨ EXISTS (is_Or_row :pat # α -> bool) new_rows then new_rows else FILTER (is_const_row :pat # α -> bool) new_rows ++ FILTER (λ(x :pat # α). ¬is_const_row x) new_rows)
insert_Any_def_typed=insert_Any ([] :(pat # α) list) = ([] :(pat # α) list) ∧ (∀(x :α) (p :pat). insert_Any [(p,x)] = [(Any,x)]) ∧ ∀(x :pat # α) (v3 :(pat # α) list) (v2 :pat # α). insert_Any (x::v2::v3) = x::insert_Any (v2::v3)
is_True_def_typed=(is_True True ⇔ T) ∧ (is_True (PosTest (v :position) (v1 :dTest)) ⇔ F) ∧ (is_True (Not (v2 :dGuard) :dGuard) ⇔ F) ∧ (is_True (Conj (v3 :dGuard) (v4 :dGuard)) ⇔ F) ∧ (is_True (Disj (v5 :dGuard) (v6 :dGuard)) ⇔ F)
mk_Disj_def_typed=∀(p :dGuard) (q :dGuard). mk_Disj p q = if is_True p ∨ is_True q then True else Disj p q
mk_Conj_def_typed=∀(p :dGuard) (q :dGuard). mk_Conj p q = if is_True p then q else if is_True q then p else Conj p q
mk_If_def_typed=∀(g :dGuard) (p :dTree) (q :dTree). mk_If g p q = if is_True g then p else If g p q
get_pos_def_typed=get_pos ([] :num list) = EmptyPos ∧ ∀(n :num) (ns :num list). get_pos (n::ns) = Pos n (get_pos ns)
pat_to_guard_def_typed=(∀(l :num list). pat_to_guard l Any = True) ∧ (∀(r :lit) (l :num list). pat_to_guard l (Lit r :pat) = PosTest (get_pos (REVERSE l)) (LitEq r)) ∧ (∀(pats :pat list) (l :num list). pat_to_guard l (Cons (NONE :(num # (num # num) list option) option) pats) = pats_to_guard l (0 :num) pats) ∧ (∀(v0 :(num # num) list option) (t :num) (pats :pat list) (l :num list). pat_to_guard l (Cons (SOME (t,v0)) pats) = mk_Conj (PosTest (get_pos (REVERSE l)) (TagLenEq t (LENGTH pats))) (pats_to_guard l (0 :num) pats)) ∧ (∀(p2 :pat) (p1 :pat) (l :num list). pat_to_guard l (Or p1 p2 :pat) = mk_Disj (pat_to_guard l p1) (pat_to_guard l p2)) ∧ (∀(p :pat) (l :num list). pat_to_guard l (Ref p) = pat_to_guard ((0 :num)::l) p) ∧ (∀(l :num list) (k :num). pats_to_guard l k ([] :pat list) = True) ∧ (∀(p :pat) (l :num list) (k :num). pats_to_guard l k [p] = pat_to_guard (k::l) p) ∧ ∀(v20 :pat list) (v19 :pat) (p :pat) (l :num list) (k :num). pats_to_guard l k (p::v19::v20) = mk_Conj (pat_to_guard (k::l) p) (pats_to_guard l (k + (1 :num)) (v19::v20))
pats_to_code_def_typed=pats_to_code ([] :(pat # num) list) = Fail ∧ ∀(x :num) (rows :(pat # num) list) (p :pat). pats_to_code ((p,x)::rows) = mk_If (pat_to_guard ([] :num list) p) (Leaf x) (pats_to_code rows)
pmatch_list_LENGTH_typed=∀(ps :pat list) (vs :term list). (pmatch_list (refs :num |-> term) ps vs :pmatchResult) ≠ PTypeFailure ⇒ LENGTH vs = LENGTH ps
is_Any_pmatch_typed=∀(p :pat). is_Any p ⇒ (pmatch (refs :num |-> term) p (v :term) :pmatchResult) ≠ PMatchFailure
match_take_until_Any_typed=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ match refs (take_until_Any rows) v = match refs rows v
match_append_typed=∀(xs :(pat # num) list) (ys :(pat # num) list) (refs :num |-> term) (v :term). match refs (xs ++ ys) v = case match refs xs v of (NONE :matchResult option) => (NONE :matchResult option) | SOME (MatchSuccess e) => if match refs ys v ≠ (NONE :matchResult option) then SOME (MatchSuccess e) else (NONE :matchResult option) | SOME MatchFailure => match refs ys v
pmatchResult_case_NONE_typed=(case (x :pmatchResult) of PMatchSuccess => (NONE :α option) | PMatchFailure => (NONE :α option) | PTypeFailure => (NONE :α option)) = (NONE :α option)
is_const_row_lemma_typed=(∀(t :num option). (v :term) ≠ Term t ([] :term list)) ∧ is_const_row ((p_1 :pat),(p_2 :α)) ∧ (pmatch (refs :num |-> term) p_1 v :pmatchResult) ≠ PTypeFailure ⇒ (pmatch refs p_1 v :pmatchResult) = PMatchFailure
not_is_const_row_typed=¬is_const_row ((p :pat),(x :α)) ∧ ¬is_Or_row (p,x) ∧ ¬is_Any p ⇒ (pmatch (refs :num |-> term) p (Term (t :num option) ([] :term list)) :pmatchResult) ≠ PMatchSuccess
EVERY_take_until_Any_typed=∀(rows :(pat # num) list). EVERY (λ((x :pat),(y :num)). ¬is_Any x) (TL (REVERSE (take_until_Any rows)))
matdch_FILTER_NOT_NONE_typed=∀(xs :(pat # num) list). match (refs :num |-> term) xs (v :term) ≠ (NONE :matchResult option) ⇒ match refs (FILTER (P :pat # num -> bool) xs) v ≠ (NONE :matchResult option)
match_move_const_up_typed=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ⇒ match refs (move_const_up rows) v = match refs rows v
match_insert_Any_typed=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ match refs (insert_Any rows) v ≠ (NONE :matchResult option) ∧ (match refs rows v ≠ SOME MatchFailure ⇒ match refs (insert_Any rows) v = match refs rows v)
walk_def_typed=(∀(x :term) (refs :num |-> term). walk ([] :num list) x refs = SOME x) ∧ ∀(n :num) (ns :num list) (x :term) (refs :num |-> term). walk (n::ns) x refs = case x of Term t xs => if n < LENGTH xs then walk ns xs❲n❳ refs else (NONE :term option) | (Litv v6 :term) => (NONE :term option) | RefPtr p => if n ≠ (0 :num) then (NONE :term option) else (case FLOOKUP refs p of (NONE :term option) => (NONE :term option) | SOME y => walk ns y refs) | Other => (NONE :term option)
walk_list_def_typed=∀(ns :num list) (x :term) (refs :num |-> term). walk_list ns x refs = case walk ns x refs of (NONE :term option) => (NONE :term list option) | SOME (Term v6 vs) => SOME vs | SOME (Litv v8 :term) => (NONE :term list option) | SOME (RefPtr v9) => (NONE :term list option) | SOME Other => (NONE :term list option)
app_pos_Pos_typed=∀(n :num) (xs :term list). n < LENGTH xs ⇒ app_pos (refs :num |-> term) (Pos n (x :position)) (Term (t :num option) xs) = app_pos refs x xs❲n❳
walk_thm_typed=∀(l :num list) (v :term) (refs :num |-> term) (x :term). walk l v refs = SOME x ⇒ app_pos refs (get_pos l) v = SOME x
walk_append_typed=∀(xs :num list) (ys :num list) (v :term) (refs :num |-> term). walk (xs ++ ys) v refs = case walk xs v refs of (NONE :term option) => (NONE :term option) | SOME v => walk ys v refs
dt_eval_guard_pat_to_guard_typed=(∀(l :num list) (p :pat) (x :term). (pmatch (refs :num |-> term) p x :pmatchResult) ≠ PTypeFailure ∧ walk (REVERSE l) (v :term) refs = SOME x ⇒ dt_eval_guard refs v (pat_to_guard l p) = SOME ((pmatch refs p x :pmatchResult) = PMatchSuccess)) ∧ ∀(l :num list) (k :num) (ps :pat list) (xs :term list) (ys :term list). (pmatch_list refs ps xs :pmatchResult) ≠ PTypeFailure ∧ LENGTH ys = k ∧ walk_list (REVERSE l) v refs = SOME (ys ++ xs) ∧ LENGTH xs = LENGTH ps ⇒ dt_eval_guard refs v (pats_to_guard l k ps) = SOME ((pmatch_list refs ps xs :pmatchResult) = PMatchSuccess)
pat_to_code_thm_typed=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ dt_eval refs v (pats_to_code rows) = match refs rows v
comp_thm_typed=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ⇒ dt_eval refs v (comp rows) = match refs rows v
comp_def_typed=∀(rows :(pat # num) list). comp rows = (let (rows0 :(pat # num) list) = move_const_up rows; (rows1 :(pat # num) list) = if exh_rows rows0 then insert_Any rows0 else rows0 in pats_to_code rows1)
