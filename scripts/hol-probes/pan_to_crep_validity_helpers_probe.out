exps_of_nested_seq=∀(es :α crepLang$prog list). (exps_of (nested_seq es) :α crepLang$exp list) = FLAT (MAP (exps_of :α crepLang$prog -> α crepLang$exp list) es)
every_inst_ok_nested_decs=∀(ns :num list) (ps :α crepLang$exp list) (p :α crepLang$prog). LENGTH ns = LENGTH ps ⇒ (EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of (nested_decs ns ps p) :α crepLang$exp list) ⇔ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) ps ∧ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of p :α crepLang$exp list))
every_inst_ok_less_pan_to_crep_comp_field=∀(index :num) (shapes :shape list) (es :α crepLang$exp list) (es' :α crepLang$exp list) (sh :shape). EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) es ∧ comp_field index shapes es = (es',sh) ⇒ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) es'
every_inst_ok_less_pan_to_crep_load_shape=∀(w :α word) (n :num) (e :α crepLang$exp). every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)) e ⇒ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (load_shape w n e)
every_inst_ok_less_pan_to_crep_cexp_heads=∀(ces :α crepLang$exp list list) (es :α crepLang$exp list). EVERY (EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)))) ces ∧ cexp_heads ces = SOME es ⇒ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) es
every_inst_ok_less_stores=∀(e :α crepLang$exp) (es :α crepLang$exp list) (a :α word). EVERY (λ(x :α crepLang$prog). EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of x :α crepLang$exp list)) (stores e es a) ⇔ (es ≠ ([] :α crepLang$exp list) ⇒ every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num)) e) ∧ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) es
every_inst_ok_less_store_globals=∀(w :word5) (es :α crepLang$exp list). EVERY (λ(x :α crepLang$prog). EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of x :α crepLang$exp list)) (store_globals w es) ⇔ EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) es
