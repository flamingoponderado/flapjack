inst_load8_full=⊢ ∀st cst ssa na lt.
    word_state_eq_rel st cst ∧ ssa_locals_rel na ssa st.locals cst.locals ∧ is_alloc_var na ∧ every_var (λx. x < na) (Inst (Mem Load8 n (Addr n0 w))) ∧ ssa_map_ok na ssa ∧ lt_ok lt ⇒
    ∃perm'. (let (res,rst) = evaluate (Inst (Mem Load8 n (Addr n0 w)),st with permute := perm') in if res = SOME Error then T else (let (prog',ssa',na') = ssa_cc_trans (Inst (Mem Load8 n (Addr n0 w))) ssa na lt; (res',rcst) = evaluate (prog',cst) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of NONE => ssa_locals_rel na' ssa' rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n) => (case LLOOKUP lt n of NONE => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names) rst.locals rcst.locals) | SOME (Continue n') => (case LLOOKUP lt n' of NONE => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names) rst.locals rcst.locals) | SOME TimeOut => rst.locals = rcst.locals | SOME NotEnoughSpace => rst.locals = rcst.locals | SOME (FinalFFI v18) => rst.locals = rcst.locals | SOME Error => rst.locals = rcst.locals))
inst_load8_type_st=:(α, β, γ) state
inst_load8_type_cst=:(α, β, γ) state
inst_load8_type_dst=:num
inst_load8_type_src=:num
inst_load8_type_offset=:α word
inst_load8_type_ssa=:num sptree$num_map
inst_load8_type_next=:num
inst_load8_type_tables=:(num sptree$num_map # sptree$num_set # sptree$num_set) list
