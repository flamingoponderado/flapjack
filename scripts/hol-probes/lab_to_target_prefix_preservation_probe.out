lines_upd_lab_len_label_prefix_zero=∀(pos :num) (ls :α line list) (acc :α line list).
  (EVERY (is_Label :α line -> bool) acc ⇒ EVEN pos) ∧
  label_prefix_zero (REVERSE acc) ⇒
  label_prefix_zero (FST (lines_upd_lab_len pos ls acc))
lines_upd_lab_len_label_prefix_zero_types=(pos :num)::num;(ls :α line list)::α line list;(acc :α line list)::α line list;
upd_lab_len_label_prefix_zero=∀(pos :num) (ss :α sec list).
  EVEN pos ∧ EVERY (sec_ends_with_label :α sec -> bool) ss ⇒
  EVERY (sec_label_prefix_zero :α sec -> bool) (upd_lab_len pos ss)
upd_lab_len_label_prefix_zero_types=(pos :num)::num;(ss :α sec list)::α sec list;
enc_lines_again_simp_label_prefix_zero=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (ls :α line list) (res :α line list)
    (ok :bool).
  enc_lines_again_simp labs ffis pos enc ls = (res,ok) ∧ label_prefix_zero ls ⇒
  label_prefix_zero res
enc_lines_again_simp_label_prefix_zero_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(ls :α line list)::α line list;(res :α line list)::α line list;(ok :bool)::bool;
enc_secs_again_label_prefix_zero=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (enc :α asm -> word8 list) (lines :α sec list) (res :α sec list)
    (ok :bool).
  enc_secs_again pos labs ffis enc lines = (res,ok) ∧
  EVERY (sec_label_prefix_zero :α sec -> bool) lines ⇒
  EVERY (sec_label_prefix_zero :α sec -> bool) res
enc_secs_again_label_prefix_zero_types=(pos :num)::num;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α sec list)::α sec list;(res :α sec list)::α sec list;(ok :bool)::bool;
