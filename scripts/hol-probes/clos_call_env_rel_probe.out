fv_type=:num -> closLang$exp list -> bool
fv1_type=:num -> closLang$exp -> bool
fv_def=(!(n :num). fv n ([] :closLang$exp list) <=> F) /\ (!(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp) (n :num). fv n (x::y::xs) <=> fv n [x] \/ fv n (y::xs)) /\ (!(v0 :tra) (v :num) (n :num). fv n [(Var v0 v :closLang$exp)] <=> n = v) /\ (!(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (v1 :tra) (n :num). fv n [(If v1 x1 x2 x3 :closLang$exp)] <=> fv n [x1] \/ fv n [x2] \/ fv n [x3]) /\ (!(xs :closLang$exp list) (x2 :closLang$exp) (v2 :tra) (n :num). fv n [(Let v2 xs x2 :closLang$exp)] <=> fv n xs \/ fv (n + LENGTH xs) [x2]) /\ (!(x1 :closLang$exp) (v3 :tra) (n :num). fv n [(Raise v3 x1 :closLang$exp)] <=> fv n [x1]) /\ (!(x1 :closLang$exp) (v4 :tra) (n :num). fv n [Tick v4 x1] <=> fv n [x1]) /\ (!(xs :closLang$exp list) (v5 :tra) (op :closLang$op) (n :num). fv n [Op v5 op xs] <=> fv n xs) /\ (!(x2 :closLang$exp list) (x1 :closLang$exp) (v6 :tra) (n :num) (loc_opt :num option). fv n [(App v6 loc_opt x1 x2 :closLang$exp)] <=> fv n [x1] \/ fv n x2) /\ (!(x1 :closLang$exp) (vs :num list option) (v7 :mlstring) (num_args :num) (n :num) (loc :num option). fv n [Fn v7 loc vs num_args x1] <=> fv (n + num_args) [x1]) /\ (!(x1 :closLang$exp) (vs :num list option) (v8 :mlstring list) (n :num) (loc :num option) (fns :(num # closLang$exp) list). fv n [(Letrec v8 loc vs fns x1 :closLang$exp)] <=> EXISTS (\((num_args :num),(x :closLang$exp)). fv (n + num_args + LENGTH fns) [x]) fns \/ fv (n + LENGTH fns) [x1]) /\ (!(x2 :closLang$exp) (x1 :closLang$exp) (v9 :tra) (n :num). fv n [(Handle v9 x1 x2 :closLang$exp)] <=> fv n [x1] \/ fv (n + (1 :num)) [x2]) /\ !(xs :closLang$exp list) (v10 :tra) (ticks :num) (n :num) (dest :num). fv n [Call v10 ticks dest xs] <=> fv n xs
fv1_def=!(v :num) (e :closLang$exp). fv1 v e <=> fv v [e]
env_rel_type=:('a -> 'b -> bool) -> 'a list -> 'b list -> num -> (num # closLang$exp) list -> bool
env_rel_def=!(R :'a -> 'b -> bool) (env1 :'a list) (env2 :'b list) (a :num) (es :(num # closLang$exp) list). env_rel R env1 env2 a es <=> if LENGTH env1 = LENGTH env2 then LIST_REL R env1 env2 else !(x :num). EXISTS (\((n :num),(p :closLang$exp)). fv1 (n + a + x) p) es ==> x < LENGTH env1 /\ x < LENGTH env2 /\ R (fEL env1 x) (fEL env2 x)
env_rel_mono=(!(x :'a) (y :'b). MEM x (env1 :'a list) /\ MEM y (env2 :'b list) /\ (R :'a -> 'b -> bool) x y ==> (R' :'a -> 'b -> bool) x y) ==> env_rel R env1 env2 (a :num) (es :(num # closLang$exp) list) ==> env_rel R' env1 env2 a es
env_rel_cong=(!(x :'a) (y :'b). MEM x (env1 :'a list) /\ MEM y (env2 :'b list) ==> ((R :'a -> 'b -> bool) x y <=> (R' :'a -> 'b -> bool) x y)) ==> (env_rel R env1 env2 (a :num) (es :(num # closLang$exp) list) <=> env_rel R' env1 env2 a es)
fv_cases=(T,T,T,T)
fv_negative=(F,F,F,F)
env_cases=(T,F,F,T)
