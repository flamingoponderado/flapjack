fperm_exp_ids_typed=∀(f :mlstring) (g :mlstring) (pan_code :α decl list). MAP ((exp_ids :α panLang$prog -> mlstring list) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions (fperm_decs f g pan_code)) = MAP ((exp_ids :α panLang$prog -> mlstring list) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions pan_code)
function_names_compile_prog_typed=∀(pan_code :α decl list). MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (compile_prog pan_code :α decl list)) = MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)
function_names_structs_compile_top_typed=∀(pan_code :α decl list). MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (compile_top pan_code :α decl list)) = MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)
functions_FILTER_nil_typed=functions (FILTER (is_exn_decl :α decl -> bool) (xs :α decl list)) = ([] :(mlstring # (mlstring # shape) list # α panLang$prog # shape) list)
functions_compile_decs_exns_typed=functions (FST (SND (SND (compile_decs (ctxt :α pan_globals$context) (prog :α decl list) :α panLang$prog list # α decl list # α decl list # α pan_globals$context)))) = ([] :(mlstring # (mlstring # shape) list # α panLang$prog # shape) list)
functions_resort_decls_typed=functions (resort_decls (xs :α decl list)) = functions xs
get_eids_pan_simp_compile_eq_typed=∀(prog :α decl list). FDOM (get_eids_from_decls prog) = FDOM (get_eids_from_decls (compile_prog prog :α decl list))
globals_allocatable_def_typed=∀(s :(α, 'ffi) panSem$state) (pan_code :β decl list). globals_allocatable s pan_code ⇔ (let (dec_shs :shape list) = dec_shapes pan_code; (struct_ctxt :(mlstring # struct_info) list option) = decs_stcnames ([] :(mlstring # struct_info) list) pan_code; (sz :num) = (SUM (MAP (size_of_sh_with_ctxt (THE struct_ctxt)) dec_shs) :num) in struct_ctxt ≠ (NONE :(mlstring # struct_info) list option) ∧ DISJOINT s.memaddrs (addresses s.top_addr sz) ∧ s.top_addr + (bytes_in_word :α word) * (n2w sz :α word) ∉ s.memaddrs ∧ sz * w2n (bytes_in_word :α word) < dimword (:α))
good_panops_def_typed=(good_panops (Function (fi :α fun_decl)) ⇔ EVERY (every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num))) (exps_of fi.body :α panLang$exp list)) ∧ (good_panops (Decl (sh :shape) (v :mlstring) (exp :α panLang$exp)) ⇔ every_exp (λ(x :α panLang$exp). ∀(op :panop) (es :α panLang$exp list). x = Panop op es ⇒ LENGTH es = (2 :num)) exp) ∧ (good_panops (ExnDecl (v5 :mlstring) (v6 :shape) :α decl) ⇔ T) ∧ (good_panops (Name (v7 :mlstring) (v8 :(mlstring # shape) list) :α decl) ⇔ T)
load_globals_alt_typed=∀(ad :word5) (n :num). (load_globals ad n :α crepLang$exp list) = GENLIST (λ(n :num). (LoadGlob (ad + (n2w n :word5)) :α crepLang$exp)) n
lookup_first_name_compile_prog_main_typed=FLOOKUP (make_funcs (crep_code :(mlstring # num list # α crepLang$prog) list) :mlstring |-> num # num) «main» = SOME (first_name,(0 :num)) ⇒ ∃(prog :α loopLang$prog). lookup first_name (fromAList (compile_prog (c :architecture) crep_code :(num # num list # α loopLang$prog) list)) = SOME (([] :num list),prog)
loop_state_def_typed=∀(s :(α, 'ffi) crepSem$state) (c :architecture) (crep_code :(mlstring # num list # α crepLang$prog) list) (ck :num) (mem :α word -> α word_loc). loop_state s c crep_code ck mem = <|locals := (LN :α word_loc sptree$num_map); globals := (FEMPTY :word5 |-> α word_loc); memory := mem; mdomain := s.memaddrs; sh_mdomain := s.sh_memaddrs; code := fromAList (compile_prog c crep_code :(num # num list # α loopLang$prog) list); clock := ck; be := s.be; ffi := s.ffi; top_addr := s.top_addr; base_addr := s.base_addr|>
loop_state_simps_typed=∀(s :(α, β) crepSem$state) (c :architecture) (crep_code :(mlstring # num list # α crepLang$prog) list) (ck :num) (mem :α word -> α word_loc). (loop_state s c crep_code ck mem).memory = mem ∧ (loop_state s c crep_code ck mem).mdomain = s.memaddrs ∧ (loop_state s c crep_code ck mem).sh_mdomain = s.sh_memaddrs ∧ (loop_state s c crep_code ck mem).clock = ck ∧ ((loop_state s c crep_code ck mem).be ⇔ s.be) ∧ (loop_state s c crep_code ck mem).ffi = s.ffi ∧ (loop_state s c crep_code ck mem).base_addr = s.base_addr ∧ (loop_state s c crep_code ck mem).top_addr = s.top_addr ∧ (loop_state s c crep_code ck mem).globals = (FEMPTY :word5 |-> α word_loc) ∧ isEmpty (loop_state s c crep_code ck mem).locals ∧ (loop_state s c crep_code ck mem).code = fromAList (compile_prog c crep_code :(num # num list # α loopLang$prog) list)
map_map2_fst_lemma_typed=∀(xs :α list) (ys :β list). MAP (FST :α # β -> α) (MAP2 (λ(x :α) (y :β). (x,y)) xs ys :(α # β) list) = TAKE (MIN (LENGTH xs) (LENGTH ys)) xs
no_labels_def_typed=∀(mem :α -> β word_loc) (dom :α -> bool). no_labels mem dom ⇔ ∀(a :α). a ∈ dom ⇒ ∃(w :β word). mem a = (Word w :β word_loc)
no_names_compile_prog_typed=EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) (pan_code :α decl list) ⇒ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) (compile_prog pan_code :α decl list)
pan_exps_of_nested_seq_typed=∀(es :α panLang$prog list). (exps_of (nested_seq es) :α panLang$exp list) = FLAT (MAP (exps_of :α panLang$prog -> α panLang$exp list) es)
pan_to_word_compile_lab_pres_typed=(compile_prog (c :architecture) (prog :α decl list) :(num # num # α prog) list) = (prog' :(num # num # α prog) list) ⇒ EVERY (λ((n :num),(m :num),(p :α prog)). (let (labs :(num # num) list) = extract_labels p in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) labs ∧ ALL_DISTINCT labs)) prog'
pan_to_word_compile_prog_lab_min_typed=(compile_prog (c :architecture) (pprog :α decl list) :(num # num # α prog) list) = (wprog :(num # num # α prog) list) ⇒ EVERY (λ(prog :num # num # α prog). (60 :num) ≤ FST prog) wprog
pan_to_word_compile_prog_no_alloc_code_typed=(compile_prog (c :architecture) (prog :α decl list) :(num # num # α prog) list) = (prog' :(num # num # α prog) list) ⇒ no_alloc_code (fromAList prog')
pan_to_word_compile_prog_no_install_code_typed=(compile_prog (c :architecture) (prog :α decl list) :(num # num # α prog) list) = (prog' :(num # num # α prog) list) ⇒ no_install_code (fromAList prog')
pan_to_word_compile_prog_no_mt_code_typed=(compile_prog (c :architecture) (prog :α decl list) :(num # num # α prog) list) = (prog' :(num # num # α prog) list) ⇒ no_mt_code (fromAList prog')
pan_to_word_every_inst_ok_less_typed=(compile_prog (c :α asm_config).ISA (pan_code :α decl list) :(num # num # α prog) list) = (wprog0 :(num # num # α prog) list) ∧ byte_offset_ok c (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ EVERY (good_panops :α decl -> bool) pan_code ⇒ EVERY (λ((n :num),(m :num),(p :α prog)). every_inst (inst_ok_less c) p) wprog0
pan_to_word_good_handlers_typed=(compile_prog (c :architecture) (prog :α decl list) :(num # num # α prog) list) = (prog' :(num # num # α prog) list) ⇒ EVERY (λ((n :num),(m :num),(pp :α prog)). word_good_handlers n pp) prog'
semantics_decls_decl_structs_typed=semantics_decls (s :(α, β) panSem$state) (start :mlstring) (pan_code :α decl list) ≠ Fail ⇒ ∃(s_ctxt :(mlstring # struct_info) list). decs_stcnames ([] :(mlstring # struct_info) list) pan_code = SOME s_ctxt
semantics_decls_has_main_prime_typed=(s :(α, β) panSem$state).code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (code :α decl list))) ∧ semantics_decls s (start :mlstring) code ≠ Fail ⇒ ∃(body :α panLang$prog) (rshape :shape). ALOOKUP (functions code) start = SOME (([] :(mlstring # shape) list),body,rshape)
semantics_size_decs_stcnames_compile_structs_typed=semantics_decls (s :(α, β) panSem$state) (nm :mlstring) (pan_code :α decl list) ≠ Fail ∧ s.globals = (FEMPTY :mlstring |-> α panSem$v) ⇒ MAP size_of_shape (dec_shapes (compile_top pan_code :α decl list)) = MAP (size_of_sh_with_ctxt (THE (decs_stcnames ([] :(mlstring # struct_info) list) pan_code))) (dec_shapes pan_code)
size_decs_stcnames_compile_decs_structs_typed=∀(s :(α, β) panSem$state) (pan_code :α decl list) (ctxt :pan_structs$context) (s' :(α, β) panSem$state) (code' :α decl list) (ctxt' :pan_structs$context). evaluate_decls s pan_code = SOME s' ∧ (compile_decs ctxt pan_code :α decl list # pan_structs$context) = (code',ctxt') ∧ struct_infos_ok s.structs ∧ FEVERY (λ((nm :mlstring),(v :α panSem$v)). is_wf_shape_v s.structs v) s.globals ∧ ctxt.structs = MAP (λ((nm :mlstring),(info :struct_info)). (nm,info.fields)) s.structs ⇒ MAP size_of_shape (dec_shapes code') = MAP (size_of_sh_with_ctxt s.structs) (dec_shapes pan_code)
size_of_eids_compile_top_typed=ALOOKUP (functions (pan_code :α decl list)) (main :mlstring) = SOME ((args :(mlstring # shape) list),(body :α panLang$prog),(rshape :shape)) ⇒ size_of_eids (compile_top pan_code main :α decl list) = size_of_eids pan_code
state_rel_imp_semantics_typed=(∀(addr' :α word). addr' ∈ (s :(α, 'ffi) panSem$state).memaddrs ⇒ ((t :(α, β, 'ffi) wordSem$state).memory addr' :α word_loc) = wlab_wloc (s.memory addr' :α word_lab)) ∧ no_labels t.memory t.mdomain ∧ (start :mlstring) = «main» ∧ (globals_size :num) = (let (dec_shs :shape list) = dec_shapes (pan_code :α decl list); (struct_ctxt :(mlstring # struct_info) list option) = decs_stcnames ([] :(mlstring # struct_info) list) pan_code in (SUM (MAP (size_of_sh_with_ctxt (THE struct_ctxt)) dec_shs) :num)) ∧ distinct_params (functions pan_code) ∧ t.mdomain = s.memaddrs ∪ addresses s.top_addr globals_size ∧ t.sh_mdomain = s.sh_memaddrs ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ ALOOKUP (fmap_to_alist t.store) CurrHeap = SOME (Word s.base_addr :α word_loc) ∧ ALOOKUP (fmap_to_alist t.store) HeapLength = SOME (Word (heap_len :α word) :α word_loc) ∧ s.top_addr = s.base_addr + (2w :α word) * heap_len − (bytes_in_word :α word) * (n2w globals_size :α word) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ byte_aligned s.top_addr ∧ globals_allocatable s pan_code ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ t.code = fromAList (compile_prog (c :architecture) pan_code :(num # num # α prog) list) ∧ s.globals = (FEMPTY :mlstring |-> α panSem$v) ∧ s.locals = (FEMPTY :mlstring |-> α panSem$v) ∧ size_of_eids pan_code < dimword (:α) ∧ s.eshapes = (FEMPTY :mlstring |-> shape) ∧ lookup (0 :num) t.locals = SOME (Loc (1 :num) (0 :num) :α word_loc) ∧ good_dimindex (:α) ∧ semantics_decls s start pan_code ≠ Fail ⇒ (semantics t first_name :behaviour) = semantics_decls s start pan_code
wloc_wlab_def_typed=∀(w :α word). wloc_wlab (Word w :α word_loc) = (Word w :α word_lab)
wloc_wlab_wlab_wloc_typed=wloc_wlab (wlab_wloc (w :α word_lab)) = w
FDOM_get_eids_structs_compile_decs_eq_typed=∀(ctxt :pan_structs$context) (prog :α decl list). FDOM (get_eids_from_decls prog) = FDOM (get_eids_from_decls (FST (compile_decs ctxt prog :α decl list # pan_structs$context)))
FDOM_get_eids_structs_compile_eq_typed=FDOM (get_eids_from_decls (compile_top (prog :α decl list) :α decl list)) = FDOM (get_eids_from_decls prog)
exp_ids_structs_compile_typed=∀(ctxt :pan_structs$context) (prog :α panLang$prog). exp_ids (compile ctxt prog :α panLang$prog) = exp_ids prog
