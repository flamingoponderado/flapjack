ALL_DISTINCT_MAP_INJ_o_typed=∀(ls :α list) (f :α -> β). (∀(x :α) (y :α). MEM x ls ∧ MEM y ls ∧ f x = f y ⇒ x = y) ∧ ALL_DISTINCT ls ⇒ ALL_DISTINCT (MAP f ls)
