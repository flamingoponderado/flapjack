crep_op_def_typed=crep_op Mul [(w1 :α word); (w2 :α word)] = SOME (w1 * w2) ∧ crep_op Mul ([] :α word list) = (NONE :α word option) ∧ crep_op Mul [(v3 :α word)] = (NONE :α word option) ∧ crep_op Mul (v3::(v7 :α word)::(v11 :α word)::(v12 :α word list)) = (NONE :α word option)
crep_primop_def_typed=∀(args :α word_lab list). crep_primop AddCarry args = if LENGTH args = (3 :num) ∧ EVERY (isWord :α word_lab -> bool) args then (let (l :α word) = theWord args❲(0 :num)❳; (r :α word) = theWord args❲(1 :num)❳; (ci :α word) = theWord args❲(2 :num)❳; ((res :α word),(co :α word)) = word_add_carry l r ci in SOME [(Word res :α word_lab); (Word co :α word_lab)]) else (NONE :α word_lab list option)
clock_eq_simp_typed=(set_var (v :num) (w :α word_lab) (s :(α, β) state)).clock = s.clock ∧ (empty_locals s).clock = s.clock ∧ (set_globals (gv :word5) w s).clock = s.clock
sh_mem_op_clock_typed=(sh_mem_op (op :memop) (v :num) (addr :β word) (s :(β, γ) state) :α result option # (β, γ) state) = ((r :α result option),(s' :(β, γ) state)) ⇒ s'.clock = s.clock
