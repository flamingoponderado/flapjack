ALL_DISTINCT_set_INJ_typed=∀(ls :α list) (col :α -> β). ALL_DISTINCT (MAP col ls) ⇒ INJ col (set ls) 𝕌(:β)
GT_TRANS_typed=(a :num) > (b :num) ∧ b > (c :num) ⇒ a > c
GT_sorted_eq_typed=SORTED $> ((x :num)::(L :num list)) ⇔ SORTED $> L ∧ ∀(y :num). MEM y L ⇒ x > y
INJ_less_typed=∀(f :α -> β) (s' :α -> bool) (t :β -> bool) (s :α -> bool). INJ f s' t ∧ s ⊆ s' ⇒ INJ f s t
MEM_MAP_IMAGE_typed=(λ(x :α). MEM x (MAP (f :β -> α) (l :β list))) = IMAGE f (set l)
MEM_smerge_typed=∀(xs :(num # α) list) (ys :(num # α) list). MEM (x :num # α) (smerge xs ys) ⇔ MEM x xs ∨ MEM x ys
SORTED_HEAD_LT_typed=∀(ls :num list). (col :num) < (h :num) ∧ SORTED (λ(x :num) (y :num). x ≤ y) (h::ls) ⇒ ¬MEM col ls
UNION_DIFF_3_typed=(s :α -> bool) DIFF (t :α -> bool) ∪ t = s ∪ t
assign_Atemps_FOREACH_lem_typed=∀(ls :num list) (s :ra_state) (ks :num list) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state). good_ra_state s ∧ no_clash s.adj_ls s.node_tag ∧ good_pref prefs ∧ EVERY (λ(v :num). v < s.dim) ls ⇒ ∃(s' :ra_state). st_ex_FOREACH ls (assign_Atemp_tag ks prefs) s = ((M_success () :(unit, state_exn) exc),s') ∧ no_clash s'.adj_ls s'.node_tag ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag ∧ ∀(m :num). if MEM m ls ∧ s.node_tag❲m❳ = Atemp then s'.node_tag❲m❳ ≠ Atemp else s'.node_tag❲m❳ = s.node_tag❲m❳
assign_Stemps_FOREACH_lem_typed=∀(ls :num list) (s :ra_state) (k :num). good_ra_state s ∧ no_clash s.adj_ls s.node_tag ∧ EVERY (λ(v :num). v < s.dim) ls ∧ good_neg_pref k (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) ⇒ ∃(s' :ra_state). st_ex_FOREACH ls (assign_Stemp_tag k prefs) s = ((M_success () :(unit, state_exn) exc),s') ∧ no_clash s'.adj_ls s'.node_tag ∧ good_ra_state s' ∧ (∀(m :num). if MEM m ls ∧ s.node_tag❲m❳ = Stemp then ∃(k' :num). s'.node_tag❲m❳ = Fixed k' ∧ k ≤ k' else s'.node_tag❲m❳ = s.node_tag❲m❳) ∧ s' = s with node_tag := s'.node_tag
bg_ok_success_typed=good_ra_state (s :ra_state) ∧ (x :num) < s.dim ∧ (y :num) < s.dim ⇒ ∃(opt :(num list # num list) option). bg_ok (k :num) x y s = ((M_success opt :((num list # num list) option, state_exn) exc),s) ∧ case opt of (NONE :(num list # num list) option) => T | SOME (case1,case2) => EVERY (λ(v :num). v < s.dim) case1 ∧ EVERY (λ(v :num). v < s.dim) case2
canonize_move_success_typed=(x :num) < (s :ra_state).dim ∧ (y :num) < s.dim ∧ good_ra_state s ⇒ ∃(x2 :num) (y2 :num). canonize_move x y s = ((M_success (x2,y2) :(num # num, state_exn) exc),s) ∧ x2 < s.dim ∧ y2 < s.dim
coalesce_parent_success_typed=∀(x :num) (s :ra_state). x < s.dim ∧ good_ra_state s ⇒ ∃(y :num) (s' :ra_state) (coal :num list). coalesce_parent x s = ((M_success y :(num, state_exn) exc),s') ∧ y < s.dim ∧ good_ra_state s' ∧ s' = s with coalesced := coal
consistency_ok_success_typed=∀(x :num) (y :num) (s :ra_state). good_ra_state s ∧ x < s.dim ∧ y < s.dim ⇒ ∃(b :bool). consistency_ok x y s = ((M_success b :(bool, state_exn) exc),s) ∧ (b ⇒ x < s.dim ∧ y < s.dim)
dec_deg_success_typed=∀(ls :num list) (s :ra_state). EVERY (λ(v :num). v < s.dim) ls ∧ good_ra_state s ⇒ ∃(d :num list). st_ex_FOREACH ls dec_deg s = ((M_success () :(unit, state_exn) exc),s with degrees := d) ∧ LENGTH d = LENGTH s.degrees
dec_degree_success_typed=∀(ls :num list) (s :ra_state). good_ra_state s ⇒ ∃(d :num list). st_ex_FOREACH ls dec_degree s = ((M_success () :(unit, state_exn) exc),s with degrees := d) ∧ LENGTH d = LENGTH s.degrees
do_alloc1_success_typed=good_ra_state (s :ra_state) ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) (moves :(num # num # num) list) ⇒ ∃(ls :num list) (s' :ra_state). do_alloc1 moves (scost :num sptree$num_map option) (k :num) s = ((M_success ls :(num list, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s'.dim = s.dim ∧ s'.node_tag = s.node_tag
do_coalesce_real_success_typed=∀(x :num) (y :num) (case1 :num list) (case2 :num list) (s :ra_state). y < s.dim ∧ x < s.dim ∧ EVERY (λ(v :num). v < s.dim) case1 ∧ EVERY (λ(v :num). v < s.dim) case2 ∧ good_ra_state s ⇒ ∃(s' :ra_state). do_coalesce_real x y case1 case2 s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
do_coalesce_success_typed=∀(s :ra_state). good_ra_state s ⇒ ∃(s' :ra_state) (b :bool). do_coalesce (k :num) s = ((M_success b :(bool, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
do_freeze_success_typed=∀(s :ra_state). good_ra_state s ⇒ ∃(s' :ra_state) (b :bool). do_freeze (k :num) s = ((M_success b :(bool, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
do_prefreeze_success_typed=∀(s :ra_state). good_ra_state s ⇒ ∃(s' :ra_state) (b :bool). do_prefreeze (k :num) s = ((M_success b :(bool, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
do_simplify_success_typed=∀(s :ra_state). good_ra_state s ⇒ ∃(s' :ra_state) (b :bool). do_simplify (k :num) s = ((M_success b :(bool, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
do_spill_success_typed=∀(s :ra_state). good_ra_state s ⇒ ∃(s' :ra_state) (b :bool). do_spill (scost :num sptree$num_map option) (k :num) s = ((M_success b :(bool, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
do_step_success_typed=∀(scost :num sptree$num_map option) (k :num) (s :ra_state). good_ra_state s ⇒ ∃(b :bool) (s' :ra_state). do_step scost k s = ((M_success b :(bool, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
domain_eq_IMAGE_typed=(domain (s :α sptree$num_map) :num -> bool) = IMAGE (FST :num # α -> num) (set (toAList s))
extract_color_st_ex_MAP_lem_typed=∀(ls :(α # num) list) (s :ra_state). EVERY (λ((k :α),(v :num)). v < LENGTH s.node_tag) ls ⇒ st_ex_MAP (λ((k :α),(v :num)). do (t :tag) <- node_tag_sub v; (st_ex_return (k,extract_tag t) :ra_state -> (α # num, state_exn) exc # ra_state) od) ls s = ((M_success (MAP (λ((k :α),(v :num)). (k,extract_tag s.node_tag❲v❳)) ls) :((α # num) list, state_exn) exc),s)
first_match_col_correct_typed=∀(x :num list) (ks :num list) (s :ra_state). ∃(res :(num option, state_exn) exc). first_match_col ks x s = (res,s) ∧ case res of (M_success (NONE :num option) :(num option, state_exn) exc) => T | (M_success (SOME k) :(num option, state_exn) exc) => MEM k ks | (M_failure v :(num option, state_exn) exc) => v = Subscript
full_consistency_ok_success_typed=∀(x :num) (y :num) (s :ra_state). good_ra_state s ⇒ ∃(b :bool). full_consistency_ok (k :num) x y s = ((M_success b :(bool, state_exn) exc),s) ∧ (b ⇒ x < s.dim ∧ y < s.dim)
is_clique_FILTER_typed=∀(ls :num list). is_clique ls (G :num list list) ⇒ is_clique (FILTER (P :num -> bool) ls) G
is_clique_subgraph_typed=is_clique (ls :num list) (s :num list list) ∧ is_subgraph s (s' :num list list) ⇒ is_clique ls s'
is_not_coalesced_succeeds_typed=good_ra_state (s :ra_state) ∧ (n :num) < s.dim ⇒ ∃(b :bool). is_not_coalesced n s = ((M_success b :(bool, state_exn) exc),s)
list_remap_domain_typed=∀(ls :num list) (ta :num sptree$num_map) (fa :num sptree$num_map) (n :num) (ta' :num sptree$num_map) (fa' :num sptree$num_map) (n' :num). list_remap ls (ta,fa,n) = (ta',fa',n') ⇒ (domain ta' :num -> bool) = (domain ta :num -> bool) ∪ set ls
list_remap_wf_typed=∀(l :num list) (ta :num sptree$num_map) (fa :num sptree$num_map) (n :num) (ta' :num sptree$num_map) (fa' :num sptree$num_map) (n' :num). list_remap l (ta,fa,n) = (ta',fa',n') ∧ wf ta ∧ wf fa ⇒ wf ta' ∧ wf fa'
mk_bij_aux_domain_typed=∀(ct :clash_tree) (ta :num sptree$num_map) (fa :num sptree$num_map) (n :num) (ta' :num sptree$num_map) (fa' :num sptree$num_map) (n' :num). mk_bij_aux ct (ta,fa,n) = (ta',fa',n') ⇒ (domain ta' :num -> bool) = (domain ta :num -> bool) ∪ {x | in_clash_tree ct x}
mk_tags_st_ex_FOREACH_lem_typed=∀(ls :num list) (s :ra_state) (fa :num -> num). good_ra_state s ∧ EVERY (λ(v :num). v < s.dim) ls ⇒ ∃(s' :ra_state). st_ex_FOREACH ls (λ(i :num). if fa i MOD (4 :num) = (1 :num) then case lookup (fa i) (fs :sptree$num_set) of (NONE :unit option) => update_node_tag i Atemp | SOME v => update_node_tag i Stemp else if fa i MOD (4 :num) = (3 :num) then update_node_tag i Stemp else update_node_tag i (Fixed (fa i DIV (2 :num)))) s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with node_tag := s'.node_tag ∧ ∀(x :num). x < s.dim ⇒ if MEM x ls then if is_phy_var (fa x) then s'.node_tag❲x❳ = Fixed (fa x DIV (2 :num)) else if is_stack_var (fa x) then s'.node_tag❲x❳ = Stemp else s'.node_tag❲x❳ = Atemp ∨ s'.node_tag❲x❳ = Stemp else s'.node_tag❲x❳ = s.node_tag❲x❳
neg_first_match_col_correct_typed=∀(x :num list) (ks :num list) (s :ra_state). ∃(res :(num option, state_exn) exc). neg_first_match_col (k :num) ks x s = (res,s) ∧ case res of (M_success (NONE :num option) :(num option, state_exn) exc) => T | (M_success (SOME c) :(num option, state_exn) exc) => ¬MEM c ks ∧ k ≤ c | (M_failure v :(num option, state_exn) exc) => v = Subscript
no_clash_LUPDATE_Fixed_typed=undirected (adjls :num list list) ∧ EVERY (λ(ls :num list). EVERY (λ(v :num). v < LENGTH (tags :tag list)) ls) adjls ∧ (n :num) < LENGTH adjls ∧ (∀(m :num). MEM m adjls❲n❳ ∧ m < LENGTH tags ⇒ tags❲m❳ ≠ Fixed (x :num)) ∧ no_clash adjls tags ⇒ no_clash adjls tags❲n ↦ Fixed x❳
no_clash_LUPDATE_Stemp_typed=no_clash (adjls :num list list) (tags :tag list) ⇒ no_clash adjls tags❲(n :num) ↦ Stemp❳
opt_split_typed=(a :unit option) ≠ (NONE :unit option) ⇔ a = SOME ()
push_stack_success_typed=∀(ls :num list) (s :ra_state). EVERY (λ(x :num). x < s.dim) ls ∧ good_ra_state s ⇒ ∃(d :num list) (mr :bool list) (st :num list). st_ex_FOREACH ls push_stack s = ((M_success () :(unit, state_exn) exc),s with <|degrees := d; move_related := mr; stack := st|>) ∧ LENGTH d = LENGTH s.degrees ∧ LENGTH mr = LENGTH s.move_related
remove_colours_succeeds_typed=∀(adj :num list) (ks :num list) (s :α) (s :ra_state). EVERY (λ(v :num). v < LENGTH s.node_tag) adj ⇒ ∃(ls :num list). remove_colours adj ks s = ((M_success ls :(num list, state_exn) exc),s)
reset_move_related_success_typed=∀(ls :(α # num # num) list) (s :ra_state). good_ra_state s ∧ EVERY (λ((p :α),(x :num),(y :num)). x < s.dim ∧ y < s.dim) ls ⇒ ∃(mv :bool list). reset_move_related ls s = ((M_success () :(unit, state_exn) exc),s with move_related := mv) ∧ LENGTH mv = s.dim
revive_moves_success_typed=EVERY (λ(x :num). x < LENGTH (s :ra_state).adj_ls) (ls :num list) ⇒ ∃(s' :ra_state). revive_moves ls s = ((M_success () :(unit, state_exn) exc),s') ∧ s' = s with <|avail_moves_wl := s'.avail_moves_wl; unavail_moves_wl := s'.unavail_moves_wl|> ∧ EVERY (λ(x :num # num # num). MEM x (s.avail_moves_wl ++ s.unavail_moves_wl)) s'.avail_moves_wl ∧ EVERY (λ(x :num # num # num). MEM x (s.avail_moves_wl ++ s.unavail_moves_wl)) s'.unavail_moves_wl
rpt_do_step_success_typed=∀(n :num) (s :ra_state) (k :num) (sc :α). good_ra_state s ⇒ ∃(s' :ra_state). rpt_do_step (scost :num sptree$num_map option) k n s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
set_FILTER_typed=set (FILTER (P :α -> bool) (live :α list)) = set live DIFF (λ(x :α). ¬P x)
sorted_insert_correct_lem_typed=∀(ls :num list) (acc :num list). SORTED $> ls ∧ SORTED $> (REVERSE acc) ∧ SORTED $> (REVERSE acc ++ ls) ∧ EVERY (λ(y :num). y > (x :num)) acc ⇒ hide (SORTED $> (sorted_insert x acc ls) ∧ ∀(z :num). MEM z (sorted_insert x acc ls) ⇔ x = z ∨ MEM z ls ∨ MEM z acc)
st_ex_FILTER_considered_var_typed=∀(ls :num list) (acc :num list) (s :ra_state). EVERY (λ(x :num). x < LENGTH s.node_tag) ls ∧ EVERY (λ(x :num). x < LENGTH s.node_tag) acc ⇒ ∃(ts :num list) (fs :α). st_ex_FILTER (considered_var (k :num)) ls acc s = ((M_success ts :(num list, state_exn) exc),s) ∧ EVERY (λ(x :num). x < LENGTH s.node_tag) ts
st_ex_FILTER_consistency_ok_typed=∀(ls :(num # num # num) list) (acc :(num # num # num) list) (s :ra_state). good_ra_state s ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) ls ⇒ ∃(ts :(num # num # num) list). st_ex_FILTER (λ((_0 :num),(x :num),(y :num)). consistency_ok x y) ls acc s = ((M_success ts :((num # num # num) list, state_exn) exc),s) ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim ∨ MEM (p,x,y) acc) ts
st_ex_FILTER_full_consistency_ok_typed=∀(ls :(α # num # num) list) (acc :(α # num # num) list) (s :ra_state). good_ra_state s ⇒ ∃(ts :(α # num # num) list). st_ex_FILTER (λ((_0 :α),(x :num),(y :num)). full_consistency_ok (k :num) x y) ls acc s = ((M_success ts :((α # num # num) list, state_exn) exc),s) ∧ EVERY (λ((p :α),(x :num),(y :num)). x < s.dim ∧ y < s.dim ∨ MEM (p,x,y) acc) ts
st_ex_FILTER_is_not_coalesced_typed=∀(ls :num list) (acc :num list) (s :ra_state). EVERY (λ(x :num). x < LENGTH s.coalesced) ls ∧ EVERY (λ(x :num). x < LENGTH s.coalesced) acc ⇒ ∃(ts :num list) (fs :α). st_ex_FILTER is_not_coalesced ls acc s = ((M_success ts :(num list, state_exn) exc),s) ∧ EVERY (λ(x :num). x < LENGTH s.coalesced) ts
st_ex_FIRST_consistency_ok_bg_ok_typed=∀(ls :(num # num # num) list) (acc :(num # num # num) list) (s :ra_state). good_ra_state s ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) ls ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) acc ⇒ ∃(ores :((num # num) # (num list # num list) # (num # num # num) list) option) (ys :(num # num # num) list) (s' :ra_state) (coal :num list). st_ex_FIRST consistency_ok (bg_ok (k :num)) ls acc s = ((M_success (ores,ys) :(((num # num) # (num list # num list) # (num # num # num) list) option # (num # num # num) list, state_exn) exc),s') ∧ good_ra_state s' ∧ s' = s with coalesced := coal ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) ys ∧ case ores of (NONE :((num # num) # (num list # num list) # (num # num # num) list) option) => T | SOME ((x,y),(case1,case2),rest) => x < s.dim ∧ y < s.dim ∧ EVERY (λ(v :num). v < s.dim) case1 ∧ EVERY (λ(v :num). v < s.dim) case2 ∧ EVERY (λ((p :num),(x :num),(y :num)). x < s.dim ∧ y < s.dim) rest
st_ex_FOREACH_update_move_related_typed=∀(ls :num list) (s :ra_state) (b :bool). EVERY (λ(v :num). v < LENGTH s.move_related) ls ⇒ ∃(lss :bool list). st_ex_FOREACH ls (λ(x :num). update_move_related x b) s = ((M_success () :(unit, state_exn) exc),s with move_related := lss) ∧ LENGTH lss = LENGTH s.move_related
st_ex_PARTITION_move_related_sub_typed=∀(atemps :num list) (lss :num list) (lss' :num list) (s :ra_state). EVERY (λ(x :num). x < LENGTH s.move_related) atemps ⇒ ∃(ts :num list) (fs :num list). st_ex_PARTITION move_related_sub atemps lss lss' s = ((M_success (ts,fs) :(num list # num list, state_exn) exc),s) ∧ EVERY (λ(x :num). MEM x lss ∨ MEM x atemps) ts ∧ EVERY (λ(x :num). MEM x lss' ∨ MEM x atemps) fs
st_ex_PARTITION_split_degree_typed=∀(atemps :num list) (k :num) (lss :num list) (lss' :num list) (s :ra_state). good_ra_state s ⇒ ∃(ts :num list) (fs :num list). st_ex_PARTITION (split_degree s.dim k) atemps lss lss' s = ((M_success (ts,fs) :(num list # num list, state_exn) exc),s) ∧ EVERY (λ(x :num). MEM x lss ∨ MEM x atemps) ts ∧ EVERY (λ(x :num). MEM x lss' ∨ MEM x atemps) fs
st_ex_list_MAX_deg_success_typed=∀(ls :num list) (s :ra_state) (k :num) (v :num) (acc :num list). good_ra_state s ∧ EVERY (λ(v :num). v < s.dim) acc ∧ k < s.dim ⇒ ∃(x :num) (y :num list). st_ex_list_MAX_deg ls s.dim k v acc s = ((M_success (x,y) :(num # num list, state_exn) exc),s) ∧ x < s.dim ∧ EVERY (λ(v :num). v < s.dim) y
st_ex_list_MIN_cost_success_typed=∀(ls :num list) (s :ra_state) (k :num) (v :num) (acc :num list). good_ra_state s ∧ EVERY (λ(v :num). v < s.dim) acc ∧ k < s.dim ⇒ ∃(x :num) (y :num list). st_ex_list_MIN_cost (scost :num sptree$num_map) ls s.dim k v acc s = ((M_success (x,y) :(num # num list, state_exn) exc),s) ∧ x < s.dim ∧ EVERY (λ(v :num). v < s.dim) y
unspill_success_typed=∀(k :num) (s :ra_state). good_ra_state s ⇒ ∃(s' :ra_state) (b :α). unspill k s = ((M_success () :(unit, state_exn) exc),s') ∧ good_ra_state s' ∧ is_subgraph s.adj_ls s'.adj_ls ∧ s.dim = s'.dim ∧ s.node_tag = s'.node_tag
