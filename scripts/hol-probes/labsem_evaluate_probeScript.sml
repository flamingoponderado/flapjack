val _ = computeLib.add_funs [fp64_to_float_def, float_to_fp64_def, fp64_negate_def];
(* Derived in the HOL kernel from the original definition: eliminate its
   existential Label match before recursively executing a JumpReg/Call. These
   are computation rules for the same declaration, not replacement semantics. *)
val lpc_label = (SIMP_CONV (srw_ss()) [Once loc_to_pc_def])
  ``loc_to_pc n1 n2 (Section k (Label a b len :: zs) :: ys)``;
val lpc_asm = (SIMP_CONV (srw_ss()) [Once loc_to_pc_def])
  ``loc_to_pc n1 n2 (Section k (Asm i bytes len :: zs) :: ys)``;
val lpc_labasm = (SIMP_CONV (srw_ss()) [Once loc_to_pc_def])
  ``loc_to_pc n1 n2 (Section k (LabAsm i pos bytes len :: zs) :: ys)``;
val _ = computeLib.add_funs [lpc_label, lpc_asm, lpc_labasm];
fun print_eval label q = (TextIO.output (TextIO.stdErr, label ^ "\n"); TextIO.flushOut TextIO.stdErr; print label; print "="; print_term (rconc ((EVAL THENC SIMP_CONV (srw_ss()) [arithmeticTheory.DIV_0, arithmeticTheory.MOD_0, byteTheory.set_byte_def, byteTheory.byte_index_def, byteTheory.word_slice_alt_def] THENC EVAL) q)); print "\n");
