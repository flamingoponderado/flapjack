data_to_word_proof_lab2_probe_begin=1
data_to_word_lab_pres_lem_typed=∀(c :data_to_word$config) (n :num) (l :num) (p :dataLang$prog). l ≠ (0 :num) ⇒ (let ((cp :α prog),(l' :num)) = (comp c n l p :α prog # num) in l ≤ l' ∧ EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l ≤ l2 ∧ l2 < l') (extract_labels cp) ∧ ALL_DISTINCT (extract_labels cp))
stub_labels_typed=EVERY (λ((n :num),(m :num),(p :α prog)). EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p)) (stubs (:α) (data_conf :data_to_word$config) :(num # num # α prog) list)
stubs_with_has_fp_ops_typed=(stubs (:α) ((data_conf :data_to_word$config) with has_fp_ops := (b :bool)) :(num # num # α prog) list) = (stubs (:α) data_conf :(num # num # α prog) list)
stubs_with_has_fp_tern_typed=(stubs (:α) ((data_conf :data_to_word$config) with has_fp_tern := (b :bool)) :(num # num # α prog) list) = (stubs (:α) data_conf :(num # num # α prog) list)
stubs_no_share_inst_typed=EVERY (λ(x :num # num # α prog). no_share_inst (SND (SND x))) (stubs (:α) (data_conf :data_to_word$config) :(num # num # α prog) list)
comp_no_share_inst_typed=∀(c :data_to_word$config) (secn :num) (l :num) (prog :dataLang$prog) (prog' :α prog) (l' :num). (comp c secn l prog :α prog # num) = (prog',l') ⇒ no_share_inst prog'
compile_no_share_inst_typed=(compile (data_conf :data_to_word$config) (word_conf :word_to_word$config) (asm_conf :α asm_config) (prog :(num # num # dataLang$prog) list) :num sptree$num_map option list # (num # num # α prog) list) = ((xx :num sptree$num_map option list),(prog' :(num # num # α prog) list)) ⇒ EVERY (λ((n :num),(m :num),(pp :α prog)). no_share_inst pp) prog'
data_to_word_compile_lab_pres_typed=let ((c :num sptree$num_map option list),(p :(num # num # α prog) list)) = (compile (data_conf :data_to_word$config) (word_conf :word_to_word$config) (asm_conf :α asm_config) (prog :(num # num # dataLang$prog) list) :num sptree$num_map option list # (num # num # α prog) list) in MAP (FST :num # num # α prog -> num) p = MAP (FST :num # num # α prog -> num) (stubs (:α) data_conf :(num # num # α prog) list) ++ MAP (FST :num # num # dataLang$prog -> num) prog ∧ EVERY (λ((n :num),(m :num),(p :α prog)). (let (labs :(num # num) list) = extract_labels p in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) labs ∧ ALL_DISTINCT labs)) p
assign_no_inst_typed=((a :data_to_word$config).has_longdiv ⇒ (ac :α asm_config).ISA = x86_64) ∧ (a.has_div ⇒ ac.ISA ∈ {ARMv8; MIPS; RISC_V}) ∧ (a.has_fp_ops ⇒ (1 :num) < ac.fp_reg_count) ∧ (a.has_fp_tern ⇒ (2 :num) < ac.fp_reg_count ∧ ac.ISA = ARMv7) ∧ addr_offset_ok ac (0w :α word) ∧ byte_offset_ok ac (0w :α word) ⇒ every_inst (inst_ok_less ac) (FST (assign a (b :num) (c :num) (d :num) (e :closLang$op) (f :num list) (g :sptree$num_set option) :α prog # num))
comp_no_inst_typed=∀(c :data_to_word$config) (n :num) (m :num) (p :dataLang$prog). ((c.has_longdiv ⇒ (ac :α asm_config).ISA = x86_64) ∧ (c.has_div ⇒ ac.ISA ∈ {ARMv8; MIPS; RISC_V}) ∧ (c.has_fp_ops ⇒ (1 :num) < ac.fp_reg_count) ∧ (c.has_fp_tern ⇒ (2 :num) < ac.fp_reg_count ∧ ac.ISA = ARMv7)) ∧ addr_offset_ok ac (0w :α word) ∧ byte_offset_ok ac (0w :α word) ⇒ every_inst (inst_ok_less ac) (FST (comp c n m p :α prog # num))
data_to_word_compile_conventions_typed=good_dimindex (:α) ⇒ (let ((c :num sptree$num_map option list),(p :(num # num # α prog) list)) = (compile (data_conf :data_to_word$config) (wc :word_to_word$config) (ac :α asm_config) (prog :(num # num # dataLang$prog) list) :num sptree$num_map option list # (num # num # α prog) list) in EVERY (λ((n :num),(m :num),(prog :α prog)). flat_exp_conventions prog ∧ post_alloc_conventions (ac.reg_count − ((5 :num) + LENGTH ac.avoid_regs)) prog ∧ ((data_conf.has_longdiv ⇒ ac.ISA = x86_64) ∧ (data_conf.has_div ⇒ ac.ISA ∈ {ARMv8; MIPS; RISC_V}) ∧ addr_offset_ok ac (0w :α word) ∧ hw_offset_ok ac (0w :α word) ∧ (∀(w :α word). -(8w :α word) ≤ w ∧ w ≤ (8w :α word) ⇒ byte_offset_ok ac w) ⇒ full_inst_ok_less ac prog) ∧ (ac.two_reg_arith ⇒ every_inst (two_reg_inst :α inst -> bool) prog) ∧ (no_share_inst prog ∨ ac.ISA ≠ Ag32)) p)
data_to_word_names_typed=(compile (c1 :word_to_word$config) (c2 :α asm_config) ((stubs (:α) (c :config).data_conf :(num # num # α prog) list) ++ MAP (compile_part (c3 :data_to_word$config) :num # num # dataLang$prog -> num # num # α prog) (prog :(num # num # dataLang$prog) list)) :num sptree$num_map option list # (num # num # α prog) list) = ((col :num sptree$num_map option list),(p :(num # num # α prog) list)) ⇒ MAP (FST :num # num # α prog -> num) p = MAP (FST :num # num # α prog -> num) (stubs (:α) c.data_conf :(num # num # α prog) list) ++ MAP (FST :num # num # dataLang$prog -> num) prog
ALL_DISTINCT_MAP_FST_stubs_typed=ALL_DISTINCT (MAP (FST :num # num # α prog -> num) (stubs (a :α itself) (c :data_to_word$config) :(num # num # α prog) list))
MAP_FST_stubs_bound_typed=MEM (n :num) (MAP (FST :num # num # α prog -> num) (stubs (a :α itself) (c :data_to_word$config) :(num # num # α prog) list)) ⇒ n < data_num_stubs
word_get_code_labels_StoreEach_typed=∀(ls :num list) (off :α word). word_get_code_labels (StoreEach (v :num) ls off) = (∅ :num -> bool)
word_get_code_labels_MemEqList_typed=∀(x :α word list) (b :α word). word_get_code_labels (MemEqList b x) = (∅ :num -> bool)
part_to_words_isWord_typed=∀(h :const_part) (c :data_to_word$config) (m :(bool # α word_loc) sptree$num_map) (i :α word) (w :bool # α word_loc) (ws :(bool # α word_loc) list). part_to_words c m h i = SOME (w,ws) ∧ (∀(n :num) (v :bool # α word_loc). (lookup n m :(bool # α word_loc) option) = SOME v ⇒ isWord (SND v)) ⇒ EVERY (isWord :α word_loc -> bool) (MAP (SND :bool # α word_loc -> α word_loc) ws) ∧ isWord (SND w)
parts_to_words_isWord_typed=∀(ps :const_part list) (c :data_to_word$config) (w :bool # α word_loc) (ws :(bool # α word_loc) list) (m :(bool # α word_loc) sptree$num_map) (n :num) (i :α word). parts_to_words c m n ps i = SOME (w,ws) ∧ (∀(n :num) (v :bool # α word_loc). (lookup n m :(bool # α word_loc) option) = SOME v ⇒ isWord (SND v)) ⇒ EVERY (isWord :α word_loc -> bool) (MAP (SND :bool # α word_loc -> α word_loc) ws) ∧ isWord (SND w)
const_parts_to_words_isWord_typed=∀(c :data_to_word$config) (ps :const_part list) (w :bool # α word_loc) (ws :(bool # α word_loc) list). (const_parts_to_words c ps :((bool # α word_loc) # (bool # α word_loc) list) option) = SOME (w,ws) ⇒ EVERY (isWord :α word_loc -> bool) (MAP (SND :bool # α word_loc -> α word_loc) ws) ∧ isWord (SND w)
word_get_code_labels_StoreAnyConsts_typed=(const_parts_to_words (c :data_to_word$config) (ps :const_part list) :((bool # α word_loc) # (bool # α word_loc) list) option) = SOME ((w :bool # α word_loc),(ws :(bool # α word_loc) list)) ⇒ word_get_code_labels (StoreAnyConsts (r1 :num) (r2 :num) (r3 :num) ws w) = (∅ :num -> bool)
getWords_good_loc_typed=∀(xs :(α # β word_loc) list) (ys :(α # β word) list) (ws :(α # β word) list) (vs1 :(α # β word_loc) list) (s :num -> bool). getWords xs ys = (ws,vs1) ∧ EVERY ((good_loc s :β word_loc -> bool) ∘ (SND :α # β word_loc -> β word_loc)) xs ⇒ EVERY ((good_loc s :β word_loc -> bool) ∘ (SND :α # β word_loc -> β word_loc)) vs1
const_parts_to_words_labels_typed=(const_parts_to_words (c :data_to_word$config) (bs :const_part list) :((bool # α word_loc) # (bool # α word_loc) list) option) = SOME ((q :bool # α word_loc),(r :(bool # α word_loc) list)) ⇒ word_get_code_labels (StoreAnyConsts (adjust_var (w :num)) (1 :num) (3 :num) r q) ⊆ assign_get_code_label (BlockOp (Build bs))
word_get_code_labels_assign_typed=∀(x :closLang$op). (assign (c :data_to_word$config) (secn :num) (v :num) (w :num) x (y :num list) (z :sptree$num_set option) :β prog # num) = ((res1 :β prog),(res2 :num)) ⇒ word_get_code_labels res1 ⊆ assign_get_code_label x ∪ set (MAP (FST :num # num # α prog -> num) (stubs (:α) c :(num # num # α prog) list))
data_to_word_comp_code_labels_typed=∀(c :data_to_word$config) (secn :num) (l :num) (p :dataLang$prog). word_get_code_labels (FST (comp c secn l p :α prog # num)) ⊆ data_get_code_labels p ∪ set (MAP (FST :num # num # α prog -> num) (stubs (:α) c :(num # num # α prog) list))
word_good_handlers_StoreEach_typed=∀(ls :num list) (off :α word). word_good_handlers (secn :num) (StoreEach (v :num) ls off)
word_good_handlers_MemEqList_typed=∀(x :α word list) (b :α word). word_good_handlers (secn :num) (MemEqList b x)
word_good_handlers_StoreAnyConsts_typed=∀(r1 :num) (r2 :num) (r3 :num) (ws :(bool # α word_loc) list) (w :bool # α word_loc). word_good_handlers (secn :num) (StoreAnyConsts r1 r2 r3 ws w)
word_good_handlers_assign_typed=∀(x :closLang$op). (assign (c :data_to_word$config) (secn :num) (v :num) (w :num) x (y :num list) (z :sptree$num_set option) :α prog # num) = ((res1 :α prog),(res2 :num)) ⇒ word_good_handlers secn res1
data_to_word_comp_good_handlers_typed=∀(c :data_to_word$config) (secn :num) (l :num) (p :dataLang$prog). word_good_handlers secn (FST (comp c secn l p :α prog # num))
stubs_labels_typed=BIGUNION (set (MAP (λ((n :num),(m :num),(pp :α prog)). word_get_code_labels pp) (stubs (:α) (dc :data_to_word$config) :(num # num # α prog) list))) ⊆ set (MAP (FST :num # num # α prog -> num) (stubs (:α) dc :(num # num # α prog) list))
data_to_word_good_code_labels_typed=(compile (data_conf :data_to_word$config) (word_conf :word_to_word$config) (asm_conf :α asm_config) (prog :(num # num # dataLang$prog) list) :num sptree$num_map option list # (num # num # α prog) list) = ((xx :num sptree$num_map option list),(prog' :(num # num # α prog) list)) ∧ data_good_code_labels prog (elabs :num -> bool) ⇒ word_good_code_labels prog' elabs
stubs_fst_def_typed=stubs_fst = [(7 :num); (8 :num); (9 :num); (10 :num); (11 :num); (12 :num); (13 :num); (14 :num); (15 :num); (16 :num); (17 :num); (18 :num); (19 :num); (20 :num); (21 :num); (22 :num); (23 :num); (29 :num); (30 :num); (31 :num); (33 :num); (34 :num); (35 :num); (36 :num); (37 :num); (38 :num); (24 :num); (25 :num); (26 :num); (27 :num); (28 :num); (32 :num); (39 :num); (61 :num); (60 :num); (59 :num); (58 :num); (54 :num); (57 :num); (56 :num); (55 :num); (53 :num); (52 :num); (51 :num); (50 :num); (49 :num); (47 :num); (48 :num); (46 :num); (45 :num); (44 :num); (43 :num); (42 :num); (41 :num); (40 :num)]
stubs_fst_eq_typed=MAP (FST :num # num # α prog -> num) (stubs (:α) (c :data_to_word$config) :(num # num # α prog) list) = stubs_fst
data_to_word_good_code_labels_incr_typed=set stubs_fst ⊆ (elabs :num -> bool) ∧ data_good_code_labels (progs :(num # num # dataLang$prog) list) elabs ⇒ word_good_code_labels (MAP (compile_part (dc :data_to_word$config) :num # num # dataLang$prog -> num # num # α prog) progs) elabs
data_to_word_good_handlers_typed=(compile (data_conf :data_to_word$config) (word_conf :word_to_word$config) (asm_conf :α asm_config) (prog :(num # num # dataLang$prog) list) :num sptree$num_map option list # (num # num # α prog) list) = ((xx :num sptree$num_map option list),(prog' :(num # num # α prog) list)) ⇒ EVERY (λ((n :num),(m :num),(pp :α prog)). word_good_handlers n pp) prog'
data_to_word_good_handlers_incr_typed=EVERY (λ((n :num),(m :num),(pp :α prog)). word_good_handlers n pp) (MAP (compile_part (dc :data_to_word$config) :num # num # dataLang$prog -> num # num # α prog) (progs :(num # num # dataLang$prog) list))
data_to_word_proof_lab2_probe_end=1
