sh_mem_op_with_const=sh_mem_op (op :memop) (x :num) (y :α word)
  ((z :(α, β, γ) state) with clock := (k :num)) =
((I :α result option -> α result option) ##
 (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_op op x y z)
sh_mem_op_with_const_types=(z :(α, β, γ) state)::(α, β, γ) state;(k :num)::num;(y :α word)::α word;(x :num)::num;(op :memop)::memop;
sh_mem_op_const=sh_mem_op (op :memop) (a :num) (r :α word) (s :(α, β, γ) state) =
((res :α result option),(t :(α, β, γ) state)) ⇒
t.clock = s.clock ∧ (t.use_alloc ⇔ s.use_alloc) ∧
(t.use_store ⇔ s.use_store) ∧ (t.use_stack ⇔ s.use_stack) ∧ t.code = s.code ∧
(t.be ⇔ s.be) ∧ t.gc_fun = s.gc_fun ∧ t.mdomain = s.mdomain ∧
t.sh_mdomain = s.sh_mdomain ∧ t.bitmaps = s.bitmaps ∧ t.compile = s.compile ∧
t.compile_oracle = s.compile_oracle
sh_mem_op_const_types=(t :(α, β, γ) state)::(α, β, γ) state;(res :α result option)::α result option;(s :(α, β, γ) state)::(α, β, γ) state;(r :α word)::α word;(a :num)::num;(op :memop)::memop;
