bmrc_full=⊢ ∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ key_ordered cmp k r Less ∧ key_ordered cmp k l Greater ∧ almost_balancedR (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r ⇒ invariant cmp (balanceR k v l r) ∧ to_fmap cmp (balanceR k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
