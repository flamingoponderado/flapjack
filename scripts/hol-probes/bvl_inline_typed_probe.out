optimise_def_typed=∀(split_seq :bool) (cut_size :num) (name :α) (arity :num) (exp :exp). optimise split_seq cut_size (name,arity,exp) = (name,arity,compile_any split_seq cut_size arity (let_op_sing (HD (remove_ticks [exp]))))
optimise_eq_typed=∀(split_seq :bool) (cut_size :num) (name :α) (arity :num) (exp :exp). optimise split_seq cut_size (name,arity,exp) = (name,arity,compile_any split_seq cut_size arity (let_op_sing (remove_ticks_sing exp)))
compile_inc_def_typed=∀(limit :num) (split_seq :bool) (cut_size :num) (cs :(num # exp) sptree$num_map) (prog :(num # num # exp) list). compile_inc limit split_seq cut_size cs prog = (let ((cs :(num # exp) sptree$num_map),(prog1 :(num # num # exp) list)) = tick_compile_prog limit cs prog in (cs,MAP (optimise split_seq cut_size :num # num # exp -> num # num # exp) prog1))
compile_prog_def_typed=∀(limit :num) (split_seq :bool) (cut_size :num) (prog :(num # num # exp) list). compile_prog limit split_seq cut_size prog = compile_inc limit split_seq cut_size (LN :(num # exp) sptree$num_map) prog
remove_ticks_sing_def_typed=(∀(v :num). remove_ticks_sing (Var v :exp) = (Var v :exp)) ∧ (∀(x1 :exp) (x2 :exp) (x3 :exp). remove_ticks_sing (If x1 x2 x3 :exp) = (If (remove_ticks_sing x1) (remove_ticks_sing x2) (remove_ticks_sing x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp). remove_ticks_sing (Let xs x2 :exp) = (Let (remove_ticks_list xs) (remove_ticks_sing x2) :exp)) ∧ (∀(x1 :exp). remove_ticks_sing (Raise x1 :exp) = (Raise (remove_ticks_sing x1) :exp)) ∧ (∀(x1 :exp) (x2 :exp). remove_ticks_sing (Handle x1 x2 :exp) = (Handle (remove_ticks_sing x1) (remove_ticks_sing x2) :exp)) ∧ (∀(op :op) (xs :exp list). remove_ticks_sing (Op op xs :exp) = (Op op (remove_ticks_list xs) :exp)) ∧ (∀(x :exp). remove_ticks_sing (Tick x :exp) = remove_ticks_sing x) ∧ (∀(m :num) (n :num). remove_ticks_sing (Force m n :exp) = (Force m n :exp)) ∧ (∀(ticks :num) (dest :num option) (xs :exp list). remove_ticks_sing (Call ticks dest xs :exp) = (Call (0 :num) dest (remove_ticks_list xs) :exp)) ∧ remove_ticks_list ([] :exp list) = ([] :exp list) ∧ ∀(x :exp) (xs :exp list). remove_ticks_list (x::xs) = remove_ticks_sing x::remove_ticks_list xs
