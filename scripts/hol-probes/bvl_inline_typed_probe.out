dest_op_def_typed=dest_op (Op (op :op) (xs :exp list) :exp) (args :α list) = (if var_list (0 :num) xs args then SOME op else (NONE :op option)) ∧ dest_op (Var (v3 :num) :exp) (v1 :α list) = (NONE :op option) ∧ dest_op (If (v4 :exp) (v5 :exp) (v6 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Let (v7 :exp list) (v8 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Raise (v9 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Handle (v10 :exp) (v11 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Tick (v12 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Call (v13 :num) (v14 :num option) (v15 :exp list) :exp) v1 = (NONE :op option) ∧ dest_op (Force (v16 :num) (v17 :num) :exp) v1 = (NONE :op option)
let_op_one_def_typed=(∀(v :num). let_op_one (Var v :exp) = (Var v :exp)) ∧ (∀(x1 :exp) (x2 :exp) (x3 :exp). let_op_one (If x1 x2 x3 :exp) = (If (let_op_one x1) (let_op_one x2) (let_op_one x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp). let_op_one (Let xs x2 :exp) = (let (xs :exp list) = let_op_list xs; (x2 :exp) = let_op_one x2 in case dest_op x2 xs of (NONE :op option) => (Let xs x2 :exp) | SOME op => (Op op xs :exp))) ∧ (∀(x1 :exp). let_op_one (Raise x1 :exp) = (Raise (let_op_one x1) :exp)) ∧ (∀(x1 :exp) (x2 :exp). let_op_one (Handle x1 x2 :exp) = (Handle (let_op_one x1) (let_op_one x2) :exp)) ∧ (∀(op :op) (xs :exp list). let_op_one (Op op xs :exp) = (Op op (let_op_list xs) :exp)) ∧ (∀(x :exp). let_op_one (Tick x :exp) = (Tick (let_op_one x) :exp)) ∧ (∀(m :num) (n :num). let_op_one (Force m n :exp) = (Force m n :exp)) ∧ (∀(ticks :num) (dest :num option) (xs :exp list). let_op_one (Call ticks dest xs :exp) = (Call ticks dest (let_op_list xs) :exp)) ∧ let_op_list ([] :exp list) = ([] :exp list) ∧ ∀(x :exp) (xs :exp list). let_op_list (x::xs) = let_op_one x::let_op_list xs
let_op_def_typed=let_op ([] :exp list) = ([] :exp list) ∧ (∀(y :exp) (xs :exp list) (x :exp). let_op (x::y::xs) = HD (let_op [x])::let_op (y::xs)) ∧ (∀(v :num). let_op [(Var v :exp)] = [(Var v :exp)]) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp). let_op [(If x1 x2 x3 :exp)] = [(If (HD (let_op [x1])) (HD (let_op [x2])) (HD (let_op [x3])) :exp)]) ∧ (∀(xs :exp list) (x2 :exp). let_op [(Let xs x2 :exp)] = (let (xs' :exp list) = let_op xs; (x2' :exp) = HD (let_op [x2]) in case dest_op x2' xs' of (NONE :op option) => [(Let xs' x2' :exp)] | SOME op => [(Op op xs' :exp)])) ∧ (∀(x1 :exp). let_op [(Raise x1 :exp)] = [(Raise (HD (let_op [x1])) :exp)]) ∧ (∀(x2 :exp) (x1 :exp). let_op [(Handle x1 x2 :exp)] = [(Handle (HD (let_op [x1])) (HD (let_op [x2])) :exp)]) ∧ (∀(xs :exp list) (op :op). let_op [(Op op xs :exp)] = [(Op op (let_op xs) :exp)]) ∧ (∀(x :exp). let_op [(Tick x :exp)] = [(Tick (HD (let_op [x])) :exp)]) ∧ (∀(n :num) (m :num). let_op [(Force m n :exp)] = [(Force m n :exp)]) ∧ ∀(xs :exp list) (ticks :num) (dest :num option). let_op [(Call ticks dest xs :exp)] = [(Call ticks dest (let_op xs) :exp)]
let_op_sing_def_typed=∀(x :exp). let_op_sing x = case let_op [x] of ([] :exp list) => (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) | y::ys => y
let_op_one_typed=(∀(e :exp). let_op [e] = [let_op_one e]) ∧ ∀(es :exp list). let_op_list es = let_op es
