is_small_aux_def_typed=(∀(n :num). is_small_aux n ([] :exp list) = n) ∧ (∀(y :exp) (xs :exp list) (x :exp) (n :num). is_small_aux n (x::y::xs) = if n = (0 :num) then n else (let (n' :num) = is_small_aux n [x] in if n' = (0 :num) then n' else is_small_aux n' (y::xs))) ∧ (∀(v :num) (n :num). is_small_aux n [(Var v :exp)] = n) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (n :num). is_small_aux n [(If x1 x2 x3 :exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = is_small_aux n' [x1] in if n'' = (0 :num) then (0 :num) else (let (n'³' :num) = is_small_aux n'' [x2] in if n'³' = (0 :num) then (0 :num) else is_small_aux n'³' [x3])))) ∧ (∀(xs :exp list) (x2 :exp) (n :num). is_small_aux n [(Let xs x2 :exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = is_small_aux n' xs in if n'' = (0 :num) then (0 :num) else is_small_aux n'' [x2]))) ∧ (∀(x1 :exp) (n :num). is_small_aux n [(Raise x1 :exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else is_small_aux n' [x1])) ∧ (∀(x2 :exp) (x1 :exp) (n :num). is_small_aux n [(Handle x1 x2 :exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else (let (n'' :num) = is_small_aux n' [x1] in if n'' = (0 :num) then (0 :num) else is_small_aux n'' [x2]))) ∧ (∀(xs :exp list) (op :op) (n :num). is_small_aux n [(Op op xs :exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else is_small_aux n' xs)) ∧ (∀(x :exp) (n :num). is_small_aux n [(Tick x :exp)] = is_small_aux n [x]) ∧ (∀(v1 :num) (v0 :num) (n :num). is_small_aux n [(Force v0 v1 :exp)] = n) ∧ ∀(xs :exp list) (ticks :num) (n :num) (dest :num option). is_small_aux n [(Call ticks dest xs :exp)] = (let (n' :num) = n − (1 :num) in if n' = (0 :num) then (0 :num) else is_small_aux n' xs)
