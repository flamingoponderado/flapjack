:(v list, v) result),s')) | ((Rerr v13 :(v list, v) result),s') => ((Rerr v13 :(v list, v) result),s')) ∧ (∀(vsopt :num list option) (v7 :mlstring) (s :(γ, 'ffi) state) (num_args :num) (loc :num option) (exp :closLang$exp) (env :v list). evaluate ([Fn v7 loc vsopt num_args exp],env,s) = if num_args ≤ s.max_app ∧ num_args ≠ (0 :num) then case vsopt of (NONE :num list option) => ((Rval [(Closure loc ([] :v list) env num_args exp :v)] :(v list, v) result),s) | SOME vs => case lookup_vars vs env of (NONE :v list option) => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME env' => ((Rval [(Closure loc ([] :v list) env' num_args exp :v)] :(v list, v) result),s) else ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s)) ∧ (∀(v8 :mlstring list) (s :(γ, 'ffi) state) (namesopt :num list option) (loc :num option) (fns :(num # closLang$exp) list) (exp :closLang$exp) (env :v list). evaluate ([(Letrec v8 loc namesopt fns exp :closLang$exp)],env,s) = if EVERY (λ((num_args :num),(e :closLang$exp)). num_args ≤ s.max_app ∧ num_args ≠ (0 :num)) fns then (let (build_rc :v list -> v list) (e :v list) = GENLIST (Recclosure loc ([] :v list) e fns :num -> v) (LENGTH fns); (envdelta :v list option) = case namesopt of (NONE :num list option) => SOME (build_rc env) | SOME names => OPTION_MAP build_rc (lookup_vars names env) in case envdelta of (NONE :v list option) => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME ed => evaluate ([exp],ed ++ env,s)) else ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s)) ∧ (∀(x1 :closLang$exp) (v9 :tra) (s :(γ, 'ffi) state) (loc_opt :num option) (env :v list) (args :closLang$exp list). evaluate ([(App v9 loc_opt x1 args :closLang$exp)],env,s) = if LENGTH args > (0 :num) then case evaluate (args,env,s) of ((Rval y2 :(v list, v) result),s1) => (case evaluate ([x1],env,s1) of ((Rval y1 :(v list, v) result),s2) => evaluate_app loc_opt (HD y1) y2 s2 | ((Rerr v7 :(v list, v) resul