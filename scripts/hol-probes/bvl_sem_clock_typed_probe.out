bvl_do_int_app_eq_some_typed=(∀(n :int). do_int_app (Const n) (vs :v list) = SOME (res :v) ⇒ vs = ([] :v list) ∧ res = (Number n :v)) ∧ (do_int_app Add vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Number (n1 + n2) :v)) ∧ (do_int_app Sub vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Number (n1 − n2) :v)) ∧ (do_int_app Mult vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Number (n1 * n2) :v)) ∧ (do_int_app Div vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ n2 ≠ (0 :int) ∧ res = (Number (n1 / n2) :v)) ∧ (do_int_app Mod vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ n2 ≠ (0 :int) ∧ res = (Number (n1 % n2) :v)) ∧ (do_int_app Less vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Boolv (n1 < n2) :v)) ∧ (do_int_app LessEq vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Boolv (n1 ≤ n2) :v)) ∧ (do_int_app Greater vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Boolv (n1 > n2) :v)) ∧ (do_int_app GreaterEq vs = SOME res ⇒ ∃(n1 :int) (n2 :int). vs = [(Number n1 :v); (Number n2 :v)] ∧ res = (Boolv (n1 ≥ n2) :v)) ∧ ∀(n :num). do_int_app (LessConstSmall n) vs = SOME res ⇒ ∃(i :int). vs = [(Number i :v)] ∧ (0 :int) ≤ i ∧ i ≤ (1000000 :int) ∧ n < (1000000 :num) ∧ res = (Boolv (i < ((&n) :int)) :v)
bvl_fix_clock_IMP_typed=fix_clock (s :(δ, ε) state) (x :α # (β, γ) state) = ((res :α),(s1 :(β, γ) state)) ⇒ s1.clock ≤ s.clock
bvl_do_app_Ref_typed=(do_app (MemOp Ref) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((RefPtr T (LEAST(ptr :num). ptr ∉ FDOM s.refs) :v),s with refs := s.refs⟨(LEAST(ptr :num). ptr ∉ FDOM s.refs) ↦ (ValueArray vs :v ref)⟩) :(v # (α, β) state, v) result)
bvl_do_app_Cons_typed=(do_app (BlockOp (Cons (tag :num) :block_op)) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rval (Block tag vs,s) :(v # (α, β) state, v) result)
