source_evaluate_definition=(∀(st :'ffi state) (env :v sem_env). evaluate st env ([] :exp list) = (st,(Rval ([] :v list) :(v list, v) result))) ∧ (∀(st :'ffi state) (es :exp list) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env (e1::e2::es) = case evaluate st env [e1] of (st',(Rval v1 :(v list, v) result)) => (case evaluate st' env (e2::es) of (st'',(Rval vs :(v list, v) result)) => (st'',(Rval (HD v1::vs) :(v list, v) result)) | (st'',(Rerr v8 :(v list, v) result)) => (st'',(Rerr v8 :(v list, v) result))) | (st',(Rerr v10 :(v list, v) result)) => (st',(Rerr v10 :(v list, v) result))) ∧ (∀(st :'ffi state) (l :lit) (env :v sem_env). evaluate st env [Lit l] = (st,(Rval [Litv l] :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Raise e] = case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => (st',(Rerr (Rraise (HD v)) :(v list, v) result)) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (pes :(pat # exp) list) (env :v sem_env) (e :exp). evaluate st env [Handle e pes] = case evaluate st env [e] of (st',(Rval v7 :(v list, v) result)) => (st',(Rval v7 :(v list, v) result)) | (st',(Rerr (Rraise v) :(v list, v) result)) => if can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) v then evaluate_match st' env v pes v else (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (st',(Rerr (Rabort v12 :v error_result) :(v list, v) result)) => (st',(Rerr (Rabort v12 :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (es :exp list) (env :v sem_env) (cn :(mlstring, mlstring) id option). evaluate st env [Con cn es] = if do_con_check env.c cn (LENGTH es) then case evaluate st env (REVERSE es) of (st',(Rval vs :(v list, v) result)) => (case build_conv env.c cn (REVERSE vs) of (NONE :v option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME v => (st',(Rval [v] :(v list, v) result))) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (n :(mlstring, mlstring) id) (env :v sem_env). evaluate st env [Var n] = case nsLookup env.v n of (NONE :v option) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME v => (st,(Rval [v] :(v list, v) result))) ∧ (∀(x :mlstring) (st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Fun x e] = (st,(Rval [Closure env x e] :(v list, v) result))) ∧ (∀(st :'ffi state) (op :op) (es :exp list) (env :v sem_env). evaluate st env [App op es] = case evaluate st env (REVERSE es) of (st',(Rval vs :(v list, v) result)) => (case getOpClass op of EvalOp => (case (do_eval_res (REVERSE vs) st' :'ffi state # (v sem_env # dec list, v) result) of (st1,(Rval (env1,decs) :(v sem_env # dec list, v) result)) => if st1.clock = (0 :num) then (st1,(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else (case evaluate_decs (dec_clock st1) env1 decs of (st2,(Rval env2 :(v sem_env, v) result)) => (case declare_env st2.eval_state ((env2 +++ env1) :v sem_env) of (NONE :(v # eval_state option) option) => (st2,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (x,es2) => (st2 with eval_state := reset_env_generation st'.eval_state es2,(Rval [x] :(v list, v) result))) | (st2,(Rerr (Rraise v7) :(v sem_env, v) result)) => (st2 with eval_state := reset_env_generation st'.eval_state st2.eval_state,(Rerr (Rraise v7) :(v list, v) result)) | (st2,(Rerr (Rabort a :v error_result) :(v sem_env, v) result)) => (st2,(Rerr (Rabort a :v error_result) :(v list, v) result))) | (st1,(Rerr e :(v sem_env # dec list, v) result)) => (st1,(Rerr e :(v list, v) result))) | FunApp => (case do_opapp (REVERSE vs) of (NONE :(v sem_env # exp) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if st'.clock = (0 :num) then (st',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else evaluate (dec_clock st') env' [e]) | Force => (case dest_thunk (REVERSE vs) st'.refs of BadRef => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | NotThunk => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | IsThunk Evaluated v => (st',(Rval [v] :(v list, v) result)) | IsThunk NotEvaluated v => case do_opapp [v; Conv (NONE :stamp option) ([] :v list)] of (NONE :(v sem_env # exp) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if st'.clock = (0 :num) then (st',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else case evaluate (dec_clock st') env' [e] of (st2,(Rval vs2 :(v list, v) result)) => (case update_thunk (REVERSE vs) st2.refs vs2 of (NONE :v store_v list option) => (st2,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME refs => (st2 with refs := refs,(Rval vs2 :(v list, v) result))) | (st2,(Rerr e :(v list, v) result)) => (st2,(Rerr e :(v list, v) result))) | Simple => case do_app (st'.refs,st'.ffi) op (REVERSE vs) of (NONE :((v store_v list # 'ffi ffi_state) # (v, v) result) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME ((refs,ffi),r) => (st' with <|refs := refs; ffi := ffi|>,list_result r)) | (st',(Rerr v14 :(v list, v) result)) => (st',(Rerr v14 :(v list, v) result))) ∧ (∀(st :'ffi state) (lop :lop) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env [Log lop e1 e2] = case evaluate st env [e1] of (st',(Rval v1 :(v list, v) result)) => (case do_log lop (HD v1) e2 of (NONE :exp_or_val option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (Exp e) => evaluate st' env [e] | SOME (Val v) => (st',(Rval [v] :(v list, v) result))) | (st',(Rerr v9 :(v list, v) result)) => (st',(Rerr v9 :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (e3 :exp) (e2 :exp) (e1 :exp). evaluate st env [If e1 e2 e3] = case evaluate st env [e1] of (st',(Rval v :(v list, v) result)) => (case do_if (HD v) e2 e3 of (NONE :exp option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME e => evaluate st' env [e]) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (pes :(pat # exp) list) (env :v sem_env) (e :exp). evaluate st env [Mat e pes] = case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => if can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) (HD v) then evaluate_match st' env (HD v) pes bind_exn_v else (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(xo :mlstring option) (st :'ffi state) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env [Let xo e1 e2] = case evaluate st env [e1] of (st',(Rval v :(v list, v) result)) => evaluate st' (env with v := nsOptBind xo (HD v) env.v) [e2] | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (funs :(mlstring # mlstring # exp) list) (env :v sem_env) (e :exp). evaluate st env [Letrec funs e] = if ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) then evaluate st (env with v := build_rec_env funs env env.v) [e] else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(t :ast_t) (st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Tannot e t] = evaluate st env [e]) ∧ (∀(st :'ffi state) (l :locs) (env :v sem_env) (e :exp). evaluate st env [Lannot e l] = evaluate st env [e]) ∧ (∀(v :v) (st :'ffi state) (err_v :v) (env :v sem_env). evaluate_match st env v ([] :(pat # exp) list) err_v = (st,(Rerr (Rraise err_v) :(v list, v) result))) ∧ (∀(v :v) (st :'ffi state) (pes :(pat # exp) list) (p :pat) (err_v :v) (env :v sem_env) (e :exp). evaluate_match st env v ((p,e)::pes) err_v = if ALL_DISTINCT (pat_bindings p) then case pmatch env.c st.refs p v ([] :(mlstring # v) list) of (No_match :(mlstring # v) list match_result) => evaluate_match st env v pes err_v | (Match_type_error :(mlstring # v) list match_result) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | Match env_v' => evaluate st (env with v := nsAppend (alist_to_ns env_v' :(mlstring, mlstring, v) namespace) env.v) [e] else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env). evaluate_decs st env ([] :dec list) = (st,(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (ds :dec list) (d2 :dec) (d1 :dec). evaluate_decs st env (d1::d2::ds) = case evaluate_decs st env [d1] of (st1,(Rval env1 :(v sem_env, v) result)) => (case evaluate_decs st1 ((env1 +++ env) :v sem_env) (d2::ds) of (st2,r) => (st2,combine_dec_result env1 r)) | (st1,(Rerr v7 :(v sem_env, v) result)) => (st1,(Rerr v7 :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (p :pat) (locs :locs) (env :v sem_env) (e :exp). evaluate_decs st env [Dlet locs p e] = if ALL_DISTINCT (pat_bindings p) ∧ every_exp (one_con_check env.c) e then case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => (st',case pmatch env.c st'.refs p (HD v) ([] :(mlstring # v) list) of (No_match :(mlstring # v) list match_result) => (Rerr (Rraise bind_exn_v) :(v sem_env, v) result) | (Match_type_error :(mlstring # v) list match_result) => (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) | Match new_vals => (Rval <|v := (alist_to_ns new_vals :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result)) | (st',(Rerr err :(v list, v) result)) => (st',(Rerr err :(v sem_env, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (locs :locs) (funs :(mlstring # mlstring # exp) list) (env :v sem_env). evaluate_decs st env [Dletrec locs funs] = (st,if ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) ∧ EVERY (λ((f :mlstring),(n :mlstring),(e :exp)). every_exp (one_con_check env.c) e) funs then (Rval <|v := build_rec_env funs env (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result) else (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result))) ∧ (∀(tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (st :'ffi state) (locs :locs) (env :v sem_env). evaluate_decs st env [Dtype locs tds] = if EVERY check_dup_ctors tds then (st with next_type_stamp := st.next_type_stamp + LENGTH tds,(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := build_tdefs st.next_type_stamp tds|> :(v sem_env, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result))) ∧ (∀(tvs :mlstring list) (tn :mlstring) (t :ast_t) (st :'ffi state) (locs :locs) (env :v sem_env). evaluate_decs st env [Dtabbrev locs tvs tn t] = (st,(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (n :mlstring) (env :v sem_env). evaluate_decs st env [Denv n] = case declare_env st.eval_state env of (NONE :(v # eval_state option) option) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) | SOME (x,es') => (st with eval_state := es',(Rval <|v := (nsSing n x :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(ts :ast_t list) (st :'ffi state) (locs :locs) (env :v sem_env) (cn :mlstring). evaluate_decs st env [Dexn locs cn ts] = (st with next_exn_stamp := st.next_exn_stamp + (1 :num),(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsSing cn (LENGTH ts,ExnStamp st.next_exn_stamp) :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (mn :mlstring) (env :v sem_env) (ds :dec list). evaluate_decs st env [Dmod mn ds] = case evaluate_decs st env ds of (st',r) => (st',case r of (Rval env' :(v sem_env, v) result) => (Rval <|v := nsLift mn env'.v; c := nsLift mn env'.c|> :(v sem_env, v) result) | (Rerr err :(v sem_env, v) result) => (Rerr err :(v sem_env, v) result))) ∧ ∀(st :'ffi state) (lds :dec list) (env :v sem_env) (ds :dec list). evaluate_decs st env [Dlocal lds ds] = case evaluate_decs st env lds of (st1,(Rval env1 :(v sem_env, v) result)) => evaluate_decs st1 ((env1 +++ env) :v sem_env) ds | (st1,(Rerr v7 :(v sem_env, v) result)) => (st1,(Rerr v7 :(v sem_env, v) result))
con_check_definition=∀(cenv :(mlstring, mlstring, num # stamp) namespace) (n_opt :(mlstring, mlstring) id option) (l :num). do_con_check cenv n_opt l ⇔ case n_opt of (NONE :(mlstring, mlstring) id option) => T | SOME n => case nsLookup cenv n of (NONE :(num # stamp) option) => F | SOME (l',v2) => l = l'
one_con_check_definition=(one_con_check (envc :(mlstring, mlstring, num # stamp) namespace) (Con (cn :(mlstring, mlstring) id option) (es :exp list)) ⇔ do_con_check envc cn (LENGTH es)) ∧ (one_con_check envc (Raise (v2 :exp)) ⇔ T) ∧ (one_con_check envc (Handle (v3 :exp) (v4 :(pat # exp) list)) ⇔ T) ∧ (one_con_check envc (Lit (v5 :lit)) ⇔ T) ∧ (one_con_check envc (Var (v8 :(mlstring, mlstring) id)) ⇔ T) ∧ (one_con_check envc (Fun (v9 :mlstring) (v10 :exp)) ⇔ T) ∧ (one_con_check envc (App (v11 :op) (v12 :exp list)) ⇔ T) ∧ (one_con_check envc (Log (v13 :lop) (v14 :exp) (v15 :exp)) ⇔ T) ∧ (one_con_check envc (If (v16 :exp) (v17 :exp) (v18 :exp)) ⇔ T) ∧ (one_con_check envc (Mat (v19 :exp) (v20 :(pat # exp) list)) ⇔ T) ∧ (one_con_check envc (Let (v21 :mlstring option) (v22 :exp) (v23 :exp)) ⇔ T) ∧ (one_con_check envc (Letrec (v24 :(mlstring # mlstring # exp) list) (v25 :exp)) ⇔ T) ∧ (one_con_check envc (Tannot (v26 :exp) (v27 :ast_t)) ⇔ T) ∧ (one_con_check envc (Lannot (v28 :exp) (v29 :locs)) ⇔ T)
build_conv_definition=∀(envC :(mlstring, mlstring, num # stamp) namespace) (cn :(mlstring, mlstring) id option) (vs :v list). build_conv envC cn vs = case cn of (NONE :(mlstring, mlstring) id option) => SOME (Conv (NONE :stamp option) vs) | SOME id => case nsLookup envC id of (NONE :(num # stamp) option) => (NONE :v option) | SOME (len,stamp) => SOME (Conv (SOME stamp) vs)
lit_same_type_definition=∀(l1 :lit) (l2 :lit). lit_same_type l1 l2 ⇔ case (l1,l2) of (IntLit v10,IntLit v22) => T | (IntLit v10,Char v23) => F | (IntLit v10,StrLit v24) => F | (IntLit v10,Word8 v25) => F | (IntLit v10,Word64 v26) => F | (IntLit v10,Float64 v27) => F | (Char v11,IntLit v34) => F | (Char v11,Char v35) => T | (Char v11,StrLit v36) => F | (Char v11,Word8 v37) => F | (Char v11,Word64 v38) => F | (Char v11,Float64 v39) => F | (StrLit v12,IntLit v46) => F | (StrLit v12,Char v47) => F | (StrLit v12,StrLit v48) => T | (StrLit v12,Word8 v49) => F | (StrLit v12,Word64 v50) => F | (StrLit v12,Float64 v51) => F | (Word8 v13,IntLit v58) => F | (Word8 v13,Char v59) => F | (Word8 v13,StrLit v60) => F | (Word8 v13,Word8 v61) => T | (Word8 v13,Word64 v62) => F | (Word8 v13,Float64 v63) => F | (Word64 v14,IntLit v70) => F | (Word64 v14,Char v71) => F | (Word64 v14,StrLit v72) => F | (Word64 v14,Word8 v73) => F | (Word64 v14,Word64 v74) => T | (Word64 v14,Float64 v75) => F | (Float64 v15,IntLit v82) => F | (Float64 v15,Char v83) => F | (Float64 v15,StrLit v84) => F | (Float64 v15,Word8 v85) => F | (Float64 v15,Word64 v86) => F | (Float64 v15,Float64 v87) => T
same_type_definition=(same_type (TypeStamp (v0 :mlstring) (n1 :num)) (TypeStamp (v1 :mlstring) (n2 :num)) ⇔ n1 = n2) ∧ (same_type (ExnStamp (v2 :num)) (ExnStamp (v3 :num)) ⇔ T) ∧ (same_type (TypeStamp (v7 :mlstring) (v8 :num)) (ExnStamp (v15 :num)) ⇔ F) ∧ (same_type (ExnStamp (v9 :num)) (TypeStamp (v19 :mlstring) (v20 :num)) ⇔ F)
same_ctor_definition=∀(stamp1 :stamp) (stamp2 :stamp). same_ctor stamp1 stamp2 ⇔ stamp1 = stamp2
ctor_same_type_definition=∀(c1 :stamp option) (c2 :stamp option). ctor_same_type c1 c2 ⇔ case (c1,c2) of ((NONE :stamp option),(NONE :stamp option)) => T | ((NONE :stamp option),SOME v7) => F | (SOME stamp1,(NONE :stamp option)) => F | (SOME stamp1,SOME stamp2) => same_type stamp1 stamp2
bool_type_num_definition=bool_type_num = (0 :num)
bool_value_definition=∀(b :bool). Boolv b = if b then Conv (SOME (TypeStamp «True» bool_type_num)) ([] :v list) else Conv (SOME (TypeStamp «False» bool_type_num)) ([] :v list)
source_pmatch_definition=(∀(v' :v) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s Pany v' env = Match env) ∧ (∀(x :mlstring) (v' :v) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pvar x) v' env = Match ((x,v')::env)) ∧ (∀(s :v store_v list) (l' :lit) (l :lit) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit l) (Litv l') env = if l = l' then Match env else if lit_same_type l l' then (No_match :(mlstring # v) list match_result) else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(vs :v list) (stamp' :stamp) (s :v store_v list) (ps :pat list) (n :(mlstring, mlstring) id) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (SOME n) ps) (Conv (SOME stamp') vs) env = case nsLookup envC n of (NONE :(num # stamp) option) => (Match_type_error :(mlstring # v) list match_result) | SOME (l,stamp) => if same_type stamp stamp' ∧ LENGTH ps = l then if same_ctor stamp stamp' then if LENGTH vs = l then pmatch_list envC s ps vs env else (Match_type_error :(mlstring # v) list match_result) else (No_match :(mlstring # v) list match_result) else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(vs :v list) (s :v store_v list) (ps :pat list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (NONE :(mlstring, mlstring) id option) ps) (Conv (NONE :stamp option) vs) env = if LENGTH ps = LENGTH vs then pmatch_list envC s ps vs env else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v0 :bool) (s :v store_v list) (p :pat) (lnum :num) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref p) (Loc v0 lnum) env = case store_lookup lnum s of (NONE :v store_v option) => (Match_type_error :(mlstring # v) list match_result) | SOME (Refv v) => pmatch envC s p v env | SOME (W8array v8 :v store_v) => (Match_type_error :(mlstring # v) list match_result) | SOME (Varray v9) => (Match_type_error :(mlstring # v) list match_result) | SOME (Thunk v10 v11) => (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v :v) (s :v store_v list) (p :pat) (i :mlstring) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pas p i) v env = pmatch envC s p v ((i,v)::env)) ∧ (∀(v :v) (t :ast_t) (s :v store_v list) (p :pat) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Ptannot p t) v env = pmatch envC s p v env) ∧ (∀(v40 :v list) (v39 :stamp option) (v21 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Conv v39 v40) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v43 :exp) (v42 :mlstring) (v41 :v sem_env) (v21 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Closure v41 v42 v43) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v46 :mlstring) (v45 :(mlstring # mlstring # exp) list) (v44 :v sem_env) (v21 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Recclosure v44 v45 v46) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v48 :num) (v47 :bool) (v21 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Loc v47 v48) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v49 :v list) (v21 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Vectorv v49) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v51 :num # num) (v50 :v sem_env) (v21 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Env v50 v51) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v66 :lit) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Litv v66) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v96 :(mlstring, mlstring) id) (v68 :v list) (v23 :pat list) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (SOME v96) v23) (Conv (NONE :stamp option) v68) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v94 :stamp) (v68 :v list) (v23 :pat list) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (NONE :(mlstring, mlstring) id option) v23) (Conv (SOME v94) v68) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v71 :exp) (v70 :mlstring) (v69 :v sem_env) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Closure v69 v70 v71) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v74 :mlstring) (v73 :(mlstring # mlstring # exp) list) (v72 :v sem_env) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Recclosure v72 v73 v74) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v76 :num) (v75 :bool) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Loc v75 v76) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v77 :v list) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Vectorv v77) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v79 :num # num) (v78 :v sem_env) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Env v78 v79) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v100 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Litv v100) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v102 :v list) (v101 :stamp option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Conv v101 v102) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v105 :exp) (v104 :mlstring) (v103 :v sem_env) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Closure v103 v104 v105) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v108 :mlstring) (v107 :(mlstring # mlstring # exp) list) (v106 :v sem_env) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Recclosure v106 v107 v108) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v111 :v list) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Vectorv v111) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v113 :num # num) (v112 :v sem_env) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Env v112 v113) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s ([] :pat list) ([] :v list) env = Match env) ∧ (∀(vs :v list) (v :v) (s :v store_v list) (ps :pat list) (p :pat) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s (p::ps) (v::vs) env = case pmatch envC s p v env of (No_match :(mlstring # v) list match_result) => (case pmatch_list envC s ps vs env of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match env' => pmatch_list envC s ps vs env') ∧ (∀(v141 :pat list) (v140 :pat) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s (v140::v141) ([] :v list) env = (Match_type_error :(mlstring # v) list match_result)) ∧ ∀(v137 :v list) (v136 :v) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s ([] :pat list) (v136::v137) env = (Match_type_error :(mlstring # v) list match_result)
can_pmatch_all_definition=(∀(envC :(mlstring, mlstring, num # stamp) namespace) (refs :v store_v list) (v :v). can_pmatch_all envC refs ([] :pat list) v ⇔ T) ∧ ∀(envC :(mlstring, mlstring, num # stamp) namespace) (refs :v store_v list) (p :pat) (ps :pat list) (v :v). can_pmatch_all envC refs (p::ps) v ⇔ if pmatch envC refs p v ([] :(mlstring # v) list) = (Match_type_error :(mlstring # v) list match_result) then F else can_pmatch_all envC refs ps v
build_rec_env_definition=∀(funs :(mlstring # mlstring # exp) list) (cl_env :v sem_env) (add_to_env :(mlstring, mlstring, v) namespace). build_rec_env funs cl_env add_to_env = FOLDR (λ((f :mlstring),(x :mlstring),(e :exp)) (env' :(mlstring, mlstring, v) namespace). nsBind f (Recclosure cl_env funs f) env') add_to_env funs
find_recfun_definition=∀(n :mlstring) (funs :(mlstring # α # β) list). find_recfun n funs = case funs of ([] :(mlstring # α # β) list) => (NONE :(α # β) option) | (f,x,e)::funs' => if f = n then SOME (x,e) else find_recfun n funs'
do_log_definition=∀(l :lop) (v :v) (e :exp). do_log l v e = if l = Andalso ∧ v = Boolv T ∨ l = Orelse ∧ v = Boolv F then SOME (Exp e) else if l = Andalso ∧ v = Boolv F ∨ l = Orelse ∧ v = Boolv T then SOME (Val v) else (NONE :exp_or_val option)
do_if_definition=∀(v :v) (e1 :α) (e2 :α). do_if v e1 e2 = if v = Boolv T then SOME e1 else if v = Boolv F then SOME e2 else (NONE :α option)
build_constrs_definition=∀(stamp :num) (condefs :(mlstring # α list) list). build_constrs stamp condefs = MAP (λ((conN :mlstring),(ts :α list)). (conN,LENGTH ts,TypeStamp conN stamp)) condefs
build_tdefs_definition=(∀(next_stamp :num). build_tdefs next_stamp ([] :(mlstring list # mlstring # (mlstring # ast_t list) list) list) = (alist_to_ns ([] :(mlstring # num # stamp) list) :(mlstring, mlstring, num # stamp) namespace)) ∧ ∀(tvs :mlstring list) (tn :mlstring) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (next_stamp :num) (condefs :(mlstring # ast_t list) list). build_tdefs next_stamp ((tvs,tn,condefs)::tds) = nsAppend (build_tdefs (next_stamp + (1 :num)) tds) (alist_to_ns (REVERSE (build_constrs next_stamp condefs)) :(mlstring, mlstring, num # stamp) namespace)
check_dup_ctors_definition=∀(tvs :mlstring list) (tn :mlstring) (condefs :(mlstring # ast_t list) list). check_dup_ctors (tvs,tn,condefs) ⇔ ALL_DISTINCT (let (x2 :mlstring list) = ([] :mlstring list) in FOLDR (λ((n :mlstring),(ts :ast_t list)) (x2 :mlstring list). if T then n::x2 else x2) x2 condefs)
combine_dec_result_definition=∀(env :v sem_env) (r :(v sem_env, α) result). combine_dec_result env r = case r of (Rval env' :(v sem_env, α) result) => (Rval <|v := nsAppend env'.v env.v; c := nsAppend env'.c env.c|> :(v sem_env, α) result) | (Rerr e :(v sem_env, α) result) => (Rerr e :(v sem_env, α) result)
extend_dec_env_definition=∀(new_env :v sem_env) (env :v sem_env). ((new_env +++ env) :v sem_env) = <|c := nsAppend new_env.c env.c; v := nsAppend new_env.v env.v|>
build_constrs_nat=[(«A»,(2 :num),TypeStamp «A» (3 :num))]
build_constrs_bool=[(«A»,(2 :num),TypeStamp «A» (3 :num))]
evaluate_type=:α state -> v sem_env -> exp list -> α state # (v list, v) result
match_type=:α state -> v sem_env -> v -> (pat # exp) list -> v -> α state # (v list, v) result
decs_type=:α state -> v sem_env -> dec list -> α state # (v sem_env, v) result
literal=((10 :num),([] :v store_v list),(Rval [Litv (IntLit (7 :int))] :(v list, v) result))
raise=((10 :num),([] :v store_v list),(Rerr (Rraise (Litv (IntLit (7 :int)))) :(v list, v) result))
type_error=((10 :num),([] :v store_v list),(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))
call_zero=((0 :num),([] :v store_v list),(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result))
call_one=((0 :num),([] :v store_v list),(Rval [Litv (IntLit (9 :int))] :(v list, v) result))
match_bind=((4 :num),([] :v store_v list),(Rval [Litv (IntLit (7 :int))] :(v list, v) result))
match_empty=((4 :num),([] :v store_v list),(Rerr (Rraise (Conv (SOME (ExnStamp (0 :num))) ([] :v list))) :(v list, v) result))
declaration=((4 :num),SOME (Litv (IntLit (7 :int))))
