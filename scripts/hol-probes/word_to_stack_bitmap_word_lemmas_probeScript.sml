load "preamble"; load "word_to_stackProofTheory";
open HolKernel Parse bossLib preamble word_to_stackProofTheory wordsTheory;
val _ = Globals.linewidth := 2000;
val replay_max0 = prove(``    ∀n. MAX_LIST (GENLIST (λx. 2*x) n) = 2*(n-1)``,   Induct>> fs[GENLIST]>>
  fs[MAX_DEF]);
val _ = (if null(hyp replay_max0) then () else raise Fail "open replay premise"; print "bw_full_max0="; print_thm replay_max0; print "\n");
val replay_max1 = prove(``    ∀n. MAX_LIST (GENLIST (λx. 2*(x+1)) n) = 2*n``,   Induct>> fs[GENLIST]>>
  fs[MAX_DEF]);
val _ = (if null(hyp replay_max1) then () else raise Fail "open replay premise"; print "bw_full_max1="; print_thm replay_max1; print "\n");
val replay_orzero = prove(``  ((w || v) = 0w) <=> (w = 0w) /\ (v = 0w)``,   srw_tac [wordsLib.WORD_BIT_EQ_ss] []
  \\ metis_tac []);
val _ = (if null(hyp replay_orzero) then () else raise Fail "open replay premise"; print "bw_full_orzero="; print_thm replay_orzero; print "\n");
val replay_shift = prove(``  ~(word_msb w) ==> (w ≪ 1 ⋙ 1 = w)``,   srw_tac [wordsLib.WORD_BIT_EQ_ss] []
  \\ Cases_on `i + 1 < dimindex (:α)`
  \\ full_simp_tac (srw_ss()++wordsLib.WORD_BIT_EQ_ss) [NOT_LESS]
  \\ `i = dimindex (:'a) - 1` by decide_tac
  \\ simp []);
val _ = (if null(hyp replay_shift) then () else raise Fail "open replay premise"; print "bw_full_shift="; print_thm replay_shift; print "\n");
val replay_orone = prove(``  (n ≪ 1) ‖ 1w = (n ≪ 1) + 1w``,   `?x. n = bitstring$v2w x`
    by METIS_TAC[ bitstringTheory.v2w_w2v]
  >> `1w = bitstring$v2w [T]`
   by fs[GSYM bitstringTheory.n2w_v2n,bitstringTheory.v2n]
  >> fs[bitstringTheory.word_lsl_v2w,bitstringTheory.word_or_v2w]
  >> fs[bitstringTheory.shiftl_def,listTheory.PAD_RIGHT]
  >> fs[bitstringTheory.bor_def,bitstringTheory.bitwise_def,MAX_DEF]
  >> fs[bitstringTheory.fixwidth_def]
  >> reverse $ rw[]
  >- fs[GSYM bitstringTheory.n2w_v2n,bitstringTheory.v2n]
  >> fs[bitstringTheory.zero_extend_def,listTheory.PAD_LEFT]
  >> pop_assum kall_tac >> Induct_on `x`
  >> fs[GSYM bitstringTheory.n2w_v2n,bitstringTheory.v2n,
     rich_listTheory.GENLIST_K_CONS]
  >> fs[COND_RAND,COND_RATOR]
  >> fs[GSYM wordsTheory.word_add_n2w]);
val _ = (if null(hyp replay_orone) then () else raise Fail "open replay premise"; print "bw_full_orone="; print_thm replay_orone; print "\n");
fun emit label q = let val th = EVAL q in print(label ^ "="); print_thm th; print "\n" end;
