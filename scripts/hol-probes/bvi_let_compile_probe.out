compile_sing_def=(∀(v :num) (env :num list) (d :num). compile_sing env d (Var v :exp) = case LLOOKUP env v of (NONE :num option) => (Var (v + d) :exp) | SOME n => (Var (v + n) :exp)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (env :num list) (d :num). compile_sing env d (If x1 x2 x3 :exp) = (If (compile_sing env d x1) (compile_sing env d x2) (compile_sing env d x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp) (env :num list) (d :num). compile_sing env d (Let xs x2 :exp) = (let (l :num) = LENGTH xs in if l = (0 :num) then compile_sing env d x2 else (let (k :num) = l − (1 :num) in if x2 = (Var k :exp) then (let (ys :exp list) = compile_list env d (FRONT xs) in (Let ys (compile_sing (MAP ($+ k) env) (d + k) (LAST xs)) :exp)) else (let (ys :exp list) = compile_list env d xs in (Let (MAP delete_var ys) (compile_sing (extract_list ys ++ env) d x2) :exp))))) ∧ (∀(x1 :exp) (env :num list) (d :num). compile_sing env d (Raise x1 :exp) = (Raise (compile_sing env d x1) :exp)) ∧ (∀(xs :exp list) (op :op) (env :num list) (d :num). compile_sing env d (Op op xs :exp) = (Op op (compile_list env d xs) :exp)) ∧ (∀(x :exp) (env :num list) (d :num). compile_sing env d (Tick x :exp) = (Tick (compile_sing env d x) :exp)) ∧ (∀(v :num) (loc :num) (env :num list) (d :num). compile_sing env d (Force loc v :exp) = case LLOOKUP env v of (NONE :num option) => (Force loc (v + d) :exp) | SOME n => (Force loc (v + n) :exp)) ∧ (∀(xs :exp list) (t :num) (h :exp option) (env :num list) (dest :num option) (d :num). compile_sing env d (Call t dest xs h :exp) = (Call t dest (compile_list env d xs) (case h of (NONE :exp option) => (NONE :exp option) | SOME e => SOME (compile_sing ((0 :num)::env) d e)) :exp)) ∧ (∀(xs :exp list) (env :num list) (d :num). compile_sing env d (Return xs) = Return (compile_list env d xs)) ∧ (∀(y :exp) (xs :exp list) (t :num) (rets :num) (env :num list) (dest :num) (d :num). compile_sing env d (LetCall rets t dest xs y) = LetCall rets t dest (compile_list env d xs) (compile_sing (REPLICATE rets (0 :num) ++ env) d y)) ∧ (∀(env :num list) (d :num). compile_list env d ([] :exp list) = ([] :exp list)) ∧ ∀(xs :exp list) (x :exp) (env :num list) (d :num). compile_list env d (x::xs) = compile_sing env d x::compile_list env d xs
compile_sing=(∀(n :num list) (d :num) (e :exp). compile n d [e] = [compile_sing n d e]) ∧ ∀(n :num list) (d :num) (e :exp list). compile_list n d e = compile n d e
compile_exp_def=∀(x :exp). compile_exp x = case compile ([] :num list) (0 :num) [x] of ([] :exp list) => (Var (0 :num) :exp) | y::v3 => y
compile_exp_eq=∀(x :exp). compile_exp x = compile_sing ([] :num list) (0 :num) x
compile_tail=compile_exp (Let [(Var (3 :num) :exp); (Var (1 :num) :exp)] (Var (1 :num) :exp) :exp) = (Let [(Var (3 :num) :exp)] (Var (2 :num) :exp) :exp)
compile_vars=compile_exp (Let [(Var (3 :num) :exp); (Var (1 :num) :exp)] (Var (0 :num) :exp) :exp) = (Let [(Op (IntOp (Const (0 :int))) ([] :exp list) :exp); (Op (IntOp (Const (0 :int))) ([] :exp list) :exp)] (Var (5 :num) :exp) :exp)
compile_empty=compile_exp (Let ([] :exp list) (Var (2 :num) :exp) :exp) = (Var (2 :num) :exp)
