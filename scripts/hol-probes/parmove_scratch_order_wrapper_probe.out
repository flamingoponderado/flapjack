pso_original_statement=windmill mvs ⇒ case find_index NONE (MAP SND (parmove mvs)) 0 of NONE => T | SOME i => case find_index NONE (MAP FST (parmove mvs)) 0 of NONE => F | SOME j => ¬(i ≤ j)
pso_empty=([],NONE,NONE,T,T)
pso_self=([],NONE,NONE,T,T)
pso_chain=([(SOME 0,SOME 1); (SOME 1,SOME 2)],NONE,NONE,T,T)
pso_swap=([(NONE,SOME 1); (SOME 1,SOME 0); (SOME 0,NONE)],SOME 2,SOME 0,T,T)
pso_cycle=([(NONE,SOME 1); (SOME 1,SOME 2); (SOME 2,SOME 0); (SOME 0,NONE)],SOME 3,SOME 0,T,T)
pso_shared_source=([(SOME 0,SOME 2); (SOME 1,SOME 2)],NONE,NONE,T,T)
pso_bool_swap=([(NONE,SOME T); (SOME T,SOME F); (SOME F,NONE)],SOME 2,SOME 0,T,T)
pso_duplicate_boundary=([(SOME 0,SOME 1); (SOME 0,SOME 2)],NONE,NONE,F,T)
