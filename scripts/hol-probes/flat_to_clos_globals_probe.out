op_globals=op_gbag (GlobOp (SetGlobal (n :num))) = {|n|} ∧ op_gbag (Label (v :num)) = ({||} :num -> num) ∧ op_gbag (FFI (v1 :mlstring) :closLang$op) = ({||} :num -> num) ∧ op_gbag (IntOp (v2 :int_op)) = ({||} :num -> num) ∧ op_gbag (WordOp (v3 :word_op)) = ({||} :num -> num) ∧ op_gbag (BlockOp (v4 :block_op)) = ({||} :num -> num) ∧ op_gbag (GlobOp (Global (v16 :num))) = ({||} :num -> num) ∧ op_gbag (GlobOp AllocGlobal) = ({||} :num -> num) ∧ op_gbag (GlobOp GlobalsPtr) = ({||} :num -> num) ∧ op_gbag (GlobOp SetGlobalsPtr) = ({||} :num -> num) ∧ op_gbag (MemOp (v6 :mem_op)) = ({||} :num -> num) ∧ op_gbag Install = ({||} :num -> num) ∧ op_gbag (ThunkOp (v7 :thunk_op) :closLang$op) = ({||} :num -> num)
set_globals=(∀(v1 :num) (v0 :tra). set_globals (Var v0 v1 :closLang$exp) = ({||} :num -> num)) ∧ (∀(v2 :tra) (e3 :closLang$exp) (e2 :closLang$exp) (e1 :closLang$exp). set_globals (If v2 e1 e2 e3 :closLang$exp) = set_globals e1 ⊎ set_globals e2 ⊎ set_globals e3) ∧ (∀(v3 :tra) (e :closLang$exp) (binds :closLang$exp list). set_globals (Let v3 binds e :closLang$exp) = set_globals e ⊎ elist_globals binds) ∧ (∀(v4 :tra) (e :closLang$exp). set_globals (Raise v4 e :closLang$exp) = set_globals e) ∧ (∀(v5 :tra) (e2 :closLang$exp) (e1 :closLang$exp). set_globals (Handle v5 e1 e2 :closLang$exp) = set_globals e1 ⊎ set_globals e2) ∧ (∀(v6 :tra) (e :closLang$exp). set_globals (Tick v6 e) = set_globals e) ∧ (∀(v9 :num) (v8 :num) (v7 :tra) (args :closLang$exp list). set_globals (Call v7 v8 v9 args) = elist_globals args) ∧ (∀(v11 :num option) (v10 :tra) (f :closLang$exp) (args :closLang$exp list). set_globals (App v10 v11 f args :closLang$exp) = set_globals f ⊎ elist_globals args) ∧ (∀(v15 :num) (v14 :num list option) (v13 :num option) (v12 :mlstring) (bod :closLang$exp). set_globals (Fn v12 v13 v14 v15 bod) = set_globals bod) ∧ (∀(v18 :num list option) (v17 :num option) (v16 :mlstring list) (fbinds :(num # closLang$exp) list) (bod :closLang$exp). set_globals (Letrec v16 v17 v18 fbinds bod :closLang$exp) = set_globals bod ⊎ elist_globals (MAP (SND :num # closLang$exp -> closLang$exp) fbinds)) ∧ (∀(v19 :tra) (opn :closLang$op) (args :closLang$exp list). set_globals (Op v19 opn args) = op_gbag opn ⊎ elist_globals args) ∧ elist_globals ([] :closLang$exp list) = ({||} :num -> num) ∧ ∀(es :closLang$exp list) (e :closLang$exp). elist_globals (e::es) = set_globals e ⊎ elist_globals es
esgc_free=(∀(v1 :num) (v0 :tra). esgc_free (Var v0 v1 :closLang$exp)) ∧ (∀(v2 :tra) (e3 :closLang$exp) (e2 :closLang$exp) (e1 :closLang$exp). esgc_free (If v2 e1 e2 e3 :closLang$exp) ⇔ esgc_free e1 ∧ esgc_free e2 ∧ esgc_free e3) ∧ (∀(v3 :tra) (e :closLang$exp) (binds :closLang$exp list). esgc_free (Let v3 binds e :closLang$exp) ⇔ EVERY esgc_free binds ∧ esgc_free e) ∧ (∀(v4 :tra) (e :closLang$exp). esgc_free (Raise v4 e :closLang$exp) ⇔ esgc_free e) ∧ (∀(v5 :tra) (e2 :closLang$exp) (e1 :closLang$exp). esgc_free (Handle v5 e1 e2 :closLang$exp) ⇔ esgc_free e1 ∧ esgc_free e2) ∧ (∀(v6 :tra) (e :closLang$exp). esgc_free (Tick v6 e) ⇔ esgc_free e) ∧ (∀(v9 :num) (v8 :num) (v7 :tra) (args :closLang$exp list). esgc_free (Call v7 v8 v9 args) ⇔ EVERY esgc_free args) ∧ (∀(v11 :num option) (v10 :tra) (e :closLang$exp) (args :closLang$exp list). esgc_free (App v10 v11 e args :closLang$exp) ⇔ esgc_free e ∧ EVERY esgc_free args) ∧ (∀(v15 :num) (v14 :num list option) (v13 :num option) (v12 :mlstring) (b :closLang$exp). esgc_free (Fn v12 v13 v14 v15 b) ⇔ set_globals b = ({||} :num -> num)) ∧ (∀(v18 :num list option) (v17 :num option) (v16 :mlstring list) (bod :closLang$exp) (binds :(num # closLang$exp) list). esgc_free (Letrec v16 v17 v18 binds bod :closLang$exp) ⇔ elist_globals (MAP (SND :num # closLang$exp -> closLang$exp) binds) = ({||} :num -> num) ∧ esgc_free bod) ∧ ∀(v20 :closLang$op) (v19 :tra) (args :closLang$exp list). esgc_free (Op v19 v20 args) ⇔ EVERY esgc_free args
elist_globals_empty=∀(es :closLang$exp list). elist_globals es = ({||} :num -> num) ⇔ ∀(e :closLang$exp). MEM e es ⇒ set_globals e = ({||} :num -> num)
smartcons_globals=set_globals (SmartCons (t :tra) (tag :num) (xs :closLang$exp list)) = elist_globals xs
smartcons_esgc=esgc_free (SmartCons (t :tra) (tag :num) (xs :closLang$exp list)) ⇔ EVERY esgc_free xs
bag_image_definition=∀(f :β -> α) (b :β -> num). BAG_IMAGE f b = (λ(e :α). (let (sb :β -> num) = BAG_FILTER (λ(e0 :β). f e0 = e) b in if FINITE_BAG sb then BAG_CARD sb else (1 :num)))
compile_globals=∀(m :mlstring option list) (e :exp list). EVERY no_Mat e ⇒ elist_globals (compile m e) = BAG_IMAGE SUC (elist_globals e)
compile_decs_globals=∀(decs :exp list). no_Mat_decs decs ⇒ elist_globals (compile_decs decs) = BAG_IMAGE SUC (elist_globals decs)
compile_eq_globals=compile (m :mlstring option list) (exps :exp list) = (exps' :closLang$exp list) ∧ EVERY no_Mat exps ⇒ elist_globals exps' = BAG_IMAGE SUC (elist_globals exps)
compile_esgc=∀(m :mlstring option list) (e :exp list). EVERY esgc_free e ∧ EVERY no_Mat e ⇒ EVERY esgc_free (compile m e)
compile_decs_esgc=∀(decs :exp list). EVERY esgc_free decs ∧ no_Mat_decs decs ⇒ EVERY esgc_free (compile_decs decs)
compile_prog_esgc=∀(decs :exp list). EVERY esgc_free decs ∧ no_Mat_decs decs ⇒ EVERY esgc_free (compile_prog decs)
insert_interp_globals=elist_globals (insert_interp (xs :closLang$exp list)) = elist_globals xs
insert_interp_esgc=EVERY esgc_free (insert_interp (xs :closLang$exp list)) ⇔ EVERY esgc_free xs
inc_compile_esgc=EVERY esgc_free (decs :exp list) ∧ no_Mat_decs decs ⇒ EVERY esgc_free (FST (inc_compile_decs decs :closLang$exp list # α list))
inc_compile_globals=∀(decs :exp list). no_Mat_decs decs ⇒ elist_globals (FST (inc_compile_decs decs :closLang$exp list # α list)) = BAG_IMAGE SUC (elist_globals decs)
compile_prog_globals=∀(decs :exp list). no_Mat_decs decs ⇒ elist_globals (compile_prog decs) = {|(0 :num)|} ⊎ BAG_IMAGE SUC (elist_globals decs)
no_mti_def=(∀(t :tra) (n :num). no_mti (Var t n :closLang$exp) ⇔ T) ∧ (∀(t :tra) (e3 :closLang$exp) (e2 :closLang$exp) (e1 :closLang$exp). no_mti (If t e1 e2 e3 :closLang$exp) ⇔ no_mti e1 ∧ no_mti e2 ∧ no_mti e3) ∧ (∀(t :tra) (es :closLang$exp list) (e :closLang$exp). no_mti (Let t es e :closLang$exp) ⇔ EVERY (λ(a :closLang$exp). no_mti a) es ∧ no_mti e) ∧ (∀(t :tra) (e :closLang$exp). no_mti (Raise t e :closLang$exp) ⇔ no_mti e) ∧ (∀(t :tra) (e2 :closLang$exp) (e1 :closLang$exp). no_mti (Handle t e1 e2 :closLang$exp) ⇔ no_mti e1 ∧ no_mti e2) ∧ (∀(t :tra) (e :closLang$exp). no_mti (Tick t e) ⇔ no_mti e) ∧ (∀(ticks :num) (t :tra) (n :num) (es :closLang$exp list). no_mti (Call t ticks n es) ⇔ F) ∧ (∀(t :tra) (opt :num option) (es :closLang$exp list) (e :closLang$exp). no_mti (App t opt e es :closLang$exp) ⇔ LENGTH es = (1 :num) ∧ opt = (NONE :num option) ∧ EVERY (λ(a :closLang$exp). no_mti a) es ∧ no_mti e) ∧ (∀(t :mlstring) (opt2 :num list option) (opt1 :num option) (num_args :num) (e :closLang$exp). no_mti (Fn t opt1 opt2 num_args e) ⇔ num_args = (1 :num) ∧ opt1 = (NONE :num option) ∧ opt2 = (NONE :num list option) ∧ no_mti e) ∧ (∀(t :mlstring list) (opt2 :num list option) (opt1 :num option) (funs :(num # closLang$exp) list) (e :closLang$exp). no_mti (Letrec t opt1 opt2 funs e :closLang$exp) ⇔ no_mti e ∧ opt1 = (NONE :num option) ∧ opt2 = (NONE :num list option) ∧ EVERY (λ(x :num # closLang$exp). FST x = (1 :num) ∧ no_mti (SND x)) funs) ∧ ∀(t :tra) (op :closLang$op) (es :closLang$exp list). no_mti (Op t op es) ⇔ EVERY (λ(a :closLang$exp). no_mti a) es
no_mti_smartcons=no_mti (SmartCons (t :tra) (tag :num) (xs :closLang$exp list)) ⇔ EVERY no_mti xs
