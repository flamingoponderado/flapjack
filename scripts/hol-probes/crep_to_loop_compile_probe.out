loop_nested_seq_empty=Skip
loop_nested_seq_one=Seq (Break 3) Skip
loop_nested_seq_two=Seq (Break 3) (Seq Tick Skip)
compile_skip=Skip
compile_break=Break 3
compile_continue=Continue 4
compile_tick=Tick
compile_return=Seq (Assign 5 (Const 5w)) (Seq (Return [5]) Skip)
compile_raise=Seq (Assign 5 (Const 6w)) (Raise 5)
compile_shmem=Seq (ShMem Load8 7 (Const 7w)) Skip
compile_store=Seq (Assign 5 (Const 9w)) (Seq (Store (Const 8w) 5) Skip)
compile_store32=Seq (Assign 5 (Const 10w))
  (Seq (Assign 6 (Const 11w)) (Seq (Store32 5 6) Skip))
compile_store_byte=Seq (Assign 5 (Const 12w))
  (Seq (Assign 6 (Const 13w)) (Seq (StoreByte 5 6) Skip))
compile_store_glob=Seq (SetGlobal 3w (Const 14w)) Skip
compile_seq=Seq (Break 1) Tick
compile_assign=Seq (Assign 7 (Var 8)) Skip
compile_primitive=Primitive [7] AddCarry [8]
compile_dec=Seq Skip (Seq (Assign 5 (Const 15w)) (Seq (Assign 5 (Var 5)) Skip))
compile_if=Seq (Assign 5 (Const 1w))
  (Seq (If NotEqual 5 (Imm 0w) (Break 2) Tick ⦕ 1; 2 ⦖) Skip)
compile_while=Loop ⦕ 1; 2 ⦖
  (Seq (Assign 5 (Const 1w))
     (Seq
        (If NotEqual 5 (Imm 0w) (Seq (Break 2) (Continue 0)) (Break 0)
           ⦕ 1; 2 ⦖) Skip)) ⦕ 1; 2 ⦖
compile_call=Seq (Assign 5 (Const 16w))
  (Seq
     (Call (SOME ([7],⦕ 1; 2 ⦖)) (SOME 42) [5]
        (SOME
           (5,If NotEqual 5 (Imm 3w) (Raise 5) (Seq Tick (Break 7)) ⦕ 1; 2 ⦖,
            Skip,⦕ 1; 2 ⦖))) Skip)
compile_ext_call=FFI «ffi» 7 8 9 10 ⦕ 1; 2 ⦖
