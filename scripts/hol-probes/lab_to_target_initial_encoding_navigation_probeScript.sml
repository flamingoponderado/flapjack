load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "loc_to_pc_enc_sec_list" loc_to_pc_enc_sec_list;
val _=types "loc_to_pc_enc_sec_list_types" loc_to_pc_enc_sec_list;
val _=print "loc_to_pc_enc_sec_list_hypotheses=";
val _=print(Int.toString(length(hyp loc_to_pc_enc_sec_list)) ^ "\n");
val _=show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc((QCONV(SIMP_CONV(srw_ss())[labSemTheory.loc_to_pc_def,enc_sec_list_def,enc_sec_def,enc_line_def]) THENC EVAL THENC QCONV(SIMP_CONV(srw_ss())[])) q)); print "\n");
val _=observe "empty" ``loc_to_pc 1 2 (enc_sec_list (K [0w;1w]) ([]:8 sec list)) = NONE``;
val _=observe "section_zero" ``loc_to_pc 1 0 (enc_sec_list (K []) ([Section 1 []]:8 sec list)) = SOME 0``;
val _=observe "mixed_index" ``loc_to_pc 1 7 (enc_sec_list (K [0w;1w]) ([Section 1 [Asm (Asmi (Inst Skip)) [] 99;LabAsm Halt 3w [] 123;Label 1 7 456]]:8 sec list)) = SOME 2``;
val _=observe "wrong_section_owner" ``loc_to_pc 99 7 (enc_sec_list (K []) ([Section 1 [Label 99 7 123]]:8 sec list)) = SOME 0``;
val _=observe "duplicate_labels" ``loc_to_pc 1 7 (enc_sec_list (K [0w;1w]) ([Section 1 [Label 1 7 123;Asm (Asmi (Inst Skip)) [] 99;Label 1 7 456]]:8 sec list)) = SOME 0``;
val _=observe "absent" ``loc_to_pc 1 3 (enc_sec_list (K []) ([Section 1 [Label 1 7 99;LabAsm Halt 3w [] 123]]:8 sec list)) = NONE``;
val _=observe "zero_label_ignored" ``loc_to_pc 99 0 (enc_sec_list (K []) ([Section 1 [Label 99 0 123]]:8 sec list)) = NONE``;
val _=observe "width1" ``loc_to_pc 1 7 (enc_sec_list (K [0w]) ([Section 1 [Asm (Asmi (Inst Skip)) [] 99;Label 1 7 123]]:1 sec list)) = SOME 1``;
val _=observe "width80_large_ids" ``loc_to_pc 1208925819614629174706176 7 (enc_sec_list (K []) ([Section 1 [Label 1208925819614629174706176 7 123]]:80 sec list)) = SOME 0``;
