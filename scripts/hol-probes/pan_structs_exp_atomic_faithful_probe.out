compile_exp_correct_full_statement=∀ctxt s e v. eval s e = SOME v ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt e = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt e) = SOME (convert_v v)
compile_exp_correct_full_hypotheses=0
compile_exp_correct_const_statement=∀s ctxt c v. eval s (Const c) = SOME v ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt (Const c) = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt (Const c)) = SOME (convert_v v)
compile_exp_correct_base_statement=∀s ctxt v. eval s BaseAddr = SOME v ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt BaseAddr = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt BaseAddr) = SOME (convert_v v)
compile_exp_correct_top_statement=∀s ctxt v. eval s TopAddr = SOME v ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt TopAddr = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt TopAddr) = SOME (convert_v v)
compile_exp_correct_cases_proved=T
