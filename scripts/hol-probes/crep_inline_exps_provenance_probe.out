exps_of_nested_seq_assign_typed=∀(ns :num list) (es :α crepLang$exp list) (e :α crepLang$exp). MEM e (exps_of (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns es :α crepLang$prog list)) :α crepLang$exp list) ⇒ MEM e es
exps_of_arg_load_typed=∀(e :α crepLang$exp) (tmp_vars :num list) (args :α crepLang$exp list) (args_vname :num list) (p :α crepLang$prog). MEM e (exps_of (arg_load tmp_vars args args_vname p) :α crepLang$exp list) ⇒ MEM e args ∨ (∃(c :num). MEM c tmp_vars ∧ e = (Var c :α crepLang$exp)) ∨ MEM e (exps_of p :α crepLang$exp list)
exps_of_unreach_elim_typed=∀(p :α crepLang$prog) (q :α crepLang$prog) (r :early_exit option) (e :α crepLang$exp) (rt :β). unreach_elim p = (q,r) ∧ MEM e (exps_of q :α crepLang$exp list) ⇒ MEM e (exps_of p :α crepLang$exp list)
exps_of_transform_eoc_typed=∀(rts :num list) (p :α crepLang$prog) (e :α crepLang$exp). MEM e (exps_of (transform_eoc rts p) :α crepLang$exp list) ⇒ MEM e (exps_of p :α crepLang$exp list)
exps_of_transform_branch_typed=∀(ld :num) (rts :num list) (p :α crepLang$prog) (e :α crepLang$exp). MEM e (exps_of (transform_branch ld rts p) :α crepLang$exp list) ⇒ MEM e (exps_of p :α crepLang$exp list)
