shift_correct_replay_typed=(∀(xs :closLang$exp list) (env :v list) (s1 :(γ, 'ffi) state) (env' :v list) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (m :num) (l :num) (i :num sptree$num_map). evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ LENGTH env = m + l ∧ (λ(y :num). alt_fv_set xs y) ⊆ env_ok m l i env env' ∧ every_Fn_vs_NONE xs ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_vs_NONE [SND (SND p)]) s1.code ∧ (∀(n :num). every_Fn_vs_NONE (FST (SND (s1.compile_oracle n))) ∧ every_Fn_vs_NONE (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (SND (SND (s1.compile_oracle n))))) ∧ state_rel s1 t1 ⇒ ∃(res' :(v list, v) result) (t2 :(γ, 'ffi) state). evaluate (shift (FST (alt_free xs)) m l i,env',t1) = (res',t2) ∧ result_rel (LIST_REL v_rel) v_rel res res' ∧ state_rel s2 t2) ∧ ∀(loc_opt :num option) (f :v) (args :v list) (s1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(γ, 'ffi) state) (f' :v) (args' :v list) (s1' :(γ, 'ffi) state). evaluate_app loc_opt f args s1 = (res,s2) ∧ v_rel f f' ∧ LIST_REL v_rel args args' ∧ FEVERY (λ(p :num # num # closLang$exp). every_Fn_vs_NONE [SND (SND p)]) s1.code ∧ (∀(n :num). every_Fn_vs_NONE (FST (SND (s1.compile_oracle n))) ∧ every_Fn_vs_NONE (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (SND (SND (s1.compile_oracle n))))) ∧ state_rel s1 s1' ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(res' :(v list, v) result) (s2' :(γ, 'ffi) state). evaluate_app loc_opt f' args' s1' = (res',s2') ∧ result_rel (LIST_REL v_rel) v_rel res res' ∧ state_rel s2 s2'
