find_code_labels=(find_code (d :num + β) (r :β |-> γ word_loc)
   (code :α stackLang$prog sptree$num_map) :α stackLang$prog option) =
SOME (e :α stackLang$prog) ⇒
get_labels e ⊆ loc_check code
find_code_labels_types=(e :α stackLang$prog)::α stackLang$prog;(code :α stackLang$prog sptree$num_map)::α stackLang$prog sptree$num_map;(r :β |-> γ word_loc)::β |-> γ word_loc;(d :num + β)::num + β;
find_code=(∀(p :num) (regs :β |-> γ word_loc) (code :α sptree$num_map).
   (find_code (INL p :num + β) regs code :α option) = lookup p code) ∧
∀(r :β) (regs :β |-> γ word_loc) (code :α sptree$num_map).
  (find_code (INR r :num + β) regs code :α option) =
  case FLOOKUP regs r of
    (NONE :γ word_loc option) => (NONE :α option)
  | SOME (Word v5) => (NONE :α option)
  | SOME (Loc loc (0 :num) :γ word_loc) => lookup loc code
  | SOME (Loc loc (SUC v9) :γ word_loc) => (NONE :α option)
find_code_types=
get_labels=(∀(p2 :α stackLang$prog) (p1 :α stackLang$prog).
   get_labels (Seq p1 p2) = get_labels p1 ∪ get_labels p2) ∧
(∀(v2 :α reg_imm) (v1 :num) (v0 :cmp) (p2 :α stackLang$prog)
     (p1 :α stackLang$prog).
   get_labels (If v0 v1 v2 p1 p2 :α stackLang$prog) =
   get_labels p1 ∪ get_labels p2) ∧
(∀(p :α stackLang$prog). get_labels (Loop p :α stackLang$prog) = get_labels p) ∧
(∀(v3 :num + num) (ret :(α stackLang$prog # num # num # num) option)
     (handler :(α stackLang$prog # num # num) option).
   get_labels (Call ret v3 handler :α stackLang$prog) =
   case ret of
     (NONE :(α stackLang$prog # num # num # num) option) =>
       (∅ :num # num -> bool)
   | SOME (r,v5,l1,l2) =>
     (l1,l2) INSERT
     get_labels r ∪
     case handler of
       (NONE :(α stackLang$prog # num # num) option) =>
         (∅ :num # num -> bool)
     | SOME (r',l1',l2') => (l1',l2') INSERT get_labels r') ∧
(∀(v4 :num). get_labels (Halt v4 :α stackLang$prog) = (∅ :num # num -> bool)) ∧
