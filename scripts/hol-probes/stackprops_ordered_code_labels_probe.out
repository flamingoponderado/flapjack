extract_labels=(∀(ret :(α stackLang$prog # num # num # num) option)
     (h :(α stackLang$prog # num # num) option) (dest :num + num).
   extract_labels (Call ret dest h :α stackLang$prog) =
   case ret of
     (NONE :(α stackLang$prog # num # num # num) option) =>
       ([] :(num # num) list)
   | SOME (ret_handler,v5,l1,l2) =>
     (let
        (ret_rest :(num # num) list) = extract_labels ret_handler
      in
        case h of
          (NONE :(α stackLang$prog # num # num) option) =>
            [(l1,l2)] ++ ret_rest
        | SOME (prog,l1',l2') =>
          (let
             (h_rest :(num # num) list) = extract_labels prog
           in
             [(l1,l2); (l1',l2')] ++ ret_rest ++ h_rest))) ∧
(∀(s1 :α stackLang$prog).
   extract_labels (Loop s1 :α stackLang$prog) = extract_labels s1) ∧
(∀(s2 :α stackLang$prog) (s1 :α stackLang$prog).
   extract_labels (Seq s1 s2) = extract_labels s1 ++ extract_labels s2) ∧
(∀(ri :α reg_imm) (r1 :num) (e3 :α stackLang$prog) (e2 :α stackLang$prog)
     (cmp :cmp).
   extract_labels (If cmp r1 ri e2 e3 :α stackLang$prog) =
   extract_labels e2 ++ extract_labels e3) ∧
extract_labels (Skip :α stackLang$prog) = ([] :(num # num) list) ∧
(∀(v3 :α inst).
   extract_labels (Inst v3 :α stackLang$prog) = ([] :(num # num) list)) ∧
(∀(v8 :store_name) (v7 :num).
