loc_check=∀(code :α stackLang$prog sptree$num_map) (l1 :num) (l2 :num).
  loc_check code (l1,l2) ⇔
  l2 = (0 :num) ∧ l1 ∈ (domain code :num -> bool) ∨
  ∃(n :num) (e :α stackLang$prog).
    lookup n code = SOME e ∧ (l1,l2) ∈ get_labels e
