state_rel_def_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ t = s with <|code := map ((I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) s.code; compile := t.compile; compile_oracle := ((I :γ -> γ) ## MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x])))) ∘ s.compile_oracle|> ∧ s.compile = (λ(cfg :γ) (prog :(num # num # bvl$exp) list). t.compile cfg (MAP ((I :num -> num) ## (I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) prog))
evaluate_remove_ticks_typed=∀(k :num) (xs :bvl$exp list) (env :v list) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state) (res :(v list, v) result) (s' :(γ, 'ffi) state). state_rel t s ∧ s.clock = k ∧ evaluate (remove_ticks xs,env,s) = (res,s') ⇒ ∃(ck :num) (t' :(γ, 'ffi) state). evaluate (xs,env,t with clock := t.clock + ck) = (res,t') ∧ state_rel t' s'
remove_ticks_cc_def_typed=∀(cc :α -> (β # γ # bvl$exp) list -> δ). remove_ticks_cc cc = (λ(cfg :α) (prog' :(β # γ # bvl$exp) list). cc cfg (MAP ((I :β -> β) ## (I :γ -> γ) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) prog'))
remove_ticks_co_def_typed=(remove_ticks_co :α # (β # γ # bvl$exp) list -> α # (β # γ # bvl$exp) list) = (I :α -> α) ## MAP ((I :β -> β) ## (I :γ -> γ) ## (λ(x :bvl$exp). HD (remove_ticks [x])))
evaluate_compile_prog_typed=evaluate ([(Call (0 :num) (SOME (start :num)) ([] :bvl$exp list) :bvl$exp)],([] :v list),(initial_state (ffi0 :'ffi ffi_state) (map ((I :num -> num) ## (λ(x :bvl$exp). HD (remove_ticks [x]))) (prog :(num # bvl$exp) sptree$num_map)) ((remove_ticks_co :γ # (num # num # bvl$exp) list -> γ # (num # num # bvl$exp) list) ∘ (co :num -> γ # (num # num # bvl$exp) list)) (cc :γ -> (num # num # bvl$exp) list -> (word8 list # word64 list # γ) option) (k :num) :(γ, 'ffi) state)) = ((r :(v list, v) result),(s :(γ, 'ffi) state)) ⇒ ∃(ck :num) (s2 :(γ, 'ffi) state). evaluate ([(Call (0 :num) (SOME start) ([] :bvl$exp list) :bvl$exp)],([] :v list),(initial_state ffi0 prog co (remove_ticks_cc cc) (k + ck) :(γ, 'ffi) state)) = (r,s2) ∧ s2.ffi = s.ffi
subspt_exp_rel_typed=∀(s1 :(num # bvl$exp) sptree$num_map) (s2 :(num # bvl$exp) sptree$num_map) (xs :bvl$exp list) (ys :bvl$exp list). subspt s1 s2 ∧ exp_rel s1 xs ys ⇒ exp_rel s2 xs ys
exp_rel_swap_typed=∀(x1 :(num # bvl$exp) sptree$num_map) (x2 :bvl$exp list) (x3 :bvl$exp list) (y1 :(num # bvl$exp) sptree$num_map). (∀(k :num). lookup k x1 = lookup k y1) ⇒ (exp_rel x1 x2 x3 ⇔ exp_rel y1 x2 x3)
exp_rel_refl_typed=∀(cs :(num # bvl$exp) sptree$num_map) (xs :bvl$exp list). exp_rel cs xs xs
exp_rel_tick_inline_typed=∀(cs0 :(num # bvl$exp) sptree$num_map) (xs :bvl$exp list). (∀(k :num) (arity :num) (v :bvl$exp). lookup k cs0 = SOME (arity,v) ⇒ ∃(exp :bvl$exp). lookup k (src_code :(num # bvl$exp) sptree$num_map) = SOME (arity,exp) ∧ exp_rel src_code [exp] [v]) ⇒ exp_rel src_code xs (tick_inline cs0 xs)
tick_inline_all_names_typed=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (t :(num # num # bvl$exp) list) (aux :α) (cs1 :(num # bvl$exp) sptree$num_map) (xs :(num # num # bvl$exp) list) (aux :(num # num # bvl$exp) list). tick_inline_all limit cs t aux = (cs1,xs) ⇒ MAP (FST :num # num # bvl$exp -> num) (REVERSE aux) ++ MAP (FST :num # num # bvl$exp -> num) t = MAP (FST :num # num # bvl$exp -> num) xs
in_cc_def_typed=∀(limit :num) (cc :α -> (num # num # bvl$exp) list -> (β # γ # δ) option). in_cc limit cc = (λ((cs :(num # bvl$exp) sptree$num_map),(cfg :α)) (prog :(num # num # bvl$exp) list). (let ((cs1 :(num # bvl$exp) sptree$num_map),(prog1 :(num # num # bvl$exp) list)) = tick_compile_prog limit cs prog in case cc cfg prog1 of (NONE :(β # γ # δ) option) => (NONE :(β # γ # (num # bvl$exp) sptree$num_map # δ) option) | SOME (code,data,cfg1) => SOME (code,data,cs1,cfg1)))
in_co_def_typed=∀(limit :num) (co :α -> ((num # bvl$exp) sptree$num_map # β) # (num # num # bvl$exp) list). in_co limit co = (λ(n :α). (let (((cs :(num # bvl$exp) sptree$num_map),(cfg :β)),(progs :(num # num # bvl$exp) list)) = co n; ((cs1 :(num # bvl$exp) sptree$num_map),(progs :(num # num # bvl$exp) list)) = tick_compile_prog limit cs progs in (cfg,progs)))
in_state_rel_def_typed=∀(limit :num) (s :((num # bvl$exp) sptree$num_map # α, β) state) (t :(α, β) state). in_state_rel limit s t ⇔ t.globals = s.globals ∧ t.refs = s.refs ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ t.compile_oracle = (λ(n :num). (let (((cs :(num # bvl$exp) sptree$num_map),(cfg :α)),(progs :(num # num # bvl$exp) list)) = (s.compile_oracle n :((num # bvl$exp) sptree$num_map # α) # (num # num # bvl$exp) list); ((cs1 :(num # bvl$exp) sptree$num_map),(progs :(num # num # bvl$exp) list)) = tick_compile_prog limit cs progs in (cfg,progs))) ∧ subspt (FST (FST (s.compile_oracle (0 :num) :((num # bvl$exp) sptree$num_map # α) # (num # num # bvl$exp) list))) t.code ∧ s.compile = in_cc limit t.compile ∧ (domain t.code :num -> bool) = (domain s.code :num -> bool) ∧ ∀(k :num) (arity :num) (exp :bvl$exp). lookup k s.code = SOME (arity,exp) ⇒ ∃(exp2 :bvl$exp). lookup k t.code = SOME (arity,exp2) ∧ exp_rel s.code [exp] [exp2]
MAP_FST_tick_inline_all_typed=∀(limit :num) (cs :(num # bvl$exp) sptree$num_map) (prog :(num # num # bvl$exp) list). MAP (FST :num # num # bvl$exp -> num) (SND (tick_inline_all limit cs prog ([] :(num # num # bvl$exp) list))) = MAP (FST :num # num # bvl$exp -> num) prog
evaluate_inline_typed=∀(es :bvl$exp list) (env :v list) (s1 :((num # bvl$exp) sptree$num_map # α, β) state) (res :(v list, v) result) (t1 :(α, β) state) (s2 :((num # bvl$exp) sptree$num_map # α, β) state) (es2 :bvl$exp list). in_state_rel (limit :num) s1 t1 ∧ exp_rel s1.code es es2 ∧ evaluate (es,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(t2 :(α, β) state). evaluate (es2,env,t1) = (res,t2) ∧ in_state_rel limit s2 t2
tick_compile_prog_res_range_typed=∀(in1 :(num # num # bvl$exp) list) (limit :num) (in2 :(num # num # bvl$exp) list) (c :(num # bvl$exp) sptree$num_map) (cs0 :(num # bvl$exp) sptree$num_map) (cs1 :(num # bvl$exp) sptree$num_map). tick_compile_prog limit cs0 in1 = (cs1,in2) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) in1) ∧ subspt cs0 c ∧ (domain c :num -> bool) ∩ set (MAP (FST :num # num # bvl$exp -> num) in1) = (∅ :num -> bool) ⇒ subspt cs1 (union c (fromAList in2))
LENGTH_let_op_typed=∀(xs :bvl$exp list). LENGTH (let_op xs) = LENGTH xs
HD_let_op_typed=[HD (let_op [(x :bvl$exp)])] = let_op [x]
