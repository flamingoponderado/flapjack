code_list_type=:num -> ('a # 'b) list -> 'c # (num # 'a # 'b) list -> 'c # (num # 'a # 'b) list
insert_each_typed=(!(p :num) (g :sptree$num_set # 'a). insert_each p (0 :num) g = g) /\ !(p :num) (n :num) (g2 :'a) (g1 :sptree$num_set). insert_each p (SUC n) (g1,g2) = insert_each (p + (2 :num)) n (insert p () g1,g2)
fst_type=!(loc :num) (fns :('a # 'b) list) (g :'c # (num # 'a # 'b) list). FST (code_list loc fns g) = FST g
snd_type=!(loc :num) (fns :('a # 'b) list) (g :'c # (num # 'a # 'b) list) (g' :'d # (num # 'a # 'b) list). SND g = SND g' ==> SND (code_list loc fns g) = SND (code_list loc fns g')
map_fst_type=!(loc :num) (fns :('a # 'b) list) (g :'c # (num # 'a # 'b) list). MAP (FST :num # 'a # 'b -> num) (SND (code_list loc fns g)) = REVERSE (GENLIST (\(i :num). loc + i * (2 :num) + (1 :num)) (LENGTH fns)) ++ MAP (FST :num # 'a # 'b -> num) (SND g)
snd_zip_type=!(loc :num) (fns :('a # 'b) list) (g :'c # (num # 'a # 'b) list). SND (code_list loc fns g) = REVERSE (ZIP (GENLIST ($+ (loc + (1 :num)) o $* (2 :num)) (LENGTH fns),fns)) ++ SND g
alookup_code_list_type=!(loc :num) (fns :('a # 'b) list) (g :'c # (num # 'a # 'b) list) (k :num). ALOOKUP (SND (code_list loc fns g)) k = case some(i :num). i < LENGTH fns /\ k = loc + (2 :num) * i + (1 :num) of (NONE :num option) => ALOOKUP (SND g) k | SOME i => SOME (fEL fns i)
code_list_replace_snd_type=!(loc :num) (fns :('a # 'b) list) (g0 :'c # (num # 'a # 'b) list) (g :'c # (num # 'a # 'b) list) (g0' :'c # (num # 'a # 'b) list) (ls :(num # 'a # 'b) list). code_list loc fns g0 = g /\ FST g0 = FST g0' /\ SND g = ls ++ SND g0 ==> code_list loc fns g0' = (FST g,ls ++ SND g0')
calls_code_subset_type=!(xs :closLang$exp list) (g0 :sptree$num_set # (num # num # closLang$exp) list) (ys :closLang$exp list) (g :sptree$num_set # (num # num # closLang$exp) list). calls xs g0 = (ys,g) ==> IMAGE SUC (domain (FST g0) :num -> bool) SUBSET IMAGE SUC (domain (FST g) :num -> bool) /\ set (MAP (FST :num # num # closLang$exp -> num) (SND g0)) SUBSET set (MAP (FST :num # num # closLang$exp -> num) (SND g)) /\ set (MAP (FST :num # num # closLang$exp -> num) (SND g)) SUBSET IMAGE SUC (domain (FST g) :num -> bool) UNION set (MAP (FST :num # num # closLang$exp -> num) (SND g0))
calls_domain_type=!(xs :closLang$exp list) (g0 :sptree$num_set # (num # num # closLang$exp) list) (ys :closLang$exp list) (g :sptree$num_set # (num # num # closLang$exp) list). calls xs g0 = (ys,g) ==> (domain (FST g) :num -> bool) SUBSET (domain (FST g0) :num -> bool) UNION IMAGE PRE (set (MAP (FST :num # num # closLang$exp -> num) (SND g)))
calls_replace_snd_type=!(xs :closLang$exp list) (g0 :sptree$num_set # (num # num # closLang$exp) list) (ys :closLang$exp list) (g :sptree$num_set # (num # num # closLang$exp) list) (g0' :sptree$num_set # (num # num # closLang$exp) list) (ls :(num # num # closLang$exp) list). calls xs g0 = (ys,g) /\ FST g0 = FST g0' /\ SND g = ls ++ SND g0 ==> calls xs g0' = (ys,FST g,ls ++ SND g0')
calls_acc_type=!(xs :closLang$exp list) (d :sptree$num_set) (old :(num # num # closLang$exp) list) (res :closLang$exp list) (d1 :sptree$num_set) (aux :(num # num # closLang$exp) list). calls xs (d,([] :(num # num # closLang$exp) list)) = (res,d1,aux) ==> calls xs (d,old) = (res,d1,aux ++ old)
insert_each_prime_def_type=(!(p :num) (gt :(num # 'a) list) (g :sptree$num_set # (num # 'a) list). insert_each' gt p (0 :num) g = g) /\ !(p :num) (n :num) (gt :(num # 'a) list) (g2 :(num # 'a) list) (g1 :sptree$num_set). insert_each' gt p (SUC n) (g1,g2) = insert_each' gt (p + (2 :num)) n (insert p () g1,(p + (1 :num),THE (ALOOKUP gt (p + (1 :num))))::g2)
wfg_insert_each_prime_type=!(gt :(num # 'a) list) (p :num) (n :num) (g :sptree$num_set # (num # 'a) list). wfg g /\ DISJOINT (set (GENLIST (\(i :num). p + (2 :num) * i) n)) (domain (FST g) :num -> bool) ==> wfg (insert_each' gt p n g)
fst_insert_each_prime_type=!(gt :(num # 'a) list) (p :num) (n :num) (g :sptree$num_set # (num # 'a) list). FST (insert_each' gt p n g) = FST (insert_each p n g)
map_fst_insert_each_prime_type=!(gt :(num # 'a) list) (p :num) (n :num) (g :sptree$num_set # (num # 'a) list). MAP (FST :num # 'a -> num) (SND (insert_each' gt p n g)) = REVERSE (GENLIST (\(i :num). p + i * (2 :num) + (1 :num)) n) ++ MAP (FST :num # 'a -> num) (SND g)
snd_insert_each_prime_type=!(gt :(num # 'a) list) (p :num) (n :num) (g :sptree$num_set # (num # 'a) list). SND (insert_each' gt p n g) = REVERSE (GENLIST (\(i :num). ((2 :num) * i + p + (1 :num),THE (ALOOKUP gt ((2 :num) * i + p + (1 :num))))) n) ++ SND g
suffix_type=!(loc :num) (fns :('a # 'b) list) (g :'c # (num # 'a # 'b) list). IS_SUFFIX (SND (code_list loc fns g)) (SND g)
example=(LN,[(15,1,Var None 2); (13,0,Var None 9); (11,2,Var None 4); (90,3,Var None 0)])
