dest_closure_v_rel_lookup_type=dest_closure (max_app :num) (SOME (loc :num)) (v1 :v) (env1 :v list) = SOME (x :app_kind) /\ v_rel (g :sptree$num_set # (num # num # closLang$exp) list) (l :num -> bool) (code :num |-> num # closLang$exp) v1 (v2 :v) /\ LIST_REL (v_rel g l code) env1 (env2 :v list) /\ wfg g /\ loc IN (domain (FST g) :num -> bool) /\ loc NOTIN l ==> ?(e :closLang$exp) (l1 :v list) (xs :(num # closLang$exp) list) (n :num) (ls :closLang$exp list) (g01 :sptree$num_set # (num # num # closLang$exp) list) (g1 :sptree$num_set # (num # num # closLang$exp) list) (l1' :v list) (tra :tra) (i :'a). x = Full_app e (env1 ++ l1) ([] :v list) /\ fEL xs n = (LENGTH env1,e) /\ calls (MAP (SND :num # closLang$exp -> closLang$exp) xs) g01 = (ls,g1) /\ n < LENGTH ls /\ subg (code_list (loc - (2 :num) * n) (ZIP (MAP (FST :num # closLang$exp -> num) xs,ls)) g1) g /\ ALOOKUP (SND g) (loc + (1 :num)) = SOME (LENGTH env1,fEL ls n) /\ dest_closure max_app (SOME loc) v2 env2 = SOME (Full_app (Call tra (0 :num) (loc + (1 :num)) (GENLIST_Var tra (1 :num) (LENGTH env1))) (env2 ++ l1') ([] :v list)) /\ code_includes (SND (code_list (loc - (2 :num) * n) (ZIP (MAP (FST :num # closLang$exp -> num) xs,ls)) g1)) code
dest_closure_v_rel_type=dest_closure (max_app :num) (loco :num option) (v1 :v) (env1 :v list) = SOME (x1 :app_kind) /\ v_rel (g :sptree$num_set # (num # num # closLang$exp) list) (l :num -> bool) (code :num |-> num # closLang$exp) v1 (v2 :v) /\ LIST_REL (v_rel g l code) env1 (env2 :v list) ==> ?(x2 :app_kind). dest_closure max_app loco v2 env2 = SOME x2 /\ case x1 of Partial_app c1 => ?(c2 :v). x2 = Partial_app c2 /\ v_rel g l code c1 c2 | Full_app e1 args1 rest1 => ?(fns1 :(num # closLang$exp) list) (loc :num) (i :num) (fns2 :(num # closLang$exp) list) (args2 :v list) (rest2 :v list) (n :num). x2 = Full_app (SND (fEL fns2 i)) args2 rest2 /\ (let (m :num) = if is_Recclosure v2 then LENGTH fns2 else (0 :num) in n + m <= LENGTH args1 /\ n + m <= LENGTH args2 /\ LIST_REL (v_rel g l code) (TAKE (n + m) args1) (TAKE (n + m) args2) /\ env_rel (v_rel g l code) (DROP (n + m) args1) (DROP (n + m) args2) m [fEL fns2 i]) /\ LIST_REL (v_rel g l code) rest1 rest2 /\ recclosure_rel g l code loc fns1 fns2 /\ i < LENGTH fns1 /\ fEL fns1 i = (n,e1)
