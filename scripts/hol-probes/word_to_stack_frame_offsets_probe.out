fo_full_abs_frame_eq_def=⊢ ∀p q. abs_frame_eq p q ⇔ FST p = FST q ∧ FST (SND p) = FST (SND q) ∧ LENGTH (SND (SND p)) = LENGTH (SND (SND q))
fo_full_LIST_REL_abs_frame_eq_handler_val=⊢ ∀xs ys. LIST_REL abs_frame_eq xs ys ⇒ handler_val xs = handler_val ys
fo_full_abs_stack_to_stack_LENGTH=⊢ ∀bs wstack sstack lens stack. abs_stack bs wstack sstack lens = SOME stack ⇒ handler_val stack = LENGTH sstack
fo_full_LASTN_MORE=⊢ ∀ls n. ¬(n < LENGTH ls) ⇒ LASTN n ls = ls
fo_full_abs_stack_len=⊢ ∀bs wstack sstack lens stack handler. abs_stack bs wstack sstack lens = SOME stack ⇒ handler_val (LASTN handler stack) ≤ LENGTH sstack
