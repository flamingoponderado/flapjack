stack_to_lab_compile_all_enc_ok_statement=EVERY (λ(n,p). stack_asm_name c p) prog ∧ EVERY (λ(n,p). stack_asm_remove c p) prog ∧ names_ok c1.reg_names c.reg_count c.avoid_regs ∧ fixed_names c1.reg_names c ∧ addr_offset_ok c 0w ∧ good_dimindex (:α) ∧ byte_offset_ok c 0w ∧ (∀n. n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub) (n2w (n * (dimindex (:α) DIV 8))) ∧ c.valid_imm (INL Add) (n2w (n * (dimindex (:α) DIV 8)))) ∧ c.valid_imm (INL Add) 1w ∧ c.valid_imm (INL Sub) 1w ∧ c.valid_imm (INL Add) 4w ∧ c.valid_imm (INL Add) 8w ∧ (∀s. addr_offset_ok c (store_offset s)) ∧ reg_name 10 c ∧ reg_name (sp + 2) c ∧ reg_name (sp + 1) c ∧ reg_name sp c ∧ conf_ok (:α) c2 ∧ sp ≠ 0 ⇒ all_enc_ok_pre c (compile c1 c2 c3 sp c.addr_offset prog)
stack_to_lab_compile_all_enc_ok_statement_typed=EVERY (λ((n :num),(p :α prog)). stack_asm_name (c :α asm_config) p) (prog :(num # α prog) list) ∧ EVERY (λ((n :num),(p :α prog)). stack_asm_remove c p) prog ∧ names_ok (c1 :stack_to_lab$config).reg_names c.reg_count c.avoid_regs ∧ fixed_names c1.reg_names c ∧ addr_offset_ok c (0w :α word) ∧ good_dimindex (:α) ∧ byte_offset_ok c (0w :α word) ∧ (∀(n :num). n ≤ max_stack_alloc ⇒ c.valid_imm (INL Sub :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word) ∧ c.valid_imm (INL Add :binop + cmp) (n2w (n * (dimindex (:α) DIV (8 :num))) :α word)) ∧ c.valid_imm (INL Add :binop + cmp) (1w :α word) ∧ c.valid_imm (INL Sub :binop + cmp) (1w :α word) ∧ c.valid_imm (INL Add :binop + cmp) (4w :α word) ∧ c.valid_imm (INL Add :binop + cmp) (8w :α word) ∧ (∀(s :store_name). addr_offset_ok c (store_offset s :α word)) ∧ reg_name (10 :num) c ∧ reg_name ((sp :num) + (2 :num)) c ∧ reg_name (sp + (1 :num)) c ∧ reg_name sp c ∧ conf_ok (:α) (c2 :data_to_word$config) ∧ sp ≠ (0 :num) ⇒ all_enc_ok_pre c (compile c1 c2 (c3 :num) sp c.addr_offset prog :α sec list)
