IMP_init_store_ok_statement=max_heap = 2 * max_heap_limit (:α) c1 − 1 ∧ (fmis,xxx) = full_make_init stack_conf c1 max_heap sp offset bitmaps code s save_regs data_sp coracle ⇒ init_store_ok c1 (fmis.store \\ Handler) fmis.memory fmis.mdomain fmis.code_buffer fmis.data_buffer
IMP_init_store_ok_statement_typed=(max_heap :num) = (2 :num) * max_heap_limit (:α) (c1 :data_to_word$config) − (1 :num) ∧ ((fmis :(α, β, γ) stackSem$state),(xxx :(α, β, γ) stackSem$state option)) = full_make_init (stack_conf :stack_to_lab$config) c1 max_heap (sp :num) (offset :α word # α word) (bitmaps :α word list) (code :(num # α prog) list) (s :(α, β, γ) labSem$state) (save_regs :num -> bool) (data_sp :num) (coracle :num -> β # (num # α prog) list # α word list) ⇒ init_store_ok c1 (fmis.store \\ Handler) fmis.memory fmis.mdomain fmis.code_buffer fmis.data_buffer
