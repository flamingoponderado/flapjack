key_def_wordToNum=⊢ ∀w. wordToNum w = w2n w
key_def_shiftToNum=⊢ shiftToNum Lsl = 40 ∧ shiftToNum Lsr = 41 ∧ shiftToNum Asr = 42 ∧ shiftToNum Ror = 43
key_def_arithOpToNum=⊢ arithOpToNum Add = 35 ∧ arithOpToNum Sub = 36 ∧ arithOpToNum And = 37 ∧ arithOpToNum Or = 38 ∧ arithOpToNum Xor = 39
key_def_regImmToNumList=⊢ (∀r. regImmToNumList (Reg r) = [33; r + 100]) ∧ ∀w. regImmToNumList (Imm w) = [34; wordToNum w]
key_def_arithToNumList=⊢ (∀op r1 r2 ri. arithToNumList (Binop op r1 r2 ri) = [25; arithOpToNum op; r2 + 100] ++ regImmToNumList ri) ∧ (∀r1 r2 r3 r4. arithToNumList (LongMul r1 r2 r3 r4) = [26; r3 + 100; r4 + 100]) ∧ (∀r1 r2 r3 r4 r5. arithToNumList (LongDiv r1 r2 r3 r4 r5) = [27; r3 + 100; r4 + 100; r5 + 100]) ∧ (∀s r1 r2 ri. arithToNumList (Shift s r1 r2 ri) = [28; shiftToNum s; r2 + 100] ++ regImmToNumList ri) ∧ (∀r1 r2 r3. arithToNumList (Div r1 r2 r3) = [29; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3 r4. arithToNumList (AddCarry r1 r2 r3 r4) = [30; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3 r4. arithToNumList (AddOverflow r1 r2 r3 r4) = [31; r2 + 100; r3 + 100]) ∧ ∀r1 r2 r3 r4. arithToNumList (SubOverflow r1 r2 r3 r4) = [32; r2 + 100; r3 + 100]
key_def_memOpToNum=⊢ memOpToNum Load = 21 ∧ memOpToNum Load8 = 22 ∧ memOpToNum Load16 = 46 ∧ memOpToNum Load32 = 44 ∧ memOpToNum Store = 23 ∧ memOpToNum Store8 = 47 ∧ memOpToNum Store16 = 24 ∧ memOpToNum Store32 = 45
key_def_loadToNumList=⊢ ∀op a ofs. loadToNumList op a ofs = [memOpToNum op; a + 100; wordToNum ofs]
key_def_fpToNumList=⊢ (∀r1 r2 r3. fpToNumList (FPLess r1 r2 r3) = [5; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPLessEqual r1 r2 r3) = [6; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPEqual r1 r2 r3) = [7; r2 + 100; r3 + 100]) ∧ (∀r1 r2. fpToNumList (FPAbs r1 r2) = [8; r2 + 100]) ∧ (∀r1 r2. fpToNumList (FPNeg r1 r2) = [9; r2 + 100]) ∧ (∀r1 r2. fpToNumList (FPSqrt r1 r2) = [10; r2 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPAdd r1 r2 r3) = [11; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPSub r1 r2 r3) = [12; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPMul r1 r2 r3) = [13; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPDiv r1 r2 r3) = [14; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPFma r1 r2 r3) = [15; r1 + 100; r2 + 100; r3 + 100]) ∧ (∀r1 r2. fpToNumList (FPMov r1 r2) = [16; r2 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPMovToReg r1 r2 r3) = [17; r2 + 100; r3 + 100]) ∧ (∀r1 r2 r3. fpToNumList (FPMovFromReg r1 r2 r3) = [18; r2 + 100; r3 + 100]) ∧
  (∀r1 r2. fpToNumList (FPToInt r1 r2) = [19; r2 + 100]) ∧ ∀r1 r2. fpToNumList (FPFromInt r1 r2) = [20; r2 + 100]
key_def_instToNumList=⊢ instToNumList (Const r w) = [2; wordToNum w] ∧ instToNumList (Arith a) = 3::arithToNumList a ∧ instToNumList (FP fp) = 4::fpToNumList fp ∧ instToNumList Skip = [1] ∧ instToNumList (Mem v3 v4 v5) = [1]
key_def_OpCurrHeapToNumList=⊢ ∀op r2. OpCurrHeapToNumList op r2 = [0; arithOpToNum op; r2 + 100]
