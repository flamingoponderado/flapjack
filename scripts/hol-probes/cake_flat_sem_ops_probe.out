do_opapp_typed=∀(vs :v list). (do_opapp vs :(v environment # exp) option) = case vs of ([] :v list) => (NONE :(v environment # exp) option) | [v4] => (NONE :(v environment # exp) option) | [(Litv v26 :v); v] => (NONE :(v environment # exp) option) | [Conv v27 v28; v] => (NONE :(v environment # exp) option) | [(Closure env n e :v); v] => SOME (env with v updated_by (λ(env :(mlstring # v) list). (n,v)::env),e) | [(Recclosure env' funs n' :v); v] => if ALL_DISTINCT (MAP (FST :mlstring # mlstring # exp -> mlstring) funs) then case find_recfun n' funs of (NONE :(mlstring # exp) option) => (NONE :(v environment # exp) option) | SOME (n,e) => SOME (env' with v := (n,v)::build_rec_env funs env' env'.v,e) else (NONE :(v environment # exp) option) | [(Loc v35 v36 :v); v] => (NONE :(v environment # exp) option) | [Vectorv v37; v] => (NONE :(v environment # exp) option) | v4::v::v12::v13 => (NONE :(v environment # exp) option)

