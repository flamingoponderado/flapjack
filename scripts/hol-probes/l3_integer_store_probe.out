sb_definition=∀rs1 rs2 offs. dfn'SB (rs1,rs2,offs) = (λstate. (let v = GPR rs1 state + sw2sw offs; (v0,s) = translateAddr (v,Data,Write) state in case v0 of NONE => signalAddressException (Store_AMO_Fault,v) s | SOME pAddr => rawWriteData (pAddr,GPR rs2 s,1) s))
