sd_definition=∀rs1 rs2 offs. dfn'SD (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state in if v then signalException Illegal_Instr s else (let v = GPR rs1 s + sw2sw offs; (v0,s) = translateAddr (v,Data,Write) s in case v0 of NONE => signalAddressException (Store_AMO_Fault,v) s | SOME pAddr => rawWriteData (pAddr,GPR rs2 s,8) s)))
