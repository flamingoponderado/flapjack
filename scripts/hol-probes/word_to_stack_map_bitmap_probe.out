mb_full_map_bitmap_success=⊢ ∀bs stack a b ls. filter_bitmap bs stack = SOME (a,b) ∧ LENGTH ls = LENGTH a ⇒ ∃x z. map_bitmap bs ls stack = SOME (x,[],DROP (LENGTH bs) stack) ∧ filter_bitmap bs x = SOME (ls,[])
mb_full_map_bitmap_more=⊢ ∀bs ls stack n a c ls'. map_bitmap bs ls stack = SOME (a,[],c) ⇒ map_bitmap bs (ls ++ ls') stack = SOME (a,ls',c)
mb_full_map_bitmap_more_simp=⊢ map_bitmap bs (TAKE (LENGTH l) ls) stack = SOME (a,[],c) ⇒ map_bitmap bs ls stack = SOME (a,DROP (LENGTH l) ls,c)
mb_full_map_bitmap_LLOOKUP_F=⊢ ∀bm ls stack n res ls1 stack1. LLOOKUP bm n = SOME F ∧ map_bitmap bm ls stack = SOME (res,ls1,stack1) ⇒ ∃v. LLOOKUP res n = SOME v ∧ LLOOKUP stack n = SOME v
