integer_application=do_int_app (Const (n' :int) :int_op) ([] :v list) = (if small_enough_int n' then SOME (Number n' :v) else (NONE :v option)) ∧ do_int_app Add [(Number (n1 :int) :v); (Number (n2 :int) :v)] = SOME (Number (n1 + n2) :v) ∧ do_int_app Sub [(Number n1 :v); (Number n2 :v)] = SOME (Number (n1 − n2) :v) ∧ do_int_app Mult [(Number n1 :v); (Number n2 :v)] = SOME (Number (n1 * n2) :v) ∧ do_int_app Div [(Number n1 :v); (Number n2 :v)] = (if n2 = (0 :int) then (NONE :v option) else SOME (Number (n1 / n2) :v)) ∧ do_int_app Mod [(Number n1 :v); (Number n2 :v)] = (if n2 = (0 :int) then (NONE :v option) else SOME (Number (n1 % n2) :v)) ∧ do_int_app Less [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 < n2) :v) ∧ do_int_app LessEq [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 ≤ n2) :v) ∧ do_int_app Greater [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 > n2) :v) ∧ do_int_app GreaterEq [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 ≥ n2) :v) ∧ do_int_app (LessConstSmall (n :num)) [(Number (i :int) :v)] = (if (0 :int) ≤ i ∧ i ≤ (1000000 :int) ∧ n < (1000000 :num) then SOME (Boolv (i < ((&n) :int)) :v) else (NONE :v option)) ∧ do_int_app Add ([] :v list) = (NONE :v option) ∧ do_int_app Sub ([] :v list) = (NONE :v option) ∧ do_int_app Mult ([] :v list) = (NONE :v option) ∧ do_int_app Div ([] :v list) = (NONE :v option) ∧ do_int_app Mod ([] :v list) = (NONE :v option) ∧ do_int_app Less ([] :v list) = (NONE :v option) ∧ do_int_app LessEq ([] :v list) = (NONE :v option) ∧ do_int_app Greater ([] :v list) = (NONE :v option) ∧ do_int_app GreaterEq ([] :v list) = (NONE :v option) ∧ do_int_app (LessConstSmall (v7 :num)) ([] :v list) = (NONE :v option) ∧ do_int_app (Const (v30 :int) :int_op) [(Number (v14 :int) :v)] = (NONE :v option) ∧ do_int_app Add [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Sub [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Mult [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Div [(Number v14 :v)] = (NONE :v option) ∧ do_int_app M