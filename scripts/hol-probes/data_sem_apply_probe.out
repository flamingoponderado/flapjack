value_to_list=(∀(ts :num) (tag :num). v_to_list (Block ts tag ([] :v list) :v) = if tag = nil_tag then SOME ([] :v list) else (NONE :v list option)) ∧ (∀(ts :num) (tag :num) (h :v) (bt :v). v_to_list (Block ts tag [h; bt] :v) = if tag = cons_tag then case v_to_list bt of (NONE :v list option) => (NONE :v list option) | SOME t => SOME (h::t) else (NONE :v list option)) ∧ (∀(v :int). v_to_list (Number v :v) = (NONE :v list option)) ∧ (∀(v1 :word64). v_to_list (Word64 v1 :v) = (NONE :v list option)) ∧ (∀(v3 :num) (v2 :num) (v16 :v). v_to_list (Block v2 v3 [v16] :v) = (NONE :v list option)) ∧ (∀(v3 :num) (v25 :v list) (v24 :v) (v20 :v) (v2 :num) (v16 :v). v_to_list (Block v2 v3 (v16::v20::v24::v25) :v) = (NONE :v list option)) ∧ (∀(v5 :num). v_to_list (CodePtr v5 :v) = (NONE :v list option)) ∧ ∀(v7 :num) (v6 :bool). v_to_list (RefPtr v6 v7 :v) = (NONE :v list option)
