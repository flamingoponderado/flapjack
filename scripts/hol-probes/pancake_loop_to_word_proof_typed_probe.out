TAKE_1_word_to_bytes_typed=good_dimindex (:α) ⇒ TAKE (1 :num) (word_to_bytes (w :α word) F) = [get_byte (0w :α word) w F]
code_rel_def_typed=∀(s_code :(num list # α prog) sptree$num_map) (t_code :(num # α wordLang$prog) sptree$num_map). code_rel s_code t_code ⇔ ∀(name :num) (params :num list) (body :α prog). lookup name s_code = SOME (params,body) ⇒ lookup name t_code = SOME (LENGTH params + (1 :num),comp_func name params body) ∧ ALL_DISTINCT params
code_rel_intro_typed=code_rel (s_code :(num list # α prog) sptree$num_map) (t_code :(num # α wordLang$prog) sptree$num_map) ⇒ ∀(name :num) (params :num list) (body :α prog). lookup name s_code = SOME (params,body) ⇒ lookup name t_code = SOME (LENGTH params + (1 :num),comp_func name params body) ∧ ALL_DISTINCT params
comp_exp_preserves_eval_typed=∀(s :(α, β) state) (e :α exp) (v :α word_loc) (t :(α, γ, β) wordSem$state) (ctxt :num sptree$num_map). eval s e = SOME v ∧ good_dimindex (:α) ∧ state_rel s t ∧ locals_rel ctxt s.locals t.locals ⇒ (word_exp t (comp_exp ctxt e) :α word_loc option) = SOME v
comp_l_invariant_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num) (prog' :α wordLang$prog) (l' :num # num). comp ctxt prog l = (prog',l') ⇒ FST l' = FST l
compile_correct_typed=∀(v :α prog) (v1 :(α, β) state) (res :α result option) (s1 :(α, β) state) (t :(α, γ, β) wordSem$state) (ctxt :num sptree$num_map) (retv :α word_loc) (l :num # num). (evaluate (v,v1) :α result option # (α, β) state) = (res,s1) ∧ res ≠ SOME (Error :α result) ∧ state_rel v1 t ∧ locals_rel ctxt v1.locals t.locals ∧ lookup (0 :num) t.locals = SOME retv ∧ good_dimindex (:α) ∧ ¬isWord retv ∧ (domain (acc_vars v (LN :sptree$num_set)) :num -> bool) ⊆ (domain ctxt :num -> bool) ⇒ ∃(t1 :(α, γ, β) wordSem$state) (res1 :α wordSem$result option). (evaluate (FST (comp ctxt v l),t) :α wordSem$result option # (α, γ, β) wordSem$state) = (res1,t1) ∧ t1.ffi = s1.ffi ∧ case res of (NONE :α result option) => state_rel s1 t1 ∧ res1 = (NONE :α wordSem$result option) ∧ lookup (0 :num) t1.locals = SOME retv ∧ locals_rel ctxt s1.locals t1.locals ∧ t1.stack = t.stack ∧ t1.handler = t.handler | SOME (Result v :α result) => state_rel s1 t1 ∧ res1 = SOME (Result retv v :α wordSem$result) ∧ t1.stack = t.stack ∧ t1.handler = t.handler | SOME (Exception v' :α result) => state_rel s1 t1 ∧ (res1 ≠ SOME (Error :α wordSem$result) ⇒ ∃(u1 :α word_loc) (u2 :α word_loc). res1 = SOME (Exception u1 u2 :α wordSem$result)) ∧ ∀(r :(α, γ, β) wordSem$state) (l1 :num) (l2 :num). jump_exc (t1 with <|stack := t.stack; handler := t.handler|>) = SOME (r,l1,l2) ⇒ res1 = SOME (Exception (Loc l1 l2 :α word_loc) v' :α wordSem$result) ∧ r = t1 | SOME (Break n :α result) => state_rel s1 t1 ∧ res1 = SOME (Break n :α wordSem$result) ∧ lookup (0 :num) t1.locals = SOME retv ∧ locals_rel ctxt s1.locals t1.locals ∧ t1.stack = t.stack ∧ t1.handler = t.handler | SOME (Continue n' :α result) => state_rel s1 t1 ∧ res1 = SOME (Continue n' :α wordSem$result) ∧ lookup (0 :num) t1.locals = SOME retv ∧ locals_rel ctxt s1.locals t1.locals ∧ t1.stack = t.stack ∧ t1.handler = t.handler | SOME (TimeOut :α result) => res1 = SOME (TimeOut :α wordSem$result) | SOME (FinalFFI f :α result) => res1 = SOME (FinalFFI f :α wordSem$result) | SOME (Error :α result) => F
cut_env_LN_IMP_typed=cut_env ((s :sptree$num_set),(LN :sptree$num_set)) (l :α sptree$num_map) = SOME (env :α sptree$num_map) ⇒ cut_envs (s,(LN :sptree$num_set)) l = SOME (env,(LN :α sptree$num_map))
cut_env_mk_new_cutset_typed=locals_rel (ctxt :num sptree$num_map) (l1 :α sptree$num_map) (l2 :α sptree$num_map) ∧ (domain (x1 :sptree$num_set) :num -> bool) ⊆ (domain l1 :num -> bool) ∧ lookup (0 :num) l2 = SOME (y :α) ⇒ ∃(env1 :α sptree$num_map). cut_env (mk_new_cutset ctxt x1,(LN :sptree$num_set)) l2 = SOME env1 ∧ locals_rel ctxt (inter l1 x1) env1
cut_env_mk_new_cutset_IMP_typed=cut_env (mk_new_cutset (ctxt :num sptree$num_map) (x1 :sptree$num_set),(LN :sptree$num_set)) (l1 :α sptree$num_map) = SOME (l2 :α sptree$num_map) ⇒ lookup (0 :num) l2 = lookup (0 :num) l1
domain_make_ctxt_typed=∀(n :num) (ps :num list) (l :num sptree$num_map). (domain (make_ctxt n ps l) :num -> bool) = (domain l :num -> bool) ∪ set ps
domain_mk_new_cutset_not_empty_typed=(domain (mk_new_cutset (ctxt :num sptree$num_map) (x1 :sptree$num_set)) :num -> bool) ≠ (∅ :num -> bool)
domain_toNumSet_typed=(domain (toNumSet (ps :num list)) :num -> bool) = set ps
env_to_list_IMP_typed=env_to_list (env1 :α word_loc sptree$num_map) (t :(β, γ, δ) wordSem$state).permute = ((l :(num # α word_loc) list),(permute :num -> num -> num)) ⇒ (domain (fromAList l) :num -> bool) = (domain env1 :num -> bool) ∧ ∀(x :num). lookup x (fromAList l) = lookup x env1
env_to_list_LN_IMP_typed=env_to_list (LN :α word_loc sptree$num_map) (l :num -> num -> num) = ((x :(num # α word_loc) list),(p :num -> num -> num)) ⇒ x = ([] :(num # α word_loc) list)
find_var_neq_0_typed=(v :num) ∈ (domain (ctxt :num sptree$num_map) :num -> bool) ∧ locals_rel ctxt (lcl :α sptree$num_map) (lcl' :α sptree$num_map) ⇒ find_var ctxt v ≠ (0 :num)
find_var_neq_0_ctxt_typed=(∀(n :num) (m :num). lookup n (ctxt :num sptree$num_map) = SOME m ⇒ m ≠ (0 :num) ∧ EVEN m) ∧ (v :num) ∈ (domain ctxt :num -> bool) ⇒ find_var ctxt v ≠ (0 :num)
find_var_neq_odd_typed=(∀(n :num) (m :num). lookup n (ctxt :num sptree$num_map) = SOME m ⇒ m ≠ (0 :num) ∧ EVEN m) ∧ ¬EVEN (k :num) ⇒ find_var ctxt (v :num) ≠ k
first_compile_all_distinct_typed=∀(prog :(num # num list # α prog) list). ALL_DISTINCT (MAP (FST :num # num list # α prog -> num) prog) ⇒ ALL_DISTINCT (MAP (FST :num # num # α wordLang$prog -> num) (compile prog))
first_compile_prog_all_distinct_typed=∀(prog :(num # num list # α prog) list). ALL_DISTINCT (MAP (FST :num # num list # α prog -> num) prog) ⇒ ALL_DISTINCT (MAP (FST :num # num # α wordLang$prog -> num) (compile_prog prog))
globals_rel_def_typed=∀(g1 :word5 |-> α) (g2 :store_name |-> α). globals_rel g1 g2 ⇔ ∀(n :word5) (v :α). FLOOKUP g1 n = SOME v ⇒ FLOOKUP g2 (Temp n) = SOME v
globals_rel_intro_typed=globals_rel (g1 :word5 |-> α) (g2 :store_name |-> α) ⇒ ∀(n :word5) (v :α). FLOOKUP g1 n = SOME v ⇒ FLOOKUP g2 (Temp n) = SOME v
good_handlers_comp_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num). word_good_handlers (FST l) (FST (comp ctxt prog l))
locals_rel_ALL_DISTINCT_MAP_typed=locals_rel (ctxt :num sptree$num_map) (lcl :α sptree$num_map) (lcl' :α sptree$num_map) ∧ set (xs :num list) ⊆ (domain ctxt :num -> bool) ∧ ALL_DISTINCT xs ⇒ ALL_DISTINCT (MAP (find_var ctxt) xs)
locals_rel_alist_insert_typed=∀(vs :num list) (ws :α list) (lcl :α sptree$num_map) (lcl' :α sptree$num_map). locals_rel (ctxt :num sptree$num_map) lcl lcl' ∧ set vs ⊆ (domain ctxt :num -> bool) ⇒ locals_rel ctxt (alist_insert vs ws lcl) (alist_insert (MAP (find_var ctxt) vs) ws lcl')
locals_rel_alist_insert_toAList_typed=∀(vs :num list) (ws :α list) (lcl :α sptree$num_map) (env :α sptree$num_map). locals_rel (ctxt :num sptree$num_map) lcl env ∧ set vs ⊆ (domain ctxt :num -> bool) ⇒ locals_rel ctxt (alist_insert vs ws lcl) (alist_insert (MAP (find_var ctxt) vs) ws (fromAList (toAList env)))
locals_rel_def_typed=∀(ctxt :num sptree$num_map) (l1 :α sptree$num_map) (l2 :α sptree$num_map). locals_rel ctxt l1 l2 ⇔ INJ (find_var ctxt) (domain ctxt :num -> bool) 𝕌(:num) ∧ (∀(n :num) (m :num). lookup n ctxt = SOME m ⇒ m ≠ (0 :num) ∧ EVEN m) ∧ ∀(n :num) (v :α). lookup n l1 = SOME v ⇒ ∃(m :num). lookup n ctxt = SOME m ∧ lookup m l2 = SOME v
locals_rel_get_var_typed=locals_rel (ctxt :num sptree$num_map) (l :α word_loc sptree$num_map) (t :(α, β, γ) wordSem$state).locals ∧ lookup (n :num) l = SOME (w :α word_loc) ⇒ get_var (find_var ctxt n) t = SOME w
locals_rel_get_vars_typed=∀(argvars :num list) (argvals :α word_loc list). locals_rel (ctxt :num sptree$num_map) (s :(α, β) state).locals (t :(α, γ, δ) wordSem$state).locals ∧ (get_vars argvars s :α word_loc list option) = SOME argvals ⇒ (get_vars (MAP (find_var ctxt) argvars) t :α word_loc list option) = SOME argvals ∧ LENGTH argvals = LENGTH argvars
locals_rel_insert_typed=locals_rel (ctxt :num sptree$num_map) (lcl :α sptree$num_map) (lcl' :α sptree$num_map) ∧ (v :num) ∈ (domain ctxt :num -> bool) ⇒ locals_rel ctxt (insert v (w :α) lcl) (insert (find_var ctxt v) w lcl')
locals_rel_insert_unmapped_typed=locals_rel (ctxt :num sptree$num_map) (lcl :α sptree$num_map) (lcl' :α sptree$num_map) ∧ (∀(n :num). n ∈ (domain ctxt :num -> bool) ⇒ find_var ctxt n ≠ (k :num)) ⇒ locals_rel ctxt lcl (insert k (x :α) lcl')
locals_rel_intro_typed=locals_rel (ctxt :num sptree$num_map) (l1 :α sptree$num_map) (l2 :α sptree$num_map) ⇒ INJ (find_var ctxt) (domain ctxt :num -> bool) 𝕌(:num) ∧ (∀(n :num) (m :num). lookup n ctxt = SOME m ⇒ m ≠ (0 :num) ∧ EVEN m) ∧ ∀(n :num) (v :α). lookup n l1 = SOME v ⇒ ∃(m :num). lookup n ctxt = SOME m ∧ lookup m l2 = SOME v
locals_rel_make_ctxt_typed=ALL_DISTINCT (params :num list) ∧ DISJOINT (set params) (set (xs :num list)) ∧ LENGTH params = LENGTH (l :α list) ⇒ locals_rel (make_ctxt (2 :num) (params ++ xs) (LN :num sptree$num_map)) (fromAList (ZIP (params,l))) (fromList2 ((retv :α)::l))
locals_rel_mk_ctxt_ln_typed=(0 :num) < (n :num) ∧ EVEN n ⇒ locals_rel (make_ctxt n (xs :num list) (LN :num sptree$num_map)) (LN :α sptree$num_map) (lc :α sptree$num_map)
lookup_EL_make_ctxt_typed=∀(params :num list) (k :num) (n :num) (l :num sptree$num_map). k < LENGTH params ∧ ALL_DISTINCT params ⇒ lookup params❲k❳ (make_ctxt n params l) = SOME ((2 :num) * k + n)
lookup_make_ctxt_EVEN_typed=∀(xs :num list) (m :num) (l :num sptree$num_map) (n :num) (y :num). EVEN m ∧ (∀(k :num) (v :num). lookup k l = SOME v ⇒ EVEN v) ∧ lookup n (make_ctxt m xs l) = SOME y ⇒ EVEN y
lookup_make_ctxt_range_typed=∀(xs :num list) (m :num) (l :num sptree$num_map) (n :num) (y :num). lookup n (make_ctxt m xs l) = SOME y ⇒ lookup n l = SOME y ∨ m ≤ y
lookup_prog_some_lookup_compile_prog_typed=∀(prog :(num # num list # α prog) list) (name :num) (params :num list) (body :α prog). lookup name (fromAList prog) = SOME (params,body) ⇒ lookup name (fromAList (compile_prog prog)) = SOME (LENGTH params + (1 :num),comp_func name params body)
loop_compile_no_alloc_code_typed=no_alloc_code (fromAList (compile (prog :(num # num list # α prog) list)))
loop_compile_no_install_code_typed=no_install_code (fromAList (compile (prog :(num # num list # α prog) list)))
loop_compile_no_mt_code_typed=no_mt_code (fromAList (compile (prog :(num # num list # α prog) list)))
loop_inst_ok_def_typed=(loop_inst_ok (c :α asm_config) (Arith (LDiv (r1 :num) (r2 :num) (r3 :num)) :β prog) ⇔ c.ISA ∈ {ARMv8; MIPS; RISC_V}) ∧ (loop_inst_ok c (Arith (LLongMul r1 r2 r3 (r4 :num)) :β prog) ⇔ (c.ISA = ARMv7 ⇒ r1 ≠ r2) ∧ (c.ISA = ARMv8 ∨ c.ISA = RISC_V ∨ c.ISA = Ag32 ⇒ r1 ≠ r3 ∧ r1 ≠ r4)) ∧ (loop_inst_ok c (Arith (LLongDiv r1 r2 r3 r4 (r5 :num)) :β prog) ⇔ c.ISA = x86_64) ∧ (loop_inst_ok c (Skip :β prog) ⇔ T) ∧ (loop_inst_ok c (Assign (v2 :num) (v3 :β exp) :β prog) ⇔ T) ∧ (loop_inst_ok c (Primitive (v4 :num list) (v5 :primop) (v6 :num list) :β prog) ⇔ T) ∧ (loop_inst_ok c (Store (v8 :β exp) (v9 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (SetGlobal (v10 :word5) (v11 :β exp)) ⇔ T) ∧ (loop_inst_ok c (Load32 (v12 :num) (v13 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (LoadByte (v14 :num) (v15 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Store32 (v16 :num) (v17 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (StoreByte (v18 :num) (v19 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Seq (v20 :β prog) (v21 :β prog)) ⇔ T) ∧ (loop_inst_ok c (If (v22 :cmp) (v23 :num) (v24 :β reg_imm) (v25 :β prog) (v26 :β prog) (v27 :sptree$num_set) :β prog) ⇔ T) ∧ (loop_inst_ok c (Loop (v28 :sptree$num_set) (v29 :β prog) (v30 :sptree$num_set) :β prog) ⇔ T) ∧ (loop_inst_ok c (Break (v31 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Continue (v32 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Raise (v33 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Return (v34 :num list) :β prog) ⇔ T) ∧ (loop_inst_ok c (ShMem (v35 :memop) (v36 :num) (v37 :β exp)) ⇔ T) ∧ (loop_inst_ok c (Tick :β prog) ⇔ T) ∧ (loop_inst_ok c (Mark (v38 :β prog)) ⇔ T) ∧ (loop_inst_ok c (Fail :β prog) ⇔ T) ∧ (loop_inst_ok c (LocValue (v39 :num) (v40 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Call (v41 :(num list # sptree$num_set) option) (v42 :num option) (v43 :num list) (v44 :(num # β prog # β prog # sptree$num_set) option) :β prog) ⇔ T) ∧ (loop_inst_ok c (FFI (v45 :mlstring) (v46 :num) (v47 :num) (v48 :num) (v49 :num) (v50 :sptree$num_set) :β prog) ⇔ T)
loop_to_word_comp_ALL_DISTINCT_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num) (p :α wordLang$prog) (r :num # num). comp ctxt prog l = (p,r) ⇒ ALL_DISTINCT (extract_labels p)
loop_to_word_comp_SND_LE_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num) (p :α wordLang$prog) (r :num # num). comp ctxt prog l = (p,r) ⇒ SND l ≤ SND r
loop_to_word_comp_every_inst_ok_less_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num). byte_offset_ok (c :α asm_config) (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ every_prog (loop_inst_ok c :α prog -> bool) prog ∧ (domain (acc_vars prog (LN :sptree$num_set)) :num -> bool) ⊆ (domain ctxt :num -> bool) ∧ INJ (find_var ctxt) (domain ctxt :num -> bool) 𝕌(:num) ∧ (∀(n :num) (m :num). lookup n ctxt = SOME m ⇒ m ≠ (0 :num) ∧ EVEN m) ⇒ every_inst (inst_ok_less c) (FST (comp ctxt prog l))
loop_to_word_comp_extract_labels_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num) (p :α wordLang$prog) (l' :num # num). comp ctxt prog l = (p,l') ⇒ EVERY (λ((q :num),(r :num)). q = FST l ∧ SND l ≤ r ∧ r < SND l') (extract_labels p)
loop_to_word_comp_extract_labels_len_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num) (p :α wordLang$prog) (r :num # num). comp ctxt prog l = (p,r) ⇒ LENGTH (extract_labels p) = SND r − SND l
loop_to_word_comp_func_every_inst_ok_less_typed=comp_func (n :num) (params :num list) (body :α prog) = (p :α wordLang$prog) ∧ every_prog (loop_inst_ok (c :α asm_config) :α prog -> bool) body ∧ addr_offset_ok c (0w :α word) ∧ byte_offset_ok c (0w :α word) ⇒ every_inst (inst_ok_less c) p
loop_to_word_comp_func_lab_pres_typed=comp_func (n' :num) (params :num list) (body :α prog) = (p :α wordLang$prog) ⇒ (∀(n :num). n < LENGTH (extract_labels p) ⇒ (λ((l1 :num),(l2 :num)). l1 = n' ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) (extract_labels p)❲n❳) ∧ ALL_DISTINCT (extract_labels p)
loop_to_word_comp_func_not_created_typed=(∀(x :α wordLang$prog). (case x of (Skip :α wordLang$prog) => F | (Move v61 v62 :α wordLang$prog) => F | (Inst v63 :α wordLang$prog) => F | (Assign v64 v65 :α wordLang$prog) => F | (Get v66 v67 :α wordLang$prog) => F | (Set v68 v69 :α wordLang$prog) => F | (Store v70 v71 :α wordLang$prog) => F | MustTerminate v72 => F | (Call v73 v74 v75 v76 :α wordLang$prog) => T | Seq v77 v78 => F | (If v79 v80 v81 v82 v83 :α wordLang$prog) => F | (Loop v84 v85 v86 :α wordLang$prog) => F | (Alloc v87 v88 :α wordLang$prog) => F | (StoreConsts v89 v90 v91 v92 v93 :α wordLang$prog) => F | (Raise v94 :α wordLang$prog) => F | (Return v95 v96 :α wordLang$prog) => F | (Break v97 :α wordLang$prog) => F | (Continue v98 :α wordLang$prog) => F | (Tick :α wordLang$prog) => F | (OpCurrHeap v99 v100 v101 :α wordLang$prog) => F | (LocValue v102 v103 :α wordLang$prog) => T | (Install v104 v105 v106 v107 v108 :α wordLang$prog) => F | (CodeBufferWrite v109 v110 :α wordLang$prog) => F | (DataBufferWrite v111 v112 :α wordLang$prog) => F | (FFI v113 v114 v115 v116 v117 v118 :α wordLang$prog) => F | ShareInst v119 v120 v121 => T) ⇒ (P :α wordLang$prog -> bool) x) ⇒ ∀(body :α prog) (name :num) (params :num list). not_created_subprogs P (comp_func name params body)
loop_to_word_comp_not_created_typed=(∀(x :α wordLang$prog). (case x of (Skip :α wordLang$prog) => F | (Move v61 v62 :α wordLang$prog) => F | (Inst v63 :α wordLang$prog) => F | (Assign v64 v65 :α wordLang$prog) => F | (Get v66 v67 :α wordLang$prog) => F | (Set v68 v69 :α wordLang$prog) => F | (Store v70 v71 :α wordLang$prog) => F | MustTerminate v72 => F | (Call v73 v74 v75 v76 :α wordLang$prog) => T | Seq v77 v78 => F | (If v79 v80 v81 v82 v83 :α wordLang$prog) => F | (Loop v84 v85 v86 :α wordLang$prog) => F | (Alloc v87 v88 :α wordLang$prog) => F | (StoreConsts v89 v90 v91 v92 v93 :α wordLang$prog) => F | (Raise v94 :α wordLang$prog) => F | (Return v95 v96 :α wordLang$prog) => F | (Break v97 :α wordLang$prog) => F | (Continue v98 :α wordLang$prog) => F | (Tick :α wordLang$prog) => F | (OpCurrHeap v99 v100 v101 :α wordLang$prog) => F | (LocValue v102 v103 :α wordLang$prog) => T | (Install v104 v105 v106 v107 v108 :α wordLang$prog) => F | (CodeBufferWrite v109 v110 :α wordLang$prog) => F | (DataBufferWrite v111 v112 :α wordLang$prog) => F | (FFI v113 v114 v115 v116 v117 v118 :α wordLang$prog) => F | ShareInst v119 v120 v121 => T) ⇒ (P :α wordLang$prog -> bool) x) ⇒ ∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num) (wprog :α wordLang$prog) (l2 :num # num). comp ctxt prog l = (wprog,l2) ⇒ not_created_subprogs P wprog
loop_to_word_compile_lab_min_typed=compile (prog :(num # num list # α prog) list) = (prog' :(num # num # α wordLang$prog) list) ∧ EVERY (λ(p :num # num list # α prog). (x :num) ≤ FST p) prog ⇒ EVERY (λ(p :num # num # α wordLang$prog). x ≤ FST p) prog'
loop_to_word_compile_not_created_typed=∀(pan_prog :(num # num list # α prog) list). (∀(x :α wordLang$prog). (case x of (Skip :α wordLang$prog) => F | (Move v61 v62 :α wordLang$prog) => F | (Inst v63 :α wordLang$prog) => F | (Assign v64 v65 :α wordLang$prog) => F | (Get v66 v67 :α wordLang$prog) => F | (Set v68 v69 :α wordLang$prog) => F | (Store v70 v71 :α wordLang$prog) => F | MustTerminate v72 => F | (Call v73 v74 v75 v76 :α wordLang$prog) => T | Seq v77 v78 => F | (If v79 v80 v81 v82 v83 :α wordLang$prog) => F | (Loop v84 v85 v86 :α wordLang$prog) => F | (Alloc v87 v88 :α wordLang$prog) => F | (StoreConsts v89 v90 v91 v92 v93 :α wordLang$prog) => F | (Raise v94 :α wordLang$prog) => F | (Return v95 v96 :α wordLang$prog) => F | (Break v97 :α wordLang$prog) => F | (Continue v98 :α wordLang$prog) => F | (Tick :α wordLang$prog) => F | (OpCurrHeap v99 v100 v101 :α wordLang$prog) => F | (LocValue v102 v103 :α wordLang$prog) => T | (Install v104 v105 v106 v107 v108 :α wordLang$prog) => F | (CodeBufferWrite v109 v110 :α wordLang$prog) => F | (DataBufferWrite v111 v112 :α wordLang$prog) => F | (FFI v113 v114 v115 v116 v117 v118 :α wordLang$prog) => F | ShareInst v119 v120 v121 => T) ⇒ (P :α wordLang$prog -> bool) x) ⇒ EVERY (not_created_subprogs P) (MAP ((SND :num # α wordLang$prog -> α wordLang$prog) ∘ (SND :num # num # α wordLang$prog -> num # α wordLang$prog)) (compile_prog pan_prog))
loop_to_word_compile_prog_FST_eq_typed=compile_prog (prog :(num # num list # α prog) list) = (prog' :(num # num # α wordLang$prog) list) ⇒ MAP (FST :num # num # α wordLang$prog -> num) prog' = MAP (FST :num # num list # α prog -> num) prog
loop_to_word_compile_prog_every_inst_ok_less_typed=compile_prog (lprog :(num # num list # α prog) list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ byte_offset_ok (c :α asm_config) (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ EVERY (λ((n :num),(params :num list),(body :α prog)). every_prog (loop_inst_ok c :α prog -> bool) body) lprog ⇒ EVERY (λ((n :num),(m :num),(p :α wordLang$prog)). every_inst (inst_ok_less c) p) wprog0
loop_to_word_compile_prog_lab_min_typed=compile_prog (prog :(num # num list # α prog) list) = (prog' :(num # num # α wordLang$prog) list) ∧ EVERY (λ(p :num # num list # α prog). (x :num) ≤ FST p) prog ⇒ EVERY (λ(p :num # num # α wordLang$prog). x ≤ FST p) prog'
loop_to_word_compile_prog_lab_pres_typed=compile_prog (prog :(num # num list # α prog) list) = (prog' :(num # num # α wordLang$prog) list) ⇒ EVERY (λ((n :num),(m :num),(p :α wordLang$prog)). (let (labs :(num # num) list) = extract_labels p in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) labs ∧ ALL_DISTINCT labs)) prog'
loop_to_word_every_inst_ok_less_typed=compile (lprog :(num # num list # α prog) list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ byte_offset_ok (c :α asm_config) (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ EVERY (λ((n :num),(params :num list),(body :α prog)). every_prog (loop_inst_ok c :α prog -> bool) body) lprog ⇒ EVERY (λ((n :num),(m :num),(p :α wordLang$prog)). every_inst (inst_ok_less c) p) wprog0
loop_to_word_good_handlers_typed=compile_prog (prog :(num # num list # α prog) list) = (prog' :(num # num # α wordLang$prog) list) ⇒ EVERY (λ((n :num),(m :num),(pp :α wordLang$prog)). word_good_handlers n pp) prog'
make_ctxt_inj_typed=∀(xs :num list) (l :num sptree$num_map) (n :num). (∀(x :num) (y :num) (v :num). lookup x l = SOME v ∧ lookup y l = SOME v ⇒ x = y ∧ v < n) ⇒ ∀(x :num) (y :num) (v :num). lookup x (make_ctxt n xs l) = SOME v ∧ lookup y (make_ctxt n xs l) = SOME v ⇒ x = y
mem_prog_mem_compile_prog_typed=∀(prog :(num # num list # α prog) list) (name :num) (params :num list) (body :α prog). MEM (name,params,body) prog ⇒ MEM (name,LENGTH params + (1 :num),comp_func name params body) (compile_prog prog)
set_fromNumSet_typed=set (fromNumSet (t :α sptree$num_map)) = (domain t :num -> bool)
state_rel_def_typed=∀(s :(α, β) state) (t :(α, γ, β) wordSem$state). state_rel s t ⇔ ∃(len :α word). t.memory = s.memory ∧ t.mdomain = s.mdomain ∧ t.sh_mdomain = s.sh_mdomain ∧ t.clock = s.clock ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ ALOOKUP (fmap_to_alist t.store) CurrHeap = SOME (Word s.base_addr) ∧ ALOOKUP (fmap_to_alist t.store) HeapLength = SOME (Word len) ∧ s.top_addr = s.base_addr + (2w :α word) * len ∧ globals_rel s.globals t.store ∧ code_rel s.code t.code
state_rel_imp_semantics_typed=∀(s :(α, β) state) (t :(α, γ, β) wordSem$state) (start :num). state_rel s t ∧ isEmpty s.locals ∧ good_dimindex (:α) ∧ lookup (0 :num) t.locals = SOME (Loc (1 :num) (0 :num) :α word_loc) ∧ (∃(prog :α prog). lookup start s.code = SOME (([] :num list),prog)) ∧ semantics s start ≠ Fail ⇒ semantics t start = semantics s start
state_rel_intro_typed=state_rel (s :(α, β) state) (t :(α, γ, β) wordSem$state) ⇒ t.memory = s.memory ∧ t.mdomain = s.mdomain ∧ t.clock = s.clock ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ ALOOKUP (fmap_to_alist t.store) CurrHeap = SOME (Word s.base_addr) ∧ globals_rel s.globals t.store ∧ code_rel s.code t.code
state_rel_with_clock_typed=state_rel (s :(α, β) state) (t :(α, γ, β) wordSem$state) ⇒ state_rel (s with clock := (k :num)) (t with clock := k)
LASTN_ADD_CONS_typed=¬(LENGTH (xs :α list) ≤ (n :num)) ⇒ LASTN (n + (1 :num)) ((x :α)::xs) = LASTN (n + (1 :num)) xs
evaluate_tick_loop_tick_unfold_typed=(t1 :(α, β, γ) wordSem$state).clock ≠ (0 :num) ⇒ (evaluate (Seq (Tick :α wordLang$prog) (Seq (Loop (names :sptree$num_set) (body :α wordLang$prog) (exit_names :sptree$num_set) :α wordLang$prog) (Tick :α wordLang$prog)),t1) :α wordSem$result option # (α, β, γ) wordSem$state) = (λ((res' :α wordSem$result option),(s1 :(α, β, γ) wordSem$state)). if res' = (NONE :α wordSem$result option) then if s1.clock = (0 :num) then (SOME (TimeOut :α wordSem$result),flush_state T s1) else ((NONE :α wordSem$result option),s1 with clock := s1.clock − (1 :num)) else (res',s1)) (evaluate ((Loop names body exit_names :α wordLang$prog),t1 with clock := t1.clock − (1 :num)) :α wordSem$result option # (α, β, γ) wordSem$state)
evaluate_tick_unfold_typed=(evaluate ((Tick :α wordLang$prog),(s :(α, β, γ) wordSem$state)) :α wordSem$result option # (α, β, γ) wordSem$state) = if s.clock = (0 :num) then (SOME (TimeOut :α wordSem$result),flush_state T s) else ((NONE :α wordSem$result option),dec_clock s)
loop_to_word_compile_not_created_MEM_typed=MEM ((a :num),(b :num),(p :α wordLang$prog)) (compile_prog (pan_prog :(num # num list # α prog) list)) ⇒ (∀(x :α wordLang$prog). (case x of (Skip :α wordLang$prog) => F | (Move v61 v62 :α wordLang$prog) => F | (Inst v63 :α wordLang$prog) => F | (Assign v64 v65 :α wordLang$prog) => F | (Get v66 v67 :α wordLang$prog) => F | (Set v68 v69 :α wordLang$prog) => F | (Store v70 v71 :α wordLang$prog) => F | MustTerminate v72 => F | (Call v73 v74 v75 v76 :α wordLang$prog) => T | Seq v77 v78 => F | (If v79 v80 v81 v82 v83 :α wordLang$prog) => F | (Loop v84 v85 v86 :α wordLang$prog) => F | (Alloc v87 v88 :α wordLang$prog) => F | (StoreConsts v89 v90 v91 v92 v93 :α wordLang$prog) => F | (Raise v94 :α wordLang$prog) => F | (Return v95 v96 :α wordLang$prog) => F | (Break v97 :α wordLang$prog) => F | (Continue v98 :α wordLang$prog) => F | (Tick :α wordLang$prog) => F | (OpCurrHeap v99 v100 v101 :α wordLang$prog) => F | (LocValue v102 v103 :α wordLang$prog) => T | (Install v104 v105 v106 v107 v108 :α wordLang$prog) => F | (CodeBufferWrite v109 v110 :α wordLang$prog) => F | (DataBufferWrite v111 v112 :α wordLang$prog) => F | (FFI v113 v114 v115 v116 v117 v118 :α wordLang$prog) => F | ShareInst v119 v120 v121 => T) ⇒ (P :α wordLang$prog -> bool) x) ⇒ not_created_subprogs P p
make_ctxt_APPEND_typed=∀(xs :num list) (ys :num list) (n :num) (l :num sptree$num_map). make_ctxt n (xs ++ ys) l = make_ctxt (n + (2 :num) * LENGTH xs) ys (make_ctxt n xs l)
make_ctxt_NOT_MEM_typed=∀(xs :num list) (n :num) (l :num sptree$num_map) (x :num). ¬MEM x xs ⇒ lookup x (make_ctxt n xs l) = lookup x l
state_rel_IMP_typed=state_rel (s :(α, β) state) (t :(α, γ, β) wordSem$state) ⇒ t.clock = s.clock
word_sh_SOME_MOD_dimword_typed=good_dimindex (:α) ∧ word_sh (sh :ast$shift) (w :α word) (n :num) = SOME (z :α word) ⇒ n MOD dimword (:α) = n
acc_vars_acc_prime_typed=∀(p :α prog) (l :sptree$num_set). (domain (acc_vars p l) :num -> bool) = (domain (acc_vars p (LN :sptree$num_set)) :num -> bool) ∪ (domain l :num -> bool)
