load "preamble";
load "set_sepTheory";
open bossLib HolKernel Parse preamble set_sepTheory;
val _ = Globals.linewidth := 20000;
val _ = print ("se_one_def=" ^ term_to_string (concl one_def) ^ "\n");
val _ = print ("se_one_type=" ^ type_to_string (type_of ``set_sep$one``) ^ "\n");
val _ = print ("se_emp_def=" ^ term_to_string (concl emp_def) ^ "\n");
val _ = print ("se_emp_type=" ^ type_to_string (type_of ``set_sep$emp``) ^ "\n");
val _ = print ("se_cond_def=" ^ term_to_string (concl cond_def) ^ "\n");
val _ = print ("se_cond_type=" ^ type_to_string (type_of ``set_sep$cond``) ^ "\n");
val _ = print ("se_split_def=" ^ term_to_string (concl SPLIT_def) ^ "\n");
val _ = print ("se_split_type=" ^ type_to_string (type_of ``set_sep$SPLIT``) ^ "\n");
val _ = print ("se_star_def=" ^ term_to_string (concl STAR_def) ^ "\n");
val _ = print ("se_star_type=" ^ type_to_string (type_of ``set_sep$STAR``) ^ "\n");
val _ = print ("se_exists_def=" ^ term_to_string (concl SEP_EXISTS) ^ "\n");
val _ = print ("se_exists_type=" ^ type_to_string (type_of ``set_sep$SEP_EXISTS``) ^ "\n");
fun check label q = let val th = prove(q, simp [one_def,emp_def,cond_def,SPLIT_def,STAR_def,SEP_EXISTS] >> simp [EXTENSION,DISJOINT_DEF] >> metis_tac [])
  in print(label ^ "=" ^ term_to_string(rhs(concl(EQT_INTRO th))) ^ "\n") end;
val _ = check "se_one_fixture" ``one (3:num) {3}``;
val _ = check "se_emp_fixture" ``emp ({}:bool set)``;
val _ = check "se_cond_fixture" ``cond T ({}:bool set)``;
val _ = check "se_false_fixture" ``~cond F ({}:num set)``;
val _ = check "se_nonempty_fixture" ``~cond T {T}``;
val _ = check "se_split_empty_fixture" ``SPLIT ({}:bool set) ({},{})``;
val _ = check "se_overlap_fixture" ``~SPLIT {T} ({T},{T})``;
val _ = check "se_extra_fixture" ``~SPLIT ({}:bool set) ({T},{})``;
val _ = check "se_star_empty_fixture" ``STAR emp emp ({}:bool set)``;
val _ = check "se_star_distinct_fixture" ``STAR (one T) (one F) (UNIV:bool set)``;
val _ = check "se_star_overlap_fixture" ``~STAR (one T) (one T) {T}``;
val _ = check "se_witness_fixture" ``($SEP_EXISTS) (\n:num. cond (n=7)) ({}:bool set)``;
val _ = check "se_no_witness_fixture" ``~($SEP_EXISTS) (\b:bool. cond F) ({}:num set)``;
val _ = check "se_infinite_fixture" ``SPLIT (UNIV:num set) (UNIV,{})``;
