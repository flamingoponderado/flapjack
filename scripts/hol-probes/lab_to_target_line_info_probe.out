line_to_info_def=∀(secs :α sec list) (p :num) (x :num # β line option).
  line_to_info secs p x =
  case SND x of
    (NONE :β line option) => ([] :(ffiname # shmem_info_num) list)
  | SOME (Label v12 v13 v14 :β line) => ([] :(ffiname # shmem_info_num) list)
  | SOME (Asm (Asmi v28) bytes l) => ([] :(ffiname # shmem_info_num) list)
  | SOME (Asm (Cbw v29 v30 :β asm_or_cbw) bytes l) =>
    ([] :(ffiname # shmem_info_num) list)
  | SOME (Asm (ShareMem m r ad) bytes l) =>
    (let
       ((name :shmem_op),(nb :word8)) = get_memop_info m
     in
       [(SharedMem name,
         <|entry_pc := pos_val (FST x) p secs; nbytes := nb;
           addr_reg := case ad of Addr r off => r;
           addr_off := case ad of Addr r off => w2n off; reg := r;
           exit_pc := pos_val (FST x) p secs + LENGTH bytes|>)])
  | SOME (LabAsm v18 v19 v20 v21) => ([] :(ffiname # shmem_info_num) list)
line_to_info_def_types=(secs :α sec list)::α sec list;(p :num)::num;(x :num # β line option)::num # β line option;
line_to_info_def_hypotheses=0
line_to_info_next=line_to_info
  (Section (k1 :num)
     (LabAsm (a :α asm_with_lab) (b :α word) (bytes1 :word8 list) (len1 :num)::
        (xs1 :α line list))::(rest1 :α sec list)) (p1 :num)
  ((i1 :num) + (1 :num),(l1 :β line option)) =
line_to_info (Section k1 xs1::rest1) (p1 + LENGTH bytes1) (i1,l1) ∧
line_to_info
  (Section (k2 :num)
     (Asm (c2 :γ asm_or_cbw) (bytes2 :word8 list) (len2 :num)::
        (xs2 :γ line list))::(rest2 :γ sec list)) (p2 :num)
  ((i2 :num) + (1 :num),(l2 :δ line option)) =
line_to_info (Section k2 xs2::rest2) (p2 + LENGTH bytes2) (i2,l2)
line_to_info_next_types=(l2 :δ line option)::δ line option;(i2 :num)::num;(p2 :num)::num;(rest2 :γ sec list)::γ sec list;(xs2 :γ line list)::γ line list;(len2 :num)::num;(bytes2 :word8 list)::word8 list;(c2 :γ asm_or_cbw)::γ asm_or_cbw;(k2 :num)::num;(l1 :β line option)::β line option;(i1 :num)::num;(p1 :num)::num;(rest1 :α sec list)::α sec list;(xs1 :α line list)::α line list;(len1 :num)::num;(bytes1 :word8 list)::word8 list;(b :α word)::α word;(a :α asm_with_lab)::α asm_with_lab;(k1 :num)::num;
line_to_info_next_hypotheses=0
line_to_info_hd_empty=line_to_info (Section (k :num) ([] :α line list)::(rest :α sec list))
  (p :num) (t :num # β line option) = line_to_info rest p t
line_to_info_hd_empty_types=(t :num # β line option)::num # β line option;(p :num)::num;(rest :α sec list)::α sec list;(k :num)::num;
line_to_info_hd_empty_hypotheses=0
line_to_info_hd_Label=line_to_info
  (Section (k :num)
     ((Label (a :num) (b :num) (0 :num) :α line)::(xs :α line list))::
     (rest :α sec list)) (p :num) (t :num # β line option) =
line_to_info (Section k xs::rest) p t
line_to_info_hd_Label_types=(t :num # β line option)::num # β line option;(p :num)::num;(rest :α sec list)::α sec list;(xs :α line list)::α line list;(b :num)::num;(a :num)::num;(k :num)::num;
line_to_info_hd_Label_hypotheses=0
GENLIST_asm_fetch_aux_next=¬is_Label (x :α line) ⇒
GENLIST
  (λ(i :num).
       (i,
        asm_fetch_aux i
          (Section (k :num) (x::(xs :α line list))::(rest :α sec list))))
  ((n :num) + (1 :num)) =
((0 :num),SOME x)::
  GENLIST (λ(i :num). (i + (1 :num),asm_fetch_aux i (Section k xs::rest))) n
GENLIST_asm_fetch_aux_next_types=(n :num)::num;(rest :α sec list)::α sec list;(xs :α line list)::α line list;(k :num)::num;(x :α line)::α line;
GENLIST_asm_fetch_aux_next_hypotheses=0
