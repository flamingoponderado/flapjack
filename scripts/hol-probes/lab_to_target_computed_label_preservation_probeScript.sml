load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "lab_lookup_compute_labels_alt_ignore" lab_lookup_compute_labels_alt_ignore;
val _=types "lab_lookup_compute_labels_alt_ignore_types" lab_lookup_compute_labels_alt_ignore;
val _=capture "enc_lines_again_section_labels" enc_lines_again_section_labels;
val _=types "enc_lines_again_section_labels_types" enc_lines_again_section_labels;
val _=capture "enc_secs_again_compute_labels" enc_secs_again_compute_labels;
val _=types "enc_secs_again_compute_labels_types" enc_secs_again_compute_labels;
val _ = show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc((SIMP_CONV (srw_ss()) [] THENC EVAL THENC SIMP_CONV (srw_ss()) [] THENC EVAL) q)); print "\n");
val enc = ``(λa. case a of Inst Skip => [0w;0w] | Jump w => [w2w w;99w] | _ => [10w;11w]) : 8 asm -> word8 list``;
val labs = ``sptree$insert 1 (sptree$insert 5 20 sptree$LN) sptree$LN : num num_map num_map``;
val input = ``[Label 1 5 0;Asm (Asmi (Inst Skip)) [0w;0w] 2;LabAsm (Jump (Lab 1 5)) 99w [] 2;Label 1 6 0] : 8 line list``;
val output = ``[Label 1 5 0;Asm (Asmi (Inst Skip)) [0w;0w] 2;LabAsm (Jump (Lab 1 5)) 14w [14w;99w] 2;Label 1 6 0] : 8 line list``;
val acc = ``[(5,2 ** 80);(5,11);(0,99)] : (num # num) list``;
val initial = ``sptree$insert 7 (sptree$insert 3 (2 ** 80+7) sptree$LN) (sptree$insert 1 (sptree$insert 9 77 sptree$LN) sptree$LN) : num num_map num_map``;
val code = ``[Section 1 ^input;Section 1 [];Section 2 [Label 2 3 1]]``;
val result = ``[Section 1 ^output;Section 1 [];Section 2 [Label 2 3 1]]``;
val _ = observe "changed_full_pair" ``enc_lines_again_simp ^labs [] 4 ^enc ^input = (^output,T) /\ section_labels 4 ^input ^acc = (8,(6,8)::(5,4)::^acc) /\ section_labels 4 ^output ^acc = (8,(6,8)::(5,4)::^acc)``;
val _ = observe "unchanged_encoding" ``enc_lines_again_simp ^labs [] 4 ^enc [LabAsm (Jump (Lab 1 5)) 16w [1w] 2] = ([LabAsm (Jump (Lab 1 5)) 16w [1w] 2],T) /\ section_labels 4 ([LabAsm (Jump (Lab 1 5)) 16w [1w] 2]:8 line list) ^acc = (6,^acc)``;
val _ = observe "empty_odd" ``enc_lines_again_simp ^labs [] 3 ^enc [] = ([],T) /\ section_labels 3 ([]:8 line list) ^acc = (3,^acc)``;
val _ = observe "zero_label_ignored" ``section_labels 4 ([Label 1 0 3;Label 1 5 1]:8 line list) ^acc = (8,(5,8)::^acc)``;
val _ = observe "duplicate_sections_full_map" ``enc_secs_again 4 ^labs [] ^enc ^code = (^result,T) /\ compute_labels_alt 4 ^result ^initial = compute_labels_alt 4 ^code ^initial /\ compute_labels_alt 4 ^code ^initial = sptree$insert 2 (sptree$fromAList [(0,8);(3,9)]) (sptree$insert 1 (sptree$fromAList [(0,8)]) ^initial)``;
val _ = observe "ignore_old_huge_nat" ``~MEM 7 (MAP Section_num ^code) /\ lab_lookup 7 3 (compute_labels_alt 4 ^code ^initial) = SOME (2 ** 80+7) /\ lab_lookup 7 3 ^initial = SOME (2 ** 80+7)``;
val _ = observe "ignore_missing" ``~MEM 13 (MAP Section_num ^code) /\ lab_lookup 13 3 (compute_labels_alt 4 ^code ^initial) = NONE /\ lab_lookup 13 3 ^initial = NONE``;
val _ = observe "nonmembership_guard_needed" ``lab_lookup 1 9 ^initial = SOME 77 /\ lab_lookup 1 9 (compute_labels_alt 4 ^code ^initial) = NONE``;
val _ = observe "false_flag_changes_labels" ``enc_lines_again_simp ^labs [] 4 ^enc [LabAsm (Jump (Lab 1 5)) 99w [] 0;Label 1 6 0] = ([LabAsm (Jump (Lab 1 5)) 16w [16w;99w] 2;Label 1 6 0],F) /\ section_labels 4 ([LabAsm (Jump (Lab 1 5)) 99w [] 0;Label 1 6 0]:8 line list) [] = (4,[(6,4)]) /\ section_labels 4 ([LabAsm (Jump (Lab 1 5)) 16w [16w;99w] 2;Label 1 6 0]:8 line list) [] = (6,[(6,6)])``;
val _ = observe "width1_changed" ``enc_lines_again_simp (sptree$LN:num num_map num_map) [] 0 ((λa.[3w;4w]):1 asm -> word8 list) [LabAsm Halt 1w [] 2;Label 1 7 0] = ([LabAsm Halt 0w [3w;4w] 2;Label 1 7 0],T) /\ section_labels 0 ([LabAsm Halt 0w [3w;4w] 2;Label 1 7 0]:1 line list) [] = (2,[(7,2)])``;
val _ = observe "width80_large_position" ``enc_lines_again_simp (sptree$LN:num num_map num_map) [] (2 ** 80+4) ((λa.[]):80 asm -> word8 list) [Label 1 7 0] = ([Label 1 7 0],T) /\ section_labels (2 ** 80+4) ([Label 1 7 0]:80 line list) [(8,2 ** 81)] = (2 ** 80+4,[(7,2 ** 80+4);(8,2 ** 81)])``;
