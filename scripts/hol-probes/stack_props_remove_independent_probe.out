asrc_type=:α asm_config -> β stackLang$prog -> bool
asrc_def=⊢ (∀s n c. stack_asm_remove c (Get n s) ⇔ reg_name n c) ∧ (∀v src c binop. stack_asm_remove c (OpCurrHeap binop v src) ⇔ reg_name v c ∧ reg_name src c) ∧ (∀s n c. stack_asm_remove c (Set s n) ⇔ reg_name n c) ∧ (∀n0 n c. stack_asm_remove c (StackStore n n0) ⇔ reg_name n c) ∧ (∀n0 n c. stack_asm_remove c (StackStoreAny n n0) ⇔ reg_name n c ∧ reg_name n0 c) ∧ (∀n0 n c. stack_asm_remove c (StackLoad n n0) ⇔ reg_name n c) ∧ (∀n0 n c. stack_asm_remove c (StackLoadAny n n0) ⇔ reg_name n c ∧ reg_name n0 c) ∧ (∀n c. stack_asm_remove c (StackGetSize n) ⇔ reg_name n c) ∧ (∀n c. stack_asm_remove c (StackSetSize n) ⇔ reg_name n c) ∧ (∀n0 n c. stack_asm_remove c (BitmapLoad n n0) ⇔ reg_name n c ∧ reg_name n0 c) ∧ (∀v0 n0 n c. stack_asm_remove c (StoreConsts n n0 v0) ⇔ reg_name n c ∧ reg_name n0 c) ∧ (∀p2 p1 c. stack_asm_remove c (Seq p1 p2) ⇔ stack_asm_remove c p1 ∧ stack_asm_remove c p2) ∧ (∀r p' p n cmp c. stack_asm_remove c (If cmp n r p p') ⇔ stack_asm_remove c p ∧ stack_asm_remove c p') ∧ (∀p c. stack_asm_remove c (Loop p) ⇔ stack_asm_remove c p) ∧ (∀tar r h c. stack_asm_remove c (Call r tar h) ⇔ case r of NONE => T | SOME (v7,v8) => stack_asm_remove c v7 ∧ case h of NONE => T | SOME (v4,v5) => stack_asm_remove c v4) ∧ (∀c. stack_asm_remove c Skip ⇔ T) ∧ (∀v9 c. stack_asm_remove c (Inst v9) ⇔ T) ∧ (∀v30 v29 v28 c. stack_asm_remove c (JumpLower v28 v29 v30) ⇔ T) ∧ (∀v31 c. stack_asm_remove c (Alloc v31) ⇔ T) ∧ (∀v35 c. stack_asm_remove c (Raise v35) ⇔ T) ∧ (∀v36 c. stack_asm_remove c (Return v36) ⇔ T) ∧ (∀v37 c. stack_asm_remove c (Break v37) ⇔ T) ∧ (∀v38 c. stack_asm_remove c (Continue v38) ⇔ T) ∧ (∀v44 v43 v42 v41 v40 v39 c. stack_asm_remove c (FFI v39 v40 v41 v42 v43 v44) ⇔ T) ∧ (∀c. stack_asm_remove c Tick ⇔ T) ∧ (∀v47 v46 v45 c. stack_asm_remove c (LocValue v45 v46 v47) ⇔ T) ∧ (∀v52 v51 v50 v49 v48 c. stack_asm_remove c (Install v48 v49 v50 v51 v52) ⇔ T) ∧ (∀v55 v54 v53 c. stack_asm_remove c (ShMemOp v53 v54 v55) ⇔ T) ∧ (∀v57 v56 c. stack_asm_remove c (CodeBufferWrite v56 v57) ⇔ T) ∧ (∀v59 v58 c. stack_asm_remove c (DataBufferWrite v58 v59) ⇔ T) ∧ (∀v60 c. stack_asm_remove c (RawCall v60) ⇔ T) ∧ (∀v61 c. stack_asm_remove c (StackAlloc v61) ⇔ T) ∧ (∀v62 c. stack_asm_remove c (StackFree v62) ⇔ T) ∧ ∀v75 c. stack_asm_remove c (Halt v75) ⇔ T
