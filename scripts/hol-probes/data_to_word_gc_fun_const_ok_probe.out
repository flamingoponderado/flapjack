gc_fun_const_ok_word_gc_fun_statement=gc_fun_const_ok (word_gc_fun c)
gc_fun_const_ok_word_gc_fun_hypotheses=0
gc_fun_const_ok_word_gc_fun_typed=gc_fun_const_ok (word_gc_fun (c :data_to_word$config) :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option)
stack_rel_IMP_size_of_stack_hypotheses=0
stack_rel_IMP_size_of_stack_typed=∀(xs :stack list) (ys :α stack_frame list). LIST_REL (stack_rel :stack -> α stack_frame -> bool) xs ys ⇒ (stack_size ys :num option) = size_of_stack xs
code_rel_def_typed=∀(c :data_to_word$config) (s_code :(num # dataLang$prog) sptree$num_map) (t_code :(num # α wordLang$prog) sptree$num_map). (code_rel c s_code t_code :bool) ⇔ (domain t_code :num -> bool) = (domain s_code :num -> bool) ∪ set (MAP (FST :num # num # α wordLang$prog -> num) (stubs (:α) c)) ∧ EVERY (λ((n :num),(x :num # α wordLang$prog)). (lookup n t_code :(num # α wordLang$prog) option) = SOME x) (stubs (:α) c) ∧ ∀(n :num) (arg_count :num) (prog :dataLang$prog). (lookup n s_code :(num # dataLang$prog) option) = SOME (arg_count,prog) ⇒ (lookup n t_code :(num # α wordLang$prog) option) = SOME (arg_count + (1 :num),FST (comp c n (2 :num) prog :α wordLang$prog # num))
code_oracle_rel_def_typed=∀(c :data_to_word$config) (s_compile :γ -> (num # num # dataLang$prog) list -> (word8 list # word64 list # γ) option) (s_compile_oracle :β -> δ # (num # num # dataLang$prog) list) (t_store :store_name |-> ε word_loc) (t_compile :γ -> (num # num # α wordLang$prog) list -> (word8 list # α word list # γ) option) (t_compile_oracle :β -> δ # (num # num # ζ wordLang$prog) list) (t_code_buffer :(ε, η) buffer) (t_data_buffer :(ε, θ) buffer). code_oracle_rel c s_compile s_compile_oracle t_store t_compile t_compile_oracle t_code_buffer t_data_buffer ⇔ t_code_buffer.buffer = ([] :η word list) ∧ t_data_buffer.buffer = ([] :θ word list) ∧ FLOOKUP t_store CodeBuffer = SOME (Word t_code_buffer.position) ∧ FLOOKUP t_store CodeBufferEnd = SOME (Word (t_code_buffer.position + (n2w t_code_buffer.space_left :ε word))) ∧ FLOOKUP t_store BitmapBuffer = SOME (Word t_data_buffer.position) ∧ FLOOKUP t_store BitmapBufferEnd = SOME (Word (t_data_buffer.position + (bytes_in_word :ε word) * (n2w t_data_buffer.space_left :ε word))) ∧ s_compile = (λ(cfg :γ). OPTION_MAP ((I :word8 list -> word8 list) ## MAP (upper_w2w :α word -> word64) ## (I :γ -> γ)) ∘ t_compile cfg ∘ MAP (compile_part c :num # num # dataLang$prog -> num # num # α wordLang$prog)) ∧ t_compile_oracle = ((I :δ -> δ) ## MAP (compile_part c :num # num # dataLang$prog -> num # num # ζ wordLang$prog)) ∘ s_compile_oracle ∧ ∀(n :β). EVERY (λ((n :num),(_0 :num # dataLang$prog)). data_num_stubs ≤ n) (SND (s_compile_oracle n))
state_rel_thm_typed=∀(c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (v1 :(v # α word_loc) list option) (locs :(num # num) list). (state_rel c l1 l2 s t v1 locs :bool) ⇔ t.ffi = s.ffi ∧ t.clock = s.clock ∧ t.handler = s.handler ∧ t.gc_fun = (word_gc_fun c :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) ∧ (code_rel c s.code t.code :bool) ∧ code_oracle_rel c s.compile s.compile_oracle t.store t.compile t.compile_oracle t.code_buffer t.data_buffer ∧ good_dimindex (:α) ∧ shift_length c < dimindex (:α) ∧ IS_SOME s.tstamps ∧ EVERY (λ(n :store_name). n ∈ FDOM t.store) [Globals] ∧ (v1 = (NONE :(v # α word_loc) list option) ⇒ (lookup (0 :num) t.locals :α word_loc option) = SOME (Loc l1 l2 :α word_loc)) ∧ (∀(n :num). IS_SOME (lookup n s.locals :v option) ⇒ IS_SOME (lookup (adjust_var n) t.locals :α word_loc option)) ∧ LIST_REL (stack_rel :stack -> α stack_frame -> bool) s.stack t.stack ∧ LIST_REL (contains_loc :α stack_frame -> num # num -> bool) t.stack locs ∧ option_le (OPTION_MAP2 $+ (stack_size t.stack :num option) t.locals_size) t.stack_max ∧ option_le t.stack_max s.stack_max ∧ t.stack_size = s.stack_frame_sizes ∧ t.locals_size = s.locals_size ∧ limits_inv s.limits (FLOOKUP t.store HeapLength) t.stack_limit c.len_size c.has_fp_ops c.has_fp_tern ∧ memory_rel c t.be (THE s.tstamps) s.refs s.space t.store t.memory t.mdomain ((case v1 of (NONE :(v # α word_loc) list option) => ([] :(v # α word_loc) list) | SOME vs => vs) ++ join_env s.locals (toAList (inter t.locals (adjust_set s.locals))) ++ [(the_global s.global,t.store⟨Globals⟩)] ++ flat s.stack t.stack)
state_rel_with_clock_typed=(state_rel (a :data_to_word$config) (b :num) (c :num) (s1 :(α, β) dataSem$state) (s2 :(γ, α, β) wordSem$state) (d :(v # γ word_loc) list option) (e :(num # num) list) :bool) ⇒ (state_rel a b c (s1 with clock := (k :num)) (s2 with clock := k) d e :bool)
state_rel_with_fp_regs_typed=(state_rel (a :data_to_word$config) (b :num) (c :num) (s1 :(γ, 'ffi) dataSem$state) (s2 :(α, γ, 'ffi) wordSem$state) (d :(v # α word_loc) list option) (e :(num # num) list) :bool) ⇒ (state_rel a b c s1 (s2 with fp_regs := (f :num |-> word64)) d e :bool)
mk_loc_def_typed=(mk_loc (SOME ((t1 :β),(d1 :num),(d2 :num))) :α word_loc) = (Loc d1 d2 :α word_loc)
mk_loc_function_type=:(β # num # num) option -> α word_loc
