jump_exc_push_env_NONE_simp_typed=((jump_exc (dec_clock (t :(α, β, γ) wordSem$state) :(α, β, γ) wordSem$state) :((α, β, γ) wordSem$state # num # num) option) = (NONE :((α, β, γ) wordSem$state # num # num) option) ⇔ (jump_exc t :((α, β, γ) wordSem$state # num # num) option) = (NONE :((α, β, γ) wordSem$state # num # num) option)) ∧ ((jump_exc (push_env (y :α word_loc sptree$num_map # α word_loc sptree$num_map) (NONE :(num # α wordLang$prog # num # num) option) t) :((α, β, γ) wordSem$state # num # num) option) = (NONE :((α, β, γ) wordSem$state # num # num) option) ⇔ (jump_exc t :((α, β, γ) wordSem$state # num # num) option) = (NONE :((α, β, γ) wordSem$state # num # num) option)) ∧ ((jump_exc (t with stack_max := (b :num option)) :((α, β, γ) wordSem$state # num # num) option) = (NONE :((α, β, γ) wordSem$state # num # num) option) ⇔ (jump_exc t :((α, β, γ) wordSem$state # num # num) option) = (NONE :((α, β, γ) wordSem$state # num # num) option))
s_key_eq_handler_eq_IMP_typed=s_key_eq (t :(α, β, γ) wordSem$state).stack (t1 :(α, δ, ε) wordSem$state).stack ∧ t.handler = t1.handler ⇒ ((jump_exc t1 :((α, δ, ε) wordSem$state # num # num) option) ≠ (NONE :((α, δ, ε) wordSem$state # num # num) option) ⇔ (jump_exc t :((α, β, γ) wordSem$state # num # num) option) ≠ (NONE :((α, β, γ) wordSem$state # num # num) option))
