jump_exc_push_env_SOME_typed=(jump_exc (push_env (y :α word_loc sptree$num_map # α word_loc sptree$num_map) (SOME ((x :num),(prog1 :α wordLang$prog),(l1 :num),(l2 :num))) (t :(α, β, γ) wordSem$state)) :((α, β, γ) wordSem$state # num # num) option) ≠ (NONE :((α, β, γ) wordSem$state # num # num) option)
eval_push_env_T_Raise_IMP_stack_length_typed=(evaluate ((p :dataLang$prog),call_env (ys :v list) (ss :num option) (push_env (x :v sptree$num_map) T (dec_clock (s :(γ, 'ffi) dataSem$state) :(γ, 'ffi) dataSem$state))) :(v list, v) semanticPrimitives$result option # (γ, 'ffi) dataSem$state) = (SOME (Rerr (Rraise (a :v)) :(v list, v) semanticPrimitives$result),(r' :(γ, 'ffi) dataSem$state)) ⇒ LENGTH r'.stack = LENGTH s.stack
eval_push_env_SOME_exc_IMP_s_key_eq_typed=(evaluate ((p :α wordLang$prog),call_env (args1 :α word_loc list) (ss :num option) (push_env (y :α word_loc sptree$num_map # α word_loc sptree$num_map) (SOME ((x1 :num),(x2 :α wordLang$prog),(x3 :num),(x4 :num))) (dec_clock (t :(α, β, γ) wordSem$state) :(α, β, γ) wordSem$state))) :α result option # (α, β, γ) wordSem$state) = (SOME (Exception (l :α word_loc) (w :α word_loc)),(t1 :(α, β, γ) wordSem$state)) ⇒ s_key_eq t1.stack t.stack ∧ t.handler = t1.handler
eval_exc_stack_shorter_typed=(evaluate ((c :dataLang$prog),call_env (ys :v list) (ss :num option) (push_env (x :v sptree$num_map) F (dec_clock (s :(γ, 'ffi) dataSem$state) :(γ, 'ffi) dataSem$state))) :(v list, v) semanticPrimitives$result option # (γ, 'ffi) dataSem$state) = (SOME (Rerr (Rraise (a :v)) :(v list, v) semanticPrimitives$result),(r' :(γ, 'ffi) dataSem$state)) ⇒ LENGTH r'.stack < LENGTH s.stack
