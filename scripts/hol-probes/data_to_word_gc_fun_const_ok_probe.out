state_rel_insert_3_1_typed=(state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(α, β) dataSem$state) ((t :(γ, α, β) wordSem$state) with locals := (insert (3 :num) (x :γ word_loc) (insert (1 :num) (y :γ word_loc) t.locals :γ word_loc sptree$num_map) :γ word_loc sptree$num_map)) (v :(v # γ word_loc) list option) (locs :(num # num) list) :bool) ⇔ (state_rel c l1 l2 s t v locs :bool)
