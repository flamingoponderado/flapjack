gc_inc_clock_def_typed=∀(n :num) (t :(α, γ, 'ffi) wordSem$state). inc_clock n t = t with clock := t.clock + n
gc_inc_clock_0_typed=∀(t :(α, β, γ) wordSem$state). inc_clock (0 :num) t = t
