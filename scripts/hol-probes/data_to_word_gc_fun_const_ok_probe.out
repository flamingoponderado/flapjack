word_gc_move_IMP_isWord_typed=word_gc_move (c' :data_to_word$config) (Word (c :α word),(i :α word),(pa :α word),(old :α word),(m :α word -> α word_loc),(dm :α word -> bool)) = ((w1 :α word_loc),(i1 :α word),(pa1 :α word),(m1 :α word -> α word_loc),(c1 :bool)) ⇒ isWord w1
word_gen_gc_move_IMP_isWord_typed=word_gen_gc_move (c' :data_to_word$config) (Word (c :α word),(i :α word),(pa :α word),(ib :α word),(pb :α word),(old :α word),(m :α word -> α word_loc),(dm :α word -> bool)) = ((w1 :α word_loc),(i1 :α word),(pa1 :α word),(ib1 :α word),(pb1 :α word),(m1 :α word -> α word_loc),(c1 :bool)) ⇒ isWord w1
word_gen_gc_partial_move_IMP_isWord_typed=word_gen_gc_partial_move (c' :data_to_word$config) (Word (c :α word),(i :α word),(pa :α word),(old :α word),(m :α word -> α word_loc),(dm :α word -> bool),(gs :α word),(rs :α word)) = ((w1 :α word_loc),(i1 :α word),(pa1 :α word),(m1 :α word -> α word_loc),(c1 :bool)) ⇒ isWord w1
word_gc_move_roots_IMP_FILTER0_replay_typed=∀(ws :α word_loc list) (i :α word) (pa :α word) (old :α word) (m :α word -> α word_loc) (dm :α word -> bool) (ws2 :α word_loc list) (i2 :α word) (pa2 :α word) (m2 :α word -> α word_loc) (c2 :bool) (c :data_to_word$config). word_gc_move_roots c (ws,i,pa,old,m,dm) = (ws2,i2,pa2,m2,c2) ∧ EVERY (loc_ok :α word_loc -> bool) ws ⇒ word_gc_move_roots c (FILTER (isWord :α word_loc -> bool) ws,i,pa,old,m,dm) = (FILTER (isWord :α word_loc -> bool) ws2,i2,pa2,m2,c2)
word_gen_gc_move_roots_IMP_FILTER0_replay_typed=∀(ws :α word_loc list) (i :α word) (pa :α word) (ib :α word) (pb :α word) (old :α word) (m :α word -> α word_loc) (dm :α word -> bool) (ws2 :α word_loc list) (i2 :α word) (pa2 :α word) (ib2 :α word) (pb2 :α word) (m2 :α word -> α word_loc) (c2 :bool) (c :data_to_word$config). word_gen_gc_move_roots c (ws,i,pa,ib,pb,old,m,dm) = (ws2,i2,pa2,ib2,pb2,m2,c2) ∧ EVERY (loc_ok :α word_loc -> bool) ws ⇒ word_gen_gc_move_roots c (FILTER (isWord :α word_loc -> bool) ws,i,pa,ib,pb,old,m,dm) = (FILTER (isWord :α word_loc -> bool) ws2,i2,pa2,ib2,pb2,m2,c2)
word_gen_gc_partial_move_roots_IMP_FILTER_first_replay_typed=∀(ws :α word_loc list) (i :α word) (pa :α word) (ib :β) (pb :γ) (old :α word) (m :α word -> α word_loc) (dm :α word -> bool) (ws2 :α word_loc list) (i2 :α word) (pa2 :α word) (ib2 :δ) (pb2 :ε) (m2 :α word -> α word_loc) (c2 :bool) (c :data_to_word$config). word_gen_gc_partial_move_roots c (ws,i,pa,old,m,dm,(gs :α word),(rs :α word)) = (ws2,i2,pa2,m2,c2) ∧ EVERY (loc_ok :α word_loc -> bool) ws ⇒ word_gen_gc_partial_move_roots c (FILTER (isWord :α word_loc -> bool) ws,i,pa,old,m,dm,gs,rs) = (FILTER (isWord :α word_loc -> bool) ws2,i2,pa2,m2,c2)
word_gc_fun_APPEND_IMP_typed=word_gc_fun (c :data_to_word$config) ((xs :α word_loc list) ++ (ys :α word_loc list),(m :α word -> α word_loc),(dm :α word -> bool),(s :store_name |-> α word_loc)) = SOME ((zs :α word_loc list),(m1 :α word -> α word_loc),(s1 :store_name |-> α word_loc)) ⇒ ∃(zs1 :α word_loc list) (zs2 :α word_loc list). zs = zs1 ++ zs2 ∧ LENGTH xs = LENGTH zs1 ∧ LENGTH ys = LENGTH zs2
IMP_loc_merge_APPEND_typed=LENGTH (FILTER (isWord :α word_loc -> bool) (ts :α word_loc list)) = LENGTH (qs :α word_loc list) ⇒ loc_merge (ts ++ (xs :α word_loc list)) (qs ++ (ys :α word_loc list)) = loc_merge ts qs ++ loc_merge xs ys
TAKE_DROP_loc_merge_APPEND_typed=TAKE (LENGTH (q :(β # α word_loc) list)) (loc_merge (MAP (SND :β # α word_loc -> α word_loc) q) (xs :α word_loc list) ++ (ys :α word_loc list)) = loc_merge (MAP (SND :β # α word_loc -> α word_loc) q) xs ∧ DROP (LENGTH q) (loc_merge (MAP (SND :β # α word_loc -> α word_loc) q) xs ++ ys) = ys
loc_merge_NIL_typed=∀(xs :α word_loc list). loc_merge xs ([] :α word_loc list) = xs
loc_merge_APPEND_typed=∀(xs1 :α word_loc list) (xs2 :α word_loc list) (ys :α word_loc list). ∃(zs1 :α word_loc list) (zs2 :α word_loc list). loc_merge (xs1 ++ xs2) ys = zs1 ++ zs2 ∧ LENGTH zs1 = LENGTH xs1 ∧ LENGTH xs2 = LENGTH xs2 ∧ ∃(ts :α word_loc list). loc_merge xs2 ts = zs2
EVERY2_loc_merge_typed=∀(xs :α word_loc list) (ys :α word_loc list). LIST_REL (λ(x :α word_loc) (y :α word_loc). (isWord y ⇒ isWord x) ∧ (¬isWord x ⇒ x = y)) xs (loc_merge xs ys)
ALOOKUP_ZIP_typed=∀(l :(num # α word_loc) list) (zs1 :α word_loc list). ALOOKUP l (0 :num) = SOME (Loc (q :num) (r :num) :α word_loc) ∧ LIST_REL (λ(x :α word_loc) (y :α word_loc). (isWord y ⇒ isWord x) ∧ (¬isWord x ⇒ x = y)) (MAP (SND :num # α word_loc -> α word_loc) l) zs1 ⇒ ALOOKUP (ZIP (MAP (FST :num # α word_loc -> num) l,zs1)) (0 :num) = SOME (Loc q r :α word_loc)
join_env_NIL_typed=join_env (s :α sptree$num_map) ([] :(num # β) list) = ([] :(α # β) list)
join_env_CONS_typed=join_env (s :α sptree$num_map) (((n :num),(v :β))::(xs :(num # β) list)) = if n ≠ (0 :num) ∧ EVEN n then (THE (lookup ((n − (2 :num)) DIV (2 :num)) s :α option),v)::join_env s xs else join_env s xs
stack_rel_simp_typed=(stack_rel (Env (i :num option) (s :v sptree$num_map) :stack) (y :α stack_frame) ⇔ ∃(rets :(num # α word_loc) list) (vs :(num # α word_loc) list). stack_rel (Env i s :stack) y ∧ y = StackFrame i rets vs (NONE :(num # num # num) option)) ∧ (stack_rel (Exc i s (n :num)) y ⇔ ∃(rets :(num # α word_loc) list) (vs :(num # α word_loc) list) (x1 :num) (x2 :num) (x3 :num). stack_rel (Exc i s n) y ∧ y = StackFrame i rets vs (SOME (x1,x2,x3)))
join_env_EQ_ZIP_typed=∀(vs :(num # α word_loc) list) (s :β sptree$num_map) (zs1 :α word_loc list). EVERY (λ((x1 :num),(x2 :α word_loc)). x1 ≠ (0 :num) ∧ EVEN x1) vs ∧ LENGTH (join_env s vs) = LENGTH zs1 ∧ LIST_REL (λ(x :α word_loc) (y :α word_loc). (isWord x ⇔ isWord y) ∧ (¬isWord x ⇒ x = y)) (MAP (SND :β # α word_loc -> α word_loc) (join_env s vs)) zs1 ⇒ join_env s (ZIP (MAP (FST :num # α word_loc -> num) vs,loc_merge (MAP (SND :num # α word_loc -> α word_loc) vs) (FILTER (isWord :α word_loc -> bool) zs1))) = ZIP (MAP (FST :β # α word_loc -> β) (join_env s vs),zs1)
LENGTH_MAP_SND_join_env_IMP_typed=∀(vs :(num # α word_loc) list) (zs1 :α word_loc list) (s :β sptree$num_map). LIST_REL (λ(x :α word_loc) (y :α word_loc). (isWord x ⇔ isWord y) ∧ (¬isWord x ⇒ x = y)) (MAP (SND :β # α word_loc -> α word_loc) (join_env s vs)) zs1 ∧ EVERY (λ((x1 :num),(x2 :α word_loc)). x1 ≠ (0 :num) ∧ EVEN x1) vs ∧ LENGTH (join_env s vs) = LENGTH zs1 ⇒ LENGTH (FILTER (isWord :α word_loc -> bool) (MAP (SND :num # α word_loc -> α word_loc) vs)) = LENGTH (FILTER (isWord :α word_loc -> bool) zs1)
lemma1_typed=(y1 :α) = (y2 :α) ∧ (x1 :β) = (x2 :β) ⇒ (f :β -> α -> γ) x1 y1 = f x2 y2
word_ml_inv_cons_snoc_typed=word_ml_inv ((heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) (c :data_to_word$config) (refs :v ref sptree$num_map) ((x :v # α word_loc)::(xs :(v # α word_loc) list)) ⇒ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c refs (xs ++ [x])
toListA_mk_typed=toListA (a :α list) (mk_BN (t1 :α sptree$num_map) (t2 :α sptree$num_map)) = toListA a (BN t1 t2) ∧ toListA a (mk_BS t1 (x :α) t2) = toListA a (BS t1 x t2)
PERM_lookup_toList_lemma_typed=∀(l :(num # α) list) (s :β sptree$num_map). (∀(n :num). IS_SOME (lookup n s :β option) ⇔ IS_SOME (ALOOKUP l (adjust_var n))) ∧ ALL_DISTINCT (MAP (FST :num # α -> num) l) ⇒ PERM (MAP (FST :β # α -> β) (MAP (λ((n :num),(v :α)). (THE (lookup ((n − (2 :num)) DIV (2 :num)) s :β option),v)) (FILTER (λ((n :num),(v :α)). n ≠ (0 :num) ∧ EVEN n) l))) (toList s :β list)
get_vars_sing_typed=(get_vars [(n :num)] (t :(α, β, γ) wordSem$state) :α word_loc list option) = SOME (x :α word_loc list) ⇔ ∃(x1 :α word_loc). (get_vars [n] t :α word_loc list option) = SOME [x1] ∧ x = [x1]
adjust_var_not_15_typed=adjust_var (a2 :num) ≠ (15 :num)
memory_rel_Temp_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc)⟨Temp (i :word5) ↦ (w :α word_loc)⟩ (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list) ⇔ memory_rel c be ts refs sp st m dm vars
MustTerminate_limit_NOT_0_typed=MustTerminate_limit (:α) ≠ (0 :num)
join_env_locals_def_typed=∀(sl :α sptree$num_map) (tl :β sptree$num_map). join_env_locals sl tl = join_env sl (toAList (inter tl (adjust_set sl)))
join_env_locals_insert_odd_typed=ODD (n :num) ⇒ join_env_locals (sl :α sptree$num_map) (insert n (v :β) (ls :β sptree$num_map) :β sptree$num_map) = join_env_locals sl ls
join_env_locals_insert_dest_odd_typed=ODD (n :num) ⇒ join_env_locals (sl :α sptree$num_map) (insert (adjust_var (dest :num)) (w :β) (insert n (v :β) (ls :β sptree$num_map) :β sptree$num_map) :β sptree$num_map) = join_env_locals sl (insert (adjust_var dest) w ls :β sptree$num_map)
inter_insert_ODD_adjust_set_alt_typed=∀(k :num). ODD k ⇒ inter (insert k (v :α) (s :α sptree$num_map) :α sptree$num_map) (adjust_set (t :β sptree$num_map)) = inter s (adjust_set t)
get_vars_termdep_typed=∀(xs :num list). (get_vars xs ((t :(α, β, γ) wordSem$state) with termdep := t.termdep − (1 :num)) :α word_loc list option) = (get_vars xs t :α word_loc list option)
inter_delete_ODD_adjust_set_alt_typed=∀(k :num). ODD k ⇒ inter (delete k (s :α sptree$num_map) :α sptree$num_map) (adjust_set (t :β sptree$num_map)) = inter s (adjust_set t)
inter_insert_ODD_adjust_set_typed=∀(k :num). ODD k ⇒ inter (insert (adjust_var (dest :num)) (w :α) (insert k (v :α) (s :α sptree$num_map) :α sptree$num_map) :α sptree$num_map) (adjust_set (t :β sptree$num_map)) = inter (insert (adjust_var dest) w s :α sptree$num_map) (adjust_set t)
get_vars_1_IMP_typed=(get_vars [(x1 :num)] (s :(α, β, γ) wordSem$state) :α word_loc list option) = SOME [(v1 :α word_loc)] ⇒ (get_var x1 s :α word_loc option) = SOME v1
get_vars_2_IMP_typed=(get_vars [(x1 :num); (x2 :num)] (s :(α, β, γ) wordSem$state) :α word_loc list option) = SOME [(v1 :α word_loc); (v2 :α word_loc)] ⇒ (get_var x1 s :α word_loc option) = SOME v1 ∧ (get_var x2 s :α word_loc option) = SOME v2
get_vars_3_IMP_typed=(get_vars [(x1 :num); (x2 :num); (x3 :num)] (s :(α, β, γ) wordSem$state) :α word_loc list option) = SOME [(v1 :α word_loc); (v2 :α word_loc); (v3 :α word_loc)] ⇒ (get_var x1 s :α word_loc option) = SOME v1 ∧ (get_var x2 s :α word_loc option) = SOME v2 ∧ (get_var x3 s :α word_loc option) = SOME v3
