part_to_words_def_typed=(∀(c :config) (m :(bool # α word_loc) sptree$num_map) (i :int) (offset :α word). part_to_words c m (Int i) offset = if small_int (:α) i then SOME ((F,Word (Smallnum i :α word)),([] :(bool # α word_loc) list)) else (let ((sign :bool),(ws :α word list)) = (i2mw i :bool # α word list) in case (encode_header c (if sign then (7 :num) else (3 :num)) (LENGTH ws) :α word option) of (NONE :α word option) => (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) | SOME hd => SOME ((T,make_ptr c offset (0w :α word) (LENGTH ws)),MAP (λ(w :α word). (F,Word w)) (hd::ws)))) ∧ (∀(c :config) (m :(bool # α word_loc) sptree$num_map) (t :num) (ns :num list) (offset :α word). part_to_words c m (Con t ns :const_part) offset = if NULL ns then if t < dimword (:α) DIV (16 :num) then SOME ((F,Word (n2w ((16 :num) * t + (2 :num)) :α word)),([] :(bool # α word_loc) list)) else (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) else case (encode_header c ((4 :num) * t) (LENGTH ns) :α word option) of (NONE :α word option) => (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) | SOME hd => SOME ((T,Word (offset ≪ (shift_length c − shift (:α)) + ((ptr_bits c t (LENGTH ns) :α word) ‖ (1w :α word)))),(F,Word hd)::MAP (lookup_mem m) ns)) ∧ (∀(c :config) (m :(bool # α word_loc) sptree$num_map) (w :word64) (offset :α word). part_to_words c m (W64 w :const_part) offset = (let (ws :α word list) = if dimindex (:α) < (64 :num) then [(((63 :num) >< (32 :num)) w :α word); (((31 :num) >< (0 :num)) w :α word)] else [(((63 :num) >< (0 :num)) w :α word)] in case (encode_header c (3 :num) (LENGTH ws) :α word option) of (NONE :α word option) => (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) | SOME hd => SOME ((T,make_ptr c offset (0w :α word) (LENGTH ws)),MAP (λ(w :α word). (F,Word w)) (hd::ws)))) ∧ ∀(c :config) (m :(bool # α word_loc) sptree$num_map) (s :mlstring) (offset :α word). part_to_words c m (Str s) offset = (let (bytes :word8 list) = MAP ((n2w :num -> word8) ∘ ORD) (explode s); (n :num) = LENGTH bytes; (hd :α word) = (make_byte_header c T n :α word); (k :num) = byte_len (:α) n; (ws :α word list) = write_bytes bytes (REPLICATE k (0w :α word)) c.be in if k < (2 :num) ** (dimindex (:α) − (4 :num)) ∧ k < (2 :num) ** c.len_size then SOME ((T,make_ptr c offset (0w :α word) k),MAP (λ(w :α word). (F,Word w)) (hd::ws)) else (NONE :((bool # α word_loc) # (bool # α word_loc) list) option))
