sl_full_LASTN_LENGTH_ID2=⊢ ∀stack x. x + 1 = LENGTH stack ⇒ LASTN (x + 1) stack = HD stack::LASTN x stack
sl_full_LASTN_LENGTH_BOUNDS=⊢ ∀n ls. (let xs = LASTN n ls in LENGTH xs ≤ n ∧ LENGTH xs ≤ LENGTH ls)
sl_full_LASTN_CONS_ID=⊢ n = LENGTH ls ⇒ LASTN (SUC n) (frame::ls) = frame::ls
sl_full_LASTN_DROP2=⊢ ∀l n. LASTN n l = DROP (LENGTH l − n) l
sl_full_EVERY_IMP_EVERY_LASTN=⊢ ∀xs ys P. EVERY P xs ∧ LASTN n xs = ys ⇒ EVERY P ys
sl_full_LASTN_LESS=⊢ ∀ls n x xs. n + 1 ≤ LENGTH ls ∧ LASTN (n + 1) ls = x::xs ⇒ LASTN n ls = xs
