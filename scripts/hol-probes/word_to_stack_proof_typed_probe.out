full_read_bitmap_append_typed=∀(bitmaps :α word list) (w :β word_loc) (bits :bool list) (more_bitmaps :α word list). full_read_bitmap bitmaps w = SOME bits ⇒ full_read_bitmap (bitmaps ++ more_bitmaps) w = SOME bits
