read_bitmap_insert_bitmap_typed=∀(bs :β word app_list) (n :num) (bs' :β word app_list) (n' :num) (i :num) (cur :β word list). i < dimword (:α) ∧ IS_SOME (read_bitmap (bm :β word list)) ∧ n = LENGTH cur + LENGTH (append bs) ∧ insert_bitmap bm (bs,n) = ((bs',n'),i) ⇒ read_bitmap (DROP (i MOD dimword (:α)) (cur ++ append bs')) = read_bitmap bm
