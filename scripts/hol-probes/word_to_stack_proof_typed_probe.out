list_LUPDATE_TAKE_DROP_typed=∀(xs :α list) (ys :α list) (n :num). list_LUPDATE xs n ys = TAKE n ys ++ list_LUPDATE xs (0 :num) (DROP n ys)
list_LUPDATE_0_CONS_typed=∀(xs :α list) (x :α) (ys :α list) (y :α). list_LUPDATE (x::xs) (0 :num) (y::ys) = x::list_LUPDATE xs (0 :num) ys
TAKE_list_LUPDATE_typed=∀(ys :α list) (xs :α list) (n :num) (i :num). TAKE n (list_LUPDATE ys i xs) = list_LUPDATE ys i (TAKE n xs)
DROP_DROP_EQ_typed=∀(n :num) (m :num) (xs :α list). DROP m (DROP n xs) = DROP (m + n) xs
DROP_LUPDATE_typed=∀(n :num) (h :α) (m :num) (xs :α list). DROP n xs❲m ↦ h❳ = if m < n then DROP n xs else (DROP n xs)❲m − n ↦ h❳
TAKE_LUPDATE_typed=∀(xs :α list) (n :num) (x :α) (i :num). TAKE n xs❲i ↦ x❳ = (TAKE n xs)❲i ↦ x❳
wLive_LENGTH_typed=∀(a :sptree$num_set # sptree$num_set) (bs :α word app_list # num) (c :num # num # num) (q :α stackLang$prog) (bs' :α word app_list # num). wLive a bs c = (q,bs') ∧ LENGTH (append (FST bs)) ≤ SND bs ⇒ LENGTH (append (FST bs')) ≤ SND bs' ∧ SND bs − LENGTH (append (FST bs)) = SND bs' − LENGTH (append (FST bs'))
EVEN_DIV2_INJ_typed=EVEN (x :num) ∧ EVEN (y :num) ∧ DIV2 x = DIV2 y ⇒ x = y
isPREFIX_DROP_typed=∀(s :α list) (t :α list) (i :num). s ≼ t ⇒ DROP i s ≼ DROP i t
