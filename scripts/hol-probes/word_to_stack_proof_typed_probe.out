alist_insert_get_vars_typed=∀(moves :(num # num) list) (s :(α, β, γ) state) (x :α word_loc list) (ls :num option list). ALL_DISTINCT (MAP (FST :num # num -> num) moves) ∧ (get_vars (MAP (SND :num # num -> num) moves) s :α word_loc list option) = SOME x ∧ ALL_DISTINCT (FILTER (IS_SOME :num option -> bool) ls) ∧ wf s.locals ∧ (∀(x :num). MEM (SOME x) ls ⇒ MEM x (MAP (FST :num # num -> num) moves)) ∧ (∀(x :num) (y :num). MEM (x,y) moves ∧ x ≠ y ⇒ MEM (SOME x) ls) ⇒ alist_insert (MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) ls)) (MAP (λ(x :num option). THE (get_var (THE (ALOOKUP moves (THE x))) s :α word_loc option)) (FILTER (IS_SOME :num option -> bool) ls)) s.locals = alist_insert (MAP (FST :num # num -> num) moves) x s.locals
wMoveSingle_thm_typed=state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) (s :(α, num # β, γ) state) (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ (case (x :num option) of (NONE :num option) => (get_var (k + (1 :num)) t :α word_loc option) = SOME (v :α word_loc) | SOME x => (get_var (x * (2 :num)) s :α word_loc option) = SOME v) ∧ (case (y :num option) of (NONE :num option) => T | SOME x => x < f' + k) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate ((wMoveSingle (format_var k y,format_var k x) (k,f,f') :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ state_rel ac k f f' (case y of (NONE :num option) => s | SOME y => set_var (y * (2 :num)) v s) t' lens (0 :num) ∧ (y = (NONE :num option) ⇒ (get_var (k + (1 :num)) t' :α word_loc option) = SOME v) ∧ (y ≠ (NONE :num option) ⇒ (get_var (k + (1 :num)) t' :α word_loc option) = (get_var (k + (1 :num)) t :α word_loc option)) ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space
