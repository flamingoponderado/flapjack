share_load_lemma1_typed=(share_inst (op :memop) ((2 :num) * (v :num)) (ad' :α word) (s :(α, num # β, γ) state) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ k ≤ v ∧ (op = Load ∨ op = Load8 ∨ op = Load16 ∨ op = Load32) ∧ res ≠ SOME (Error :α wordSem$result) ⇒ ∃(t1 :(α, β, γ) stackSem$state). sh_mem_op op k ad' t = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(f :final_event). res = SOME (FinalFFI f :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 (t1 with stack := t1.stack❲t1.stack_space + (f + k − (v + (1 :num))) ↦ THE (FLOOKUP t1.regs k)❳) lens (0 :num) ∧ (∃(x :α word_loc). FLOOKUP t1.regs k = SOME x) ∧ t1.stack_space = t.stack_space ∧ LENGTH t1.stack = LENGTH t.stack)
