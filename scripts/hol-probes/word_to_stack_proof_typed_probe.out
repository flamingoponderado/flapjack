ALOOKUP_ID_TABULATE_typed=ALOOKUP (MAP (λ(x :α). (x,x)) (ls :α list)) (x :α) = if MEM x ls then SOME x else (NONE :α option)
ALOOKUP_MAP_any_typed=∀(f :α # β -> γ # δ) (k :α -> γ) (h :γ -> β -> δ) (ls :(α # β) list) (a :α) (x :γ). INJ k (a INSERT set (MAP (FST :α # β -> α) ls)) 𝕌(:γ) ∧ (∀(x :α) (y :β). MEM (x,y) ls ⇒ f (x,y) = (k x,h (k x) y)) ∧ k a = x ⇒ ALOOKUP (MAP f ls) x = OPTION_MAP (h x) (ALOOKUP ls a)
ALOOKUP_MAP_INJ_FST_typed=∀(ls :α list) (f :α -> β # γ) (x :α) (k :β). INJ ((FST :β # γ -> β) ∘ f) (x INSERT set ls) 𝕌(:β) ∧ FST (f x) = k ⇒ ALOOKUP (MAP f ls) k = ALOOKUP (MAP (λ(x :α). (x,SND (f x))) ls) x
