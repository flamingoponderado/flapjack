word_to_stack_stack_asm_convs_typed=EVERY (λ((n :num),(m :num),(p :α prog)). full_inst_ok_less (c :α asm_config) p ∧ (c.two_reg_arith ⇒ every_inst (two_reg_inst :α inst -> bool) p) ∧ (no_share_inst p ∨ c.ISA ≠ Ag32) ∧ post_alloc_conventions (c.reg_count − (LENGTH c.avoid_regs + (5 :num))) p) (progs :(num # num # α prog) list) ∧ (4 :num) < c.reg_count − (LENGTH c.avoid_regs + (5 :num)) ⇒ EVERY (λ((n :num),(p :α stackLang$prog)). stack_asm_name c p ∧ stack_asm_remove c p) (SND (SND (SND (compile c F progs :α word list # config # num list # (num # α stackLang$prog) list))))
