evaluate_SeqStackFree_typed=(s :(α, β, γ) stackSem$state).use_stack ∧ s.stack_space ≤ LENGTH s.stack ⇒ (evaluate (SeqStackFree (n :num) (p :α stackLang$prog),s) :α stackSem$result option # (α, β, γ) stackSem$state) = (evaluate (Seq (StackFree n :α stackLang$prog) p,s) :α stackSem$result option # (α, β, γ) stackSem$state)
evaluate_copy_ret_aux_typed=∀(k :num) (f :num) (n :num) (t :(α, β, γ) stackSem$state). t.use_stack ∧ f ≠ (0 :num) ∧ f ≤ LENGTH t.stack − (t.stack_space + n) ⇒ ∃(t' :(α, β, γ) stackSem$state). (evaluate ((copy_ret_aux k f n :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),t') ∧ ∃(t'_stack :α word_loc list) (t'_regs :num |-> α word_loc). t' = t with <|stack := t'_stack; regs := t'_regs|> ∧ LENGTH t'_stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ DROP (f + n + t'.stack_space) t'_stack = DROP (f + n + t.stack_space) t.stack ∧ (∀(i :num). i ≠ k ⇒ (get_var i t' :α word_loc option) = (get_var i t :α word_loc option)) ∧ (∀(m :num). m < f − n ⇒ (DROP (n + t'.stack_space) t'_stack)❲m❳ = (DROP (n + t.stack_space) t.stack)❲m❳) ∧ (let (stack' :α word_loc list) = DROP t'.stack_space t'_stack; (stack :α word_loc list) = DROP t.stack_space t.stack in ∀(x :num). x < n ⇒ stack'❲x + f❳ = stack❲x❳)
evaluate_copy_ret_aux_clock_typed=∀(t :(α, β, γ) stackSem$state). (evaluate ((copy_ret_aux (k :num) (f :num) (n :num) :α stackLang$prog),t with clock := (clk :num)) :α stackSem$result option # (α, β, γ) stackSem$state) = ((I :α stackSem$result option -> α stackSem$result option) ## (λ(t :(α, β, γ) stackSem$state). t with clock := clk)) (evaluate ((copy_ret_aux k f n :α stackLang$prog),t) :α stackSem$result option # (α, β, γ) stackSem$state)
