evaluate_ShareInst_correct_lemma_typed=(evaluate (ShareInst (op :memop) ((2 :num) * (v :num)) (Op Add [(Var ((2 :num) * (ad :num)) :α exp); (Const (offset :α word) :α exp)]),(s :(α, num # β, γ) state)) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ ad < f' + k ⇒ ∃(ck :num) (t1 :(α, β, γ) stackSem$state). (evaluate (wShareInst op ((2 :num) * v) (Addr ((2 :num) * ad) offset) (k,f,f'),t with clock := ck + t.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ (res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num) ∨ ∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock)
evaluate_ShareInst_Load_typed=(evaluate (ShareInst (op :memop) ((2 :num) * (v :num)) (Op Add [(Var ((2 :num) * (ad :num)) :α exp); (Const (offset :α word) :α exp)]),(s :(α, num # β, γ) state)) :α wordSem$result option # (α, num # β, γ) state) = ((res :α wordSem$result option),(s1 :(α, num # β, γ) state)) ∧ res ≠ SOME (Error :α wordSem$result) ∧ state_rel (ac :α asm_config) (k :num) (f :num) (f' :num) s (t :(α, β, γ) stackSem$state) (lens :num list) (0 :num) ∧ v < f' + k ∧ ad < f' + k ∧ (op = Load ∨ op = Load8 ∨ op = Load16 ∨ op = Load32) ⇒ ∃(ck :num) (t1 :(α, β, γ) stackSem$state). (evaluate (wShareInst op ((2 :num) * v) (Addr ((2 :num) * ad) offset) (k,f,f'),t with clock := ck + t.clock) :α stackSem$result option # (α, β, γ) stackSem$state) = (OPTION_MAP (compile_result :α wordSem$result -> α stackSem$result) res,t1) ∧ ((∃(fv :final_event). res = SOME (FinalFFI fv :α wordSem$result) ∧ s1.ffi = t1.ffi ∧ s1.clock = t1.clock) ∨ res = (NONE :α wordSem$result option) ∧ state_rel ac k f f' s1 t1 lens (0 :num))
