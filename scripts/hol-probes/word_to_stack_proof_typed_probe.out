word_to_stack_good_code_labels_typed=(compile (asm_conf :α asm_config) F (progs :(num # num # α prog) list) :α word list # config # num list # (num # α stackLang$prog) list) = ((bytes :α word list),(bs :config),(fs :num list),(prog' :(num # α stackLang$prog) list)) ∧ word_good_code_labels progs (elabs :num -> bool) ⇒ stack_good_code_labels prog' elabs
word_to_stack_good_handler_labels_typed=EVERY (λ((n :num),(m :num),(pp :α prog)). word_good_handlers n pp) (prog :(num # num # α prog) list) ⇒ (compile (asm_conf :α asm_config) F prog :α word list # config # num list # (num # α stackLang$prog) list) = ((bytes :α word list),(bs :config),(fs :num list),(prog' :(num # α stackLang$prog) list)) ⇒ stack_good_handler_labels prog'
the_words_EVERY_IS_SOME_Word_typed=∀(ls :α word_loc option list) (x :α word list). the_words ls = SOME x ⇒ ∀(a :α word_loc option). MEM a ls ⇒ ∃(w :α word). a = SOME (Word w)
the_words_MAP_exists_typed=∀(ls :α list) (x :β word list) (a :α) (f :α -> β word_loc option). the_words (MAP f ls) = SOME x ∧ MEM a ls ⇒ ∃(w :β word). f a = SOME (Word w)
the_words_SOME_eq_typed=∀(ls :α word_loc option list) (x :α word list). the_words ls = SOME x ⇒ x = MAP (λ(x :α word_loc option). case x of (NONE :α word_loc option) => (ARB :α word) | SOME (Word y) => y | SOME (Loc v2 v3 :α word_loc) => (ARB :α word)) ls
LENGTH_word_list_typed=∀(xs :bool list) (d :num). LENGTH (word_list xs d :α word list) = if d = (0 :num) then (1 :num) else (LENGTH xs − (1 :num)) DIV d + (1 :num)
const_addresses_def_typed=(∀(a :α word) (d :α word -> bool). const_addresses a ([] :β list) d ⇔ T) ∧ ∀(a :α word) (x :β) (xs :β list) (d :α word -> bool). const_addresses a (x::xs) d ⇔ a ∈ d ∧ const_addresses (a + (bytes_in_word :α word)) xs d
