pan_installed_def_replay_statement=∀bytes cbspace bitmaps data_sp ffi_names r1 r2 mc_conf shmem_extra ms p_mem p_dom sdm'. pan_installed bytes cbspace bitmaps data_sp ffi_names (r1,r2) mc_conf shmem_extra ms p_mem p_dom sdm' ⇔ ∃t m bitmap_ptr bitmaps_dm sdm. (let heap_stack_dm = {w | t.regs r1 ≤₊ w ∧ w <₊ t.regs r2} in (∀a. a ∈ p_dom ⇒ m a = p_mem a) ∧ good_init_state mc_conf ms bytes cbspace t m (heap_stack_dm ∪ bitmaps_dm) sdm ∧ sdm' = sdm ∩ byte_aligned ∧ byte_aligned (t.regs r1) ∧ byte_aligned (t.regs r2) ∧ byte_aligned bitmap_ptr ∧ t.regs r1 ≤₊ t.regs r2 ∧ 1024w * bytes_in_word ≤₊ t.regs r2 − t.regs r1 ∧ DISJOINT heap_stack_dm bitmaps_dm ∧ m (t.regs r1) = Word bitmap_ptr ∧ m (t.regs r1 + bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) ∧ m (t.regs r1 + 2w * bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w data_sp + bytes_in_word * n2w (LENGTH bitmaps)) ∧ m (t.regs r1 + 3w * bytes_in_word) = Word (mc_conf.target.get_pc ms + n2w (LENGTH bytes)) ∧ m (t.regs r1 + 4w * bytes_in_word) = Word (mc_conf.target.get_pc ms + n2w cbspace + n2w (LENGTH bytes)) ∧ (word_list bitmap_ptr (MAP Word bitmaps) * word_list_exists (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) data_sp) (fun2set (m,byte_aligned ∩ bitmaps_dm)) ∧ ffi_names = SOME mc_conf.ffi_names ∧ ∀i. mmio_pcs_min_index mc_conf.ffi_names = SOME i ⇒ MAP (λrec. w2n (mc_conf.target.get_pc ms) + rec.entry_pc) shmem_extra = DROP i (MAP w2n mc_conf.ffi_entry_pcs) ∧ mc_conf.mmio_info = ZIP (GENLIST (λindex. index + i) (LENGTH shmem_extra),MAP (λrec. (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off),rec.reg,n2w rec.exit_pc + mc_conf.target.get_pc ms)) shmem_extra) ∧ cbspace + LENGTH bytes + ffi_offset * (i + 3) < dimword (:α))
pan_installed_def_replay_hypotheses=0
pan_installed_def_replay_typed=∀(bytes :word8 list) (cbspace :num) (bitmaps :α word list) (data_sp :num) (ffi_names :ffiname list option) (r1 :num) (r2 :num) (mc_conf :(α, 'state, β) machine_config) (shmem_extra :shmem_info_num list) (ms :'state) (p_mem :α word -> α word_loc) (p_dom :α word -> bool) (sdm' :α word -> bool). pan_installed bytes cbspace bitmaps data_sp ffi_names (r1,r2) mc_conf shmem_extra ms p_mem p_dom sdm' ⇔ ∃(t :α asm_state) (m :α word -> α word_loc) (bitmap_ptr :α word) (bitmaps_dm :α word -> bool) (sdm :α word -> bool). (let (heap_stack_dm :α word -> bool) = {w | t.regs r1 ≤₊ w ∧ w <₊ t.regs r2} in (∀(a :α word). a ∈ p_dom ⇒ m a = p_mem a) ∧ good_init_state mc_conf ms bytes cbspace t m (heap_stack_dm ∪ bitmaps_dm) sdm ∧ sdm' = sdm ∩ (byte_aligned :α word -> bool) ∧ byte_aligned (t.regs r1) ∧ byte_aligned (t.regs r2) ∧ byte_aligned bitmap_ptr ∧ t.regs r1 ≤₊ t.regs r2 ∧ (1024w :α word) * (bytes_in_word :α word) ≤₊ t.regs r2 − t.regs r1 ∧ DISJOINT heap_stack_dm bitmaps_dm ∧ m (t.regs r1) = Word bitmap_ptr ∧ m (t.regs r1 + (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ m (t.regs r1 + (2w :α word) * (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w data_sp :α word) + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ m (t.regs r1 + (3w :α word) * (bytes_in_word :α word)) = Word (mc_conf.target.get_pc ms + (n2w (LENGTH bytes) :α word)) ∧ m (t.regs r1 + (4w :α word) * (bytes_in_word :α word)) = Word (mc_conf.target.get_pc ms + (n2w cbspace :α word) + (n2w (LENGTH bytes) :α word)) ∧ (word_list bitmap_ptr (MAP (Word :α word -> α word_loc) bitmaps) * (word_list_exists (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) data_sp :(α word # α word_loc -> bool) -> bool)) (fun2set (m,(byte_aligned :α word -> bool) ∩ bitmaps_dm)) ∧ ffi_names = SOME mc_conf.ffi_names ∧ ∀(i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ⇒ MAP (λ(rec :shmem_info_num). w2n (mc_conf.target.get_pc ms) + rec.entry_pc) shmem_extra = DROP i (MAP (w2n :α word -> num) mc_conf.ffi_entry_pcs) ∧ mc_conf.mmio_info = ZIP (GENLIST (λ(index :num). index + i) (LENGTH shmem_extra),MAP (λ(rec :shmem_info_num). (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off :α word),rec.reg,(n2w rec.exit_pc :α word) + mc_conf.target.get_pc ms)) shmem_extra) ∧ cbspace + LENGTH bytes + ffi_offset * (i + (3 :num)) < dimword (:α))
pan_installed_imp_installed_replay_statement=pan_installed bytes cbspace bitmaps data_sp ffi_names (r1,r2) mc_conf shmem_extra ms p_mem p_dom sdm ⇒ installed bytes cbspace bitmaps data_sp ffi_names (r1,r2) mc_conf shmem_extra ms
pan_installed_imp_installed_replay_hypotheses=0
pan_installed_imp_installed_replay_typed=pan_installed (bytes :word8 list) (cbspace :num) (bitmaps :α word list) (data_sp :num) (ffi_names :ffiname list option) ((r1 :num),(r2 :num)) (mc_conf :(α, β, γ) machine_config) (shmem_extra :shmem_info_num list) (ms :β) (p_mem :α word -> α word_loc) (p_dom :α word -> bool) (sdm :α word -> bool) ⇒ installed bytes cbspace bitmaps data_sp ffi_names (r1,r2) mc_conf shmem_extra ms
