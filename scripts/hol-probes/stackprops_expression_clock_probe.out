ec_store_statement=mem_store (x :α word) (y :α word_loc)
  ((z :(α, β, γ) state) with clock := (k :num)) =
OPTION_MAP (λ(s :(α, β, γ) state). s with clock := k) (mem_store x y z)
ec_store_types=(z :(α, β, γ) state)::(α, β, γ) state;(k :num)::num;(y :α word_loc)::α word_loc;(x :α word)::α word;
ec_word_statement=∀(s :(α, β, γ) state) (y :α exp) (k :num).
  (word_exp (s with clock := k) y :α word option) =
  (word_exp s y :α word option)
ec_word_types=(s :(α, β, γ) state)::(α, β, γ) state;(y :α exp)::α exp;(k :num)::num;
ec_assign_statement=assign (x :num) (y :α exp) ((s :(α, β, γ) state) with clock := (k :num)) =
OPTION_MAP (λ(s :(α, β, γ) state). s with clock := k) (assign x y s)
ec_assign_types=(s :(α, β, γ) state)::(α, β, γ) state;(k :num)::num;(y :α exp)::α exp;(x :num)::num;
ec_const=SOME 255w
