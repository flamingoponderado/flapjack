csr_dispatch_definition_0=∀x. rec'FPCSR x = FPCSR (word_bit 3 x) ((7 >< 5) x) (word_bit 4 x) (word_bit 0 x) (word_bit 2 x) (word_bit 1 x) ((31 >< 8) x)
csr_dispatch_definition_1=∀x. reg'FPCSR x = case x of FPCSR DZ FRM NV NX OF UF fpcsr'rst => fpcsr'rst @@ FRM @@ v2w [NV] @@ v2w [DZ] @@ v2w [OF] @@ v2w [UF] @@ v2w [NX]
csr_dispatch_definition_2=∀_ x. write'reg'FPCSR (_,x) = rec'FPCSR x
csr_dispatch_definition_3=∀_ x. write'rec'FPCSR (_,x) = reg'FPCSR x
csr_dispatch_definition_4=∀csr. CSRMap csr = (λstate. case csr of 1w => (w2w ((4 >< 0) (reg'FPCSR (state.c_UCSR state.procID).fpcsr)),state) | 2w => (w2w (state.c_UCSR state.procID).fpcsr.FRM,state) | 3w => (w2w ((7 >< 0) (reg'FPCSR (state.c_UCSR state.procID).fpcsr)),state) | 3072w => (state.c_cycles state.procID + (state.c_UCSR state.procID).cycle_delta,state) | 3073w => (state.clock + (state.c_UCSR state.procID).time_delta,state) | 3074w => (state.c_instret state.procID + (state.c_UCSR state.procID).instret_delta,state) | 3200w => (sw2sw ((63 >< 32) (state.c_cycles state.procID + (state.c_UCSR state.procID).cycle_delta)),state) | 3201w => (sw2sw ((63 >< 32) (state.clock + (state.c_UCSR state.procID).time_delta)),state) | 3202w => (sw2sw ((63 >< 32) (state.c_instret state.procID + (state.c_UCSR state.procID).instret_delta)),state) | 256w => (reg'sstatus (lift_mstatus_sstatus (state.c_MCSR state.procID).mstatus),state) | 257w => ((state.c_SCSR state.procID).stvec,state) | 260w => (reg'sie (lift_mie_sie (state.c_MCSR state.procID).mie),state) | 289w => ((state.c_SCSR state.procID).stimecmp,state) | 3329w => (state.clock + (state.c_SCSR state.procID).stime_delta,state) | 3457w => (sw2sw ((63 >< 32) (state.clock + (state.c_SCSR state.procID).stime_delta)),state) | 320w => ((state.c_SCSR state.procID).sscratch,state) | 321w => ((state.c_SCSR state.procID).sepc,state) | 3394w => (reg'mcause (state.c_SCSR state.procID).scause,state) | 3395w => ((state.c_SCSR state.procID).sbadaddr,state) | 324w => (reg'sip (lift_mip_sip (state.c_MCSR state.procID).mip),state) | 384w => ((state.c_SCSR state.procID).sptbr,state) | 385w => ((state.c_SCSR state.procID).sasid,state) | 2304w => (state.c_cycles state.procID + (state.c_UCSR state.procID).cycle_delta,state) | 2305w => (state.clock + (state.c_UCSR state.procID).time_delta,state) | 2306w => (state.c_instret state.procID + (state.c_UCSR state.procID).instret_delta,state) | 2432w => (sw2sw ((63 >< 32) (state.c_cycles state.procID + (state.c_UCSR state.procID).cycle_delta)),state) | 2433w => (sw2sw ((63 >< 32) (state.clock + (state.c_UCSR state.procID).time_delta)),state) | 2434w => (sw2sw ((63 >< 32) (state.c_instret state.procID + (state.c_UCSR state.procID).instret_delta)),state) | 512w => (reg'mstatus (state.c_HCSR state.procID).hstatus,state) | 513w => ((state.c_HCSR state.procID).htvec,state) | 514w => (reg'mtdeleg (state.c_HCSR state.procID).htdeleg,state) | 545w => ((state.c_HCSR state.procID).htimecmp,state) | 3585w => (state.clock + (state.c_HCSR state.procID).htime_delta,state) | 3713w => (sw2sw ((63 >< 32) (state.clock + (state.c_HCSR state.procID).htime_delta)),state) | 576w => ((state.c_HCSR state.procID).hscratch,state) | 577w => ((state.c_HCSR state.procID).hepc,state) | 578w => (reg'mcause (state.c_HCSR state.procID).hcause,state) | 579w => ((state.c_HCSR state.procID).hbadaddr,state) | 2561w => (state.clock + (state.c_SCSR state.procID).stime_delta,state) | 2689w => (sw2sw ((63 >< 32) (state.clock + (state.c_SCSR state.procID).stime_delta)),state) | 3840w => (reg'mcpuid (state.c_MCSR state.procID).mcpuid,state) | 3841w => (reg'mimpid (state.c_MCSR state.procID).mimpid,state) | 3856w => ((state.c_MCSR state.procID).mhartid,state) | 768w => (reg'mstatus (state.c_MCSR state.procID).mstatus,state) | 769w => ((state.c_MCSR state.procID).mtvec,state) | 770w => (reg'mtdeleg (state.c_MCSR state.procID).mtdeleg,state) | 772w => (reg'mie (state.c_MCSR state.procID).mie,state) | 801w => ((state.c_MCSR state.procID).mtimecmp,state) | 1793w => (state.clock + (state.c_MCSR state.procID).mtime_delta,state) | 1857w => (sw2sw ((63 >< 32) (state.clock + (state.c_MCSR state.procID).mtime_delta)),state) | 832w => ((state.c_MCSR state.procID).mscratch,state) | 833w => ((state.c_MCSR state.procID).mepc,state) | 834w => (reg'mcause (state.c_MCSR state.procID).mcause,state) | 835w => ((state.c_MCSR state.procID).mbadaddr,state) | 836w => (reg'mip (state.c_MCSR state.procID).mip,state) | 896w => ((state.c_MCSR state.procID).mbase,state) | 897w => ((state.c_MCSR state.procID).mbound,state) | 898w => ((state.c_MCSR state.procID).mibase,state) | 899w => ((state.c_MCSR state.procID).mibound,state) | 900w => ((state.c_MCSR state.procID).mdbase,state) | 901w => ((state.c_MCSR state.procID).mdbound,state) | 2817w => (state.clock + (state.c_HCSR state.procID).htime_delta,state) | 2945w => (sw2sw ((63 >< 32) (state.clock + (state.c_HCSR state.procID).htime_delta)),state) | 1920w => ((state.c_MCSR state.procID).mtohost,state) | 1921w => ((state.c_MCSR state.procID).mfromhost,state) | 1923w => (0w,state) | v => raise'exception (UNDEFINED (STRCAT "unexpected CSR read at " (word_to_hex_string csr))) state)
csr_dispatch_definition_5=∀value csr. write'CSRMap (value,csr) = (λstate. case csr of 1w => (let s = (let v = state.c_UCSR state.procID; x1 = v.fpcsr in state with c_UCSR := state.c_UCSR⦇state.procID ↦ v with fpcsr := write'reg'FPCSR (x1,bit_field_insert 4 0 ((4 >< 0) value) (reg'FPCSR x1))⦈); s = (let v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mstatus := v.mstatus with MFS := ext_status Dirty⦈); v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mstatus := v.mstatus with MSD := T⦈) | 2w => (let s = (let v = state.c_UCSR state.procID in state with c_UCSR := state.c_UCSR⦇state.procID ↦ v with fpcsr := v.fpcsr with FRM := (2 >< 0) value⦈); s = (let v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mstatus := v.mstatus with MFS := ext_status Dirty⦈); v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mstatus := v.mstatus with MSD := T⦈) | 3w => (let s = (let v = state.c_UCSR state.procID in state with c_UCSR := state.c_UCSR⦇state.procID ↦ v with fpcsr := write'reg'FPCSR (v.fpcsr,(31 >< 0) value)⦈); s = (let v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mstatus := v.mstatus with MFS := ext_status Dirty⦈); v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mstatus := v.mstatus with MSD := T⦈) | 256w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mstatus := lower_sstatus_mstatus (rec'sstatus value,(state.c_MCSR state.procID).mstatus)⦈ | 257w => state with c_SCSR := state.c_SCSR⦇state.procID ↦ state.c_SCSR state.procID with stvec := value⦈ | 260w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mie := lower_sie_mie (rec'sie value,(state.c_MCSR state.procID).mie)⦈ | 289w => (let s = state with c_SCSR := state.c_SCSR⦇state.procID ↦ state.c_SCSR state.procID with stimecmp := value⦈; v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mip := v.mip with STIP := F⦈) | 320w => state with c_SCSR := state.c_SCSR⦇state.procID ↦ state.c_SCSR state.procID with sscratch := value⦈ | 321w => state with c_SCSR := state.c_SCSR⦇state.procID ↦ state.c_SCSR state.procID with sepc := value && sw2sw 4w⦈ | 324w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mip := lower_sip_mip (rec'sip value,(state.c_MCSR state.procID).mip)⦈ | 384w => state with c_SCSR := state.c_SCSR⦇state.procID ↦ state.c_SCSR state.procID with sptbr := value⦈ | 385w => state with c_SCSR := state.c_SCSR⦇state.procID ↦ state.c_SCSR state.procID with sasid := value⦈ | 2304w => state with c_UCSR := state.c_UCSR⦇state.procID ↦ state.c_UCSR state.procID with cycle_delta := value − state.c_cycles state.procID⦈ | 2305w => state with c_UCSR := state.c_UCSR⦇state.procID ↦ state.c_UCSR state.procID with time_delta := value − state.clock⦈ | 2306w => state with c_UCSR := state.c_UCSR⦇state.procID ↦ state.c_UCSR state.procID with instret_delta := value − state.c_instret state.procID⦈ | 2432w => (let v = state.c_UCSR state.procID in state with c_UCSR := state.c_UCSR⦇state.procID ↦ v with cycle_delta := bit_field_insert 63 32 (((31 >< 0) value − (63 >< 32) (state.c_cycles state.procID)) ≪ 32) v.cycle_delta⦈) | 2433w => (let v = state.c_UCSR state.procID in state with c_UCSR := state.c_UCSR⦇state.procID ↦ v with time_delta := bit_field_insert 63 32 (((31 >< 0) value − (63 >< 32) state.clock) ≪ 32) v.time_delta⦈) | 2434w => (let v = state.c_UCSR state.procID in state with c_UCSR := state.c_UCSR⦇state.procID ↦ v with instret_delta := bit_field_insert 63 32 (((31 >< 0) value − (63 >< 32) (state.c_instret state.procID)) ≪ 32) v.instret_delta⦈) | 768w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mstatus := update_mstatus ((state.c_MCSR state.procID).mstatus,rec'mstatus value)⦈ | 769w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mtvec := value⦈ | 770w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mtdeleg := rec'mtdeleg value⦈ | 772w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mie := rec'mie value⦈ | 801w => (let s = state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mtimecmp := value⦈; v = s.c_MCSR s.procID in s with c_MCSR := s.c_MCSR⦇s.procID ↦ v with mip := v.mip with MTIP := F⦈) | 1793w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mtime_delta := value − state.clock⦈ | 1857w => (let v = state.c_MCSR state.procID in state with c_MCSR := state.c_MCSR⦇state.procID ↦ v with mtime_delta := bit_field_insert 63 32 (((31 >< 0) value − (63 >< 32) state.clock) ≪ 32) v.mtime_delta⦈) | 832w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mscratch := value⦈ | 833w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mepc := value && sw2sw 4w⦈ | 834w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mcause := rec'mcause value⦈ | 835w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mbadaddr := value⦈ | 836w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mip := rec'mip value⦈ | 896w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mbase := value⦈ | 897w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mbound := value⦈ | 898w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mibase := value⦈ | 899w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mibound := value⦈ | 900w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mdbase := value⦈ | 901w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mdbound := value⦈ | 2817w => state with c_HCSR := state.c_HCSR⦇state.procID ↦ state.c_HCSR state.procID with htime_delta := value − state.clock⦈ | 2945w => (let v = state.c_HCSR state.procID in state with c_HCSR := state.c_HCSR⦇state.procID ↦ v with htime_delta := bit_field_insert 63 32 (((31 >< 0) value − (63 >< 32) state.clock) ≪ 32) v.htime_delta⦈) | 1920w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mtohost := value⦈ | 1921w => state with c_MCSR := state.c_MCSR⦇state.procID ↦ state.c_MCSR state.procID with mfromhost := value⦈ | 1923w => sendIPI value state | v1 => SND (raise'exception (INTERNAL_ERROR (STRCAT "unexpected CSR write to " (word_to_hex_string csr))) state))
csr_dispatch_definition_6=∀n. CSR n = (λstate. CSRMap n state)
csr_dispatch_definition_7=∀value n. write'CSR (value,n) = (λstate. write'CSRMap (value,n) state)
csr_dispatch_definition_8=∀csr val. writeCSR (csr,val) = (λstate. (let (v,s) = (let s = write'CSR (val,csr) state in (Delta s,s)); (v,s) = (let s0 = write'Delta (v with addr := SOME (w2w csr)) s in (Delta s0,s0)); (v0,s) = CSR csr s in write'Delta (v with data2 := SOME v0) s))
csr_dispatch_definition_9=∀core. sendIPI core = (λstate. (let id = w2w core in if w2n id < state.totalCore then (let v = state.c_MCSR id in state with c_MCSR := state.c_MCSR⦇id ↦ v with mip := v.mip with MSIP := T⦈) else state))
