scw_definition=∀aq rl rd rs1 rs2. dfn'SC_W (aq,rl,rd,rs1,rs2) = (λstate. (let v = GPR rs1 state in if (1 >< 0) v ≠ 0w then signalAddressException (AMO_Misaligned,v) state else if ¬matchLoadReservation v state then write'GPR (1w,rd) state else (let (v0,s) = translateAddr (v,Data,Read) state in case v0 of NONE => signalAddressException (Store_AMO_Fault,v) s | SOME pAddr => write'ReserveLoad NONE (write'GPR (0w,rd) (rawWriteData (pAddr,GPR rs2 s,4) s)))))
scw_type=:word1 # word1 # word5 # word5 # word5 -> riscv_state -> riscv_state
