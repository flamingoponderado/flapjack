attach_bitmaps_SOME_typed=attach_bitmaps (names :mlstring sptree$num_map) (c :config) (bm :β) (v :(α # lab_to_target$config) option) = SOME (r :α # β # config) ⇒ ∃(bytes :α) (c' :lab_to_target$config). v = SOME (bytes,c') ∧ r = (bytes,bm,c with <|lab_conf := c'; symbols := MAP (λ((n :num),(p :num),(l :num)). (lookup_any n names «NOTFOUND»,p,l)) c'.sec_pos_len|>)
from_lab_conf_EX_typed=from_lab (asm_conf :β asm_config) (c :config) (names :mlstring sptree$num_map) (p :β sec list) (bm :α) = SOME ((bytes :word8 list),(bitmap :α),(c' :config)) ⇒ ∃(lc :lab_to_target$config). c' = c with <|lab_conf := lc; symbols := MAP (λ((n :num),(p :num),(l :num)). (lookup_any n names «NOTFOUND»,p,l)) lc.sec_pos_len|>
from_stack_conf_EX_typed=from_stack (asm_conf :β asm_config) (c :config) (names :mlstring sptree$num_map) (p :(num # β prog) list) (bm :α) = (v :(word8 list # α # config) option) ⇒ ∃(p :β sec list). from_lab asm_conf c names p bm = v
