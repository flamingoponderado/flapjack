attach_bitmaps_SOME_typed=attach_bitmaps (names :mlstring sptree$num_map) (c :config) (bm :β) (v :(α # lab_to_target$config) option) = SOME (r :α # β # config) ⇒ ∃(bytes :α) (c' :lab_to_target$config). v = SOME (bytes,c') ∧ r = (bytes,bm,c with <|lab_conf := c'; symbols := MAP (λ((n :num),(p :num),(l :num)). (lookup_any n names «NOTFOUND»,p,l)) c'.sec_pos_len|>)
from_lab_conf_EX_typed=from_lab (asm_conf :β asm_config) (c :config) (names :mlstring sptree$num_map) (p :β sec list) (bm :α) = SOME ((bytes :word8 list),(bitmap :α),(c' :config)) ⇒ ∃(lc :lab_to_target$config). c' = c with <|lab_conf := lc; symbols := MAP (λ((n :num),(p :num),(l :num)). (lookup_any n names «NOTFOUND»,p,l)) lc.sec_pos_len|>
from_stack_conf_EX_typed=from_stack (asm_conf :β asm_config) (c :config) (names :mlstring sptree$num_map) (p :(num # β prog) list) (bm :α) = (v :(word8 list # α # config) option) ⇒ ∃(p :β sec list). from_lab asm_conf c names p bm = v
from_word_conf_EX_typed=from_word (asm_conf :α asm_config) (c :config) (names :mlstring sptree$num_map) (p :(num # num # α wordLang$prog) list) = (v :(word8 list # α word list # config) option) ⇒ ∃(wc :word_to_stack$config) (p :(num # α prog) list) (bm :α word list). from_stack asm_conf (c with word_conf := wc) names p bm = v
decide_inline_reset_spt_typed=(decide_inline ((kc :clos_known$config) with val_approx_spt updated_by (f :val_approx sptree$num_map -> val_approx sptree$num_map)) :val_approx -> α option -> num -> inliningDecision) = (decide_inline kc :val_approx -> α option -> num -> inliningDecision)
oracle_monotonic_rel_mono_typed=∀(R :α -> α -> bool) (R' :α -> α -> bool). (∀(x :α) (y :α). R x y ⇒ R' x y) ∧ oracle_monotonic (f :β -> α -> bool) R (init_s :α -> bool) (orac :num -> β) ⇒ oracle_monotonic f R' init_s orac
syntax_oracle_ok_start_typed=syntax_oracle_ok (c :clos_to_bvl$config) ((c' :clos_to_bvl$config) with start updated_by (f :num -> num)) (es :closLang$exp list) (co :num -> (num # val_approx sptree$num_map # sptree$num_set # α) # closLang$exp list # (num # num # closLang$exp) list) ⇔ syntax_oracle_ok c c' es co
