do_test_typed=(∀(ty :prim_type) (v1 :v) (v2 :v). do_test Equal ty v1 v2 = if check_type ty v1 ∧ check_type ty v2 then if ty = Float64T then Eq_val (fp64_equal (the_Litv_Float64 v1) (the_Litv_Float64 v2)) else do_eq v1 v2 else Eq_type_error) ∧ (∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (Compare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (v3,(NONE :lit option),v8) => Eq_type_error | (v3,SOME v10,(NONE :lit option)) => Eq_type_error | (BoolT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (IntT,SOME (IntLit i),SOME (IntLit j)) => Eq_val (int_cmp cmp i j) | (CharT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (StrT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (WordT v38,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (Float64T,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Char v32),SOME (IntLit j)) => Eq_type_error | (v3,SOME (StrLit v33),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word8 v34),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word64 v35),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Float64 v36),SOME (IntLit j)) => Eq_type_error | (v3,SOME (IntLit v45),SOME (Char d)) => Eq_type_error | (BoolT,SOME (Char c),SOME (Char d)) => Eq_type_error | (IntT,SOME (Char c),SOME (Char d)) => Eq_type_error | (CharT,SOME (Char c),SOME (Char d)) => Eq_val (num_cmp cmp (ORD c) (ORD d) :bool) | (StrT,SOME (Char c),SOME (Char d)) => Eq_type_error | (WordT v52,SOME (Char c),SOME (Char d)) => Eq_type_error | (Float64T,SOME (Char c),SOME (Char d)) => Eq_type_error | (v3,SOME (StrLit v47),SOME (Char d)) => Eq_type_error | (v3,SOME (Word8 v48),SOME (Char d)) => Eq_type_error | (v3,SOME (Word64 v49),SOME (Char d)) => Eq_type_error | (v3,SOME (Float64 v50),SOME (Char d)) => Eq_type_error | (v3,SOME (IntLit v59),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Char v60),SOME (StrLit t)) => Eq_type_error | (BoolT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (IntT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (CharT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (StrLit t)) => Eq_val (str_cmp F cmp s t) | (WordT v66,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (Float64T,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Word8 v62),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Word64 v63),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Float64 v64),SOME (StrLit t)) => Eq_type_error | (v3,SOME (IntLit v73),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Char v74),SOME (Word8 v)) => Eq_type_error | (v3,SOME (StrLit v75),SOME (Word8 v)) => Eq_type_error | (BoolT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (IntT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (CharT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (StrT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (WordT W8,SOME (Word8 w),SOME (Word8 v)) => Eq_val (num_cmp cmp (w2n w) (w2n v) :bool) | (WordT W64,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (Float64T,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Word64 v77),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Float64 v78),SOME (Word8 v)) => Eq_type_error | (v3,SOME v10,SOME (Word64 v23)) => Eq_type_error | (v3,SOME (IntLit v87),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Char v88),SOME (Float64 v')) => Eq_type_error | (v3,SOME (StrLit v89),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Word8 v90),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Word64 v91),SOME (Float64 v')) => Eq_type_error | (BoolT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (IntT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (CharT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (StrT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (WordT v94,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (Float64T,SOME (Float64 w'),SOME (Float64 v')) => Eq_val (fp_cmp cmp w' v')) ∧ ∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (AltCompare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (BoolT,v3) => Eq_type_error | (IntT,v3) => Eq_type_error | (CharT,v3) => Eq_type_error | (StrT,(NONE :lit option),v9) => Eq_type_error | (StrT,SOME (IntLit v18),v9) => Eq_type_error | (StrT,SOME (Char v19),v9) => Eq_type_error | (StrT,SOME (StrLit s),(NONE :lit option)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (IntLit v32)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Char v33)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (StrLit t)) => Eq_val (str_cmp T cmp s t) | (StrT,SOME (StrLit s),SOME (Word8 v35)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Word64 v36)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Float64 v37)) => Eq_type_error | (StrT,SOME (Word8 v21),v9) => Eq_type_error | (StrT,SOME (Word64 v22),v9) => Eq_type_error | (StrT,SOME (Float64 v23),v9) => Eq_type_error | (WordT v5,v3) => Eq_type_error | (Float64T,v3) => Eq_type_error
