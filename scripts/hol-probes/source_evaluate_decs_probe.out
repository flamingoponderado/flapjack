evaluate_decs_cons=∀(s :'ffi state) (env :v sem_env) (d :dec) (ds :dec list). evaluate_decs s env (d::ds) = case evaluate_decs s env [d] of (s1,(Rval env1 :(v sem_env, v) result)) => (case evaluate_decs s1 ((env1 +++ env) :v sem_env) ds of (s2,r) => (s2,combine_dec_result env1 r)) | (s1,(Rerr v7 :(v sem_env, v) result)) => (s1,(Rerr v7 :(v sem_env, v) result))
evaluate_decs_append=∀(ds1 :dec list) (s :α state) (env :v sem_env) (ds2 :dec list). evaluate_decs s env (ds1 ++ ds2) = case evaluate_decs s env ds1 of (s1,(Rval env1 :(v sem_env, v) result)) => (case evaluate_decs s1 ((env1 +++ env) :v sem_env) ds2 of (s2,r) => (s2,combine_dec_result env1 r)) | (s1,(Rerr v7 :(v sem_env, v) result)) => (s1,(Rerr v7 :(v sem_env, v) result))
