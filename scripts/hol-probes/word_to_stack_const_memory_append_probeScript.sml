val const_addresses_append = prove(``∀xs ys dm a.
    const_addresses a (xs ++ ys) dm ⇔
    const_addresses a xs dm ∧
    const_addresses (a + bytes_in_word * n2w (LENGTH xs)) ys dm``,   Induct \\ fs [const_addresses_def]
  \\ fs [ADD1] \\ gvs [GSYM word_add_n2w,WORD_LEFT_ADD_DISTRIB]
  \\ rw [] \\ eq_tac \\ rw []);
val _ = (if null(hyp const_addresses_append) then () else raise Fail "open premise"; print "cm_full_const_addresses_append="; print_thm const_addresses_append; print "\n");
