compile_inc_no_mutcons_typed=(compile_inc (n :num) (prog :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list) = ((n1 :num),(prog1 :(num # num # bvi$exp) list)) ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog1
bvi_tailrec_compile_prog_no_mutcons_typed=∀(b :bool) (next :num) (prog :(num # num # bvi$exp) list) (next1 :num) (prog1 :(num # num # bvi$exp) list). (compile_prog b next prog :num # (num # num # bvi$exp) list) = (next1,prog1) ∧ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog1
bvi_let_delete_var_no_mutcons_typed=∀(x :bvi$exp). no_mutcons x ⇒ no_mutcons (delete_var x)
bvi_let_compile_no_mutcons_typed=(∀(env :num list) (d :num) (e :bvi$exp). no_mutcons e ⇒ no_mutcons (compile_sing env d e :bvi$exp)) ∧ ∀(env :num list) (d :num) (es :bvi$exp list). EVERY no_mutcons es ⇒ EVERY no_mutcons (compile_list env d es :bvi$exp list)
bvi_let_compile_exp_no_mutcons_typed=∀(x :bvi$exp). no_mutcons x ⇒ no_mutcons (compile_exp x :bvi$exp)
compile_int_no_mutcons_typed=∀(i :int). no_mutcons (compile_int i)
compile_op_no_mutcons_typed=∀(op :closLang$op) (c1 :bvi$exp list). EVERY no_mutcons c1 ⇒ no_mutcons (compile_op op c1 :bvi$exp)
compile_exps_sing_no_mutcons_typed=(∀(n :num) (e :bvl$exp) (c :bvi$exp) (aux :(num # num # bvi$exp) app_list) (n1 :num). compile_exps_sing n e = (c,aux,n1) ⇒ no_mutcons c ∧ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) (append aux)) ∧ ∀(n :num) (es :bvl$exp list) (c :bvi$exp list) (aux :(num # num # bvi$exp) app_list) (n1 :num). compile_exps_list n es = (c,aux,n1) ⇒ EVERY no_mutcons c ∧ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) (append aux)
compile_single_no_mutcons_typed=∀(n :num) (p :num # num # bvl$exp) (q :(num # num # bvi$exp) app_list) (n1 :num). compile_single n p = (q,n1) ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) (append q)
compile_list_no_mutcons_typed=∀(n :num) (progs :(num # num # bvl$exp) list) (q :(num # num # bvi$exp) app_list) (n1 :num). (compile_list n progs :(num # num # bvi$exp) app_list # num) = (q,n1) ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) (append q)
stubs_no_mutcons_typed=∀(start :num) (n :num). EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) (stubs start n)
to_op_no_mutcons_typed=∀(op :assoc_op). no_mutcons_op (to_op op)
apply_op_no_mutcons_typed=∀(op :assoc_op) (e1 :bvi$exp) (e2 :bvi$exp). no_mutcons (apply_op op e1 e2) ⇔ no_mutcons e1 ∧ no_mutcons e2
id_from_op_no_mutcons_typed=∀(op :assoc_op). no_mutcons (id_from_op op)
let_wrap_no_mutcons_typed=∀(arity :num) (id :bvi$exp) (x :bvi$exp). no_mutcons (let_wrap arity id x) ⇔ no_mutcons id ∧ no_mutcons x
get_bin_args_no_mutcons_typed=∀(exp :bvi$exp) (e1 :bvi$exp) (e2 :bvi$exp). get_bin_args exp = SOME (e1,e2) ∧ no_mutcons exp ⇒ no_mutcons e1 ∧ no_mutcons e2
opbinargs_no_mutcons_typed=∀(opr :assoc_op) (exp :bvi$exp) (e1 :bvi$exp) (e2 :bvi$exp). opbinargs opr exp = SOME (e1,e2) ∧ no_mutcons exp ⇒ no_mutcons e1 ∧ no_mutcons e2
try_swap_no_mutcons_typed=∀(loc :num) (opr :assoc_op) (exp :bvi$exp). no_mutcons exp ⇒ no_mutcons (try_swap loc opr exp)
check_op_no_mutcons_typed=∀(ts :v_ty list) (opr :assoc_op) (loc :num) (exp :bvi$exp) (exp2 :bvi$exp). check_op ts opr loc exp = SOME exp2 ∧ no_mutcons exp ⇒ no_mutcons exp2
args_from_no_mutcons_typed=∀(f :bvi$exp) (t :num) (d :num) (args :bvi$exp list) (hdl :bvi$exp option). args_from f = SOME (t,d,args,hdl) ∧ no_mutcons f ⇒ EVERY no_mutcons args ∧ case hdl of (NONE :bvi$exp option) => T | SOME h => no_mutcons h
push_call_no_mutcons_typed=∀(n :num) (op :assoc_op) (acc :num) (x :bvi$exp) (f :bvi$exp). no_mutcons x ∧ no_mutcons f ⇒ no_mutcons (push_call n op acc x (args_from f))
rewrite_catchall_no_mutcons_typed=∀(ts :v_ty list) (opr :assoc_op) (loc :num) (exp :bvi$exp) (next :num) (acc :num) (r :bool) (y :bvi$exp). (case check_op ts opr loc exp of (NONE :bvi$exp option) => (F,apply_op opr (Var acc :bvi$exp) exp) | SOME v1 => case opbinargs opr v1 of (NONE :(bvi$exp # bvi$exp) option) => (F,apply_op opr (Var acc :bvi$exp) v1) | SOME (xs,f) => (T,push_call next opr acc xs (args_from f))) = (r,y) ∧ no_mutcons exp ⇒ no_mutcons y
rewrite_no_mutcons_typed=∀(loc :num) (next :num) (opr :assoc_op) (acc :num) (ts :v_ty list) (exp :bvi$exp) (r :bool) (y :bvi$exp). rewrite loc next opr acc ts exp = (r,y) ∧ no_mutcons exp ⇒ no_mutcons y
tailrec_compile_exp_no_mutcons_typed=∀(loc :num) (next :num) (arity :num) (exp :bvi$exp) (aux :bvi$exp) (opt :bvi$exp). (compile_exp loc next arity exp :(bvi$exp # bvi$exp) option) = SOME (aux,opt) ∧ no_mutcons exp ⇒ no_mutcons aux ∧ no_mutcons opt
bvi_tailrec_compile_each_no_mutcons_typed=∀(next :num) (prog :(num # num # bvi$exp) list) (next1 :num) (prog1 :(num # num # bvi$exp) list). compile_each next prog = (next1,prog1) ∧ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog ⇒ EVERY (no_mutcons ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) prog1
compile_get_code_labels_typed=∀(start :num) (c :bvl_to_bvi$config) (names :mlstring sptree$num_map) (prog :(num # num # bvl$exp) list) (loc :num) (code :(num # num # bvi$exp) list) (inlines :(num # bvl$exp) sptree$num_map) (bvi_inlines :(num # bvi$exp) sptree$num_map) (n1 :num) (n2 :num) (n3 :num) (names' :mlstring sptree$num_map). (compile start c names prog :num # (num # num # bvi$exp) list # (num # bvl$exp) sptree$num_map # (num # bvi$exp) sptree$num_map # num # num # num # mlstring sptree$num_map) = (loc,code,inlines,bvi_inlines,n1,n2,n3,names') ⇒ BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvi$exp -> bvi$exp) ∘ (SND :num # num # bvi$exp -> num # bvi$exp)) code)) ⊆ bvl_num_stubs + start * bvl_to_bvi_namespaces INSERT set (MAP (FST :num # num # bvi$exp -> num) code) ∪ IMAGE (λ(k :num). bvl_num_stubs + k * bvl_to_bvi_namespaces) (BIGUNION (set (MAP (get_code_labels ∘ (SND :num # bvl$exp -> bvl$exp) ∘ (SND :num # num # bvl$exp -> num # bvl$exp)) prog))) ∪ {bvl_num_stubs + (2 :num) + k * bvl_to_bvi_namespaces | bvl_num_stubs + (2 :num) + k * bvl_to_bvi_namespaces < n2} ∪ {bvl_num_stubs + (3 :num) + k * bvl_to_bvi_namespaces | bvl_num_stubs + (3 :num) + k * bvl_to_bvi_namespaces < n3}
compile_distinct_names_typed=(compile (n0 :num) (c :bvl_to_bvi$config) (ns :mlstring sptree$num_map) (p2 :(num # num # bvl$exp) list) :num # (num # num # bvi$exp) list # (num # bvl$exp) sptree$num_map # (num # bvi$exp) sptree$num_map # num # num # num # mlstring sptree$num_map) = ((k :num),(p3 :(num # num # bvi$exp) list),(l :(num # bvl$exp) sptree$num_map),(bl :(num # bvi$exp) sptree$num_map),(n1 :num),(n2 :num),(ns' :num # mlstring sptree$num_map)) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) p2) ∧ c.next_name2 = bvl_num_stubs + (2 :num) + (n02 :num) * bvl_to_bvi_namespaces ⇒ EVERY (λ(n :num). data_num_stubs ≤ n) (MAP (FST :num # num # bvi$exp -> num) p3) ∧ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) p3)
full_co_def_typed=∀(c :bvl_to_bvi$config) (co :α -> ((num # bvl$exp) sptree$num_map # num # num # num # (num # bvi$exp) sptree$num_map # β) # (num # num # bvl$exp) list). full_co c co = (let (limit :num) = c.inline_size_limit; (split :bool) = c.split_main_at_seq; (cut :num) = c.exp_cut in state_co compile_inc (state_co (compile_prog c.do_tmc :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (state_co (compile_prog c.do_tailrec :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (state_co compile_inc (state_co (compile_inc limit split cut :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) co)))))
full_cc_def_typed=∀(c :bvl_to_bvi$config) (cc :α -> (num # num # bvi$exp) list -> (β # γ # δ) option). full_cc c cc = (let (limit :num) = c.inline_size_limit; (split :bool) = c.split_main_at_seq; (cut :num) = c.exp_cut in state_cc (compile_inc limit split cut :(num # bvl$exp) sptree$num_map -> (num # num # bvl$exp) list -> (num # bvl$exp) sptree$num_map # (num # num # bvl$exp) list) (state_cc compile_inc (state_cc (compile_prog c.do_tailrec :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (state_cc (compile_prog c.do_tmc :num -> (num # num # bvi$exp) list -> num # (num # num # bvi$exp) list) (state_cc compile_inc cc)))))
ALL_DISTINCT_MAP_FST_SND_full_co_typed=ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) (SND ((co :β -> ((num # bvl$exp) sptree$num_map # num # num # num # (num # bvi$exp) sptree$num_map # α) # (num # num # bvl$exp) list) (n :β)))) ∧ FST (SND (SND (FST (co n)))) MOD bvl_to_bvi_namespaces = (2 :num) ∧ FST (SND (SND (SND (FST (co n))))) MOD bvl_to_bvi_namespaces = (3 :num) ⇒ ALL_DISTINCT (MAP (FST :num # num # bvi$exp -> num) (SND (full_co (c :bvl_to_bvi$config) co n)))
