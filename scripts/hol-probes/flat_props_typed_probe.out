pmatch_extend_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (env' :(mlstring # v) list) (env'' :α). (pmatch s p v env :(mlstring # v) list match_result) = Match env' ⇒ ∃(env'' :(mlstring # v) list). env' = env'' ++ env ∧ MAP (FST :mlstring # v -> mlstring) env'' = pat_bindings p) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (env' :(mlstring # v) list) (env'' :β). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env' ⇒ ∃(env'' :(mlstring # v) list). env' = env'' ++ env ∧ MAP (FST :mlstring # v -> mlstring) env'' = pats_bindings ps
pmatch_append_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (pred_env :α). map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) (tail_env :(mlstring # v) list)) (pmatch s p v env :(mlstring # v) list match_result) = (pmatch s p v (env ++ tail_env) :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (n :β). map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) tail_env) (pmatch_list s ps vs env :(mlstring # v) list match_result) = (pmatch_list s ps vs (env ++ tail_env) :(mlstring # v) list match_result)
pmatch_any_match_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (env' :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = Match env' ⇒ ∀(env :(mlstring # v) list). ∃(env' :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = Match env') ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (env' :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env' ⇒ ∀(env :(mlstring # v) list). ∃(env' :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env'
pmatch_any_no_match_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (No_match :(mlstring # v) list match_result)
pmatch_any_match_error_typed=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result) ⇒ ∀(env :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)
pmatch_list_pairwise_typed=∀(ps :pat list) (vs :v list) (s :(γ, 'ffi) state) (env :(mlstring # v) list) (env' :(mlstring # v) list). (pmatch_list s ps vs env :(mlstring # v) list match_result) = Match env' ⇒ LIST_REL (λ(p :pat) (v :v). ∀(env :(mlstring # v) list). ∃(env' :(mlstring # v) list). (pmatch s p v env :(mlstring # v) list match_result) = Match env') ps vs
pmatch_list_snoc_nil_typed=∀(p :pat) (ps :pat list) (v :v) (vs :v list) (s :(γ, 'ffi) state) (env :(mlstring # v) list). (pmatch_list s ([] :pat list) (SNOC v vs) env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result) ∧ (pmatch_list s (SNOC p ps) ([] :v list) env :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)
pmatch_list_append_typed=∀(ps :pat list) (vs :v list) (ps' :pat list) (vs' :v list) (s :(α, β) state) (env :(mlstring # v) list). LENGTH ps = LENGTH vs ⇒ (pmatch_list s (ps ++ ps') (vs ++ vs') env :(mlstring # v) list match_result) = case (pmatch_list s ps vs env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (case (pmatch_list s ps' vs' env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match env' => (pmatch_list s ps' vs' env' :(mlstring # v) list match_result)
pmatch_list_snoc_typed=∀(ps :pat list) (vs :v list) (p :pat) (v :v) (s :(γ, 'ffi) state) (env :(mlstring # v) list). LENGTH ps = LENGTH vs ⇒ (pmatch_list s (SNOC p ps) (SNOC v vs) env :(mlstring # v) list match_result) = case (pmatch_list s ps vs env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (case (pmatch s p v env :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match env' => (pmatch s p v env' :(mlstring # v) list match_result)
map_match_eq_case_typed=map_match (f :α -> α) (v :α match_result) = case v of (No_match :α match_result) => v | (Match_type_error :α match_result) => v | Match m => Match (f m)
pmatch_nil_typed=(∀(v :v) (tail_env :(mlstring # v) list) (s :(γ, 'ffi) state) (p :pat). (pmatch s p v tail_env :(mlstring # v) list match_result) = map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) tail_env) (pmatch s p v ([] :(mlstring # v) list) :(mlstring # v) list match_result)) ∧ ∀(vs :v list) (tail_env :(mlstring # v) list) (s :(γ, 'ffi) state) (ps :pat list). (pmatch_list s ps vs tail_env :(mlstring # v) list match_result) = map_match (flip ($++ :(mlstring # v) list -> (mlstring # v) list -> (mlstring # v) list) tail_env) (pmatch_list s ps vs ([] :(mlstring # v) list) :(mlstring # v) list match_result)
build_rec_env_merge_typed=∀(funs :(mlstring # mlstring # exp) list) (funs' :α) (env :v environment) (env' :(mlstring # v) list). build_rec_env funs env env' = MAP (λ((fn :mlstring),(n :mlstring),(e :exp)). (fn,(Recclosure env funs fn :v))) funs ++ env'
evaluate_cons_typed=(evaluate (env :v environment) (s :(α, β) state) ((e :exp)::(es :exp list)) :(α, β) state # (v list, v) result) = case (evaluate env s [e] :(α, β) state # (v list, v) result) of (s,(Rval v :(v list, v) result)) => (case (evaluate env s es :(α, β) state # (v list, v) result) of (s,(Rval vs :(v list, v) result)) => (s,(Rval (v ++ vs) :(v list, v) result)) | (s,(Rerr v8 :(v list, v) result)) => (s,(Rerr v8 :(v list, v) result))) | (s,(Rerr v10 :(v list, v) result)) => (s,(Rerr v10 :(v list, v) result))
evaluate_append_typed=(evaluate (env :v environment) (s :(α, β) state) ((l1 :exp list) ++ (l2 :exp list)) :(α, β) state # (v list, v) result) = case (evaluate env s l1 :(α, β) state # (v list, v) result) of (s,(Rval v1 :(v list, v) result)) => (case (evaluate env s l2 :(α, β) state # (v list, v) result) of (s,(Rval v2 :(v list, v) result)) => (s,(Rval (v1 ++ v2) :(v list, v) result)) | (s,(Rerr v9 :(v list, v) result)) => (s,(Rerr v9 :(v list, v) result))) | (s,(Rerr v11 :(v list, v) result)) => (s,(Rerr v11 :(v list, v) result))
with_clock_ffi_typed=((s :(β, α) state) with clock := (k :num)).ffi = s.ffi
evaluate_add_to_clock_typed=(∀(env :v environment) (s :(γ, 'ffi) state) (es :exp list) (s' :(γ, 'ffi) state) (r :(v list, v) result). (evaluate env s es :(γ, 'ffi) state # (v list, v) result) = (s',r) ∧ r ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ (evaluate env (s with clock := s.clock + (extra :num)) es :(γ, 'ffi) state # (v list, v) result) = (s' with clock := s'.clock + extra,r)) ∧ (∀(s :(γ, 'ffi) state) (d :exp) (s' :(γ, 'ffi) state) (r :v error_result option). evaluate_dec s d = (s',r) ∧ r ≠ SOME (Rabort Rtimeout_error :v error_result) ⇒ evaluate_dec (s with clock := s.clock + extra) d = (s' with clock := s'.clock + extra,r)) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list) (s' :(γ, 'ffi) state) (r :v error_result option). (evaluate_decs s ds :(γ, 'ffi) state # v error_result option) = (s',r) ∧ r ≠ SOME (Rabort Rtimeout_error :v error_result) ⇒ (evaluate_decs (s with clock := s.clock + extra) ds :(γ, 'ffi) state # v error_result option) = (s' with clock := s'.clock + extra,r)
evaluate_decs_add_to_clock_typed=∀(decs :exp list) (s :(α, β) state) (s' :(α, β) state) (r :v error_result option). r ≠ SOME (Rabort Rtimeout_error :v error_result) ∧ (evaluate_decs s decs :(α, β) state # v error_result option) = (s',r) ⇒ (evaluate_decs (s with clock := s.clock + (extra :num)) decs :(α, β) state # v error_result option) = (s' with clock := s'.clock + extra,r)
do_app_io_events_mono_typed=do_app (s :(γ, 'ffi) state) (op :op) (vs :v list) = SOME ((t :(γ, 'ffi) state),(r :(v, v) result)) ⇒ s.ffi.io_events ≼ t.ffi.io_events
store_v_vs_def_typed=(∀(vs :α list). store_v_vs (Varray vs) = vs) ∧ (∀(v :α). store_v_vs (Refv v) = [v]) ∧ (∀(m :thunk_mode) (v :α). store_v_vs (Thunk m v) = [v]) ∧ ∀(xs :word8 list). store_v_vs (W8array xs :α store_v) = ([] :α list)
ctor_same_type_OPTREL_typed=∀(c1 :(α # β) option) (c2 :(α # β) option). ctor_same_type c1 c2 ⇔ OPTREL (inv_image ($= :β -> β -> bool) (SND :α # β -> β)) c1 c2
pats_bindings_FLAT_MAP_typed=∀(ps :pat list). pats_bindings ps = FLAT (REVERSE (MAP (λ(p :pat). pat_bindings p) ps))
evaluate_Mat_typed=(evaluate (env :v environment) (s :(α, β) state) [(Mat (tra :tra) (e :exp) (pes :(pat # exp) list) :exp)] :(α, β) state # (v list, v) result) = case (evaluate env s [e] :(α, β) state # (v list, v) result) of (s,(Rval v :(v list, v) result)) => if pmatch_rows pes s (HD v) ≠ (Match_type_error :((mlstring # v) list # pat # exp) match_result) then (evaluate_match env s (HD v) pes bind_exn_v :(α, β) state # (v list, v) result) else (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (s,(Rerr v8 :(v list, v) result)) => (s,(Rerr v8 :(v list, v) result))
evaluate_Handle_typed=(evaluate (env :v environment) (s :(α, β) state) [(Handle (_0 :tra) (e :exp) (pes :(pat # exp) list) :exp)] :(α, β) state # (v list, v) result) = case (evaluate env s [e] :(α, β) state # (v list, v) result) of (s,(Rval v7 :(v list, v) result)) => (s,(Rval v7 :(v list, v) result)) | (s,(Rerr (Rraise v) :(v list, v) result)) => if pmatch_rows pes s v ≠ (Match_type_error :((mlstring # v) list # pat # exp) match_result) then (evaluate_match env s v pes v :(α, β) state # (v list, v) result) else (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (s,(Rerr (Rabort v12 :v error_result) :(v list, v) result)) => (s,(Rerr (Rabort v12 :v error_result) :(v list, v) result))
evaluate_match_NIL_typed=(evaluate_match (env :v environment) (s :(α, β) state) (v :v) ([] :(pat # exp) list) (err_v :v) :(α, β) state # (v list, v) result) = (s,(Rerr (Rraise err_v) :(v list, v) result))
evaluate_match_CONS_typed=(evaluate_match (env :v environment) (s :(α, β) state) (v :v) (((p :pat),(e :exp))::(pes :(pat # exp) list)) (err_v :v) :(α, β) state # (v list, v) result) = case (pmatch s p v ([] :(mlstring # v) list) :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (evaluate_match env s v pes err_v :(α, β) state # (v list, v) result) | (Match_type_error :(mlstring # v) list match_result) => (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | Match env_v' => if ALL_DISTINCT (pat_bindings p) ∧ pmatch_rows pes s v ≠ (Match_type_error :((mlstring # v) list # pat # exp) match_result) then (evaluate (env with v := env_v' ++ env.v) s [e] :(α, β) state # (v list, v) result) else (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))
simple_do_app_thm_typed=simple_val_rel (vr :v -> v -> bool) ∧ simple_state_rel vr (sr :(α, β) state -> (γ, β) state -> bool) ⇒ ∀(s1 :(α, β) state) (vs1 :v list) (t1 :(α, β) state) (r1 :(v, v) result) (s2 :(γ, β) state) (vs2 :v list). do_app s1 (op :op) vs1 = SOME (t1,r1) ⇒ sr s1 s2 ∧ LIST_REL vr vs1 vs2 ⇒ ∃(t2 :(γ, β) state) (r2 :(v, v) result). result_rel vr vr r1 r2 ∧ sr t1 t2 ∧ do_app s2 op vs2 = SOME (t2,r2)
isClosure_simps_typed=¬isClosure (Litv (l :lit) :v) ∧ ¬isClosure (Conv (o' :(num # num option) option) (l :v list)) ∧ isClosure (Closure (e :v environment) (m :mlstring) (e0 :exp) :v) ∧ isClosure (Recclosure e (l :(mlstring # mlstring # exp) list) m :v) ∧ ¬isClosure (Loc (b :bool) (n :num) :v) ∧ ¬isClosure (Vectorv l)
evaluate_decs_add_to_clock_io_events_mono_alt_typed=(evaluate_decs (s :(γ, 'ffi) state) (ds :exp list) :(γ, 'ffi) state # v error_result option) = ((s1 :(γ, 'ffi) state),(res :v error_result option)) ∧ (evaluate_decs (s with clock := s.clock + (extra :num)) ds :(γ, 'ffi) state # v error_result option) = ((s2 :(γ, 'ffi) state),(res2 :v error_result option)) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
elist_globals_FOLDR_typed=elist_globals (es :exp list) = FOLDR ($⊎ :(num -> num) -> (num -> num) -> num -> num) ({||} :num -> num) (MAP set_globals es)
elist_globals_REVERSE_typed=elist_globals (REVERSE (es :exp list)) = elist_globals es
initial_state_clock_typed=(initial_state (ffi :β ffi_state) (k :num) (ec :α install_config)).clock = k ∧ initial_state ffi k ec with clock := (k1 :num) = initial_state ffi k1 ec
IMP_semantics_eq_typed=eval_sim (ffi :'ffi ffi_state) (ds1 :exp list) (ds2 :exp list) (ec :α install_config) (ec2 :β install_config) (rel :exp list -> exp list -> bool) F ∧ semantics ec ffi ds1 ≠ Fail ⇒ rel ds1 ds2 ⇒ semantics ec ffi ds1 = semantics ec2 ffi ds2
pmatch_list_MAP_Pvar_typed=∀(xs :mlstring list) (vs :v list). LENGTH xs = LENGTH vs ⇒ (pmatch_list (s :(α, β) state) (MAP Pvar xs) vs ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match (REVERSE (ZIP (xs,vs)))
evaluate_MAP_Var_local_typed=MAP (ALOOKUP (env :v environment).v) (xs :mlstring list) = MAP (SOME :v -> v option) (vs :v list) ⇒ (evaluate env (s :(α, β) state) (MAP (Var_local (t :tra)) xs) :(α, β) state # (v list, v) result) = (s,(Rval vs :(v list, v) result))
bind_locals_list_def_typed=∀(ts :tra list) (ks :mlstring list). bind_locals_list ts ks = (MAP2 (λ(t :tra) (x :mlstring). Var_local t x) ts ks :exp list)
evaluate_vars_typed=∀(env :v environment) (s :(α, β) state) (kvs :(mlstring # v) list) (env' :(mlstring # v) list) (ks :mlstring list) (vs :v list) (ts :tra list). ALL_DISTINCT (MAP (FST :mlstring # v -> mlstring) kvs) ∧ DISJOINT (set (MAP (FST :mlstring # v -> mlstring) kvs)) (set (MAP (FST :mlstring # v -> mlstring) env')) ∧ env.v = env' ++ kvs ∧ ks = MAP (FST :mlstring # v -> mlstring) kvs ∧ vs = MAP (SND :mlstring # v -> v) kvs ∧ LENGTH ts = LENGTH ks ⇒ (evaluate env s (bind_locals_list ts ks) :(α, β) state # (v list, v) result) = (s,(Rval vs :(v list, v) result))
evaluate_add_to_clock_io_events_mono_typed=(∀(env :v environment) (s :(γ, 'ffi) state) (es :exp list). (FST (evaluate env s es :(γ, 'ffi) state # (v list, v) result)).ffi.io_events ≼ (FST (evaluate env (s with clock := s.clock + (extra :num)) es :(γ, 'ffi) state # (v list, v) result)).ffi.io_events) ∧ (∀(s :(γ, 'ffi) state) (d :exp). (FST (evaluate_dec s d)).ffi.io_events ≼ (FST (evaluate_dec (s with clock := s.clock + extra) d)).ffi.io_events) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list). (FST (evaluate_decs s ds :(γ, 'ffi) state # v error_result option)).ffi.io_events ≼ (FST (evaluate_decs (s with clock := s.clock + extra) ds :(γ, 'ffi) state # v error_result option)).ffi.io_events
evaluate_dec_add_to_clock_io_events_mono_typed=∀(prog :exp) (s :(γ, 'ffi) state) (extra :num). (FST (evaluate_dec s prog)).ffi.io_events ≼ (FST (evaluate_dec (s with clock := s.clock + extra) prog)).ffi.io_events
evaluate_decs_add_to_clock_io_events_mono_typed=∀(ds :exp list) (s :(γ, 'ffi) state) (extra :num). (FST (evaluate_decs s ds :(γ, 'ffi) state # v error_result option)).ffi.io_events ≼ (FST (evaluate_decs (s with clock := s.clock + extra) ds :(γ, 'ffi) state # v error_result option)).ffi.io_events
evaluate_io_events_mono_typed=(∀(env :v environment) (s :(γ, 'ffi) state) (es :exp list). s.ffi.io_events ≼ (FST (evaluate env s es :(γ, 'ffi) state # (v list, v) result)).ffi.io_events) ∧ (∀(s :(γ, 'ffi) state) (d :exp). s.ffi.io_events ≼ (FST (evaluate_dec s d)).ffi.io_events) ∧ ∀(s :(γ, 'ffi) state) (ds :exp list). s.ffi.io_events ≼ (FST (evaluate_decs s ds :(γ, 'ffi) state # v error_result option)).ffi.io_events
evaluate_io_events_mono_IMP_typed=((evaluate (env :v environment) (s :(α, β) state) (es :exp list) :(α, β) state # (v list, v) result) = ((s' :(α, β) state),(r :(v list, v) result)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events) ∧ (evaluate_dec s (d :exp) = (s',(r' :v error_result option)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events) ∧ ((evaluate_decs s (ds :exp list) :(α, β) state # v error_result option) = (s',(r'' :v error_result option)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events)
evaluate_dec_io_events_mono_typed=∀(z :exp) (y :(α, β) state). y.ffi.io_events ≼ (FST (evaluate_dec y z)).ffi.io_events
evaluate_decs_io_events_mono_typed=∀(ds :exp list) (s :(γ, 'ffi) state) (s' :(γ, 'ffi) state) (y :v error_result option). (evaluate_decs s ds :(γ, 'ffi) state # v error_result option) = (s',y) ⇒ s.ffi.io_events ≼ s'.ffi.io_events
