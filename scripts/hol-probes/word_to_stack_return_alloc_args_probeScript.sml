fun theoremRow label th = (if null (hyp th) then () else raise Fail "open premise"; print(label ^ "="); print_thm th; print "\n");
val stack_move_alloc_arg = prove(``∀n st off i p.
    alloc_arg p ⇒
    alloc_arg (stack_move n st off i p)``,   Induct>>rw[stack_move_def,alloc_arg_def]);
val _ = theoremRow "raa_full_stack_move_alloc_arg" stack_move_alloc_arg;
val alloc_arg_copy_ret_aux = prove(``∀k f n.
  alloc_arg (copy_ret_aux k f n)``,   ho_match_mp_tac copy_ret_aux_ind>>
  rw[]>>simp[Once copy_ret_aux_def]>>rw[]>>
  simp[alloc_arg_def,stackLangTheory.list_Seq_def]);
val _ = theoremRow "raa_full_alloc_arg_copy_ret_aux" alloc_arg_copy_ret_aux;
val alloc_arg_copy_ret = prove(``(alloc_arg (copy_ret perf b kf vs kont) ⇔ alloc_arg kont)``,   PairCases_on`kf`>>rw[copy_ret_def]>>
  simp[alloc_arg_def,SeqStackFree_def,alloc_arg_copy_ret_aux]);
val _ = theoremRow "raa_full_alloc_arg_copy_ret" alloc_arg_copy_ret;
