bytes_in_mem_IMP=∀(xs :word8 list) (p :α word).
  bytes_in_mem p xs (m :α word -> word8) (dm :α word -> bool)
    (dm1 :α word -> bool) ⇒
  bytes_in_memory p xs m dm
