constant_program_skip=Skip
constant_program_assign=Seq (Assign 2 (Const 7w)) (Assign 3 (Const 7w))
constant_program_selected=Seq (Assign 1 (Const 0w)) (Assign 2 (Const 7w))
constant_program_unknown=If Equal 1 (Imm 0w) (Assign 2 (Const 7w)) Tick
constant_program_tail=Seq (Seq (Assign 2 (Const 9w)) (Assign 1 (Const 7w))) (Call NONE (SOME 7) [1; 2] (SOME (1,Assign 3 (Var 1),5,6)))
constant_program_return=Seq (Assign 1 (Const 7w)) (Call (SOME ([],(LN,LN),Seq (Assign 3 (Var 1)) Tick,3,4)) (SOME 7) [1] NONE)
constant_program_both=Seq (Assign 1 (Const 7w)) (Call (SOME ([],(LN,LN),Assign 3 (Var 1),3,4)) (SOME 7) [1] (SOME (1,Assign 4 (Var 2),5,6)))
constant_program_alloc=Seq (Assign 1 (Const 7w)) (Alloc 1 (LN,LN))
constant_program_install=Seq (Seq (Assign 2 (Const 9w)) (Assign 1 (Const 7w))) (Install 1 2 3 4 (LN,LN))
constant_program_ffi=Seq (Seq (Assign 2 (Const 9w)) (Assign 1 (Const 7w))) (FFI «echo» 1 2 3 4 (LN,LN))
constant_program_loop=Loop LN (Assign 3 (Var 1)) LN
constant_program_must=MustTerminate (Assign 3 (Const 7w))
constant_program_trailing_skip=Tick
