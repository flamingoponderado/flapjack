na_full_set_var_swap=⊢ a ≠ a' ⇒ set_var a b (set_var a' b' c) = set_var a' b' (set_var a b c)
na_full_set_var_swap_word=⊢ a ≠ a' ⇒ set_var a b (set_var a' b' c) = set_var a' b' (set_var a b c)
na_full_set_var_cancel=⊢ set_var a b (set_var a b' t) = set_var a b t
na_full_set_var_cancel_word=⊢ set_var a b (set_var a b' s) = set_var a b s
na_full_get_var_set_var=⊢ get_var k (set_var k v st) = SOME v
na_full_state_with_const=⊢ t with clock := t.clock = t
na_full_set_store_set_var=⊢ set_store a b (set_var c d e) = set_var c d (set_store a b e)
na_full_IS_SOME_get_vars_set_var=⊢ ∀ls s. IS_SOME (get_vars ls s) ⇒ IS_SOME (get_vars ls (set_var k v s))
na_full_IS_SOME_get_vars_EVERY=⊢ ∀xs s. IS_SOME (get_vars xs s) ⇔ EVERY (λx. IS_SOME (get_var x s)) xs
na_full_get_vars_eq=⊢ ∀ls z. get_vars ls st = SOME z ⇒ (let lookups = MAP (λx. lookup x st.locals) ls in EVERY IS_SOME lookups ∧ z = MAP THE lookups)
na_full_pop_env_ffi=⊢ pop_env s = SOME s' ⇒ s.ffi = s'.ffi
