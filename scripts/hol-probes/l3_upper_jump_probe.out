upper_jump_definition_0=∀state. Skip state = state.c_Skip state.procID
upper_jump_definition_1=∀newPC. branchTo newPC = (λstate. write'NextFetch (SOME (BranchTo newPC)) state)
upper_jump_definition_2=∀rd imm. dfn'LUI (rd,imm) = (λstate. write'GPR (sw2sw (imm @@ 0w),rd) state)
upper_jump_definition_3=∀rd imm. dfn'AUIPC (rd,imm) = (λstate. write'GPR (PC state + sw2sw (imm @@ 0w),rd) state)
upper_jump_definition_4=∀rd imm. dfn'JAL (rd,imm) = (λstate. (let v = PC state + sw2sw imm ≪ 1 in if word_bit 0 v then signalAddressException (Fetch_Misaligned,v) state else branchTo v (write'GPR (PC state + Skip state,rd) state)))
upper_jump_definition_5=∀rd rs1 imm. dfn'JALR (rd,rs1,imm) = (λstate. (let v = GPR rs1 state + sw2sw imm && sw2sw 2w in if word_bit 0 v then signalAddressException (Fetch_Misaligned,v) state else branchTo v (write'GPR (PC state + Skip state,rd) state)))
