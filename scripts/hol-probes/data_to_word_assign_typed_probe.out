evaluate_WriteWord64_bignum_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (t :(α, γ, 'ffi) wordSem$state).store t.memory t.mdomain (join_env_locals (sl :v sptree$num_map) t.locals ++ (vars :(v # α word_loc) list)) ∧ (get_var (src :num) t :α word_loc option) = SOME (Word (w :α word)) ∧ shift_length c < dimindex (:α) ∧ src ≠ (1 :num) ∧ (1 :num) < sp ∧ dimindex (:α) = (64 :num) ∧ (encode_header c (3 :num) (1 :num) :α word option) = SOME (header :α word) ∧ ¬small_int (:α) ((&w2n w) :int) ∧ (∀(n :num). IS_SOME (lookup n sl :v option) ⇒ IS_SOME (lookup (adjust_var n) t.locals :α word_loc option)) ⇒ ∃(nf :α word_loc) (m' :α word -> α word_loc) (locals' :α word_loc sptree$num_map) (v :β). (evaluate (WriteWord64 c header (dest :num) src,t) :α result option # (α, γ, 'ffi) wordSem$state) = ((NONE :α result option),t with <|store := t.store⟨NextFree ↦ nf⟩; memory := m'; locals := locals'|>) ∧ memory_rel c be ts refs (sp − (2 :num)) t.store⟨NextFree ↦ nf⟩ m' t.mdomain (join_env_locals (insert dest (Number ((&w2n w) :int) :v) sl :v sptree$num_map) locals' ++ vars) ∧ (∀(n :num). IS_SOME (lookup n sl :v option) ⇒ IS_SOME (lookup (adjust_var n) locals' :α word_loc option)) ∧ IS_SOME (lookup (adjust_var dest) locals' :α word_loc option) ∧ (lookup (0 :num) locals' :α word_loc option) = (lookup (0 :num) t.locals :α word_loc option)
