imp_assign_typed=(op :closLang$op) = WordOp WordToInt ∨ (∃(ws :word_size) (test :test). op = WordOp (WordTest ws test)) ∨ (∃(sh :ast$shift) (n :num). op = WordOp (WordShift W8 sh n)) ∨ (∃(sh :ast$shift) (n :num). op = WordOp (WordShift W64 sh n)) ∨ (∃(opw :opw). op = WordOp (WordOpw W8 opw)) ∨ (∃(opw :opw). op = WordOp (WordOpw W64 opw)) ∨ (∃(b :bool). op = WordOp (WordFromWord b)) ∨ op = WordOp WordFromInt ∨ (∃(ev :thunk_mode). op = (ThunkOp (UpdateThunk ev) :closLang$op)) ∨ op = MemOp UpdateCons ∨ op = MemOp UpdateByte ∨ op = MemOp Update ∨ (∃(tag :num) (len :num). op = BlockOp (TagLenEq tag len :block_op)) ∨ (∃(tag :num). op = BlockOp (TagEq tag)) ∨ op = IntOp Sub ∨ (∃(b :bool) (cmp :opb). op = MemOp (StringCmp b cmp)) ∨ op = GlobOp SetGlobalsPtr ∨ (∃(n :num). op = GlobOp (SetGlobal n)) ∨ (∃(fl :bool). op = MemOp (RefByte fl)) ∨ op = MemOp RefArray ∨ op = MemOp Ref ∨ (∃(t :num) (k :num). op = MemOp (MutCons t k)) ∨ op = IntOp Mult ∨ op = IntOp Mod ∨ op = BlockOp ListAppend ∨ (∃(i :num). op = IntOp (LessConstSmall i)) ∨ op = IntOp LessEq ∨ op = IntOp Less ∨ op = MemOp LengthByte ∨ op = BlockOp LengthBlock ∨ op = MemOp Length ∨ (∃(len :num). op = BlockOp (LenEq len :block_op)) ∨ (∃(lab :num). op = (Label lab :closLang$op)) ∨ op = Install ∨ op = GlobOp GlobalsPtr ∨ (∃(n :num). op = GlobOp (Global n)) ∨ (∃(tag :num). op = BlockOp (FromList tag)) ∨ (∃(fpu :fp_uop). op = WordOp (FP_uop fpu)) ∨ (∃(fpt :fp_top). op = WordOp (FP_top fpt)) ∨ (∃(fpc :fp_cmp). op = WordOp (FP_cmp fpc)) ∨ (∃(fpb :fp_bop). op = WordOp (FP_bop fpb)) ∨ op = MemOp FinaliseCons ∨ (∃(n :mlstring). op = (FFI n :closLang$op)) ∨ (∃(p :const_part). op = BlockOp (EqualConst p)) ∨ op = BlockOp Equal ∨ (∃(n :num). op = BlockOp (ElemAt n)) ∨ op = MemOp El ∨ op = IntOp Div ∨ op = MemOp DerefByte ∨ (∃(new_flag :bool). op = MemOp (CopyByte new_flag) ∧ ¬new_flag) ∨ (∃(i :int). op = IntOp (Const i :int_op)) ∨ (∃(tag :num). op = BlockOp (ConsExtend tag)) ∨ (∃(tag :num). op = BlockOp (Cons tag :block_op)) ∨ op = MemOp ConfigGC ∨ (∃(parts :const_part list). op = BlockOp (Build parts)) ∨ (∃(leq :bool). op = MemOp (BoundsCheckByte leq)) ∨ op = BlockOp BoundsCheckBlock ∨ op = MemOp BoundsCheckArray ∨ (∃(test :test). op = BlockOp (BoolTest test)) ∨ op = BlockOp BoolNot ∨ (∃(ev :thunk_mode). op = (ThunkOp (AllocThunk ev) :closLang$op)) ∨ op = IntOp Add ∨ op = MemOp XorByte ⇒ (state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (NONE :(v # α word_loc) list option) (locs :(num # num) list) :bool) ∧ (op_requires_names op ⇎ (names_opt :sptree$num_set option) = (NONE :sptree$num_set option)) ∧ cut_state_opt names_opt s = SOME (x :(γ, 'ffi) dataSem$state) ∧ (get_vars (args :num list) s.locals :v list option) = SOME (vals :v list) ∧ t.termdep > (1 :num) ∧ (do_app op vals x :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) = (Rval ((v :v),(s2 :(γ, 'ffi) dataSem$state)) :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) ⇒ ∃(q :α result option) (r :(α, γ, 'ffi) wordSem$state). (evaluate (FST (assign c (n :num) (l :num) (dest :num) op args names_opt :α wordLang$prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (q,r) ∧ (q = SOME (NotEnoughSpace :α result) ⇒ r.ffi = t.ffi ∧ option_le r.stack_max s2.stack_max ∧ (c.gc_kind ≠ None ⇒ ¬s2.safe_for_space)) ∧ (q ≠ SOME (NotEnoughSpace :α result) ⇒ (state_rel c l1 l2 (set_var dest v s2) r (NONE :(v # α word_loc) list option) locs :bool) ∧ q = (NONE :α result option))
assign_WordFromInt_typed=(op :closLang$op) = WordOp WordFromInt ⇒ (state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (NONE :(v # α word_loc) list option) (locs :(num # num) list) :bool) ∧ (op_requires_names op ⇎ (names_opt :sptree$num_set option) = (NONE :sptree$num_set option)) ∧ cut_state_opt names_opt s = SOME (x :(γ, 'ffi) dataSem$state) ∧ (get_vars (args :num list) s.locals :v list option) = SOME (vals :v list) ∧ t.termdep > (1 :num) ∧ (do_app op vals x :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) = (Rval ((v :v),(s2 :(γ, 'ffi) dataSem$state)) :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) ⇒ ∃(q :α result option) (r :(α, γ, 'ffi) wordSem$state). (evaluate (FST (assign c (n :num) (l :num) (dest :num) op args names_opt :α wordLang$prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (q,r) ∧ (q = SOME (NotEnoughSpace :α result) ⇒ r.ffi = t.ffi ∧ option_le r.stack_max s2.stack_max ∧ (c.gc_kind ≠ None ⇒ ¬s2.safe_for_space)) ∧ (q ≠ SOME (NotEnoughSpace :α result) ⇒ (state_rel c l1 l2 (set_var dest v s2) r (NONE :(v # α word_loc) list option) locs :bool) ∧ q = (NONE :α result option))
