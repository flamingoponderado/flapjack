size_of_seen_SUBSET_typed=∀(lims :limits) (vs :v list) (refs :v ref sptree$num_map) (seen :sptree$num_set) (n1 :num) (seen1 :sptree$num_set) (refs1 :v ref sptree$num_map). size_of lims vs refs seen = (n1,refs1,seen1) ⇒ (domain seen :num -> bool) ⊆ (domain seen1 :num -> bool)
size_of_seen_Block_typed=∀(lims :limits) (vs :v list) (refs :v ref sptree$num_map) (seen :sptree$num_set) (n1 :num) (refs1 :v ref sptree$num_map) (seen1 :sptree$num_set) (ts :num) (tag :num) (l :v list). size_of lims vs refs seen = (n1,refs1,seen1) ⇒ MEM (Block ts tag l :v) vs ∧ l ≠ ([] :v list) ⇒ (lookup ts seen1 :unit option) = SOME ()
IMP_read_bytearray_GENLIST_typed=∀(ls :α list) (len :num) (a :β word). len = LENGTH ls ∧ (∀(i :num). i < len ⇒ (g :β word -> α option) (a + (n2w i :β word)) = SOME ls❲i❳) ⇒ read_bytearray a len g = SOME ls
