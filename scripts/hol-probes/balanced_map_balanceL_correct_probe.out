bmlc_full=⊢ ∀(k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map) (cmp :α -> α -> ordering). good_cmp cmp ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ almost_balancedL (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r ⇒ invariant cmp (balanceL k v l r) ∧ to_fmap cmp (balanceL k v l r) = (to_fmap cmp l ⊌ to_fmap cmp r)⟨key_set cmp k ↦ v⟩
