flatten_leq_statement=∀t x y z cs bs. z ≤ SND (SND (flatten t x y z cs bs))
no_ret_correct_statement=∀t p y z cs bs. FST (SND (flatten t p y z cs bs)) ⇒ ∀s. IS_SOME (FST (evaluate (p,s)))
compile_jump_correct_statement=∀s regs pc' pc dest code. asm_fetch_aux pc code = SOME (compile_jump dest) ∧ loc_to_pc (dest_to_loc' regs dest) 0 code = SOME pc' ∧ (∀r. dest = INR r ⇒ ∃p. read_reg r s = Loc p 0) ∧ s.pc = pc ∧ s.code = code ∧ s.regs = regs ∧ s.clock ≠ 0 ⇒ evaluate s = evaluate (upd_pc pc' (dec_clock s))
result_view_nchotomy_statement=∀rr. (∃n n0. rr = Vloc n n0) ∨ (∃n n0. rr = Vcont n n0) ∨ rr = Vtimeout ∨ rr = Verr
result_view_def_statement=result_view (Result (Loc n1 n2)) v0 v1 v2 = Vloc n1 n2 ∧ result_view (Exception (Loc n1 n2)) v3 v4 v5 = Vloc n1 n2 ∧ result_view TimeOut v6 v7 v8 = Vtimeout ∧ result_view (Continue n) l cs v9 = Vcont l (find_lab n cs) ∧ result_view (Break n) l v10 bs = Vloc l (find_lab n bs) ∧ result_view (Result (Word v32)) v12 v13 v14 = Verr ∧ result_view (Exception (Word v38)) v12 v13 v14 = Verr ∧ result_view (Halt v24) v12 v13 v14 = Verr ∧ result_view (FinalFFI v25) v12 v13 v14 = Verr ∧ result_view Error v12 v13 v14 = Verr
halt_word_view_def_statement=halt_word_view (Word 0w) = Halt Success ∧ halt_word_view (Word v7) = (if v7 = 0w then Halt Success else Halt Resource_limit_hit) ∧ halt_word_view (Loc v2 v3) = Error
halt_view_def_statement=halt_view (SOME (Halt w)) = SOME (halt_word_view w) ∧ halt_view (SOME (FinalFFI outcome)) = SOME (Halt (FFI_outcome outcome)) ∧ halt_view NONE = NONE ∧ halt_view (SOME (Result v2)) = NONE ∧ halt_view (SOME (Exception v3)) = NONE ∧ halt_view (SOME (Break v4)) = NONE ∧ halt_view (SOME (Continue v5)) = NONE ∧ halt_view (SOME TimeOut) = NONE ∧ halt_view (SOME Error) = NONE
stack_to_lab_lab_pres_statement=∀t p n nl cs bs. EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p) ∧ ¬t ∧ next_lab p 2 ≤ nl ⇒ (let (cp,nr,nl') = flatten t p n nl cs bs in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels (append cp)) ∧ ALL_DISTINCT (extract_labels (append cp)) ∧ (∀lab. MEM lab (extract_labels (append cp)) ⇒ MEM lab (extract_labels p) ∨ nl ≤ SND lab ∧ SND lab < nl') ∧ nl ≤ nl')
stack_to_lab_lab_pres_T_statement=∀t p n nl cs bs. EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p) ∧ t ∧ next_lab p 2 ≤ nl ⇒ (let (cp,nr,nl') = flatten t p n nl cs bs in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0) (extract_labels (append cp)) ∧ ALL_DISTINCT (extract_labels (append cp)) ∧ (∀lab. MEM lab (extract_labels (append cp)) ⇒ MEM lab (extract_labels p) ∨ SND lab < nl') ∧ nl ≤ nl')
flatten_T_F_statement=∀p_2 p_1 m cs bs. ¬is_Seq p_2 ⇒ flatten T p_2 p_1 m cs bs = flatten F p_2 p_1 m cs bs
prog_to_section_labels_ok_statement=∀prog. EVERY (λ(n,p). (let labs = extract_labels p in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) labs ∧ ALL_DISTINCT labs)) prog ∧ ALL_DISTINCT (MAP FST prog) ⇒ labels_ok (MAP prog_to_section prog)
NOT_MEM_find_lab_IMP_statement=∀bs n. ¬MEM (find_lab n bs) bs ⇒ find_lab n bs = 0
is_some_loc_to_pc_prefix_statement=∀n k c2 c1. IS_SOME (loc_to_pc n k c1) ∧ c1 ≼ c2 ⇒ IS_SOME (loc_to_pc n k c2)
every_is_some_loc_to_pc_prefix_statement=∀n cs c2 c1. EVERY (λk. IS_SOME (loc_to_pc n k c1)) cs ∧ c1 ≼ c2 ⇒ EVERY (λk. IS_SOME (loc_to_pc n k c2)) cs
NOT_bad_fun_return_IMP_SOME_statement=∀q. ¬bad_fun_return q ⇒ ∃n. q = SOME n
next_lab_non_zero_1022_statement=∀p. 2 ≤ next_lab p 2
