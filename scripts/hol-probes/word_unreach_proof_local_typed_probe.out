get_vars_IS_SOME_lookup_typed=∀(xs :num list) (s :(α, β, γ) state). (∃(ws :α word_loc list). get_vars xs s = SOME ws) ⇔ EVERY (λ(x :num). IS_SOME (lookup x s.locals)) xs
evaluate_SimpSeq_typed=evaluate (Seq (p1 :α prog) (p2 :α prog),(s :(α, β, γ) state)) = ((res :α result option),(s1 :(α, β, γ) state)) ∧ res ≠ SOME (Error :α result) ⇒ evaluate (SimpSeq p1 p2,s) = (res,s1)
push_env_handler_typed=push_env (x' :α word_loc sptree$num_map # α word_loc sptree$num_map) (case (handler :(num # α prog # num # num) option) of (NONE :(num # α prog # num # num) option) => (NONE :(num # α prog # num # num) option) | SOME (y1,q2,y2,y3) => SOME (y1,Seq_assoc_right q2 (Skip :α prog),y2,y3)) (dec_clock (s :(α, β, γ) state)) = push_env x' handler (dec_clock s)
evaluate_Loop_body_eq_typed=(∀(s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state). evaluate ((p1 :α prog),s) = (res,s1) ∧ res ≠ SOME (Error :α result) ⇒ evaluate ((p2 :α prog),s) = (res,s1)) ⇒ ∀(s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state). evaluate ((Loop (names :sptree$num_set) p1 (exit_names :sptree$num_set) :α prog),s) = (res,s1) ∧ res ≠ SOME (Error :α result) ⇒ evaluate ((Loop names p2 exit_names :α prog),s) = (res,s1)
