compile_decs_elist_globals_typed=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (decs :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (decs' :exp list). compile_decs t n next env envs decs = (n',next',env',envs',decs') ⇒ elist_globals decs' = LIST_TO_BAG (MAP ($+ next.vidx) (COUNT_LIST (SUM (MAP num_bindings decs) :num)))
compile_decs_env_gen_inv_typed=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (ds :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (ds_i1 :exp list). compile_decs t n next env envs ds = (n',next',env',envs',ds_i1) ∧ env_gen_inv envs ⇒ env_gen_inv envs' ∧ subspt envs.envs envs'.envs
compile_decs_esgc_free_typed=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (decs :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (decs' :exp list). compile_decs t n next env envs decs = (n',next',env',envs',decs') ⇒ EVERY esgc_free decs'
