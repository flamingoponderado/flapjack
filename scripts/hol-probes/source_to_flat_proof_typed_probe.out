v_rel_eqns_typed=(∀(v :v) (l :lit) (genv :global_env). (v_rel genv (Litv l :semanticPrimitives$v) v :bool) ⇔ v = (Litv l :v)) ∧ (∀(vs :semanticPrimitives$v list) (v :v) (genv :global_env) (cn :stamp option). (v_rel genv (Conv cn vs) v :bool) ⇔ (∃(cn' :stamp) (cn'' :num # num option) (vs'' :v list). cn = SOME cn' ∧ v = Conv (SOME cn'') vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'' ∧ FLOOKUP genv.c (cn'',LENGTH vs) = SOME cn') ∨ ∃(vs'' :v list). cn = (NONE :stamp option) ∧ v = Conv (NONE :(num # num option) option) vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'') ∧ (∀(v :v) (l :num) (genv :global_env) (b :bool). (v_rel genv (Loc b l :semanticPrimitives$v) v :bool) ⇔ v = (Loc b (l + (1 :num)) :v)) ∧ (∀(vs :semanticPrimitives$v list) (v :v) (genv :global_env). (v_rel genv (Vectorv vs) v :bool) ⇔ ∃(vs'' :v list). v = Vectorv vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'') ∧ (∀(genv :global_env) (env' :(mlstring # v) list). env_rel genv (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace) env' ⇔ env' = ([] :(mlstring # v) list)) ∧ (∀(x :mlstring) (v :semanticPrimitives$v) (genv :global_env) (env' :(mlstring # v) list) (env :(mlstring, mlstring, semanticPrimitives$v) namespace). env_rel genv (nsBind x v env) env' ⇔ ∃(env'³' :(mlstring # v) list) (v'' :v). env' = (x,v'')::env'³' ∧ env_rel genv env env'³' ∧ (v_rel genv v v'' :bool)) ∧ ∀(v :v) (id :num # num) (genv :global_env) (e :semanticPrimitives$v sem_env). (v_rel genv (Env e id) v :bool) ⇔ F
v_rel_eqns_non_global_typed=(∀(v :v) (l :lit) (genv :global_env). (v_rel genv (Litv l :semanticPrimitives$v) v :bool) ⇔ v = (Litv l :v)) ∧ (∀(vs :semanticPrimitives$v list) (v :v) (genv :global_env) (cn :stamp option). (v_rel genv (Conv cn vs) v :bool) ⇔ (∃(cn' :stamp) (cn'' :num # num option) (vs'' :v list). cn = SOME cn' ∧ v = Conv (SOME cn'') vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'' ∧ FLOOKUP genv.c (cn'',LENGTH vs) = SOME cn') ∨ ∃(vs'' :v list). cn = (NONE :stamp option) ∧ v = Conv (NONE :(num # num option) option) vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'') ∧ (∀(v :v) (l :num) (genv :global_env) (b :bool). (v_rel genv (Loc b l :semanticPrimitives$v) v :bool) ⇔ v = (Loc b (l + (1 :num)) :v)) ∧ (∀(vs :semanticPrimitives$v list) (v :v) (genv :global_env). (v_rel genv (Vectorv vs) v :bool) ⇔ ∃(vs'' :v list). v = Vectorv vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'') ∧ (∀(genv :global_env) (env' :(mlstring # v) list). env_rel genv (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace) env' ⇔ env' = ([] :(mlstring # v) list)) ∧ (∀(x :mlstring) (v :semanticPrimitives$v) (genv :global_env) (env' :(mlstring # v) list) (env :(mlstring, mlstring, semanticPrimitives$v) namespace). env_rel genv (nsBind x v env) env' ⇔ ∃(env'³' :(mlstring # v) list) (v'' :v). env' = (x,v'')::env'³' ∧ env_rel genv env env'³' ∧ (v_rel genv v v'' :bool)) ∧ ∀(v :v) (id :num # num) (genv :global_env) (e :semanticPrimitives$v sem_env). (v_rel genv (Env e id) v :bool) ⇔ F
