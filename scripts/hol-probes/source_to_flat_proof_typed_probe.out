ALL_DISJOINT_CONS_typed=(ALL_DISJOINT [(x :α -> bool)] ⇔ T) ∧ (ALL_DISJOINT (x::(y :α -> bool)::(zs :(α -> bool) list)) ⇔ DISJOINT x y ∧ ALL_DISJOINT (x ∪ y::zs))
ALL_DISJOINT_DEF_typed=∀(xs :(α -> bool) list). ALL_DISJOINT xs ⇔ ∀(i :num) (j :num). i < LENGTH xs ∧ j < LENGTH xs ∧ i ≠ j ⇒ xs❲i❳ ∩ xs❲j❳ = (∅ :α -> bool)
ALL_DISJOINT_MOVE_typed=∀(i :num) (j :num) (mv_set :α -> bool) (xs :(α -> bool) list) (ys :(α -> bool) list). ALL_DISJOINT xs ∧ ys = xs❲i ↦ xs❲i❳ DIFF mv_set; j ↦ xs❲j❳ ∪ mv_set❳ ∧ mv_set ⊆ xs❲i❳ ∧ i < LENGTH xs ∧ j < LENGTH xs ⇒ ALL_DISJOINT ys
ALL_DISJOINT_SUBSETS_typed=∀(xs :(α -> bool) list) (ys :(α -> bool) list). ALL_DISJOINT xs ∧ LIST_REL (λ(x :α -> bool) (y :α -> bool). y ⊆ x) xs ys ⇒ ALL_DISJOINT ys
ALL_DISJOINT_elem_typed=∀(x :α) (i :num). ALL_DISJOINT (xs :(α -> bool) list) ∧ i < LENGTH xs ∧ x ∈ xs❲i❳ ⇒ EVERY (I :bool -> bool) (MAPi (λ(j :num) (y :α -> bool). j = i ∨ x ∉ y) xs)
ALOOKUP_MAP_3_typed=(∀(x :α # β). MEM x (xs :(α # β) list) ⇒ FST ((f :α # β -> α # γ) x) = FST x) ⇒ ALOOKUP (MAP f xs) (x :α) = OPTION_MAP (λ(y :β). SND (f (x,y))) (ALOOKUP xs x)
ALOOKUP_alloc_defs_typed=∀(env :(α # β) list) (x :α) (v :β) (l :num) (tt :num). ALOOKUP (REVERSE env) x = SOME v ⇒ ∃(n :num) (t :tra). ALOOKUP (alloc_defs tt l (MAP (FST :α # β -> α) (REVERSE env))) x = SOME (Glob t (l + n)) ∧ n < LENGTH (MAP (FST :α # β -> α) env) ∧ (REVERSE (MAP (SOME :β -> β option) (MAP (SND :α # β -> β) env)))❲n❳ = SOME v
ALOOKUP_alloc_defs_EL_typed=∀(funs :(α # β # γ) list) (l :num) (n :num) (m :num). ALL_DISTINCT (MAP (λ((x :α),(y :β),(z :γ)). x) funs) ∧ n < LENGTH funs ⇒ ∃(tt :tra). ALOOKUP (alloc_defs m l (MAP (FST :α # β # γ -> α) (REVERSE funs))) (MAP (FST :α # β # γ -> α) funs)❲n❳ = SOME (Glob tt (l + LENGTH funs − (n + (1 :num))))
Boolv_11_typed=(Boolv (b :bool) :v) = (Boolv (b' :bool) :v) ⇔ (b ⇔ b')
EL_APPEND_IF_typed=((xs :α list) ++ (ys :α list))❲(i :num)❳ = if i < LENGTH xs then xs❲i❳ else ys❲i − LENGTH xs❳
EL_add_SOME_SOME_typed=((pre :α option list) ++ MAP (SOME :α -> α option) (xs :α list) ++ (post :α option list))❲(i :num)❳ ≠ (NONE :α option) ⇔ (pre ++ REPLICATE (LENGTH xs) (NONE :α option) ++ post)❲i❳ ≠ (NONE :α option) ∨ LENGTH pre ≤ i ∧ i < LENGTH pre + LENGTH xs
FILTER_MAPi_ID_typed=∀(ls :α list) (f :num -> α -> β). FILTER (P :β -> bool) (MAPi f ls) = MAPi f ls ⇔ ∀(n :num). n < LENGTH ls ⇒ P (f n ls❲n❳)
FST_PAIR_MAP_I_typed=FST (((I :α -> α) ## (f :γ -> β)) (x :α # γ)) = FST x
FST_SND_EQ_CASE_typed=(FST :α # β -> α) = (λ((a :α),(b :β)). a) ∧ (SND :γ # δ -> δ) = (λ((a :γ),(b :δ)). b)
LIST_REL_IMP_EL_typed=∀(P :α -> β -> bool) (xs :α list) (ys :β list). LIST_REL P xs ys ⇒ ∀(i :num). i < LENGTH xs ⇒ P xs❲i❳ ys❲i❳
LIST_REL_IMP_EL2_typed=∀(P :α -> β -> bool) (xs :α list) (ys :β list). LIST_REL P xs ys ⇒ ∀(i :num). i < LENGTH ys ⇒ P xs❲i❳ ys❲i❳
