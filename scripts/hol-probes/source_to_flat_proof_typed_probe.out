compile_exp_esgc_free_typed=(∀(tra :mlstring list) (env :source_to_flat$environment) (exp :ast$exp). esgc_free (compile_exp tra env exp :exp) ∧ set_globals (compile_exp tra env exp :exp) = ({||} :num -> num)) ∧ (∀(tra :mlstring list) (env :source_to_flat$environment) (exps :ast$exp list). EVERY esgc_free (compile_exps tra env exps :exp list) ∧ elist_globals (compile_exps tra env exps :exp list) = ({||} :num -> num)) ∧ (∀(tra :mlstring list) (env :source_to_flat$environment) (pes :(ast$pat # ast$exp) list). EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) (compile_pes tra env pes)) ∧ elist_globals (MAP (SND :flatLang$pat # exp -> exp) (compile_pes tra env pes)) = ({||} :num -> num)) ∧ ∀(tra :mlstring list) (env :source_to_flat$environment) (funs :(mlstring # mlstring # ast$exp) list). EVERY esgc_free (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) (compile_funs tra env funs)) ∧ elist_globals (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) (compile_funs tra env funs)) = ({||} :num -> num)
compile_exps_length_typed=LENGTH (compile_exps (t :mlstring list) (m :source_to_flat$environment) (es :ast$exp list) :exp list) = LENGTH es
compile_flat_correct_typed=install_conf_rel (cfg :flat_pattern$config) (ec1 :α install_config) (ec2 :α install_config) ∧ (semantics ec1 (ffi :β ffi_state) (prog :exp list) :behaviour) ≠ Fail ⇒ (semantics ec1 ffi prog :behaviour) = (semantics ec2 ffi (compile_flat cfg prog) :behaviour)
