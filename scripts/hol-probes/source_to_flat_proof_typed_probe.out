env_all_rel_weak_typed=∀(genv :global_env) (map :source_to_flat$environment) (locals :mlstring list) (env :semanticPrimitives$v sem_env) (env' :v environment) (genv' :global_env). env_all_rel genv map env env' locals ∧ genv.c ⊑ genv'.c ∧ genv.tys ⊑ genv'.tys ∧ subglobals genv.v genv'.v ⇒ env_all_rel genv' map env env' locals
env_domain_eq_append_typed=env_domain_eq (env1 :source_to_flat$environment) (env1' :semanticPrimitives$v sem_env) ∧ env_domain_eq (env2 :source_to_flat$environment) (env2' :semanticPrimitives$v sem_env) ⇒ env_domain_eq (extend_env env1 env2) ((env1' +++ env2') :semanticPrimitives$v sem_env)
env_domain_eq_def_typed=∀(var_map :source_to_flat$environment) (env :α sem_env). env_domain_eq var_map env ⇔ nsDom var_map.v = nsDom env.v ∧ nsDomMod var_map.v = nsDomMod env.v ∧ nsDom var_map.c = nsDom env.c ∧ nsDomMod var_map.c = nsDomMod env.c
env_gen_future_rel_def_typed=∀(interp :(semanticPrimitives$v -> (config # α) option) option) (gen :environment_generation_store) (eval_state :eval_state option). env_gen_future_rel interp gen eval_state ⇔ case src_orac_next_cfg interp eval_state of (NONE :config option) => T | SOME c => ∃(gen_final :source_to_flat$environment sptree$num_map). lookup gen.generation c.envs.env_gens = SOME gen_final ∧ subspt gen.envs gen_final
env_gen_future_rel_forward_typed=env_gen_future_rel (interp :(semanticPrimitives$v -> (config # α) option) option) (envs :environment_generation_store) (eval_state :eval_state option) ∧ orac_forward_rel interp eval_state (eval_state2 :eval_state option) ⇒ env_gen_future_rel interp envs eval_state2
env_gen_inv_def_typed=∀(e :environment_generation_store). env_gen_inv e ⇔ (domain e.envs :num -> bool) ⊆ count e.next
env_gen_rel_def_typed=∀(gen :environment_generation_store) (eval_state :eval_state option). env_gen_rel gen eval_state ⇔ case eval_state of (NONE :eval_state option) => T | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => gen.generation = s.generation ∧ s.generation < LENGTH s.envs ∧ gen.next = LENGTH s.envs❲s.generation❳
env_rel_LIST_REL_typed=∀(xs :(mlstring # semanticPrimitives$v) list) (ys :(mlstring # v) list). env_rel (genv :global_env) (alist_to_ns xs :(mlstring, mlstring, semanticPrimitives$v) namespace) ys ⇔ LIST_REL (λ(x :mlstring # semanticPrimitives$v) (y :mlstring # v). FST x = FST y ∧ (v_rel genv (SND x) (SND y) :bool)) xs ys
env_rel_append_typed=∀(genv :global_env) (env1 :(mlstring, mlstring, semanticPrimitives$v) namespace) (env2 :(mlstring, mlstring, semanticPrimitives$v) namespace) (env1' :(mlstring # v) list) (env2' :(mlstring # v) list). env_rel genv env1 env1' ∧ env_rel genv env2 env2' ⇒ env_rel genv (nsAppend env1 env2) (env1' ++ env2')
env_rel_bind_one_typed=∀(genv :global_env) (env2 :(mlstring, mlstring, semanticPrimitives$v) namespace) (d :v) (c :mlstring) (b :semanticPrimitives$v) (env2' :(mlstring # v) list). (v_rel genv b d :bool) ∧ env_rel genv env2 env2' ⇒ env_rel genv (nsBind c b env2) ((c,d)::env2')
env_rel_dom_typed=∀(genv :global_env) (env :(mlstring, mlstring, semanticPrimitives$v) namespace) (env' :(mlstring # v) list). env_rel genv env env' ⇒ ∃(l :(mlstring # semanticPrimitives$v) list). env = (alist_to_ns l :(mlstring, mlstring, semanticPrimitives$v) namespace) ∧ MAP (FST :mlstring # semanticPrimitives$v -> mlstring) l = MAP (FST :mlstring # v -> mlstring) env'
env_rel_el_typed=∀(genv :global_env) (env :(mlstring # semanticPrimitives$v) list) (env_i1 :(mlstring # v) list). env_rel genv (alist_to_ns env :(mlstring, mlstring, semanticPrimitives$v) namespace) env_i1 ⇔ LENGTH env = LENGTH env_i1 ∧ ∀(n :num). n < LENGTH env ⇒ FST env❲n❳ = FST env_i1❲n❳ ∧ (v_rel genv (SND env❲n❳) (SND env_i1❲n❳) :bool)
env_rel_lookup_typed=∀(genv :global_env) (env :(mlstring # semanticPrimitives$v) list) (x :mlstring) (v :semanticPrimitives$v) (env' :(mlstring # v) list). ALOOKUP env x = SOME v ∧ env_rel genv (alist_to_ns env :(mlstring, mlstring, semanticPrimitives$v) namespace) env' ⇒ ∃(v' :v). (v_rel genv v v' :bool) ∧ ALOOKUP env' x = SOME v'
env_rel_one_typed=env_rel (genv :global_env) (nsBind (a :mlstring) (b :semanticPrimitives$v) (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace)) (xs :(mlstring # v) list) ⇔ ∃(v :v). xs = [(a,v)] ∧ (v_rel genv b v :bool)
env_rel_weak_typed=∀(genv :global_env) (env :(mlstring, mlstring, semanticPrimitives$v) namespace) (env' :(mlstring # v) list) (genv' :global_env). env_rel genv env env' ∧ genv.c ⊑ genv'.c ∧ genv.tys ⊑ genv'.tys ∧ subglobals genv.v genv'.v ⇒ env_rel genv' env env'
env_store_inv_def_typed=∀(e :environment_store). env_store_inv e ⇔ (domain e.env_gens :num -> bool) ⊆ count e.next
env_updated_lem_typed=(env :α environment) with v updated_by (λ(y :(mlstring # α) list). y) = env
eta2_typed=∀(f :α -> β -> γ) (x :α). (λ(y :β). f x y) = f x
eval_ref_inv_def_typed=∀(first_global :v option list) (first_ref :α store_v list). eval_ref_inv first_global first_ref ⇔ first_global = [SOME (Loc T (0 :num) :v)] ∧ ∃(v :α). first_ref = [Refv v]
eval_state_call_rel_def_typed=∀(es1 :eval_state option) (es2 :eval_state option). eval_state_call_rel es1 es2 ⇔ case es1 of (NONE :eval_state option) => T | SOME (EvalDecs v4) => T | SOME (EvalOracle s1) => ∃(s2 :eval_oracle_state). es2 = SOME (EvalOracle s2) ∧ s2.generation = s1.generation ∧ LENGTH s1.envs ≤ LENGTH s2.envs ∧ ∀(i :num). i < s1.generation ⇒ s2.envs❲i❳ = s1.envs❲i❳
eval_state_call_rel_refl_typed=eval_state_call_rel (es1 :eval_state option) es1
eval_state_call_rel_trans_typed=eval_state_call_rel (es1 :eval_state option) (es2 :eval_state option) ∧ eval_state_call_rel es2 (es3 :eval_state option) ⇒ eval_state_call_rel es1 es3
evaluate_Bool_typed=s_rel (genv :global_env) (s :α semanticPrimitives$state) (s' :(β, α) flatSem$state) ∧ genv_c_ok genv.c ⇒ (evaluate (env :v environment) s' [Bool (t :tra) (b :bool)] :(β, α) flatSem$state # (v list, v) result) = (s',(Rval [(Boolv b :v)] :(v list, v) result))
evaluate_foldr_let_err_typed=∀(env :v environment) (s :(α, β) flatSem$state) (s' :(α, β) flatSem$state) (exps :exp list) (e :exp) (x :v error_result). (evaluate env s exps :(α, β) flatSem$state # (v list, v) result) = (s',(Rerr x :(v list, v) result)) ⇒ (evaluate env s [FOLDR (Let (t :tra) (NONE :mlstring option) :exp -> exp -> exp) e exps] :(α, β) flatSem$state # (v list, v) result) = (s',(Rerr x :(v list, v) result))
evaluate_make_varls_typed=∀(n :num) (t :tra) (idx :num) (vars :mlstring list) (g :v option list) (g' :v option list) (s :(α, β) flatSem$state) (env :v environment) (vals :v list) (len :num). s.globals = g ++ REPLICATE len (NONE :v option) ++ g' ∧ LENGTH g = idx ∧ LENGTH vals = LENGTH vars ∧ len = LENGTH vars ∧ (∀(n :num). n < LENGTH vals ⇒ ALOOKUP env.v vars❲n❳ = SOME vals❲n❳) ⇒ (evaluate env s [make_varls n t idx vars] :(α, β) flatSem$state # (v list, v) result) = (s with globals := g ++ MAP (SOME :v -> v option) vals ++ g',(Rval [Conv (NONE :(num # num option) option) ([] :v list)] :(v list, v) result))
fin_idx_match_def_typed=∀(len :num) (end_idx :next_indices) (next_cfg :config option). fin_idx_match len end_idx next_cfg ⇔ case next_cfg of (NONE :config option) => end_idx.vidx ≤ len | SOME c => c.next.vidx = len
find_recfun_typed=∀(x :mlstring) (funs :(mlstring # mlstring # ast$exp) list) (e :ast$exp) (comp_map :source_to_flat$environment) (y :mlstring) (t :mlstring list). find_recfun x funs = SOME (y,e) ⇒ find_recfun x (compile_funs t comp_map funs) = SOME (y,(compile_exp (x::t) (comp_map with v := nsBind y (Local None y) comp_map.v) e :exp))
flookup_funion_submap_typed=(x :α |-> β) ⊌ (y :α |-> β) ⊑ (z :α |-> β) ∧ FLOOKUP (x ⊌ y) (k :α) = SOME (v :β) ⇒ FLOOKUP z k = SOME v
fst_lem_typed=(λ((p1 :α),(p1' :β),(p2 :γ)). p1) = (FST :α # β # γ -> α)
funion_submap_typed=(x :α |-> β) ⊌ (y :α |-> β) ⊑ (z :α |-> β) ∧ DISJOINT (FDOM x) (FDOM y) ⇒ y ⊑ z
genv_allocated_idxs_def_typed=∀(genv :global_env). genv_allocated_idxs genv = {(i,Idx_Var) | i < LENGTH genv.v ∧ genv.v❲i❳ ≠ (NONE :v option)} ∪ {(i,Idx_Type) | ∃(cn :num) (a :num). ((cn,SOME i),a) ∈ FDOM genv.c} ∪ {(i,Idx_Type) | i ∈ FDOM genv.tys} ∪ {(i,Idx_Exn) | ∃(a :num). ((i,(NONE :num option)),a) ∈ FDOM genv.c}
genv_c_ok_def_typed=∀(genv_c :(num # num option) # num |-> stamp). genv_c_ok genv_c ⇔ has_bools genv_c ∧ has_exns genv_c ∧ has_lists genv_c ∧ (∀(cn1 :num # num option) (cn2 :num # num option) (l1 :num) (l2 :num) (stamp1 :stamp) (stamp2 :stamp). FLOOKUP genv_c (cn1,l1) = SOME stamp1 ∧ FLOOKUP genv_c (cn2,l2) = SOME stamp2 ⇒ (ctor_same_type (SOME stamp1) (SOME stamp2) ⇔ ctor_same_type (SOME cn1) (SOME cn2))) ∧ ∀(cn1 :num # num option) (cn2 :num # num option) (l1 :num) (l2 :num) (stamp :stamp). FLOOKUP genv_c (cn1,l1) = SOME stamp ∧ FLOOKUP genv_c (cn2,l2) = SOME stamp ⇒ cn1 = cn2 ∧ l1 = l2
genv_c_ok_extend_typed=genv_c_ok (c :(num # num option) # num |-> stamp) ∧ (∀(cn :num # num option) (arity :num) (stamp :stamp). FLOOKUP (c_ext :(num # num option) # num |-> stamp) (cn,arity) = SOME stamp ⇒ (same_type (ExnStamp (0 :num)) stamp ⇔ SND cn = (NONE :num option)) ∧ (∀(cn' :num # num option) (arity' :num) (stamp' :stamp). FLOOKUP c_ext (cn',arity') = SOME stamp' ⇒ (same_type stamp stamp' ⇔ ctor_same_type (SOME cn) (SOME cn')) ∧ (stamp = stamp' ⇒ cn = cn' ∧ arity = arity')) ∧ ∀(cn' :num # num option) (arity' :num) (stamp' :stamp). FLOOKUP c (cn',arity') = SOME stamp' ⇒ stamp ≠ stamp' ∧ (SND cn ≠ (NONE :num option) ⇒ SND cn ≠ SND cn') ∧ ∀(s :mlstring) (s' :mlstring) (n :num). stamp = TypeStamp s n ⇒ stamp' ≠ TypeStamp s' n) ⇒ genv_c_ok (c ⊌ c_ext)
genv_c_ok_pmatch_stamps_ok_typed=s_rel (genv :global_env) (s :α semanticPrimitives$state) (t :(β, α) flatSem$state) ∧ nsLookup (comp_map_c :(γ, δ, num # (num # (num # num) list) option) namespace) (nm :(γ, δ) id) = SOME ((flat_cn :num),(ty_gp :(num # (num # num) list) option)) ∧ same_type (src_stamp :stamp) (src_stamp' :stamp) ∧ genv_c_ok genv.c ∧ genv_c_tys_ok genv.c genv.tys ∧ FLOOKUP genv.c ((flat_cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),(l :num)) = SOME src_stamp ∧ FLOOKUP genv.c ((flat_stamp' :num # num option),(l' :num)) = SOME src_stamp' ∧ (∀(ty_id :num) (ctors :(num # num) list). ty_gp = SOME (ty_id,ctors) ⇒ FLOOKUP genv.tys ty_id = SOME ctors) ⇒ pmatch_stamps_ok (SOME (flat_cn,ty_gp)) (SOME flat_stamp') l l'
genv_c_ok_same_type_FST_eq_imp_same_ctor_typed=genv_c_ok (genv_c :(num # num option) # num |-> stamp) ∧ FLOOKUP genv_c ((cn1 :num # num option),(l1 :num)) = SOME (stamp1 :stamp) ∧ FLOOKUP genv_c ((cn2 :num # num option),(l2 :num)) = SOME (stamp2 :stamp) ∧ same_type stamp1 stamp2 ∧ FST cn1 = FST cn2 ∧ l1 = l2 ⇒ same_ctor stamp1 stamp2
genv_c_tys_ok_def_typed=∀(genv_c :(α # β option) # γ |-> δ) (genv_tys :β |-> (α # γ) list). genv_c_tys_ok genv_c genv_tys ⇔ ∀(cn :α) (ty_id :β) (arity :γ). ((cn,SOME ty_id),arity) ∈ FDOM genv_c ⇒ ∃(ctors :(α # γ) list). FLOOKUP genv_tys ty_id = SOME ctors ∧ MEM (cn,arity) ctors
genv_c_tys_ok_extend_typed=genv_c_tys_ok (c :(α # β option) # γ |-> δ) (tys :β |-> (α # γ) list) ∧ genv_c_tys_ok (c_ext :(α # β option) # γ |-> δ) (tys_ext :β |-> (α # γ) list) ∧ DISJOINT (FDOM tys) (FDOM tys_ext) ⇒ genv_c_tys_ok (c ⊌ c_ext) (tys ⊌ tys_ext)
genv_lookup_cons_typed=genv_c_ok (genv_c :(num # num option) # num |-> stamp) ⇒ (FLOOKUP genv_c (cn :(num # num option) # num) = SOME (TypeStamp «::» list_type_num) ⇔ cn = ((cons_tag,SOME list_id),(2 :num)))
genv_lookup_nil_typed=genv_c_ok (genv_c :(num # num option) # num |-> stamp) ⇒ (FLOOKUP genv_c (cn :(num # num option) # num) = SOME (TypeStamp «[]» list_type_num) ⇔ cn = ((nil_tag,SOME list_id),(0 :num)))
global_env_typed=recordtype.global_env::v option list -> ((num # num option) # num |-> stamp) -> (num |-> (num # num) list) -> global_env
global_env_inv_add_locals_typed=∀(genv :global_env) (comp_map :source_to_flat$environment) (locals1 :mlstring -> bool) (locals2 :mlstring -> bool) (env :semanticPrimitives$v sem_env). global_env_inv genv comp_map locals1 env ⇒ global_env_inv genv comp_map (locals2 ∪ locals1) env
global_env_inv_append_typed=∀(genv :global_env) (var_map1 :source_to_flat$environment) (var_map2 :source_to_flat$environment) (env1 :semanticPrimitives$v sem_env) (env2 :semanticPrimitives$v sem_env). env_domain_eq var_map1 env1 ∧ global_env_inv genv var_map1 (∅ :mlstring -> bool) env1 ∧ global_env_inv genv var_map2 (∅ :mlstring -> bool) env2 ⇒ global_env_inv genv (extend_env var_map1 var_map2) (∅ :mlstring -> bool) ((env1 +++ env2) :semanticPrimitives$v sem_env)
global_env_inv_extend_typed=∀(pat_env :(mlstring # semanticPrimitives$v) list) (genv :global_env) (pat_env' :(mlstring # v) list) (tt :num) (g1 :v option list) (g2 :v option list). env_rel genv (alist_to_ns pat_env :(mlstring, mlstring, semanticPrimitives$v) namespace) pat_env' ∧ genv.v = g1 ++ MAP (SOME :v -> v option) (REVERSE (MAP (SND :mlstring # v -> v) pat_env')) ++ g2 ∧ ALL_DISTINCT (MAP (FST :mlstring # semanticPrimitives$v -> mlstring) pat_env) ⇒ global_env_inv genv <|c := (nsEmpty :(mlstring, mlstring, num # (num # (num # num) list) option) namespace); v := (alist_to_ns (alloc_defs tt (LENGTH g1) (REVERSE (MAP (FST :mlstring # v -> mlstring) pat_env'))) :(mlstring, mlstring, var_name) namespace)|> (∅ :mlstring -> bool) <|v := (alist_to_ns pat_env :(mlstring, mlstring, semanticPrimitives$v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|>
global_env_inv_extend2_typed=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (new_vars :(mlstring # var_name) list) (env' :(mlstring, mlstring, semanticPrimitives$v) namespace) (locals :mlstring -> bool) (env_c :(mlstring, mlstring, num # stamp) namespace). set (MAP ((Short :mlstring -> (mlstring, mlstring) id) ∘ (FST :mlstring # var_name -> mlstring)) new_vars) = nsDom env' ∧ global_env_inv genv comp_map locals env ∧ global_env_inv genv (comp_map with v := (alist_to_ns new_vars :(mlstring, mlstring, var_name) namespace)) locals <|v := env'; c := env_c|> ⇒ global_env_inv genv (comp_map with v := nsBindList new_vars comp_map.v) locals (env with v := nsAppend env' env.v)
global_env_inv_weak_typed=∀(genv :global_env) (comp_map :source_to_flat$environment) (shadowers :mlstring -> bool) (env :semanticPrimitives$v sem_env) (genv' :global_env). global_env_inv genv comp_map shadowers env ∧ genv.c ⊑ genv'.c ∧ genv.tys ⊑ genv'.tys ∧ subglobals genv.v genv'.v ⇒ global_env_inv genv' comp_map shadowers env
has_bools_def_typed=∀(genv :(num # num option) # num |-> stamp). has_bools genv ⇔ FLOOKUP genv ((true_tag,SOME bool_id),(0 :num)) = SOME (TypeStamp «True» bool_type_num) ∧ FLOOKUP genv ((false_tag,SOME bool_id),(0 :num)) = SOME (TypeStamp «False» bool_type_num)
has_exns_def_typed=∀(genv :(num # α option) # num |-> stamp). has_exns genv ⇔ FLOOKUP genv ((div_tag,(NONE :α option)),(0 :num)) = SOME div_stamp ∧ FLOOKUP genv ((chr_tag,(NONE :α option)),(0 :num)) = SOME chr_stamp ∧ FLOOKUP genv ((subscript_tag,(NONE :α option)),(0 :num)) = SOME subscript_stamp ∧ FLOOKUP genv ((bind_tag,(NONE :α option)),(0 :num)) = SOME bind_stamp
has_lists_def_typed=∀(genv :(num # num option) # num |-> stamp). has_lists genv ⇔ FLOOKUP genv ((cons_tag,SOME list_id),(2 :num)) = SOME (TypeStamp «::» list_type_num) ∧ FLOOKUP genv ((nil_tag,SOME list_id),(0 :num)) = SOME (TypeStamp «[]» list_type_num)
idx_block_def_typed=∀(start_idx :next_indices) (end_idx :next_indices). idx_block start_idx end_idx = {(i,Idx_Var) | start_idx.vidx ≤ i ∧ i < end_idx.vidx} ∪ {(i,Idx_Type) | start_idx.tidx ≤ i ∧ i < end_idx.tidx} ∪ {(i,Idx_Exn) | start_idx.eidx ≤ i ∧ i < end_idx.eidx}
idx_block_union_final_typed=idx_prev (idx :next_indices) (idx' :next_indices) ⇒ idx_block idx idx' ∪ idx_final_block idx' = idx_final_block idx
idx_final_block_def_typed=∀(start_idx :next_indices). idx_final_block start_idx = {(i,Idx_Var) | start_idx.vidx ≤ i} ∪ {(i,Idx_Type) | start_idx.tidx ≤ i} ∪ {(i,Idx_Exn) | start_idx.eidx ≤ i}
idx_prev_def_typed=∀(idx :next_indices) (idx2 :next_indices). idx_prev idx idx2 ⇔ idx.vidx ≤ idx2.vidx ∧ idx.tidx ≤ idx2.tidx ∧ idx.eidx ≤ idx2.eidx
idx_prev_refl_typed=idx_prev (idx :next_indices) idx
idx_prev_trans_typed=idx_prev (idx :next_indices) (idx2 :next_indices) ∧ idx_prev idx2 (idx3 :next_indices) ⇒ idx_prev idx idx3
idx_range_rel_def_typed=∀(interp :(semanticPrimitives$v -> (config # α) option) option) (genv :global_env) (s_n_ts :num) (s_n_en :num) (s_eval :eval_state option) (idxs :next_indices # next_indices # (num # idx_types -> bool)). idx_range_rel interp genv s_n_ts s_n_en s_eval idxs ⇔ ∃(idx :next_indices) (end_idx :next_indices) (fin_idx :next_indices) (other_blocks :num # idx_types -> bool). idxs = (idx,end_idx,other_blocks) ∧ (case src_orac_next_cfg interp s_eval of (NONE :config option) => T | SOME c => fin_idx = c.next) ∧ idx_prev end_idx fin_idx ∧ ALL_DISJOINT [idx_block idx end_idx; idx_final_block fin_idx; other_blocks; genv_allocated_idxs genv] ∧ (∀(cn :mlstring) (t :num). t ≥ s_n_ts ⇒ TypeStamp cn t ∉ FRANGE genv.c) ∧ ∀(cn :num). cn ≥ s_n_en ⇒ ExnStamp cn ∉ FRANGE genv.c
idx_range_rel_v_REPLICATE_NONE_typed=idx_range_rel (interp :(semanticPrimitives$v -> (config # α) option) option) (genv :global_env) (nts :num) (nes :num) (eval_state :eval_state option) ((idx :next_indices),(end_idx :next_indices),(others :num # idx_types -> bool)) ∧ fin_idx_match (LENGTH genv.v) end_idx (src_orac_next_cfg interp eval_state) ∧ (n :num) + idx.vidx ≤ end_idx.vidx ⇒ ∃(pre :v option list) (post :v option list). genv.v = pre ++ REPLICATE n (NONE :v option) ++ post ∧ LENGTH pre = idx.vidx
idx_range_shrink_typed=idx_range_rel (i :(semanticPrimitives$v -> (config # α) option) option) (genv :global_env) (nts :num) (nes :num) (eval_config :eval_state option) ((l_idx :next_indices),(r_idx :next_indices),(etc :num # idx_types -> bool)) ∧ idx_prev l_idx (l_idx' :next_indices) ∧ idx_prev l_idx' r_idx ⇒ idx_range_rel i genv nts nes eval_config (l_idx',r_idx,etc)
idx_types_typed=Idx_Var::idx_types; Idx_Type::idx_types; Idx_Exn::idx_types
idx_types_FORALL_typed=(∀(x :idx_types). (P :idx_types -> bool) x) ⇔ P Idx_Var ∧ P Idx_Type ∧ P Idx_Exn
inc_compile_esgc_free_typed=EVERY esgc_free (SND (inc_compile (env_id :num # num) (c :config) (p :dec list)))
inc_compile_globals_BAG_ALL_DISTINCT_typed=BAG_ALL_DISTINCT (elist_globals (SND (inc_compile (env_id :num # num) (c :config) (prog :dec list))))
inc_compile_no_Mat_typed=no_Mat_decs (SND (inc_compile (env_id :num # num) (c :config) (prog :dec list)))
inc_compile_prog_env_submap_typed=inc_compile_prog (env_id :num # num) (c :config) (p :dec list) = ((c' :config),(p' :exp list)) ∧ env_store_inv c.envs ⇒ env_store_inv c'.envs ∧ subspt c.envs.env_gens c'.envs.env_gens
inc_compile_prog_esgc_free_typed=EVERY esgc_free (SND (inc_compile_prog (env_id :num # num) (c :config) (p :dec list)))
inc_compile_prog_idx_prev_typed=inc_compile_prog (env_id :num # num) (c0 :config) (decs :dec list) = ((c1 :config),(fdecs :exp list)) ⇒ idx_prev c0.next c1.next
inc_compile_prog_nonempty_typed=inc_compile_prog (env_id :num # num) (st :config) (decs :dec list) = ((st' :config),(fdecs :exp list)) ⇒ fdecs ≠ ([] :exp list)
init_eval_state_ok_def_typed=(init_eval_state_ok (NONE :eval_state option) ⇔ T) ∧ (init_eval_state_ok (SOME (EvalDecs (v0 :eval_decs_state))) ⇔ F) ∧ (init_eval_state_ok (SOME (EvalOracle (s :eval_oracle_state))) ⇔ s.generation = (0 :num) ∧ s.envs = [([] :semanticPrimitives$v sem_env list)])
init_genv_def_typed=init_genv = <|v := ([] :v option list); c := (FEMPTY :(num # num option) # num |-> stamp) |++ init_genv_els; tys := (FEMPTY :num |-> (num # num) list) |++ MAP ((I :num -> num) ## MAP ((I :num -> num) ## (FST :num # stamp -> num))) init_genv_ty_els|>
init_genv_els_def_typed=init_genv_els = FLAT (MAP (λ((id :num),(xs :(num # num # stamp) list)). MAP (λ((tag :num),(arity :num),(stamp :stamp)). (((tag,SOME id),arity),stamp)) xs) init_genv_ty_els) ++ [(((div_tag,(NONE :num option)),(0 :num)),div_stamp); (((chr_tag,(NONE :num option)),(0 :num)),chr_stamp); (((subscript_tag,(NONE :num option)),(0 :num)),subscript_stamp); (((bind_tag,(NONE :num option)),(0 :num)),bind_stamp)]
init_genv_next_typed=init_genv_next = <|vidx := (0 :num); tidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 i => i | ExnStamp v5 => (0 :num)) init_genv_els)); eidx := SUC (MAX_LIST (MAP (λ(v :((num # num option) # num) # stamp). case SND v of TypeStamp v3 v4 => (0 :num) | ExnStamp i => i) init_genv_els))|>
init_genv_ok_typed=genv_c_ok init_genv.c
init_genv_ty_els_def_typed=init_genv_ty_els = [(bool_id,[(false_tag,(0 :num),TypeStamp «False» bool_type_num); (true_tag,(0 :num),TypeStamp «True» bool_type_num)]); (list_id,REVERSE [(cons_tag,(2 :num),TypeStamp «::» list_type_num); (nil_tag,(0 :num),TypeStamp «[]» list_type_num)])]
init_genv_tys_ok_typed=genv_c_tys_ok init_genv.c init_genv.tys
init_global_env_inv_def_typed=∀(genv :global_env) (comp_map :source_to_flat$environment) (env :α sem_env). init_global_env_inv genv comp_map env ⇔ env.v = (nsEmpty :(mlstring, mlstring, α) namespace) ∧ case env.c of Bind ns ms => ms = ([] :(mlstring # (mlstring, mlstring, num # stamp) namespace) list) ∧ EVERY (λ((x :mlstring),(arity :num),(stamp :stamp)). case nsLookup comp_map.c (Short x :(mlstring, mlstring) id) of (NONE :(num # (num # (num # num) list) option) option) => F | SOME (cn,ty_gp) => FLOOKUP genv.c ((cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),arity) = SOME stamp ∧ case ty_gp of (NONE :(num # (num # num) list) option) => T | SOME (ty_id,ctors) => FLOOKUP genv.tys ty_id = SOME ctors) ns
init_global_env_inv_imp_typed=init_global_env_inv (genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) ⇒ global_env_inv genv comp_map (∅ :mlstring -> bool) env
invariant_IMP_s_rel_typed=invariant (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idx :next_indices # next_indices # (num # idx_types -> bool)) (st :β semanticPrimitives$state) (st' :(α, β) flatSem$state) ⇒ s_rel genv st st'
invariant_begin_alloc_blanks_typed=precondition1 (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (s1 :β semanticPrimitives$state) (env1 :γ sem_env) (cfg :config) (eval_conf :α install_config) (prog :dec list) ∧ (cfg' :config) = FST (compile_prog cfg prog) ∧ (init_globs :v option list) = SOME (Loc T (0 :num) :v)::REPLICATE (cfg'.next.vidx − (1 :num)) (NONE :v option) ⇒ invariant interp g <|next := (0 :num); generation := cfg.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|> (init_genv with v := init_globs) (cfg.next with vidx := (1 :num),cfg'.next,(∅ :num # idx_types -> bool)) s1 (initial_state s1.ffi s1.clock eval_conf with <|refs := [Refv (Conv (NONE :(num # num option) option) ([] :v list))]; globals := init_globs|>)
invariant_change_clock_typed=invariant (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (env :next_indices # next_indices # (num # idx_types -> bool)) (st1 :β semanticPrimitives$state) (st2 :(α, β) flatSem$state) ⇒ invariant interp g gen genv env (st1 with clock := (k :num)) (st2 with clock := k)
invariant_change_eval_ref_typed=invariant (interp :(semanticPrimitives$v -> (config # α) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idxs :next_indices # next_indices # (num # idx_types -> bool)) (st :β semanticPrimitives$state) (st' :(α, β) flatSem$state) ⇒ invariant interp g gen genv idxs st (st' with refs := Refv (y :v)::TL st'.refs)
