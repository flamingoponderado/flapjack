compile_decs_generation_typed=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (ds :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (ds_i1 :exp list). compile_decs t n next env envs ds = (n',next',env',envs',ds_i1) ⇒ envs'.generation = envs.generation
compile_decs_idx_prev_typed=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (ds :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (ds_i1 :exp list). compile_decs t n next env envs ds = (n',next',env',envs',ds_i1) ⇒ idx_prev next next'
