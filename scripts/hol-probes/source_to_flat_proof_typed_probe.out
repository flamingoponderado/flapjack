do_eval_typed=∀(vs' :v list). (do_eval (vs :semanticPrimitives$v list) (s :α semanticPrimitives$state).eval_state :(semanticPrimitives$v sem_env # dec list # eval_state option) option) = SOME ((env :semanticPrimitives$v sem_env),(decs :dec list),(eval_state :eval_state option)) ∧ invariant (interp :(semanticPrimitives$v -> (config # β) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idxs :next_indices # next_indices # (num # idx_types -> bool)) s (t :(β, α) flatSem$state) ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs' ⇒ ∃(genv' :global_env) (env_id :num # num) (c :config) (decs' :exp list) (eval_config' :β install_config) (c' :config) (idx :next_indices) (end_idx :next_indices) (fin_idx :γ) (other :num # idx_types -> bool). idxs = (idx,end_idx,other) ∧ (do_eval (DROP (4 :num) vs') t.eval_config :(exp list # β install_config # v) option) = SOME (decs',eval_config',Unitv) ∧ LENGTH vs' = (6 :num) ∧ inc_compile_prog env_id c decs = (c',decs') ∧ decs' ≠ ([] :exp list) ∧ invariant interp g <|next := (0 :num); generation := c.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|> genv' (c.next,c'.next,idx_block idx end_idx ∪ other) (s with eval_state := eval_state) (t with <|eval_config := eval_config'; globals := t.globals ++ REPLICATE (c'.next.vidx − c.next.vidx) (NONE :v option)|>) ∧ env_gen_rel <|next := (0 :num); generation := c.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|> eval_state ∧ (let ((_0 :num),(_1 :next_indices),(_2 :source_to_flat$environment),(gen :environment_generation_store),(_3 :exp list)) = compile_decs ([] :mlstring list) (1 :num) c.next (lookup_env_id env_id c.envs) <|next := (0 :num); generation := c.envs.next; envs := (LN :source_to_flat$environment sptree$num_map)|> decs in env_gen_future_rel interp gen eval_state) ∧ global_env_inv genv' (lookup_env_id env_id c.envs) (∅ :mlstring -> bool) env ∧ src_orac_next_cfg interp eval_state = SOME c' ∧ idx_prev end_idx c'.next ∧ genv.c ⊑ genv'.c ∧ genv.tys ⊑ genv'.tys ∧ subglobals genv.v genv'.v ∧ orac_config_envs_subspt interp s.eval_state eval_state ∧ case s.eval_state of (NONE :eval_state option) => F | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => ∃(s' :eval_oracle_state). eval_state = SOME (EvalOracle s') ∧ s'.envs = (add_env_generation s).envs ∧ s'.generation = (add_env_generation s).generation
do_opapp_typed=∀(genv :global_env) (vs :semanticPrimitives$v list) (vs_i1 :v list) (env :semanticPrimitives$v sem_env) (e :ast$exp). (do_opapp vs :(semanticPrimitives$v sem_env # ast$exp) option) = SOME (env,e) ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs_i1 ⇒ ∃(comp_map :source_to_flat$environment) (env_i1 :v environment) (locals :mlstring list) (t1 :mlstring list) (ts :tra list). env_all_rel genv comp_map env env_i1 locals ∧ LENGTH ts = LENGTH locals ∧ (do_opapp vs_i1 :(v environment # exp) option) = SOME (env_i1,(compile_exp t1 (comp_map with v := bind_locals ts locals comp_map.v) e :exp))
do_test_lemma_typed=do_test (test :test) (ty :prim_type) (v1 :semanticPrimitives$v) (v2 :semanticPrimitives$v) = Eq_val (b :bool) ∧ genv_c_ok (genv :global_env).c ∧ (v_rel genv v1 (w1 :v) :bool) ∧ (v_rel genv v2 (w2 :v) :bool) ⇒ do_test test ty w1 w2 = Eq_val b
drestrict_lem_typed=(f1 :α |-> β) ⊑ (f2 :α |-> β) ⇒ DRESTRICT f2 (COMPL (FDOM f1)) ⊌ f1 = f2
drop_4_via_el_typed=LENGTH (vs :α list) = (6 :num) ⇒ [vs❲(4 :num)❳; LAST vs] = DROP (4 :num) vs
env_all_rel_typed=∀(genv :global_env) (map :source_to_flat$environment) (env_v_local :(mlstring, mlstring, semanticPrimitives$v) namespace) (env :semanticPrimitives$v sem_env) (env' :(mlstring # v) list) (locals :mlstring list). (∃(l :(mlstring # semanticPrimitives$v) list). env_v_local = (alist_to_ns l :(mlstring, mlstring, semanticPrimitives$v) namespace) ∧ MAP (FST :mlstring # semanticPrimitives$v -> mlstring) l = locals) ∧ global_env_inv genv map (set locals) env ∧ env_rel genv env_v_local env' ⇒ env_all_rel genv map <|c := env.c; v := nsAppend env_v_local env.v|> <|v := env'|> locals
