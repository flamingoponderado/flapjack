MAPi_SNOC_typed=∀(xs :α list) (x :α) (f :num -> α -> β). MAPi f (SNOC x xs) = SNOC (f (LENGTH xs) x) (MAPi f xs)
NOT_NULL_EQ_typed=¬NULL (xs :α list) ⇔ ∃(y :α) (ys :α list). xs = y::ys
SND_eq_typed=SND (x :β # α) = (y :α) ⇔ ∃(a :β). x = (a,y)
SUB_BAG_IMP_typed=(B1 :α -> num) ≤ (B2 :α -> num) ⇒ (x :α) ⋲ B1 ⇒ x ⋲ B2
abort_compile_dec_result_typed=abort (combine_dec_result (env :semanticPrimitives$v sem_env) (r :(semanticPrimitives$v sem_env, α) result)) ⇔ abort r
abort_def_typed=∀(r :(α, β) result). abort r ⇔ case r of (Rval v2 :(α, β) result) => F | (Rerr (Rraise v6) :(α, β) result) => F | (Rerr (Rabort a :β error_result) :(α, β) result) => T
abort_simps_typed=(abort (Rerr (Rabort (a :abort) :β error_result) :(α, β) result) ⇔ T) ∧ (abort (Rerr (Rraise (e :δ)) :(γ, δ) result) ⇔ F) ∧ (abort (Rval (v :ε) :(ε, ζ) result) ⇔ F)
alloc_tags1_imp_typed=∀(ctors :(α # β list) list) (ns :(γ, α, num) namespace) (spt :num sptree$num_map) (tag_list :(num # num) list). (alloc_tags1 ctors :(γ, α, num) namespace # num sptree$num_map # (num # num) list) = (ns,spt,tag_list) ∧ ALL_DISTINCT (MAP (FST :α # β list -> α) ctors) ⇒ ∃(cn_tags :(α # num # num) list). ns = (alist_to_ns (MAP (λ((cn :α),(tag :num),(arity :num)). (cn,tag)) cn_tags) :(γ, α, num) namespace) ∧ set (MAP (SND :α # num # num -> num # num) cn_tags) = {(tag,arity) | ∃(max :num). lookup arity spt = SOME max ∧ tag < max} ∧ tag_list = MAP (SND :α # num # num -> num # num) cn_tags ∧ ALL_DISTINCT tag_list ∧ LIST_REL (λ((cn :α),(ts :β list)) ((cn' :α),(_0 :num),(arity :num)). cn = cn' ∧ arity = LENGTH ts) ctors cn_tags ∧ MAP (FST :α # β list -> α) ctors = MAP (FST :α # num # num -> α) cn_tags
