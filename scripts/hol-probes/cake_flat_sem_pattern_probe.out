stamp_rules_typed=(∀(cn :α) (cn' :α) (n_ps :γ) (n_vs :γ). pmatch_stamps_ok (SOME (cn,(NONE :(β # (α # γ) list) option))) (SOME (cn',(NONE :β option))) n_ps n_vs) ∧ (∀(cn :α) (cn' :α) (ctor_set :(α # γ) list) (n_ps :γ) (n_vs :γ) (ty_id :β) (ty_id' :β). ty_id = ty_id' ∧ MEM (cn,n_ps) ctor_set ∧ MEM (cn',n_vs) ctor_set ⇒ pmatch_stamps_ok (SOME (cn,SOME (ty_id,ctor_set))) (SOME (cn',SOME ty_id')) n_ps n_vs) ∧ ∀(n_ps :γ) (n_vs :γ). n_ps = n_vs ⇒ pmatch_stamps_ok (NONE :(α # (β # (α # γ) list) option) option) (NONE :(α # β option) option) n_ps n_vs
stamp_cases_typed=∀(a0 :(α # (β # (α # γ) list) option) option) (a1 :(α # β option) option) (a2 :γ) (a3 :γ). pmatch_stamps_ok a0 a1 a2 a3 ⇔ (∃(cn :α) (cn' :α). a0 = SOME (cn,(NONE :(β # (α # γ) list) option)) ∧ a1 = SOME (cn',(NONE :β option))) ∨ (∃(cn :α) (cn' :α) (ctor_set :(α # γ) list) (ty_id :β) (ty_id' :β). a0 = SOME (cn,SOME (ty_id,ctor_set)) ∧ a1 = SOME (cn',SOME ty_id') ∧ ty_id = ty_id' ∧ MEM (cn,a2) ctor_set ∧ MEM (cn',a3) ctor_set) ∨ a0 = (NONE :(α # (β # (α # γ) list) option) option) ∧ a1 = (NONE :(α # β option) option) ∧ a2 = a3
pmatch_typed=(∀(x :mlstring) (v' :v) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch s (Pvar x :pat) v' bindings :(mlstring # v) list match_result) = Match ((x,v')::bindings)) ∧ (∀(v' :v) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch s Pany v' bindings :(mlstring # v) list match_result) = Match bindings) ∧ (∀(s :(α, β) state) (l' :lit) (l :lit) (bindings :(mlstring # v) list). (pmatch s (Plit l :pat) (Litv l' :v) bindings :(mlstring # v) list match_result) = if l = l' then Match bindings else if lit_same_type l l' then (No_match :(mlstring # v) list match_result) else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(vs :v list) (stmp' :(num # num option) option) (stmp :(num # (num # (num # num) list) option) option) (s :(α, β) state) (ps :pat list) (bindings :(mlstring # v) list). (pmatch s (Pcon stmp ps) (Conv stmp' vs) bindings :(mlstring # v) list match_result) = if ¬pmatch_stamps_ok stmp stmp' (LENGTH ps) (LENGTH vs) then (Match_type_error :(mlstring # v) list match_result) else if OPTION_MAP (FST :num # (num # (num # num) list) option -> num) stmp = OPTION_MAP (FST :num # num option -> num) stmp' ∧ LENGTH ps = LENGTH vs then (pmatch_list s ps vs bindings :(mlstring # v) list match_result) else (No_match :(mlstring # v) list match_result)) ∧ (∀(v :v) (s :(α, β) state) (p :pat) (i :mlstring) (bindings :(mlstring # v) list). (pmatch s (Pas p i) v bindings :(mlstring # v) list match_result) = (pmatch s p v ((i,v)::bindings) :(mlstring # v) list match_result)) ∧ (∀(v0 :bool) (s :(α, β) state) (p :pat) (lnum :num) (bindings :(mlstring # v) list). (pmatch s (Pref p) (Loc v0 lnum :v) bindings :(mlstring # v) list match_result) = case store_lookup lnum s.refs of (NONE :v store_v option) => (Match_type_error :(mlstring # v) list match_result) | SOME (Refv v) => (pmatch s p v bindings :(mlstring # v) list match_result) | SOME (W8array v9 :v store_v) => (Match_type_error :(mlstring # v) list match_result) | SOME (Varray v10) => (Match_type_error :(mlstring # v) list match_result) | SOME (Thunk v11 v12) => (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v34 :v list) (v33 :(num # num option) option) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Conv v33 v34) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v37 :exp) (v36 :mlstring) (v35 :v environment) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Closure v35 v36 v37 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v40 :mlstring) (v39 :(mlstring # mlstring # exp) list) (v38 :v environment) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Recclosure v38 v39 v40 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v42 :num) (v41 :bool) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Loc v41 v42 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v43 :v list) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Vectorv v43) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v56 :lit) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Litv v56 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v61 :exp) (v60 :mlstring) (v59 :v environment) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Closure v59 v60 v61 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v64 :mlstring) (v63 :(mlstring # mlstring # exp) list) (v62 :v environment) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Recclosure v62 v63 v64 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v66 :num) (v65 :bool) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Loc v65 v66 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v67 :v list) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Vectorv v67) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v80 :lit) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Litv v80 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v82 :v list) (v81 :(num # num option) option) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Conv v81 v82) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v85 :exp) (v84 :mlstring) (v83 :v environment) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Closure v83 v84 v85 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v88 :mlstring) (v87 :(mlstring # mlstring # exp) list) (v86 :v environment) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Recclosure v86 v87 v88 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v91 :v list) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Vectorv v91) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(s :(α, β) state) (bindings :(mlstring # v) list). (pmatch_list s ([] :pat list) ([] :v list) bindings :(mlstring # v) list match_result) = Match bindings) ∧ (∀(vs :v list) (v :v) (s :(α, β) state) (ps :pat list) (p :pat) (bindings :(mlstring # v) list). (pmatch_list s (p::ps) (v::vs) bindings :(mlstring # v) list match_result) = case (pmatch s p v bindings :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (case (pmatch_list s ps vs bindings :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match bindings' => (pmatch_list s ps vs bindings' :(mlstring # v) list match_result)) ∧ (∀(v115 :pat list) (v114 :pat) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch_list s (v114::v115) ([] :v list) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ ∀(v111 :v list) (v110 :v) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch_list s ([] :pat list) (v110::v111) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)
rows_typed=(∀(v :v) (s :(β, γ) state). pmatch_rows ([] :(pat # α) list) s v = (No_match :((mlstring # v) list # pat # α) match_result)) ∧ ∀(v :v) (s :(β, γ) state) (pes :(pat # α) list) (p :pat) (e :α). pmatch_rows ((p,e)::pes) s v = case (pmatch s p v ([] :(mlstring # v) list) :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => pmatch_rows pes s v | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :((mlstring # v) list # pat # α) match_result) | Match env => case pmatch_rows pes s v of (No_match :((mlstring # v) list # pat # α) match_result) => Match (env,p,e) | (Match_type_error :((mlstring # v) list # pat # α) match_result) => (Match_type_error :((mlstring # v) list # pat # α) match_result) | Match v1 => Match (env,p,e)
wildcard=Match []
literal_same=Match []
literal_mismatch=No_match
literal_wrong_type=Match_type_error
tuple_length=Match_type_error
different_constructor=No_match
wrong_constructor_type=Match_type_error
list_error_precedence=Match_type_error
