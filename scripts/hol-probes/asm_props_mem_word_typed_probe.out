SND_read_mem_word_consts_typed=∀(n :num) (a :α word) (s :α asm_state). ((SND (read_mem_word a n s :β word # α asm_state)).be ⇔ s.be) ∧ (SND (read_mem_word a n s :γ word # α asm_state)).lr = s.lr ∧ (SND (read_mem_word a n s :δ word # α asm_state)).align = s.align ∧ (SND (read_mem_word a n s :ε word # α asm_state)).mem_domain = s.mem_domain
write_mem_word_consts_typed=∀(n :num) (a :α word) (w :β word) (s :α asm_state). ((write_mem_word a n w s).be ⇔ s.be) ∧ (write_mem_word a n w s).lr = s.lr ∧ (write_mem_word a n w s).align = s.align ∧ (write_mem_word a n w s).mem_domain = s.mem_domain
