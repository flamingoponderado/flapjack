ctxt_fc_eids_eq_typed=(ctxt_fc (cvs :mlstring |-> (mlstring # shape) list # shape) (em :mlstring |-> α word) (vs :mlstring list) (shs :shape list) (ns :num list)).eids = em
ctxt_fc_def_typed=∀(cvs :mlstring |-> (mlstring # shape) list # shape) (em :mlstring |-> α word) (vs :mlstring list) (shs :shape list) (ns :num list). ctxt_fc cvs em vs shs ns = <|vars := (FEMPTY :mlstring |-> shape # num list) |++ ZIP (vs,ZIP (shs,with_shape shs ns)); funcs := cvs; eids := em; vmax := MAX_LIST ns|>
ctxt_fc_funcs_eq_typed=(ctxt_fc (cvs :mlstring |-> (mlstring # shape) list # shape) (em :mlstring |-> α word) (vs :mlstring list) (shs :shape list) (ns :num list)).funcs = cvs
ctxt_fc_vmax_typed=(ctxt_fc (ctxt :β context).funcs (em :mlstring |-> α word) (vs :mlstring list) (shs :shape list) (ns :num list)).vmax = MAX_LIST ns
EL_load_globals_typed=∀(n :num) (m :num) (w :word5). n < m ⇒ (load_globals w m :α crepLang$exp list)❲n❳ = (LoadGlob (w + (n2w n :word5)) :α crepLang$exp)
evaluate_replicate_const_typed=∀(n :num) (s :(α, β) state). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) (REPLICATE n (Const (0w :α word) :α crepLang$exp)) = SOME (REPLICATE n (Word (0w :α word) :α word_lab))
filter_not_mem_self_typed=FILTER (λ(x :α). ¬MEM x (l :α list)) l = ([] :α list)
first_compile_to_crep_all_distinct_typed=ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (prog :α decl list))) ⇒ ALL_DISTINCT (MAP (FST :mlstring # num list # α crepLang$prog -> mlstring) (compile_to_crep prog))
is_wf_shape_nil_length_flatten_typed=is_wf_shape_nil (shape_of (v :α v)) ∧ (size_of_shape (shape_of v) = (0 :num) ⇒ (l :α word_lab list) = ([] :α word_lab list)) ∧ ((0 :num) < size_of_shape (shape_of v) ⇒ l = flatten v) ⇒ LENGTH l = size_of_shape (shape_of v)
load_shape_el_rel_typed=∀(m :num) (n :num) (a :α word) (t :β) (e :α crepLang$exp). n < m ⇒ (load_shape a m e)❲n❳ = if a + (bytes_in_word :α word) * (n2w n :α word) = (0w :α word) then (Load e :α crepLang$exp) else (Load (Op Add [e; (Const (a + (bytes_in_word :α word) * (n2w n :α word)) :α crepLang$exp)]) :α crepLang$exp)
MAP_SOME_MEM_lemma_typed=MAP (f :β -> α option) (FLAT (xs :β list list)) = MAP (SOME :α -> α option) (FLAT (ys :α list list)) ∧ MEM (zs :β list) xs ∧ MEM (z :β) zs ⇒ ∃(r :γ) (y :α). f z = SOME y ∧ MEM y (FLAT ys)
MAX_LIST_APPEND_typed=MAX_LIST ((a :num list) ++ (b :num list)) = MAX (MAX_LIST a) (MAX_LIST b)
MAX_LIST_NOT_MEM_typed=(x :num) > MAX_LIST (l :num list) ⇒ ¬MEM x l
mem_comp_field_typed=∀(sh :shape list) (i :num) (e :α crepLang$exp list) (shp :shape) (ce :α crepLang$exp) (es :α crepLang$exp list) (vs :β v list). i < LENGTH vs ∧ LENGTH e = size_of_shape (shape_of (RStruct vs)) ∧ comp_field i sh e = (es,shp) ∧ Comb sh = shape_of (RStruct vs) ∧ MEM ce es ⇒ MEM ce e
mem_comp_field_lem_typed=∀(i :num) (l :shape list) (es :α crepLang$exp list) (x :α crepLang$exp). MEM x (FST (comp_field i l es)) ⇒ MEM x es ∨ x = (Const (0w :α word) :α crepLang$exp)
mod_eq_lt_eq_typed=∀(n :num) (x :num) (m :num). n < x ∧ m < x ∧ n MOD x = m MOD x ⇒ n = m
not_none_then_some_typed=(x :α option) ≠ (NONE :α option) ⇔ ∃(a :α). x = SOME a
code_rel_def_typed=∀(ctxt :α context) (s_code :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) (t_code :mlstring |-> num list # α crepLang$prog). code_rel ctxt s_code t_code ⇔ ∀(f :mlstring) (vshs :(mlstring # shape) list) (prog :α panLang$prog) (rsh :shape). FLOOKUP s_code f = SOME (vshs,prog,rsh) ⇒ localised_prog prog ∧ FLOOKUP ctxt.funcs f = SOME (vshs,rsh) ∧ (let (vs :mlstring list) = MAP (FST :mlstring # shape -> mlstring) vshs; (shs :shape list) = MAP (SND :mlstring # shape -> shape) vshs; (ns :num list) = GENLIST (I :num -> num) (size_of_shape (Comb shs)); (nctxt :α context) = ctxt_fc ctxt.funcs ctxt.eids vs shs ns in FLOOKUP t_code f = SOME (ns,compile nctxt prog))
code_rel_empty_locals_typed=code_rel (ctxt :α context) (s :(α, β) panSem$state).code (t :(α, γ) state).code ⇒ code_rel ctxt (empty_locals s).code (empty_locals t).code
code_rel_imp_typed=code_rel (ctxt :α context) (s_code :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) (t_code :mlstring |-> num list # α crepLang$prog) ⇒ ∀(f :mlstring) (vshs :(mlstring # shape) list) (prog :α panLang$prog). FLOOKUP s_code f = SOME (vshs,prog,(rsh :shape)) ⇒ localised_prog prog ∧ FLOOKUP ctxt.funcs f = SOME (vshs,rsh) ∧ (let (vs :mlstring list) = MAP (FST :mlstring # shape -> mlstring) vshs; (shs :shape list) = MAP (SND :mlstring # shape -> shape) vshs; (ns :num list) = GENLIST (I :num -> num) (size_of_shape (Comb shs)); (nctxt :α context) = ctxt_fc ctxt.funcs ctxt.eids vs shs ns in FLOOKUP t_code f = SOME (ns,compile nctxt prog))
mk_ctxt_code_imp_code_rel_typed=∀(pan_code :α decl list). ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ EVERY ((localised_prog :α panLang$prog -> bool) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions pan_code) ⇒ code_rel (mk_ctxt (FEMPTY :mlstring |-> shape # num list) (make_funcs (functions pan_code)) (0 :num) (get_eids_from_decls pan_code)) (alist_to_fmap (functions pan_code)) (alist_to_fmap (compile_to_crep pan_code))
compile_exp_val_rel_typed=∀(s :(α, β) panSem$state) (e :α panLang$exp) (v :α v) (t :(α, β) state) (ct :α context) (es :α crepLang$exp list) (sh :shape). (eval s e :α v option) = SOME v ∧ state_rel s t ∧ code_rel ct s.code t.code ∧ (locals_rel ct s.locals t.locals :bool) ∧ localised_exp e ∧ compile_exp ct e = (es,sh) ⇒ MAP (eval t :α crepLang$exp -> α word_lab option) es = MAP (SOME :α word_lab -> α word_lab option) (flatten v) ∧ LENGTH es = size_of_shape sh ∧ shape_of v = sh ∧ is_wf_shape_nil sh
eval_map_comp_exp_flat_eq_typed=∀(argexps :α panLang$exp list) (args :α v list) (s :(α, β) panSem$state) (t :(α, β) state) (ctxt :α context). MAP (eval s :α panLang$exp -> α v option) argexps = MAP (SOME :α v -> α v option) args ∧ state_rel s t ∧ code_rel ctxt s.code t.code ∧ (locals_rel ctxt s.locals t.locals :bool) ∧ EVERY (localised_exp :α panLang$exp -> bool) argexps ⇒ MAP (eval t :α crepLang$exp -> α word_lab option) (FLAT (MAP (FST :α crepLang$exp list # shape -> α crepLang$exp list) (MAP (compile_exp ctxt :α panLang$exp -> α crepLang$exp list # shape) argexps))) = MAP (SOME :α word_lab -> α word_lab option) (FLAT (MAP (flatten :α v -> α word_lab list) args))
compile_prog_distinct_params_typed=EVERY (λ((name :mlstring),(params :num list),(body :α crepLang$prog)). ALL_DISTINCT params) (compile_prog (prog :α decl list))
eval_distinct_lists_not_affect_typed=∀(vs :num list) (s :(α, β) state) (e :α crepLang$exp) (w :γ) (nvals :α word_lab list). LENGTH vs = LENGTH nvals ∧ distinct_lists vs (var_cexp e) ⇒ (eval (s with locals := s.locals |++ ZIP (vs,nvals)) e :α word_lab option) = (eval s e :α word_lab option)
opt_mmap_eval_distinct_lists_not_affect_typed=∀(es :α crepLang$exp list) (s :(α, β) state) (ws :α word_lab list) (vs :num list) (nvals :α word_lab list). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME ws ∧ LENGTH vs = LENGTH nvals ∧ distinct_lists vs (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ⇒ OPT_MMAP (eval (s with locals := s.locals |++ ZIP (vs,nvals)) :α crepLang$exp -> α word_lab option) es = SOME ws
eval_nested_assign_distinct_eq_typed=∀(es :α crepLang$exp list) (ns :num list) (t :(α, β) state) (ev :α word_lab list) (vs :α word_lab list). MAP (eval t :α crepLang$exp -> α word_lab option) es = MAP (SOME :α word_lab -> α word_lab option) ev ∧ OPT_MMAP (FLOOKUP t.locals) ns = SOME vs ∧ distinct_lists ns (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ∧ ALL_DISTINCT ns ∧ LENGTH ns = LENGTH es ⇒ (evaluate (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns es :α crepLang$prog list),t) :α result option # (α, β) state) = ((NONE :α result option),t with locals := t.locals |++ ZIP (ns,ev))
eval_nested_decs_seq_res_var_eq_typed=∀(es :α crepLang$exp list) (ns :num list) (t :(α, β) state) (ev :α word_lab list) (p :α crepLang$prog). MAP (eval t :α crepLang$exp -> α word_lab option) es = MAP (SOME :α word_lab -> α word_lab option) ev ∧ LENGTH ns = LENGTH es ∧ distinct_lists ns (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ∧ ALL_DISTINCT ns ⇒ (let ((q :α result option),(r :(α, β) state)) = (evaluate (p,t with locals := t.locals |++ ZIP (ns,ev)) :α result option # (α, β) state) in (evaluate (nested_decs ns es p,t) :α result option # (α, β) state) = (q,r with locals := FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) r.locals (ZIP (ns,MAP (FLOOKUP t.locals) ns))))
evaluate_nested_decs_load_globals_typed=globals_lookup (s :(α, β) state) (rv :γ v) = SOME (rvs :α word_lab list) ∧ size_of_shape (shape_of rv) ≤ (32 :num) ∧ ALL_DISTINCT (vs :num list) ∧ LENGTH vs = size_of_shape (shape_of rv) ⇒ (evaluate (nested_decs vs (load_globals (0w :word5) (size_of_shape (shape_of rv)) :α crepLang$exp list) (p :α crepLang$prog),s) :α result option # (α, β) state) = (let ((res :α result option),(s' :(α, β) state)) = (evaluate (p,s with locals := s.locals |++ ZIP (vs,rvs)) :α result option # (α, β) state) in (res,s' with locals := FOLDL (res_var :(num |-> α word_lab) -> num # α word_lab option -> (num |-> α word_lab)) s'.locals (ZIP (vs,MAP (FLOOKUP s.locals) vs))))
globals_lookup_def_typed=∀(t :(α, β) state) (v :γ v). globals_lookup t v = OPT_MMAP (FLOOKUP t.globals) (GENLIST (λ(x :num). (n2w x :word5)) (size_of_shape (shape_of v)))
first_compile_prog_all_distinct_typed=ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (prog :α decl list))) ⇒ ALL_DISTINCT (MAP (FST :mlstring # num list # α crepLang$prog -> mlstring) (compile_prog prog))
not_mem_context_assigned_mem_gt_typed=∀(ctxt :α context) (p :α panLang$prog) (x :num). ctxt_max ctxt.vmax ctxt.vars ∧ (∀(v :mlstring) (sh :shape) (ns' :num list). FLOOKUP ctxt.vars v = SOME (sh,ns') ⇒ ¬MEM x ns') ∧ x ≤ ctxt.vmax ⇒ ¬MEM x (assigned_free_vars (compile ctxt p))
pc_compile_correct_typed=∀(v'' :α panLang$prog) (v1 :(α, β) panSem$state) (res :α panSem$result option) (s1 :(α, β) panSem$state) (t :(α, β) state) (ctxt :α context). (evaluate (v'',v1) :α panSem$result option # (α, β) panSem$state) = (res,s1) ∧ res ≠ SOME (Error :α panSem$result) ∧ state_rel v1 t ∧ code_rel ctxt v1.code t.code ∧ excp_rel ctxt.eids v1.eshapes ∧ (locals_rel ctxt v1.locals t.locals :bool) ∧ localised_prog v'' ⇒ ∃(res1 :α result option) (t1 :(α, β) state). (evaluate (compile ctxt v'',t) :α result option # (α, β) state) = (res1,t1) ∧ state_rel s1 t1 ∧ code_rel ctxt s1.code t1.code ∧ excp_rel ctxt.eids s1.eshapes ∧ case res of (NONE :α panSem$result option) => res1 = (NONE :α result option) ∧ (locals_rel ctxt s1.locals t1.locals :bool) | SOME (Error :α panSem$result) => F | SOME (TimeOut :α panSem$result) => res1 = SOME (TimeOut :α result) | SOME (Break :α panSem$result) => res1 = SOME (Break (0 :num) :α result) ∧ (locals_rel ctxt s1.locals t1.locals :bool) | SOME (Continue :α panSem$result) => res1 = SOME (Continue (0 :num) :α result) ∧ (locals_rel ctxt s1.locals t1.locals :bool) | SOME (Return v :α panSem$result) => res1 = SOME (Return (flatten v) :α result) | SOME (Exception eid v' :α panSem$result) => (case FLOOKUP ctxt.eids eid of (NONE :α word option) => F | SOME n => res1 = SOME (Exception n :α result) ∧ ((1 :num) ≤ size_of_shape (shape_of v') ⇒ globals_lookup t1 v' = SOME (flatten v') ∧ size_of_shape (shape_of v') ≤ (32 :num))) | SOME (FinalFFI f :α panSem$result) => res1 = SOME (FinalFFI f :α result)
pan_primop_crep_primop_typed=∀(pop :primop) (vs :α v list) (value :α v). pan_primop pop vs = SOME value ⇒ crep_primop pop (FLAT (MAP (flatten :α v -> α word_lab list) vs)) = SOME (flatten value)
ctxt_max_el_leq_typed=ctxt_max (ctxt :α context).vmax ctxt.vars ∧ FLOOKUP ctxt.vars (v :mlstring) = SOME ((sh :shape),(ns :num list)) ∧ (n :num) < LENGTH ns ⇒ ns❲n❳ ≤ ctxt.vmax
locals_rel_extend_new_var_typed=∀(ct :α context) (s :mlstring |-> β v) (t :num |-> β word_lab) (v :β v) (x :mlstring) (ns :num list). (locals_rel ct s t :bool) ∧ is_wf_shape_nil (shape_of v) ∧ ALL_DISTINCT ns ∧ (∀(x :num). MEM x ns ⇒ ct.vmax < x ∧ x ≤ ct.vmax + size_of_shape (shape_of v)) ∧ LENGTH ns = size_of_shape (shape_of v) ⇒ (locals_rel (ct with <|vars := ct.vars⟨x ↦ (shape_of v,ns)⟩; vmax := ct.vmax + size_of_shape (shape_of v)|>) s⟨x ↦ v⟩ (t |++ ZIP (ns,flatten v)) :bool)
no_overlap_wrap_rt_some_all_distinct_typed=no_overlap (fm :α |-> shape # β list) ∧ wrap_rt (FLOOKUP fm (r :α)) = SOME ((vsh :shape),(ns :β list)) ⇒ ALL_DISTINCT ns
opt_mmap_eval_is_wf_shape_v_typed=OPT_MMAP (eval (s :(α, β) panSem$state) :α panLang$exp -> α v option) (es :α panLang$exp list) = SOME (vs :α v list) ∧ state_rel s (t :(α, β) state) ∧ (locals_rel (ctxt :γ context) s.locals (t_locs :num |-> α word_lab) :bool) ⇒ EVERY is_wf_shape_v_nil vs
excp_rel_def_typed=∀(ceids :α |-> β) (seids :α |-> γ). excp_rel ceids seids ⇔ FDOM seids = FDOM ceids ∧ ∀(e :α) (e' :α) (n :β) (n' :β). FLOOKUP ceids e = SOME n ∧ FLOOKUP ceids e' = SOME n' ∧ n = n' ⇒ e = e'
local_rel_gt_vmax_preserved_typed=∀(ct :α context) (l :mlstring |-> β v) (l' :num |-> β word_lab) (n :num) (v :β word_lab). (locals_rel ct l l' :bool) ∧ ct.vmax < n ⇒ (locals_rel ct l l'⟨n ↦ v⟩ :bool)
locals_rel_def_typed=∀(ctxt :β context) (s_locals :mlstring |-> α v) (t_locals :num |-> α word_lab). (locals_rel ctxt s_locals t_locals :bool) ⇔ no_overlap ctxt.vars ∧ ctxt_max ctxt.vmax ctxt.vars ∧ ∀(vname :mlstring) (v :α v). FLOOKUP s_locals vname = SOME v ⇒ ∃(ns :num list) (vs :α word_lab list). FLOOKUP ctxt.vars vname = SOME (shape_of v,ns) ∧ OPT_MMAP (FLOOKUP t_locals) ns = SOME vs ∧ flatten v = vs ∧ is_wf_shape_nil (shape_of v)
locals_rel_lookup_ctxt_typed=(locals_rel (ctxt :α context) (lcl :mlstring |-> β v) (lcl' :num |-> β word_lab) :bool) ∧ FLOOKUP lcl (vr :mlstring) = SOME (v :β v) ⇒ ∃(ns :num list). FLOOKUP ctxt.vars vr = SOME (shape_of v,ns) ∧ LENGTH ns = LENGTH (flatten v) ∧ OPT_MMAP (FLOOKUP lcl') ns = SOME (flatten v) ∧ is_wf_shape_nil (shape_of v)
locals_rel_wf_shape_typed=(locals_rel (ctxt :α context) (s_locs :mlstring |-> β v) (t_locs :num |-> β word_lab) :bool) ∧ FLOOKUP s_locs (nm :mlstring) = SOME (v :β v) ⇒ is_wf_shape_v_nil v
state_rel_def_typed=∀(s :(α, 'ffi) panSem$state) (t :(α, 'ffi) state). state_rel s t ⇔ s.memory = t.memory ∧ s.memaddrs = t.memaddrs ∧ s.sh_memaddrs = t.sh_memaddrs ∧ s.structs = ([] :(mlstring # struct_info) list) ∧ s.globals = (FEMPTY :mlstring |-> α v) ∧ s.clock = t.clock ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.base_addr = t.base_addr ∧ s.top_addr = t.top_addr
slc_def_typed=∀(vshs :(α # γ) list) (args :β list). slc vshs args = (FEMPTY :α |-> β) |++ ZIP (MAP (FST :α # γ -> α) vshs,args)
slc_tlc_rw_typed=(FEMPTY :α |-> β v) |++ ZIP (MAP (FST :α # γ -> α) (vsh :(α # γ) list),(args :β v list)) = slc vsh args ∧ (FEMPTY :δ |-> β word_lab) |++ ZIP ((ns :δ list),FLAT (MAP (flatten :β v -> β word_lab list) args)) = tlc ns args
tlc_def_typed=∀(ns :α list) (args :β v list). tlc ns args = (FEMPTY :α |-> β word_lab) |++ ZIP (ns,FLAT (MAP (flatten :β v -> β word_lab list) args))
get_eids_imp_excp_rel_typed=∀(seids :mlstring |-> β) (pc :α decl list). size_of_eids pc < dimword (:α) ∧ FDOM seids = FDOM (get_eids_from_decls pc) ⇒ excp_rel (get_eids_from_decls pc) seids
mk_ctxt_imp_locals_rel_typed=∀(pc :(mlstring # (mlstring # shape) list # α # shape) list) (lcl :num |-> β word_lab) (es :mlstring |-> γ word). (locals_rel (mk_ctxt (FEMPTY :mlstring |-> shape # num list) (make_funcs pc) (0 :num) es) (FEMPTY :mlstring |-> β v) lcl :bool)
state_rel_imp_semantics_decls_to_crep_typed=∀(s :(α, β) panSem$state) (t :(α, β) state) (pan_code :α decl list) (start :mlstring). state_rel (s with structs := ([] :(mlstring # struct_info) list)) t ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ t.code = alist_to_fmap (compile_to_crep pan_code) ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ s.eshapes = (FEMPTY :mlstring |-> shape) ∧ EVERY ((localised_prog :α panLang$prog -> bool) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions pan_code) ∧ EVERY (λ(x :α decl). is_function x ∨ is_exn_decl x) pan_code ∧ size_of_eids pan_code < dimword (:α) ∧ semantics_decls s start pan_code ≠ Fail ⇒ semantics t start = semantics_decls s start pan_code
state_rel_imp_semantics_to_crep_typed=∀(s :(α, β) panSem$state) (t :(α, β) state) (pan_code :α decl list) (start :mlstring). state_rel s t ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ s.code = alist_to_fmap (functions pan_code) ∧ t.code = alist_to_fmap (compile_to_crep pan_code) ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ EVERY ((localised_prog :α panLang$prog -> bool) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions pan_code) ∧ size_of_eids pan_code < dimword (:α) ∧ FDOM s.eshapes = FDOM (get_eids_from_decls pan_code) ∧ semantics s start ≠ Fail ⇒ semantics t start = semantics s start
state_rel_imp_semantics_decls_typed=∀(s :(α, β) panSem$state) (t :(α, β) state) (pan_code :α decl list) (start :mlstring). state_rel (s with structs := ([] :(mlstring # struct_info) list)) t ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ t.code = alist_to_fmap (compile_prog pan_code) ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ s.eshapes = (FEMPTY :mlstring |-> shape) ∧ EVERY ((localised_prog :α panLang$prog -> bool) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions pan_code) ∧ EVERY (λ(x :α decl). is_function x ∨ is_exn_decl x) pan_code ∧ size_of_eids pan_code < dimword (:α) ∧ semantics_decls s start pan_code ≠ Fail ⇒ semantics t start = semantics_decls s start pan_code
state_rel_imp_semantics_typed=∀(s :(α, β) panSem$state) (t :(α, β) state) (pan_code :α decl list) (start :mlstring). state_rel s t ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ s.code = alist_to_fmap (functions pan_code) ∧ t.code = alist_to_fmap (compile_prog pan_code) ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ EVERY ((localised_prog :α panLang$prog -> bool) ∘ (FST :α panLang$prog # shape -> α panLang$prog) ∘ (SND :(mlstring # shape) list # α panLang$prog # shape -> α panLang$prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α panLang$prog # shape -> (mlstring # shape) list # α panLang$prog # shape)) (functions pan_code) ∧ size_of_eids pan_code < dimword (:α) ∧ FDOM s.eshapes = FDOM (get_eids_from_decls pan_code) ∧ semantics s start ≠ Fail ⇒ semantics t start = semantics s start
eval_map_var_cexp_present_ctxt_typed=∀(es :α panLang$exp list) (vs :α v list) (s :(α, β) panSem$state) (t :(α, β) state) (ctxt :α context). MAP (eval s :α panLang$exp -> α v option) es = MAP (SOME :α v -> α v option) vs ∧ state_rel s t ∧ code_rel ctxt s.code t.code ∧ (locals_rel ctxt s.locals t.locals :bool) ∧ EVERY (localised_exp :α panLang$exp -> bool) es ⇒ ∀(n :num). MEM n (FLAT (MAP (var_cexp :α crepLang$exp -> num list) (FLAT (MAP (FST :α crepLang$exp list # shape -> α crepLang$exp list) (MAP (compile_exp ctxt :α panLang$exp -> α crepLang$exp list # shape) es))))) ⇒ ∃(vname :mlstring) (shp :shape) (ns :num list). FLOOKUP ctxt.vars vname = SOME (shp,ns) ∧ MEM n ns
eval_var_cexp_present_ctxt_typed=∀(s :(α, β) panSem$state) (e :α panLang$exp) (v :α v) (t :(α, β) state) (ct :α context) (es :α crepLang$exp list) (sh :shape). state_rel s t ∧ (eval s e :α v option) = SOME v ∧ code_rel ct s.code t.code ∧ (locals_rel ct s.locals t.locals :bool) ∧ localised_exp e ∧ compile_exp ct e = (es,sh) ⇒ ∀(n :num). MEM n (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ⇒ ∃(v :mlstring) (shp :shape) (ns :num list). FLOOKUP ct.vars v = SOME (shp,ns) ∧ MEM n ns
call_preserve_state_code_locals_rel_typed=∀(rshape :shape). ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) (vshs :(mlstring # shape) list)) ∧ LIST_REL (λ(vshape :mlstring # shape) (arg :α v). SND vshape = shape_of arg) vshs (args :α v list) ∧ state_rel (s :(α, β) panSem$state) (t :(α, β) state) ∧ code_rel (ctxt :α context) s.code t.code ∧ excp_rel ctxt.eids s.eshapes ∧ (locals_rel ctxt s.locals t.locals :bool) ∧ FLOOKUP s.code (fname :mlstring) = SOME (vshs,(prog :α panLang$prog),rshape) ∧ FLOOKUP ctxt.funcs fname = SOME (vshs,rshape) ∧ ALL_DISTINCT (ns :num list) ∧ size_of_shape (Comb (MAP (SND :mlstring # shape -> shape) vshs)) = LENGTH (FLAT (MAP (flatten :α v -> α word_lab list) args)) ∧ FLOOKUP t.code fname = SOME (ns,compile (ctxt_fc ctxt.funcs ctxt.eids (MAP (FST :mlstring # shape -> mlstring) vshs) (MAP (SND :mlstring # shape -> shape) vshs) ns) prog) ∧ LENGTH ns = LENGTH (FLAT (MAP (flatten :α v -> α word_lab list) args)) ∧ EVERY is_wf_shape_v_nil args ⇒ state_rel (dec_clock s with locals := slc vshs args) (dec_clock t with locals := tlc ns args) ∧ code_rel (ctxt_fc ctxt.funcs ctxt.eids (MAP (FST :mlstring # shape -> mlstring) vshs) (MAP (SND :mlstring # shape -> shape) vshs) ns) (dec_clock s).code (dec_clock t).code ∧ excp_rel (ctxt_fc ctxt.funcs ctxt.eids (MAP (FST :mlstring # shape -> mlstring) vshs) (MAP (SND :mlstring # shape -> shape) vshs) ns).eids (dec_clock s).eshapes ∧ (locals_rel (ctxt_fc ctxt.funcs ctxt.eids (MAP (FST :mlstring # shape -> mlstring) vshs) (MAP (SND :mlstring # shape -> shape) vshs) ns) (slc vshs args) (tlc ns args) :bool)
