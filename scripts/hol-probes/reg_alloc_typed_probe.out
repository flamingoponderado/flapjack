revive_moves_def_typed=∀(vs :num list). revive_moves vs = st_ex_bind (st_ex_MAP adj_ls_sub vs) (λ(nbs :num list list). st_ex_bind (get_unavail_moves_wl :ra_state -> ((num # num # num) list, state_exn) exc # ra_state) (λ(uam :(num # num # num) list). st_ex_bind (get_avail_moves_wl :ra_state -> ((num # num # num) list, state_exn) exc # ra_state) (λ(am :(num # num # num) list). (let ((rev :(num # num # num) list),(unavail :(num # num # num) list)) = PARTITION (λ((_0 :num),(x :num),(y :num)). EXISTS (sorted_mem x) nbs ∨ EXISTS (sorted_mem y) nbs) uam; (sorted :(num # num # num) list) = smerge (sort_moves rev) am in st_ex_ignore_bind (set_avail_moves_wl sorted :ra_state -> (unit, state_exn) exc # ra_state) (set_unavail_moves_wl unavail :ra_state -> (unit, state_exn) exc # ra_state)))))
rpt_do_step_def_typed=(∀(scost :num sptree$num_map option) (k :num). rpt_do_step scost k (0 :num) = (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state)) ∧ ∀(scost :num sptree$num_map option) (k :num) (c :num). rpt_do_step scost k (SUC c) = st_ex_bind (do_step scost k) (λ(b :bool). if b then rpt_do_step scost k c else (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state))
unspill_def_typed=∀(k :num). unspill k = st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). st_ex_bind (get_spill_wl :ra_state -> (num list, state_exn) exc # ra_state) (λ(swl :num list). st_ex_bind (st_ex_PARTITION (split_degree d k) swl ([] :num list) ([] :num list)) (λ((ltk :num list),(gtk :num list)). st_ex_ignore_bind (revive_moves ltk) (st_ex_bind (st_ex_PARTITION move_related_sub ltk ([] :num list) ([] :num list)) (λ((ltkfreeze :num list),(ltksimp :num list)). st_ex_ignore_bind (set_spill_wl gtk :ra_state -> (unit, state_exn) exc # ra_state) (st_ex_ignore_bind (add_simp_wl ltksimp :ra_state -> (unit, state_exn) exc # ra_state) (add_freeze_wl ltkfreeze :ra_state -> (unit, state_exn) exc # ra_state)))))))
algorithm_typed=Simple::algorithm; IRC::algorithm
ra_state_typed=recordtype.ra_state::num list list -> tag list -> num list -> num -> num list -> num list -> num list -> (num # num # num) list -> (num # num # num) list -> num list -> bool list -> num list -> ra_state
tag_typed=Fixed::num -> tag; Atemp::tag; Stemp::tag
clash_tree_typed=Delta::num list -> num list -> clash_tree; Set::sptree$num_set -> clash_tree; Branch::sptree$num_set option -> clash_tree -> clash_tree -> clash_tree; Seq::clash_tree -> clash_tree -> clash_tree
check_clash_tree_def_typed=(∀(f :num -> num) (w :num list) (r :num list) (live :sptree$num_set) (flive :sptree$num_set). check_clash_tree f (Delta w r) live flive = case check_partial_col f w live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME v => (let (del_w :sptree$num_set) = numset_list_delete w live; (fdel_w :sptree$num_set) = numset_list_delete (MAP f w) flive in check_partial_col f r del_w fdel_w)) ∧ (∀(f :num -> num) (t :sptree$num_set) (live :sptree$num_set) (flive :sptree$num_set). check_clash_tree f (Set t) live flive = check_col f t) ∧ (∀(f :num -> num) (topt :sptree$num_set option) (t1 :clash_tree) (t2 :clash_tree) (live :sptree$num_set) (flive :sptree$num_set). check_clash_tree f (Branch topt t1 t2) live flive = case check_clash_tree f t1 live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME (t1_out,ft1_out) => case check_clash_tree f t2 live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME (t2_out,ft2_out) => case topt of (NONE :sptree$num_set option) => check_partial_col f (MAP (FST :num # unit -> num) (toAList (difference t2_out t1_out))) t1_out ft1_out | SOME t => check_col f t) ∧ ∀(f :num -> num) (t1 :clash_tree) (t2 :clash_tree) (live :sptree$num_set) (flive :sptree$num_set). check_clash_tree f (Seq t1 t2) live flive = case check_clash_tree f t2 live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME (t2_out,ft2_out) => check_clash_tree f t1 t2_out ft2_out
check_col_def_typed=∀(f :num -> num) (t :α sptree$num_map). check_col f t = (let (names :num list) = MAP (f ∘ (FST :num # α -> num)) (toAList t) in if ALL_DISTINCT names then SOME (t,fromAList (MAP (λ(x :num). (x,())) names)) else (NONE :(α sptree$num_map # sptree$num_set) option))
check_partial_col_def_typed=(∀(f :num -> num) (t :sptree$num_set) (ft :sptree$num_set). check_partial_col f ([] :num list) t ft = SOME (t,ft)) ∧ ∀(f :num -> num) (x :num) (xs :num list) (t :sptree$num_set) (ft :sptree$num_set). check_partial_col f (x::xs) t ft = case lookup x t of (NONE :unit option) => (case lookup (f x) ft of (NONE :unit option) => check_partial_col f xs (insert x () t) (insert (f x) () ft) | SOME v => (NONE :(sptree$num_set # sptree$num_set) option)) | SOME v1 => check_partial_col f xs t ft
numset_list_delete_def_typed=(∀(t :α sptree$num_map). numset_list_delete ([] :num list) t = t) ∧ ∀(x :num) (xs :num list) (t :α sptree$num_map). numset_list_delete (x::xs) t = numset_list_delete xs (delete x t)
canonize_move_def_typed=∀(x :num) (y :num). canonize_move x y = st_ex_bind (is_Fixed x) (λ(bx :bool). st_ex_bind (is_Fixed y) (λ(by :bool). if by then (st_ex_return (y,x) :ra_state -> (num # num, state_exn) exc # ra_state) else if bx then (st_ex_return (x,y) :ra_state -> (num # num, state_exn) exc # ra_state) else if x < y then (st_ex_return (x,y) :ra_state -> (num # num, state_exn) exc # ra_state) else (st_ex_return (y,x) :ra_state -> (num # num, state_exn) exc # ra_state)))
coalesce_parent_def_typed=∀(x :num). coalesce_parent x = st_ex_bind (coalesced_sub x) (λ(xt :num). st_ex_bind (is_Fixed xt) (λ(bx :bool). if bx then (st_ex_return xt :ra_state -> (num, state_exn) exc # ra_state) else if x ≤ xt then (st_ex_return x :ra_state -> (num, state_exn) exc # ra_state) else st_ex_bind (coalesce_parent xt) (λ(anc :num). st_ex_ignore_bind (update_coalesced x anc) (st_ex_return anc :ra_state -> (num, state_exn) exc # ra_state))))
consistency_ok_def_typed=∀(x :num) (y :num). consistency_ok x y = if x = y then (st_ex_return F :ra_state -> (bool, state_exn) exc # ra_state) else st_ex_bind (adj_ls_sub y) (λ(adjy :num list). if sorted_mem x adjy then (st_ex_return F :ra_state -> (bool, state_exn) exc # ra_state) else st_ex_bind (is_Fixed x) (λ(bx :bool). st_ex_bind (is_Fixed y) (λ(by :bool). st_ex_bind (move_related_sub x) (λ(movrelx :bool). st_ex_bind (move_related_sub y) (λ(movrely :bool). (st_ex_return ((bx ∨ movrelx) ∧ (by ∨ movrely) ∧ ¬(bx ∧ by)) :ra_state -> (bool, state_exn) exc # ra_state))))))
inc_deg_def_typed=∀(n :num) (d :num). inc_deg n d = st_ex_bind (degrees_sub n) (λ(cd :num). update_degrees n (cd + d))
reset_move_related_def_typed=∀(ls :(α # num # num) list). reset_move_related ls = st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). st_ex_ignore_bind (st_ex_FOREACH (COUNT_LIST d) (λ(x :num). update_move_related x F)) (st_ex_FOREACH ls (λ((_0 :α),(x :num),(y :num)). st_ex_bind (is_Fixed x) (λ(bx :bool). st_ex_bind (is_Fixed y) (λ(by :bool). st_ex_ignore_bind (update_move_related x (¬bx)) (update_move_related y (¬by)))))))
st_ex_FIRST_def_typed=(∀(P :num -> num -> ra_state -> (bool, state_exn) exc # ra_state) (Q :num -> num -> ra_state -> (α option, state_exn) exc # ra_state) (unavail :(β # num # num) list). st_ex_FIRST P Q ([] :(β # num # num) list) unavail = (st_ex_return ((NONE :((num # num) # α # (β # num # num) list) option),unavail) :ra_state -> (((num # num) # α # (β # num # num) list) option # (β # num # num) list, state_exn) exc # ra_state)) ∧ ∀(P :num -> num -> ra_state -> (bool, state_exn) exc # ra_state) (Q :num -> num -> ra_state -> (α option, state_exn) exc # ra_state) (m :β # num # num) (ms :(β # num # num) list) (unavail :(β # num # num) list). st_ex_FIRST P Q (m::ms) unavail = (let ((p :β),(x :num),(y :num)) = m in st_ex_bind (coalesce_parent x) (λ(x :num). st_ex_bind (coalesce_parent y) (λ(y :num). st_ex_bind (P x y) (λ(b1 :bool). if ¬b1 then st_ex_FIRST P Q ms unavail else st_ex_bind (canonize_move x y) (λ((x :num),(y :num)). st_ex_bind (Q x y) (λ(optb2 :α option). case optb2 of (NONE :α option) => st_ex_FIRST P Q ms ((p,x,y)::unavail) | SOME pr => (st_ex_return (SOME ((x,y),pr,ms),unavail) :ra_state -> (((num # num) # α # (β # num # num) list) option # (β # num # num) list, state_exn) exc # ra_state)))))))
assign_Atemp_tag_def_typed=∀(ks :num list) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) (n :num). assign_Atemp_tag ks prefs n = st_ex_bind (node_tag_sub n) (λ(ntag :tag). case ntag of Fixed v2 => (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state) | Atemp => st_ex_bind (adj_ls_sub n) (λ(adjs :num list). st_ex_bind (remove_colours adjs ks) (λ(ks :num list). case ks of ([] :num list) => update_node_tag n Stemp | x::v1 => st_ex_bind (prefs n ks) (λ(c :num option). case c of (NONE :num option) => update_node_tag n (Fixed x) | SOME y => update_node_tag n (Fixed y)))) | Stemp => (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state))
assign_Atemps_def_typed=∀(k :num) (ls :num list) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state). assign_Atemps k ls prefs = st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). st_ex_bind (st_ex_return (FILTER (λ(n :num). n < d) ls) :ra_state -> (num list, state_exn) exc # ra_state) (λ(ls :num list). st_ex_bind (st_ex_return (GENLIST (λ(x :num). x) k) :ra_state -> (num list, state_exn) exc # ra_state) (λ(ks :num list). st_ex_bind (st_ex_return (GENLIST (λ(x :num). x) d) :ra_state -> (num list, state_exn) exc # ra_state) (λ(cs :num list). st_ex_ignore_bind (st_ex_FOREACH ls (assign_Atemp_tag ks prefs)) (st_ex_FOREACH cs (assign_Atemp_tag ks prefs))))))
first_match_col_def_typed=(∀(ks :num list). first_match_col ks ([] :num list) = (st_ex_return (NONE :num option) :ra_state -> (num option, state_exn) exc # ra_state)) ∧ ∀(ks :num list) (x :num) (xs :num list). first_match_col ks (x::xs) = st_ex_bind (node_tag_sub x) (λ(c :tag). case c of Fixed m => if MEM m ks then (st_ex_return (SOME m) :ra_state -> (num option, state_exn) exc # ra_state) else first_match_col ks xs | Atemp => first_match_col ks xs | Stemp => first_match_col ks xs)
remove_colours_def_typed=(∀(ls :num list). remove_colours ls ([] :num list) = (st_ex_return ([] :num list) :ra_state -> (num list, state_exn) exc # ra_state)) ∧ (∀(v3 :num list) (v2 :num). remove_colours ([] :num list) (v2::v3) = (st_ex_return (v2::v3) :ra_state -> (num list, state_exn) exc # ra_state)) ∧ ∀(xs :num list) (x :num) (v5 :num list) (v4 :num). remove_colours (x::xs) (v4::v5) = st_ex_bind (node_tag_sub x) (λ(cx :tag). st_ex_bind (case cx of Fixed c => remove_colours xs (FILTER (λ(x :num). x ≠ c) (v4::v5)) | Atemp => remove_colours xs (v4::v5) | Stemp => remove_colours xs (v4::v5)) (λ(r :num list). (st_ex_return r :ra_state -> (num list, state_exn) exc # ra_state)))
considered_var_def_typed=∀(k :num) (x :num). considered_var k x = st_ex_bind (is_Atemp x) (λ(bx :bool). st_ex_bind (is_Fixed_k k x) (λ(fx :bool). (st_ex_return (bx ∨ fx) :ra_state -> (bool, state_exn) exc # ra_state)))
deg_or_inf_def_typed=∀(k :num) (x :num). deg_or_inf k x = st_ex_bind (is_Fixed_k k x) (λ(bx :bool). if bx then (st_ex_return k :ra_state -> (num, state_exn) exc # ra_state) else degrees_sub x)
is_Atemp_def_typed=∀(d :num). is_Atemp d = st_ex_bind (node_tag_sub d) (λ(dt :tag). (st_ex_return (dt = Atemp) :ra_state -> (bool, state_exn) exc # ra_state))
is_Fixed_def_typed=∀(x :num). is_Fixed x = st_ex_bind (node_tag_sub x) (λ(xt :tag). (st_ex_return (case xt of Fixed n => T | Atemp => F | Stemp => F) :ra_state -> (bool, state_exn) exc # ra_state))
is_Fixed_k_def_typed=∀(k :num) (x :num). is_Fixed_k k x = st_ex_bind (node_tag_sub x) (λ(xt :tag). (st_ex_return (case xt of Fixed n => n < k | Atemp => F | Stemp => F) :ra_state -> (bool, state_exn) exc # ra_state))
handle_Fail_def_typed=∀(x :ra_state -> (α, state_exn) exc # ra_state) (f :string -> ra_state -> (α, state_exn) exc # ra_state). handle_Fail x f = (λ(state :ra_state). case x state of ((M_success y :(α, state_exn) exc),state) => ((M_success y :(α, state_exn) exc),state) | ((M_failure (Fail e1 :state_exn) :(α, state_exn) exc),state) => f e1 state | ((M_failure Subscript :(α, state_exn) exc),state) => ((M_failure Subscript :(α, state_exn) exc),state))
handle_Subscript_def_typed=∀(x :ra_state -> (α, state_exn) exc # ra_state) (f :ra_state -> (α, state_exn) exc # ra_state). handle_Subscript x f = (λ(state :ra_state). case x state of ((M_success y :(α, state_exn) exc),state) => ((M_success y :(α, state_exn) exc),state) | ((M_failure (Fail e1 :state_exn) :(α, state_exn) exc),state) => ((M_failure (Fail e1 :state_exn) :(α, state_exn) exc),state) | ((M_failure Subscript :(α, state_exn) exc),state) => f state)
raise_Fail_def_typed=∀(e1 :string). (raise_Fail e1 :ra_state -> (α, state_exn) exc # ra_state) = (λ(state :ra_state). ((M_failure (Fail e1 :state_exn) :(α, state_exn) exc),state))
raise_Subscript_def_typed=(raise_Subscript :ra_state -> (α, state_exn) exc # ra_state) = (λ(state :ra_state). ((M_failure Subscript :(α, state_exn) exc),state))
state_exn_typed=Fail::string -> state_exn; Subscript::state_exn
clique_insert_edge_def_typed=clique_insert_edge ([] :num list) = (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state) ∧ ∀(x :num) (xs :num list). clique_insert_edge (x::xs) = st_ex_ignore_bind (list_insert_edge x xs) (clique_insert_edge xs)
extend_clique_def_typed=(∀(cli :num list). extend_clique ([] :num list) cli = (st_ex_return cli :ra_state -> (num list, state_exn) exc # ra_state)) ∧ ∀(x :num) (xs :num list) (cli :num list). extend_clique (x::xs) cli = if MEM x cli then extend_clique xs cli else st_ex_ignore_bind (list_insert_edge x cli) (extend_clique xs (x::cli))
extend_graph_def_typed=(∀(ta :α -> num). extend_graph ta ([] :(α # α) list) = (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state)) ∧ ∀(y :α) (xs :(α # α) list) (x :α) (ta :α -> num). extend_graph ta ((x,y)::xs) = st_ex_ignore_bind (insert_edge (ta x) (ta y)) (extend_graph ta xs)
init_ra_state_def_typed=∀(ct :clash_tree) (forced :(num # num) list) (fs :sptree$num_set) (ta :num sptree$num_map) (fa :num sptree$num_map) (n :num). init_ra_state ct forced fs (ta,fa,n) = st_ex_ignore_bind (mk_graph (sp_default ta) ct ([] :num list)) (st_ex_ignore_bind (extend_graph (sp_default ta) forced) (mk_tags n fs (sp_default fa)))
insert_edge_def_typed=∀(x :num) (y :num). insert_edge x y = st_ex_bind (adj_ls_sub x) (λ(adjx :num list). st_ex_bind (adj_ls_sub y) (λ(adjy :num list). st_ex_ignore_bind (update_adj_ls x (sorted_insert y ([] :num list) adjx)) (update_adj_ls y (sorted_insert x ([] :num list) adjy))))
list_insert_edge_def_typed=(∀(x :num). list_insert_edge x ([] :num list) = (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state)) ∧ ∀(x :num) (y :num) (ys :num list). list_insert_edge x (y::ys) = st_ex_ignore_bind (insert_edge x y) (list_insert_edge x ys)
mk_graph_def_typed=(∀(ta :num -> num) (w :num list) (r :num list) (liveout :num list). mk_graph ta (Delta w r) liveout = st_ex_bind (st_ex_return (MAP ta w) :ra_state -> (num list, state_exn) exc # ra_state) (λ(wta :num list). st_ex_bind (st_ex_return (MAP ta r) :ra_state -> (num list, state_exn) exc # ra_state) (λ(rta :num list). st_ex_bind (extend_clique wta liveout) (λ(live :num list). st_ex_bind (st_ex_return (FILTER (λ(x :num). ¬MEM x wta) live) :ra_state -> (num list, state_exn) exc # ra_state) (λ(live :num list). st_ex_bind (extend_clique rta live) (λ(livein :num list). (st_ex_return livein :ra_state -> (num list, state_exn) exc # ra_state))))))) ∧ (∀(ta :num -> num) (t :sptree$num_set) (liveout :num list). mk_graph ta (Set t) liveout = st_ex_bind (st_ex_return (MAP ta (MAP (FST :num # unit -> num) (toAList t))) :ra_state -> (num list, state_exn) exc # ra_state) (λ(live :num list). st_ex_ignore_bind (clique_insert_edge live) (st_ex_return live :ra_state -> (num list, state_exn) exc # ra_state))) ∧ (∀(ta :num -> num) (topt :sptree$num_set option) (t1 :clash_tree) (t2 :clash_tree) (liveout :num list). mk_graph ta (Branch topt t1 t2) liveout = st_ex_bind (mk_graph ta t1 liveout) (λ(t1_live :num list). st_ex_bind (mk_graph ta t2 liveout) (λ(t2_live :num list). case topt of (NONE :sptree$num_set option) => st_ex_bind (extend_clique t1_live t2_live) (λ(livein :num list). (st_ex_return livein :ra_state -> (num list, state_exn) exc # ra_state)) | SOME t => st_ex_bind (st_ex_return (MAP ta (MAP (FST :num # unit -> num) (toAList t))) :ra_state -> (num list, state_exn) exc # ra_state) (λ(clashes :num list). st_ex_ignore_bind (clique_insert_edge clashes) (st_ex_return clashes :ra_state -> (num list, state_exn) exc # ra_state))))) ∧ ∀(ta :num -> num) (t1 :clash_tree) (t2 :clash_tree) (liveout :num list). mk_graph ta (Seq t1 t2) liveout = st_ex_bind (mk_graph ta t2 liveout) (λ(live :num list). mk_graph ta t1 live)
mk_tags_def_typed=∀(n :num) (fs :sptree$num_set) (fa :num -> num). mk_tags n fs fa = st_ex_bind (st_ex_return (GENLIST (λ(x :num). x) n) :ra_state -> (num list, state_exn) exc # ra_state) (λ(inds :num list). st_ex_FOREACH inds (λ(i :num). (let (v :num) = fa i; (remainder :num) = v MOD (4 :num) in if remainder = (1 :num) then case lookup v fs of (NONE :unit option) => update_node_tag i Atemp | SOME v => update_node_tag i Stemp else if remainder = (3 :num) then update_node_tag i Stemp else update_node_tag i (Fixed (v DIV (2 :num))))))
ira_state_typed=recordtype.ira_state::num # num list -> num # tag -> num # num -> num -> num list -> num list -> num list -> (num # num # num) list -> (num # num # num) list -> num # num -> num # bool -> num list -> ira_state
run_ira_state_def_typed=∀(x :ra_state -> (β, γ) exc # ra_state) (state :ira_state). run_ira_state x state = run x (ra_state (REPLICATE (FST state.adj_ls) (SND state.adj_ls)) (REPLICATE (FST state.node_tag) (SND state.node_tag)) (REPLICATE (FST state.degrees) (SND state.degrees)) state.dim state.simp_wl state.spill_wl state.freeze_wl state.avail_moves_wl state.unavail_moves_wl (REPLICATE (FST state.coalesced) (SND state.coalesced)) (REPLICATE (FST state.move_related) (SND state.move_related)) state.stack)
coalesce_root_def_typed=∀(x :num). coalesce_root x = st_ex_bind (coalesced_sub x) (λ(xt :num). st_ex_bind (is_Fixed xt) (λ(bx :bool). if bx then (st_ex_return xt :ra_state -> (num, state_exn) exc # ra_state) else if x ≤ xt then (st_ex_return x :ra_state -> (num, state_exn) exc # ra_state) else coalesce_root xt))
extract_color_def_typed=∀(ta :num sptree$num_map). extract_color ta = st_ex_bind (st_ex_return (toAList ta) :ra_state -> ((num # num) list, state_exn) exc # ra_state) (λ(taa :(num # num) list). st_ex_bind (st_ex_MAP (λ((k :num),(v :num)). st_ex_bind (node_tag_sub v) (λ(t :tag). (st_ex_return (k,extract_tag t) :ra_state -> (num # num, state_exn) exc # ra_state))) taa) (λ(itags :(num # num) list). (st_ex_return (fromAList itags) :ra_state -> (num sptree$num_map, state_exn) exc # ra_state)))
full_consistency_ok_def_typed=∀(k :num) (x :num) (y :num). full_consistency_ok k x y = if x = y then (st_ex_return F :ra_state -> (bool, state_exn) exc # ra_state) else st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). if x ≥ d ∨ y ≥ d then (st_ex_return F :ra_state -> (bool, state_exn) exc # ra_state) else st_ex_bind (adj_ls_sub y) (λ(adjy :num list). if sorted_mem x adjy then (st_ex_return F :ra_state -> (bool, state_exn) exc # ra_state) else st_ex_bind (is_Fixed_k k x) (λ(bx :bool). st_ex_bind (is_Fixed_k k y) (λ(by :bool). st_ex_bind (is_Atemp x) (λ(ax :bool). st_ex_bind (is_Atemp y) (λ(ay :bool). (st_ex_return ((bx ∨ ax) ∧ (by ∨ ay) ∧ ¬(bx ∧ by)) :ra_state -> (bool, state_exn) exc # ra_state)))))))
update_move_def_typed=∀(spta :num -> num) (p :num) (x :num) (y :num). update_move spta (p,x,y) = (let (spx :num) = spta x; (spy :num) = spta y in if spx ≤ spy then (p,spx,spy) else (p,spy,spx))
moves_to_sp_def_typed=(∀(acc :(α # num) list sptree$num_map). moves_to_sp ([] :(α # num # num) list) acc = acc) ∧ ∀(move :α # num # num) (xs :(α # num # num) list) (acc :(α # num) list sptree$num_map). moves_to_sp (move::xs) acc = (let ((p :α),(x :num),(y :num)) = move in moves_to_sp xs (undir_move_insert p x y acc))
pri_move_insert_def_typed=∀(p :α) (x :num) (y :β) (acc :(α # β) list sptree$num_map). pri_move_insert p x y acc = case lookup x acc of (NONE :(α # β) list option) => insert x [(p,y)] acc | SOME ls => insert x ((p,y)::ls) acc
resort_moves_def_typed=∀(acc :(num # α) list sptree$num_map). resort_moves acc = map (λ(ls :(num # α) list). MAP (SND :num # α -> α) (sort_moves ls)) acc
undir_move_insert_def_typed=∀(p :α) (x :num) (y :num) (acc :(α # num) list sptree$num_map). undir_move_insert p x y acc = pri_move_insert p x y (pri_move_insert p y x acc)
list_remap_def_typed=(∀(ta :num sptree$num_map) (nv :num) (fa :num sptree$num_map). list_remap ([] :num list) (ta,fa,nv) = (ta,fa,nv)) ∧ ∀(xs :num list) (x :num) (ta :num sptree$num_map) (nv :num) (fa :num sptree$num_map). list_remap (x::xs) (ta,fa,nv) = case lookup x ta of (NONE :num option) => list_remap xs (insert x nv ta,insert nv x fa,nv + (1 :num)) | SOME v => list_remap xs (ta,fa,nv)
mk_bij_def_typed=∀(t :clash_tree). mk_bij t = (let ((ta :num sptree$num_map),(fa :num sptree$num_map),(n :num)) = mk_bij_aux t ((LN :num sptree$num_map),(LN :num sptree$num_map),(0 :num)) in (ta,fa,n))
mk_bij_aux_def_typed=(∀(writes :num list) (reads :num list) (tfn :num sptree$num_map # num sptree$num_map # num). mk_bij_aux (Delta writes reads) tfn = list_remap writes (list_remap reads tfn)) ∧ (∀(t :sptree$num_set) (tfn :num sptree$num_map # num sptree$num_map # num). mk_bij_aux (Set t) tfn = list_remap (MAP (FST :num # unit -> num) (toAList t)) tfn) ∧ (∀(topt :sptree$num_set option) (t1 :clash_tree) (t2 :clash_tree) (tfn :num sptree$num_map # num sptree$num_map # num). mk_bij_aux (Branch topt t1 t2) tfn = (let (tfn' :num sptree$num_map # num sptree$num_map # num) = mk_bij_aux t2 (mk_bij_aux t1 tfn) in case topt of (NONE :sptree$num_set option) => tfn' | SOME ts => list_remap (MAP (FST :num # unit -> num) (toAList ts)) tfn')) ∧ ∀(t1 :clash_tree) (t2 :clash_tree) (tfn :num sptree$num_map # num sptree$num_map # num). mk_bij_aux (Seq t1 t2) tfn = mk_bij_aux t1 (mk_bij_aux t2 tfn)
safe_div_def_typed=∀(x :num) (v :num). safe_div x v = if v = (0 :num) then (0 :num) else x DIV v
smerge_def_typed=(∀(ys :(num # α) list). smerge ([] :(num # α) list) ys = ys) ∧ (∀(v3 :(num # α) list) (v2 :num # α). smerge (v2::v3) ([] :(num # α) list) = v2::v3) ∧ ∀(ys :(num # α) list) (xs :(num # α) list) (p' :num) (p :num) (m' :α) (m :α). smerge ((p,m)::xs) ((p',m')::ys) = if p ≥ p' then (p,m)::smerge xs ((p',m')::ys) else (p',m')::smerge ((p,m)::xs) ys
sort_moves_def_typed=∀(ls :(num # α) list). sort_moves ls = sort (λ((p :num),(x :α)) ((p' :num),(x' :α)). p > p') ls
sorted_insert_def_typed=(∀(x :num) (acc :num list). sorted_insert x acc ([] :num list) = REVERSE (x::acc)) ∧ ∀(x :num) (acc :num list) (y :num) (ys :num list). sorted_insert x acc (y::ys) = if x = y then REVERSE acc ++ y::ys else if x > y then REVERSE acc ++ x::y::ys else sorted_insert x (y::acc) ys
sorted_mem_def_typed=(∀(x :num). sorted_mem x ([] :num list) ⇔ F) ∧ ∀(x :num) (y :num) (ys :num list). sorted_mem x (y::ys) ⇔ if x = y then T else if x > y then F else sorted_mem x ys
sp_default_def_typed=∀(t :num sptree$num_map) (i :num). sp_default t i = case lookup i t of (NONE :num option) => if is_phy_var i then i DIV (2 :num) else (0 :num) | SOME x => x
st_ex_list_MAX_deg_def_typed=(∀(d :num) (k :num) (v :num) (acc :num list). st_ex_list_MAX_deg ([] :num list) d k v acc = (st_ex_return (k,acc) :ra_state -> (num # num list, state_exn) exc # ra_state)) ∧ ∀(x :num) (xs :num list) (d :num) (k :num) (v :num) (acc :num list). st_ex_list_MAX_deg (x::xs) d k v acc = if x < d then st_ex_bind (degrees_sub x) (λ(xv :num). if v < xv then st_ex_list_MAX_deg xs d x xv (k::acc) else st_ex_list_MAX_deg xs d k v (x::acc)) else st_ex_list_MAX_deg xs d k v acc
st_ex_list_MIN_cost_def_typed=(∀(scost :num sptree$num_map) (d :num) (k :num) (v :num) (acc :num list). st_ex_list_MIN_cost scost ([] :num list) d k v acc = (st_ex_return (k,acc) :ra_state -> (num # num list, state_exn) exc # ra_state)) ∧ ∀(scost :num sptree$num_map) (x :num) (xs :num list) (d :num) (k :num) (v :num) (acc :num list). st_ex_list_MIN_cost scost (x::xs) d k v acc = if x < d then st_ex_bind (degrees_sub x) (λ(xv :num). st_ex_bind (st_ex_return (safe_div (lookup_any x scost (0 :num)) xv) :ra_state -> (num, state_exn) exc # ra_state) (λ(cost :num). if v > cost then st_ex_list_MIN_cost scost xs d x cost (k::acc) else st_ex_list_MIN_cost scost xs d k v (x::acc))) else st_ex_list_MIN_cost scost xs d k v acc
is_not_coalesced_def_typed=∀(d :num). is_not_coalesced d = st_ex_bind (coalesced_sub d) (λ(dt :num). (st_ex_return (d = dt) :ra_state -> (bool, state_exn) exc # ra_state))
split_degree_def_typed=∀(d :num) (k :num) (v :num). split_degree d k v = if v < d then st_ex_bind (degrees_sub v) (λ(vd :num). st_ex_bind (is_not_coalesced v) (λ(b :bool). (st_ex_return (vd < k ∧ b) :ra_state -> (bool, state_exn) exc # ra_state))) else (st_ex_return T :ra_state -> (bool, state_exn) exc # ra_state)
st_ex_FILTER_def_typed=(∀(P :β -> α -> (bool, γ) exc # α) (acc :β list). st_ex_FILTER P ([] :β list) acc = (st_ex_return acc :α -> (β list, γ) exc # α)) ∧ ∀(P :β -> α -> (bool, γ) exc # α) (x :β) (xs :β list) (acc :β list). st_ex_FILTER P (x::xs) acc = st_ex_bind (P x) (λ(Px :bool). if Px then st_ex_FILTER P xs (x::acc) else st_ex_FILTER P xs acc)
st_ex_FOREACH_def_typed=(∀(a :γ -> α -> (δ, β) exc # α). st_ex_FOREACH ([] :γ list) a = (st_ex_return () :α -> (unit, β) exc # α)) ∧ ∀(x :γ) (xs :γ list) (a :γ -> α -> (δ, β) exc # α). st_ex_FOREACH (x::xs) a = st_ex_ignore_bind (a x) (st_ex_FOREACH xs a)
st_ex_MAP_def_typed=(∀(f :δ -> α -> (β, γ) exc # α). st_ex_MAP f ([] :δ list) = (st_ex_return ([] :β list) :α -> (β list, γ) exc # α)) ∧ ∀(f :δ -> α -> (β, γ) exc # α) (x :δ) (xs :δ list). st_ex_MAP f (x::xs) = st_ex_bind (f x) (λ(fx :β). st_ex_bind (st_ex_MAP f xs) (λ(fxs :β list). (st_ex_return (fx::fxs) :α -> (β list, γ) exc # α)))
st_ex_PARTITION_def_typed=(∀(P :β -> α -> (bool, γ) exc # α) (tt :β list) (ff :β list). st_ex_PARTITION P ([] :β list) tt ff = (st_ex_return (tt,ff) :α -> (β list # β list, γ) exc # α)) ∧ ∀(P :β -> α -> (bool, γ) exc # α) (x :β) (xs :β list) (tt :β list) (ff :β list). st_ex_PARTITION P (x::xs) tt ff = st_ex_bind (P x) (λ(Px :bool). if Px then st_ex_PARTITION P xs (x::tt) ff else st_ex_PARTITION P xs tt (x::ff))
assign_Stemp_tag_def_typed=∀(k :num) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state) (n :num). assign_Stemp_tag k prefs n = st_ex_bind (node_tag_sub n) (λ(ntag :tag). case ntag of Fixed v1 => (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state) | Atemp => (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state) | Stemp => st_ex_bind (adj_ls_sub n) (λ(adjs :num list). st_ex_bind (st_ex_MAP node_tag_sub adjs) (λ(tags :tag list). (let (bads :num list) = sort (λ(x :num) (y :num). x ≤ y) (MAP tag_col tags) in st_ex_bind (prefs n bads) (λ(c :num option). case c of (NONE :num option) => update_node_tag n (Fixed (unbound_colour k bads)) | SOME y => update_node_tag n (Fixed y))))))
assign_Stemps_def_typed=∀(k :num) (prefs :num -> num list -> ra_state -> (num option, state_exn) exc # ra_state). assign_Stemps k prefs = st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). st_ex_bind (st_ex_return (GENLIST (λ(x :num). x) d) :ra_state -> (num list, state_exn) exc # ra_state) (λ(cs :num list). st_ex_FOREACH cs (assign_Stemp_tag k prefs)))
neg_biased_pref_def_typed=∀(k :num) (mtable :num list sptree$num_map) (n :num) (bads :num list). neg_biased_pref k mtable n bads = st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). if n < d then (let (vs :num list) = case lookup n mtable of (NONE :num list option) => ([] :num list) | SOME vs => vs in handle_Subscript (neg_first_match_col k bads vs) (st_ex_return (NONE :num option) :ra_state -> (num option, state_exn) exc # ra_state)) else (st_ex_return (NONE :num option) :ra_state -> (num option, state_exn) exc # ra_state))
neg_first_match_col_def_typed=(∀(k :num) (bads :num list). neg_first_match_col k bads ([] :num list) = (st_ex_return (NONE :num option) :ra_state -> (num option, state_exn) exc # ra_state)) ∧ ∀(k :num) (bads :num list) (x :num) (xs :num list). neg_first_match_col k bads (x::xs) = st_ex_bind (node_tag_sub x) (λ(c :tag). case c of Fixed m => if MEM m bads ∨ m < k then neg_first_match_col k bads xs else (st_ex_return (SOME m) :ra_state -> (num option, state_exn) exc # ra_state) | Atemp => neg_first_match_col k bads xs | Stemp => neg_first_match_col k bads xs)
extract_tag_def_typed=∀(t :tag). extract_tag t = case t of Fixed m => m | Atemp => (0 :num) | Stemp => (0 :num)
tag_col_def_typed=tag_col (Fixed (n :num)) = n ∧ tag_col Atemp = (0 :num) ∧ tag_col Stemp = (0 :num)
unbound_colour_def_typed=(∀(col :num). unbound_colour col ([] :num list) = col) ∧ ∀(col :num) (x :num) (xs :num list). unbound_colour col (x::xs) = if col < x then col else if x = col then unbound_colour (col + (1 :num)) xs else unbound_colour col xs
add_freeze_wl_def_typed=∀(ls :num list). (add_freeze_wl ls :ra_state -> (unit, α) exc # ra_state) = st_ex_bind (get_freeze_wl :ra_state -> (num list, α) exc # ra_state) (λ(fwl :num list). (set_freeze_wl (ls ++ fwl) :ra_state -> (unit, α) exc # ra_state))
add_simp_wl_def_typed=∀(ls :num list). (add_simp_wl ls :ra_state -> (unit, α) exc # ra_state) = st_ex_bind (get_simp_wl :ra_state -> (num list, α) exc # ra_state) (λ(swl :num list). (set_simp_wl (ls ++ swl) :ra_state -> (unit, α) exc # ra_state))
add_spill_wl_def_typed=∀(ls :num list). (add_spill_wl ls :ra_state -> (unit, α) exc # ra_state) = st_ex_bind (get_spill_wl :ra_state -> (num list, α) exc # ra_state) (λ(swl :num list). (set_spill_wl (ls ++ swl) :ra_state -> (unit, α) exc # ra_state))
add_unavail_moves_wl_def_typed=∀(ls :(num # num # num) list). (add_unavail_moves_wl ls :ra_state -> (unit, α) exc # ra_state) = st_ex_bind (get_unavail_moves_wl :ra_state -> ((num # num # num) list, α) exc # ra_state) (λ(swl :(num # num # num) list). (set_unavail_moves_wl (ls ++ swl) :ra_state -> (unit, α) exc # ra_state))
dec_deg_def_typed=∀(n :num). dec_deg n = st_ex_bind (degrees_sub n) (λ(cd :num). update_degrees n (cd − (1 :num)))
dec_degree_def_typed=∀(n :num). dec_degree n = st_ex_bind (get_dim :ra_state -> (num, state_exn) exc # ra_state) (λ(d :num). if n < d then st_ex_bind (adj_ls_sub n) (λ(adjs :num list). st_ex_FOREACH adjs dec_deg) else (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state))
push_stack_def_typed=∀(x :num). push_stack x = st_ex_bind (get_stack :ra_state -> (num list, state_exn) exc # ra_state) (λ(swl :num list). st_ex_ignore_bind (update_degrees x (0 :num)) (st_ex_ignore_bind (update_move_related x F) (set_stack (x::swl) :ra_state -> (unit, state_exn) exc # ra_state)))
respill_def_typed=∀(k :num) (x :num). respill k x = st_ex_bind (degrees_sub x) (λ(xd :num). if xd < k then (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state) else st_ex_bind (get_freeze_wl :ra_state -> (num list, state_exn) exc # ra_state) (λ(freeze :num list). if MEM x freeze then st_ex_ignore_bind (add_spill_wl [x] :ra_state -> (unit, state_exn) exc # ra_state) (set_freeze_wl (FILTER (λ(y :num). y ≠ x) freeze) :ra_state -> (unit, state_exn) exc # ra_state) else (st_ex_return () :ra_state -> (unit, state_exn) exc # ra_state)))
