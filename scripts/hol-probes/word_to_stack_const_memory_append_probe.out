cm_full_const_writes_append=⊢ ∀h t a off m. const_writes a off (h ++ t) m = const_writes (a + bytes_in_word * n2w (LENGTH h)) off t (const_writes a off h m)
cm_full_const_addresses_append=⊢ ∀xs ys dm a. const_addresses a (xs ++ ys) dm ⇔ const_addresses a xs dm ∧ const_addresses (a + bytes_in_word * n2w (LENGTH xs)) ys dm
