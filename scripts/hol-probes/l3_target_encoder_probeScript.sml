fun q s = "\"" ^ String.toString s ^ "\"";
fun ty t = if is_vartype t then "(tv " ^ q(dest_vartype t) ^ ")"
 else let val {Thy,Tyop,Args}=dest_thy_type t in "(ty " ^ q Thy ^ " " ^ q Tyop ^ String.concat(map(fn a=>" " ^ ty a)Args) ^ ")" end;
fun tm t = case dest_term t of
 VAR(n,y)=>"(v " ^ q n ^ " " ^ ty y ^ ")"
 | CONST{Thy,Name,Ty}=>"(c " ^ q Thy ^ " " ^ q Name ^ " " ^ ty Ty ^ ")"
 | COMB(f,x)=>"(a " ^ tm f ^ " " ^ tm x ^ ")"
 | LAMB(v,b)=>"(l " ^ tm v ^ " " ^ tm b ^ ")";
fun original q = let val th=(EVAL THENC DEPTH_CONV(TRY_CONV bitstringLib.v2w_n2w_CONV) THENC EVAL)q
 in if null(hyp th) then rhs(concl th) else raise Fail "original target observation has assumptions" end;
fun ast label q = let val value=original q;val _=listSyntax.dest_list value
 in print(label^"="^tm value^"\n") end;
fun bytes label q = let val value=original q;val(xs,_)=listSyntax.dest_list value
 val numbers=map(fn x=>Arbnum.toString(numSyntax.dest_numeral x))xs
 in print(label^"=["^String.concatWith ";" numbers^"]\n") end;
