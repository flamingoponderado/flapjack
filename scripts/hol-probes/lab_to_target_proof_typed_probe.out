IMP_ffi_entry_pcs_disjoint_Asm_typed=∀(s1 :(α, config, 'ffi) labSem$state) (mc_conf :(α, 'state, β) machine_config). code_similar s1.code (code2 :α sec list) ∧ all_enc_ok mc_conf.target.config (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list) (0 :num) code2 ∧ asm_fetch_aux s1.pc s1.code = SOME (Asm (instr :α asm_or_cbw) (_bytes :word8 list) (_len :num)) ∧ (∀(op :memop) (re :num) (a :α addr). instr ≠ ShareMem op re a) ∧ share_mem_domain_code_rel mc_conf (p :α word) code2 s1.shared_mem_domain ∧ bytes_in_mem (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) (bytes' :word8 list) (t1 :α asm_state).mem t1.mem_domain s1.mem_domain ∧ pos_val (s1.pc + (1 :num)) (0 :num) code2 = LENGTH bytes' + pos_val s1.pc (0 :num) code2 ∧ t1.pc = p + (n2w (pos_val s1.pc (0 :num) code2) :α word) ⇒ ffi_entry_pcs_disjoint mc_conf t1 (LENGTH bytes')
