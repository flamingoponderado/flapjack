share_mem_domain_code_rel_shift_interfer_typed=share_mem_domain_code_rel (mc_conf :(α, β, γ) machine_config) (p :α word) (code2 :α sec list) (s1 :(α, δ, ε) labSem$state).shared_mem_domain ⇒ share_mem_domain_code_rel (mc_conf with next_interfer := (λ(i :num). mc_conf.next_interfer (i + (l :num)))) p code2 s1.shared_mem_domain
