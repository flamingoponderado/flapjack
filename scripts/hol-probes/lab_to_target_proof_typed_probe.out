filter_skip_extract_labels_typed=∀(code :α sec list). MAP ((extract_labels :α line list -> (num # num) list) ∘ (Section_lines :α sec -> α line list)) (filter_skip code) = MAP ((extract_labels :α line list -> (num # num) list) ∘ (Section_lines :α sec -> α line list)) code
