line_encd_def_typed=(line_encd (enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos' :num) (Asm (b' :α asm_or_cbw) (bytes :word8 list) (len :num)) ⇔ enc (cbw_to_asm b') = bytes ∧ len = LENGTH bytes) ∧ (line_encd enc labs ffis pos' (LabAsm (Halt :α asm_with_lab) (v0 :α word) bytes len) ⇔ enc (Jump (-(n2w (pos' + ffi_offset) :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (LabAsm (Install :α asm_with_lab) (v1 :α word) bytes len) ⇔ enc (Jump (-(n2w (pos' + (2 :num) * ffi_offset) :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (LabAsm (CallFFI (s :mlstring) :α asm_with_lab) (v2 :α word) bytes len) ⇔ enc (Jump (-(n2w (pos' + (get_ffi_index ffis (ExtCall s) + (3 :num)) * ffi_offset) :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (LabAsm (Jump (l :lab) :α asm_with_lab) (v3 :α word) bytes len) ⇔ enc (Jump ((n2w (find_pos l labs) :α word) + -(n2w pos' :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (LabAsm (JumpCmp (a :cmp) (b :num) (c :α reg_imm) l :α asm_with_lab) (v4 :α word) bytes len) ⇔ enc (JumpCmp a b c ((n2w (find_pos l labs) :α word) + -(n2w pos' :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (LabAsm (LocValue (k :num) l :α asm_with_lab) (v5 :α word) bytes len) ⇔ enc (Loc k ((n2w (find_pos l labs) :α word) + -(n2w pos' :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (LabAsm (Call l :α asm_with_lab) (v6 :α word) bytes len) ⇔ enc (Call ((n2w (find_pos l labs) :α word) + -(n2w pos' :α word)) :α asm) = bytes ∧ LENGTH bytes ≤ len) ∧ (line_encd enc labs ffis pos' (Label (v15 :num) (v16 :num) (v17 :num) :α line) ⇔ T)
