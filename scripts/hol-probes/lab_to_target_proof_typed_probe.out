(t1.regs a :α word) else mc_conf.target.get_reg ms' a); fp_regs := (λ(n :num). mc_conf.target.get_fp_reg ms' n); mem := asm_write_bytearray (t1.regs s1.ptr2_reg :α word) new_bytes t1.mem; pc := (t1.regs s1.link_reg :α word)|>) ms')) ∧ (∀(ms2 :β) (t1 :α asm_state) (k :num) (a1 :α word) (a2 :α word). target_state_rel mc_conf.target (t1 with pc := p − (n2w ((2 :num) * ffi_offset) :α word)) ms2 ∧ aligned mc_conf.target.config.code_alignment (t1.regs s1.link_reg :α word) ⇒ (let (ms' :β) = mc_conf.ccache_interfer k (a1,a2,ms2) in target_state_rel mc_conf.target (t1 with <|regs := (λ(a :num). if MEM a mc_conf.callee_saved_regs ∨ a = s1.ptr_reg ∨ ¬(a < mc_conf.target.config.reg_count) ∨ MEM a mc_conf.target.config.avoid_regs then (t1.regs a :α word) else mc_conf.target.get_reg ms' a); fp_regs := (λ(n :num). mc_conf.target.get_fp_reg ms' n); pc := (t1.regs s1.link_reg :α word)|>) ms')) ∧ s1.compile = compile_lab mc_conf.target.config ∧ (no_share_mem_inst code2 ⇒ ∀(k :num). (let ((cfg :config),(code :α sec list)) = (s1.compile_oracle k :config # α sec list) in good_code mc_conf.target.config cfg.labels code ∧ no_share_mem_inst code ∧ (k = (0 :num) ⇒ cfg.labels = labs ∧ cfg.pos = LENGTH (prog_to_bytes code2) ∧ cfg.ffi_names = SOME mc_conf.ffi_names))) ∧ (∀(l1 :num) (l2 :num) (x :num). lab_lookup l1 l2 labs = SOME x ⇒ EVEN x) ∧ (1w :α word) && p = (0w :α word) ∧ list_subset (FILTER (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) (find_ffi_names s1.code)) mc_conf.ffi_names ∧ EVEN (LENGTH (prog_to_bytes code2)) ∧ (∀(name :ffiname) (i :num). MEM name mc_conf.ffi_names ∧ mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ get_ffi_index mc_conf.ffi_names name < i ⇒ (∃(s :mlstring). name = ExtCall s) ∧ p − (n2w (((3 :num) + get_ffi_index mc_conf.ffi_names name) * ffi_offset) :α word) ∉ mc_conf.prog_addresses ∧ p − (n2w (((3 :num) + get_ffi_index mc_conf.ffi_names name) * ffi_offset) :α word) ≠ mc_conf.halt_pc ∧ p − (n2w (((3 :num) + get_ffi_index mc_conf.ffi_names name) * ffi_offset) :α word) ≠ mc_conf.ccache_pc ∧ find_index (p − (n2w (((3 :num) + get_ffi_index mc_conf.ffi_names name) * ffi_offset) :α word)) mc_conf.ffi_entry_pcs (0 :num) = SOME (get_ffi_index mc_conf.ffi_names name)) ∧ p − (n2w ffi_offset :α word) = mc_conf.halt_pc ∧ p − (n2w ((2 :num) * ffi_offset) :α word) = mc_conf.ccache_pc ∧ interference_ok mc_conf.next_interfer (mc_conf.target.proj t1.mem_domain) ∧ (∀(l1 :num) (l2 :num) (x2 :num). loc_to_pc l1 l2 s1.code = SOME x2 ⇒ lab_lookup l1 l2 labs = SOME (pos_val x2 (0 :num) code2)) ∧ (∀(r :num). (s1.fp_regs r :word64) = (t1.fp_regs r :word64)) ∧ (∀(r :num). word_loc_val p labs (read_reg r s1 :α word_loc) = SOME (t1.regs r :α word)) ∧ (∀(a :α word). byte_align a ∈ s1.mem_domain ⇒ a ∈ t1.mem_domain ∧ a ∈ s1.mem_domain ∧ word_loc_val_byte p labs s1.mem a s1.be = SOME (t1.mem a :word8)) ∧ (∀(n :num). n < s1.code_buffer.space_left ⇒ (let (addr :α word) = s1.code_buffer.position + (n2w (LENGTH s1.code_buffer.buffer + n) :α word) in addr ∈ t1.mem_domain ∧ addr ∉ s1.mem_domain)) ∧ bytes_in_mem p (prog_to_bytes code2) t1.mem t1.mem_domain s1.mem_domain ∧ s1.code_buffer.position = p + (n2w (LENGTH (prog_to_bytes code2)) :α word) ∧ bytes_in_mem s1.code_buffer.position s1.code_buffer.buffer t1.mem t1.mem_domain s1.mem_domain ∧ LENGTH (prog_to_bytes code2) + LENGTH s1.code_buffer.buffer + s1.code_buffer.space_left < dimword (:α) ∧ (∀(bn :num). bn < LENGTH s1.code_buffer.buffer + s1.code_buffer.space_left ⇒ ¬MEM (s1.code_buffer.position + (n2w bn :α word)) mc_conf.ffi_entry_pcs) ∧ ¬s1.failed ∧ ¬t1.failed ∧ (s1.be ⇔ t1.be) ∧ t1.pc = p + (n2w (pos_val s1.pc (0 :num) code2) :α word) ∧ p && (n2w ((2 :num) ** t1.align − (1 :num)) :α word) = (0w :α word) ∧ (case mc_conf.target.config.link_reg of (NONE :num option) => T | SOME r => t1.lr = r) ∧ (t1.be ⇔ mc_conf.target.config.big_endian) ∧ t1.align = mc_conf.target.config.code_alignment ∧ enc_ok mc_conf.target.config ∧ all_enc_ok mc_conf.target.config labs (TAKE (THE (mmio_pcs_min_index mc_conf.ffi_names))