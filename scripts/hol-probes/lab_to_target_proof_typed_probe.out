enc_with_nop_pad_bytes_typed=(nop :α list) = (enc :β asm -> α list) (Inst (Skip :β inst) :β asm) ∧ LENGTH (enc (x :β asm)) ≤ (len :num) ∧ LENGTH (enc x) MOD LENGTH nop = (0 :num) ∧ len MOD LENGTH nop = (0 :num) ∧ (0 :num) < LENGTH nop ⇒ enc_with_nop enc x (pad_bytes (enc x) len nop)
enc_with_nop_pad_bytes_length_typed=enc_with_nop (enc :α asm -> β list) (x :α asm) (pad_bytes (enc x) (LENGTH (enc x)) (enc (Inst (Skip :α inst) :α asm)))
asm_step_IMP_evaluate_step_nop_typed=∀(c :(α, 'state, β) machine_config) (s1 :α asm_state) (ms1 :'state) (io :γ ffi_state) (i :α asm) (s2 :α asm_state) (bytes :word8 list). encoder_correct c.target ∧ c.prog_addresses = s1.mem_domain ∧ ffi_entry_pcs_disjoint c s1 (LENGTH bytes) ∧ interference_ok c.next_interfer (c.target.proj s1.mem_domain) ∧ bytes_in_memory s1.pc bytes s2.mem s1.mem_domain ∧ asm_step_nop bytes c.target.config s1 i s2 ∧ s2 = asm i (s1.pc + (n2w (LENGTH bytes) :α word)) s1 ∧ target_state_rel c.target s1 ms1 ∧ (∀(x :α word). i ≠ (Call x :α asm)) ⇒ ∃(l :num) (ms2 :'state). ∀(k :num). (evaluate c io (k + l) ms1 :machine_result # 'state # γ ffi_state) = (evaluate (shift_interfer l c) io k ms2 :machine_result # 'state # γ ffi_state) ∧ find_next_interference c io (k + l) ms1 = find_next_interference (shift_interfer l c) io k ms2 ∧ target_state_rel c.target s2 ms2 ∧ l ≠ (0 :num)
asm_step_nop_def_typed=∀(bytes :word8 list) (c :α asm_config) (s1 :α asm_state) (i :α asm) (s2 :α asm_state). asm_step_nop bytes c s1 i s2 ⇔ bytes_in_memory s1.pc bytes s1.mem s1.mem_domain ∧ enc_with_nop c.encode i bytes ∧ (case c.link_reg of (NONE :num option) => T | SOME r => s1.lr = r) ∧ (s1.be ⇔ c.big_endian) ∧ s1.align = c.code_alignment ∧ asm i (s1.pc + (n2w (LENGTH bytes) :α word)) s1 = s2 ∧ ¬s2.failed ∧ asm_ok i c
has_odd_inst_def_typed=(has_odd_inst ([] :α sec list) ⇔ F) ∧ (∀(xs :α sec list) (k :num). has_odd_inst (Section k ([] :α line list)::xs) ⇔ has_odd_inst xs) ∧ ∀(ys :α line list) (y :α line) (xs :α sec list) (k :num). has_odd_inst (Section k (y::ys)::xs) ⇔ ¬EVEN (line_length y) ∨ has_odd_inst (Section k ys::xs)
has_odd_inst_alignment_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (code :α sec list). enc_ok c ∧ all_enc_ok c labs ffis pos code ∧ has_odd_inst code ⇒ c.code_alignment = (0 :num)
line_ok_alignment_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (line :α line). enc_ok c ∧ line_ok c labs ffis pos line ∧ ODD (line_length line) ⇒ c.code_alignment = (0 :num)
