sec_loc_to_pc_bound_typed=∀(n :num) (xs :α line list) (x :num). sec_loc_to_pc n xs = SOME x ⇒ x ≤ LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) xs)
enc_with_nop_def_typed=∀(enc :α asm -> β list) (b :α asm) (bytes :β list). enc_with_nop enc b bytes ⇔ (let (init :β list) = enc b; (step :β list) = enc (Inst (Skip :α inst) :α asm) in if LENGTH step = (0 :num) then bytes = init else (let (n :num) = (LENGTH bytes − LENGTH init) DIV LENGTH step in bytes = init ++ FLAT (REPLICATE n step)))
lines_enc_with_nop_add_nop_typed=∀(enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (ls :α line list). LENGTH (enc (Inst (Skip :α inst) :α asm)) = (1 :num) ∧ lines_enc_with_nop enc labs ffis pos (REVERSE ls) ⇒ lines_enc_with_nop enc labs ffis pos (REVERSE (add_nop (enc (Inst (Skip :α inst) :α asm)) ls))
all_enc_with_nop_def_typed=(∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (enc :α asm -> word8 list). all_enc_with_nop enc labs ffis pos ([] :α sec list) ⇔ T) ∧ (∀(xs :α sec list) (pos :num) (labs :num sptree$num_map sptree$num_map) (k :num) (ffis :ffiname list) (enc :α asm -> word8 list). all_enc_with_nop enc labs ffis pos (Section k ([] :α line list)::xs) ⇔ all_enc_with_nop enc labs ffis pos xs) ∧ ∀(ys :α line list) (y :α line) (xs :α sec list) (pos :num) (labs :num sptree$num_map sptree$num_map) (k :num) (ffis :ffiname list) (enc :α asm -> word8 list). all_enc_with_nop enc labs ffis pos (Section k (y::ys)::xs) ⇔ line_enc_with_nop enc labs ffis pos y ∧ all_enc_with_nop enc labs ffis (pos + line_length y) (Section k ys::xs)
all_enc_with_nop_alt_typed=(all_enc_with_nop (enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) ([] :α sec list) ⇔ T) ∧ (all_enc_with_nop enc labs ffis pos (Section (k :num) (ls :α line list)::(ss :α sec list)) ⇔ lines_enc_with_nop enc labs ffis pos ls ∧ all_enc_with_nop enc labs ffis (pos + (SUM (MAP (line_length :α line -> num) ls) :num)) ss)
all_enc_with_nop_label_zero_typed=∀(enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (ls :α sec list). all_enc_with_nop enc labs ffis pos ls ⇒ EVERY (sec_label_zero :α sec -> bool) ls
