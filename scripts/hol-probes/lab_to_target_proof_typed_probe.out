enc_ok_LENGTH_GT_0_typed=enc_ok (c :α asm_config) ⇒ (0 :num) < LENGTH (c.encode (l :α asm))
pos_val_GE_num_pcs_typed=∀(pc :num) (p :num) (code2 :α sec list). num_pcs code2 ≤ pc ⇒ pos_val (num_pcs code2) p code2 = pos_val pc p code2
pos_val_GE_pc_typed=∀(i :num) (p :num) (code2 :α sec list). p ≤ pos_val i p code2
pos_val_inj_typed=∀(p :num) (code2 :α sec list) (j :num). pos_val (i :num) p code2 = pos_val j p code2 ∧ i ≤ num_pcs code2 ∧ j ≤ num_pcs code2 ∧ all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (p' :num) code2 ∧ enc_ok c ⇒ i = j
pos_val_mono_typed=∀(i :num) (p :num) (code2 :α sec list) (j :num) (p' :num). i < j ∧ j ≤ num_pcs code2 ∧ all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) p' code2 ∧ enc_ok c ⇒ pos_val i p code2 < pos_val j p code2
