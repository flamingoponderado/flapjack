GENLIST_asm_fetch_aux_next_typed=¬is_Label (x :α line) ⇒ GENLIST (λ(i :num). (i,asm_fetch_aux i (Section (k :num) (x::(xs :α line list))::(rest :α sec list)))) ((n :num) + (1 :num)) = ((0 :num),SOME x)::GENLIST (λ(i :num). (i + (1 :num),asm_fetch_aux i (Section k xs::rest))) n
line_to_info_def_typed=∀(secs :α sec list) (p :num) (x :num # β line option). line_to_info secs p x = case SND x of (NONE :β line option) => ([] :(ffiname # shmem_info_num) list) | SOME (Label v12 v13 v14 :β line) => ([] :(ffiname # shmem_info_num) list) | SOME (Asm (Asmi v28) bytes l) => ([] :(ffiname # shmem_info_num) list) | SOME (Asm (Cbw v29 v30 :β asm_or_cbw) bytes l) => ([] :(ffiname # shmem_info_num) list) | SOME (Asm (ShareMem m r ad) bytes l) => (let ((name :shmem_op),(nb :word8)) = get_memop_info m in [(SharedMem name,<|entry_pc := pos_val (FST x) p secs; nbytes := nb; addr_reg := case ad of Addr r off => r; addr_off := case ad of Addr r off => w2n off; reg := r; exit_pc := pos_val (FST x) p secs + LENGTH bytes|>)]) | SOME (LabAsm v18 v19 v20 v21) => ([] :(ffiname # shmem_info_num) list)
line_to_info_hd_empty_typed=line_to_info (Section (k :num) ([] :α line list)::(rest :α sec list)) (p :num) (t :num # β line option) = line_to_info rest p t
line_to_info_hd_Label_typed=line_to_info (Section (k :num) ((Label (a :num) (b :num) (0 :num) :α line)::(xs :α line list))::(rest :α sec list)) (p :num) (t :num # β line option) = line_to_info (Section k xs::rest) p t
