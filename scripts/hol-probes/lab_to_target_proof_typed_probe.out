state_rel_shift_interfer_typed=(state_rel ((mc_conf :(α, β, γ) machine_config),(code2 :α sec list),(labs :num sptree$num_map sptree$num_map),(p :α word)) (s1 :(α, config, δ) labSem$state) (t1 :α asm_state) (x :β) :bool) ⇒ (state_rel (shift_interfer (l :num) mc_conf,code2,labs,p) s1 t1 x :bool)
even_labels_ends_imp_strong_typed=∀(pos :num) (code :α sec list). even_labels pos code ∧ EVERY (sec_ends_with_label :α sec -> bool) code ∧ EVERY (sec_label_zero :α sec -> bool) code ⇒ even_labels_strong pos code
EVEN_sec_length_lines_upd_lab_len_typed=∀(pos :num) (lines :α line list) (acc :α line list). (if NULL lines then EVEN pos ∧ EVEN (SUM (MAP (line_len :α line -> num) acc) :num) else is_Label (LAST lines) ∧ EVEN (pos + (SUM (MAP (line_len :α line -> num) acc) :num))) ⇒ EVEN (SUM (MAP (line_len :α line -> num) (FST (lines_upd_lab_len pos lines acc))) :num)
SND_lines_upd_lab_len_typed=∀(pos :num) (lines :α line list) (acc :α line list). SND (lines_upd_lab_len pos lines acc) = pos + (SUM (MAP (line_len :α line -> num) (FST (lines_upd_lab_len pos lines acc))) :num) − (SUM (MAP (line_len :α line -> num) acc) :num)
lines_upd_lab_len_encd0_label_zero_typed=∀(pos :num) (lines :α line list) (aux :α line list). enc_ok (c :α asm_config) ∧ (enc :α asm -> word8 list) = c.encode ∧ c.code_alignment ≠ (0 :num) ∧ EVERY (line_encd0 enc) lines ∧ EVEN pos ∧ EVERY (label_zero :α line -> bool) aux ⇒ EVERY (label_zero :α line -> bool) (FST (lines_upd_lab_len pos lines aux))
upd_lab_len_encd0_label_zero_typed=∀(pos :num) (code :α sec list). enc_ok (c :α asm_config) ∧ (enc :α asm -> word8 list) = c.encode ∧ c.code_alignment ≠ (0 :num) ∧ all_encd0 enc code ∧ EVEN pos ∧ EVERY (sec_ends_with_label :α sec -> bool) code ⇒ EVERY (sec_label_zero :α sec -> bool) (upd_lab_len pos code)
all_enc_ok_pre_light_imp_all_enc_ok_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (code :α sec list). all_enc_with_nop c.encode labs ffis pos code ∧ all_enc_ok_pre c code ∧ all_enc_ok_light c code ∧ even_labels_strong pos code ∧ all_labs_exist labs code ∧ (offset_ok labs ffis pos code :bool) ⇒ all_enc_ok c labs ffis pos code
line_ok_pre_light_imp_line_ok_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (line :α line). line_ok_pre c line ∧ line_enc_with_nop c.encode labs ffis pos line ∧ line_offset_ok labs ffis pos line ∧ line_labs_exist labs line ∧ line_ok_light c line ∧ (is_Label line ⇒ EVEN pos) ⇒ line_ok c labs ffis pos line
line_ok_line_enc_with_nop_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (line :α line). line_ok c labs ffis pos line ⇒ line_enc_with_nop c.encode labs ffis pos line
lines_ok_lines_enc_with_nop_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (lines :α line list). lines_ok c labs ffis pos lines ⇒ lines_enc_with_nop c.encode labs ffis pos lines
EVEN_add_AND_typed=(1w :α word) && (p :α word) = (0w :α word) ∧ EVEN (x :num) ⇒ (1w :α word) && p + (n2w x :α word) = (0w :α word)
word_loc_val_byte_def_typed=∀(p :α word) (labs :num sptree$num_map sptree$num_map) (m :α word -> α word_loc) (a :α word) (be :bool). word_loc_val_byte p labs m a be = case word_loc_val p labs (m (byte_align a)) of (NONE :α word option) => (NONE :word8 option) | SOME w => SOME (get_byte a w be)
word_loc_val_def_typed=(∀(p :α word) (labs :num sptree$num_map sptree$num_map) (w :α word). word_loc_val p labs (Word w) = SOME w) ∧ ∀(p :α word) (labs :num sptree$num_map sptree$num_map) (k1 :num) (k2 :num). word_loc_val p labs (Loc k1 k2 :α word_loc) = case lab_lookup k1 k2 labs of (NONE :num option) => (NONE :α word option) | SOME q => SOME (p + (n2w q :α word))
zero_labs_acc_exist_eq_typed=zero_labs_acc_exist (labs :α sptree$num_map sptree$num_map) (code :β sec list) ⇔ restrict_zero (get_labels code) ⊆ labs_domain labs
label_zero_pos_ok_even_labels_typed=∀(pos :num) (code :α sec list). EVERY (sec_label_zero :α sec -> bool) code ∧ all_lab_len_pos_ok pos code ⇒ even_labels pos code
label_zero_pos_ok_lines_even_labels_typed=∀(pos :num) (ls :α line list). EVERY (label_zero :α line -> bool) ls ∧ lab_len_pos_ok pos ls ⇒ lines_even_labels pos ls
enc_lines_again_simp_label_zero_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (ls :α line list) (res :α line list) (ok :bool). enc_lines_again_simp labs ffis pos enc ls = (res,ok) ∧ EVERY (label_zero :α line -> bool) ls ⇒ EVERY (label_zero :α line -> bool) res
enc_secs_again_label_zero_typed=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (enc :α asm -> word8 list) (lines :α sec list) (res :α sec list) (ok :bool). enc_secs_again pos labs ffis enc lines = (res,ok) ∧ EVERY (sec_label_zero :α sec -> bool) lines ⇒ EVERY (sec_label_zero :α sec -> bool) res
EVERY_label_zero_pad_section_typed=∀(nop :word8 list) (xs :α line list) (aux :α line list). EVERY (label_zero :α line -> bool) aux ⇒ EVERY (label_zero :α line -> bool) (pad_section nop xs aux)
EVERY_sec_label_zero_pad_code_typed=∀(nop :word8 list) (ls :α sec list). EVERY (sec_label_zero :α sec -> bool) (pad_code nop ls)
compute_labels_alt_domain_labs_typed=∀(pos :num) (code :α sec list) (labs :num sptree$num_map sptree$num_map). (domain (compute_labels_alt pos code labs) :num -> bool) = IMAGE (FST :num # num -> num) (get_code_labels code) ∪ (domain labs :num -> bool)
remove_labels_loop_domain_labs_typed=∀(a :num) (b :α asm_config) (c :num) (d :num sptree$num_map sptree$num_map) (e :ffiname list) (f :α sec list) (g :α sec list) (h :num sptree$num_map sptree$num_map). remove_labels_loop a b c d e f = SOME (g,h) ⇒ (domain h :num -> bool) = IMAGE (FST :num # num -> num) (get_code_labels f) ∪ (domain d :num -> bool)
remove_labels_domain_labs_typed=remove_labels (c :num) (t :α asm_config) (k :num) (init_labs :num sptree$num_map sptree$num_map) (f :ffiname list) (p :α sec list) = SOME ((q :α sec list),(labs :num sptree$num_map sptree$num_map)) ⇒ (domain labs :num -> bool) = IMAGE (FST :num # num -> num) (get_code_labels p) ∪ (domain init_labs :num -> bool)
extract_labels_loc_to_pc_typed=∀(l1 :num) (l2 :num) (code :α sec list). EVERY (sec_labels_ok :α sec -> bool) code ∧ MEM (l1,l2) (FLAT (MAP ((extract_labels :α line list -> (num # num) list) ∘ (Section_lines :α sec -> α line list)) code)) ⇒ ∃(y :num). loc_to_pc l1 l2 code = SOME y
find_ffi_names_ALL_DISTINCT_typed=∀(code :α sec list). ALL_DISTINCT (find_ffi_names code)
read_ffi_bytearrays_with_next_interfer_typed=read_ffi_bytearrays ((mc :(β, α, γ) machine_config) with next_interfer := (foo :num -> α -> α)) = read_ffi_bytearrays mc
read_ffi_bytearrays_shift_interfer_typed=read_ffi_bytearrays (shift_interfer (x :num) (y :(β, α, γ) machine_config)) = read_ffi_bytearrays y
read_ffi_bytearrays_ffi_interfer_typed=read_ffi_bytearrays ((mc :(β, α, γ) machine_config) with ffi_interfer := (ffi :num -> num # word8 list # α -> α)) = read_ffi_bytearrays mc
