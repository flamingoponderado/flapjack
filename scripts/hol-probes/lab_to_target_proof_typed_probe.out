ENGTH (prog_to_bytes code2)) :α word)) cbspace coracle) :behaviour) ≠ Fail ⇒ machine_sem mc_conf ffi ms = {(semantics (make_init mc_conf ffi t m dm sdm ms code (compile_lab mc_conf.target.config) (mc_conf.target.get_pc ms + (n2w (LENGTH (prog_to_bytes code2)) :α word)) cbspace coracle) :behaviour)}
compiler_oracle_ok_def_typed=∀(coracle :num -> config # α sec list) (init_labs :num sptree$num_map sptree$num_map) (init_pos :num) (c :α asm_config) (ffis :ffiname list). compiler_oracle_ok coracle init_labs init_pos c ffis ⇔ (∀(k :num). (let ((cfg :config),(code :α sec list)) = coracle k in good_code c cfg.labels code ∧ no_share_mem_inst code)) ∧ (let ((cfg :config),(code :α sec list)) = coracle (0 :num) in cfg.labels = init_labs ∧ cfg.pos = init_pos ∧ cfg.ffi_names = SOME ffis)
mc_conf_ok_def_typed=∀(mc_conf :(α, β, γ) machine_config). mc_conf_ok mc_conf ⇔ good_dimindex (:α) ∧ encoder_correct mc_conf.target ∧ reg_ok mc_conf.ptr_reg mc_conf.target.config ∧ reg_ok mc_conf.len_reg mc_conf.target.config ∧ reg_ok mc_conf.ptr2_reg mc_conf.target.config ∧ reg_ok mc_conf.len2_reg mc_conf.target.config ∧ reg_ok (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) mc_conf.target.config ∧ enc_ok mc_conf.target.config
align2_not_align3_4w_typed=¬aligned (3 :num) (x :α word) ∧ aligned (2 :num) x ∧ dimindex (:α) = (64 :num) ⇒ x = byte_align x + (4w :α word) ∧ x + (1w :α word) = byte_align x + (5w :α word) ∧ x + (2w :α word) = byte_align x + (6w :α word) ∧ x + (3w :α word) = byte_align x + (7w :α word)
aligned_2_imp_typed=aligned (2 :num) (x :α word) ∧ dimindex (:α) = (32 :num) ⇒ byte_align x = x ∧ byte_align (x + (1w :α word)) = x ∧ byte_align (x + (2w :α word)) = x ∧ byte_align (x + (3w :α word)) = x
aligned_2_not_eq_typed=aligned (2 :num) (x :α word) ∧ dimindex (:α) = (32 :num) ∧ x ≠ byte_align (a :α word) ⇒ x ≠ a ∧ x + (1w :α word) ≠ a ∧ x + (2w :α word) ≠ a ∧ x + (3w :α word) ≠ a
aligned_3_imp_typed=aligned (3 :num) (x :α word) ∧ dimindex (:α) = (64 :num) ⇒ byte_align x = x ∧ byte_align (x + (1w :α word)) = x ∧ byte_align (x + (2w :α word)) = x ∧ byte_align (x + (3w :α word)) = x ∧ byte_align (x + (4w :α word)) = x ∧ byte_align (x + (5w :α word)) = x ∧ byte_align (x + (6w :α word)) = x ∧ byte_align (x + (7w :α word)) = x
aligned_3_not_eq_typed=aligned (3 :num) (x :α word) ∧ dimindex (:α) = (64 :num) ∧ x ≠ byte_align (a :α word) ⇒ x ≠ a ∧ x + (1w :α word) ≠ a ∧ x + (2w :α word) ≠ a ∧ x + (3w :α word) ≠ a ∧ x + (4w :α word) ≠ a ∧ x + (5w :α word) ≠ a ∧ x + (6w :α word) ≠ a ∧ x + (7w :α word) ≠ a
Inst_lemma_typed=¬(asm_inst (i :α inst) (s1 :(α, config, γ) labSem$state)).failed ∧ (state_rel ((mc_conf :(α, 'state, β) machine_config),(code2 :α sec list),(labs :num sptree$num_map sptree$num_map),(p :α word)) s1 (t1 :α asm_state) (ms1 :'state) :bool) ∧ pos_val (s1.pc + (1 :num)) (0 :num) code2 = pos_val s1.pc (0 :num) code2 + LENGTH (bytes' :word8 list) ⇒ ¬(inst i t1 :α asm_state).failed ∧ (∀(a :α word). a ∉ s1.mem_domain ⇒ ((inst i t1 :α asm_state).mem a :word8) = (t1.mem a :word8)) ∧ (target_state_rel mc_conf.target (upd_pc (t1.pc + (n2w (LENGTH bytes') :α word)) (inst i t1 :α asm_state)) (ms2 :'state) ⇒ (state_rel (mc_conf,code2,labs,p) (inc_pc (dec_clock (asm_inst i s1))) (upd_pc (t1.pc + (n2w (LENGTH bytes') :α word)) (inst i t1 :α asm_state)) ms2 :bool))
arith_upd_fp_regs_typed=(arith_upd (a :α arith) (s :(α, β, γ) labSem$state)).fp_regs = s.fp_regs ∧ (arith_upd a (t :α asm_state)).fp_regs = t.fp_regs
arith_upd_share_mem_domain_unchange_typed=(arith_upd (a :α arith) (s1 :(α, β, γ) labSem$state)).shared_mem_domain = s1.shared_mem_domain
fp_upd_share_mem_domain_unchange_typed=(fp_upd (f :fp) (s1 :(α, β, γ) labSem$state)).shared_mem_domain = s1.shared_mem_domain
Inst_share_mem_pc_update_helper_typed=share_mem_state_rel (mc_conf :(α, β, γ) machine_config) (s1 :(δ, config, ε) labSem$state) (t1 :α asm_state) (ms1 :ζ) ∧ target_state_rel mc_conf.target (t1 with pc := (pc' :α word)) (ms2 :β) ⇒ share_mem_state_rel mc_conf (s1 with <|pc := s1.pc + (1 :num); clock := s1.clock − (1 :num)|>) (t1 with pc := pc') ms2
Inst_share_mem_reg_update_helper_typed=share_mem_state_rel (mc_conf :(α, β, γ) machine_config) (s1 :(α, config, δ) labSem$state) (t1 :α asm_state) (ms1 :ε) ∧ target_state_rel mc_conf.target (t1 with <|regs := t1.regs⦇(n :num) ↦ (c :α word)⦈; pc := (pc' :α word)|>) (ms2 :β) ⇒ share_mem_state_rel mc_conf (s1 with <|regs := s1.regs⦇n ↦ Word c⦈; pc := s1.pc + (1 :num); clock := s1.clock − (1 :num)|>) (t1 with <|regs := t1.regs⦇n ↦ c⦈; pc := pc'|>) ms2
ffi_entry_pcs_disjoint_LENGTH_shorter_typed=∀(l1 :num) (l2 :num). ffi_entry_pcs_disjoint (c :(α, β, γ) machine_config) (s1 :α asm_state) l1 ∧ l2 ≤ l1 ⇒ ffi_entry_pcs_disjoint c s1 l2
shift_interfer_twice_typed=shift_interfer (l' :num) (shift_interfer (l :num) (c :(α, β, γ) machine_config)) = shift_interfer (l + l') c
enc_lines_again_simp_label_one_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (ls :α line list) (res :α line list) (ok :bool). enc_lines_again_simp labs ffis pos enc ls = (res,ok) ∧ EVERY (label_one :α line -> bool) ls ⇒ EVERY (label_one :α line -> bool) res
enc_secs_again_label_one_typed=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (enc :α asm -> word8 list) (lines :α sec list) (res :α sec list) (ok :bool). enc_secs_again pos labs ffis enc lines = (res,ok) ∧ EVERY (sec_label_one :α sec -> bool) lines ⇒ EVERY (sec_label_one :α sec -> bool) res
label_one_def_typed=(label_one (Label (v0 :num) (v1 :num) (n :num) :α line) ⇔ n ≤ (1 :num)) ∧ (label_one (Asm (v5 :α asm_or_cbw) (v6 :word8 list) (v7 :num)) ⇔ T) ∧ (label_one (LabAsm (v8 :α asm_with_lab) (v9 :α word) (v10 :word8 list) (v11 :num)) ⇔ T)
lines_upd_lab_len_label_one_typed=∀(pos :num) (ls :α line list) (acc :α line list). EVERY (label_one :α line -> bool) acc ⇒ EVERY (label_one :α line -> bool) (FST (lines_upd_lab_len pos ls acc))
sec_label_one_def_typed=∀(v0 :num) (ls :α line list). sec_label_one (Section v0 ls) ⇔ EVERY (label_one :α line -> bool) ls
upd_lab_len_label_one_typed=∀(pos :num) (ss :α sec list). EVERY (sec_label_one :α sec -> bool) (upd_lab_len pos ss)
all_labs_exist_pad_code_typed=∀(nop :word8 list) (code :α sec list). all_labs_exist (labs :β sptree$num_map sptree$num_map) (pad_code nop code) ⇔ all_labs_exist labs code
upd_lab_len_all_labs_exist_typed=∀(pos :num) (code :α sec list). all_labs_exist (labs :β sptree$num_map sptree$num_map) (upd_lab_len pos code) ⇔ all_labs_exist labs code
code_similar_all_labs_exist_typed=∀(c1 :α sec list) (c2 :α sec list). code_similar c1 c2 ⇒ (all_labs_exist (labs :β sptree$num_map sptree$num_map) c1 ⇔ all_labs_exist labs c2)
line_labs_exist_def_typed=(line_labs_exist (labs :α sptree$num_map sptree$num_map) (LabAsm (a :β asm_with_lab) (v0 :β word) (v1 :word8 list) (v2 :num)) ⇔ ∀(n1 :num) (n2 :num). (n1,n2) ∈ labs_of a ⇒ lab_lookup n1 n2 labs ≠ (NONE :α option)) ∧ (line_labs_exist (v3 :α sptree$num_map sptree$num_map) (Label (v6 :num) (v7 :num) (v8 :num) :β line) ⇔ T) ∧ (line_labs_exist v3 (Asm (v9 :β asm_or_cbw) (v10 :word8 list) (v11 :num)) ⇔ T)
line_similar_line_labs_exist_typed=∀(l1 :α line) (l2 :α line). line_similar l1 l2 ⇒ (line_labs_exist (labs :β sptree$num_map sptree$num_map) l1 ⇔ line_labs_exist labs l2)
sec_labs_exist_def_typed=∀(labs :α sptree$num_map sptree$num_map) (v0 :num) (ls :β line list). sec_labs_exist labs (Section v0 ls) ⇔ EVERY (line_labs_exist labs :β line -> bool) ls
all_labs_exist_get_labels_typed=all_labs_exist (labs :α sptree$num_map sptree$num_map) (code :β sec list) ⇔ get_labels code ⊆ labs_domain labs
line_labs_exist_get_labels_typed=∀(labs :α sptree$num_map sptree$num_map) (line :β line). line_labs_exist labs line ⇔ line_get_labels line ⊆ labs_domain labs
sec_labs_exist_get_labels_typed=∀(labs :α sptree$num_map sptree$num_map) (sec :β sec). sec_labs_exist labs sec ⇔ sec_get_labels sec ⊆ labs_domain labs
enc_lines_again_line_labs_exist_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (lines :α line list) (acc :α line list) (ok :bool) (res :α line list) (ok' :num # bool) (k :β). enc_lines_again labs ffis pos enc lines (acc,ok) = (res,ok') ∧ EVERY (line_labs_exist (labs' :γ sptree$num_map sptree$num_map) :α line -> bool) acc ∧ EVERY (line_labs_exist labs' :α line -> bool) lines ⇒ EVERY (line_labs_exist labs' :α line -> bool) res
enc_secs_again_all_labs_exist_typed=∀(pos :num) (ffis :num sptree$num_map sptree$num_map) (labs :ffiname list) (enc :α asm -> word8 list) (ls :α sec list) (res :α sec list) (ok :bool) (k :β). enc_secs_again pos ffis labs enc ls = (res,ok) ∧ all_labs_exist (labs' :γ sptree$num_map sptree$num_map) ls ⇒ all_labs_exist labs' res
lab_lookup_def_typed=∀(k1 :num) (k2 :num) (labs :α sptree$num_map sptree$num_map). lab_lookup k1 k2 labs = case lookup k1 labs of (NONE :α sptree$num_map option) => (NONE :α option) | SOME f => lookup k2 f
lines_ok_section_lab_lookup_even_typed=∀(pos :num) (lines :α line list) (acc :(num # num) list). lines_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) pos lines ∧ (∀(l2 :num) (x :num). ALOOKUP acc l2 = SOME x ⇒ EVEN x) ∧ ALOOKUP (SND (section_labels pos lines acc)) (l2 :num) = SOME (x :num) ⇒ EVEN x
all_lab_len_pos_ok_def_typed=(∀(v0 :num). all_lab_len_pos_ok v0 ([] :α sec list) ⇔ T) ∧ ∀(ss :α sec list) (pos :num) (ls :α line list) (k :num). all_lab_len_pos_ok pos (Section k ls::ss) ⇔ lab_len_pos_ok pos ls ∧ all_lab_len_pos_ok (pos + sec_length ls (0 :num)) ss
lab_len_pos_ok_def_typed=(∀(pos :num). lab_len_pos_ok pos ([] :α line list) ⇔ T) ∧ ∀(pos :num) (l :α line) (ls :α line list). lab_len_pos_ok pos (l::ls) ⇔ line_lab_len_pos_ok pos l ∧ lab_len_pos_ok (pos + line_len l) ls
lab_len_pos_ok_append_typed=∀(l1 :α line list) (pos :num) (l2 :α line list). lab_len_pos_ok pos (l1 ++ l2) ⇔ lab_len_pos_ok pos l1 ∧ lab_len_pos_ok (pos + (SUM (MAP (line_len :α line -> num) l1) :num)) l2
line_lab_len_pos_ok_def_typed=(line_lab_len_pos_ok (pos' :num) (Label (v0 :num) (v1 :num) (l :num) :α line) ⇔ if EVEN pos' then l = (0 :num) else l = (1 :num)) ∧ (line_lab_len_pos_ok (v2 :num) (Asm (v8 :α asm_or_cbw) (v9 :word8 list) (v10 :num)) ⇔ T) ∧ (line_lab_len_pos_ok v2 (LabAsm (v11 :α asm_with_lab) (v12 :α word) (v13 :word8 list) (v14 :num)) ⇔ T)
enc_lines_again_simp_pos_ok_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (enc :α asm -> word8 list) (lines :α line list) (res :α line list). enc_lines_again_simp labs ffis pos enc lines = (res,T) ∧ lab_len_pos_ok pos lines ⇒ lab_len_pos_ok pos res
enc_secs_again_pos_ok_typed=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (enc :α asm -> word8 list) (code :α sec list) (res :α sec list). enc_secs_again pos labs ffis enc code = (res,T) ∧ all_lab_len_pos_ok pos code ⇒ all_lab_len_pos_ok pos res
pad_section_pos_ok_typed=∀(nop :word8 list) (lines :α line list) (aux :α line list) (pos :num). lab_len_pos_ok (pos + (SUM (MAP (line_len :α line -> num) aux) :num)) lines ∧ lab_len_pos_ok pos (REVERSE aux) ∧ EVERY (label_zero :α line -> bool) aux ∧ (NULL aux ∨ is_Label (HD aux) ⇒ label_prefix_zero lines) ⇒ lab_len_pos_ok pos (pad_section nop lines aux)
lab_len_pos_ok_even_prefix_zero_typed=∀(pos :num) (ls :α line list). EVEN pos ∧ lab_len_pos_ok pos ls ⇒ label_prefix_zero ls
lines_upd_lab_len_pos_ok_typed=∀(pos :num) (lines :α line list). lab_len_pos_ok pos (FST (lines_upd_lab_len pos lines ([] :α line list)))
upd_lab_len_pos_ok_typed=∀(pos :num) (code :α sec list). all_lab_len_pos_ok pos (upd_lab_len pos code)
enc_sec_list_sec_labels_ok_typed=∀(enc :α asm -> word8 list) (code :α sec list). EVERY (sec_labels_ok :α sec -> bool) code ⇒ EVERY (sec_labels_ok :α sec -> bool) (enc_sec_list enc code)
enc_secs_again_sec_labels_ok_typed=∀(pos :num) (ffis :num sptree$num_map sptree$num_map) (labs :ffiname list) (enc :α asm -> word8 list) (ls :α sec list) (res :α sec list) (ok :bool) (k :β). enc_secs_again pos ffis labs enc ls = (res,ok) ∧ EVERY (sec_labels_ok :α sec -> bool) ls ⇒ EVERY (sec_labels_ok :α sec -> bool) res
pad_code_sec_labels_ok_typed=∀(nop :word8 list) (code :α sec list). EVERY (sec_labels_ok :α sec -> bool) code ⇒ EVERY (sec_labels_ok :α sec -> bool) (pad_code nop code)
upd_lab_len_sec_labels_ok_typed=∀(n :num) (ls :α sec list). EVERY (sec_labels_ok :α sec -> bool) ls ⇒ EVERY (sec_labels_ok :α sec -> bool) (upd_lab_len n ls)
labs_domain_def_typed=∀(labs :α sptree$num_map sptree$num_map). labs_domain labs = {(n1,n2) | lab_lookup n1 n2 labs ≠ (NONE :α option)}
labs_domain_insert_typed=(k :num) ∉ (domain (labs :α sptree$num_map sptree$num_map) :num -> bool) ⇒ labs_domain (insert k (s :α sptree$num_map) labs) = IMAGE (λ(n2 :num). (k,n2)) (domain s :num -> bool) ∪ labs_domain labs
labs_domain_LN_typed=labs_domain (LN :α sptree$num_map sptree$num_map) = (∅ :num # num -> bool)
line_length_ok_def_typed=∀(l :α line). line_length_ok l ⇔ LENGTH (line_bytes l) = line_len l
sec_length_ok_def_typed=∀(v0 :num) (ls :α line list). sec_length_ok (Section v0 ls) ⇔ EVERY (line_length_ok :α line -> bool) ls
