lines_enc_with_nop_def_typed=(∀(enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num). lines_enc_with_nop enc labs ffis pos ([] :α line list) ⇔ T) ∧ ∀(enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (l :α line) (ls :α line list). lines_enc_with_nop enc labs ffis pos (l::ls) ⇔ line_enc_with_nop enc labs ffis pos l ∧ lines_enc_with_nop enc labs ffis (pos + line_length l) ls
