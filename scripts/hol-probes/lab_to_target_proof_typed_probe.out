oracle_tie_ccache_step_typed=oracle_tie (mc_conf :(α, β, γ) machine_config) (ms1 :β) (s1 :(α, δ, ε) labSem$state) ∧ next_interference mc_conf s1.ffi ms1 = SOME (CcApp (a1 :α word) (a2 :α word) (ms_pre :β) (ms_post :β),(mc' :(α, β, γ) machine_config),(ffi' :ε ffi_state)) ⇒ (∀(r :num). s1.cc_regs (0 :num) r = if MEM r mc_conf.callee_saved_regs ∨ r = mc_conf.ptr_reg ∨ ¬(r < mc_conf.target.config.reg_count) ∨ MEM r mc_conf.target.config.avoid_regs then (NONE :α word option) else SOME (mc_conf.target.get_reg ms_post r)) ∧ (∀(i :num). s1.cc_fp_regs (0 :num) i = mc_conf.target.get_fp_reg ms_post i) ∧ target_cc_regs mc' ffi' ms_post = shift_seq (1 :num) s1.cc_regs ∧ target_cc_fp_regs mc' ffi' ms_post = shift_seq (1 :num) s1.cc_fp_regs ∧ target_io_regs mc' ffi' ms_post = s1.io_regs ∧ target_io_fp_regs mc' ffi' ms_post = s1.io_fp_regs
oracle_tie_ExtCall_residues_typed=∀(mc_conf :(α, β, δ) machine_config) (ms1 :β) (s1 :(α, γ, 'ffi) labSem$state) (ms2 :β) (l :num) (index :num) (name :mlstring) (bytes :word8 list) (bytes2 :word8 list) (new_ffi :'ffi ffi_state) (new_bytes :word8 list) (t1 :α asm_state). oracle_tie mc_conf ms1 s1 ∧ (∀(k :num). find_next_interference mc_conf s1.ffi (k + l) ms1 = find_next_interference (mc_conf with next_interfer := shift_seq l mc_conf.next_interfer) s1.ffi k ms2) ∧ mc_conf.target.get_pc ms2 ∉ mc_conf.prog_addresses DIFF set mc_conf.ffi_entry_pcs ∧ mc_conf.target.get_pc ms2 ≠ mc_conf.halt_pc ∧ mc_conf.target.get_pc ms2 ≠ mc_conf.ccache_pc ∧ find_index (mc_conf.target.get_pc ms2) mc_conf.ffi_entry_pcs (0 :num) = SOME index ∧ mc_conf.ffi_names❲index❳ = ExtCall name ∧ ALOOKUP mc_conf.mmio_info index = (NONE :(word8 # α addr # num # α word) option) ∧ read_ffi_bytearrays mc_conf ms2 = (SOME bytes,SOME bytes2) ∧ call_FFI s1.ffi (ExtCall name) bytes bytes2 = FFI_return new_ffi new_bytes ⇒ (λ(a :num). get_reg_value (s1.io_regs (0 :num) (ExtCall name) a) (t1.regs a :α word) (I :α word -> α word)) = (λ(a :num). if MEM a mc_conf.callee_saved_regs ∨ ¬(a < mc_conf.target.config.reg_count) ∨ MEM a mc_conf.target.config.avoid_regs then (t1.regs a :α word) else mc_conf.target.get_reg (mc_conf.ffi_interfer (0 :num) (index,new_bytes,ms2)) a) ∧ (λ(n :num). s1.io_fp_regs (0 :num) n) = (λ(n :num). mc_conf.target.get_fp_reg (mc_conf.ffi_interfer (0 :num) (index,new_bytes,ms2)) n)
oracle_tie_ffi_next_typed=oracle_tie (mc_conf :(α, β, δ) machine_config) (ms1 :β) (s1 :(α, γ, 'ffi) labSem$state) ∧ next_interference mc_conf s1.ffi ms1 = SOME ((FfiApp (index :num) (new_bytes :word8 list) (ms_pre :β) (ms_post :β) :(α, β) interference_app),(mc' :(α, β, δ) machine_config),(ffi' :'ffi ffi_state)) ∧ (s2 :(α, γ, 'ffi) labSem$state).io_regs = shift_seq (1 :num) s1.io_regs ∧ s2.io_fp_regs = shift_seq (1 :num) s1.io_fp_regs ∧ s2.cc_regs = s1.cc_regs ∧ s2.cc_fp_regs = s1.cc_fp_regs ∧ s2.ffi = ffi' ⇒ oracle_tie mc' ms_post s2
oracle_tie_ffi_step_typed=oracle_tie (mc_conf :(α, β, γ) machine_config) (ms1 :β) (s1 :(α, δ, ε) labSem$state) ∧ next_interference mc_conf s1.ffi ms1 = SOME ((FfiApp (index :num) (new_bytes :word8 list) (ms_pre :β) (ms_post :β) :(α, β) interference_app),(mc' :(α, β, γ) machine_config),(ffi' :ε ffi_state)) ⇒ (∀(name :ffiname) (r :num). s1.io_regs (0 :num) name r = if MEM r mc_conf.callee_saved_regs ∨ ¬(r < mc_conf.target.config.reg_count) ∨ MEM r mc_conf.target.config.avoid_regs then (NONE :α word option) else SOME (mc_conf.target.get_reg ms_post r)) ∧ (∀(i :num). s1.io_fp_regs (0 :num) i = mc_conf.target.get_fp_reg ms_post i) ∧ target_io_regs mc' ffi' ms_post = shift_seq (1 :num) s1.io_regs ∧ target_io_fp_regs mc' ffi' ms_post = shift_seq (1 :num) s1.io_fp_regs ∧ target_cc_regs mc' ffi' ms_post = s1.cc_regs ∧ target_cc_fp_regs mc' ffi' ms_post = s1.cc_fp_regs
oracle_tie_shift_interfer_typed=oracle_tie (mc_conf :(α, β, γ) machine_config) (ms1 :β) (s1 :(α, δ, ε) labSem$state) ∧ (∀(k :num). find_next_interference mc_conf s1.ffi (k + (l :num)) ms1 = find_next_interference (shift_interfer l mc_conf) s1.ffi k (ms2 :β)) ⇒ oracle_tie (shift_interfer l mc_conf) ms2 s1
oracle_tie_step_typed=oracle_tie (mc_conf :(α, β, δ) machine_config) (ms1 :β) (s1 :(α, γ, 'ffi) labSem$state) ∧ (∀(k :num). find_next_interference mc_conf s1.ffi (k + (l :num)) ms1 = find_next_interference (shift_interfer l mc_conf) s1.ffi k (ms2 :β)) ∧ (s2 :(α, γ, 'ffi) labSem$state).io_regs = s1.io_regs ∧ s2.io_fp_regs = s1.io_fp_regs ∧ s2.cc_regs = s1.cc_regs ∧ s2.cc_fp_regs = s1.cc_fp_regs ∧ s2.ffi = s1.ffi ⇒ oracle_tie (shift_interfer l mc_conf) ms2 s2
pad_code_compute_labels_typed=∀(pos :num) (code :α sec list) (acc :num sptree$num_map sptree$num_map). EVERY (sec_label_one :α sec -> bool) code ∧ (LENGTH (nop :word8 list) ≠ (1 :num) ⇒ EVERY (sec_label_zero :α sec -> bool) code) ∧ EVERY (sec_label_prefix_zero :α sec -> bool) code ∧ all_lab_len_pos_ok pos code ⇒ compute_labels_alt pos (pad_code nop code) acc = compute_labels_alt pos code acc
pad_section_labels_typed=∀(nop :word8 list) (lines :α line list) (aux :α line list) (pos :num) (labs :(num # num) list). lab_len_pos_ok (pos + (SUM (MAP (line_len :α line -> num) aux) :num)) lines ∧ lab_len_pos_ok pos (REVERSE aux) ∧ EVERY (label_zero :α line -> bool) aux ∧ (¬NULL lines ∧ is_Label (HD lines) ∧ line_len (HD lines) = (1 :num) ⇒ ¬NULL aux ∧ ¬is_Label (HD aux)) ⇒ section_labels pos (pad_section nop lines aux) labs = section_labels pos (REVERSE aux ++ lines) labs
LENGTH_pad_bytes_typed=(0 :num) < LENGTH (nop :α list) ∧ LENGTH (bytes :α list) ≤ (l :num) ⇒ LENGTH (pad_bytes bytes l nop) = l
line_len_pad_section1_typed=∀(nop :word8 list) (xs :α line list) (aux :α line list). LENGTH nop = (1 :num) ∧ EVERY (label_one :α line -> bool) xs ∧ ¬EVERY (is_Label :α line -> bool) aux ⇒ (SUM (MAP (line_len :α line -> num) (pad_section nop xs aux)) :num) = (SUM (MAP (line_len :α line -> num) xs) :num) + (SUM (MAP (line_len :α line -> num) aux) :num)
line_len_pad_section0_typed=∀(nop :word8 list) (ls :α line list) (aux :α line list). EVERY (label_zero :α line -> bool) ls ⇒ (SUM (MAP (line_len :α line -> num) (pad_section nop ls aux)) :num) = (SUM (MAP (line_len :α line -> num) ls) :num) + (SUM (MAP (line_len :α line -> num) aux) :num)
line_length_pad_section_typed=∀(nop :word8 list) (ls :α line list) (acc :α line list). LENGTH nop = (1 :num) ∧ EVERY (label_one :α line -> bool) ls ∧ EVERY (line_length_leq :α line -> bool) ls ∧ (SUM (MAP (line_length :α line -> num) acc) :num) = (SUM (MAP (line_len :α line -> num) acc) :num) ∧ EVERY (is_Label :α line -> bool) acc ∧ label_prefix_zero ls ⇒ (SUM (MAP (line_length :α line -> num) (pad_section nop ls acc)) :num) = (SUM (MAP (line_len :α line -> num) ls) :num) + (SUM (MAP (line_len :α line -> num) acc) :num)
line_length_pad_section1_typed=∀(nop :word8 list) (ls :α line list) (acc :α line list). LENGTH nop = (1 :num) ∧ EVERY (label_one :α line -> bool) ls ∧ EVERY (line_length_leq :α line -> bool) ls ∧ ¬EVERY (is_Label :α line -> bool) acc ∧ (SUM (MAP (line_length :α line -> num) acc) :num) = (SUM (MAP (line_len :α line -> num) acc) :num) ⇒ (SUM (MAP (line_length :α line -> num) (pad_section nop ls acc)) :num) = (SUM (MAP (line_len :α line -> num) ls) :num) + (SUM (MAP (line_len :α line -> num) acc) :num)
label_zero_line_length_pad_section_typed=∀(nop :word8 list) (ls :α line list) (acc :α line list). (0 :num) < LENGTH nop ∧ EVERY (label_zero :α line -> bool) ls ∧ MAP (line_length :α line -> num) acc = MAP (line_len :α line -> num) acc ∧ EVERY (line_length_leq :α line -> bool) ls ⇒ MAP (line_length :α line -> num) (pad_section nop ls acc) = MAP (line_len :α line -> num) (REVERSE acc ++ ls)
