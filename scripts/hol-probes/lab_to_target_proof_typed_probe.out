pos_val_def_typed=(∀(pos :num) (i :num). pos_val i pos ([] :α sec list) = pos) ∧ (∀(xs :α sec list) (pos :num) (k :num) (i :num). pos_val i pos (Section k ([] :α line list)::xs) = pos_val i pos xs) ∧ ∀(ys :α line list) (y :α line) (xs :α sec list) (pos :num) (k :num) (i :num). pos_val i pos (Section k (y::ys)::xs) = if is_Label y then pos_val i (pos + line_length y) (Section k ys::xs) else if i = (0 :num) then pos else pos_val (i − (1 :num)) (pos + line_length y) (Section k ys::xs)
pos_val_acc_typed=∀(ls :α sec list) (n :num). pos_val (SUM (MAP ((λ(xs :α line list). LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) xs)) ∘ (Section_lines :α sec -> α line list)) ls) :num) n ls = n + (SUM (MAP (SUM ∘ MAP (line_length :α line -> num) ∘ (Section_lines :α sec -> α line list)) ls) :num)
pos_val_thm_typed=pos_val (i :num) (pos :num) ([] :α sec list) = pos ∧ pos_val i pos (Section (k :num) (s :β line list)::(ss :β sec list)) = case sec_pos_val i pos s of (NONE :num option) => pos_val (i − LENGTH (FILTER ($¬ ∘ (is_Label :β line -> bool)) s)) (pos + (SUM (MAP (line_length :β line -> num) s) :num)) ss | SOME x => x
sec_pos_val_def_typed=(∀(i :num) (pos :num). sec_pos_val i pos ([] :α line list) = (NONE :num option)) ∧ ∀(i :num) (pos :num) (y :α line) (ys :α line list). sec_pos_val i pos (y::ys) = if is_Label y then sec_pos_val i (pos + line_length y) ys else if i = (0 :num) then SOME pos else sec_pos_val (i − (1 :num)) (pos + line_length y) ys
