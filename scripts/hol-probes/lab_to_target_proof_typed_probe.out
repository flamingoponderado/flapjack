pos_val_append_typed=∀(c1 :α sec list) (i :num) (pos :num) (c2 :α sec list). EVERY (sec_label_zero :α sec -> bool) c2 ⇒ pos_val i pos (c1 ++ c2) = if i ≤ (SUM (MAP ((λ(xs :α line list). LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) xs)) ∘ (Section_lines :α sec -> α line list)) c1) :num) then pos_val i pos c1 else pos_val (i − (SUM (MAP ((λ(xs :α line list). LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) xs)) ∘ (Section_lines :α sec -> α line list)) c1) :num)) (pos + (SUM (MAP (SUM ∘ MAP (line_length :α line -> num) ∘ (Section_lines :α sec -> α line list)) c1) :num)) c2
sec_label_zero_def_typed=∀(v0 :num) (ls :α line list). sec_label_zero (Section v0 ls) ⇔ EVERY (label_zero :α line -> bool) ls
sec_label_zero_pos_val_0_typed=∀(xs :α sec list) (pos :num). EVERY (sec_label_zero :α sec -> bool) xs ⇒ pos_val (0 :num) pos xs = pos
pos_val_acc_sum_typed=∀(i :num) (pos :num) (secs :α sec list) (x :num) (y :num). x + y = pos ⇒ x + pos_val i y secs = pos_val i pos secs
pos_val_acc_0_typed=∀(i :num) (pos :num) (secs :α sec list). pos + pos_val i (0 :num) secs = pos_val i pos secs
pos_val_APPEND1_typed=∀(pc :num) (code :α sec list). pc < num_pcs code ⇒ pos_val pc (0 :num) (code ++ (sec_list :α sec list)) = pos_val pc (0 :num) code
pos_val_APPEND2_typed=∀(c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (p :num) (code :α sec list). all_enc_ok c labs ffis p code ⇒ pos_val ((pc :num) + num_pcs code) (0 :num) (code ++ (sec_list :α sec list)) = LENGTH (prog_to_bytes code) + pos_val pc (0 :num) sec_list
