line_ok_def_typed=(line_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos' :num) (Label (v0 :num) (v1 :num) (l :num) :α line) ⇔ EVEN pos' ∧ l = (0 :num)) ∧ (line_ok c labs ffis pos' (Asm (b :α asm_or_cbw) (bytes :word8 list) l) ⇔ enc_with_nop c.encode (cbw_to_asm b) bytes ∧ LENGTH bytes = l ∧ asm_ok (cbw_to_asm b) c) ∧ (line_ok c labs ffis pos' (LabAsm (Halt :α asm_with_lab) (w :α word) bytes l) ⇔ (let (w1 :α word) = (0w :α word) − (n2w (pos' + ffi_offset) :α word) in enc_with_nop c.encode (Jump w1 :α asm) bytes ∧ LENGTH bytes = l ∧ asm_ok (Jump w1 :α asm) c)) ∧ (line_ok c labs ffis pos' (LabAsm (Install :α asm_with_lab) w bytes l) ⇔ (let (w1 :α word) = (0w :α word) − (n2w (pos' + (2 :num) * ffi_offset) :α word) in enc_with_nop c.encode (Jump w1 :α asm) bytes ∧ LENGTH bytes = l ∧ asm_ok (Jump w1 :α asm) c)) ∧ (line_ok c labs ffis pos' (LabAsm (CallFFI (index :mlstring) :α asm_with_lab) w bytes l) ⇔ (let (w1 :α word) = (0w :α word) − (n2w (pos' + ((3 :num) + get_ffi_index ffis (ExtCall index)) * ffi_offset) :α word) in enc_with_nop c.encode (Jump w1 :α asm) bytes ∧ LENGTH bytes = l ∧ asm_ok (Jump w1 :α asm) c)) ∧ (line_ok c labs ffis pos' (LabAsm (Call (v24 :lab) :α asm_with_lab) w bytes l) ⇔ F) ∧ (line_ok c labs ffis pos' (LabAsm (Jump (v19 :lab) :α asm_with_lab) w bytes l) ⇔ case get_label (Jump v19 :α asm_with_lab) of Lab l1 l2 => case lab_lookup l1 l2 labs of (NONE :num option) => F | SOME t => (let (w1 :α word) = (n2w t :α word) − (n2w pos' :α word) in enc_with_nop c.encode (lab_inst w1 (Jump v19 :α asm_with_lab)) bytes ∧ LENGTH bytes = l ∧ asm_ok (lab_inst w1 (Jump v19 :α asm_with_lab)) c)) ∧ (line_ok c labs ffis pos' (LabAsm (JumpCmp (v20 :cmp) (v21 :num) (v22 :α reg_imm) (v23 :lab) :α asm_with_lab) w bytes l) ⇔ case get_label (JumpCmp v20 v21 v22 v23 :α asm_with_lab) of Lab l1 l2 => case lab_lookup l1 l2 labs of (NONE :num option) => F | SOME t => (let (w1 :α word) = (n2w t :α word) − (n2w pos' :α word) in enc_with_nop c.encode (lab_inst w1 (JumpCmp v20 v21 v22 v23 :α asm_with_lab)) bytes ∧ LENGTH bytes = l ∧ asm_ok (lab_inst w1 (JumpCmp v20 v21 v22 v23 :α asm_with_lab)) c)) ∧ (line_ok c labs ffis pos' (LabAsm (LocValue (v26 :num) (v27 :lab) :α asm_with_lab) w bytes l) ⇔ case get_label (LocValue v26 v27 :α asm_with_lab) of Lab l1 l2 => case lab_lookup l1 l2 labs of (NONE :num option) => F | SOME t => (let (w1 :α word) = (n2w t :α word) − (n2w pos' :α word) in enc_with_nop c.encode (lab_inst w1 (LocValue v26 v27 :α asm_with_lab)) bytes ∧ LENGTH bytes = l ∧ asm_ok (lab_inst w1 (LocValue v26 v27 :α asm_with_lab)) c))
