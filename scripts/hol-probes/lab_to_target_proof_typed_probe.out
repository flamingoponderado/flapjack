line_len_def_typed=(∀(v0 :num) (v1 :num) (l :num). line_len (Label v0 v1 l :α line) = l) ∧ (∀(v2 :α asm_or_cbw) (v3 :word8 list) (l :num). line_len (Asm v2 v3 l) = l) ∧ ∀(v4 :α asm_with_lab) (v5 :α word) (v6 :word8 list) (l :num). line_len (LabAsm v4 v5 v6 l) = l
list_subset_refl_typed=∀(xs :α list). list_subset xs xs
list_subset_TAKE_typed=∀(i :num) (xs :α list). list_subset (TAKE i xs) xs
list_subset_trans_typed=list_subset (a :α list) (b :α list) ∧ list_subset b (c :α list) ⇒ list_subset a c
machine_sem_EQ_sem_typed=∀(mc_conf :(α, 'state, β) machine_config) (p :α word) (ms :'state) (s1 :(α, config, 'ffi) labSem$state). encoder_correct mc_conf.target ∧ init_ok (mc_conf,p) s1 ms ∧ (semantics s1 :behaviour) ≠ Fail ⇒ machine_sem mc_conf s1.ffi ms = {(semantics s1 :behaviour)}
bytes_in_mem_UPDATE_typed=∀(ls :α list) (a :β word) (m :β word -> α) (md :β word -> bool) (md2 :β word -> bool) (w1 :β word) (w2 :α). (∀(n :num). n < LENGTH ls ⇒ a + (n2w n :β word) ≠ w1) ∧ bytes_in_mem a ls m md md2 ⇒ bytes_in_mem a ls m⦇w1 ↦ w2⦈ md md2
bytes_in_memory_eq_mem_typed=∀(pc :α word) (bytes :word8 list). (∀(a :α word). a ∈ (t1 :α asm_state).mem_domain ⇒ (mc_conf :(α, β, γ) machine_config).target.get_byte (ms1 :β) a = (t1.mem a :word8)) ∧ bytes_in_memory pc bytes t1.mem t1.mem_domain ⇒ bytes_in_memory pc bytes (mc_conf.target.get_byte ms1) t1.mem_domain
mmio_pcs_min_index_is_SOME_typed=∀(ffi_names :ffiname list). mmio_pcs_min_index ffi_names = SOME (i :num) ⇒ i ≤ LENGTH ffi_names ∧ (∀(j :num). j < i ⇒ ∃(s :mlstring). ffi_names❲j❳ = ExtCall s) ∧ ∀(j :num). i ≤ j ∧ j < LENGTH ffi_names ⇒ ∃(op :shmem_op). ffi_names❲j❳ = SharedMem op
mmio_pcs_min_index_APPEND_thm_typed=EVERY (λ(x :ffiname). ∀(s :mlstring). x ≠ ExtCall s) (l :ffiname list) ∧ EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) (ffis :ffiname list) ⇒ mmio_pcs_min_index (ffis ++ l) = SOME (LENGTH ffis)
mmio_pcs_min_index_get_shmem_info_ok_typed=all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis' :ffiname list) (p' :num) (code2 :α sec list) ∧ enc_ok c ∧ EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) (ffis :ffiname list) ∧ get_shmem_info code2 (p :num) ffis ([] :shmem_info_num list) = ((new_ffi_names :ffiname list),(new_shmem_info :shmem_info_num list)) ⇒ mmio_pcs_min_index new_ffi_names = SOME (LENGTH ffis)
