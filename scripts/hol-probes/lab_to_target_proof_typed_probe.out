good_code_def_typed=∀(c :α asm_config) (labs :β sptree$num_map sptree$num_map) (code :α sec list). good_code c labs code ⇔ EVERY (sec_ends_with_label :α sec -> bool) code ∧ EVERY (sec_labels_ok :α sec -> bool) code ∧ ALL_DISTINCT (MAP (Section_num :α sec -> num) code) ∧ EVERY ((ALL_DISTINCT :(num # num) list -> bool) ∘ (extract_labels :α line list -> (num # num) list) ∘ (Section_lines :α sec -> α line list)) code ∧ DISJOINT (domain labs :num -> bool) (set (MAP (Section_num :α sec -> num) code)) ∧ restrict_nonzero (get_labels code) ⊆ get_code_labels code ∪ labs_domain labs ∧ all_enc_ok_pre c code
implements_intro_gen_typed=((b :bool) ∧ (x :behaviour) ≠ Fail ⇒ (y :behaviour -> bool) = {x}) ⇒ b ⇒ implements' T y {x}
