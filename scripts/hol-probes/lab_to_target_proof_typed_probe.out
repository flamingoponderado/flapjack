enc_lines_again_simp_def_typed=(∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (enc :α asm -> word8 list). enc_lines_again_simp labs ffis pos enc ([] :α line list) = (([] :α line list),T)) ∧ (∀(xs :α line list) (w :α word) (pos :num) (labs :num sptree$num_map sptree$num_map) (l :num) (ffis :ffiname list) (enc :α asm -> word8 list) (bytes :word8 list) (a :α asm_with_lab). enc_lines_again_simp labs ffis pos enc (LabAsm a w bytes l::xs) = (let (w1 :α word) = (get_jump_offset a ffis labs pos :α word) in if w = w1 then (let ((rest :α line list),(ok :bool)) = enc_lines_again_simp labs ffis (pos + l) enc xs in (LabAsm a w bytes l::rest,ok)) else (let (bs :word8 list) = enc (lab_inst w1 a); (l1 :num) = MAX (LENGTH bs) l; ((rest :α line list),(ok :bool)) = enc_lines_again_simp labs ffis (pos + l1) enc xs in (LabAsm a w1 bs l1::rest,l1 = l ∧ ok)))) ∧ (∀(xs :α line list) (pos :num) (labs :num sptree$num_map sptree$num_map) (l :num) (k2 :num) (k1 :num) (ffis :ffiname list) (enc :α asm -> word8 list). enc_lines_again_simp labs ffis pos enc ((Label k1 k2 l :α line)::xs) = (let ((rest :α line list),(ok :bool)) = enc_lines_again_simp labs ffis (pos + l) enc xs in ((Label k1 k2 l :α line)::rest,ok))) ∧ ∀(xs :α line list) (x2 :word8 list) (x1 :α asm_or_cbw) (pos :num) (labs :num sptree$num_map sptree$num_map) (l :num) (ffis :ffiname list) (enc :α asm -> word8 list). enc_lines_again_simp labs ffis pos enc (Asm x1 x2 l::xs) = (let ((rest :α line list),(ok :bool)) = enc_lines_again_simp labs ffis (pos + l) enc xs in (Asm x1 x2 l::rest,ok))
