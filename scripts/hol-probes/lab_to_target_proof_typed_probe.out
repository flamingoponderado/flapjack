line_len_pad_section_typed=∀(nop :word8 list) (xs :α line list) (aux :α line list). LENGTH nop = (1 :num) ∧ EVERY (label_one :α line -> bool) xs ∧ (EVERY (is_Label :α line -> bool) aux ⇒ label_prefix_zero xs) ⇒ (SUM (MAP (line_len :α line -> num) (pad_section nop xs aux)) :num) = (SUM (MAP (line_len :α line -> num) xs) :num) + (SUM (MAP (line_len :α line -> num) aux) :num)
