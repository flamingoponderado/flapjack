lines_enc_with_nop_pad_section1_typed=∀(nop :word8 list) (code :α line list) (aux :α line list) (pos :num). nop = (enc :α asm -> word8 list) (Inst (Skip :α inst) :α asm) ∧ LENGTH nop = (1 :num) ∧ lines_encd enc (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos + (SUM (MAP (line_len :α line -> num) aux) :num)) code ∧ lines_enc_with_nop enc labs ffis pos (REVERSE aux) ∧ ¬EVERY (is_Label :α line -> bool) aux ∧ EVERY (label_one :α line -> bool) code ⇒ lines_enc_with_nop enc labs ffis pos (pad_section nop code aux)
semantics_compile_typed=mc_conf_ok (mc_conf :(α, β, γ) machine_config) ∧ (no_share_mem_inst (code :α sec list) ⇒ compiler_oracle_ok (coracle :num -> config # α sec list) (c' :config).labels (LENGTH (bytes :word8 list)) (asm_conf :α asm_config) mc_conf.ffi_names) ∧ good_code asm_conf (c :config).labels code ∧ asm_conf = mc_conf.target.config ∧ isEmpty c.labels ∧ c.pos = (0 :num) ∧ (compile asm_conf c code :(word8 list # config) option) = SOME (bytes,c') ∧ c'.ffi_names = SOME mc_conf.ffi_names ∧ good_init_state mc_conf (ms :β) bytes (cbspace :num) (t :α asm_state) (m :α word -> α word_loc) (dm :α word -> bool) (sdm :α word -> bool) ∧ mmio_pcs_min_index mc_conf.ffi_names = SOME (i :num) ∧ MAP (λ(rec :shmem_info_num). w2n (mc_conf.target.get_pc ms) + rec.entry_pc) c'.shmem_extra = DROP i (MAP (w2n :α word -> num) mc_conf.ffi_entry_pcs) ∧ mc_conf.mmio_info = ZIP (GENLIST (λ(index :num). index + i) (LENGTH c'.shmem_extra),MAP (λ(rec :shmem_info_num). (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off :α word),rec.reg,(n2w rec.exit_pc :α word) + mc_conf.target.get_pc ms)) c'.shmem_extra) ∧ no_install_or_no_share_mem code mc_conf.ffi_names ∧ cbspace + LENGTH bytes + ffi_offset * (i + (3 :num)) < dimword (:α) ∧ (∀(ffis :ffiname list). c.ffi_names = SOME ffis ⇒ EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) ffis) ⇒ implements' T (machine_sem mc_conf (ffi :δ ffi_state) ms) {(semantics (make_init mc_conf ffi t m (dm ∩ (byte_aligned :α word -> bool)) (sdm ∩ (byte_aligned :α word -> bool)) ms code (compile asm_conf :config -> α sec list -> (word8 list # config) option) (mc_conf.target.get_pc ms + (n2w (LENGTH bytes) :α word)) cbspace coracle) :behaviour)}
share_mem_domain_code_rel_def_typed=∀(mc_conf :(α, β, γ) machine_config) (p :α word) (code2 :α sec list) (s1_shared_mem_domain :α word -> bool). share_mem_domain_code_rel mc_conf p code2 s1_shared_mem_domain ⇔ (∀(pc :num) (op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num) (i :num). asm_fetch_aux pc code2 = SOME (Asm (ShareMem op re a) inst len) ∧ mmio_pcs_min_index mc_conf.ffi_names = SOME i ⇒ ∃(index :num). i ≤ index ∧ find_index (p + (n2w (pos_val pc (0 :num) code2) :α word)) mc_conf.ffi_entry_pcs (0 :num) = SOME index ∧ (let ((name :shmem_op),(nb :word8)) = get_memop_info op in mc_conf.ffi_names❲index❳ = SharedMem name ∧ ALOOKUP mc_conf.mmio_info index = SOME (nb,a,re,p + (n2w (pos_val pc (0 :num) code2 + len) :α word)))) ∧ (∀(pc :num) (line :α line). asm_fetch_aux pc code2 = SOME line ∧ (∀(op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num). line ≠ Asm (ShareMem op re a) inst len) ⇒ DISJOINT (set mc_conf.ffi_entry_pcs) {p + (n2w a :α word) + (n2w (pos_val pc (0 :num) code2) :α word) | a < LENGTH (line_bytes line)}) ∧ (∀(a :α word). byte_align a ∈ s1_shared_mem_domain ⇒ a ∈ s1_shared_mem_domain) ∧ mc_conf.shared_addresses = s1_shared_mem_domain
share_mem_state_rel_def_typed=∀(mc_conf :(β, γ, δ) machine_config) (s1 :(α, config, 'ffi) labSem$state) (t1 :ε) (ms1 :ζ). share_mem_state_rel mc_conf s1 t1 ms1 ⇔ (∀(ms2 :γ) (k :num) (index :num) (new_bytes :word8 list) (t1 :β asm_state) (nb :word8) (ad :num) (offs :β word) (re :num) (pc' :β word) (ad' :β word) (st :'ffi ffi_state) (new_st :'ffi ffi_state) (i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ i ≤ index ∧ index < LENGTH mc_conf.ffi_names ∧ (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s1.ffi st ∧ ALOOKUP mc_conf.mmio_info index = SOME (nb,Addr ad offs,re,pc') ∧ mc_conf.prog_addresses = t1.mem_domain ∧ ad' = mc_conf.target.get_reg ms2 ad + offs ∧ target_state_rel mc_conf.target (t1 with pc := mc_conf.ffi_entry_pcs❲index❳) ms2 ⇒ ∃(op :shmem_op). mc_conf.ffi_names❲index❳ = SharedMem op ∧ case op of MappedRead => (if nb = (0w :word8) then w2n ad' MOD (dimindex (:α) DIV (8 :num)) = (0 :num) else T) ∧ ad' ∈ mc_conf.shared_addresses ∧ is_valid_mapped_read (mc_conf.target.get_pc ms2) nb (Addr ad offs) re pc' mc_conf.target ms2 mc_conf.prog_addresses ∧ call_FFI st (SharedMem MappedRead) [nb] (word_to_bytes ad' F) = FFI_return new_st new_bytes ⇒ target_state_rel mc_conf.target (t1 with <|pc := pc'; regs := (λ(n :num). if n = re then word_of_bytes F (0w :β word) new_bytes else (t1.regs n :β word))|>) (mc_conf.ffi_interfer k (index,new_bytes,ms2)) | MappedWrite => (if nb = (0w :word8) then w2n ad' MOD (dimindex (:α) DIV (8 :num)) = (0 :num) else T) ∧ ad' ∈ mc_conf.shared_addresses ∧ is_valid_mapped_write (mc_conf.target.get_pc ms2) nb (Addr ad offs) re pc' mc_conf.target ms2 mc_conf.prog_addresses ∧ call_FFI st (SharedMem MappedWrite) [nb] ((let (w :β word) = mc_conf.target.get_reg ms2 re in if nb = (0w :word8) then word_to_bytes w F else word_to_bytes_aux (w2n nb) w F) ++ word_to_bytes ad' F) = FFI_return new_st new_bytes ⇒ target_state_rel mc_conf.target (t1 with pc := pc') (mc_conf.ffi_interfer k (index,new_bytes,ms2))) ∧ ∀(index :num) (i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ index < LENGTH mc_conf.ffi_names ∧ i ≤ index ⇒ mc_conf.halt_pc ≠ mc_conf.ffi_entry_pcs❲index❳ ∧ mc_conf.ccache_pc ≠ mc_conf.ffi_entry_pcs❲index❳
get_shmem_info_ok_lemma_typed=all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis' :ffiname list) (p' :num) (code2 :α sec list) ∧ enc_ok c ∧ LENGTH (prog_to_bytes code2) < dimword (:α) ∧ EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) (ffis :ffiname list) ∧ get_shmem_info code2 (p :num) ffis ([] :shmem_info_num list) = ((new_ffi_names :ffiname list),(new_shmem_info :shmem_info_num list)) ⇒ (∀(pc :num) (op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num) (i :num). asm_fetch_aux pc code2 = SOME (Asm (ShareMem op re a) inst len) ∧ mmio_pcs_min_index new_ffi_names = SOME i ⇒ ∃(index :num). find_index (p + pos_val pc (0 :num) code2) (MAP (λ(rec :shmem_info_num). rec.entry_pc) new_shmem_info) (0 :num) = SOME index ∧ (let ((name :shmem_op),(nb :word8)) = get_memop_info op in new_ffi_names❲index + i❳ = SharedMem name ∧ new_shmem_info❲index❳ = <|entry_pc := new_shmem_info❲index❳.entry_pc; nbytes := nb; addr_reg := case a of Addr r off => r; addr_off := case a of Addr r off => w2n off; reg := re; exit_pc := p + (pos_val pc (0 :num) code2 + len)|>)) ∧ ∀(pc :num) (line :α line). asm_fetch_aux pc code2 = SOME line ∧ (∀(op :memop) (re :num) (a :α addr) (inst :word8 list) (len :num). line ≠ Asm (ShareMem op re a) inst len) ⇒ DISJOINT (set (MAP (λ(rec :shmem_info_num). rec.entry_pc) new_shmem_info)) {p + a + pos_val pc (0 :num) code2 | a < LENGTH (line_bytes line)}
get_shmem_info_ALL_DISTINCT_typed=LENGTH (prog_to_bytes (code2 :α sec list)) < dimword (:α) ∧ enc_ok (c :α asm_config) ∧ all_enc_ok c (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (p' :num) code2 ⇒ ALL_DISTINCT (MAP (λ(rec :shmem_info_num). rec.entry_pc) (SND (get_shmem_info code2 (p :num) ([] :ffiname list) ([] :shmem_info_num list))))
genlist_line_to_info_entry_pc_max_typed=all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (p' :num) (code2 :α sec list) ∧ enc_ok c ⇒ EVERY (λ(x :ffiname # shmem_info_num). (SND x).entry_pc < pos_val (num_pcs code2) (0 :num) code2) (FLAT (GENLIST (λ(i :num). line_to_info code2 (0 :num) (i,asm_fetch_aux i code2)) (num_pcs code2)))
