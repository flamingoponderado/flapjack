t_pc ms + (n2w (LENGTH (prog_to_bytes code2)) :α word)) cbspace coracle) t ms :bool)
init_ok_def_typed=∀(mc_conf :(α, β, γ) machine_config) (p :α word) (s :(α, config, δ) labSem$state) (ms :β). init_ok (mc_conf,p) s ms ⇔ ∃(code2 :α sec list) (labs :num sptree$num_map sptree$num_map) (t1 :α asm_state). (state_rel (mc_conf,code2,labs,p) s t1 ms :bool) ∧ oracle_tie mc_conf ms s
