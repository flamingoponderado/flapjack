line_offset_ok_def_typed=(line_offset_ok (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos' :num) (LabAsm (a :α asm_with_lab) (w :α word) (bytes :word8 list) (v0 :num)) ⇔ w = (get_jump_offset a ffis labs pos' :α word)) ∧ (line_offset_ok (v1 :num sptree$num_map sptree$num_map) (v2 :ffiname list) (v3 :num) (Label (v10 :num) (v11 :num) (v12 :num) :α line) ⇔ T) ∧ (line_offset_ok v1 v2 v3 (Asm (v13 :α asm_or_cbw) (v14 :word8 list) (v15 :num)) ⇔ T)
lines_offset_ok_def_typed=(∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num). lines_offset_ok labs ffis pos ([] :α line list) ⇔ T) ∧ ∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (l :α line) (ls :α line list). lines_offset_ok labs ffis pos (l::ls) ⇔ line_offset_ok labs ffis pos l ∧ lines_offset_ok labs ffis (pos + line_len l) ls
lines_offset_ok_append_typed=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (l1 :α line list) (l2 :α line list). lines_offset_ok labs ffis pos (l1 ++ l2) ⇔ lines_offset_ok labs ffis pos l1 ∧ lines_offset_ok labs ffis (pos + (SUM (MAP (line_len :α line -> num) l1) :num)) l2
offset_ok_def_typed=(∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list). (offset_ok labs ffis pos ([] :α sec list) :bool) ⇔ T) ∧ ∀(ss :α sec list) (pos :num) (ls :α line list) (labs :num sptree$num_map sptree$num_map) (k :num) (ffis :ffiname list). (offset_ok labs ffis pos (Section k ls::ss) :bool) ⇔ lines_offset_ok labs ffis pos ls ∧ (offset_ok labs ffis (pos + (SUM (MAP (line_len :α line -> num) ls) :num)) ss :bool)
lines_offset_ok_pad_section_typed=∀(nop :word8 list) (lines :α line list) (aux :α line list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num). lab_len_pos_ok (pos + (SUM (MAP (line_len :α line -> num) aux) :num)) lines ∧ lab_len_pos_ok pos (REVERSE aux) ∧ EVERY (label_zero :α line -> bool) aux ∧ (¬NULL lines ∧ is_Label (HD lines) ∧ line_len (HD lines) = (1 :num) ⇒ ¬NULL aux ∧ ¬is_Label (HD aux)) ∧ lines_offset_ok labs ffis pos (REVERSE aux ++ lines) ⇒ lines_offset_ok labs ffis pos (pad_section nop lines aux)
oracle_tie_ccache_residues_typed=∀(mc_conf :(α, β, δ) machine_config) (mc2 :(α, β, δ) machine_config) (ms1 :β) (s1 :(α, γ, 'ffi) labSem$state) (ms2 :β) (l :num) (t1 :α asm_state). oracle_tie mc_conf ms1 s1 ∧ (∀(k :num). find_next_interference mc_conf s1.ffi (k + l) ms1 = find_next_interference mc2 s1.ffi k ms2) ∧ mc2.target = mc_conf.target ∧ mc2.ptr_reg = mc_conf.ptr_reg ∧ mc2.len_reg = mc_conf.len_reg ∧ mc2.ccache_interfer = mc_conf.ccache_interfer ∧ mc2.target.get_pc ms2 ∉ mc2.prog_addresses DIFF set mc2.ffi_entry_pcs ∧ mc2.target.get_pc ms2 ≠ mc2.halt_pc ∧ mc2.target.get_pc ms2 = mc2.ccache_pc ⇒ (λ(a :num). get_reg_value (s1.cc_regs (0 :num) a) (t1.regs a :α word) (I :α word -> α word)) = (λ(a :num). if MEM a mc_conf.callee_saved_regs ∨ a = mc_conf.ptr_reg ∨ ¬(a < mc_conf.target.config.reg_count) ∨ MEM a mc_conf.target.config.avoid_regs then (t1.regs a :α word) else mc_conf.target.get_reg (mc_conf.ccache_interfer (0 :num) (mc_conf.target.get_reg ms2 mc_conf.ptr_reg,mc_conf.target.get_reg ms2 mc_conf.len_reg,ms2)) a) ∧ (λ(n :num). s1.cc_fp_regs (0 :num) n) = (λ(n :num). mc_conf.target.get_fp_reg (mc_conf.ccache_interfer (0 :num) (mc_conf.target.get_reg ms2 mc_conf.ptr_reg,mc_conf.target.get_reg ms2 mc_conf.len_reg,ms2)) n)
oracle_tie_shift_gen_typed=∀(mc_conf :(α, β, δ) machine_config) (mc2 :(α, β, δ) machine_config) (ms1 :β) (s1 :(α, γ, 'ffi) labSem$state) (ms2 :β) (l :num). oracle_tie mc_conf ms1 s1 ∧ (∀(k :num). find_next_interference mc_conf s1.ffi (k + l) ms1 = find_next_interference mc2 s1.ffi k ms2) ∧ mc2.target = mc_conf.target ∧ mc2.callee_saved_regs = mc_conf.callee_saved_regs ∧ mc2.ptr_reg = mc_conf.ptr_reg ⇒ oracle_tie mc2 ms2 s1
oracle_tie_def_typed=∀(mc_conf :(α, 'state, β) machine_config) (ms :'state) (s1 :(α, γ, 'ffi) labSem$state). oracle_tie mc_conf ms s1 ⇔ s1.io_regs = target_io_regs mc_conf s1.ffi ms ∧ s1.io_fp_regs = target_io_fp_regs mc_conf s1.ffi ms ∧ s1.cc_regs = target_cc_regs mc_conf s1.ffi ms ∧ s1.cc_fp_regs = target_cc_fp_regs mc_conf s1.ffi ms
