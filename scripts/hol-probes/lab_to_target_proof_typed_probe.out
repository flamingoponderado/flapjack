all_encd_length_leq_typed=∀(enc :α asm -> word8 list) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num) (ls :α sec list). all_encd enc labs ffis pos ls ⇒ all_length_leq ls
