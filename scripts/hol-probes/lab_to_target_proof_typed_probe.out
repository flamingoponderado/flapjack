MEM_get_shmem_info_typed=all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (p' :num) (code2 :α sec list) ∧ asm_fetch_aux (pc :num) code2 = SOME (Asm (ShareMem (op :memop) (re :num) (a :α addr)) (inst' :word8 list) (len :num)) ∧ get_memop_info op = ((q :shmem_op),(r :word8)) ⇒ MEM (SharedMem q,<|entry_pc := pos_val pc (p :num) code2; nbytes := r; addr_reg := case a of Addr r off => r; addr_off := case a of Addr r off => w2n off; reg := re; exit_pc := pos_val pc (p + LENGTH inst') code2|>) (ZIP (get_shmem_info code2 p ([] :ffiname list) ([] :shmem_info_num list)))
get_shmem_info_MappedRead_or_MappedWrite_typed=∀(sec :α sec list) (pos :num) (ffi_names :ffiname list) (info :shmem_info_num list) (new_ffi_names :ffiname list) (new_info :shmem_info_num list). get_shmem_info sec pos ffi_names info = (new_ffi_names,new_info) ⇒ ∃(l :ffiname list). new_ffi_names = ffi_names ++ l ∧ EVERY (λ(x :ffiname). ∃(op :shmem_op). x = SharedMem op) l
get_shmem_info_init_pc_offset_typed=all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (p' :num) (code :α sec list) ⇒ FST (get_shmem_info code (0 :num) ([] :ffiname list) ([] :shmem_info_num list)) = FST (get_shmem_info code (p :num) ([] :ffiname list) ([] :shmem_info_num list)) ∧ MAP (λ(rec :shmem_info_num). rec with <|entry_pc := p + rec.entry_pc; exit_pc := p + rec.exit_pc|>) (SND (get_shmem_info code (0 :num) ([] :ffiname list) ([] :shmem_info_num list))) = SND (get_shmem_info code p ([] :ffiname list) ([] :shmem_info_num list))
line_to_info_offset_FST_eq_typed=MAP (FST :ffiname # shmem_info_num -> ffiname) (line_to_info (code :α sec list) (p :num) (accum :num # β line option)) = MAP (FST :ffiname # shmem_info_num -> ffiname) (line_to_info code (0 :num) accum)
