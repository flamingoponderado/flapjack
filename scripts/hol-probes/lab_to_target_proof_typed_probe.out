label_prefix_zero_def_typed=∀(ls :α line list). label_prefix_zero ls ⇔ ∀(n :num). n < LENGTH ls ∧ (∀(m :num). m ≤ n ⇒ is_Label ls❲m❳) ⇒ ∀(m :num). m ≤ n ⇒ line_len ls❲m❳ = (0 :num)
