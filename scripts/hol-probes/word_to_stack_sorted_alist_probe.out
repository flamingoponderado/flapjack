sa_full_ALOOKUP_IFF_MEM=⊢ ALL_DISTINCT (MAP FST l) ⇒ (ALOOKUP l q = SOME r ⇔ MEM (q,r) l)
sa_full_SORTED_CONS_IMP=⊢ SORTED (λx y. FST x > FST y) (h::t) ⇒ ¬MEM h t ∧ SORTED (λx y. FST x > FST y) t ∧ ∀x. MEM x t ⇒ FST h > FST x
sa_full_SORTED_IMP_ALL_DISTINCT_LEMMA=⊢ ∀l. SORTED (λx y. FST x > FST y) l ⇒ ALL_DISTINCT (MAP FST l)
sa_full_MEM_toAList_fromAList=⊢ SORTED (λx y. FST x > FST y) l ⇒ (MEM a (toAList (fromAList l)) ⇔ MEM a l)
sa_full_SORTED_FST_PERM_IMP_ALIST_EQ=⊢ SORTED (λx y. FST x > FST y) l ∧ SORTED (λx y. FST x > FST y) q ∧ PERM (toAList (fromAList l)) q ⇒ q = l
sa_full_ALL_DISTINCT_MEM_toAList_fromAList=⊢ ALL_DISTINCT (MAP FST ls) ⇒ (MEM x (toAList (fromAList ls)) ⇔ MEM x ls)
