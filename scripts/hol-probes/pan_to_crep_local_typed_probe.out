state_rel_structs_typed=∀(s :(α, β) panSem$state) (t :(α, β) state). state_rel s t ⇒ s.structs = ([] :(mlstring # struct_info) list)
state_rel_globals_typed=∀(s :(α, β) panSem$state) (t :(α, β) state). state_rel s t ⇒ s.globals = (FEMPTY :mlstring |-> α v)
pair_map_I_typed=(λ((x :α),(y :β)). (x,y)) = (I :α # β -> α # β)
decs_stcnames_lemma_typed=∀(code :α decl list) (ctxt :(mlstring # struct_info) list). EVERY (λ(d :α decl). is_function d ∨ is_exn_decl d) code ⇒ decs_stcnames ctxt code = SOME ctxt
evaluate_shape_invariant_ret_inst_typed=∀(p :α panLang$prog) (s :(α, β) panSem$state) (v :α panSem$result) (s' :(α, β) panSem$state) (t :(α, β) state) (ctxt :γ context) (t_locs :num |-> α word_lab). (evaluate (p,s) :α panSem$result option # (α, β) panSem$state) = (SOME v,s') ∧ state_rel s t ∧ (locals_rel ctxt s.locals t_locs :bool) ⇒ case v of (Error :α panSem$result) => T | (TimeOut :α panSem$result) => T | (Break :α panSem$result) => T | (Continue :α panSem$result) => T | (Return retv :α panSem$result) => is_wf_shape_v_nil retv | (Exception eid exn :α panSem$result) => is_wf_shape_v_nil exn | (FinalFFI v7 :α panSem$result) => T
evaluate_shape_invariant_ret_inst2_typed=∀(s :(α, β) panSem$state) (argexps :α panLang$exp list) (args :α v list) (fname :mlstring) (p :α panLang$prog) (p2 :α panLang$prog) (newlocals :mlstring |-> α v) (rsh :shape) (v :α panSem$result) (s' :(α, β) panSem$state) (t :(α, β) state) (ctxt :γ context) (t_locs :num |-> α word_lab). OPT_MMAP (eval s :α panLang$exp -> α v option) argexps = SOME args ∧ (lookup_code s.code fname args :(α panLang$prog # (mlstring |-> α v) # shape) option) = SOME (p2,newlocals,rsh) ∧ (evaluate (p,dec_clock s with locals := newlocals) :α panSem$result option # (α, β) panSem$state) = (SOME v,s') ∧ state_rel s t ∧ (locals_rel ctxt s.locals t_locs :bool) ⇒ case v of (Error :α panSem$result) => T | (TimeOut :α panSem$result) => T | (Break :α panSem$result) => T | (Continue :α panSem$result) => T | (Return retv :α panSem$result) => is_wf_shape_v_nil retv | (Exception eid exn :α panSem$result) => is_wf_shape_v_nil exn | (FinalFFI v7 :α panSem$result) => T
