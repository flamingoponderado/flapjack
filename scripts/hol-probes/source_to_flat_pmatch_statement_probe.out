pmatch_statement_typed=(∀(cenv :(mlstring, mlstring, num # stamp) namespace) (s :semanticPrimitives$v store_v list) (p :ast$pat) (v :semanticPrimitives$v) (env :(mlstring # semanticPrimitives$v) list) (r :(mlstring # semanticPrimitives$v) list match_result) (env' :(mlstring # semanticPrimitives$v) list) (env'' :(mlstring # semanticPrimitives$v) list) (env_i1 :(mlstring # v) list) (s_i1 :('f_orac_st, 'ffi) flatSem$state) (v_i1 :v) (st' :'ffi semanticPrimitives$state). (pmatch cenv s p v env :(mlstring # semanticPrimitives$v) list match_result) = r ∧ s_rel (genv :global_env) st' s_i1 ∧ global_env_inv genv (comp_map2 :source_to_flat$environment) (shadowers :mlstring -> bool) (senv :semanticPrimitives$v sem_env) ∧ genv_c_ok genv.c ∧ genv_c_tys_ok genv.c genv.tys ∧ cenv = senv.c ∧ comp_map2.c = (comp_map :source_to_flat$environment).c ∧ env = env' ++ env'' ∧ s_i1.globals = genv.v ∧ s = st'.refs ∧ (v_rel genv v v_i1 :bool) ∧ env_rel genv (alist_to_ns env' :(mlstring, mlstring, semanticPrimitives$v) namespace) env_i1 ⇒ ∃(r_i1 :(mlstring # v) list match_result). (pmatch s_i1 (compile_pat comp_map p) v_i1 env_i1 :(mlstring # v) list match_result) = r_i1 ∧ match_result_rel genv env'' r r_i1) ∧ ∀(cenv :(mlstring, mlstring, num # stamp) namespace) (s :semanticPrimitives$v store_v list) (ps :ast$pat list) (vs :semanticPrimitives$v list) (env :(mlstring # semanticPrimitives$v) list) (r :(mlstring # semanticPrimitives$v) list match_result) (env' :(mlstring # semanticPrimitives$v) list) (env'' :(mlstring # semanticPrimitives$v) list) (env_i1 :(mlstring # v) list) (s_i1 :('f_orac_st, 'ffi) flatSem$state) (vs_i1 :v list) (st' :'ffi semanticPrimitives$state). (pmatch_list cenv s ps vs env :(mlstring # semanticPrimitives$v) list match_result) = r ∧ global_env_inv genv comp_map2 shadowers senv ∧ genv_c_ok genv.c ∧ genv_c_tys_ok genv.c genv.tys ∧ cenv = senv.c ∧ comp_map2.c = comp_map.c ∧ env = env' ++ env'' ∧ s_i1.globals = genv.v ∧ s_rel genv st' s_i1 ∧ s = st'.refs ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs_i1 ∧ env_rel genv (alist_to_ns env' :(mlstring, mlstring, semanticPrimitives$v) namespace) env_i1 ⇒ ∃(r_i1 :(mlstring # v) list match_result). (pmatch_list s_i1 (MAP (compile_pat comp_map) ps) vs_i1 env_i1 :(mlstring # v) list match_result) = r_i1 ∧ match_result_rel genv env'' r r_i1
