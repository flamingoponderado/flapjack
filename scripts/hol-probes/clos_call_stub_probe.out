variables_type=:tra -> num -> num -> closLang$exp list
variables_def=!(t :tra) (n :num) (i :num). GENLIST_Var t i n = if n = (0 :num) then ([] :closLang$exp list) else GENLIST_Var t (i + (1 :num)) (n - (1 :num)) ++ [(Var t (n - (1 :num)) :closLang$exp)]
calls_list_type=:tra -> num -> num -> (num # 'a) list -> (num # closLang$exp) list
calls_list_def=(!(t :tra) (loc :num) (i :num). calls_list t i loc ([] :(num # 'a) list) = ([] :(num # closLang$exp) list)) /\ !(xs :(num # 'a) list) (v0 :'a) (t :tra) (n :num) (loc :num) (i :num). calls_list t i loc ((n,v0)::xs) = (n,Call t (0 :num) (loc + (1 :num)) (GENLIST_Var t (1 :num) n))::calls_list t (i + (1 :num)) (loc + (2 :num)) xs
calls_list_mapi=!(loc :num) (tra :'a) (n :num). (calls_list (t :tra) n loc :(num # 'b) list -> (num # closLang$exp) list) = MAPi (\(i :num) (p :num # 'b). (FST p,Call t (0 :num) (loc + (2 :num) * i + (1 :num)) (GENLIST_Var t (1 :num) (FST p))))
code_locs_GENLIST_Var_typed=!(n :num) (t :tra) (i :num). code_locs (GENLIST_Var t i n) = ([] :num list)
fv_GENLIST_Var_tra_typed=!(n :num) (tra :tra) (i :num). fv (v :num) (GENLIST_Var tra i n) <=> v < n
evaluate_GENLIST_Var_tra_typed=!(n :num) (tr :tra) (i :num). evaluate (GENLIST_Var tr i n,(env :v list),(s :('a, 'b) state)) = if n <= LENGTH env then ((Rval (TAKE n env) :(v list, v) result),s) else ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s)
compile_ALL_DISTINCT_typed=compile (do_call :bool) (x :closLang$exp list) = ((y :closLang$exp list),(g :sptree$num_set),(aux :(num # num # closLang$exp) list)) /\ ALL_DISTINCT (code_locs x) ==> ALL_DISTINCT (MAP (FST :num # num # closLang$exp -> num) aux)
no_Labels_GENLIST_Var_typed=!(n :tra) (l :num) (w :num). EVERY no_Labels (GENLIST_Var n l w)
no_Labels_calls_list_typed=!(t :tra) (k1 :num) (loc :num) (fns :(num # 'a) list). EVERY no_Labels (MAP (SND :num # closLang$exp -> closLang$exp) (calls_list t k1 loc fns))
obeys_max_app_GENLIST_Var_typed=!(n :tra) (l :num) (w :num). EVERY (obeys_max_app (k :num)) (GENLIST_Var n l w)
obeys_max_app_calls_list_typed=!(t :tra) (k1 :num) (loc :num) (fns :(num # 'a) list). EVERY (obeys_max_app (k :num)) (MAP (SND :num # closLang$exp -> closLang$exp) (calls_list t k1 loc fns))
cases=([Var None 0; Var None 1; Var None 2],[(2,Call None 0 11 [Var None 0; Var None 1]); (0,Call None 0 13 []); (1,Call None 0 15 [Var None 0])])
