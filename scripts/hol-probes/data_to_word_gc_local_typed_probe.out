heap_split_APPEND_prime_typed=heap_split (SUM (MAP (el_length :(α, β) heap_element -> num) (h1 :(α, β) heap_element list)) :num) (h1 ++ (h2 :(α, β) heap_element list)) = SOME (h1,h2)
traverse_heap_typed=(∀(heap :(α, β) heap_element list) (p1 :num list). traverse_heap heap p1 ([] :α heap_address list) p1) ∧ (∀(heap :(α, β) heap_element list) (vs1 :α heap_address list) (vs2 :α heap_address list) (vars :α heap_address list) (p1 :num list) (p2 :num list) (p3 :num list). traverse_heap heap p1 vs1 p2 ∧ traverse_heap heap p2 vs2 p3 ∧ set vars = set (vs1 ++ vs2) ⇒ traverse_heap heap p1 vars p3) ∧ (∀(heap :(α, β) heap_element list) (p1 :num list) (d :α). traverse_heap heap p1 [Data d] p1) ∧ (∀(heap :(α, β) heap_element list) (p1 :num list) (n :num) (t :α). MEM n p1 ⇒ traverse_heap heap p1 [Pointer n t] p1) ∧ ∀(heap :(α, β) heap_element list) (p1 :num list) (n :num) (t :α) (p2 :num list) (xs :α heap_address list) (l :num) (d :β). heap_lookup n heap = SOME (DataElement xs l d) ∧ traverse_heap heap (n::p1) xs p2 ⇒ traverse_heap heap p1 [Pointer n t] p2
size_of_Block_typed=size_of (lims :limits) [(Block (ts :num) (tag :num) (vs :v list) :v)] (refs :v ref sptree$num_map) (seen :sptree$num_set) = if vs = ([] :v list) ∨ IS_SOME (lookup ts seen :unit option) then ((0 :num),refs,seen) else (let ((n :num),(refs' :v ref sptree$num_map),(seen' :sptree$num_set)) = size_of lims vs refs (insert ts () seen :sptree$num_set) in (n + LENGTH vs + (1 :num),refs',seen'))
