value_rel_type=:global_env -> semanticPrimitives$v -> v -> bool
env_rel_type=:global_env -> (mlstring, mlstring, semanticPrimitives$v) namespace -> (mlstring # v) list -> bool
global_inv_type=:global_env -> source_to_flat$environment -> (mlstring -> bool) -> semanticPrimitives$v sem_env -> bool
value_rel_rules=(∀(genv :global_env) (lit :lit). (v_rel genv (Litv lit :semanticPrimitives$v) (Litv lit :v) :bool)) ∧ (∀(genv :global_env) (cn :stamp) (cn' :num # num option) (vs :semanticPrimitives$v list) (vs' :v list). LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs' ∧ FLOOKUP genv.c (cn',LENGTH vs) = SOME cn ⇒ (v_rel genv (Conv (SOME cn) vs) (Conv (SOME cn') vs') :bool)) ∧ (∀(genv :global_env) (vs :semanticPrimitives$v list) (vs' :v list). LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs' ⇒ (v_rel genv (Conv (NONE :stamp option) vs) (Conv (NONE :(num # num option) option) vs') :bool)) ∧ (∀(genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (env_v_local :(mlstring, mlstring, semanticPrimitives$v) namespace) (x :mlstring) (e :ast$exp) (env_v_local' :v environment) (t :mlstring list) (ts :tra list). env_rel genv env_v_local env_v_local'.v ∧ global_env_inv genv comp_map (set (MAP (FST :mlstring # v -> mlstring) env_v_local'.v)) env ∧ LENGTH ts = LENGTH env_v_local'.v + (1 :num) ⇒ (v_rel genv (Closure (env with v := nsAppend env_v_local env.v) x e :semanticPrimitives$v) (Closure env_v_local' x (compile_exp t (comp_map with v := bind_locals ts (x::MAP (FST :mlstring # v -> mlstring) env_v_local'.v) comp_map.v) e :exp) :v) :bool)) ∧ (∀(genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (env_v_local :(mlstring, mlstring, semanticPrimitives$v) namespace) (funs :(mlstring # mlstring # ast$exp) list) (x :mlstring) (env_v_local' :v environment) (t :mlstring list) (ts :tra list). env_rel genv env_v_local env_v_local'.v ∧ global_env_inv genv comp_map (set (MAP (FST :mlstring # v -> mlstring) env_v_local'.v)) env ∧ LENGTH ts = LENGTH funs + LENGTH env_v_local'.v ⇒ (v_rel genv (Recclosure (env with v := nsAppend env_v_local env.v) funs x :semanticPrimitives$v) (Recclosure env_v_local' (compile_funs t (comp_map with v := bind_locals ts (MAP (FST :mlstring # mlstring # ast$exp -> mlstring) funs ++ MAP (FST :mlstring # v -> mlstring) env_v_local'.v) comp_map.v) funs) x :v) :bool)) ∧ (∀(genv :global_env) (comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (funs :(mlstring # mlstring # ast$exp) list) (flat_env :v environment) (x :mlstring) (y :mlstring) (e :ast$exp) (new_vars :(mlstring # var_name) list) (t1 :mlstring list) (t2 :tra). MAP (FST :mlstring # var_name -> mlstring) new_vars = MAP (FST :mlstring # mlstring # ast$exp -> mlstring) (REVERSE funs) ∧ global_env_inv genv comp_map (∅ :mlstring -> bool) env ∧ flat_env.v = ([] :(mlstring # v) list) ∧ find_recfun x funs = SOME (y,e) ∧ (∀(x :mlstring). MEM x (MAP (FST :mlstring # mlstring # ast$exp -> mlstring) funs) ⇒ ∃(n :num) (y :mlstring) (e :ast$exp) (t1 :tra) (t2 :mlstring list) (t3 :tra). ALOOKUP new_vars x = SOME (Glob t1 n) ∧ n < LENGTH genv.v ∧ find_recfun x funs = SOME (y,e) ∧ genv.v❲n❳ = SOME (Closure flat_env y (compile_exp t2 (comp_map with v := nsBindList ((y,Local t3 y)::new_vars) comp_map.v) e :exp) :v)) ⇒ (v_rel genv (Recclosure env funs x :semanticPrimitives$v) (Closure flat_env y (compile_exp t1 (comp_map with v := nsBindList ((y,Local t2 y)::new_vars) comp_map.v) e :exp) :v) :bool)) ∧ (∀(genv :global_env) (loc :num) (b :bool). (v_rel genv (Loc b loc :semanticPrimitives$v) (Loc b (loc + (1 :num)) :v) :bool)) ∧ (∀(genv :global_env) (vs :semanticPrimitives$v list) (vs' :v list). LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs' ⇒ (v_rel genv (Vectorv vs) (Vectorv vs') :bool)) ∧ (∀(genv :global_env). env_rel genv (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace) ([] :(mlstring # v) list)) ∧ (∀(genv :global_env) (x :mlstring) (v :semanticPrimitives$v) (env :(mlstring, mlstring, semanticPrimitives$v) namespace) (env' :(mlstring # v) list) (v' :v). env_rel genv env env' ∧ (v_rel genv v v' :bool) ⇒ env_rel genv (nsBind x v env) ((x,v')::env')) ∧ ∀(genv :global_env) (comp_map :source_to_flat$environment) (shadowers :mlstring -> bool) (env :semanticPrimitives$v sem_env). (∀(x :(mlstring, mlstring) id) (v :semanticPrimitives$v). x ∉ IMAGE (Short :mlstring -> (mlstring, mlstring) id) shadowers ∧ nsLookup env.v x = SOME v ⇒ ∃(n :num) (v' :v) (t :tra). nsLookup comp_map.v x = SOME (Glob t n) ∧ n < LENGTH genv.v ∧ genv.v❲n❳ = SOME v' ∧ (v_rel genv v v' :bool)) ∧ (∀(x :(mlstring, mlstring) id) (arity :num) (stamp :stamp). nsLookup env.c x = SOME (arity,stamp) ⇒ ∃(cn :num) (ty_gp :(num # (num # num) list) option). nsLookup comp_map.c x = SOME (cn,ty_gp) ∧ FLOOKUP genv.c ((cn,OPTION_MAP (FST :num # (num # num) list -> num) ty_gp),arity) = SOME stamp ∧ ∀(ty_id :num) (ctors :(num # num) list). ty_gp = SOME (ty_id,ctors) ⇒ FLOOKUP genv.tys ty_id = SOME ctors) ⇒ global_env_inv genv comp_map shadowers env

