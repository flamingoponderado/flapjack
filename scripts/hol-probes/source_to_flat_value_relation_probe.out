ts = LENGTH funs + LENGTH env_v_local'.v) ∨ (∃(comp_map :source_to_flat$environment) (env :semanticPrimitives$v sem_env) (funs :(mlstring # mlstring # ast$exp) list) (flat_env :v environment) (x :mlstring) (y :mlstring) (e :ast$exp) (new_vars :(mlstring # var_name) list) (t1 :mlstring list) (t2 :tra). a1 = (Recclosure env funs x :semanticPrimitives$v) ∧ a2 = (Closure flat_env y (compile_exp t1 (comp_map with v := nsBindList ((y,Local t2 y)::new_vars) comp_map.v) e :exp) :v) ∧ MAP (FST :mlstring # var_name -> mlstring) new_vars = MAP (FST :mlstring # mlstring # ast$exp -> mlstring) (REVERSE funs) ∧ global_env_inv a0 comp_map (∅ :mlstring -> bool) env ∧ flat_env.v = ([] :(mlstring # v) list) ∧ find_recfun x funs = SOME (y,e) ∧ ∀(x :mlstring). MEM x (MAP (FST :mlstring # mlstring # ast$exp -> mlstring) funs) ⇒ ∃(n :num) (y :mlstring) (e :ast$exp) (t1 :tra) (t2 :mlstring list) (t3 :tra). ALOOKUP new_vars x = SOME (Glob t1 n) ∧ n < LENGTH a0.v ∧ find_recfun x funs = SOME (y,e) ∧ a0.v❲n❳ = SOME (Closure flat_env y (compile_exp t2 (comp_map with v := nsBindList ((y,Local t3 y)::new_vars) comp_map.v) e :exp) :v)) ∨ (∃(loc :num) (b :bool). a1 = (Loc b loc :semanticPrimitives$v) ∧ a2 = (Loc b (loc + (1 :num)) :v)) ∨ ∃(vs :semanticPrimitives$v list) (vs' :v list). a1 = Vectorv vs ∧ a2 = Vectorv vs' ∧ LIST_REL (v_rel a0 :semanticPrimitives$v -> v -> bool) vs vs') ∧ (∀(a3 :global_env) (a4 :(mlstring, mlstring, semanticPrimitives$v) namespace) (a5 :(mlstring # v) list). env_rel a3 a4 a5 ⇔ a4 = (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace) ∧ a5 = ([] :(mlstring # v) list) ∨ ∃(x :mlstring) (v :semanticPrimitives$v) (env :(mlstring, mlstring, semanticPrimitives$v) namespace) (env' :(mlstring # v) list) (v' :v). a4 = nsBind x v env ∧ a5 = (x,v')::env' ∧ env_rel a3 env env' ∧ (v_rel a3 v v' :bool)) ∧ ∀(a6 :global_env) (a7 :source_to_flat$environment) (a8 :mlstring -> bool) (a9 :semanticPrimitives$v sem_env). global_env_inv a6 a7 a8 a9 ⇔ (∀(x :(mlstring, mlstring) id)