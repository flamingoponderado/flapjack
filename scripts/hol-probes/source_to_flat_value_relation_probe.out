v_rel_eqns_local=(∀(v :v) (l :lit) (genv :global_env). (v_rel genv (Litv l :semanticPrimitives$v) v :bool) ⇔ v = (Litv l :v)) ∧ (∀(vs :semanticPrimitives$v list) (v :v) (genv :global_env) (cn :stamp option). (v_rel genv (Conv cn vs) v :bool) ⇔ (∃(cn' :stamp) (cn'' :num # num option) (vs'' :v list). cn = SOME cn' ∧ v = Conv (SOME cn'') vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'' ∧ FLOOKUP genv.c (cn'',LENGTH vs) = SOME cn') ∨ ∃(vs'' :v list). cn = (NONE :stamp option) ∧ v = Conv (NONE :(num # num option) option) vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'') ∧ (∀(v :v) (l :num) (genv :global_env) (b :bool). (v_rel genv (Loc b l :semanticPrimitives$v) v :bool) ⇔ v = (Loc b (l + (1 :num)) :v)) ∧ (∀(vs :semanticPrimitives$v list) (v :v) (genv :global_env). (v_rel genv (Vectorv vs) v :bool) ⇔ ∃(vs'' :v list). v = Vectorv vs'' ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs'') ∧ (∀(genv :global_env) (env' :(mlstring # v) list). env_rel genv (nsEmpty :(mlstring, mlstring, semanticPrimitives$v) namespace) env' ⇔ env' = ([] :(mlstring # v) list)) ∧ (∀(x :mlstring) (v :semanticPrimitives$v) (genv :global_env) (env' :(mlstring # v) list) (env :(mlstring, mlstring, semanticPrimitives$v) namespace). env_rel genv (nsBind x v env) env' ⇔ ∃(env'³' :(mlstring # v) list) (v'' :v). env' = (x,v'')::env'³' ∧ env_rel genv env env'³' ∧ (v_rel genv v v'' :bool)) ∧ ∀(v :v) (id :num # num) (genv :global_env) (e :semanticPrimitives$v sem_env). (v_rel genv (Env e id) v :bool) ⇔ F
do_opapp_local_statement=∀(genv :global_env) (vs :semanticPrimitives$v list) (vs_i1 :v list) (env :semanticPrimitives$v sem_env) (e :ast$exp). (do_opapp vs :(semanticPrimitives$v sem_env # ast$exp) option) = SOME (env,e) ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs_i1 ⇒ ∃(comp_map :source_to_flat$environment) (env_i1 :v environment) (locals :mlstring list) (t1 :mlstring list) (ts :tra list). env_all_rel genv comp_map env env_i1 locals ∧ LENGTH ts = LENGTH locals ∧ (do_opapp vs_i1 :(v environment # exp) option) = SOME (env_i1,(compile_exp t1 (comp_map with v := bind_locals ts locals comp_map.v) e :exp))
