load "preamble";
load "word_to_stackTheory";
load "wordConvsTheory";
load "stackPropsTheory";
(* Finite unions are evaluated by FOLDR UNION EMPTY, the list form of BIGUNION. *)
open bossLib HolKernel Parse preamble word_to_stackTheory;
fun out label q = (print (label ^ "="); print_term (rconc (EVAL q)); print "\n");
val rhs = ``(a:num#num) INSERT b INSERT (s:num#num->bool) UNION h``;
val grouped = ``(a:num#num) INSERT b INSERT ((s:num#num->bool) UNION h)``;
val _ = out "pl_rhs_group" (if aconv rhs grouped then ``T`` else ``F``);
val _ = out "pl_empty" ``let p = []; (ps,fs,bm,i) = compile_word_to_stack (c:64 asm$asm_config) F 4 p (Append (List [8w]) (List [2w]),5) in (FOLDR $UNION {} (MAP (stackProps$get_code_labels o SND) ps),FOLDR $UNION {} (MAP (\(n,m,pp).wordConvs$get_code_labels pp) p),FOLDR $UNION {} (MAP (\(n,pp).stackProps$stack_get_handler_labels n pp) ps),fs,i,EVERY (\(n,m,pp).wordConvs$good_handlers n pp) p) = ({}, {}, {}, [],5,T)``;
val _ = out "pl_duplicates" ``let p = [(7,0,wordLang$LocValue 0 8);(7,0,wordLang$LocValue 0 9)]; (ps,fs,bm,i) = compile_word_to_stack (c:64 asm$asm_config) F 4 p (Append (List [8w]) (List [2w]),5) in (FOLDR $UNION {} (MAP (stackProps$get_code_labels o SND) ps),FOLDR $UNION {} (MAP (\(n,m,pp).wordConvs$get_code_labels pp) p),FOLDR $UNION {} (MAP (\(n,pp).stackProps$stack_get_handler_labels n pp) ps),fs,i,EVERY (\(n,m,pp).wordConvs$good_handlers n pp) p) = ({(8,0);(9,0)},{8;9},{},[0;0],5,T)``;
val _ = out "pl_spilled" ``let p = [(7,0,wordLang$LocValue 99 8)]; (ps,fs,bm,i) = compile_word_to_stack (c:64 asm$asm_config) F 4 p (Append (List [8w]) (List [2w]),5) in (FOLDR $UNION {} (MAP (stackProps$get_code_labels o SND) ps),FOLDR $UNION {} (MAP (\(n,m,pp).wordConvs$get_code_labels pp) p),FOLDR $UNION {} (MAP (\(n,pp).stackProps$stack_get_handler_labels n pp) ps),fs,i,EVERY (\(n,m,pp).wordConvs$good_handlers n pp) p) = ({(8,0)},{8},{},[47],5,T)``;
