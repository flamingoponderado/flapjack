val _ = out "pl_wrong_owner" ``let p = [(7,0,wordLang$Call (SOME ([],(LN,LN),wordLang$LocValue 0 8,11,12)) (SOME 10) [] (SOME (0,wordLang$LocValue 0 9,9,5)))]; (ps,fs,bm,i) = compile_word_to_stack (c:64 asm$asm_config) F 4 p (Append (List [8w]) (List [2w]),5) in (FOLDR $UNION {} (MAP (stackProps$get_code_labels o SND) ps),FOLDR $UNION {} (MAP (\(n,m,pp).wordConvs$get_code_labels pp) p),FOLDR $UNION {} (MAP (\(n,pp).stackProps$stack_get_handler_labels n pp) ps),fs,i,EVERY (\(n,m,pp).wordConvs$good_handlers n pp) p) = ({(9,5);(10,0);(8,0);(9,0)},{10;8;9},{},[0],5,F)``;
