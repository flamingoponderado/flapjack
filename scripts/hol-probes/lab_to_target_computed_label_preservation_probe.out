lab_lookup_compute_labels_alt_ignore=∀(pos :num) (secs :α sec list) (acc :num sptree$num_map sptree$num_map).
  ¬MEM (n1 :num) (MAP (Section_num :α sec -> num) secs) ⇒
  lab_lookup n1 (n2 :num) (compute_labels_alt pos secs acc) =
  lab_lookup n1 n2 acc
