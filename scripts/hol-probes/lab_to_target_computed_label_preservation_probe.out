enc_secs_again_compute_labels=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (enc :α asm -> word8 list) (secs :α sec list) (res :α sec list)
    (acc :num sptree$num_map sptree$num_map).
