enc_lines_again_section_labels=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (lines :α line list) (res :α line list)
    (acc :(num # num) list).
  enc_lines_again_simp labs ffis pos enc lines = (res,T) ⇒
  section_labels pos lines acc = section_labels pos res acc
