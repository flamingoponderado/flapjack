op_theorem=op_gbag (astOp_to_flatOp (op :ast$op)) = ({||} :num -> num)
compile_theorem=(∀(tra :mlstring list) (env :source_to_flat$environment) (exp :ast$exp). esgc_free (compile_exp tra env exp :exp) ∧ set_globals (compile_exp tra env exp :exp) = ({||} :num -> num)) ∧ (∀(tra :mlstring list) (env :source_to_flat$environment) (exps :ast$exp list). EVERY esgc_free (compile_exps tra env exps :exp list) ∧ elist_globals (compile_exps tra env exps :exp list) = ({||} :num -> num)) ∧ (∀(tra :mlstring list) (env :source_to_flat$environment) (pes :(ast$pat # ast$exp) list). EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) (compile_pes tra env pes)) ∧ elist_globals (MAP (SND :flatLang$pat # exp -> exp) (compile_pes tra env pes)) = ({||} :num -> num)) ∧ ∀(tra :mlstring list) (env :source_to_flat$environment) (funs :(mlstring # mlstring # ast$exp) list). EVERY esgc_free (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) (compile_funs tra env funs)) ∧ elist_globals (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) (compile_funs tra env funs)) = ({||} :num -> num)
make_varls_theorem=∀(n :num) (t :tra) (idx :num) (xs :mlstring list). esgc_free (make_varls n t idx xs)
compile_decs_theorem=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (decs :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (decs' :exp list). compile_decs t n next env envs decs = (n',next',env',envs',decs') ⇒ EVERY esgc_free decs'
compile_prog_theorem=compile_prog (c :config) (p :dec list) = ((c1 :config),(p1 :exp list)) ⇒ EVERY esgc_free p1
inc_compile_prog_theorem=EVERY esgc_free (SND (inc_compile_prog (env_id :num # num) (c :config) (p :dec list)))
compile_flat_esgc=compile_flat (cfg :flat_pattern$config) (ds :exp list) = (ds' :exp list) ∧ EVERY esgc_free ds ⇒ EVERY esgc_free ds'
compile_full_esgc=EVERY esgc_free (SND (compile (c :config) (p :dec list)))
inc_compile_full_esgc=EVERY esgc_free (SND (inc_compile (env_id :num # num) (c :config) (p :dec list)))
compile_no_mat=no_Mat_decs (SND (compile (c :config) (prog :dec list)))
inc_compile_no_mat=no_Mat_decs (SND (inc_compile (env_id :num # num) (c :config) (prog :dec list)))
num_bindings=(∀(v0 :locs) (p :ast$pat) (e :ast$exp). num_bindings (Dlet v0 p e) = case simple_dlet p e of (NONE :(mlstring # (mlstring, mlstring) id) option) => LENGTH (pat_bindings p) | SOME v1 => (0 :num)) ∧ (∀(v1 :locs) (f :(mlstring # mlstring # ast$exp) list). num_bindings (Dletrec v1 f) = LENGTH f) ∧ (∀(v2 :mlstring) (ds :dec list). num_bindings (Dmod v2 ds) = (SUM (MAP (λ(a :dec). num_bindings a) ds) :num)) ∧ (∀(lds :dec list) (ds :dec list). num_bindings (Dlocal lds ds) = (SUM (MAP (λ(a :dec). num_bindings a) lds) :num) + (SUM (MAP (λ(a :dec). num_bindings a) ds) :num)) ∧ (∀(v3 :mlstring). num_bindings (Denv v3) = (1 :num)) ∧ (∀(v9 :locs) (v10 :(mlstring list # mlstring # (mlstring # ast_t list) list) list). num_bindings (Dtype v9 v10) = (0 :num)) ∧ (∀(v14 :ast_t) (v13 :mlstring) (v12 :mlstring list) (v11 :locs). num_bindings (Dtabbrev v11 v12 v13 v14) = (0 :num)) ∧ ∀(v17 :ast_t list) (v16 :mlstring) (v15 :locs). num_bindings (Dexn v15 v16 v17) = (0 :num)
compile_decs_num_bindings=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (decs :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (decs' :exp list). compile_decs t n next env envs decs = (n',next',env',envs',decs') ⇒ next.vidx ≤ next'.vidx ∧ (SUM (MAP num_bindings decs) :num) = next'.vidx − next.vidx
set_globals_make_varls=∀(a :num) (b :tra) (c :num) (d :mlstring list). set_globals (make_varls a b c d) = LIST_TO_BAG (MAP ($+ c) (COUNT_LIST (LENGTH d)))
compile_decs_elist_globals=∀(t :mlstring list) (n :num) (next :next_indices) (env :source_to_flat$environment) (envs :environment_generation_store) (decs :dec list) (n' :num) (next' :next_indices) (env' :source_to_flat$environment) (envs' :environment_generation_store) (decs' :exp list). compile_decs t n next env envs decs = (n',next',env',envs',decs') ⇒ elist_globals decs' = LIST_TO_BAG (MAP ($+ next.vidx) (COUNT_LIST (SUM (MAP num_bindings decs) :num)))
compile_flat_sub_bag=elist_globals (compile_flat (cfg :flat_pattern$config) (p :exp list)) ≤ elist_globals p
compile_globals_distinct=BAG_ALL_DISTINCT (elist_globals (SND (compile (c :config) (prog :dec list))))
inc_compile_globals_distinct=BAG_ALL_DISTINCT (elist_globals (SND (inc_compile (env_id :num # num) (c :config) (prog :dec list))))
