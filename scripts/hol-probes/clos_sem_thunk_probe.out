dest_typed=(dest_thunk [RefPtr (b :bool) (ptr :num)] (refs :num |-> v ref) :dest_thunk_ret) = (case FLOOKUP refs ptr of (NONE :v ref option) => BadRef | SOME (ValueArray v6) => NotThunk | SOME (ByteArray v7 :v ref) => NotThunk | SOME (Thunk Evaluated v :v ref) => if b then BadRef else (IsThunk Evaluated v :dest_thunk_ret) | SOME (Thunk NotEvaluated v :v ref) => if b then BadRef else (IsThunk NotEvaluated v :dest_thunk_ret)) ∧ (dest_thunk ([] :v list) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Number (v11 :int)::(v5 :v list)) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Word64 (v12 :word64) :v)::v5) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Block (v13 :num) (v14 :v list)::v5) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (ByteVector (v15 :word8 list)::v5) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk (RefPtr (v16 :bool) (v17 :num)::(v45 :v)::(v46 :v list)) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Closure (v18 :num option) (v19 :v list) (v20 :v list) (v21 :num) (v22 :closLang$exp) :v)::v5) refs :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Recclosure (v23 :num option) (v24 :v list) (v25 :v list) (v26 :(num # closLang$exp) list) (v27 :num) :v)::v5) refs :dest_thunk_ret) = NotThunk
store_typed=∀(ptr :α) (v :β ref) (refs :α |-> β ref). store_thunk ptr v refs = case FLOOKUP refs ptr of (NONE :β ref option) => (NONE :(α |-> β ref) option) | SOME (ValueArray v7) => (NONE :(α |-> β ref) option) | SOME (ByteArray v8 :β ref) => (NONE :(α |-> β ref) option) | SOME (Thunk Evaluated v10 :β ref) => (NONE :(α |-> β ref) option) | SOME (Thunk NotEvaluated v10 :β ref) => SOME refs⟨ptr ↦ v⟩
update_typed=update_thunk [RefPtr F (ptr :num)] (refs :num |-> v ref) [(v :v)] = (case (dest_thunk [v] refs :dest_thunk_ret) of BadRef => (NONE :(num |-> v ref) option) | NotThunk => store_thunk ptr (Thunk Evaluated v :v ref) refs | (IsThunk v3 v4 :dest_thunk_ret) => (NONE :(num |-> v ref) option)) ∧ update_thunk ([] :v list) (v1 :num |-> v ref) (v2 :v list) = (NONE :(num |-> v ref) option) ∧ update_thunk (Number (v13 :int)::(v8 :v list)) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk ((Word64 (v14 :word64) :v)::v8) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk (Block (v15 :num) (v16 :v list)::v8) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk (ByteVector (v17 :word8 list)::v8) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk (RefPtr T (v19 :num)::v8) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk [RefPtr F v19] v1 ([] :v list) = (NONE :(num |-> v ref) option) ∧ update_thunk [RefPtr F v19] v1 ((v63 :v)::(v67 :v)::(v68 :v list)) = (NONE :(num |-> v ref) option) ∧ update_thunk (RefPtr F v19::(v57 :v)::(v58 :v list)) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk ((Closure (v20 :num option) (v21 :v list) (v22 :v list) (v23 :num) (v24 :closLang$exp) :v)::v8) v1 v2 = (NONE :(num |-> v ref) option) ∧ update_thunk ((Recclosure (v25 :num option) (v26 :v list) (v27 :v list) (v28 :(num # closLang$exp) list) (v29 :num) :v)::v8) v1 v2 = (NONE :(num |-> v ref) option)
bad_typed=∀(m :thunk_mode) (v :v) (refs :num |-> v ref). bad_thunk_update m v refs ⇔ m = Evaluated ∧ (dest_thunk [v] refs :dest_thunk_ret) ≠ NotThunk
missing=BadRef
ref_flag=BadRef
unevaluated=IsThunk NotEvaluated (Number 5)
array=NotThunk
update=SOME (SOME (Thunk Evaluated (Number 7)))
repeat_update=T
nested_update=T
