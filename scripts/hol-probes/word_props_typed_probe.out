unset_var_with_const_typed=unset_var (x :num) ((z :(α, β, γ) state) with locals_size := (ls :num option)) = unset_var x z with locals_size := ls ∧ unset_var x (z with fp_regs := (fp :num |-> word64)) = unset_var x z with fp_regs := fp ∧ unset_var x (z with store := (store :store_name |-> α word_loc)) = unset_var x z with store := store ∧ unset_var x (z with stack := (xs :α stack_frame list)) = unset_var x z with stack := xs ∧ unset_var x (z with stack_limit := (sl :num)) = unset_var x z with stack_limit := sl ∧ unset_var x (z with stack_max := (sm :num option)) = unset_var x z with stack_max := sm ∧ unset_var x (z with stack_size := (ssize :num sptree$num_map)) = unset_var x z with stack_size := ssize ∧ unset_var x (z with memory := (m :α word -> α word_loc)) = unset_var x z with memory := m ∧ unset_var x (z with mdomain := (md :α word -> bool)) = unset_var x z with mdomain := md ∧ unset_var x (z with sh_mdomain := (smd :α word -> bool)) = unset_var x z with sh_mdomain := smd ∧ unset_var x (z with permute := (p :num -> num -> num)) = unset_var x z with permute := p ∧ unset_var x (z with compile := (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option)) = unset_var x z with compile := c ∧ unset_var x (z with compile_oracle := (co :num -> β # (num # num # α prog) list)) = unset_var x z with compile_oracle := co ∧ unset_var x (z with code_buffer := (cb :(α, 8) buffer)) = unset_var x z with code_buffer := cb ∧ unset_var x (z with data_buffer := (db :(α, α) buffer)) = unset_var x z with data_buffer := db ∧ unset_var x (z with gc_fun := (g :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option)) = unset_var x z with gc_fun := g ∧ unset_var x (z with handler := (hd :num)) = unset_var x z with handler := hd ∧ unset_var x (z with clock := (clk :num)) = unset_var x z with clock := clk ∧ unset_var x (z with termdep := (tdep :num)) = unset_var x z with termdep := tdep ∧ unset_var x (z with code := (cd :(num # α prog) sptree$num_map)) = unset_var x z with code := cd ∧ unset_var x (z with be := (b :bool)) = unset_var x z with be := b ∧ unset_var x (z with ffi := (ffi :δ ffi_state)) = unset_var x z with ffi := ffi
word_exp_with_const_typed=∀(x :(α, β, γ) state) (y :α exp). (word_exp (x with clock := (k :num)) y :α word_loc option) = (word_exp x y :α word_loc option) ∧ (word_exp (x with stack := (xs :α stack_frame list)) y :α word_loc option) = (word_exp x y :α word_loc option) ∧ (word_exp (x with permute := (perm :num -> num -> num)) y :α word_loc option) = (word_exp x y :α word_loc option) ∧ (word_exp (x with termdep := (termdep :num)) y :α word_loc option) = (word_exp x y :α word_loc option) ∧ (word_exp (x with code := (c :(num # α prog) sptree$num_map)) y :α word_loc option) = (word_exp x y :α word_loc option) ∧ (word_exp (x with compile_oracle := (co :num -> β # (num # num # α prog) list)) y :α word_loc option) = (word_exp x y :α word_loc option) ∧ (word_exp (x with compile := (cc :β -> (num # num # α prog) list -> (word8 list # α word list # β) option)) y :α word_loc option) = (word_exp x y :α word_loc option)
get_var_set_var_typed=get_var (v1 :num) (set_var (v2 :num) (x :α word_loc) (s :(α, β, γ) state)) = if v1 = v2 then SOME x else get_var v1 s
get_vars_length_lemma_typed=∀(ls :num list) (s :(α, β, γ) state) (y :α word_loc list). get_vars ls s = SOME y ⇒ LENGTH y = LENGTH ls
LASTN_stack_size_SOME_typed=∀(n :num) (stack :α stack_frame list) (stack' :α stack_frame list) (x :num). LASTN n stack = stack' ∧ stack_size stack = SOME x ∧ n ≤ LENGTH stack ⇒ ∃(y :num). stack_size stack' = SOME y ∧ y ≤ x
mem_list_rearrange_typed=∀(ls :α list) (x :α) (f :num -> num). MEM x (list_rearrange f ls) ⇔ MEM x ls
s_key_eq_def2_typed=∀(l1 :α stack_frame list) (l2 :α stack_frame list). s_key_eq l1 l2 ⇔ LIST_REL (s_frame_key_eq :α stack_frame -> α stack_frame -> bool) l1 l2
set_store_const_typed=(set_store (x :store_name) (y :α word_loc) (z :(α, β, γ) state)).locals = z.locals ∧ (set_store x y z).locals_size = z.locals_size ∧ (set_store x y z).fp_regs = z.fp_regs ∧ (set_store x y z).stack = z.stack ∧ (set_store x y z).stack_limit = z.stack_limit ∧ (set_store x y z).stack_max = z.stack_max ∧ (set_store x y z).stack_size = z.stack_size ∧ (set_store x y z).memory = z.memory ∧ (set_store x y z).mdomain = z.mdomain ∧ (set_store x y z).sh_mdomain = z.sh_mdomain ∧ (set_store x y z).permute = z.permute ∧ (set_store x y z).compile = z.compile ∧ (set_store x y z).compile_oracle = z.compile_oracle ∧ (set_store x y z).code_buffer = z.code_buffer ∧ (set_store x y z).data_buffer = z.data_buffer ∧ (set_store x y z).gc_fun = z.gc_fun ∧ (set_store x y z).handler = z.handler ∧ (set_store x y z).clock = z.clock ∧ (set_store x y z).termdep = z.termdep ∧ (set_store x y z).code = z.code ∧ ((set_store x y z).be ⇔ z.be) ∧ (set_store x y z).ffi = z.ffi
set_var_const_typed=(set_var (x :num) (y :α word_loc) (z :(α, β, γ) state)).locals_size = z.locals_size ∧ (set_var x y z).fp_regs = z.fp_regs ∧ (set_var x y z).store = z.store ∧ (set_var x y z).stack = z.stack ∧ (set_var x y z).stack_limit = z.stack_limit ∧ (set_var x y z).stack_max = z.stack_max ∧ (set_var x y z).stack_size = z.stack_size ∧ (set_var x y z).memory = z.memory ∧ (set_var x y z).mdomain = z.mdomain ∧ (set_var x y z).sh_mdomain = z.sh_mdomain ∧ (set_var x y z).permute = z.permute ∧ (set_var x y z).compile = z.compile ∧ (set_var x y z).compile_oracle = z.compile_oracle ∧ (set_var x y z).code_buffer = z.code_buffer ∧ (set_var x y z).data_buffer = z.data_buffer ∧ (set_var x y z).gc_fun = z.gc_fun ∧ (set_var x y z).handler = z.handler ∧ (set_var x y z).clock = z.clock ∧ (set_var x y z).termdep = z.termdep ∧ (set_var x y z).code = z.code ∧ ((set_var x y z).be ⇔ z.be) ∧ (set_var x y z).ffi = z.ffi
set_var_with_const_typed=set_var (x :num) (y :α word_loc) ((z :(α, β, γ) state) with locals_size := (ls :num option)) = set_var x y z with locals_size := ls ∧ set_var x y (z with fp_regs := (fp :num |-> word64)) = set_var x y z with fp_regs := fp ∧ set_var x y (z with store := (store :store_name |-> α word_loc)) = set_var x y z with store := store ∧ set_var x y (z with stack := (xs :α stack_frame list)) = set_var x y z with stack := xs ∧ set_var x y (z with stack_limit := (sl :num)) = set_var x y z with stack_limit := sl ∧ set_var x y (z with stack_max := (sm :num option)) = set_var x y z with stack_max := sm ∧ set_var x y (z with stack_size := (ssize :num sptree$num_map)) = set_var x y z with stack_size := ssize ∧ set_var x y (z with memory := (m :α word -> α word_loc)) = set_var x y z with memory := m ∧ set_var x y (z with mdomain := (md :α word -> bool)) = set_var x y z with mdomain := md ∧ set_var x y (z with sh_mdomain := (smd :α word -> bool)) = set_var x y z with sh_mdomain := smd ∧ set_var x y (z with permute := (p :num -> num -> num)) = set_var x y z with permute := p ∧ set_var x y (z with compile := (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option)) = set_var x y z with compile := c ∧ set_var x y (z with compile_oracle := (co :num -> β # (num # num # α prog) list)) = set_var x y z with compile_oracle := co ∧ set_var x y (z with code_buffer := (cb :(α, 8) buffer)) = set_var x y z with code_buffer := cb ∧ set_var x y (z with data_buffer := (db :(α, α) buffer)) = set_var x y z with data_buffer := db ∧ set_var x y (z with gc_fun := (g :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option)) = set_var x y z with gc_fun := g ∧ set_var x y (z with handler := (hd :num)) = set_var x y z with handler := hd ∧ set_var x y (z with clock := (clk :num)) = set_var x y z with clock := clk ∧ set_var x y (z with termdep := (tdep :num)) = set_var x y z with termdep := tdep ∧ set_var x y (z with code := (cd :(num # α prog) sptree$num_map)) = set_var x y z with code := cd ∧ set_var x y (z with be := (b :bool)) = set_var x y z with be := b ∧ set_var x y (z with ffi := (ffi :δ ffi_state)) = set_var x y z with ffi := ffi
stack_size_eq_typed=stack_size (StackFrame (n :num option) (_0 :(num # α word_loc) list) (_1 :(num # α word_loc) list) (NONE :(num # num # num) option)::(stack :α stack_frame list)) = OPTION_MAP2 $+ n (stack_size stack) ∧ stack_size (StackFrame n (_2 :(num # α word_loc) list) (_3 :(num # α word_loc) list) (SOME (handler :num # num # num))::stack) = OPTION_MAP2 $+ (OPTION_MAP ($+ (3 :num)) n) (stack_size stack) ∧ stack_size ([] :β stack_frame list) = SOME (1 :num)
stack_size_eq2_typed=stack_size ((sfrm :α stack_frame)::(stack :α stack_frame list)) = OPTION_MAP2 $+ (stack_size_frame sfrm) (stack_size stack) ∧ stack_size ([] :β stack_frame list) = SOME (1 :num)
evaluate_code_only_grows_typed=∀(p :α prog) (s :(α, β, γ) state) (r :α result option) (t :(α, β, γ) state). evaluate (p,s) = (r,t) ⇒ subspt s.code t.code
evaluate_NONE_stack_size_const_typed=∀(p :α prog) (s :(α, β, γ) state) (t :(α, β, γ) state). evaluate (p,s) = ((NONE :α result option),t) ⇒ stack_size t.stack = stack_size s.stack
