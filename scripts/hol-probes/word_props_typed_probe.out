cut_state_with_const_typed=cut_state (x :sptree$num_set # sptree$num_set) ((z :(α, β, γ) state) with clock := (k :num)) = OPTION_MAP (λ(s :(α, β, γ) state). s with clock := k) (cut_state x z) ∧ cut_state x (z with code := (code :(num # α prog) sptree$num_map)) = OPTION_MAP (λ(s :(α, β, γ) state). s with code := code) (cut_state x z) ∧ cut_state x (z with compile := (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option)) = OPTION_MAP (λ(s :(α, β, γ) state). s with compile := c) (cut_state x z) ∧ cut_state x (z with compile_oracle := (co :num -> β # (num # num # α prog) list)) = OPTION_MAP (λ(s :(α, β, γ) state). s with compile_oracle := co) (cut_state x z) ∧ cut_state x (z with permute := (perm :num -> num -> num)) = OPTION_MAP (λ(s :(α, β, γ) state). s with permute := perm) (cut_state x z) ∧ cut_state x (z with stack := (xs :α stack_frame list)) = OPTION_MAP (λ(s :(α, β, γ) state). s with stack := xs) (cut_state x z)
