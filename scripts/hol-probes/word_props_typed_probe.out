flush_state_with_const_typed=flush_state (b :bool) ((y :(α, β, γ) state) with locals := (l :α word_loc sptree$num_map)) = flush_state b y ∧ flush_state b (y with locals_size := (ls :num option)) = flush_state b y ∧ flush_state T (y with stack := (xs :α stack_frame list)) = flush_state T y ∧ flush_state b (y with permute := (p :num -> num -> num)) = flush_state b y with permute := p ∧ flush_state b (y with stack_max := (sm :num option)) = flush_state b y with stack_max := sm ∧ flush_state b (y with clock := (k :num)) = flush_state b y with clock := k
