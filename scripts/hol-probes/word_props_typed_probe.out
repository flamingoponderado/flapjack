env_to_list_lookup_equiv_typed=env_to_list (y :α word_loc sptree$num_map) (f :num -> num -> num) = ((q :(num # α word_loc) list),(r :num -> num -> num)) ⇒ (∀(n :num). ALOOKUP q n = lookup n y) ∧ ∀(x1 :num) (x2 :α word_loc). MEM (x1,x2) q ⇒ lookup x1 y = SOME x2
alloc_const_typed=alloc (c :α word) (names :sptree$num_set # sptree$num_set) (s :(α, β, γ) state) = ((r :α result option),(s' :(α, β, γ) state)) ⇒ s'.clock = s.clock ∧ s'.ffi = s.ffi ∧ s'.code = s.code ∧ (s'.be ⇔ s.be) ∧ s'.code_buffer = s.code_buffer ∧ s'.data_buffer = s.data_buffer ∧ s'.compile = s.compile ∧ s'.compile_oracle = s.compile_oracle ∧ s'.stack_limit = s.stack_limit ∧ s'.stack_size = s.stack_size
evaluate_add_clock_typed=∀(p :α prog) (s :(α, β, γ) state) (r :α result option) (s' :(α, β, γ) state). evaluate (p,s) = (r,s') ∧ r ≠ SOME (TimeOut :α result) ⇒ evaluate (p,s with clock := s.clock + (extra :num)) = (r,s' with clock := s'.clock + extra)
evaluate_add_clock_io_events_mono_typed=∀(exps :α prog) (s :(α, β, γ) state) (extra :num). (SND (evaluate (exps,s))).ffi.io_events ≼ (SND (evaluate (exps,s with clock := s.clock + extra))).ffi.io_events
alloc_code_gc_fun_const_typed=alloc (x :α word) (names :sptree$num_set # sptree$num_set) (s :(α, β, γ) state) = ((res :α result option),(t :(α, β, γ) state)) ⇒ t.code = s.code ∧ t.code_buffer = s.code_buffer ∧ t.data_buffer = s.data_buffer ∧ t.gc_fun = s.gc_fun ∧ t.mdomain = s.mdomain ∧ t.sh_mdomain = s.sh_mdomain ∧ (t.be ⇔ s.be) ∧ t.compile = s.compile ∧ t.compile_oracle = s.compile_oracle ∧ t.stack_limit = s.stack_limit ∧ t.stack_size = s.stack_size
evaluate_consts_typed=∀(xs :α prog) (s1 :(α, β, γ) state) (vs :α result option) (s2 :(α, β, γ) state). evaluate (xs,s1) = (vs,s2) ⇒ s1.gc_fun = s2.gc_fun ∧ s1.mdomain = s2.mdomain ∧ s1.sh_mdomain = s2.sh_mdomain ∧ (s1.be ⇔ s2.be) ∧ s1.compile = s2.compile ∧ s1.stack_limit = s2.stack_limit
pop_env_code_gc_fun_clock_typed=pop_env (r :(α, β, γ) state) = SOME (x :(α, β, γ) state) ⇒ r.code = x.code ∧ r.code_buffer = x.code_buffer ∧ r.data_buffer = x.data_buffer ∧ r.gc_fun = x.gc_fun ∧ r.clock = x.clock ∧ (r.be ⇔ x.be) ∧ r.mdomain = x.mdomain ∧ r.sh_mdomain = x.sh_mdomain ∧ r.compile = x.compile ∧ r.compile_oracle = x.compile_oracle ∧ r.stack_limit = x.stack_limit ∧ r.stack_max = x.stack_max ∧ r.stack_size = x.stack_size
evaluate_dec_clock_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state). evaluate (prog,st) = (res,rst) ⇒ evaluate (prog,st with clock := st.clock − rst.clock) = (res,rst with clock := (0 :num))
evaluate_io_events_mono_typed=∀(exps :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (exps,s1) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
cut_state_const_typed=cut_state (x :sptree$num_set # sptree$num_set) (s :(α, β, γ) state) = SOME (s' :(α, β, γ) state) ⇒ ∃(l :α word_loc sptree$num_map). s' = s with locals := l
evaluate_stack_limit_typed=∀(c :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (c,s1) = (res,s2) ⇒ s2.stack_limit = s1.stack_limit
evaluate_stack_limit_stack_max_typed=∀(c :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (c,s1) = (res,s2) ∧ the (s1.stack_limit + (1 :num)) s1.stack_max > s1.stack_limit ⇒ the (s2.stack_limit + (1 :num)) s2.stack_max > s2.stack_limit
evaluate_stack_limit_stack_max_eq_typed=∀(c :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (c,s1) = (res,s2) ∧ the s1.stack_limit s1.stack_max ≥ s1.stack_limit ⇒ the s2.stack_limit s2.stack_max ≥ s2.stack_limit
evaluate_stack_max_typed=∀(c :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (c,s1) = (res,s2) ⇒ case s1.stack_max of (NONE :num option) => s2.stack_max = (NONE :num option) | SOME stack_max => the stack_max s2.stack_max ≥ stack_max
evaluate_stack_max_IS_SOME_typed=∀(c :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (c,s1) = (res,s2) ∧ IS_SOME s2.stack_max ⇒ IS_SOME s1.stack_max
evaluate_stack_max_le_typed=∀(c :α prog) (s1 :(α, β, γ) state) (res :α result option) (s2 :(α, β, γ) state). evaluate (c,s1) = (res,s2) ⇒ option_le s1.stack_max s2.stack_max
share_inst_const_typed=(share_inst (op :memop) (v :num) (c :β word) (s :(β, γ, δ) state) :α result option # (β, γ, δ) state) = ((res :α result option),(s' :(β, γ, δ) state)) ⇒ (s'.be ⇔ s.be) ∧ s'.gc_fun = s.gc_fun ∧ s'.mdomain = s.mdomain ∧ s'.sh_mdomain = s.sh_mdomain ∧ s'.code = s.code ∧ s'.code_buffer = s.code_buffer ∧ s'.data_buffer = s.data_buffer ∧ s'.compile = s.compile ∧ s'.compile_oracle = s.compile_oracle ∧ s'.permute = s.permute ∧ s'.clock = s.clock ∧ s'.handler = s.handler ∧ s'.stack_limit = s.stack_limit ∧ s'.stack_max = s.stack_max
evaluate_stack_swap_typed=∀(c' :α prog) (s :(α, β, γ) state). case evaluate (c',s) of ((NONE :α result option),s1) => s_key_eq s.stack s1.stack ∧ s1.handler = s.handler ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ ∃(st :α stack_frame list). evaluate (c',s with stack := xs) = ((NONE :α result option),s1 with stack := st) ∧ s_val_eq s1.stack st ∧ s_key_eq xs st | (SOME (Result v13 v14),s1) => s_key_eq s.stack s1.stack ∧ s1.handler = s.handler ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ ∃(st :α stack_frame list). evaluate (c',s with stack := xs) = (SOME (Result v13 v14),s1 with stack := st) ∧ s_val_eq s1.stack st ∧ s_key_eq xs st | (SOME (Exception x y),s1) => s.handler < LENGTH s.stack ∧ ∃(e0 :(num # α word_loc) list) (e :(num # α word_loc) list) (n :num # num # num) (ls :α stack_frame list) (m :num option) (lss :(num # α word_loc) list). LASTN (s.handler + (1 :num)) s.stack = StackFrame m e0 e (SOME n)::ls ∧ Abbrev (m = s1.locals_size) ∧ (MAP (FST :num # α word_loc -> num) e = MAP (FST :num # α word_loc -> num) lss ∧ s1.locals = union (fromAList lss) (fromAList e0)) ∧ s_key_eq s1.stack ls ∧ s1.handler = (case n of (v,v1) => v) ∧ ∀(xs :α stack_frame list) (e0' :(num # α word_loc) list) (e' :(num # α word_loc) list) (ls' :α stack_frame list). LASTN (s.handler + (1 :num)) xs = StackFrame m e0' e' (SOME n)::ls' ∧ s_val_eq s.stack xs ⇒ ∃(st :α stack_frame list) (locs :α word_loc sptree$num_map). evaluate (c',s with stack := xs) = (SOME (Exception x y),s1 with <|stack := st; handler := case n of (v,v1) => v; locals := locs|>) ∧ (∃(lss' :(num # α word_loc) list). MAP (FST :num # α word_loc -> num) e' = MAP (FST :num # α word_loc -> num) lss' ∧ locs = union (fromAList lss') (fromAList e0') ∧ MAP (SND :num # α word_loc -> α word_loc) lss = MAP (SND :num # α word_loc -> α word_loc) lss') ∧ s_val_eq s1.stack st ∧ s_key_eq ls' st | (SOME (Break v17 :α result),s1) => s_key_eq s.stack s1.stack ∧ s1.handler = s.handler ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ ∃(st :α stack_frame list). evaluate (c',s with stack := xs) = (SOME (Break v17 :α result),s1 with stack := st) ∧ s_val_eq s1.stack st ∧ s_key_eq xs st | (SOME (Continue v18 :α result),s1) => s_key_eq s.stack s1.stack ∧ s1.handler = s.handler ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ ∃(st :α stack_frame list). evaluate (c',s with stack := xs) = (SOME (Continue v18 :α result),s1 with stack := st) ∧ s_val_eq s1.stack st ∧ s_key_eq xs st | (SOME (TimeOut :α result),s1) => s1.stack = ([] :α stack_frame list) ∧ isEmpty s1.locals ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ evaluate (c',s with stack := xs) = (SOME (TimeOut :α result),s1) | (SOME (NotEnoughSpace :α result),s1) => s1.stack = ([] :α stack_frame list) ∧ isEmpty s1.locals ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ evaluate (c',s with stack := xs) = (SOME (NotEnoughSpace :α result),s1) | (SOME (FinalFFI e :α result),s1) => s1.stack = ([] :α stack_frame list) ∧ isEmpty s1.locals ∧ ∀(xs :α stack_frame list). s_val_eq s.stack xs ⇒ evaluate (c',s with stack := xs) = (SOME (FinalFFI e :α result),s1) | (SOME (Error :α result),s1) => T
gc_const_typed=gc (x :(α, β, γ) state) = SOME (y :(α, β, γ) state) ⇒ y.clock = x.clock ∧ y.ffi = x.ffi ∧ y.code = x.code ∧ (y.be ⇔ x.be) ∧ y.code_buffer = x.code_buffer ∧ y.data_buffer = x.data_buffer ∧ y.compile = x.compile ∧ y.handler = x.handler ∧ y.compile_oracle = x.compile_oracle ∧ y.locals_size = x.locals_size ∧ y.stack_limit = x.stack_limit ∧ y.stack_max = x.stack_max ∧ y.stack_size = x.stack_size
gc_fun_ok_def_typed=∀(f :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option). gc_fun_ok f ⇔ ∀(wl :α word_loc list) (m :α word -> α word_loc) (d :α word -> bool) (s :store_name |-> α word_loc) (wl1 :α word_loc list) (m1 :α word -> α word_loc) (s1 :store_name |-> α word_loc). Handler ∈ FDOM s ∧ f (wl,m,d,s \\ Handler) = SOME (wl1,m1,s1) ⇒ LENGTH wl = LENGTH wl1 ∧ Handler ∉ FDOM s1 ∧ f (wl,m,d,s) = SOME (wl1,m1,s1⟨Handler ↦ s⟨Handler⟩⟩)
inst_const_typed=inst (i :α inst) (s :(α, β, γ) state) = SOME (s' :(α, β, γ) state) ⇒ s'.clock = s.clock ∧ s'.ffi = s.ffi
inst_const_full_typed=inst (i :α inst) (s :(α, β, γ) state) = SOME (s' :(α, β, γ) state) ⇒ s'.code = s.code ∧ s'.code_buffer = s.code_buffer ∧ s'.data_buffer = s.data_buffer ∧ s'.compile = s.compile ∧ s'.compile_oracle = s.compile_oracle ∧ s'.clock = s.clock ∧ s'.ffi = s.ffi ∧ s'.handler = s.handler ∧ s'.stack = s.stack ∧ s'.locals_size = s.locals_size ∧ s'.stack_limit = s.stack_limit ∧ s'.stack_max = s.stack_max ∧ s'.stack_size = s.stack_size
jump_exc_const_typed=jump_exc (s :(α, β, γ) state) = SOME ((s' :(α, β, γ) state),(y :num # num)) ⇒ (s'.be ⇔ s.be) ∧ s'.gc_fun = s.gc_fun ∧ s'.mdomain = s.mdomain ∧ s'.sh_mdomain = s.sh_mdomain ∧ s'.code = s.code ∧ s'.code_buffer = s.code_buffer ∧ s'.data_buffer = s.data_buffer ∧ s'.compile = s.compile ∧ s'.compile_oracle = s.compile_oracle ∧ s'.clock = s.clock ∧ s'.ffi = s.ffi ∧ s'.stack_limit = s.stack_limit ∧ s'.stack_max = s.stack_max ∧ s'.stack_size = s.stack_size
locals_rel_alist_insert_typed=∀(ls :num list) (vs :α word_loc list) (s :α word_loc sptree$num_map) (t :α word_loc sptree$num_map). locals_rel (temp :num) s t ∧ EVERY (λ(x :num). x < temp) ls ⇒ locals_rel temp (alist_insert ls vs s) (alist_insert ls vs t)
locals_rel_cut_env_typed=locals_rel (temp :num) (loc :α word_loc sptree$num_map) (loc' :α word_loc sptree$num_map) ∧ every_name (λ(x :num). x < temp) (names :sptree$num_set # sptree$num_set) ∧ cut_env names loc = SOME (x :α word_loc sptree$num_map) ⇒ cut_env names loc' = SOME x
locals_rel_cut_envs_typed=locals_rel (temp :num) (loc :α word_loc sptree$num_map) (loc' :α word_loc sptree$num_map) ∧ every_name (λ(x :num). x < temp) (names :sptree$num_set # sptree$num_set) ∧ cut_envs names loc = SOME (x :α word_loc sptree$num_map # α word_loc sptree$num_map) ⇒ cut_envs names loc' = SOME x
locals_rel_evaluate_thm_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state) (loc :α word_loc sptree$num_map) (temp :num). evaluate (prog,st) = (res,rst) ∧ res ≠ SOME (Error :α result) ∧ every_var (λ(x :num). x < temp) prog ∧ locals_rel temp st.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate (prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc'
locals_rel_get_var_typed=(r :num) < (temp :num) ∧ get_var r (st :(α, β, γ) state) = SOME (x :α word_loc) ∧ locals_rel temp st.locals (loc :α word_loc sptree$num_map) ⇒ get_var r (st with locals := loc) = SOME x
locals_rel_get_var_imm_typed=every_var_imm (λ(x :num). x < (temp :num)) (r :α reg_imm) ∧ get_var_imm r (st :(α, β, γ) state) = SOME (x :α word_loc) ∧ locals_rel temp st.locals (loc :α word_loc sptree$num_map) ⇒ get_var_imm r (st with locals := loc) = SOME x
locals_rel_get_var_imm_simp_typed=every_var_imm (λ(x :num). x < (temp :num)) (r :α reg_imm) ∧ locals_rel temp (st :(α, β, γ) state).locals (loc :α word_loc sptree$num_map) ⇒ get_var_imm r (st with locals := loc) = get_var_imm r st
locals_rel_get_var_simp_typed=(r :num) < (temp :num) ∧ locals_rel temp (st :(α, β, γ) state).locals (loc :α word_loc sptree$num_map) ⇒ get_var r (st with locals := loc) = get_var r st
locals_rel_get_vars_typed=∀(ls :num list) (vs :α word_loc list). get_vars ls (st :(α, β, γ) state) = SOME vs ∧ EVERY (λ(x :num). x < (temp :num)) ls ∧ locals_rel temp st.locals (loc :α word_loc sptree$num_map) ⇒ get_vars ls (st with locals := loc) = SOME vs
locals_rel_get_vars_simp_typed=EVERY (λ(x :num). x < (temp :num)) (l :num list) ∧ locals_rel temp (st :(α, β, γ) state).locals (loc :α word_loc sptree$num_map) ⇒ get_vars l (st with locals := loc) = get_vars l st
locals_rel_word_exp_typed=∀(s :(α, β, γ) state) (exp :α exp) (w :α word_loc). every_var_exp (λ(x :num). x < (temp :num)) exp ∧ (word_exp s exp :α word_loc option) = SOME w ∧ locals_rel temp s.locals (loc :α word_loc sptree$num_map) ⇒ (word_exp (s with locals := loc) exp :α word_loc option) = SOME w
locals_rel_word_exp_simp_typed=∀(s :(α, β, γ) state) (exp :α exp) (w :δ). every_var_exp (λ(x :num). x < (temp :num)) exp ∧ locals_rel temp s.locals (loc :α word_loc sptree$num_map) ⇒ (word_exp (s with locals := loc) exp :α word_loc option) = (word_exp s exp :α word_loc option)
the_words_EVERY_IS_SOME_typed=∀(ls :α word_loc option list) (x :α word list). the_words ls = SOME x ⇒ EVERY (IS_SOME :α word_loc option -> bool) ls
locals_rel_def_typed=∀(temp :num) (s :α word_loc sptree$num_map) (t :α word_loc sptree$num_map). locals_rel temp s t ⇔ ∀(x :num). x < temp ⇒ lookup x s = lookup x t
mem_store_const_typed=mem_store (x :α word) (y :α word_loc) (z :(α, β, γ) state) = SOME (a :(α, β, γ) state) ⇒ a.locals = z.locals ∧ a.clock = z.clock ∧ (a.be ⇔ z.be) ∧ a.gc_fun = z.gc_fun ∧ a.mdomain = z.mdomain ∧ a.sh_mdomain = z.sh_mdomain ∧ a.ffi = z.ffi ∧ a.handler = z.handler ∧ a.code = z.code ∧ a.code_buffer = z.code_buffer ∧ a.data_buffer = z.data_buffer ∧ a.compile = z.compile ∧ a.compile_oracle = z.compile_oracle ∧ a.stack = z.stack ∧ a.locals_size = z.locals_size ∧ a.stack_limit = z.stack_limit ∧ a.stack_max = z.stack_max ∧ a.stack_size = z.stack_size
no_install_code_def_typed=∀(code :(num # α prog) sptree$num_map). no_install_code code ⇔ ∀(k :num) (n :num) (p :α prog). lookup k code = SOME (n,p) ⇒ no_install p
no_alloc_code_def_typed=∀(code :(num # α prog) sptree$num_map). no_alloc_code code ⇔ ∀(k :num) (n :num) (p :α prog). lookup k code = SOME (n,p) ⇒ no_alloc p
no_alloc_find_code_typed=∀(code :(num # α prog) sptree$num_map) (dest :num option) (args :β word_loc list) (lsize :γ sptree$num_map) (args1 :β word_loc list) (expr :α prog) (ps :γ option). find_code dest args code lsize = SOME (args1,expr,ps) ∧ no_alloc_code code ⇒ no_alloc expr
no_install_evaluate_const_code_typed=∀(prog :α prog) (s :(α, β, γ) state) (result :α result option) (s1 :(α, β, γ) state). evaluate (prog,s) = (result,s1) ∧ no_install prog ∧ no_install_code s.code ⇒ s.code = s1.code
no_install_find_code_typed=∀(code :(num # α prog) sptree$num_map) (dest :num option) (args :β word_loc list) (lsize :γ sptree$num_map) (args1 :β word_loc list) (expr :α prog) (ps :γ option). no_install_code code ∧ find_code dest args code lsize = SOME (args1,expr,ps) ⇒ no_install expr
no_mt_code_def_typed=∀(code :(num # α prog) sptree$num_map). no_mt_code code ⇔ ∀(k :num) (n :num) (p :α prog). lookup k code = SOME (n,p) ⇒ no_mt p
permute_swap_lemma_typed=∀(prog :α prog) (st :(α, β, γ) state) (perm :num -> num -> num). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (prog,st) in res ≠ SOME (Error :α result) ⇒ ∃(perm' :num -> num -> num). evaluate (prog,st with permute := perm') = (res,rst with permute := perm))
ALL_DISTINCT_MEM_IMP_ALOOKUP_SOME_typed=ALL_DISTINCT (MAP (FST :α # β -> α) (xs :(α # β) list)) ∧ MEM ((x :α),(y :β)) xs ⇒ ALOOKUP xs x = SOME y
env_to_list_ALL_DISTINCT_typed=env_to_list (y :α word_loc sptree$num_map) (perm :num -> num -> num) = ((vs :(num # α word_loc) list),(other :num -> num -> num)) ⇒ ALL_DISTINCT (MAP (FST :num # α word_loc -> num) vs)
env_to_list_ALL_DISTINCT_FST_typed=ALL_DISTINCT (MAP (FST :num # α word_loc -> num) (FST (env_to_list (y :α word_loc sptree$num_map) (perm :num -> num -> num))))
env_to_list_PERM_typed=PERM (FST (env_to_list (env :α word_loc sptree$num_map) (perm :num -> num -> num))) (FST (env_to_list env (perm' :num -> num -> num)))
PERM_fromAList_typed=∀(l1 :(num # α) list) (l2 :(num # α) list). PERM l1 l2 ∧ ALL_DISTINCT (MAP (FST :num # α -> num) l1) ⇒ fromAList l1 = fromAList l2
PERM_list_rearrange_typed=∀(f :num -> num) (xs :α list). ALL_DISTINCT xs ⇒ PERM xs (list_rearrange f xs)
permute_swap_lemma2_typed=∀(prog :α prog) (st :(α, β, γ) state) (perm :num -> num -> num) (stack :α stack_frame list). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (prog,st) in res ≠ SOME (Error :α result) ∧ no_alloc_code st.code ∧ no_alloc prog ∧ no_install_code st.code ∧ no_install prog ∧ LIST_REL (λ(s1 :α stack_frame) (s2 :α stack_frame). PERM_STACK s1 s2) stack st.stack ⇒ ∃(perm' :num -> num -> num) (stack' :α stack_frame list). evaluate (prog,st with <|permute := perm; stack := stack|>) = (res,rst with <|permute := perm'; stack := stack'|>) ∧ LIST_REL (λ(s1 :α stack_frame) (s2 :α stack_frame). PERM_STACK s1 s2) stack' rst.stack)
permute_swap_lemma3_typed=∀(prog :α prog) (st :(α, β, γ) state) (perm :num -> num -> num) (stack :δ). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (prog,st) in res ≠ SOME (Error :α result) ∧ no_alloc_code st.code ∧ no_alloc prog ∧ no_install_code st.code ∧ no_install prog ∧ EVERY (λ(st :α stack_frame). case st of StackFrame v v1 vs handler => ALL_DISTINCT (MAP (FST :num # α word_loc -> num) vs)) st.stack ⇒ ∃(perm' :num -> num -> num) (stack' :α stack_frame list). evaluate (prog,st with permute := perm) = (res,rst with <|permute := perm'; stack := stack'|>) ∧ LIST_REL (λ(s1 :α stack_frame) (s2 :α stack_frame). PERM_STACK s1 s2) stack' rst.stack)
stack_size_perm_typed=∀(l1 :α stack_frame list) (l2 :α stack_frame list). LIST_REL (λ(s1 :α stack_frame) (s2 :α stack_frame). PERM_STACK s1 s2) l1 l2 ⇒ stack_size l1 = stack_size l2
pop_env_const_typed=pop_env (x :(α, β, γ) state) = SOME (y :(α, β, γ) state) ⇒ y.clock = x.clock ∧ y.ffi = x.ffi ∧ (y.be ⇔ x.be) ∧ y.compile = x.compile ∧ y.compile_oracle = x.compile_oracle ∧ y.memory = x.memory ∧ y.mdomain = x.mdomain ∧ y.sh_mdomain = x.sh_mdomain ∧ y.store = x.store ∧ y.fp_regs = x.fp_regs ∧ y.gc_fun = x.gc_fun ∧ y.termdep = x.termdep ∧ y.permute = x.permute ∧ y.data_buffer = x.data_buffer ∧ y.code_buffer = x.code_buffer ∧ y.code = x.code ∧ y.stack_limit = x.stack_limit ∧ y.stack_max = x.stack_max ∧ y.stack_size = x.stack_size
s_frame_key_eq_def_typed=(s_frame_key_eq (StackFrame (n :num option) (ls0 :(num # α word_loc) list) (ls :(num # α word_loc) list) (NONE :(num # num # num) option)) (StackFrame (n' :num option) (ls0' :(num # α word_loc) list) (ls' :(num # α word_loc) list) (NONE :(num # num # num) option)) ⇔ MAP (FST :num # α word_loc -> num) ls = MAP (FST :num # α word_loc -> num) ls' ∧ ls0 = ls0' ∧ n = n') ∧ (s_frame_key_eq (StackFrame n ls0 ls (SOME (y :num # num # num))) (StackFrame n' ls0' ls' (SOME (y' :num # num # num))) ⇔ MAP (FST :num # α word_loc -> num) ls = MAP (FST :num # α word_loc -> num) ls' ∧ y = y' ∧ ls0 = ls0' ∧ n = n') ∧ (s_frame_key_eq (StackFrame (v3 :num option) (v4 :(num # α word_loc) list) (v5 :(num # α word_loc) list) (SOME (v21 :num # num # num))) (StackFrame (v11 :num option) (v12 :(num # α word_loc) list) (v13 :(num # α word_loc) list) (NONE :(num # num # num) option)) ⇔ F) ∧ (s_frame_key_eq (StackFrame v3 v4 v5 (NONE :(num # num # num) option)) (StackFrame v11 v12 v13 (SOME (v19 :num # num # num))) ⇔ F)
s_frame_key_eq_def2_typed=s_frame_key_eq (StackFrame (n :num option) (ls0 :(num # α word_loc) list) (ls :(num # α word_loc) list) (y :(num # num # num) option)) (StackFrame (n' :num option) (ls0' :(num # α word_loc) list) (ls' :(num # α word_loc) list) (y' :(num # num # num) option)) ⇔ MAP (FST :num # α word_loc -> num) ls = MAP (FST :num # α word_loc -> num) ls' ∧ y = y' ∧ ls0 = ls0' ∧ n = n'
s_frame_key_eq_refl_typed=∀(ls :α stack_frame). s_frame_key_eq ls ls ⇔ T
s_frame_val_eq_def_typed=(s_frame_val_eq (StackFrame (n :num option) (ls1 :(num # α word_loc) list) (ls :(num # α word_loc) list) (NONE :(num # num # num) option)) (StackFrame (n' :num option) (ls1' :(num # α word_loc) list) (ls' :(num # α word_loc) list) (NONE :(num # num # num) option)) ⇔ MAP (SND :num # α word_loc -> α word_loc) ls = MAP (SND :num # α word_loc -> α word_loc) ls' ∧ n = n') ∧ (s_frame_val_eq (StackFrame n ls1 ls (SOME (y :num # num # num))) (StackFrame n' ls1' ls' (SOME (y' :num # num # num))) ⇔ MAP (SND :num # α word_loc -> α word_loc) ls = MAP (SND :num # α word_loc -> α word_loc) ls' ∧ y = y' ∧ n = n') ∧ (s_frame_val_eq (StackFrame (v3 :num option) (v4 :(num # α word_loc) list) (v5 :(num # α word_loc) list) (SOME (v21 :num # num # num))) (StackFrame (v11 :num option) (v12 :(num # α word_loc) list) (v13 :(num # α word_loc) list) (NONE :(num # num # num) option)) ⇔ F) ∧ (s_frame_val_eq (StackFrame v3 v4 v5 (NONE :(num # num # num) option)) (StackFrame v11 v12 v13 (SOME (v19 :num # num # num))) ⇔ F)
s_frame_val_eq_def2_typed=s_frame_val_eq (StackFrame (n :num option) (ls0 :(num # α word_loc) list) (ls :(num # α word_loc) list) (y :(num # num # num) option)) (StackFrame (n' :num option) (ls0' :(num # α word_loc) list) (ls' :(num # α word_loc) list) (y' :(num # num # num) option)) ⇔ MAP (SND :num # α word_loc -> α word_loc) ls = MAP (SND :num # α word_loc -> α word_loc) ls' ∧ y = y' ∧ n = n'
s_frame_val_eq_refl_typed=∀(ls :α stack_frame). s_frame_val_eq ls ls ⇔ T
s_key_eq_def_typed=(s_key_eq ([] :α stack_frame list) ([] :α stack_frame list) ⇔ T) ∧ (∀(ys :α stack_frame list) (y :α stack_frame) (xs :α stack_frame list) (x :α stack_frame). s_key_eq (x::xs) (y::ys) ⇔ s_key_eq xs ys ∧ s_frame_key_eq x y) ∧ (∀(v8 :α stack_frame list) (v7 :α stack_frame). s_key_eq ([] :α stack_frame list) (v7::v8) ⇔ F) ∧ ∀(v4 :α stack_frame list) (v3 :α stack_frame). s_key_eq (v3::v4) ([] :α stack_frame list) ⇔ F
s_key_eq_refl_typed=∀(ls :α stack_frame list). s_key_eq ls ls ⇔ T
s_val_and_key_eq_typed=∀(s :α stack_frame list) (t :α stack_frame list). s_val_eq s t ∧ s_key_eq s t ⇒ s = t
s_val_eq_def_typed=(s_val_eq ([] :α stack_frame list) ([] :α stack_frame list) ⇔ T) ∧ (∀(ys :α stack_frame list) (y :α stack_frame) (xs :α stack_frame list) (x :α stack_frame). s_val_eq (x::xs) (y::ys) ⇔ s_val_eq xs ys ∧ s_frame_val_eq x y) ∧ (∀(v8 :α stack_frame list) (v7 :α stack_frame). s_val_eq ([] :α stack_frame list) (v7::v8) ⇔ F) ∧ ∀(v4 :α stack_frame list) (v3 :α stack_frame). s_val_eq (v3::v4) ([] :α stack_frame list) ⇔ F
s_val_eq_refl_typed=∀(ls :α stack_frame list). s_val_eq ls ls ⇔ T
LASTN_LENGTH_cond_typed=∀(n :num) (xs :α list). n = LENGTH xs ⇒ LASTN n xs = xs
s_key_eq_stack_size_typed=∀(xs :α stack_frame list) (ys :α stack_frame list). s_key_eq xs ys ⇒ stack_size xs = stack_size ys
s_key_eq_tail_typed=∀(a :α stack_frame) (b :α stack_frame list) (c :α stack_frame) (d :α stack_frame list). s_key_eq (a::b) (c::d) ⇒ s_key_eq b d
s_val_append_eq_stack_size_typed=∀(stk :α stack_frame list) (stk' :α stack_frame list) (frm :α stack_frame). s_val_eq stk stk' ⇒ stack_size (frm::stk) = stack_size (frm::stk')
s_val_eq_LASTN_exists_typed=∀(s :α stack_frame list) (t :α stack_frame list) (n :num) (m :num option) (e0 :(num # α word_loc) list) (e :(num # α word_loc) list) (y :num # num # num) (xs :α stack_frame list). s_val_eq s t ∧ LASTN n s = StackFrame m e0 e (SOME y)::xs ⇒ ∃(e0' :(num # α word_loc) list) (e' :(num # α word_loc) list) (ls :α stack_frame list). LASTN n t = StackFrame m e0' e' (SOME y)::ls ∧ MAP (SND :num # α word_loc -> α word_loc) e' = MAP (SND :num # α word_loc -> α word_loc) e ∧ s_val_eq xs ls
s_val_eq_stack_size_typed=∀(xs :α stack_frame list) (ys :α stack_frame list). s_val_eq xs ys ⇒ stack_size xs = stack_size ys
gc_s_key_eq_typed=∀(s :(α, β, γ) state) (x :(α, β, γ) state). gc s = SOME x ⇒ s_key_eq s.stack x.stack
gc_s_val_eq_typed=∀(s :(α, β, γ) state) (x :δ) (st :α stack_frame list) (y :(α, β, γ) state). s_val_eq s.stack st ∧ gc s = SOME y ⇒ ∃(z :α stack_frame list). gc (s with stack := st) = SOME (y with stack := z) ∧ s_val_eq y.stack z ∧ s_key_eq z st
gc_s_val_eq_gen_typed=∀(s :(α, β, γ) state) (t :(α, δ, ε) state) (s' :(α, β, γ) state). s.gc_fun = t.gc_fun ∧ s.memory = t.memory ∧ s.mdomain = t.mdomain ∧ s.store = t.store ∧ s_val_eq s.stack t.stack ∧ s.stack_size = t.stack_size ∧ s.stack_max = t.stack_max ∧ s.stack_limit = t.stack_limit ∧ gc s = SOME s' ⇒ ∃(t' :(α, δ, ε) state). gc t = SOME t' ∧ s_val_eq s'.stack t'.stack ∧ s_key_eq t.stack t'.stack ∧ t'.memory = s'.memory ∧ t'.store = s'.store ∧ t'.stack_size = s'.stack_size ∧ t'.stack_max = s'.stack_max ∧ t'.stack_limit = s'.stack_limit
gc_s_val_eq_word_state_typed=∀(s :(α, β, γ) state) (tlocs :α word_loc sptree$num_map) (tstack :α stack_frame list) (y :(α, β, γ) state). s_val_eq s.stack tstack ∧ gc s = SOME y ⇒ ∃(zlocs :α word_loc sptree$num_map) (zstack :α stack_frame list). gc (s with <|stack := tstack; locals := tlocs|>) = SOME (y with <|stack := zstack; locals := zlocs|>) ∧ s_val_eq y.stack zstack ∧ s_key_eq zstack tstack
push_env_pop_env_s_key_eq_typed=∀(x :α word_loc sptree$num_map # α word_loc sptree$num_map) (b :(num # α prog # num # num) option) (s :(α, β, γ) state) (t :(α, δ, ε) state). s_key_eq (push_env x b s).stack t.stack ⇒ ∃(n :num option) (l :(num # α word_loc) list) (ls :α stack_frame list) (opt :(num # num # num) option). t.stack = StackFrame n (toAList (FST x)) l opt::ls ∧ ∃(y :(α, δ, ε) state). pop_env t = SOME y ∧ y.locals = union (fromAList l) (fromAList (toAList (FST x))) ∧ (domain (SND x) :num -> bool) ∪ (domain (FST x) :num -> bool) = (domain y.locals :num -> bool) ∧ s_key_eq s.stack y.stack
s_key_eq_length_typed=∀(s :α stack_frame list) (t :α stack_frame list). s_key_eq s t ⇒ LENGTH s = LENGTH t
s_key_eq_sym_typed=∀(a :α stack_frame list) (b :α stack_frame list). s_key_eq a b ⇔ s_key_eq b a
s_key_eq_trans_typed=∀(a :α stack_frame list) (b :α stack_frame list) (c :α stack_frame list). s_key_eq a b ∧ s_key_eq b c ⇒ s_key_eq a c
s_val_eq_length_typed=∀(s :α stack_frame list) (t :α stack_frame list). s_val_eq s t ⇒ LENGTH s = LENGTH t
s_val_eq_sym_typed=∀(a :α stack_frame list) (b :α stack_frame list). s_val_eq a b ⇔ s_val_eq b a
s_val_eq_trans_typed=∀(a :α stack_frame list) (b :α stack_frame list) (c :α stack_frame list). s_val_eq a b ∧ s_val_eq b c ⇒ s_val_eq a c
