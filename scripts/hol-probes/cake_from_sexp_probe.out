typesexp_typed=(∀(s :mlstring). typesexp (Atvar s) = listsexp [SX_SYM "Atvar"; SEXSTR (explode s)]) ∧ (∀(t2 :ast_t) (t1 :ast_t). typesexp (Atfun t1 t2) = listsexp [SX_SYM "Atfun"; typesexp t1; typesexp t2]) ∧ (∀(ts :ast_t list). typesexp (Attup ts) = listsexp [SX_SYM "Attup"; listsexp (MAP (λ(a :ast_t). typesexp a) ts)]) ∧ ∀(ts :ast_t list) (tc :(mlstring, mlstring) id). typesexp (Atapp ts tc) = listsexp [SX_SYM "Atapp"; listsexp (MAP (λ(a :ast_t). typesexp a) ts); idsexp tc]
