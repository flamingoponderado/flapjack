litsexp_typed=(∀(i :int). litsexp (IntLit i) = if i < (0 :int) then listsexp [SX_SYM "-"; ((&Num (-i)) :sexp)] else ((&Num i) :sexp)) ∧ (∀(c :char). litsexp (Char c) = listsexp [SX_SYM "char"; SEXSTR (STRING c ("" :string))]) ∧ (∀(s :mlstring). litsexp (StrLit s) = SEXSTR (explode s)) ∧ (∀(w :word8). litsexp (Word8 w) = listsexp [SX_SYM "word8"; ((&w2n w) :sexp)]) ∧ (∀(w :word64). litsexp (Word64 w) = listsexp [SX_SYM "word64"; ((&w2n w) :sexp)]) ∧ ∀(w :word64). litsexp (Float64 w) = listsexp [SX_SYM "float64"; ((&w2n w) :sexp)]
