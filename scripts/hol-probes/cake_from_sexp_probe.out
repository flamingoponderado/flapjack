lists=[SOME []; SOME [1; 2; 3]; NONE; NONE]
option=[SOME NONE; SOME (SOME 5); NONE; NONE]
identifier=[SOME (Short «x»); SOME (Long «M» (Short «x»)); NONE; SOME (Long «A» (Long «B» (Short «x»))); NONE; NONE]
literals=[SOME (IntLit 0); SOME (IntLit 12); SOME (StrLit «a\^@b»); NONE; SOME (IntLit (-12)); SOME (Char #"z"); NONE; SOME (Word8 255w); NONE; SOME (Word64 0xFFFFFFFFFFFFFFFFw); NONE; SOME (Float64 42w)]
locations=[SOME (Locs UNKNOWNpt EOFpt); SOME (Locs (POSN 1 2) (POSN 3 4)); NONE; NONE]
types=[SOME (Atvar «a»); SOME (Atfun (Atvar «a») (Attup [])); SOME (Atapp [Atvar «a»] (Short «list»)); NONE; SOME (Attup [Atvar «a»; Atvar «b»]); NONE; NONE]
patterns=[SOME (Pvar «x»); SOME Pany; SOME (Plit (IntLit 42)); SOME (Pcon NONE [Pvar «x»; Pany]); SOME (Pas (Pref (Pvar «x»)) «y»); SOME (Ptannot (Pvar «x») (Atvar «a»)); NONE; SOME (Pcon NONE [Pref (Pvar «x»); Pany]); NONE; NONE]
expressions=[SOME (Lit (IntLit 1)); SOME (Var (Short «x»)); SOME (Raise (Lit (IntLit 1))); SOME (Fun «x» (Var (Short «x»))); SOME (Con NONE [Lit (IntLit 1); Lit (IntLit 2)]); SOME (Mat (Lit (IntLit 1)) [(Pvar «x»,Lit (IntLit 2))]); SOME (Letrec [(«f»,«x»,Lit (IntLit 1))] (Lit (IntLit 2))); SOME (If (Lit (IntLit 1)) (Lit (IntLit 2)) (Lit (IntLit 3))); NONE; NONE; NONE]
declarations=[SOME (Denv «x»); SOME (Dlet (Locs UNKNOWNpt UNKNOWNpt) (Pvar «x») (Lit (IntLit 1))); SOME (Dmod «M» [Denv «x»]); SOME (Dlocal [Denv «a»] [Denv «b»]); SOME (Dtype (Locs UNKNOWNpt UNKNOWNpt) []); SOME (Dexn (Locs UNKNOWNpt UNKNOWNpt) «E» [Atvar «a»]); SOME (Dtabbrev (Locs UNKNOWNpt UNKNOWNpt) [«a»] «t» (Atvar «a»)); NONE; NONE]
operators=[SOME Equality; SOME Opapp; SOME Aw8sub_unsafe; SOME (ThunkOp ForceThunk); SOME Env_id; SOME (FFI «x\^@y»); SOME (ThunkOp (AllocThunk Evaluated)); SOME (ThunkOp (UpdateThunk NotEvaluated)); SOME (Shift W64 Ror 123); SOME (Arith Add IntT); SOME (FromTo (WordT W8) (WordT W64)); SOME (Test (AltCompare Leq) IntT); NONE; NONE]
