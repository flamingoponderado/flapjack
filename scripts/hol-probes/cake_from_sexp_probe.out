control=[SOME "abc"; SOME "\\"; SOME "\^@"; SOME "\^_"; SOME "\127"; SOME "\255"; NONE; NONE; NONE; NONE; NONE; NONE; SOME "x\^@y"]
decode_encode_control_typed=∀(ls :string). decode_control (encode_control ls) = SOME ls
encode_decode_control_typed=∀(ls :string) (r :string). decode_control ls = SOME r ⇒ ls = encode_control r
sexpid_typed=∀(s :sexp) (p :sexp -> α option). sexpid p s = do ((nm :string),(args :sexp list)) <- dstrip_sexp s; do assert (nm = "Short" ∧ LENGTH args = (1 :num)); OPTION_MAP (Short :α -> (mlstring, α) id) (p args❲(0 :num)❳) od ++ do assert (nm = "Long" ∧ LENGTH args = (2 :num)); OPTION_MAP2 (Long :mlstring -> (mlstring, α) id -> (mlstring, α) id) (odestSEXSTR args❲(0 :num)❳) (sexpid p args❲(1 :num)❳) od od
sexptype_typed=∀(s :sexp). sexptype s = do ((s' :string),(args :sexp list)) <- dstrip_sexp s; do assert (s' = "Atvar" ∧ LENGTH args = (1 :num)); OPTION_MAP Atvar (odestSEXSTR args❲(0 :num)❳) od ++ do assert (s' = "Atfun" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Atfun (sexptype args❲(0 :num)❳) (sexptype args❲(1 :num)❳) od ++ do assert (s' = "Attup" ∧ LENGTH args = (1 :num)); OPTION_MAP Attup (sexplist (λ(a :sexp). sexptype a) args❲(0 :num)❳) od ++ do assert (s' = "Atapp" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Atapp (sexplist (λ(a :sexp). sexptype a) args❲(0 :num)❳) (sexpid odestSEXSTR args❲(1 :num)❳) od od
sexppat_typed=∀(s :sexp). sexppat s = OPTION_MAP Pvar (odestSEXSTR s) ++ do ((nm :string),(args :sexp list)) <- dstrip_sexp s; do assert (nm = "Pany" ∧ LENGTH args = (0 :num)); SOME Pany od ++ do assert (nm = "Plit" ∧ LENGTH args = (1 :num)); OPTION_MAP Plit (sexplit args❲(0 :num)❳) od ++ do assert (nm = "Pcon" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Pcon (sexpopt (sexpid odestSEXSTR) args❲(0 :num)❳) (sexplist (λ(a :sexp). sexppat a) args❲(1 :num)❳) od ++ do assert (nm = "Pas" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Pas (sexppat args❲(0 :num)❳) (odestSEXSTR args❲(1 :num)❳) od ++ do assert (nm = "Pref" ∧ LENGTH args = (1 :num)); OPTION_MAP Pref (sexppat args❲(0 :num)❳) od ++ do assert (nm = "Ptannot" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Ptannot (sexppat args❲(0 :num)❳) (sexptype args❲(1 :num)❳) od od
sexpexp_typed=∀(s :sexp). sexpexp s = do ((nm :string),(args :sexp list)) <- dstrip_sexp s; do assert (nm = "Raise" ∧ LENGTH args = (1 :num)); OPTION_MAP Raise (sexpexp args❲(0 :num)❳) od ++ do assert (nm = "Handle" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Handle (sexpexp args❲(0 :num)❳) (sexplist (sexppair sexppat (λ(a :sexp). sexpexp a)) args❲(1 :num)❳) od ++ do assert (nm = "Lit" ∧ LENGTH args = (1 :num)); OPTION_MAP Lit (sexplit args❲(0 :num)❳) od ++ do assert (nm = "Con" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Con (sexpopt (sexpid odestSEXSTR) args❲(0 :num)❳) (sexplist (λ(a :sexp). sexpexp a) args❲(1 :num)❳) od ++ do assert (nm = "Var" ∧ LENGTH args = (1 :num)); OPTION_MAP Var (sexpid odestSEXSTR args❲(0 :num)❳) od ++ do assert (nm = "Fun" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Fun (odestSEXSTR args❲(0 :num)❳) (sexpexp args❲(1 :num)❳) od ++ do assert (nm = "App" ∧ LENGTH args = (2 :num)); OPTION_MAP2 App (sexpop args❲(0 :num)❳) (sexplist (λ(a :sexp). sexpexp a) args❲(1 :num)❳) od ++ do assert (nm = "Log" ∧ LENGTH args = (3 :num)); ((((OPTION_MAP Log (sexplog args❲(0 :num)❳) <*> sexpexp args❲(1 :num)❳) :(exp -> exp) option) <*> sexpexp args❲(2 :num)❳) :exp option) od ++ do assert (nm = "If" ∧ LENGTH args = (3 :num)); ((((OPTION_MAP If (sexpexp args❲(0 :num)❳) <*> sexpexp args❲(1 :num)❳) :(exp -> exp) option) <*> sexpexp args❲(2 :num)❳) :exp option) od ++ do assert (nm = "Mat" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Mat (sexpexp args❲(0 :num)❳) (sexplist (sexppair sexppat (λ(a :sexp). sexpexp a)) args❲(1 :num)❳) od ++ do assert (nm = "Let" ∧ LENGTH args = (3 :num)); ((((OPTION_MAP Let (sexpopt odestSEXSTR args❲(0 :num)❳) <*> sexpexp args❲(1 :num)❳) :(exp -> exp) option) <*> sexpexp args❲(2 :num)❳) :exp option) od ++ do assert (nm = "Letrec" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Letrec (sexplist (sexppair odestSEXSTR (sexppair odestSEXSTR (λ(a :sexp). sexpexp a))) args❲(0 :num)❳) (sexpexp args❲(1 :num)❳) od ++ do assert (nm = "Tannot" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Tannot (sexpexp args❲(0 :num)❳) (sexptype args❲(1 :num)❳) od ++ do assert (nm = "Lannot" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Lannot (sexpexp args❲(0 :num)❳) (sexplocn args❲(1 :num)❳) od od
sexptype_def_typed=sexptype_def = sexplist (sexppair (sexplist odestSEXSTR) (sexppair odestSEXSTR (sexplist (sexppair odestSEXSTR (sexplist sexptype)))))
sexptype_def_type=:sexp -> (mlstring list # mlstring # (mlstring # ast_t list) list) list option
sexpdec_typed=∀(s :sexp). sexpdec s = do ((nm :string),(args :sexp list)) <- dstrip_sexp s; do assert (nm = "Dlet" ∧ LENGTH args = (3 :num)); ((((OPTION_MAP Dlet (sexplocn (HD args)) <*> sexppat args❲(1 :num)❳) :(exp -> dec) option) <*> sexpexp args❲(2 :num)❳) :dec option) od ++ do assert (nm = "Dletrec" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Dletrec (sexplocn (HD args)) (sexplist (sexppair odestSEXSTR (sexppair odestSEXSTR sexpexp)) args❲(1 :num)❳) od ++ do assert (nm = "Dtype" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Dtype (sexplocn (HD args)) (sexptype_def args❲(1 :num)❳) od ++ do assert (nm = "Dtabbrev" ∧ LENGTH args = (4 :num)); ((((((OPTION_MAP Dtabbrev (sexplocn args❲(0 :num)❳) <*> sexplist odestSEXSTR args❲(1 :num)❳) :(mlstring -> ast_t -> dec) option) <*> odestSEXSTR args❲(2 :num)❳) :(ast_t -> dec) option) <*> sexptype args❲(3 :num)❳) :dec option) od ++ do assert (nm = "Denv" ∧ LENGTH args = (1 :num)); OPTION_MAP Denv (odestSEXSTR args❲(0 :num)❳) od ++ do assert (nm = "Dexn" ∧ LENGTH args = (3 :num)); ((((OPTION_MAP Dexn (sexplocn args❲(0 :num)❳) <*> odestSEXSTR args❲(1 :num)❳) :(ast_t list -> dec) option) <*> sexplist sexptype args❲(2 :num)❳) :dec option) od ++ do assert (nm = "Dmod" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Dmod (odestSEXSTR args❲(0 :num)❳) (sexplist (λ(a :sexp). sexpdec a) args❲(1 :num)❳) od ++ do assert (nm = "Dlocal" ∧ LENGTH args = (2 :num)); OPTION_MAP2 Dlocal (sexplist (λ(a :sexp). sexpdec a) args❲(0 :num)❳) (sexplist (λ(a :sexp). sexpdec a) args❲(1 :num)❳) od od
sexp_constructors_typed=:(sexp -> sexp -> sexp) # (string -> sexp) # (num -> sexp) # (string -> sexp)
lists=[SOME []; SOME [1; 2; 3]; NONE; NONE]
option=[SOME NONE; SOME (SOME 5); NONE; NONE]
identifier=[SOME (Short «x»); SOME (Long «M» (Short «x»)); NONE; SOME (Long «A» (Long «B» (Short «x»))); NONE; NONE]
literals=[SOME (IntLit 0); SOME (IntLit 12); SOME (StrLit «a\^@b»); NONE; SOME (IntLit (-12)); SOME (Char #"z"); NONE; SOME (Word8 255w); NONE; SOME (Word64 0xFFFFFFFFFFFFFFFFw); NONE; SOME (Float64 42w)]
locations=[SOME (Locs UNKNOWNpt EOFpt); SOME (Locs (POSN 1 2) (POSN 3 4)); NONE; NONE]
types=[SOME (Atvar «a»); SOME (Atfun (Atvar «a») (Attup [])); SOME (Atapp [Atvar «a»] (Short «list»)); NONE; SOME (Attup [Atvar «a»; Atvar «b»]); NONE; NONE]
patterns=[SOME (Pvar «x»); SOME Pany; SOME (Plit (IntLit 42)); SOME (Pcon NONE [Pvar «x»; Pany]); SOME (Pas (Pref (Pvar «x»)) «y»); SOME (Ptannot (Pvar «x») (Atvar «a»)); NONE; SOME (Pcon NONE [Pref (Pvar «x»); Pany]); NONE; NONE]
expressions=[SOME (Lit (IntLit 1)); SOME (Var (Short «x»)); SOME (Raise (Lit (IntLit 1))); SOME (Fun «x» (Var (Short «x»))); SOME (Con NONE [Lit (IntLit 1); Lit (IntLit 2)]); SOME (Mat (Lit (IntLit 1)) [(Pvar «x»,Lit (IntLit 2))]); SOME (Letrec [(«f»,«x»,Lit (IntLit 1))] (Lit (IntLit 2))); SOME (If (Lit (IntLit 1)) (Lit (IntLit 2)) (Lit (IntLit 3))); NONE; NONE; NONE]
declarations=[SOME (Denv «x»); SOME (Dlet (Locs UNKNOWNpt UNKNOWNpt) (Pvar «x») (Lit (IntLit 1))); SOME (Dmod «M» [Denv «x»]); SOME (Dlocal [Denv «a»] [Denv «b»]); SOME (Dtype (Locs UNKNOWNpt UNKNOWNpt) []); SOME (Dexn (Locs UNKNOWNpt UNKNOWNpt) «E» [Atvar «a»]); SOME (Dtabbrev (Locs UNKNOWNpt UNKNOWNpt) [«a»] «t» (Atvar «a»)); NONE; NONE]
operators=[SOME Equality; SOME Opapp; SOME Aw8sub_unsafe; SOME (ThunkOp ForceThunk); SOME Env_id; SOME (FFI «x\^@y»); SOME (ThunkOp (AllocThunk Evaluated)); SOME (ThunkOp (UpdateThunk NotEvaluated)); SOME (Shift W64 Ror 123); SOME (Arith Add IntT); SOME (FromTo (WordT W8) (WordT W64)); SOME (Test (AltCompare Leq) IntT); NONE; NONE]
