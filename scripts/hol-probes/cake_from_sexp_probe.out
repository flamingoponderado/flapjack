optsexp_typed=optsexp (NONE :sexp option) = SX_SYM "NONE" ∧ ∀(x :sexp). optsexp (SOME x) = listsexp [SX_SYM "SOME"; x]
idsexp_typed=(∀(n :mlstring). idsexp (Short n :(mlstring, mlstring) id) = listsexp [SX_SYM "Short"; SEXSTR (explode n)]) ∧ ∀(ns :mlstring) (n :(mlstring, mlstring) id). idsexp (Long ns n) = listsexp [SX_SYM "Long"; SEXSTR (explode ns); idsexp n]
