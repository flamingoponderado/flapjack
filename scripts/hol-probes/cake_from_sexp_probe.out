encode_control_remove_typed=∀(s :string). EVERY isPrint s ∧ ¬MEM #"\\" s ⇒ encode_control s = s
SEXSTR_remove_typed=EVERY isPrint (s :string) ∧ ¬MEM #"\\" s ⇒ SEXSTR s = SX_STR s
odestSEXSTR_typed=odestSEXSTR (SX_STR (s :string)) = OPTION_MAP implode (decode_control s) ∧ odestSEXSTR ⟪(v :sexp) • (v1 :sexp)⟫ = (NONE :mlstring option) ∧ odestSEXSTR (SX_SYM (v2 :string)) = (NONE :mlstring option) ∧ odestSEXSTR ((&(v3 :num)) :sexp) = (NONE :mlstring option)
sexplist_typed=∀(s :sexp) (p :sexp -> α option). sexplist p s = case s of ⟪h • t⟫ => do (ph :α) <- p h; (pt :α list) <- sexplist p t; SOME (ph::pt) od | ⟪⟫ => SOME ([] :α list) | SX_SYM s' => (NONE :α list option) | ((&v8) :sexp) => (NONE :α list option) | SX_STR v9 => (NONE :α list option)
sexppair_typed=∀(p1 :sexp -> α option) (p2 :sexp -> β option) (s :sexp). sexppair p1 p2 s = case s of ⟪s1 • s2⟫ => OPTION_MAP2 ($, :α -> β -> α # β) (p1 s1) (p2 s2) | SX_SYM v7 => (NONE :(α # β) option) | ((&v8) :sexp) => (NONE :(α # β) option) | SX_STR v9 => (NONE :(α # β) option)
sexpopt_typed=∀(p :sexp -> α option) (s :sexp). sexpopt p s = do (nm :mlstring) <- odestSXSYM s; assert (nm = «NONE»); SOME (NONE :α option) od ++ do ((nm :string),(args :sexp list)) <- dstrip_sexp s; assert (nm = "SOME" ∧ LENGTH args = (1 :num)); OPTION_MAP (SOME :α -> α option) (p (HD args)) od
sexplit_typed=∀(s :sexp). sexplit s = OPTION_MAP (IntLit ∘ $&) (odestSXNUM s) ++ OPTION_MAP StrLit (odestSEXSTR s) ++ do ((nm :string),(args :sexp list)) <- dstrip_sexp s; assert (LENGTH args = (1 :num)); do assert (nm = "-"); (n :num) <- odestSXNUM (HD args); if n = (0 :num) then (NONE :lit option) else SOME (IntLit (-((&n) :int))) od ++ do assert (nm = "char"); (cs :mlstring) <- odestSEXSTR (HD args); assert (strlen cs = (1 :num)); SOME (Char (strsub cs (0 :num))) od ++ do assert (nm = "word8"); (n :num) <- odestSXNUM (HD args); assert (n < (256 :num)); SOME (Word8 (n2w n :word8)) od ++ do assert (nm = "word64"); (n :num) <- odestSXNUM (HD args); assert (n < (2 :num) ** (64 :num)); SOME (Word64 (n2w n :word64)) od ++ do assert (nm = "float64"); (n :num) <- odestSXNUM (HD args); assert (n < (2 :num) ** (64 :num)); SOME (Float64 (n2w n :word64)) od od
sexplocpt_typed=sexplocpt (SX_SYM (s :string)) = (if s = "unk" then SOME UNKNOWNpt else if s = "eof" then SOME EOFpt else (NONE :locn option)) ∧ sexplocpt ⟪(v :sexp) • (v1 :sexp)⟫ = do (ls :sexp list) <- strip_sxcons ⟪v • v1⟫; assert (LENGTH ls = (2 :num)); OPTION_MAP2 POSN (odestSXNUM ls❲(0 :num)❳) (odestSXNUM ls❲(1 :num)❳) od ∧ sexplocpt ((&(v3 :num)) :sexp) = do (ls :sexp list) <- strip_sxcons ((&v3) :sexp); assert (LENGTH ls = (2 :num)); OPTION_MAP2 POSN (odestSXNUM ls❲(0 :num)❳) (odestSXNUM ls❲(1 :num)❳) od ∧ sexplocpt (SX_STR (v4 :string)) = do (ls :sexp list) <- strip_sxcons (SX_STR v4); assert (LENGTH ls = (2 :num)); OPTION_MAP2 POSN (odestSXNUM ls❲(0 :num)❳) (odestSXNUM ls❲(1 :num)❳) od
sexplocn_typed=∀(s :sexp). sexplocn s = do (ls :sexp list) <- strip_sxcons s; assert (LENGTH ls = (2 :num)); OPTION_MAP2 Locs (sexplocpt ls❲(0 :num)❳) (sexplocpt ls❲(1 :num)❳) od
sexparith_typed=sexparith (SX_SYM (s :string)) = (if s = "Add" then SOME Add else if s = "Sub" then SOME Sub else if s = "Mul" then SOME Mul else if s = "Div" then SOME Div else if s = "Mod" then SOME Mod else if s = "Neg" then SOME Neg else if s = "Abs" then SOME Abs else if s = "And" then SOME And else if s = "Xor" then SOME Xor else if s = "Or" then SOME Or else if s = "Not" then SOME Not else if s = "Sqrt" then SOME Sqrt else if s = "FMA" then SOME FMA else (NONE :arith option)) ∧ sexparith ⟪(v :sexp) • (v1 :sexp)⟫ = (NONE :arith option) ∧ sexparith ((&(v3 :num)) :sexp) = (NONE :arith option) ∧ sexparith (SX_STR (v4 :string)) = (NONE :arith option)
decode_prim_type_typed=decode_prim_type (SX_SYM (s :string)) = (if s = "BoolT" then SOME BoolT else if s = "IntT" then SOME IntT else if s = "CharT" then SOME CharT else if s = "StrT" then SOME StrT else if s = "Word8T" then SOME (WordT W8) else if s = "Word64T" then SOME (WordT W64) else if s = "Float64T" then SOME Float64T else (NONE :prim_type option)) ∧ decode_prim_type ⟪(v :sexp) • (v1 :sexp)⟫ = (NONE :prim_type option) ∧ decode_prim_type ((&(v3 :num)) :sexp) = (NONE :prim_type option) ∧ decode_prim_type (SX_STR (v4 :string)) = (NONE :prim_type option)
decode_test_typed=decode_test (SX_SYM (s :string)) = (if s = "Equal" then SOME Equal else if s = "Less" then SOME (Compare Lt) else if s = "LessEq" then SOME (Compare Leq) else if s = "Greater" then SOME (Compare Gt) else if s = "GreaterEq" then SOME (Compare Geq) else if s = "AltLess" then SOME (AltCompare Lt) else if s = "AltLessEq" then SOME (AltCompare Leq) else if s = "AltGreater" then SOME (AltCompare Gt) else if s = "AltGreaterEq" then SOME (AltCompare Geq) else (NONE :test option)) ∧ decode_test ⟪(v :sexp) • (v1 :sexp)⟫ = (NONE :test option) ∧ decode_test ((&(v3 :num)) :sexp) = (NONE :test option) ∧ decode_test (SX_STR (v4 :string)) = (NONE :test option)
sexplog_typed=sexplog (SX_SYM (s :string)) = (if s = "Andalso" then SOME Andalso else if s = "Orelse" then SOME Orelse else (NONE :lop option)) ∧ sexplog ⟪(v :sexp) • (v1 :sexp)⟫ = (NONE :lop option) ∧ sexplog ((&(v3 :num)) :sexp) = (NONE :lop option) ∧ sexplog (SX_STR (v4 :string)) = (NONE :lop option)
sexpop_typed=sexpop (SX_SYM (s :string)) = (if s = "Equality" then SOME Equality else if s = "Opapp" then SOME Opapp else if s = "Opassign" then SOME Opassign else if s = "Opref" then SOME Opref else if s = "Opderef" then SOME Opderef else if s = "Aw8alloc" then SOME Aw8alloc else if s = "Aw8sub" then SOME Aw8sub else if s = "Aw8length" then SOME Aw8length else if s = "Aw8update" then SOME Aw8update else if s = "Aw8subunsafe" then SOME Aw8sub_unsafe else if s = "Aw8updateunsafe" then SOME Aw8update_unsafe else if s = "CopyStrStr" then SOME CopyStrStr else if s = "CopyStrAw8" then SOME CopyStrAw8 else if s = "CopyAw8Str" then SOME CopyAw8Str else if s = "CopyAw8Aw8" then SOME CopyAw8Aw8 else if s = "XorAw8Strunsafe" then SOME XorAw8Str_unsafe else if s = "Implode" then SOME Implode else if s = "Explode" then SOME Explode else if s = "Strsub" then SOME Strsub else if s = "Strlen" then SOME Strlen else if s = "Strcat" then SOME Strcat else if s = "VfromList" then SOME VfromList else if s = "Vsub" then SOME Vsub else if s = "Vsubunsafe" then SOME Vsub_unsafe else if s = "Vlength" then SOME Vlength else if s = "ListAppend" then SOME ListAppend else if s = "Aalloc" then SOME Aalloc else if s = "AallocEmpty" then SOME AallocEmpty else if s = "AallocFixed" then SOME AallocFixed else if s = "Asub" then SOME Asub else if s = "Alength" then SOME Alength else if s = "Aupdate" then SOME Aupdate else if s = "Asubunsafe" then SOME Asub_unsafe else if s = "Aupdateunsafe" then SOME Aupdate_unsafe else if s = "ForceThunk" then SOME (ThunkOp ForceThunk) else if s = "ConfigGC" then SOME ConfigGC else if s = "Eval" then SOME Eval else if s = "Envid" then SOME Env_id else (NONE :op option)) ∧ sexpop ⟪SX_SYM s • SX_STR (s' :string)⟫ = (if s = "FFI" then OPTION_MAP (FFI ∘ implode) (decode_control s') else (NONE :op option)) ∧ sexpop ⟪SX_SYM s • SX_SYM (t :string)⟫ = (case decode_thunk_mode t of (NONE :thunk_mode option) => (NONE :op option) | SOME m => if s = "AllocThunk" then SOME (ThunkOp (AllocThunk m)) else if s = "UpdateThunk" then SOME (ThunkOp (UpdateThunk m)) else (NONE :op option)) ∧ sexpop ⟪SX_SYM s • ((&(n :num)) :sexp)⟫ = (if s = "Shift8Lsl" then SOME (Shift W8 Lsl n) else if s = "Shift8Lsr" then SOME (Shift W8 Lsr n) else if s = "Shift8Asr" then SOME (Shift W8 Asr n) else if s = "Shift8Ror" then SOME (Shift W8 Ror n) else if s = "Shift64Lsl" then SOME (Shift W64 Lsl n) else if s = "Shift64Lsr" then SOME (Shift W64 Lsr n) else if s = "Shift64Asr" then SOME (Shift W64 Asr n) else if s = "Shift64Ror" then SOME (Shift W64 Ror n) else (NONE :op option)) ∧ sexpop ⟪SX_SYM s • ⟪(x :sexp) • (y :sexp)⟫⟫ = (if s = "Arith" then case (sexparith x,decode_prim_type y) of ((NONE :arith option),v3) => (NONE :op option) | (SOME a,(NONE :prim_type option)) => (NONE :op option) | (SOME a,SOME prim_type) => SOME (Arith a prim_type) else if s = "FromTo" then case (decode_prim_type x,decode_prim_type y) of ((NONE :prim_type option),v3) => (NONE :op option) | (SOME ty1,(NONE :prim_type option)) => (NONE :op option) | (SOME ty1,SOME ty2) => SOME (FromTo ty1 ty2) else if s = "Test" then case (decode_test x,decode_prim_type y) of ((NONE :test option),v3) => (NONE :op option) | (SOME test,(NONE :prim_type option)) => (NONE :op option) | (SOME test,SOME prim_type) => SOME (Test test prim_type) else (NONE :op option)) ∧ sexpop ⟪⟪(v12 :sexp) • (v13 :sexp)⟫ • (v1 :sexp)⟫ = (NONE :op option) ∧ sexpop ⟪((&(v15 :num)) :sexp) • v1⟫ = (NONE :op option) ∧ sexpop ⟪SX_STR (v16 :string) • v1⟫ = (NONE :op option) ∧ sexpop ((&(v5 :num)) :sexp) = (NONE :op option) ∧ sexpop (SX_STR (v6 :string)) = (NONE :op option)
