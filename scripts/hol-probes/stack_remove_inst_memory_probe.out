im_statement=∀jump off k s t s1 op r a. state_rel jump off k s t ∧ reg_bound_inst (Mem op r a) k ∧ inst (Mem op r a) s = SOME s1 ⇒ ∃t1. inst (Mem op r a) t = SOME t1 ∧ state_rel jump off k s1 t1
im_types=jump:bool;off:α word # α word;k:num;s:(α, β, γ) stackSem$state;t:(α, β, γ) stackSem$state;s1:(α, β, γ) stackSem$state;op:memop;r:num;a:α addr
im_proved=T
