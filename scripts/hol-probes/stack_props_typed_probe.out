evaluate_clock_neutral_typed=∀(prog :α stackLang$prog) (s :(α, β, γ) state) (res :α result option) (t :(α, β, γ) state). (evaluate (prog,s) :α result option # (α, β, γ) state) = (res,t) ∧ clock_neutral prog ⇒ (evaluate (prog,s with clock := (c :num)) :α result option # (α, β, γ) state) = (res,t with clock := c)
evaluate_ffi_neutral_typed=∀(prog :α stackLang$prog) (s :(α, β, γ) state) (res :α result option) (t :(α, β, γ) state). (evaluate (prog,s) :α result option # (α, β, γ) state) = (res,t) ∧ clock_neutral prog ⇒ (evaluate (prog,s with ffi := (c :δ ffi_state)) :α result option # (α, β, δ) state) = (res,t with ffi := c)
