tar h :α stackLang$prog) ⇔ case r of (NONE :(α stackLang$prog # num # num # num) option) => T | SOME (v7,v8) => stack_asm_remove c v7 ∧ case h of (NONE :(α stackLang$prog # num # num) option) => T | SOME (v4,v5) => stack_asm_remove c v4) ∧ (∀(c :β asm_config). stack_asm_remove c (Skip :α stackLang$prog) ⇔ T) ∧ (∀(v9 :α inst) (c :β asm_config). stack_asm_remove c (Inst v9 :α stackLang$prog) ⇔ T) ∧ (∀(v30 :num) (v29 :num) (v28 :num) (c :β asm_config). stack_asm_remove c (JumpLower v28 v29 v30 :α stackLang$prog) ⇔ T) ∧ (∀(v31 :num) (c :β asm_config). stack_asm_remove c (Alloc v31 :α stackLang$prog) ⇔ T) ∧ (∀(v35 :num) (c :β asm_config). stack_asm_remove c (Raise v35 :α stackLang$prog) ⇔ T) ∧ (∀(v36 :num) (c :β asm_config). stack_asm_remove c (Return v36 :α stackLang$prog) ⇔ T) ∧ (∀(v37 :num) (c :β asm_config). stack_asm_remove c (Break v37 :α stackLang$prog) ⇔ T) ∧ (∀(v38 :num) (c :β asm_config). stack_asm_remove c (Continue v38 :α stackLang$prog) ⇔ T) ∧ (∀(v44 :num) (v43 :num) (v42 :num) (v41 :num) (v40 :num) (v39 :mlstring) (c :β asm_config). stack_asm_remove c (FFI v39 v40 v41 v42 v43 v44 :α stackLang$prog) ⇔ T) ∧ (∀(c :β asm_config). stack_asm_remove c (Tick :α stackLang$prog) ⇔ T) ∧ (∀(v47 :num) (v46 :num) (v45 :num) (c :β asm_config). stack_asm_remove c (LocValue v45 v46 v47 :α stackLang$prog) ⇔ T) ∧ (∀(v52 :num) (v51 :num) (v50 :num) (v49 :num) (v48 :num) (c :β asm_config). stack_asm_remove c (Install v48 v49 v50 v51 v52 :α stackLang$prog) ⇔ T) ∧ (∀(v55 :α addr) (v54 :num) (v53 :memop) (c :β asm_config). stack_asm_remove c (ShMemOp v53 v54 v55) ⇔ T) ∧ (∀(v57 :num) (v56 :num) (c :β asm_config). stack_asm_remove c (CodeBufferWrite v56 v57 :α stackLang$prog) ⇔ T) ∧ (∀(v59 :num) (v58 :num) (c :β asm_config). stack_asm_remove c (DataBufferWrite v58 v59 :α stackLang$prog) ⇔ T) ∧ (∀(v60 :num) (c :β asm_config). stack_asm_remove c (RawCall v60 :α stackLang$prog) ⇔ T) ∧ (∀(v61 :num) (c :β asm_config). stack_asm_remove c (StackAlloc v61 :α stackLang$prog) ⇔ T) ∧ (∀(v62 :num) (c :β asm_config). stack_asm_remove c (StackFree v62 :α stackLang$prog) ⇔ T) ∧ ∀(v75 :num) (c :β asm_config). stack_asm_remove c (Halt v75 :α stackLang$prog) ⇔ T
sh_mem_load16_with_const_typed=(sh_mem_load16 (r :num) (x :α word) ((y :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_load16 r x y :α result option # (α, β, γ) state)
sh_mem_load32_with_const_typed=(sh_mem_load32 (r :num) (x :α word) ((y :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_load32 r x y :α result option # (α, β, γ) state)
sh_mem_load_byte_with_const_typed=(sh_mem_load_byte (r :num) (x :α word) ((y :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_load_byte r x y :α result option # (α, β, γ) state)
sh_mem_load_with_const_typed=(sh_mem_load (r :num) (x :α word) ((y :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_load r x y :α result option # (α, β, γ) state)
sh_mem_op_const_typed=sh_mem_op (op :memop) (a :num) (r :α word) (s :(α, β, γ) state) = ((res :α result option),(t :(α, β, γ) state)) ⇒ t.clock = s.clock ∧ (t.use_alloc ⇔ s.use_alloc) ∧ (t.use_store ⇔ s.use_store) ∧ (t.use_stack ⇔ s.use_stack) ∧ t.code = s.code ∧ (t.be ⇔ s.be) ∧ t.gc_fun = s.gc_fun ∧ t.mdomain = s.mdomain ∧ t.sh_mdomain = s.sh_mdomain ∧ t.bitmaps = s.bitmaps ∧ t.compile = s.compile ∧ t.compile_oracle = s.compile_oracle
sh_mem_store16_with_const_typed=(sh_mem_store16 (x :num) (y :α word) ((z :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_store16 x y z :α result option # (α, β, γ) state)
sh_mem_store32_with_const_typed=(sh_mem_store32 (x :num) (y :α word) ((z :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_store32 x y z :α result option # (α, β, γ) state)
sh_mem_store_byte_with_const_typed=(sh_mem_store_byte (x :num) (y :α word) ((z :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_store_byte x y z :α result option # (α, β, γ) state)
sh_mem_store_with_const_typed=(sh_mem_store (x :num) (y :α word) ((z :(α, β, γ) state) with clock := (k :num)) :α result option # (α, β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(α, β, γ) state). s with clock := k)) (sh_mem_store x y z :α result option # (α, β, γ) state)
dec_stack_length_typed=∀(bs :α word list) (enc :β word_loc list) (orig_stack :β word_loc list) (new_stack :β word_loc list). (dec_stack bs enc orig_stack :β word_loc list option) = SOME new_stack ⇒ LENGTH orig_stack = LENGTH new_stack
map_bitmap_length_typed=∀(a :bool list) (b :α list) (c :α list) (x :α list) (y :α list) (z :α list). map_bitmap a b c = SOME (x,y,z) ⇒ LENGTH c = LENGTH x + LENGTH z ∧ LENGTH x = LENGTH a
empty_env_const_typed=(empty_env (x :(β, γ, α) state)).ffi = x.ffi ∧ (empty_env x).clock = x.clock ∧ ((empty_env (z :(δ, ε, ζ) state)).use_alloc ⇔ z.use_alloc) ∧ ((empty_env z).use_store ⇔ z.use_store) ∧ ((empty_env z).use_stack ⇔ z.use_stack) ∧ (empty_env z).code = z.code ∧ ((empty_env z).be ⇔ z.be) ∧ (empty_env z).gc_fun = z.gc_fun ∧ (empty_env z).mdomain = z.mdomain ∧ (empty_env z).sh_mdomain = z.sh_mdomain ∧ (empty_env z).bitmaps = z.bitmaps ∧ (empty_env z).data_buffer = z.data_buffer ∧ (empty_env z).code_buffer = z.code_buffer ∧ (empty_env z).compile = z.compile ∧ (empty_env z).compile_oracle = z.compile_oracle
empty_env_with_const_typed=empty_env ((x :(α, β, γ) state) with clock := (y :num)) = empty_env x with clock := y
get_var_imm_with_const_typed=get_var_imm (x :α reg_imm) ((y :(α, β, γ) state) with clock := (k :num)) = get_var_imm x y
get_var_with_const_typed=(get_var (r :num) ((t :(α, β, γ) state) with clock := (clk :num)) :α word_loc option) = (get_var r t :α word_loc option) ∧ (get_var r (t with stack_space := (stk_space :num)) :α word_loc option) = (get_var r t :α word_loc option)
set_fp_var_const_typed=(set_fp_var (x :num) (y :word64) (z :(α, β, γ) state)).stack_space = z.stack_space ∧ (set_fp_var x y z).stack = z.stack
set_store_const_typed=(set_store (x :store_name) (y :β word_loc) (z :(β, γ, α) state)).ffi = z.ffi ∧ (set_store x y z).clock = z.clock ∧ ((set_store x y z).use_alloc ⇔ z.use_alloc) ∧ ((set_store x y z).use_store ⇔ z.use_store) ∧ ((set_store x y z).use_stack ⇔ z.use_stack) ∧ (set_store x y z).code = z.code ∧ ((set_store x y z).be ⇔ z.be) ∧ (set_store x y z).gc_fun = z.gc_fun ∧ (set_store x y z).memory = z.memory ∧ (set_store x y z).mdomain = z.mdomain ∧ (set_store x y z).sh_mdomain = z.sh_mdomain ∧ (set_store x y z).bitmaps = z.bitmaps ∧ (set_store x y z).data_buffer = z.data_buffer ∧ (set_store x y z).code_buffer = z.code_buffer ∧ (set_store x y z).compile = z.compile ∧ (set_store x y z).compile_oracle = z.compile_oracle ∧ (set_store x y z).stack_space = z.stack_space ∧ (set_store x y z).stack = z.stack
set_store_with_const_typed=set_store (x :store_name) (y :α word_loc) ((z :(α, β, γ) state) with clock := (a :num)) = set_store x y z with clock := a
set_var_const_typed=(set_var (x :num) (y :β word_loc) (z :(β, γ, α) state)).ffi = z.ffi ∧ (set_var x y z).clock = z.clock ∧ ((set_var x y z).use_alloc ⇔ z.use_alloc) ∧ ((set_var x y z).use_store ⇔ z.use_store) ∧ ((set_var x y z).use_stack ⇔ z.use_stack) ∧ (set_var x y z).code = z.code ∧ ((set_var x y z).be ⇔ z.be) ∧ (set_var x y z).fp_regs = z.fp_regs ∧ (set_var x y z).data_buffer = z.data_buffer ∧ (set_var x y z).code_buffer = z.code_buffer ∧ (set_var x y z).gc_fun = z.gc_fun ∧ (set_var x y z).memory = z.memory ∧ (set_var x y z).mdomain = z.mdomain ∧ (set_var x y z).sh_mdomain = z.sh_mdomain ∧ (set_var x y z).bitmaps = z.bitmaps ∧ (set_var x y z).compile = z.compile ∧ (set_var x y z).compile_oracle = z.compile_oracle ∧ (set_var x y z).store = z.store ∧ (set_var x y z).stack = z.stack ∧ (set_var x y z).stack_space = z.stack_space
set_var_with_const_typed=set_var (x :num) (y :α word_loc) ((z :(α, β, γ) state) with clock := (clk :num)) = set_var x y z with clock := clk ∧ set_var x y (z with memory := (m :α word -> α word_loc)) = set_var x y z with memory := m ∧ set_var x y (z with ffi := (ffi :δ ffi_state)) = set_var x y z with ffi := ffi ∧ set_var x y (z with stack := (stk :α word_loc list)) = set_var x y z with stack := stk ∧ set_var x y (z with stack_space := (stk_space :num)) = set_var x y z with stack_space := stk_space
