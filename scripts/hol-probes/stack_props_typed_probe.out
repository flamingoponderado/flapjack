evaluate_add_clock_typed=∀(p :α stackLang$prog) (s :(α, β, γ) state) (r :α result option) (s' :(α, β, γ) state). (evaluate (p,s) :α result option # (α, β, γ) state) = (r,s') ∧ r ≠ SOME (TimeOut :α result) ⇒ (evaluate (p,s with clock := s.clock + (extra :num)) :α result option # (α, β, γ) state) = (r,s' with clock := s'.clock + extra)
