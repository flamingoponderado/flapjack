state_typed=recordtype.state::α word_loc sptree$num_map -> num option -> (num |-> word64) -> (store_name |-> α word_loc) -> α stack_frame list -> num -> num option -> num sptree$num_map -> (α word -> α word_loc) -> (α word -> bool) -> (α word -> bool) -> (num -> num -> num) -> (γ -> (num # num # α prog) list -> (word8 list # α word list # γ) option) -> (num -> γ # (num # num # α prog) list) -> (α, 8) buffer -> (α, α) buffer -> (α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) -> num -> num -> num -> (num # α prog) sptree$num_map -> bool -> 'ffi ffi_state -> (α, γ, 'ffi) wordSem$state
word8_loc_typed=Byte::word8 -> word8_loc; LocByte::num -> num -> num -> word8_loc
assert_def_typed=∀(b :bool) (s :(α, β, γ) state). assert b s = s with failed := (¬b ∨ s.failed)
dec_clock_def_typed=∀(s :(α, β, γ) state). dec_clock s = s with clock := s.clock − (1 :num)
inc_pc_def_typed=∀(s :(α, β, γ) state). inc_pc s = s with pc := s.pc + (1 :num)
read_fp_reg_def_typed=∀(r :num) (s :(α, β, γ) state). read_fp_reg r s = (s.fp_regs r :word64)
reg_imm_def_typed=(∀(r :num) (s :(α, β, γ) state). (reg_imm (Reg r :α reg_imm) s :α word_loc) = (read_reg r s :α word_loc)) ∧ ∀(w :α word) (s :(α, β, γ) state). (reg_imm (Imm w) s :α word_loc) = Word w
upd_fp_reg_def_typed=∀(r :num) (v :word64) (s :(α, β, γ) state). upd_fp_reg r v s = s with fp_regs := s.fp_regs⦇r ↦ v⦈
upd_mem_def_typed=∀(a :α word) (w :α word_loc) (s :(α, β, γ) state). upd_mem a w s = s with mem := s.mem⦇a ↦ w⦈
upd_pc_def_typed=∀(pc :num) (s :(α, β, γ) state). upd_pc pc s = s with pc := pc
upd_reg_def_typed=∀(r :num) (w :α word_loc) (s :(α, β, γ) state). upd_reg r w s = s with regs := s.regs⦇r ↦ w⦈
