arith_upd_def_typed=(∀(b :binop) (r1 :num) (r2 :num) (ri :α reg_imm) (s :(α, β, γ) state). arith_upd (Binop b r1 r2 ri) s = case ((read_reg r2 s :α word_loc),(reg_imm ri s :α word_loc)) of (Word w1,Word w2) => binop_upd r1 b w1 w2 s | ((Loc v12 v13 :α word_loc),Word w2) => if b = Or ∧ ri = (Reg r2 :α reg_imm) then upd_reg r1 (Loc v12 v13 :α word_loc) s else assert F s | (v,(Loc v6 v7 :α word_loc)) => if b = Or ∧ ri = (Reg r2 :α reg_imm) then upd_reg r1 v s else assert F s) ∧ (∀(l :ast$shift) (r1 :num) (r2 :num) (ri :α reg_imm) (s :(α, β, γ) state). arith_upd (Shift l r1 r2 ri :α arith) s = case ((read_reg r2 s :α word_loc),(reg_imm ri s :α word_loc)) of (Word w1,Word w2) => assert (w2n w2 < dimindex (:α)) (upd_reg r1 (Word (word_shift l w1 (w2n w2) :α word)) s) | (Word w1,(Loc v14 v15 :α word_loc)) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (s :(α, β, γ) state). arith_upd (Div r1 r2 r3 :α arith) s = case ((read_reg r3 s :α word_loc),(read_reg r2 s :α word_loc)) of (Word q,Word w2) => assert (q ≠ (0w :α word)) (upd_reg r1 (Word (w2 / q)) s) | (Word q,(Loc v14 v15 :α word_loc)) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :(α, β, γ) state). arith_upd (AddCarry r1 r2 r3 r4 :α arith) s = case ((read_reg r2 s :α word_loc),(read_reg r3 s :α word_loc),(read_reg r4 s :α word_loc)) of (Word w2,Word w3,Word w4) => (let (r :num) = w2n w2 + w2n w3 + if w4 = (0w :α word) then (0 :num) else (1 :num) in upd_reg r4 (Word (if dimword (:α) ≤ r then (1w :α word) else (0w :α word))) (upd_reg r1 (Word (n2w r :α word)) s)) | (Word w2,Word w3,(Loc v24 v25 :α word_loc)) => assert F s | (Word w2,(Loc v18 v19 :α word_loc),v13) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :(α, β, γ) state). arith_upd (LongMul r1 r2 r3 r4 :α arith) s = case ((read_reg r3 s :α word_loc),(read_reg r4 s :α word_loc)) of (Word w3,Word w4) => (let (r :num) = w2n w3 * w2n w4 in upd_reg r2 (Word (n2w r :α word)) (upd_reg r1 (Word (n2w (r DIV dimword (:α)) :α word)) s)) | (Word w3,(Loc v14 v15 :α word_loc)) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num) (s :(α, β, γ) state). arith_upd (LongDiv r1 r2 r3 r4 r5 :α arith) s = case ((read_reg r3 s :α word_loc),(read_reg r4 s :α word_loc),(read_reg r5 s :α word_loc)) of (Word w3,Word w4,Word w5) => (let (n :num) = w2n w3 * dimword (:α) + w2n w4; (d :num) = w2n w5; (q :num) = n DIV d in assert (d ≠ (0 :num) ∧ q < dimword (:α)) (upd_reg r1 (Word (n2w q :α word)) (upd_reg r2 (Word (n2w (n MOD d) :α word)) s))) | (Word w3,Word w4,(Loc v24 v25 :α word_loc)) => assert F s | (Word w3,(Loc v18 v19 :α word_loc),v13) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :(α, β, γ) state). arith_upd (AddOverflow r1 r2 r3 r4 :α arith) s = case ((read_reg r2 s :α word_loc),(read_reg r3 s :α word_loc)) of (Word w2,Word w3) => upd_reg r4 (Word (if w2i (w2 + w3) ≠ w2i w2 + w2i w3 then (1w :α word) else (0w :α word))) (upd_reg r1 (Word (w2 + w3)) s) | (Word w2,(Loc v14 v15 :α word_loc)) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ ∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (s :(α, β, γ) state). arith_upd (SubOverflow r1 r2 r3 r4 :α arith) s = case ((read_reg r2 s :α word_loc),(read_reg r3 s :α word_loc)) of (Word w2,Word w3) => upd_reg r4 (Word (if w2i (w2 − w3) ≠ w2i w2 − w2i w3 then (1w :α word) else (0w :α word))) (upd_reg r1 (Word (w2 − w3)) s) | (Word w2,(Loc v14 v15 :α word_loc)) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s
binop_upd_def_typed=(∀(r :num) (w1 :α word) (w2 :α word). (binop_upd r Add w1 w2 :(α, β, γ) state -> (α, β, γ) state) = (upd_reg r (Word (w1 + w2)) :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (w1 :α word) (w2 :α word). (binop_upd r Sub w1 w2 :(α, β, γ) state -> (α, β, γ) state) = (upd_reg r (Word (w1 − w2)) :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (w1 :α word) (w2 :α word). (binop_upd r And w1 w2 :(α, β, γ) state -> (α, β, γ) state) = (upd_reg r (Word (w1 && w2)) :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (w1 :α word) (w2 :α word). (binop_upd r Or w1 w2 :(α, β, γ) state -> (α, β, γ) state) = (upd_reg r (Word (w1 ‖ w2)) :(α, β, γ) state -> (α, β, γ) state)) ∧ ∀(r :num) (w1 :α word) (w2 :α word). (binop_upd r Xor w1 w2 :(α, β, γ) state -> (α, β, γ) state) = (upd_reg r (Word (w1 ⊕ w2)) :(α, β, γ) state -> (α, β, γ) state)
is_Label_def_typed=(is_Label (Label (v0 :num) (v1 :num) (v2 :num) :α line) ⇔ T) ∧ (is_Label (Asm (v6 :α asm_or_cbw) (v7 :word8 list) (v8 :num)) ⇔ F) ∧ (is_Label (LabAsm (v9 :α asm_with_lab) (v10 :α word) (v11 :word8 list) (v12 :num)) ⇔ F)
evaluate_def_typed=∀(s :(α, γ, 'ffi) state). (evaluate s :machine_result # (α, γ, 'ffi) state) = if s.clock = (0 :num) then (TimeOut,s) else case asm_fetch s of (NONE :α line option) => (Error,s) | SOME (Label v44 v45 v46 :α line) => (Error,s) | SOME (Asm (Asmi (Inst i :α asm)) v50 v51) => (let (s1 :(α, γ, 'ffi) state) = asm_inst i s in if s1.failed then (Error,s) else (evaluate (inc_pc (dec_clock s1)) :machine_result # (α, γ, 'ffi) state)) | SOME (Asm (Asmi (Jump v12 :α asm)) v50 v51) => (Error,s) | SOME (Asm (Asmi (JumpCmp v13 v14 v15 v16 :α asm)) v50 v51) => (Error,s) | SOME (Asm (Asmi (Call v17 :α asm)) v50 v51) => (Error,s) | SOME (Asm (Asmi (JumpReg r :α asm)) v50 v51) => (case (read_reg r s :α word_loc) of Word v3 => (Error,s) | (Loc n1 n2 :α word_loc) => case loc_to_pc n1 n2 s.code of (NONE :num option) => (Error,s) | SOME p => (evaluate (upd_pc p (dec_clock s)) :machine_result # (α, γ, 'ffi) state)) | SOME (Asm (Asmi (Loc v19 v20 :α asm)) v50 v51) => (Error,s) | SOME (Asm (Cbw r1 r2 :α asm_or_cbw) v50 v51) => (case ((read_reg r1 s :α word_loc),(read_reg r2 s :α word_loc)) of (Word w1,Word w2) => (case buffer_write s.code_buffer w1 (w2w w2 :word8) of (NONE :(α, 8) buffer option) => (Error,s) | SOME new_cb => (evaluate (inc_pc (dec_clock (s with code_buffer := new_cb))) :machine_result # (α, γ, 'ffi) state)) | (Word w1,(Loc v14 v15 :α word_loc)) => (Error,s) | ((Loc v8 v9 :α word_loc),v3) => (Error,s)) | SOME (Asm (ShareMem m r ad) v50 v51) => (case share_mem_op m r ad s of (NONE :('ffi ffi_result # (α, γ, 'ffi) state) option) => (Error,s) | SOME (FFI_return v3 v4,s') => (evaluate (s' with <|io_regs := shift_seq (1 :num) s'.io_regs; io_fp_regs := shift_seq (1 :num) s'.io_fp_regs|>) :machine_result # (α, γ, 'ffi) state) | SOME ((FFI_final outcome :'ffi ffi_result),s') => ((Halt (FFI_outcome outcome) :machine_result),s')) | SOME (LabAsm (Jump l :α asm_with_lab) v53 v54 v55) => (case get_pc_value l s of (NONE :num option) => (Error,s) | SOME p => (evaluate (upd_pc p (dec_clock s)) :machine_result # (α, γ, 'ffi) state)) | SOME (LabAsm (JumpCmp c r'' ri l' :α asm_with_lab) v53 v54 v55) => (case (word_cmp c (read_reg r'' s :α word_loc) (reg_imm ri s :α word_loc) :bool option) of (NONE :bool option) => (Error,s) | SOME T => (case get_pc_value l' s of (NONE :num option) => (Error,s) | SOME p => (evaluate (upd_pc p (dec_clock s)) :machine_result # (α, γ, 'ffi) state)) | SOME F => (evaluate (inc_pc (dec_clock s)) :machine_result # (α, γ, 'ffi) state)) | SOME (LabAsm (Call l'' :α asm_with_lab) v53 v54 v55) => (case get_pc_value l'' s of (NONE :num option) => (Error,s) | SOME p => case (get_ret_Loc s :α word_loc option) of (NONE :α word_loc option) => (Error,s) | SOME k => (let (s1 :(α, γ, 'ffi) state) = upd_reg s.link_reg k s in (evaluate (upd_pc p (dec_clock s1)) :machine_result # (α, γ, 'ffi) state))) | SOME (LabAsm (LocValue r' lab :α asm_with_lab) v53 v54 v55) => if get_pc_value lab s = (NONE :num option) then (Error,s) else (let (s1 :(α, γ, 'ffi) state) = upd_reg r' (lab_to_loc lab :α word_loc) s in (evaluate (inc_pc (dec_clock s1)) :machine_result # (α, γ, 'ffi) state)) | SOME (LabAsm (CallFFI ffi_index :α asm_with_lab) v53 v54 v55) => (case ((read_reg s.len_reg s :α word_loc),(read_reg s.ptr_reg s :α word_loc),(read_reg s.len2_reg s :α word_loc),(read_reg s.ptr2_reg s :α word_loc),(read_reg s.link_reg s :α word_loc)) of (Word w,Word w2,Word w3,v36,Word v41) => (Error,s) | (Word w,Word w2,Word w3,Word w4,(Loc n1 n2 :α word_loc)) => (case (read_bytearray w2 (w2n w) (mem_load_byte_aux s.mem s.mem_domain s.be),read_bytearray w4 (w2n w3) (mem_load_byte_aux s.mem s.mem_domain s.be),loc_to_pc n1 n2 s.code) of ((NONE :word8 list option),v3) => (Error,s) | (SOME bytes,(NONE :word8 list option),v9) => (Error,s) | (SOME bytes,SOME bytes2,(NONE :num option)) => (Error,s) | (SOME bytes,SOME bytes2,SOME new_pc) => case call_FFI s.ffi (ExtCall ffi_index) bytes bytes2 of FFI_return new_ffi new_bytes => (let (new_io_regs :num -> ffiname -> num -> α word option) = shift_seq (1 :num) s.io_regs; (new_io_fp_regs :num -> num -> word64) = shift_seq (1 :num) s.io_fp_regs; (new_m :α word -> α word_loc) = write_bytearray w4 new_bytes s.mem s.mem_domain s.be in (evaluate (s with <|mem := new_m; ffi := new_ffi; io_regs := new_io_regs; io_fp_regs := new_io_fp_regs; regs := (λ(a :num). get_reg_value (s.io_regs (0 :num) (ExtCall ffi_index) a) (read_reg a s :α word_loc) (Word :α word -> α word_loc)); fp_regs := (λ(n :num). s.io_fp_regs (0 :num) n); pc := new_pc; clock := s.clock − (1 :num)|>) :machine_result # (α, γ, 'ffi) state)) | (FFI_final outcome :'ffi ffi_result) => ((Halt (FFI_outcome outcome) :machine_result),s)) | (Word w,Word w2,Word w3,(Loc v48 v49 :α word_loc),(Loc n1 n2 :α word_loc)) => (Error,s) | (Word w,Word w2,(Loc v32 v33 :α word_loc),v27) => (Error,s) | (Word w,(Loc v22 v23 :α word_loc),v17) => (Error,s) | ((Loc v12 v13 :α word_loc),v5) => (Error,s)) | SOME (LabAsm (Install :α asm_with_lab) v53 v54 v55) => (case ((read_reg s.ptr_reg s :α word_loc),(read_reg s.len_reg s :α word_loc),(read_reg s.link_reg s :α word_loc)) of (Word w1,v21,Word v26) => (Error,s) | (Word w1,Word w2,(Loc n1 n2 :α word_loc)) => (case ((buffer_flush s.code_buffer w1 w2 :(word8 list # (α, 8) buffer) option),loc_to_pc n1 n2 s.code) of ((NONE :(word8 list # (α, 8) buffer) option),v5) => (Error,s) | (SOME v10,(NONE :num option)) => (Error,s) | (SOME (bytes,cb),SOME new_pc) => (let ((cfg :γ),(prog :α sec list)) = (s.compile_oracle (0 :num) :γ # α sec list); (new_oracle :num -> γ # α sec list) = shift_seq (1 :num) s.compile_oracle in case ((s.compile cfg prog :(word8 list # γ) option),prog) of (v2,([] :α sec list)) => (Error,s) | ((NONE :(word8 list # γ) option),v6::v7) => (Error,s) | (SOME (bytes',cfg'),Section k v17::v7) => if bytes = bytes' ∧ FST (new_oracle (0 :num)) = cfg' then (evaluate (s with <|pc := new_pc; code_buffer := cb; code := s.code ++ prog; cc_regs := shift_seq (1 :num) s.cc_regs; cc_fp_regs := shift_seq (1 :num) s.cc_fp_regs; regs := (λ(a :num). get_reg_value (s.cc_regs (0 :num) a) (read_reg a s :α word_loc) (Word :α word -> α word_loc))⦇s.ptr_reg ↦ (Loc k (0 :num) :α word_loc)⦈; fp_regs := (λ(n :num). s.cc_fp_regs (0 :num) n); compile_oracle := new_oracle; clock := s.clock − (1 :num)|>) :machine_result # (α, γ, 'ffi) state) else (Error,s))) | (Word w1,(Loc v33 v34 :α word_loc),(Loc n1 n2 :α word_loc)) => (Error,s) | ((Loc v16 v18 :α word_loc),v11) => (Error,s)) | SOME (LabAsm (Halt :α asm_with_lab) v53 v54 v55) => case (read_reg s.ptr_reg s :α word_loc) of Word (0w :α word) => ((Halt Success :machine_result),s) | Word v6 => ((Halt Resource_limit_hit :machine_result),s) | (Loc v4 v5 :α word_loc) => (Error,s)
fp_upd_def_typed=(∀(r :num) (d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPLess r d1 d2) s = upd_reg r (Word (if fp64_lessThan (read_fp_reg d1 s) (read_fp_reg d2 s) then (1w :α word) else (0w :α word))) s) ∧ (∀(r :num) (d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPLessEqual r d1 d2) s = upd_reg r (Word (if fp64_lessEqual (read_fp_reg d1 s) (read_fp_reg d2 s) then (1w :α word) else (0w :α word))) s) ∧ (∀(r :num) (d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPEqual r d1 d2) s = upd_reg r (Word (if fp64_equal (read_fp_reg d1 s) (read_fp_reg d2 s) then (1w :α word) else (0w :α word))) s) ∧ (∀(d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPMov d1 d2) s = upd_fp_reg d1 (read_fp_reg d2 s) s) ∧ (∀(d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPAbs d1 d2) s = upd_fp_reg d1 (fp64_abs (read_fp_reg d2 s)) s) ∧ (∀(d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPNeg d1 d2) s = upd_fp_reg d1 (fp64_negate (read_fp_reg d2 s)) s) ∧ (∀(d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPSqrt d1 d2) s = upd_fp_reg d1 (fp64_sqrt roundTiesToEven (read_fp_reg d2 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :(α, γ, 'ffi) state). fp_upd (FPAdd d1 d2 d3) s = upd_fp_reg d1 (fp64_add roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :(α, γ, 'ffi) state). fp_upd (FPSub d1 d2 d3) s = upd_fp_reg d1 (fp64_sub roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :(α, γ, 'ffi) state). fp_upd (FPMul d1 d2 d3) s = upd_fp_reg d1 (fp64_mul roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :(α, γ, 'ffi) state). fp_upd (FPDiv d1 d2 d3) s = upd_fp_reg d1 (fp64_div roundTiesToEven (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (s :(α, γ, 'ffi) state). fp_upd (FPFma d1 d2 d3) s = upd_fp_reg d1 (fpfma (read_fp_reg d1 s) (read_fp_reg d2 s) (read_fp_reg d3 s)) s) ∧ (∀(r1 :num) (r2 :num) (d :num) (s :(α, γ, 'ffi) state). fp_upd (FPMovToReg r1 r2 d) s = if dimindex (:α) = (64 :num) then upd_reg r1 (Word (w2w (read_fp_reg d s) :α word)) s else (let (v :word64) = read_fp_reg d s in upd_reg r2 (Word (((63 :num) >< (32 :num)) v :α word)) (upd_reg r1 (Word (((31 :num) >< (0 :num)) v :α word)) s))) ∧ (∀(d :num) (r1 :num) (r2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPMovFromReg d r1 r2) s = if dimindex (:α) = (64 :num) then case (read_reg r1 s :α word_loc) of Word w1 => upd_fp_reg d (w2w w1 :word64) s | (Loc v4 v5 :α word_loc) => assert F s else case ((read_reg r1 s :α word_loc),(read_reg r2 s :α word_loc)) of (Word w1,Word w2) => upd_fp_reg d ((w2 @@ w1) :word64) s | (Word w1,(Loc v14 v15 :α word_loc)) => assert F s | ((Loc v8 v9 :α word_loc),v3) => assert F s) ∧ (∀(d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPToInt d1 d2) s = case fp64_to_int roundTiesToEven (read_fp_reg d2 s) of (NONE :int option) => assert F s | SOME i => (let (w :word32) = (i2w i :word32) in ((if dimindex (:α) = (64 :num) then upd_fp_reg d1 (w2w w :word64) else (let ((h :num),(l :num)) = if ODD d1 then ((63 :num),(32 :num)) else ((31 :num),(0 :num)) in upd_fp_reg (d1 DIV (2 :num)) (bit_field_insert h l w (read_fp_reg (d1 DIV (2 :num)) s)))) (assert (w2i w = i) s) :(α, γ, 'ffi) state))) ∧ ∀(d1 :num) (d2 :num) (s :(α, γ, 'ffi) state). fp_upd (FPFromInt d1 d2) s = (let (i :int) = if dimindex (:α) = (64 :num) then w2i (((31 :num) >< (0 :num)) (read_fp_reg d2 s) :word32) else (let (v :word64) = read_fp_reg (d2 DIV (2 :num)) s in w2i (if ODD d2 then (((63 :num) >< (32 :num)) v :α word) else (((31 :num) >< (0 :num)) v :α word))) in upd_fp_reg d1 (int_to_fp64 roundTiesToEven i) s)
asm_inst_def_typed=(∀(s :(α, γ, 'ffi) state). asm_inst (Skip :α inst) s = s) ∧ (∀(r :num) (imm :α word) (s :(α, γ, 'ffi) state). asm_inst (Const r imm :α inst) s = upd_reg r (Word imm) s) ∧ (∀(x :α arith) (s :(α, γ, 'ffi) state). asm_inst (Arith x :α inst) s = arith_upd x s) ∧ (∀(m :memop) (r :num) (a :α addr) (s :(α, γ, 'ffi) state). asm_inst (Mem m r a) s = mem_op m r a s) ∧ ∀(fp :fp) (s :(α, γ, 'ffi) state). asm_inst (FP fp :α inst) s = fp_upd fp s
asm_inst_consts_typed=(asm_inst (i :α inst) (s :(α, β, γ) state)).pc = s.pc ∧ (asm_inst i s).code = s.code ∧ (asm_inst i s).clock = s.clock ∧ (asm_inst i s).ffi = s.ffi ∧ (asm_inst i s).io_regs = s.io_regs ∧ (asm_inst i s).io_fp_regs = s.io_fp_regs ∧ (asm_inst i s).cc_regs = s.cc_regs ∧ (asm_inst i s).cc_fp_regs = s.cc_fp_regs ∧ (asm_inst i s).ptr_reg = s.ptr_reg ∧ (asm_inst i s).len_reg = s.len_reg ∧ (asm_inst i s).ptr2_reg = s.ptr2_reg ∧ (asm_inst i s).len2_reg = s.len2_reg ∧ (asm_inst i s).link_reg = s.link_reg
addr_def_typed=∀(r :num) (offset :α word) (s :(α, β, γ) state). (addr (Addr r offset) s :α word option) = case (read_reg r s :α word_loc) of Word w => SOME (w + offset) | (Loc v4 v5 :α word_loc) => (NONE :α word option)
mem_load_def_typed=∀(r :num) (a :α addr) (s :(α, γ, 'ffi) state). (mem_load r a s :(α, γ, 'ffi) state) = case (addr a s :α word option) of (NONE :α word option) => assert F s | SOME w => assert (w2n w MOD (dimindex (:α) DIV (8 :num)) = (0 :num) ∧ w ∈ s.mem_domain) (upd_reg r (s.mem w :α word_loc) s)
mem_load32_def_typed=∀(r :num) (a :α addr) (s :(α, γ, 'ffi) state). mem_load32 r a s = case (addr a s :α word option) of (NONE :α word option) => assert F s | SOME w => case mem_load_32 s.mem s.mem_domain s.be w of (NONE :word32 option) => assert F s | SOME v => upd_reg r (Word (w2w v :α word)) s
mem_load_byte_def_typed=∀(r :num) (a :α addr) (s :(α, γ, 'ffi) state). mem_load_byte r a s = case (addr a s :α word option) of (NONE :α word option) => assert F s | SOME w => case mem_load_byte_aux s.mem s.mem_domain s.be w of (NONE :word8 option) => assert F s | SOME v => upd_reg r (Word (w2w v :α word)) s
mem_op_def_typed=(∀(r :num) (a :α addr). (mem_op Load r a :(α, β, γ) state -> (α, β, γ) state) = (mem_load r a :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (a :α addr). (mem_op Store r a :(α, β, γ) state -> (α, β, γ) state) = (mem_store r a :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (a :α addr). (mem_op Load32 r a :(α, β, γ) state -> (α, β, γ) state) = (mem_load32 r a :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (a :α addr). (mem_op Store32 r a :(α, β, γ) state -> (α, β, γ) state) = (mem_store32 r a :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (a :α addr). (mem_op Load8 r a :(α, β, γ) state -> (α, β, γ) state) = (mem_load_byte r a :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (a :α addr). (mem_op Store8 r a :(α, β, γ) state -> (α, β, γ) state) = (mem_store_byte r a :(α, β, γ) state -> (α, β, γ) state)) ∧ (∀(r :num) (a :α addr). (mem_op Load16 r a :(α, β, γ) state -> (α, β, γ) state) = (assert F :(α, β, γ) state -> (α, β, γ) state)) ∧ ∀(r :num) (a :α addr). (mem_op Store16 r a :(α, β, γ) state -> (α, β, γ) state) = (assert F :(α, β, γ) state -> (α, β, γ) state)
mem_store_def_typed=∀(r :num) (a :α addr) (s :(α, γ, 'ffi) state). (mem_store r a s :(α, γ, 'ffi) state) = case (addr a s :α word option) of (NONE :α word option) => assert F s | SOME w => assert (w2n w MOD (dimindex (:α) DIV (8 :num)) = (0 :num) ∧ w ∈ s.mem_domain) (upd_mem w (read_reg r s :α word_loc) s)
mem_store32_def_typed=∀(r :num) (a :α addr) (s :(α, γ, 'ffi) state). mem_store32 r a s = case (addr a s :α word option) of (NONE :α word option) => assert F s | SOME w => case (read_reg r s :α word_loc) of Word b => (case mem_store_32 s.mem s.mem_domain s.be w (w2w b :word32) of (NONE :(α word -> α word_loc) option) => assert F s | SOME m => s with mem := m) | (Loc v4 v5 :α word_loc) => assert F s
mem_store_byte_def_typed=∀(r :num) (a :α addr) (s :(α, γ, 'ffi) state). mem_store_byte r a s = case (addr a s :α word option) of (NONE :α word option) => assert F s | SOME w => case (read_reg r s :α word_loc) of Word b => (case mem_store_byte_aux s.mem s.mem_domain s.be w (w2w b :word8) of (NONE :(α word -> α word_loc) option) => assert F s | SOME m => s with mem := m) | (Loc v4 v5 :α word_loc) => assert F s
asm_code_length_def_typed=asm_code_length ([] :α sec list) = (0 :num) ∧ (∀(xs :α sec list) (k :num). asm_code_length (Section k ([] :α line list)::xs) = asm_code_length xs) ∧ ∀(ys :α line list) (y :α line) (xs :α sec list) (k :num). asm_code_length (Section k (y::ys)::xs) = asm_code_length (Section k ys::xs) + if is_Label y then (0 :num) else (1 :num)
asm_fetch_def_typed=∀(s :(α, β, γ) state). asm_fetch s = asm_fetch_aux s.pc s.code
asm_fetch_aux_def_typed=(∀(pos :num). asm_fetch_aux pos ([] :α sec list) = (NONE :α line option)) ∧ (∀(xs :α sec list) (pos :num) (k :num). asm_fetch_aux pos (Section k ([] :α line list)::xs) = asm_fetch_aux pos xs) ∧ ∀(ys :α line list) (y :α line) (xs :α sec list) (pos :num) (k :num). asm_fetch_aux pos (Section k (y::ys)::xs) = if is_Label y then asm_fetch_aux pos (Section k ys::xs) else if pos = (0 :num) then SOME y else asm_fetch_aux (pos − (1 :num)) (Section k ys::xs)
get_lab_after_def_typed=(∀(pos :num). (get_lab_after pos ([] :β sec list) :α word_loc option) = (NONE :α word_loc option)) ∧ (∀(xs :β sec list) (pos :num) (k :num). (get_lab_after pos (Section k ([] :β line list)::xs) :α word_loc option) = (get_lab_after pos xs :α word_loc option)) ∧ ∀(ys :β line list) (y :β line) (xs :β sec list) (pos :num) (k :num). (get_lab_after pos (Section k (y::ys)::xs) :α word_loc option) = if is_Label y then (get_lab_after pos (Section k ys::xs) :α word_loc option) else if pos = (0 :num) then (next_label (Section k ys::xs) :α word_loc option) else (get_lab_after (pos − (1 :num)) (Section k ys::xs) :α word_loc option)
get_pc_value_def_typed=∀(lab :lab) (s :(α, γ, 'ffi) state). get_pc_value lab s = case lab of Lab n1 n2 => loc_to_pc n1 n2 s.code
get_ret_Loc_def_typed=∀(s :(β, γ, δ) state). (get_ret_Loc s :α word_loc option) = (get_lab_after s.pc s.code :α word_loc option)
lab_to_loc_def_typed=∀(n1 :num) (n2 :num). (lab_to_loc (Lab n1 n2) :α word_loc) = (Loc n1 n2 :α word_loc)
loc_to_pc_def_typed=(∀(n2 :num) (n1 :num). loc_to_pc n1 n2 ([] :α sec list) = (NONE :num option)) ∧ ∀(ys :α sec list) (xs :α line list) (n2 :num) (n1 :num) (k :num). loc_to_pc n1 n2 (Section k xs::ys) = if k = n1 ∧ n2 = (0 :num) then SOME (0 :num) else case xs of ([] :α line list) => loc_to_pc n1 n2 ys | z::zs => if (∃(k :num). z = (Label n1 n2 k :α line)) ∧ n2 ≠ (0 :num) then SOME (0 :num) else if is_Label z then loc_to_pc n1 n2 (Section k zs::ys) else case loc_to_pc n1 n2 (Section k zs::ys) of (NONE :num option) => (NONE :num option) | SOME pos' => SOME (pos' + (1 :num))
next_label_def_typed=(next_label ([] :β sec list) :α word_loc option) = (NONE :α word_loc option) ∧ (∀(xs :β sec list) (k :num). (next_label (Section k ([] :β line list)::xs) :α word_loc option) = (next_label xs :α word_loc option)) ∧ (∀(ys :β line list) (xs :β sec list) (v0 :num) (n2 :num) (n1 :num) (k :num). (next_label (Section k ((Label n1 n2 v0 :β line)::ys)::xs) :α word_loc option) = SOME (Loc n1 n2 :α word_loc)) ∧ (∀(ys :β line list) (xs :β sec list) (v9 :β asm_or_cbw) (v11 :num) (v10 :word8 list) (k :num). (next_label (Section k (Asm v9 v10 v11::ys)::xs) :α word_loc option) = (next_label (Section k ys::xs) :α word_loc option)) ∧ ∀(ys :β line list) (xs :β sec list) (v15 :num) (v14 :word8 list) (v13 :β word) (v12 :β asm_with_lab) (k :num). (next_label (Section k (LabAsm v12 v13 v14 v15::ys)::xs) :α word_loc option) = (next_label (Section k ys::xs) :α word_loc option)
semantics_def_typed=∀(s :(α, β, γ) state). (semantics s :behaviour) = if ∃(k :num). FST (evaluate (s with clock := k) :machine_result # (α, β, γ) state) = Error then Fail else case some(res :behaviour). ∃(k :num) (t :(α, β, γ) state) (outcome :outcome). (evaluate (s with clock := k) :machine_result # (α, β, γ) state) = ((Halt outcome :machine_result),t) ∧ res = Terminate outcome t.ffi.io_events of (NONE :behaviour option) => Diverge (LUB (IMAGE (λ(k :num). (fromList (SND (evaluate (s with clock := k) :machine_result # (α, β, γ) state)).ffi.io_events :io_event llist)) 𝕌(:num))) | SOME res => res
share_mem_load_def_typed=∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state) (n :num). share_mem_load r ad s n = case (addr ad s :α word option) of (NONE :α word option) => (NONE :('ffi ffi_result # (α, γ, 'ffi) state) option) | SOME v => if if n = (0 :num) then w2n v MOD (dimindex (:α) DIV (8 :num)) = (0 :num) ∧ v ∈ s.shared_mem_domain else byte_align v ∈ s.shared_mem_domain then case call_FFI s.ffi (SharedMem MappedRead) [(n2w n :word8)] (word_to_bytes v F) of FFI_return new_ffi new_bytes => SOME (FFI_return new_ffi new_bytes,s with <|ffi := new_ffi; regs := s.regs⦇r ↦ Word (word_of_bytes F (0w :α word) new_bytes)⦈; pc := s.pc + (1 :num); clock := s.clock − (1 :num)|>) | (FFI_final outcome :'ffi ffi_result) => SOME ((FFI_final outcome :'ffi ffi_result),s) else (NONE :('ffi ffi_result # (α, γ, 'ffi) state) option)
share_mem_op_def_typed=(∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Load r ad s = share_mem_load r ad s (0 :num)) ∧ (∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Load8 r ad s = share_mem_load r ad s (1 :num)) ∧ (∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Load16 r ad s = share_mem_load r ad s (2 :num)) ∧ (∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Store r ad s = share_mem_store r ad s (0 :num)) ∧ (∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Store8 r ad s = share_mem_store r ad s (1 :num)) ∧ (∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Store16 r ad s = share_mem_store r ad s (2 :num)) ∧ (∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Load32 r ad s = share_mem_load r ad s (4 :num)) ∧ ∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state). share_mem_op Store32 r ad s = share_mem_store r ad s (4 :num)
share_mem_store_def_typed=∀(r :num) (ad :α addr) (s :(α, γ, 'ffi) state) (n :num). share_mem_store r ad s n = case (read_reg r s :α word_loc) of Word w => (case (addr ad s :α word option) of (NONE :α word option) => (NONE :('ffi ffi_result # (α, γ, 'ffi) state) option) | SOME v => if if n = (0 :num) then w2n v MOD (dimindex (:α) DIV (8 :num)) = (0 :num) ∧ v ∈ s.shared_mem_domain else byte_align v ∈ s.shared_mem_domain then case call_FFI s.ffi (SharedMem MappedWrite) [(n2w n :word8)] ((if n = (0 :num) then word_to_bytes w F else TAKE n (word_to_bytes w F)) ++ word_to_bytes v F) of FFI_return new_ffi new_bytes => SOME (FFI_return new_ffi new_bytes,inc_pc (dec_clock (s with ffi := new_ffi))) | (FFI_final outcome :'ffi ffi_result) => SOME ((FFI_final outcome :'ffi ffi_result),s) else (NONE :('ffi ffi_result # (α, γ, 'ffi) state) option)) | (Loc v5 v6 :α word_loc) => (NONE :('ffi ffi_result # (α, γ, 'ffi) state) option)
