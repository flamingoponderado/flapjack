reg_bound_comp_statement=∀i p. (reg_bound (comp i p) s ⇔ reg_bound p s) ∧ (reg_bound (comp_top i p) s ⇔ reg_bound p s)
stack_rawcall_reg_bound_statement=EVERY (λp. reg_bound p sp) (MAP SND (compile prog1)) ⇔ EVERY (λp. reg_bound p sp) (MAP SND prog1)
call_args_comp_statement=∀i p. (call_args (comp i p) r1 r2 r3 r4 r5 ⇔ call_args p r1 r2 r3 r4 r5) ∧ (call_args (comp_top i p) r1 r2 r3 r4 r5 ⇔ call_args p r1 r2 r3 r4 r5)
stack_alloc_call_args_statement=EVERY (λp. call_args p 1 2 3 4 0) (MAP SND (compile prog1)) ⇔ EVERY (λp. call_args p 1 2 3 4 0) (MAP SND prog1)
MAP_FST_compile_statement=MAP FST (compile code) = MAP FST code
call_arg_comp_statement=∀i p. (alloc_arg (comp i p) ⇔ alloc_arg p) ∧ (alloc_arg (comp_top i p) ⇔ alloc_arg p)
