clock_mono_check=⊢ ((s :α state).clock ≠ (0 :num) ⇒ is_clock_io_mono (λ(s :α state). (f :α state -> α state # (β, γ) result) (adj_clock (1 :num) (0 :num) s)) (dec_clock s)) ⇒ is_clock_io_mono (λ(s :α state). if s.clock = (0 :num) then (s,(Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result)) else f s) s
clock_mono_type=:(α state -> α state # (β, γ) result) -> α state -> bool
clock_mono_def=⊢ ∀(f :α state -> α state # (β, γ) result) (s :α state). is_clock_io_mono f s ⇔ case f s of (s',r) => io_events_mono s.ffi s'.ffi ∧ s'.clock ≤ s.clock ∧ s.next_type_stamp ≤ s'.next_type_stamp ∧ s.next_exn_stamp ≤ s'.next_exn_stamp ∧ LENGTH s.refs ≤ LENGTH s'.refs ∧ ∀(clk :num). case f (s with clock := clk) of (s'',r') => (r' ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ r' = r ∧ s'' = s' with clock := clk − (s.clock − s'.clock)) ∧ (r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ (clk ≥ s.clock − s'.clock ⇔ r' ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result))) ∧ (r' ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ clk ≤ s.clock ⇒ r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result)) ∧ (clk ≤ s.clock ⇒ io_events_mono s''.ffi s'.ffi)
clock_mono_return=⊢ is_clock_io_mono (λ(s :α state). (s,(Rval (r :β) :(β, γ) result))) (s :α state)
clock_mono_err=⊢ is_clock_io_mono (λ(s :α state). (s,(Rerr (r :γ error_result) :(β, γ) result))) (s :α state)
clock_mono_cong=⊢ (s :α state) = (t :α state) ⇒ (∀(s :α state). s.eval_state = t.eval_state ∧ s.refs = t.refs ∧ s.ffi = t.ffi ⇒ (f :α state -> α state # (β, γ) result) s = (g :α state -> α state # (β, γ) result) s) ⇒ (is_clock_io_mono f s ⇔ is_clock_io_mono g t)
clock_mono_extra=⊢ (∀(s :α state). is_clock_io_mono (f :α state -> α state # (β, γ) result) s) ⇒ f (s :α state) = ((s' :α state),(r :(β, γ) result)) ∧ r ≠ (Rerr (Rabort Rtimeout_error :γ error_result) :(β, γ) result) ⇒ f (s with clock := s.clock + (extra :num)) = (s' with clock := s'.clock + extra,r)
clock_mono_extra_mono=⊢ (∀(s :α state). is_clock_io_mono (f :α state -> α state # (β, γ) result) s) ⇒ io_events_mono (FST (f (s :α state))).ffi (FST (f (s with clock := s.clock + (extra :num)))).ffi
adj_clock=⊢ ∀(inc :num) (dec :num) (s :α state). adj_clock inc dec s = s with clock := s.clock + inc − dec
dec_inc_clock=⊢ dec_clock (adj_clock (1 :num) (0 :num) (s :α state)) = s
evaluate_call_ffi_imp=⊢ (∀(s :α state) (e :v sem_env) (p :exp list) (s' :α state) (r :(v list, v) result). evaluate s e p = (s',r) ⇒ (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s.ffi s'.ffi) ∧ (∀(s :β state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v) (s' :β state) (r :(v list, v) result). evaluate_match s e v pes errv = (s',r) ⇒ (call_FFI_rel :β ffi_state -> β ffi_state -> bool)꙳ s.ffi s'.ffi) ∧ ∀(s :γ state) (e :v sem_env) (p :dec list) (s' :γ state) (r :(v sem_env, v) result). evaluate_decs s e p = (s',r) ⇒ (call_FFI_rel :γ ffi_state -> γ ffi_state -> bool)꙳ s.ffi s'.ffi
evaluate_decs_call_ffi_imp=⊢ ∀(s :α state) (e :v sem_env) (p :dec list) (s' :α state) (r :(v sem_env, v) result). evaluate_decs s e p = (s',r) ⇒ (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s.ffi s'.ffi
evaluate_io_mono=⊢ (∀(s :'ffi state) (e :v sem_env) (exp :exp list). io_events_mono s.ffi (FST (evaluate s e exp)).ffi) ∧ (∀(s :'ffi state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v). io_events_mono s.ffi (FST (evaluate_match s e v pes errv)).ffi) ∧ ∀(s :α state) (e :v sem_env) (d :dec list). io_events_mono s.ffi (FST (evaluate_decs s e d)).ffi
evaluate_io_mono_imp=⊢ (∀(s :α state) (e :v sem_env) (p :exp list) (s' :α state) (r :(v list, v) result). evaluate s e p = (s',r) ⇒ io_events_mono s.ffi s'.ffi) ∧ (∀(s :β state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v) (s' :β state) (r :(v list, v) result). evaluate_match s e v pes errv = (s',r) ⇒ io_events_mono s.ffi s'.ffi) ∧ ∀(s :γ state) (e :v sem_env) (p :dec list) (s' :γ state) (r :(v sem_env, v) result). evaluate_decs s e p = (s',r) ⇒ io_events_mono s.ffi s'.ffi
evaluate_call_ffi=⊢ (∀(s :'ffi state) (e :v sem_env) (exp :exp list). (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s.ffi (FST (evaluate s e exp)).ffi) ∧ (∀(s :'ffi state) (e :v sem_env) (v :v) (pes :(pat # exp) list) (errv :v). (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s.ffi (FST (evaluate_match s e v pes errv)).ffi) ∧ ∀(s :'ffi state) (e :v sem_env) (ds :dec list). (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s.ffi (FST (evaluate_decs s e ds)).ffi
do_app_io_mono=⊢ do_app ((r :v store_v list),(ffi :α ffi_state)) (op :op) (vs :v list) = SOME (((r' :v store_v list),(ffi' :α ffi_state)),(res :(v, v) result)) ⇒ io_events_mono ffi ffi'
do_app_call_ffi=⊢ do_app ((r :v store_v list),(ffi :α ffi_state)) (op :op) (vs :v list) = SOME (((r' :v store_v list),(ffi' :α ffi_state)),(res :(v, v) result)) ⇒ (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ ffi ffi'
call_length=⊢ call_FFI (st :α ffi_state) (index :ffiname) (conf :word8 list) (x :word8 list) = FFI_return (new_st :α ffi_state) (new_bytes :word8 list) ⇒ LENGTH x = LENGTH new_bytes
mono_definition=⊢ ∀(s1 :α ffi_state) (s2 :α ffi_state). io_events_mono s1 s2 ⇔ s1.io_events ≼ s2.io_events ∧ (s2.io_events = s1.io_events ⇒ s2 = s1)
mono_refl=⊢ io_events_mono (ffi :α ffi_state) ffi
mono_trans=⊢ io_events_mono (ffi1 :α ffi_state) (ffi2 :α ffi_state) ∧ io_events_mono ffi2 (ffi3 :α ffi_state) ⇒ io_events_mono ffi1 ffi3
mono_antisym=⊢ io_events_mono (s1 :α ffi_state) (s2 :α ffi_state) ∧ io_events_mono s2 s1 ⇒ s1 = s2
call_consts=⊢ call_FFI_rel (s1 :α ffi_state) (s2 :α ffi_state) ⇒ s2.oracle = s1.oracle
rtc_consts=⊢ ∀(s1 :α ffi_state) (s2 :α ffi_state). (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s1 s2 ⇒ s2.oracle = s1.oracle
rtc_mono=⊢ ∀(s1 :α ffi_state) (s2 :α ffi_state). (call_FFI_rel :α ffi_state -> α ffi_state -> bool)꙳ s1 s2 ⇒ io_events_mono s1 s2
