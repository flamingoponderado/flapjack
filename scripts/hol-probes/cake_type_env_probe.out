freevars=⊢ (∀(tvs :mlstring list) (tv :mlstring) (dbmax :num). check_freevars dbmax tvs (Tvar tv) ⇔ MEM tv tvs) ∧ (∀(tvs :mlstring list) (ts :t list) (tn :num) (dbmax :num). check_freevars dbmax tvs (Tapp ts tn) ⇔ EVERY (λ(a :t). check_freevars dbmax tvs a) ts) ∧ ∀(tvs :mlstring list) (n :num) (dbmax :num). check_freevars dbmax tvs (Tvar_db n) ⇔ n < dbmax
freevars_ast=⊢ (∀(tvs :mlstring list) (tv :mlstring). check_freevars_ast tvs (Atvar tv) ⇔ MEM tv tvs) ∧ (∀(tvs :mlstring list) (ts :ast_t list). check_freevars_ast tvs (Attup ts) ⇔ EVERY (λ(a :ast_t). check_freevars_ast tvs a) ts) ∧ (∀(tvs :mlstring list) (t2 :ast_t) (t1 :ast_t). check_freevars_ast tvs (Atfun t1 t2) ⇔ check_freevars_ast tvs t1 ∧ check_freevars_ast tvs t2) ∧ ∀(tvs :mlstring list) (ts :ast_t list) (tn :(mlstring, mlstring) id). check_freevars_ast tvs (Atapp ts tn) ⇔ EVERY (λ(a :ast_t). check_freevars_ast tvs a) ts
db_inc=⊢ (∀(tv :mlstring) (skip :num) (n :num). deBruijn_inc skip n (Tvar tv) = Tvar tv) ∧ (∀(skip :num) (n :num) (m :num). deBruijn_inc skip n (Tvar_db m) = if m < skip then Tvar_db m else Tvar_db (m + n)) ∧ ∀(ts :t list) (tn :num) (skip :num) (n :num). deBruijn_inc skip n (Tapp ts tn) = Tapp (MAP (λ(a :t). deBruijn_inc skip n a) ts) tn
db_subst=⊢ (∀(tv :mlstring) (ts :t list) (skip :num). deBruijn_subst skip ts (Tvar tv) = Tvar tv) ∧ (∀(ts :t list) (skip :num) (n :num). deBruijn_subst skip ts (Tvar_db n) = if ¬(n < skip) ∧ n < LENGTH ts + skip then ts❲n − skip❳ else if ¬(n < skip) then Tvar_db (n − LENGTH ts) else Tvar_db n) ∧ ∀(ts' :t list) (ts :t list) (tn :num) (skip :num). deBruijn_subst skip ts (Tapp ts' tn) = Tapp (MAP (λ(a :t). deBruijn_subst skip ts a) ts') tn
bind_tvar=⊢ ∀(tvs :num) (tenvE :tenv_val_exp). bind_tvar tvs tenvE = if tvs = (0 :num) then tenvE else Bind_tvar tvs tenvE
opt_bind=⊢ ∀(n :mlstring option) (tvs :num) (t :t) (tenvE :tenv_val_exp). opt_bind_name n tvs t tenvE = case n of (NONE :mlstring option) => tenvE | SOME n' => Bind_name n' tvs t tenvE
tve_lookup=⊢ (∀(n :mlstring) (inc :num). tveLookup n inc Empty = (NONE :(num # t) option)) ∧ (∀(n :mlstring) (inc :num) (tvs :num) (tenvE :tenv_val_exp). tveLookup n inc (Bind_tvar tvs tenvE) = tveLookup n (inc + tvs) tenvE) ∧ ∀(n :mlstring) (inc :num) (n' :mlstring) (tvs :num) (t :t) (tenvE :tenv_val_exp). tveLookup n inc (Bind_name n' tvs t tenvE) = if n' = n then SOME (tvs,deBruijn_inc tvs inc t) else tveLookup n inc tenvE
extend=⊢ ∀(tenv' :type_env) (tenv :type_env). extend_dec_tenv tenv' tenv = <|v := nsAppend tenv'.v tenv.v; c := nsAppend tenv'.c tenv.c; t := nsAppend tenv'.t tenv.t|>
lookup_local=⊢ ∀(id :(mlstring, mlstring) id) (tenvE :tenv_val_exp). lookup_varE id tenvE = case id of (Short x :(mlstring, mlstring) id) => tveLookup x (0 :num) tenvE | Long v4 v5 => (NONE :(num # t) option)
lookup=⊢ ∀(id :(mlstring, mlstring) id) (tenvE :tenv_val_exp) (tenv :type_env). lookup_var id tenvE tenv = case lookup_varE id tenvE of (NONE :(num # t) option) => nsLookup tenv.v id | SOME x => SOME x
num_tvs=⊢ num_tvs Empty = (0 :num) ∧ (∀(tvs :num) (tenvE :tenv_val_exp). num_tvs (Bind_tvar tvs tenvE) = tvs + num_tvs tenvE) ∧ ∀(n :mlstring) (tvs :num) (t :t) (tenvE :tenv_val_exp). num_tvs (Bind_name n tvs t tenvE) = num_tvs tenvE
bind_list=⊢ (∀(tvs :num) (tenvE :tenv_val_exp). bind_var_list tvs ([] :(mlstring # t) list) tenvE = tenvE) ∧ ∀(tvs :num) (tenvE :tenv_val_exp) (t :t) (n :mlstring) (binds :(mlstring # t) list). bind_var_list tvs ((n,t)::binds) tenvE = Bind_name n tvs t (bind_var_list tvs binds tenvE)
inc_example=⊢ deBruijn_inc (1 :num) (3 :num) (Tapp [Tvar_db (0 :num); Tvar_db (1 :num); Tvar_db (4 :num)] (7 :num)) = Tapp [Tvar_db (0 :num); Tvar_db (4 :num); Tvar_db (7 :num)] (7 :num)
subst_example=⊢ deBruijn_subst (1 :num) [Tapp ([] :t list) (5 :num); Tvar_db (7 :num)] (Tapp [Tvar_db (0 :num); Tvar_db (1 :num); Tvar_db (2 :num); Tvar_db (4 :num)] (9 :num)) = Tapp [Tvar_db (0 :num); Tapp ([] :t list) (5 :num); Tvar_db (7 :num); Tvar_db (2 :num)] (9 :num)
lookup_example=⊢ tveLookup «x» (0 :num) (Bind_tvar (2 :num) (Bind_name «x» (1 :num) (Tapp [Tvar_db (0 :num); Tvar_db (1 :num)] (4 :num)) Empty)) = SOME ((1 :num),Tapp [Tvar_db (0 :num); Tvar_db (3 :num)] (4 :num))
type_subst=⊢ (∀(tv :mlstring) (s :mlstring |-> t). type_subst s (Tvar tv) = case FLOOKUP s tv of (NONE :t option) => Tvar tv | SOME t => t) ∧ (∀(ts :t list) (tn :num) (s :mlstring |-> t). type_subst s (Tapp ts tn) = Tapp (MAP (λ(a :t). type_subst s a) ts) tn) ∧ ∀(s :mlstring |-> t) (n :num). type_subst s (Tvar_db n) = Tvar_db n
check_type_names=⊢ (∀(tv :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Atvar tv) ⇔ T) ∧ (∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Attup ts) ⇔ EVERY (λ(a :ast_t). check_type_names tenvT a) ts) ∧ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (t2 :ast_t) (t1 :ast_t). check_type_names tenvT (Atfun t1 t2) ⇔ check_type_names tenvT t1 ∧ check_type_names tenvT t2) ∧ ∀(ts :ast_t list) (tn :(mlstring, mlstring) id) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Atapp ts tn) ⇔ (case nsLookup tenvT tn of (NONE :(mlstring list # t) option) => F | SOME (tvs,v2) => LENGTH tvs = LENGTH ts) ∧ EVERY (λ(a :ast_t). check_type_names tenvT a) ts
type_name_subst=⊢ (∀(tv :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). type_name_subst tenvT (Atvar tv) = Tvar tv) ∧ (∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). type_name_subst tenvT (Attup ts) = Ttup (MAP (λ(a :ast_t). type_name_subst tenvT a) ts)) ∧ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (t2 :ast_t) (t1 :ast_t). type_name_subst tenvT (Atfun t1 t2) = Tfn (type_name_subst tenvT t1) (type_name_subst tenvT t2)) ∧ ∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tc :(mlstring, mlstring) id). type_name_subst tenvT (Atapp ts tc) = (let (args :t list) = MAP (λ(a :ast_t). type_name_subst tenvT a) ts in case nsLookup tenvT tc of (NONE :(mlstring list # t) option) => Ttup args | SOME (tvs,t) => type_subst (alist_to_fmap (ZIP (tvs,args))) t)
type_p_rules=⊢ (∀(tvs :num) (tenv :type_env) (t :t). check_freevars tvs ([] :mlstring list) t ⇒ type_p tvs tenv Pany t ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (n :mlstring) (t :t). check_freevars tvs ([] :mlstring list) t ⇒ type_p tvs tenv (Pvar n) t [(n,t)]) ∧ (∀(tvs :num) (tenv :type_env) (n :int). T ⇒ type_p tvs tenv (Plit (IntLit n)) Tint ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (c :char). T ⇒ type_p tvs tenv (Plit (Char c)) Tchar ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (s :mlstring). T ⇒ type_p tvs tenv (Plit (StrLit s)) Tstring ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (w :word8). T ⇒ type_p tvs tenv (Plit (Word8 w)) Tword8 ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (w :word64). T ⇒ type_p tvs tenv (Plit (Word64 w)) Tword64 ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (cn :(mlstring, mlstring) id) (ps :pat list) (ts :t list) (tvs' :mlstring list) (tn :num) (ts' :t list) (bindings :(mlstring # t) list). EVERY (check_freevars tvs ([] :mlstring list)) ts' ∧ LENGTH ts' = LENGTH tvs' ∧ type_ps tvs tenv ps (MAP (type_subst (alist_to_fmap (ZIP (tvs',ts')))) ts) bindings ∧ nsLookup tenv.c cn = SOME (tvs',ts,tn) ⇒ type_p tvs tenv (Pcon (SOME cn) ps) (Tapp ts' tn) bindings) ∧ (∀(tvs :num) (tenv :type_env) (ps :pat list) (ts :t list) (bindings :(mlstring # t) list). type_ps tvs tenv ps ts bindings ⇒ type_p tvs tenv (Pcon (NONE :(mlstring, mlstring) id option) ps) (Ttup ts) bindings) ∧ (∀(tvs :num) (tenv :type_env) (p :pat) (t :t) (bindings :(mlstring # t) list). type_p tvs tenv p t bindings ⇒ type_p tvs tenv (Pref p) (Tref t) bindings) ∧ (∀(tvs :num) (tenv :type_env) (pat :pat) (v :mlstring) (t :t) (bindings :(mlstring # t) list). type_p tvs tenv pat t bindings ⇒ type_p tvs tenv (Pas pat v) t (bindings ++ [(v,t)])) ∧ (∀(tvs :num) (tenv :type_env) (p :pat) (t :ast_t) (bindings :(mlstring # t) list). check_freevars_ast ([] :mlstring list) t ∧ check_type_names tenv.t t ∧ type_p tvs tenv p (type_name_subst tenv.t t) bindings ⇒ type_p tvs tenv (Ptannot p t) (type_name_subst tenv.t t) bindings) ∧ (∀(tvs :num) (tenv :type_env). T ⇒ type_ps tvs tenv ([] :pat list) ([] :t list) ([] :(mlstring # t) list)) ∧ ∀(tvs :num) (tenv :type_env) (p :pat) (ps :pat list) (t :t) (ts :t list) (bindings :(mlstring # t) list) (bindings' :(mlstring # t) list). type_p tvs tenv p t bindings ∧ type_ps tvs tenv ps ts bindings' ⇒ type_ps tvs tenv (p::ps) (t::ts) (bindings' ++ bindings)
type_name_example=⊢ type_name_subst (alist_to_ns [(«pair»,[«a»; «b»],Tapp [Tvar «a»; Tvar «b»] (9 :num))] :(mlstring, mlstring, mlstring list # t) namespace) (Atapp [Atvar «x»; Atvar «y»] (Short «pair» :(mlstring, mlstring) id)) = Tapp [Tvar «x»; Tvar «y»] (9 :num)
type_name_missing=⊢ type_name_subst (alist_to_ns ([] :(mlstring # mlstring list # t) list) :(mlstring, mlstring, mlstring list # t) namespace) (Atapp [Atvar «x»] (Short «missing» :(mlstring, mlstring) id)) = Tapp [Tvar «x»] (9 :num)
type_name_duplicates=⊢ type_name_subst (alist_to_ns [(«dup»,[«a»; «a»],Tvar «a»)] :(mlstring, mlstring, mlstring list # t) namespace) (Atapp [Atvar «x»; Atvar «y»] (Short «dup» :(mlstring, mlstring) id)) = Tvar «x»
type_of=⊢ t_of BoolT = Tbool ∧ t_of IntT = Tint ∧ t_of CharT = Tchar ∧ t_of StrT = Tstring ∧ t_of (WordT W8 :prim_type) = Tword8 ∧ t_of (WordT W64 :prim_type) = Tword64 ∧ t_of Float64T = Tdouble
supported_test=⊢ (supported_test Equal (ty :prim_type) ⇔ T) ∧ (supported_test (Compare (v0 :opb)) ty ⇔ MEM ty [IntT; CharT; (WordT W8 :prim_type); Float64T; StrT]) ∧ (supported_test (AltCompare (v4 :opb)) ty ⇔ ty = StrT)
supported_arith=⊢ supported_arith (a :arith) IntT = (if MEM a [Add; Sub; Mul; Div; Mod] then SOME (2 :num) else (NONE :num option)) ∧ supported_arith a Float64T = (if MEM a [Abs; Neg; Sqrt] then SOME (1 :num) else if MEM a [Add; Sub; Mul; Div] then SOME (2 :num) else if MEM a [FMA] then SOME (3 :num) else (NONE :num option)) ∧ supported_arith a (WordT (v0 :word_size) :prim_type) = (if MEM a [Add; Sub; And; Or; Xor] then SOME (2 :num) else (NONE :num option)) ∧ supported_arith a BoolT = (if MEM a [Not] then SOME (1 :num) else (NONE :num option)) ∧ supported_arith a CharT = (NONE :num option) ∧ supported_arith a StrT = (NONE :num option)
supported_conversion=⊢ (supported_conversion (WordT W8 :prim_type) IntT ⇔ T) ∧ (supported_conversion (WordT W64 :prim_type) IntT ⇔ T) ∧ (supported_conversion IntT (WordT W8 :prim_type) ⇔ T) ∧ (supported_conversion IntT (WordT W64 :prim_type) ⇔ T) ∧ (supported_conversion CharT IntT ⇔ T) ∧ (supported_conversion IntT CharT ⇔ T) ∧ (supported_conversion CharT (WordT W8 :prim_type) ⇔ T) ∧ (supported_conversion (WordT W8 :prim_type) CharT ⇔ T) ∧ (supported_conversion Float64T (WordT W64 :prim_type) ⇔ T) ∧ (supported_conversion (WordT W64 :prim_type) Float64T ⇔ T) ∧ (supported_conversion (from_ty :prim_type) BoolT ⇔ F) ∧ (supported_conversion BoolT IntT ⇔ F) ∧ (supported_conversion IntT IntT ⇔ F) ∧ (supported_conversion StrT IntT ⇔ F) ∧ (supported_conversion Float64T IntT ⇔ F) ∧ (supported_conversion BoolT CharT ⇔ F) ∧ (supported_conversion CharT CharT ⇔ F) ∧ (supported_conversion StrT CharT ⇔ F) ∧ (supported_conversion (WordT W64 :prim_type) CharT ⇔ F) ∧ (supported_conversion Float64T CharT ⇔ F) ∧ (supported_conversion from_ty StrT ⇔ F) ∧ (supported_conversion BoolT (WordT (v2 :word_size) :prim_type) ⇔ F) ∧ (supported_conversion CharT (WordT W64 :prim_type) ⇔ F) ∧ (supported_conversion StrT (WordT v2 :prim_type) ⇔ F) ∧ (supported_conversion (WordT (v8 :word_size) :prim_type) (WordT v2 :prim_type) ⇔ F) ∧ (supported_conversion Float64T (WordT W8 :prim_type) ⇔ F) ∧ (supported_conversion BoolT Float64T ⇔ F) ∧ (supported_conversion IntT Float64T ⇔ F) ∧ (supported_conversion CharT Float64T ⇔ F) ∧ (supported_conversion StrT Float64T ⇔ F) ∧ (supported_conversion (WordT W8 :prim_type) Float64T ⇔ F) ∧ (supported_conversion Float64T Float64T ⇔ F)
type_op=⊢ ∀(op :op) (ts :t list) (t :t). type_op op ts t ⇔ case (op,ts) of (Arith a ty,ts) => EVERY (λ(arg :t). arg = t_of ty) ts ∧ t = t_of ty ∧ supported_arith a ty = SOME (LENGTH ts) | (FromTo ty1 ty2,([] :t list)) => F | (FromTo ty1 ty2,[t1'³']) => t1'³' = t_of ty1 ∧ t = t_of ty2 ∧ supported_conversion ty1 ty2 | (FromTo ty1 ty2,t1'³'::v32::v33) => F | (Shift v19 v20 v21,([] :t list)) => F | (Shift W8 v20 v21,[t1']) => t1' = Tword8 ∧ t = Tword8 | (Shift W64 v20 v21,[t1']) => t1' = Tword64 ∧ t = Tword64 | (Shift v19 v20 v21,t1'::v40::v41) => F | (Equality,([] :t list)) => F | (Equality,[t1'']) => F | (Equality,[t1''; t2']) => t1'' = t2' ∧ t = Tbool | (Equality,t1''::t2'::v52::v53) => F | (Test test ty',([] :t list)) => F | (Test test ty',[t1'⁴']) => F | (Test test ty',[t1'⁴'; t2'']) => t1'⁴' = t2'' ∧ t = Tbool ∧ t1'⁴' = t_of ty' ∧ supported_test test ty' | (Test test ty',t1'⁴'::t2''::v64::v65) => F | (Opapp,([] :t list)) => F | (Opapp,[t1]) => F | (Opapp,[t1; t2]) => t1 = Tfn t2 t | (Opapp,t1::t2::v76::v77) => F | (Opassign,([] :t list)) => F | (Opassign,[t1'⁵']) => F | (Opassign,[t1'⁵'; t2'³']) => t1'⁵' = Tref t2'³' ∧ t = Ttup ([] :t list) | (Opassign,t1'⁵'::t2'³'::v88::v89) => F | (Opref,([] :t list)) => F | (Opref,[t1'⁶']) => t = Tref t1'⁶' | (Opref,t1'⁶'::v96::v97) => F | (Opderef,([] :t list)) => F | (Opderef,[t1'⁷']) => t1'⁷' = Tref t | (Opderef,t1'⁷'::v104::v105) => F | (Aw8alloc,([] :t list)) => F | (Aw8alloc,[t1'⁸']) => F | (Aw8alloc,[t1'⁸'; t2'⁴']) => t1'⁸' = Tint ∧ t2'⁴' = Tword8 ∧ t = Tword8array | (Aw8alloc,t1'⁸'::t2'⁴'::v116::v117) => F | (Aw8sub,([] :t list)) => F | (Aw8sub,[t1'⁹']) => F | (Aw8sub,[t1'⁹'; t2'⁵']) => t1'⁹' = Tword8array ∧ t2'⁵' = Tint ∧ t = Tword8 | (Aw8sub,t1'⁹'::t2'⁵'::v128::v129) => F | (Aw8length,([] :t list)) => F | (Aw8length,[t1'¹⁰']) => t1'¹⁰' = Tword8array ∧ t = Tint | (Aw8length,t1'¹⁰'::v136::v137) => F | (Aw8update,([] :t list)) => F | (Aw8update,[t1'¹¹']) => F | (Aw8update,[t1'¹¹'; t2'⁶']) => F | (Aw8update,[t1'¹¹'; t2'⁶'; t3]) => t1'¹¹' = Tword8array ∧ t2'⁶' = Tint ∧ t3 = Tword8 ∧ t = Ttup ([] :t list) | (Aw8update,t1'¹¹'::t2'⁶'::t3::v152::v153) => F | (CopyStrStr,([] :t list)) => F | (CopyStrStr,[t1'¹²']) => F | (CopyStrStr,[t1'¹²'; t2'⁷']) => F | (CopyStrStr,[t1'¹²'; t2'⁷'; t3']) => t1'¹²' = Tstring ∧ t2'⁷' = Tint ∧ t3' = Tint ∧ t = Tstring | (CopyStrStr,t1'¹²'::t2'⁷'::t3'::v168::v169) => F | (CopyStrAw8,([] :t list)) => F | (CopyStrAw8,[t1'¹³']) => F | (CopyStrAw8,[t1'¹³'; t2'⁸']) => F | (CopyStrAw8,[t1'¹³'; t2'⁸'; t3'']) => F | (CopyStrAw8,[t1'¹³'; t2'⁸'; t3''; t4]) => F | (CopyStrAw8,[t1'¹³'; t2'⁸'; t3''; t4; t5]) => t1'¹³' = Tstring ∧ t2'⁸' = Tint ∧ t3'' = Tint ∧ t4 = Tword8array ∧ t5 = Tint ∧ t = Ttup ([] :t list) | (CopyStrAw8,t1'¹³'::t2'⁸'::t3''::t4::t5::v192::v193) => F | (CopyAw8Str,([] :t list)) => F | (CopyAw8Str,[t1'¹⁴']) => F | (CopyAw8Str,[t1'¹⁴'; t2'⁹']) => F | (CopyAw8Str,[t1'¹⁴'; t2'⁹'; t3'³']) => t1'¹⁴' = Tword8array ∧ t2'⁹' = Tint ∧ t3'³' = Tint ∧ t = Tstring | (CopyAw8Str,t1'¹⁴'::t2'⁹'::t3'³'::v208::v209) => F | (CopyAw8Aw8,([] :t list)) => F | (CopyAw8Aw8,[t1'¹⁵']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰'; t3'⁴']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰'; t3'⁴'; t4']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰'; t3'⁴'; t4'; t5']) => t1'¹⁵' = Tword8array ∧ t2'¹⁰' = Tint ∧ t3'⁴' = Tint ∧ t4' = Tword8array ∧ t5' = Tint ∧ t = Ttup ([] :t list) | (CopyAw8Aw8,t1'¹⁵'::t2'¹⁰'::t3'⁴'::t4'::t5'::v232::v233) => F | (XorAw8Str_unsafe,ts) => F | (Implode,([] :t list)) => F | (Implode,[t1'¹⁶']) => t1'¹⁶' = Tlist Tchar ∧ t = Tstring | (Implode,t1'¹⁶'::v240::v241) => F | (Explode,([] :t list)) => F | (Explode,[t1'¹⁷']) => t1'¹⁷' = Tstring ∧ t = Tlist Tchar | (Explode,t1'¹⁷'::v248::v249) => F | (Strsub,([] :t list)) => F | (Strsub,[t1'¹⁸']) => F | (Strsub,[t1'¹⁸'; t2'¹¹']) => t1'¹⁸' = Tstring ∧ t2'¹¹' = Tint ∧ t = Tchar | (Strsub,t1'¹⁸'::t2'¹¹'::v260::v261) => F | (Strlen,([] :t list)) => F | (Strlen,[t1'¹⁹']) => t1'¹⁹' = Tstring ∧ t = Tint | (Strlen,t1'¹⁹'::v268::v269) => F | (Strcat,([] :t list)) => F | (Strcat,[t1'²⁰']) => t1'²⁰' = Tlist Tstring ∧ t = Tstring | (Strcat,t1'²⁰'::v276::v277) => F | (VfromList,([] :t list)) => F | (VfromList,Tvar v286::v281) => F | (VfromList,Tvar_db v287::v281) => F | (VfromList,Tapp ([] :t list) ctor::v281) => F | (VfromList,[Tapp [t1'²¹'] ctor]) => ctor = Tlist_num ∧ t = Tvector t1'²¹' | (VfromList,Tapp [t1'²¹'] ctor::v300::v301) => F | (VfromList,Tapp (t1'²¹'::v296::v297) ctor::v281) => F | (Vsub,([] :t list)) => F | (Vsub,[t1'²²']) => F | (Vsub,[t1'²²'; t2'¹²']) => t2'¹²' = Tint ∧ Tvector t = t1'²²' | (Vsub,t1'²²'::t2'¹²'::v312::v313) => F | (Vlength,([] :t list)) => F | (Vlength,Tvar v322::v317) => F | (Vlength,Tvar_db v323::v317) => F | (Vlength,Tapp ([] :t list) ctor'::v317) => F | (Vlength,[Tapp [t1'²³'] ctor']) => ctor' = Tvector_num ∧ t = Tint | (Vlength,Tapp [t1'²³'] ctor'::v336::v337) => F | (Vlength,Tapp (t1'²³'::v332::v333) ctor'::v317) => F | (Aalloc,([] :t list)) => F | (Aalloc,[t1'²⁴']) => F | (Aalloc,[t1'²⁴'; t2'¹³']) => t1'²⁴' = Tint ∧ t = Tarray t2'¹³' | (Aalloc,t1'²⁴'::t2'¹³'::v348::v349) => F | (AallocEmpty,([] :t list)) => F | (AallocEmpty,[t1'²⁵']) => t1'²⁵' = Ttup ([] :t list) ∧ ∃(t2 :t). t = Tarray t2 | (AallocEmpty,t1'²⁵'::v356::v357) => F | (AallocFixed,ts) => F | (Asub,([] :t list)) => F | (Asub,[t1'²⁶']) => F | (Asub,[t1'²⁶'; t2'¹⁴']) => t2'¹⁴' = Tint ∧ Tarray t = t1'²⁶' | (Asub,t1'²⁶'::t2'¹⁴'::v368::v369) => F | (Alength,([] :t list)) => F | (Alength,Tvar v378::v373) => F | (Alength,Tvar_db v379::v373) => F | (Alength,Tapp ([] :t list) ctor''::v373) => F | (Alength,[Tapp [t1'²⁷'] ctor'']) => ctor'' = Tarray_num ∧ t = Tint | (Alength,Tapp [t1'²⁷'] ctor''::v392::v393) => F | (Alength,Tapp (t1'²⁷'::v388::v389) ctor''::v373) => F | (Aupdate,([] :t list)) => F | (Aupdate,[t1'²⁸']) => F | (Aupdate,[t1'²⁸'; t2'¹⁵']) => F | (Aupdate,[t1'²⁸'; t2'¹⁵'; t3'⁵']) => t1'²⁸' = Tarray t3'⁵' ∧ t2'¹⁵' = Tint ∧ t = Ttup ([] :t list) | (Aupdate,t1'²⁸'::t2'¹⁵'::t3'⁵'::v408::v409) => F | (Vsub_unsafe,ts) => F | (Asub_unsafe,ts) => F | (Aupdate_unsafe,ts) => F | (Aw8sub_unsafe,ts) => F | (Aw8update_unsafe,ts) => F | (ThunkOp v24,ts) => F | (ListAppend,([] :t list)) => F | (ListAppend,Tvar v418::v413) => F | (ListAppend,Tvar_db v419::v413) => F | (ListAppend,Tapp ([] :t list) ctor'³'::v413) => F | (ListAppend,[Tapp (t1'³¹'::v425) ctor'³']) => F | (ListAppend,[Tapp [t1'³¹'] ctor'³'; t2'¹⁸']) => ctor'³' = Tlist_num ∧ t2'¹⁸' = Tapp [t1'³¹'] ctor'³' ∧ t = t2'¹⁸' | (ListAppend,[Tapp (t1'³¹'::v436::v437) ctor'³'; t2'¹⁸']) => F | (ListAppend,Tapp (t1'³¹'::v425) ctor'³'::t2'¹⁸'::v432::v433) => F | (ConfigGC,([] :t list)) => F | (ConfigGC,[t1'²⁹']) => F | (ConfigGC,[t1'²⁹'; t2'¹⁶']) => t1'²⁹' = Tint ∧ t2'¹⁶' = Tint ∧ t = Ttup ([] :t list) | (ConfigGC,t1'²⁹'::t2'¹⁶'::v448::v449) => F | (FFI n,([] :t list)) => F | (FFI n,[t1'³⁰']) => F | (FFI n,[t1'³⁰'; t2'¹⁷']) => t1'³⁰' = Tstring ∧ t2'¹⁷' = Tword8array ∧ t = Ttup ([] :t list) | (FFI n,t1'³⁰'::t2'¹⁷'::v460::v461) => F | (Eval,ts) => F | (Env_id,ts) => F
type_e_rules=⊢ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :int). T ⇒ type_e tenv tenvE (Lit (IntLit n)) Tint) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (c :char). T ⇒ type_e tenv tenvE (Lit (Char c)) Tchar) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (s :mlstring). T ⇒ type_e tenv tenvE (Lit (StrLit s)) Tstring) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word8). T ⇒ type_e tenv tenvE (Lit (Word8 w)) Tword8) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word64). T ⇒ type_e tenv tenvE (Lit (Word64 w)) Tword64) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word64). T ⇒ type_e tenv tenvE (Lit (Float64 w)) Tdouble) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :t). check_freevars (num_tvs tenvE) ([] :mlstring list) t ∧ type_e tenv tenvE e Texn ⇒ type_e tenv tenvE (Raise e) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (pes :(pat # exp) list) (t :t). type_e tenv tenvE e t ∧ pes ≠ ([] :(pat # exp) list) ∧ (∀((p :pat),(e :exp))::set pes. ∃(bindings :(mlstring # t) list). ALL_DISTINCT (pat_bindings p) ∧ type_p (num_tvs tenvE) tenv p Texn bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t) ⇒ type_e tenv tenvE (Handle e pes) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (cn :(mlstring, mlstring) id) (es :exp list) (tvs :mlstring list) (tn :num) (ts' :t list) (ts :t list). EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) ts' ∧ LENGTH tvs = LENGTH ts' ∧ type_es tenv tenvE es (MAP (type_subst (alist_to_fmap (ZIP (tvs,ts')))) ts) ∧ nsLookup tenv.c cn = SOME (tvs,ts,tn) ⇒ type_e tenv tenvE (Con (SOME cn) es) (Tapp ts' tn)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (es :exp list) (ts :t list). type_es tenv tenvE es ts ⇒ type_e tenv tenvE (Con (NONE :(mlstring, mlstring) id option) es) (Ttup ts)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :(mlstring, mlstring) id) (t :t) (targs :t list) (tvs :num). tvs = LENGTH targs ∧ EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) targs ∧ lookup_var n tenvE tenv = SOME (tvs,t) ⇒ type_e tenv tenvE (Var n) (deBruijn_subst (0 :num) targs t)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :mlstring) (e :exp) (t1 :t) (t2 :t). check_freevars (num_tvs tenvE) ([] :mlstring list) t1 ∧ type_e tenv (Bind_name n (0 :num) t1 tenvE) e t2 ⇒ type_e tenv tenvE (Fun n e) (Tfn t1 t2)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (op :op) (es :exp list) (ts :t list) (t :t). type_es tenv tenvE es ts ∧ type_op op ts t ∧ check_freevars (num_tvs tenvE) ([] :mlstring list) t ⇒ type_e tenv tenvE (App op es) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (l :lop) (e1 :exp) (e2 :exp). type_e tenv tenvE e1 Tbool ∧ type_e tenv tenvE e2 Tbool ⇒ type_e tenv tenvE (Log l e1 e2) Tbool) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e1 :exp) (e2 :exp) (e3 :exp) (t :t). type_e tenv tenvE e1 Tbool ∧ type_e tenv tenvE e2 t ∧ type_e tenv tenvE e3 t ⇒ type_e tenv tenvE (If e1 e2 e3) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (pes :(pat # exp) list) (t1 :t) (t2 :t). type_e tenv tenvE e t1 ∧ pes ≠ ([] :(pat # exp) list) ∧ (∀((p :pat),(e :exp))::set pes. ∃(bindings :(mlstring # t) list). ALL_DISTINCT (pat_bindings p) ∧ type_p (num_tvs tenvE) tenv p t1 bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t2) ⇒ type_e tenv tenvE (Mat e pes) t2) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :mlstring option) (e1 :exp) (e2 :exp) (t1 :t) (t2 :t). type_e tenv tenvE e1 t1 ∧ type_e tenv (opt_bind_name n (0 :num) t1 tenvE) e2 t2 ⇒ type_e tenv tenvE (Let n e1 e2) t2) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (funs :(mlstring # mlstring # exp) list) (e :exp) (t :t) (bindings :(mlstring # t) list). type_funs tenv (bind_var_list (0 :num) bindings tenvE) funs bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t ⇒ type_e tenv tenvE (Letrec funs e) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :ast_t). check_freevars_ast ([] :mlstring list) t ∧ check_type_names tenv.t t ∧ type_e tenv tenvE e (type_name_subst tenv.t t) ⇒ type_e tenv tenvE (Tannot e t) (type_name_subst tenv.t t)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (l :locs) (t :t). type_e tenv tenvE e t ⇒ type_e tenv tenvE (Lannot e l) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp). T ⇒ type_es tenv tenvE ([] :exp list) ([] :t list)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (es :exp list) (t :t) (ts :t list). type_e tenv tenvE e t ∧ type_es tenv tenvE es ts ⇒ type_es tenv tenvE (e::es) (t::ts)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp). T ⇒ type_funs tenv tenvE ([] :(mlstring # mlstring # exp) list) ([] :(mlstring # t) list)) ∧ ∀(tenv :type_env) (tenvE :tenv_val_exp) (fn :mlstring) (n :mlstring) (e :exp) (funs :(mlstring # mlstring # exp) list) (bindings :(mlstring # t) list) (t1 :t) (t2 :t). check_freevars (num_tvs tenvE) ([] :mlstring list) (Tfn t1 t2) ∧ type_e tenv (Bind_name n (0 :num) t1 tenvE) e t2 ∧ type_funs tenv tenvE funs bindings ∧ ALOOKUP bindings fn = (NONE :t option) ⇒ type_funs tenv tenvE ((fn,n,e)::funs) ((fn,Tfn t1 t2)::bindings)
arith_good=⊢ type_op (Arith Add IntT) [Tint; Tint] Tint ⇔ T
arith_bad_arity=⊢ type_op (Arith Add IntT) [Tint] Tint ⇔ F
empty_array=⊢ type_op AallocEmpty [Ttup ([] :t list)] (Tarray Tint) ⇔ $? ($= (Tapp ([] :t list) (5 :num)))
unsafe_op=⊢ type_op Aw8sub_unsafe [Tword8array; Tint] Tword8 ⇔ F
value_def=⊢ (∀(v0 :lit). is_value (Lit v0) ⇔ T) ∧ (∀(v1 :(mlstring, mlstring) id option) (es :exp list). is_value (Con v1 es) ⇔ EVERY (λ(a :exp). is_value a) es) ∧ (∀(v2 :(mlstring, mlstring) id). is_value (Var v2) ⇔ T) ∧ (∀(v4 :exp) (v3 :mlstring). is_value (Fun v3 v4) ⇔ T) ∧ (∀(v5 :ast_t) (e :exp). is_value (Tannot e v5) ⇔ is_value e) ∧ (∀(v6 :locs) (e :exp). is_value (Lannot e v6) ⇔ is_value e) ∧ (∀(v :exp). is_value (Raise v) ⇔ F) ∧ (∀(v9 :(pat # exp) list) (v8 :exp). is_value (Handle v8 v9) ⇔ F) ∧ (∀(v17 :exp list) (v16 :op). is_value (App v16 v17) ⇔ F) ∧ (∀(v20 :exp) (v19 :exp) (v18 :lop). is_value (Log v18 v19 v20) ⇔ F) ∧ (∀(v23 :exp) (v22 :exp) (v21 :exp). is_value (If v21 v22 v23) ⇔ F) ∧ (∀(v25 :(pat # exp) list) (v24 :exp). is_value (Mat v24 v25) ⇔ F) ∧ (∀(v28 :exp) (v27 :exp) (v26 :mlstring option). is_value (Let v26 v27 v28) ⇔ F) ∧ ∀(v30 :exp) (v29 :(mlstring # mlstring # exp) list). is_value (Letrec v29 v30) ⇔ F
check_ctor=⊢ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_ctor_tenv tenvT ([] :(mlstring list # mlstring # (mlstring # ast_t list) list) list) ⇔ T) ∧ ∀(tvs :mlstring list) (tn :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (ctors :(mlstring # ast_t list) list). check_ctor_tenv tenvT ((tvs,tn,ctors)::tds) ⇔ check_dup_ctors (tvs,tn,ctors) ∧ ALL_DISTINCT tvs ∧ EVERY (λ((cn :mlstring),(ts :ast_t list)). EVERY (check_freevars_ast tvs) ts ∧ EVERY (check_type_names tenvT) ts) ctors ∧ ¬MEM tn (MAP (λ(p :mlstring list # mlstring # (mlstring # ast_t list) list). case p of (v,tn,v3) => tn) tds) ∧ check_ctor_tenv tenvT tds
build_ctor=⊢ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace). (build_ctor_tenv tenvT ([] :(γ # ε # (β # ast_t list) list) list) ([] :δ list) :(α, β, γ # t list # δ) namespace) = (alist_to_ns ([] :(β # γ # t list # δ) list) :(α, β, γ # t list # δ) namespace)) ∧ (∀(tvs :γ) (tn :ε) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tds :(γ # ε # (β # ast_t list) list) list) (ids :δ list) (id :δ) (ctors :(β # ast_t list) list). (build_ctor_tenv tenvT ((tvs,tn,ctors)::tds) (id::ids) :(α, β, γ # t list # δ) namespace) = nsAppend (build_ctor_tenv tenvT tds ids :(α, β, γ # t list # δ) namespace) (alist_to_ns (REVERSE (MAP (λ((cn :β),(ts :ast_t list)). (cn,tvs,MAP (type_name_subst tenvT) ts,id)) ctors)) :(α, β, γ # t list # δ) namespace)) ∧ (∀(v9 :δ) (v10 :δ list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). (build_ctor_tenv tenvT ([] :(γ # ε # (β # ast_t list) list) list) (v9::v10) :(α, β, γ # t list # δ) namespace) = (alist_to_ns ([] :(β # γ # t list # δ) list) :(α, β, γ # t list # δ) namespace)) ∧ ∀(v6 :(γ # ε # (β # ast_t list) list) list) (v5 :γ # ε # (β # ast_t list) list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). (build_ctor_tenv tenvT (v5::v6) ([] :δ list) :(α, β, γ # t list # δ) namespace) = (alist_to_ns ([] :(β # γ # t list # δ) list) :(α, β, γ # t list # δ) namespace)
add_tvs=⊢ ∀(tvs :num) (bindings :(mlstring # t) list). tenv_add_tvs tvs bindings = MAP (λ((n :mlstring),(t :t)). (n,tvs,t)) bindings
scheme=⊢ ∀(tvs_spec :num) (t_spec :t) (tvs_impl :num) (t_impl :t). tscheme_inst (tvs_spec,t_spec) (tvs_impl,t_impl) ⇔ ∃(subst :t list). LENGTH subst = tvs_impl ∧ check_freevars tvs_impl ([] :mlstring list) t_impl ∧ EVERY (check_freevars tvs_spec ([] :mlstring list)) subst ∧ deBruijn_subst (0 :num) subst t_impl = t_spec
tenv_lift=⊢ ∀(mn :mlstring) (tenv :type_env). tenvLift mn tenv = <|v := nsLift mn tenv.v; c := nsLift mn tenv.c; t := nsLift mn tenv.t|>
primitive_nums=⊢ prim_type_nums = [Tarray_num; Tchar_num; Texn_num; Tfn_num; Tint_num; Tref_num; Tstring_num; Ttup_num; Tvector_num; Tword64_num; Tword8_num; Tword8array_num; Tdouble_num]
type_d_rules=⊢ (∀(extra_checks :bool) (tvs :num) (tenv :type_env) (p :pat) (e :exp) (t :t) (bindings :(mlstring # t) list) (locs :locs). is_value e ∧ ALL_DISTINCT (pat_bindings p) ∧ type_p tvs tenv p t bindings ∧ type_e tenv (bind_tvar tvs Empty) e t ∧ (extra_checks ⇒ ∀(tvs' :num) (bindings' :(mlstring # t) list) (t' :t). type_p tvs' tenv p t' bindings' ∧ type_e tenv (bind_tvar tvs' Empty) e t' ⇒ LIST_REL tscheme_inst (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs' bindings')) (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs bindings))) ⇒ type_d extra_checks tenv (Dlet locs p e) (∅ :num -> bool) <|v := (alist_to_ns (tenv_add_tvs tvs bindings) :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(extra_checks :bool) (tenv :type_env) (p :pat) (e :exp) (t :t) (bindings :(mlstring # t) list) (locs :locs). (extra_checks ⇒ ¬is_value e ∧ type_pe_determ tenv Empty p e) ∧ ALL_DISTINCT (pat_bindings p) ∧ type_p (0 :num) tenv p t bindings ∧ type_e tenv Empty e t ⇒ type_d extra_checks tenv (Dlet locs p e) (∅ :num -> bool) <|v := (alist_to_ns (tenv_add_tvs (0 :num) bindings) :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(extra_checks :bool) (tenv :type_env) (funs :(mlstring # mlstring # exp) list) (bindings :(mlstring # t) list) (tvs :num) (locs :locs). type_funs tenv (bind_var_list (0 :num) bindings (bind_tvar tvs Empty)) funs bindings ∧ (extra_checks ⇒ ∀(tvs' :num) (bindings' :(mlstring # t) list). type_funs tenv (bind_var_list (0 :num) bindings' (bind_tvar tvs' Empty)) funs bindings' ⇒ LIST_REL tscheme_inst (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs' bindings')) (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs bindings))) ⇒ type_d extra_checks tenv (Dletrec locs funs) (∅ :num -> bool) <|v := (alist_to_ns (tenv_add_tvs tvs bindings) :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(extra_checks :bool) (tenv :type_env) (tdefs :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (type_identities :num list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (locs :locs). ALL_DISTINCT type_identities ∧ DISJOINT (set type_identities) (set (Tlist_num::Tbool_num::prim_type_nums)) ∧ check_ctor_tenv (nsAppend tenvT tenv.t) tdefs ∧ LENGTH type_identities = LENGTH tdefs ∧ tenvT = (alist_to_ns (MAP2 (λ((tvs :mlstring list),(tn :mlstring),(ctors :(mlstring # ast_t list) list)) (i :num). (tn,tvs,Tapp (MAP Tvar tvs) i)) tdefs type_identities :(mlstring # mlstring list # t) list) :(mlstring, mlstring, mlstring list # t) namespace) ⇒ type_d extra_checks tenv (Dtype locs tdefs) (set type_identities) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (build_ctor_tenv (nsAppend tenvT tenv.t) tdefs type_identities :(mlstring, mlstring, mlstring list # t list # num) namespace); t := tenvT|>) ∧ (∀(extra_checks :bool) (tenv :type_env) (tvs :mlstring list) (tn :mlstring) (t :ast_t) (locs :locs). check_freevars_ast tvs t ∧ check_type_names tenv.t t ∧ ALL_DISTINCT tvs ⇒ type_d extra_checks tenv (Dtabbrev locs tvs tn t) (∅ :num -> bool) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsSing tn (tvs,type_name_subst tenv.t t) :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(extra_checks :bool) (tenv :type_env) (cn :mlstring) (ts :ast_t list) (locs :locs). EVERY (check_freevars_ast ([] :mlstring list)) ts ∧ EVERY (check_type_names tenv.t) ts ⇒ type_d extra_checks tenv (Dexn locs cn ts) (∅ :num -> bool) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsSing cn (([] :mlstring list),MAP (type_name_subst tenv.t) ts,Texn_num) :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(extra_checks :bool) (tenv :type_env) (mn :mlstring) (ds :dec list) (decls :num -> bool) (tenv' :type_env). type_ds extra_checks tenv ds decls tenv' ⇒ type_d extra_checks tenv (Dmod mn ds) decls (tenvLift mn tenv')) ∧ (∀(extra_checks :bool) (tenv :type_env) (lds :dec list) (ds :dec list) (tenv1 :type_env) (tenv2 :type_env) (decls1 :num -> bool) (decls2 :num -> bool). type_ds extra_checks tenv lds decls1 tenv1 ∧ type_ds extra_checks (extend_dec_tenv tenv1 tenv) ds decls2 tenv2 ∧ DISJOINT decls1 decls2 ⇒ type_d extra_checks tenv (Dlocal lds ds) (decls1 ∪ decls2) tenv2) ∧ (∀(extra_checks :bool) (tenv :type_env). T ⇒ type_ds extra_checks tenv ([] :dec list) (∅ :num -> bool) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ ∀(extra_checks :bool) (tenv :type_env) (d :dec) (ds :dec list) (tenv1 :type_env) (tenv2 :type_env) (decls1 :num -> bool) (decls2 :num -> bool). type_d extra_checks tenv d decls1 tenv1 ∧ type_ds extra_checks (extend_dec_tenv tenv1 tenv) ds decls2 tenv2 ∧ DISJOINT decls1 decls2 ⇒ type_ds extra_checks tenv (d::ds) (decls1 ∪ decls2) (extend_dec_tenv tenv2 tenv1)
value_tuple=⊢ is_value (Con (NONE :(mlstring, mlstring) id option) [Lit (IntLit (1 :int)); Lit (IntLit (2 :int))]) ⇔ T
value_apply=⊢ is_value (App Opapp [Lit (IntLit (1 :int)); Lit (IntLit (2 :int))]) ⇔ F
ctor_distinct=⊢ check_ctor_tenv (alist_to_ns ([] :(mlstring # mlstring list # t) list) :(mlstring, mlstring, mlstring list # t) namespace) [(([] :mlstring list),«t»,[(«A»,([] :ast_t list)); («B»,([] :ast_t list))])] ⇔ T
ctor_duplicate=⊢ check_ctor_tenv (alist_to_ns ([] :(mlstring # mlstring list # t) list) :(mlstring, mlstring, mlstring list # t) namespace) [(([] :mlstring list),«t»,[(«A»,([] :ast_t list)); («A»,([] :ast_t list))])] ⇔ F
prim_tenv=⊢ prim_tenv = <|c := (alist_to_ns (REVERSE [(«Bind»,([] :mlstring list),([] :t list),Texn_num); («Chr»,([] :mlstring list),([] :t list),Texn_num); («Div»,([] :mlstring list),([] :t list),Texn_num); («Subscript»,([] :mlstring list),([] :t list),Texn_num); («False»,([] :mlstring list),([] :t list),Tbool_num); («True»,([] :mlstring list),([] :t list),Tbool_num); («[]»,[«'a»],([] :t list),Tlist_num); («::»,[«'a»],[Tvar «'a»; Tlist (Tvar «'a»)],Tlist_num)]) :(mlstring, mlstring, mlstring list # t list # num) namespace); v := (nsEmpty :(mlstring, mlstring, num # t) namespace); t := (alist_to_ns (REVERSE [(«array»,[«'a»],Tapp [Tvar «'a»] Tarray_num); («bool»,([] :mlstring list),Tapp ([] :t list) Tbool_num); («char»,([] :mlstring list),Tapp ([] :t list) Tchar_num); («double»,([] :mlstring list),Tapp ([] :t list) Tdouble_num); («exn»,([] :mlstring list),Tapp ([] :t list) Texn_num); («int»,([] :mlstring list),Tapp ([] :t list) Tint_num); («list»,[«'a»],Tapp [Tvar «'a»] Tlist_num); («ref»,[«'a»],Tapp [Tvar «'a»] Tref_num); («string»,([] :mlstring list),Tapp ([] :t list) Tstring_num); («unit»,([] :mlstring list),Tapp ([] :t list) Ttup_num); («vector»,[«'a»],Tapp [Tvar «'a»] Tvector_num); («word64»,([] :mlstring list),Tapp ([] :t list) Tword64_num); («word8»,([] :mlstring list),Tapp ([] :t list) Tword8_num); («word8array»,([] :mlstring list),Tapp ([] :t list) Tword8array_num)]) :(mlstring, mlstring, mlstring list # t) namespace)|>
prim_type_ids=⊢ prim_type_ids = set (Tlist_num::Tbool_num::prim_type_nums)
can_type_prog=⊢ ∀(state :α state) (prog :dec list). can_type_prog state prog ⇔ ∃(new_tids :num -> bool) (new_tenv :type_env). DISJOINT state.type_ids new_tids ∧ type_ds T state.tenv prog new_tids new_tenv
semantics_def=⊢ ∀(state :α state) (prelude :dec list) (input :string). semantics state prelude input = case parse (lexer_fun input) of (NONE :dec list option) => CannotParse | SOME prog => if can_type_prog state (prelude ++ prog) then Execute (semantics_prog state.sem_st state.sem_env (prelude ++ prog)) else IllTyped
prim_list_lookup=⊢ nsLookup prim_tenv.t (Short «list» :(mlstring, mlstring) id) = SOME ([«'a»],Tapp [Tvar «'a»] (6 :num))
prim_cons_lookup=⊢ nsLookup prim_tenv.c (Short «::» :(mlstring, mlstring) id) = SOME ([«'a»],[Tvar «'a»; Tapp [Tvar «'a»] (6 :num)],(6 :num))
