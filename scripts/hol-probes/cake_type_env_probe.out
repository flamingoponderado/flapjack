freevars=⊢ (∀(tvs :mlstring list) (tv :mlstring) (dbmax :num). check_freevars dbmax tvs (Tvar tv) ⇔ MEM tv tvs) ∧ (∀(tvs :mlstring list) (ts :t list) (tn :num) (dbmax :num). check_freevars dbmax tvs (Tapp ts tn) ⇔ EVERY (λ(a :t). check_freevars dbmax tvs a) ts) ∧ ∀(tvs :mlstring list) (n :num) (dbmax :num). check_freevars dbmax tvs (Tvar_db n) ⇔ n < dbmax
freevars_ast=⊢ (∀(tvs :mlstring list) (tv :mlstring). check_freevars_ast tvs (Atvar tv) ⇔ MEM tv tvs) ∧ (∀(tvs :mlstring list) (ts :ast_t list). check_freevars_ast tvs (Attup ts) ⇔ EVERY (λ(a :ast_t). check_freevars_ast tvs a) ts) ∧ (∀(tvs :mlstring list) (t2 :ast_t) (t1 :ast_t). check_freevars_ast tvs (Atfun t1 t2) ⇔ check_freevars_ast tvs t1 ∧ check_freevars_ast tvs t2) ∧ ∀(tvs :mlstring list) (ts :ast_t list) (tn :(mlstring, mlstring) id). check_freevars_ast tvs (Atapp ts tn) ⇔ EVERY (λ(a :ast_t). check_freevars_ast tvs a) ts
db_inc=⊢ (∀(tv :mlstring) (skip :num) (n :num). deBruijn_inc skip n (Tvar tv) = Tvar tv) ∧ (∀(skip :num) (n :num) (m :num). deBruijn_inc skip n (Tvar_db m) = if m < skip then Tvar_db m else Tvar_db (m + n)) ∧ ∀(ts :t list) (tn :num) (skip :num) (n :num). deBruijn_inc skip n (Tapp ts tn) = Tapp (MAP (λ(a :t). deBruijn_inc skip n a) ts) tn
db_subst=⊢ (∀(tv :mlstring) (ts :t list) (skip :num). deBruijn_subst skip ts (Tvar tv) = Tvar tv) ∧ (∀(ts :t list) (skip :num) (n :num). deBruijn_subst skip ts (Tvar_db n) = if ¬(n < skip) ∧ n < LENGTH ts + skip then ts❲n − skip❳ else if ¬(n < skip) then Tvar_db (n − LENGTH ts) else Tvar_db n) ∧ ∀(ts' :t list) (ts :t list) (tn :num) (skip :num). deBruijn_subst skip ts (Tapp ts' tn) = Tapp (MAP (λ(a :t). deBruijn_subst skip ts a) ts') tn
bind_tvar=⊢ ∀(tvs :num) (tenvE :tenv_val_exp). bind_tvar tvs tenvE = if tvs = (0 :num) then tenvE else Bind_tvar tvs tenvE
opt_bind=⊢ ∀(n :mlstring option) (tvs :num) (t :t) (tenvE :tenv_val_exp). opt_bind_name n tvs t tenvE = case n of (NONE :mlstring option) => tenvE | SOME n' => Bind_name n' tvs t tenvE
tve_lookup=⊢ (∀(n :mlstring) (inc :num). tveLookup n inc Empty = (NONE :(num # t) option)) ∧ (∀(n :mlstring) (inc :num) (tvs :num) (tenvE :tenv_val_exp). tveLookup n inc (Bind_tvar tvs tenvE) = tveLookup n (inc + tvs) tenvE) ∧ ∀(n :mlstring) (inc :num) (n' :mlstring) (tvs :num) (t :t) (tenvE :tenv_val_exp). tveLookup n inc (Bind_name n' tvs t tenvE) = if n' = n then SOME (tvs,deBruijn_inc tvs inc t) else tveLookup n inc tenvE
extend=⊢ ∀(tenv' :type_env) (tenv :type_env). extend_dec_tenv tenv' tenv = <|v := nsAppend tenv'.v tenv.v; c := nsAppend tenv'.c tenv.c; t := nsAppend tenv'.t tenv.t|>
lookup_local=⊢ ∀(id :(mlstring, mlstring) id) (tenvE :tenv_val_exp). lookup_varE id tenvE = case id of (Short x :(mlstring, mlstring) id) => tveLookup x (0 :num) tenvE | Long v4 v5 => (NONE :(num # t) option)
lookup=⊢ ∀(id :(mlstring, mlstring) id) (tenvE :tenv_val_exp) (tenv :type_env). lookup_var id tenvE tenv = case lookup_varE id tenvE of (NONE :(num # t) option) => nsLookup tenv.v id | SOME x => SOME x
num_tvs=⊢ num_tvs Empty = (0 :num) ∧ (∀(tvs :num) (tenvE :tenv_val_exp). num_tvs (Bind_tvar tvs tenvE) = tvs + num_tvs tenvE) ∧ ∀(n :mlstring) (tvs :num) (t :t) (tenvE :tenv_val_exp). num_tvs (Bind_name n tvs t tenvE) = num_tvs tenvE
bind_list=⊢ (∀(tvs :num) (tenvE :tenv_val_exp). bind_var_list tvs ([] :(mlstring # t) list) tenvE = tenvE) ∧ ∀(tvs :num) (tenvE :tenv_val_exp) (t :t) (n :mlstring) (binds :(mlstring # t) list). bind_var_list tvs ((n,t)::binds) tenvE = Bind_name n tvs t (bind_var_list tvs binds tenvE)
inc_example=⊢ deBruijn_inc (1 :num) (3 :num) (Tapp [Tvar_db (0 :num); Tvar_db (1 :num); Tvar_db (4 :num)] (7 :num)) = Tapp [Tvar_db (0 :num); Tvar_db (4 :num); Tvar_db (7 :num)] (7 :num)
subst_example=⊢ deBruijn_subst (1 :num) [Tapp ([] :t list) (5 :num); Tvar_db (7 :num)] (Tapp [Tvar_db (0 :num); Tvar_db (1 :num); Tvar_db (2 :num); Tvar_db (4 :num)] (9 :num)) = Tapp [Tvar_db (0 :num); Tapp ([] :t list) (5 :num); Tvar_db (7 :num); Tvar_db (2 :num)] (9 :num)
lookup_example=⊢ tveLookup «x» (0 :num) (Bind_tvar (2 :num) (Bind_name «x» (1 :num) (Tapp [Tvar_db (0 :num); Tvar_db (1 :num)] (4 :num)) Empty)) = SOME ((1 :num),Tapp [Tvar_db (0 :num); Tvar_db (3 :num)] (4 :num))
type_subst=⊢ (∀(tv :mlstring) (s :mlstring |-> t). type_subst s (Tvar tv) = case FLOOKUP s tv of (NONE :t option) => Tvar tv | SOME t => t) ∧ (∀(ts :t list) (tn :num) (s :mlstring |-> t). type_subst s (Tapp ts tn) = Tapp (MAP (λ(a :t). type_subst s a) ts) tn) ∧ ∀(s :mlstring |-> t) (n :num). type_subst s (Tvar_db n) = Tvar_db n
check_type_names=⊢ (∀(tv :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Atvar tv) ⇔ T) ∧ (∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Attup ts) ⇔ EVERY (λ(a :ast_t). check_type_names tenvT a) ts) ∧ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (t2 :ast_t) (t1 :ast_t). check_type_names tenvT (Atfun t1 t2) ⇔ check_type_names tenvT t1 ∧ check_type_names tenvT t2) ∧ ∀(ts :ast_t list) (tn :(mlstring, mlstring) id) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). check_type_names tenvT (Atapp ts tn) ⇔ (case nsLookup tenvT tn of (NONE :(mlstring list # t) option) => F | SOME (tvs,v2) => LENGTH tvs = LENGTH ts) ∧ EVERY (λ(a :ast_t). check_type_names tenvT a) ts
type_name_subst=⊢ (∀(tv :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). type_name_subst tenvT (Atvar tv) = Tvar tv) ∧ (∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). type_name_subst tenvT (Attup ts) = Ttup (MAP (λ(a :ast_t). type_name_subst tenvT a) ts)) ∧ (∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (t2 :ast_t) (t1 :ast_t). type_name_subst tenvT (Atfun t1 t2) = Tfn (type_name_subst tenvT t1) (type_name_subst tenvT t2)) ∧ ∀(ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tc :(mlstring, mlstring) id). type_name_subst tenvT (Atapp ts tc) = (let (args :t list) = MAP (λ(a :ast_t). type_name_subst tenvT a) ts in case nsLookup tenvT tc of (NONE :(mlstring list # t) option) => Ttup args | SOME (tvs,t) => type_subst (alist_to_fmap (ZIP (tvs,args))) t)
type_p_rules=⊢ (∀(tvs :num) (tenv :type_env) (t :t). check_freevars tvs ([] :mlstring list) t ⇒ type_p tvs tenv Pany t ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (n :mlstring) (t :t). check_freevars tvs ([] :mlstring list) t ⇒ type_p tvs tenv (Pvar n) t [(n,t)]) ∧ (∀(tvs :num) (tenv :type_env) (n :int). T ⇒ type_p tvs tenv (Plit (IntLit n)) Tint ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (c :char). T ⇒ type_p tvs tenv (Plit (Char c)) Tchar ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (s :mlstring). T ⇒ type_p tvs tenv (Plit (StrLit s)) Tstring ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (w :word8). T ⇒ type_p tvs tenv (Plit (Word8 w)) Tword8 ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (w :word64). T ⇒ type_p tvs tenv (Plit (Word64 w)) Tword64 ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (cn :(mlstring, mlstring) id) (ps :pat list) (ts :t list) (tvs' :mlstring list) (tn :num) (ts' :t list) (bindings :(mlstring # t) list). EVERY (check_freevars tvs ([] :mlstring list)) ts' ∧ LENGTH ts' = LENGTH tvs' ∧ type_ps tvs tenv ps (MAP (type_subst (alist_to_fmap (ZIP (tvs',ts')))) ts) bindings ∧ nsLookup tenv.c cn = SOME (tvs',ts,tn) ⇒ type_p tvs tenv (Pcon (SOME cn) ps) (Tapp ts' tn) bindings) ∧ (∀(tvs :num) (tenv :type_env) (ps :pat list) (ts :t list) (bindings :(mlstring # t) list). type_ps tvs tenv ps ts bindings ⇒ type_p tvs tenv (Pcon (NONE :(mlstring, mlstring) id option) ps) (Ttup ts) bindings) ∧ (∀(tvs :num) (tenv :type_env) (p :pat) (t :t) (bindings :(mlstring # t) list). type_p tvs tenv p t bindings ⇒ type_p tvs tenv (Pref p) (Tref t) bindings) ∧ (∀(tvs :num) (tenv :type_env) (pat :pat) (v :mlstring) (t :t) (bindings :(mlstring # t) list). type_p tvs tenv pat t bindings ⇒ type_p tvs tenv (Pas pat v) t (bindings ++ [(v,t)])) ∧ (∀(tvs :num) (tenv :type_env) (p :pat) (t :ast_t) (bindings :(mlstring # t) list). check_freevars_ast ([] :mlstring list) t ∧ check_type_names tenv.t t ∧ type_p tvs tenv p (type_name_subst tenv.t t) bindings ⇒ type_p tvs tenv (Ptannot p t) (type_name_subst tenv.t t) bindings) ∧ (∀(tvs :num) (tenv :type_env). T ⇒ type_ps tvs tenv ([] :pat list) ([] :t list) ([] :(mlstring # t) list)) ∧ ∀(tvs :num) (tenv :type_env) (p :pat) (ps :pat list) (t :t) (ts :t list) (bindings :(mlstring # t) list) (bindings' :(mlstring # t) list). type_p tvs tenv p t bindings ∧ type_ps tvs tenv ps ts bindings' ⇒ type_ps tvs tenv (p::ps) (t::ts) (bindings' ++ bindings)
type_name_example=⊢ type_name_subst (alist_to_ns [(«pair»,[«a»; «b»],Tapp [Tvar «a»; Tvar «b»] (9 :num))] :(mlstring, mlstring, mlstring list # t) namespace) (Atapp [Atvar «x»; Atvar «y»] (Short «pair» :(mlstring, mlstring) id)) = Tapp [Tvar «x»; Tvar «y»] (9 :num)
type_name_missing=⊢ type_name_subst (alist_to_ns ([] :(mlstring # mlstring list # t) list) :(mlstring, mlstring, mlstring list # t) namespace) (Atapp [Atvar «x»] (Short «missing» :(mlstring, mlstring) id)) = Tapp [Tvar «x»] (9 :num)
type_name_duplicates=⊢ type_name_subst (alist_to_ns [(«dup»,[«a»; «a»],Tvar «a»)] :(mlstring, mlstring, mlstring list # t) namespace) (Atapp [Atvar «x»; Atvar «y»] (Short «dup» :(mlstring, mlstring) id)) = Tvar «x»
type_of=⊢ t_of BoolT = Tbool ∧ t_of IntT = Tint ∧ t_of CharT = Tchar ∧ t_of StrT = Tstring ∧ t_of (WordT W8) = Tword8 ∧ t_of (WordT W64) = Tword64 ∧ t_of Float64T = Tdouble
supported_test=⊢ (supported_test Equal (ty :prim_type) ⇔ T) ∧ (supported_test (Compare (v0 :opb)) ty ⇔ MEM ty [IntT; CharT; WordT W8; Float64T; StrT]) ∧ (supported_test (AltCompare (v4 :opb)) ty ⇔ ty = StrT)
supported_arith=⊢ supported_arith (a :arith) IntT = (if MEM a [Add; Sub; Mul; Div; Mod] then SOME (2 :num) else (NONE :num option)) ∧ supported_arith a Float64T = (if MEM a [Abs; Neg; Sqrt] then SOME (1 :num) else if MEM a [Add; Sub; Mul; Div] then SOME (2 :num) else if MEM a [FMA] then SOME (3 :num) else (NONE :num option)) ∧ supported_arith a (WordT (v0 :word_size)) = (if MEM a [Add; Sub; And; Or; Xor] then SOME (2 :num) else (NONE :num option)) ∧ supported_arith a BoolT = (if MEM a [Not] then SOME (1 :num) else (NONE :num option)) ∧ supported_arith a CharT = (NONE :num option) ∧ supported_arith a StrT = (NONE :num option)
supported_conversion=⊢ (supported_conversion (WordT W8) IntT ⇔ T) ∧ (supported_conversion (WordT W64) IntT ⇔ T) ∧ (supported_conversion IntT (WordT W8) ⇔ T) ∧ (supported_conversion IntT (WordT W64) ⇔ T) ∧ (supported_conversion CharT IntT ⇔ T) ∧ (supported_conversion IntT CharT ⇔ T) ∧ (supported_conversion CharT (WordT W8) ⇔ T) ∧ (supported_conversion (WordT W8) CharT ⇔ T) ∧ (supported_conversion Float64T (WordT W64) ⇔ T) ∧ (supported_conversion (WordT W64) Float64T ⇔ T) ∧ (supported_conversion (from_ty :prim_type) BoolT ⇔ F) ∧ (supported_conversion BoolT IntT ⇔ F) ∧ (supported_conversion IntT IntT ⇔ F) ∧ (supported_conversion StrT IntT ⇔ F) ∧ (supported_conversion Float64T IntT ⇔ F) ∧ (supported_conversion BoolT CharT ⇔ F) ∧ (supported_conversion CharT CharT ⇔ F) ∧ (supported_conversion StrT CharT ⇔ F) ∧ (supported_conversion (WordT W64) CharT ⇔ F) ∧ (supported_conversion Float64T CharT ⇔ F) ∧ (supported_conversion from_ty StrT ⇔ F) ∧ (supported_conversion BoolT (WordT (v2 :word_size)) ⇔ F) ∧ (supported_conversion CharT (WordT W64) ⇔ F) ∧ (supported_conversion StrT (WordT v2) ⇔ F) ∧ (supported_conversion (WordT (v8 :word_size)) (WordT v2) ⇔ F) ∧ (supported_conversion Float64T (WordT W8) ⇔ F) ∧ (supported_conversion BoolT Float64T ⇔ F) ∧ (supported_conversion IntT Float64T ⇔ F) ∧ (supported_conversion CharT Float64T ⇔ F) ∧ (supported_conversion StrT Float64T ⇔ F) ∧ (supported_conversion (WordT W8) Float64T ⇔ F) ∧ (supported_conversion Float64T Float64T ⇔ F)
type_op=⊢ ∀(op :op) (ts :t list) (t :t). type_op op ts t ⇔ case (op,ts) of (Arith a ty,ts) => EVERY (λ(arg :t). arg = t_of ty) ts ∧ t = t_of ty ∧ supported_arith a ty = SOME (LENGTH ts) | (FromTo ty1 ty2,([] :t list)) => F | (FromTo ty1 ty2,[t1'³']) => t1'³' = t_of ty1 ∧ t = t_of ty2 ∧ supported_conversion ty1 ty2 | (FromTo ty1 ty2,t1'³'::v32::v33) => F | (Shift v19 v20 v21,([] :t list)) => F | (Shift W8 v20 v21,[t1']) => t1' = Tword8 ∧ t = Tword8 | (Shift W64 v20 v21,[t1']) => t1' = Tword64 ∧ t = Tword64 | (Shift v19 v20 v21,t1'::v40::v41) => F | (Equality,([] :t list)) => F | (Equality,[t1'']) => F | (Equality,[t1''; t2']) => t1'' = t2' ∧ t = Tbool | (Equality,t1''::t2'::v52::v53) => F | (Test test ty',([] :t list)) => F | (Test test ty',[t1'⁴']) => F | (Test test ty',[t1'⁴'; t2'']) => t1'⁴' = t2'' ∧ t = Tbool ∧ t1'⁴' = t_of ty' ∧ supported_test test ty' | (Test test ty',t1'⁴'::t2''::v64::v65) => F | (Opapp,([] :t list)) => F | (Opapp,[t1]) => F | (Opapp,[t1; t2]) => t1 = Tfn t2 t | (Opapp,t1::t2::v76::v77) => F | (Opassign,([] :t list)) => F | (Opassign,[t1'⁵']) => F | (Opassign,[t1'⁵'; t2'³']) => t1'⁵' = Tref t2'³' ∧ t = Ttup ([] :t list) | (Opassign,t1'⁵'::t2'³'::v88::v89) => F | (Opref,([] :t list)) => F | (Opref,[t1'⁶']) => t = Tref t1'⁶' | (Opref,t1'⁶'::v96::v97) => F | (Opderef,([] :t list)) => F | (Opderef,[t1'⁷']) => t1'⁷' = Tref t | (Opderef,t1'⁷'::v104::v105) => F | (Aw8alloc,([] :t list)) => F | (Aw8alloc,[t1'⁸']) => F | (Aw8alloc,[t1'⁸'; t2'⁴']) => t1'⁸' = Tint ∧ t2'⁴' = Tword8 ∧ t = Tword8array | (Aw8alloc,t1'⁸'::t2'⁴'::v116::v117) => F | (Aw8sub,([] :t list)) => F | (Aw8sub,[t1'⁹']) => F | (Aw8sub,[t1'⁹'; t2'⁵']) => t1'⁹' = Tword8array ∧ t2'⁵' = Tint ∧ t = Tword8 | (Aw8sub,t1'⁹'::t2'⁵'::v128::v129) => F | (Aw8length,([] :t list)) => F | (Aw8length,[t1'¹⁰']) => t1'¹⁰' = Tword8array ∧ t = Tint | (Aw8length,t1'¹⁰'::v136::v137) => F | (Aw8update,([] :t list)) => F | (Aw8update,[t1'¹¹']) => F | (Aw8update,[t1'¹¹'; t2'⁶']) => F | (Aw8update,[t1'¹¹'; t2'⁶'; t3]) => t1'¹¹' = Tword8array ∧ t2'⁶' = Tint ∧ t3 = Tword8 ∧ t = Ttup ([] :t list) | (Aw8update,t1'¹¹'::t2'⁶'::t3::v152::v153) => F | (CopyStrStr,([] :t list)) => F | (CopyStrStr,[t1'¹²']) => F | (CopyStrStr,[t1'¹²'; t2'⁷']) => F | (CopyStrStr,[t1'¹²'; t2'⁷'; t3']) => t1'¹²' = Tstring ∧ t2'⁷' = Tint ∧ t3' = Tint ∧ t = Tstring | (CopyStrStr,t1'¹²'::t2'⁷'::t3'::v168::v169) => F | (CopyStrAw8,([] :t list)) => F | (CopyStrAw8,[t1'¹³']) => F | (CopyStrAw8,[t1'¹³'; t2'⁸']) => F | (CopyStrAw8,[t1'¹³'; t2'⁸'; t3'']) => F | (CopyStrAw8,[t1'¹³'; t2'⁸'; t3''; t4]) => F | (CopyStrAw8,[t1'¹³'; t2'⁸'; t3''; t4; t5]) => t1'¹³' = Tstring ∧ t2'⁸' = Tint ∧ t3'' = Tint ∧ t4 = Tword8array ∧ t5 = Tint ∧ t = Ttup ([] :t list) | (CopyStrAw8,t1'¹³'::t2'⁸'::t3''::t4::t5::v192::v193) => F | (CopyAw8Str,([] :t list)) => F | (CopyAw8Str,[t1'¹⁴']) => F | (CopyAw8Str,[t1'¹⁴'; t2'⁹']) => F | (CopyAw8Str,[t1'¹⁴'; t2'⁹'; t3'³']) => t1'¹⁴' = Tword8array ∧ t2'⁹' = Tint ∧ t3'³' = Tint ∧ t = Tstring | (CopyAw8Str,t1'¹⁴'::t2'⁹'::t3'³'::v208::v209) => F | (CopyAw8Aw8,([] :t list)) => F | (CopyAw8Aw8,[t1'¹⁵']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰'; t3'⁴']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰'; t3'⁴'; t4']) => F | (CopyAw8Aw8,[t1'¹⁵'; t2'¹⁰'; t3'⁴'; t4'; t5']) => t1'¹⁵' = Tword8array ∧ t2'¹⁰' = Tint ∧ t3'⁴' = Tint ∧ t4' = Tword8array ∧ t5' = Tint ∧ t = Ttup ([] :t list) | (CopyAw8Aw8,t1'¹⁵'::t2'¹⁰'::t3'⁴'::t4'::t5'::v232::v233) => F | (XorAw8Str_unsafe,ts) => F | (Implode,([] :t list)) => F | (Implode,[t1'¹⁶']) => t1'¹⁶' = Tlist Tchar ∧ t = Tstring | (Implode,t1'¹⁶'::v240::v241) => F | (Explode,([] :t list)) => F | (Explode,[t1'¹⁷']) => t1'¹⁷' = Tstring ∧ t = Tlist Tchar | (Explode,t1'¹⁷'::v248::v249) => F | (Strsub,([] :t list)) => F | (Strsub,[t1'¹⁸']) => F | (Strsub,[t1'¹⁸'; t2'¹¹']) => t1'¹⁸' = Tstring ∧ t2'¹¹' = Tint ∧ t = Tchar | (Strsub,t1'¹⁸'::t2'¹¹'::v260::v261) => F | (Strlen,([] :t list)) => F | (Strlen,[t1'¹⁹']) => t1'¹⁹' = Tstring ∧ t = Tint | (Strlen,t1'¹⁹'::v