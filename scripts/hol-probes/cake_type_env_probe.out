) => F | (Vsub_unsafe,ts) => F | (Asub_unsafe,ts) => F | (Aupdate_unsafe,ts) => F | (Aw8sub_unsafe,ts) => F | (Aw8update_unsafe,ts) => F | (ThunkOp v24,ts) => F | (ListAppend,([] :t list)) => F | (ListAppend,Tvar v418::v413) => F | (ListAppend,Tvar_db v419::v413) => F | (ListAppend,Tapp ([] :t list) ctor'³'::v413) => F | (ListAppend,[Tapp (t1'³¹'::v425) ctor'³']) => F | (ListAppend,[Tapp [t1'³¹'] ctor'³'; t2'¹⁸']) => ctor'³' = Tlist_num ∧ t2'¹⁸' = Tapp [t1'³¹'] ctor'³' ∧ t = t2'¹⁸' | (ListAppend,[Tapp (t1'³¹'::v436::v437) ctor'³'; t2'¹⁸']) => F | (ListAppend,Tapp (t1'³¹'::v425) ctor'³'::t2'¹⁸'::v432::v433) => F | (ConfigGC,([] :t list)) => F | (ConfigGC,[t1'²⁹']) => F | (ConfigGC,[t1'²⁹'; t2'¹⁶']) => t1'²⁹' = Tint ∧ t2'¹⁶' = Tint ∧ t = Ttup ([] :t list) | (ConfigGC,t1'²⁹'::t2'¹⁶'::v448::v449) => F | (FFI n,([] :t list)) => F | (FFI n,[t1'³⁰']) => F | (FFI n,[t1'³⁰'; t2'¹⁷']) => t1'³⁰' = Tstring ∧ t2'¹⁷' = Tword8array ∧ t = Ttup ([] :t list) | (FFI n,t1'³⁰'::t2'¹⁷'::v460::v461) => F | (Eval,ts) => F | (Env_id,ts) => F
type_e_rules=⊢ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :int). T ⇒ type_e tenv tenvE (Lit (IntLit n)) Tint) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (c :char). T ⇒ type_e tenv tenvE (Lit (Char c)) Tchar) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (s :mlstring). T ⇒ type_e tenv tenvE (Lit (StrLit s)) Tstring) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word8). T ⇒ type_e tenv tenvE (Lit (Word8 w)) Tword8) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word64). T ⇒ type_e tenv tenvE (Lit (Word64 w)) Tword64) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word64). T ⇒ type_e tenv tenvE (Lit (Float64 w)) Tdouble) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :t). check_freevars (num_tvs tenvE) ([] :mlstring list) t ∧ type_e tenv tenvE e Texn ⇒ type_e tenv tenvE (Raise e) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (pes :(pat # exp) list) (t :t). type_e tenv tenvE e t ∧ pes ≠ ([] :(pat # exp) list) ∧ (∀((p :pat),(e :exp))::set pes. ∃(bindings :(mlstring # t) list). ALL_DISTINCT (pat_bindings p) ∧ type_p (num_tvs tenvE) tenv p Texn bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t) ⇒ type_e tenv tenvE (Handle e pes) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (cn :(mlstring, mlstring) id) (es :exp list) (tvs :mlstring list) (tn :num) (ts' :t list) (ts :t list). EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) ts' ∧ LENGTH tvs = LENGTH ts' ∧ type_es tenv tenvE es (MAP (type_subst (alist_to_fmap (ZIP (tvs,ts')))) ts) ∧ nsLookup tenv.c cn = SOME (tvs,ts,tn) ⇒ type_e tenv tenvE (Con (SOME cn) es) (Tapp ts' tn)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (es :exp list) (ts :t list). type_es tenv tenvE es ts ⇒ type_e tenv tenvE (Con (NONE :(mlstring, mlstring) id option) es) (Ttup ts)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :(mlstring, mlstring) id) (t :t) (targs :t list) (tvs :num). tvs = LENGTH targs ∧ EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) targs ∧ lookup_var n tenvE tenv = SOME (tvs,t) ⇒ type_e tenv tenvE (Var n) (deBruijn_subst (0 :num) targs t)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :mlstring) (e :exp) (t1 :t) (t2 :t). check_freevars (num_tvs tenvE) ([] :mlstring list) t1 ∧ type_e tenv (Bind_name n (0 :num) t1 tenvE) e t2 ⇒ type_e tenv tenvE (Fun n e) (Tfn t1 t2)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (op :op) (es :exp list) (ts :t list) (t :t). type_es tenv tenvE es ts ∧ type_op op ts t ∧ check_freevars (num_tvs tenvE) ([] :mlstring list) t ⇒ type_e tenv tenvE (App op es) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (l :lop) (e1 :exp) (e2 :exp). type_e tenv tenvE e1 Tbool ∧ type_e tenv tenvE e2 Tbool ⇒ type_e tenv tenvE (Log l e1 e2) Tbool) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e1 :exp) (e2 :exp) (e3 :exp) (t :t). type_e tenv tenvE e1 Tbool ∧ type_e tenv tenvE e2 t ∧ type_e tenv tenvE e3 t ⇒ type_e tenv tenvE (If e1 e2 e3) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (pes :(pat # exp) list) (t1 :t) (t2 :t). type_e tenv tenvE e t1 ∧ pes ≠ ([] :(pat # exp) list) ∧ (∀((p :pat),(e :exp))::set pes. ∃(bindings :(mlstring # t) list). ALL_DISTINCT (pat_bindings p) ∧ type_p (num_tvs tenvE) tenv p t1 bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t2) ⇒ type_e tenv tenvE (Mat e pes) t2) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :mlstring option) (e1 :exp) (e2 :exp) (t1 :t) (t2 :t). type_e tenv tenvE e1 t1 ∧ type_e tenv (opt_bind_name n (0 :num) t1 tenvE) e2 t2 ⇒ type_e tenv tenvE (Let n e1 e2) t2) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (funs :(mlstring # mlstring # exp) list) (e :exp) (t :t) (bindings :(mlstring # t) list). type_funs tenv (bind_var_list (0 :num) bindings tenvE) funs bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t ⇒ type_e tenv tenvE (Letrec funs e) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :ast_t). check_freevars_ast ([] :mlstring list) t ∧ check_type_names tenv.t t ∧ type_e tenv tenvE e (type_name_subst tenv.t t) ⇒ type_e tenv tenvE (Tannot e t) (type_name_subst tenv.t t)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (l :locs) (t :t). type_e tenv tenvE e t ⇒ type_e tenv tenvE (Lannot e l) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp). T ⇒ type_es tenv tenvE ([] :exp list) ([] :t list)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (es :exp list) (t :t) (ts :t list). type_e tenv tenvE e t ∧ type_es tenv tenvE es ts ⇒ type_es tenv tenvE (e::es) (t::ts)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp). T ⇒ type_funs tenv tenvE ([] :(mlstring # mlstring # exp) list) ([] :(mlstring # t) list)) ∧ ∀(tenv :type_env) (tenvE :tenv_val_exp) (fn :mlstring) (n :mlstring) (e :exp) (funs :(mlstring # mlstring # exp) list) (bindings :(mlstring # t) list) (t1 :t) (t2 :t). check_freevars (num_tvs tenvE) ([] :mlstring list) (Tfn t1 t2) ∧ type_e tenv (Bind_name n (0 :num) t1 tenvE) e t2 ∧ type_funs tenv tenvE funs bindings ∧ ALOOKUP bindings fn = (NONE :t option) ⇒ type_funs tenv tenvE ((fn,n,e)::funs) ((fn,Tfn t1 t2)::bindings)
arith_good=⊢ type_op (Arith Add IntT) [Tint; Tint] Tint ⇔ T
arith_bad_arity=⊢ type_op (Arith Add IntT) [Tint] Tint ⇔ F
empty_array=⊢ type_op AallocEmpty [Ttup ([] :t list)] (Tarray Tint) ⇔ $? ($= (Tapp ([] :t list) (5 :num)))
unsafe_op=⊢ type_op Aw8sub_unsafe [Tword8array; Tint] Tword8 ⇔ F
