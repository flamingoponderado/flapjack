store_list_code_full_def=(∀t a. store_list_code a t [] = Skip) ∧ (∀xs w t a. store_list_code a t (INL w::xs) = Seq (list_Seq [Inst (Const t w); Inst (Mem Store t (Addr a 0w)); Inst (Arith (Binop Add a a (Imm bytes_in_word)))]) (store_list_code a t xs)) ∧ ∀xs t i a. store_list_code a t (INR i::xs) = Seq (list_Seq [Inst (Mem Store i (Addr a 0w)); Inst (Arith (Binop Add a a (Imm bytes_in_word)))]) (store_list_code a t xs)
store_list_code_type=:num -> num -> (α word + num) list -> α prog
