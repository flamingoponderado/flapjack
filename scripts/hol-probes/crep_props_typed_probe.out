assigned_free_vars_IMP_assigned_vars_typed=∀(prog :α crepLang$prog) (x :num). MEM x (assigned_free_vars prog) ⇒ MEM x (assigned_vars prog)
assigned_free_vars_nested_decs_append_typed=∀(ns :num list) (es :α crepLang$exp list) (p :α crepLang$prog). LENGTH ns = LENGTH es ⇒ assigned_free_vars (nested_decs ns es p) = FILTER (λ(x :num). ¬MEM x ns) (assigned_free_vars p)
nested_seq_assigned_free_vars_eq_typed=∀(ns :num list) (vs :α crepLang$exp list). LENGTH ns = LENGTH vs ⇒ assigned_free_vars (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns vs :α crepLang$prog list)) = ns
assigned_free_vars_store_globals_empty_typed=∀(es :α crepLang$exp list) (ad :word5). assigned_free_vars (nested_seq (store_globals ad es)) = ([] :num list)
assigned_free_vars_seq_store_empty_typed=∀(es :α crepLang$exp list) (ad :α crepLang$exp) (a :α word). assigned_free_vars (nested_seq (stores ad es a)) = ([] :num list)
assigned_vars_nested_decs_append_typed=∀(ns :num list) (es :α crepLang$exp list) (p :α crepLang$prog). LENGTH ns = LENGTH es ⇒ assigned_vars (nested_decs ns es p) = ns ++ assigned_vars p
nested_seq_assigned_vars_eq_typed=∀(ns :num list) (vs :α crepLang$exp list). LENGTH ns = LENGTH vs ⇒ assigned_vars (nested_seq (MAP2 (Assign :num -> α crepLang$exp -> α crepLang$prog) ns vs :α crepLang$prog list)) = ns
assigned_vars_store_globals_empty_typed=∀(es :α crepLang$exp list) (ad :word5). assigned_vars (nested_seq (store_globals ad es)) = ([] :num list)
assigned_vars_seq_store_empty_typed=∀(es :α crepLang$exp list) (ad :α crepLang$exp) (a :α word). assigned_vars (nested_seq (stores ad es a)) = ([] :num list)
every_exp_def_typed=(∀(w :α word) (P :α crepLang$exp -> bool). every_exp P (Const w :α crepLang$exp) ⇔ P (Const w :α crepLang$exp)) ∧ (∀(v :num) (P :α crepLang$exp -> bool). every_exp P (Var v :α crepLang$exp) ⇔ P (Var v :α crepLang$exp)) ∧ (∀(e :α crepLang$exp) (P :α crepLang$exp -> bool). every_exp P (Load e :α crepLang$exp) ⇔ P (Load e :α crepLang$exp) ∧ every_exp P e) ∧ (∀(e :α crepLang$exp) (P :α crepLang$exp -> bool). every_exp P (Load32 e :α crepLang$exp) ⇔ P (Load32 e :α crepLang$exp) ∧ every_exp P e) ∧ (∀(e :α crepLang$exp) (P :α crepLang$exp -> bool). every_exp P (LoadByte e) ⇔ P (LoadByte e) ∧ every_exp P e) ∧ (∀(w :word5) (P :α crepLang$exp -> bool). every_exp P (LoadGlob w :α crepLang$exp) ⇔ P (LoadGlob w :α crepLang$exp)) ∧ (∀(es :α crepLang$exp list) (bop :binop) (P :α crepLang$exp -> bool). every_exp P (Op bop es) ⇔ P (Op bop es) ∧ EVERY (λ(a :α crepLang$exp). every_exp P a) es) ∧ (∀(op :crepop) (es :α crepLang$exp list) (P :α crepLang$exp -> bool). every_exp P (Crepop op es) ⇔ P (Crepop op es) ∧ EVERY (λ(a :α crepLang$exp). every_exp P a) es) ∧ (∀(e2 :α crepLang$exp) (e1 :α crepLang$exp) (c :cmp) (P :α crepLang$exp -> bool). every_exp P (Cmp c e1 e2) ⇔ P (Cmp c e1 e2) ∧ every_exp P e1 ∧ every_exp P e2) ∧ (∀(sh :ast$shift) (e2 :α crepLang$exp) (e1 :α crepLang$exp) (P :α crepLang$exp -> bool). every_exp P (Shift sh e1 e2 :α crepLang$exp) ⇔ P (Shift sh e1 e2 :α crepLang$exp) ∧ every_exp P e1 ∧ every_exp P e2) ∧ (∀(P :α crepLang$exp -> bool). every_exp P (BaseAddr :α crepLang$exp) ⇔ P (BaseAddr :α crepLang$exp)) ∧ ∀(P :α crepLang$exp -> bool). every_exp P (TopAddr :α crepLang$exp) ⇔ P (TopAddr :α crepLang$exp)
var_exp_load_shape_typed=∀(i :num) (a :α word) (e :α crepLang$exp) (n :α crepLang$exp). MEM n (load_shape a i e) ⇒ var_cexp n = var_cexp e
exps_of_def_typed=(∀(v0 :num) (p :α crepLang$prog) (e :α crepLang$exp). (exps_of (Dec v0 e p :α crepLang$prog) :α crepLang$exp list) = e::(exps_of p :α crepLang$exp list)) ∧ (∀(q :α crepLang$prog) (p :α crepLang$prog). (exps_of (Seq p q) :α crepLang$exp list) = (exps_of p :α crepLang$exp list) ++ (exps_of q :α crepLang$exp list)) ∧ (∀(q :α crepLang$prog) (p :α crepLang$prog) (e :α crepLang$exp). (exps_of (If e p q :α crepLang$prog) :α crepLang$exp list) = e::(exps_of p :α crepLang$exp list) ++ (exps_of q :α crepLang$exp list)) ∧ (∀(p :α crepLang$prog) (e :α crepLang$exp). (exps_of (While e p :α crepLang$prog) :α crepLang$exp list) = e::(exps_of p :α crepLang$exp list)) ∧ (∀(es :α crepLang$exp list) (e :mlstring). (exps_of (Call (NONE :(num list # (α word # α crepLang$prog) option) option) e es :α crepLang$prog) :α crepLang$exp list) = es) ∧ (∀(v1 :num list) (es :α crepLang$exp list) (e :mlstring). (exps_of (Call (SOME (v1,(NONE :(α word # α crepLang$prog) option))) e es :α crepLang$prog) :α crepLang$exp list) = es) ∧ (∀(v3 :α word) (v2 :num list) (p' :α crepLang$prog) (es :α crepLang$exp list) (e :mlstring). (exps_of (Call (SOME (v2,SOME (v3,p'))) e es :α crepLang$prog) :α crepLang$exp list) = es ++ (exps_of p' :α crepLang$exp list)) ∧ (∀(e2 :α crepLang$exp) (e1 :α crepLang$exp). (exps_of (Store e1 e2 :α crepLang$prog) :α crepLang$exp list) = [e1; e2]) ∧ (∀(e2 :α crepLang$exp) (e1 :α crepLang$exp). (exps_of (Store32 e1 e2 :α crepLang$prog) :α crepLang$exp list) = [e1; e2]) ∧ (∀(e2 :α crepLang$exp) (e1 :α crepLang$exp). (exps_of (StoreByte e1 e2 :α crepLang$prog) :α crepLang$exp list) = [e1; e2]) ∧ (∀(v4 :word5) (e :α crepLang$exp). (exps_of (StoreGlob v4 e) :α crepLang$exp list) = [e]) ∧ (∀(es :α crepLang$exp list). (exps_of (Return es :α crepLang$prog) :α crepLang$exp list) = es) ∧ (∀(v5 :num) (e :α crepLang$exp). (exps_of (Assign v5 e :α crepLang$prog) :α crepLang$exp list) = [e]) ∧ (∀(v7 :num) (v6 :memop) (e :α crepLang$exp). (exps_of (ShMem v6 v7 e) :α crepLang$exp list) = [e]) ∧ (exps_of (Skip :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list) ∧ (∀(v15 :num list) (v14 :primop) (v13 :num list). (exps_of (Primitive v13 v14 v15 :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list)) ∧ (∀(v31 :num). (exps_of (Break v31 :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list)) ∧ (∀(v32 :num). (exps_of (Continue v32 :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list)) ∧ (∀(v40 :num) (v39 :num) (v38 :num) (v37 :num) (v36 :mlstring). (exps_of (ExtCall v36 v37 v38 v39 v40 :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list)) ∧ (∀(v41 :α word). (exps_of (Raise v41 :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list)) ∧ (exps_of (Tick :α crepLang$prog) :α crepLang$exp list) = ([] :α crepLang$exp list)
evaluate_io_events_mono_typed=∀(exps :α crepLang$prog) (s1 :(α, β) state) (res :α result option) (s2 :(α, β) state). (evaluate (exps,s1) :α result option # (α, β) state) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
sh_mem_load_FLOOKUP_locals_typed=(sh_mem_load (v :num) (addr :β word) (nb :num) (s :(β, γ) state) :α result option # (β, γ) state) = ((res :α result option),(t :(β, γ) state)) ∧ (n :num) ≠ v ∧ (res = (NONE :α result option) ∨ res = SOME (Continue (k :num) :α result) ∨ res = SOME (Break k :α result)) ⇒ FLOOKUP t.locals n = FLOOKUP s.locals n
sh_mem_store_FLOOKUP_locals_typed=(sh_mem_store (v :num) (addr :β word) (nb :num) (s :(β, γ) state) :α result option # (β, γ) state) = ((res :α result option),(t :(β, γ) state)) ⇒ FLOOKUP t.locals (n :num) = FLOOKUP s.locals n
unassigned_free_vars_evaluate_same_typed=∀(p :α crepLang$prog) (s :(α, β) state) (res :α result option) (t :(α, β) state) (n :num) (k :num). (evaluate (p,s) :α result option # (α, β) state) = (res,t) ∧ (res = (NONE :α result option) ∨ res = SOME (Continue k :α result) ∨ res = SOME (Break k :α result)) ∧ ¬MEM n (assigned_free_vars p) ⇒ FLOOKUP t.locals n = FLOOKUP s.locals n
dec_clock_simp_typed=(dec_clock (s :(α, β) state)).locals = s.locals ∧ (dec_clock s).globals = s.globals ∧ (dec_clock s).code = s.code ∧ (dec_clock s).memory = s.memory ∧ (dec_clock s).memaddrs = s.memaddrs ∧ (dec_clock s).sh_memaddrs = s.sh_memaddrs ∧ ((dec_clock s).be ⇔ s.be) ∧ (dec_clock s).ffi = s.ffi ∧ (dec_clock s).base_addr = s.base_addr ∧ (dec_clock s).top_addr = s.top_addr
empty_locals_simp_typed=(empty_locals (s :(α, β) state)).globals = s.globals ∧ (empty_locals s).code = s.code ∧ (empty_locals s).memory = s.memory ∧ (empty_locals s).memaddrs = s.memaddrs ∧ (empty_locals s).sh_memaddrs = s.sh_memaddrs ∧ (empty_locals s).clock = s.clock ∧ ((empty_locals s).be ⇔ s.be) ∧ (empty_locals s).ffi = s.ffi ∧ (empty_locals s).base_addr = s.base_addr ∧ (empty_locals s).top_addr = s.top_addr
eval_upd_clock_eq_typed=∀(t :(α, β) state) (e :α crepLang$exp) (ck :num). (eval (t with clock := ck) e :α word_lab option) = (eval t e :α word_lab option)
opt_mmap_eval_upd_clock_eq_typed=∀(es :α crepLang$exp list) (s :(α, β) state) (ck :num). OPT_MMAP (eval (s with clock := ck + s.clock) :α crepLang$exp -> α word_lab option) es = OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es
eval_load_shape_el_rel_typed=∀(m :num) (n :num) (a :α word) (t :(α, β) state) (e :α crepLang$exp). n < m ⇒ (eval t (load_shape a m e)❲n❳ :α word_lab option) = (eval t (Load (Op Add [e; (Const (a + (bytes_in_word :α word) * (n2w n :α word)) :α crepLang$exp)]) :α crepLang$exp) :α word_lab option)
evaluate_code_invariant_typed=∀(p :α crepLang$prog) (t :(α, β) state) (res :α result option) (st :(α, β) state). (evaluate (p,t) :α result option # (α, β) state) = (res,st) ⇒ st.code = t.code
evaluate_seq_store_globals_res_typed=∀(vars :num list) (vs :α word_lab list) (t :(α, β) state) (a :word5). ALL_DISTINCT vars ∧ LENGTH vars = LENGTH vs ∧ w2n a + LENGTH vs ≤ (32 :num) ⇒ (evaluate (nested_seq (store_globals a (MAP (Var :num -> α crepLang$exp) vars)),t with locals := t.locals |++ ZIP (vars,vs)) :α result option # (α, β) state) = ((NONE :α result option),t with <|locals := t.locals |++ ZIP (vars,vs); globals := t.globals |++ ZIP (GENLIST (λ(x :num). a + (n2w x :word5)) (LENGTH vs),vs)|>)
evaluate_seq_stroes_locals_eq_typed=∀(es :α crepLang$exp list) (ad :α crepLang$exp) (a :α word) (s :(α, β) state) (res :α result option) (t :(α, β) state). (evaluate (nested_seq (stores ad es a),s) :α result option # (α, β) state) = (res,t) ⇒ t.locals = s.locals
evaluate_seq_stores_mem_state_rel_typed=∀(es :num list) (vs :α word_lab list) (ad :num) (a :α word) (s :(α, β) state) (res :α result option) (t :(α, β) state) (addr :α word) (m :α word -> α word_lab). LENGTH es = LENGTH vs ∧ ¬MEM ad es ∧ ALL_DISTINCT es ∧ mem_stores (addr + a) vs s.memaddrs s.memory = SOME m ∧ (evaluate (nested_seq (stores (Var ad :α crepLang$exp) (MAP (Var :num -> α crepLang$exp) es) a),s with locals := s.locals |++ ((ad,(Word addr :α word_lab))::ZIP (es,vs))) :α result option # (α, β) state) = (res,t) ⇒ res = (NONE :α result option) ∧ t.memory = m ∧ t.memaddrs = s.memaddrs ∧ t.sh_memaddrs = s.sh_memaddrs ∧ (t.be ⇔ s.be) ∧ t.ffi = s.ffi ∧ t.code = s.code ∧ t.clock = s.clock ∧ t.base_addr = s.base_addr ∧ t.top_addr = s.top_addr
flookup_res_var_diff_eq_typed=(n :α) ≠ (m :α) ⇒ FLOOKUP (res_var (l :α |-> β) (m,(v :β option))) n = FLOOKUP l n
flookup_res_var_distinct_zip_eq_typed=LENGTH (xs :α list) = LENGTH (ys :β option list) ∧ ¬MEM (x :α) xs ⇒ FLOOKUP (FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) (fm :α |-> β) (ZIP (xs,ys))) x = FLOOKUP fm x
flookup_res_var_thm_typed=FLOOKUP (res_var (l :β |-> α) ((m :β),(v :α option))) (n :β) = if n = m then v else FLOOKUP l n
FLOOKUP_set_globals_typed=FLOOKUP (set_globals (gv :word5) (w :α word_lab) (s :(α, β) state)).locals (n :num) = FLOOKUP s.locals n
length_load_shape_eq_shape_typed=∀(n :num) (a :α word) (e :α crepLang$exp). LENGTH (load_shape a n e) = n
var_cexp_load_globals_empty_typed=∀(ads :num) (a :word5). FLAT (MAP (var_cexp :α crepLang$exp -> num list) (load_globals a ads :α crepLang$exp list)) = ([] :num list)
el_load_globals_elem_typed=∀(ads :num) (a :word5) (n :num). n < ads ⇒ (load_globals a ads :α crepLang$exp list)❲n❳ = (LoadGlob (a + (n2w n :word5)) :α crepLang$exp)
length_load_globals_eq_read_size_typed=∀(ads :num) (a :word5). LENGTH (load_globals a ads :α crepLang$exp list) = ads
lookup_locals_eq_map_vars_typed=∀(ns :num list) (t :(α, β) state). OPT_MMAP (FLOOKUP t.locals) ns = OPT_MMAP (eval t :α crepLang$exp -> α word_lab option) (MAP (Var :num -> α crepLang$exp) ns)
map_var_cexp_eq_var_typed=∀(vs :num list). FLAT (MAP (var_cexp :α crepLang$exp -> num list) (MAP (Var :num -> α crepLang$exp) vs)) = vs
res_var_lookup_original_eq_typed=∀(xs :α list) (ys :β list) (lc :α |-> β). ALL_DISTINCT xs ∧ LENGTH xs = LENGTH ys ⇒ FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) (lc |++ ZIP (xs,ys)) (ZIP (xs,MAP (FLOOKUP lc) xs)) = lc
update_locals_not_vars_eval_eq_typed=∀(s :(α, β) state) (e :α crepLang$exp) (v :α word_lab) (n :num) (w :α word_lab). ¬MEM n (var_cexp e) ∧ (eval s e :α word_lab option) = SOME v ⇒ (eval (s with locals := s.locals⟨n ↦ w⟩) e :α word_lab option) = SOME v
eval_some_var_cexp_local_lookup_typed=∀(s :(α, β) state) (e :α crepLang$exp) (v :α word_lab) (n :num). (eval s e :α word_lab option) = SOME v ∧ MEM n (var_cexp e) ⇒ ∃(w :α word_lab). FLOOKUP s.locals n = SOME w
opt_mmap_eval_some_var_cexp_local_lookup_typed=∀(s :(α, β) state) (es :α crepLang$exp list) (vs :α word_lab list) (n :num). OPT_MMAP (eval s :α crepLang$exp -> α word_lab option) es = SOME vs ∧ MEM n (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es)) ⇒ ∃(w :α word_lab). FLOOKUP s.locals n = SOME w
evaluate_add_clock_eq_typed=∀(p :α crepLang$prog) (t :(α, β) state) (res :α result option) (st :(α, β) state) (ck :num). (evaluate (p,t) :α result option # (α, β) state) = (res,st) ∧ res ≠ SOME (TimeOut :α result) ⇒ (evaluate (p,t with clock := t.clock + ck) :α result option # (α, β) state) = (res,st with clock := st.clock + ck)
evaluate_add_clock_io_events_mono_typed=∀(exps :α crepLang$prog) (s :(α, β) state) (extra :num). (SND (evaluate (exps,s) :α result option # (α, β) state)).ffi.io_events ≼ (SND (evaluate (exps,s with clock := s.clock + extra) :α result option # (α, β) state)).ffi.io_events
mem_load_flat_rel_typed=∀(sh :shape) (adr :α word) (s :(α, β) state) (v :α v) (n :num). (mem_load sh adr s.memaddrs s.memory (stcs :(mlstring # struct_info) list) :α v option) = SOME v ∧ n < LENGTH (flatten v) ∧ is_wf_shape_nil sh ⇒ (mem_load (adr + (bytes_in_word :α word) * (n2w (LENGTH (TAKE n (flatten v))) :α word)) s :α word_lab option) = SOME (flatten v)❲n❳
