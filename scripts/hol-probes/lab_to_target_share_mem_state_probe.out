smsr_def=∀(mc_conf :(β, γ, δ) machine_config) (s1 :(α, config, 'ffi) labSem$state) (t1 :ε) (ms1 :ζ). share_mem_state_rel mc_conf s1 t1 ms1 ⇔ (∀(ms2 :γ) (k :num) (index :num) (new_bytes :word8 list) (t1 :β asm_state) (nb :word8) (ad :num) (offs :β word) (re :num) (pc' :β word) (ad' :β word) (st :'ffi ffi_state) (new_st :'ffi ffi_state) (i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ i ≤ index ∧ index < LENGTH mc_conf.ffi_names ∧ (call_FFI_rel :'ffi ffi_state -> 'ffi ffi_state -> bool)꙳ s1.ffi st ∧ ALOOKUP mc_conf.mmio_info index = SOME (nb,Addr ad offs,re,pc') ∧ mc_conf.prog_addresses = t1.mem_domain ∧ ad' = mc_conf.target.get_reg ms2 ad + offs ∧ target_state_rel mc_conf.target (t1 with pc := mc_conf.ffi_entry_pcs❲index❳) ms2 ⇒ ∃(op :shmem_op). mc_conf.ffi_names❲index❳ = SharedMem op ∧ case op of MappedRead => (if nb = (0w :word8) then w2n ad' MOD (dimindex (:α) DIV (8 :num)) = (0 :num) else T) ∧ ad' ∈ mc_conf.shared_addresses ∧ is_valid_mapped_read (mc_conf.target.get_pc ms2) nb (Addr ad offs) re pc' mc_conf.target ms2 mc_conf.prog_addresses ∧ call_FFI st (SharedMem MappedRead) [nb] (word_to_bytes ad' F) = FFI_return new_st new_bytes ⇒ target_state_rel mc_conf.target (t1 with <|pc := pc'; regs := (λ(n :num). if n = re then word_of_bytes F (0w :β word) new_bytes else (t1.regs n :β word))|>) (mc_conf.ffi_interfer k (index,new_bytes,ms2)) | MappedWrite => (if nb = (0w :word8) then w2n ad' MOD (dimindex (:α) DIV (8 :num)) = (0 :num) else T) ∧ ad' ∈ mc_conf.shared_addresses ∧ is_valid_mapped_write (mc_conf.target.get_pc ms2) nb (Addr ad offs) re pc' mc_conf.target ms2 mc_conf.prog_addresses ∧ call_FFI st (SharedMem MappedWrite) [nb] ((let (w :β word) = mc_conf.target.get_reg ms2 re in if nb = (0w :word8) then word_to_bytes w F else word_to_bytes_aux (w2n nb) w F) ++ word_to_bytes ad' F) = FFI_return new_st new_bytes ⇒ target_state_rel mc_conf.target (t1 with pc := pc') (mc_conf.ffi_interfer k (index,new_bytes,ms2))) ∧ ∀(index :num) (i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ index < LENGTH mc_conf.ffi_names ∧ i ≤ index ⇒ mc_conf.halt_pc ≠ mc_conf.ffi_entry_pcs❲index❳ ∧ mc_conf.ccache_pc ≠ mc_conf.ffi_entry_pcs❲index❳
smsr_nil=∀mc s1 t1 ms1. mc.ffi_names = [] ⇒ share_mem_state_rel mc s1 t1 ms1
smsr_halt=∀mc s1 t1 ms1 w. mc.ffi_names = [SharedMem MappedRead] ∧ mc.ffi_entry_pcs = [w] ∧ mc.halt_pc = w ⇒ ¬share_mem_state_rel mc s1 t1 ms1
