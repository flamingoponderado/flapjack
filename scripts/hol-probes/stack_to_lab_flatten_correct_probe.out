flatten_correct_statement=∀prog s1 t r s2 n l cs bs t1. evaluate (prog,s1) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel s1 t1 ∧ call_args prog t1.ptr_reg t1.len_reg t1.ptr2_reg t1.len2_reg t1.link_reg ∧ code_installed t1.pc (append (FST (flatten t prog n l cs bs))) t1.code ∧ EVERY (λk. IS_SOME (loc_to_pc n k t1.code)) (cs ++ bs ++ [0]) ⇒ ∃ck t2. case halt_view r of NONE => (∀ck1. evaluate (t1 with clock := t1.clock + ck + ck1) = evaluate (t2 with clock := t2.clock + ck1)) ∧ t2.len_reg = t1.len_reg ∧ t2.ptr_reg = t1.ptr_reg ∧ t2.len2_reg = t1.len2_reg ∧ t2.ptr2_reg = t1.ptr2_reg ∧ t2.link_reg = t1.link_reg ∧ t1.code ≼ t2.code ∧ (case OPTION_MAP (λw. result_view w n cs bs) r of NONE => t2.pc = t1.pc + LENGTH (FILTER ($¬ ∘ is_Label) (append (FST (flatten t prog n l cs bs)))) ∧ state_rel s2 t2 | SOME (Vloc n1 n2) => (∀n. IS_SOME (lookup n s2.code) ⇒ IS_SOME (loc_to_pc n 0 t2.code)) ∧ ∀w. loc_to_pc n1 n2 t2.code = SOME w ⇒ w = t2.pc ∧ state_rel s2 t2 | SOME (Vcont n1' n2') => state_rel s2 t2 ∧ code_installed t2.pc [LabAsm (Jump (Lab n1' n2')) 0w [] 0] t2.code | SOME Vtimeout => t2.ffi = s2.ffi ∧ t2.clock = 0 | SOME Verr => F) | SOME res => evaluate (t1 with clock := t1.clock + ck) = (res,t2) ∧ t2.ffi = s2.ffi
flatten_correct_statement_typed=∀(prog :α prog) (s1 :(α, γ, 'ffi) stackSem$state) (t :bool) (r :α stackSem$result option) (s2 :(α, γ, 'ffi) stackSem$state) (n :num) (l :num) (cs :num list) (bs :num list) (t1 :(α, γ, 'ffi) labSem$state). (evaluate (prog,s1) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (r,s2) ∧ r ≠ SOME (Error :α stackSem$result) ∧ (state_rel s1 t1 :bool) ∧ call_args prog t1.ptr_reg t1.len_reg t1.ptr2_reg t1.len2_reg t1.link_reg ∧ code_installed t1.pc (append (FST (flatten t prog n l cs bs))) t1.code ∧ EVERY (λ(k :num). IS_SOME (loc_to_pc n k t1.code)) (cs ++ bs ++ [(0 :num)]) ⇒ ∃(ck :num) (t2 :(α, γ, 'ffi) labSem$state). case halt_view r of (NONE :machine_result option) => (∀(ck1 :num). (evaluate (t1 with clock := t1.clock + ck + ck1) :machine_result # (α, γ, 'ffi) labSem$state) = (evaluate (t2 with clock := t2.clock + ck1) :machine_result # (α, γ, 'ffi) labSem$state)) ∧ t2.len_reg = t1.len_reg ∧ t2.ptr_reg = t1.ptr_reg ∧ t2.len2_reg = t1.len2_reg ∧ t2.ptr2_reg = t1.ptr2_reg ∧ t2.link_reg = t1.link_reg ∧ t1.code ≼ t2.code ∧ (case OPTION_MAP (λ(w :α stackSem$result). result_view w n cs bs) r of (NONE :result_view option) => t2.pc = t1.pc + LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) (append (FST (flatten t prog n l cs bs)))) ∧ (state_rel s2 t2 :bool) | SOME (Vloc n1 n2) => (∀(n :num). IS_SOME (lookup n s2.code :α prog option) ⇒ IS_SOME (loc_to_pc n (0 :num) t2.code)) ∧ ∀(w :num). loc_to_pc n1 n2 t2.code = SOME w ⇒ w = t2.pc ∧ (state_rel s2 t2 :bool) | SOME (Vcont n1' n2') => (state_rel s2 t2 :bool) ∧ code_installed t2.pc [LabAsm (Jump (Lab n1' n2') :α asm_with_lab) (0w :α word) ([] :word8 list) (0 :num)] t2.code | SOME Vtimeout => t2.ffi = s2.ffi ∧ t2.clock = (0 :num) | SOME Verr => F) | SOME res => (evaluate (t1 with clock := t1.clock + ck) :machine_result # (α, γ, 'ffi) labSem$state) = (res,t2) ∧ t2.ffi = s2.ffi
flatten_correct_statement_types=(prog :α prog)::α prog;(s1 :(α, γ, 'ffi) stackSem$state)::(α, γ, 'ffi) stackSem$state;(t :bool)::bool;(r :α stackSem$result option)::α stackSem$result option;(s2 :(α, γ, 'ffi) stackSem$state)::(α, γ, 'ffi) stackSem$state;(n :num)::num;(l :num)::num;(cs :num list)::num list;(bs :num list)::num list;(t1 :(α, γ, 'ffi) labSem$state)::(α, γ, 'ffi) labSem$state;
