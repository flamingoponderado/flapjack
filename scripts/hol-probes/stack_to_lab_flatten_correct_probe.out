flatten_correct_statement=∀prog s1 t r s2 n l cs bs t1. evaluate (prog,s1) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel s1 t1 ∧ call_args prog t1.ptr_reg t1.len_reg t1.ptr2_reg t1.len2_reg t1.link_reg ∧ code_installed t1.pc (append (FST (flatten t prog n l cs bs))) t1.code ∧ EVERY (λk. IS_SOME (loc_to_pc n k t1.code)) (cs ++ bs ++ [0]) ⇒ ∃ck t2. case halt_view r of NONE => (∀ck1. evaluate (t1 with clock := t1.clock + ck + ck1) = evaluate (t2 with clock := t2.clock + ck1)) ∧ t2.len_reg = t1.len_reg ∧ t2.ptr_reg = t1.ptr_reg ∧ t2.len2_reg = t1.len2_reg ∧ t2.ptr2_reg = t1.ptr2_reg ∧ t2.link_reg = t1.link_reg ∧ t1.code ≼ t2.code ∧ (case OPTION_MAP (λw. result_view w n cs bs) r of NONE => t2.pc = t1.pc + LENGTH (FILTER ($¬ ∘ is_Label) (append (FST (flatten t prog n l cs bs)))) ∧ state_rel s2 t2 | SOME (Vloc n1 n2) => (∀n. IS_SOME (lookup n s2.code) ⇒ IS_SOME (loc_to_pc n 0 t2.code)) ∧ ∀w. loc_to_pc n1 n2 t2.code = SOME w ⇒ w = t2.pc ∧ state_rel s2 t2 | SOME (Vcont n1' n2') => state_rel s2 t2 ∧ code_installed t2.pc [LabAsm (Jump (Lab n1' n2')) 0w [] 0] t2.code | SOME Vtimeout => t2.ffi = s2.ffi ∧ t2.clock = 0 | SOME Verr => F) | SOME res => evaluate (t1 with clock := t1.clock + ck) = (res,t2) ∧ t2.ffi = s2.ffi
