mem_val_def_statement=(∀regs w. mem_val regs (INL w) = Word w) ∧ ∀regs n. mem_val regs (INR n) = regs⟨n⟩
mem_val_def_type=:(num |-> α word_loc) -> α word + num -> α word_loc
MAP_mem_val_MAP_INL_statement=∀ws f. MAP (mem_val f) (MAP INL ws) = MAP Word ws
MAP_mem_val_MAP_INL_proved=T
MAP_mem_val_MAP_INL_hypotheses=0
word_list_and_rev_join_lemma_statement=∀ys xs ss q p b1 b a. b = a + n2w (LENGTH xs + LENGTH ys) * bytes_in_word ∧ (p * word_list a (xs ++ REVERSE ys) * q) ss ∧ b1 ⇒ (p * word_list a xs * word_list_rev b ys * q) ss ∧ b1
word_list_and_rev_join_lemma_proved=T
word_list_and_rev_join_lemma_hypotheses=0
INSERT_DELETE_EQ_DELETE_statement=∀x s. (x INSERT s) DELETE x = s DELETE x
INSERT_DELETE_EQ_DELETE_proved=T
INSERT_DELETE_EQ_DELETE_hypotheses=0
word_list_exists_addresses_statement=∀m1 n a. dimindex (:α) DIV 8 * n < dimword (:α) ∧ good_dimindex (:α) ⇒ word_list_exists a n (fun2set (m1,addresses a n))
word_list_exists_addresses_proved=T
word_list_exists_addresses_hypotheses=0
word_list_wrap_statement=∀ls a. good_dimindex (:α) ∧ dimword (:α) DIV (dimindex (:α) DIV 8) < LENGTH ls ⇒ ∃x xs y ys b. word_list a ls = word_list a (x::xs) * word_list b (y::ys) ∧ b = a
word_list_wrap_proved=T
word_list_wrap_hypotheses=0
fmap_simp_lemma1_statement=∀z y x g. g⟨0 ↦ z; 5 ↦ y; 0 ↦ x⟩ = g⟨5 ↦ y; 0 ↦ z⟩
fmap_simp_lemma1_proved=T
fmap_simp_lemma1_hypotheses=0
word_list_set_statement=∀xs a. good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n bytes_in_word < dimword (:α) ⇒ word_list a xs (set (GENLIST (λi. (a + n2w i * bytes_in_word,xs❲i❳)) (LENGTH xs)))
word_list_set_proved=T
word_list_set_hypotheses=0
word_list_seteq_statement=∀xs a. good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n bytes_in_word < dimword (:α) ⇒ word_list a xs = (λs. s = set (GENLIST (λi. (a + n2w i * bytes_in_word,xs❲i❳)) (LENGTH xs)))
word_list_seteq_proved=T
word_list_seteq_hypotheses=0
word_list_EL_in_memory_statement=∀xs r2 r1 m i dm a. good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n bytes_in_word < dimword (:α) ∧ (r1 * word_list a xs * r2) (fun2set (m,dm)) ∧ i < LENGTH xs ⇒ m (a + n2w i * bytes_in_word) = xs❲i❳
word_list_EL_in_memory_proved=T
word_list_EL_in_memory_hypotheses=0
word_list_in_memory_statement=∀xs r2 r1 m dm a. (r1 * word_list a xs * r2) (fun2set (m,dm)) ∧ good_dimindex (:α) ∧ w2n a + LENGTH xs * w2n bytes_in_word < dimword (:α) ⇒ memory m (addresses a (LENGTH xs)) = word_list a xs
word_list_in_memory_proved=T
word_list_in_memory_hypotheses=0
word_list_exists_addresses_matches_theory=T
word_list_wrap_matches_theory=T
