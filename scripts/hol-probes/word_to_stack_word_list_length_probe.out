wl_full_DIV_ADD_1=⊢ 0 < d ⇒ m DIV d + 1 = (m + d) DIV d
wl_full_LENGTH_word_list_lemma=⊢ ∀xs d. 0 < d ⇒ LENGTH (word_list xs d) = (LENGTH xs − 1) DIV d + 1
wl_full_LENGTH_word_list=⊢ ∀xs d. LENGTH (word_list xs d) = if d = 0 then 1 else (LENGTH xs − 1) DIV d + 1
