compile_pats_def_typed=∀(cfg :config) (naive :bool) (t :tra) (i :num) (v :exp) (default_x :exp) (ps :(flatLang$pat # exp) list). compile_pats cfg naive t i v default_x ps = (let (branches :exp list) = MAP (compile_pat_rhs t i v) ps in if naive then naive_pattern_matches t v (ZIP (MAP (FST :flatLang$pat # exp -> flatLang$pat) ps,branches)) default_x else (let (pats :(pat # num) list) = MAPi (λ(j :num) ((p :flatLang$pat),(_0 :exp)). (encode_pat p,j)) ps; (dt :dTree) = comp pats in decode_dtree t (fromList branches :exp sptree$num_map) v default_x dt))
sum_string_ords_def_typed=∀(str :mlstring) (i :num). sum_string_ords i str = if i < strlen str then ORD (strsub str i) − (35 :num) + sum_string_ords (i + (1 :num)) str else (0 :num)
dec_name_to_num_def_typed=∀(name :mlstring). dec_name_to_num name = if strlen name < (2 :num) then (0 :num) else if strsub name (0 :num) = #"." ∧ strsub name (1 :num) = #"." then sum_string_ords (2 :num) name else (0 :num)
enc_num_to_name_aux_def_typed=∀(xs :string) (i :num). enc_num_to_name_aux i xs = if i < (90 :num) then STRING #"." (STRING #"." (STRING (CHR (i + (35 :num))) xs)) else enc_num_to_name_aux (i − (90 :num)) (STRING #"}" xs)
enc_num_to_name_def_typed=∀(i :num). enc_num_to_name i = implode (enc_num_to_name_aux i ("" :string))
max_dec_name_def_typed=max_dec_name ([] :mlstring list) = (0 :num) ∧ ∀(nm :mlstring) (nms :mlstring list). max_dec_name (nm::nms) = MAX (dec_name_to_num nm) (max_dec_name nms)
op_sets_globals_def_typed=(op_sets_globals (GlobalVarInit (n :num)) ⇔ T) ∧ (op_sets_globals (Src (v :ast$op)) ⇔ F) ∧ (op_sets_globals (GlobalVarAlloc (v1 :num)) ⇔ F) ∧ (op_sets_globals (GlobalVarLookup (v3 :num)) ⇔ F) ∧ (op_sets_globals (TagLenEq (v4 :num) (v5 :num) :op) ⇔ F) ∧ (op_sets_globals (LenEq (v6 :num)) ⇔ F) ∧ (op_sets_globals (El (v7 :num)) ⇔ F) ∧ (op_sets_globals Id ⇔ F)
decode_pos_def_typed=(∀(t :tra) (v :exp). decode_pos t v EmptyPos = v) ∧ ∀(t :tra) (v :exp) (i :num) (pos :position). decode_pos t v (Pos i pos) = decode_pos t (App t (El i) [v] :exp) pos
simp_guard_def_typed=(∀(y :dGuard) (x :dGuard). simp_guard (Conj x y) = (let (v :dGuard) = simp_guard x; (w :dGuard) = simp_guard y in if v = (Not True :dGuard) ∨ w = (Not True :dGuard) then (Not True :dGuard) else if v = True then w else if w = True then v else Conj v w)) ∧ (∀(y :dGuard) (x :dGuard). simp_guard (Disj x y) = (let (v :dGuard) = simp_guard x; (w :dGuard) = simp_guard y in if v = True ∨ w = True then True else if v = (Not True :dGuard) then w else if w = (Not True :dGuard) then v else Disj v w)) ∧ (∀(x :dGuard). simp_guard (Not x :dGuard) = (let (v :dGuard) = simp_guard x in case v of PosTest v8 v9 => (Not v :dGuard) | (Not (PosTest v29 v30) :dGuard) => PosTest v29 v30 | (Not (Not v31 :dGuard) :dGuard) => (Not v31 :dGuard) | (Not (Conj v32 v33) :dGuard) => Conj v32 v33 | (Not (Disj v34 v35) :dGuard) => Disj v34 v35 | (Not True :dGuard) => True | Conj v11 v12 => (Not v :dGuard) | Disj v13 v14 => (Not v :dGuard) | True => (Not v :dGuard))) ∧ (∀(v2 :dTest) (v1 :position). simp_guard (PosTest v1 v2) = PosTest v1 v2) ∧ simp_guard True = True
decode_guard_def_typed=(∀(t :tra) (v :exp) (gd :dGuard). decode_guard t v (Not gd :dGuard) = (App t (Src Equality) [decode_guard t v gd; Bool t F] :exp)) ∧ (∀(t :tra) (v :exp) (gd1 :dGuard) (gd2 :dGuard). decode_guard t v (Conj gd1 gd2) = SmartIf t (decode_guard t v gd1) (decode_guard t v gd2) (Bool t F)) ∧ (∀(t :tra) (v :exp) (gd1 :dGuard) (gd2 :dGuard). decode_guard t v (Disj gd1 gd2) = SmartIf t (decode_guard t v gd1) (Bool t T) (decode_guard t v gd2)) ∧ (∀(t :tra) (v :exp). decode_guard t v True = Bool t T) ∧ ∀(t :tra) (v :exp) (pos :position) (test :dTest). decode_guard t v (PosTest pos test) = decode_test t test (decode_pos t v pos)
decode_dtree_def_typed=(∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp) (n :num). decode_dtree t br_spt v df (Leaf n) = case lookup n br_spt of (NONE :exp option) => df | SOME br => br) ∧ (∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp). decode_dtree t br_spt v df Fail = df) ∧ (∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp). decode_dtree t br_spt v df TypeFail = Var_local t «impossible-case») ∧ ∀(t :tra) (br_spt :exp sptree$num_map) (v :exp) (df :exp) (guard :dGuard) (dt1 :dTree) (dt2 :dTree). decode_dtree t br_spt v df (If guard dt1 dt2 :dTree) = (let (guard :dGuard) = simp_guard guard; (dec1 :exp) = decode_dtree t br_spt v df dt1; (dec2 :exp) = decode_dtree t br_spt v df dt2 in if guard = True then dec1 else if guard = (Not True :dGuard) then dec2 else SmartIf t (decode_guard t v guard) dec1 dec2)
encode_pat_def_typed=encode_pat Pany = Any ∧ (∀(l :lit). encode_pat (Plit l :flatLang$pat) = (Lit l :pat)) ∧ (∀(v0 :mlstring). encode_pat (Pvar v0 :flatLang$pat) = Any) ∧ (∀(stmp :(num # (num # (num # num) list) option) option) (ps :flatLang$pat list). encode_pat (Pcon stmp ps) = (Cons (case stmp of (NONE :(num # (num # (num # num) list) option) option) => (NONE :(num # (num # num) list option) option) | SOME (i,(NONE :(num # (num # num) list) option)) => SOME (i,(NONE :(num # num) list option)) | SOME (i,SOME (ty,ctors)) => SOME (i,SOME ctors)) (MAP (λ(a :flatLang$pat). encode_pat a) ps) :pat)) ∧ (∀(v :mlstring) (p :flatLang$pat). encode_pat (Pas p v) = encode_pat p) ∧ ∀(p :flatLang$pat). encode_pat (Pref p) = Ref (encode_pat p)
compile_pat_bindings_def_typed=(∀(v1 :num) (v0 :tra) (exp :exp). compile_pat_bindings v0 v1 ([] :(flatLang$pat # num # exp) list) exp = ((LN :sptree$num_set),exp)) ∧ (∀(v3 :exp) (v2 :num) (t :tra) (m :(flatLang$pat # num # exp) list) (i :num) (exp :exp). compile_pat_bindings t i ((Pany,v2,v3)::m) exp = compile_pat_bindings t i m exp) ∧ (∀(x :exp) (t :tra) (s :mlstring) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i (((Pvar s :flatLang$pat),k,x)::m) exp = (let ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t i m exp in (insert k () spt,(Let t (SOME s) x exp2 :exp)))) ∧ (∀(v6 :exp) (v5 :num) (v4 :lit) (t :tra) (m :(flatLang$pat # num # exp) list) (i :num) (exp :exp). compile_pat_bindings t i (((Plit v4 :flatLang$pat),v5,v6)::m) exp = compile_pat_bindings t i m exp) ∧ (∀(x :exp) (v7 :(num # (num # (num # num) list) option) option) (t :tra) (ps :flatLang$pat list) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i ((Pcon v7 ps,k,x)::m) exp = (let (j_nms :((num # mlstring) # flatLang$pat # num # exp) list) = MAP (λ((j :num),(p :flatLang$pat)). (let (k :num) = i + (1 :num) + j; (nm :mlstring) = enc_num_to_name k in ((j,nm),p,k,Var_local t nm))) (enumerate (0 :num) ps :(num # flatLang$pat) list); ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t (i + (2 :num) + LENGTH ps) (MAP (SND :(num # mlstring) # flatLang$pat # num # exp -> flatLang$pat # num # exp) j_nms ++ m) exp; (j_nms_used :((num # mlstring) # flatLang$pat # num # exp) list) = FILTER (λ((_1 :num # mlstring),(_2 :flatLang$pat),(k :num),(_3 :exp)). IS_SOME (lookup k spt)) j_nms; (exp3 :exp) = FOLDR (λ(((j :num),(nm :mlstring)),(_0 :flatLang$pat # num # exp)) (exp :exp). (Let t (SOME nm) (App t (El j) [x] :exp) exp :exp)) exp2 j_nms_used; (spt2 :sptree$num_set) = if NULL j_nms_used then spt else insert k () spt in (spt2,exp3))) ∧ (∀(x :exp) (v :mlstring) (t :tra) (p :flatLang$pat) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i ((Pas p v,k,x)::m) exp = (let (nm :mlstring) = enc_num_to_name (i + (1 :num)); ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t (i + (2 :num)) ((p,i + (1 :num),Var_local t nm)::m) exp in (insert k () spt,(Let t (SOME v) x (Let t (SOME nm) (Var_local t v) exp2 :exp) :exp)))) ∧ ∀(x :exp) (t :tra) (p :flatLang$pat) (m :(flatLang$pat # num # exp) list) (k :num) (i :num) (exp :exp). compile_pat_bindings t i ((Pref p,k,x)::m) exp = (let (nm :mlstring) = enc_num_to_name (i + (1 :num)); ((spt :sptree$num_set),(exp2 :exp)) = compile_pat_bindings t (i + (2 :num)) ((p,i + (1 :num),Var_local t nm)::m) exp in (insert k () spt,(Let t (SOME nm) (App t (El (0 :num)) [x] :exp) exp2 :exp)))
compile_pat_rhs_def_typed=∀(t :tra) (i :num) (v :exp) (p :flatLang$pat) (exp :exp). compile_pat_rhs t i v (p,exp) = SND (compile_pat_bindings t (i + (1 :num)) [(p,i,v)] exp)
naive_pattern_match_def_typed=(∀(t :tra). naive_pattern_match t ([] :(flatLang$pat # exp) list) = Bool t T) ∧ (∀(v0 :exp) (t :tra) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pany,v0)::mats) = naive_pattern_match t mats) ∧ (∀(v2 :exp) (v1 :mlstring) (t :tra) (mats :(flatLang$pat # exp) list). naive_pattern_match t (((Pvar v1 :flatLang$pat),v2)::mats) = naive_pattern_match t mats) ∧ (∀(v :exp) (t :tra) (mats :(flatLang$pat # exp) list) (l :lit). naive_pattern_match t (((Plit l :flatLang$pat),v)::mats) = SmartIf t (App t (Src Equality) [v; (Lit t l :exp)] :exp) (naive_pattern_match t mats) (Bool t F)) ∧ (∀(v :exp) (t :tra) (ps :flatLang$pat list) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pcon (NONE :(num # (num # (num # num) list) option) option) ps,v)::mats) = naive_pattern_match t (MAPi (λ(i :num) (p :flatLang$pat). (p,(App t (El i) [v] :exp))) ps ++ mats)) ∧ (∀(v :exp) (t :tra) (p :flatLang$pat) (mats :(flatLang$pat # exp) list) (i :mlstring). naive_pattern_match t ((Pas p i,v)::mats) = naive_pattern_match t ((p,v)::mats)) ∧ (∀(v :exp) (t :tra) (stmp :num # (num # (num # num) list) option) (ps :flatLang$pat list) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pcon (SOME stmp) ps,v)::mats) = SmartIf t (App t (TagLenEq (FST stmp) (LENGTH ps) :op) [v] :exp) (naive_pattern_match t (MAPi (λ(i :num) (p :flatLang$pat). (p,(App t (El i) [v] :exp))) ps ++ mats)) (Bool t F)) ∧ ∀(v :exp) (t :tra) (p :flatLang$pat) (mats :(flatLang$pat # exp) list). naive_pattern_match t ((Pref p,v)::mats) = naive_pattern_match t ((p,(App t (El (0 :num)) [v] :exp))::mats)
naive_pattern_matches_def_typed=(∀(v :exp) (t :tra) (dflt_x :exp). naive_pattern_matches t v ([] :(flatLang$pat # exp) list) dflt_x = dflt_x) ∧ ∀(x :exp) (v :exp) (t :tra) (ps :(flatLang$pat # exp) list) (p :flatLang$pat) (dflt_x :exp). naive_pattern_matches t v ((p,x)::ps) dflt_x = SmartIf t (naive_pattern_match t [(p,v)]) x (naive_pattern_matches t v ps dflt_x)
compile_dec_def_typed=∀(cfg :config) (exp :exp). compile_dec cfg exp = SND (SND (compile_exp cfg exp))
