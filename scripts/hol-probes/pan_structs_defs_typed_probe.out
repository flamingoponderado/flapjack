afindi_def_typed=(∀(x :α). afindi x ([] :(α # β) list) = (NONE :num option)) ∧ ∀(x :α) (v :β) (t :(α # β) list) (k :α). afindi x ((k,v)::t) = if x = k then SOME (0 :num) else case afindi x t of (NONE :num option) => (NONE :num option) | SOME i => SOME ((1 :num) + i)
compile_shape_def_typed=(∀(sctxt :(mlstring # (α # shape) list) list). compile_shape sctxt One = One) ∧ (∀(shapes :shape list) (sctxt :(mlstring # (α # shape) list) list). compile_shape sctxt (Comb shapes) = Comb (compile_shapes sctxt shapes)) ∧ (∀(sctxt :(mlstring # (α # shape) list) list) (nm :mlstring). compile_shape sctxt (Named nm) = case dropWhile (λ((n :mlstring),(fs :(α # shape) list)). n ≠ nm) sctxt of ([] :(mlstring # (α # shape) list) list) => One | (nm',flds)::sctxt' => Comb (compile_shapes sctxt' (MAP (SND :α # shape -> shape) flds))) ∧ (∀(sctxt :(mlstring # (α # shape) list) list). compile_shapes sctxt ([] :shape list) = ([] :shape list)) ∧ ∀(shs :shape list) (sh :shape) (sctxt :(mlstring # (α # shape) list) list). compile_shapes sctxt (sh::shs) = compile_shape sctxt sh::compile_shapes sctxt shs
old_exp_shape_def_typed=(∀(v :mlstring) (ctxt :context). old_exp_shape ctxt (Var Local v :α exp) = case ALOOKUP ctxt.locals v of (NONE :shape option) => One | SOME sh => sh) ∧ (∀(v :mlstring) (ctxt :context). old_exp_shape ctxt (Var Global v :α exp) = case ALOOKUP ctxt.globals v of (NONE :shape option) => One | SOME sh => sh) ∧ (∀(es :α exp list) (ctxt :context). old_exp_shape ctxt (RStruct es) = Comb (old_exp_shapes ctxt es)) ∧ (∀(index :num) (e :α exp) (ctxt :context). old_exp_shape ctxt (RField index e) = case old_exp_shape ctxt e of One => One | Comb shs => (case LLOOKUP shs index of (NONE :shape option) => One | SOME sh => sh) | Named v3 => One) ∧ (∀(nm :mlstring) (eflds :(mlstring # α exp) list) (ctxt :context). old_exp_shape ctxt (NStruct nm eflds) = Named nm) ∧ (∀(fld :mlstring) (e :α exp) (ctxt :context). old_exp_shape ctxt (NField fld e) = case old_exp_shape ctxt e of One => One | Comb v2 => One | Named nm => case ALOOKUP ctxt.structs nm of (NONE :(mlstring # shape) list option) => One | SOME flds => case ALOOKUP flds fld of (NONE :shape option) => One | SOME sh => sh) ∧ (∀(sh :shape) (e :α exp) (ctxt :context). old_exp_shape ctxt (Load sh e :α exp) = sh) ∧ (∀(v7 :α word) (ctxt :context). old_exp_shape ctxt (Const v7 :α exp) = One) ∧ (∀(v19 :α exp) (ctxt :context). old_exp_shape ctxt (Load32 v19 :α exp) = One) ∧ (∀(v20 :α exp) (ctxt :context). old_exp_shape ctxt (LoadByte v20) = One) ∧ (∀(v22 :α exp list) (v21 :binop) (ctxt :context). old_exp_shape ctxt (Op v21 v22) = One) ∧ (∀(v24 :α exp list) (v23 :panop) (ctxt :context). old_exp_shape ctxt (Panop v23 v24) = One) ∧ (∀(v27 :α exp) (v26 :α exp) (v25 :cmp) (ctxt :context). old_exp_shape ctxt (Cmp v25 v26 v27) = One) ∧ (∀(v30 :α exp) (v29 :α exp) (v28 :ast$shift) (ctxt :context). old_exp_shape ctxt (Shift v28 v29 v30 :α exp) = One) ∧ (∀(ctxt :context). old_exp_shape ctxt (BaseAddr :α exp) = One) ∧ (∀(ctxt :context). old_exp_shape ctxt (TopAddr :α exp) = One) ∧ (∀(ctxt :context). old_exp_shape ctxt (BytesInWord :α exp) = One) ∧ (∀(ctxt :context). old_exp_shapes ctxt ([] :α exp list) = ([] :shape list)) ∧ ∀(es :α exp list) (e :α exp) (ctxt :context). old_exp_shapes ctxt (e::es) = old_exp_shape ctxt e::old_exp_shapes ctxt es
