pull_ops_simp_def_statement=(∀op. pull_ops_simp op [] = []) ∧ ∀op x xs. pull_ops_simp op (x::xs) = case x of Const v9 => x::pull_ops_simp op xs | Var v10 => x::pull_ops_simp op xs | Lookup v11 => x::pull_ops_simp op xs | Load v12 => x::pull_ops_simp op xs | Op op' ls => if op = op' then ls ++ pull_ops_simp op xs else x::pull_ops_simp op xs | Shift v15 v16 v17 => x::pull_ops_simp op xs
pull_ops_simp_def_hypotheses=0
binary_branch_exp_def_statement=(∀exps. binary_branch_exp (Op Sub exps) ⇔ EVERY (λa. binary_branch_exp a) exps) ∧ (∀xs. binary_branch_exp (Op Add xs) ⇔ LENGTH xs = 2 ∧ EVERY (λa. binary_branch_exp a) xs) ∧ (∀xs. binary_branch_exp (Op And xs) ⇔ LENGTH xs = 2 ∧ EVERY (λa. binary_branch_exp a) xs) ∧ (∀xs. binary_branch_exp (Op Or xs) ⇔ LENGTH xs = 2 ∧ EVERY (λa. binary_branch_exp a) xs) ∧ (∀xs. binary_branch_exp (Op Xor xs) ⇔ LENGTH xs = 2 ∧ EVERY (λa. binary_branch_exp a) xs) ∧ (∀exp. binary_branch_exp (Load exp) ⇔ binary_branch_exp exp) ∧ (∀shift nexp exp. binary_branch_exp (Shift shift exp nexp) ⇔ binary_branch_exp exp ∧ binary_branch_exp nexp) ∧ (∀v. binary_branch_exp (Const v) ⇔ T) ∧ (∀v1. binary_branch_exp (Var v1) ⇔ T) ∧ ∀v2. binary_branch_exp (Lookup v2) ⇔ T
binary_branch_exp_def_hypotheses=0
inst_select_thm_statement=∀c temp prog st res rst loc. evaluate (prog,st) = (res,rst) ∧ every_var (λx. x < temp) prog ∧ res ≠ SOME Error ∧ locals_rel temp st.locals loc ⇒ ∃loc'. evaluate (inst_select c temp prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of NONE => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12) => locals_rel temp rst.locals loc' | SOME (Continue v13) => locals_rel temp rst.locals loc' | SOME TimeOut => rst.locals = loc' | SOME NotEnoughSpace => rst.locals = loc' | SOME (FinalFFI v14) => rst.locals = loc' | SOME Error => rst.locals = loc'
inst_select_thm_hypotheses=0
inst_select_Loop_helper_statement=∀s names prog exit_names res rst c temp loc. (∀st res rst loc. evaluate (prog,st) = (res,rst) ∧ res ≠ SOME Error ∧ locals_rel temp st.locals loc ⇒ ∃loc'. evaluate (inst_select c temp prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of NONE => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12) => locals_rel temp rst.locals loc' | SOME (Continue v13) => locals_rel temp rst.locals loc' | SOME TimeOut => rst.locals = loc' | SOME NotEnoughSpace => rst.locals = loc' | SOME (FinalFFI v14) => rst.locals = loc' | SOME Error => rst.locals = loc') ∧ evaluate (Loop names prog exit_names,s) = (res,rst) ∧ res ≠ SOME Error ∧ every_var (λx. x < temp) prog ∧ every_name (λx. x < temp) (names,LN) ∧ every_name (λx. x < temp) (exit_names,LN) ∧ locals_rel temp s.locals loc ⇒ ∃loc'. evaluate (Loop names (inst_select c temp prog) exit_names,s with locals := loc) = (res,rst with locals := loc') ∧ case res of NONE => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12) => locals_rel temp rst.locals loc' | SOME (Continue v13) => locals_rel temp rst.locals loc' | SOME TimeOut => rst.locals = loc' | SOME NotEnoughSpace => rst.locals = loc' | SOME (FinalFFI v14) => rst.locals = loc' | SOME Error => rst.locals = loc'
inst_select_Loop_helper_hypotheses=0
locals_rel_def_statement=∀temp s t. locals_rel temp s t ⇔ ∀x. x < temp ⇒ lookup x s = lookup x t
locals_rel_def_hypotheses=0
the_words_EVERY_IS_SOME_statement=∀ls x. the_words ls = SOME x ⇒ EVERY IS_SOME ls
the_words_EVERY_IS_SOME_hypotheses=0
locals_rel_get_vars_statement=∀ls vs. get_vars ls st = SOME vs ∧ EVERY (λx. x < temp) ls ∧ locals_rel temp st.locals loc ⇒ get_vars ls (st with locals := loc) = SOME vs
locals_rel_get_vars_hypotheses=0
locals_rel_alist_insert_statement=∀ls vs s t. locals_rel temp s t ∧ EVERY (λx. x < temp) ls ⇒ locals_rel temp (alist_insert ls vs s) (alist_insert ls vs t)
locals_rel_alist_insert_hypotheses=0
locals_rel_get_var_statement=r < temp ∧ get_var r st = SOME x ∧ locals_rel temp st.locals loc ⇒ get_var r (st with locals := loc) = SOME x
locals_rel_get_var_hypotheses=0
locals_rel_get_var_simp_statement=r < temp ∧ locals_rel temp st.locals loc ⇒ get_var r (st with locals := loc) = get_var r st
locals_rel_get_var_simp_hypotheses=0
locals_rel_get_vars_simp_statement=EVERY (λx. x < temp) l ∧ locals_rel temp st.locals loc ⇒ get_vars l (st with locals := loc) = get_vars l st
locals_rel_get_vars_simp_hypotheses=0
locals_rel_get_var_imm_statement=every_var_imm (λx. x < temp) r ∧ get_var_imm r st = SOME x ∧ locals_rel temp st.locals loc ⇒ get_var_imm r (st with locals := loc) = SOME x
locals_rel_get_var_imm_hypotheses=0
locals_rel_get_var_imm_simp_statement=every_var_imm (λx. x < temp) r ∧ locals_rel temp st.locals loc ⇒ get_var_imm r (st with locals := loc) = get_var_imm r st
locals_rel_get_var_imm_simp_hypotheses=0
locals_rel_word_exp_statement=∀s exp w. every_var_exp (λx. x < temp) exp ∧ word_exp s exp = SOME w ∧ locals_rel temp s.locals loc ⇒ word_exp (s with locals := loc) exp = SOME w
locals_rel_word_exp_hypotheses=0
locals_rel_word_exp_simp_statement=∀s exp w. every_var_exp (λx. x < temp) exp ∧ locals_rel temp s.locals loc ⇒ word_exp (s with locals := loc) exp = word_exp s exp
locals_rel_word_exp_simp_hypotheses=0
locals_rel_cut_envs_statement=locals_rel temp loc loc' ∧ every_name (λx. x < temp) names ∧ cut_envs names loc = SOME x ⇒ cut_envs names loc' = SOME x
locals_rel_cut_envs_hypotheses=0
locals_rel_cut_env_statement=locals_rel temp loc loc' ∧ every_name (λx. x < temp) names ∧ cut_env names loc = SOME x ⇒ cut_env names loc' = SOME x
locals_rel_cut_env_hypotheses=0
locals_rel_evaluate_thm_statement=∀prog st res rst loc temp. evaluate (prog,st) = (res,rst) ∧ res ≠ SOME Error ∧ every_var (λx. x < temp) prog ∧ locals_rel temp st.locals loc ⇒ ∃loc'. evaluate (prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of NONE => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12) => locals_rel temp rst.locals loc' | SOME (Continue v13) => locals_rel temp rst.locals loc' | SOME TimeOut => rst.locals = loc' | SOME NotEnoughSpace => rst.locals = loc' | SOME (FinalFFI v14) => rst.locals = loc' | SOME Error => rst.locals = loc'
locals_rel_evaluate_thm_hypotheses=0
PERM_PART_statement=∀P L l1 l2 p q. (p,q) = PART P L l1 l2 ⇒ PERM (L ++ (l1 ++ l2)) (p ++ q)
PERM_PART_hypotheses=0
PERM_PARTITION_statement=∀P L A B. (A,B) = PARTITION P L ⇒ PERM L (A ++ B)
PERM_PARTITION_hypotheses=0
PARTs_HAVE_PROP_statement=∀P L A B l1 l2. (A,B) = PART P L l1 l2 ∧ (∀x. MEM x l1 ⇒ P x) ∧ (∀x. MEM x l2 ⇒ ¬P x) ⇒ (∀z. MEM z A ⇒ P z) ∧ ∀z. MEM z B ⇒ ¬P z
PARTs_HAVE_PROP_hypotheses=0
inst_select_thm_typed=∀(c :α asm_config) (temp :num) (prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state) (loc :α word_loc sptree$num_map). evaluate (prog,st) = (res,rst) ∧ every_var (λ(x :num). x < temp) prog ∧ res ≠ SOME (Error :α result) ∧ locals_rel temp st.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate (inst_select c temp prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc'
inst_select_Loop_helper_typed=∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (prog :α prog) (exit_names :sptree$num_set) (res :α result option) (rst :(α, γ, 'ffi) state) (c :α asm_config) (temp :num) (loc :α word_loc sptree$num_map). (∀(st :(α, γ, 'ffi) state) (res :α result option) (rst :(α, γ, 'ffi) state) (loc :α word_loc sptree$num_map). evaluate (prog,st) = (res,rst) ∧ res ≠ SOME (Error :α result) ∧ locals_rel temp st.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate (inst_select c temp prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc') ∧ evaluate ((Loop names prog exit_names :α prog),s) = (res,rst) ∧ res ≠ SOME (Error :α result) ∧ every_var (λ(x :num). x < temp) prog ∧ every_name (λ(x :num). x < temp) (names,(LN :sptree$num_set)) ∧ every_name (λ(x :num). x < temp) (exit_names,(LN :sptree$num_set)) ∧ locals_rel temp s.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate ((Loop names (inst_select c temp prog) exit_names :α prog),s with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc'
locals_rel_evaluate_thm_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state) (loc :α word_loc sptree$num_map) (temp :num). evaluate (prog,st) = (res,rst) ∧ res ≠ SOME (Error :α result) ∧ every_var (λ(x :num). x < temp) prog ∧ locals_rel temp st.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate (prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc'
