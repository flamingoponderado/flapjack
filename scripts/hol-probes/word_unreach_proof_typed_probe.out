ALL_DISTINCT_merge_moves_typed=ALL_DISTINCT (MAP (FST :num # num -> num) (merge_moves (l1 :(num # num) list) (l2 :(num # num) list)))
copy_vars_def_typed=(∀(to :α sptree$num_map) (from :α sptree$num_map). copy_vars ([] :(num # num) list) from to = to) ∧ ∀(to :α sptree$num_map) (rest :(num # num) list) (r :num) (l :num) (from :α sptree$num_map). copy_vars ((l,r)::rest) from to = insert l (THE (lookup r from)) (copy_vars rest from to)
copy_vars_anub_typed=(copy_vars (anub (xs :(num # num) list) ([] :num list)) :α sptree$num_map -> α sptree$num_map -> α sptree$num_map) = (copy_vars xs :α sptree$num_map -> α sptree$num_map -> α sptree$num_map)
copy_vars_append_typed=∀(xs :(num # num) list) (ys :(num # num) list) (from :α sptree$num_map) (to :α sptree$num_map). copy_vars (xs ++ ys) from to = copy_vars xs from (copy_vars ys from to)
copy_vars_MEM_acc_typed=∀(xs :(num # num) list) (acc :num list) (n :num) (w :α). MEM n acc ⇒ insert n w (copy_vars (anub xs acc) (s :α sptree$num_map) (t :α sptree$num_map)) = insert n w (copy_vars (anub xs (FILTER (λ(x :num). n ≠ x) acc)) s t)
evaluate_Move_typed=evaluate ((Move (pri :num) (moves :(num # num) list) :α prog),(s :(α, β, γ) state)) = if ALL_DISTINCT (MAP (FST :num # num -> num) moves) then case get_vars (MAP (SND :num # num -> num) moves) s of (NONE :α word_loc list option) => (SOME (Error :α result),s) | SOME l => ((NONE :α result option),s with locals := copy_vars moves s.locals s.locals) else (SOME (Error :α result),s)
evaluate_remove_unreach_typed=∀(p :α prog) (s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state). evaluate (p,s) = (res,s1) ∧ res ≠ SOME (Error :α result) ⇒ evaluate (remove_unreach p,s) = (res,s1)
evaluate_Seq_assoc_typed=evaluate (Seq (p1 :α prog) (Seq (p2 :α prog) (p3 :α prog)),(s :(α, β, γ) state)) = evaluate (Seq (Seq p1 p2) p3,s)
evaluate_Seq_assoc_right_lemma_typed=∀(p1 :α prog) (p2 :α prog) (s :(α, γ, 'ffi) state) (res :α result option) (s1 :(α, γ, 'ffi) state). evaluate (Seq p1 p2,s) = (res,s1) ∧ res ≠ SOME (Error :α result) ⇒ evaluate (Seq_assoc_right p1 p2,s) = (res,s1)
evaluate_Seq_Skip_typed=∀(p1 :α prog) (s :(α, γ, 'ffi) state). evaluate (Seq p1 (Skip :α prog),s) = evaluate (p1,s)
evaluate_Skip_Seq_typed=evaluate (Seq (Skip :α prog) (p :α prog),(s :(α, γ, 'ffi) state)) = evaluate (p,s)
IMP_EVERY_MAP_SND_anub_typed=∀(xs :(α # β) list) (acc :α list) (p :β -> bool). EVERY p (MAP (SND :α # β -> β) xs) ⇒ EVERY p (MAP (SND :α # β -> β) (anub xs acc))
lookup_copy_vars_typed=∀(l1 :(num # num) list) (h1 :num) (y :num) (s :α sptree$num_map) (t :α sptree$num_map) (z :α). ALOOKUP l1 h1 = SOME y ∧ lookup h1 (copy_vars l1 s t) = SOME z ⇒ THE (lookup y s) = z
lookup_copy_vars_ignore_typed=∀(l1 :(num # num) list) (h1 :num) (x :α sptree$num_map) (y :α sptree$num_map). ALOOKUP l1 h1 = (NONE :num option) ⇒ lookup h1 (copy_vars l1 x y) = lookup h1 y
merge_moves_Skip_typed=∀(l1 :(num # num) list) (l2 :(num # num) list) (s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state). evaluate (Seq (Move (n1 :num) l1 :α prog) (Move (n2 :num) l2 :α prog),s) = (res,s1) ∧ res ≠ SOME (Error :α result) ⇒ evaluate ((Move (m :num) (merge_moves l1 l2) :α prog),s) = (res,s1)
merge_moves_thm_typed=∀(p :α prog) (l1 :(num # num) list) (l2 :(num # num) list) (s :(α, β, γ) state) (res :α result option) (s1 :(α, β, γ) state). evaluate (Seq (Move (n1 :num) l1 :α prog) (Seq (Move (n2 :num) l2 :α prog) p),s) = (res,s1) ∧ res ≠ SOME (Error :α result) ⇒ evaluate (Seq (Move (m :num) (merge_moves l1 l2) :α prog) p,s) = (res,s1)
