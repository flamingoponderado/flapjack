full_make_init_def_statement=∀stack_conf data_conf max_heap sp offset bitmaps code s4 save_regs data_sp coracle. full_make_init stack_conf data_conf max_heap sp offset bitmaps code s4 save_regs data_sp coracle = (let ggc = is_gen_gc data_conf.gc_kind; jump = stack_conf.jump; code1 = compile data_conf (compile code); code2 = compile jump offset ggc max_heap sp InitGlobals_location code1; code3 = fromAList (compile stack_conf.reg_names code2); coracle1 = (I ## MAP prog_comp ## I) ∘ coracle; coracle2 = (I ## MAP (prog_comp jump offset sp) ## I) ∘ coracle1; coracle3 = (I ## compile stack_conf.reg_names ## I) ∘ coracle2; s3 = make_init code3 coracle3 (MAP (find_name stack_conf.reg_names) [2; 3; 4]) save_regs s4; s2 = make_init stack_conf.reg_names (fromAList code2) coracle2 s3; s1 = make_init_any ggc max_heap bitmaps data_sp coracle1 jump offset sp (fromAList code1) s2 in (make_init data_conf (fromAList code) coracle s1,make_init_opt ggc max_heap bitmaps data_sp coracle1 jump offset sp (fromAList code1) s2))
full_make_init_buffer_statement=(FST (full_make_init a b c d e f g h i j k)).code_buffer.buffer = [] ∧ (FST (full_make_init a b c d e f g h i j k)).data_buffer.buffer = []
full_make_init_ffi_statement=(FST (full_make_init a b c d e f g h i j k)).ffi = h.ffi
full_make_init_compile_statement=(FST (full_make_init a b c d e f g h i j k)).compile = (λc. (λp. h.compile c (MAP prog_to_section (MAP (prog_comp a.reg_names) (MAP (prog_comp a.jump e d) p)))) ∘ MAP prog_comp)
