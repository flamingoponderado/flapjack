val native_and_term = ``riscv$Run (ArithR (AND (rdv,rs1v,rs2v))) stv``;
val native_and_th = SIMP_CONV (srw_ss()) [Run_def, dfn'AND_def] native_and_term;
val _ = capture "native_and" native_and_th native_and_term;
val native_or_term = ``riscv$Run (ArithR (OR (rdv,rs1v,rs2v))) stv``;
val native_or_th = SIMP_CONV (srw_ss()) [Run_def, dfn'OR_def] native_or_term;
val _ = capture "native_or" native_or_th native_or_term;
val native_xor_term = ``riscv$Run (ArithR (XOR (rdv,rs1v,rs2v))) stv``;
val native_xor_th = SIMP_CONV (srw_ss()) [Run_def, dfn'XOR_def] native_xor_term;
