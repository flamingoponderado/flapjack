load "preamble"; load "riscvTheory"; load "asmSemTheory"; load "riscv_targetTheory";
open HolKernel Parse bossLib preamble riscvTheory asmSemTheory riscv_targetTheory;
val _ = Globals.linewidth := 1000000;
fun capture label th tm = (print(label ^ "_clause="); print_term(concl th); print "\n";
 print(label ^ "_hypotheses=" ^ Int.toString(length(hyp th)) ^ "\n");
 print(label ^ "_types="); print_type(type_of tm); print " ; "; print(String.concatWith ", " (map (fn v => term_to_string v ^ " : " ^ type_to_string(type_of v)) (free_vars tm))); print "\n");
val _ = capture "source_reg_imm" asmSemTheory.reg_imm_def ``asmSem$reg_imm``;
val _ = capture "source_binop_upd" asmSemTheory.binop_upd_def ``asmSem$binop_upd``;
val _ = capture "source_arith_upd" asmSemTheory.arith_upd_def ``asmSem$arith_upd``;
val _ = capture "source_asm_step" asmSemTheory.asm_step_def ``asmSem$asm_step``;
val _ = capture "source_bop_r" riscv_targetTheory.riscv_bop_r_def ``riscv_target$riscv_bop_r``;
val native_add_term = ``riscv$Run (ArithR (ADD (rdv,rs1v,rs2v))) stv``;
val native_add_th = SIMP_CONV (srw_ss()) [Run_def, dfn'ADD_def] native_add_term;
val _ = capture "native_add" native_add_th native_add_term;
val native_sub_term = ``riscv$Run (ArithR (SUB (rdv,rs1v,rs2v))) stv``;
val native_sub_th = SIMP_CONV (srw_ss()) [Run_def, dfn'SUB_def] native_sub_term;
