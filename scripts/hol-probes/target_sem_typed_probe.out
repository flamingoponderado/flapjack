apply_oracle_def_typed=∀(oracle :num -> β -> α) (x :β). apply_oracle oracle x = (oracle (0 :num) x,shift_seq (1 :num) oracle)
encoded_bytes_in_mem_def_typed=∀(c :α asm_config) (pc :β word) (m :β word -> word8) (md :β word -> bool). encoded_bytes_in_mem c pc m md ⇔ ∃(i :α asm) (k :num). k * (2 :num) ** c.code_alignment < LENGTH (c.encode i) ∧ bytes_in_memory pc (DROP (k * (2 :num) ** c.code_alignment) (c.encode i)) m md
evaluate_def_typed=∀(ms :α) (mc :(β, α, γ) machine_config) (k :num) (ffi :'ffi ffi_state). (evaluate mc ffi k ms :machine_result # α # 'ffi ffi_state) = if k = (0 :num) then (TimeOut,ms,ffi) else if mc.target.get_pc ms ∈ mc.prog_addresses DIFF set mc.ffi_entry_pcs then if encoded_bytes_in_mem mc.target.config (mc.target.get_pc ms) (mc.target.get_byte ms) mc.prog_addresses then (let (ms1 :α) = mc.target.next ms; ((ms2 :α),(new_oracle :num -> α -> α)) = apply_oracle mc.next_interfer ms1; (mc' :(β, α, γ) machine_config) = mc with next_interfer := new_oracle in if EVERY mc'.target.state_ok [ms; ms1; ms2] ∧ ∀(x :β word). x ∉ mc'.prog_addresses ⇒ mc'.target.get_byte ms1 x = mc'.target.get_byte ms x then (evaluate mc' ffi (k − (1 :num)) ms2 :machine_result # α # 'ffi ffi_state) else (Error,ms,ffi)) else (Error,ms,ffi) else if mc.target.get_pc ms = mc.halt_pc then (if mc.target.get_reg ms mc.ptr_reg = (0w :β word) then (Halt Success :machine_result) else (Halt Resource_limit_hit :machine_result),ms,ffi) else if mc.target.get_pc ms = mc.ccache_pc then (let ((ms1 :α),(new_oracle :num -> β word # β word # α -> α)) = apply_oracle mc.ccache_interfer (mc.target.get_reg ms mc.ptr_reg,mc.target.get_reg ms mc.len_reg,ms); (mc' :(β, α, γ) machine_config) = mc with ccache_interfer := new_oracle in (evaluate mc' ffi (k − (1 :num)) ms1 :machine_result # α # 'ffi ffi_state)) else case find_index (mc.target.get_pc ms) mc.ffi_entry_pcs (0 :num) of (NONE :num option) => (Error,ms,ffi) | SOME ffi_index => case mc.ffi_names❲ffi_index❳ of ExtCall v1 => (case ALOOKUP mc.mmio_info ffi_index of (NONE :(word8 # β addr # num # β word) option) => (case read_ffi_bytearrays mc ms of ((NONE :word8 list option),v3) => (Error,ms,ffi) | (SOME bytes,(NONE :word8 list option)) => (Error,ms,ffi) | (SOME bytes,SOME bytes2) => case call_FFI ffi mc.ffi_names❲ffi_index❳ bytes bytes2 of FFI_return new_ffi new_bytes => (let ((ms1 :α),(new_oracle :num -> num # word8 list # α -> α)) = apply_oracle mc.ffi_interfer (ffi_index,new_bytes,ms); (mc' :(β, α, γ) machine_config) = mc with ffi_interfer := new_oracle in (evaluate mc' new_ffi (k − (1 :num)) ms1 :machine_result # α # 'ffi ffi_state)) | (FFI_final outcome :'ffi ffi_result) => ((Halt (FFI_outcome outcome) :machine_result),ms,ffi)) | SOME v => (Error,ms,ffi)) | SharedMem op => case ALOOKUP mc.mmio_info ffi_index of (NONE :(word8 # β addr # num # β word) option) => (Error,ms,ffi) | SOME (nb,a,reg,pc') => case op of MappedRead => (case a of Addr r off => (let (ad :β word) = mc.target.get_reg ms r + off in if (if nb = (0w :word8) then w2n ad MOD (dimindex (:β) DIV (8 :num)) = (0 :num) else T) ∧ ad ∈ mc.shared_addresses ∧ is_valid_mapped_read (mc.target.get_pc ms) nb a reg pc' mc.target ms mc.prog_addresses then case call_FFI ffi mc.ffi_names❲ffi_index❳ [nb] (word_to_bytes ad F) of FFI_return new_ffi new_bytes => (let ((ms1 :α),(new_oracle :num -> num # word8 list # α -> α)) = apply_oracle mc.ffi_interfer (ffi_index,new_bytes,ms); (mc' :(β, α, γ) machine_config) = mc with ffi_interfer := new_oracle in (evaluate mc' new_ffi (k − (1 :num)) ms1 :machine_result # α # 'ffi ffi_state)) | (FFI_final outcome :'ffi ffi_result) => ((Halt (FFI_outcome outcome) :machine_result),ms,ffi) else (Error,ms,ffi))) | MappedWrite => case a of Addr r off => (let (ad :β word) = mc.target.get_reg ms r + off in if (if nb = (0w :word8) then w2n ad MOD (dimindex (:β) DIV (8 :num)) = (0 :num) else T) ∧ ad ∈ mc.shared_addresses ∧ is_valid_mapped_write (mc.target.get_pc ms) nb a reg pc' mc.target ms mc.prog_addresses then case call_FFI ffi mc.ffi_names❲ffi_index❳ [nb] ((let (w :β word) = mc.target.get_reg ms reg in if nb = (0w :word8) then word_to_bytes w F else word_to_bytes_aux (w2n nb) w F) ++ word_to_bytes ad F) of FFI_return new_ffi new_bytes => (let ((ms1 :α),(new_oracle :num -> num # word8 list # α -> α)) = apply_oracle mc.ffi_interfer (ffi_index,new_bytes,ms); (mc' :(β, α, γ) machine_config) = mc with ffi_interfer := new_oracle in (evaluate mc' new_ffi (k − (1 :num)) ms1 :machine_result # α # 'ffi ffi_state)) | (FFI_final outcome :'ffi ffi_result) => ((Halt (FFI_outcome outcome) :machine_result),ms,ffi) else (Error,ms,ffi))
read_ffi_bytearray_def_typed=∀(mc :(α, β, γ) machine_config) (ptr_reg :num) (len_reg :num) (ms :β). read_ffi_bytearray mc ptr_reg len_reg ms = read_bytearray (mc.target.get_reg ms ptr_reg) (w2n (mc.target.get_reg ms len_reg)) (λ(a :α word). if a ∈ mc.prog_addresses then SOME (mc.target.get_byte ms a) else (NONE :word8 option))
read_ffi_bytearrays_def_typed=∀(mc :(α, β, γ) machine_config) (ms :β). read_ffi_bytearrays mc ms = (read_ffi_bytearray mc mc.ptr_reg mc.len_reg ms,read_ffi_bytearray mc mc.ptr2_reg mc.len2_reg ms)
good_init_state_def_typed=∀(mc_conf :(α, 'state, β) machine_config) (ms :'state) (bytes :word8 list) (cbspace :num) (t :α asm_state) (m :α word -> α word_loc) (dm :α word -> bool) (sdm :α word -> bool). good_init_state mc_conf ms bytes cbspace t m dm sdm ⇔ target_state_rel mc_conf.target t ms ∧ target_configured t mc_conf ∧ t.pc = mc_conf.target.get_pc ms ∧ start_pc_ok mc_conf t.pc ∧ (n2w ((2 :num) ** t.align − (1 :num)) :α word) && t.pc = (0w :α word) ∧ interference_ok mc_conf.next_interfer (mc_conf.target.proj mc_conf.prog_addresses) ∧ ffi_interfer_ok t.pc mc_conf ∧ ccache_interfer_ok t.pc mc_conf ∧ code_loaded bytes mc_conf ms ∧ bytes_in_mem t.pc bytes t.mem t.mem_domain dm ∧ dm ⊆ t.mem_domain ∧ (∀(a :α word). byte_align a ∈ dm ⇒ a ∈ dm) ∧ sdm = mc_conf.shared_addresses ∧ (∀(a :α word). byte_align a ∈ sdm ⇒ a ∈ sdm) ∧ DISJOINT mc_conf.prog_addresses mc_conf.shared_addresses ∧ (∀(a :α word). ∃(w :α word). t.mem a = get_byte a w mc_conf.target.config.big_endian ∧ m (byte_align a) = Word w) ∧ (∀(n :num). n < cbspace ⇒ (n2w (n + LENGTH bytes) :α word) + t.pc ∈ t.mem_domain ∧ (n2w (n + LENGTH bytes) :α word) + t.pc ∉ dm) ∧ cbspace + LENGTH bytes < dimword (:α)
start_pc_ok_def_typed=∀(mc_conf :(α, β, γ) machine_config) (pc :α word). start_pc_ok mc_conf pc ⇔ mc_conf.halt_pc ∉ mc_conf.prog_addresses ∧ mc_conf.ccache_pc ∉ mc_conf.prog_addresses ∧ mc_conf.halt_pc ∉ mc_conf.shared_addresses ∧ mc_conf.ccache_pc ∉ mc_conf.shared_addresses ∧ pc − (n2w ffi_offset :α word) = mc_conf.halt_pc ∧ pc − (n2w ((2 :num) * ffi_offset) :α word) = mc_conf.ccache_pc ∧ (1w :α word) && pc = (0w :α word) ∧ ∃(i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ (∀(index :num). index < i ⇒ pc − (n2w (((3 :num) + index) * ffi_offset) :α word) ∉ mc_conf.prog_addresses ∧ pc − (n2w (((3 :num) + index) * ffi_offset) :α word) ∉ mc_conf.shared_addresses ∧ pc − (n2w (((3 :num) + index) * ffi_offset) :α word) ≠ mc_conf.halt_pc ∧ pc − (n2w (((3 :num) + index) * ffi_offset) :α word) ≠ mc_conf.ccache_pc ∧ find_index (pc − (n2w (((3 :num) + index) * ffi_offset) :α word)) mc_conf.ffi_entry_pcs (0 :num) = SOME index) ∧ (∀(index :num). index < LENGTH mc_conf.ffi_names ∧ i ≤ index ⇒ mc_conf.halt_pc ≠ mc_conf.ffi_entry_pcs❲index❳ ∧ mc_conf.ccache_pc ≠ mc_conf.ffi_entry_pcs❲index❳) ∧ LENGTH mc_conf.ffi_names = LENGTH mc_conf.ffi_entry_pcs
ccache_interfer_ok_def_typed=∀(pc :α word) (mc_conf :(α, β, γ) machine_config). ccache_interfer_ok pc mc_conf ⇔ ∀(ms2 :β) (t1 :α asm_state) (k :num) (a1 :α word) (a2 :α word). target_state_rel mc_conf.target (t1 with pc := -(n2w ((2 :num) * ffi_offset) :α word) + pc) ms2 ∧ aligned mc_conf.target.config.code_alignment (t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n)) ⇒ (let (ms' :β) = mc_conf.ccache_interfer k (a1,a2,ms2) in mc_conf.target.state_ok ms' ∧ mc_conf.target.get_pc ms' = t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ∧ (∀(a :α word). a ∈ t1.mem_domain ⇒ mc_conf.target.get_byte ms' a = t1.mem a) ∧ ∀(r :num). (MEM r mc_conf.callee_saved_regs ∨ r = mc_conf.ptr_reg) ∧ r < mc_conf.target.config.reg_count ∧ ¬MEM r mc_conf.target.config.avoid_regs ⇒ mc_conf.target.get_reg ms' r = t1.regs r)
ffi_interfer_ok_def_typed=∀(pc :α word) (mc_conf :(α, β, γ) machine_config). ffi_interfer_ok pc mc_conf ⇔ ∀(ms2 :β) (k :num) (index :num) (new_bytes :word8 list) (t1 :α asm_state) (bytes :word8 list) (bytes2 :word8 list) (i :num). index < LENGTH mc_conf.ffi_names ∧ mmio_pcs_min_index mc_conf.ffi_names = SOME i ∧ mc_conf.prog_addresses = t1.mem_domain ⇒ (index < i ⇒ read_ffi_bytearrays mc_conf ms2 = (SOME bytes,SOME bytes2) ∧ LENGTH new_bytes = LENGTH bytes2 ∧ (mc_conf.ffi_names❲index❳ = ExtCall «» ⇒ new_bytes = bytes2) ∧ target_state_rel mc_conf.target (t1 with pc := -(n2w (((3 :num) + index) * ffi_offset) :α word) + pc) ms2 ∧ aligned mc_conf.target.config.code_alignment (t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n)) ⇒ (let (ms' :β) = mc_conf.ffi_interfer k (index,new_bytes,ms2) in mc_conf.target.state_ok ms' ∧ mc_conf.target.get_pc ms' = t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ∧ (∀(a :α word). a ∈ t1.mem_domain ⇒ mc_conf.target.get_byte ms' a = asm_write_bytearray (t1.regs mc_conf.ptr2_reg) new_bytes t1.mem a) ∧ ∀(r :num). MEM r mc_conf.callee_saved_regs ∧ r < mc_conf.target.config.reg_count ∧ ¬MEM r mc_conf.target.config.avoid_regs ⇒ mc_conf.target.get_reg ms' r = t1.regs r)) ∧ (i ≤ index ∧ target_state_rel mc_conf.target (t1 with pc := mc_conf.ffi_entry_pcs❲index❳) ms2 ⇒ ∃(info :word8 # α addr # num # α word). ALOOKUP mc_conf.mmio_info index = SOME info ∧ (mc_conf.ffi_names❲index❳ = SharedMem MappedRead ⇒ ∀(new_bytes :word8 list). target_state_rel mc_conf.target (t1 with <|pc := SND (SND (SND info)); regs := (λ(n :num). if n = FST (SND (SND info)) then word_of_bytes F (0w :α word) new_bytes else t1.regs n)|>) (mc_conf.ffi_interfer k (index,new_bytes,ms2))) ∧ (mc_conf.ffi_names❲index❳ = SharedMem MappedWrite ⇒ target_state_rel mc_conf.target (t1 with pc := SND (SND (SND info))) (mc_conf.ffi_interfer k (index,new_bytes,ms2))))
code_loaded_def_typed=∀(bytes :word8 list) (mc :(α, β, γ) machine_config) (ms :β). code_loaded bytes mc ms ⇔ read_bytearray (mc.target.get_pc ms) (LENGTH bytes) (λ(a :α word). if a ∈ mc.prog_addresses then SOME (mc.target.get_byte ms a) else (NONE :word8 option)) = SOME bytes
get_reg_value_def_typed=(∀(w :α) (f :β -> α). get_reg_value (NONE :β option) w f = w) ∧ ∀(v :β) (v0 :α) (f :β -> α). get_reg_value (SOME v) v0 f = f v
target_configured_def_typed=∀(t :α asm_state) (mc_conf :(α, β, γ) machine_config). target_configured t mc_conf ⇔ ¬t.failed ∧ (t.be ⇔ mc_conf.target.config.big_endian) ∧ t.align = mc_conf.target.config.code_alignment ∧ t.mem_domain = mc_conf.prog_addresses ∧ case mc_conf.target.config.link_reg of (NONE :num option) => T | SOME r => t.lr = r
machine_sem_def_typed=(∀(mc :(α, β, γ) machine_config) (st :δ ffi_state) (ms :β) (t :outcome) (io_list :io_event list). machine_sem mc st ms (Terminate t io_list) ⇔ ∃(k :num) (ms' :β) (st' :δ ffi_state). (evaluate mc st k ms :machine_result # β # δ ffi_state) = ((Halt t :machine_result),ms',st') ∧ st'.io_events = io_list) ∧ (∀(mc :(α, β, γ) machine_config) (st :δ ffi_state) (ms :β) (io_trace :io_event llist). machine_sem mc st ms (Diverge io_trace) ⇔ (∀(k :num). ∃(ms' :β) (st' :δ ffi_state). (evaluate mc st k ms :machine_result # β # δ ffi_state) = (TimeOut,ms',st')) ∧ lprefix_lub (IMAGE (λ(k :num). (fromList (SND (SND (evaluate mc st k ms :machine_result # β # δ ffi_state))).io_events :io_event llist)) 𝕌(:num)) io_trace) ∧ ∀(mc :(α, β, γ) machine_config) (st :δ ffi_state) (ms :β). machine_sem mc st ms Fail ⇔ ∃(k :num). FST (evaluate mc st k ms :machine_result # β # δ ffi_state) = Error
is_valid_mapped_read_def_typed=∀(pc :α word) (nb :word8) (ad :α addr) (r :num) (pc' :β) (t :(α, γ, δ) target) (ms :γ) (md :α word -> bool). is_valid_mapped_read pc nb ad r pc' t ms md ⇔ if nb = (1w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Load8 r ad) :α asm)) (t.get_byte ms) md else if nb = (0w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Load r ad) :α asm)) (t.get_byte ms) md else if nb = (2w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Load16 r ad) :α asm)) (t.get_byte ms) md else if nb = (4w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Load32 r ad) :α asm)) (t.get_byte ms) md else F
is_valid_mapped_write_def_typed=∀(pc :α word) (nb :word8) (ad :α addr) (r :num) (pc' :β) (t :(α, γ, δ) target) (ms :γ) (md :α word -> bool). is_valid_mapped_write pc nb ad r pc' t ms md ⇔ if nb = (1w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Store8 r ad) :α asm)) (t.get_byte ms) md else if nb = (0w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Store r ad) :α asm)) (t.get_byte ms) md else if nb = (2w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Store16 r ad) :α asm)) (t.get_byte ms) md else if nb = (4w :word8) then bytes_in_memory pc (t.config.encode (Inst (Mem Store32 r ad) :α asm)) (t.get_byte ms) md else F
mmio_pcs_min_index_def_typed=∀(ffi_names :ffiname list). mmio_pcs_min_index ffi_names = some(x :num). x ≤ LENGTH ffi_names ∧ (∀(j :num). j < x ⇒ ∃(s :mlstring). ffi_names❲j❳ = ExtCall s) ∧ ∀(j :num). x ≤ j ∧ j < LENGTH ffi_names ⇒ ∃(op :shmem_op). ffi_names❲j❳ = SharedMem op
post_ccache_asm_def_typed=∀(mc_conf :(α, 'state, β) machine_config) (t1 :α asm_state) (ms' :'state). post_ccache_asm mc_conf t1 ms' = t1 with <|regs := (λ(a :num). if MEM a mc_conf.callee_saved_regs ∨ a = mc_conf.ptr_reg ∨ ¬(a < mc_conf.target.config.reg_count) ∨ MEM a mc_conf.target.config.avoid_regs then t1.regs a else mc_conf.target.get_reg ms' a); fp_regs := (λ(i :num). mc_conf.target.get_fp_reg ms' i); pc := t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n)|>
post_ffi_asm_def_typed=∀(mc_conf :(α, 'state, β) machine_config) (t1 :α asm_state) (new_bytes :word8 list) (ms' :'state). post_ffi_asm mc_conf t1 new_bytes ms' = t1 with <|regs := (λ(a :num). if MEM a mc_conf.callee_saved_regs ∨ ¬(a < mc_conf.target.config.reg_count) ∨ MEM a mc_conf.target.config.avoid_regs then t1.regs a else mc_conf.target.get_reg ms' a); fp_regs := (λ(i :num). mc_conf.target.get_fp_reg ms' i); mem := asm_write_bytearray (t1.regs mc_conf.ptr2_reg) new_bytes t1.mem; pc := t1.regs (case mc_conf.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n)|>
machine_config_typed=recordtype.machine_config::(α word -> bool) -> (α word -> bool) -> α word list -> ffiname list -> num -> num -> num -> num -> (num -> num # word8 list # β -> β) -> num list -> (num -> β -> β) -> α word -> α word -> (num -> α word # α word # β -> β) -> (α, β, γ) target -> (num # word8 # α addr # num # α word) list -> (α, β, γ) machine_config
machine_result_typed=Halt::outcome -> machine_result; Error::machine_result; TimeOut::machine_result
installed_def_typed=∀(bytes :word8 list) (cbspace :num) (bitmaps :α word list) (data_sp :num) (ffi_names :ffiname list option) (r1 :num) (r2 :num) (mc_conf :(α, 'state, β) machine_config) (shmem_extra :shmem_info_num list) (ms :'state). installed bytes cbspace bitmaps data_sp ffi_names (r1,r2) mc_conf shmem_extra ms ⇔ ∃(t :α asm_state) (m :α word -> α word_loc) (bitmap_ptr :α word) (bitmaps_dm :α word -> bool) (sdm :α word -> bool). (let (heap_stack_dm :α word -> bool) = {w | t.regs r1 ≤₊ w ∧ w <₊ t.regs r2} in good_init_state mc_conf ms bytes cbspace t m (heap_stack_dm ∪ bitmaps_dm) sdm ∧ byte_aligned (t.regs r1) ∧ byte_aligned (t.regs r2) ∧ byte_aligned bitmap_ptr ∧ t.regs r1 ≤₊ t.regs r2 ∧ (1024w :α word) * (bytes_in_word :α word) ≤₊ t.regs r2 − t.regs r1 ∧ DISJOINT heap_stack_dm bitmaps_dm ∧ m (t.regs r1) = Word bitmap_ptr ∧ m (t.regs r1 + (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ m (t.regs r1 + (2w :α word) * (bytes_in_word :α word)) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w data_sp :α word) + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ m (t.regs r1 + (3w :α word) * (bytes_in_word :α word)) = Word (mc_conf.target.get_pc ms + (n2w (LENGTH bytes) :α word)) ∧ m (t.regs r1 + (4w :α word) * (bytes_in_word :α word)) = Word (mc_conf.target.get_pc ms + (n2w cbspace :α word) + (n2w (LENGTH bytes) :α word)) ∧ (word_list bitmap_ptr (MAP (Word :α word -> α word_loc) bitmaps) * (word_list_exists (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) data_sp :(α word # α word_loc -> bool) -> bool)) (fun2set (m,(byte_aligned :α word -> bool) ∩ bitmaps_dm)) ∧ ffi_names = SOME mc_conf.ffi_names ∧ ∀(i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ⇒ MAP (λ(rec :shmem_info_num). w2n (mc_conf.target.get_pc ms) + rec.entry_pc) shmem_extra = DROP i (MAP (w2n :α word -> num) mc_conf.ffi_entry_pcs) ∧ mc_conf.mmio_info = ZIP (GENLIST (λ(index :num). index + i) (LENGTH shmem_extra),MAP (λ(rec :shmem_info_num). (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off :α word),rec.reg,(n2w rec.exit_pc :α word) + mc_conf.target.get_pc ms)) shmem_extra) ∧ cbspace + LENGTH bytes + ffi_offset * (i + (3 :num)) < dimword (:α))
