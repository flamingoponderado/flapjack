hn_push_source=⊢ ∀perf l2 l1 kff. no_shmemop (PushHandler perf l1 l2 kff)
hn_pop_source=⊢ ∀prog perf kff. no_shmemop (PopHandler perf kff prog) ⇔ no_shmemop prog
hn_args_source=⊢ ∀perf kff dest arg_count. no_shmemop (StackHandlerArgs perf dest arg_count kff)
hn_push_type=:bool -> num -> num -> num # α # β -> γ stackLang$prog
hn_pop_type=:bool -> num # α # β -> γ stackLang$prog -> γ stackLang$prog
hn_args_type=:bool -> α + β -> num -> num # num # num -> γ stackLang$prog
hn_push_64_F=T
hn_pop_64_F_safe=(T,T)
hn_pop_64_F_forbidden=(F,F)
hn_push_64_T=T
hn_pop_64_T_safe=(T,T)
hn_pop_64_T_forbidden=(F,F)
hn_push_1_F=T
hn_pop_1_F_safe=(T,T)
hn_pop_1_F_forbidden=(F,F)
hn_push_1_T=T
hn_pop_1_T_safe=(T,T)
hn_pop_1_T_forbidden=(F,F)
hn_args_direct_zero=T
hn_args_direct_perf=T
hn_args_indirect_small=T
hn_args_indirect_huge=T
