rm_perm_statement=(s :(α, β, γ) state) with permute := s.permute = s
rm_perm_hypotheses=0
find_code_thm_statement=(∀(n :num) (v :num # α prog). (lookup n (st :(α, β, γ) state).code :(num # α prog) option) = SOME v ⇒ ∃(t :bool) (k :num) (a :num) (c :α asm_config) (col :num sptree$num_map option). (lookup n (l :(num # α prog) sptree$num_map) :(num # α prog) option) = SOME (SND (compile_single t k a c ((n,v),col)))) ∧ find_code (o1 :num option) (add_ret_loc (o' :(ε # ζ # η # num # num) option) (x :δ word_loc list)) st.code st.stack_size = SOME ((args :δ word_loc list),(prog :α prog),(locsize :num option)) ⇒ ∃(t :bool) (k :num) (a :num) (c :α asm_config) (col :num sptree$num_map option) (n :num) (prog' :α prog). SND (compile_single t k a c ((n,LENGTH args,prog),col)) = (LENGTH args,prog') ∧ find_code o1 (add_ret_loc o' x) l st.stack_size = SOME (args,prog',locsize)
find_code_thm_hypotheses=0
pop_env_termdep_statement=pop_env (rst :(α, β, γ) state) = SOME (x :(α, β, γ) state) ⇒ x.termdep = rst.termdep
pop_env_termdep_hypotheses=0
compile_single_eta_statement=compile_single (t :bool) (k :num) (a :num) (c :α asm_config) (((p :num),(x :num # α prog)),(y :num sptree$num_map option)) = (p,SND (compile_single t k a c ((p,x),y)))
compile_single_eta_hypotheses=0
code_rel_union_fromAList_statement=∀(s :(num # α prog) sptree$num_map) (l :(num # α prog) sptree$num_map) (ls :(num # num # α prog) list). (code_rel s l :bool) ∧ (domain s :num -> bool) = (domain l :num -> bool) ⇒ (code_rel (union s (fromAList ls) :(num # α prog) sptree$num_map) (union l (fromAList (MAP (λ(p :num # num # α prog). compile_single (t :bool) (k :num) (a :num) (c :α asm_config) (p,(NONE :num sptree$num_map option))) ls)) :(num # α prog) sptree$num_map) :bool)
code_rel_union_fromAList_hypotheses=0
code_rel_no_alloc_statement=find_code (op :num option) (args :α word_loc list) (c1 :(num # β prog) sptree$num_map) (sz :γ sptree$num_map) = SOME (v :α word_loc list # β prog # γ option) ∧ (code_rel c1 (c2 :(num # β prog) sptree$num_map) :bool) ∧ no_alloc (FST (SND v)) ∧ find_code op args c2 sz = SOME (v' :α word_loc list # β prog # γ option) ⇒ no_alloc (FST (SND v'))
code_rel_no_alloc_hypotheses=0
code_rel_no_install_statement=find_code (op :num option) (args :α word_loc list) (c1 :(num # β prog) sptree$num_map) (sz :γ sptree$num_map) = SOME (v :α word_loc list # β prog # γ option) ∧ (code_rel c1 (c2 :(num # β prog) sptree$num_map) :bool) ∧ no_install (FST (SND v)) ∧ find_code op args c2 sz = SOME (v' :α word_loc list # β prog # γ option) ⇒ no_install (FST (SND v'))
code_rel_no_install_hypotheses=0
