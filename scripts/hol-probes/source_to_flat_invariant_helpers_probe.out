globals_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idxs :next_indices # next_indices # (num # idx_types -> bool)) (s :'b semanticPrimitives$state) (s_i1 :('a, 'b) flatSem$state) ==> s_i1.globals = genv.v
constructors_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idxs :next_indices # next_indices # (num # idx_types -> bool)) (s :'b semanticPrimitives$state) (s_i1 :('a, 'b) flatSem$state) ==> genv_c_ok genv.c
shrink_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) ((l_idx :next_indices),(r_idx :next_indices),(etc :num # idx_types -> bool)) (st :'b semanticPrimitives$state) (st' :('a, 'b) flatSem$state) /\ idx_prev l_idx (l_idx' :next_indices) /\ idx_prev l_idx' r_idx ==> invariant interp g gen genv (l_idx',r_idx,etc) st st'
shrink_gen_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) ((l_idx :next_indices),(r_idx :next_indices),(etc :num # idx_types -> bool)) (st :'b semanticPrimitives$state) (st' :('a, 'b) flatSem$state) /\ idx_prev l_idx (l_idx' :next_indices) /\ idx_prev l_idx' r_idx /\ (env_gen_inv gen ==> env_gen_inv (gen' :environment_generation_store)) ==> invariant interp g gen' genv (l_idx',r_idx,etc) st st'
eval_ref_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (idxs :next_indices # next_indices # (num # idx_types -> bool)) (st :'b semanticPrimitives$state) (st' :('a, 'b) flatSem$state) ==> invariant interp g gen genv idxs st (st' with refs := Refv (y :v)::TL st'.refs)
end_eval_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen' :environment_generation_store) (genv :global_env) ((x :next_indices),(end_idx1 :next_indices),idx_block (idx :next_indices) (end_idx :next_indices) UNION (other :num # idx_types -> bool)) (st :'b semanticPrimitives$state) (st' :('a, 'b) flatSem$state) /\ invariant interp g (gen :environment_generation_store) (prev_genv :global_env) (idx,end_idx,other) (prev_st :'c semanticPrimitives$state) (prev_st' :('a, 'c) flatSem$state) /\ orac_forward_rel interp (begin_eval_state :eval_state option) st.eval_state /\ idx_prev end_idx end_idx1 /\ orac_config_envs_subspt interp prev_st.eval_state begin_eval_state /\ (case prev_st.eval_state of (NONE :eval_state option) => F | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => ?(s' :eval_oracle_state). begin_eval_state = SOME (EvalOracle s') /\ s'.envs = (add_env_generation s).envs /\ s'.generation = (add_env_generation s).generation) ==> invariant interp g gen genv (idx,end_idx,other) (st with eval_state := reset_env_generation prev_st.eval_state st.eval_state) st' /\ orac_forward_rel interp prev_st.eval_state (reset_env_generation prev_st.eval_state st.eval_state) /\ (env_gen_rel gen prev_st.eval_state ==> env_gen_rel gen (reset_env_generation prev_st.eval_state st.eval_state))
