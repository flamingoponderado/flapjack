max_var_def_typed=max_var (Skip :α prog) = (0 :num) ∧ (∀(pri :num) (ls :(num # num) list). max_var (Move pri ls :α prog) = MAX_LIST (MAP (FST :num # num -> num) ls ++ MAP (SND :num # num -> num) ls)) ∧ (∀(i :α inst). max_var (Inst i :α prog) = max_var_inst i) ∧ (∀(num :num) (exp :α exp). max_var (Assign num exp) = MAX num (max_var_exp exp)) ∧ (∀(store :store_name) (num :num). max_var (Get num store :α prog) = num) ∧ (∀(num :num) (exp :α exp). max_var (Store exp num :α prog) = MAX num (max_var_exp exp)) ∧ (∀(ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (h :(num # α prog # num # num) option) (dest :num option) (args :num list). max_var (Call ret dest args h :α prog) = (let (n :num) = MAX_LIST args in case ret of (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) => n | SOME (v7,v9,v11,v12) => (let (cutset_max :num) = MAX n (cutsets_max v9); (ret_max :num) = max3 (MAX_LIST v7) cutset_max (max_var v11) in case h of (NONE :(num # α prog # num # num) option) => ret_max | SOME (v2,v4,v5) => max3 v2 ret_max (max_var v4)))) ∧ (∀(s2 :α prog) (s1 :α prog). max_var (Seq s1 s2) = MAX (max_var s1) (max_var s2)) ∧ (∀(s1 :α prog). max_var (MustTerminate s1) = max_var s1) ∧ (∀(ri :α reg_imm) (r1 :num) (e3 :α prog) (e2 :α prog) (cmp :cmp). max_var (If cmp r1 ri e2 e3 :α prog) = (let (r :num) = case ri of (Reg r :α reg_imm) => MAX r r1 | Imm v3 => r1 in max3 r (max_var e2) (max_var e3))) ∧ (∀(numset :sptree$num_set # sptree$num_set) (num :num). max_var (Alloc num numset :α prog) = MAX num (cutsets_max numset)) ∧ (∀(ws :(bool # α word) list) (d :num) (c :num) (b :num) (a :num). max_var (StoreConsts a b c d ws :α prog) = MAX_LIST [a; b; c; d]) ∧ (∀(r4 :num) (r3 :num) (r2 :num) (r1 :num) (numset :sptree$num_set # sptree$num_set). max_var (Install r1 r2 r3 r4 numset :α prog) = MAX_LIST [r1; r2; r3; r4; cutsets_max numset]) ∧ (∀(r2 :num) (r1 :num). max_var (CodeBufferWrite r1 r2 :α prog) = MAX r1 r2) ∧ (∀(r2 :num) (r1 :num