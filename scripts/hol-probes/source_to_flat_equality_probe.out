do_eq_typed=∀(genv :global_env). genv_c_ok genv.c ⇒ (∀(v1 :semanticPrimitives$v) (v2 :semanticPrimitives$v) (r :eq_result) (v1_i1 :v) (v2_i1 :v). do_eq v1 v2 = r ∧ (v_rel genv v1 v1_i1 :bool) ∧ (v_rel genv v2 v2_i1 :bool) ⇒ do_eq v1_i1 v2_i1 = r) ∧ ∀(vs1 :semanticPrimitives$v list) (vs2 :semanticPrimitives$v list) (r :eq_result) (vs1_i1 :v list) (vs2_i1 :v list). do_eq_list vs1 vs2 = r ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs1 vs1_i1 ∧ LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs2 vs2_i1 ⇒ do_eq_list vs1_i1 vs2_i1 = r
