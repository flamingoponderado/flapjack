short_full=⊢ ∀ys xs words off m dm a. const_addresses a words dm ∧ good_dimindex (:α) ∧ LENGTH words < dimindex (:α) ⇒ copy_words (LENGTH xs) a off (xs ++ chunk_to_bitmap words ++ ys) dm m = if LENGTH words = dimindex (:α) − 1 then copy_words (LENGTH xs + (LENGTH words + 1)) (a + bytes_in_word * n2w (LENGTH words)) off (xs ++ chunk_to_bitmap words ++ ys) dm (const_writes a off words m) else SOME (a + bytes_in_word * n2w (LENGTH words),const_writes a off words m)
short_hypotheses=0
short_proved=T
