every_inst_ok_less_pan_to_crep_compile_prog=∀(pan_code :α decl list). EVERY (good_panops :α decl -> bool) pan_code ⇒ EVERY (λ((name :mlstring),(params :num list),(body :α crepLang$prog)). EVERY (every_exp (λ(x :α crepLang$exp). ∀(op :crepop) (es :α crepLang$exp list). x = Crepop op es ⇒ LENGTH es = (2 :num))) (exps_of body :α crepLang$exp list)) (compile_prog pan_code :(mlstring # num list # α crepLang$prog) list)
