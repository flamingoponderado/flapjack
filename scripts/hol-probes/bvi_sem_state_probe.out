evaluate_type=:bvi$exp list # v list # (α, β) state -> (v list, exn_or_ret) result # (α, β) state
eval_var=(evaluate ([(Var (0 :num) :bvi$exp)],[(Number (3 :int) :v)],(s :(γ, 'ffi) state)) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval [(Number (3 :int) :v)] :(v list, exn_or_ret) result),s)
eval_return=(evaluate ([Return ([] :bvi$exp list)],([] :v list),(s :(γ, 'ffi) state)) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rerr (Rraise (Ret ([] :v list))) :(v list, exn_or_ret) result),s)
eval_tick_timeout=(evaluate ([(Tick (Var (0 :num) :bvi$exp) :bvi$exp)],([] :v list),(s :(γ, 'ffi) state) with clock := (0 :num)) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rerr (Rabort Rtimeout_error :exn_or_ret error_result) :(v list, exn_or_ret) result),s with clock := (0 :num))
eval_call_bad_handler=(evaluate ([(Call (0 :num) (NONE :num option) ([] :bvi$exp list) (SOME (Var (0 :num) :bvi$exp)) :bvi$exp)],([] :v list),(s :(γ, 'ffi) state)) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result),s)
eval_force_evaluated=(evaluate ([(Force (5 :num) (0 :num) :bvi$exp)],[(RefPtr F (1 :num) :v)],(s :(γ, 'ffi) state) with refs := (FEMPTY :num |-> v ref)⟨(1 :num) ↦ (Thunk Evaluated (Number (7 :int) :v) :v ref)⟩) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval [(Number (7 :int) :v)] :(v list, exn_or_ret) result),s with refs := (FEMPTY :num |-> v ref)⟨(1 :num) ↦ (Thunk Evaluated (Number (7 :int) :v) :v ref)⟩)
eval_let_call_return=(evaluate ([LetCall (0 :num) (0 :num) (0 :num) ([] :bvi$exp list) (Var (0 :num) :bvi$exp)],[(Number (7 :int) :v)],(s :(γ, 'ffi) state) with <|clock := (2 :num); code := ⦕ 0 ↦ ((0 :num),Return ([] :bvi$exp list)) ⦖ |>) :(v list, exn_or_ret) result # (γ, 'ffi) state) = ((Rval [(Number (7 :int) :v)] :(v list, exn_or_ret) result),s with <|clock := (1 :num); code := ⦕ 0 ↦ ((0 :num),Return ([] :bvi$exp list)) ⦖ |>)
