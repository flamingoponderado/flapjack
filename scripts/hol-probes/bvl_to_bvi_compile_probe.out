smart_append_def=SmartAppend (Nil :α app_list) (l2 :α app_list) = l2 ∧ SmartAppend (List (v2 :α list) :α app_list) (Nil :α app_list) = (List v2 :α app_list) ∧ SmartAppend (Append (v3 :α app_list) (v4 :α app_list) :α app_list) (Nil :α app_list) = (Append v3 v4 :α app_list) ∧ SmartAppend (List (v5 :α list) :α app_list) (List (v11 :α list) :α app_list) = (Append (List v5 :α app_list) (List v11 :α app_list) :α app_list) ∧ SmartAppend (List v5 :α app_list) (Append (v12 :α app_list) (v13 :α app_list) :α app_list) = (Append (List v5 :α app_list) (Append v12 v13 :α app_list) :α app_list) ∧ SmartAppend (Append (v6 :α app_list) (v7 :α app_list) :α app_list) (List (v17 :α list) :α app_list) = (Append (Append v6 v7 :α app_list) (List v17 :α app_list) :α app_list) ∧ SmartAppend (Append v6 v7 :α app_list) (Append (v18 :α app_list) (v19 :α app_list) :α app_list) = (Append (Append v6 v7 :α app_list) (Append v18 v19 :α app_list) :α app_list)
compile_aux_def=∀(k :num) (args :α) (p :bvi$exp). compile_aux (k,args,p) = (List [(bvl_num_stubs + bvl_to_bvi_namespaces * k + (1 :num),args,(compile_exp p :bvi$exp))] :(num # α # bvi$exp) app_list)
compile_exps_sing_def=(∀(v :num) (n :num). compile_exps_sing n (Var v :exp) = ((Var v :bvi$exp),(Nil :(num # num # bvi$exp) app_list),n)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (n :num). compile_exps_sing n (If x1 x2 x3 :exp) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x1; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x2; ((c3 :bvi$exp),(aux3 :(num # num # bvi$exp) app_list),(n3 :num)) = compile_exps_sing n2 x3 in ((If c1 c2 c3 :bvi$exp),SmartAppend (SmartAppend aux1 aux2) aux3,n3))) ∧ (∀(xs :exp list) (x2 :exp) (n :num). compile_exps_sing n (Let xs x2 :exp) = if NULL xs then (let ((args :exp list),(x0 :exp)) = destLet x2; ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n args; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x0; (n3 :num) = n2 + (1 :num) in ((Call (0 :num) (SOME (bvl_num_stubs + bvl_to_bvi_namespaces * n2 + (1 :num))) c1 (NONE :bvi$exp option) :bvi$exp),SmartAppend (SmartAppend aux1 aux2) (compile_aux (n2,LENGTH args,c2)),n3)) else (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n xs; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x2 in ((Let c1 c2 :bvi$exp),SmartAppend aux1 aux2,n2))) ∧ (∀(x1 :exp) (n :num). compile_exps_sing n (Raise x1 :exp) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x1 in ((Raise c1 :bvi$exp),aux1,n1))) ∧ (∀(x1 :exp) (n :num). compile_exps_sing n (Tick x1 :exp) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x1 in ((Tick c1 :bvi$exp),aux1,n1))) ∧ (∀(v :num) (n :num) (loc :num). compile_exps_sing n (Force loc v :exp) = ((Force (bvl_num_stubs + bvl_to_bvi_namespaces * loc) v :bvi$exp),(Nil :(num # num # bvi$exp) app_list),n)) ∧ (∀(xs :exp list) (op :op) (n :num). compile_exps_sing n (Op op xs :exp) = (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n xs in (compile_op op c1,aux1,n1))) ∧ (∀(x2 :exp) (x1 :exp) (n :num). compile_exps_sing n (Handle x1 x2 :exp) = (let ((args :exp list),(x0 :exp)) = destLet x1; ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n args; ((c2 :bvi$exp),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_sing n1 x0; ((c3 :bvi$exp),(aux3 :(num # num # bvi$exp) app_list),(n3 :num)) = compile_exps_sing n2 x2; (aux4 :(num # num # bvi$exp) app_list) = compile_aux (n3,LENGTH args,c2); (n4 :num) = n3 + (1 :num) in ((Call (0 :num) (SOME (bvl_num_stubs + bvl_to_bvi_namespaces * n3 + (1 :num))) c1 (SOME c3) :bvi$exp),SmartAppend (SmartAppend (SmartAppend aux1 aux2) aux3) aux4,n4))) ∧ (∀(xs :exp list) (ticks :num) (n :num) (dest :num option). compile_exps_sing n (Call ticks dest xs :exp) = (let ((c1 :bvi$exp list),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_list n xs in ((Call ticks (case dest of (NONE :num option) => (NONE :num option) | SOME n => SOME (bvl_num_stubs + bvl_to_bvi_namespaces * n)) c1 (NONE :bvi$exp option) :bvi$exp),aux1,n1))) ∧ (∀(n :num). compile_exps_list n ([] :exp list) = (([] :bvi$exp list),(Nil :(num # num # bvi$exp) app_list),n)) ∧ ∀(xs :exp list) (x :exp) (n :num). compile_exps_list n (x::xs) = (let ((c1 :bvi$exp),(aux1 :(num # num # bvi$exp) app_list),(n1 :num)) = compile_exps_sing n x; ((c2 :bvi$exp list),(aux2 :(num # num # bvi$exp) app_list),(n2 :num)) = compile_exps_list n1 xs in (c1::c2,SmartAppend aux1 aux2,n2))
compile_exps_sing=(∀(n :num) (e :exp). compile_exps n [e] = (let ((x :bvi$exp),(y :(num # num # bvi$exp) app_list),(z :num)) = compile_exps_sing n e in ([x],y,z))) ∧ ∀(n :num) (es :exp list). compile_exps_list n es = compile_exps n es
