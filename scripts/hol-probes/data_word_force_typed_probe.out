force_thunk_typed=⊢ ∀(c :config) (secn :num) (l :num) (ret :(num # β sptree$num_map) option) (loc :num) (v1 :num). (force_thunk c secn l ret loc v1 :α prog # num) = case (encode_header c ((8 :num) + (6 :num)) (1 :num) :α word option) of (NONE :α word option) => ((GiveUp :α prog),l) | SOME header => ((If Test (adjust_var v1) (Imm (1w :α word)) (case ret of (NONE :(num # β sptree$num_map) option) => (Return (0 :num) [adjust_var v1] :α prog) | SOME (dest,v3) => (Assign (adjust_var dest) (Var (adjust_var v1) :α exp) :α prog)) (list_Seq [(Assign (1 :num) (real_addr c (adjust_var v1) :α exp) :α prog); (Assign (3 :num) (Op And [(Load (Var (1 :num) :α exp) :α exp); (Const (60w :α word) :α exp)] :α exp) :α prog); (If Equal (3 :num) (Imm (n2w (((8 :num) + (6 :num)) * (4 :num)) :α word)) (case ret of (NONE :(num # β sptree$num_map) option) => list_Seq [(Assign (1 :num) (Load (Op Add [(Var (1 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α exp) :α prog); (Return (0 :num) [(1 :num)] :α prog)] | SOME (dest,v2) => (Assign (adjust_var dest) (Load (Op Add [(Var (1 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α exp) :α prog)) (If NotEqual (3 :num) (Imm (n2w (((0 :num) + (6 :num)) * (4 :num)) :α word)) (case ret of (NONE :(num # β sptree$num_map) option) => (Return (0 :num) [adjust_var v1] :α prog) | SOME (dest,v3) => (Assign (adjust_var dest) (Var (adjust_var v1) :α exp) :α prog)) (list_Seq [(Assign (5 :num) (Load (Op Add [(Var (1 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α exp) :α prog); case ret of (NONE :(num # β sptree$num_map) option) => (Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME loc) [(0 :num); adjust_var v1; (5 :num)] (NONE :(num # α prog # num # num) option) :α prog) | SOME (r,ns) => (Call (SOME ([adjust_var r],adjust_sets ns,(Skip :α prog),secn,l)) (SOME loc) [adjust_var v1; (5 :num)] (NONE :(num # α prog # num # num) option) :α prog)]) :α prog) :α prog)]) :α prog),l + (1 :num))
arg4_typed=⊢ ∀(vs :β list) (f :β -> β -> β -> β -> α) (x :α). arg4 vs f x = case vs of ([] :β list) => x | [v1] => x | [v1; v2] => x | [v1; v2; v3] => x | [v1; v2; v3; v4] => f v1 v2 v3 v4 | v1::v2::v3::v4::v22::v23 => x
set_bool_typed=⊢ ∀(dest :num) (cmp :cmp) (r :num) (ri :α reg_imm). SetBool dest cmp r ri = (If cmp r ri (Assign dest TRUE_CONST :α prog) (Assign dest FALSE_CONST :α prog) :α prog)
assign_cmp_typed=⊢ (∀(dest :num) (v1 :num) (v2 :num). (AssignCmp dest Lt v1 v2 :α prog) = SetBool dest Lower v1 (Reg v2 :α reg_imm)) ∧ (∀(dest :num) (v1 :num) (v2 :num). (AssignCmp dest Gt v1 v2 :α prog) = SetBool dest Lower v2 (Reg v1 :α reg_imm)) ∧ (∀(dest :num) (v1 :num) (v2 :num). (AssignCmp dest Leq v1 v2 :α prog) = SetBool dest NotLower v2 (Reg v1 :α reg_imm)) ∧ ∀(dest :num) (v1 :num) (v2 :num). (AssignCmp dest Geq v1 v2 :α prog) = SetBool dest NotLower v1 (Reg v2 :α reg_imm)
assign_string_cmp_typed=⊢ ∀(c :config) (secn :num) (l :num) (dest :num) (names :sptree$num_set option) (b :bool) (cmp :opb) (v1 :num) (v2 :num). (assign_StringCmp c secn l dest names b cmp v1 v2 :α prog # num) = (let (k :num) = dimindex (:α) − c.len_size − shift (:α) in (list_Seq [(Assign (1 :num) (real_addr c (adjust_var v1) :α exp) :α prog); (Assign (3 :num) (real_addr c (adjust_var v2) :α exp) :α prog); (Assign (5 :num) (ShiftN Lsr (Load (Var (1 :num) :α exp) :α exp) k) :α prog); (Assign (7 :num) (ShiftN Lsr (Load (Var (3 :num) :α exp) :α exp) k) :α prog); if b then (If Equal (5 :num) (Reg (7 :num) :α reg_imm) (list_Seq [(Assign (11 :num) (Op Add [(Var (1 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α prog); (Assign (13 :num) (Op Add [(Var (3 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α prog); MustTerminate (Call (SOME ([(5 :num); (7 :num)],adjust_sets (get_names names),(Skip :α prog),secn,l)) (SOME StringCmpLoop_location) [(11 :num); (13 :num); (7 :num); (7 :num); (7 :num)] (NONE :(num # α prog # num # num) option) :α prog)]) (Skip :α prog) :α prog) else list_Seq [(Assign (11 :num) (Op Add [(Var (1 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α prog); (Assign (13 :num) (Op Add [(Var (3 :num) :α exp); (Const (bytes_in_word :α word) :α exp)] :α exp) :α prog); (Assign (9 :num) (Var (5 :num) :α exp) :α prog); (If Lower (7 :num) (Reg (5 :num) :α reg_imm) (Assign (9 :num) (Var (7 :num) :α exp) :α prog) (Skip :α prog) :α prog); MustTerminate (Call (SOME ([(5 :num); (7 :num)],adjust_sets (get_names names),(Skip :α prog),secn,l)) (SOME StringCmpLoop_location) [(11 :num); (13 :num); (9 :num); (5 :num); (7 :num)] (NONE :(num # α prog # num # num) option) :α prog)]; (AssignCmp (adjust_var dest) cmp (5 :num) (7 :num) :α prog)],l + (1 :num)))
