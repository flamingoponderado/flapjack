state_co=∀(f :δ -> ε -> ζ # γ) (co :α -> (δ # β) # ε). state_co f co = (λ(n :α). (let (((state :δ),(cfg :β)),(progs :ε)) = co n; ((state1 :ζ),(progs :γ)) = f state progs in (cfg,progs)))
oracle_monotonic=∀(f :α -> β -> bool) (R :β -> β -> bool) (S :β -> bool) (orac :num -> α). oracle_monotonic f R S orac ⇔ (∀(i :num) (j :num) (x :β) (y :β). i < j ∧ x ∈ f (orac i) ∧ y ∈ f (orac j) ⇒ R x y) ∧ ∀(i :num) (x :β) (y :β). x ∈ S ∧ y ∈ f (orac i) ⇒ R x y
is_state_oracle=∀(compile_inc_f :α -> β -> α # γ) (co :num -> (α # δ) # β). is_state_oracle compile_inc_f co ⇔ ∀(n :num). FST (FST (co (SUC n))) = FST (compile_inc_f (FST (FST (co n))) (SND (co n)))
monotonic_with_invariant=∀(P :α -> bool) (n_f :α -> num). P (FST (FST ((orac :num -> (α # β) # γ) (0 :num)))) ∧ (∀(x :num). x ∈ (St :num -> bool) ⇒ x < n_f (FST (FST (orac (0 :num))))) ∧ (∀(st :α) (prog :γ) (st' :α) (prog' :δ). (f_inc :α -> γ -> α # δ) st prog = (st',prog') ∧ P st ⇒ P st' ∧ n_f st ≤ n_f st' ∧ ∀(cfg :β) (x :num). x ∈ (f :β # δ -> num -> bool) (cfg,prog') ⇒ n_f st ≤ x ∧ x < n_f st') ∧ is_state_oracle f_inc orac ⇒ oracle_monotonic f $< St (state_co f_inc orac)
state_cc=∀(f :α -> γ -> ζ # θ) (cc :β -> θ -> (δ # ε # η) option). state_cc f cc = (λ((state :α),(cfg :β)) (prog :γ). (let ((state1 :ζ),(prog1 :θ)) = f state prog in case cc cfg prog1 of (NONE :(δ # ε # η) option) => (NONE :(δ # ε # ζ # η) option) | SOME (code,data,cfg1) => SOME (code,data,state1,cfg1)))
FST_state_co=FST (state_co (f :γ -> δ -> ε # β) (co :ζ -> (γ # α) # δ) (n :ζ)) = SND (FST (co n))
SND_state_co=SND (state_co (f :γ -> δ -> ε # α) (co :ζ -> (γ # β) # δ) (n :ζ)) = SND (f (FST (FST (co n))) (SND (co n)))
state_cc_success=state_cc (λ(s :num) (p :num). (s + (1 :num),p + (2 :num))) (λ(c :num) (p :num). SOME (p,T,c + (3 :num))) ((4 :num),(5 :num)) (6 :num) = SOME ((8 :num),T,(5 :num),(8 :num))
state_cc_failure=state_cc (λ(s :num) (p :num). (s + (1 :num),p + (2 :num))) (λ(c :num) (p :num). (NONE :(num # bool # num) option)) ((4 :num),(5 :num)) (6 :num) = (NONE :(num # bool # num # num) option)
