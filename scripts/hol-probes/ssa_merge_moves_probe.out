merge_missing_both=([],[],5,LN,LN)
merge_missing_left=([],[],5,LN,⦕ 1 ↦ 9 ⦖)
merge_missing_right=([],[],5,⦕ 1 ↦ 7 ⦖,LN)
merge_equal=([],[],5,⦕ 1 ↦ 7 ⦖,⦕ 1 ↦ 7 ⦖)
merge_unequal=([(5,7)],[(5,9)],9,⦕ 1 ↦ 5 ⦖,⦕ 1 ↦ 5 ⦖)
merge_tail_order=([(9,7); (5,11)],[(9,9); (5,13)],13,⦕ 0 ↦ 9; 2 ↦ 5 ⦖,⦕ 0 ↦ 9; 2 ↦ 5 ⦖)
merge_duplicate=([(5,7)],[(5,9)],9,⦕ 1 ↦ 5 ⦖,⦕ 1 ↦ 5 ⦖)
merge_invalid=([],[],0,BN LN LN,⦕ 0 ↦ 7; 4 ↦ 9 ⦖)
merge_big=([(18446744073709551616,18446744073709551616)],[(18446744073709551616,3)],
 18446744073709551620,⦕ 0 ↦ 18446744073709551616 ⦖,
