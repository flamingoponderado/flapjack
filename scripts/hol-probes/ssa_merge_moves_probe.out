merge_definition=⊢ (∀ssa_L ssa_R na. merge_moves [] ssa_L ssa_R na = ([],[],na,ssa_L,ssa_R)) ∧
  ∀x xs ssa_L ssa_R na.
    merge_moves (x::xs) ssa_L ssa_R na =
    (let
       (seqL,seqR,na',ssa_L',ssa_R') = merge_moves xs ssa_L ssa_R na;
       optLx = lookup x ssa_L';
       optLy = lookup x ssa_R'
     in
       case (optLx,optLy) of
         (NONE,v3) => (seqL,seqR,na',ssa_L',ssa_R')
       | (SOME Lx,NONE) => (seqL,seqR,na',ssa_L',ssa_R')
       | (SOME Lx,SOME Ly) =>
         if Lx = Ly then (seqL,seqR,na',ssa_L',ssa_R')
         else
           (let
              Lmove = (na',Lx);
              Rmove = (na',Ly)
            in
              (Lmove::seqL,Rmove::seqR,na' + 4,insert x na' ssa_L',
               insert x na' ssa_R')))
merge_original_type=:num list ->
num sptree$num_map ->
num sptree$num_map ->
num ->
(num # num) list #
(num # num) list # num # num sptree$num_map # num sptree$num_map
