load "preamble";
load "stackPropsTheory";
open bossLib HolKernel Parse preamble stackPropsTheory;
fun out label q = (print (label ^ "="); print_term (rconc (EVAL q)); print "\n");
val _ = out "sl_skip" ``let p = (stackLang$Skip : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({},{})``;
val _ = out "sl_jump" ``let p = (JumpLower 1 2 9 : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,0)},{})``;
val _ = out "sl_raw" ``let p = (RawCall 9 : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,1)},{})``;
val _ = out "sl_location" ``let p = (LocValue 2 9 4 : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,4)},{})``;
val _ = out "sl_store_none" ``let p = (StoreConsts 1 2 NONE : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({},{})``;
val _ = out "sl_store_some" ``let p = (StoreConsts 1 2 (SOME 9) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,0)},{})``;
val _ = out "sl_direct_tail" ``let p = (Call NONE (INL 8) NONE : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(8,0)},{})``;
val _ = out "sl_indirect_tail_handler" ``let p = (Call NONE (INR 8) (SOME (LocValue 2 9 4,7,5)) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,4)},{})``;
val _ = out "sl_direct_tail_handler" ``let p = (Call NONE (INL 8) (SOME (LocValue 2 9 4,7,5)) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(8,0);(9,4)},{})``;
val _ = out "sl_return_owner" ``let p = (Call (SOME (LocValue 2 3 6,4,5,6)) (INL 8) (SOME (RawCall 9,7,5)) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(8,0);(3,6);(9,1)},{(7,5)})``;
val _ = out "sl_return_other_owner" ``let p = (Call (SOME (LocValue 2 3 6,4,5,6)) (INR 8) (SOME (RawCall 9,6,5)) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(3,6);(9,1)},{})``;
val _ = out "sl_return_no_handler" ``let p = (Call (SOME (LocValue 2 3 6,4,5,6)) (INR 8) NONE : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(3,6)},{})``;
val _ = out "sl_sequence_duplicate" ``let p = (Seq (RawCall 9) (RawCall 9) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,1)},{})``;
val _ = out "sl_if_loop" ``let p = (If Equal 0 (Reg 1) (Loop (RawCall 9)) (LocValue 2 9 4) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({(9,1);(9,4)},{})``;
val _ = out "sl_nested_handlers" ``let p = (Call (SOME (Call (SOME (Skip,1,2,3)) (INR 0) (SOME (Skip,7,2)),4,5,6)) (INR 0) (SOME (Call (SOME (Skip,1,2,3)) (INR 0) (SOME (Skip,7,3)),6,5)) : 64 stackLang$prog) in (get_code_labels p,stack_get_handler_labels 7 p) = ({},{(7,2);(7,3)})``;
