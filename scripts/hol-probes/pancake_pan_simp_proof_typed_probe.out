compile_correct_typed=∀(v :α panLang$prog) (v1 :(α, β) state) (res :α result option) (s1 :(α, β) state) (t :(α, β) state). evaluate (v,v1) = (res,s1) ∧ res ≠ SOME (Error :α result) ∧ state_rel v1 t t.code ⇒ ∃(t1 :(α, β) state). evaluate (seq_assoc (Skip :α panLang$prog) v,t) = (res,t1) ∧ state_rel s1 t1 t1.code
compile_correct_same_state_typed=FST (evaluate ((p :α panLang$prog),(s :(α, β) state))) ≠ SOME (Error :α result) ⇒ evaluate (compile p,s) = evaluate (p,s)
compile_eval_correct_typed=∀(s :(α, β) state) (e :α panLang$exp) (v :α v) (t :(α, β) state). eval s e = SOME v ∧ state_rel s t t.code ⇒ eval t e = SOME v
decs_stcnames_compile_prog_typed=∀(ctxt :(mlstring # struct_info) list) (pan_code :α decl list). decs_stcnames ctxt (compile_prog pan_code) = decs_stcnames ctxt pan_code
eval_seq_assoc_eq_evaluate_typed=evaluate (seq_assoc (Skip :α panLang$prog) (p :α panLang$prog),(s :(α, β) state)) = ((res :α result option),(t :(α, β) state)) ⇒ evaluate (p,s) = (res,t)
eval_seq_assoc_not_error_typed=FST (evaluate ((p :α panLang$prog),(s :(α, β) state))) ≠ SOME (Error :α result) ⇒ FST (evaluate (seq_assoc (Skip :α panLang$prog) p,s)) ≠ SOME (Error :α result)
evaluate_SmartSeq_typed=evaluate (SmartSeq (p :α panLang$prog) (q :α panLang$prog),(s :(α, 'ffi) state)) = evaluate (Seq p q,s)
evaluate_seq_assoc_typed=∀(p :α panLang$prog) (q :α panLang$prog) (s :(α, 'ffi) state). evaluate (seq_assoc p q,s) = evaluate (Seq p q,s)
evaluate_seq_call_ret_eq_typed=∀(p :α panLang$prog) (s :(α, β) state). FST (evaluate (p,s)) ≠ SOME (Error :α result) ⇒ evaluate (seq_call_ret p,s) = evaluate (p,s)
evaluate_seq_no_error_fst_typed=FST (evaluate (Seq (p :α panLang$prog) (p' :α panLang$prog),(s :(α, β) state))) ≠ SOME (Error :α result) ⇒ FST (evaluate (p,s)) ≠ SOME (Error :α result)
evaluate_seq_simp_typed=evaluate ((p :α panLang$prog),(s :(α, β) state)) = ((res :α result option),(t :(α, β) state)) ∧ res ≠ SOME (Error :α result) ⇒ evaluate (compile p,s) = (res,t)
evaluate_seq_skip_typed=∀(p :α panLang$prog) (s :(α, 'ffi) state). evaluate (Seq p (Skip :α panLang$prog),s) = evaluate (p,s)
evaluate_skip_seq_typed=evaluate (Seq (Skip :α panLang$prog) (p :α panLang$prog),(s :(α, 'ffi) state)) = evaluate (p,s)
evaluate_while_body_same_typed=(∀(s :(α, β) state). evaluate ((body :α panLang$prog),s) = evaluate ((body' :α panLang$prog),s)) ⇒ ∀(s :(α, β) state). evaluate ((While (e :α panLang$exp) body :α panLang$prog),s) = evaluate ((While e body' :α panLang$prog),s)
evaluate_while_no_error_imp_typed=eval (s :(α, β) state) (e :α panLang$exp) = SOME (ValWord (w :α word)) ∧ w ≠ (0w :α word) ∧ s.clock ≠ (0 :num) ∧ FST (evaluate ((While e (c :α panLang$prog) :α panLang$prog),s)) ≠ SOME (Error :α result) ⇒ FST (evaluate (c,dec_clock s)) ≠ SOME (Error :α result)
exp_ids_compile_eq_typed=∀(p :α panLang$prog). exp_ids (compile p) = exp_ids p
exp_ids_ret_to_tail_eq_typed=∀(p :α panLang$prog). exp_ids (ret_to_tail p) = exp_ids p
exp_ids_seq_assoc_eq_typed=∀(p :α panLang$prog) (q :α panLang$prog). exp_ids (seq_assoc p q) = exp_ids p ++ exp_ids q
first_compile_prog_all_distinct_typed=ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (prog :α decl list))) ⇒ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (compile_prog prog)))
functions_compile_prog_typed=functions (compile_prog (prog :α decl list)) = MAP (λ((x :mlstring),(y :(mlstring # shape) list),(z :α panLang$prog),(t :shape)). (x,y,compile z,t)) (functions prog)
map_snd_f_eq_typed=∀(p :(α # β # γ) list) (f :γ -> δ) (g :δ -> ε). MAP (g ∘ (SND :β # δ -> δ) ∘ (SND :α # β # δ -> β # δ) ∘ (λ((name :α),(params :β),(body :γ)). (name,params,f body))) p = MAP (g ∘ f) (MAP ((SND :β # γ -> γ) ∘ (SND :α # β # γ -> β # γ)) p)
ret_to_tail_correct_typed=∀(v :α panLang$prog) (v1 :(α, β) state). FST (evaluate (v,v1)) ≠ SOME (Error :α result) ⇒ evaluate (ret_to_tail v,v1) = evaluate (v,v1)
size_of_eids_compile_eq_typed=∀(pan_code :α decl list). size_of_eids (compile_prog pan_code) = size_of_eids pan_code
state_rel_def_typed=∀(s :(α, β) state) (t :(α, β) state) (c :mlstring |-> (mlstring # shape) list # α panLang$prog # shape). state_rel s t c ⇔ t = s with code := c ∧ (∀(f :mlstring). FLOOKUP s.code f = (NONE :((mlstring # shape) list # α panLang$prog # shape) option) ⇒ FLOOKUP c f = (NONE :((mlstring # shape) list # α panLang$prog # shape) option)) ∧ ∀(f :mlstring) (vshs :(mlstring # shape) list) (prog :α panLang$prog) (rshape :shape). FLOOKUP s.code f = SOME (vshs,prog,rshape) ⇒ FLOOKUP c f = SOME (vshs,compile prog,rshape)
state_rel_imp_evaluate_decls_typed=∀(s :(α, β) state) (pan_code :α decl list) (t :(α, β) state) (s' :(α, β) state) (start :γ). state_rel s t t.code ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ evaluate_decls s pan_code = SOME s' ⇒ ∃(t' :(α, β) state). evaluate_decls t (compile_prog pan_code) = SOME t' ∧ state_rel s' t' t'.code
state_rel_imp_semantics_typed=∀(s :(α, β) state) (t :(α, β) state) (pan_code :α decl list) (start :mlstring). state_rel s t t.code ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ s.code = alist_to_fmap (functions pan_code) ∧ t.code = alist_to_fmap (functions (compile_prog pan_code)) ∧ semantics s start ≠ Fail ⇒ semantics t start = semantics s start
state_rel_imp_semantics_decls_typed=∀(s :(α, β) state) (t :(α, β) state) (pan_code :α decl list) (start :mlstring). state_rel s t t.code ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ t.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ semantics_decls s start pan_code ≠ Fail ⇒ semantics_decls s start pan_code = semantics_decls t start (compile_prog pan_code)
state_rel_intro_typed=∀(s :(α, β) state) (t :(α, β) state) (c :mlstring |-> (mlstring # shape) list # α panLang$prog # shape). state_rel s t c ⇒ t = s with code := c ∧ ∀(f :mlstring) (vshs :(mlstring # shape) list) (prog :α panLang$prog) (rshape :shape). FLOOKUP s.code f = SOME (vshs,prog,rshape) ⇒ FLOOKUP c f = SOME (vshs,compile prog,rshape)
