cml_grammar=⊢ cmlG = <|start := mkNT nTopLevelDecs; rules := (FEMPTY :MMLnonT + num |-> ((token, MMLnonT) symbol list -> bool))⟨mkNT nNonETopLevelDecs ↦ {[(NN nDecl :(token, MMLnonT) symbol); (NN nNonETopLevelDecs :(token, MMLnonT) symbol)]} ∪ {[TK SemicolonT; (NN nTopLevelDecs :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nTopLevelDecs ↦ {[(NN nE :(token, MMLnonT) symbol); TK SemicolonT; (NN nTopLevelDecs :(token, MMLnonT) symbol)]} ∪ {[(NN nDecl :(token, MMLnonT) symbol); (NN nNonETopLevelDecs :(token, MMLnonT) symbol)]} ∪ {[TK SemicolonT; (NN nTopLevelDecs :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nStructure ↦ {[TK StructureT; (NN nStructName :(token, MMLnonT) symbol); (NN nOptionalSignatureAscription :(token, MMLnonT) symbol); TK EqualsT; TK StructT; (NN nDecls :(token, MMLnonT) symbol); TK EndT]}; mkNT nDecls ↦ {[(NN nDecl :(token, MMLnonT) symbol); (NN nDecls :(token, MMLnonT) symbol)]} ∪ {[TK SemicolonT; (NN nDecls :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nDecl ↦ {[TK ValT; (NN nPattern :(token, MMLnonT) symbol); TK EqualsT; (NN nE :(token, MMLnonT) symbol)]} ∪ {[TK FunT; (NN nAndFDecls :(token, MMLnonT) symbol)]} ∪ {[(NN nTypeDec :(token, MMLnonT) symbol)]} ∪ {[TK ExceptionT; (NN nDconstructor :(token, MMLnonT) symbol)]} ∪ {[(NN nTypeAbbrevDec :(token, MMLnonT) symbol)]} ∪ {[TK LocalT; (NN nDecls :(token, MMLnonT) symbol); TK InT; (NN nDecls :(token, MMLnonT) symbol); TK EndT]} ∪ {[(NN nStructure :(token, MMLnonT) symbol)]}; mkNT nOptionalSignatureAscription ↦ {[TK SealT; (NN nSignatureValue :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nSignatureValue ↦ {[TK SigT; (NN nSpecLineList :(token, MMLnonT) symbol); TK EndT]}; mkNT nSpecLineList ↦ {[(NN nSpecLine :(token, MMLnonT) symbol); (NN nSpecLineList :(token, MMLnonT) symbol)]} ∪ {[TK SemicolonT; (NN nSpecLineList :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nOptTypEqn ↦ {[TK EqualsT; (NN nType :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nSpecLine ↦ {[TK ValT; (NN nV :(token, MMLnonT) symbol); TK ColonT; (NN nType :(token, MMLnonT) symbol)]} ∪ {[TK TypeT; (NN nTypeName :(token, MMLnonT) symbol); (NN nOptTypEqn :(token, MMLnonT) symbol)]} ∪ {[TK ExceptionT; (NN nDconstructor :(token, MMLnonT) symbol)]} ∪ {[(NN nTypeDec :(token, MMLnonT) symbol)]}; mkNT nStructName ↦ {[TK (AlphaT s)] | s ≠ «»}; mkNT nPEs ↦ {[(NN nPattern :(token, MMLnonT) symbol); TK DarrowT; (NN nPE :(token, MMLnonT) symbol)]}; mkNT nPEsfx ↦ {([] :(token, MMLnonT) symbol list)} ∪ {[TK HandleT; (NN nPEs :(token, MMLnonT) symbol)]} ∪ {[TK BarT; (NN nPEs :(token, MMLnonT) symbol)]}; mkNT nPE ↦ {[TK CaseT; (NN nE :(token, MMLnonT) symbol); TK OfT; (NN nPEs :(token, MMLnonT) symbol)]} ∪ {[TK IfT; (NN nE :(token, MMLnonT) symbol); TK ThenT; (NN nE :(token, MMLnonT) symbol); TK ElseT; (NN nPE :(token, MMLnonT) symbol)]} ∪ {[TK FnT; (NN nPattern :(token, MMLnonT) symbol); TK DarrowT; (NN nE :(token, MMLnonT) symbol)]} ∪ {[TK RaiseT; (NN nPE :(token, MMLnonT) symbol)]} ∪ {[(NN nElogicOR :(token, MMLnonT) symbol); (NN nPEsfx :(token, MMLnonT) symbol)]}; mkNT nPbaseList1 ↦ {[(NN nPbase :(token, MMLnonT) symbol)]} ∪ {[(NN nPbase :(token, MMLnonT) symbol); (NN nPbaseList1 :(token, MMLnonT) symbol)]}; mkNT nPatternList ↦ {[(NN nPattern :(token, MMLnonT) symbol)]} ∪ {[(NN nPattern :(token, MMLnonT) symbol); TK CommaT; (NN nPatternList :(token, MMLnonT) symbol)]}; mkNT nPtuple ↦ {[TK LparT; TK RparT]} ∪ {[TK LparT; (NN nPatternList :(token, MMLnonT) symbol); TK RparT]}; mkNT nPattern ↦ {[(NN nPas :(token, MMLnonT) symbol)]} ∪ {[(NN nPas :(token, MMLnonT) symbol); TK ColonT; (NN nType :(token, MMLnonT) symbol)]}; mkNT nPas ↦ {[(NN nV :(token, MMLnonT) symbol); TK AsT; (NN nPcons :(token, MMLnonT) symbol)]} ∪ {[(NN nPcons :(token, MMLnonT) symbol)]}; mkNT nPcons ↦ {[(NN nPapp :(token, MMLnonT) symbol); TK (SymbolT «::»); (NN nPcons :(token, MMLnonT) symbol)]} ∪ {[(NN nPapp :(token, MMLnonT) symbol)]}; mkNT nPapp ↦ {[(NN nPConApp :(token, MMLnonT) symbol); (NN nPbase :(token, MMLnonT) symbol)]} ∪ {[(NN nPbase :(token, MMLnonT) symbol)]}; mkNT nPConApp ↦ {[(NN nConstructorName :(token, MMLnonT) symbol)]} ∪ {[(NN nPConApp :(token, MMLnonT) symbol); (NN nPbase :(token, MMLnonT) symbol)]}; mkNT nPbase ↦ {[(NN nV :(token, MMLnonT) symbol)]} ∪ {[(NN nConstructorName :(token, MMLnonT) symbol)]} ∪ {[TK (IntT i)] | T} ∪ {[TK (StringT m)] | T} ∪ {[TK (CharT c)] | T} ∪ {[(NN nPtuple :(token, MMLnonT) symbol)]} ∪ {[TK UnderbarT]} ∪ {[TK LbrackT; TK RbrackT]} ∪ {[TK LbrackT; (NN nPatternList :(token, MMLnonT) symbol); TK RbrackT]} ∪ {[TK OpT; (NN nOpID :(token, MMLnonT) symbol)]}; mkNT nLetDecs ↦ {[(NN nLetDec :(token, MMLnonT) symbol); (NN nLetDecs :(token, MMLnonT) symbol)]} ∪ {[TK SemicolonT; (NN nLetDecs :(token, MMLnonT) symbol)]} ∪ {([] :(token, MMLnonT) symbol list)}; mkNT nLetDec ↦ {[TK ValT; (NN nPattern :(token, MMLnonT) symbol); TK EqualsT; (NN nE :(token, MMLnonT) symbol)]} ∪ {[TK FunT; (NN nAndFDecls :(token, MMLnonT) symbol)]}; mkNT nAndFDecls ↦ {[(NN nFDecl :(token, MMLnonT) symbol)]} ∪ {[(NN nAndFDecls :(token, MMLnonT) symbol); TK AndT; (NN nFDecl :(token, MMLnonT) symbol)]}; mkNT nFDecl ↦ {[(NN nV :(token, MMLnonT) symbol); (NN nPbaseList1 :(token, MMLnonT) symbol); TK EqualsT; (NN nE :(token, MMLnonT) symbol)]}; mkNT nE ↦ {[TK IfT; (NN nE :(token, MMLnonT) symbol); TK ThenT; (NN nE :(token, MMLnonT) symbol); TK ElseT; (NN nE :(token, MMLnonT) symbol)]} ∪ {[TK CaseT; (NN nE :(token, MMLnonT) symbol); TK OfT; (NN nPEs :(token, MMLnonT) symbol)]} ∪ {[TK FnT; (NN nPattern :(token, MMLnonT) symbol); TK DarrowT; (NN nE :(token, MMLnonT) symbol)]} ∪ {[TK RaiseT; (NN nE :(token, MMLnonT) symbol)]} ∪ {[(NN nEhandle :(token, MMLnonT) symbol)]}; mkNT nEhandle ↦ {[(NN nElogicOR :(token, MMLnonT) symbol)]} ∪ {[(NN nElogicOR :(token, MMLnonT) symbol); TK HandleT; (NN nPEs :(token, MMLnonT) symbol)]}; mkNT nElogicOR ↦ {[(NN nElogicOR :(token, MMLnonT) symbol); TK OrelseT; (NN nElogicAND :(token, MMLnonT) symbol)]} ∪ {[(NN nElogicAND :(token, MMLnonT) symbol)]}; mkNT nElogicAND ↦ {[(NN nElogicAND :(token, MMLnonT) symbol); TK AndalsoT; (NN nEtyped :(token, MMLnonT) symbol)]} ∪ {[(NN nEtyped :(token, MMLnonT) symbol)]}; mkNT nEtyped ↦ {[(NN nEbefore :(token, MMLnonT) symbol)]} ∪ {[(NN nEbefore :(token, MMLnonT) symbol); TK ColonT; (NN nType :(token, MMLnonT) symbol)]}; mkNT nEbefore ↦ {[(NN nEbefore :(token, MMLnonT) symbol); TK (AlphaT «before»); (NN nEcomp :(token, MMLnonT) symbol)]} ∪ {[(NN nEcomp :(token, MMLnonT) symbol)]}; mkNT nEcomp ↦ {[(NN nEcomp :(token, MMLnonT) symbol); (NN nCompOps :(token, MMLnonT) symbol); (NN nErel :(token, MMLnonT) symbol)]} ∪ {[(NN nErel :(token, MMLnonT) symbol)]}; mkNT nErel ↦ {[(NN nErel :(token, MMLnonT) symbol); (NN nRelOps :(token, MMLnonT) symbol); (NN nElistop :(token, MMLnonT) symbol)]} ∪ {[(NN nElistop :(token, MMLnonT) symbol)]}; mkNT nElistop ↦ {[(NN nEadd :(token, MMLnonT) symbol); (NN nListOps :(token, MMLnonT) symbol); (NN nElistop :(token, MMLnonT) symbol)]} ∪ {[(NN nEadd :(token, MMLnonT) symbol)]}; mkNT nEadd ↦ {[(NN nEadd :(token, MMLnonT) symbol); (NN nAddOps :(token, MMLnonT) symbol); (NN nEmult :(token, MMLnonT) symbol)]} ∪ {[(NN nEmult :(token, MMLnonT) symbol)]}; mkNT nEmult ↦ {[(NN nEmult :(token, MMLnonT) symbol); (NN nMultOps :(token, MMLnonT) symbol); (NN nEapp :(token, MMLnonT) symbol)]} ∪ {[(NN nEapp :(token, MMLnonT) symbol)]}; mkNT nListOps ↦ {[TK (SymbolT s)] | validListSym (explode s)}; mkNT nCompOps ↦ {[TK (AlphaT «o»)]} ∪ {[TK (SymbolT «:=»)]}; mkNT nRelOps ↦ {[TK (SymbolT s)] | validRelSym (explode s)} ∪ {[TK EqualsT]}; mkNT nAddOps ↦ {[TK (SymbolT s)] | validAddSym (explode s)}; mkNT nMultOps ↦ {[TK (AlphaT «div»)]; [TK (AlphaT «mod»)]; [TK StarT]} ∪ {[TK (SymbolT s)] | validMultSym (explode s)}; mkNT nEapp ↦ {[(NN nEapp :(token, MMLnonT) symbol); (NN nEbase :(token, MMLnonT) symbol)]} ∪ {[(NN nEbase :(token, MMLnonT) symbol)]}; mkNT nElist1 ↦ {[(NN nE :(token, MMLnonT) symbol)]} ∪ {[(NN nE :(token, MMLnonT) symbol); TK CommaT; (NN nElist1 :(token, MMLnonT) symbol)]}; mkNT nElist2 ↦ {[(NN nE :(token, MMLnonT) symbol); TK CommaT; (NN nElist1 :(token, MMLnonT) symbol)]}; mkNT nEtuple ↦ {[TK LparT; (NN nElist2 :(token, MMLnonT) symbol); TK RparT]}; mkNT nEseq ↦ {[(NN nE :(token, MMLnonT) symbol); TK SemicolonT; (NN nEseq :(token, MMLnonT) symbol)]} ∪ {[(NN nE :(token, MMLnonT) symbol)]}; mkNT nEbase ↦ {[TK LparT; (NN nEseq :(token, MMLnonT) symbol); TK RparT]} ∪ {[(NN nEtuple :(token, MMLnonT) symbol)]} ∪ {[TK LparT; TK RparT]} ∪ {[(NN nFQV :(token, MMLnonT) symbol)]} ∪ {[(NN nConstructorName :(token, MMLnonT) symbol)]} ∪ {[(NN nEliteral :(token, MMLnonT) symbol)]} ∪ {[TK LetT; (NN nLetDecs :(token, MMLnonT) symbol); TK InT; (NN nEseq :(token, MMLnonT) symbol); TK EndT]} ∪ {[TK LbrackT; TK RbrackT]} ∪ {[TK LbrackT; (NN nElist1 :(token, MMLnonT) symbol); TK RbrackT]} ∪ {[TK OpT; (NN nOpID :(token, MMLnonT) symbol)]}; mkNT nEliteral ↦ {[TK (IntT i)] | T} ∪ {[TK (CharT c)] | T} ∪ {[TK (StringT m)] | T} ∪ {[TK (WordT n)] | T} ∪ {[TK (FFIT m)] | T}; mkNT nOpID ↦ {[TK (LongidT str s)] | (str,s) | s ≠ «»} ∪ {[TK (AlphaT s)] | s ≠ «»} ∪ {[TK (SymbolT s)] | s ≠ «»} ∪ {[TK StarT]} ∪ {[TK EqualsT]}; mkNT nFQV ↦ {[(NN nV :(token, MMLnonT) symbol)]} ∪ {[TK (LongidT str s)] | (str,s) | s ≠ «» ∧ (isAlpha (strsub s (0 :num)) ⇒ ¬isUpper (strsub s (0 :num)))}; mkNT nV ↦ {[TK (AlphaT s)] | s ∉ {«before»; «div»; «mod»; «o»} ∧ s ≠ «» ∧ ¬isUpper (strsub s (0 :num))} ∪ {[TK (SymbolT s)] | validPrefixSym (explode s)}; mkNT nConstructorName ↦ {[(NN nUQConstructorName :(token, MMLnonT) symbol)]} ∪ {[TK (LongidT str s)] | (str,s) | s ≠ «» ∧ isAlpha (strsub s (0 :num)) ∧ isUpper (strsub s (0 :num))}; mkNT nUQConstructorName ↦ {[TK (AlphaT s)] | s ≠ «» ∧ isUpper (strsub s (0 :num))}; mkNT nTypeAbbrevDec ↦ {[TK TypeT; (NN nTypeName :(token, MMLnonT) symbol); TK EqualsT; (NN nType :(token, MMLnonT) symbol)]}; mkNT nTypeDec ↦ {[TK DatatypeT; (NN nDtypeDecls :(token, MMLnonT) symbol)]}; mkNT nDtypeDecls ↦ {[(NN nDtypeDecl :(token, MMLnonT) symbol)]} ∪ {[(NN nDtypeDecls :(token, MMLnonT) symbol); TK AndT; (NN nDtypeDecl :(token, MMLnonT) symbol)]}; mkNT nDtypeDecl ↦ {[(NN nTypeName :(token, MMLnonT) symbol); TK EqualsT; (NN nDtypeCons :(token, MMLnonT) symbol)]}; mkNT nDtypeCons ↦ {[(NN nDconstructor :(token, MMLnonT) symbol)]} ∪ {[(NN nDtypeCons :(token, MMLnonT) symbol); TK BarT; (NN nDconstructor :(token, MMLnonT) symbol)]}; mkNT nDconstructor ↦ {[(NN nUQConstructorName :(token, MMLnonT) symbol); (NN nTbaseList :(token, MMLnonT) symbol)]}; mkNT nTyVarList ↦ {[(NN nTyvarN :(token, MMLnonT) symbol)]} ∪ {[(NN nTyVarList :(token, MMLnonT) symbol); TK CommaT; (NN nTyvarN :(token, MMLnonT) symbol)]}; mkNT nTypeName ↦ {[(NN nUQTyOp :(token, MMLnonT) symbol)]} ∪ {[TK LparT; (NN nTyVarList :(token, MMLnonT) symbol); TK RparT; (NN nUQTyOp :(token, MMLnonT) symbol)]} ∪ {[TK (TyvarT m); (NN nUQTyOp :(token, MMLnonT) symbol)] | T}; mkNT nPTbase ↦ {[TK (TyvarT m)] | T} ∪ {[(NN nTyOp :(token, MMLnonT) symbol)]} ∪ {[TK LparT; (NN nType :(token, MMLnonT) symbol); TK RparT]}; mkNT nTbaseList ↦ {([] :(token, MMLnonT) symbol list)} ∪ {[(NN nPTbase :(token, MMLnonT) symbol); (NN nTbaseList :(token, MMLnonT) symbol)]}; mkNT nType ↦ {[(NN nPType :(token, MMLnonT) symbol)]} ∪ {[(NN nPType :(token, MMLnonT) symbol); TK ArrowT; (NN nType :(token, MMLnonT) symbol)]}; mkNT nPType ↦ {[(NN nDType :(token, MMLnonT) symbol); TK StarT; (NN nPType :(token, MMLnonT) symbol)]} ∪ {[(NN nDType :(token, MMLnonT) symbol)]}; mkNT nDType ↦ {[(NN nDType :(token, MMLnonT) symbol); (NN nTyOp :(token, MMLnonT) symbol)]} ∪ {[(NN nTbase :(token, MMLnonT) symbol)]}; mkNT nTbase ↦ {[TK (TyvarT m)] | T} ∪ {[(NN nTyOp :(token, MMLnonT) symbol)]} ∪ {[TK LparT; (NN nTypeList2 :(token, MMLnonT) symbol); TK RparT; (NN nTyOp :(token, MMLnonT) symbol)]} ∪ {[TK LparT; (NN nType :(token, MMLnonT) symbol); TK RparT]}; mkNT nTypeList2 ↦ {[(NN nType :(token, MMLnonT) symbol); TK CommaT; (NN nTypeList1 :(token, MMLnonT) symbol)]}; mkNT nTypeList1 ↦ {[(NN nType :(token, MMLnonT) symbol)]} ∪ {[(NN nType :(token, MMLnonT) symbol); TK CommaT; (NN nTypeList1 :(token, MMLnonT) symbol)]}; mkNT nTyOp ↦ {[(NN nUQTyOp :(token, MMLnonT) symbol)]} ∪ {[TK (LongidT p m)] | T}; mkNT nTyvarN ↦ {[TK (TyvarT m)] | T}; mkNT nUQTyOp ↦ {[TK (AlphaT m)] | T} ∪ {[TK (SymbolT m)] | T}⟩|>
cml_start=⊢ cmlG.start = mkNT nTopLevelDecs
empty_top=⊢ ([] :(token, MMLnonT) symbol list) ∈ cmlG.rules⟨mkNT nTopLevelDecs⟩ ⇔ T
decl_top=⊢ [(NN nDecl :(token, MMLnonT) symbol); (NN nNonETopLevelDecs :(token, MMLnonT) symbol)] ∈ cmlG.rules⟨mkNT nTopLevelDecs⟩ ⇔ T
