fix_type=:α state -> β state # γ -> β state # γ
list_type=:(α, β) result -> (α list, β) result
clock_lemma=⊢ ∀(s :α state) (x :β state # γ) (s1 :β state) (res :γ). fix_clock s x = (s1,res) ⇒ s1.clock ≤ s.clock
eval_clock_lemma=⊢ fix_clock (s :α state) (do_eval_res (vs :v list) s :α state # (v sem_env # dec list, β) result) = (do_eval_res vs s :α state # (v sem_env # dec list, β) result)
full_evaluate_ind=⊢ ∀(P0 :'ffi state -> v sem_env -> exp list -> bool) (P1 :'ffi state -> v sem_env -> v -> (pat # exp) list -> v -> bool) (P2 :'ffi state -> v sem_env -> dec list -> bool). (∀(st :'ffi state) (env :v sem_env). P0 st env ([] :exp list)) ∧ (∀(st :'ffi state) (env :v sem_env) (e1 :exp) (e2 :exp) (es :exp list). (∀(st' :'ffi state) (v3 :(v list, v) result) (v1 :v list). evaluate st env [e1] = (st',v3) ∧ v3 = (Rval v1 :(v list, v) result) ⇒ P0 st' env (e2::es)) ∧ P0 st env [e1] ⇒ P0 st env (e1::e2::es)) ∧ (∀(st :'ffi state) (env :v sem_env) (l :lit). P0 st env [Lit l]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp). P0 st env [e] ⇒ P0 st env [Raise e]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (pes :(pat # exp) list). (∀(st' :'ffi state) (v2 :(v list, v) result) (v4 :v error_result) (v :v). evaluate st env [e] = (st',v2) ∧ v2 = (Rerr v4 :(v list, v) result) ∧ v4 = Rraise v ∧ can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) v ⇒ P1 st' env v pes v) ∧ P0 st env [e] ⇒ P0 st env [Handle e pes]) ∧ (∀(st :'ffi state) (env :v sem_env) (cn :(mlstring, mlstring) id option) (es :exp list). (do_con_check env.c cn (LENGTH es) ⇒ P0 st env (REVERSE es)) ⇒ P0 st env [Con cn es]) ∧ (∀(st :'ffi state) (env :v sem_env) (n :(mlstring, mlstring) id). P0 st env [Var n]) ∧ (∀(st :'ffi state) (env :v sem_env) (x :mlstring) (e :exp). P0 st env [Fun x e]) ∧ (∀(st :'ffi state) (env :v sem_env) (op :op) (es :exp list). (∀(st' :'ffi state) (v10 :(v list, v) result) (vs :v list) (v :v sem_env # exp) (env' :v sem_env) (e :exp). evaluate st env (REVERSE es) = (st',v10) ∧ v10 = (Rval vs :(v list, v) result) ∧ getOpClass op = FunApp ∧ do_opapp (REVERSE vs) = SOME v ∧ v = (env',e) ∧ st'.clock ≠ (0 :num) ⇒ P0 (dec_clock st') env' [e]) ∧ (∀(st' :'ffi state) (v10 :(v list, v) result) (vs :v list) (st1 :'ffi state) (v3 :(v sem_env # dec list, v) result) (v5 :v sem_env # dec list) (env1 :v sem_env) (decs :dec list). evaluate st env (REVERSE es) = (st',v10) ∧ v10 = (Rval vs :(v list, v) result) ∧ getOpClass op = EvalOp ∧ (do_eval_res (REVERSE vs) st' :'ffi state # (v sem_env # dec list, v) result) = (st1,v3) ∧ v3 = (Rval v5 :(v sem_env # dec list, v) result) ∧ v5 = (env1,decs) ∧ st1.clock ≠ (0 :num) ⇒ P2 (dec_clock st1) env1 decs) ∧ (∀(st' :'ffi state) (v10 :(v list, v) result) (vs :v list) (v2 :thunk_mode) (v :v) (v' :v sem_env # exp) (env' :v sem_env) (e :exp). evaluate st env (REVERSE es) = (st',v10) ∧ v10 = (Rval vs :(v list, v) result) ∧ getOpClass op = Force ∧ dest_thunk (REVERSE vs) st'.refs = IsThunk v2 v ∧ v2 = NotEvaluated ∧ do_opapp [v; Conv (NONE :stamp option) ([] :v list)] = SOME v' ∧ v' = (env',e) ∧ st'.clock ≠ (0 :num) ⇒ P0 (dec_clock st') env' [e]) ∧ P0 st env (REVERSE es) ⇒ P0 st env [App op es]) ∧ (∀(st :'ffi state) (env :v sem_env) (lop :lop) (e1 :exp) (e2 :exp). (∀(st' :'ffi state) (v3 :(v list, v) result) (v1 :v list) (v1' :exp_or_val) (e :exp). evaluate st env [e1] = (st',v3) ∧ v3 = (Rval v1 :(v list, v) result) ∧ do_log lop (HD v1) e2 = SOME v1' ∧ v1' = Exp e ⇒ P0 st' env [e]) ∧ P0 st env [e1] ⇒ P0 st env [Log lop e1 e2]) ∧ (∀(st :'ffi state) (env :v sem_env) (e1 :exp) (e2 :exp) (e3 :exp). (∀(st' :'ffi state) (v2 :(v list, v) result) (v :v list) (e :exp). evaluate st env [e1] = (st',v2) ∧ v2 = (Rval v :(v list, v) result) ∧ do_if (HD v) e2 e3 = SOME e ⇒ P0 st' env [e]) ∧ P0 st env [e1] ⇒ P0 st env [If e1 e2 e3]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (pes :(pat # exp) list). (∀(st' :'ffi state) (v2 :(v list, v) result) (v :v list). evaluate st env [e] = (st',v2) ∧ v2 = (Rval v :(v list, v) result) ∧ can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) (HD v) ⇒ P1 st' env (HD v) pes bind_exn_v) ∧ P0 st env [e] ⇒ P0 st env [Mat e pes]) ∧ (∀(st :'ffi state) (env :v sem_env) (xo :mlstring option) (e1 :exp) (e2 :exp). (∀(st' :'ffi state) (v2 :(v list, v) result) (v :v list). evaluate st env [e1] = (st',v2) ∧ v2 = (Rval v :(v list, v) result) ⇒ P0 st' (env with v := nsOptBind xo (HD v) env.v) [e2]) ∧ P0 st env [e1] ⇒ P0 st env [Let xo e1 e2]) ∧ (∀(st :'ffi state) (env :v sem_env) (funs :(mlstring # mlstring # exp) list) (e :exp). (ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) ⇒ P0 st (env with v := build_rec_env funs env env.v) [e]) ⇒ P0 st env [Letrec funs e]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (t :ast_t). P0 st env [e] ⇒ P0 st env [Tannot e t]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (l :locs). P0 st env [e] ⇒ P0 st env [Lannot e l]) ∧ (∀(st :'ffi state) (env :v sem_env) (v :v) (err_v :v). P1 st env v ([] :(pat # exp) list) err_v) ∧ (∀(st :'ffi state) (env :v sem_env) (v :v) (p :pat) (e :exp) (pes :(pat # exp) list) (err_v :v). (∀(env_v' :(mlstring # v) list). ALL_DISTINCT (pat_bindings p) ∧ pmatch env.c st.refs p v ([] :(mlstring # v) list) = Match env_v' ⇒ P0 st (env with v := nsAppend (alist_to_ns env_v' :(mlstring, mlstring, v) namespace) env.v) [e]) ∧ (ALL_DISTINCT (pat_bindings p) ∧ pmatch env.c st.refs p v ([] :(mlstring # v) list) = (No_match :(mlstring # v) list match_result) ⇒ P1 st env v pes err_v) ⇒ P1 st env v ((p,e)::pes) err_v) ∧ (∀(st :'ffi state) (env :v sem_env). P2 st env ([] :dec list)) ∧ (∀(st :'ffi state) (env :v sem_env) (d1 :dec) (d2 :dec) (ds :dec list). (∀(st1 :'ffi state) (v1 :(v sem_env, v) result) (env1 :v sem_env). evaluate_decs st env [d1] = (st1,v1) ∧ v1 = (Rval env1 :(v sem_env, v) result) ⇒ P2 st1 ((env1 +++ env) :v sem_env) (d2::ds)) ∧ P2 st env [d1] ⇒ P2 st env (d1::d2::ds)) ∧ (∀(st :'ffi state) (env :v sem_env) (locs :locs) (p :pat) (e :exp). (ALL_DISTINCT (pat_bindings p) ∧ every_exp (one_con_check env.c) e ⇒ P0 st env [e]) ⇒ P2 st env [Dlet locs p e]) ∧ (∀(st :'ffi state) (env :v sem_env) (locs :locs) (funs :(mlstring # mlstring # exp) list). P2 st env [Dletrec locs funs]) ∧ (∀(st :'ffi state) (env :v sem_env) (locs :locs) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list). P2 st env [Dtype locs tds]) ∧ (∀(st :'ffi state) (env :v sem_env) (locs :locs) (tvs :mlstring list) (tn :mlstring) (t :ast_t). P2 st env [Dtabbrev locs tvs tn t]) ∧ (∀(st :'ffi state) (env :v sem_env) (n :mlstring). P2 st env [Denv n]) ∧ (∀(st :'ffi state) (env :v sem_env) (locs :locs) (cn :mlstring) (ts :ast_t list). P2 st env [Dexn locs cn ts]) ∧ (∀(st :'ffi state) (env :v sem_env) (mn :mlstring) (ds :dec list). P2 st env ds ⇒ P2 st env [Dmod mn ds]) ∧ (∀(st :'ffi state) (env :v sem_env) (lds :dec list) (ds :dec list). (∀(st1 :'ffi state) (v1 :(v sem_env, v) result) (env1 :v sem_env). evaluate_decs st env lds = (st1,v1) ∧ v1 = (Rval env1 :(v sem_env, v) result) ⇒ P2 st1 ((env1 +++ env) :v sem_env) ds) ∧ P2 st env lds ⇒ P2 st env [Dlocal lds ds]) ⇒ (∀(v0 :'ffi state) (v1 :v sem_env) (v2 :exp list). P0 v0 v1 v2) ∧ (∀(v0 :'ffi state) (v1 :v sem_env) (v2 :v) (v3 :(pat # exp) list) (v4 :v). P1 v0 v1 v2 v3 v4) ∧ ∀(v0 :'ffi state) (v1 :v sem_env) (v2 :dec list). P2 v0 v1 v2
evaluate_ind=⊢ ∀(P1 :'ffi state -> v sem_env -> exp list -> bool) (P2 :'ffi state -> v sem_env -> v -> (pat # exp) list -> v -> bool). (∀(st :'ffi state) (env :v sem_env). P1 st env ([] :exp list)) ∧ (∀(st :'ffi state) (env :v sem_env) (e1 :exp) (e2 :exp) (es :exp list). (∀(st' :'ffi state) (v1 :v list). evaluate st env [e1] = (st',(Rval v1 :(v list, v) result)) ⇒ P1 st' env (e2::es)) ∧ P1 st env [e1] ⇒ P1 st env (e1::e2::es)) ∧ (∀(st :'ffi state) (env :v sem_env) (l :lit). P1 st env [Lit l]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp). P1 st env [e] ⇒ P1 st env [Raise e]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (pes :(pat # exp) list). (∀(st' :'ffi state) (v :v). evaluate st env [e] = (st',(Rerr (Rraise v) :(v list, v) result)) ∧ can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) v ⇒ P2 st' env v pes v) ∧ P1 st env [e] ⇒ P1 st env [Handle e pes]) ∧ (∀(st :'ffi state) (env :v sem_env) (cn :(mlstring, mlstring) id option) (es :exp list). (do_con_check env.c cn (LENGTH es) ⇒ P1 st env (REVERSE es)) ⇒ P1 st env [Con cn es]) ∧ (∀(st :'ffi state) (env :v sem_env) (n :(mlstring, mlstring) id). P1 st env [Var n]) ∧ (∀(st :'ffi state) (env :v sem_env) (x :mlstring) (e :exp). P1 st env [Fun x e]) ∧ (∀(st :'ffi state) (env :v sem_env) (op :op) (es :exp list). (∀(st' :'ffi state) (vs :v list) (env' :v sem_env) (e :exp). evaluate st env (REVERSE es) = (st',(Rval vs :(v list, v) result)) ∧ getOpClass op = FunApp ∧ do_opapp (REVERSE vs) = SOME (env',e) ∧ st'.clock ≠ (0 :num) ⇒ P1 (dec_clock st') env' [e]) ∧ (∀(st' :'ffi state) (vs :v list) (v :v) (env' :v sem_env) (e :exp). evaluate st env (REVERSE es) = (st',(Rval vs :(v list, v) result)) ∧ getOpClass op = Force ∧ dest_thunk (REVERSE vs) st'.refs = IsThunk NotEvaluated v ∧ do_opapp [v; Conv (NONE :stamp option) ([] :v list)] = SOME (env',e) ∧ st'.clock ≠ (0 :num) ⇒ P1 (dec_clock st') env' [e]) ∧ P1 st env (REVERSE es) ⇒ P1 st env [App op es]) ∧ (∀(st :'ffi state) (env :v sem_env) (lop :lop) (e1 :exp) (e2 :exp). (∀(st' :'ffi state) (v1 :v list) (e :exp). evaluate st env [e1] = (st',(Rval v1 :(v list, v) result)) ∧ do_log lop (HD v1) e2 = SOME (Exp e) ⇒ P1 st' env [e]) ∧ P1 st env [e1] ⇒ P1 st env [Log lop e1 e2]) ∧ (∀(st :'ffi state) (env :v sem_env) (e1 :exp) (e2 :exp) (e3 :exp). (∀(st' :'ffi state) (v :v list) (e :exp). evaluate st env [e1] = (st',(Rval v :(v list, v) result)) ∧ do_if (HD v) e2 e3 = SOME e ⇒ P1 st' env [e]) ∧ P1 st env [e1] ⇒ P1 st env [If e1 e2 e3]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (pes :(pat # exp) list). (∀(st' :'ffi state) (v :v list). evaluate st env [e] = (st',(Rval v :(v list, v) result)) ∧ can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) (HD v) ⇒ P2 st' env (HD v) pes bind_exn_v) ∧ P1 st env [e] ⇒ P1 st env [Mat e pes]) ∧ (∀(st :'ffi state) (env :v sem_env) (xo :mlstring option) (e1 :exp) (e2 :exp). (∀(st' :'ffi state) (v :v list). evaluate st env [e1] = (st',(Rval v :(v list, v) result)) ⇒ P1 st' (env with v := nsOptBind xo (HD v) env.v) [e2]) ∧ P1 st env [e1] ⇒ P1 st env [Let xo e1 e2]) ∧ (∀(st :'ffi state) (env :v sem_env) (funs :(mlstring # mlstring # exp) list) (e :exp). (ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) ⇒ P1 st (env with v := build_rec_env funs env env.v) [e]) ⇒ P1 st env [Letrec funs e]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (t :ast_t). P1 st env [e] ⇒ P1 st env [Tannot e t]) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp) (l :locs). P1 st env [e] ⇒ P1 st env [Lannot e l]) ∧ (∀(st :'ffi state) (env :v sem_env) (v :v) (err_v :v). P2 st env v ([] :(pat # exp) list) err_v) ∧ (∀(st :'ffi state) (env :v sem_env) (v :v) (p :pat) (e :exp) (pes :(pat # exp) list) (err_v :v). (∀(env_v' :(mlstring # v) list). ALL_DISTINCT (pat_bindings p) ∧ pmatch env.c st.refs p v ([] :(mlstring # v) list) = Match env_v' ⇒ P1 st (env with v := nsAppend (alist_to_ns env_v' :(mlstring, mlstring, v) namespace) env.v) [e]) ∧ (ALL_DISTINCT (pat_bindings p) ∧ pmatch env.c st.refs p v ([] :(mlstring # v) list) = (No_match :(mlstring # v) list match_result) ⇒ P2 st env v pes err_v) ⇒ P2 st env v ((p,e)::pes) err_v) ⇒ (∀(v0 :'ffi state) (v1 :v sem_env) (v2 :exp list). P1 v0 v1 v2) ∧ ∀(v0 :'ffi state) (v1 :v sem_env) (v2 :v) (v3 :(pat # exp) list) (v4 :v). P2 v0 v1 v2 v3 v4
evaluate_clock=⊢ (∀(s1 :'ffi state) (env :v sem_env) (e :exp list) (r :(v list, v) result) (s2 :'ffi state). evaluate s1 env e = (s2,r) ⇒ s2.clock ≤ s1.clock) ∧ (∀(s1 :'ffi state) (env :v sem_env) (v :v) (p :(pat # exp) list) (v' :v) (r :(v list, v) result) (s2 :'ffi state). evaluate_match s1 env v p v' = (s2,r) ⇒ s2.clock ≤ s1.clock) ∧ ∀(s1 :'ffi state) (env :v sem_env) (ds :dec list) (r :(v sem_env, v) result) (s2 :'ffi state). evaluate_decs s1 env ds = (s2,r) ⇒ s2.clock ≤ s1.clock
raise_clock=⊢ ∀(s :'ffi state) (env :v sem_env) (e :exp) (r :(v list, v) result) (s2 :'ffi state). evaluate s env [Raise e] = (s2,r) ⇒ s2.clock ≤ s.clock
fixed=(3 :num)
zero=(0 :num)
failure=(Rerr (Rraise (1 :num)) :(bool list, num) result)
