load "preamble"; load "word_to_stackProofTheory";
open HolKernel Parse bossLib preamble word_to_stackProofTheory arithmeticTheory listTheory rich_listTheory miscTheory;
val _ = Globals.linewidth := 4000;
val isPREFIX_DROP = prove(``∀s t i.
  isPREFIX s t ⇒
  isPREFIX (DROP i s) (DROP i t)``,   Induct>>rw[]>>
  every_case_tac>>fs[]>>
  Cases_on`i`>>simp[]);
val _ = (if null(hyp isPREFIX_DROP) then () else raise Fail "open premise"; print "ll_full_isPREFIX_DROP="; print_thm isPREFIX_DROP; print "\n");
val LLOOKUP_cons_SUC = prove(``m < n ⇒
  LLOOKUP (h::xs) (n - m) =
  LLOOKUP xs (n - (m+1))``,   rw[]>>
  `n - m = SUC (n - (m+1))` by simp[]>>
  simp[LLOOKUP_def]);
val _ = (if null(hyp LLOOKUP_cons_SUC) then () else raise Fail "open premise"; print "ll_full_LLOOKUP_cons_SUC="; print_thm LLOOKUP_cons_SUC; print "\n");
val EVEN_DIV2_INJ = prove(``EVEN x ∧ EVEN y ∧ DIV2 x = DIV2 y ⇒ x = y``,   srw_tac[][EVEN_EXISTS,DIV2_def,MULT_COMM]
  \\ fs[MULT_DIV]);
val _ = (if null(hyp EVEN_DIV2_INJ) then () else raise Fail "open premise"; print "ll_full_EVEN_DIV2_INJ="; print_thm EVEN_DIV2_INJ; print "\n");
fun emit label q = let val th = EVAL q in print(label ^ "="); print_thm th; print "\n" end;
