env_c_lemma_replay=((<|v := build_rec_env (q :(mlstring # mlstring # exp) list) (env :v sem_env) (env1 :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> +++ env) :v sem_env).c = env.c
lift_prefix=∀(ds :dec list) (d :dec) (ds1 :dec list) (ds2 :dec). lift_lets ds d = SOME (ds1,ds2) ⇒ REVERSE ds ≼ ds1
lift_modules_locals=(∀(ds1 :dec list) (ds2 :dec list). lift_lets ([] :dec list) (Dlocal ds1 ds2) = (NONE :(dec list # dec) option)) ∧ ∀(mn :mlstring) (ds :dec list). lift_lets ([] :dec list) (Dmod mn ds) = (NONE :(dec list # dec) option)
lift_single_evaluation=evaluate_decs (s :α semanticPrimitives$state) (env :v sem_env) [(d :dec)] = ((s' :α semanticPrimitives$state),(res :(v sem_env, v) result)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ∧ lift_let d = SOME ((d1 :dec),(d2 :dec)) ⇒ evaluate_decs s env [Dlocal [d1] [d2]] = (s',res)
lift_all_evaluation=∀(ds :dec list) (d :dec) (s :α semanticPrimitives$state) (env :v sem_env) (s1 :α semanticPrimitives$state) (env1 :v sem_env) (s2 :α semanticPrimitives$state) (res :(v sem_env, v) result) (ds1 :dec list) (ds2 :dec). evaluate_decs s env (REVERSE ds) = (s1,(Rval env1 :(v sem_env, v) result)) ∧ evaluate_decs s1 ((env1 +++ env) :v sem_env) [d] = (s2,res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ∧ lift_lets ds d = SOME (ds1,ds2) ⇒ evaluate_decs s env [Dlocal ds1 [ds2]] = (s2,res)
compile_declarations=∀(s :α semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :α semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs s env (compile_decs ds) = (s',res)
compile_semantics=¬semantics_prog (s :α semanticPrimitives$state) (env :v sem_env) (prog :dec list) Fail ∧ semantics_prog s env prog (outcome :behaviour) ⇒ semantics_prog s env (compile_decs prog) outcome
compile_semantics_oracle=∀(f :dec list -> dec list). is_insert_oracle (ci :α compiler_instance) f (s :β semanticPrimitives$state).eval_state ∧ ¬semantics_prog s (env :v sem_env) (prog :dec list) Fail ∧ semantics_prog s env prog (outcome :behaviour) ⇒ semantics_prog (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env prog outcome
lift_start=∀(d :dec) (s :α semanticPrimitives$state) (env :v sem_env) (s2 :α semanticPrimitives$state) (res :(v sem_env, v) result) (ds1 :dec list) (ds2 :dec). evaluate_decs s env [d] = (s2,res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ∧ lift_lets ([] :dec list) d = SOME (ds1,ds2) ⇒ evaluate_decs s env [Dlocal ds1 [ds2]] = (s2,res)
dest_let_definition=dest_Let (Let (opt :mlstring option) (x :exp) (y :exp)) = SOME (opt,x,y) ∧ dest_Let (Raise (v :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Handle (v1 :exp) (v2 :(pat # exp) list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Lit (v3 :lit)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Con (v4 :(mlstring, mlstring) id option) (v5 :exp list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Var (v6 :(mlstring, mlstring) id)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Fun (v7 :mlstring) (v8 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (App (v9 :op) (v10 :exp list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Log (v11 :lop) (v12 :exp) (v13 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (If (v14 :exp) (v15 :exp) (v16 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Mat (v17 :exp) (v18 :(pat # exp) list)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Letrec (v22 :(mlstring # mlstring # exp) list) (v23 :exp)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Tannot (v24 :exp) (v25 :ast_t)) = (NONE :(mlstring option # exp # exp) option) ∧ dest_Let (Lannot (v26 :exp) (v27 :locs)) = (NONE :(mlstring option # exp # exp) option)
dest_letrec_definition=dest_Letrec (Letrec (funs :(mlstring # mlstring # exp) list) (x :exp)) = SOME (funs,x) ∧ dest_Letrec (Raise (v :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Handle (v1 :exp) (v2 :(pat # exp) list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Lit (v3 :lit)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Con (v4 :(mlstring, mlstring) id option) (v5 :exp list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Var (v6 :(mlstring, mlstring) id)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Fun (v7 :mlstring) (v8 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (App (v9 :op) (v10 :exp list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Log (v11 :lop) (v12 :exp) (v13 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (If (v14 :exp) (v15 :exp) (v16 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Mat (v17 :exp) (v18 :(pat # exp) list)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Let (v19 :mlstring option) (v20 :exp) (v21 :exp)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Tannot (v24 :exp) (v25 :ast_t)) = (NONE :((mlstring # mlstring # exp) list # exp) option) ∧ dest_Letrec (Lannot (v26 :exp) (v27 :locs)) = (NONE :((mlstring # mlstring # exp) list # exp) option)
lift_let_definition=lift_let (Dlet (l :locs) (p :pat) (x :exp)) = (case dest_Let x of (NONE :(mlstring option # exp # exp) option) => (case dest_Letrec x of (NONE :((mlstring # mlstring # exp) list # exp) option) => (NONE :(dec # dec) option) | SOME (funs,x) => SOME (Dletrec l funs,Dlet l p x)) | SOME ((NONE :mlstring option),v4,v5) => SOME (Dlet l Pany v4,Dlet l p v5) | SOME (SOME v6,v4,v5) => SOME (Dlet l (Pvar v6) v4,Dlet l p v5)) ∧ lift_let (Dletrec (v10 :locs) (v11 :(mlstring # mlstring # exp) list)) = (NONE :(dec # dec) option) ∧ lift_let (Dtype (v12 :locs) (v13 :(mlstring list # mlstring # (mlstring # ast_t list) list) list)) = (NONE :(dec # dec) option) ∧ lift_let (Dtabbrev (v14 :locs) (v15 :mlstring list) (v16 :mlstring) (v17 :ast_t)) = (NONE :(dec # dec) option) ∧ lift_let (Dexn (v18 :locs) (v19 :mlstring) (v20 :ast_t list)) = (NONE :(dec # dec) option) ∧ lift_let (Dmod (v21 :mlstring) (v22 :dec list)) = (NONE :(dec # dec) option) ∧ lift_let (Dlocal (v23 :dec list) (v24 :dec list)) = (NONE :(dec # dec) option) ∧ lift_let (Denv (v25 :mlstring)) = (NONE :(dec # dec) option)
lift_lets_definition=∀(sofar :dec list) (d :dec). lift_lets sofar d = case lift_let d of (NONE :(dec # dec) option) => (case sofar of ([] :dec list) => (NONE :(dec list # dec) option) | v2::v3 => SOME (REVERSE sofar,d)) | SOME (d1,d2) => lift_lets (d1::sofar) d2
compile_decs_definition=compile_decs ([] :dec list) = ([] :dec list) ∧ ∀(ds :dec list) (d :dec). compile_decs (d::ds) = case lift_lets ([] :dec list) d of (NONE :(dec list # dec) option) => (case d of Dlet v19 v20 v21 => d::compile_decs ds | Dletrec v22 v23 => d::compile_decs ds | Dtype v24 v25 => d::compile_decs ds | Dtabbrev v26 v27 v28 v29 => d::compile_decs ds | Dexn v30 v31 v32 => d::compile_decs ds | Dmod mn ds1 => Dmod mn (compile_decs ds1)::compile_decs ds | Dlocal ds1' ds2 => Dlocal (compile_decs ds1') (compile_decs ds2)::compile_decs ds | Denv v37 => d::compile_decs ds) | SOME (v1,v2) => Dlocal v1 [v2]::compile_decs ds
nested_lifts=compile_decs [Dmod «M» [Dlet unknown_loc Pany (Let (NONE :mlstring option) (Lit (IntLit (1 :int))) (Let (SOME «x») (Lit (IntLit (2 :int))) (Var (Short «x» :(mlstring, mlstring) id))))]] = [Dmod «M» [Dlocal [Dlet unknown_loc Pany (Lit (IntLit (1 :int))); Dlet unknown_loc (Pvar «x») (Lit (IntLit (2 :int)))] [Dlet unknown_loc Pany (Var (Short «x» :(mlstring, mlstring) id))]]] ⇔ T
