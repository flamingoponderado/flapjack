extract_def_typed=(extract (Var (n :num) :exp) (ys :α list) :num) = n + LENGTH ys + (1 :num) ∧ (extract (If (v4 :exp) (v5 :exp) (v6 :exp) :exp) (v1 :α list) :num) = (0 :num) ∧ (extract (Let (v7 :exp list) (v8 :exp) :exp) v1 :num) = (0 :num) ∧ (extract (Raise (v9 :exp) :exp) v1 :num) = (0 :num) ∧ (extract (Tick (v10 :exp) :exp) v1 :num) = (0 :num) ∧ (extract (Call (v11 :num) (v12 :num option) (v13 :exp list) (v14 :exp option) :exp) v1 :num) = (0 :num) ∧ (extract (Force (v15 :num) (v16 :num) :exp) v1 :num) = (0 :num) ∧ (extract (Op (v17 :op) (v18 :exp list) :exp) v1 :num) = (0 :num) ∧ (extract (LetCall (v19 :num) (v20 :num) (v21 :num) (v22 :exp list) (v23 :exp)) v1 :num) = (0 :num) ∧ (extract (Return (v24 :exp list)) v1 :num) = (0 :num)
extract_list_def_typed=extract_list ([] :exp list) = ([] :num list) ∧ ∀(x :exp) (xs :exp list). extract_list (x::xs) = (extract x xs :num)::extract_list xs
delete_var_def_typed=delete_var (Var (n :num) :exp) = (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) ∧ delete_var (If (v1 :exp) (v2 :exp) (v3 :exp) :exp) = (If v1 v2 v3 :exp) ∧ delete_var (Let (v4 :exp list) (v5 :exp) :exp) = (Let v4 v5 :exp) ∧ delete_var (Raise (v6 :exp) :exp) = (Raise v6 :exp) ∧ delete_var (Tick (v7 :exp) :exp) = (Tick v7 :exp) ∧ delete_var (Call (v8 :num) (v9 :num option) (v10 :exp list) (v11 :exp option) :exp) = (Call v8 v9 v10 v11 :exp) ∧ delete_var (Force (v12 :num) (v13 :num) :exp) = (Force v12 v13 :exp) ∧ delete_var (Op (v14 :op) (v15 :exp list) :exp) = (Op v14 v15 :exp) ∧ delete_var (LetCall (v16 :num) (v17 :num) (v18 :num) (v19 :exp list) (v20 :exp)) = LetCall v16 v17 v18 v19 v20 ∧ delete_var (Return (v21 :exp list)) = Return v21
compile_def_typed=(∀(env :num list) (d :num). compile env d ([] :exp list) = ([] :exp list)) ∧ (∀(y :exp) (xs :exp list) (x :exp) (env :num list) (d :num). compile env d (x::y::xs) = compile env d [x] ++ compile env d (y::xs)) ∧ (∀(v :num) (env :num list) (d :num). compile env d [(Var v :exp)] = case LLOOKUP env v of (NONE :num option) => [(Var (v + d) :exp)] | SOME n => [(Var (v + n) :exp)]) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (env :num list) (d :num). compile env d [(If x1 x2 x3 :exp)] = [(If (HD (compile env d [x1])) (HD (compile env d [x2])) (HD (compile env d [x3])) :exp)]) ∧ (∀(xs :exp list) (x2 :exp) (env :num list) (d :num). compile env d [(Let xs x2 :exp)] = (let (l :num) = LENGTH xs in if l = (0 :num) then compile env d [x2] else (let (k :num) = l − (1 :num) in if x2 = (Var k :exp) then (let (ys :exp list) = compile env d (FRONT xs) in [(Let ys (HD (compile (MAP ($+ k) env) (d + k) [LAST xs])) :exp)]) else (let (ys :exp list) = compile env d xs in [(Let (MAP delete_var ys) (HD (compile (extract_list ys ++ env) d [x2])) :exp)])))) ∧ (∀(x1 :exp) (env :num list) (d :num). compile env d [(Raise x1 :exp)] = [(Raise (HD (compile env d [x1])) :exp)]) ∧ (∀(xs :exp list) (op :op) (env :num list) (d :num). compile env d [(Op op xs :exp)] = [(Op op (compile env d xs) :exp)]) ∧ (∀(x :exp) (env :num list) (d :num). compile env d [(Tick x :exp)] = [(Tick (HD (compile env d [x])) :exp)]) ∧ (∀(v :num) (loc :num) (env :num list) (d :num). compile env d [(Force loc v :exp)] = case LLOOKUP env v of (NONE :num option) => [(Force loc (v + d) :exp)] | SOME n => [(Force loc (v + n) :exp)]) ∧ (∀(xs :exp list) (t :num) (h :exp option) (env :num list) (dest :num option) (d :num). compile env d [(Call t dest xs h :exp)] = [(Call t dest (compile env d xs) (case h of (NONE :exp option) => (NONE :exp option) | SOME e => SOME (HD (compile ((0 :num)::env) d [e]))) :exp)]) ∧ (∀(xs :exp list) (env :num list) (d :num). compile env d [Return xs] = [Return (compile env d xs)]) ∧ ∀(y :exp) (xs :exp list) (t :num) (rets :num) (env :num list) (dest :num) (d :num). compile env d [LetCall rets t dest xs y] = [LetCall rets t dest (compile env d xs) (HD (compile (REPLICATE rets (0 :num) ++ env) d [y]))]
compile_exp_def_typed=∀(x :exp). compile_exp x = case compile ([] :num list) (0 :num) [x] of ([] :exp list) => (Var (0 :num) :exp) | y::v3 => y
compile_sing_typed=(∀(n :num list) (d :num) (e :exp). compile n d [e] = [compile_sing n d e]) ∧ ∀(n :num list) (d :num) (e :exp list). compile_list n d e = compile n d e
compile_exp_eq_typed=∀(x :exp). compile_exp x = compile_sing ([] :num list) (0 :num) x
