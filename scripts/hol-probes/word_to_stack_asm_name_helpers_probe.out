anh_type=:α asm_config -> α stackLang$prog -> bool
anh_call_dest_stack_asm_name=⊢ call_dest d a k = (q0,d') ⇒ stack_asm_name c q0 ∧ case d' of INL l => T | INR r => r ≤ FST k + 1
anh_wLive_stack_asm_name=⊢ FST kf + 1 < c.reg_count − LENGTH c.avoid_regs ∧ wLive q bs kf = (q1,bs') ⇒ stack_asm_name c q1
anh_stack_move_stack_asm_name=⊢ ∀n start offset i p. stack_asm_name c (stack_move n start offset i p) ⇔ stack_asm_name c p
anh_copy_ret_aux_stack_asm_name=⊢ ∀k f n. stack_asm_name c (copy_ret_aux k f n)
anh_copy_ret_stack_asm_name=⊢ stack_asm_name c (copy_ret perf b kf vs kont) ⇔ stack_asm_name c kont
