beq_source=∀rs1 rs2 offs. dfn'BEQ (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) = if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
beq_hypotheses=0
beq_typed_source=∀(rs1 :word5) (rs2 :word5) (offs :word12). dfn'BEQ (rs1,rs2,offs) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s in if (if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) = if v0 then (sw2sw (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0 then branchTo (PC s0 + (sw2sw offs :word64) ≪ (1 :num)) s0 else s0))
bne_source=∀rs1 rs2 offs. dfn'BNE (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) ≠ if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
bne_hypotheses=0
bne_typed_source=∀(rs1 :word5) (rs2 :word5) (offs :word12). dfn'BNE (rs1,rs2,offs) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s in if (if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) ≠ if v0 then (sw2sw (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0 then branchTo (PC s0 + (sw2sw offs :word64) ≪ (1 :num)) s0 else s0))
blt_source=∀rs1 rs2 offs. dfn'BLT (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) < if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
