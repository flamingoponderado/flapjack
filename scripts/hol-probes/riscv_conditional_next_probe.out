bgeu_typed_source=∀(rs1 :word5) (rs2 :word5) (offs :word12). dfn'BGEU (rs1,rs2,offs) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s in if (if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) ≥₊ if v0 then (sw2sw (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0 then branchTo (PC s0 + (sw2sw offs :word64) ≪ (1 :num)) s0 else s0))
next_source=∀s. NextRISCV s = (let (f,s) = Fetch s; s = Run (DecodeAny f) s in if s.exception ≠ NoException then NONE else (let pc = PC s in case NextFetch s of NONE => update_pc (pc + Skip s) s | SOME (BranchTo a) => update_pc a (write'NextFetch NONE s) | SOME Ereturn => NONE | SOME Mrts => NONE | SOME (Trap v5) => NONE))
next_hypotheses=0
next_typed_source=∀(s :riscv_state). NextRISCV s = (let ((f :rawInstType),(s :riscv_state)) = (Fetch s :rawInstType # riscv_state); (s :riscv_state) = Run (DecodeAny f) s in if s.exception ≠ NoException then (NONE :riscv_state option) else (let (pc :word64) = PC s in case NextFetch s of (NONE :TransferControl option) => update_pc (pc + Skip s) s | SOME (BranchTo a) => update_pc a (write'NextFetch (NONE :TransferControl option) s) | SOME Ereturn => (NONE :riscv_state option) | SOME Mrts => (NONE :riscv_state option) | SOME (Trap v5) => (NONE :riscv_state option)))
