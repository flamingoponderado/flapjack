blt_typed_source=∀(rs1 :word5) (rs2 :word5) (offs :word12). dfn'BLT (rs1,rs2,offs) = (λ(state :riscv_state). (let ((v :bool),(s :riscv_state)) = in32BitMode () state; ((v0 :bool),(s0 :riscv_state)) = in32BitMode () s in if (if v then (sw2sw (((31 :num) >< (0 :num)) (GPR rs1 s) :word32) :word64) else GPR rs1 s) < if v0 then (sw2sw (((31 :num) >< (0 :num)) (GPR rs2 s0) :word32) :word64) else GPR rs2 s0 then branchTo (PC s0 + (sw2sw offs :word64) ≪ (1 :num)) s0 else s0))
