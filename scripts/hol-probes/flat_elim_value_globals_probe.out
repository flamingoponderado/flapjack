value_globals=(∀(vl :v list) (v0 :(num # num option) option). find_v_globals (Conv v0 vl) = find_v_globalsL vl) ∧ (∀(v1 :mlstring) (env :v environment) (e :exp). find_v_globals (Closure env v1 e :v) = union (find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)) (find_lookups e)) ∧ (∀(vves :(mlstring # mlstring # exp) list) (v2 :mlstring) (env :v environment). find_v_globals (Recclosure env vves v2 :v) = union (find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)) (find_lookupsL (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) vves))) ∧ (∀(vl :v list). find_v_globals (Vectorv vl) = find_v_globalsL vl) ∧ (∀(v5 :lit). isEmpty (find_v_globals (Litv v5 :v))) ∧ (∀(v15 :num) (v14 :bool). isEmpty (find_v_globals (Loc v14 v15 :v))) ∧ isEmpty (find_v_globalsL ([] :v list)) ∧ ∀(t :v list) (h :v). find_v_globalsL (h::t) = union (find_v_globals h) (find_v_globalsL t)
refs_globals=(∀(t :v store_v list) (a :v). find_refs_globals (Refv a::t) = union (find_v_globals a) (find_refs_globals t)) ∧ (∀(t :v store_v list) (l :v list). find_refs_globals (Varray l::t) = union (find_v_globalsL l) (find_refs_globals t)) ∧ (∀(v0 :thunk_mode) (t :v store_v list) (a :v). find_refs_globals (Thunk v0 a::t) = union (find_v_globals a) (find_refs_globals t)) ∧ (∀(v4 :word8 list) (t :v store_v list). find_refs_globals ((W8array v4 :v store_v)::t) = find_refs_globals t) ∧ isEmpty (find_refs_globals ([] :v store_v list))
env_globals=∀(env :v environment). find_env_globals env = find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)
result_globals=find_result_globals (SOME (Rraise (v :v))) = find_v_globals v ∧ isEmpty (find_result_globals (NONE :v error_result option)) ∧ isEmpty (find_result_globals (SOME (Rabort (v4 :abort) :v error_result)))
primitive_result_globals=(∀(e :v error_result). find_sem_prim_res_globals (Rerr e :(v list, v) result) = find_result_globals (SOME e)) ∧ ∀(e :v list). find_sem_prim_res_globals (Rval e :(v list, v) result) = find_v_globalsL e
value_has_eval=(∀(v0 :mlstring) (env :v environment) (e :exp). v_has_Eval (Closure env v0 e :v) ⇔ has_Eval e ∨ EXISTS (λ(a :v). v_has_Eval a) (MAP (SND :mlstring # v -> v) env.v)) ∧ (∀(vl :v list) (v1 :(num # num option) option). v_has_Eval (Conv v1 vl) ⇔ EXISTS (λ(a :v). v_has_Eval a) vl) ∧ (∀(v2 :mlstring) (nm_es :(mlstring # mlstring # exp) list) (env :v environment). v_has_Eval (Recclosure env nm_es v2 :v) ⇔ EXISTS (λ(a :v). v_has_Eval a) (MAP (SND :mlstring # v -> v) env.v) ∨ EXISTS has_Eval (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) nm_es)) ∧ (∀(vl :v list). v_has_Eval (Vectorv vl) ⇔ EXISTS (λ(a :v). v_has_Eval a) vl) ∧ (∀(v :lit). v_has_Eval (Litv v :v) ⇔ F) ∧ ∀(v13 :num) (v12 :bool). v_has_Eval (Loc v12 v13 :v) ⇔ F
globals_relation=∀(reachable :sptree$num_set) (s_g :v option list) (t_g :v option list). globals_rel reachable s_g t_g ⇔ LENGTH s_g = LENGTH t_g ∧ (∀(n :num). n ∈ (domain reachable :num -> bool) ∧ n < LENGTH t_g ⇒ s_g❲n❳ = t_g❲n❳) ∧ (∀(n :num) (x :v). n < LENGTH t_g ∧ t_g❲n❳ = SOME x ⇒ s_g❲n❳ = SOME x) ∧ (∀(n :num). n < LENGTH t_g ∧ s_g❲n❳ = (NONE :v option) ⇒ t_g❲n❳ = (NONE :v option)) ∧ ∀(n :num) (x :v). n ∈ (domain reachable :num -> bool) ∧ n < LENGTH t_g ∧ t_g❲n❳ = SOME x ⇒ ¬v_has_Eval x ∧ (domain (find_v_globals x) :num -> bool) ⊆ (domain reachable :num -> bool)
globals_transitivity=∀(reachable :sptree$num_set) (s1 :v option list) (s2 :v option list) (s3 :v option list). globals_rel reachable s1 s2 ∧ globals_rel reachable s2 s3 ⇒ globals_rel reachable s1 s3
state_relation=∀(reachable :sptree$num_set) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). flat_state_rel reachable s t ⇔ s.clock = t.clock ∧ s.refs = t.refs ∧ s.ffi = t.ffi ∧ globals_rel reachable s.globals t.globals ∧ (domain (find_refs_globals s.refs) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ EVERY (EVERY ($¬ ∘ v_has_Eval) ∘ (store_v_vs :v store_v -> v list)) s.refs
state_transitivity=∀(reachable :sptree$num_set) (s1 :(α, β) state) (s2 :(α, β) state) (s3 :(α, β) state). flat_state_rel reachable s1 s2 ∧ flat_state_rel reachable s2 s3 ⇒ flat_state_rel reachable s1 s3
closure_lookup=SOME ()
tuple_lookup=SOME ()
closure_eval=T
