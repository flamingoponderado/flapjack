pure_every_eta=∀(es :exp list). EVERY (λ(a :exp). is_pure a) es ⇔ EVERY is_pure es
value_globals=(∀(vl :v list) (v0 :(num # num option) option). find_v_globals (Conv v0 vl) = find_v_globalsL vl) ∧ (∀(v1 :mlstring) (env :v environment) (e :exp). find_v_globals (Closure env v1 e :v) = union (find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)) (find_lookups e)) ∧ (∀(vves :(mlstring # mlstring # exp) list) (v2 :mlstring) (env :v environment). find_v_globals (Recclosure env vves v2 :v) = union (find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)) (find_lookupsL (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) vves))) ∧ (∀(vl :v list). find_v_globals (Vectorv vl) = find_v_globalsL vl) ∧ (∀(v5 :lit). isEmpty (find_v_globals (Litv v5 :v))) ∧ (∀(v15 :num) (v14 :bool). isEmpty (find_v_globals (Loc v14 v15 :v))) ∧ isEmpty (find_v_globalsL ([] :v list)) ∧ ∀(t :v list) (h :v). find_v_globalsL (h::t) = union (find_v_globals h) (find_v_globalsL t)
refs_globals=(∀(t :v store_v list) (a :v). find_refs_globals (Refv a::t) = union (find_v_globals a) (find_refs_globals t)) ∧ (∀(t :v store_v list) (l :v list). find_refs_globals (Varray l::t) = union (find_v_globalsL l) (find_refs_globals t)) ∧ (∀(v0 :thunk_mode) (t :v store_v list) (a :v). find_refs_globals (Thunk v0 a::t) = union (find_v_globals a) (find_refs_globals t)) ∧ (∀(v4 :word8 list) (t :v store_v list). find_refs_globals ((W8array v4 :v store_v)::t) = find_refs_globals t) ∧ isEmpty (find_refs_globals ([] :v store_v list))
lookups_append=∀(l1 :exp list) (l2 :exp list). find_lookupsL (l1 ++ l2) = union (find_lookupsL l1) (find_lookupsL l2)
value_globals_append=∀(l1 :v list) (l2 :v list). find_v_globalsL (l1 ++ l2) = union (find_v_globalsL l1) (find_v_globalsL l2)
refs_globals_append=∀(refs :v store_v list) (new :v store_v list). find_refs_globals (refs ++ new) = union (find_refs_globals refs) (find_refs_globals new)
lookups_reverse=∀(l :exp list). find_lookupsL l = find_lookupsL (REVERSE l)
value_globals_reverse=∀(l :v list). find_v_globalsL l = find_v_globalsL (REVERSE l)
value_globals_el=∀(n :num) (vs :v list). n < LENGTH vs ⇒ (domain (find_v_globals vs❲n❳) :num -> bool) ⊆ (domain (find_v_globalsL vs) :num -> bool)
refs_globals_el=(n :num) < LENGTH (refs :v store_v list) ∧ (domain (find_refs_globals refs) :num -> bool) ⊆ (R :num -> bool) ⇒ (∀(a :v). refs❲n❳ = Refv a ⇒ (domain (find_v_globals a) :num -> bool) ⊆ R) ∧ (∀(vs :v list). refs❲n❳ = Varray vs ⇒ (domain (find_v_globalsL vs) :num -> bool) ⊆ R) ∧ ∀(m :thunk_mode) (a :v). refs❲n❳ = Thunk m a ⇒ (domain (find_v_globals a) :num -> bool) ⊆ R
env_globals=∀(env :v environment). find_env_globals env = find_v_globalsL (MAP (SND :mlstring # v -> v) env.v)
result_globals=find_result_globals (SOME (Rraise (v :v))) = find_v_globals v ∧ isEmpty (find_result_globals (NONE :v error_result option)) ∧ isEmpty (find_result_globals (SOME (Rabort (v4 :abort) :v error_result)))
primitive_result_globals=(∀(e :v error_result). find_sem_prim_res_globals (Rerr e :(v list, v) result) = find_result_globals (SOME e)) ∧ ∀(e :v list). find_sem_prim_res_globals (Rval e :(v list, v) result) = find_v_globalsL e
value_has_eval=(∀(v0 :mlstring) (env :v environment) (e :exp). v_has_Eval (Closure env v0 e :v) ⇔ has_Eval e ∨ EXISTS (λ(a :v). v_has_Eval a) (MAP (SND :mlstring # v -> v) env.v)) ∧ (∀(vl :v list) (v1 :(num # num option) option). v_has_Eval (Conv v1 vl) ⇔ EXISTS (λ(a :v). v_has_Eval a) vl) ∧ (∀(v2 :mlstring) (nm_es :(mlstring # mlstring # exp) list) (env :v environment). v_has_Eval (Recclosure env nm_es v2 :v) ⇔ EXISTS (λ(a :v). v_has_Eval a) (MAP (SND :mlstring # v -> v) env.v) ∨ EXISTS has_Eval (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) nm_es)) ∧ (∀(vl :v list). v_has_Eval (Vectorv vl) ⇔ EXISTS (λ(a :v). v_has_Eval a) vl) ∧ (∀(v :lit). v_has_Eval (Litv v :v) ⇔ F) ∧ ∀(v13 :num) (v12 :bool). v_has_Eval (Loc v12 v13 :v) ⇔ F
globals_relation=∀(reachable :sptree$num_set) (s_g :v option list) (t_g :v option list). globals_rel reachable s_g t_g ⇔ LENGTH s_g = LENGTH t_g ∧ (∀(n :num). n ∈ (domain reachable :num -> bool) ∧ n < LENGTH t_g ⇒ s_g❲n❳ = t_g❲n❳) ∧ (∀(n :num) (x :v). n < LENGTH t_g ∧ t_g❲n❳ = SOME x ⇒ s_g❲n❳ = SOME x) ∧ (∀(n :num). n < LENGTH t_g ∧ s_g❲n❳ = (NONE :v option) ⇒ t_g❲n❳ = (NONE :v option)) ∧ ∀(n :num) (x :v). n ∈ (domain reachable :num -> bool) ∧ n < LENGTH t_g ∧ t_g❲n❳ = SOME x ⇒ ¬v_has_Eval x ∧ (domain (find_v_globals x) :num -> bool) ⊆ (domain reachable :num -> bool)
globals_transitivity=∀(reachable :sptree$num_set) (s1 :v option list) (s2 :v option list) (s3 :v option list). globals_rel reachable s1 s2 ∧ globals_rel reachable s2 s3 ⇒ globals_rel reachable s1 s3
declarations_closed=∀(reachable :sptree$num_set) (decs :exp list). decs_closed reachable decs ⇔ ∀(r :sptree$num_set) (t :sptree$num_set sptree$num_map). analyse_code decs = (r,t) ⇒ (domain r :num -> bool) ⊆ (domain reachable :num -> bool) ∧ ∀(n :num) (m :num). n ∈ (domain reachable :num -> bool) ∧ is_reachable t n m ⇒ m ∈ (domain reachable :num -> bool)
closed_tail=∀(reachable :sptree$num_set) (e :exp) (t :exp list). decs_closed reachable (e::t) ⇒ decs_closed reachable t
closed_head=∀(reachable :sptree$num_set) (e :exp) (t :exp list). decs_closed reachable (e::t) ⇒ decs_closed reachable [e]
state_relation=∀(reachable :sptree$num_set) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). flat_state_rel reachable s t ⇔ s.clock = t.clock ∧ s.refs = t.refs ∧ s.ffi = t.ffi ∧ globals_rel reachable s.globals t.globals ∧ (domain (find_refs_globals s.refs) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ EVERY (EVERY ($¬ ∘ v_has_Eval) ∘ (store_v_vs :v store_v -> v list)) s.refs
state_transitivity=∀(reachable :sptree$num_set) (s1 :(α, β) state) (s2 :(α, β) state) (s3 :(α, β) state). flat_state_rel reachable s1 s2 ∧ flat_state_rel reachable s2 s3 ⇒ flat_state_rel reachable s1 s3
state_pmatch=(∀(new_state :(γ, 'ffi) state) (p :pat) (a :v) (env :(mlstring # v) list). flat_state_rel (reachable :sptree$num_set) new_state (new_removed_state :(γ, 'ffi) state) ⇒ (pmatch new_removed_state p a env :(mlstring # v) list match_result) = (pmatch new_state p a env :(mlstring # v) list match_result)) ∧ ∀(new_state :(γ, 'ffi) state) (p :pat list) (a :v list) (env :(mlstring # v) list). flat_state_rel reachable new_state new_removed_state ⇒ (pmatch_list new_removed_state p a env :(mlstring # v) list match_result) = (pmatch_list new_state p a env :(mlstring # v) list match_result)
state_pmatch_rows=flat_state_rel (reachable :sptree$num_set) (new_state :(α, β) state) (new_removed_state :(α, β) state) ⇒ pmatch_rows (pes :(pat # exp) list) new_removed_state (a :v) = pmatch_rows pes new_state a
selected_row_lookups=pmatch_rows (pes :(pat # exp) list) (q :(α, β) state) (a :v) = Match ((env' :(mlstring # v) list),(p' :pat),(e' :exp)) ∧ (domain (find_lookupsL (MAP (SND :pat # exp -> exp) pes)) :num -> bool) ⊆ (domain (reachable :γ sptree$num_map) :num -> bool) ⇒ (domain (find_lookups e') :num -> bool) ⊆ (domain reachable :num -> bool)
value_to_list_globals=∀(x :v) (reachable :sptree$num_set) (xs :v list). (domain (find_v_globals x) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ v_to_list x = SOME xs ⇒ (domain (find_v_globalsL xs) :num -> bool) ⊆ (domain reachable :num -> bool)
list_to_value_globals=∀(xs :v list) (reachable :sptree$num_set) (x :v). (domain (find_v_globalsL xs) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ list_to_v xs = x ⇒ (domain (find_v_globals x) :num -> bool) ⊆ (domain reachable :num -> bool)
list_append_globals=∀(xs :v list) (reachable :sptree$num_set) (ys :v list). (domain (find_v_globalsL xs) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ (domain (find_v_globalsL ys) :num -> bool) ⊆ (domain reachable :num -> bool) ⇒ (domain (find_v_globals (list_to_v (xs ++ ys))) :num -> bool) ⊆ (domain reachable :num -> bool)
list_to_value_eval=v_has_Eval (list_to_v (xs :v list)) ⇔ EXISTS v_has_Eval xs
value_to_list_eval=∀(v :v) (xs :v list). v_to_list v = SOME xs ⇒ (v_has_Eval v ⇔ EXISTS v_has_Eval xs)
evaluation_length=∀(env :v environment) (s :(γ, 'ffi) state) (ls :exp list) (s' :(γ, 'ffi) state) (vs :v list). (evaluate env s ls :(γ, 'ffi) state # (v list, v) result) = (s',(Rval vs :(v list, v) result)) ⇒ LENGTH vs = LENGTH ls
evaluation_singleton=(evaluate (env :v environment) (s :(α, β) state) [(e :exp)] :(α, β) state # (v list, v) result) = ((s' :(α, β) state),(Rval (vs :v list) :(v list, v) result)) ⇒ ∃(y :v). vs = [y]
evaluation_simulation=∀(env :v environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate env state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ (domain (find_lookupsL exprL) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ flat_state_rel reachable state removed_state ∧ (domain (find_env_globals env) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ EVERY ($¬ ∘ v_has_Eval ∘ (SND :mlstring # v -> v)) env.v ∧ EVERY ($¬ ∘ has_Eval) exprL ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). (evaluate env removed_state exprL :(γ, 'ffi) state # (v list, v) result) = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state ∧ (domain (find_sem_prim_res_globals result) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ EVERY ($¬ ∘ v_has_Eval) (result_vs result)
singleton_evaluation_simulation=∀(env :α environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (expr :exp) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate (env with v := ([] :(mlstring # v) list)) state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ flat_state_rel reachable state removed_state ∧ exprL = [expr] ∧ keep reachable expr ∧ (domain (find_lookups expr) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ ¬has_Eval expr ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). (evaluate (env with v := ([] :(mlstring # v) list)) removed_state exprL :(γ, 'ffi) state # (v list, v) result) = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state
declaration_evaluation_simulation=∀(state :(γ, 'ffi) state) (dec :exp) (new_state :(γ, 'ffi) state) (result :v error_result option) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). evaluate_dec state dec = (new_state,result) ∧ decs_closed reachable [dec] ∧ flat_state_rel reachable state removed_state ∧ keep reachable dec ∧ ¬has_Eval_dec dec ∧ result ≠ SOME (Rabort Rtype_error :v error_result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). evaluate_dec removed_state dec = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state
total_pattern_no_match=(∀(s :(γ, 'ffi) state) (p :pat) (v :v) (env :(mlstring # v) list) (res :(mlstring # v) list match_result). (pmatch s p v env :(mlstring # v) list match_result) = res ∧ total_pat p ⇒ res ≠ (No_match :(mlstring # v) list match_result)) ∧ ∀(s :(γ, 'ffi) state) (ps :pat list) (vs :v list) (env :(mlstring # v) list) (res :(mlstring # v) list match_result). LENGTH ps = LENGTH vs ∧ (pmatch_list s ps vs env :(mlstring # v) list match_result) = res ∧ total_pat_list ps ⇒ res ≠ (No_match :(mlstring # v) list match_result)
row_total_pattern_no_match=EXISTS total_pat (MAP (FST :pat # α -> pat) (pes :(pat # α) list)) ⇒ pmatch_rows pes (new_state :(β, γ) state) (v :v) ≠ (No_match :((mlstring # v) list # pat # α) match_result)
pure_evaluation_simulation=∀(env :v environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate env state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ EVERY is_pure exprL ∧ EVERY ($¬ ∘ v_has_Eval ∘ (SND :mlstring # v -> v)) env.v ∧ EVERY ($¬ ∘ has_Eval) exprL ∧ EVERY (λ(e :exp). isEmpty (inter (find_loc e) reachable)) exprL ∧ flat_state_rel reachable state removed_state ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(values :v list). flat_state_rel reachable new_state removed_state ∧ result = (Rval values :(v list, v) result) ∧ EVERY ($¬ ∘ v_has_Eval) values
discarded_singleton=∀(env :α environment) (state :(β, γ) state) (exprL :exp list) (new_state :(β, γ) state) (result :(v list, v) result) (expr :exp) (reachable :sptree$num_set) (removed_state :(β, γ) state). (evaluate (env with v := ([] :(mlstring # v) list)) state exprL :(β, γ) state # (v list, v) result) = (new_state,result) ∧ exprL = [expr] ∧ ¬has_Eval expr ∧ ¬keep reachable expr ∧ flat_state_rel reachable state removed_state ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ flat_state_rel reachable new_state removed_state ∧ ∃(value :v). result = (Rval [value] :(v list, v) result)
declaration_removal=∀(state :(γ, 'ffi) state) (decs :exp list) (new_state :(γ, 'ffi) state) (result :v error_result option) (reachable :sptree$num_set) (removed_decs :exp list) (removed_state :(γ, 'ffi) state). (evaluate_decs state decs :(γ, 'ffi) state # v error_result option) = (new_state,result) ∧ result ≠ SOME (Rabort Rtype_error :v error_result) ∧ remove_unreachable reachable decs = removed_decs ∧ flat_state_rel reachable state removed_state ∧ EVERY ($¬ ∘ has_Eval_dec) decs ∧ decs_closed reachable decs ⇒ ∃(new_removed_state :(γ, 'ffi) state). new_removed_state.ffi = new_state.ffi ∧ (evaluate_decs removed_state removed_decs :(γ, 'ffi) state # v error_result option) = (new_removed_state,result)
initial_state_removal=∀(ffi :α ffi_state) (k :num) (decs :exp list) (new_state :(β, α) state) (result :v error_result option) (roots :sptree$num_set) (tree :sptree$num_set sptree$num_map) (reachable :sptree$num_set) (removed_decs :exp list). (evaluate_decs (initial_state ffi k (ec :β install_config)) decs :(β, α) state # v error_result option) = (new_state,result) ∧ result ≠ SOME (Rabort Rtype_error :v error_result) ∧ (roots,tree) = analyse_code decs ∧ reachable = closure_spt roots tree ∧ ¬EXISTS has_Eval_dec decs ∧ remove_unreachable reachable decs = removed_decs ⇒ ∃(s :(β, α) state). s.ffi = new_state.ffi ∧ (evaluate_decs (initial_state ffi k ec) removed_decs :(β, α) state # v error_result option) = (s,result)
flat_eval_sim_definition=∀(ffi :α ffi_state) (ds1 :exp list) (ds2 :exp list) (ec :β install_config) (ec2 :γ install_config) (rel :exp list -> exp list -> bool) (allow_fail :bool). eval_sim ffi ds1 ds2 ec ec2 rel allow_fail ⇔ ∀(k :num) (res1 :v error_result option) (s2 :(β, α) state). (evaluate_decs (initial_state ffi k ec) ds1 :(β, α) state # v error_result option) = (s2,res1) ∧ (allow_fail ∨ res1 ≠ SOME (Rabort Rtype_error :v error_result)) ∧ rel ds1 ds2 ⇒ ∃(ck :num) (res2 :v error_result option) (t2 :(γ, α) state). (evaluate_decs (initial_state ffi (k + ck) ec2) ds2 :(γ, α) state # v error_result option) = (t2,res2) ∧ s2.ffi = t2.ffi ∧ (res1 = (NONE :v error_result option) ⇒ res2 = (NONE :v error_result option)) ∧ (∀(v :v). res1 = SOME (Rraise v) ⇒ ∃(v1 :v). res2 = SOME (Rraise v1)) ∧ ∀(a :abort). res1 = SOME (Rabort a :v error_result) ⇒ res2 = SOME (Rabort a :v error_result)
flat_remove_eval_sim=eval_sim (ffi :α ffi_state) (ds1 :exp list) (remove_flat_prog ds1) (ec :β install_config) ec (λ(d1 :exp list) (d2 :exp list). d2 = remove_flat_prog d1) F
flat_remove_semantics=semantics (ec :β install_config) (ffi :α ffi_state) (ds1 :exp list) ≠ Fail ⇒ semantics ec ffi ds1 = semantics ec ffi (remove_flat_prog ds1)
global_bag_operator=op_gbag (GlobalVarInit (n :num)) = {|n|} ∧ op_gbag (Src (v :ast$op)) = ({||} :num -> num) ∧ op_gbag (GlobalVarAlloc (v1 :num)) = ({||} :num -> num) ∧ op_gbag (GlobalVarLookup (v3 :num)) = ({||} :num -> num) ∧ op_gbag (TagLenEq (v4 :num) (v5 :num)) = ({||} :num -> num) ∧ op_gbag (LenEq (v6 :num)) = ({||} :num -> num) ∧ op_gbag (El (v7 :num)) = ({||} :num -> num) ∧ op_gbag Id = ({||} :num -> num)
global_bag_expressions=(∀(t :tra) (e :exp). set_globals (Raise t e :exp) = set_globals e) ∧ (∀(t :tra) (pes :(pat # exp) list) (e :exp). set_globals (Handle t e pes :exp) = set_globals e ⊎ elist_globals (MAP (SND :pat # exp -> exp) pes)) ∧ (∀(t :tra) (id :(num # num option) option) (es :exp list). set_globals (Con t id es :exp) = elist_globals es) ∧ (∀(v :mlstring) (t :mlstring) (e :exp). set_globals (Fun t v e :exp) = set_globals e) ∧ (∀(t :tra) (op :op) (es :exp list). set_globals (App t op es :exp) = elist_globals es ⊎ op_gbag op) ∧ (∀(t :tra) (e3 :exp) (e2 :exp) (e1 :exp). set_globals (If t e1 e2 e3 :exp) = set_globals e1 ⊎ set_globals e2 ⊎ set_globals e3) ∧ (∀(t :tra) (pes :(pat # exp) list) (e :exp). set_globals (Mat t e pes :exp) = set_globals e ⊎ elist_globals (MAP (SND :pat # exp -> exp) pes)) ∧ (∀(v :mlstring option) (t :tra) (e2 :exp) (e1 :exp). set_globals (Let t v e1 e2 :exp) = set_globals e1 ⊎ set_globals e2) ∧ (∀(t :mlstring) (fs :(mlstring # mlstring # exp) list) (e :exp). set_globals (Letrec t fs e :exp) = set_globals e ⊎ elist_globals (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) fs)) ∧ (∀(v9 :lit) (v8 :tra). set_globals (Lit v8 v9 :exp) = ({||} :num -> num)) ∧ (∀(v14 :mlstring) (v13 :tra). set_globals (Var_local v13 v14) = ({||} :num -> num)) ∧ elist_globals ([] :exp list) = ({||} :num -> num) ∧ ∀(es :exp list) (e :exp). elist_globals (e::es) = set_globals e ⊎ elist_globals es
global_closure_free=(∀(t :tra) (e :exp). esgc_free (Raise t e :exp) ⇔ esgc_free e) ∧ (∀(t :tra) (pes :(pat # exp) list) (e :exp). esgc_free (Handle t e pes :exp) ⇔ esgc_free e ∧ EVERY esgc_free (MAP (SND :pat # exp -> exp) pes)) ∧ (∀(t :tra) (id :(num # num option) option) (es :exp list). esgc_free (Con t id es :exp) ⇔ EVERY esgc_free es) ∧ (∀(v :mlstring) (t :mlstring) (e :exp). esgc_free (Fun t v e :exp) ⇔ set_globals e = ({||} :num -> num)) ∧ (∀(t :tra) (op :op) (es :exp list). esgc_free (App t op es :exp) ⇔ EVERY esgc_free es) ∧ (∀(t :tra) (e3 :exp) (e2 :exp) (e1 :exp). esgc_free (If t e1 e2 e3 :exp) ⇔ esgc_free e1 ∧ esgc_free e2 ∧ esgc_free e3) ∧ (∀(t :tra) (pes :(pat # exp) list) (e :exp). esgc_free (Mat t e pes :exp) ⇔ esgc_free e ∧ EVERY esgc_free (MAP (SND :pat # exp -> exp) pes)) ∧ (∀(v :mlstring option) (t :tra) (e2 :exp) (e1 :exp). esgc_free (Let t v e1 e2 :exp) ⇔ esgc_free e1 ∧ esgc_free e2) ∧ (∀(t :mlstring) (fs :(mlstring # mlstring # exp) list) (e :exp). esgc_free (Letrec t fs e :exp) ⇔ esgc_free e ∧ elist_globals (MAP ((SND :mlstring # exp -> exp) ∘ (SND :mlstring # mlstring # exp -> mlstring # exp)) fs) = ({||} :num -> num)) ∧ (∀(v7 :lit) (v6 :tra). esgc_free (Lit v6 v7 :exp)) ∧ ∀(v12 :mlstring) (v11 :tra). esgc_free (Var_local v11 v12)
removed_global_bag_empty=elist_globals (ds :exp list) = ({||} :num -> num) ⇒ elist_globals (remove_flat_prog ds) = ({||} :num -> num)
