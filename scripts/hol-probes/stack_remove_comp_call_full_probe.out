cc_call_tail_statement=∀dest handler s. (∀prog. find_code dest s.regs s.code = SOME prog ∧ handler = NONE ∧ s.clock ≠ 0 ⇒ ∀r s2 t1 k off jump. evaluate (prog,dec_clock s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k (dec_clock s) t1 ∧ reg_bound prog k ⇒ ∃ck t2. evaluate (comp jump off k prog,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ ∀r s2 t1 k off jump. evaluate (Call NONE dest handler,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound (Call NONE dest handler) k ⇒ ∃ck t2. evaluate (comp jump off k (Call NONE dest handler),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
cc_call_tail_proved=T
cc_call_return_none_statement=∀x dest s. (∀prog. find_code dest (s.regs \\ FST (SND x)) s.code = SOME prog ∧ s.clock ≠ 0 ⇒ ∀r s2 t1 k off jump. evaluate (prog,dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k (dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) t1 ∧ reg_bound prog k ⇒ ∃ck t2. evaluate (comp jump off k prog,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ∧ (∀prog middle. find_code dest (s.regs \\ FST (SND x)) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) = (SOME (Result (Loc (FST (SND (SND x))) (SND (SND (SND x))))),middle) ⇒ ∀r s2 t1 k off jump. evaluate (FST x,middle) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k middle t1 ∧ reg_bound (FST x) k ⇒ ∃ck t2. evaluate (comp jump off k (FST x),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ ∀r s2 t1 k off jump. evaluate (Call (SOME x) dest NONE,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound (Call (SOME x) dest NONE) k ⇒ ∃ck t2. evaluate (comp jump off k (Call (SOME x) dest NONE),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
