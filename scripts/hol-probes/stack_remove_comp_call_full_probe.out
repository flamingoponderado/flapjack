cc_call_full_statement=∀ret handler dest s. (case ret of NONE => ∀prog. find_code dest s.regs s.code = SOME prog ∧ handler = NONE ∧ s.clock ≠ 0 ⇒ ∀r s2 t1 k off jump. evaluate (prog,dec_clock s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k (dec_clock s) t1 ∧ reg_bound prog k ⇒ ∃ck t2. evaluate (comp jump off k prog,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2 | SOME x => ∀prog. find_code dest (s.regs \\ FST (SND x)) s.code = SOME prog ∧ s.clock ≠ 0 ⇒ ∀r s2 t1 k off jump. evaluate (prog,dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k (dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) t1 ∧ reg_bound prog k ⇒ ∃ck t2. evaluate (comp jump off k prog,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ (case ret of NONE => T | SOME x => ∀prog middle. find_code dest (s.regs \\ FST (SND x)) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) = (SOME (Result (Loc (FST (SND (SND x))) (SND (SND (SND x))))),middle) ⇒ ∀r s2 t1 k off jump. evaluate (FST x,middle) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k middle t1 ∧ reg_bound (FST x) k ⇒ ∃ck t2. evaluate (comp jump off k (FST x),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ (case (ret,handler) of (NONE,v4) => T | (SOME x,NONE) => T | (SOME x,SOME h) => ∀prog middle. find_code dest (s.regs \\ FST (SND x)) s.code = SOME prog ∧ s.clock ≠ 0 ∧ evaluate (prog,dec_clock (set_var (FST (SND x)) (Loc (FST (SND (SND x))) (SND (SND (SND x)))) s)) = (SOME (Exception (Loc (FST (SND h)) (SND (SND h)))),middle) ⇒ ∀r s2 t1 k off jump. evaluate (FST h,middle) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k middle t1 ∧ reg_bound (FST h) k ⇒ ∃ck t2. evaluate (comp jump off k (FST h),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ ∀r s2 t1 k off jump. evaluate (Call ret dest handler,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound (Call ret dest handler) k ⇒ ∃ck t2. evaluate (comp jump off k (Call ret dest handler),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) =>