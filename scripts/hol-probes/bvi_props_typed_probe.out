initial_state_simp_typed=(initial_state (f :β ffi_state) (c :(num # bvi$exp) sptree$num_map) (co :num -> α # (num # num # bvi$exp) list) (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option) (k :num) :(α, β) state).code = c ∧ (initial_state f c co cc k :(α, β) state).ffi = f ∧ (initial_state f c co cc k :(α, β) state).clock = k ∧ (initial_state f c co cc k :(α, β) state).compile = cc ∧ (initial_state f c co cc k :(α, β) state).compile_oracle = co ∧ (initial_state f c co cc k :(α, β) state).refs = (FEMPTY :num |-> v ref) ∧ (initial_state f c co cc k :(α, β) state).global = (NONE :num option)
initial_state_with_simp_typed=(initial_state (f :β ffi_state) (c :(num # bvi$exp) sptree$num_map) (co :num -> α # (num # num # bvi$exp) list) (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option) (k :num) :(α, β) state) with clock := (k1 :num) = (initial_state f c co cc k1 :(α, β) state) ∧ (initial_state f c co cc k :(α, β) state) with code := (c1 :(num # bvi$exp) sptree$num_map) = (initial_state f c1 co cc k :(α, β) state)
inc_clock_refs_typed=(inc_clock (n :num) (s :(α, β) state)).refs = s.refs
inc_clock_code_typed=(inc_clock (n :num) (s :(α, β) state)).code = s.code
inc_clock_global_typed=(inc_clock (n :num) (s :(α, β) state)).global = s.global
inc_clock_ffi_typed=(inc_clock (n :num) (s :(β, α) state)).ffi = s.ffi
inc_clock_clock_typed=(inc_clock (n :num) (s :(α, β) state)).clock = s.clock + n
dec_clock_global_typed=(dec_clock (n :num) (s :(α, β) state)).global = s.global
dec_clock_ffi_typed=(dec_clock (n :num) (s :(β, α) state)).ffi = s.ffi
dec_clock_refs_typed=(dec_clock (n :num) (s :(α, β) state)).refs = s.refs
dec_clock_with_code_typed=dec_clock (n :num) ((s :(α, β) state) with code := (c :(num # bvi$exp) sptree$num_map)) = dec_clock n s with code := c
dec_clock_code_typed=(dec_clock (n :num) (s :(α, β) state)).code = s.code
dec_clock0_typed=∀(n :α) (s :(γ, 'ffi) state). dec_clock (0 :num) s = s
inc_clock_eq_0_typed=(inc_clock (extra :num) (s :(α, β) state)).clock = (0 :num) ⇔ s.clock = (0 :num) ∧ extra = (0 :num)
inc_clock_ADD_typed=inc_clock (n :num) (inc_clock (m :num) (s :(α, β) state)) = inc_clock (n + m) s
dec_clock_inv_clock_typed=¬((t1 :(α, β) state).clock < (ticks :num) + (1 :num)) ⇒ dec_clock (ticks + (1 :num)) (inc_clock (c :num) t1) = inc_clock c (dec_clock (ticks + (1 :num)) t1)
dec_clock_inv_clock1_typed=(t1 :(α, β) state).clock ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock (c :num) t1) = inc_clock c (dec_clock (1 :num) t1)
evaluate_code_mono_typed=∀(xs :bvi$exp list) (env :v list) (s1 :(α, β) state) (vs :(v list, exn_or_ret) result) (s2 :(α, β) state). (evaluate (xs,env,s1) :(v list, exn_or_ret) result # (α, β) state) = (vs,s2) ⇒ subspt s1.code s2.code
evaluate_LENGTH_typed=∀(xs :bvi$exp list) (s :v list) (env :(α, β) state). case (evaluate (xs,s,env) :(v list, exn_or_ret) result # (α, β) state) of ((Rval res :(v list, exn_or_ret) result),s1) => LENGTH xs = LENGTH res | ((Rerr v7 :(v list, exn_or_ret) result),s1) => T
evaluate_IMP_LENGTH_typed=(evaluate ((xs :bvi$exp list),(s :v list),(env :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = ((Rval (res :v list) :(v list, exn_or_ret) result),(s1 :(α, β) state)) ⇒ LENGTH xs = LENGTH res
evaluate_SING_IMP_typed=(evaluate ([(x :bvi$exp)],(env :v list),(s1 :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = ((Rval (vs :v list) :(v list, exn_or_ret) result),(s2 :(α, β) state)) ⇒ ∃(w :v). vs = [w]
evaluate_CONS_typed=(evaluate ((x :bvi$exp)::(xs :bvi$exp list),(env :v list),(s :(α, β) state)) :(v list, exn_or_ret) result # (α, β) state) = case (evaluate ([x],env,s) :(v list, exn_or_ret) result # (α, β) state) of ((Rval v :(v list, exn_or_ret) result),s2) => (case (evaluate (xs,env,s2) :(v list, exn_or_ret) result # (α, β) state) of ((Rval vs :(v list, exn_or_ret) result),s1) => ((Rval (HD v::vs) :(v list, exn_or_ret) result),s1) | ((Rerr v8 :(v list, exn_or_ret) result),s1) => ((Rerr v8 :(v list, exn_or_ret) result),s1)) | ((Rerr v10 :(v list, exn_or_ret) result),s2) => ((Rerr v10 :(v list, exn_or_ret) result),s2)
evaluate_SNOC_typed=∀(xs :bvi$exp list) (env :v list) (s :(α, β) state) (x :bvi$exp). (evaluate (SNOC x xs,env,s) :(v list, exn_or_ret) result # (α, β) state) = case (evaluate (xs,env,s) :(v list, exn_or_ret) result # (α, β) state) of ((Rval vs :(v list, exn_or_ret) result),s2) => (case (evaluate ([x],env,s2) :(v list, exn_or_ret) result # (α, β) state) of ((Rval v :(v list, exn_or_ret) result),s1) => ((Rval (vs ++ v) :(v list, exn_or_ret) result),s1) | ((Rerr v8 :(v list, exn_or_ret) result),s1) => ((Rerr v8 :(v list, exn_or_ret) result),s1)) | ((Rerr v10 :(v list, exn_or_ret) result),s2) => ((Rerr v10 :(v list, exn_or_ret) result),s2)
evaluate_APPEND_typed=∀(xs :bvi$exp list) (env :v list) (s :(α, β) state) (ys :bvi$exp list). (evaluate (xs ++ ys,env,s) :(v list, exn_or_ret) result # (α, β) state) = case (evaluate (xs,env,s) :(v list, exn_or_ret) result # (α, β) state) of ((Rval vs :(v list, exn_or_ret) result),s2) => (case (evaluate (ys,env,s2) :(v list, exn_or_ret) result # (α, β) state) of ((Rval ws :(v list, exn_or_ret) result),s1) => ((Rval (vs ++ ws) :(v list, exn_or_ret) result),s1) | ((Rerr v7 :(v list, exn_or_ret) result),s1) => ((Rerr v7 :(v list, exn_or_ret) result),s1)) | ((Rerr v9 :(v list, exn_or_ret) result),s2) => ((Rerr v9 :(v list, exn_or_ret) result),s2)
do_app_change_clock_typed=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((res :v),(s2 :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) ⇒ (do_app op args (s1 with clock := (ck :num)) :(v # (α, β) state, exn_or_ret) result) = (Rval (res,s2 with clock := ck) :(v # (α, β) state, exn_or_ret) result)
do_app_change_clock_err_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rerr (e :exn_or_ret error_result) :(v # (α, β) state, exn_or_ret) result) ⇒ (do_app op vs (s with clock := (c :num)) :(v # (α, β) state, exn_or_ret) result) = (Rerr e :(v # (α, β) state, exn_or_ret) result)
evaluate_add_clock_typed=∀(exps :bvi$exp list) (env :v list) (s1 :(α, β) state) (res :(v list, exn_or_ret) result) (s2 :(α, β) state). (evaluate (exps,env,s1) :(v list, exn_or_ret) result # (α, β) state) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtimeout_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ ∀(ck :num). (evaluate (exps,env,inc_clock ck s1) :(v list, exn_or_ret) result # (α, β) state) = (res,inc_clock ck s2)
do_app_io_events_mono_typed=(do_app (op :closLang$op) (vs :v list) (s1 :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((x :v),(s2 :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_io_events_mono_typed=∀(exps :bvi$exp list) (env :v list) (s1 :(α, β) state) (res :(v list, exn_or_ret) result) (s2 :(α, β) state). (evaluate (exps,env,s1) :(v list, exn_or_ret) result # (α, β) state) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_add_to_clock_io_events_mono_typed=∀(exps :bvi$exp list) (env :v list) (s :(α, β) state) (extra :num). (SND (evaluate (exps,env,s) :(v list, exn_or_ret) result # (α, β) state)).ffi.io_events ≼ (SND (evaluate (exps,env,inc_clock extra s) :(v list, exn_or_ret) result # (α, β) state)).ffi.io_events
adj_orac_def_typed=∀(cc :β -> (num # num # bvi$exp) list -> (word8 list # word64 list # β) option) (f :α -> β) (s :(α, 'ffi) state). adj_orac cc f s = <|refs := s.refs; clock := s.clock; global := s.global; code := s.code; ffi := s.ffi; compile := cc; compile_oracle := (f ## (I :(num # num # bvi$exp) list -> (num # num # bvi$exp) list)) ∘ s.compile_oracle|>
adj_orac_ok_def_typed=∀(cc :β -> (num # num # bvi$exp) list -> (word8 list # word64 list # β) option) (f :α -> β) (s :(α, 'ffi) state). adj_orac_ok cc f s ⇔ ∀(n :num) (x :α) (y :(num # num # bvi$exp) list). (s.compile_oracle n :α # (num # num # bvi$exp) list) = (x,y) ⇒ OPTION_MAP ((I :word8 list -> word8 list) ## (I :word64 list -> word64 list) ## f) (s.compile x y) = cc (f x) y
adj_orac_rel_def_typed=∀(cc :β -> (num # num # bvi$exp) list -> (word8 list # word64 list # β) option) (f :α -> β) (s1 :(α, 'ffi) state) (s2 :(β, 'ffi) state). adj_orac_rel cc f s1 s2 ⇔ adj_orac_ok cc f s1 ∧ s2 = adj_orac cc f s1
evaluate_inv_clock_typed=∀(xs :bvi$exp list) (env :v list) (t1 :(α, β) state) (res :(v list, exn_or_ret) result) (t2 :(α, β) state) (n :num). (evaluate (xs,env,t1) :(v list, exn_or_ret) result # (α, β) state) = (res,t2) ∧ res ≠ (Rerr (Rabort Rtimeout_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ (evaluate (xs,env,inc_clock n t1) :(v list, exn_or_ret) result # (α, β) state) = (res,inc_clock n t2)
do_app_code_typed=∀(op :closLang$op) (s1 :(α, β) state) (s2 :(α, β) state). (do_app op (a :v list) s1 :(v # (α, β) state, exn_or_ret) result) = (Rval ((x0 :v),s2) :(v # (α, β) state, exn_or_ret) result) ∧ op ≠ Install ⇒ s2.code = s1.code
do_app_oracle_typed=∀(op :closLang$op) (s1 :(α, β) state) (s2 :(α, β) state). (do_app op (a :v list) s1 :(v # (α, β) state, exn_or_ret) result) = (Rval ((x0 :v),s2) :(v # (α, β) state, exn_or_ret) result) ∧ op ≠ Install ⇒ s2.compile_oracle = s1.compile_oracle ∧ s2.compile = s1.compile
evaluate_global_mono_typed=∀(xs :bvi$exp list) (env :v list) (s :(α, β) state) (res :(v list, exn_or_ret) result) (t :(α, β) state). (evaluate (xs,env,s) :(v list, exn_or_ret) result # (α, β) state) = (res,t) ⇒ IS_SOME s.global ⇒ IS_SOME t.global
do_app_err_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rerr (e :exn_or_ret error_result) :(v # (α, β) state, exn_or_ret) result) ⇒ e = (Rabort Rtype_error :exn_or_ret error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :exn_or_ret error_result)
do_app_aux_const_typed=do_app_aux (op :closLang$op) (vs :v list) (s :(α, β) state) = SOME (SOME ((y :v),(z :(α, β) state))) ⇒ z.clock = s.clock
do_app_with_code_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((r :v),(s' :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) ⇒ (domain s.code :num -> bool) ⊆ (domain (c :(num # bvi$exp) sptree$num_map) :num -> bool) ∧ op ≠ Install ⇒ (do_app op vs (s with code := c) :(v # (α, β) state, exn_or_ret) result) = (Rval (r,s' with code := c) :(v # (α, β) state, exn_or_ret) result)
do_app_with_code_err_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rerr (e :exn_or_ret error_result) :(v # (α, β) state, exn_or_ret) result) ⇒ ((domain (c :(num # bvi$exp) sptree$num_map) :num -> bool) ⊆ (domain s.code :num -> bool) ∨ e ≠ (Rabort Rtype_error :exn_or_ret error_result)) ∧ op ≠ Install ⇒ (do_app op vs (s with code := c) :(v # (α, β) state, exn_or_ret) result) = (Rerr e :(v # (α, β) state, exn_or_ret) result)
do_app_aux_with_clock_typed=do_app_aux (op :closLang$op) (vs :v list) ((s :(α, β) state) with clock := (c :num)) = OPTION_MAP (OPTION_MAP (λ((x :v),(y :(α, β) state)). (x,y with clock := c))) (do_app_aux op vs s)
do_app_aux_io_events_mono_typed=do_app_aux (op :closLang$op) (vs :v list) (s :(α, β) state) = SOME (SOME ((x :v),(y :(α, β) state))) ⇒ s.ffi.io_events ≼ y.ffi.io_events
do_app_inv_clock_typed=case (do_app (op :closLang$op) (REVERSE (a :v list)) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) of (Rval (v,s1) :(v # (α, β) state, exn_or_ret) result) => (do_app op (REVERSE a) (inc_clock (n :num) s) :(v # (α, β) state, exn_or_ret) result) = (Rval (v,inc_clock n s1) :(v # (α, β) state, exn_or_ret) result) | (Rerr e :(v # (α, β) state, exn_or_ret) result) => (do_app op (REVERSE a) (inc_clock n s) :(v # (α, β) state, exn_or_ret) result) = (Rerr e :(v # (α, β) state, exn_or_ret) result)
do_app_inc_clock_IMP_typed=((do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((v :v),(s1 :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) ⇒ (do_app op vs (inc_clock (n :num) s) :(v # (α, β) state, exn_or_ret) result) = (Rval (v,inc_clock n s1) :(v # (α, β) state, exn_or_ret) result)) ∧ ((do_app op vs s :(v # (α, β) state, exn_or_ret) result) = (Rerr (e :exn_or_ret error_result) :(v # (α, β) state, exn_or_ret) result) ⇒ (do_app op vs (inc_clock n s) :(v # (α, β) state, exn_or_ret) result) = (Rerr e :(v # (α, β) state, exn_or_ret) result))
do_app_inc_clock_typed=(do_app (op :closLang$op) (vs :v list) (inc_clock (x :num) (y :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) = map_result (λ((v :v),(s :(α, β) state)). (v,s with clock := x + y.clock)) (I :exn_or_ret -> exn_or_ret) (do_app op vs y :(v # (α, β) state, exn_or_ret) result)
adj_orac_simps_typed=(adj_orac (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option) (f :γ -> α) (s :(γ, β) state)).clock = s.clock ∧ (adj_orac cc f s).code = s.code ∧ (adj_orac cc f s).refs = s.refs ∧ (adj_orac cc f s).global = s.global ∧ (adj_orac cc f s).ffi = s.ffi ∧ dec_clock (n :num) (adj_orac cc f s) = adj_orac cc f (dec_clock n s) ∧ adj_orac cc f s with clock := (k :num) = adj_orac cc f (s with clock := k) ∧ (adj_orac_ok cc f (dec_clock n s) ⇔ adj_orac_ok cc f s) ∧ (adj_orac_ok cc f (s with clock := k) ⇔ adj_orac_ok cc f s)
do_app_cfg_swap_typed=(op :closLang$op) ≠ Install ⇒ ((do_app op (args :v list) (s :(α, β) state) :(v # (α, β) state, exn_or_ret) result) = (Rval ((value :v),(s1 :(α, β) state)) :(v # (α, β) state, exn_or_ret) result) ∧ (domain s.code :num -> bool) ⊆ (domain (t :(γ, δ) state).code :num -> bool) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (γ, β) state, exn_or_ret) result) = (Rval (value,t with <|refs := s1.refs; clock := s1.clock; global := s1.global; ffi := s1.ffi|>) :(v # (γ, β) state, exn_or_ret) result)) ∧ ((do_app op args s :(v # (α, β) state, exn_or_ret) result) = (Rerr (error :exn_or_ret error_result) :(v # (α, β) state, exn_or_ret) result) ∧ ((domain t.code :num -> bool) ⊆ (domain s.code :num -> bool) ∨ error ≠ (Rabort Rtype_error :exn_or_ret error_result)) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (γ, β) state, exn_or_ret) result) = (Rerr error :(v # (γ, β) state, exn_or_ret) result))
do_app_cfg_swap_Rval_typed=∀(op :closLang$op) (args :v list) (s :(α, 'ffi) state) (s1 :(α, 'ffi) state) (t :(β, 'ffi) state) (value :v). op ≠ Install ∧ (domain s.code :num -> bool) = (domain t.code :num -> bool) ∧ (do_app op args s :(v # (α, 'ffi) state, exn_or_ret) result) = (Rval (value,s1) :(v # (α, 'ffi) state, exn_or_ret) result) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (β, 'ffi) state, exn_or_ret) result) = (Rval (value,t with <|refs := s1.refs; clock := s1.clock; global := s1.global; ffi := s1.ffi|>) :(v # (β, 'ffi) state, exn_or_ret) result)
do_app_cfg_swap_Rerr_typed=∀(op :closLang$op) (args :v list) (s :(α, 'ffi) state) (t :(β, 'ffi) state) (error :exn_or_ret error_result). op ≠ Install ∧ (domain s.code :num -> bool) = (domain t.code :num -> bool) ∧ (do_app op args s :(v # (α, 'ffi) state, exn_or_ret) result) = (Rerr error :(v # (α, 'ffi) state, exn_or_ret) result) ⇒ (do_app op args (t with <|refs := s.refs; clock := s.clock; global := s.global; ffi := s.ffi|>) :(v # (β, 'ffi) state, exn_or_ret) result) = (Rerr error :(v # (β, 'ffi) state, exn_or_ret) result)
do_install_Rerr_type_typed=(do_install (args :v list) (s :(α, β) state) :(v # (α, β) state, γ) result) = (Rerr (e :γ error_result) :(v # (α, β) state, γ) result) ⇒ e = (Rabort Rtype_error :γ error_result)
do_install_adj_orac_typed=∀(args :v list) (s :(α, 'ffi) state) (v :v) (t :(α, 'ffi) state) (cc :β -> (num # num # bvi$exp) list -> (word8 list # word64 list # β) option) (f :α -> β). adj_orac_ok cc f s ∧ (do_install args s :(v # (α, 'ffi) state, exn_or_ret) result) = (Rval (v,t) :(v # (α, 'ffi) state, exn_or_ret) result) ⇒ (do_install args (adj_orac cc f s) :(v # (β, 'ffi) state, exn_or_ret) result) = (Rval (v,adj_orac cc f t) :(v # (β, 'ffi) state, exn_or_ret) result) ∧ adj_orac_ok cc f t
do_app_adj_orac_typed=adj_orac_ok (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option) (f :β -> α) (s :(β, γ) state) ⇒ (∀(v :v) (t :(β, γ) state). (do_app (op :closLang$op) (args :v list) s :(v # (β, γ) state, exn_or_ret) result) = (Rval (v,t) :(v # (β, γ) state, exn_or_ret) result) ⇒ (do_app op args (adj_orac cc f s) :(v # (α, γ) state, exn_or_ret) result) = (Rval (v,adj_orac cc f t) :(v # (α, γ) state, exn_or_ret) result) ∧ adj_orac_ok cc f t) ∧ ∀(e :exn_or_ret error_result). (do_app op args s :(v # (β, γ) state, exn_or_ret) result) = (Rerr e :(v # (β, γ) state, exn_or_ret) result) ∧ e ≠ (Rabort Rtype_error :exn_or_ret error_result) ⇒ (do_app op args (adj_orac cc f s) :(v # (α, γ) state, exn_or_ret) result) = (Rerr e :(v # (α, γ) state, exn_or_ret) result)
evaluate_adj_orac_rel_typed=∀(xs :bvi$exp list) (env :v list) (s :(α, 'ffi) state) (res :(v list, exn_or_ret) result) (t1 :(α, 'ffi) state) (cc :β -> (num # num # bvi$exp) list -> (word8 list # word64 list # β) option) (f :α -> β) (s2 :(β, 'ffi) state). (evaluate (xs,env,s) :(v list, exn_or_ret) result # (α, 'ffi) state) = (res,t1) ∧ res ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ∧ adj_orac_rel cc f s s2 ⇒ ∃(t2 :(β, 'ffi) state). (evaluate (xs,env,s2) :(v list, exn_or_ret) result # (β, 'ffi) state) = (res,t2) ∧ adj_orac_rel cc f t1 t2
adj_orac_initial_state_typed=adj_orac (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option) (SND :γ # α -> α) (initial_state (ffi :β ffi_state) (code :(num # bvi$exp) sptree$num_map) (co :num -> (γ # α) # (num # num # bvi$exp) list) (state_cc (CURRY (I :γ # (num # num # bvi$exp) list -> γ # (num # num # bvi$exp) list)) cc) (k :num) :(γ # α, β) state) = (initial_state ffi code (state_co (CURRY (I :γ # (num # num # bvi$exp) list -> γ # (num # num # bvi$exp) list)) co) cc k :(α, β) state)
adj_orac_ok_initial_state_typed=adj_orac_ok (cc :α -> (num # num # bvi$exp) list -> (word8 list # word64 list # α) option) (SND :β # α -> α) (initial_state (ffi :γ ffi_state) (code :(num # bvi$exp) sptree$num_map) (co :num -> (β # α) # (num # num # bvi$exp) list) (state_cc (CURRY (I :β # (num # num # bvi$exp) list -> β # (num # num # bvi$exp) list)) cc) (k :num) :(β # α, γ) state)
evaluate_CURRY_I_typed=(evaluate ((es :bvi$exp list),(env :v list),(initial_state (ffi :γ ffi_state) (code :(num # bvi$exp) sptree$num_map) (co :num -> (α # β) # (num # num # bvi$exp) list) (state_cc (CURRY (I :α # (num # num # bvi$exp) list -> α # (num # num # bvi$exp) list)) (cc :β -> (num # num # bvi$exp) list -> (word8 list # word64 list # β) option)) (k :num) :(α # β, γ) state)) :(v list, exn_or_ret) result # (α # β, γ) state) = ((r :(v list, exn_or_ret) result),(s :(α # β, γ) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :exn_or_ret error_result) :(v list, exn_or_ret) result) ⇒ ∃(s2 :(β, γ) state). (evaluate (es,env,(initial_state ffi code (state_co (CURRY (I :α # (num # num # bvi$exp) list -> α # (num # num # bvi$exp) list)) co) cc k :(β, γ) state)) :(v list, exn_or_ret) result # (β, γ) state) = (r,s2) ∧ s2.ffi = s.ffi
evaluate_global_mono_lemma_typed=∀(xs :bvi$exp list) (env :v list) (s :(α, β) state). IS_SOME s.global ⇒ IS_SOME (SND (evaluate (xs,env,s) :(v list, exn_or_ret) result # (α, β) state)).global
dec_clock_1_inc_clock_typed=(x :num) ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock x (s :(α, β) state)) = inc_clock (x − (1 :num)) s
dec_clock_1_inc_clock2_typed=(s :(α, β) state).clock ≠ (0 :num) ⇒ dec_clock (1 :num) (inc_clock (x :num) s) = inc_clock x (dec_clock (1 :num) s)
dec_clock_inc_clock_typed=¬((s :(α, β) state).clock < (n :num)) ⇒ dec_clock n (inc_clock (x :num) s) = inc_clock x (dec_clock n s)
take_drop_lem_typed=∀(skip :num) (env :α list). skip < LENGTH env ∧ skip + SUC (n :num) ≤ LENGTH env ∧ DROP skip env ≠ ([] :α list) ⇒ env❲skip❳::TAKE n (DROP ((1 :num) + skip) env) = TAKE (n + (1 :num)) (DROP skip env)
