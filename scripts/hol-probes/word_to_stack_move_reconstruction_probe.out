mr_full_wf_alist_insert=⊢ ∀xs ys z. wf z ⇒ wf (alist_insert xs ys z)
mr_full_ALOOKUP_MAP_any=⊢ ∀f k h ls a x. INJ k (a INSERT set (MAP FST ls)) 𝕌(:γ) ∧ (∀x y. MEM (x,y) ls ⇒ f (x,y) = (k x,h (k x) y)) ∧ k a = x ⇒ ALOOKUP (MAP f ls) x = OPTION_MAP (h x) (ALOOKUP ls a)
mr_full_ALOOKUP_MAP_INJ_FST=⊢ ∀ls f x k. INJ (FST ∘ f) (x INSERT set ls) 𝕌(:β) ∧ FST (f x) = k ⇒ ALOOKUP (MAP f ls) k = ALOOKUP (MAP (λx. (x,SND (f x))) ls) x
mr_full_ALOOKUP_ID_TABULATE=⊢ ALOOKUP (MAP (λx. (x,x)) ls) x = if MEM x ls then SOME x else NONE
mr_full_alist_insert_get_vars=⊢ ∀moves s x ls. ALL_DISTINCT (MAP FST moves) ∧ get_vars (MAP SND moves) s = SOME x ∧ ALL_DISTINCT (FILTER IS_SOME ls) ∧ wf s.locals ∧ (∀x. MEM (SOME x) ls ⇒ MEM x (MAP FST moves)) ∧ (∀x y. MEM (x,y) moves ∧ x ≠ y ⇒ MEM (SOME x) ls) ⇒ alist_insert (MAP THE (FILTER IS_SOME ls)) (MAP (λx. THE (get_var (THE (ALOOKUP moves (THE x))) s)) (FILTER IS_SOME ls)) s.locals = alist_insert (MAP FST moves) x s.locals
