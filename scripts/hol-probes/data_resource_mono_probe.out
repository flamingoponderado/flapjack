same_stack_size_typed=∀(x :stack) (y :stack). same_stack_size x y ⇔ size_of_stack_frame x = size_of_stack_frame y
same_stack_size_size_of_stack_typed=∀(xs :stack list) (ys :stack list). LIST_REL same_stack_size xs ys ⇒ size_of_stack xs = size_of_stack ys
s_peak_heap_typed=(s :(α, β) dataSem$state) with peak_heap_length := s.peak_heap_length = s ∧ s with safe_for_space := s.safe_for_space = s ∧ s with stack_max := s.stack_max = s ∧ s with locals_size := s.locals_size = s ∧ s with <|stack := s.stack; stack_max := (smnew :num option); clock := (clock :num); safe_for_space := (ssnew :bool)|> = s with <|stack_max := smnew; clock := clock; safe_for_space := ssnew|> ∧ s with <|handler := s.handler; safe_for_space := ssnew; peak_heap_length := (plnnew :num)|> = s with <|safe_for_space := ssnew; peak_heap_length := plnnew|>
evaluate_stack_and_locals_swap_typed=∀(c :dataLang$prog) (s :(γ, 'ffi) dataSem$state). case (evaluate (c,s) :(v list, v) result option # (γ, 'ffi) dataSem$state) of ((NONE :(v list, v) result option),s1) => s1.stack = s.stack ∧ s1.handler = s.handler ∧ ∀(xs :stack list) (lsz :num option). LENGTH s.stack = LENGTH xs ⇒ ∃(lss :num option) (sfs :bool) (smx :num option) (phl :num). (evaluate (c,s with <|stack := xs; locals_size := lsz|>) :(v list, v) result option # (γ, 'ffi) dataSem$state) = ((NONE :(v list, v) result option),s1 with <|locals_size := lss; stack := xs; safe_for_space := sfs; stack_max := smx; peak_heap_length := phl|>) | (SOME (Rval v6 :(v list, v) result),s1) => s1.stack = s.stack ∧ s1.handler = s.handler ∧ ∀(xs :stack list) (lsz :num option). LENGTH s.stack = LENGTH xs ⇒ ∃(lss :num option) (sfs :bool) (smx :num option) (phl :num). (evaluate (c,s with <|stack := xs; locals_size := lsz|>) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (SOME (Rval v6 :(v list, v) result),s1 with <|locals_size := lss; stack := xs; safe_for_space := sfs; stack_max := smx; peak_heap_length := phl|>) | (SOME (Rerr (Rraise t) :(v list, v) result),s1) => ∃(s2 :(γ, 'ffi) dataSem$state). jump_exc s = SOME s2 ∧ s2.locals = s1.locals ∧ s2.stack = s1.stack ∧ s2.handler = s1.handler ∧ ∀(xs :stack list) (s7 :(γ, 'ffi) dataSem$state) (lsz :num option). jump_exc (s with <|stack := xs; locals_size := lsz|>) = SOME s7 ∧ LENGTH s.stack = LENGTH xs ⇒ ∃(lss :num option) (sfs :bool) (smx :num option) (phl :num). (evaluate (c,s with <|stack := xs; locals_size := lsz|>) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (SOME (Rerr (Rraise t) :(v list, v) result),s1 with <|stack := s7.stack; handler := s7.handler; locals := s7.locals; locals_size := lss; safe_for_space := sfs; stack_max := smx; peak_heap_length := phl|>) | (SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s1) => T | (SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s1) => s1.stack = ([] :stack list) ∧ ∀(xs :stack list) (lsz :num option). LENGTH s.stack = LENGTH xs ⇒ ∃(lss :num option) (sfs :bool) (smx :num option) (phl :num). (evaluate (c,s with <|stack := xs; locals_size := lsz|>) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (SOME (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s1 with <|locals_size := lss; safe_for_space := sfs; stack_max := smx; peak_heap_length := phl|>) | (SOME (Rerr (Rabort (Rffi_error v14) :v error_result) :(v list, v) result),s1) => s1.stack = ([] :stack list) ∧ ∀(xs :stack list) (lsz :num option). LENGTH s.stack = LENGTH xs ⇒ ∃(lss :num option) (sfs :bool) (smx :num option) (phl :num). (evaluate (c,s with <|stack := xs; locals_size := lsz|>) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (SOME (Rerr (Rabort (Rffi_error v14) :v error_result) :(v list, v) result),s1 with <|locals_size := lss; safe_for_space := sfs; stack_max := smx; peak_heap_length := phl|>)
cut_state_opt_with_const_typed=cut_state_opt (x :sptree$num_set option) ((y :(α, β) dataSem$state) with stack := (z :stack list)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with stack := z) (cut_state_opt x y) ∧ cut_state_opt x (y with clock := (k :num)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with clock := k) (cut_state_opt x y) ∧ cut_state_opt x (y with locals_size := (lsz :num option)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with locals_size := lsz) (cut_state_opt x y)
consume_space_with_stack_replay_typed=consume_space (x :num) ((y :(α, β) dataSem$state) with stack := (z :stack list)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with stack := z) (consume_space x y)
consume_space_with_locals_replay_typed=consume_space (x :num) ((y :(α, β) dataSem$state) with locals := (z :v sptree$num_map)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with locals := z) (consume_space x y)
consume_space_add_space_typed=∃(sf :bool) (hp :num). consume_space (k :num) (add_space ((t :(α, β) dataSem$state) with locals := (env1 :v sptree$num_map)) k) = SOME (t with <|locals := env1; space := (0 :num); safe_for_space := sf; peak_heap_length := hp|>)
do_app_aux_with_locals_typed=do_app_aux (op :closLang$op) (vs :v list) ((s :(α, β) dataSem$state) with locals := (z :v sptree$num_map)) = map_result (λ((x :v),(y :(α, β) dataSem$state)). (x,y with locals := z)) (I :v -> v) (do_app_aux op vs s)
map_error_result_typed=(∀(f :β -> α) (e :β). map_error_result f (Rraise e) = Rraise (f e)) ∧ ∀(f :β -> α) (a :abort). map_error_result f (Rabort a :β error_result) = (Rabort a :α error_result)
map_result_typed=(∀(f1 :γ -> α) (f2 :δ -> β) (v :γ). map_result f1 f2 (Rval v :(γ, δ) result) = (Rval (f1 v) :(α, β) result)) ∧ ∀(f1 :γ -> α) (f2 :δ -> β) (e :δ error_result). map_result f1 f2 (Rerr e :(γ, δ) result) = (Rerr (map_error_result f2 e) :(α, β) result)
map_error_result_Rtype_error_typed=map_error_result (f :β -> α) (e :β error_result) = (Rabort (a :abort) :α error_result) ⇔ e = (Rabort a :β error_result)
map_error_result_I_typed=map_error_result (I :α -> α) (e :α error_result) = e
map_result_Rval_typed=map_result (f1 :γ -> α) (f2 :δ -> β) (e :(γ, δ) result) = (Rval (x :α) :(α, β) result) ⇔ ∃(y :γ). e = (Rval y :(γ, δ) result) ∧ x = f1 y
map_result_Rerr_typed=map_result (f1 :γ -> α) (f2 :δ -> β) (e :(γ, δ) result) = (Rerr (e' :β error_result) :(α, β) result) ⇔ ∃(a :δ error_result). e = (Rerr a :(γ, δ) result) ∧ map_error_result f2 a = e'
do_app_aux_with_space_typed=do_app_aux (op :closLang$op) (vs :v list) ((s :(α, β) dataSem$state) with space := (z :num)) = map_result (λ((x :v),(y :(α, β) dataSem$state)). (x,y with space := z)) (I :v -> v) (do_app_aux op vs s)
