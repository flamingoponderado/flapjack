do_app_io_events_mono_typed=(do_app (x :closLang$op) (y :v list) (z :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((a :v),(b :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.ffi.io_events ≼ b.ffi.io_events
do_app_safe_for_space_mono_typed=(do_app (op :closLang$op) (xs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((r :v),(s1 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ∧ s1.safe_for_space ⇒ s.safe_for_space
do_app_stack_max_typed=(do_app (op :closLang$op) (xs :v list) (s1 :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((v :v),(s2 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ option_le s1.stack_max s2.stack_max
evaluate_io_events_mono_typed=∀(exps :dataLang$prog) (s1 :(α, β) dataSem$state) (res :(v list, v) result option) (s2 :(α, β) dataSem$state). (evaluate (exps,s1) :(v list, v) result option # (α, β) dataSem$state) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_safe_for_space_mono_typed=∀(prog :dataLang$prog) (s :(γ, 'ffi) dataSem$state) (res :(v list, v) result option) (s1 :(γ, 'ffi) dataSem$state). (evaluate (prog,s) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (res,s1) ∧ s1.safe_for_space ⇒ s.safe_for_space
evaluate_option_le_stack_max_typed=∀(c2 :dataLang$prog) (s :(α, β) dataSem$state) (res :(v list, v) result option) (s1 :(α, β) dataSem$state). (evaluate (c2,s) :(v list, v) result option # (α, β) dataSem$state) = (res,s1) ⇒ option_le s.stack_max s1.stack_max
