do_app_io_events_mono_typed=(do_app (x :closLang$op) (y :v list) (z :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((a :v),(b :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.ffi.io_events ≼ b.ffi.io_events
do_app_safe_for_space_mono_typed=(do_app (op :closLang$op) (xs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((r :v),(s1 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ∧ s1.safe_for_space ⇒ s.safe_for_space
do_app_stack_max_typed=(do_app (op :closLang$op) (xs :v list) (s1 :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((v :v),(s2 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ option_le s1.stack_max s2.stack_max
evaluate_io_events_mono_typed=∀(exps :dataLang$prog) (s1 :(α, β) dataSem$state) (res :(v list, v) result option) (s2 :(α, β) dataSem$state). (evaluate (exps,s1) :(v list, v) result option # (α, β) dataSem$state) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_safe_for_space_mono_typed=∀(prog :dataLang$prog) (s :(γ, 'ffi) dataSem$state) (res :(v list, v) result option) (s1 :(γ, 'ffi) dataSem$state). (evaluate (prog,s) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (res,s1) ∧ s1.safe_for_space ⇒ s.safe_for_space
evaluate_option_le_stack_max_typed=∀(c2 :dataLang$prog) (s :(α, β) dataSem$state) (res :(v list, v) result option) (s1 :(α, β) dataSem$state). (evaluate (c2,s) :(v list, v) result option # (α, β) dataSem$state) = (res,s1) ⇒ option_le s.stack_max s1.stack_max
evaluate_smx_safe_peak_swap_typed=∀(smx :num option) (safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ ∃(smx' :num option) (safe' :bool) (peak' :num). (evaluate (c,s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := smx'; safe_for_space := safe'; peak_heap_length := peak'|>)
evaluate_safe_peak_swap_typed=∀(safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ ∃(safe' :bool) (peak' :num). (evaluate (c,s with <|safe_for_space := safe; peak_heap_length := peak|>) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|safe_for_space := safe'; peak_heap_length := peak'|>)
do_app_err_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (e :v error_result) (safe :bool) (peak :num). (do_app op vs s :(v # (α, β) dataSem$state, v) result) = (Rerr e :(v # (α, β) dataSem$state, v) result) ⇒ (do_app op vs (s with <|safe_for_space := safe; peak_heap_length := peak|>) :(v # (α, β) dataSem$state, v) result) = (Rerr e :(v # (α, β) dataSem$state, v) result)
do_app_err_sm_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (e :v error_result) (smx :num option) (safe :bool) (peak :num). (do_app op vs s :(v # (α, β) dataSem$state, v) result) = (Rerr e :(v # (α, β) dataSem$state, v) result) ⇒ (do_app op vs (s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) :(v # (α, β) dataSem$state, v) result) = (Rerr e :(v # (α, β) dataSem$state, v) result)
do_app_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (q :v) (s' :(α, β) dataSem$state) (safe :bool) (peak :num). (do_app op vs s :(v # (α, β) dataSem$state, v) result) = (Rval (q,s') :(v # (α, β) dataSem$state, v) result) ⇒ ∃(new_safe :bool) (new_peak :num). (do_app op vs (s with <|safe_for_space := safe; peak_heap_length := peak|>) :(v # (α, β) dataSem$state, v) result) = (Rval (q,s' with <|safe_for_space := new_safe; peak_heap_length := new_peak|>) :(v # (α, β) dataSem$state, v) result)
do_app_sm_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (q :v) (s' :(α, β) dataSem$state) (smx :num option) (safe :bool) (peak :num). (do_app op vs s :(v # (α, β) dataSem$state, v) result) = (Rval (q,s') :(v # (α, β) dataSem$state, v) result) ⇒ ∃(safe' :bool) (peak' :num) (smx' :num option). (do_app op vs (s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) :(v # (α, β) dataSem$state, v) result) = (Rval (q,s' with <|stack_max := smx'; safe_for_space := safe'; peak_heap_length := peak'|>) :(v # (α, β) dataSem$state, v) result)
size_of_heap_with_safe_typed=∀(s :(α, β) dataSem$state) (safe :bool). size_of_heap (s with safe_for_space := safe) = size_of_heap s
do_app_aux_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (q :v) (s' :(α, β) dataSem$state) (safe :bool) (peak :num). do_app_aux op vs s = (Rval (q,s') :(v # (α, β) dataSem$state, v) result) ⇒ ∃(safe' :bool) (peak' :num). do_app_aux op vs (s with <|safe_for_space := safe; peak_heap_length := peak|>) = (Rval (q,s' with <|safe_for_space := safe'; peak_heap_length := peak'|>) :(v # (α, β) dataSem$state, v) result)
do_app_aux_sm_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (q :v) (s' :(α, β) dataSem$state) (smx :num option) (safe :bool) (peak :num). do_app_aux op vs s = (Rval (q,s') :(v # (α, β) dataSem$state, v) result) ⇒ ∃(safe' :bool) (peak' :num) (smx' :num option). do_app_aux op vs (s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) = (Rval (q,s' with <|stack_max := smx'; safe_for_space := safe'; peak_heap_length := peak'|>) :(v # (α, β) dataSem$state, v) result)
cut_env_typed=∀(name_set :sptree$num_set) (env :α sptree$num_map). cut_env name_set env = if (domain name_set :num -> bool) ⊆ (domain env :num -> bool) then SOME (mk_wf (inter env name_set)) else (NONE :α sptree$num_map option)
cut_state_typed=∀(names :sptree$num_set) (s :(γ, 'ffi) dataSem$state). cut_state names s = case cut_env names s.locals of (NONE :v sptree$num_map option) => (NONE :(γ, 'ffi) dataSem$state option) | SOME env => SOME (s with locals := env)
cut_state_opt_typed=∀(names :sptree$num_set option) (s :(α, β) dataSem$state). cut_state_opt names s = case names of (NONE :sptree$num_set option) => SOME s | SOME names => cut_state names s
call_env_typed=∀(args :v list) (size :num option) (s :(γ, 'ffi) dataSem$state). call_env args size s = (let (new_stack_max :num option) = OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (size_of_stack s.stack) size); (stack_safe :bool) = the F (OPTION_MAP ($> s.limits.stack_limit) new_stack_max) in s with <|locals := (fromList args :v sptree$num_map); locals_size := size; stack_max := new_stack_max; safe_for_space := (s.safe_for_space ∧ stack_safe)|>)
get_var_typed=∀(v :num). (get_var v :α sptree$num_map -> α option) = (lookup v :α sptree$num_map -> α option)
get_vars_typed=(∀(s :α sptree$num_map). get_vars ([] :num list) s = SOME ([] :α list)) ∧ ∀(v :num) (vs :num list) (s :α sptree$num_map). get_vars (v::vs) s = case (get_var v s :α option) of (NONE :α option) => (NONE :α list option) | SOME x => case get_vars vs s of (NONE :α list option) => (NONE :α list option) | SOME xs => SOME (x::xs)
set_var_typed=∀(v :num) (x :v) (s :(α, β) dataSem$state). set_var v x s = s with locals := (insert v x s.locals :v sptree$num_map)
set_vars_typed=∀(ns :num list) (vs :v list) (s :(α, β) dataSem$state). set_vars ns vs s = s with locals := (union (fromAList (ZIP (ns,vs))) s.locals :v sptree$num_map)
flush_state_typed=(∀(s :(γ, 'ffi) dataSem$state). flush_state T s = s with <|locals := (LN :v sptree$num_map); stack := ([] :stack list); locals_size := SOME (0 :num)|>) ∧ ∀(s :(γ, 'ffi) dataSem$state). flush_state F s = s with <|locals := (LN :v sptree$num_map); locals_size := SOME (0 :num)|>
push_env_typed=(∀(env :v sptree$num_map) (s :(γ, 'ffi) dataSem$state). push_env env F s = (let (stack :stack list) = (Env s.locals_size env :stack)::s.stack; (stack_max :num option) = OPTION_MAP2 MAX s.stack_max (size_of_stack stack); (stack_safe :bool) = the F (OPTION_MAP ($> s.limits.stack_limit) stack_max) in s with <|stack := stack; stack_max := stack_max; safe_for_space := (s.safe_for_space ∧ stack_safe)|>)) ∧ ∀(env :v sptree$num_map) (s :(γ, 'ffi) dataSem$state). push_env env T s = (let (stack :stack list) = Exc s.locals_size env s.handler::s.stack; (stack_max :num option) = OPTION_MAP2 MAX s.stack_max (size_of_stack stack); (stack_safe :bool) = the F (OPTION_MAP ($> s.limits.stack_limit) stack_max) in s with <|stack := stack; stack_max := stack_max; handler := LENGTH s.stack; safe_for_space := (s.safe_for_space ∧ stack_safe)|>)
pop_env_typed=∀(s :(γ, 'ffi) dataSem$state). pop_env s = case s.stack of ([] :stack list) => (NONE :(γ, 'ffi) dataSem$state option) | (Env ss e :stack)::xs => SOME (s with <|locals := e; stack := xs; locals_size := ss|>) | Exc ss' e' n::xs => SOME (s with <|locals := e'; stack := xs; locals_size := ss'; handler := n|>)
jump_exc_typed=∀(s :(γ, 'ffi) dataSem$state). jump_exc s = if s.handler < LENGTH s.stack then case LASTN (s.handler + (1 :num)) s.stack of ([] :stack list) => (NONE :(γ, 'ffi) dataSem$state option) | (Env v9 v10 :stack)::xs => (NONE :(γ, 'ffi) dataSem$state option) | Exc ss e n::xs => SOME (s with <|handler := n; locals := e; stack := xs; locals_size := ss|>) else (NONE :(γ, 'ffi) dataSem$state option)
find_code_typed=(∀(p :num) (args :v list) (code :(num # α) sptree$num_map) (ssize :β sptree$num_map). (find_code (SOME p) args code ssize :(v list # α # β option) option) = case (lookup p code :(num # α) option) of (NONE :(num # α) option) => (NONE :(v list # α # β option) option) | SOME (arity,exp) => if LENGTH args = arity then SOME (args,exp,(lookup p ssize :β option)) else (NONE :(v list # α # β option) option)) ∧ ∀(args :v list) (code :(num # α) sptree$num_map) (ssize :β sptree$num_map). (find_code (NONE :num option) args code ssize :(v list # α # β option) option) = if args = ([] :v list) then (NONE :(v list # α # β option) option) else case LAST args of (Number v9 :v) => (NONE :(v list # α # β option) option) | (Word64 v10 :v) => (NONE :(v list # α # β option) option) | (Block v11 v12 v13 :v) => (NONE :(v list # α # β option) option) | (CodePtr loc :v) => (case (lookup loc code :(num # α) option) of (NONE :(num # α) option) => (NONE :(v list # α # β option) option) | SOME (arity,exp) => if LENGTH args = arity + (1 :num) then SOME (FRONT args,exp,(lookup loc ssize :β option)) else (NONE :(v list # α # β option) option)) | (RefPtr v15 v16 :v) => (NONE :(v list # α # β option) option)
is_bool_typed=(isBool (b :bool) (Block (v0 :num) (tag :num) ([] :v list) :v) ⇔ bool_to_tag b = tag) ∧ (isBool (v1 :bool) (Number (v4 :int) :v) ⇔ F) ∧ (isBool v1 (Word64 (v5 :word64) :v) ⇔ F) ∧ (isBool v1 (Block (v6 :num) (v7 :num) ((v20 :v)::(v21 :v list)) :v) ⇔ F) ∧ (isBool v1 (CodePtr (v9 :num) :v) ⇔ F) ∧ (isBool v1 (RefPtr (v10 :bool) (v11 :num) :v) ⇔ F)
install_sfs_typed=∀(op :closLang$op) (s :(γ, 'ffi) dataSem$state). install_sfs op s = s with safe_for_space := (op ≠ Install ∧ s.safe_for_space)
initial_state_typed=∀(ffi :β ffi_state) (code :(num # dataLang$prog) sptree$num_map) (coracle :num -> α # (num # num # dataLang$prog) list) (cc :α -> (num # num # dataLang$prog) list -> (word8 list # word64 list # α) option) (stamps :bool) (lims :limits) (ss :num sptree$num_map) (k :num). (initial_state ffi code coracle cc stamps lims ss k :(α, β) dataSem$state) = <|locals := (LN :v sptree$num_map); locals_size := SOME (0 :num); stack := ([] :stack list); stack_max := SOME (1 :num); global := (NONE :num option); handler := (0 :num); refs := (LN :v ref sptree$num_map); clock := k; code := code; compile := cc; compile_oracle := coracle; ffi := ffi; space := (0 :num); tstamps := if stamps then SOME (0 :num) else (NONE :num option); safe_for_space := if stamps then T else F; peak_heap_length := (0 :num); stack_frame_sizes := ss; limits := lims|>
add_space_typed=∀(s :(γ, 'ffi) dataSem$state) (k :num). add_space s k = s with <|space := k; safe_for_space := add_space_safe k s; peak_heap_length := heap_peak k s|>
op_requires_names_typed=∀(op :closLang$op). op_requires_names op ⇔ op_space_reset op ∨ (∃(n :mlstring). op = (FFI n :closLang$op)) ∨ (∃(new_flag :bool). op = MemOp (CopyByte new_flag)) ∨ op = MemOp XorByte ∨ (∃(b :bool) (cmp :opb). op = MemOp (StringCmp b cmp)) ∨ op = Install
evaluate_clock_typed=∀(xs :dataLang$prog) (s1 :(α, β) dataSem$state) (vs :(v list, v) result option) (s2 :(α, β) dataSem$state). (evaluate (xs,s1) :(v list, v) result option # (α, β) dataSem$state) = (vs,s2) ⇒ s2.clock ≤ s1.clock
fix_clock_evaluate_typed=fix_clock (s :(α, β) dataSem$state) (evaluate ((xs :dataLang$prog),s) :(v list, v) result option # (α, β) dataSem$state) = (evaluate (xs,s) :(v list, v) result option # (α, β) dataSem$state)
set_vars_clock_replay_typed=(set_vars (ns :num list) (vs :v list) (s :(α, β) dataSem$state)).clock = s.clock
cut_state_opt_with_swap_replay_typed=cut_state_opt (names_opt :sptree$num_set option) ((s :(α, β) dataSem$state) with <|stack_max := (smx :num option); safe_for_space := (safe :bool); peak_heap_length := (peak :num)|>) = OPTION_MAP (λ(t :(α, β) dataSem$state). t with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) (cut_state_opt names_opt s)
cut_state_opt_stack_max_replay_typed=cut_state_opt (names_opt :sptree$num_set option) (s :(α, β) dataSem$state) = SOME (s2 :(α, β) dataSem$state) ⇒ s2.stack_max = s.stack_max
cut_state_opt_swap_input_replay_typed=cut_state_opt (names_opt :sptree$num_set option) (s :(α, β) dataSem$state) = SOME (s2 :(α, β) dataSem$state) ⇒ s2 with <|stack_max := s.stack_max; safe_for_space := (safe :bool); peak_heap_length := (peak :num)|> = s2 with <|safe_for_space := safe; peak_heap_length := peak|>
evaluate_safe_peak_swap_aux_typed=∀(safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ (let (s0 :(α, β) dataSem$state) = s with <|stack_max := s.stack_max; safe_for_space := safe; peak_heap_length := peak|> in ∃(safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := s'.stack_max; safe_for_space := safe; peak_heap_length := peak|>))
evaluate_smx_safe_peak_swap_aux_typed=∀(smx :num option) (safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ (let (s0 :(α, β) dataSem$state) = s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|> in ∃(smx :num option) (safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>))
evaluate_fl_smx_safe_peak_swap_aux_replay_typed=∀(c :dataLang$prog) (s :(α, β) dataSem$state) (r :(v list, v) result option) (s' :(α, β) dataSem$state) (fl :bool) (smx :num option) (safe :bool) (peak :num). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ if fl then (let (s0 :(α, β) dataSem$state) = s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|> in ∃(smx :num option) (safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>)) else (let (s0 :(α, β) dataSem$state) = s with <|stack_max := s.stack_max; safe_for_space := safe; peak_heap_length := peak|> in ∃(smx :γ) (safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := s'.stack_max; safe_for_space := safe; peak_heap_length := peak|>))
