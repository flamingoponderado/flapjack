load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory labSemTheory sptreeTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "get_shmem_info_APPEND" get_shmem_info_APPEND;
val _=types "get_shmem_info_APPEND_types" get_shmem_info_APPEND;
val _=print("get_shmem_info_APPEND_hypotheses="^Int.toString(length(hyp get_shmem_info_APPEND))^"\n");
val _=capture "get_shmem_info_PREPEND" get_shmem_info_PREPEND;
val _=types "get_shmem_info_PREPEND_types" get_shmem_info_PREPEND;
val _=print("get_shmem_info_PREPEND_hypotheses="^Int.toString(length(hyp get_shmem_info_PREPEND))^"\n");
val _=show_types:=false;
fun observe label q=(print(label^"=");print_term(rconc(EVAL q));print"\n");
val code=``[Section 0 [];Section 1 [Label 1 7 99;Asm (ShareMem Load8 3 (Addr 2 5w)) [] 0;Asm (Cbw 1 2) [0w;0w] 42;LabAsm (Jump(Lab 1 7)) 99w [0w] 10;Asm (ShareMem Store8 4 (Addr 2 (-1w))) [0w;0w] 2]]:8 sec list``;
val initial=``<|entry_pc:=100;nbytes:=3w;addr_reg:=99;addr_off:=42;reg:=77;exit_pc:=103|>``;
val names=``[SharedMem MappedWrite]``;
val result=``get_shmem_info ^code 7 ^names [^initial]``;
val _=observe "invalid_code_output" ``^result=([SharedMem MappedWrite;SharedMem MappedRead;SharedMem MappedWrite],[^initial;<|entry_pc:=7;nbytes:=1w;addr_reg:=2;addr_off:=5;reg:=3;exit_pc:=7|>;<|entry_pc:=10;nbytes:=1w;addr_reg:=2;addr_off:=255;reg:=4;exit_pc:=12|>])``;
val _=observe "prepend_names" ``FST ^result=^names++FST(get_shmem_info ^code 7 [] [])``;
val _=observe "prepend_info" ``SND ^result=[^initial]++SND(get_shmem_info ^code 7 [] [])``;
val _=observe "append_split" ``get_shmem_info ^code 7 (^names++[ExtCall (strlit "guest")]) ([^initial]++[^initial])=(^names++FST(get_shmem_info ^code 7 [ExtCall(strlit "guest")] [^initial]),[^initial]++SND(get_shmem_info ^code 7 [ExtCall(strlit "guest")] [^initial]))``;
val _=observe "empty" ``get_shmem_info ([]:8 sec list) 1000 ^names [^initial]=(^names,[^initial])``;
val wide=``[Section 1 [Label 1 7 99;Asm (ShareMem Load8 3 (Addr 2 5w)) [] 0;Asm(Cbw 1 2)[0w;0w]42;LabAsm(Jump(Lab 1 7))99w[0w]10;Asm(ShareMem Store8 4 (Addr 2 (-1w)))[0w;0w]2]]:80 sec list``;
val _=observe "wide_offsets" ``MAP (λr.r.addr_off) (SND(get_shmem_info ^wide 1000 [] []))=[5;1208925819614629174706175]``;
val one=``[Section 1 [Label 1 7 99;Asm(ShareMem Load8 3 (Addr 2 5w))[]0;Asm(Cbw 1 2)[0w;0w]42;LabAsm(Jump(Lab 1 7))99w[0w]10;Asm(ShareMem Store8 4 (Addr 2 (-1w)))[0w;0w]2]]:1 sec list``;
val _=observe "one_offsets" ``MAP (λr.r.addr_off) (SND(get_shmem_info ^one 7 [] []))=[1;1]``;
