EVERY_label_zero_add_nop=∀(xs :α line list).
  EVERY (label_zero :α line -> bool) (add_nop (nop :word8 list) xs) ⇔
  EVERY (label_zero :α line -> bool) xs
EVERY_label_zero_add_nop_types=(xs :α line list)::α line list;(nop :word8 list)::word8 list;
EVERY_label_zero_pad_section=∀(nop :word8 list) (xs :α line list) (aux :α line list).
  EVERY (label_zero :α line -> bool) aux ⇒
  EVERY (label_zero :α line -> bool) (pad_section nop xs aux)
EVERY_label_zero_pad_section_types=(nop :word8 list)::word8 list;(xs :α line list)::α line list;(aux :α line list)::α line list;
EVERY_sec_label_zero_pad_code=∀(nop :word8 list) (ls :α sec list).
  EVERY (sec_label_zero :α sec -> bool) (pad_code nop ls)
EVERY_sec_label_zero_pad_code_types=(nop :word8 list)::word8 list;(ls :α sec list)::α sec list;
enc_lines_again_simp_label_zero=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (ls :α line list) (res :α line list)
    (ok :bool).
  enc_lines_again_simp labs ffis pos enc ls = (res,ok) ∧
  EVERY (label_zero :α line -> bool) ls ⇒
  EVERY (label_zero :α line -> bool) res
enc_lines_again_simp_label_zero_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(ls :α line list)::α line list;(res :α line list)::α line list;(ok :bool)::bool;
enc_secs_again_label_zero=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (enc :α asm -> word8 list) (lines :α sec list) (res :α sec list)
    (ok :bool).
  enc_secs_again pos labs ffis enc lines = (res,ok) ∧
  EVERY (sec_label_zero :α sec -> bool) lines ⇒
  EVERY (sec_label_zero :α sec -> bool) res
enc_secs_again_label_zero_types=(pos :num)::num;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α sec list)::α sec list;(res :α sec list)::α sec list;(ok :bool)::bool;
