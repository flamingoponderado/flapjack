compile_correct_full_statement=∀p s res s' ctxt. evaluate (p,s) = (res,s') ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ struct_infos_ok s.structs ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ res ≠ SOME Error ⇒ evaluate (compile ctxt p,convert_s ctxt s) = (convert_res res,convert_s ctxt s') ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.locals ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s'.globals ∧ (is_cont_res res ⇒ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s'.locals) ∧ EVERY (v_flds_ok s'.structs) (res_vs res) ∧ EVERY (is_wf_shape_v s'.structs) (res_vs res)
compile_correct_full_proved=T
compile_correct_primitive_statement=∀v pop es s res s' ctxt. evaluate (Primitive v pop es,s) = (res,s') ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ struct_infos_ok s.structs ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ res ≠ SOME Error ⇒ evaluate (compile ctxt (Primitive v pop es),convert_s ctxt s) = (convert_res res,convert_s ctxt s') ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.locals ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s'.globals ∧ (is_cont_res res ⇒ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s'.locals) ∧ EVERY (v_flds_ok s'.structs) (res_vs res) ∧ EVERY (is_wf_shape_v s'.structs) (res_vs res)
compile_correct_primitive_proved=T
compile_correct_full_types=p::α panLang$prog;s::(α, β) state;res::α result option;s'::(α, β) state;ctxt::context
compile_correct_primitive_types=v::mlstring;pop::primop;es::α panLang$exp list;s::(α, β) state;res::α result option;s'::(α, β) state;ctxt::context
