consume_space_with_stack_typed=consume_space (x :num) ((y :(α, β) dataSem$state) with stack := (z :stack list)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with stack := z) (consume_space x y)
consume_space_with_locals_typed=consume_space (x :num) ((y :(α, β) dataSem$state) with locals := (z :v sptree$num_map)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with locals := z) (consume_space x y)
cut_state_opt_with_swap_typed=cut_state_opt (names_opt :sptree$num_set option) ((s :(α, β) dataSem$state) with <|stack_max := (smx :num option); safe_for_space := (safe :bool); peak_heap_length := (peak :num)|>) = OPTION_MAP (λ(t :(α, β) dataSem$state). t with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) (cut_state_opt names_opt s)
cut_state_opt_stack_max_typed=cut_state_opt (names_opt :sptree$num_set option) (s :(α, β) dataSem$state) = SOME (s2 :(α, β) dataSem$state) ⇒ s2.stack_max = s.stack_max
cut_state_opt_swap_input_typed=cut_state_opt (names_opt :sptree$num_set option) (s :(α, β) dataSem$state) = SOME (s2 :(α, β) dataSem$state) ⇒ s2 with <|stack_max := s.stack_max; safe_for_space := (safe :bool); peak_heap_length := (peak :num)|> = s2 with <|safe_for_space := safe; peak_heap_length := peak|>
evaluate_fl_smx_safe_peak_swap_aux_typed=∀(c :dataLang$prog) (s :(α, β) dataSem$state) (r :(v list, v) result option) (s' :(α, β) dataSem$state) (fl :bool) (smx :num option) (safe :bool) (peak :num). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ if fl then (let (s0 :(α, β) dataSem$state) = s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|> in ∃(smx :num option) (safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>)) else (let (s0 :(α, β) dataSem$state) = s with <|stack_max := s.stack_max; safe_for_space := safe; peak_heap_length := peak|> in ∃(smx :γ) (safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := s'.stack_max; safe_for_space := safe; peak_heap_length := peak|>))
