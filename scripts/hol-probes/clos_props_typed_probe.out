with_same_clock_typed=(s :(γ, 'ffi) state) with clock := s.clock = s
dec_clock_code_typed=(dec_clock (x :num) (y :(α, β) state)).code = y.code
dec_clock_ffi_typed=(dec_clock (x :num) (y :(β, α) state)).ffi = y.ffi
dec_clock_compile_oracle_typed=(dec_clock (n :num) (s :(α, β) state)).compile_oracle = s.compile_oracle
dec_clock_compile_typed=(dec_clock (n :num) (s :(α, β) state)).compile = s.compile
list_to_v_EVERY_APPEND_typed=∀(x :v) (y :v) (xs :v list) (ys :v list). v_to_list x = SOME xs ∧ v_to_list y = SOME ys ∧ (∀(t :num) (l :v list). (P :v -> bool) (Block t l) ⇔ EVERY P l) ∧ P x ∧ P y ⇒ P (list_to_v (xs ++ ys))
forall_sum_typed=(∀(x :α + β). (P :α + β -> bool) x) ⇔ (∀(a :α). P (INL a :α + β)) ∧ ∀(b :β). P (INR b :α + β)
evaluate_better_ind_typed=(∀(xs :closLang$exp list) (s1 :(γ, 'ffi) state). (∀(ys :closLang$exp list) (s2 :(γ, 'ffi) state). s2.clock ≤ s1.clock ∧ (s2.clock = s1.clock ⇒ exp3_alt_size ys < exp3_alt_size xs) ⇒ (P1 :closLang$exp list -> (γ, 'ffi) state -> bool) ys s2) ⇒ (∀(args :v list) (s2 :(γ, 'ffi) state). s2.clock ≤ s1.clock ∧ (s2.clock = s1.clock ⇒ LENGTH args < exp3_alt_size xs) ⇒ (P2 :v list -> (γ, 'ffi) state -> bool) args s2) ⇒ P1 xs s1) ∧ (∀(args :v list) (s1 :(γ, 'ffi) state). (∀(ys :closLang$exp list) (s2 :(γ, 'ffi) state). s2.clock ≤ s1.clock ∧ (s2.clock = s1.clock ⇒ exp3_alt_size ys < LENGTH args) ⇒ P1 ys s2) ⇒ (∀(args' :v list) (s2 :(γ, 'ffi) state). s2.clock ≤ s1.clock ∧ (s2.clock = s1.clock ⇒ LENGTH args' < LENGTH args) ⇒ P2 args' s2) ⇒ P2 args s1) ⇒ (∀(xs :closLang$exp list) (s1 :(γ, 'ffi) state). P1 xs s1) ∧ ∀(args :v list) (s1 :(γ, 'ffi) state). P2 args s1
ref_rel_simp_typed=(ref_rel (R :α -> β -> bool) (ValueArray (vs :α list)) (y :β ref) ⇔ ∃(ws :β list). y = ValueArray ws ∧ LIST_REL R vs ws) ∧ (ref_rel R (ByteArray (bs :word8 list) :α ref) y ⇔ y = (ByteArray bs :β ref)) ∧ (ref_rel R (Thunk (m :thunk_mode) (a :α) :α ref) y ⇔ ∃(b :β). y = (Thunk m b :β ref) ∧ R a b)
code_locs_cons_typed=∀(x :closLang$exp) (xs :closLang$exp list). code_locs (x::xs) = code_locs [x] ++ code_locs xs
code_locs_map_typed=∀(xs :α list) (f :α -> closLang$exp). code_locs (MAP f xs) = FLAT (MAP (λ(x :α). code_locs [f x]) xs)
BIGUNION_MAP_code_locs_SND_SND_typed=BIGUNION (set (MAP ((set :num list -> num -> bool) ∘ code_locs ∘ (λ(x :α # β # closLang$exp). [SND (SND x)])) (xs :(α # β # closLang$exp) list))) = set (code_locs (MAP ((SND :β # closLang$exp -> closLang$exp) ∘ (SND :α # β # closLang$exp -> β # closLang$exp)) xs))
contains_App_SOME_EXISTS_typed=∀(ls :closLang$exp list) (max_app :num). contains_App_SOME max_app ls ⇔ EXISTS (λ(x :closLang$exp). contains_App_SOME max_app [x]) ls
every_Fn_SOME_APPEND_typed=every_Fn_SOME ((l1 :closLang$exp list) ++ (l2 :closLang$exp list)) ⇔ every_Fn_SOME l1 ∧ every_Fn_SOME l2
IMP_every_Fn_vs_NONE_TAKE_typed=every_Fn_vs_NONE (ls :closLang$exp list) ⇒ every_Fn_vs_NONE (TAKE (n :num) ls)
every_Fn_vs_NONE_APPEND_typed=every_Fn_vs_NONE ((l1 :closLang$exp list) ++ (l2 :closLang$exp list)) ⇔ every_Fn_vs_NONE l1 ∧ every_Fn_vs_NONE l2
every_Fn_vs_SOME_APPEND_typed=every_Fn_vs_SOME ((l1 :closLang$exp list) ++ (l2 :closLang$exp list)) ⇔ every_Fn_vs_SOME l1 ∧ every_Fn_vs_SOME l2
exp3_size_typed=exp3_size (xs :closLang$exp list) = LENGTH xs + (SUM (MAP exp_size xs) :num)
exp1_size_rw_typed=exp1_size (fbinds :(num # closLang$exp) list) = exp3_size (MAP (SND :num # closLang$exp -> closLang$exp) fbinds) + (SUM (MAP (FST :num # closLang$exp -> num) fbinds) :num) + LENGTH fbinds
fv_nil_typed=fv (v :num) ([] :closLang$exp list) ⇔ F
fv1_intro_typed=∀(v :num) (e :closLang$exp). fv v [e] ⇔ fv1 v e
fv1_thm_typed=(∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp) (n :num). fv n (x::y::xs) ⇔ fv1 n x ∨ fv n (y::xs)) ∧ (∀(v0 :tra) (v :num) (n :num). fv1 n (Var v0 v :closLang$exp) ⇔ n = v) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (v1 :tra) (n :num). fv1 n (If v1 x1 x2 x3 :closLang$exp) ⇔ fv1 n x1 ∨ fv1 n x2 ∨ fv1 n x3) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (v2 :tra) (n :num). fv1 n (Let v2 xs x2 :closLang$exp) ⇔ fv n xs ∨ fv1 (n + LENGTH xs) x2) ∧ (∀(x1 :closLang$exp) (v3 :tra) (n :num). fv1 n (Raise v3 x1 :closLang$exp) ⇔ fv1 n x1) ∧ (∀(x1 :closLang$exp) (v4 :tra) (n :num). fv1 n (Tick v4 x1) ⇔ fv1 n x1) ∧ (∀(xs :closLang$exp list) (v5 :tra) (op :closLang$op) (n :num). fv1 n (Op v5 op xs) ⇔ fv n xs) ∧ (∀(x2 :closLang$exp list) (x1 :closLang$exp) (v6 :tra) (n :num) (loc_opt :num option). fv1 n (App v6 loc_opt x1 x2 :closLang$exp) ⇔ fv1 n x1 ∨ fv n x2) ∧ (∀(x1 :closLang$exp) (vs :num list option) (v7 :mlstring) (num_args :num) (n :num) (loc :num option). fv1 n (Fn v7 loc vs num_args x1) ⇔ fv1 (n + num_args) x1) ∧ (∀(x1 :closLang$exp) (vs :num list option) (v8 :mlstring list) (n :num) (loc :num option) (fns :(num # closLang$exp) list). fv1 n (Letrec v8 loc vs fns x1 :closLang$exp) ⇔ EXISTS (λ((num_args :num),(x :closLang$exp)). fv1 (n + num_args + LENGTH fns) x) fns ∨ fv1 (n + LENGTH fns) x1) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (v9 :tra) (n :num). fv1 n (Handle v9 x1 x2 :closLang$exp) ⇔ fv1 n x1 ∨ fv1 (n + (1 :num)) x2) ∧ ∀(xs :closLang$exp list) (v10 :tra) (ticks :num) (n :num) (dest :num). fv1 n (Call v10 ticks dest xs) ⇔ fv n xs
fv_cons_typed=fv (v :num) ((x :closLang$exp)::(xs :closLang$exp list)) ⇔ fv1 v x ∨ fv v xs
fv_exists_typed=∀(ls :closLang$exp list). fv (v :num) ls ⇔ EXISTS (fv1 v) ls
fv_MAPi_typed=∀(l :α list) (x :num) (f :num -> α -> closLang$exp). fv x (MAPi f l) ⇔ ∃(n :num). n < LENGTH l ∧ fv x [f n l❲n❳]
fv_GENLIST_Var_typed=∀(n :num). fv (v :num) (GENLIST (Var (tra :tra) :num -> closLang$exp) n) ⇔ v < n
fv_REPLICATE_typed=fv (n :num) (REPLICATE (m :num) (e :closLang$exp)) ⇔ (0 :num) < m ∧ fv1 n e
v_ind_typed=∀(P :v -> bool). (∀(i :int). P (Number i)) ∧ (∀(c :word64). P (Word64 c :v)) ∧ (∀(l :v list). EVERY P l ⇒ ∀(n :num). P (Block n l)) ∧ (∀(l :word8 list). P (ByteVector l)) ∧ (∀(b :bool) (n :num). P (RefPtr b n)) ∧ (∀(l :v list) (l0 :v list). EVERY P l ∧ EVERY P l0 ⇒ ∀(e :closLang$exp) (n :num) ($o :num option). P (Closure $o l l0 n e :v)) ∧ (∀(l :v list) (l0 :v list). EVERY P l ∧ EVERY P l0 ⇒ ∀(n :num) (l1 :(num # closLang$exp) list) ($o :num option). P (Recclosure $o l l0 l1 n :v)) ⇒ ∀(v :v). P v
do_app_err_typed=∀(op :closLang$op) (ls :v list) (s :(α, β) state) (e :v error_result). (do_app op ls s :(v # (α, β) state, v) result) = (Rerr e :(v # (α, β) state, v) result) ⇒ op ≠ BlockOp Equal ⇒ ∃(a :abort). e = (Rabort a :v error_result)
Boolv_11_typed=(Boolv (b1 :bool) :v) = (Boolv (b2 :bool) :v) ⇔ (b1 ⇔ b2)
evaluate_LENGTH_typed=(∀(p_1 :closLang$exp list) (p_1' :v list) (p_2 :(γ, 'ffi) state). case evaluate (p_1,p_1',p_2) of ((Rval res :(v list, v) result),s1) => LENGTH p_1 = LENGTH res | ((Rerr v7 :(v list, v) result),s1) => T) ∧ ∀(v0 :num option) (v1 :v) (v2 :v list) (v3 :(γ, 'ffi) state). case evaluate_app v0 v1 v2 v3 of ((Rval res :(v list, v) result),s1) => LENGTH res = (1 :num) | ((Rerr v7 :(v list, v) result),s1) => T
evaluate_app_IMP_LENGTH_typed=evaluate_app (x1 :num option) (x2 :v) (x3 :v list) (x4 :(α, β) state) = ((Rval (res :v list) :(v list, v) result),(s1 :(α, β) state)) ⇒ LENGTH res = (1 :num)
do_install_const_typed=do_install (vs :v list) (s :(α, β) state) = ((res :(closLang$exp list, v) result),(s' :(α, β) state)) ⇒ s'.max_app = s.max_app ∧ s'.ffi = s.ffi
evaluate_const_typed=evaluate ((xs :closLang$exp list),(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s1 :(α, β) state)) ⇒ s1.max_app = s.max_app
evaluate_app_const_typed=evaluate_app (x1 :num option) (x2 :v) (x3 :v list) (x4 :(α, β) state) = ((res :(v list, v) result),(s1 :(α, β) state)) ⇒ s1.max_app = x4.max_app
evaluate_code_typed=evaluate ((xs :closLang$exp list),(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s1 :(α, β) state)) ⇒ ∃(n :num). s1.compile_oracle = shift_seq n s.compile_oracle ∧ (let (ls :(num # num # closLang$exp) list) = FLAT (MAP ((SND :closLang$exp list # (num # num # closLang$exp) list -> (num # num # closLang$exp) list) ∘ (SND :α # closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list)) (GENLIST s.compile_oracle n)) in s1.code = s.code |++ ls ∧ ALL_DISTINCT (MAP (FST :num # num # closLang$exp -> num) ls) ∧ DISJOINT (FDOM s.code) (set (MAP (FST :num # num # closLang$exp -> num) ls)))
evaluate_app_code_typed=evaluate_app (lopt :num option) (f :v) (args :v list) (s :(α, β) state) = ((res :(v list, v) result),(s1 :(α, β) state)) ⇒ ∃(n :num). s1.compile_oracle = shift_seq n s.compile_oracle ∧ (let (ls :(num # num # closLang$exp) list) = FLAT (MAP ((SND :closLang$exp list # (num # num # closLang$exp) list -> (num # num # closLang$exp) list) ∘ (SND :α # closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list)) (GENLIST s.compile_oracle n)) in s1.code = s.code |++ ls ∧ ALL_DISTINCT (MAP (FST :num # num # closLang$exp -> num) ls) ∧ DISJOINT (FDOM s.code) (set (MAP (FST :num # num # closLang$exp -> num) ls)))
evaluate_MAP_Op_Const_typed=∀(f :α -> int) (env :v list) (s :(β, γ) state) (ls :α list). evaluate (MAP (λ(x :α). Op (tra :tra) (IntOp (Const (f x))) ([] :closLang$exp list)) ls,env,s) = ((Rval (MAP (Number ∘ f) ls) :(v list, v) result),s)
lookup_vars_NONE_typed=∀(vs :num list). lookup_vars vs (env :α list) = (NONE :α list option) ⇔ ∃(v :num). MEM v vs ∧ LENGTH env ≤ v
lookup_vars_SOME_typed=∀(vs :num list) (env :α list) (xs :α list). lookup_vars vs env = SOME xs ⇒ LENGTH vs = LENGTH xs
lookup_vars_MEM_typed=lookup_vars (ys :num list) (env2 :v list) = SOME (x :v list) ∧ (n :num) < LENGTH ys ⇒ ys❲n❳ < LENGTH env2 ∧ x❲n❳ = env2❲ys❲n❳❳
clock_lemmas_typed=∀(s :(α, β) state). s with clock := s.clock = s
evaluate_app_rw_typed=∀(args :v list) (loc_opt :num option) (f :v) (s :(α, β) state). args ≠ ([] :v list) ⇒ evaluate_app loc_opt f args s = case dest_closure s.max_app loc_opt f args of (NONE :app_kind option) => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME (Partial_app v) => if s.clock < LENGTH args then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with clock := (0 :num)) else ((Rval [v] :(v list, v) result),dec_clock (LENGTH args) s) | SOME (Full_app exp env rest_args) => if s.clock < LENGTH args − LENGTH rest_args then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with clock := (0 :num)) else case evaluate ([exp],env,dec_clock (LENGTH args − LENGTH rest_args) s) of ((Rval ([] :v list) :(v list, v) result),s1) => ((Rval ([] :v list) :(v list, v) result),s1) | ((Rval [v] :(v list, v) result),s1) => evaluate_app loc_opt v rest_args s1 | ((Rval (v::v15::v16) :(v list, v) result),s1) => ((Rval (v::v15::v16) :(v list, v) result),s1) | ((Rerr v8 :(v list, v) result),s1) => ((Rerr v8 :(v list, v) result),s1)
pure_correct_typed=pure (e :closLang$exp) ⇒ case evaluate ([e],(env :v list),(s :(γ, 'ffi) state)) of ((Rval vs :(v list, v) result),s') => s' = s ∧ LENGTH vs = (1 :num) | ((Rerr (Rraise a) :(v list, v) result),s') => F | ((Rerr (Rabort a'' :v error_result) :(v list, v) result),s') => a'' = Rtype_error
pair_lam_lem_typed=∀(f :α -> β -> γ) (v :γ) (z :α # β). (let ((x :α),(y :β)) = z in f x y) = v ⇔ ∃(x1 :α) (x2 :β). z = (x1,x2) ∧ f x1 x2 = v
do_app_split_list_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (res :(v # (α, β) state, v) result) ⇔ vs = ([] :v list) ∧ (do_app op ([] :v list) s :(v # (α, β) state, v) result) = res ∨ ∃(v :v) (vs1 :v list). vs = v::vs1 ∧ (do_app op (v::vs1) s :(v # (α, β) state, v) result) = res
is_closure_def_typed=(is_closure (Closure (v0 :num option) (v1 :v list) (v2 :v list) (v3 :num) (v4 :closLang$exp) :v) ⇔ T) ∧ (is_closure (Recclosure (v5 :num option) (v6 :v list) (v7 :v list) (v8 :(num # closLang$exp) list) (v9 :num) :v) ⇔ T) ∧ (is_closure (Number (v :int)) ⇔ F) ∧ (is_closure (Word64 (v11 :word64) :v) ⇔ F) ∧ (is_closure (Block (v12 :num) (v13 :v list)) ⇔ F) ∧ (is_closure (ByteVector (v14 :word8 list)) ⇔ F) ∧ (is_closure (RefPtr (v15 :bool) (v16 :num)) ⇔ F)
clo_to_loc_def_typed=(∀(l :num option) (v0 :v list) (v1 :v list) (v2 :num) (v3 :closLang$exp). clo_to_loc (Closure l v0 v1 v2 v3 :v) = l) ∧ ∀(l :num option) (v4 :v list) (v5 :v list) (v6 :(num # closLang$exp) list) (i :num). clo_to_loc (Recclosure l v4 v5 v6 i :v) = OPTION_MAP ($+ ((2 :num) * i)) l
clo_to_env_def_typed=(∀(v0 :num option) (v1 :v list) (env :v list) (v2 :num) (v3 :closLang$exp). clo_to_env (Closure v0 v1 env v2 v3 :v) = env) ∧ ∀(loc :num option) (v4 :v list) (env :v list) (fns :(num # closLang$exp) list) (v5 :num). clo_to_env (Recclosure loc v4 env fns v5 :v) = GENLIST (Recclosure loc ([] :v list) env fns :num -> v) (LENGTH fns) ++ env
clo_to_partial_args_def_typed=(∀(v0 :num option) (args :v list) (v1 :v list) (v2 :num) (v3 :closLang$exp). clo_to_partial_args (Closure v0 args v1 v2 v3 :v) = args) ∧ ∀(v4 :num option) (args :v list) (v5 :v list) (v6 :(num # closLang$exp) list) (v7 :num). clo_to_partial_args (Recclosure v4 args v5 v6 v7 :v) = args
clo_add_partial_args_def_typed=(∀(args :v list) (x1 :num option) (args' :v list) (x2 :v list) (x3 :num) (x4 :closLang$exp). clo_add_partial_args args (Closure x1 args' x2 x3 x4 :v) = (Closure x1 (args ++ args') x2 x3 x4 :v)) ∧ ∀(args :v list) (x1 :num option) (args' :v list) (x2 :v list) (x3 :(num # closLang$exp) list) (x4 :num). clo_add_partial_args args (Recclosure x1 args' x2 x3 x4 :v) = (Recclosure x1 (args ++ args') x2 x3 x4 :v)
clo_to_num_params_def_typed=(∀(v0 :num option) (v1 :v list) (v2 :v list) (n :num) (v3 :closLang$exp). clo_to_num_params (Closure v0 v1 v2 n v3 :v) = n) ∧ ∀(v4 :num option) (v5 :v list) (v6 :v list) (fns :(num # closLang$exp) list) (i :num). clo_to_num_params (Recclosure v4 v5 v6 fns i :v) = FST fns❲i❳
rec_clo_ok_def_typed=(∀(v0 :num option) (v1 :v list) (v2 :v list) (fns :(num # closLang$exp) list) (i :num). rec_clo_ok (Recclosure v0 v1 v2 fns i :v) ⇔ i < LENGTH fns) ∧ ∀(v3 :num option) (v4 :v list) (v5 :v list) (v6 :num) (v7 :closLang$exp). rec_clo_ok (Closure v3 v4 v5 v6 v7 :v) ⇔ T
dest_closure_full_length_typed=∀(max_app :num) (l :num option) (v :v) (vs :v list) (e :closLang$exp) (args :v list) (rest :v list). dest_closure max_app l v vs = SOME (Full_app e args rest) ⇒ LENGTH (clo_to_partial_args v) < clo_to_num_params v ∧ LENGTH vs + LENGTH (clo_to_partial_args v) = clo_to_num_params v + LENGTH rest ∧ LENGTH args = clo_to_num_params v + LENGTH (clo_to_env v)
evaluate_app_clock_less_typed=∀(loc_opt :num option) (f :v) (args :v list) (s1 :(α, β) state) (vs :v list) (s2 :(α, β) state). args ≠ ([] :v list) ∧ evaluate_app loc_opt f args s1 = ((Rval vs :(v list, v) result),s2) ⇒ s2.clock < s1.clock
clo_add_partial_args_nil_typed=∀(x :v). is_closure x ⇒ clo_add_partial_args ([] :v list) x = x
clo_can_apply_def_typed=∀(loc :num option) (cl :v) (num_args :num). clo_can_apply loc cl num_args ⇔ LENGTH (clo_to_partial_args cl) < clo_to_num_params cl ∧ rec_clo_ok cl ∧ (loc ≠ (NONE :num option) ⇒ loc = clo_to_loc cl ∧ num_args = clo_to_num_params cl ∧ clo_to_partial_args cl = ([] :v list))
check_closures_def_typed=∀(cl :v) (cl' :v). check_closures cl cl' ⇔ ∀(loc :num option) (num_args :num). clo_can_apply loc cl num_args ⇒ clo_can_apply loc cl' num_args
dest_closure_partial_is_closure_typed=dest_closure (max_app :num) (l :num option) (v :v) (vs :v list) = SOME (Partial_app (v' :v)) ⇒ is_closure v'
is_closure_add_partial_args_nil_typed=is_closure (v :v) ⇒ clo_add_partial_args ([] :v list) v = v
evaluate_app_clock0_typed=(s0 :(α, β) state).clock = (0 :num) ∧ (args :v list) ≠ ([] :v list) ⇒ evaluate_app (lopt :num option) (r :v) args s0 ≠ ((Rval (vs :v list) :(v list, v) result),(s :(α, β) state))
evaluate_app_clock0_timeout_typed=(s0 :(α, β) state).clock = (0 :num) ∧ (args :v list) ≠ ([] :v list) ∧ evaluate_app (lopt :num option) (r :v) args s0 = ((Rerr (e :v error_result) :(v list, v) result),(s :(α, β) state)) ∧ e ≠ (Rabort Rtype_error :v error_result) ⇒ e = (Rabort Rtimeout_error :v error_result)
evaluate_app_clock_drop_typed=∀(args :v list) (f :v) (lopt :num option) (s0 :(α, β) state) (s :(α, β) state) (vs :v list). evaluate_app lopt f args s0 = ((Rval vs :(v list, v) result),s) ⇒ s.clock + LENGTH args ≤ s0.clock
dest_closure_is_closure_typed=dest_closure (max_app :num) (lopt :num option) (f :v) (vs :v list) = SOME (r :app_kind) ⇒ is_closure f
stage_partial_app_typed=is_closure (c :v) ∧ dest_closure (max_app :num) (NONE :num option) (v :v) ((rest :v list) ++ (used :v list)) = SOME (Partial_app (clo_add_partial_args rest c)) ⇒ dest_closure max_app (NONE :num option) c rest = SOME (Partial_app (clo_add_partial_args rest c))
dest_closure_full_addargs_typed=dest_closure (max_app :num) (NONE :num option) (c :v) (vs :v list) = SOME (Full_app (b :closLang$exp) (env :v list) (r :v list)) ∧ LENGTH (more :v list) + LENGTH vs ≤ max_app ⇒ dest_closure max_app (NONE :num option) c (more ++ vs) = SOME (Full_app b env (more ++ r))
evaluate_append_typed=∀(es1 :closLang$exp list) (es2 :closLang$exp list) (env :v list) (s :(α, β) state). evaluate (es1 ++ es2,env,s) = case evaluate (es1,env,s) of ((Rval vs1 :(v list, v) result),s') => (case evaluate (es2,env,s') of ((Rval vs2 :(v list, v) result),s'') => ((Rval (vs1 ++ vs2) :(v list, v) result),s'') | ((Rerr v7 :(v list, v) result),s'') => ((Rerr v7 :(v list, v) result),s'')) | ((Rerr v9 :(v list, v) result),s') => ((Rerr v9 :(v list, v) result),s')
evaluate_GENLIST_Var_typed=∀(n :num) (env :v list) (s :(α, β) state). evaluate (GENLIST (Var (tra :tra) :num -> closLang$exp) n,env,s) = if n ≤ LENGTH env then ((Rval (TAKE n env) :(v list, v) result),s) else ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s)
evaluate_length_imp_typed=evaluate ((es :closLang$exp list),(env :v list),(s1 :(α, β) state)) = ((Rval (vs :v list) :(v list, v) result),(s2 :(α, β) state)) ⇒ LENGTH es = LENGTH vs
evaluate_app_length_imp_typed=evaluate_app (l :num option) (f :v) (args :v list) (s :(α, β) state) = ((Rval (vs :v list) :(v list, v) result),(s2 :(α, β) state)) ⇒ LENGTH vs = (1 :num)
dest_closure_none_append_typed=∀(max_app :num) (l :α) (f :v) (args1 :v list) (args2 :v list). dest_closure max_app (NONE :num option) f args2 = (NONE :app_kind option) ⇒ dest_closure max_app (NONE :num option) f (args1 ++ args2) = (NONE :app_kind option)
dest_closure_none_append2_typed=∀(max_app :num) (l :α) (f :v) (args1 :v list) (args2 :v list). LENGTH args1 + LENGTH args2 ≤ max_app ∧ dest_closure max_app (NONE :num option) f (args1 ++ args2) = (NONE :app_kind option) ⇒ dest_closure max_app (NONE :num option) f args2 = (NONE :app_kind option)
dest_closure_rest_length_typed=dest_closure (max_app :num) (NONE :num option) (f :v) (args :v list) = SOME (Full_app (e :closLang$exp) (l :v list) (rest :v list)) ⇒ LENGTH rest < LENGTH args
dest_closure_partial_twice_typed=∀(max_app :num) (f :v) (args1 :v list) (args2 :v list) (cl :v) (res :app_kind option). LENGTH args1 + LENGTH args2 ≤ max_app ∧ dest_closure max_app (NONE :num option) f (args1 ++ args2) = res ∧ dest_closure max_app (NONE :num option) f args2 = SOME (Partial_app cl) ⇒ dest_closure max_app (NONE :num option) cl args1 = res
evaluate_app_append_typed=∀(args2 :v list) (f :v) (args1 :v list) (s :(α, β) state). LENGTH (args1 ++ args2) ≤ s.max_app ⇒ evaluate_app (NONE :num option) f (args1 ++ args2) s = case evaluate_app (NONE :num option) f args2 s of ((Rval vs1 :(v list, v) result),s1) => evaluate_app (NONE :num option) (HD vs1) args1 s1 | ((Rerr v7 :(v list, v) result),s1) => ((Rerr v7 :(v list, v) result),s1)
revnil_typed=([] :α list) = REVERSE (l :α list) ⇔ l = ([] :α list)
dest_closure_full_maxapp_typed=dest_closure (max_app :num) (NONE :num option) (c :v) (vs :v list) = SOME (Full_app (b :closLang$exp) (env :v list) (r :v list)) ∧ r ≠ ([] :v list) ⇒ LENGTH vs ≤ max_app
dest_closure_full_split_prime_typed=dest_closure (max_app :num) (loc :num option) (v :v) (vs :v list) = SOME (Full_app (e :closLang$exp) (env :v list) (rest :v list)) ⇒ ∃(used :v list). vs = rest ++ used ∧ dest_closure max_app loc v used = SOME (Full_app e env ([] :v list))
dest_closure_partial_split_typed=∀(max_app :num) (v1 :v) (vs :v list) (v2 :v) (n :num). dest_closure max_app (NONE :num option) v1 vs = SOME (Partial_app v2) ∧ n ≤ LENGTH vs ⇒ ∃(v3 :v). dest_closure max_app (NONE :num option) v1 (DROP n vs) = SOME (Partial_app v3) ∧ v2 = clo_add_partial_args (TAKE n vs) v3
dest_closure_partial_split_prime_typed=∀(max_app :num) (n :num) (v :v) (vs :v list) (cl :v). dest_closure max_app (NONE :num option) v vs = SOME (Partial_app cl) ∧ n ≤ LENGTH vs ⇒ ∃(cl0 :v) (used :v list) (rest :v list). vs = rest ++ used ∧ LENGTH rest = n ∧ dest_closure max_app (NONE :num option) v used = SOME (Partial_app cl0) ∧ cl = clo_add_partial_args rest cl0
dest_closure_NONE_Full_to_Partial_typed=dest_closure (max_app :num) (NONE :num option) (v :v) ((l1 :v list) ++ (l2 :v list)) = SOME (Full_app (b :closLang$exp) (env :v list) ([] :v list)) ∧ l1 ≠ ([] :v list) ⇒ ∃(cl :v). dest_closure max_app (NONE :num option) v l2 = SOME (Partial_app cl) ∧ dest_closure max_app (NONE :num option) cl l1 = SOME (Full_app b env ([] :v list))
dec_clock_with_clock_typed=dec_clock (n :num) (s :(α, β) state) with clock := (y :num) = s with clock := y
do_app_ffi_error_IMP_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (Rabort (Rffi_error (f :final_event)) :v error_result) :(v # (α, β) state, v) result) ⇒ ∃(i :mlstring). op = (FFI i :closLang$op)
do_app_add_to_clock_typed=(do_app (op :closLang$op) (vs :v list) ((s :(α, β) state) with clock := s.clock + (extra :num)) :(v # (α, β) state, v) result) = map_result (λ((v :v),(s :(α, β) state)). (v,s with clock := s.clock + extra)) (I :v -> v) (do_app op vs s :(v # (α, β) state, v) result)
do_install_add_to_clock_typed=do_install (vs :v list) (s :(α, β) state) = ((Rval (e :closLang$exp list) :(closLang$exp list, v) result),(s' :(α, β) state)) ⇒ do_install vs (s with clock := s.clock + (extra :num)) = ((Rval e :(closLang$exp list, v) result),s' with clock := s'.clock + extra)
do_install_type_error_add_to_clock_typed=do_install (vs :v list) (s :(α, β) state) = ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),(t :(α, β) state)) ⇒ do_install vs (s with clock := s.clock + (extra :num)) = ((Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result),t with clock := t.clock + extra)
do_install_not_Rraise_typed=do_install (vs :v list) (s :(α, β) state) = ((res :(closLang$exp list, v) result),(t :(α, β) state)) ⇒ res ≠ (Rerr (Rraise (r :v)) :(closLang$exp list, v) result)
do_install_not_Rffi_error_typed=do_install (vs :v list) (s :(α, β) state) = ((res :(closLang$exp list, v) result),(t :(α, β) state)) ⇒ res ≠ (Rerr (Rabort (Rffi_error (f :final_event)) :v error_result) :(closLang$exp list, v) result)
evaluate_add_clock_initial_state_typed=evaluate ((es :closLang$exp list),(env :v list),initial_state (ffi :β ffi_state) (ma :num) (code :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option) (k :num)) = ((r :(v list, v) result),(s' :(α, β) state)) ∧ r ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ ∀(extra :num). evaluate (es,env,initial_state ffi ma code co cc (k + extra)) = (r,s' with clock := s'.clock + extra)
do_app_io_events_mono_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((v :v),(s' :(α, β) state)) :(v # (α, β) state, v) result) ⇒ s.ffi.io_events ≼ s'.ffi.io_events
evaluate_io_events_mono_typed=(∀(p :closLang$exp list # v list # (γ, 'ffi) state). (SND (SND p)).ffi.io_events ≼ (SND (evaluate p)).ffi.io_events) ∧ ∀(loc_opt :num option) (v :v) (rest :v list) (s :(γ, 'ffi) state). s.ffi.io_events ≼ (SND (evaluate_app loc_opt v rest s)).ffi.io_events
evaluate_io_events_mono_imp_typed=evaluate ((es :closLang$exp list),(env :v list),(s :(α, β) state)) = ((r :(v list, v) result),(s' :(α, β) state)) ⇒ s.ffi.io_events ≼ s'.ffi.io_events
with_clock_ffi_typed=((s :(β, α) state) with clock := (k :num)).ffi = s.ffi
evaluate_add_to_clock_io_events_mono_typed=(∀(p :closLang$exp list # v list # (γ, 'ffi) state) (es :closLang$exp list) (env :v list) (s :(γ, 'ffi) state). p = (es,env,s) ⇒ (SND (evaluate p)).ffi.io_events ≼ (SND (evaluate (es,env,s with clock := s.clock + (extra :num)))).ffi.io_events) ∧ ∀(l :num option) (v :v) (r :v list) (s :(γ, 'ffi) state). (SND (evaluate_app l v r s)).ffi.io_events ≼ (SND (evaluate_app l v r (s with clock := s.clock + extra))).ffi.io_events
do_app_never_timesout_typed=(do_app (op :closLang$op) (args :v list) (s :(α, β) state) :(v # (α, β) state, v) result) ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v # (α, β) state, v) result)
evaluate_timeout_clocks0_typed=(∀(v :closLang$exp list # v list # (γ, 'ffi) state) (s :(γ, 'ffi) state). evaluate v = ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s) ⇒ s.clock = (0 :num)) ∧ ∀(locopt :num option) (v :v) (env :v list) (s :(γ, 'ffi) state) (s' :(γ, 'ffi) state). evaluate_app locopt v env s = ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s') ⇒ s'.clock = (0 :num)
exp_size_MEM_typed=(∀(e :closLang$exp) (elist :closLang$exp list). MEM e elist ⇒ exp_size e < exp3_size elist) ∧ ∀(x :num) (e :closLang$exp) (ealist :(num # closLang$exp) list). MEM (x,e) ealist ⇒ exp_size e < exp1_size ealist
evaluate_eq_nil_typed=evaluate ((es :closLang$exp list),(env :v list),(s0 :(α, β) state)) = ((Rval ([] :v list) :(v list, v) result),(s :(α, β) state)) ⇔ s0 = s ∧ es = ([] :closLang$exp list)
exp2_size_rw_typed=exp2_size (h :num # closLang$exp) = (1 :num) + FST h + exp_size (SND h)
v_size_lemma_typed=MEM (v :v) (vl :v list) ⇒ v_size v < v1_size vl
elglobals_EQ_EMPTY_typed=elist_globals (l :closLang$exp list) = ({||} :num -> num) ⇔ ∀(e :closLang$exp). MEM e l ⇒ set_globals e = ({||} :num -> num)
elist_globals_FOLDR_typed=elist_globals (es :closLang$exp list) = FOLDR ($⊎ :(num -> num) -> (num -> num) -> num -> num) ({||} :num -> num) (MAP set_globals es)
elist_globals_reverse_typed=∀(ls :closLang$exp list). elist_globals (REVERSE ls) = elist_globals ls
isClos_cases_typed=isClos (x :v) ⇔ (∃(x1 :num option) (x2 :v list) (x3 :v list) (x4 :num) (x5 :closLang$exp). x = (Closure x1 x2 x3 x4 x5 :v)) ∨ ∃(y1 :num option) (y2 :v list) (y3 :v list) (y4 :(num # closLang$exp) list) (y5 :num). x = (Recclosure y1 y2 y3 y4 y5 :v)
simple_val_rel_alt_typed=simple_val_rel (vr :v -> v -> bool) ⇔ (∀(x :v) (n :int). vr x (Number n) ⇔ x = Number n) ∧ (∀(x :v) (p :v list) (n :num). vr x (Block n p) ⇔ ∃(xs :v list). x = Block n xs ∧ LIST_REL vr xs p) ∧ (∀(x :v) (p :word64). vr x (Word64 p :v) ⇔ x = (Word64 p :v)) ∧ (∀(x :v) (p :word8 list). vr x (ByteVector p) ⇔ x = ByteVector p) ∧ (∀(x :v) (p :num) (b :bool). vr x (RefPtr b p) ⇔ x = RefPtr b p) ∧ (∀(x5 :closLang$exp) (x4 :num) (x3 :v list) (x2 :v list) (x1 :num option) (x :v). vr x (Closure x1 x2 x3 x4 x5 :v) ⇒ isClos x) ∧ (∀(y5 :num) (y4 :(num # closLang$exp) list) (y3 :v list) (y2 :v list) (y1 :num option) (x :v). vr x (Recclosure y1 y2 y3 y4 y5 :v) ⇒ isClos x) ∧ (∀(b1 :bool) (b2 :bool). vr (Boolv b1 :v) (Boolv b2 :v) ⇔ (b1 ⇔ b2)) ∧ (vr Unit Unit ⇔ T)
simple_state_rel_ffi_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ⇒ s.ffi = t.ffi
simple_state_rel_fdom_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ⇒ FDOM s.refs = FDOM t.refs
simple_state_rel_update_ffi_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ⇒ sr (s with ffi := (f :β ffi_state)) (t with ffi := f)
simple_state_rel_update_bytes_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ⇒ sr (s with refs := s.refs⟨(p :num) ↦ (ByteArray (bs :word8 list) :v ref)⟩) (t with refs := t.refs⟨p ↦ (ByteArray bs :v ref)⟩)
simple_state_rel_update_values_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ∧ LIST_REL vr (xs :v list) (ys :v list) ⇒ sr (s with refs := s.refs⟨(p :num) ↦ ValueArray xs⟩) (t with refs := t.refs⟨p ↦ ValueArray ys⟩)
simple_state_rel_update_thunks_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ∧ vr (v :v) (w :v) ⇒ sr (s with refs := s.refs⟨(p :num) ↦ (Thunk (m :thunk_mode) v :v ref)⟩) (t with refs := t.refs⟨p ↦ (Thunk m w :v ref)⟩)
simple_state_rel_update_globals_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ∧ LIST_REL (OPTREL vr) (xs :v option list) (ys :v option list) ⇒ sr (s with globals := xs) (t with globals := ys)
simple_state_rel_get_global_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ∧ get_global (n :num) t.globals = (x :v option option) ⇒ case x of (NONE :v option option) => get_global n s.globals = (NONE :v option option) | SOME (NONE :v option) => get_global n s.globals = SOME (NONE :v option) | SOME (SOME y) => ∃(x :v). get_global n s.globals = SOME (SOME x) ∧ vr x y
isClos_IMP_v_to_list_NONE_typed=isClos (x :v) ⇒ v_to_list x = (NONE :v list option)
v_rel_to_list_ByteVector_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(lv :v) (x :v). vr x lv ⇒ ∀(wss :word8 list list). v_to_list x = SOME (MAP ByteVector wss) ⇔ v_to_list lv = SOME (MAP ByteVector wss)
v_rel_to_list_byte1_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(y :v) (x :v). vr x y ⇒ ∀(ns :num list). v_to_list x = SOME (MAP (Number ∘ $&) ns) ⇔ v_to_list y = SOME (MAP (Number ∘ $&) ns)
v_rel_to_list_byte2_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(y :v) (x :v). vr x y ⇒ ∀(ns :num list). v_to_list x = SOME (MAP (Number ∘ $&) ns) ∧ EVERY (λ(n :num). n < (256 :num)) ns ⇔ v_to_list y = SOME (MAP (Number ∘ $&) ns) ∧ EVERY (λ(n :num). n < (256 :num)) ns
v_to_list_SOME_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(y :v) (ys :v list) (x :v). vr x y ∧ v_to_list y = SOME ys ⇒ ∃(xs :v list). LIST_REL vr xs ys ∧ v_to_list x = SOME xs
v_to_list_NONE_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(y :v) (x :v). vr x y ∧ v_to_list y = (NONE :v list option) ⇒ v_to_list x = (NONE :v list option)
simple_state_rel_FLOOKUP_refs_IMP_typed=simple_state_rel (vr :v -> v -> bool) (sr :(α, β) state -> (γ, β) state -> bool) ∧ sr (s :(α, β) state) (t :(γ, β) state) ∧ FLOOKUP t.refs (p :num) = (x :v ref option) ⇒ case x of (NONE :v ref option) => FLOOKUP s.refs p = (NONE :v ref option) | SOME (ValueArray vs) => ∃(xs :v list). FLOOKUP s.refs p = SOME (ValueArray xs) ∧ LIST_REL vr xs vs | SOME (ByteArray bs :v ref) => FLOOKUP s.refs p = SOME (ByteArray bs :v ref) | SOME (Thunk m w :v ref) => ∃(v :v). FLOOKUP s.refs p = SOME (Thunk m v :v ref) ∧ vr v w
refs_ffi_lemma_typed=(s :(γ, 'ffi) state) with <|refs := (refs' :num |-> v ref); ffi := (ffi' :α ffi_state)|> = s with <|ffi := ffi'; refs := refs'|>
result_rel_Rval2_typed=result_rel (R1 :α -> β -> bool) (R2 :γ -> δ -> bool) (r :(α, γ) result) (Rval (v :β) :(β, δ) result) ⇔ ∃(v' :α). r = (Rval v' :(α, γ) result) ∧ R1 v' v
PAIR_REL_SIMP_typed=(((R1 :α -> β -> bool) ### (R2 :γ -> δ -> bool)) (n :α # γ) ((c :β),(d :δ)) ⇔ ∃(x :α) (y :γ). n = (x,y) ∧ R1 x c ∧ R2 y d) ∧ ((R1 ### R2) ((a :α),(b :γ)) (m :β # δ) ⇔ ∃(x :β) (y :δ). m = (x,y) ∧ R1 a x ∧ R2 b y)
LIST_REL_REFL_EVERY_typed=∀(l :α list). LIST_REL (R :α -> α -> bool) l l ⇔ EVERY (λ(x :α). R x x) l
POS_INT_EQ_NUM_typed=(0 :int) ≤ (i :int) ⇔ ∃(n :num). i = ((&n) :int)
simple_val_rel_Boolv_typed=simple_val_rel (vr :v -> v -> bool) ⇒ (vr (Boolv (b :bool) :v) (v1 :v) ⇒ v1 = (Boolv b :v)) ∧ (vr v1 (Boolv b :v) ⇒ v1 = (Boolv b :v))
simple_compile_state_rel_def_typed=∀(vr :v -> v -> bool) (sr :(γ, 'ffi) state -> (γ, 'ffi) state -> bool) (comp :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) (cr :closLang$exp list -> closLang$exp list -> bool). simple_compile_state_rel vr sr comp cr ⇔ simple_state_rel vr sr ∧ ∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). sr s t ⇒ t.clock = s.clock ∧ s.compile = pure_cc comp t.compile ∧ t.compile_oracle = (pure_co comp :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle ∧ (∀(n :num) (exps :closLang$exp list) (res :(num # num # closLang$exp) list) (p :closLang$exp list) (aux :(num # num # closLang$exp) list). SND (s.compile_oracle n) = (p,aux) ⇒ comp (p,aux) = (exps,res) ⇒ res = ([] :(num # num # closLang$exp) list) ∧ LENGTH exps = LENGTH p ∧ cr p exps) ∧ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ ∀(n :num). sr (s with <|clock := n; compile_oracle := shift_seq (1 :num) s.compile_oracle; code := s.code|>) (t with <|clock := n; compile_oracle := shift_seq (1 :num) t.compile_oracle; code := t.code|>)
val_rel_to_words_lemma_typed=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(xs :v list) (ys :v list). LIST_REL vr xs ys ⇒ ∀(ns :word64 list). xs = MAP Word64 ns ⇔ ys = MAP Word64 ns
simple_val_rel_do_install_typed=∀(comp :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list). simple_val_rel (vr :v -> v -> bool) ∧ simple_compile_state_rel vr (sr :(γ, 'ffi) state -> (γ, 'ffi) state -> bool) comp (cr :closLang$exp list -> closLang$exp list -> bool) ⇒ sr (s :(γ, 'ffi) state) (t :(γ, 'ffi) state) ∧ LIST_REL vr (xs :v list) (ys :v list) ⇒ case do_install xs s of ((Rval exps1 :(closLang$exp list, v) result),s1) => ∃(exps2 :closLang$exp list) (t1 :(γ, 'ffi) state). sr s1 t1 ∧ exps1 ≠ ([] :closLang$exp list) ∧ cr exps1 exps2 ∧ do_install ys t = ((Rval exps2 :(closLang$exp list, v) result),t1) | ((Rerr err1 :(closLang$exp list, v) result),s1) => ∃(err2 :v error_result) (t1 :(γ, 'ffi) state). do_install ys t = ((Rerr err2 :(closLang$exp list, v) result),t1) ∧ exc_rel vr err1 err2 ∧ sr s1 t1
LIST_REL_LAST_typed=∀(P :α -> β -> bool). LIST_REL P (xs :α list) (ys :β list) ∧ xs ≠ ([] :α list) ⇒ P (LAST xs) (LAST ys)
FST_EQ_LEMMA_typed=FST (x :α # β) = (y :α) ⇔ ∃(y1 :β). x = (y,y1)
initial_state_max_app_typed=(initial_state (ffi :β ffi_state) (max_app :num) (code :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option) (k :num)).max_app = max_app
eval_sim_def_typed=∀(ffi :α ffi_state) (max_app :num) (code1 :num |-> num # closLang$exp) (co1 :num -> β # closLang$exp list # (num # num # closLang$exp) list) (cc1 :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) (es1 :closLang$exp list) (code2 :num |-> num # closLang$exp) (co2 :num -> γ # closLang$exp list # (num # num # closLang$exp) list) (cc2 :γ -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # γ) option) (es2 :closLang$exp list) (rel :(num |-> num # closLang$exp) -> (num -> β # closLang$exp list # (num # num # closLang$exp) list) -> (β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) -> closLang$exp list -> (num |-> num # closLang$exp) -> (num -> γ # closLang$exp list # (num # num # closLang$exp) list) -> (γ -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # γ) option) -> closLang$exp list -> bool) (allow_fail :bool). eval_sim ffi max_app code1 co1 cc1 es1 code2 co2 cc2 es2 rel allow_fail ⇔ ∀(k :num) (res1 :(v list, v) result) (s2 :(β, α) state). evaluate (es1,([] :v list),initial_state ffi max_app code1 co1 cc1 k) = (res1,s2) ∧ (allow_fail ∨ res1 ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) ∧ rel code1 co1 cc1 es1 code2 co2 cc2 es2 ⇒ ∃(ck :num) (res2 :(v list, v) result) (t2 :(γ, α) state). evaluate (es2,([] :v list),initial_state ffi max_app code2 co2 cc2 (k + ck)) = (res2,t2) ∧ result_rel (λ(x :v list) (y :v list). T) (λ(x :v) (y :v). T) res1 res2 ∧ s2.ffi = t2.ffi
initial_state_with_clock_typed=initial_state (ffi :β ffi_state) (ma :num) (code :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option) (k :num) with clock := (initial_state ffi ma code co cc k).clock + (ck :num) = initial_state ffi ma code co cc (k + ck)
IMP_semantics_eq_typed=eval_sim (ffi :'ffi ffi_state) (max_app :num) (code1 :num |-> num # closLang$exp) (co1 :num -> α # closLang$exp list # (num # num # closLang$exp) list) (cc1 :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option) (es1 :closLang$exp list) (code2 :num |-> num # closLang$exp) (co2 :num -> β # closLang$exp list # (num # num # closLang$exp) list) (cc2 :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) (es2 :closLang$exp list) (rel :(num |-> num # closLang$exp) -> (num -> α # closLang$exp list # (num # num # closLang$exp) list) -> (α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option) -> closLang$exp list -> (num |-> num # closLang$exp) -> (num -> β # closLang$exp list # (num # num # closLang$exp) list) -> (β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) -> closLang$exp list -> bool) F ∧ semantics ffi max_app code1 co1 cc1 es1 ≠ Fail ⇒ rel code1 co1 cc1 es1 code2 co2 cc2 es2 ⇒ semantics ffi max_app code2 co2 cc2 es2 = semantics ffi max_app code1 co1 cc1 es1
IMP_semantics_eq_no_fail_typed=eval_sim (ffi :α ffi_state) (max_app :num) (code1 :num |-> num # closLang$exp) (co1 :num -> β # closLang$exp list # (num # num # closLang$exp) list) (cc1 :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) (es1 :closLang$exp list) (code2 :num |-> num # closLang$exp) (co2 :num -> γ # closLang$exp list # (num # num # closLang$exp) list) (cc2 :γ -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # γ) option) (es2 :closLang$exp list) (rel :(num |-> num # closLang$exp) -> (num -> β # closLang$exp list # (num # num # closLang$exp) list) -> (β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) -> closLang$exp list -> (num |-> num # closLang$exp) -> (num -> γ # closLang$exp list # (num # num # closLang$exp) list) -> (γ -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # γ) option) -> closLang$exp list -> bool) T ⇒ rel code1 co1 cc1 es1 code2 co2 cc2 es2 ⇒ semantics ffi max_app code2 co2 cc2 es2 = semantics ffi max_app code1 co1 cc1 es1
semantics_CURRY_I_gen_typed=(∀(n :num) (x :α # β) (y :closLang$exp list # (num # num # closLang$exp) list). (co :num -> (α # β) # closLang$exp list # (num # num # closLang$exp) list) n = (x,y) ⇒ (cc_x :α # β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α # β) option) x y = state_cc (CURRY (I :α # closLang$exp list # (num # num # closLang$exp) list -> α # closLang$exp list # (num # num # closLang$exp) list)) (cc :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) x y) ⇒ semantics (ffi :γ ffi_state) (max_app :num) (code :num |-> num # closLang$exp) co cc_x (es :closLang$exp list) ≠ Fail ⇒ semantics ffi max_app code (state_co (CURRY (I :α # closLang$exp list # (num # num # closLang$exp) list -> α # closLang$exp list # (num # num # closLang$exp) list)) co) cc es = semantics ffi max_app code co cc_x es
semantics_nil_typed=semantics (ffi :α ffi_state) (maxapp :num) (code :num |-> num # closLang$exp) (co :num -> β # closLang$exp list # (num # num # closLang$exp) list) (cc :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) ([] :closLang$exp list) = Terminate Success ffi.io_events
find_code_SUBMAP_typed=find_code (dest :γ) (vs :α list) (code1 :γ |-> num # β) = SOME (p :α list # β) ∧ code1 ⊑ (code2 :γ |-> num # β) ⇒ find_code dest vs code2 = SOME p
find_code_SUBMAP_rel_typed=find_code (dest :num) (vs :α list) (s1 :(β, γ) state).code = SOME (p :α list # closLang$exp) ∧ SUBMAP_rel s1 (s2 :(β, γ) state) ⇒ find_code dest vs s2.code = SOME p
SUBMAP_rel_EX_typed=SUBMAP_rel (z1 :(α, β) state) (z2 :(α, β) state) ⇒ ∃(code :num |-> num # closLang$exp). z2 = z1 with code := code ∧ z1.code ⊑ code
do_install_SUBMAP_typed=do_install (xs :v list) (z1 :(α, β) state) = ((r :(closLang$exp list, v) result),(s1 :(α, β) state)) ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(closLang$exp list, v) result) ∧ SUBMAP_rel z1 (z2 :(α, β) state) ⇒ ∃(s2 :(α, β) state). do_install xs z2 = (r,s2) ∧ SUBMAP_rel s1 s2
do_app_SUBMAP_Rerr_typed=∀(op :closLang$op) (xs :v list) (s1 :(α, β) state) (s2 :(α, β) state) (r :v error_result). (do_app op xs s1 :(v # (α, β) state, v) result) = (Rerr r :(v # (α, β) state, v) result) ∧ SUBMAP_rel s1 s2 ⇒ (do_app op xs s2 :(v # (α, β) state, v) result) = (Rerr r :(v # (α, β) state, v) result)
do_app_SUBMAP_Rval_typed=∀(op :closLang$op) (xs :v list) (s1 :(α, β) state) (s2 :(α, β) state) (r :v) (z1 :(α, β) state). (do_app op xs s1 :(v # (α, β) state, v) result) = (Rval (r,z1) :(v # (α, β) state, v) result) ∧ SUBMAP_rel s1 s2 ⇒ ∃(z2 :(α, β) state). (do_app op xs s2 :(v # (α, β) state, v) result) = (Rval (r,z2) :(v # (α, β) state, v) result) ∧ SUBMAP_rel z1 z2
SUBMAP_refs_clocks_eqs_typed=SUBMAP_rel (s1 :(α, β) state) (s2 :(α, β) state) ⇒ s1.refs = s2.refs ∧ s1.clock = s2.clock
SUBMAP_dec_clock_typed=SUBMAP_rel (s1 :(α, β) state) (s2 :(α, β) state) ⇒ SUBMAP_rel (dec_clock (1 :num) s1) (dec_clock (1 :num) s2)
app_call_dests_cons_typed=∀(y :closLang$exp list) (x :closLang$exp). app_call_dests (opt :bool option) (x::y) = app_call_dests opt [x] ∪ app_call_dests opt y
any_dest_cons_typed=∀(y :closLang$exp list) (x :closLang$exp). any_dests (x::y) = any_dests [x] ∪ any_dests y
call_dest_cons_typed=∀(y :closLang$exp list) (x :closLang$exp). call_dests (x::y) = call_dests [x] ∪ call_dests y
app_dest_cons_typed=∀(y :closLang$exp list) (x :closLang$exp). app_dests (x::y) = app_dests [x] ∪ app_dests y
any_dest_append_typed=∀(l1 :closLang$exp list) (l2 :closLang$exp list). any_dests (l1 ++ l2) = any_dests l1 ∪ any_dests l2
call_dest_append_typed=∀(l1 :closLang$exp list) (l2 :closLang$exp list). call_dests (l1 ++ l2) = call_dests l1 ∪ call_dests l2
app_dest_append_typed=∀(l1 :closLang$exp list) (l2 :closLang$exp list). app_dests (l1 ++ l2) = app_dests l1 ∪ app_dests l2
app_call_dests_map_typed=∀(ls :α list). app_call_dests (opt :bool option) (MAP (f :α -> closLang$exp) ls) = BIGUNION (set (MAP (λ(x :α). app_call_dests opt [f x]) ls))
any_dests_call_dests_app_dests_typed=∀(xs :closLang$exp list). any_dests xs = call_dests xs ∪ app_dests xs
get_code_labels_code_locs_typed=∀(xs :closLang$exp list). EVERY no_Labels xs ∧ every_Fn_SOME xs ⇒ BIGUNION (set (MAP get_code_labels xs)) = set (code_locs xs) ∪ any_dests xs
initial_state_clock_typed=(initial_state (ffi :β ffi_state) (max_app :num) (f :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option) (k :num)).clock = k ∧ initial_state ffi max_app f co cc (k' :num) with clock := k = initial_state ffi max_app f co cc k
