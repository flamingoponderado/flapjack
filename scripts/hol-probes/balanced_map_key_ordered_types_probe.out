bmkt_ordered=⊢ (∀(cmp :α -> β -> γ) (k :α) (res :γ). key_ordered cmp k (Tip :(β, δ) balanced_map) res ⇔ T) ∧ ∀(cmp :α -> β -> γ) (k :α) (n :num) (k' :β) (v :δ) (l :(β, δ) balanced_map) (r :(β, δ) balanced_map) (res :γ). key_ordered cmp k (Bin n k' v l r) res ⇔ cmp k k' = res ∧ key_ordered cmp k l res ∧ key_ordered cmp k r res
bmkt_invariant=⊢ (∀(cmp :α -> α -> ordering). invariant cmp (Tip :(α, β) balanced_map) ⇔ T) ∧ ∀(cmp :α -> α -> ordering) (s :num) (k :α) (v :β) (l :(α, β) balanced_map) (r :(α, β) balanced_map). invariant cmp (Bin s k v l r) ⇔ s = (1 :num) + structure_size l + structure_size r ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ balanced (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r
