find_word_loc_def_typed=∀(name :num) (v0 :α) (v1 :β). find_word_loc (name,v0,v1) = name
find_word_ref_def_typed=(∀(p :α prog). find_word_ref (MustTerminate p) = find_word_ref p) ∧ (∀(v0 :num list) (target :num option) (ret :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (handler :(num # α prog # num # num) option). find_word_ref (Call ret target v0 handler :α prog) = union (case target of (NONE :num option) => (LN :sptree$num_set) | SOME n => insert n () (LN :sptree$num_set)) (union (case ret of (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) => (LN :sptree$num_set) | SOME (v1,v3,ret_handler,l1,v8) => insert l1 () (find_word_ref ret_handler)) (case handler of (NONE :(num # α prog # num # num) option) => (LN :sptree$num_set) | SOME (v1,v3,v4) => find_word_ref v3))) ∧ (∀(p2 :α prog) (p1 :α prog). find_word_ref (Seq p1 p2) = union (find_word_ref p1) (find_word_ref p2)) ∧ (∀(v3 :α reg_imm) (v2 :num) (v1 :cmp) (p2 :α prog) (p1 :α prog). find_word_ref (If v1 v2 v3 p1 p2 :α prog) = union (find_word_ref p1) (find_word_ref p2)) ∧ (∀(v4 :num) (n :num). find_word_ref (LocValue v4 n :α prog) = insert n () (LN :sptree$num_set)) ∧ (∀(names :sptree$num_set) (exit_names :sptree$num_set) (body :α prog). find_word_ref (Loop names body exit_names :α prog) = find_word_ref body) ∧ isEmpty (find_word_ref (Skip :α prog)) ∧ (∀(v9 :(num # num) list) (v7 :num). isEmpty (find_word_ref (Move v7 v9 :α prog))) ∧ (∀(v10 :α inst). isEmpty (find_word_ref (Inst v10 :α prog))) ∧ (∀(v12 :α exp) (v11 :num). isEmpty (find_word_ref (Assign v11 v12))) ∧ (∀(v14 :store_name) (v13 :num). isEmpty (find_word_ref (Get v13 v14 :α prog))) ∧ (∀(v16 :α exp) (v15 :store_name). isEmpty (find_word_ref (Set v15 v16 :α prog))) ∧ (∀(v18 :num) (v17 :α exp). isEmpty (find_word_ref (Store v17 v18 :α prog))) ∧ (∀(v35 :sptree$num_set # sptree$num_set) (v34 :num). isEmpty (find_word_ref (Alloc v34 v35 :α prog))) ∧ (∀(v40 :(bool # α word) list) (v39 :num) (v38 :num) (v37 :num) (v36 :num). isEmpty (find_word_ref (StoreConsts v36 v37 v38 v39 v40 :α prog))) ∧ (∀(v41 :num). isEmpty (find_word_ref (Raise v41 :α prog))) ∧ (∀(v43 :num list) (v42 :num). isEmpty (find_word_ref (Return v42 v43 :α prog))) ∧ (∀(v44 :num). isEmpty (find_word_ref (Break v44 :α prog))) ∧ (∀(v45 :num). isEmpty (find_word_ref (Continue v45 :α prog))) ∧ isEmpty (find_word_ref (Tick :α prog)) ∧ (∀(v48 :num) (v47 :num) (v46 :binop). isEmpty (find_word_ref (OpCurrHeap v46 v47 v48 :α prog))) ∧ (∀(v55 :sptree$num_set # sptree$num_set) (v54 :num) (v53 :num) (v52 :num) (v51 :num). isEmpty (find_word_ref (Install v51 v52 v53 v54 v55 :α prog))) ∧ (∀(v57 :num) (v56 :num). isEmpty (find_word_ref (CodeBufferWrite v56 v57 :α prog))) ∧ (∀(v59 :num) (v58 :num). isEmpty (find_word_ref (DataBufferWrite v58 v59 :α prog))) ∧ (∀(v65 :sptree$num_set # sptree$num_set) (v64 :num) (v63 :num) (v62 :num) (v61 :num) (v60 :mlstring). isEmpty (find_word_ref (FFI v60 v61 v62 v63 v64 v65 :α prog))) ∧ ∀(v68 :α exp) (v67 :num) (v66 :memop). isEmpty (find_word_ref (ShareInst v66 v67 v68))
analyse_word_code_def_typed=isEmpty (analyse_word_code ([] :(num # α # β prog) list)) ∧ ∀(t :(num # α # β prog) list) (prog :β prog) (n :num) (args :α). analyse_word_code ((n,args,prog)::t) = insert n (find_word_ref prog) (analyse_word_code t)
remove_word_code_def_typed=∀(reachable :β sptree$num_map) (l :(num # α) list). remove_word_code reachable l = FILTER (λ(x :num # α). IS_SOME (lookup (FST x) reachable)) l
remove_word_prog_def_typed=∀(n :num) (code :(num # α # β prog) list). remove_word_prog n code = (let (t :sptree$num_set sptree$num_map) = analyse_word_code code; (reachable :sptree$num_set) = closure_spt (insert n () (LN :sptree$num_set)) t in remove_word_code reachable code)
dest_word_loc_def_typed=dest_word_loc (Loc (n :num) (_0 :num) :β word_loc) = SOME n ∧ dest_word_loc (_1 :α word_loc) = (NONE :num option)
dest_result_loc_def_typed=dest_result_loc (SOME (Result (w :α word_loc) (ns :α word_loc list))) = BIGUNION (set (MAP (λ(x' :α word_loc). case dest_word_loc x' of (NONE :num option) => (∅ :num -> bool) | SOME x => {x}) ns)) ∧ dest_result_loc (SOME (Exception w (Loc (n :num) (n0 :num) :α word_loc))) = {n} ∧ dest_result_loc (_0 :β result option) = (∅ :num -> bool)
get_locals_def_typed=isEmpty (get_locals (LN :α word_loc sptree$num_map)) ∧ get_locals ⦕ 0 ↦ (a :β word_loc) ⦖ = (case dest_word_loc a of (NONE :num option) => (LN :sptree$num_set) | SOME n => insert n () (LN :sptree$num_set)) ∧ get_locals (BN (t1 :β word_loc sptree$num_map) (t2 :β word_loc sptree$num_map)) = union (get_locals t1) (get_locals t2) ∧ get_locals (BS t1 a t2) = (let (t :sptree$num_set) = union (get_locals t1) (get_locals t2) in case dest_word_loc a of (NONE :num option) => t | SOME n => insert n () t)
get_store_def_typed=(get_store (st :store_name |-> α word_loc) :sptree$num_set) = (let (locSet :α word_loc list) = SET_TO_LIST (FRANGE st); (locList :num list) = MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) (MAP (dest_word_loc :α word_loc -> num option) locSet)) in FOLDL (λ(acc :sptree$num_set) (loc :num). insert loc () acc) (LN :sptree$num_set) locList)
get_num_wordloc_alist_def_typed=get_num_wordloc_alist (l :(num # α word_loc) list) = (let (locs :num list) = MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) (MAP ((dest_word_loc :α word_loc -> num option) ∘ (SND :num # α word_loc -> α word_loc)) l)) in FOLDL (λ(acc :sptree$num_set) (loc :num). insert loc () acc) (LN :sptree$num_set) locs)
get_stack_def_typed=isEmpty (get_stack ([] :α stack_frame list) :sptree$num_set) ∧ (get_stack (StackFrame (lsz :num option) (e0 :(num # β word_loc) list) (e :(num # β word_loc) list) (_0 :(num # num # num) option)::(xs :β stack_frame list)) :sptree$num_set) = union (union (get_num_wordloc_alist e0) (get_num_wordloc_alist e)) (get_stack xs :sptree$num_set)
get_memory_def_typed=get_memory (mem :α word -> α word_loc) (mdom :α word -> bool) = (let (locSet :α word_loc list) = SET_TO_LIST (IMAGE mem mdom); (locList :num list) = MAP (THE :num option -> num) (FILTER (IS_SOME :num option -> bool) (MAP (dest_word_loc :α word_loc -> num option) locSet)) in FOLDL (λ(acc :sptree$num_set) (loc :num). insert loc () acc) (LN :sptree$num_set) locList)
find_loc_state_def_typed=find_loc_state (s :(α, β, γ) state) = (let (loc :sptree$num_set) = get_locals s.locals; (sto :sptree$num_set) = (get_store s.store :sptree$num_set); (sta :sptree$num_set) = (get_stack s.stack :sptree$num_set); (mem :sptree$num_set) = get_memory s.memory s.mdomain in union (union loc sto) (union sta mem))
code_rel_def_typed=code_rel (reachable :sptree$num_set) (s_code :(num # α prog) sptree$num_map) (t_code :(num # α prog) sptree$num_map) ⇔ ∀(n :num). n ∈ (domain reachable :num -> bool) ⇒ lookup n s_code = lookup n t_code
code_closed_def_typed=code_closed (reachable :α sptree$num_map) (c1 :(β # γ prog) sptree$num_map) ⇔ ∃(code1 :(num # β # γ prog) list). c1 = fromAList code1 ∧ ∀(n :num) (m :num). n ∈ (domain reachable :num -> bool) ∧ is_reachable (analyse_word_code code1) n m ⇒ m ∈ (domain reachable :num -> bool)
gc_no_new_locs_def_typed=gc_no_new_locs (g :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) ⇔ ∀(sta :α stack_frame list) (mem :α word -> α word_loc) (mdom :α word -> bool) (sto :store_name |-> α word_loc) (wl :α word_loc list) (mem1 :α word -> α word_loc) (sto1 :store_name |-> α word_loc) (sta1 :α stack_frame list). g (enc_stack sta,mem,mdom,sto) = SOME (wl,mem1,sto1) ∧ dec_stack wl sta = SOME sta1 ⇒ (domain (get_stack sta1 :sptree$num_set) :num -> bool) ⊆ (domain (get_stack sta :sptree$num_set) :num -> bool) ∧ (domain (get_memory mem1 mdom) :num -> bool) ⊆ (domain (get_memory mem mdom) :num -> bool) ∧ (domain (get_store sto1 :sptree$num_set) :num -> bool) ⊆ (domain (get_store sto :sptree$num_set) :num -> bool)
word_state_rel_def_typed=word_state_rel (reachable :sptree$num_set) (t :(α, β, γ) state) (s :(α, β, γ) state) ⇔ s.locals = t.locals ∧ s.fp_regs = t.fp_regs ∧ s.store = t.store ∧ s.stack = t.stack ∧ s.memory = t.memory ∧ s.mdomain = t.mdomain ∧ s.sh_mdomain = t.sh_mdomain ∧ s.permute = t.permute ∧ s.compile = t.compile ∧ s.compile_oracle = t.compile_oracle ∧ s.code_buffer = t.code_buffer ∧ s.data_buffer = t.data_buffer ∧ s.gc_fun = t.gc_fun ∧ s.handler = t.handler ∧ s.clock = t.clock ∧ s.termdep = t.termdep ∧ (s.be ⇔ t.be) ∧ s.ffi = t.ffi ∧ s.locals_size = t.locals_size ∧ s.stack_max = t.stack_max ∧ s.stack_limit = t.stack_limit ∧ s.stack_size = t.stack_size ∧ code_rel reachable s.code t.code ∧ (domain (find_loc_state t) :num -> bool) ⊆ (domain reachable :num -> bool)
lookup_analyse_word_code_typed=∀(code :(num # α # β prog) list) (n :num) (arity :α) (prog :β prog). ALOOKUP code n = SOME (arity,prog) ⇒ lookup n (analyse_word_code code) = SOME (find_word_ref prog)
remove_word_code_thm_typed=∀(n :num) (reachable :sptree$num_set) (l :(num # α) list). ALL_DISTINCT (MAP (FST :num # α -> num) l) ⇒ ∀(v :α). n ∈ (domain reachable :num -> bool) ∧ MEM (n,v) l ⇔ MEM (n,v) (remove_word_code reachable l)
domain_get_locals_lookup_typed=∀(n :num) (t :α word_loc sptree$num_map). n ∈ (domain (get_locals t) :num -> bool) ⇔ ∃(k :num) (n1 :num). lookup k t = SOME (Loc n n1 :α word_loc)
get_locals_insert_Loc_typed=∀(k :num) (n1 :num) (n0 :num) (locals :α word_loc sptree$num_map). (domain (get_locals (insert k (Loc n1 n0 :α word_loc) locals)) :num -> bool) ⊆ (domain (get_locals locals) :num -> bool) ∪ {n1}
get_locals_insert_typed=∀(k :num) (v :α word_loc) (locals :α word_loc sptree$num_map). (domain (get_locals (insert k v locals)) :num -> bool) ⊆ (domain (get_locals locals) :num -> bool) ∪ case dest_word_loc v of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}
domain_get_store_typed=∀(n :num) (store :store_name |-> α word_loc). n ∈ (domain (get_store store :sptree$num_set) :num -> bool) ⇔ ∃(k :store_name) (n1 :num). FLOOKUP store k = SOME (Loc n n1 :α word_loc)
get_store_update_typed=∀(store :store_name |-> α word_loc) (k :store_name) (v :α word_loc). (domain (get_store store⟨k ↦ v⟩ :sptree$num_set) :num -> bool) ⊆ (domain (get_store store :sptree$num_set) :num -> bool) ∪ case dest_word_loc v of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}
get_num_wordloc_alist_thm_typed=∀(n :num) (e :α) (l :(num # β word_loc) list). (∃(n0 :num). MEM (Loc n n0 :β word_loc) (MAP (SND :num # β word_loc -> β word_loc) l)) ⇔ n ∈ (domain (get_num_wordloc_alist l) :num -> bool)
get_num_wordloc_alist_get_locals_typed=∀(e :(num # α word_loc) list). (domain (get_locals (fromAList e)) :num -> bool) ⊆ (domain (get_num_wordloc_alist e) :num -> bool)
get_locals_union_subset_typed=∀(A :α word_loc sptree$num_map) (B :α word_loc sptree$num_map). (domain (get_locals (union A B)) :num -> bool) ⊆ (domain (union (get_locals A) (get_locals B)) :num -> bool)
get_stack_hd_thm_typed=∀(stack :α stack_frame list) (dr :num -> bool) (l0 :(num # α word_loc) list) (l :(num # α word_loc) list) (opt :(num # num # num) option) (t :α stack_frame list). (domain (get_stack stack :sptree$num_set) :num -> bool) ⊆ dr ∧ stack = StackFrame (lsz :num option) l l0 opt::t ⇒ (domain (get_locals (union (fromAList l0) (fromAList l))) :num -> bool) ⊆ dr ∧ (domain (get_stack t :sptree$num_set) :num -> bool) ⊆ dr
get_stack_LASTN_typed=∀(stack :α stack_frame list) (n :num). (domain (get_stack (LASTN n stack) :sptree$num_set) :num -> bool) ⊆ (domain (get_stack stack :sptree$num_set) :num -> bool)
get_stack_CONS_typed=∀(h :α stack_frame) (t :α stack_frame list). (domain (get_stack [h] :sptree$num_set) :num -> bool) ⊆ (domain (get_stack (h::t) :sptree$num_set) :num -> bool) ∧ (domain (get_stack t :sptree$num_set) :num -> bool) ⊆ (domain (get_stack (h::t) :sptree$num_set) :num -> bool)
get_stack_enc_stack_typed=∀(stack :α stack_frame list) (reachable :β sptree$num_map). (domain (get_stack stack :sptree$num_set) :num -> bool) ⊆ (domain reachable :num -> bool) ⇒ ∀(e :α word_loc). MEM e (enc_stack stack) ⇒ (case dest_word_loc e of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}) ⊆ (domain reachable :num -> bool)
get_stack_dec_stack_typed=∀(locs :α word_loc list) (stack :α stack_frame list) (reachable :β sptree$num_map) (new_stack :α stack_frame list). (∀(n :num) (n0 :num). MEM (Loc n n0 :α word_loc) locs ⇒ n ∈ (domain reachable :num -> bool)) ∧ (domain (get_stack stack :sptree$num_set) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ dec_stack locs stack = SOME new_stack ⇒ (domain (get_stack new_stack :sptree$num_set) :num -> bool) ⊆ (domain reachable :num -> bool)
FINITE_mdom_mem_typed=∀(mdom :α -> bool). FINITE mdom ⇒ FINITE {(mem :α -> β) x | x ∈ mdom}
domain_get_memory_typed=∀(mem :α word -> α word_loc) (mdom :α word -> bool) (n :num). n ∈ (domain (get_memory mem mdom) :num -> bool) ⇔ ∃(k :α word) (n1 :num). k ∈ mdom ∧ mem k = (Loc n n1 :α word_loc)
get_memory_update_typed=∀(k :α word) (v :α word_loc) (memory :α word -> α word_loc) (mdomain :α word -> bool). (domain (get_memory memory⦇k ↦ v⦈ mdomain) :num -> bool) ⊆ (domain (get_memory memory mdomain) :num -> bool) ∪ case dest_word_loc v of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}
domain_find_loc_state_typed=∀(s :(α, β, γ) state). (domain (find_loc_state s) :num -> bool) = (domain (get_locals s.locals) :num -> bool) ∪ (domain (get_store s.store :sptree$num_set) :num -> bool) ∪ (domain (get_stack s.stack :sptree$num_set) :num -> bool) ∪ (domain (get_memory s.memory s.mdomain) :num -> bool)
ALOOKUP_ZIP_SUCCESS_typed=∀(x :α list) (y :β list) (k :α) (v :β). LENGTH x = LENGTH y ⇒ ALOOKUP (ZIP (x,y)) k = SOME v ⇒ MEM v y
get_vars_locals_typed=∀(args :num list) (s :(α, β, γ) state) (x :α word_loc list) (y :α word_loc). get_vars args s = SOME x ∧ MEM y x ⇒ ∃(n :num). lookup n s.locals = SOME y
get_vars_get_locals_typed=∀(args :num list) (s :(α, β, γ) state) (x :α word_loc list) (n :num) (n1 :num). get_vars args s = SOME x ∧ MEM (Loc n n1 :α word_loc) x ⇒ n ∈ (domain (get_locals s.locals) :num -> bool)
get_locals_fromList2_typed=∀(args :num list) (s :(α, β, γ) state) (x :α word_loc list) (t :α word_loc sptree$num_map). get_vars args s = SOME x ∧ x ≠ ([] :α word_loc list) ∧ t = fromList2 x ⇒ (domain (get_locals t) :num -> bool) ⊆ (domain (get_locals s.locals) :num -> bool)
get_locals_fromList2_extension_typed=∀(x :num) (y :α word_loc) (ys :α word_loc list). x ∈ (domain (get_locals (fromList2 ys)) :num -> bool) ⇒ x ∈ (domain (get_locals (fromList2 (ys ++ [y]))) :num -> bool)
get_locals_fromList2_FRONT_typed=∀(args :num list) (s :(α, β, γ) state) (x :α word_loc list) (xf :α word_loc list) (t :α word_loc sptree$num_map). get_vars args s = SOME x ∧ x ≠ ([] :α word_loc list) ∧ xf = FRONT x ∧ t = fromList2 xf ⇒ (domain (get_locals t) :num -> bool) ⊆ (domain (get_locals s.locals) :num -> bool)
get_memory_write_bytearray_lemma_typed=∀(mem :α word -> α word_loc) (mdom :α word -> bool) (reachable :β sptree$num_map) (c :α word) (r :word8 list) (be :bool). (domain (get_memory mem mdom) :num -> bool) ⊆ (domain reachable :num -> bool) ⇒ (domain (get_memory (write_bytearray c r mem mdom be) mdom) :num -> bool) ⊆ (domain reachable :num -> bool)
stack_list_rearrange_lemma_typed=∀(s :(α, β, γ) state) (dr :num -> bool) (locs :δ sptree$num_map) (opt :(num # num # num) option) (lsz :num option). (domain (get_locals s.locals) :num -> bool) ⊆ dr ∧ (domain (get_stack s.stack :sptree$num_set) :num -> bool) ⊆ dr ⇒ (domain (get_stack (StackFrame lsz (toAList (inter s.locals (n :ε sptree$num_map))) (list_rearrange (s.permute (0 :num)) (sort (key_val_compare :num # α word_loc -> num # α word_loc -> bool) (toAList (inter s.locals locs)))) opt::s.stack) :sptree$num_set) :num -> bool) ⊆ dr
remove_word_code_thm_FST_typed=∀(n :num) (reachable :sptree$num_set) (l :(num # α) list). ALL_DISTINCT (MAP (FST :num # α -> num) l) ⇒ (n ∈ (domain reachable :num -> bool) ∧ MEM n (MAP (FST :num # α -> num) l) ⇔ MEM n (MAP (FST :num # α -> num) (remove_word_code reachable l)))
remove_word_code_MAP_FST_lemma_typed=∀(reachable :sptree$num_set) (l :(num # num # α prog) list). MAP (FST :num # num # α prog -> num) (FILTER (λ(x :num # num # α prog). IS_SOME (lookup (FST x) reachable)) l) = FILTER (λ(x :num). IS_SOME (lookup x reachable)) (MAP (FST :num # num # α prog -> num) l)
word_state_rel_get_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ get_var (v :num) t = get_var v s
word_state_rel_get_store_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ (get_store (v :store_name) t :α word_loc option) = (get_store v s :α word_loc option)
word_state_rel_get_vars_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ get_vars (vs :num list) t = get_vars vs s
word_state_rel_set_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ∧ (case dest_word_loc (v :α word_loc) of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}) ⊆ (domain reachable :num -> bool) ⇒ word_state_rel reachable (set_var (n :num) v s) (set_var n v t)
word_state_rel_set_var_word_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ word_state_rel reachable (set_var (n :num) (Word (w :α word)) s) (set_var n (Word w) t)
word_state_rel_set_vars_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ∧ BIGUNION (set (MAP (λ(x' :α word_loc). case dest_word_loc x' of (NONE :num option) => (∅ :num -> bool) | SOME x => {x}) (l :α word_loc list))) ⊆ (domain reachable :num -> bool) ∧ LENGTH (l0 :num list) = LENGTH l ⇒ word_state_rel reachable (set_vars l0 l s) (set_vars l0 l t)
word_state_rel_set_fp_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ word_state_rel reachable (set_fp_var (n :num) (v :word64) s) (set_fp_var n v t)
word_state_rel_word_exp_typed=∀(s1 :(α, β, γ) state) (exp :α exp) (s2 :(α, β, γ) state) (reachable :sptree$num_set). word_state_rel reachable s1 s2 ⇒ (word_exp s2 exp :α word_loc option) = (word_exp s1 exp :α word_loc option)
word_state_rel_mem_load_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ mem_load (addr :α word) t = mem_load addr s
word_state_rel_mem_load_32_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ mem_load_32 s.memory s.mdomain s.be (c :α word) = mem_load_32 t.memory t.mdomain t.be c
word_state_rel_get_fp_var_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ get_fp_var (v :num) s = get_fp_var v t
word_state_rel_assign_NONE_typed=∀(reg :num) (exp :α exp) (s :(α, β, γ) state) (reachable :sptree$num_set) (t :(α, β, γ) state). word_state_rel reachable s t ⇒ (assign reg exp s = (NONE :(α, β, γ) state option) ⇔ assign reg exp t = (NONE :(α, β, γ) state option))
word_state_rel_inst_NONE_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (i :α inst). word_state_rel reachable s t ⇒ (inst i s = (NONE :(α, β, γ) state option) ⇔ inst i t = (NONE :(α, β, γ) state option))
word_state_rel_assign_SOME_typed=word_state_rel (reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) ⇒ assign (reg :num) (exp :α exp) s = SOME (s1 :(α, β, γ) state) ∧ assign reg exp t = SOME (t1 :(α, β, γ) state) ⇒ word_state_rel reachable s1 t1
word_state_rel_inst_SOME_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (i :α inst) (s1 :(α, β, γ) state) (t1 :(α, β, γ) state). word_state_rel reachable s t ⇒ inst i s = SOME s1 ∧ inst i t = SOME t1 ⇒ word_state_rel reachable s1 t1
word_state_rel_pop_env_NONE_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state). word_state_rel reachable s t ⇒ (pop_env s = (NONE :(α, β, γ) state option) ⇔ pop_env t = (NONE :(α, β, γ) state option))
word_state_rel_pop_env_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (s1 :(α, β, γ) state) (l1 :δ) (l2 :ε). word_state_rel reachable s t ⇒ pop_env s = SOME s1 ⇒ ∃(t1 :(α, β, γ) state). pop_env t = SOME t1 ∧ word_state_rel reachable s1 t1
word_state_rel_jump_exc_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (s1 :(α, β, γ) state) (l1 :num) (l2 :num). word_state_rel reachable s t ⇒ jump_exc s = SOME (s1,l1,l2) ⇒ ∃(t1 :(α, β, γ) state). jump_exc t = SOME (t1,l1,l2) ∧ word_state_rel reachable s1 t1
word_state_rel_gc_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (s1 :(α, β, γ) state). word_state_rel reachable s t ∧ gc_no_new_locs s.gc_fun ⇒ gc s = SOME s1 ⇒ ∃(t1 :(α, β, γ) state). gc t = SOME t1 ∧ word_state_rel reachable s1 t1
word_state_rel_alloc_typed=∀(reachable :sptree$num_set) (s :(α, β, γ) state) (t :(α, β, γ) state) (res :α result option) (c :α word) (n :sptree$num_set # sptree$num_set) (s1 :(α, β, γ) state). word_state_rel reachable s t ∧ res ≠ SOME (Error :α result) ∧ gc_no_new_locs s.gc_fun ⇒ alloc c n s = (res,s1) ⇒ ∃(t1 :(α, β, γ) state). alloc c n t = (res,t1) ∧ word_state_rel reachable s1 t1 ∧ dest_result_loc res ⊆ (domain reachable :num -> bool)
const_writes_eq_Loc_typed=∀(words :(bool # α word) list) (a :α word) (c :α word) (m :α word -> α word_loc) (k :α word) (l1 :num) (l2 :num). const_writes a c words m k = (Loc l1 l2 :α word_loc) ⇒ m k = (Loc l1 l2 :α word_loc)
push_env_def2_typed=push_env (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (handler :(num # α prog # num # num) option) (s :(α, β, γ) state) = (let (l0 :(num # α word_loc) list) = toAList (FST env); ((l :(num # α word_loc) list),(permute :num -> num -> num)) = env_to_list (SND env) s.permute; (handler :(num # num # num) option) = case handler of (NONE :(num # α prog # num # num) option) => (NONE :(num # num # num) option) | SOME (w,h,l1,l2) => SOME (s.handler,l1,l2); (stack :α stack_frame list) = StackFrame s.locals_size l0 l handler::s.stack in s with <|stack := stack; stack_max := OPTION_MAP2 MAX s.stack_max (stack_size stack); permute := permute; handler := case handler of (NONE :(num # num # num) option) => s.handler | SOME x => LENGTH s.stack|>)
get_locals_inter_subset_typed=(domain (get_locals (inter (a :α word_loc sptree$num_map) (b :β sptree$num_map))) :num -> bool) ⊆ (domain (get_locals a) :num -> bool)
word_removal_lemma_typed=∀(program :α prog) (state :(α, β, γ) state) (result :α result option) (new_state :(α, β, γ) state) (reachable :sptree$num_set) (removed_state :(α, β, γ) state). evaluate (program,state) = (result,new_state) ∧ result ≠ SOME (Error :α result) ∧ word_state_rel reachable state removed_state ∧ gc_no_new_locs state.gc_fun ∧ no_install program ∧ no_install_code state.code ∧ no_install_code removed_state.code ∧ (domain (find_word_ref program) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ code_closed reachable state.code ⇒ ∃(s :(α, β, γ) state). evaluate (program,removed_state) = (result,s) ∧ word_state_rel reachable new_state s ∧ dest_result_loc result ⊆ (domain reachable :num -> bool)
word_removal_thm_typed=∀(start :num) (state :(α, β, γ) state) (result :α result option) (new_state :(α, β, γ) state) (r :δ) (reachable :sptree$num_set) (code1 :(num # num # α prog) list). evaluate ((Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME start) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog),state) = (result,new_state) ∧ result ≠ SOME (Error :α result) ∧ state.code = fromAList code1 ∧ (domain (find_loc_state state) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ gc_no_new_locs state.gc_fun ∧ reachable = closure_spt (insert start () (LN :sptree$num_set)) (analyse_word_code code1) ∧ ALL_DISTINCT (MAP (FST :num # num # α prog -> num) code1) ∧ no_install_code state.code ⇒ ∃(s :(α, β, γ) state). evaluate ((Call (NONE :(num list # (sptree$num_set # sptree$num_set) # α prog # num # num) option) (SOME start) [(0 :num)] (NONE :(num # α prog # num # num) option) :α prog),state with code := fromAList (remove_word_code reachable code1)) = (result,s)
