linear_scan_reg_alloc_def_typed=∀(k :num) (moves :(num # num # num) list) (ct :clash_tree) (forced :(num # num) list). linear_scan_reg_alloc k moves ct forced = (let (bijstate :bijection_state) = find_bijection_clash_tree find_bijection_init ct; (ct' :clash_tree) = apply_bij_on_clash_tree ct bijstate.bij; (forced' :(num # num) list) = MAP (λ((r1 :num),(r2 :num)). (the (0 :num) (lookup r1 bijstate.bij),the (0 :num) (lookup r2 bijstate.bij))) forced; (moves' :(num # num # num) list) = MAP (λ((p :num),(r1 :num),(r2 :num)). (p,the (0 :num) (lookup r1 bijstate.bij),the (0 :num) (lookup r2 bijstate.bij))) moves; (reglist_unsorted :num list) = MAP (SND :num # num -> num) (toAList bijstate.bij) in run_linear_reg_alloc_intervals ct' k forced' moves' reglist_unsorted bijstate.invbij bijstate.nmax)
