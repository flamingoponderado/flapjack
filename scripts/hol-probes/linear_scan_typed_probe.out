size_of_clash_tree_def_typed=(∀(wr :num list) (rd :num list). size_of_clash_tree (Delta wr rd) = (2 :int)) ∧ (∀(cutset :sptree$num_set). size_of_clash_tree (Set cutset) = (1 :int)) ∧ (∀(optcutset :sptree$num_set option) (ct1 :clash_tree) (ct2 :clash_tree). size_of_clash_tree (Branch optcutset ct1 ct2 :clash_tree) = (if IS_SOME optcutset then (1 :int) else (0 :int)) + size_of_clash_tree ct1 + size_of_clash_tree ct2) ∧ ∀(ct1 :clash_tree) (ct2 :clash_tree). size_of_clash_tree (Seq ct1 ct2) = size_of_clash_tree ct1 + size_of_clash_tree ct2
