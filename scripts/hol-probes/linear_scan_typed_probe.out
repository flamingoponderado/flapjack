live_tree_typed=Writes::num list -> live_tree; Reads::num list -> live_tree; Branch::live_tree -> live_tree -> live_tree; Seq::live_tree -> live_tree -> live_tree
check_intervals_def_typed=∀(f :num -> α) (int_beg :int sptree$num_map) (int_end :int sptree$num_map). check_intervals f int_beg int_end ⇔ ∀(r1 :num) (r2 :num). r1 ∈ (domain int_beg :num -> bool) ∧ r2 ∈ (domain int_beg :num -> bool) ∧ interval_intersect (THE (lookup r1 int_beg),THE (lookup r1 int_end)) (THE (lookup r2 int_beg),THE (lookup r2 int_end)) ∧ f r1 = f r2 ⇒ r1 = r2
check_live_tree_def_typed=(∀(f :num -> num) (l :num list) (live :sptree$num_set) (flive :sptree$num_set). check_live_tree f (Writes l) live flive = case check_partial_col f l live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME v => (let (livein :sptree$num_set) = numset_list_delete l live; (flivein :sptree$num_set) = numset_list_delete (MAP f l) flive in SOME (livein,flivein))) ∧ (∀(f :num -> num) (l :num list) (live :sptree$num_set) (flive :sptree$num_set). check_live_tree f (Reads l) live flive = check_partial_col f l live flive) ∧ (∀(f :num -> num) (lt1 :live_tree) (lt2 :live_tree) (live :sptree$num_set) (flive :sptree$num_set). check_live_tree f (Branch lt1 lt2 :live_tree) live flive = case check_live_tree f lt1 live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME (livein1,flivein1) => case check_live_tree f lt2 live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME (livein2,flivein2) => check_partial_col f (MAP (FST :num # unit -> num) (toAList (difference livein2 livein1))) livein1 flivein1) ∧ ∀(f :num -> num) (lt1 :live_tree) (lt2 :live_tree) (live :sptree$num_set) (flive :sptree$num_set). check_live_tree f (Seq lt1 lt2) live flive = case check_live_tree f lt2 live flive of (NONE :(sptree$num_set # sptree$num_set) option) => (NONE :(sptree$num_set # sptree$num_set) option) | SOME (livein2,flivein2) => check_live_tree f lt1 livein2 flivein2
check_number_property_def_typed=(∀(P :int -> sptree$num_set -> bool) (l :num list) (n :int) (live :sptree$num_set). check_number_property P (Writes l) n live ⇔ (let (n_out :int) = n − (1 :int); (live_out :sptree$num_set) = numset_list_delete l live in P n_out live_out)) ∧ (∀(P :int -> sptree$num_set -> bool) (l :num list) (n :int) (live :sptree$num_set). check_number_property P (Reads l) n live ⇔ (let (n_out :int) = n − (1 :int); (live_out :sptree$num_set) = numset_list_insert l live in P n_out live_out)) ∧ (∀(P :int -> sptree$num_set -> bool) (lt1 :live_tree) (lt2 :live_tree) (n :int) (live :sptree$num_set). check_number_property P (Branch lt1 lt2 :live_tree) n live ⇔ (let (r2 :bool) = check_number_property P lt2 n live; (r1 :bool) = check_number_property P lt1 (n − size_of_live_tree lt2) live in r1 ∧ r2)) ∧ ∀(P :int -> sptree$num_set -> bool) (lt1 :live_tree) (lt2 :live_tree) (n :int) (live :sptree$num_set). check_number_property P (Seq lt1 lt2) n live ⇔ (let (r2 :bool) = check_number_property P lt2 n live; (r1 :bool) = check_number_property P lt1 (n − size_of_live_tree lt2) (get_live_backward lt2 live) in r1 ∧ r2)
check_number_property_strong_def_typed=(∀(P :int -> sptree$num_set -> bool) (l :num list) (n :int) (live :sptree$num_set). check_number_property_strong P (Writes l) n live ⇔ (let (n_out :int) = n − (1 :int); (live_out :sptree$num_set) = numset_list_delete l live in P n_out live_out)) ∧ (∀(P :int -> sptree$num_set -> bool) (l :num list) (n :int) (live :sptree$num_set). check_number_property_strong P (Reads l) n live ⇔ (let (n_out :int) = n − (1 :int); (live_out :sptree$num_set) = numset_list_insert l live in P n_out live_out)) ∧ (∀(P :int -> sptree$num_set -> bool) (lt1 :live_tree) (lt2 :live_tree) (n :int) (live :sptree$num_set). check_number_property_strong P (Branch lt1 lt2 :live_tree) n live ⇔ (let (r2 :bool) = check_number_property_strong P lt2 n live; (r1 :bool) = check_number_property_strong P lt1 (n − size_of_live_tree lt2) live in r1 ∧ r2 ∧ P (n − size_of_live_tree (Branch lt1 lt2 :live_tree)) (get_live_backward (Branch lt1 lt2 :live_tree) live))) ∧ ∀(P :int -> sptree$num_set -> bool) (lt1 :live_tree) (lt2 :live_tree) (n :int) (live :sptree$num_set). check_number_property_strong P (Seq lt1 lt2) n live ⇔ (let (r2 :bool) = check_number_property_strong P lt2 n live; (r1 :bool) = check_number_property_strong P lt1 (n − size_of_live_tree lt2) (get_live_backward lt2 live) in r1 ∧ r2)
check_startlive_prop_def_typed=(∀(l :num list) (n :int) (beg :int sptree$num_map) (end :int sptree$num_map) (ndef :int). check_startlive_prop (Writes l) n beg end ndef ⇔ ∀(r :num). MEM r l ⇒ (case lookup r beg of (NONE :int option) => ndef | SOME x => x) ≤ n ∧ ∃(v :int). lookup r end = SOME v ∧ n ≤ v) ∧ (∀(l :num list) (n :int) (beg :int sptree$num_map) (end :int sptree$num_map) (ndef :int). check_startlive_prop (Reads l) n beg end ndef ⇔ T) ∧ (∀(lt1 :live_tree) (lt2 :live_tree) (n :int) (beg :int sptree$num_map) (end :int sptree$num_map) (ndef :int). check_startlive_prop (Branch lt1 lt2 :live_tree) n beg end ndef ⇔ (let (r2 :bool) = check_startlive_prop lt2 n beg end ndef; (r1 :bool) = check_startlive_prop lt1 (n − size_of_live_tree lt2) beg end ndef in r1 ∧ r2)) ∧ ∀(lt1 :live_tree) (lt2 :live_tree) (n :int) (beg :int sptree$num_map) (end :int sptree$num_map) (ndef :int). check_startlive_prop (Seq lt1 lt2) n beg end ndef ⇔ (let (r2 :bool) = check_startlive_prop lt2 n beg end ndef; (r1 :bool) = check_startlive_prop lt1 (n − size_of_live_tree lt2) beg end ndef in r1 ∧ r2)
fix_domination_def_typed=∀(lt :live_tree). fix_domination lt = (let (live :sptree$num_set) = get_live_backward lt (LN :sptree$num_set) in if isEmpty live then lt else Seq (Writes (MAP (FST :num # unit -> num) (toAList live))) lt)
get_intervals_def_typed=(∀(l :num list) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map). get_intervals (Writes l) n int_beg int_end = (n − (1 :int),numset_list_add_if_lt l n int_beg,numset_list_add_if_gt l n int_end)) ∧ (∀(l :num list) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map). get_intervals (Reads l) n int_beg int_end = (n − (1 :int),int_beg,numset_list_add_if_gt l n int_end)) ∧ (∀(lt1 :live_tree) (lt2 :live_tree) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map). get_intervals (Branch lt1 lt2 :live_tree) n int_beg int_end = (let ((n2 :int),(int_beg2 :int sptree$num_map),(int_end2 :int sptree$num_map)) = get_intervals lt2 n int_beg int_end in get_intervals lt1 n2 int_beg2 int_end2)) ∧ ∀(lt1 :live_tree) (lt2 :live_tree) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map). get_intervals (Seq lt1 lt2) n int_beg int_end = (let ((n2 :int),(int_beg2 :int sptree$num_map),(int_end2 :int sptree$num_map)) = get_intervals lt2 n int_beg int_end in get_intervals lt1 n2 int_beg2 int_end2)
get_intervals_ct_def_typed=∀(ct :clash_tree). get_intervals_ct ct = (let ((n :int),(int_beg :int sptree$num_map),(int_end :int sptree$num_map),(live :sptree$num_set)) = get_intervals_ct_aux ct (0 :int) (LN :int sptree$num_map) (LN :int sptree$num_map) (LN :sptree$num_set); (listlive :num list) = MAP (FST :num # unit -> num) (toAList live) in (n − (1 :int),numset_list_add_if_lt listlive n int_beg,numset_list_add_if_gt listlive n int_end))
get_intervals_ct_aux_def_typed=(∀(wr :num list) (rd :num list) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_ct_aux (Delta wr rd) n int_beg int_end live = (n − (2 :int),numset_list_add_if_lt wr n int_beg,numset_list_add_if_gt rd (n − (1 :int)) (numset_list_add_if_gt wr n int_end),numset_list_insert rd (numset_list_delete wr live))) ∧ (∀(cutset :sptree$num_set) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_ct_aux (Set cutset) n int_beg int_end live = (n − (1 :int),int_beg,numset_list_add_if_gt (MAP (FST :num # unit -> num) (toAList cutset)) n int_end,union cutset live)) ∧ (∀(optcutset :sptree$num_set option) (ct1 :clash_tree) (ct2 :clash_tree) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_ct_aux (Branch optcutset ct1 ct2 :clash_tree) n int_beg int_end live = (let ((n2 :int),(int_beg2 :int sptree$num_map),(int_end2 :int sptree$num_map),(live2 :sptree$num_set)) = get_intervals_ct_aux ct2 n int_beg int_end live; ((n1 :int),(int_beg1 :int sptree$num_map),(int_end1 :int sptree$num_map),(live1 :sptree$num_set)) = get_intervals_ct_aux ct1 n2 int_beg2 int_end2 live in case optcutset of (NONE :sptree$num_set option) => (n1,int_beg1,int_end1,union live1 live2) | SOME cutset => (n1 − (1 :int),int_beg1,numset_list_add_if_gt (MAP (FST :num # unit -> num) (toAList cutset)) n1 int_end1,union cutset (union live1 live2)))) ∧ ∀(ct1 :clash_tree) (ct2 :clash_tree) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_ct_aux (Seq ct1 ct2) n int_beg int_end live = (let ((n2 :int),(int_beg2 :int sptree$num_map),(int_end2 :int sptree$num_map),(live2 :sptree$num_set)) = get_intervals_ct_aux ct2 n int_beg int_end live in get_intervals_ct_aux ct1 n2 int_beg2 int_end2 live2)
get_intervals_withlive_def_typed=(∀(l :num list) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_withlive (Writes l) n int_beg int_end live = (n − (1 :int),numset_list_add_if_lt l n int_beg,numset_list_add_if_gt l n int_end)) ∧ (∀(l :num list) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_withlive (Reads l) n int_beg int_end live = (n − (1 :int),numset_list_delete l int_beg,numset_list_add_if_gt l n int_end)) ∧ (∀(lt1 :live_tree) (lt2 :live_tree) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_withlive (Branch lt1 lt2 :live_tree) n int_beg int_end live = (let ((n2 :int),(int_beg2 :int sptree$num_map),(int_end2 :int sptree$num_map)) = get_intervals_withlive lt2 n int_beg int_end live; ((n1 :int),(int_beg1 :int sptree$num_map),(int_end1 :int sptree$num_map)) = get_intervals_withlive lt1 n2 (difference int_beg2 live) int_end2 live in (n1,difference int_beg1 (union (get_live_backward lt1 live) (get_live_backward lt2 live)),int_end1))) ∧ ∀(lt1 :live_tree) (lt2 :live_tree) (n :int) (int_beg :int sptree$num_map) (int_end :int sptree$num_map) (live :sptree$num_set). get_intervals_withlive (Seq lt1 lt2) n int_beg int_end live = (let ((n2 :int),(int_beg2 :int sptree$num_map),(int_end2 :int sptree$num_map)) = get_intervals_withlive lt2 n int_beg int_end live; ((n1 :int),(int_beg1 :int sptree$num_map),(int_end1 :int sptree$num_map)) = get_intervals_withlive lt1 n2 int_beg2 int_end2 (get_live_backward lt2 live) in (n1,int_beg1,int_end1))
get_live_backward_def_typed=(∀(l :num list) (live :sptree$num_set). get_live_backward (Writes l) live = numset_list_delete l live) ∧ (∀(l :num list) (live :sptree$num_set). get_live_backward (Reads l) live = numset_list_insert l live) ∧ (∀(lt1 :live_tree) (lt2 :live_tree) (live :sptree$num_set). get_live_backward (Branch lt1 lt2 :live_tree) live = (let (live1 :sptree$num_set) = get_live_backward lt1 live; (live2 :sptree$num_set) = get_live_backward lt2 live in numset_list_insert (MAP (FST :num # unit -> num) (toAList (difference live2 live1))) live1)) ∧ ∀(lt1 :live_tree) (lt2 :live_tree) (live :sptree$num_set). get_live_backward (Seq lt1 lt2) live = get_live_backward lt1 (get_live_backward lt2 live)
get_live_tree_def_typed=(∀(wr :num list) (rd :num list). get_live_tree (Delta wr rd) = Seq (Reads rd) (Writes wr)) ∧ (∀(cutset :sptree$num_set). get_live_tree (Set cutset) = (let (cutlist :num list) = MAP (FST :num # unit -> num) (toAList cutset) in Reads cutlist)) ∧ (∀(optcutset :sptree$num_set option) (ct1 :clash_tree) (ct2 :clash_tree). get_live_tree (Branch optcutset ct1 ct2 :clash_tree) = (let (lt1 :live_tree) = get_live_tree ct1; (lt2 :live_tree) = get_live_tree ct2 in case optcutset of (NONE :sptree$num_set option) => (Branch lt1 lt2 :live_tree) | SOME cutset => (let (cutlist :num list) = MAP (FST :num # unit -> num) (toAList cutset) in Seq (Reads cutlist) (Branch lt1 lt2 :live_tree)))) ∧ ∀(ct1 :clash_tree) (ct2 :clash_tree). get_live_tree (Seq ct1 ct2) = (let (lt2 :live_tree) = get_live_tree ct2; (lt1 :live_tree) = get_live_tree ct1 in Seq lt1 lt2)
interval_intersect_def_typed=∀(l1 :int) (r1 :int) (l2 :int) (r2 :int). interval_intersect (l1,r1) (l2,r2) ⇔ l1 ≤ r2 ∧ l2 ≤ r1
live_tree_registers_def_typed=(∀(l :num list). live_tree_registers (Writes l) = set l) ∧ (∀(l :num list). live_tree_registers (Reads l) = set l) ∧ (∀(lt1 :live_tree) (lt2 :live_tree). live_tree_registers (Branch lt1 lt2 :live_tree) = live_tree_registers lt1 ∪ live_tree_registers lt2) ∧ ∀(lt1 :live_tree) (lt2 :live_tree). live_tree_registers (Seq lt1 lt2) = live_tree_registers lt1 ∪ live_tree_registers lt2
numset_list_add_if_def_typed=(∀(v :int) (s :int sptree$num_map) (P :int -> int -> bool). numset_list_add_if ([] :num list) v s P = s) ∧ ∀(x :num) (xs :num list) (v :int) (s :int sptree$num_map) (P :int -> int -> bool). numset_list_add_if (x::xs) v s P = case lookup x s of (NONE :int option) => numset_list_add_if xs v (insert x v s) P | SOME v' => if P v v' then numset_list_add_if xs v (insert x v s) P else numset_list_add_if xs v s P
numset_list_add_if_gt_def_typed=∀(l :num list) (v :int) (s :int sptree$num_map). numset_list_add_if_gt l v s = numset_list_add_if l v s (λ(a :int) (b :int). b ≤ a)
numset_list_add_if_lt_def_typed=∀(l :num list) (v :int) (s :int sptree$num_map). numset_list_add_if_lt l v s = numset_list_add_if l v s $<=
numset_list_insert_def_typed=(∀(t :sptree$num_set). numset_list_insert ([] :num list) t = t) ∧ ∀(x :num) (xs :num list) (t :sptree$num_set). numset_list_insert (x::xs) t = numset_list_insert xs (insert x () t)
numset_list_insert_nottailrec_def_typed=(∀(t :sptree$num_set). numset_list_insert_nottailrec ([] :num list) t = t) ∧ ∀(x :num) (xs :num list) (t :sptree$num_set). numset_list_insert_nottailrec (x::xs) t = insert x () (numset_list_insert_nottailrec xs t)
point_inside_interval_def_typed=∀(l :int) (r :int) (n :int). point_inside_interval (l,r) n ⇔ l ≤ n ∧ n ≤ r
size_of_live_tree_def_typed=(∀(l :num list). size_of_live_tree (Writes l) = (1 :int)) ∧ (∀(l :num list). size_of_live_tree (Reads l) = (1 :int)) ∧ (∀(lt1 :live_tree) (lt2 :live_tree). size_of_live_tree (Branch lt1 lt2 :live_tree) = size_of_live_tree lt1 + size_of_live_tree lt2) ∧ ∀(lt1 :live_tree) (lt2 :live_tree). size_of_live_tree (Seq lt1 lt2) = size_of_live_tree lt1 + size_of_live_tree lt2
linear_scan_hidden_state_typed=recordtype.linear_scan_hidden_state::num list -> int list -> int list -> num list -> (num # num # num) list -> linear_scan_hidden_state
linear_scan_state_typed=recordtype.linear_scan_state::(int # num) list -> num list -> sptree$num_set -> num -> num -> num -> linear_scan_state
colors_length_def_typed=(colors_length :linear_scan_hidden_state -> (num, γ) exc # linear_scan_hidden_state) = (Marray_length (λ(state :linear_scan_hidden_state). state.colors) :linear_scan_hidden_state -> (num, γ) exc # linear_scan_hidden_state)
colors_sub_def_typed=colors_sub = Marray_sub (λ(state :linear_scan_hidden_state). state.colors) Subscript
get_intervals_ct_monad_def_typed=∀(ct :clash_tree). get_intervals_ct_monad ct = st_ex_bind (get_intervals_ct_monad_aux ct (0 :int) (LN :sptree$num_set)) (λ((n :int),(live :sptree$num_set)). st_ex_ignore_bind (numset_list_add_if_lt_monad (MAP (FST :num # unit -> num) (toAList live)) n) (st_ex_ignore_bind (numset_list_add_if_gt_monad (MAP (FST :num # unit -> num) (toAList live)) n) (st_ex_return (n − (1 :int)) :linear_scan_hidden_state -> (int, state_exn) exc # linear_scan_hidden_state)))
get_intervals_ct_monad_aux_def_typed=(∀(wr :num list) (rd :num list) (n :int) (live :sptree$num_set). get_intervals_ct_monad_aux (Delta wr rd) n live = st_ex_ignore_bind (numset_list_add_if_lt_monad wr n) (st_ex_ignore_bind (numset_list_add_if_gt_monad wr n) (st_ex_ignore_bind (numset_list_add_if_gt_monad rd (n − (1 :int))) (st_ex_return (n − (2 :int),numset_list_insert rd (numset_list_delete wr live)) :linear_scan_hidden_state -> (int # sptree$num_set, state_exn) exc # linear_scan_hidden_state)))) ∧ (∀(cutset :sptree$num_set) (n :int) (live :sptree$num_set). get_intervals_ct_monad_aux (Set cutset) n live = st_ex_ignore_bind (numset_list_add_if_gt_monad (MAP (FST :num # unit -> num) (toAList cutset)) n) (st_ex_return (n − (1 :int),union cutset live) :linear_scan_hidden_state -> (int # sptree$num_set, state_exn) exc # linear_scan_hidden_state)) ∧ (∀(optcutset :sptree$num_set option) (ct1 :clash_tree) (ct2 :clash_tree) (n :int) (live :sptree$num_set). get_intervals_ct_monad_aux (Branch optcutset ct1 ct2 :clash_tree) n live = st_ex_bind (get_intervals_ct_monad_aux ct2 n live) (λ((n2 :int),(live2 :sptree$num_set)). st_ex_bind (get_intervals_ct_monad_aux ct1 n2 live) (λ((n1 :int),(live1 :sptree$num_set)). case optcutset of (NONE :sptree$num_set option) => (st_ex_return (n1,union live1 live2) :linear_scan_hidden_state -> (int # sptree$num_set, state_exn) exc # linear_scan_hidden_state) | SOME cutset => st_ex_ignore_bind (numset_list_add_if_gt_monad (MAP (FST :num # unit -> num) (toAList cutset)) n1) (st_ex_return (n1 − (1 :int),union cutset (union live1 live2)) :linear_scan_hidden_state -> (int # sptree$num_set, state_exn) exc # linear_scan_hidden_state)))) ∧ ∀(ct1 :clash_tree) (ct2 :clash_tree) (n :int) (live :sptree$num_set). get_intervals_ct_monad_aux (Seq ct1 ct2) n live = st_ex_bind (get_intervals_ct_monad_aux ct2 n live) (λ((n2 :int),(live2 :sptree$num_set)). get_intervals_ct_monad_aux ct1 n2 live2)
int_beg_length_def_typed=(int_beg_length :linear_scan_hidden_state -> (num, γ) exc # linear_scan_hidden_state) = (Marray_length (λ(state :linear_scan_hidden_state). state.int_beg) :linear_scan_hidden_state -> (num, γ) exc # linear_scan_hidden_state)
