writePC_type=:word64 -> riscv_state -> riscv_state
writePC_hypotheses=0
writePC_fullRecord_equation=∀v s. write'PC v s = s with c_PC := s.c_PC⦇s.procID ↦ v⦈
writePC_fullRecord_proof=T
writePC_allKeys_equation=∀v s k. (write'PC v s).c_PC k = if k = s.procID then v else s.c_PC k
writePC_allKeys_proof=T
writePC_current_equation=∀v s. PC (write'PC v s) = v
writePC_current_proof=T
