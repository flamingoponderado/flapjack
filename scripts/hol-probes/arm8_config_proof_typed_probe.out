is_arm8_machine_config_def_typed=∀(mc :(64, arm8_state, ProcState # SCTLRType # TCR_EL1 # exception # (word5 -> word64) # (word64 # word8 -> bool) # word64) machine_config). is_arm8_machine_config mc ⇔ mc.target = arm8_target ∧ mc.len_reg = (1 :num) ∧ mc.ptr_reg = (0 :num) ∧ mc.len2_reg = (3 :num) ∧ mc.ptr2_reg = (2 :num) ∧ mc.callee_saved_regs = [(19 :num); (20 :num); (21 :num); (22 :num); (23 :num); (24 :num); (25 :num); (26 :num); (27 :num); (28 :num)]
arm8_machine_config_ok_typed=is_arm8_machine_config (mc :(64, arm8_state, ProcState # SCTLRType # TCR_EL1 # exception # (word5 -> word64) # (word64 # word8 -> bool) # word64) machine_config) ⇒ mc_conf_ok mc
arm8_init_ok_typed=is_arm8_machine_config (mc :(64, arm8_state, ProcState # SCTLRType # TCR_EL1 # exception # (word5 -> word64) # (word64 # word8 -> bool) # word64) machine_config) ⇒ mc_init_ok arm8_config arm8_backend_config mc
