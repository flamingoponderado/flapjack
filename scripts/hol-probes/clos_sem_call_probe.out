dest_closure_typed=∀(max_app :num) (loc_opt :num option) (f :v) (args :v list). dest_closure max_app loc_opt f args = case f of Number v17 => (NONE :app_kind option) | (Word64 v18 :v) => (NONE :app_kind option) | Block v19 v20 => (NONE :app_kind option) | ByteVector v21 => (NONE :app_kind option) | RefPtr v22 v23 => (NONE :app_kind option) | (Closure loc arg_env clo_env num_args exp :v) => if check_loc max_app loc_opt loc num_args (LENGTH args) (LENGTH arg_env) ∧ LENGTH arg_env < num_args then if ¬(LENGTH args + LENGTH arg_env < num_args) then SOME (Full_app exp (REVERSE (TAKE (num_args − LENGTH arg_env) (REVERSE args)) ++ arg_env ++ clo_env) (REVERSE (DROP (num_args − LENGTH arg_env) (REVERSE args)))) else SOME (Partial_app (Closure loc (args ++ arg_env) clo_env num_args exp :v)) else (NONE :app_kind option) | (Recclosure loc' arg_env' clo_env' fns i :v) => (let ((num_args :num),(exp :closLang$exp)) = fns❲i❳ in if LENGTH fns ≤ i ∨ ¬check_loc max_app loc_opt (OPTION_MAP ($+ ((2 :num) * i)) loc') num_args (LENGTH args) (LENGTH arg_env') ∨ ¬(LENGTH arg_env' < num_args) then (NONE :app_kind option) else (let (rs :v list) = GENLIST (Recclosure loc' ([] :v list) clo_env' fns :num -> v) (LENGTH fns) in if ¬(LENGTH args + LENGTH arg_env' < num_args) then SOME (Full_app exp (REVERSE (TAKE (num_args − LENGTH arg_env') (REVERSE args)) ++ arg_env' ++ rs ++ clo_env') (REVERSE (DROP (num_args − LENGTH arg_env') (REVERSE args)))) else SOME (Partial_app (Recclosure loc' (args ++ arg_env') clo_env' fns i :v))))
dest_closure_length_typed=∀(max_app :num) (loc_opt :num option) (f :v) (args :v list) (exp :closLang$exp) (args1 :v list) (args2 :v list) (so_far :α). dest_closure max_app loc_opt f args = SOME (Full_app exp args1 args2) ⇒ LENGTH args2 < LENGTH args
partial=SOME (Partial_app (Closure NONE [Number 1] [Number 9] 2 (Var None 0)))
overapplication=SOME (Full_app (Var None 0) [Number 2; Number 3; Number 9] [Number 1])
direct_mismatch=NONE
recursive_direct=SOME (Full_app (Var None 1) [Number 7; Recclosure (SOME 10) [] [] [(1,Var None 0); (1,Var None 1)] 0; Recclosure (SOME 10) [] [] [(1,Var None 0); (1,Var None 1)] 1] [])
recursive_out_of_range=(λ(num_args,exp). NONE) (HD [])
