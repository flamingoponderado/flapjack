ll_LLOOKUP_def=⊢ (∀n. LLOOKUP [] n = NONE) ∧ ∀n x xs. LLOOKUP (x::xs) n = if n = 0 then SOME x else LLOOKUP xs (n − 1)
ll_LLOOKUP_DROP=⊢ ∀xs n m. LLOOKUP (DROP m xs) n = LLOOKUP xs (m + n)
ll_LLOOKUP_TAKE_IMP=⊢ ∀xs x n m. LLOOKUP (TAKE m xs) n = SOME x ⇒ LLOOKUP xs n = SOME x
ll_LLOOKUP_LUPDATE=⊢ ∀xs i n x. LLOOKUP xs❲i ↦ x❳ n = if i ≠ n then LLOOKUP xs n else if i < LENGTH xs then SOME x else NONE
ll_LLOOKUP_THM=⊢ ∀xs n. LLOOKUP xs n = if n < LENGTH xs then SOME xs❲n❳ else NONE
ll_LLOOKUP_EQ_EL=⊢ ∀xs n y. LLOOKUP xs n = SOME y ⇔ n < LENGTH xs ∧ y = xs❲n❳
