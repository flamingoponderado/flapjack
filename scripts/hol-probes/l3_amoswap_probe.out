amoswap_w_definition=∀aq rl rd rs1 rs2. dfn'AMOSWAP_W (aq,rl,rd,rs1,rs2) = (λstate. (let v = GPR rs1 state in if (1 >< 0) v ≠ 0w then signalAddressException (AMO_Misaligned,v) state else (let (v0,s) = translateAddr (v,Data,Write) state in case v0 of NONE => signalAddressException (Store_AMO_Fault,v) s | SOME pAddr => rawWriteData (pAddr,GPR rs2 s,4) (write'GPR (sw2sw ((31 >< 0) (rawReadData pAddr s)),rd) s))))
amoswap_w_type=:word1 # word1 # word5 # word5 # word5 -> riscv_state -> riscv_state
amoswap_d_definition=∀aq rl rd rs1 rs2. dfn'AMOSWAP_D (aq,rl,rd,rs1,rs2) = (λstate. (let v = GPR rs1 state in if (2 >< 0) v ≠ 0w then signalAddressException (AMO_Misaligned,v) state else (let (v0,s) = translateAddr (v,Data,Write) state in case v0 of NONE => signalAddressException (Store_AMO_Fault,v) s | SOME pAddr => rawWriteData (pAddr,GPR rs2 s,8) (write'GPR (rawReadData pAddr s,rd) s))))
amoswap_d_type=:word1 # word1 # word5 # word5 # word5 -> riscv_state -> riscv_state
