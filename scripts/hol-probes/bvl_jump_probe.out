JumpList_def_typed=∀(xs :bvl$exp list) (n :num). JumpList n xs = (let (l :num) = LENGTH xs in if l = (0 :num) then (Op (IntOp (Const (0 :int))) ([] :bvl$exp list) :bvl$exp) else if l = (1 :num) then HD xs else (let (k :num) = l DIV (2 :num); (ys :bvl$exp list) = TAKE k xs; (zs :bvl$exp list) = DROP k xs; (lt :bvl$exp) = if n + l < (1000000 :num) ∧ n + k < (1000000 :num) then (Op (IntOp (LessConstSmall (n + k))) [(Var (0 :num) :bvl$exp)] :bvl$exp) else (Op (IntOp Less) [(Op (IntOp (Const ((&(n + k)) :int))) ([] :bvl$exp list) :bvl$exp); (Var (0 :num) :bvl$exp)] :bvl$exp) in (If lt (JumpList n ys) (JumpList (n + k) zs) :bvl$exp)))
Jump_def_typed=∀(x :bvl$exp) (xs :bvl$exp list). Jump x xs = (Let [x] (JumpList (0 :num) xs) :bvl$exp)
evaluate_Jump_typed=evaluate ([(x :bvl$exp)],(env :v list),(s :(α, β) state)) = ((Rval [(Number ((&(n :num)) :int) :v)] :(v list, v) result),(t :(α, β) state)) ∧ n < LENGTH (xs :bvl$exp list) ⇒ evaluate ([Jump x xs],env,s) = evaluate ([xs❲n❳],(Number ((&n) :int) :v)::env,t)
bvl_get_code_labels_JumpList_typed=∀(n :num) (xs :bvl$exp list). get_code_labels (JumpList n xs) = BIGUNION (set (MAP get_code_labels xs))
evaluate_JumpList_replay=∀(n :num) (xs :bvl$exp list) (k :num). k < LENGTH xs ⇒ evaluate ([JumpList n xs],(Number ((&(n + k)) :int) :v)::(env :v list),(s :(α, β) state)) = evaluate ([xs❲k❳],(Number ((&(n + k)) :int) :v)::env,s)
