JumpList_def_typed=∀(xs :exp list) (n :num). JumpList n xs = (let (l :num) = LENGTH xs in if l = (0 :num) then (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) else if l = (1 :num) then HD xs else (let (k :num) = l DIV (2 :num); (ys :exp list) = TAKE k xs; (zs :exp list) = DROP k xs; (lt :exp) = if n + l < (1000000 :num) ∧ n + k < (1000000 :num) then (Op (IntOp (LessConstSmall (n + k))) [(Var (0 :num) :exp)] :exp) else (Op (IntOp Less) [(Op (IntOp (Const ((&(n + k)) :int))) ([] :exp list) :exp); (Var (0 :num) :exp)] :exp) in (If lt (JumpList n ys) (JumpList (n + k) zs) :exp)))
Jump_def_typed=∀(x :exp) (xs :exp list). Jump x xs = (Let [x] (JumpList (0 :num) xs) :exp)
