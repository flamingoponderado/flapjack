val copy_ret_aux_thm=prove(``(copy_ret_aux k f 0 = Skip) /\
  (copy_ret_aux k f (SUC n) =
  list_Seq [StackLoad k n; StackStore k (n + f); copy_ret_aux k f n])``,  fs[Once copy_ret_aux_def] >>
  fs[Once copy_ret_aux_def]);
val _ = (if null(hyp copy_ret_aux_thm) then () else raise Fail "open premise"; print "rl_full_copy_ret_aux_thm="; print_thm copy_ret_aux_thm; print "\n");
val get_labels_copy_ret=prove(``get_labels (copy_ret perf is_handle kf vs q) = get_labels q``,  fs[oneline copy_ret_def,SeqStackFree_def] \\
  rpt (TOP_CASE_TAC \\ fs[get_labels_def]) \\
  qmatch_goalsub_abbrev_tac `copy_ret_aux _ _ n` \\
  rpt $ pop_assum kall_tac \\
  Induct_on `n` >> fs[copy_ret_aux_thm,get_labels_def,stackLangTheory.list_Seq_def]);
val _ = (if null(hyp get_labels_copy_ret) then () else raise Fail "open premise"; print "rl_full_get_labels_copy_ret="; print_thm get_labels_copy_ret; print "\n");
