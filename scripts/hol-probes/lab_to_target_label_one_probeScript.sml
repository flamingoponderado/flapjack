load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _ = capture "label_one_def" label_one_def;
val _ = types "label_one_def_types" label_one_def;
val _ = capture "sec_label_one_def" sec_label_one_def;
val _ = types "sec_label_one_def_types" sec_label_one_def;
val _ = capture "lines_upd_lab_len_label_one" lines_upd_lab_len_label_one;
val _ = types "lines_upd_lab_len_label_one_types" lines_upd_lab_len_label_one;
val _ = capture "upd_lab_len_label_one" upd_lab_len_label_one;
val _ = types "upd_lab_len_label_one_types" upd_lab_len_label_one;
val _ = capture "enc_lines_again_simp_label_one" enc_lines_again_simp_label_one;
val _ = types "enc_lines_again_simp_label_one_types" enc_lines_again_simp_label_one;
val _ = capture "enc_secs_again_label_one" enc_secs_again_label_one;
val _ = types "enc_secs_again_label_one_types" enc_secs_again_label_one;
val _ = (print "label_one_signature="; print(type_to_string(type_of ``label_one``)); print "\n");
val _ = (print "sec_label_one_signature="; print(type_to_string(type_of ``sec_label_one``)); print "\n");
val _ = show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc(EVAL q)); print "\n");
val bad = ``[Label 3 4 99; Asm (Asmi (Inst Skip)) [] 1; Label 3 5 77] : 8 labLang$line list``;
val grow = ``(λa:8 asm. case a of Jump w => if w = 0w then [0w] else [1w;1w;1w] | _ => [99w;99w]) : 8 asm -> word8 list``;
val labs = ``insert 3 (insert 4 10 LN) LN : num num_map num_map``;
val _ = observe "label_zero" ``label_one (Label 8 9 0 : 8 labLang$line)``;
val _ = observe "label_one" ``label_one (Label 8 9 1 : 8 labLang$line)``;
val _ = observe "label_two_rejected" ``¬label_one (Label 8 9 2 : 8 labLang$line)``;
val _ = observe "asm_any_annotation" ``label_one (Asm (Asmi (Inst Skip)) [] 999 : 8 labLang$line)``;
val _ = observe "labasm_any_annotation" ``label_one (LabAsm (Jump (Lab 3 4)) 0w [] 999 : 8 labLang$line)``;
val _ = observe "empty_section" ``sec_label_one (Section 3 [] : 8 labLang$sec)``;
val _ = observe "bad_section_rejected" ``¬sec_label_one (Section 3 ^bad)``;
val _ = observe "update_even_full" ``lines_upd_lab_len 0 ^bad [] = ([Label 3 4 0;Asm (Asmi (Inst Skip)) [] 1;Label 3 5 1],2)``;
val _ = observe "update_odd_full" ``lines_upd_lab_len 1 ^bad [] = ([Label 3 4 1;Asm (Asmi (Inst Skip)) [] 1;Label 3 5 1],4)``;
val _ = observe "update_establishes" ``EVERY sec_label_one (upd_lab_len 1 [Section 3 ^bad;Section 4 [Label 4 0 999]])``;
val _ = observe "bad_acc_retained" ``¬EVERY label_one (FST(lines_upd_lab_len 0 [] [Label 7 8 99] : 8 labLang$line list # num))``;
val _ = observe "grow_false_preserves" ``enc_lines_again_simp ^labs [] 0 ^grow [LabAsm (Jump (Lab 3 4)) 0w [0w] 1;Label 3 0 1] = ([LabAsm (Jump (Lab 3 4)) 10w [1w;1w;1w] 3;Label 3 0 1],F)``;
val _ = observe "sections_false_preserve" ``enc_secs_again 0 ^labs [] ^grow [Section 3 [LabAsm (Jump (Lab 3 4)) 0w [0w] 1;Label 3 0 1];Section 4 [Label 4 0 0]] = ([Section 3 [LabAsm (Jump (Lab 3 4)) 10w [1w;1w;1w] 3;Label 3 0 1];Section 4 [Label 4 0 0]],F)``;
