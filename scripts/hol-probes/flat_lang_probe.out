type_id_abbrev=:num option
type_group_id_abbrev=:(num # (num # num) list) option
pat_bindings_def_typed=pat_bindings Pany = ([] :mlstring list) ∧ (∀(n :mlstring). pat_bindings (Pvar n :pat) = [n]) ∧ (∀(l :lit). pat_bindings (Plit l :pat) = ([] :mlstring list)) ∧ (∀(v0 :(num # (num # (num # num) list) option) option) (ps :pat list). pat_bindings (Pcon v0 ps) = pats_bindings ps) ∧ (∀(p :pat) (i :mlstring). pat_bindings (Pas p i) = pat_bindings p ++ [i]) ∧ (∀(p :pat). pat_bindings (Pref p) = pat_bindings p) ∧ pats_bindings ([] :pat list) = ([] :mlstring list) ∧ ∀(p :pat) (ps :pat list). pats_bindings (p::ps) = pats_bindings ps ++ pat_bindings p
bool_id_def_typed=bool_id = (0 :num)
Bool_def_typed=∀(t :tra) (b :bool). Bool t b = (Con t (SOME (bool_to_tag b,SOME bool_id)) ([] :exp list) :exp)
SmartIf_def_typed=∀(t :tra) (e :exp) (p :exp) (q :exp). SmartIf t e p q = case e of (Raise v32 v33 :exp) => (If t e p q :exp) | (Handle v34 v35 v36 :exp) => (If t e p q :exp) | (Lit v37 v38 :exp) => (If t e p q :exp) | (Con v39 (NONE :(num # num option) option) v41 :exp) => (If t e p q :exp) | (Con v39 (SOME (tag,(NONE :num option))) ([] :exp list) :exp) => (If t e p q :exp) | (Con v39 (SOME (true_tag,SOME bool_id)) ([] :exp list) :exp) => p | (Con v39 (SOME (false_tag,SOME bool_id)) ([] :exp list) :exp) => q | (Con v39 (SOME (tag,SOME bool_id)) ([] :exp list) :exp) => (If t e p q :exp) | (Con v39 (SOME (tag,SOME id)) ([] :exp list) :exp) => (If t e p q :exp) | (Con v39 (SOME v65) (v68::v69) :exp) => (If t e p q :exp) | Var_local v42 v43 => (If t e p q :exp) | (Fun v44 v45 v46 :exp) => (If t e p q :exp) | (App v47 v48 v49 :exp) => (If t e p q :exp) | (If v50 v51 v52 v53 :exp) => (If t e p q :exp) | (Mat v54 v55 v56 :exp) => (If t e p q :exp) | (Let v57 v58 v59 v60 :exp) => (If t e p q :exp) | (Letrec v61 v62 v63 :exp) => (If t e p q :exp)
false_tag_def_typed=false_tag = (0 :num)
true_tag_def_typed=true_tag = (1 :num)
bool_to_tag_def_typed=∀(b :bool). bool_to_tag b = if b then true_tag else false_tag
