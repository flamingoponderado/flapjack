check_clash_tree_apply_bijection_typed=∀(bij :num sptree$num_map) (invbij :num sptree$num_map) (f :num -> num) (ct :clash_tree) (live :sptree$num_set) (flive :sptree$num_set) (live' :sptree$num_set) (flive' :sptree$num_set) (livein :sptree$num_set) (flivein :sptree$num_set). sp_inverts bij invbij ∧ sp_inverts invbij bij ∧ in_clash_tree ct ⊆ (domain bij :num -> bool) ∧ (domain live :num -> bool) ⊆ (domain invbij :num -> bool) ∧ (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ∧ (domain flive' :num -> bool) = IMAGE (λ(r :num). f (the (0 :num) (lookup r bij))) (domain live' :num -> bool) ∧ (domain live' :num -> bool) = IMAGE (λ(r :num). the (0 :num) (lookup r invbij)) (domain live :num -> bool) ∧ INJ f (domain live :num -> bool) 𝕌(:num) ∧ check_clash_tree f (apply_bij_on_clash_tree ct bij) live flive = SOME (livein,flivein) ⇒ ∃(livein' :sptree$num_set) (flivein' :sptree$num_set). check_clash_tree (λ(r :num). f (the (0 :num) (lookup r bij))) ct live' flive' = SOME (livein',flivein') ∧ (domain livein' :num -> bool) = IMAGE (λ(r :num). the (0 :num) (lookup r invbij)) (domain livein :num -> bool)
check_clash_tree_equal_col_typed=∀(f1 :num -> num) (f2 :num -> num) (ct :clash_tree) (live :sptree$num_set) (flive :sptree$num_set). (∀(r :num). r ∈ in_clash_tree ct ⇒ f1 r = f2 r) ∧ (∀(r :num). r ∈ (domain live :num -> bool) ⇒ f1 r = f2 r) ⇒ check_clash_tree f1 ct live flive = check_clash_tree f2 ct live flive
