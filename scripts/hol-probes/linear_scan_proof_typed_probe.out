check_partial_col_IMAGE_typed=∀(f :num -> num) (l :num list) (live :sptree$num_set) (flive :sptree$num_set) (live' :sptree$num_set) (flive' :sptree$num_set). (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ⇒ check_partial_col f l live flive = SOME (live',flive') ⇒ (domain flive' :num -> bool) = IMAGE f (domain live' :num -> bool)
check_partial_col_input_monotone_typed=∀(f :num -> num) (live1 :sptree$num_set) (flive1 :sptree$num_set) (live2 :sptree$num_set) (flive2 :sptree$num_set) (l :num list) (v :sptree$num_set # sptree$num_set). IMAGE f (domain live1 :num -> bool) = (domain flive1 :num -> bool) ∧ IMAGE f (domain live2 :num -> bool) = (domain flive2 :num -> bool) ⇒ (domain live1 :num -> bool) ⊆ (domain live2 :num -> bool) ⇒ INJ f (domain live2 :num -> bool) 𝕌(:num) ⇒ check_partial_col f l live2 flive2 = SOME v ⇒ ∃(livein1 :sptree$num_set) (flivein1 :sptree$num_set). check_partial_col f l live1 flive1 = SOME (livein1,flivein1)
check_partial_col_list_monotone_typed=∀(f :num -> num) (live :sptree$num_set) (flive :sptree$num_set) (s1 :sptree$num_set) (s2 :sptree$num_set) (a :sptree$num_set) (b :sptree$num_set). (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ⇒ INJ f (domain live :num -> bool) 𝕌(:num) ⇒ (domain s1 :num -> bool) ⊆ (domain s2 :num -> bool) ⇒ check_partial_col f (MAP (FST :num # unit -> num) (toAList s2)) live flive = SOME (a,b) ⇒ ∃(c :sptree$num_set) (d :sptree$num_set). check_partial_col f (MAP (FST :num # unit -> num) (toAList s1)) live flive = SOME (c,d)
check_partial_col_numset_list_insert_typed=∀(f :num -> num) (l :num list) (live :sptree$num_set) (flive :sptree$num_set) (liveout :sptree$num_set) (fliveout :sptree$num_set). check_partial_col f l live flive = SOME (liveout,fliveout) ⇒ liveout = numset_list_insert l live
check_partial_col_success_INJ_typed=∀(l :num list) (live :sptree$num_set) (flive :sptree$num_set) (f :num -> num). (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ∧ INJ f (domain live :num -> bool) 𝕌(:num) ∧ check_partial_col f l live flive = SOME ((live' :sptree$num_set),(flive' :sptree$num_set)) ⇒ INJ f (set l ∪ (domain live :num -> bool)) 𝕌(:num) ∧ INJ f (domain live' :num -> bool) 𝕌(:num)
check_partial_col_success_INJ_lemma_typed=∀(l :num list) (live :sptree$num_set) (flive :sptree$num_set) (f :num -> num). (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ∧ INJ f (domain live :num -> bool) 𝕌(:num) ∧ check_partial_col f l live flive = SOME ((live' :sptree$num_set),(flive' :sptree$num_set)) ⇒ INJ f (set l ∪ (domain live :num -> bool)) 𝕌(:num)
domain_numset_list_delete_typed=∀(l :num list) (s :α sptree$num_map). (domain (numset_list_delete l s) :num -> bool) = (domain s :num -> bool) DIFF set l
domain_numset_list_insert_typed=∀(l :num list) (s :sptree$num_set). (domain (numset_list_insert l s) :num -> bool) = set l ∪ (domain s :num -> bool)
fix_domination_check_live_tree_typed=∀(f :num -> num) (lt :live_tree) (liveout :sptree$num_set) (fliveout :sptree$num_set). check_live_tree f (fix_domination lt) (LN :sptree$num_set) (LN :sptree$num_set) = SOME (liveout,fliveout) ⇒ ∃(liveout' :sptree$num_set) (fliveout' :sptree$num_set). check_live_tree f lt (LN :sptree$num_set) (LN :sptree$num_set) = SOME (liveout',fliveout')
fix_domination_fixes_domination_typed=∀(lt :live_tree). (domain (get_live_backward (fix_domination lt) (LN :sptree$num_set)) :num -> bool) = (∅ :num -> bool)
get_live_tree_correct_typed=∀(f :num -> num) (live :sptree$num_set) (flive :sptree$num_set) (ct :clash_tree) (livein :sptree$num_set) (flivein :sptree$num_set). IMAGE f (domain live :num -> bool) = (domain flive :num -> bool) ⇒ INJ f (domain live :num -> bool) 𝕌(:num) ⇒ check_live_tree f (get_live_tree ct) live flive = SOME (livein,flivein) ⇒ ∃(livein' :sptree$num_set) (flivein' :sptree$num_set). check_clash_tree f ct live flive = SOME (livein',flivein')
get_live_tree_correct_LN_typed=∀(f :num -> num) (ct :clash_tree) (livein :sptree$num_set) (flivein :sptree$num_set). check_live_tree f (get_live_tree ct) (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein,flivein) ⇒ ∃(livein' :sptree$num_set) (flivein' :sptree$num_set). check_clash_tree f ct (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein',flivein')
get_live_tree_correct_lemma_typed=∀(f :num -> num) (live :sptree$num_set) (flive :sptree$num_set) (live' :sptree$num_set) (flive' :sptree$num_set) (ct :clash_tree) (livein' :sptree$num_set) (flivein' :sptree$num_set). IMAGE f (domain live :num -> bool) = (domain flive :num -> bool) ∧ IMAGE f (domain live' :num -> bool) = (domain flive' :num -> bool) ⇒ INJ f (domain live' :num -> bool) 𝕌(:num) ⇒ (domain live :num -> bool) ⊆ (domain live' :num -> bool) ⇒ check_live_tree f (get_live_tree ct) live' flive' = SOME (livein',flivein') ⇒ ∃(livein :sptree$num_set) (flivein :sptree$num_set). check_clash_tree f ct live flive = SOME (livein,flivein) ∧ (domain livein :num -> bool) ⊆ (domain livein' :num -> bool)
lookup_insert_id_typed=∀(x :num) (y :unit) (s :sptree$num_set). lookup x s = SOME () ⇒ s = insert x () s
numset_list_delete_IMAGE_typed=∀(f :num -> num) (l :num list) (live :sptree$num_set) (flive :sptree$num_set) (v :sptree$num_set # sptree$num_set). (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ⇒ INJ f (domain live :num -> bool) 𝕌(:num) ⇒ check_partial_col f l live flive = SOME v ⇒ (domain (numset_list_delete (MAP f l) flive) :num -> bool) = IMAGE f (domain (numset_list_delete l live) :num -> bool)
numset_list_insert_FILTER_typed=∀(l :num list) (live :sptree$num_set). numset_list_insert (FILTER (λ(x :num). lookup x live = (NONE :unit option)) l) live = numset_list_insert l live
numset_list_insert_FOLDL_typed=∀(l :num list) (live :sptree$num_set). numset_list_insert l live = FOLDL (λ(live :sptree$num_set) (x :num). insert x () live) live l
numset_list_insert_nottailrec_FOLDR_typed=∀(l :num list) (live :sptree$num_set). numset_list_insert_nottailrec l live = FOLDR (λ(x :num) (live :sptree$num_set). insert x () live) live l
set_MAP_FST_toAList_eq_domain_typed=∀(s :α sptree$num_map). set (MAP (FST :num # α -> num) (toAList s)) = (domain s :num -> bool)
size_of_live_tree_positive_typed=∀(lt :live_tree). (0 :int) ≤ size_of_live_tree lt
intbeg_less_def_typed=∀(int_beg :int list) (r1 :num) (r2 :num). intbeg_less int_beg r1 r2 ⇔ ($< LEX $<=) (int_beg❲r1❳,r1) (int_beg❲r2❳,r2)
intbeg_less_total_typed=∀(int_beg :int list). total (intbeg_less int_beg)
intbeg_less_transitive_typed=∀(int_beg :int list). transitive (intbeg_less int_beg)
linear_reg_alloc_step_pass1_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (moves :num list sptree$num_map) (forced_adj :num list sptree$num_map) (forced :(num # num) list) (reg :num) (pos :int) (mincol :num). ¬MEM reg l ∧ good_linear_scan_state st sth l pos forced mincol ∧ pos ≤ sth.int_beg❲reg❳ ∧ reg < LENGTH sth.colors ∧ forbidden_is_from_forced_list forced l reg (the ([] :num list) (lookup reg forced_adj)) ∧ EVERY (λ(r :num). MEM r l) (the ([] :num list) (lookup reg forced_adj)) ∧ EVERY (λ(r :num). r < LENGTH sth.colors) (the ([] :num list) (lookup reg forced_adj)) ∧ EVERY (λ(r :num). r < LENGTH sth.colors) (the ([] :num list) (lookup reg moves)) ∧ sth.int_beg❲reg❳ ≤ sth.int_end❲reg❳ ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = linear_reg_alloc_step_pass1 forced_adj moves st reg sth ∧ good_linear_scan_state stout sthout (reg::l) sth.int_beg❲reg❳ forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). ¬MEM r (reg::l) ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (∀(r :num). MEM r l ∧ is_phy_var r ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (phystack_on_stack l st sth ⇒ phystack_on_stack (reg::l) stout sthout) ∧ stout.colormax = st.colormax
linear_reg_alloc_step_pass2_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (moves :num list sptree$num_map) (forced_adj :num list sptree$num_map) (forced :(num # num) list) (reg :num) (pos :int) (mincol :num). ¬MEM reg l ∧ good_linear_scan_state st sth l pos forced mincol ∧ pos ≤ sth.int_beg❲reg❳ ∧ reg < LENGTH sth.colors ∧ forbidden_is_from_forced_list forced l reg (the ([] :num list) (lookup reg forced_adj)) ∧ EVERY (λ(r :num). MEM r l) (the ([] :num list) (lookup reg forced_adj)) ∧ EVERY (λ(r :num). r < LENGTH sth.colors) (the ([] :num list) (lookup reg forced_adj)) ∧ EVERY (λ(r :num). r < LENGTH sth.colors) (the ([] :num list) (lookup reg moves)) ∧ sth.int_beg❲reg❳ ≤ sth.int_end❲reg❳ ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = linear_reg_alloc_step_pass2 forced_adj moves st reg sth ∧ good_linear_scan_state stout sthout (reg::l) sth.int_beg❲reg❳ forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). ¬MEM r (reg::l) ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (∀(r :num). MEM r l ∧ is_phy_var r ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ stout.colormax = st.colormax
phystack_on_stack_def_typed=∀(l :num list) (st :linear_scan_state) (sth :linear_scan_hidden_state). phystack_on_stack l st sth ⇔ ∀(r :num). MEM r l ∧ is_phy_var r ∧ (2 :num) * st.colormax ≤ r ⇒ st.colormax ≤ sth.colors❲r❳
st_ex_FOLDL_linear_reg_alloc_step_passn_invariants_typed=∀(regl :num list) (st :linear_scan_state) (sth :linear_scan_hidden_state) (pos :int) (b :bool) (moves :num list sptree$num_map) (forced_adj :num list sptree$num_map) (forced :(num # num) list) (mincol :num). SORTED (intbeg_less sth.int_beg) regl ∧ ALL_DISTINCT regl ∧ good_linear_scan_state st sth ([] :num list) pos forced mincol ∧ EVERY (λ(r :num). pos ≤ sth.int_beg❲r❳) regl ∧ EVERY (λ(r :num). r < LENGTH sth.colors) regl ∧ (∀(r :num). forbidden_is_from_forced_sublist regl forced sth.int_beg r (the ([] :num list) (lookup r forced_adj))) ∧ EVERY (λ((r1 :num),(r2 :num)). MEM r1 regl ∧ MEM r2 regl) forced ∧ (∀(r1 :num). EVERY (λ(r2 :num). r2 < LENGTH sth.colors) (the ([] :num list) (lookup r1 forced_adj))) ∧ (∀(r1 :num). EVERY (λ(r2 :num). r2 < LENGTH sth.colors) (the ([] :num list) (lookup r1 moves))) ∧ EVERY (λ(r :num). sth.int_beg❲r❳ ≤ sth.int_end❲r❳) regl ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state) (posout :int). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = st_ex_FOLDL ((if b then linear_reg_alloc_step_pass1 else linear_reg_alloc_step_pass2) forced_adj moves :linear_scan_state -> num -> linear_scan_hidden_state -> (linear_scan_state, state_exn) exc # linear_scan_hidden_state) st regl sth ∧ good_linear_scan_state stout sthout (REVERSE regl) posout forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). ¬MEM r regl ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (b ⇒ phystack_on_stack (REVERSE regl) stout sthout) ∧ stout.colormax = st.colormax
st_ex_FOLDL_linear_reg_alloc_step_passn_invariants_lemma_typed=∀(regl :num list) (st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (b :bool) (moves :num list sptree$num_map) (forced_adj :num list sptree$num_map) (forced :(num # num) list) (mincol :num). SORTED (intbeg_less sth.int_beg) regl ∧ (∀(r1 :num) (r2 :num). MEM r1 l ∧ MEM r2 regl ⇒ intbeg_less sth.int_beg r1 r2) ∧ ALL_DISTINCT regl ∧ EVERY (λ(r :num). ¬MEM r regl) l ∧ good_linear_scan_state st sth l pos forced mincol ∧ EVERY (λ(r :num). pos ≤ sth.int_beg❲r❳) regl ∧ EVERY (λ(r :num). r < LENGTH sth.colors) regl ∧ (∀(r :num). forbidden_is_from_forced_sublist (l ++ regl) forced sth.int_beg r (the ([] :num list) (lookup r forced_adj))) ∧ EVERY (λ((r1 :num),(r2 :num)). MEM r1 (l ++ regl) ∧ MEM r2 (l ++ regl)) forced ∧ (∀(r1 :num). EVERY (λ(r2 :num). r2 < LENGTH sth.colors) (the ([] :num list) (lookup r1 forced_adj))) ∧ (∀(r1 :num). EVERY (λ(r2 :num). r2 < LENGTH sth.colors) (the ([] :num list) (lookup r1 moves))) ∧ EVERY (λ(r :num). sth.int_beg❲r❳ ≤ sth.int_end❲r❳) regl ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state) (posout :int). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = st_ex_FOLDL ((if b then linear_reg_alloc_step_pass1 else linear_reg_alloc_step_pass2) forced_adj moves :linear_scan_state -> num -> linear_scan_hidden_state -> (linear_scan_state, state_exn) exc # linear_scan_hidden_state) st regl sth ∧ good_linear_scan_state stout sthout (REVERSE regl ++ l) posout forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). ¬MEM r (l ++ regl) ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (b ⇒ phystack_on_stack l st sth ⇒ phystack_on_stack (REVERSE regl ++ l) stout sthout) ∧ stout.colormax = st.colormax
apply_reg_exchange_correct_typed=∀(l :num list) (sth :linear_scan_hidden_state) (k :num). ALL_DISTINCT (MAP (λ(r :num). sth.colors❲r❳) l) ∧ (∀(r :num). MEM r l ⇒ is_phy_var r) ∧ (∀(r :num). MEM r l ⇒ r < LENGTH sth.colors) ⇒ ∃(sthout :linear_scan_hidden_state). ((M_success () :(unit, state_exn) exc),sthout) = apply_reg_exchange l sth ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r1 :num) (r2 :num). r1 < LENGTH sth.colors ∧ r2 < LENGTH sth.colors ⇒ sthout.colors❲r1❳ = sthout.colors❲r2❳ ⇒ sth.colors❲r1❳ = sth.colors❲r2❳) ∧ (∀(r :num). MEM r l ⇒ sthout.colors❲r❳ = r DIV (2 :num)) ∧ ((∀(r :num). MEM r l ⇒ (k ≤ sth.colors❲r❳ ⇔ k ≤ r DIV (2 :num))) ⇒ ∀(r :num). r < LENGTH sth.colors ⇒ (k ≤ sth.colors❲r❳ ⇔ k ≤ sthout.colors❲r❳)) ∧ ((∀(r :num). MEM r l ⇒ r DIV (2 :num) < k) ⇒ ∀(r :num). r < LENGTH sth.colors ∧ k ≤ sth.colors❲r❳ ∧ (∀(r' :num). MEM r' l ⇒ sth.colors❲r❳ ≠ sth.colors❲r'❳) ⇒ k ≤ sthout.colors❲r❳) ∧ ((∀(r :num). MEM r l ⇒ k ≤ sth.colors❲r❳ ∧ k ≤ r DIV (2 :num)) ⇒ ∀(r :num). r < LENGTH sth.colors ∧ sth.colors❲r❳ < k ⇒ sthout.colors❲r❳ = sth.colors❲r❳)
colors_sub_eqn_typed=colors_sub (n :num) (s :linear_scan_hidden_state) = if n < LENGTH s.colors then ((M_success s.colors❲n❳ :(num, state_exn) exc),s) else ((M_failure Subscript :(num, state_exn) exc),s)
find_reg_exchange_correct_typed=∀(l :num list) (sth :linear_scan_hidden_state) (k :num). ALL_DISTINCT (MAP (λ(r :num). sth.colors❲r❳) l) ∧ (∀(r :num). MEM r l ⇒ is_phy_var r) ∧ (∀(r :num). MEM r l ⇒ r < LENGTH sth.colors) ⇒ ∃(exch :num sptree$num_map) (invexch :num sptree$num_map). find_reg_exchange l (LN :num sptree$num_map) (LN :num sptree$num_map) sth = ((M_success (exch,invexch) :(num sptree$num_map # num sptree$num_map, state_exn) exc),sth) ∧ (lookup_default_id exch ∘ lookup_default_id invexch = (λ(x :num). x) ∧ lookup_default_id invexch ∘ lookup_default_id exch = (λ(x :num). x)) ∧ (∀(r :num). MEM r l ⇒ lookup_default_id exch sth.colors❲r❳ = r DIV (2 :num)) ∧ ((∀(r :num). MEM r l ⇒ (k ≤ sth.colors❲r❳ ⇔ k ≤ r DIV (2 :num))) ⇒ ∀(c :num). id (k ≤ c ⇔ k ≤ lookup_default_id exch c)) ∧ ((∀(r :num). MEM r l ⇒ r DIV (2 :num) < k) ⇒ ∀(c :num). k ≤ c ∧ (∀(r :num). MEM r l ⇒ c ≠ sth.colors❲r❳) ⇒ k ≤ lookup_default_id exch c) ∧ ((∀(r :num). MEM r l ⇒ k ≤ sth.colors❲r❳ ∧ k ≤ r DIV (2 :num)) ⇒ ∀(c :num). c < k ⇒ lookup_default_id exch c = c)
find_reg_exchange_FOLDL_typed=∀(l :num list) (colors :α) (exch :num sptree$num_map) (invexch :num sptree$num_map) (sth :linear_scan_hidden_state). (∀(r :num). MEM r l ⇒ r < LENGTH sth.colors) ⇒ find_reg_exchange l exch invexch sth = ((M_success (FOLDL (λ(a :num sptree$num_map # num sptree$num_map) (b :num). find_reg_exchange_step sth.colors b a) (exch,invexch) l) :(num sptree$num_map # num sptree$num_map, state_exn) exc),sth)
find_reg_exchange_FOLDR_correct_typed=∀(l :num list) (colors :num list) (exch :num sptree$num_map) (invexch :num sptree$num_map) (k :num). ALL_DISTINCT (MAP (λ(r :num). colors❲r❳) l) ∧ (∀(r :num). MEM r l ⇒ is_phy_var r) ∧ (exch,invexch) = FOLDR (λ(a :num) (b :num sptree$num_map # num sptree$num_map). find_reg_exchange_step colors a b) ((LN :num sptree$num_map),(LN :num sptree$num_map)) l ⇒ (lookup_default_id exch ∘ lookup_default_id invexch = (λ(x :num). x) ∧ lookup_default_id invexch ∘ lookup_default_id exch = (λ(x :num). x)) ∧ (∀(r :num). MEM r l ⇒ lookup_default_id exch colors❲r❳ = r DIV (2 :num)) ∧ ((∀(r :num). MEM r l ⇒ (k ≤ colors❲r❳ ⇔ k ≤ r DIV (2 :num))) ⇒ ∀(c :num). id (k ≤ c ⇔ k ≤ lookup_default_id exch c)) ∧ ((∀(r :num). MEM r l ⇒ r DIV (2 :num) < k) ⇒ ∀(c :num). k ≤ c ∧ (∀(r :num). MEM r l ⇒ c ≠ colors❲r❳) ⇒ k ≤ lookup_default_id exch c) ∧ ((∀(r :num). MEM r l ⇒ k ≤ colors❲r❳ ∧ k ≤ r DIV (2 :num)) ⇒ ∀(c :num). c < k ⇒ lookup_default_id exch c = c)
find_reg_exchange_step_def_typed=∀(colors :num list) (r :num) (exch :num sptree$num_map) (invexch :num sptree$num_map). find_reg_exchange_step colors r (exch,invexch) = (let (col1 :num) = colors❲r❳; (fcol1 :num) = r DIV (2 :num); (col2 :num) = lookup_default_id invexch fcol1; (fcol2 :num) = lookup_default_id exch col1 in (insert col1 fcol1 (insert col2 fcol2 exch),insert fcol1 col1 (insert fcol2 col2 invexch)))
int_beg_sub_eqn_typed=int_beg_sub (n :num) (s :linear_scan_hidden_state) = if n < LENGTH s.int_beg then ((M_success s.int_beg❲n❳ :(int, state_exn) exc),s) else ((M_failure Subscript :(int, state_exn) exc),s)
int_end_sub_eqn_typed=int_end_sub (n :num) (s :linear_scan_hidden_state) = if n < LENGTH s.int_end then ((M_success s.int_end❲n❳ :(int, state_exn) exc),s) else ((M_failure Subscript :(int, state_exn) exc),s)
lookup_default_id_def_typed=∀(s :num sptree$num_map) (x :num). lookup_default_id s x = case lookup x s of (NONE :num option) => x | SOME x => x
lookup_default_id_insert_typed=∀(s :num sptree$num_map) (k1 :num) (k2 :num) (v :num). lookup_default_id (insert k2 v s) k1 = if k1 = k2 then v else lookup_default_id s k1
id_def_typed=∀(x :α). id x = x
MAP_colors_eq_typed=∀(sth :linear_scan_hidden_state) (f :num -> num). ∃(sthout :linear_scan_hidden_state). ((M_success () :(unit, state_exn) exc),sthout) = MAP_colors f (LENGTH sth.colors) sth ∧ (∀(n :num). n < LENGTH sth.colors ⇒ sthout.colors❲n❳ = f sth.colors❲n❳) ∧ LENGTH sth.colors = LENGTH sthout.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end
MAP_colors_eq_lemma_typed=∀(sth :linear_scan_hidden_state) (n :num) (f :num -> num). n ≤ LENGTH sth.colors ⇒ ∃(sthout :linear_scan_hidden_state). ((M_success () :(unit, state_exn) exc),sthout) = MAP_colors f n sth ∧ LENGTH sth.colors = LENGTH sthout.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(n' :num). n' < n ⇒ sthout.colors❲n'❳ = f sth.colors❲n'❳) ∧ ∀(n' :num). n ≤ n' ⇒ sthout.colors❲n'❳ = sth.colors❲n'❳
sorted_moves_sub_eqn_typed=sorted_moves_sub (n :num) (s :linear_scan_hidden_state) = if n < LENGTH s.sorted_moves then ((M_success s.sorted_moves❲n❳ :(num # num # num, state_exn) exc),s) else ((M_failure Subscript :(num # num # num, state_exn) exc),s)
sorted_regs_sub_eqn_typed=sorted_regs_sub (n :num) (s :linear_scan_hidden_state) = if n < LENGTH s.sorted_regs then ((M_success s.sorted_regs❲n❳ :(num, state_exn) exc),s) else ((M_failure Subscript :(num, state_exn) exc),s)
update_colors_eqn_typed=update_colors (n :num) (t :num) (s :linear_scan_hidden_state) = if n < LENGTH s.colors then ((M_success () :(unit, state_exn) exc),s with colors := s.colors❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_int_beg_eqn_typed=update_int_beg (n :num) (t :int) (s :linear_scan_hidden_state) = if n < LENGTH s.int_beg then ((M_success () :(unit, state_exn) exc),s with int_beg := s.int_beg❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_int_end_eqn_typed=update_int_end (n :num) (t :int) (s :linear_scan_hidden_state) = if n < LENGTH s.int_end then ((M_success () :(unit, state_exn) exc),s with int_end := s.int_end❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_sorted_moves_eqn_typed=update_sorted_moves (n :num) (t :num # num # num) (s :linear_scan_hidden_state) = if n < LENGTH s.sorted_moves then ((M_success () :(unit, state_exn) exc),s with sorted_moves := s.sorted_moves❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
update_sorted_regs_eqn_typed=update_sorted_regs (n :num) (t :num) (s :linear_scan_hidden_state) = if n < LENGTH s.sorted_regs then ((M_success () :(unit, state_exn) exc),s with sorted_regs := s.sorted_regs❲n ↦ t❳) else ((M_failure Subscript :(unit, state_exn) exc),s)
if_thm_typed=∀(b :bool) (x :α) (y :α) (z :α). (if b then x else y) = z ⇔ b ∧ x = z ∨ ¬b ∧ y = z
LUPDATE_TAKE_typed=∀(n :num) (x :num) (y :α) (l :α list). x < n ∧ n ≤ LENGTH l ⇒ TAKE n l❲x ↦ y❳ = (TAKE n l)❲x ↦ y❳
partition_moves_correct_typed=∀(l :num) (ppiv :num) (r :num) (sth :linear_scan_hidden_state). l ≤ LENGTH sth.sorted_moves ∧ r ≤ LENGTH sth.sorted_moves ⇒ ∃(mid :num) (sthout :linear_scan_hidden_state). partition_moves l ppiv r sth = ((M_success mid :(num, state_exn) exc),sthout) ∧ (l ≤ r ⇒ l ≤ mid ∧ mid ≤ r) ∧ sthout = sth with sorted_moves := sthout.sorted_moves ∧ LENGTH sthout.sorted_moves = LENGTH sth.sorted_moves ∧ ∀(n :num). l ≤ n ∧ r ≤ n ∧ n ≤ LENGTH sth.sorted_moves ⇒ PERM (TAKE n sth.sorted_moves) (TAKE n sthout.sorted_moves)
partition_regs_correct_typed=∀(l :num) (rpiv :num) (begrpiv :int) (r :num) (sth :linear_scan_hidden_state). (∀(i :num). l ≤ i ∧ i < r ⇒ sth.sorted_regs❲i❳ < LENGTH sth.int_beg) ∧ l ≤ LENGTH sth.sorted_regs ∧ r ≤ LENGTH sth.sorted_regs ⇒ ∃(mid :num) (sthout :linear_scan_hidden_state). partition_regs l rpiv begrpiv r sth = ((M_success mid :(num, state_exn) exc),sthout) ∧ sthout = sth with sorted_regs := sthout.sorted_regs ∧ LENGTH sthout.sorted_regs = LENGTH sth.sorted_regs ∧ (l ≤ r ⇒ l ≤ mid ∧ mid ≤ r) ∧ (∀(n :num). l ≤ n ∧ r ≤ n ∧ n ≤ LENGTH sth.sorted_regs ⇒ PERM (TAKE n sth.sorted_regs) (TAKE n sthout.sorted_regs)) ∧ (∀(ind :num). ind < l ∨ r ≤ ind ⇒ sthout.sorted_regs❲ind❳ = sth.sorted_regs❲ind❳) ∧ (∀(ind :num). l ≤ ind ∧ ind < mid ⇒ (let (reg :num) = sthout.sorted_regs❲ind❳ in ($< LEX $<=) (sth.int_beg❲reg❳,reg) (begrpiv,rpiv))) ∧ ∀(ind :num). mid ≤ ind ∧ ind < r ⇒ (let (reg :num) = sthout.sorted_regs❲ind❳ in ($< LEX $<=) (begrpiv,rpiv) (sth.int_beg❲reg❳,reg))
PERM_EVERY_EQ_typed=∀(P :α -> bool) (l1 :α list) (l2 :α list). PERM l1 l2 ⇒ (EVERY P l1 ⇔ EVERY P l2)
sort_moves_correct_typed=∀(l :num) (r :num) (sth :linear_scan_hidden_state). l ≤ LENGTH sth.sorted_moves ∧ r ≤ LENGTH sth.sorted_moves ⇒ ∃(sthout :linear_scan_hidden_state). (sort_moves l r sth :(unit, state_exn) exc # linear_scan_hidden_state) = ((M_success () :(unit, state_exn) exc),sthout) ∧ sthout = sth with sorted_moves := sthout.sorted_moves ∧ LENGTH sthout.sorted_moves = LENGTH sth.sorted_moves ∧ ∀(n :num). l ≤ n ∧ r ≤ n ∧ n ≤ LENGTH sth.sorted_moves ⇒ PERM (TAKE n sth.sorted_moves) (TAKE n sthout.sorted_moves)
sort_regs_correct_typed=∀(l :num) (r :num) (sth :linear_scan_hidden_state). (∀(i :num). l ≤ i ∧ i < r ⇒ sth.sorted_regs❲i❳ < LENGTH sth.int_beg) ∧ l ≤ LENGTH sth.sorted_regs ∧ r ≤ LENGTH sth.sorted_regs ⇒ ∃(sthout :linear_scan_hidden_state). sort_regs l r sth = ((M_success () :(unit, state_exn) exc),sthout) ∧ sthout = sth with sorted_regs := sthout.sorted_regs ∧ LENGTH sthout.sorted_regs = LENGTH sth.sorted_regs ∧ (∀(n :num). l ≤ n ∧ r ≤ n ∧ n ≤ LENGTH sth.sorted_regs ⇒ PERM (TAKE n sth.sorted_regs) (TAKE n sthout.sorted_regs)) ∧ (∀(ind :num). ind < l ∨ r ≤ ind ⇒ sthout.sorted_regs❲ind❳ = sth.sorted_regs❲ind❳) ∧ ∀(i1 :num) (i2 :num). l ≤ i1 ∧ i1 ≤ i2 ∧ i2 < r ⇒ (let (reg1 :num) = sthout.sorted_regs❲i1❳; (reg2 :num) = sthout.sorted_regs❲i2❳ in ($< LEX $<=) (sth.int_beg❲reg1❳,reg1) (sth.int_beg❲reg2❳,reg2))
sort_regs_prop_lemma_typed=∀(P :num -> bool) (l1 :num list) (l2 :num list) (l :num) (r :num). l ≤ LENGTH l1 ∧ r ≤ LENGTH l1 ∧ (∀(ind :num). ind < l ∨ r ≤ ind ⇒ l2❲ind❳ = l1❲ind❳) ∧ (∀(ind :num). l ≤ ind ∧ ind < r ⇒ P l1❲ind❳) ∧ PERM l1 l2 ⇒ ∀(ind :num). l ≤ ind ∧ ind < r ⇒ P l2❲ind❳
split_at_indice_typed=∀(l :α list) (i :num). i ≤ LENGTH l ⇒ ∃(l1 :α list) (l2 :α list). l = l1 ++ l2 ∧ LENGTH l1 = i
split_at_indice_sing_typed=∀(l :α list) (i :num). i < LENGTH l ⇒ ∃(l1 :α list) (x :α) (l2 :α list). l = l1 ++ [x] ++ l2 ∧ LENGTH l1 = i
swap_moves_correct_typed=∀(sth :linear_scan_hidden_state) (i1 :num) (i2 :num). i1 < LENGTH sth.sorted_moves ∧ i2 < LENGTH sth.sorted_moves ⇒ ∃(sthout :linear_scan_hidden_state). swap_moves i1 i2 sth = ((M_success () :(unit, state_exn) exc),sthout) ∧ sthout = sth with sorted_moves := sthout.sorted_moves ∧ LENGTH sthout.sorted_moves = LENGTH sth.sorted_moves ∧ ∀(n :num). i1 < n ∧ i2 < n ∧ n ≤ LENGTH sth.sorted_moves ⇒ PERM (TAKE n sth.sorted_moves) (TAKE n sthout.sorted_moves)
swap_moves_eq_typed=∀(sth :linear_scan_hidden_state) (i1 :num) (i2 :num). i1 < LENGTH sth.sorted_moves ∧ i2 < LENGTH sth.sorted_moves ⇒ ∃(sthout :linear_scan_hidden_state). swap_moves i1 i2 sth = ((M_success () :(unit, state_exn) exc),sthout) ∧ sthout = sth with sorted_moves := sth.sorted_moves❲i2 ↦ sth.sorted_moves❲i1❳; i1 ↦ sth.sorted_moves❲i2❳❳
swap_perm_lemma_typed=∀(l :α list) (i1 :num) (i2 :num). i1 < LENGTH l ∧ i2 < LENGTH l ⇒ PERM l l❲i2 ↦ l❲i1❳; i1 ↦ l❲i2❳❳
swap_regs_eq_typed=∀(sth :linear_scan_hidden_state) (i1 :num) (i2 :num). i1 < LENGTH sth.sorted_regs ∧ i2 < LENGTH sth.sorted_regs ⇒ ∃(sthout :linear_scan_hidden_state). swap_regs i1 i2 sth = ((M_success () :(unit, state_exn) exc),sthout) ∧ sthout = sth with sorted_regs := sth.sorted_regs❲i2 ↦ sth.sorted_regs❲i1❳; i1 ↦ sth.sorted_regs❲i2❳❳
swap_regs_perm_typed=∀(sth :linear_scan_hidden_state) (i1 :num) (i2 :num) (sthout :linear_scan_hidden_state). swap_regs i1 i2 sth = ((M_success () :(unit, state_exn) exc),sthout) ⇒ ∀(n :num). i1 < n ∧ i2 < n ∧ n ≤ LENGTH sth.sorted_regs ⇒ PERM (TAKE n sth.sorted_regs) (TAKE n sthout.sorted_regs)
ALL_DISTINCT_IS_SPARSE_SUBLIST_typed=∀(l1 :α list) (l2 :α list). ALL_DISTINCT l2 ∧ IS_SPARSE_SUBLIST l1 l2 ⇒ ALL_DISTINCT l1
FILTER_IS_SPARSE_SUBLIST_typed=∀(l :α list). IS_SPARSE_SUBLIST (FILTER (P :α -> bool) l) l
FILTER_MEM_active_typed=∀(reg :num) (l :(int # num) list). (∀(e :int). ¬MEM (e,reg) l) ⇒ FILTER (λ((e :int),(r :num)). r ≠ reg) l = l
forced_update_stack_color_lemma_typed=∀(colors :num list) (stacknum :num) (l :num list) (r2 :num) (r1 :num). EVERY (λ(r :num). colors❲r❳ < stacknum) l ∧ MEM r2 l ∧ r1 < LENGTH colors ∧ colors❲r1 ↦ stacknum❳❲r1❳ = colors❲r1 ↦ stacknum❳❲r2❳ ⇒ r1 = r2
IS_SPARSE_SUBLIST_def_typed=(∀(l2 :α list). IS_SPARSE_SUBLIST ([] :α list) l2 ⇔ T) ∧ (∀(xs :α list) (x :α). IS_SPARSE_SUBLIST (x::xs) ([] :α list) ⇔ F) ∧ ∀(ys :α list) (y :α) (xs :α list) (x :α). IS_SPARSE_SUBLIST (x::xs) (y::ys) ⇔ x = y ∧ IS_SPARSE_SUBLIST xs ys ∨ IS_SPARSE_SUBLIST (x::xs) ys
IS_SPARSE_SUBLIST_APPEND_LEFT_typed=∀(l1 :α list) (l2 :α list) (l :α list). IS_SPARSE_SUBLIST l1 l2 ⇒ IS_SPARSE_SUBLIST (l ++ l1) (l ++ l2)
IS_SPARSE_SUBLIST_APPEND_RIGHT_typed=∀(l1 :α list) (l2 :α list) (l :α list). IS_SPARSE_SUBLIST l1 l2 ⇒ IS_SPARSE_SUBLIST (l1 ++ l) (l2 ++ l)
MAP_IS_SPARSE_SUBLIST_typed=∀(l1 :α list) (l2 :α list). IS_SPARSE_SUBLIST l1 l2 ⇒ IS_SPARSE_SUBLIST (MAP (f :α -> β) l1) (MAP f l2)
MEM_SPARSE_SUBLIST_typed=∀(l1 :α list) (l2 :α list) (x :α). IS_SPARSE_SUBLIST l1 l2 ∧ MEM x l1 ⇒ MEM x l2
spill_register_FILTER_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (reg :num) (mincol :num). (¬is_phy_var reg ∨ ¬MEM reg l) ∧ good_linear_scan_state st sth l pos forced mincol ∧ reg < LENGTH sth.colors ∧ sth.int_beg❲reg❳ ≤ pos ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = spill_register (st with active := FILTER (λ((e :int),(r :num)). r ≠ reg) st.active) reg sth ∧ good_linear_scan_state stout sthout (reg::l) pos forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ (∀(r :num). r ≠ reg ⇒ sth.colors❲r❳ = sthout.colors❲r❳) ∧ stout.colormax = st.colormax ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ st.colormax ≤ sthout.colors❲reg❳
spill_register_FILTER_invariants_hidden_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (reg :num) (mincol :num). id (¬is_phy_var reg ∨ ¬MEM reg l) ∧ good_linear_scan_state st sth l pos forced mincol ∧ reg < LENGTH sth.colors ∧ sth.int_beg❲reg❳ ≤ pos ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = spill_register (st with active := FILTER (λ((e :int),(r :num)). r ≠ reg) st.active) reg sth ∧ good_linear_scan_state stout sthout (reg::l) pos forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ (∀(r :num). r ≠ reg ⇒ sth.colors❲r❳ = sthout.colors❲r❳) ∧ stout.colormax = st.colormax ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ st.colormax ≤ sthout.colors❲reg❳
spill_register_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (reg :num) (mincol :num). (∀(e :int). ¬MEM (e,reg) st.active) ∧ (¬is_phy_var reg ∨ ¬MEM reg l) ∧ good_linear_scan_state st sth l pos forced mincol ∧ reg < LENGTH sth.colors ∧ sth.int_beg❲reg❳ ≤ pos ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = spill_register st reg sth ∧ good_linear_scan_state stout sthout (reg::l) pos forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). r ≠ reg ⇒ sth.colors❲r❳ = sthout.colors❲r❳) ∧ stout.colormax = st.colormax ∧ st.colormax ≤ sthout.colors❲reg❳
update_color_active_colors_same_typed=∀(e :α) (reg :num) (active :(β # num) list) (regcol :γ) (colors :γ list). MAP (λ((e :β),(r :num)). colors❲reg ↦ regcol❳❲r❳) (FILTER (λ((e :β),(r :num)). r ≠ reg) active) = MAP (λ((e :β),(r :num)). colors❲r❳) (FILTER (λ((e :β),(r :num)). r ≠ reg) active)
linear_scan_reg_alloc_correct_typed=∀(k :num) (moves :(num # num # num) list) (ct :clash_tree) (forced :(num # num) list). EVERY (λ((r1 :num),(r2 :num)). in_clash_tree ct r1 ∧ in_clash_tree ct r2) forced ⇒ ∃(col :num sptree$num_map) (livein :sptree$num_set) (flivein :sptree$num_set). linear_scan_reg_alloc k moves ct forced = (M_success col :(num sptree$num_map, state_exn) exc) ∧ check_clash_tree (sp_default col) ct (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein,flivein) ∧ (∀(r :num). in_clash_tree ct r ⇒ r ∈ (domain col :num -> bool) ∧ if is_phy_var r then sp_default col r = r DIV (2 :num) else if is_stack_var r then k ≤ sp_default col r else T) ∧ (∀(r :num). r ∈ (domain col :num -> bool) ⇒ in_clash_tree ct r) ∧ EVERY (λ((r1 :num),(r2 :num)). sp_default col r1 = sp_default col r2 ⇒ r1 = r2) forced
linear_reg_alloc_without_renaming_correct_typed=∀(k :num) (moves :(num # num # num) list) (ct :clash_tree) (forced :(num # num) list). (∀(i :num). i < LENGTH (sth :linear_scan_hidden_state).int_beg ⇒ (0 :int) < sth.int_beg❲i❳) ∧ (∀(i :num). i < LENGTH sth.int_end ⇒ (0 :int) < sth.int_end❲i❳) ∧ LENGTH sth.int_end = LENGTH sth.int_beg ∧ (∀(r :num). MEM r (reglist_unsorted :num list) ⇔ in_clash_tree ct r) ∧ (∀(r :num). in_clash_tree ct r ⇒ r < LENGTH sth.int_beg) ∧ EVERY (λ((r1 :num),(r2 :num)). in_clash_tree ct r1 ∧ in_clash_tree ct r2) forced ∧ EVERY (λ((r1 :num),(r2 :num)). r1 < LENGTH sth.colors ∧ r2 < LENGTH sth.colors) (MAP (SND :num # num # num -> num # num) moves) ∧ LENGTH reglist_unsorted ≤ LENGTH sth.sorted_regs ∧ LENGTH moves ≤ LENGTH sth.sorted_moves ∧ LENGTH sth.colors = LENGTH sth.int_beg ∧ LENGTH sth.int_end = LENGTH sth.int_beg ∧ ALL_DISTINCT reglist_unsorted ⇒ ∃(sthout :linear_scan_hidden_state) (livein :sptree$num_set) (flivein :sptree$num_set). st_ex_ignore_bind (get_intervals_ct_monad ct) (linear_reg_alloc_intervals k forced moves reglist_unsorted) sth = ((M_success () :(unit, state_exn) exc),sthout) ∧ check_clash_tree (λ(r :num). sthout.colors❲r❳) ct (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein,flivein) ∧ (∀(r :num). in_clash_tree ct r ⇒ if is_phy_var r then sthout.colors❲r❳ = r DIV (2 :num) else if is_stack_var r then k ≤ sthout.colors❲r❳ else T) ∧ EVERY (λ((r1 :num),(r2 :num)). sthout.colors❲r1❳ = sthout.colors❲r2❳ ⇒ r1 = r2) forced ∧ LENGTH sthout.colors = LENGTH sth.colors
