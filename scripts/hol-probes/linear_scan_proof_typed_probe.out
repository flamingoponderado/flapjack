good_linear_scan_state_def_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (mincol :num). good_linear_scan_state st sth l pos forced mincol ⇔ LENGTH sth.int_beg = LENGTH sth.colors ∧ LENGTH sth.int_end = LENGTH sth.colors ∧ ALL_DISTINCT (st.colorpool ++ MAP (λ((e :int),(r :num)). sth.colors❲r❳) st.active) ∧ EVERY (λ(r :num). r < LENGTH sth.colors) l ∧ EVERY (λ(r :num). sth.colors❲r❳ < st.stacknum) l ∧ (domain st.phyregs :num -> bool) = {sth.colors❲r❳ | r | MEM r l ∧ is_phy_var r ∧ sth.colors❲r❳ < st.colormax} ∧ ALL_DISTINCT (MAP (λ(r :num). sth.colors❲r❳) (FILTER is_phy_var l)) ∧ EVERY (λ(c :num). c < st.colornum) st.colorpool ∧ EVERY (λ((e :int),(r :num)). sth.colors❲r❳ < st.colornum) st.active ∧ st.colornum ≤ st.colormax ∧ st.colormax ≤ st.stacknum ∧ EVERY (λ(r :num). sth.colors❲r❳ < st.colormax ⇒ sth.colors❲r❳ < st.colornum) l ∧ EVERY (λ(r :num). sth.int_beg❲r❳ ≤ pos) l ∧ EVERY (λ(r :num). pos ≤ sth.int_end❲r❳ ∧ sth.colors❲r❳ < st.colormax ⇒ MEM (sth.int_end❲r❳,r) st.active) l ∧ EVERY (λ(r :num). MEM (sth.int_end❲r❳,r) st.active ⇒ pos ≤ (1 :int) + sth.int_end❲r❳) l ∧ (∀(r1 :num) (r2 :num). MEM r1 l ∧ MEM r2 l ∧ interval_intersect (sth.int_beg❲r1❳,sth.int_end❲r1❳) (sth.int_beg❲r2❳,sth.int_end❲r2❳) ∧ sth.colors❲r1❳ = sth.colors❲r2❳ ⇒ r1 = r2) ∧ SORTED (less_FST :int # num -> int # num -> bool) st.active ∧ EVERY (λ((e :int),(r :num)). e = sth.int_end❲r❳) st.active ∧ EVERY (λ((e :int),(r :num)). MEM r l) st.active ∧ EVERY (λ((r1 :num),(r2 :num)). MEM r1 l ∧ MEM r2 l ∧ sth.colors❲r1❳ = sth.colors❲r2❳ ⇒ r1 = r2) forced ∧ mincol ≤ st.colornum ∧ EVERY (λ(c :num). mincol ≤ c) (st.colorpool ++ MAP (λ(r :num). sth.colors❲r❳) l)
