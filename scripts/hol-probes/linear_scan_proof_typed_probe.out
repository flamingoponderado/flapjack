find_color_in_colornum_invariants_typed=∀(st :linear_scan_state) (forbidden :sptree$num_set) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (mincol :num). good_linear_scan_state st sth l pos forced mincol ∧ (domain forbidden :num -> bool) ⊆ {sth.colors❲r❳ | MEM r l} ∧ find_color_in_colornum st forbidden = ((stout :linear_scan_state),SOME (col :num)) ⇒ good_linear_scan_state (stout with colorpool updated_by (λ(l :num list). col::l)) sth l pos forced mincol ∧ st.colornum ≤ col ∧ col < stout.colornum ∧ st.colornum ≤ stout.colornum ∧ col ∉ (domain forbidden :num -> bool) ∧ st = stout with <|colorpool := st.colorpool; colornum := st.colornum|>
