check_col_apply_bijection_typed=∀(cutset :sptree$num_set) (livein :sptree$num_set) (flivein :sptree$num_set) (f :num -> num). (∀(r :num). r ∈ (bijdom :num -> bool) ⇒ (appbij :num -> num) r ∈ (bijcodom :num -> bool) ∧ (appinvbij :num -> num) (appbij r) = r) ∧ (∀(r :num). r ∈ bijcodom ⇒ appinvbij r ∈ bijdom ∧ appbij (appinvbij r) = r) ∧ (domain cutset :num -> bool) ⊆ bijdom ∧ check_col f (foldi (λ(r :num) (_0 :unit) (acc :sptree$num_set). insert (appbij r) () acc) (0 :num) (LN :sptree$num_set) cutset) = SOME (livein,flivein) ⇒ ∃(livein' :sptree$num_set) (flivein' :sptree$num_set). check_col (λ(r :num). f (appbij r)) cutset = SOME (livein',flivein') ∧ (domain livein' :num -> bool) = IMAGE appinvbij (domain livein :num -> bool)
check_col_equal_col_typed=∀(s :α sptree$num_map) (f1 :num -> num) (f2 :num -> num). (∀(r :num). r ∈ (domain s :num -> bool) ⇒ f1 r = f2 r) ⇒ check_col f1 s = check_col f2 s
check_partial_col_apply_bijection_typed=∀(l :num list) (live :sptree$num_set) (flive :sptree$num_set) (live' :sptree$num_set) (flive' :sptree$num_set) (livein :sptree$num_set) (flivein :sptree$num_set). (∀(r :num). r ∈ (bijdom :num -> bool) ⇒ (appbij :num -> num) r ∈ (bijcodom :num -> bool) ∧ (appinvbij :num -> num) (appbij r) = r) ∧ (∀(r :num). r ∈ bijcodom ⇒ appinvbij r ∈ bijdom ∧ appbij (appinvbij r) = r) ∧ set l ⊆ bijdom ∧ (domain live :num -> bool) ⊆ bijcodom ∧ (domain flive :num -> bool) = IMAGE (f :num -> num) (domain live :num -> bool) ∧ (domain flive' :num -> bool) = IMAGE (f ∘ appbij) (domain live' :num -> bool) ∧ (domain live' :num -> bool) = IMAGE appinvbij (domain live :num -> bool) ∧ INJ f (domain live :num -> bool) 𝕌(:num) ∧ check_partial_col f (MAP appbij l) live flive = SOME (livein,flivein) ⇒ ∃(livein' :sptree$num_set) (flivein' :sptree$num_set). check_partial_col (λ(r :num). f (appbij r)) l live' flive' = SOME (livein',flivein') ∧ (domain livein' :num -> bool) = IMAGE appinvbij (domain livein :num -> bool)
check_partial_col_equal_col_typed=∀(l :num list) (live :sptree$num_set) (flive :sptree$num_set) (f1 :num -> num) (f2 :num -> num). (∀(r :num). MEM r l ⇒ f1 r = f2 r) ⇒ check_partial_col f1 l live flive = check_partial_col f2 l live flive
domain_apply_bij_set_typed=∀(s :α sptree$num_map) (bij :num sptree$num_map). (domain (foldi (λ(r :num) (_0 :α) (acc :sptree$num_set). insert (the (0 :num) (lookup r bij)) () acc) (0 :num) (LN :sptree$num_set) s) :num -> bool) = IMAGE (λ(r :num). the (0 :num) (lookup r bij)) (domain s :num -> bool)
extract_coloration_output_typed=∀(bij :num sptree$num_map) (invbij :num sptree$num_map) (sth :linear_scan_hidden_state) (l :num list) (acc :num sptree$num_map). sp_inverts bij invbij ∧ sp_inverts invbij bij ∧ EVERY (λ(r :num). r ∈ (domain invbij :num -> bool)) l ∧ EVERY (λ(r :num). r < LENGTH sth.colors) l ⇒ ∃(col :num sptree$num_map). extract_coloration invbij l acc sth = ((M_success col :(num sptree$num_map, state_exn) exc),sth) ∧ (∀(r :num). r ∈ (domain bij :num -> bool) ⇒ if MEM (the (0 :num) (lookup r bij)) l then lookup r col = SOME sth.colors❲the (0 :num) (lookup r bij)❳ else lookup r col = lookup r acc) ∧ (domain col :num -> bool) ⊆ (domain bij :num -> bool) ∪ (domain acc :num -> bool)
in_clash_tree_apply_bij_typed=∀(bij :num sptree$num_map) (ct :clash_tree). in_clash_tree ct ⊆ (domain bij :num -> bool) ⇒ in_clash_tree (apply_bij_on_clash_tree ct bij) = IMAGE (λ(r :num). the (0 :num) (lookup r bij)) (in_clash_tree ct)
LENGTH_toAList_typed=∀(s :α sptree$num_map). LENGTH (toAList s) = size s
convention_partitions_or_typed=∀(r :num). is_phy_var r ∧ ¬is_stack_var r ∧ ¬is_alloc_var r ∨ ¬is_phy_var r ∧ is_stack_var r ∧ ¬is_alloc_var r ∨ ¬is_phy_var r ∧ ¬is_stack_var r ∧ is_alloc_var r
find_bijection_clash_tree_invariants_typed=∀(st :bijection_state) (ct :clash_tree) (regset :num -> bool). good_bijection_state st regset ⇒ good_bijection_state (find_bijection_clash_tree st ct) (in_clash_tree ct ∪ regset)
find_bijection_init_invariants_typed=good_bijection_state find_bijection_init (∅ :num -> bool)
find_bijection_invariants_typed=∀(st :bijection_state) (r :num) (regset :num -> bool). good_bijection_state st regset ⇒ good_bijection_state (find_bijection_step st r) (r INSERT regset)
foldi_find_bijection_invariants_typed=∀(st :bijection_state) (s :α sptree$num_map) (regset :num -> bool). good_bijection_state st regset ⇒ good_bijection_state (foldi (λ(r :num) (v :α) (acc :bijection_state). find_bijection_step acc r) (0 :num) st s) ((domain s :num -> bool) ∪ regset)
FOLDL_find_bijection_invariants_typed=∀(st :bijection_state) (l :num list) (regset :num -> bool). good_bijection_state st regset ⇒ good_bijection_state (FOLDL find_bijection_step st l) (set l ∪ regset)
good_bijection_state_def_typed=∀(st :bijection_state) (regset :num -> bool). good_bijection_state st regset ⇔ regset = (domain st.bij :num -> bool) ∧ (sp_inverts st.bij st.invbij ∧ sp_inverts st.invbij st.bij) ∧ ((∀(r :num). r ∈ regset ⇒ (is_stack_var r ⇔ is_stack_var (the (0 :num) (lookup r st.bij)))) ∧ (∀(r :num). r ∈ regset ⇒ (is_alloc_var r ⇔ is_alloc_var (the (0 :num) (lookup r st.bij)))) ∧ ∀(r :num). r ∈ regset ∧ is_phy_var r ⇒ r = the (0 :num) (lookup r st.bij)) ∧ (∀(r :num). r ∈ (domain st.invbij :num -> bool) ∧ is_stack_var r ⇒ r < st.nstack) ∧ (∀(r :num). r ∈ (domain st.invbij :num -> bool) ∧ is_alloc_var r ⇒ r < st.nalloc) ∧ (is_stack_var st.nstack ∧ is_alloc_var st.nalloc) ∧ ∀(r :num). the (0 :num) (lookup r st.bij) ≤ st.nmax
in_clash_tree_set_eq_typed=(∀(w :num list) (r :num list). in_clash_tree (Delta w r) = set w ∪ set r) ∧ (∀(names :sptree$num_set). in_clash_tree (Set names) = (domain names :num -> bool)) ∧ (∀(name_opt :sptree$num_set option) (t1 :clash_tree) (t2 :clash_tree). in_clash_tree (Branch name_opt t1 t2 :clash_tree) = case name_opt of (NONE :sptree$num_set option) => in_clash_tree t1 ∪ in_clash_tree t2 | SOME names => (domain names :num -> bool) ∪ in_clash_tree t1 ∪ in_clash_tree t2) ∧ ∀(t1 :clash_tree) (t2 :clash_tree). in_clash_tree (Seq t1 t2) = in_clash_tree t1 ∪ in_clash_tree t2
check_intervals_check_live_tree_typed=∀(lt :live_tree) (n_out :int) (beg_out :int sptree$num_map) (end_out :int sptree$num_map) (f :num -> num). (n_out,beg_out,end_out) = get_intervals (fix_domination lt) (0 :int) (LN :int sptree$num_map) (LN :int sptree$num_map) ∧ check_intervals f beg_out end_out ⇒ ∃(liveout :sptree$num_set) (fliveout :sptree$num_set). check_live_tree f (fix_domination lt) (LN :sptree$num_set) (LN :sptree$num_set) = SOME (liveout,fliveout)
check_intervals_check_live_tree_lemma_typed=∀(lt :live_tree) (n_in :int) (beg_out :int sptree$num_map) (end_out :int sptree$num_map) (f :num -> num) (live :sptree$num_set) (flive :sptree$num_set). check_startlive_prop lt n_in beg_out end_out (n_in − size_of_live_tree lt) ∧ check_number_property_strong (λ(n :int) (live' :sptree$num_set). ∀(r :num). r ∈ (domain live' :num -> bool) ⇒ (case lookup r beg_out of (NONE :int option) => (n_out :int) | SOME x => x) ≤ n) lt n_in live ∧ check_number_property (λ(n :int) (live' :sptree$num_set). ∀(r :num). r ∈ (domain live' :num -> bool) ⇒ ∃(v :int). lookup r end_out = SOME v ∧ n + (1 :int) ≤ v) lt n_in live ∧ check_number_property_strong (λ(n :int) (live' :sptree$num_set). (domain live' :num -> bool) ⊆ (domain end_out :num -> bool)) lt n_in live ∧ (domain beg_out :num -> bool) = (domain end_out :num -> bool) ∧ live_tree_registers lt ⊆ (domain end_out :num -> bool) ∧ check_intervals f beg_out end_out ∧ (domain flive :num -> bool) = IMAGE f (domain live :num -> bool) ∧ INJ f (domain live :num -> bool) 𝕌(:num) ⇒ ∃(liveout :sptree$num_set) (fliveout :sptree$num_set). check_live_tree f lt live flive = SOME (liveout,fliveout)
exists_point_inside_interval_interval_intersect_typed=∀(l1 :int) (r1 :int) (l2 :int) (r2 :int) (v :int). point_inside_interval (l1,r1) v ∧ point_inside_interval (l2,r2) v ⇒ interval_intersect (l1,r1) (l2,r2)
get_intervals_ct_aux_int_typed=∀(ct :clash_tree) (n_in :int) (beg_in :int sptree$num_map) (end_in :int sptree$num_map) (live_in :sptree$num_set) (n_out :int) (beg_out :int sptree$num_map) (end_out :int sptree$num_map) (live_out :sptree$num_set). (n_out,beg_out,end_out,live_out) = get_intervals_ct_aux ct n_in beg_in end_in live_in ⇒ (n_out,beg_out,end_out) = get_intervals (get_live_tree ct) n_in beg_in end_in
get_intervals_ct_aux_live_typed=∀(ct :clash_tree) (n_in :int) (beg_in :int sptree$num_map) (end_in :int sptree$num_map) (live_in :sptree$num_set) (live_in' :sptree$num_set) (n_out :int) (beg_out :int sptree$num_map) (end_out :int sptree$num_map) (live_out :sptree$num_set). (domain live_in :num -> bool) = (domain live_in' :num -> bool) ∧ (n_out,beg_out,end_out,live_out) = get_intervals_ct_aux ct n_in beg_in end_in live_in ⇒ (domain live_out :num -> bool) = (domain (get_live_backward (get_live_tree ct) live_in') :num -> bool)
get_intervals_ct_eq_typed=∀(ct :clash_tree) (int_beg1 :int sptree$num_map) (int_beg2 :int sptree$num_map) (int_end1 :int sptree$num_map) (int_end2 :int sptree$num_map) (n1 :int) (n2 :int). (n1,int_beg1,int_end1) = get_intervals_ct ct ∧ (n2,int_beg2,int_end2) = get_intervals (fix_domination (get_live_tree ct)) (0 :int) (LN :int sptree$num_map) (LN :int sptree$num_map) ⇒ (∀(r :num). lookup r int_beg1 = lookup r int_beg2) ∧ ∀(r :num). lookup r int_end1 = lookup r int_end2
color_register_eq_typed=∀(st :linear_scan_state) (reg :num) (col :num) (rend :int). color_register st reg col rend = st_ex_ignore_bind (update_colors reg col) (st_ex_return (st with <|active updated_by add_active_interval (rend,reg); phyregs := if is_phy_var reg then insert col () st.phyregs else st.phyregs|>) :linear_scan_hidden_state -> (linear_scan_state, state_exn) exc # linear_scan_hidden_state)
color_register_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (reg :num) (col :num) (forbidden :sptree$num_set) (mincol :num). good_linear_scan_state st sth l pos forced mincol ∧ forbidden_is_from_map_color_forced forced l sth.colors reg forbidden ∧ col ∉ (domain forbidden :num -> bool) ∧ (is_phy_var reg ⇒ (domain st.phyregs :num -> bool) ⊆ (domain forbidden :num -> bool)) ∧ ¬MEM col (st.colorpool ++ MAP (λ((e :int),(r :num)). sth.colors❲r❳) st.active) ∧ sth.int_beg❲reg❳ = pos ∧ sth.int_beg❲reg❳ ≤ sth.int_end❲reg❳ ∧ col < st.colornum ∧ mincol ≤ col ∧ reg < LENGTH sth.colors ∧ ¬MEM reg l ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = color_register st reg col sth.int_end❲reg❳ sth ∧ good_linear_scan_state stout sthout (reg::l) pos forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). r ≠ reg ⇒ sth.colors❲r❳ = sthout.colors❲r❳) ∧ stout.colormax = st.colormax
find_last_stealable_output_typed=∀(forbidden :sptree$num_set) (sth :linear_scan_hidden_state) (active :(α # num) list) (steal :α # num) (rest :(α # num) list). find_last_stealable active forbidden sth = ((M_success (SOME (steal,rest)) :(((α # num) # (α # num) list) option, state_exn) exc),sth) ⇒ ¬is_phy_var (SND steal) ∧ lookup sth.colors❲SND steal❳ forbidden = (NONE :unit option) ∧ ∃(l1 :(α # num) list) (l2 :(α # num) list). rest = l1 ++ l2 ∧ active = l1 ++ steal::l2
find_last_stealable_success_typed=∀(forbidden :sptree$num_set) (sth :linear_scan_hidden_state) (active :(α # num) list). EVERY (λ((e :α),(r :num)). r < LENGTH sth.colors) active ⇒ ∃(optout :((α # num) # (α # num) list) option). find_last_stealable active forbidden sth = ((M_success optout :(((α # num) # (α # num) list) option, state_exn) exc),sth)
find_spill_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (forbidden :sptree$num_set) (forced :(num # num) list) (reg :num) (force :bool) (mincol :num). ¬MEM reg l ∧ good_linear_scan_state st sth l sth.int_beg❲reg❳ forced mincol ∧ reg < LENGTH sth.colors ∧ forbidden_is_from_map_color_forced forced l sth.colors reg forbidden ∧ (is_phy_var reg ⇒ (domain st.phyregs :num -> bool) ⊆ (domain forbidden :num -> bool)) ∧ sth.int_beg❲reg❳ ≤ sth.int_end❲reg❳ ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = find_spill st forbidden reg sth.int_end❲reg❳ force sth ∧ good_linear_scan_state stout sthout (reg::l) sth.int_beg❲reg❳ forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). ¬MEM r (reg::l) ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (∀(r :num). MEM r l ∧ is_phy_var r ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ stout.colormax = st.colormax
good_linear_scan_state_active_length_colors_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (pos :int) (forced :(num # num) list) (mincol :num). good_linear_scan_state st sth l pos forced mincol ⇒ EVERY (λ((e :int),(r :num)). r < LENGTH sth.colors) st.active
linear_reg_alloc_step_aux_invariants_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (l :num list) (preferred :num list) (forbidden :sptree$num_set) (forced :(num # num) list) (reg :num) (force :bool) (mincol :num). ¬MEM reg l ∧ good_linear_scan_state st sth l sth.int_beg❲reg❳ forced mincol ∧ reg < LENGTH sth.colors ∧ forbidden_is_from_map_color_forced forced l sth.colors reg forbidden ∧ (is_phy_var reg ⇒ (domain st.phyregs :num -> bool) ⊆ (domain forbidden :num -> bool)) ∧ (domain forbidden :num -> bool) ⊆ {sth.colors❲r❳ | MEM r l} ∧ sth.int_beg❲reg❳ ≤ sth.int_end❲reg❳ ⇒ ∃(stout :linear_scan_state) (sthout :linear_scan_hidden_state). ((M_success stout :(linear_scan_state, state_exn) exc),sthout) = linear_reg_alloc_step_aux st forbidden preferred reg sth.int_end❲reg❳ force sth ∧ good_linear_scan_state stout sthout (reg::l) sth.int_beg❲reg❳ forced mincol ∧ LENGTH sthout.colors = LENGTH sth.colors ∧ sthout.int_beg = sth.int_beg ∧ sthout.int_end = sth.int_end ∧ (∀(r :num). ¬MEM r (reg::l) ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ (∀(r :num). MEM r l ∧ is_phy_var r ⇒ sthout.colors❲r❳ = sth.colors❲r❳) ∧ stout.colormax = st.colormax
st_ex_MAP_colors_sub_typed=∀(l :num list) (sth :linear_scan_hidden_state). EVERY (λ(r :num). r < LENGTH sth.colors) l ⇒ st_ex_MAP colors_sub l sth = ((M_success (MAP (λ(r :num). sth.colors❲r❳) l) :(num list, state_exn) exc),sth)
state_invariants_remove_head_typed=∀(st :linear_scan_state) (sth :linear_scan_hidden_state) (reg :num) (l :num list) (pos :int) (forced :(num # num) list) (mincol :num). MEM reg l ∧ good_linear_scan_state st sth (reg::l) pos forced mincol ⇒ good_linear_scan_state st sth l pos forced mincol
edges_to_adjlist_FOLDL_typed=∀(forced :(num # num) list) (sth :linear_scan_hidden_state) (acc :num list sptree$num_map). EVERY (λ((r1 :num),(r2 :num)). r1 < LENGTH sth.int_beg ∧ r2 < LENGTH sth.int_beg) forced ⇒ edges_to_adjlist forced acc sth = ((M_success (FOLDL (λ(acc :num list sptree$num_map) (pair :num # num). edges_to_adjlist_step sth pair acc) acc forced) :(num list sptree$num_map, state_exn) exc),sth)
edges_to_adjlist_FOLDR_output_typed=∀(forced :(num # num) list) (sth :linear_scan_hidden_state) (reg :num). forbidden_is_from_forced forced sth.int_beg reg (the ([] :num list) (lookup reg (FOLDR (λ(pair :num # num) (acc :num list sptree$num_map). edges_to_adjlist_step sth pair acc) (LN :num list sptree$num_map) forced)))
edges_to_adjlist_output_typed=∀(forced :(num # num) list) (sth :linear_scan_hidden_state). EVERY (λ((r1 :num),(r2 :num)). r1 < LENGTH sth.int_beg ∧ r2 < LENGTH sth.int_beg) forced ⇒ ∃(adjlist :num list sptree$num_map). edges_to_adjlist forced (LN :num list sptree$num_map) sth = ((M_success adjlist :(num list sptree$num_map, state_exn) exc),sth) ∧ ∀(reg :num). forbidden_is_from_forced forced sth.int_beg reg (the ([] :num list) (lookup reg adjlist))
edges_to_adjlist_step_def_typed=∀(sth :linear_scan_hidden_state) (a :num) (b :num) (acc :num list sptree$num_map). edges_to_adjlist_step sth (a,b) acc = if a = b then acc else if ($< LEX $<=) (sth.int_beg❲a❳,a) (sth.int_beg❲b❳,b) then insert b (a::the ([] :num list) (lookup b acc)) acc else insert a (b::the ([] :num list) (lookup a acc)) acc
forbidden_is_from_forced_def_typed=∀(forced :(num # num) list) (int_beg :int list) (reg :num) (forbidden :num list). forbidden_is_from_forced forced int_beg reg forbidden ⇔ ∀(reg2 :num). reg ≠ reg2 ∧ (MEM (reg2,reg) forced ∨ MEM (reg,reg2) forced) ∧ ($< LEX $<=) (int_beg❲reg2❳,reg2) (int_beg❲reg❳,reg) ⇔ MEM reg2 forbidden
