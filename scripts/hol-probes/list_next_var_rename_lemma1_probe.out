lnvr1_original_statement=∀ls ssa na ls' ssa' na'. list_next_var_rename ls ssa na = (ls',ssa',na') ⇒ (let len = LENGTH ls in ALL_DISTINCT ls' ∧ ls' = MAP (λx. 4 * x + na) (COUNT_LIST len) ∧ na' = na + 4 * len)
