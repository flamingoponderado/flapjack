ml_32=∀jump off k s t a x. state_rel jump off k s t ∧ mem_load_32 s.memory s.mdomain s.be a = SOME x ⇒ mem_load_32 t.memory t.mdomain t.be a = SOME x
ml_32_types=jump:bool;off:α word # α word;k:num;s:(α, β, γ) stackSem$state;t:(α, β, γ) stackSem$state;a:α word;x:word32
ml_32_proved=T
ml_byte=∀jump off k s t a x. state_rel jump off k s t ∧ mem_load_byte_aux s.memory s.mdomain s.be a = SOME x ⇒ mem_load_byte_aux t.memory t.mdomain t.be a = SOME x
ml_byte_types=jump:bool;off:α word # α word;k:num;s:(α, β, γ) stackSem$state;t:(α, β, γ) stackSem$state;a:α word;x:word8
ml_byte_proved=T
