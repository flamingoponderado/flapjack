not_skip_def_statement=∀(l :α line).
  not_skip l ⇔
  case l of
    (Label v10 v11 v12 :α line) => T
  | Asm (Asmi (Inst (Skip :α inst))) v14 v15 => F
  | Asm (Asmi (Inst (Const v59 v60))) v14 v15 => T
  | Asm (Asmi (Inst (Arith v61 :α inst))) v14 v15 => T
  | Asm (Asmi (Inst (Mem v62 v63 v64))) v14 v15 => T
  | Asm (Asmi (Inst (FP v65 :α inst))) v14 v15 => T
  | Asm (Asmi (Jump v43 :α asm)) v14 v15 => T
  | Asm (Asmi (JumpCmp v44 v45 v46 v47 :α asm)) v14 v15 => T
  | Asm (Asmi (Call v48 :α asm)) v14 v15 => T
  | Asm (Asmi (JumpReg v49 :α asm)) v14 v15 => T
  | Asm (Asmi (Loc v50 v51)) v14 v15 => T
  | Asm (Cbw v27 v28 :α asm_or_cbw) v14 v15 => T
  | Asm (ShareMem v29 v30 v31) v14 v15 => T
  | LabAsm v16 v17 v18 v19 => T
not_skip_def_types=(l :α line)::α line;
not_skip_def_hypotheses=0
not_skip_def_proved=T
filter_skip_def_statement=filter_skip ([] :α sec list) = ([] :α sec list) ∧
∀(xs :α line list) (rest :α sec list) (n :num).
  filter_skip (Section n xs::rest) =
  Section n (FILTER (not_skip :α line -> bool) xs)::filter_skip rest
filter_skip_def_types=
filter_skip_def_hypotheses=0
filter_skip_def_proved=T
filter_skip_MAP_statement=∀(ls :α sec list).
  filter_skip ls =
  MAP
    (λ(x :α sec).
         case x of
           Section n xs => Section n (FILTER (not_skip :α line -> bool) xs))
    ls
filter_skip_MAP_types=(ls :α sec list)::α sec list;
filter_skip_MAP_hypotheses=0
filter_skip_MAP_proved=T
