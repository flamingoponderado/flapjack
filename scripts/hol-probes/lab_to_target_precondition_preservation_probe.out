enc_lines_again_all_enc_ok_pre=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (lines :α line list) (acc :α line list)
    (ok :bool) (res :α line list) (ok' :num # bool) (c :α asm_config).
  enc_lines_again labs ffis pos enc lines (acc,ok) = (res,ok') ∧
  EVERY (line_ok_pre c) lines ∧ EVERY (line_ok_pre c) acc ⇒
  EVERY (line_ok_pre c) res
enc_lines_again_all_enc_ok_pre_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α line list)::α line list;(acc :α line list)::α line list;(ok :bool)::bool;(res :α line list)::α line list;(ok' :num # bool)::num # bool;(c :α asm_config)::α asm_config;
enc_lines_again_all_enc_ok_pre_hypotheses=0
enc_secs_again_all_enc_ok_pre=∀(pos :num) (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (enc :α asm -> word8 list) (ls :α sec list) (res :α sec list) (ok :bool)
    (c :α asm_config).
  enc_secs_again pos labs ffis enc ls = (res,ok) ∧ all_enc_ok_pre c ls ⇒
  all_enc_ok_pre c res
enc_secs_again_all_enc_ok_pre_types=(pos :num)::num;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(enc :α asm -> word8 list)::α asm -> word8 list;(ls :α sec list)::α sec list;(res :α sec list)::α sec list;(ok :bool)::bool;(c :α asm_config)::α asm_config;
enc_secs_again_all_enc_ok_pre_hypotheses=0
line_ok_pre_add_nop=EVERY (line_ok_pre (c :α asm_config)) (xs :α line list) ⇒
EVERY (line_ok_pre c) (add_nop (nop :word8 list) xs)
line_ok_pre_add_nop_types=(nop :word8 list)::word8 list;(xs :α line list)::α line list;(c :α asm_config)::α asm_config;
line_ok_pre_add_nop_hypotheses=0
line_ok_pre_pad_section=∀(nop :word8 list) (xs :α line list) (acc :α line list) (c :α asm_config).
  EVERY (line_ok_pre c) xs ∧ EVERY (line_ok_pre c) acc ⇒
  EVERY (line_ok_pre c) (pad_section nop xs acc)
line_ok_pre_pad_section_types=(nop :word8 list)::word8 list;(xs :α line list)::α line list;(acc :α line list)::α line list;(c :α asm_config)::α asm_config;
line_ok_pre_pad_section_hypotheses=0
all_enc_ok_pre_pad_code=∀(nop :word8 list) (code :α sec list) (c :α asm_config).
  all_enc_ok_pre c code ⇒ all_enc_ok_pre c (pad_code nop code)
all_enc_ok_pre_pad_code_types=(nop :word8 list)::word8 list;(code :α sec list)::α sec list;(c :α asm_config)::α asm_config;
all_enc_ok_pre_pad_code_hypotheses=0
all_enc_ok_pre_lines_upd_lab_len=∀(n :num) (lines :α line list) (acc :α line list).
  EVERY (line_ok_pre (c :α asm_config)) lines ∧ EVERY (line_ok_pre c) acc ⇒
  EVERY (line_ok_pre c) (FST (lines_upd_lab_len n lines acc))
all_enc_ok_pre_lines_upd_lab_len_types=(n :num)::num;(lines :α line list)::α line list;(acc :α line list)::α line list;(c :α asm_config)::α asm_config;
all_enc_ok_pre_lines_upd_lab_len_hypotheses=0
all_enc_ok_pre_upd_lab_len=∀(n :num) (code :α sec list).
  all_enc_ok_pre (c :α asm_config) code ⇒
  all_enc_ok_pre c (upd_lab_len n code)
all_enc_ok_pre_upd_lab_len_types=(n :num)::num;(code :α sec list)::α sec list;(c :α asm_config)::α asm_config;
all_enc_ok_pre_upd_lab_len_hypotheses=0
