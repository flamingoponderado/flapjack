compile_correct_full_statement=∀p s res s' ctxt. evaluate (p,s) = (res,s') ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ struct_infos_ok s.structs ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ res ≠ SOME Error ⇒ evaluate (compile ctxt p,convert_s ctxt s) = (convert_res res,convert_s ctxt s') ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.locals ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s'.globals ∧ (is_cont_res res ⇒ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s'.locals) ∧ EVERY (v_flds_ok s'.structs) (res_vs res) ∧ EVERY (is_wf_shape_v s'.structs) (res_vs res)
compile_correct_full_proved=T
compile_correct_while_statement=∀e c1 s res s' ctxt. evaluate (While e c1,s) = (res,s') ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.locals ∧ FEVERY (λ(nm,v). is_wf_shape_v s.structs v) s.globals ∧ struct_infos_ok s.structs ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ res ≠ SOME Error ⇒ evaluate (compile ctxt (While e c1),convert_s ctxt s) = (convert_res res,convert_s ctxt s') ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.locals ∧ FEVERY (λ(nm,v). v_flds_ok s'.structs v) s'.globals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s'.globals ∧ (is_cont_res res ⇒ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s'.locals) ∧ EVERY (v_flds_ok s'.structs) (res_vs res) ∧ EVERY (is_wf_shape_v s'.structs) (res_vs res)
compile_correct_while_proved=T
compile_correct_full_types=p::α panLang$prog;s::(α, β) state;res::α result option;s'::(α, β) state;ctxt::context
compile_correct_while_types=e::α panLang$exp;c1::α panLang$prog;s::(α, β) state;res::α result option;s'::(α, β) state;ctxt::context
evaluate_ind_statement=∀P. (∀s. P (Skip,s)) ∧ (∀v sh e prog s. (∀value. eval s e = SOME value ∧ sh = shape_of value ⇒ P (prog,s with locals := s.locals⟨v ↦ value⟩)) ⇒ P (Dec v sh e prog,s)) ∧ (∀vk v src s. P (Assign vk v src,s)) ∧ (∀v pop es s. P (Primitive v pop es,s)) ∧ (∀dst src s. P (Store dst src,s)) ∧ (∀dst src s. P (Store32 dst src,s)) ∧ (∀dst src s. P (StoreByte dst src,s)) ∧ (∀op vk v ad s. P (ShMemLoad op vk v ad,s)) ∧ (∀op ad e s. P (ShMemStore op ad e,s)) ∧ (∀c1 c2 s. (∀res s1. (res,s1) = evaluate (c1,s) ∧ res = NONE ⇒ P (c2,s1)) ∧ P (c1,s) ⇒ P (Seq c1 c2,s)) ∧ (∀e c1 c2 s. (∀v1 v6 w. eval s e = SOME v1 ∧ v1 = Val v6 ∧ v6 = Word w ⇒ P (if w ≠ 0w then c1 else c2,s)) ⇒ P (If e c1 c2,s)) ∧ (∀s. P (Break,s)) ∧ (∀s. P (Continue,s)) ∧ (∀e c s. (∀v2 v11 w res s1 v1. eval s e = SOME v2 ∧ v2 = Val v11 ∧ v11 = Word w ∧ w ≠ 0w ∧ s.clock ≠ 0 ∧ (res,s1) = evaluate (c,dec_clock s) ∧ res = SOME v1 ∧ v1 = Continue ⇒ P (While e c,s1)) ∧ (∀v2 v11 w res s1. eval s e = SOME v2 ∧ v2 = Val v11 ∧ v11 = Word w ∧ w ≠ 0w ∧ s.clock ≠ 0 ∧ (res,s1) = evaluate (c,dec_clock s) ∧ res = NONE ⇒ P (While e c,s1)) ∧ (∀v2 v11 w. eval s e = SOME v2 ∧ v2 = Val v11 ∧ v11 = Word w ∧ w ≠ 0w ∧ s.clock ≠ 0 ⇒ P (c,dec_clock s)) ⇒ P (While e c,s)) ∧ (∀e s. P (Return e,s)) ∧ (∀eid e s. P (Raise eid e,s)) ∧ (∀s. P (Tick,s)) ∧ (∀v0 v1 s. P (Annot v0 v1,s)) ∧ (∀caltyp fname argexps s. (∀args v7 prog v12 newlocals return_sh eval_prog v4 st v8 eid exn v v1 v2 v3 eid' v5 evar p sh. OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v7 ∧ v7 = (prog,v12) ∧ v12 = (newlocals,return_sh) ∧ s.clock ≠ 0 ∧ eval_prog = evaluate (prog,dec_clock s with locals := newlocals) ∧ eval_prog = (v4,st) ∧ v4 = SOME v8 ∧ v8 = Exception eid exn ∧ caltyp = SOME v ∧ v = (v1,v2) ∧ v2 = SOME v3 ∧ v3 = (eid',v5) ∧ v5 = (evar,p) ∧ eid = eid' ∧ FLOOKUP s.eshapes eid = SOME sh ∧ shape_of exn = sh ∧ is_valid_value s Local evar exn ⇒ P (p,set_var evar exn (st with locals := s.locals))) ∧ (∀args v7 prog v12 newlocals return_sh. OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v7 ∧ v7 = (prog,v12) ∧ v12 = (newlocals,return_sh) ∧ s.clock ≠ 0 ⇒ P (prog,dec_clock s with locals := newlocals)) ⇒ P (Call caltyp fname argexps,s)) ∧ (∀rt shape fname argexps prog1 s. (∀args v2 prog v7 newlocals return_sh eval_prog v st v3 retv. OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v2 ∧ v2 = (prog,v7) ∧ v7 = (newlocals,return_sh) ∧ s.clock ≠ 0 ∧ eval_prog = evaluate (prog,dec_clock s with locals := newlocals) ∧ eval_prog = (v,st) ∧ v = SOME v3 ∧ v3 = Return retv ∧ shape_of retv = shape ∧ shape_of retv = return_sh ⇒ P (prog1,set_var rt retv (st with locals := s.locals))) ∧ (∀args v2 prog v7 newlocals return_sh. OPT_MMAP (eval s) argexps = SOME args ∧ lookup_code s.code fname args = SOME v2 ∧ v2 = (prog,v7) ∧ v7 = (newlocals,return_sh) ∧ s.clock ≠ 0 ⇒ P (prog,dec_clock s with locals := newlocals)) ⇒ P (DecCall rt shape fname argexps prog1,s)) ∧ (∀ffi_index ptr1 len1 ptr2 len2 s. P (ExtCall ffi_index ptr1 len1 ptr2 len2,s)) ⇒ ∀v v1. P (v,v1)
evaluate_ind_proved=T
evaluate_ind_types=P::α panLang$prog # (α, 'ffi) state -> bool
