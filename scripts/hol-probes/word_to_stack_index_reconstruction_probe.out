ir_full_index_list_eq_ZIP=⊢ index_list xs k = ZIP (REVERSE (MAP ($+ k) (COUNT_LIST (LENGTH xs))),xs)
ir_full_MEM_index_list_LIM=⊢ ∀ls n v k. MEM (n,v) (index_list ls k) ⇒ n − k < LENGTH ls
ir_full_MEM_index_list_EL=⊢ ∀ls n v. MEM (n,v) (index_list ls k) ⇒ ls❲LENGTH ls − (n − k + 1)❳ = v
ir_full_ALOOKUP_index_list=⊢ ∀ls n. n < LENGTH ls + k ⇒ ALOOKUP (index_list ls k) n = LLOOKUP ls (LENGTH ls + k − (n + 1))
ir_output_0_0=⊢ index_list [] 0 = [] ⇔ T
ir_recover_0_0=⊢ MAP (λp. (FST p,SND p,SOME []❲LENGTH [] − (FST p − 0 + 1)❳)) (index_list [] 0) = [] ⇔ T
ir_lookup_0_0_0=⊢ (ALOOKUP (index_list [] 0) 0,LLOOKUP [] (LENGTH [] + 0 − (0 + 1)),0 < LENGTH [] + 0) = (NONE,NONE,F) ⇔ T
