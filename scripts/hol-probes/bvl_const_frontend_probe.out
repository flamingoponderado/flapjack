dest_simple=dest_simple (Op (IntOp (Const (i :int))) (xs :exp list) :exp) = (if NULL xs then SOME i else (NONE :int option)) ∧ dest_simple (Var (v :num) :exp) = (NONE :int option) ∧ dest_simple (If (v1 :exp) (v2 :exp) (v3 :exp) :exp) = (NONE :int option) ∧ dest_simple (Let (v4 :exp list) (v5 :exp) :exp) = (NONE :int option) ∧ dest_simple (Raise (v6 :exp) :exp) = (NONE :int option) ∧ dest_simple (Handle (v7 :exp) (v8 :exp) :exp) = (NONE :int option) ∧ dest_simple (Tick (v9 :exp) :exp) = (NONE :int option) ∧ dest_simple (Call (v10 :num) (v11 :num option) (v12 :exp list) :exp) = (NONE :int option) ∧ dest_simple (Force (v13 :num) (v14 :num) :exp) = (NONE :int option) ∧ dest_simple (Op (Label (v34 :num)) (v16 :exp list) :exp) = (NONE :int option) ∧ dest_simple (Op (FFI (v35 :mlstring) :op) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Add) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Sub) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Mult) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Div) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Mod) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Less) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp LessEq) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp Greater) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp GreaterEq) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (IntOp (LessConstSmall (v51 :num))) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (WordOp (v37 :word_op)) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (BlockOp (v38 :block_op)) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (GlobOp (v39 :glob_op)) v16 :exp) = (NONE :int option) ∧ dest_simple (Op (MemOp (v40 :mem_op)) v16 :exp) = (NONE :int option) ∧ dest_simple (Op Install v16 :exp) = (NONE :int option) ∧ dest_simple (Op (ThunkOp (v41 :thunk_op) :op) v16 :exp) = (NONE :int option)
case_op_const=∀(exp :exp). case_op_const exp = case exp of (Var v17 :exp) => (NONE :(op # exp # int) option) | (If v18 v19 v20 :exp) => (NONE :(op # exp # int) option) | (Let v21 v22 :exp) => (NONE :(op # exp # int) option) | (Raise v23 :exp) => (NONE :(op # exp # int) option) | (Handle v24 v25 :exp) => (NONE :(op # exp # int) option) | (Tick v26 :exp) => (NONE :(op # exp # int) option) | (Call v27 v28 v29 :exp) => (NONE :(op # exp # int) option) | (Force v30 v31 :exp) => (NONE :(op # exp # int) option) | (Op op ([] :exp list) :exp) => (NONE :(op # exp # int) option) | (Op op [x1] :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Var v59 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(If v60 v61 v62 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Let v63 v64 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Raise v65 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Handle v66 v67 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Tick v68 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Call v69 v70 v71 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Force v72 v73 :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (Label v84) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (FFI v85 :op) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op [x1; (Op (IntOp (Const n2)) l :exp)] :exp) => if NULL l then SOME (op,x1,n2) else (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp (Const n2)) l :exp)::v98::v99) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Add) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Sub) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Mult) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Div) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Mod) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Less) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp LessEq) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp Greater) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp GreaterEq) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (IntOp (LessConstSmall v95)) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (WordOp v87) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (BlockOp v88) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (GlobOp v89) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (MemOp v90) l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op Install l :exp)::v41) :exp) => (NONE :(op # exp # int) option) | (Op op (x1::(Op (ThunkOp v91 :op) l :exp)::v41) :exp) => (NONE :(op # exp # int) option)
SmartOp_flip=∀(op :op) (x1 :exp) (x2 :exp). SmartOp_flip op x1 x2 = case dest_simple x1 of (NONE :int option) => (op,x1,x2) | SOME i => if MEM op [IntOp Add; IntOp Mult] then (op,x2,x1) else if op = IntOp Sub then (IntOp Add,x2,(Op (IntOp (Const (-i))) ([] :exp list) :exp)) else (op,x1,x2)
SmartOp2=∀(op :op) (x1 :exp) (x2 :exp). SmartOp2 (op,x1,x2) = (let (mk_add_const :exp -> int -> exp) (x1 :exp) (c2 :int) = if c2 = (0 :int) then x1 else (Op (IntOp Add) [x1; (Op (IntOp (Const c2)) ([] :exp list) :exp)] :exp); (mk_add :exp -> exp -> exp) (x1 :exp) (x2 :exp) = (let (default :exp) = (Op (IntOp Add) [x1; x2] :exp) in case dest_simple x2 of (NONE :int option) => (case (case_op_const x1,case_op_const x2) of ((NONE :(op # exp # int) option),v3) => default | (SOME v5,(NONE :(op # exp # int) option)) => default | (SOME (op1,x11,n12),SOME (op2,x21,n22)) => if op1 = IntOp Add ∧ op2 = IntOp Add then mk_add_const (Op (IntOp Add) [x11; x21] :exp) (n22 + n12) else if op1 = IntOp Add ∧ op2 = IntOp Sub then (Op (IntOp Sub) [(Op (IntOp Sub) [x11; x21] :exp); (Op (IntOp (Const (n22 + n12))) ([] :exp list) :exp)] :exp) else if op1 = IntOp Sub ∧ op2 = IntOp Add then mk_add_const (Op (IntOp Sub) [x11; x21] :exp) (n22 + n12) else default) | SOME n2 => case case_op_const x1 of (NONE :(op # exp # int) option) => (case dest_simple x1 of (NONE :int option) => mk_add_const x1 n2 | SOME n1 => (Op (IntOp (Const (n2 + n1))) ([] :exp list) :exp)) | SOME (IntOp Add,x11,n12) => mk_add_const x11 (n2 + n12) | SOME (IntOp Sub,x11,n12) => (Op (IntOp Sub) [x11; (Op (IntOp (Const (n2 + n12))) ([] :exp list) :exp)] :exp) | SOME (op,x11,n12) => default); (mk_sub :exp -> exp -> exp) (x1 :exp) (x2 :exp) = (let (default :exp) = (Op (IntOp Sub) [x1; x2] :exp) in case dest_simple x2 of (NONE :int option) => (case (case_op_const x1,case_op_const x2) of ((NONE :(op # exp # int) option),v3) => default | (SOME v5,(NONE :(op # exp # int) option)) => default | (SOME (op1,x11,n12),SOME (op2,x21,n22)) => if op1 = IntOp Add ∧ op2 = IntOp Add then (Op (IntOp Add) [(Op (IntOp Sub) [x11; x21] :exp); (Op (IntOp (Const (n22 − n12))) ([] :exp list) :exp)] :exp) else if op1 = IntOp Add ∧ op2 = IntOp Sub then (Op (IntOp Sub) [(Op (IntOp Add) [x11; x21] :exp); (Op (IntOp (Const (n22 − n12))) ([] :exp list) :exp)] :exp) else if op1 = IntOp Sub ∧ op2 = IntOp Add then mk_add_const (Op (IntOp Add) [x11; x21] :exp) (n22 − n12) else default) | SOME n2 => case case_op_const x1 of (NONE :(op # exp # int) option) => (case dest_simple x1 of (NONE :int option) => default | SOME n1 => (Op (IntOp (Const (n2 − n1))) ([] :exp list) :exp)) | SOME (IntOp Add,x11,n12) => (Op (IntOp Sub) [x11; (Op (IntOp (Const (n2 − n12))) ([] :exp list) :exp)] :exp) | SOME (IntOp Sub,x11,n12) => mk_add_const x11 (n2 − n12) | SOME (op,x11,n12) => default); (mk_mul :exp -> exp -> exp) (x1 :exp) (x2 :exp) = (let (default :exp) = (Op (IntOp Mult) [x1; x2] :exp) in case dest_simple x2 of (NONE :int option) => (case (case_op_const x1,case_op_const x2) of ((NONE :(op # exp # int) option),v3) => default | (SOME v5,(NONE :(op # exp # int) option)) => default | (SOME (op1,x11,n12),SOME (op2,x21,n22)) => if op1 = IntOp Mult ∧ op2 = IntOp Mult then (Op (IntOp Mult) [(Op (IntOp (Const (n22 * n12))) ([] :exp list) :exp); (Op (IntOp Mult) [x11; x21] :exp)] :exp) else default) | SOME n2 => case case_op_const x1 of (NONE :(op # exp # int) option) => (case dest_simple x1 of (NONE :int option) => if n2 = (1 :int) then x1 else if n2 = -(1 :int) then mk_sub x1 (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) else default | SOME n1 => (Op (IntOp (Const (n2 * n1))) ([] :exp list) :exp)) | SOME (IntOp Mult,x11,n12) => (Op (IntOp Mult) [x11; (Op (IntOp (Const (n2 * n12))) ([] :exp list) :exp)] :exp) | SOME (op,x11,n12) => default); (default :exp) = (Op op [x1; x2] :exp) in if op = IntOp Add then mk_add x1 x2 else if op = IntOp Sub then mk_sub x1 x2 else if op = IntOp Mult then mk_mul x1 x2 else if MEM op [IntOp Div; IntOp Mod; IntOp Less; IntOp LessEq; IntOp Greater; IntOp GreaterEq] then case (dest_simple x1,dest_simple x2) of ((NONE :int option),v3) => default | (SOME x1,(NONE :int option)) => default | (SOME x1,SOME x2) => case op of Label v8 => default | (FFI v9 :op) => default | IntOp (Const v18) => default | IntOp Add => default | IntOp Sub => default | IntOp Mult => default | IntOp Div => if x1 = (0 :int) then default else (Op (IntOp (Const (x2 / x1))) ([] :exp list) :exp) | IntOp Mod => if x1 = (0 :int) then default else (Op (IntOp (Const (x2 % x1))) ([] :exp list) :exp) | IntOp Less => Bool (x2 < x1) | IntOp LessEq => Bool (x2 ≤ x1) | IntOp Greater => Bool (x2 > x1) | IntOp GreaterEq => Bool (x2 ≥ x1) | IntOp (LessConstSmall v19) => default | WordOp v11 => default | BlockOp v12 => default | GlobOp v13 => default | MemOp v14 => default | Install => default | (ThunkOp v15 :op) => default else if op = BlockOp Equal then case (dest_simple x1,dest_simple x2) of ((NONE :int option),(NONE :int option)) => default | ((NONE :int option),SOME v8) => (Op (BlockOp (EqualConst (Int v8))) [x1] :exp) | (SOME i,(NONE :int option)) => (Op (BlockOp (EqualConst (Int i))) [x2] :exp) | (SOME i,SOME j) => Bool (j = i) else if op = MemOp El then case dest_simple x1 of (NONE :int option) => default | SOME i => if i < (0 :int) then default else mk_elem_at x2 (Num i) else default)
SmartOp1=∀(op :op) (x :exp). SmartOp1 op x = case dest_EqualInt op of (NONE :int option) => (Op op [x] :exp) | SOME i => case dest_simple x of (NONE :int option) => (Op op [x] :exp) | SOME j => Bool (j = i)
SmartOp=∀(op :op) (xs :exp list). SmartOp op xs = case xs of ([] :exp list) => (Op op xs :exp) | [x1] => SmartOp1 op x1 | [x1; x2] => SmartOp2 (SmartOp_flip op x1 x2) | x1::x2::v10::v11 => (Op op xs :exp)
extract=(extract (Var (n :num) :exp) (ys :α list) :exp option) = SOME (Var (n + LENGTH ys + (1 :num)) :exp) ∧ (extract (Op (IntOp (Const (i :int))) (xs :exp list) :exp) ys :exp option) = SOME (Op (IntOp (Const i)) ([] :exp list) :exp) ∧ (extract (Op (BlockOp (Cons (t :num) :block_op)) xs :exp) ys :exp option) = (if NULL xs then SOME (Op (BlockOp (Cons t :block_op)) ([] :exp list) :exp) else (NONE :exp option)) ∧ (extract (If (v4 :exp) (v5 :exp) (v6 :exp) :exp) (v1 :α list) :exp option) = (NONE :exp option) ∧ (extract (Let (v7 :exp list) (v8 :exp) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Raise (v9 :exp) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Handle (v10 :exp) (v11 :exp) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Tick (v12 :exp) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Call (v13 :num) (v14 :num option) (v15 :exp list) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Force (v16 :num) (v17 :num) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (Label (v37 :num)) (v19 :exp list) :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (FFI (v38 :mlstring) :op) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Add) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Sub) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Mult) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Div) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Mod) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Less) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp LessEq) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp Greater) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp GreaterEq) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (IntOp (LessConstSmall (v54 :num))) v19 :exp) v1 :exp option) = (NONE :exp option) ∧ (extract (Op (WordOp (v40 :w