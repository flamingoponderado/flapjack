extract_list=extract_list ([] :exp list) = ([] :exp option list) ∧ ∀(x :exp) (xs :exp list). extract_list (x::xs) = (extract x xs :exp option)::extract_list xs
delete_var=delete_var (Var (n :num) :exp) = (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) ∧ delete_var (If (v1 :exp) (v2 :exp) (v3 :exp) :exp) = (If v1 v2 v3 :exp) ∧ delete_var (Let (v4 :exp list) (v5 :exp) :exp) = (Let v4 v5 :exp) ∧ delete_var (Raise (v6 :exp) :exp) = (Raise v6 :exp) ∧ delete_var (Handle (v7 :exp) (v8 :exp) :exp) = (Handle v7 v8 :exp) ∧ delete_var (Tick (v9 :exp) :exp) = (Tick v9 :exp) ∧ delete_var (Call (v10 :num) (v11 :num option) (v12 :exp list) :exp) = (Call v10 v11 v12 :exp) ∧ delete_var (Force (v13 :num) (v14 :num) :exp) = (Force v13 v14 :exp) ∧ delete_var (Op (v15 :op) (v16 :exp list) :exp) = (Op v15 v16 :exp)
compile_sing=(∀(env :exp option list) (v :num). compile_sing env (Var v :exp) = case LLOOKUP env v of (NONE :exp option option) => (Var v :exp) | SOME (NONE :exp option) => (Var v :exp) | SOME (SOME (Var i :exp)) => (Var (v + i) :exp) | SOME (SOME (If v21 v22 v23 :exp)) => (If v21 v22 v23 :exp) | SOME (SOME (Let v24 v25 :exp)) => (Let v24 v25 :exp) | SOME (SOME (Raise v26 :exp)) => (Raise v26 :exp) | SOME (SOME (Handle v27 v28 :exp)) => (Handle v27 v28 :exp) | SOME (SOME (Tick v29 :exp)) => (Tick v29 :exp) | SOME (SOME (Call v30 v31 v32 :exp)) => (Call v30 v31 v32 :exp) | SOME (SOME (Force v33 v34 :exp)) => (Force v33 v34 :exp) | SOME (SOME (Op v35 v36 :exp)) => (Op v35 v36 :exp)) ∧ (∀(env :exp option list) (x1 :exp) (x2 :exp) (x3 :exp). compile_sing env (If x1 x2 x3 :exp) = (let (y1 :exp) = compile_sing env x1; (y2 :exp) = compile_sing env x2; (y3 :exp) = compile_sing env x3 in if y1 = Bool T then y2 else if y1 = Bool F then y3 else (If y1 y2 y3 :exp))) ∧ (∀(env :exp option list) (xs :exp list) (x2 :exp). compile_sing env (Let xs x2 :exp) = (let (ys :exp list) = compile_list env xs in (Let (MAP delete_var ys) (compile_sing (extract_list ys ++ env) x2) :exp))) ∧ (∀(env :exp option list) (x1 :exp) (x2 :exp). compile_sing env (Handle x1 x2 :exp) = (Handle (compile_sing env x1) (compile_sing ((NONE :exp option)::env) x2) :exp)) ∧ (∀(env :exp option list) (x1 :exp). compile_sing env (Raise x1 :exp) = (Raise (compile_sing env x1) :exp)) ∧ (∀(env :exp option list) (op :op) (xs :exp list). compile_sing env (Op op xs :exp) = SmartOp op (compile_list env xs)) ∧ (∀(env :exp option list) (x :exp). compile_sing env (Tick x :exp) = (Tick (compile_sing env x) :exp)) ∧ (∀(env :exp option list) (loc :num) (v :num). compile_sing env (Force loc v :exp) = case LLOOKUP env v of (NONE :exp option option) => (Force loc v :exp) | SOME (NONE :exp option) => (Force loc v :exp) | SOME (SOME (Var i :exp)) => (Force loc (v + i) :exp) | SOME (SOME (If v21 v22 v23 :exp)) => (Force loc v :exp) | SOME (SOME (Let v24 v25 :exp)) => (Force loc v :exp) | SOME (SOME (Raise v26 :exp)) => (Force loc v :exp) | SOME (SOME (Handle v27 v28 :exp)) => (Force loc v :exp) | SOME (SOME (Tick v29 :exp)) => (Force loc v :exp) | SOME (SOME (Call v30 v31 v32 :exp)) => (Force loc v :exp) | SOME (SOME (Force v33 v34 :exp)) => (Force loc v :exp) | SOME (SOME (Op v35 v36 :exp)) => (Force loc v :exp)) ∧ (∀(env :exp option list) (t :num) (dest :num option) (xs :exp list). compile_sing env (Call t dest xs :exp) = (Call t dest (compile_list env xs) :exp)) ∧ (∀(env :exp option list). compile_list env ([] :exp list) = ([] :exp list)) ∧ ∀(env :exp option list) (x :exp) (xs :exp list). compile_list env (x::xs) = compile_sing env x::compile_list env xs
compile_eq=(∀(e :exp) (env :exp option list). compile env [e] = [compile_sing env e]) ∧ ∀(es :exp list) (env :exp option list). compile env es = compile_list env es
compile_exp=∀(x :exp). compile_exp x = case compile ([] :exp option list) [x] of ([] :exp list) => (Var (0 :num) :exp) | y::v3 => y
compile_exp_eq=∀(x :exp). compile_exp x = compile_sing ([] :exp option list) x
