tenv_val_ok_nsEmpty_typed=tenv_val_ok (nsEmpty :(α, β, num # t) namespace)
tenv_ctor_ok_nsEmpty_typed=tenv_ctor_ok (nsEmpty :(α, β, mlstring list # t list # γ) namespace)
tenv_abbrev_ok_nsEmpty_typed=tenv_abbrev_ok (nsEmpty :(α, β, mlstring list # t) namespace)
tenv_ok_empty_typed=tenv_ok <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>
unchanged_tenv_typed=∀(tenv :type_env). <|v := tenv.v; c := tenv.c; t := tenv.t|> = tenv
deBruijn_subst_tenvE_def_typed=(∀(targs :t list). deBruijn_subst_tenvE targs Empty = Empty) ∧ (∀(targs :t list) (tvs :num) (env :tenv_val_exp). deBruijn_subst_tenvE targs (Bind_tvar tvs env) = Bind_tvar tvs (deBruijn_subst_tenvE targs env)) ∧ ∀(targs :t list) (x :mlstring) (tvs :num) (t :t) (env :tenv_val_exp). deBruijn_subst_tenvE targs (Bind_name x tvs t env) = Bind_name x tvs (deBruijn_subst (tvs + num_tvs env) (MAP (deBruijn_inc (0 :num) (tvs + num_tvs env)) targs) t) (deBruijn_subst_tenvE targs env)
db_merge_def_typed=(∀(e :tenv_val_exp). db_merge Empty e = e) ∧ (∀(tvs :num) (e1 :tenv_val_exp) (e2 :tenv_val_exp). db_merge (Bind_tvar tvs e1) e2 = Bind_tvar tvs (db_merge e1 e2)) ∧ ∀(x :mlstring) (tvs :num) (t :t) (e1 :tenv_val_exp) (e2 :tenv_val_exp). db_merge (Bind_name x tvs t e1) e2 = Bind_name x tvs t (db_merge e1 e2)
bind_tvar_rewrites_typed=(∀(tvs :num) (e1 :tenv_val_exp) (e2 :tenv_val_exp). db_merge (bind_tvar tvs e1) e2 = bind_tvar tvs (db_merge e1 e2)) ∧ (∀(tvs :num) (e :tenv_val_exp). num_tvs (bind_tvar tvs e) = tvs + num_tvs e) ∧ (∀(tvs :num) (e :tenv_val_exp). num_tvs (Bind_tvar tvs e) = tvs + num_tvs e) ∧ (∀(tvs :num) (n :mlstring) (t :t) (e :tenv_val_exp). num_tvs (Bind_name n tvs t e) = num_tvs e) ∧ (∀(tvs :α) (e :β). num_tvs Empty = (0 :num)) ∧ (∀(n :mlstring) (inc :num) (tvs :num) (e :tenv_val_exp). tveLookup n inc (bind_tvar tvs e) = tveLookup n (inc + tvs) e) ∧ (∀(tvs :num) (e :tenv_val_exp). tenv_val_exp_ok (bind_tvar tvs e) ⇔ tenv_val_exp_ok e) ∧ ∀(targs :t list) (tvs :num) (e :tenv_val_exp). deBruijn_subst_tenvE targs (bind_tvar tvs e) = bind_tvar tvs (deBruijn_subst_tenvE targs e)
bind_tvar0_typed=∀(x :tenv_val_exp). bind_tvar (0 :num) x = x
tveLookup_subst_none_typed=∀(n :mlstring) (inc :num) (e :tenv_val_exp). tveLookup n inc (deBruijn_subst_tenvE (targs :t list) e) = (NONE :(num # t) option) ⇔ tveLookup n inc e = (NONE :(num # t) option)
tveLookup_db_merge_none_typed=∀(n :mlstring) (inc :num) (e1 :tenv_val_exp) (e2 :tenv_val_exp). tveLookup n inc (db_merge e1 e2) = (NONE :(num # t) option) ⇔ tveLookup n inc e1 = (NONE :(num # t) option) ∧ tveLookup n (num_tvs e1 + inc) e2 = (NONE :(num # t) option)
tveLookup_inc_none_typed=∀(n :mlstring) (inc :num) (e :tenv_val_exp). tveLookup n inc e = (NONE :(num # t) option) ⇔ tveLookup n (0 :num) e = (NONE :(num # t) option)
bind_var_list_append_typed=∀(n :num) (te1 :(mlstring # t) list) (te2 :(mlstring # t) list) (te3 :tenv_val_exp). bind_var_list n (te1 ++ te2) te3 = bind_var_list n te1 (bind_var_list n te2 te3)
num_tvs_bind_var_list_typed=∀(tvs :num) (env :(mlstring # t) list) (tenvE :tenv_val_exp). num_tvs (bind_var_list tvs env tenvE) = num_tvs tenvE
tveLookup_bvl_typed=∀(x :mlstring) (tvs :num) (tvs' :num) (bindings :(mlstring # t) list) (tenvE :tenv_val_exp). tveLookup x tvs (bind_var_list tvs' bindings tenvE) = case ALOOKUP bindings x of (NONE :t option) => tveLookup x tvs tenvE | SOME t => SOME (tvs',deBruijn_inc tvs' tvs t)
num_tvs_db_merge_typed=∀(e1 :tenv_val_exp) (e2 :tenv_val_exp). num_tvs (db_merge e1 e2) = num_tvs e1 + num_tvs e2
num_tvs_deBruijn_subst_tenvE_typed=∀(targs :t list) (tenvE :tenv_val_exp). num_tvs (deBruijn_subst_tenvE targs tenvE) = num_tvs tenvE
tenv_val_exp_ok_db_merge_typed=∀(e1 :tenv_val_exp) (e2 :tenv_val_exp). tenv_val_exp_ok (db_merge e1 e2) ⇒ tenv_val_exp_ok e2
deBruijn_inc0_typed=(∀(t :t) (sk :num). deBruijn_inc sk (0 :num) t = t) ∧ ∀(ts :t list) (sk :num). MAP (deBruijn_inc sk (0 :num)) ts = ts
deBruijn_inc_deBruijn_inc_typed=∀(sk :num) (i2 :num) (t :t) (i1 :num). deBruijn_inc sk i1 (deBruijn_inc sk i2 t) = deBruijn_inc sk (i1 + i2) t
nil_deBruijn_inc_typed=∀(skip :num) (tvs :num) (t :t). check_freevars skip ([] :mlstring list) t ∨ check_freevars skip ([] :mlstring list) (deBruijn_inc skip tvs t) ⇒ deBruijn_inc skip tvs t = t
nil_deBruijn_subst_typed=∀(skip :num) (tvs :t list) (t :t). check_freevars skip ([] :mlstring list) t ⇒ deBruijn_subst skip tvs t = t
type_pes_def_typed=∀(tvs :num) (tvs' :num) (tenv :type_env) (tenvE :tenv_val_exp) (pes :(pat # exp) list) (t1 :t) (t2 :t). type_pes tvs tvs' tenv tenvE pes t1 t2 ⇔ ∀((p :pat),(e :exp))::set pes. ∃(bindings :(mlstring # t) list). ALL_DISTINCT (pat_bindings p) ∧ type_p tvs tenv p t1 bindings ∧ type_e tenv (bind_var_list tvs' bindings tenvE) e t2
type_es_list_rel_typed=∀(es :exp list) (ts :t list) (tenv :type_env) (tenvE :tenv_val_exp). type_es tenv tenvE es ts ⇔ LIST_REL (type_e tenv tenvE) es ts
add_tenvE_nsAppend_typed=∀(tenvE :tenv_val_exp) (tenvV :(α, mlstring, num # t) namespace). nsAppend (add_tenvE tenvE (nsEmpty :(α, mlstring, num # t) namespace)) tenvV = add_tenvE tenvE tenvV
type_ds_empty_typed=∀(check :bool) (tenv :type_env) (decls :num -> bool) (r :type_env). type_ds check tenv ([] :dec list) decls r ⇔ decls = (∅ :num -> bool) ∧ r = <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>
extend_dec_tenv_assoc_typed=∀(tenv1 :type_env) (tenv2 :type_env) (tenv3 :type_env). extend_dec_tenv tenv1 (extend_dec_tenv tenv2 tenv3) = extend_dec_tenv (extend_dec_tenv tenv1 tenv2) tenv3
type_ctor_long_typed=∀(ctMap :α |-> β # γ list # δ) (mn :ε) (id :(ε, ζ) id). type_ctor ctMap (Long mn id) = type_ctor ctMap id
deBruijn_subst_id_typed=(∀(t :t) (n :num). check_freevars n ([] :mlstring list) t ⇒ deBruijn_subst (0 :num) (MAP Tvar_db (COUNT_LIST n)) t = t) ∧ ∀(ts :t list) (n :num). EVERY (check_freevars n ([] :mlstring list)) ts ⇒ MAP (deBruijn_subst (0 :num) (MAP Tvar_db (COUNT_LIST n))) ts = ts
type_ps_length_typed=∀(tvs :num) (tenvC :type_env) (ps :pat list) (ts :t list) (tenv :(mlstring # t) list). type_ps tvs tenvC ps ts tenv ⇒ LENGTH ps = LENGTH ts
tenv_abbrev_ok_merge_typed=∀(tenvT1 :(α, β, mlstring list # t) namespace) (tenvT2 :(α, β, mlstring list # t) namespace). tenv_abbrev_ok tenvT1 ∧ tenv_abbrev_ok tenvT2 ⇒ tenv_abbrev_ok (nsAppend tenvT1 tenvT2)
tenv_ctor_ok_merge_typed=∀(tenvC1 :(α, β, mlstring list # t list # γ) namespace) (tenvC2 :(α, β, mlstring list # t list # γ) namespace). tenv_ctor_ok tenvC1 ∧ tenv_ctor_ok tenvC2 ⇒ tenv_ctor_ok (nsAppend tenvC1 tenvC2)
nsLookup_add_tenvE1_typed=∀(tenvE :tenv_val_exp) (tenvV :(α, mlstring, num # t) namespace) (n :mlstring) (tvs :num) (t :t) (tvs2 :num). check_freevars tvs2 ([] :mlstring list) t ∧ tveLookup n tvs tenvE = SOME (tvs2,t) ⇒ nsLookup (add_tenvE tenvE tenvV) (Short n :(α, mlstring) id) = SOME (tvs2,t)
nsLookup_add_tenvE2_typed=∀(tenvE :tenv_val_exp) (tenvV :(α, mlstring, num # t) namespace) (n :mlstring) (tvs :num) (t :t) (tvs2 :num). tveLookup n tvs tenvE = (NONE :(num # t) option) ∧ nsLookup tenvV (Short n :(α, mlstring) id) = SOME (tvs2,t) ⇒ nsLookup (add_tenvE tenvE tenvV) (Short n :(α, mlstring) id) = SOME (tvs2,t)
nsLookup_add_tenvE3_typed=∀(tenvE :tenv_val_exp) (tenvV :(α, mlstring, num # t) namespace) (n :(α, mlstring) id) (t :t) (tvs2 :num) (mn :α). nsLookup tenvV (Long mn n) = SOME (tvs2,t) ⇒ nsLookup (add_tenvE tenvE tenvV) (Long mn n) = SOME (tvs2,t)
db_merge_bvl_typed=∀(tenv1 :(mlstring # t) list) (tenv2 :tenv_val_exp) (tenv3 :tenv_val_exp) (tvs :num). db_merge (bind_var_list tvs tenv1 tenv2) tenv3 = bind_var_list tvs tenv1 (db_merge tenv2 tenv3)
tveLookup_add_inc_typed=∀(x :mlstring) (inc :num) (tenv :tenv_val_exp) (tvs :num) (t :t) (inc2 :num). tveLookup x inc tenv = SOME (tvs,t) ⇒ tveLookup x (inc2 + inc) tenv = SOME (tvs,deBruijn_inc tvs inc2 t)
tveLookup_db_merge_some_typed=∀(n :mlstring) (inc :num) (tenvE1 :tenv_val_exp) (tenvE2 :tenv_val_exp) (tvs :num) (t :t). tveLookup n inc (db_merge tenvE1 tenvE2) = SOME (tvs,t) ⇔ tveLookup n inc tenvE1 = SOME (tvs,t) ∨ tveLookup n inc tenvE1 = (NONE :(num # t) option) ∧ tveLookup n (num_tvs tenvE1 + inc) tenvE2 = SOME (tvs,t)
ctMap_ok_lookup_typed=∀(ctMap :stamp |-> mlstring list # t list # num) (cn :α) (tvs :mlstring list) (ts :t list) (ti :num) (tn :stamp). ctMap_ok ctMap ∧ FLOOKUP ctMap tn = SOME (tvs,ts,ti) ⇒ EVERY (check_freevars (0 :num) tvs) ts
tenv_ctor_ok_lookup_typed=∀(tenvC :(α, β, mlstring list # t list # γ) namespace) (cn :(α, β) id) (tvs :mlstring list) (ts :t list) (tn :γ). tenv_ctor_ok tenvC ∧ nsLookup tenvC cn = SOME (tvs,ts,tn) ⇒ EVERY (check_freevars (0 :num) tvs) ts
tenv_val_ok_add_tenvE_typed=∀(tenvE :tenv_val_exp) (tenvV :(α, mlstring, num # t) namespace). num_tvs tenvE = (0 :num) ∧ tenv_val_exp_ok tenvE ∧ tenv_val_ok tenvV ⇒ tenv_val_ok (add_tenvE tenvE tenvV)
add_tenvE_bvl_typed=∀(n :num) (bindings :(mlstring # t) list) (tenvE :tenv_val_exp) (tenvV :(α, mlstring, num # t) namespace). add_tenvE (bind_var_list n bindings tenvE) tenvV = nsBindList (MAP (λ((x :mlstring),(t :t)). (x,n,t)) bindings) (add_tenvE tenvE tenvV)
check_freevars_subst_list_typed=∀(dbmax :num) (tvs :mlstring list) (tvs' :mlstring list) (ts :t list) (ts' :t list). LENGTH tvs = LENGTH ts ∧ EVERY (check_freevars dbmax tvs) ts' ∧ EVERY (check_freevars dbmax tvs') ts ⇒ EVERY (check_freevars dbmax tvs') (MAP (type_subst (alist_to_fmap (ZIP (tvs,ts)))) ts')
deBruijn_subst_freevars_typed=∀(skip :num) (targs :t list) (t :t) (tvs :num). skip = (0 :num) ∧ EVERY (check_freevars tvs ([] :mlstring list)) targs ∧ check_freevars (LENGTH targs) ([] :mlstring list) t ⇒ check_freevars tvs ([] :mlstring list) (deBruijn_subst skip targs t)
type_ds_sing_typed=∀(check :bool) (tenv :type_env) (d :dec) (decls :num -> bool) (r :type_env). type_ds check tenv [d] decls r ⇔ type_d check tenv d decls r
