type_p_subst_typed=(∀(n :num) (tenv :type_env) (p :pat) (t :t) (new_bindings :(mlstring # t) list). type_p n tenv p t new_bindings ⇒ ∀(targs' :t list) (inc :num) (tvs :num) (targs :t list). tenv_abbrev_ok tenv.t ∧ tenv_ctor_ok tenv.c ∧ n = inc + LENGTH targs ∧ EVERY (check_freevars tvs ([] :mlstring list)) targs ∧ targs' = MAP (deBruijn_inc (0 :num) inc) targs ⇒ type_p (inc + tvs) tenv p (deBruijn_subst inc targs' t) (MAP (λ((x :mlstring),(t :t)). (x,deBruijn_subst inc targs' t)) new_bindings)) ∧ ∀(n :num) (tenv :type_env) (ps :pat list) (ts :t list) (new_bindings :(mlstring # t) list). type_ps n tenv ps ts new_bindings ⇒ ∀(targs' :t list) (inc :num) (targs :t list) (tvs :num). tenv_abbrev_ok tenv.t ∧ tenv_ctor_ok tenv.c ∧ n = inc + LENGTH targs ∧ EVERY (check_freevars tvs ([] :mlstring list)) targs ∧ targs' = MAP (deBruijn_inc (0 :num) inc) targs ⇒ type_ps (inc + tvs) tenv ps (MAP (deBruijn_subst inc targs') ts) (MAP (λ((x :mlstring),(t :t)). (x,deBruijn_subst inc targs' t)) new_bindings)
