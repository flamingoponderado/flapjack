type_subst_deBruijn_subst_list_typed=∀(t :α) (tvs :mlstring list) (tvs' :β) (ts :t list) (ts' :t list) (ts'' :t list) (inc :num). LENGTH tvs = LENGTH ts ∧ EVERY (check_freevars (0 :num) tvs) ts'' ⇒ MAP (deBruijn_subst inc ts') (MAP (type_subst (alist_to_fmap (ZIP (tvs,ts)))) ts'') = MAP (type_subst (alist_to_fmap (ZIP (tvs,MAP (λ(t :t). deBruijn_subst inc ts' t) ts)))) ts''
deBruijn_subst2_typed=(∀(t :t) (sk :num) (targs :t list) (targs' :t list) (tvs' :α). check_freevars (LENGTH targs) ([] :mlstring list) t ⇒ deBruijn_subst sk (MAP (deBruijn_inc (0 :num) sk) targs') (deBruijn_subst (0 :num) targs t) = deBruijn_subst (0 :num) (MAP (deBruijn_subst sk (MAP (deBruijn_inc (0 :num) sk) targs')) targs) t) ∧ ∀(ts :t list) (sk :num) (targs :t list) (targs' :t list) (tvs' :β). EVERY (check_freevars (LENGTH targs) ([] :mlstring list)) ts ⇒ MAP (deBruijn_subst sk (MAP (deBruijn_inc (0 :num) sk) targs')) (MAP (deBruijn_subst (0 :num) targs) ts) = MAP (deBruijn_subst (0 :num) (MAP (deBruijn_subst sk (MAP (deBruijn_inc (0 :num) sk) targs')) targs)) ts
