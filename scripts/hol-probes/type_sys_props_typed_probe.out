type_e_subst_typed=(∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :t). type_e tenv tenvE e t ⇒ ∀(tenvE1 :tenv_val_exp) (targs :t list) (tvs :num) (targs' :t list). num_tvs (tenvE2 :tenv_val_exp) = (0 :num) ∧ tenv_abbrev_ok tenv.t ∧ tenv_ctor_ok tenv.c ∧ tenv_val_ok tenv.v ∧ tenv_val_exp_ok tenvE ∧ EVERY (check_freevars tvs ([] :mlstring list)) targs ∧ tenvE = db_merge tenvE1 (bind_tvar (LENGTH targs) tenvE2) ∧ targs' = MAP (deBruijn_inc (0 :num) (num_tvs tenvE1)) targs ⇒ type_e tenv (db_merge (deBruijn_subst_tenvE targs tenvE1) (bind_tvar tvs tenvE2)) e (deBruijn_subst (num_tvs tenvE1) targs' t)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (es :exp list) (ts :t list). type_es tenv tenvE es ts ⇒ ∀(tenvE1 :tenv_val_exp) (targs :t list) (tvs :num) (targs' :t list). num_tvs tenvE2 = (0 :num) ∧ tenv_abbrev_ok tenv.t ∧ tenv_ctor_ok tenv.c ∧ tenv_val_ok tenv.v ∧ tenv_val_exp_ok tenvE ∧ EVERY (check_freevars tvs ([] :mlstring list)) targs ∧ tenvE = db_merge tenvE1 (bind_tvar (LENGTH targs) tenvE2) ∧ targs' = MAP (deBruijn_inc (0 :num) (num_tvs tenvE1)) targs ⇒ type_es tenv (db_merge (deBruijn_subst_tenvE targs tenvE1) (bind_tvar tvs tenvE2)) es (MAP (deBruijn_subst (num_tvs tenvE1) targs') ts)) ∧ ∀(tenv :type_env) (tenvE :tenv_val_exp) (funs :(mlstring # mlstring # exp) list) (env :(mlstring # t) list). type_funs tenv tenvE funs env ⇒ ∀(tenvE1 :tenv_val_exp) (targs :t list) (tvs :num) (targs' :t list). num_tvs tenvE2 = (0 :num) ∧ tenv_abbrev_ok tenv.t ∧ tenv_ctor_ok tenv.c ∧ tenv_val_ok tenv.v ∧ tenv_val_exp_ok tenvE ∧ EVERY (check_freevars tvs ([] :mlstring list)) targs ∧ tenvE = db_merge tenvE1 (bind_tvar (LENGTH targs) tenvE2) ∧ targs' = MAP (deBruijn_inc (0 :num) (num_tvs tenvE1)) targs ⇒ type_funs tenv (db_merge (deBruijn_subst_tenvE targs tenvE1) (bind_tvar tvs tenvE2)) funs (MAP (λ((x :mlstring),(t :t)). (x,deBruijn_subst (num_tvs tenvE1) targs' t)) env)
