) = MAP ((n2w :num -> word8) ∘ ORD) (explode s); (n :num) = LENGTH bytes; (hd :α word) = (make_byte_header c T n :α word); (k :num) = byte_len (:α) n; (ws :α word list) = write_bytes bytes (REPLICATE k (0w :α word)) c.be in if k < (2 :num) ** (dimindex (:α) − (4 :num)) ∧ k < (2 :num) ** c.len_size then SOME ((T,make_ptr c offset (0w :α word) k),MAP (λ(w :α word). (F,Word w)) (hd::ws)) else (NONE :((bool # α word_loc) # (bool # α word_loc) list) option))
parts_to_words_def_typed=(∀(c :config) (m :(bool # α word_loc) sptree$num_map) (i :num) (off :α word). parts_to_words c m i ([] :const_part list) off = SOME (lookup_mem m (i − (1 :num)),([] :(bool # α word_loc) list))) ∧ ∀(c :config) (m :(bool # α word_loc) sptree$num_map) (i :num) (x :const_part) (parts :const_part list) (off :α word). parts_to_words c m i (x::parts) off = case part_to_words c m x off of (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) => (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) | SOME (w,xs) => case parts_to_words c (insert i w m :(bool # α word_loc) sptree$num_map) (i + (1 :num)) parts (off + (bytes_in_word :α word) * (n2w (LENGTH xs) :α word)) of (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) => (NONE :((bool # α word_loc) # (bool # α word_loc) list) option) | SOME (r,ys) => SOME (r,xs ++ ys)
const_parts_to_words_def_typed=∀(c :config) (parts :const_part list). (const_parts_to_words c parts :((bool # α word_loc) # (bool # α word_loc) list) option) = parts_to_words c (LN :(bool # α word_loc) sptree$num_map) (0 :num) parts (0w :α word)
