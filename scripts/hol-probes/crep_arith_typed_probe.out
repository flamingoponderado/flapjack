dest_2exp_def_typed=∀(w :α word) (n :num). dest_2exp n w = if w = (0w :α word) then (NONE :num option) else if w = (1w :α word) then SOME n else if w && (1w :α word) ≠ (0w :α word) then (NONE :num option) else dest_2exp (n + (1 :num)) (w ⋙ (1 :num))
dest_2exp_thm_typed=dest_2exp (0 :num) (w :α word) = SOME (n2 :num) ⇒ w = (1w :α word) ≪ n2
dest_const_def_typed=dest_const (Const (w :α word) :α exp) = SOME w ∧ dest_const (Var (v1 :num) :α exp) = (NONE :α word option) ∧ dest_const (Load (v2 :α exp) :α exp) = (NONE :α word option) ∧ dest_const (Load32 (v3 :α exp) :α exp) = (NONE :α word option) ∧ dest_const (LoadByte (v4 :α exp)) = (NONE :α word option) ∧ dest_const (LoadGlob (v5 :word5) :α exp) = (NONE :α word option) ∧ dest_const (Op (v6 :binop) (v7 :α exp list)) = (NONE :α word option) ∧ dest_const (Crepop (v8 :crepop) (v9 :α exp list)) = (NONE :α word option) ∧ dest_const (Cmp (v10 :cmp) (v11 :α exp) (v12 :α exp)) = (NONE :α word option) ∧ dest_const (Shift (v13 :ast$shift) (v14 :α exp) (v15 :α exp) :α exp) = (NONE :α word option) ∧ dest_const (BaseAddr :α exp) = (NONE :α word option) ∧ dest_const (TopAddr :α exp) = (NONE :α word option)
mul_const_def_typed=∀(exp :α exp) (c :α word). mul_const exp c = if c = (0w :α word) then (Const (0w :α word) :α exp) else if c = (1w :α word) then exp else case dest_2exp (0 :num) c of (NONE :num option) => Crepop Mul [exp; (Const c :α exp)] | SOME i => (Shift Lsl exp (Const (n2w i :α word) :α exp) :α exp)
simp_exp_def_typed=(∀(op :crepop) (exps :α exp list). simp_exp (Crepop op exps) = (let (exps' :α exp list) = MAP (λ(a :α exp). simp_exp a) exps in case (op,exps') of (v4,([] :α exp list)) => Crepop op exps' | (v4,[v9]) => Crepop op exps' | (v4,[v9; v13]) => (case (dest_const v9,dest_const v13) of ((NONE :α word option),(NONE :α word option)) => Crepop op exps' | ((NONE :α word option),SOME v8) => mul_const v9 v8 | (SOME c,(NONE :α word option)) => mul_const v13 c | (SOME c,SOME c2) => (Const (c * c2) :α exp)) | (v4,v9::v13::v17::v18) => Crepop op exps')) ∧ (∀(exp :α exp). simp_exp (Load32 exp :α exp) = (Load32 (simp_exp exp) :α exp)) ∧ (∀(exp :α exp). simp_exp (LoadByte exp) = LoadByte (simp_exp exp)) ∧ (∀(exp :α exp). simp_exp (Load exp :α exp) = (Load (simp_exp exp) :α exp)) ∧ (∀(exps :α exp list) (bop :binop). simp_exp (Op bop exps) = Op bop (MAP (λ(a :α exp). simp_exp a) exps)) ∧ (∀(exp2 :α exp) (exp1 :α exp) (cmp :cmp). simp_exp (Cmp cmp exp1 exp2) = Cmp cmp (simp_exp exp1) (simp_exp exp2)) ∧ (∀(s :ast$shift) (exp2 :α exp) (exp1 :α exp). simp_exp (Shift s exp1 exp2 :α exp) = (Shift s (simp_exp exp1) (simp_exp exp2) :α exp)) ∧ (∀(v :α word). simp_exp (Const v :α exp) = (Const v :α exp)) ∧ (∀(v1 :num). simp_exp (Var v1 :α exp) = (Var v1 :α exp)) ∧ (∀(v12 :word5). simp_exp (LoadGlob v12 :α exp) = (LoadGlob v12 :α exp)) ∧ simp_exp (BaseAddr :α exp) = (BaseAddr :α exp) ∧ simp_exp (TopAddr :α exp) = (TopAddr :α exp)
simp_prog_def_typed=(∀(v :num) (p :α prog) (exp :α exp). simp_prog (Dec v exp p :α prog) = (Dec v (simp_exp exp) (simp_prog p) :α prog)) ∧ (∀(v :num) (exp :α exp). simp_prog (Assign v exp :α prog) = (Assign v (simp_exp exp) :α prog)) ∧ (∀(exp2 :α exp) (exp1 :α exp). simp_prog (Store exp1 exp2 :α prog) = (Store (simp_exp exp1) (simp_exp exp2) :α prog)) ∧ (∀(exp2 :α exp) (exp1 :α exp). simp_prog (Store32 exp1 exp2 :α prog) = (Store32 (simp_exp exp1) (simp_exp exp2) :α prog)) ∧ (∀(exp2 :α exp) (exp1 :α exp). simp_prog (StoreByte exp1 exp2 :α prog) = (StoreByte (simp_exp exp1) (simp_exp exp2) :α prog)) ∧ (∀(g :word5) (exp :α exp). simp_prog (StoreGlob g exp) = StoreGlob g (simp_exp exp)) ∧ (∀(p2 :α prog) (p1 :α prog). simp_prog (Seq p1 p2) = Seq (simp_prog p1) (simp_prog p2)) ∧ (∀(p2 :α prog) (p1 :α prog) (exp :α exp). simp_prog (If exp p1 p2) = If (simp_exp exp) (simp_prog p1) (simp_prog p2)) ∧ (∀(p :α prog) (exp :α exp). simp_prog (While exp p) = While (simp_exp exp) (simp_prog p)) ∧ (∀(exps :α exp list) (e :mlstring) (call_type :(num list # (α word # α prog) option) option). simp_prog (Call call_type e exps :α prog) = (let (call_type2 :(num list # (α word # α prog) option) option) = case call_type of (NONE :(num list # (α word # α prog) option) option) => (NONE :(num list # (α word # α prog) option) option) | SOME (rv,opt_handler) => SOME (rv,case opt_handler of (NONE :(α word # α prog) option) => (NONE :(α word # α prog) option) | SOME (ix,ep) => SOME (ix,simp_prog ep)) in (Call call_type2 e (MAP (simp_exp :α exp -> α exp) exps) :α prog))) ∧ (∀(exp :α exp list). simp_prog (Return exp :α prog) = (Return (MAP (simp_exp :α exp -> α exp) exp) :α prog)) ∧ (∀(vn :num) (op :memop) (exp :α exp). simp_prog (ShMem op vn exp) = ShMem op vn (simp_exp exp)) ∧ simp_prog (Skip :α prog) = (Skip :α prog) ∧ (∀(v9 :num list) (v8 :primop) (v7 :num list). simp_prog (Primitive v7 v8 v9 :α prog) = (Primitive v7 v8 v9 :α prog)) ∧ (∀(v25 :num). simp_prog (Break v25 :α prog) = (Break v25 :α prog)) ∧ (∀(v26 :num). simp_prog (Continue v26 :α prog) = (Continue v26 :α prog)) ∧ (∀(v34 :num) (v33 :num) (v32 :num) (v31 :num) (v30 :mlstring). simp_prog (ExtCall v30 v31 v32 v33 v34 :α prog) = (ExtCall v30 v31 v32 v33 v34 :α prog)) ∧ (∀(v35 :α word). simp_prog (Raise v35 :α prog) = (Raise v35 :α prog)) ∧ simp_prog (Tick :α prog) = (Tick :α prog)
dest_2exp_lemma_typed=∀(i :num) (w :α word) (n :num). dest_2exp i w = SOME n ⇒ i ≤ n ∧ w = (1w :α word) ≪ (n − i)
