load "preamble"; load "word_to_stackProofTheory";
open HolKernel Parse bossLib preamble word_to_stackProofTheory word_to_stackTheory stackPropsTheory;
val _ = Globals.linewidth := 1000000;
val _ = numLib.temp_prefer_num();
fun theoremRow label th = (if null(hyp th) then () else raise Fail "open premise"; print(label ^ "="); print_thm th; print "\n");
val inst_case = prove(``!c perf i bs frame. post_alloc_conventions (FST frame) (wordLang$Inst i) /\ 4 <= FST frame /\ perf=F ==> reg_bound (FST (comp c perf (wordLang$Inst i) bs frame)) (FST frame+2)``, metis_tac[word_to_stack_reg_bound]);
val _ = theoremRow "rbi_full_inst" inst_case;
val share_case = prove(``!c perf op v exp bs frame. post_alloc_conventions (FST frame) (ShareInst op v exp) /\ 4 <= FST frame /\ perf=F ==> reg_bound (FST (comp c perf (ShareInst op v exp) bs frame)) (FST frame+2)``, metis_tac[word_to_stack_reg_bound]);
val _ = theoremRow "rbi_full_share" share_case;
