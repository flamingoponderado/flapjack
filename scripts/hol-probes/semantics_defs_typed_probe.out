evaluate_prog_with_clock_def_typed=∀(st :α semanticPrimitives$state) (env :v sem_env) (k :num) (prog :dec list). evaluate_prog_with_clock st env k prog = (let ((st' :α semanticPrimitives$state),(r :(v sem_env, v) result)) = evaluate_decs (st with clock := k) env prog in (st'.ffi,r))
semantics_prog_def_typed=(∀(st :α semanticPrimitives$state) (env :v sem_env) (prog :dec list) (outcome :outcome) (io_list :io_event list). semantics_prog st env prog (Terminate outcome io_list) ⇔ ∃(k :num) (ffi :α ffi_state) (r :(v sem_env, v) result). evaluate_prog_with_clock st env k prog = (ffi,r) ∧ (case r of (Rval v2 :(v sem_env, v) result) => (Rval v2 :(v sem_env, v) result) ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) ∧ outcome = Success | (Rerr (Rraise v6) :(v sem_env, v) result) => (Rerr (Rraise v6) :(v sem_env, v) result) ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) ∧ outcome = Success | (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) => (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) ∧ outcome = Success | (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) => (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result) ∧ outcome = Success | (Rerr (Rabort (Rffi_error outcome') :v error_result) :(v sem_env, v) result) => outcome = FFI_outcome outcome') ∧ io_list = ffi.io_events ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) ∧ (∀(st :α semanticPrimitives$state) (env :v sem_env) (prog :dec list) (io_trace :io_event llist). semantics_prog st env prog (Diverge io_trace) ⇔ (∀(k :num). ∃(ffi :α ffi_state). evaluate_prog_with_clock st env k prog = (ffi,(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result))) ∧ lprefix_lub (IMAGE (λ(k :num). (fromList (FST (evaluate_prog_with_clock st env k prog)).io_events :io_event llist)) 𝕌(:num)) io_trace) ∧ ∀(st :α semanticPrimitives$state) (env :v sem_env) (prog :dec list). semantics_prog st env prog Fail ⇔ ∃(k :num). SND (evaluate_prog_with_clock st env k prog) = (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)
