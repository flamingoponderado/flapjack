set_byte_full_def=∀a b w is_bigendian. set_byte a b w is_bigendian = (let i = byte_index a is_bigendian in word_slice_alt (dimindex (:α)) (i + 8) w ‖ w2w b ≪ i ‖ word_slice_alt i 0 w)
set_byte_type=:α word -> word8 -> α word -> bool -> α word
word_of_bytes_full_def=(∀be a. word_of_bytes be a [] = 0w) ∧ ∀be a b bs. word_of_bytes be a (b::bs) = set_byte a b (word_of_bytes be (a + 1w) bs) be
word_of_bytes_type=:bool -> α word -> word8 list -> α word
