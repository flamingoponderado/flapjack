v_ty_typed=Int::v_ty; List::v_ty; Any::v_ty
assoc_op_typed=Plus::assoc_op; Times::assoc_op; Append::assoc_op; Noop::assoc_op
is_rec_def_typed=(is_rec (name :num) (Call (v0 :num) (d :num option) (v1 :exp list) (NONE :exp option) :exp) ⇔ d = SOME name) ∧ (is_rec (v2 :num) (Var (v5 :num) :exp) ⇔ F) ∧ (is_rec v2 (If (v6 :exp) (v7 :exp) (v8 :exp) :exp) ⇔ F) ∧ (is_rec v2 (Let (v9 :exp list) (v10 :exp) :exp) ⇔ F) ∧ (is_rec v2 (Raise (v11 :exp) :exp) ⇔ F) ∧ (is_rec v2 (Tick (v12 :exp) :exp) ⇔ F) ∧ (is_rec v2 (Call (v13 :num) (v14 :num option) (v15 :exp list) (SOME (v49 :exp)) :exp) ⇔ F) ∧ (is_rec v2 (Force (v17 :num) (v18 :num) :exp) ⇔ F) ∧ (is_rec v2 (Op (v19 :op) (v20 :exp list) :exp) ⇔ F) ∧ (is_rec v2 (LetCall (v21 :num) (v22 :num) (v23 :num) (v24 :exp list) (v25 :exp)) ⇔ F) ∧ (is_rec v2 (Return (v26 :exp list)) ⇔ F)
from_op_def_typed=∀(op :op). from_op op = if op = IntOp Add then Plus else if op = IntOp Mult then Times else if op = BlockOp ListAppend then Append else Noop
to_op_def_typed=to_op Plus = IntOp Add ∧ to_op Times = IntOp Mult ∧ to_op Append = BlockOp ListAppend ∧ to_op Noop = IntOp Mod
apply_op_def_typed=∀(op :assoc_op) (e1 :exp) (e2 :exp). apply_op op e1 e2 = (Op (to_op op) [e1; e2] :exp)
arg_ty_def_typed=arg_ty (IntOp (Const (i :int))) = (if small_enough_int i then Int else Any) ∧ arg_ty (IntOp Add) = Int ∧ arg_ty (IntOp Sub) = Int ∧ arg_ty (IntOp Mult) = Int ∧ arg_ty (IntOp Div) = Int ∧ arg_ty (IntOp Mod) = Int ∧ arg_ty (IntOp LessEq) = Int ∧ arg_ty (IntOp Less) = Int ∧ arg_ty (IntOp Greater) = Int ∧ arg_ty (IntOp GreaterEq) = Int ∧ arg_ty (BlockOp ListAppend) = List ∧ arg_ty (Label (v :num)) = Any ∧ arg_ty (FFI (v1 :mlstring) :op) = Any ∧ arg_ty (IntOp (LessConstSmall (v17 :num))) = Any ∧ arg_ty (WordOp (v3 :word_op)) = Any ∧ arg_ty (BlockOp (Cons (v20 :num) :block_op)) = Any ∧ arg_ty (BlockOp (ElemAt (v21 :num))) = Any ∧ arg_ty (BlockOp (TagLenEq (v22 :num) (v23 :num))) = Any ∧ arg_ty (BlockOp (LenEq (v24 :num))) = Any ∧ arg_ty (BlockOp (TagEq (v25 :num))) = Any ∧ arg_ty (BlockOp LengthBlock) = Any ∧ arg_ty (BlockOp (BoolTest (v26 :test))) = Any ∧ arg_ty (BlockOp BoolNot) = Any ∧ arg_ty (BlockOp BoundsCheckBlock) = Any ∧ arg_ty (BlockOp (ConsExtend (v27 :num))) = Any ∧ arg_ty (BlockOp (FromList (v28 :num))) = Any ∧ arg_ty (BlockOp (Constant (v29 :const))) = Any ∧ arg_ty (BlockOp Equal) = Any ∧ arg_ty (BlockOp (EqualConst (v30 :const_part))) = Any ∧ arg_ty (BlockOp (Build (v31 :const_part list))) = Any ∧ arg_ty (GlobOp (v5 :glob_op)) = Any ∧ arg_ty (MemOp (v6 :mem_op)) = Any ∧ arg_ty Install = Any ∧ arg_ty (ThunkOp (v7 :thunk_op) :op) = Any
check_op_def_typed=∀(ts :v_ty list) (opr :assoc_op) (loc :num) (exp :exp). check_op ts opr loc exp = case opbinargs opr (try_swap loc opr exp) of (NONE :(exp # exp) option) => (NONE :exp option) | SOME (xs,f) => if is_rec loc f ∧ term_ok ts (op_type opr) xs then SOME (apply_op opr xs f) else (NONE :exp option)
decide_ty_def_typed=decide_ty Int Int = Int ∧ decide_ty List List = List ∧ decide_ty Int List = Any ∧ decide_ty Int Any = Any ∧ decide_ty List Int = Any ∧ decide_ty List Any = Any ∧ decide_ty Any (v1 :v_ty) = Any
get_bin_args_def_typed=∀(op :exp). get_bin_args op = case op of (Var v22 :exp) => (NONE :(exp # exp) option) | (If v23 v24 v25 :exp) => (NONE :(exp # exp) option) | (Let v26 v27 :exp) => (NONE :(exp # exp) option) | (Raise v28 :exp) => (NONE :(exp # exp) option) | (Tick v29 :exp) => (NONE :(exp # exp) option) | (Call v30 v31 v32 v33 :exp) => (NONE :(exp # exp) option) | (Force v34 v35 :exp) => (NONE :(exp # exp) option) | (Op v36 ([] :exp list) :exp) => (NONE :(exp # exp) option) | (Op v36 [e1] :exp) => (NONE :(exp # exp) option) | (Op v36 [e1; e2] :exp) => SOME (e1,e2) | (Op v36 (e1::e2::v54::v55) :exp) => (NONE :(exp # exp) option) | LetCall v38 v39 v40 v41 v42 => (NONE :(exp # exp) option) | Return v43 => (NONE :(exp # exp) option)
is_arith_def_typed=∀(op :op). is_arith op ⇔ case op of Label v8 => F | (FFI v9 :op) => F | IntOp (Const v18) => F | IntOp Add => T | IntOp Sub => T | IntOp Mult => T | IntOp Div => F | IntOp Mod => F | IntOp Less => F | IntOp LessEq => F | IntOp Greater => F | IntOp GreaterEq => F | IntOp (LessConstSmall v19) => F | WordOp v11 => F | BlockOp v12 => F | GlobOp v13 => F | MemOp v14 => F | Install => F | (ThunkOp v15 :op) => F
is_const_def_typed=(is_const (IntOp (Const (i :int))) ⇔ small_enough_int i) ∧ (is_const (Label (v :num)) ⇔ F) ∧ (is_const (FFI (v1 :mlstring) :op) ⇔ F) ∧ (is_const (IntOp Add) ⇔ F) ∧ (is_const (IntOp Sub) ⇔ F) ∧ (is_const (IntOp Mult) ⇔ F) ∧ (is_const (IntOp Div) ⇔ F) ∧ (is_const (IntOp Mod) ⇔ F) ∧ (is_const (IntOp Less) ⇔ F) ∧ (is_const (IntOp LessEq) ⇔ F) ∧ (is_const (IntOp Greater) ⇔ F) ∧ (is_const (IntOp GreaterEq) ⇔ F) ∧ (is_const (IntOp (LessConstSmall (v17 :num))) ⇔ F) ∧ (is_const (WordOp (v3 :word_op)) ⇔ F) ∧ (is_const (BlockOp (v4 :block_op)) ⇔ F) ∧ (is_const (GlobOp (v5 :glob_op)) ⇔ F) ∧ (is_const (MemOp (v6 :mem_op)) ⇔ F) ∧ (is_const Install ⇔ F) ∧ (is_const (ThunkOp (v7 :thunk_op) :op) ⇔ F)
is_rel_def_typed=∀(op :op). is_rel op ⇔ case op of Label v8 => F | (FFI v9 :op) => F | IntOp (Const v18) => F | IntOp Add => F | IntOp Sub => F | IntOp Mult => F | IntOp Div => F | IntOp Mod => F | IntOp Less => T | IntOp LessEq => T | IntOp Greater => T | IntOp GreaterEq => T | IntOp (LessConstSmall v19) => F | WordOp v11 => F | BlockOp v12 => F | GlobOp v13 => F | MemOp v14 => F | Install => F | (ThunkOp v15 :op) => F
opbinargs_def_typed=∀(opr :assoc_op) (exp :exp). opbinargs opr exp = if ¬op_eq opr exp then (NONE :(exp # exp) option) else get_bin_args exp
op_eq_def_typed=(op_eq Plus (Op (op :op) (xs :exp list) :exp) ⇔ op = IntOp Add) ∧ (op_eq Times (Op op xs :exp) ⇔ op = IntOp Mult) ∧ (op_eq Append (Op op xs :exp) ⇔ op = BlockOp ListAppend) ∧ (op_eq (v0 :assoc_op) (Var (v3 :num) :exp) ⇔ F) ∧ (op_eq v0 (If (v4 :exp) (v5 :exp) (v6 :exp) :exp) ⇔ F) ∧ (op_eq v0 (Let (v7 :exp list) (v8 :exp) :exp) ⇔ F) ∧ (op_eq v0 (Raise (v9 :exp) :exp) ⇔ F) ∧ (op_eq v0 (Tick (v10 :exp) :exp) ⇔ F) ∧ (op_eq v0 (Call (v11 :num) (v12 :num option) (v13 :exp list) (v14 :exp option) :exp) ⇔ F) ∧ (op_eq v0 (Force (v15 :num) (v16 :num) :exp) ⇔ F) ∧ (op_eq Noop (Op (v17 :op) (v18 :exp list) :exp) ⇔ F) ∧ (op_eq v0 (LetCall (v19 :num) (v20 :num) (v21 :num) (v22 :exp list) (v23 :exp)) ⇔ F) ∧ (op_eq v0 (Return (v24 :exp list)) ⇔ F)
op_type_def_typed=op_type Append = List ∧ op_type Noop = Any ∧ op_type Plus = Int ∧ op_type Times = Int
scan_expr_sing_def_typed=(∀(ts :v_ty list) (loc :num) (n :num). scan_expr_sing ts loc (Var n :exp) = (let (ty :v_ty) = if n < LENGTH ts then ts❲n❳ else Any in (ts,ty,F,(NONE :assoc_op option)))) ∧ (∀(ts :v_ty list) (loc :num) (xi :exp) (xt :exp) (xe :exp). scan_expr_sing ts loc (If xi xt xe :exp) = (let ((ti :v_ty list),(tyi :v_ty),(_0' :bool),(oi :assoc_op option)) = scan_expr_sing ts loc xi; ((tt :v_ty list),(ty1 :v_ty),(_1 :bool),(ot :assoc_op option)) = scan_expr_sing ti loc xt; ((te :v_ty list),(ty2 :v_ty),(_2 :bool),(oe :assoc_op option)) = scan_expr_sing ti loc xe; (op :assoc_op option) = case ot of (NONE :assoc_op option) => oe | SOME v1 => ot; (ty :v_ty) = case op of (NONE :assoc_op option) => decide_ty ty1 ty2 | SOME opr => decide_ty ty1 (decide_ty ty2 (op_type opr)) in ((MAP2 decide_ty tt te :v_ty list),ty,IS_SOME oe,op))) ∧ (∀(ts :v_ty list) (loc :num) (xs :exp list) (x :exp). scan_expr_sing ts loc (Let xs x :exp) = (let (ys :(v_ty list # v_ty # bool # assoc_op option) list) = scan_expr_list ts loc xs; (tt :v_ty list) = MAP ((FST :v_ty # bool # assoc_op option -> v_ty) ∘ (SND :v_ty list # v_ty # bool # assoc_op option -> v_ty # bool # assoc_op option)) ys; (tr :v_ty list) = case LAST1 ys of (NONE :(v_ty list # v_ty # bool # assoc_op option) option) => ts | SOME c => FST c; ((tu :v_ty list),(ty :v_ty),(_0 :bool),(op :assoc_op option)) = scan_expr_sing (tt ++ tr) loc x in (DROP (LENGTH ys) tu,ty,F,op))) ∧ (∀(ts :v_ty list) (loc :num) (x :exp). scan_expr_sing ts loc (Raise x :exp) = (ts,Any,F,(NONE :assoc_op option))) ∧ (∀(ts :v_ty list) (loc :num) (x :exp). scan_expr_sing ts loc (Tick x :exp) = scan_expr_sing ts loc x) ∧ (∀(ts :v_ty list) (loc :num) (v0 :num) (n :num). scan_expr_sing ts loc (Force v0 n :exp) = (let (ty :v_ty) = if n < LENGTH ts then ts❲n❳ else Any in (ts,ty,F,(NONE :assoc_op option)))) ∧ (∀(ts :v_ty list) (loc :num) (t :num) (d :num option) (xs :exp list) (h :exp option). scan_expr_sing ts loc (Call t d xs h :exp) = (ts,Any,F,(NONE :assoc_op option))) ∧ (∀(ts :v_ty list) (loc :num) (xs :exp list). scan_expr_sing ts loc (Return xs) = (ts,Any,F,(NONE :assoc_op option))) ∧ (∀(ts :v_ty list) (loc :num) (rets :num) (t :num) (d :num) (xs :exp list) (y :exp). scan_expr_sing ts loc (LetCall rets t d xs y) = (ts,Any,F,(NONE :assoc_op option))) ∧ (∀(ts :v_ty list) (loc :num) (op :op) (xs :exp list). scan_expr_sing ts loc (Op op xs :exp) = (let (opr :assoc_op) = from_op op; (opt :v_ty) = op_type opr in case opr of Plus => if IS_SOME (check_op ts opr loc (Op op xs :exp)) then (ts,opt,F,SOME opr) else if term_ok ts opt (Op op xs :exp) then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => (ts,Any,F,(NONE :assoc_op option)) | SOME (x,y) => (update_context opt ts x y,opt,F,(NONE :assoc_op option)) else (ts,Any,F,(NONE :assoc_op option)) | Times => if IS_SOME (check_op ts opr loc (Op op xs :exp)) then (ts,opt,F,SOME opr) else if term_ok ts opt (Op op xs :exp) then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => (ts,Any,F,(NONE :assoc_op option)) | SOME (x,y) => (update_context opt ts x y,opt,F,(NONE :assoc_op option)) else (ts,Any,F,(NONE :assoc_op option)) | Append => if IS_SOME (check_op ts opr loc (Op op xs :exp)) then (ts,opt,F,SOME opr) else if term_ok ts opt (Op op xs :exp) then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => (ts,Any,F,(NONE :assoc_op option)) | SOME (x,y) => (update_context opt ts x y,opt,F,(NONE :assoc_op option)) else (ts,Any,F,(NONE :assoc_op option)) | Noop => if arg_ty op = Int then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => if is_const op then (ts,Int,F,(NONE :assoc_op option)) else (ts,Any,F,(NONE :assoc_op option)) | SOME (x,y) => if ¬is_const op then (update_context Int ts x y,Any,F,(NONE :assoc_op option)) else (ts,Any,F,(NONE :assoc_op option)) else if op = BlockOp (Cons (0 :num) :block_op) ∧ xs = ([] :exp list) then (ts,List,F,(NONE :assoc_op option)) else (ts,Any,F,(NONE :assoc_op option)))) ∧ (∀(ts :v_ty list) (loc :num). scan_expr_list ts loc ([] :exp list) = ([] :(v_ty list # v_ty # bool # assoc_op option) list)) ∧ ∀(ts :v_ty list) (loc :num) (x :exp) (xs :exp list). scan_expr_list ts loc (x::xs) = (let ((tx :v_ty list),(ty :v_ty),(r :bool),(op :assoc_op option)) = scan_expr_sing ts loc x in (tx,ty,r,op)::scan_expr_list tx loc xs)
term_ok_def_typed=∀(ts :v_ty list) (ty :v_ty) (expr :exp). term_ok ts ty expr ⇔ case ty of Int => term_ok_int ts expr | List => term_ok_any ts T expr | Any => term_ok_any ts F expr
term_ok_any_def_typed=(∀(ts :v_ty list) (list :bool) (i :num). term_ok_any ts list (Var i :exp) ⇔ if ¬list then i < LENGTH ts else if i < LENGTH ts then ts❲i❳ = List else F) ∧ (∀(xs :exp list) (ts :v_ty list) (op :op) (list :bool). term_ok_any ts list (Op op xs :exp) ⇔ case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => xs = ([] :exp list) ∧ if list then op = BlockOp (Cons (0 :num) :block_op) else is_const op | SOME (x,y) => if op = BlockOp ListAppend then term_ok_any ts T x ∧ term_ok_any ts T y else if ¬list ∧ is_arith op then term_ok_int ts x ∧ term_ok_int ts y else if ¬list ∧ is_rel op then term_ok_int ts x ∧ term_ok_int ts y else if op = BlockOp (Cons (0 :num) :block_op) then term_ok_any ts T x ∧ term_ok_any ts F y else F) ∧ (∀(v8 :exp) (v7 :exp) (v6 :exp) (ts :v_ty list) (list :bool). term_ok_any ts list (If v6 v7 v8 :exp) ⇔ F) ∧ (∀(v9 :exp list) (v10 :exp) (ts :v_ty list) (list :bool). term_ok_any ts list (Let v9 v10 :exp) ⇔ F) ∧ (∀(v11 :exp) (ts :v_ty list) (list :bool). term_ok_any ts list (Raise v11 :exp) ⇔ F) ∧ (∀(v12 :exp) (ts :v_ty list) (list :bool). term_ok_any ts list (Tick v12 :exp) ⇔ F) ∧ (∀(v16 :exp option) (v15 :exp list) (v14 :num option) (v13 :num) (ts :v_ty list) (list :bool). term_ok_any ts list (Call v13 v14 v15 v16 :exp) ⇔ F) ∧ (∀(v18 :num) (v17 :num) (ts :v_ty list) (list :bool). term_ok_any ts list (Force v17 v18 :exp) ⇔ F) ∧ (∀(v25 :exp) (v24 :exp list) (v23 :num) (v22 :num) (v21 :num) (ts :v_ty list) (list :bool). term_ok_any ts list (LetCall v21 v22 v23 v24 v25) ⇔ F) ∧ ∀(v26 :exp list) (ts :v_ty list) (list :bool). term_ok_any ts list (Return v26) ⇔ F
term_ok_int_def_typed=∀(ts :v_ty list) (expr :exp). term_ok_int ts expr ⇔ case expr of (Var i :exp) => if i < LENGTH ts then ts❲i❳ = Int else F | (If v24 v25 v26 :exp) => F | (Let v27 v28 :exp) => F | (Raise v29 :exp) => F | (Tick v30 :exp) => F | (Call v31 v32 v33 v34 :exp) => F | (Force v35 v36 :exp) => F | (Op op xs :exp) => (case get_bin_args expr of (NONE :(exp # exp) option) => xs = ([] :exp list) ∧ is_const op | SOME (x,y) => is_arith op ∧ term_ok_int ts x ∧ term_ok_int ts y) | LetCall v39 v40 v41 v42 v43 => F | Return v44 => F
try_swap_def_typed=try_swap (loc :num) Append (exp :exp) = exp ∧ try_swap loc Plus exp = (case opbinargs Plus exp of (NONE :(exp # exp) option) => exp | SOME (l,r) => if is_rec loc l then apply_op Plus r l else exp) ∧ try_swap loc Times exp = (case opbinargs Times exp of (NONE :(exp # exp) option) => exp | SOME (l,r) => if is_rec loc l then apply_op Times r l else exp) ∧ try_swap loc Noop exp = case opbinargs Noop exp of (NONE :(exp # exp) option) => exp | SOME (l,r) => if is_rec loc l then apply_op Noop r l else exp
has_rec_def_typed=(∀(loc :num). has_rec loc ([] :exp list) ⇔ F) ∧ (∀(y :exp) (xs :exp list) (x :exp) (loc :num). has_rec loc (x::y::xs) ⇔ if has_rec loc [x] then T else has_rec loc (y::xs)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (loc :num). has_rec loc [(If x1 x2 x3 :exp)] ⇔ if has_rec loc [x2] then T else has_rec loc [x3]) ∧ (∀(xs :exp list) (x :exp) (loc :num). has_rec loc [(Let xs x :exp)] ⇔ has_rec loc [x]) ∧ (∀(x :exp) (loc :num). has_rec loc [(Tick x :exp)] ⇔ has_rec loc [x]) ∧ (∀(xs :exp list) (op :op) (loc :num). has_rec loc [(Op op xs :exp)] ⇔ if EXISTS (is_rec loc) xs then T else has_rec loc xs) ∧ (∀(v6 :num) (loc :num). has_rec loc [(Var v6 :exp)] ⇔ F) ∧ (∀(v12 :exp) (loc :num). has_rec loc [(Raise v12 :exp)] ⇔ F) ∧ (∀(v17 :exp option) (v16 :exp list) (v15 :num option) (v14 :num) (loc :num). has_rec loc [(Call v14 v15 v16 v17 :exp)] ⇔ F) ∧ (∀(v19 :num) (v18 :num) (loc :num). has_rec loc [(Force v18 v19 :exp)] ⇔ F) ∧ (∀(v26 :exp) (v25 :exp list) (v24 :num) (v23 :num) (v22 :num) (loc :num). has_rec loc [LetCall v22 v23 v24 v25 v26] ⇔ F) ∧ ∀(v27 :exp list) (loc :num). has_rec loc [Return v27] ⇔ F
has_rec1_def_typed=∀(loc :num) (x :exp). has_rec1 loc x ⇔ has_rec loc [x]
has_rec_sing_def_typed=(∀(x3 :exp) (x2 :exp) (x1 :exp) (loc :num). has_rec_sing loc (If x1 x2 x3 :exp) ⇔ if has_rec_sing loc x2 then T else has_rec_sing loc x3) ∧ (∀(xs :exp list) (x :exp) (loc :num). has_rec_sing loc (Let xs x :exp) ⇔ has_rec_sing loc x) ∧ (∀(x :exp) (loc :num). has_rec_sing loc (Tick x :exp) ⇔ has_rec_sing loc x) ∧ (∀(xs :exp list) (op :op) (loc :num). has_rec_sing loc (Op op xs :exp) ⇔ if EXISTS (is_rec loc) xs then T else has_rec_list loc xs) ∧ (∀(v4 :num) (loc :num). has_rec_sing loc (Var v4 :exp) ⇔ F) ∧ (∀(v10 :exp) (loc :num). has_rec_sing loc (Raise v10 :exp) ⇔ F) ∧ (∀(v15 :exp option) (v14 :exp list) (v13 :num option) (v12 :num) (loc :num). has_rec_sing loc (Call v12 v13 v14 v15 :exp) ⇔ F) ∧ (∀(v17 :num) (v16 :num) (loc :num). has_rec_sing loc (Force v16 v17 :exp) ⇔ F) ∧ (∀(v24 :exp) (v23 :exp list) (v22 :num) (v21 :num) (v20 :num) (loc :num). has_rec_sing loc (LetCall v20 v21 v22 v23 v24) ⇔ F) ∧ (∀(v25 :exp list) (loc :num). has_rec_sing loc (Return v25) ⇔ F) ∧ (∀(loc :num). has_rec_list loc ([] :exp list) ⇔ F) ∧ ∀(xs :exp list) (x :exp) (loc :num). has_rec_list loc (x::xs) ⇔ if has_rec_sing loc x then T else has_rec_list loc xs
has_rec_eq_typed=(∀(e :exp) (loc :num). has_rec loc [e] ⇔ has_rec_sing loc e) ∧ ∀(es :exp list) (loc :num). has_rec loc es ⇔ has_rec_list loc es
args_from_def_typed=args_from (Call (t :num) (SOME (d :num)) (as :exp list) (hdl :exp option) :exp) = SOME (t,d,as,hdl) ∧ args_from (Var (v :num) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (If (v1 :exp) (v2 :exp) (v3 :exp) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Let (v4 :exp list) (v5 :exp) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Raise (v6 :exp) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Tick (v7 :exp) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Call (v8 :num) (NONE :num option) (v10 :exp list) (v11 :exp option) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Force (v12 :num) (v13 :num) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Op (v14 :op) (v15 :exp list) :exp) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (LetCall (v16 :num) (v17 :num) (v18 :num) (v19 :exp list) (v20 :exp)) = (NONE :(num # num # exp list # exp option) option) ∧ args_from (Return (v21 :exp list)) = (NONE :(num # num # exp list # exp option) option)
id_from_op_def_typed=id_from_op Plus = (Op (IntOp (Const (0 :int))) ([] :exp list) :exp) ∧ id_from_op Times = (Op (IntOp (Const (1 :int))) ([] :exp list) :exp) ∧ id_from_op Append = (Op (BlockOp (Cons nil_tag :block_op)) ([] :exp list) :exp) ∧ id_from_op Noop = dummy
let_wrap_def_typed=∀(arity :num) (id :exp) (exp :exp). let_wrap arity id exp = (Let (GENLIST (λ(i :num). (Var i :exp)) arity ++ [id]) exp :exp)
mk_aux_call_def_typed=∀(loc :num) (arity :num) (id :exp). mk_aux_call loc arity id = (Call (0 :num) (SOME loc) (id::GENLIST (λ(i :num). (Var i :exp)) arity) (NONE :exp option) :exp)
push_call_def_typed=push_call (n :num) (op :assoc_op) (acc :num) (exp :exp) (SOME ((ticks :num),(dest :α),(args :exp list),(handler :exp option))) = (Call ticks (SOME n) (args ++ [apply_op op (Var acc :exp) exp]) handler :exp) ∧ push_call (v0 :num) (v1 :assoc_op) (v2 :num) (v3 :exp) (NONE :(num # α # exp list # exp option) option) = dummy
dummy_def_typed=dummy = (Var (1234567890 :num) :exp)
