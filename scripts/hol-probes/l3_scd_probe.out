scd_definition=∀aq rl rd rs1 rs2. dfn'SC_D (aq,rl,rd,rs1,rs2) = (λstate. (let (v,s) = in32BitMode () state in if v then signalException Illegal_Instr s else (let v = GPR rs1 s in if (2 >< 0) v ≠ 0w then signalAddressException (AMO_Misaligned,v) s else if ¬matchLoadReservation v s then write'GPR (1w,rd) s else (let (v0,s) = translateAddr (v,Data,Read) s in case v0 of NONE => signalAddressException (Store_AMO_Fault,v) s | SOME pAddr => write'ReserveLoad NONE (write'GPR (0w,rd) (rawWriteData (pAddr,GPR rs2 s,8) s))))))
scd_type=:word1 # word1 # word5 # word5 # word5 -> riscv_state -> riscv_state
