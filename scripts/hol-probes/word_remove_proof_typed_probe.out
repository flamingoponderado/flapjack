alloc_compile_state_typed=alloc (w :α word) (names :sptree$num_set # sptree$num_set) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = ((I :α result option -> α result option) ## (compile_state clk c :(α, β, γ) state -> (α, β, γ) state)) (alloc w names s)
assign_compile_state_typed=assign (x :num) (y :α exp) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP (compile_state clk c :(α, β, γ) state -> (α, β, γ) state) (assign x y s)
call_env_compile_state_typed=call_env (x :α word_loc list) (lsz :num option) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (z :(α, β, γ) state)) = compile_state clk c (call_env x lsz z)
compile_state_def_typed=∀(clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state). compile_state clk c s = s with <|clock := s.clock + clk; termdep := (0 :num); code := map ((I :num -> num) ## (remove_must_terminate :α prog -> α prog)) s.code; compile_oracle := ((I :β -> β) ## MAP ((I :num -> num) ## (I :num -> num) ## (remove_must_terminate :α prog -> α prog))) ∘ s.compile_oracle; compile := c|>
compile_state_const_typed=(compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)).locals = s.locals ∧ (compile_state clk c s).permute = s.permute ∧ (compile_state clk c s).ffi = s.ffi ∧ (compile_state clk c s).code_buffer = s.code_buffer ∧ (compile_state clk c s).data_buffer = s.data_buffer ∧ (compile_state clk c s).code = map ((I :num -> num) ## (remove_must_terminate :α prog -> α prog)) s.code ∧ (compile_state clk c s).clock = s.clock + clk ∧ (compile_state clk c s).termdep = (0 :num) ∧ (compile_state clk c s).compile_oracle = ((I :β -> β) ## MAP ((I :num -> num) ## (I :num -> num) ## (remove_must_terminate :α prog -> α prog))) ∘ s.compile_oracle ∧ (compile_state clk c s).compile = c ∧ (compile_state clk c s).stack = s.stack ∧ (compile_state clk c s).store = s.store ∧ (compile_state clk c s).fp_regs = s.fp_regs ∧ (compile_state clk c s).memory = s.memory ∧ (compile_state clk c s).mdomain = s.mdomain ∧ (compile_state clk c s).sh_mdomain = s.sh_mdomain ∧ ((compile_state clk c s).be ⇔ s.be) ∧ (compile_state clk c s).gc_fun = s.gc_fun ∧ (compile_state clk c s).handler = s.handler ∧ (compile_state clk c s).locals_size = s.locals_size ∧ (compile_state clk c s).stack_size = s.stack_size ∧ (compile_state clk c s).stack_max = s.stack_max ∧ (compile_state clk c s).stack_limit = s.stack_limit
compile_state_dec_clock_typed=(s :(α, β, γ) state).clock ≠ (0 :num) ⇒ compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (dec_clock s) = dec_clock (compile_state clk c s)
compile_state_update_typed=compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state) with stack := (f1 :α stack_frame list) = compile_state clk c (s with stack := f1) ∧ compile_state clk c s with permute := (f2 :num -> num -> num) = compile_state clk c (s with permute := f2) ∧ compile_state clk c s with ffi := (f10 :δ ffi_state) = compile_state clk c (s with ffi := f10) ∧ compile_state clk c s with data_buffer := (f9 :(α, α) buffer) = compile_state clk c (s with data_buffer := f9) ∧ compile_state clk c s with code_buffer := (f8 :(α, 8) buffer) = compile_state clk c (s with code_buffer := f8) ∧ compile_state clk c s with memory := (f7 :α word -> α word_loc) = compile_state clk c (s with memory := f7) ∧ compile_state clk c s with locals := (f6 :α word_loc sptree$num_map) = compile_state clk c (s with locals := f6) ∧ compile_state clk c s with memory := (f5 :α word -> α word_loc) = compile_state clk c (s with memory := f5) ∧ compile_state clk c s with store := (f4 :store_name |-> α word_loc) = compile_state clk c (s with store := f4) ∧ compile_state clk c s with fp_regs := (f11 :num |-> word64) = compile_state clk c (s with fp_regs := f11) ∧ compile_state clk c s with handler := (f3 :num) = compile_state clk c (s with handler := f3) ∧ compile_state clk c s with locals_size := (f12 :num option) = compile_state clk c (s with locals_size := f12) ∧ compile_state clk c s with stack_size := (f13 :num sptree$num_map) = compile_state clk c (s with stack_size := f13) ∧ compile_state clk c s with stack_max := (f14 :num option) = compile_state clk c (s with stack_max := f14) ∧ compile_state clk c s with stack_limit := (f15 :num) = compile_state clk c (s with stack_limit := f15)
cut_state_compile_state_typed=cut_state (names :sptree$num_set # sptree$num_set) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP (compile_state clk c :(α, β, γ) state -> (α, β, γ) state) (cut_state names s)
find_code_map_I_typed=find_code (d :num option) (l :α word_loc list) (map ((I :num -> num) ## (f :δ -> β)) (t :(num # δ) sptree$num_map)) (lsz :γ sptree$num_map) = OPTION_MAP ((I :α word_loc list -> α word_loc list) ## f ## (I :γ option -> γ option)) (find_code d l t lsz)
flush_state_compile_state_typed=flush_state (x :bool) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (z :(α, β, γ) state)) = compile_state clk c (flush_state x z)
gc_compile_state_typed=gc (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP (compile_state clk c :(α, β, γ) state -> (α, β, γ) state) (gc s)
get_fp_var_compile_state_typed=get_fp_var (x :num) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = get_fp_var x s
get_store_compile_state_typed=get_store (x :store_name) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = get_store x s
