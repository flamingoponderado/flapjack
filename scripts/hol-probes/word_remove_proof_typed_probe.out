get_var_compile_state_typed=get_var (x :num) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = get_var x s
get_vars_compile_state_typed=get_vars (xs :num list) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = get_vars xs s
has_space_compile_state_typed=has_space (n :α word_loc) (compile_state (clk :num) (c :γ -> (num # num # β prog) list -> (word8 list # β word list # γ) option) (s :(β, γ, δ) state)) = has_space n s
inst_compile_state_typed=inst (i :α inst) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP (compile_state clk c :(α, β, γ) state -> (α, β, γ) state) (inst i s)
jump_exc_compile_state_typed=jump_exc (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP ((compile_state clk c :(α, β, γ) state -> (α, β, γ) state) ## (I :num # num -> num # num)) (jump_exc s)
mem_load_compile_state_typed=mem_load (w :α word) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = mem_load w s
mem_store_compile_state_typed=mem_store (x :α word) (y :α word_loc) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP (compile_state clk c :(α, β, γ) state -> (α, β, γ) state) (mem_store x y s)
pop_env_compile_state_typed=pop_env (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = OPTION_MAP (compile_state clk c :(α, β, γ) state -> (α, β, γ) state) (pop_env s)
push_env_case_handler_typed=(push_env (x :α word_loc sptree$num_map # α word_loc sptree$num_map) (case (handler :(num # α prog # num # num) option) of (NONE :(num # α prog # num # num) option) => (NONE :(num # α prog # num # num) option) | SOME (v,prog,l1,l2) => SOME (v,(f :α prog -> α prog) prog,l1,l2)) :(α, β, γ) state -> (α, β, γ) state) = (push_env x handler :(α, β, γ) state -> (α, β, γ) state)
push_env_compile_state_typed=push_env (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (h :(num # α prog # num # num) option) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = compile_state clk c (push_env env h s)
set_fp_var_compile_state_typed=set_fp_var (x :num) (y :word64) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = compile_state clk c (set_fp_var x y s)
set_store_compile_state_typed=set_store (x :store_name) (y :α word_loc) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = compile_state clk c (set_store x y s)
set_var_compile_state_typed=set_var (x :num) (y :α word_loc) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = compile_state clk c (set_var x y s)
set_vars_compile_state_typed=set_vars (xs :num list) (ys :α word_loc list) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = compile_state clk c (set_vars xs ys s)
unset_var_compile_state_typed=unset_var (x :num) (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) (s :(α, β, γ) state)) = compile_state clk c (unset_var x s)
word_exp_compile_state_typed=∀(s :(α, β, γ) state) (y :α exp). (word_exp (compile_state (clk :num) (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) s) y :α word_loc option) = (word_exp s y :α word_loc option)
word_remove_correct_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state). evaluate (prog,st) = (res,rst) ∧ st.compile = (λ(cfg :β). (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) cfg ∘ MAP ((I :num -> num) ## (I :num -> num) ## (remove_must_terminate :α prog -> α prog))) ∧ res ≠ SOME (Error :α result) ⇒ ∃(clk :num). evaluate (remove_must_terminate prog,compile_state clk c st) = (res,compile_state (0 :num) c rst)
