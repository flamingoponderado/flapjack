general_compile_correct_replay=∀(xs :bvl$exp list) (env :v list) (s1 :(α, β) state) (ys :bvl$exp list) (env1 :v list) (res :(v list, v) result) (s2 :(α, β) state) (extra :v list) (l :db_var_set) (s :num) (nr :bool). (compile (limit :num) (LENGTH env) xs :bvl$exp list # db_var_set # num # bool) = (ys,l,s,nr) ∧ (env_rel l env env1 :bool) ∧ evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate (ys,env1 ++ extra,s1) = (res,s2) ∧ (nr ⇒ ∀(e :v). res ≠ (Rerr (Rraise e) :(v list, v) result))
exported_compile_correct_352_replay=∀(l :db_var_set) (s :num) (nr :bool). (compile (limit :num) (LENGTH (env :v list)) (xs :bvl$exp list) :bvl$exp list # db_var_set # num # bool) = ((ys :bvl$exp list),l,s,nr) ∧ evaluate (xs,env,(s1 :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate (ys,env,s1) = (res,s2) ∧ (nr ⇒ ∀(e :v). res ≠ (Rerr (Rraise e) :(v list, v) result))
