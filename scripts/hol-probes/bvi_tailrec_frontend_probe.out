rewrites=[SOME (Let [Var 0; Op (IntOp (Const 0)) []] (Call 0 (SOME 58) [Var 0; Op (IntOp Add) [Var 1; Op (IntOp (Const 1)) []]] NONE),Call 0 (SOME 58) [Var 0; Op (IntOp Add) [Var 1; Op (IntOp (Const 1)) []]] NONE); SOME (Let [Var 0; Op (IntOp (Const 1)) []] (Call 0 (SOME 58) [Var 0; Op (IntOp Mult) [Var 1; Op (IntOp (Const 2)) []]] NONE),Call 0 (SOME 58) [Var 0; Op (IntOp Mult) [Var 1; Op (IntOp (Const 2)) []]] NONE); SOME (Let [Var 0; Op (IntOp (Const 0)) []] (If (Var 0) (Call 0 (SOME 58) [Var 0; Op (IntOp Add) [Var 1; Op (IntOp (Const 1)) []]] NONE) (Op (IntOp Add) [Var 1; Op (IntOp (Const 7)) []])),If (Var 0) (Call 0 (SOME 58) [Var 0; Op (IntOp Add) [Var 1; Op (IntOp (Const 1)) []]] NONE) (Op (IntOp Add) [Var 1; Op (IntOp (Const 7)) []])); SOME (Let [Var 0; Op (IntOp (Const 0)) []] (Let [Op (IntOp Less) [Var 0; Op (IntOp (Const 4)) []]] (Call 0 (SOME 58) [Var 0; Op (IntOp Add) [Var 2; Var 1]] NONE)),Let [Op (IntOp Less) [Var 0; Op (IntOp (Const 4)) []]] (Call 0 (SOME 58) [Var 0; Op (IntOp Add) [Var 2; Var 1]] NONE)); SOME (Let [Var 0; mk_unit] (Call 0 (SOME 58) [Var 0; Op (BlockOp ListAppend) [Var 1; mk_unit]] NONE),Call 0 (SOME 58) [Var 0; Op (BlockOp ListAppend) [Var 1; mk_unit]] NONE); NONE]
