scan_expr_def_typed=(∀(ts :v_ty list) (loc :num). scan_expr ts loc ([] :exp list) = ([] :(v_ty list # v_ty # bool # assoc_op option) list)) ∧ (∀(y :exp) (xs :exp list) (x :exp) (ts :v_ty list) (loc :num). scan_expr ts loc (x::y::xs) = (let ((tx :v_ty list),(ty :v_ty),(r :bool),(op :assoc_op option)) = HD (scan_expr ts loc [x]) in (tx,ty,r,op)::scan_expr tx loc (y::xs))) ∧ (∀(ts :v_ty list) (n :num) (loc :num). scan_expr ts loc [(Var n :exp)] = (let (ty :v_ty) = if n < LENGTH ts then ts❲n❳ else Any in [(ts,ty,F,(NONE :assoc_op option))])) ∧ (∀(xt :exp) (xi :exp) (xe :exp) (ts :v_ty list) (loc :num). scan_expr ts loc [(If xi xt xe :exp)] = (let ((ti :v_ty list),(tyi :v_ty),(_0' :bool),(oi :assoc_op option)) = HD (scan_expr ts loc [xi]); ((tt :v_ty list),(ty1 :v_ty),(_1 :bool),(ot :assoc_op option)) = HD (scan_expr ti loc [xt]); ((te :v_ty list),(ty2 :v_ty),(_2 :bool),(oe :assoc_op option)) = HD (scan_expr ti loc [xe]); (op :assoc_op option) = case ot of (NONE :assoc_op option) => oe | SOME v1 => ot; (ty :v_ty) = case op of (NONE :assoc_op option) => decide_ty ty1 ty2 | SOME opr => decide_ty ty1 (decide_ty ty2 (op_type opr)) in [((MAP2 decide_ty tt te :v_ty list),ty,IS_SOME oe,op)])) ∧ (∀(xs :exp list) (x :exp) (ts :v_ty list) (loc :num). scan_expr ts loc [(Let xs x :exp)] = (let (ys :(v_ty list # v_ty # bool # assoc_op option) list) = scan_expr ts loc xs; (tt :v_ty list) = MAP ((FST :v_ty # bool # assoc_op option -> v_ty) ∘ (SND :v_ty list # v_ty # bool # assoc_op option -> v_ty # bool # assoc_op option)) ys; (tr :v_ty list) = case LAST1 ys of (NONE :(v_ty list # v_ty # bool # assoc_op option) option) => ts | SOME c => FST c; ((tu :v_ty list),(ty :v_ty),(_0 :bool),(op :assoc_op option)) = HD (scan_expr (tt ++ tr) loc [x]) in [(DROP (LENGTH ys) tu,ty,F,op)])) ∧ (∀(x :exp) (ts :v_ty list) (loc :num). scan_expr ts loc [(Raise x :exp)] = [(ts,Any,F,(NONE :assoc_op option))]) ∧ (∀(x :exp) (ts :v_ty list) (loc :num). scan_expr ts loc [(Tick x :exp)] = scan_expr ts loc [x]) ∧ (∀(v0 :num) (ts :v_ty list) (n :num) (loc :num). scan_expr ts loc [(Force v0 n :exp)] = (let (ty :v_ty) = if n < LENGTH ts then ts❲n❳ else Any in [(ts,ty,F,(NONE :assoc_op option))])) ∧ (∀(xs :exp list) (ts :v_ty list) (t :num) (loc :num) (h :exp option) (d :num option). scan_expr ts loc [(Call t d xs h :exp)] = [(ts,Any,F,(NONE :assoc_op option))]) ∧ (∀(xs :exp list) (ts :v_ty list) (loc :num). scan_expr ts loc [(Return xs :exp)] = [(ts,Any,F,(NONE :assoc_op option))]) ∧ (∀(y :exp) (xs :exp list) (ts :v_ty list) (t :num) (rets :num) (loc :num) (d :num). scan_expr ts loc [LetCall rets t d xs y] = [(ts,Any,F,(NONE :assoc_op option))]) ∧ ∀(xs :exp list) (ts :v_ty list) (op :op) (loc :num). scan_expr ts loc [(Op op xs :exp)] = (let (opr :assoc_op) = from_op op; (opt :v_ty) = op_type opr in case opr of Plus => if IS_SOME (check_op ts opr loc (Op op xs :exp)) then [(ts,opt,F,SOME opr)] else if term_ok ts opt (Op op xs :exp) then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => [(ts,Any,F,(NONE :assoc_op option))] | SOME (x,y) => [(update_context opt ts x y,opt,F,(NONE :assoc_op option))] else [(ts,Any,F,(NONE :assoc_op option))] | Times => if IS_SOME (check_op ts opr loc (Op op xs :exp)) then [(ts,opt,F,SOME opr)] else if term_ok ts opt (Op op xs :exp) then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => [(ts,Any,F,(NONE :assoc_op option))] | SOME (x,y) => [(update_context opt ts x y,opt,F,(NONE :assoc_op option))] else [(ts,Any,F,(NONE :assoc_op option))] | Append => if IS_SOME (check_op ts opr loc (Op op xs :exp)) then [(ts,opt,F,SOME opr)] else if term_ok ts opt (Op op xs :exp) then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => [(ts,Any,F,(NONE :assoc_op option))] | SOME (x,y) => [(update_context opt ts x y,opt,F,(NONE :assoc_op option))] else [(ts,Any,F,(NONE :assoc_op option))] | Noop => if arg_ty op = Int then case get_bin_args (Op op xs :exp) of (NONE :(exp # exp) option) => if is_const op then [(ts,Int,F,(NONE :assoc_op option))] else [(ts,Any,F,(NONE :assoc_op option))] | SOME (x,y) => if ¬is_const op then [(update_context Int ts x y,Any,F,(NONE :assoc_op option))] else [(ts,Any,F,(NONE :assoc_op option))] else if op = BlockOp (Cons (0 :num) :block_op) ∧ xs = ([] :exp list) then [(ts,List,F,(NONE :assoc_op option))] else [(ts,Any,F,(NONE :assoc_op option))])
check_exp_def_typed=∀(loc :num) (arity :num) (exp :exp). check_exp loc arity exp = if ¬has_rec1 loc exp then (NONE :assoc_op option) else (let (context :v_ty list) = REPLICATE arity Any in case scan_expr context loc [exp] of ([] :(v_ty list # v_ty # bool # assoc_op option) list) => (NONE :assoc_op option) | (ts,ty,r,opr)::v1 => case opr of (NONE :assoc_op option) => (NONE :assoc_op option) | SOME op => if ty ≠ op_type op then (NONE :assoc_op option) else opr)
rewrite_def_typed=(∀(ts :v_ty list) (opr :assoc_op) (next :num) (n :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Var n :exp) = (F,(Var n :exp))) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (If x1 x2 x3 :exp) = (let (t1 :v_ty list) = FST (HD (scan_expr ts loc [x1])); ((r2 :bool),(y2 :exp)) = rewrite loc next opr acc t1 x2; ((r3 :bool),(y3 :exp)) = rewrite loc next opr acc t1 x3; (z2 :exp) = if r2 then y2 else apply_op opr (Var acc :exp) x2; (z3 :exp) = if r3 then y3 else apply_op opr (Var acc :exp) x3 in (r2 ∨ r3,(If x1 z2 z3 :exp)))) ∧ (∀(xs :exp list) (x :exp) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Let xs x :exp) = (let (ys :(v_ty list # v_ty # bool # assoc_op option) list) = scan_expr ts loc xs; (tt :v_ty list) = MAP ((FST :v_ty # bool # assoc_op option -> v_ty) ∘ (SND :v_ty list # v_ty # bool # assoc_op option -> v_ty # bool # assoc_op option)) ys; (tr :v_ty list) = case LAST1 ys of (NONE :(v_ty list # v_ty # bool # assoc_op option) option) => ts | SOME c => FST c; ((r :bool),(y :exp)) = rewrite loc next opr (acc + LENGTH xs) (tt ++ tr) x in (r,(Let xs y :exp)))) ∧ (∀(x :exp) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Tick x :exp) = (let ((r :bool),(y :exp)) = rewrite loc next opr acc ts x in (r,(Tick y :exp)))) ∧ (∀(v :num) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (l :num) (acc :num). rewrite loc next opr acc ts (Force l v :exp) = (F,(Force l v :exp))) ∧ (∀(v18 :exp) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Raise v18 :exp) = case check_op ts opr loc (Raise v18 :exp) of (NONE :exp option) => (F,apply_op opr (Var acc :exp) (Raise v18 :exp)) | SOME v1 => case opbinargs opr v1 of (NONE :(exp # exp) option) => (F,apply_op opr (Var acc :exp) v1) | SOME (xs,f) => (T,push_call next opr acc xs (args_from f))) ∧ (∀(v23 :exp option) (v22 :exp list) (v21 :num option) (v20 :num) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Call v20 v21 v22 v23 :exp) = case check_op ts opr loc (Call v20 v21 v22 v23 :exp) of (NONE :exp option) => (F,apply_op opr (Var acc :exp) (Call v20 v21 v22 v23 :exp)) | SOME v1 => case opbinargs opr v1 of (NONE :(exp # exp) option) => (F,apply_op opr (Var acc :exp) v1) | SOME (xs,f) => (T,push_call next opr acc xs (args_from f))) ∧ (∀(v27 :exp list) (v26 :op) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Op v26 v27 :exp) = case check_op ts opr loc (Op v26 v27 :exp) of (NONE :exp option) => (F,apply_op opr (Var acc :exp) (Op v26 v27 :exp)) | SOME v1 => case opbinargs opr v1 of (NONE :(exp # exp) option) => (F,apply_op opr (Var acc :exp) v1) | SOME (xs,f) => (T,push_call next opr acc xs (args_from f))) ∧ (∀(v32 :exp) (v31 :exp list) (v30 :num) (v29 :num) (v28 :num) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (LetCall v28 v29 v30 v31 v32) = case check_op ts opr loc (LetCall v28 v29 v30 v31 v32) of (NONE :exp option) => (F,apply_op opr (Var acc :exp) (LetCall v28 v29 v30 v31 v32)) | SOME v1 => case opbinargs opr v1 of (NONE :(exp # exp) option) => (F,apply_op opr (Var acc :exp) v1) | SOME (xs,f) => (T,push_call next opr acc xs (args_from f))) ∧ ∀(v33 :exp list) (ts :v_ty list) (opr :assoc_op) (next :num) (loc :num) (acc :num). rewrite loc next opr acc ts (Return v33 :exp) = case check_op ts opr loc (Return v33 :exp) of (NONE :exp option) => (F,apply_op opr (Var acc :exp) (Return v33 :exp)) | SOME v1 => case opbinargs opr v1 of (NONE :(exp # exp) option) => (F,apply_op opr (Var acc :exp) v1) | SOME (xs,f) => (T,push_call next opr acc xs (args_from f))
compile_exp_def_typed=∀(loc :num) (next :num) (arity :num) (exp :exp). (compile_exp loc next arity exp :(exp # exp) option) = case check_exp loc arity exp of (NONE :assoc_op option) => (NONE :(exp # exp) option) | SOME op => (let (context :v_ty list) = REPLICATE arity Any; ((r :bool),(opt :exp)) = rewrite loc next op arity context exp; (aux :exp) = let_wrap arity (id_from_op op) opt in SOME (aux,opt))
compile_each_def_typed=(∀(next :num). compile_each next ([] :(num # num # exp) list) = (next,([] :(num # num # exp) list))) ∧ ∀(xs :(num # num # exp) list) (next :num) (loc :num) (exp :exp) (arity :num). compile_each next ((loc,arity,exp)::xs) = case (compile_exp loc next arity exp :(exp # exp) option) of (NONE :(exp # exp) option) => (let ((n :num),(ys :(num # num # exp) list)) = compile_each next xs in (n,(loc,arity,exp)::ys)) | SOME (exp_aux,exp_opt) => (let ((n :num),(ys :(num # num # exp) list)) = compile_each (next + bvl_to_bvi_namespaces) xs in (n,(loc,arity,exp_aux)::(next,arity + (1 :num),exp_opt)::ys))
compile_prog_def_typed=∀(do_it :bool) (next :num) (xs :(num # num # exp) list). (compile_prog do_it next xs :num # (num # num # exp) list) = if do_it then compile_each next xs else (next,xs)
