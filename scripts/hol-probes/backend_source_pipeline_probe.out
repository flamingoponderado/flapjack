to_flat_typed=⊢ ∀(c :config) (p :dec list). to_flat c p = (let (p :dec list) = (compile p :dec list); ((c' :source_to_flat$config),(p :flatLang$exp list)) = (compile c.source_conf p :source_to_flat$config # flatLang$exp list); (c :config) = c with source_conf := c' in (c,p))
to_clos_typed=⊢ ∀(c :config) (p :dec list). to_clos c p = (let ((c :config),(p :flatLang$exp list)) = to_flat c p; (p :closLang$exp list) = (compile_prog p :closLang$exp list) in (c,p))
to_bvl_typed=⊢ ∀(c :config) (p :dec list). to_bvl c p = (let ((c :config),(p :closLang$exp list)) = to_clos c p; ((c' :clos_to_bvl$config),(p :(num # num # bvl$exp) list),(names :mlstring sptree$num_map)) = (compile c.clos_conf p :clos_to_bvl$config # (num # num # bvl$exp) list # mlstring sptree$num_map); (c :config) = c with clos_conf := c' in (c,p,names))
to_bvi_typed=⊢ ∀(c :config) (p :dec list). to_bvi c p = (let ((c :config),(p :(num # num # bvl$exp) list),(names :mlstring sptree$num_map)) = to_bvl c p; ((s :num),(p :(num # num # bvi$exp) list),(l :(num # bvl$exp) sptree$num_map),(bl :(num # bvi$exp) sptree$num_map),(n1 :num),(n2 :num),(n3 :num),(names :mlstring sptree$num_map)) = (compile c.clos_conf.start c.bvl_conf names p :num # (num # num # bvi$exp) list # (num # bvl$exp) sptree$num_map # (num # bvi$exp) sptree$num_map # num # num # num # mlstring sptree$num_map); (names :mlstring sptree$num_map) = (union (fromAList (stub_names () ++ stub_names () ++ stub_names () ++ stub_names ())) names :mlstring sptree$num_map); (c :config) = c with clos_conf updated_by (λ(c :clos_to_bvl$config). c with start := s); (c :config) = c with bvl_conf updated_by (λ(c :bvl_to_bvi$config). c with <|inlines := l; bvi_inlines := bl; next_name1 := n1; next_name2 := n2; next_name3 := n3|>) in (c,p,names))
to_data_typed=⊢ ∀(c :config) (p :dec list). to_data c p = (let ((c :config),(p :(num # num # bvi$exp) list),(names :mlstring sptree$num_map)) = to_bvi c p; (p :(num # num # dataLang$prog) list) = (compile_prog p :(num # num # dataLang$prog) list) in (c,p,names))
