∃(bytes :word8 list).
  enc_with_nop mc_conf.target.config.encode
    (Inst (Mem Store8 r2 (Addr r1 (0w :α word))) :α asm) bytes ∧
  bytes_in_memory (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) bytes
    t1.mem t1.mem_domain ∧
  bytes_in_mem (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) bytes
    t1.mem t1.mem_domain s1.mem_domain ∧
  pos_val (s1.pc + (1 :num)) (0 :num) code2 =
  pos_val s1.pc (0 :num) code2 + LENGTH bytes ∧
  asm_ok (Inst (Mem Store8 r2 (Addr r1 (0w :α word))) :α asm)
    mc_conf.target.config
IMP_bytes_in_memory_CallFFI=code_similar s1.code code2 ∧
all_enc_ok mc_conf.target.config labs ffi_names 0 code2 ∧
bytes_in_mem p (prog_to_bytes code2) t1.mem t1.mem_domain s1.mem_domain ∧
asm_fetch s1 = SOME (LabAsm (CallFFI name) l bytes n) ⇒
∃tt enc.
  tt =
  0w −
  n2w
    (pos_val s1.pc 0 code2 +
     (3 + get_ffi_index ffi_names (ExtCall name)) * ffi_offset) ∧
  enc = mc_conf.target.config.encode (Jump tt) ∧
  bytes_in_memory (p + n2w (pos_val s1.pc 0 code2)) enc t1.mem t1.mem_domain ∧
  asm_ok (Jump tt) mc_conf.target.config
IMP_bytes_in_memory_CallFFI_types=code_similar (s1 :(α, config, 'ffi) labSem$state).code (code2 :α sec list) ∧
all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config
  (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list)
  (0 :num) code2 ∧
bytes_in_mem (p :α word) (prog_to_bytes code2) (t1 :α asm_state).mem
  t1.mem_domain s1.mem_domain ∧
asm_fetch s1 =
SOME
  (LabAsm (CallFFI (name :mlstring) :α asm_with_lab) (l :α word)
     (bytes :word8 list) (n :num)) ⇒
∃(tt :α word) (enc :word8 list).
  tt =
  (0w :α word) −
  (n2w
     (pos_val s1.pc (0 :num) code2 +
      ((3 :num) + get_ffi_index ffi_names (ExtCall name)) * ffi_offset) :
   α word) ∧ enc = mc_conf.target.config.encode (Jump tt :α asm) ∧
  bytes_in_memory (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) enc
    t1.mem t1.mem_domain ∧ asm_ok (Jump tt :α asm) mc_conf.target.config
