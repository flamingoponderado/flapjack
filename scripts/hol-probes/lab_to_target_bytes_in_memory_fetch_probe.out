bytes_in_mem_IMP_memory=∀xs a.
  (∀a. a ∉ dm1 ⇒ m a = m1 a) ⇒
  bytes_in_mem a xs m dm dm1 ⇒
  bytes_in_memory a xs m1 dm
bytes_in_mem_IMP_memory_types=∀(xs :word8 list) (a :α word).
  (∀(a :α word).
     a ∉ (dm1 :α word -> bool) ⇒
     (m :α word -> word8) a = (m1 :α word -> word8) a) ⇒
  bytes_in_mem a xs m (dm :α word -> bool) dm1 ⇒
  bytes_in_memory a xs m1 dm
asm_fetch_aux_pos_val_LENGTH_EQ=∀pc n code2 line.
  asm_fetch_aux pc code2 = SOME line ∧
  all_enc_ok conf labs ffi_names n code2 ∧
  pos_val (pc + 1) n code2 = LENGTH bytes' + pos_val pc n code2 ⇒
  LENGTH (line_bytes line) = LENGTH bytes'
asm_fetch_aux_pos_val_LENGTH_EQ_types=∀(pc :num) (n :num) (code2 :α sec list) (line :α line).
  asm_fetch_aux pc code2 = SOME line ∧
  all_enc_ok (conf :α asm_config) (labs :num sptree$num_map sptree$num_map)
    (ffi_names :ffiname list) n code2 ∧
  pos_val (pc + (1 :num)) n code2 =
  LENGTH (bytes' :word8 list) + pos_val pc n code2 ⇒
  LENGTH (line_bytes line) = LENGTH bytes'
IMP_bytes_in_memory_ShareMem=asm_fetch_aux s1.pc s1.code = SOME (Asm (ShareMem mop r ad) l n) ∧
code_similar s1.code code2 ∧
all_enc_ok mc_conf.target.config labs ffi_names 0 code2 ∧
bytes_in_mem p (prog_to_bytes code2) t1.mem t1.mem_domain s1.mem_domain ⇒
∃bytes.
  asm_fetch_aux s1.pc code2 =
  SOME (Asm (ShareMem mop r ad) bytes (LENGTH bytes)) ∧
  enc_with_nop mc_conf.target.config.encode (Inst (Mem mop r ad)) bytes ∧
  bytes_in_memory (p + n2w (pos_val s1.pc 0 code2)) bytes t1.mem
    t1.mem_domain ∧
  bytes_in_mem (p + n2w (pos_val s1.pc 0 code2)) bytes t1.mem t1.mem_domain
    s1.mem_domain ∧
  pos_val (s1.pc + 1) 0 code2 = pos_val s1.pc 0 code2 + LENGTH bytes ∧
  asm_ok (Inst (Mem mop r ad)) mc_conf.target.config
IMP_bytes_in_memory_ShareMem_types=asm_fetch_aux (s1 :(α, config, 'ffi) labSem$state).pc s1.code =
SOME
  (Asm (ShareMem (mop :memop) (r :num) (ad :α addr)) (l :word8 list) (n :num)) ∧
code_similar s1.code (code2 :α sec list) ∧
all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config
  (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list)
  (0 :num) code2 ∧
bytes_in_mem (p :α word) (prog_to_bytes code2) (t1 :α asm_state).mem
  t1.mem_domain s1.mem_domain ⇒
∃(bytes :word8 list).
  asm_fetch_aux s1.pc code2 =
  SOME (Asm (ShareMem mop r ad) bytes (LENGTH bytes)) ∧
  enc_with_nop mc_conf.target.config.encode (Inst (Mem mop r ad) :α asm)
    bytes ∧
  bytes_in_memory (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) bytes
    t1.mem t1.mem_domain ∧
  bytes_in_mem (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) bytes
    t1.mem t1.mem_domain s1.mem_domain ∧
  pos_val (s1.pc + (1 :num)) (0 :num) code2 =
  pos_val s1.pc (0 :num) code2 + LENGTH bytes ∧
  asm_ok (Inst (Mem mop r ad) :α asm) mc_conf.target.config
