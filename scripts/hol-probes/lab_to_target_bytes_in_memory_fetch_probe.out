prog_to_bytes_lemma=∀code2 code1 pc i pos.
  code_similar code1 code2 ∧
  all_enc_ok mc_conf.target.config labs ffi_names pos code2 ∧
  asm_fetch_aux pc code1 = SOME i ⇒
  ∃bs j bs2.
    prog_to_bytes code2 = bs ++ line_bytes j ++ bs2 ∧
    LENGTH bs + pos = pos_val pc pos code2 ∧
    LENGTH bs + pos + LENGTH (line_bytes j) = pos_val (pc + 1) pos code2 ∧
    line_similar i j ∧
    line_ok mc_conf.target.config labs ffi_names (pos_val pc pos code2) j
prog_to_bytes_lemma_types=∀(code2 :α sec list) (code1 :α sec list) (pc :num) (i :α line) (pos :num).
  code_similar code1 code2 ∧
  all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config
    (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list) pos
    code2 ∧ asm_fetch_aux pc code1 = SOME i ⇒
  ∃(bs :word8 list) (j :α line) (bs2 :word8 list).
    prog_to_bytes code2 = bs ++ line_bytes j ++ bs2 ∧
    LENGTH bs + pos = pos_val pc pos code2 ∧
    LENGTH bs + pos + LENGTH (line_bytes j) =
    pos_val (pc + (1 :num)) pos code2 ∧ line_similar i j ∧
    line_ok mc_conf.target.config labs ffi_names (pos_val pc pos code2) j
IMP_bytes_in_memory=code_similar code1 code2 ∧
all_enc_ok mc_conf.target.config labs ffi_names 0 code2 ∧
asm_fetch_aux pc code1 = SOME i ∧
bytes_in_mem p (prog_to_bytes code2) m dm dm1 ⇒
∃j. bytes_in_mem (p + n2w (pos_val pc 0 code2)) (line_bytes j) m dm dm1 ∧
    line_ok mc_conf.target.config labs ffi_names (pos_val pc 0 code2) j ∧
    pos_val (pc + 1) 0 code2 = pos_val pc 0 code2 + LENGTH (line_bytes j) ∧
    line_similar i j
IMP_bytes_in_memory_types=code_similar (code1 :α sec list) (code2 :α sec list) ∧
all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config
  (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list)
  (0 :num) code2 ∧ asm_fetch_aux (pc :num) code1 = SOME (i :α line) ∧
bytes_in_mem (p :α word) (prog_to_bytes code2) (m :α word -> word8)
  (dm :α word -> bool) (dm1 :α word -> bool) ⇒
∃(j :α line).
  bytes_in_mem (p + (n2w (pos_val pc (0 :num) code2) :α word)) (line_bytes j)
    m dm dm1 ∧
  line_ok mc_conf.target.config labs ffi_names (pos_val pc (0 :num) code2) j ∧
  pos_val (pc + (1 :num)) (0 :num) code2 =
  pos_val pc (0 :num) code2 + LENGTH (line_bytes j) ∧ line_similar i j
IMP_bytes_in_memory_JumpReg=code_similar s1.code code2 ∧
all_enc_ok mc_conf.target.config labs ffi_names 0 code2 ∧
bytes_in_mem p (prog_to_bytes code2) t1.mem t1.mem_domain s1.mem_domain ∧
asm_fetch s1 = SOME (Asm (Asmi (JumpReg r1)) l n) ⇒
bytes_in_memory (p + n2w (pos_val s1.pc 0 code2))
  (mc_conf.target.config.encode (JumpReg r1)) t1.mem t1.mem_domain ∧
asm_ok (JumpReg r1) mc_conf.target.config
IMP_bytes_in_memory_JumpReg_types=code_similar (s1 :(α, γ, δ) labSem$state).code (code2 :α sec list) ∧
all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config
  (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list)
  (0 :num) code2 ∧
bytes_in_mem (p :α word) (prog_to_bytes code2) (t1 :α asm_state).mem
  t1.mem_domain s1.mem_domain ∧
asm_fetch s1 =
SOME (Asm (Asmi (JumpReg (r1 :num) :α asm)) (l :word8 list) (n :num)) ⇒
bytes_in_memory (p + (n2w (pos_val s1.pc (0 :num) code2) :α word))
  (mc_conf.target.config.encode (JumpReg r1 :α asm)) t1.mem t1.mem_domain ∧
asm_ok (JumpReg r1 :α asm) mc_conf.target.config
IMP_bytes_in_memory_Jump=code_similar s1.code code2 ∧
all_enc_ok mc_conf.target.config labs ffi_names 0 code2 ∧
bytes_in_mem p (prog_to_bytes code2) t1.mem t1.mem_domain s1.mem_domain ∧
asm_fetch s1 = SOME (LabAsm (Jump jtarget) l bytes n) ⇒
∃tt enc.
  tt = n2w (find_pos jtarget labs) − n2w (pos_val s1.pc 0 code2) ∧
  enc = mc_conf.target.config.encode (Jump tt) ∧
  bytes_in_memory (p + n2w (pos_val s1.pc 0 code2)) enc t1.mem t1.mem_domain ∧
  asm_ok (Jump tt) mc_conf.target.config
IMP_bytes_in_memory_Jump_types=code_similar (s1 :(α, config, 'ffi) labSem$state).code (code2 :α sec list) ∧
all_enc_ok (mc_conf :(α, 'state, β) machine_config).target.config
  (labs :num sptree$num_map sptree$num_map) (ffi_names :ffiname list)
  (0 :num) code2 ∧
bytes_in_mem (p :α word) (prog_to_bytes code2) (t1 :α asm_state).mem
  t1.mem_domain s1.mem_domain ∧
asm_fetch s1 =
SOME
  (LabAsm (Jump (jtarget :lab) :α asm_with_lab) (l :α word)
     (bytes :word8 list) (n :num)) ⇒
∃(tt :α word) (enc :word8 list).
  tt =
  (n2w (find_pos jtarget labs) :α word) −
  (n2w (pos_val s1.pc (0 :num) code2) :α word) ∧
  enc = mc_conf.target.config.encode (Jump tt :α asm) ∧
  bytes_in_memory (p + (n2w (pos_val s1.pc (0 :num) code2) :α word)) enc
    t1.mem t1.mem_domain ∧ asm_ok (Jump tt :α asm) mc_conf.target.config
