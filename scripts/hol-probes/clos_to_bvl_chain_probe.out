chain_installed_def=∀(start :num) (es :closLang$exp list) (code :num |-> num # closLang$exp). chain_installed start es code ⇔ ∀(i :num). i < LENGTH es ⇒ (find_code (start + i) ([] :closSem$v list) code :(closSem$v list # closLang$exp) option) = SOME (([] :closSem$v list),if i + (1 :num) < LENGTH es then (Let None [es❲i❳] (Call None (0 :num) (start + i + (1 :num)) ([] :closLang$exp list) :closLang$exp) :closLang$exp) else es❲i❳)
chain_installed_cons=chain_installed (start :num) ((e :closLang$exp)::(es :closLang$exp list)) (code :num |-> num # closLang$exp) ⇔ (find_code start ([] :closSem$v list) code :(closSem$v list # closLang$exp) option) = SOME (([] :closSem$v list),if es = ([] :closLang$exp list) then e else (Let None [e] (Call None (0 :num) (start + (1 :num)) ([] :closLang$exp list) :closLang$exp) :closLang$exp)) ∧ chain_installed (start + (1 :num)) es code
chain_installed_SUBMAP=∀(start :num) (es :closLang$exp list) (code :num |-> num # closLang$exp) (code' :num |-> num # closLang$exp). chain_installed start es code ∧ code ⊑ code' ⇒ chain_installed start es code'
chain_installed_thm=∀(es :closLang$exp list) (start :num). ∃(e :closLang$exp). ∀(st :(α, β) closSem$state) (code :γ) (res :(closSem$v list, closSem$v) result) (st' :(α, β) closSem$state). chain_installed start es st.code ∧ evaluate (es,([] :closSem$v list),st) = (res,st') ∧ (0 :num) < LENGTH es ⇒ ∃(k :num) (res1 :(closSem$v list, closSem$v) result) (st1 :(α, β) closSem$state). (find_code start ([] :closSem$v list) st.code :(closSem$v list # closLang$exp) option) = SOME (([] :closSem$v list),e) ∧ evaluate ([e],([] :closSem$v list),st with clock := st.clock + k) = (res1,st1) ∧ result_rel (λ(x :closSem$v list) (y :closSem$v list). T) (λ(x :closSem$v) (y :closSem$v). T) res1 res ∧ st'.ffi = st1.ffi
chain_installed_chain_exps=∀(start :num) (es :closLang$exp list). chain_installed start es (alist_to_fmap (chain_exps start es))
chain_exps_GT_typed=∀(n :num) (xs :closLang$exp list). xs ≠ ([] :closLang$exp list) ⇒ EVERY ($> (n + LENGTH xs)) (MAP (FST :num # num # closLang$exp -> num) (chain_exps n xs))
chain_exps_LE_typed=∀(n :num) (xs :closLang$exp list). EVERY ($<= n) (MAP (FST :num # num # closLang$exp -> num) (chain_exps n xs))
chain_exps_ALL_DISTINCT_typed=ALL_DISTINCT (MAP (FST :num # num # closLang$exp -> num) (chain_exps (i :num) (ls :closLang$exp list)))
every_Fn_vs_SOME_def_typed=(every_Fn_vs_SOME ([] :closLang$exp list) ⇔ T) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). every_Fn_vs_SOME (x::y::xs) ⇔ every_Fn_vs_SOME [x] ∧ every_Fn_vs_SOME (y::xs)) ∧ (∀(v0 :tra) (v :num). every_Fn_vs_SOME [(Var v0 v :closLang$exp)] ⇔ T) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (v1 :tra). every_Fn_vs_SOME [(If v1 x1 x2 x3 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1] ∧ every_Fn_vs_SOME [x2] ∧ every_Fn_vs_SOME [x3]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (v2 :tra). every_Fn_vs_SOME [(Let v2 xs x2 :closLang$exp)] ⇔ every_Fn_vs_SOME [x2] ∧ every_Fn_vs_SOME xs) ∧ (∀(x1 :closLang$exp) (v3 :tra). every_Fn_vs_SOME [(Raise v3 x1 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1]) ∧ (∀(x1 :closLang$exp) (v4 :tra). every_Fn_vs_SOME [(Tick v4 x1 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1]) ∧ (∀(xs :closLang$exp list) (v5 :tra) (op :closLang$op). every_Fn_vs_SOME [(Op v5 op xs :closLang$exp)] ⇔ every_Fn_vs_SOME xs) ∧ (∀(x2 :closLang$exp list) (x1 :closLang$exp) (v6 :tra) (loc_opt :num option). every_Fn_vs_SOME [(App v6 loc_opt x1 x2 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1] ∧ every_Fn_vs_SOME x2) ∧ (∀(x1 :closLang$exp) (vs_opt :num list option) (v7 :mlstring) (num_args :num) (loc :num option). every_Fn_vs_SOME [Fn v7 loc vs_opt num_args x1] ⇔ IS_SOME vs_opt ∧ every_Fn_vs_SOME [x1]) ∧ (∀(x1 :closLang$exp) (vs_opt :num list option) (v8 :mlstring list) (loc :num option) (fns :(num # closLang$exp) list). every_Fn_vs_SOME [(Letrec v8 loc vs_opt fns x1 :closLang$exp)] ⇔ IS_SOME vs_opt ∧ every_Fn_vs_SOME (MAP (SND :num # closLang$exp -> closLang$exp) fns) ∧ every_Fn_vs_SOME [x1]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (v9 :tra). every_Fn_vs_SOME [(Handle v9 x1 x2 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1] ∧ every_Fn_vs_SOME [x2]) ∧ ∀(xs :closLang$exp list) (v10 :tra) (ticks :num) (dest :num). every_Fn_vs_SOME [(Call v10 ticks dest xs :closLang$exp)] ⇔ every_Fn_vs_SOME xs
num_stubs_def_typed=∀(max_app :num). num_stubs max_app = max_app + max_app * (max_app − (1 :num)) DIV (2 :num) + (1 :num) + (1 :num)
compile_prog_code_locs_typed=∀(ls :(num # num # closLang$exp) list). MAP (FST :num # num # bvl$exp -> num) (compile_prog (max_app :num) ls) = MAP ($+ (num_stubs max_app) ∘ (FST :num # num # closLang$exp -> num)) ls ++ MAP ($+ (num_stubs max_app)) (REVERSE (code_locs (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) ls)))
compile_exps_code_locs_typed=∀(max_app :num) (xs :closLang$exp list) (aux :(num # num # bvl$exp) list) (ys :bvl$exp list) (aux2 :(num # num # bvl$exp) list). compile_exps max_app xs aux = (ys,aux2 ++ aux) ⇒ MAP (FST :num # num # bvl$exp -> num) aux2 = MAP ($+ (num_stubs max_app)) (REVERSE (code_locs xs))
chain_exps_every_Fn_SOME_typed=∀(es :closLang$exp list) (l :num). every_Fn_SOME es ⇒ every_Fn_SOME (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps l es))
chain_exps_every_Fn_SOME_8596_replay=∀(x :num) (y :closLang$exp list). every_Fn_SOME (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps x y)) ⇔ every_Fn_SOME y
chain_exps_every_Fn_vs_SOME_typed=∀(x :num) (y :closLang$exp list). every_Fn_vs_SOME (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps x y)) ⇔ every_Fn_vs_SOME y
chain_exps_obeys_max_app_typed=∀(es :closLang$exp list) (l :num). EVERY (obeys_max_app (k :num)) es ⇒ EVERY (obeys_max_app k) (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps l es))
chain_exps_no_Labels_typed=∀(es :closLang$exp list) (l :num). EVERY no_Labels es ⇒ EVERY no_Labels (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps l es))
