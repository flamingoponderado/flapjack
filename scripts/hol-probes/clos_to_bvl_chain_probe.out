chain_installed_def=∀(start :num) (es :closLang$exp list) (code :num |-> num # closLang$exp). chain_installed start es code ⇔ ∀(i :num). i < LENGTH es ⇒ (find_code (start + i) ([] :closSem$v list) code :(closSem$v list # closLang$exp) option) = SOME (([] :closSem$v list),if i + (1 :num) < LENGTH es then (Let None [es❲i❳] (Call None (0 :num) (start + i + (1 :num)) ([] :closLang$exp list) :closLang$exp) :closLang$exp) else es❲i❳)
chain_installed_cons=chain_installed (start :num) ((e :closLang$exp)::(es :closLang$exp list)) (code :num |-> num # closLang$exp) ⇔ (find_code start ([] :closSem$v list) code :(closSem$v list # closLang$exp) option) = SOME (([] :closSem$v list),if es = ([] :closLang$exp list) then e else (Let None [e] (Call None (0 :num) (start + (1 :num)) ([] :closLang$exp list) :closLang$exp) :closLang$exp)) ∧ chain_installed (start + (1 :num)) es code
chain_installed_SUBMAP=∀(start :num) (es :closLang$exp list) (code :num |-> num # closLang$exp) (code' :num |-> num # closLang$exp). chain_installed start es code ∧ code ⊑ code' ⇒ chain_installed start es code'
chain_installed_thm=∀(es :closLang$exp list) (start :num). ∃(e :closLang$exp). ∀(st :(α, β) closSem$state) (code :γ) (res :(closSem$v list, closSem$v) result) (st' :(α, β) closSem$state). chain_installed start es st.code ∧ evaluate (es,([] :closSem$v list),st) = (res,st') ∧ (0 :num) < LENGTH es ⇒ ∃(k :num) (res1 :(closSem$v list, closSem$v) result) (st1 :(α, β) closSem$state). (find_code start ([] :closSem$v list) st.code :(closSem$v list # closLang$exp) option) = SOME (([] :closSem$v list),e) ∧ evaluate ([e],([] :closSem$v list),st with clock := st.clock + k) = (res1,st1) ∧ result_rel (λ(x :closSem$v list) (y :closSem$v list). T) (λ(x :closSem$v) (y :closSem$v). T) res1 res ∧ st'.ffi = st1.ffi
chain_installed_chain_exps=∀(start :num) (es :closLang$exp list). chain_installed start es (alist_to_fmap (chain_exps start es))
