every_Fn_vs_SOME_def_typed=(every_Fn_vs_SOME ([] :closLang$exp list) ⇔ T) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). every_Fn_vs_SOME (x::y::xs) ⇔ every_Fn_vs_SOME [x] ∧ every_Fn_vs_SOME (y::xs)) ∧ (∀(v0 :tra) (v :num). every_Fn_vs_SOME [(Var v0 v :closLang$exp)] ⇔ T) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (v1 :tra). every_Fn_vs_SOME [(If v1 x1 x2 x3 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1] ∧ every_Fn_vs_SOME [x2] ∧ every_Fn_vs_SOME [x3]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (v2 :tra). every_Fn_vs_SOME [(Let v2 xs x2 :closLang$exp)] ⇔ every_Fn_vs_SOME [x2] ∧ every_Fn_vs_SOME xs) ∧ (∀(x1 :closLang$exp) (v3 :tra). every_Fn_vs_SOME [(Raise v3 x1 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1]) ∧ (∀(x1 :closLang$exp) (v4 :tra). every_Fn_vs_SOME [(Tick v4 x1 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1]) ∧ (∀(xs :closLang$exp list) (v5 :tra) (op :closLang$op). every_Fn_vs_SOME [(Op v5 op xs :closLang$exp)] ⇔ every_Fn_vs_SOME xs) ∧ (∀(x2 :closLang$exp list) (x1 :closLang$exp) (v6 :tra) (loc_opt :num option). every_Fn_vs_SOME [(App v6 loc_opt x1 x2 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1] ∧ every_Fn_vs_SOME x2) ∧ (∀(x1 :closLang$exp) (vs_opt :num list option) (v7 :mlstring) (num_args :num) (loc :num option). every_Fn_vs_SOME [Fn v7 loc vs_opt num_args x1] ⇔ IS_SOME vs_opt ∧ every_Fn_vs_SOME [x1]) ∧ (∀(x1 :closLang$exp) (vs_opt :num list option) (v8 :mlstring list) (loc :num option) (fns :(num # closLang$exp) list). every_Fn_vs_SOME [(Letrec v8 loc vs_opt fns x1 :closLang$exp)] ⇔ IS_SOME vs_opt ∧ every_Fn_vs_SOME (MAP (SND :num # closLang$exp -> closLang$exp) fns) ∧ every_Fn_vs_SOME [x1]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (v9 :tra). every_Fn_vs_SOME [(Handle v9 x1 x2 :closLang$exp)] ⇔ every_Fn_vs_SOME [x1] ∧ every_Fn_vs_SOME [x2]) ∧ ∀(xs :closLang$exp list) (v10 :tra) (ticks :num) (dest :num). every_Fn_vs_SOME [(Call v10 ticks dest xs :closLang$exp)] ⇔ every_Fn_vs_SOME xs
num_stubs_def_typed=∀(max_app :num). num_stubs max_app = max_app + max_app * (max_app − (1 :num)) DIV (2 :num) + (1 :num) + (1 :num)
compile_prog_code_locs_typed=∀(ls :(num # num # closLang$exp) list). MAP (FST :num # num # bvl$exp -> num) (compile_prog (max_app :num) ls) = MAP ($+ (num_stubs max_app) ∘ (FST :num # num # closLang$exp -> num)) ls ++ MAP ($+ (num_stubs max_app)) (REVERSE (code_locs (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) ls)))
compile_exps_code_locs_typed=∀(max_app :num) (xs :closLang$exp list) (aux :(num # num # bvl$exp) list) (ys :bvl$exp list) (aux2 :(num # num # bvl$exp) list). compile_exps max_app xs aux = (ys,aux2 ++ aux) ⇒ MAP (FST :num # num # bvl$exp -> num) aux2 = MAP ($+ (num_stubs max_app)) (REVERSE (code_locs xs))
chain_exps_every_Fn_SOME_typed=∀(es :closLang$exp list) (l :num). every_Fn_SOME es ⇒ every_Fn_SOME (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps l es))
