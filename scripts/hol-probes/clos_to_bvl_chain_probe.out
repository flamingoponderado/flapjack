chain_exps_obeys_max_app_typed=∀(es :closLang$exp list) (l :num). EVERY (obeys_max_app (k :num)) es ⇒ EVERY (obeys_max_app k) (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps l es))
chain_exps_no_Labels_typed=∀(es :closLang$exp list) (l :num). EVERY no_Labels es ⇒ EVERY no_Labels (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (chain_exps l es))
