val subOp = ``(INL asm$Sub : asm$binop + asm$cmp)``;
val addOp = ``(INL asm$Add : asm$binop + asm$cmp)``;
val _ = print_eval "valid_imm_sub_min12" ``^cfg.valid_imm ^subOp (-2048w : 64 word)``;
val _ = print_eval "valid_imm_sub_min12p1" ``^cfg.valid_imm ^subOp (-2047w : 64 word)``;
val _ = print_eval "valid_imm_add_min12" ``^cfg.valid_imm ^addOp (-2048w : 64 word)``;
val _ = print_eval "valid_imm_add_max12" ``^cfg.valid_imm ^addOp (2047w : 64 word)``;
val _ = print_eval "valid_imm_add_max12p1" ``^cfg.valid_imm ^addOp (2048w : 64 word)``;
val _ = (print "native_config_type=";print_type(type_of cfg);print "\n");
val _ = (print "native_config_encode_type=";print_type(type_of ``riscv_config.encode``);print "\n");
val _ = print("native_config_hypotheses="^Int.toString(length(hyp riscv_config_def))^"\n");
val _ = (print "native_config_definition=";print_term(concl riscv_config_def);print "\n");
val encoder_eq=prove(``riscv_config.encode = riscv_enc``,SIMP_TAC(srw_ss())[riscv_config_def]);
val _ = if null(hyp encoder_eq) then
 (print "native_config_encode_equation=";print_term(concl encoder_eq);print "\n";print "native_config_encode_hypotheses=0\n")
 else raise Fail "native config encoder equation has assumptions";
