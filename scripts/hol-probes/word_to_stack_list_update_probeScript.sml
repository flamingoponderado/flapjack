      DROP n (list_LUPDATE xs i ys) = DROP n ys``,   Induct \\ fs [list_LUPDATE_def] \\ rpt strip_tac
  \\ `LENGTH xs + (i+1) <= n /\ i < n` by decide_tac
  \\ fs [DROP_LUPDATE]);
val _ = (if null(hyp DROP_list_LUPDATE_IGNORE) then () else raise Fail "open premise"; print "lu_full_DROP_list_LUPDATE_IGNORE="; print_thm DROP_list_LUPDATE_IGNORE; print "\n");
