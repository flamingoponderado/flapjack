load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _ = capture "lines_enc_with_nop_add_nop" lines_enc_with_nop_add_nop;
val _ = types "lines_enc_with_nop_add_nop_types" lines_enc_with_nop_add_nop;
val _ = show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc(QCONV (SIMP_CONV (srw_ss()) []) (rconc(EVAL q)))); print "\n");
val enc = ``(λa:8 asm. case a of Jump w => [w] | JumpCmp c r i w => [w] | Loc r w => [w] | _ => [0w])``;
val mixed = ``[Label 1 2 0;Asm (Asmi (Inst Skip)) [0w] 1;LabAsm (Jump (Lab 1 2)) 77w [251w] 1] : 8 labLang$line list``;
val labfirst = ``[Label 1 2 0;LabAsm (Jump (Lab 1 2)) 77w [250w] 1;Asm (Asmi (Inst Skip)) [0w] 1] : 8 labLang$line list``;
val _ = observe "mixed_before_after" ``lines_enc_with_nop ^enc LN [] 5 (REVERSE ^mixed) /\ lines_enc_with_nop ^enc LN [] 5 (REVERSE(add_nop (^enc (Inst Skip)) ^mixed))``;
val _ = observe "mixed_full_tuple" ``add_nop (^enc (Inst Skip)) ^mixed = [Label 1 2 0;Asm (Asmi (Inst Skip)) [0w;0w] 2;LabAsm (Jump (Lab 1 2)) 77w [251w] 1]``;
val _ = observe "labfirst_before_after" ``lines_enc_with_nop ^enc LN [] 5 (REVERSE ^labfirst) /\ lines_enc_with_nop ^enc LN [] 5 (REVERSE(add_nop (^enc (Inst Skip)) ^labfirst))``;
val _ = observe "labfirst_full_tuple" ``add_nop (^enc (Inst Skip)) ^labfirst = [Label 1 2 0;LabAsm (Jump (Lab 1 2)) 77w [250w;0w] 2;Asm (Asmi (Inst Skip)) [0w] 1]``;
val _ = observe "all_labels_unchanged" ``add_nop (^enc (Inst Skip)) ([Label 1 2 0;Label 1 3 0]:8 labLang$line list) = [Label 1 2 0;Label 1 3 0]``;
val _ = observe "empty_unchanged" ``lines_enc_with_nop ^enc LN [] 5 (REVERSE(add_nop (^enc (Inst Skip)) ([]:8 labLang$line list)))``;
val _ = observe "halt_before_after" ``lines_enc_with_nop ^enc LN [] 5 [LabAsm Halt 77w [235w] 1] /\ lines_enc_with_nop ^enc LN [] 5 (REVERSE(add_nop (^enc (Inst Skip)) [LabAsm Halt 77w [235w] 1]))``;
val _ = observe "call_before_after" ``lines_enc_with_nop ^enc LN [] 5 [LabAsm (Call (Lab 1 2)) 77w [99w] 1] /\ lines_enc_with_nop ^enc LN [] 5 (REVERSE(add_nop (^enc (Inst Skip)) [LabAsm (Call (Lab 1 2)) 77w [99w] 1]))``;
val _ = observe "one_byte_guard_required" ``~lines_enc_with_nop (λa:8 asm.[0w;0w]) LN [] 5 (REVERSE(add_nop [0w;0w] [Asm (Asmi (Inst Skip)) [0w;0w] 2]))``;
