rb_definition_exp=⊢ (∀n k. reg_bound_exp (Var n) k ⇔ n < k) ∧ (∀k e. reg_bound_exp (Load e) k ⇔ reg_bound_exp e k) ∧ (∀v0 k e2 e1. reg_bound_exp (Shift v0 e1 e2) k ⇔ reg_bound_exp e1 k ∧ reg_bound_exp e2 k) ∧ (∀v2 v1. reg_bound_exp (Lookup v1) v2 ⇔ F) ∧ (∀v3 k es. reg_bound_exp (Op v3 es) k ⇔ EVERY (λe. reg_bound_exp e k) es) ∧ ∀v7 v5. reg_bound_exp (Const v7) v5 ⇔ T
rb_definition_inst=⊢ (reg_bound_inst (Mem v0 n (Addr a v1)) k ⇔ n < k ∧ a < k) ∧ (reg_bound_inst (Const n v2) k ⇔ n < k) ∧ (reg_bound_inst (Arith (Shift v3 n r2 ri)) k ⇔ r2 < k ∧ n < k ∧ case ri of Reg r => r < k | Imm v3 => T) ∧ (reg_bound_inst (Arith (Binop v4 n r2 ri)) k ⇔ r2 < k ∧ n < k ∧ case ri of Reg r1 => r1 < k | Imm v3 => T) ∧ (reg_bound_inst (Arith (Div r1 r2 r3)) k ⇔ r1 < k ∧ r2 < k ∧ r3 < k) ∧ (reg_bound_inst (Arith (AddCarry r1 r2 r3 r4)) k ⇔ r1 < k ∧ r2 < k ∧ r3 < k ∧ r4 < k) ∧ (reg_bound_inst (Arith (AddOverflow r1 r2 r3 r4)) k ⇔ r1 < k ∧ r2 < k ∧ r3 < k ∧ r4 < k) ∧ (reg_bound_inst (Arith (SubOverflow r1 r2 r3 r4)) k ⇔ r1 < k ∧ r2 < k ∧ r3 < k ∧ r4 < k) ∧ (reg_bound_inst (Arith (LongMul r1 r2 r3 r4)) k ⇔ r1 < k ∧ r2 < k ∧ r3 < k ∧ r4 < k) ∧ (reg_bound_inst (Arith (LongDiv r1 r2 r3 r4 r5)) k ⇔ r1 < k ∧ r2 < k ∧ r3 < k ∧ r4 < k ∧ r5 < k) ∧ (reg_bound_inst (FP (FPLess r f1 f2)) k ⇔ r < k) ∧ (reg_bound_inst (FP (FPLessEqual r f1 f2)) k ⇔ r < k) ∧ (reg_bound_inst (FP (FPEqual r f1 f2)) k ⇔ r < k) ∧ (reg_bound_inst (FP (FPMovToReg r1 r2 d)) k ⇔ r1 < k ∧ r2 < k) ∧ (reg_bound_inst (FP (FPMovFromReg d r1 r2)) k ⇔ r1 < k ∧ r2 < k) ∧ (reg_bound_inst Skip v6 ⇔ T) ∧ (reg_bound_inst (FP (FPAbs v99 v100)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPNeg v101 v102)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPSqrt v103 v104)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPAdd v105 v106 v107)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPSub v108 v109 v110)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPMul v111 v112 v113)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPDiv v114 v115 v116)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPFma v117 v118 v119)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPMov v120 v121)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPToInt v128 v129)) v6 ⇔ T) ∧ (reg_bound_inst (FP (FPFromInt v130 v131)) v6 ⇔ T)
rb_definition_prog=⊢ (∀v1 k. reg_bound (Halt v1) k ⇔ v1 < k) ∧ (∀v1 k. reg_bound (Raise v1) k ⇔ v1 < k) ∧ (∀v1 n k. reg_bound (Get v1 n) k ⇔ v1 < k) ∧ (∀v2 v1 op k. reg_bound (OpCurrHeap op v1 v2) k ⇔ v1 < k ∧ v2 < k) ∧ (∀v1 n k. reg_bound (Set n v1) k ⇔ v1 < k ∧ n ≠ BitmapBase) ∧ (∀v1 l2 l1 k. reg_bound (LocValue v1 l1 l2) k ⇔ v1 < k) ∧ (∀v0 t2 t1 k. reg_bound (StoreConsts t1 t2 v0) k ⇔ 3 < k ∧ t1 < k ∧ t2 < k) ∧ (∀v1 k. reg_bound (Return v1) k ⇔ v1 < k) ∧ (∀v2 v1 k dest. reg_bound (JumpLower v1 v2 dest) k ⇔ v1 < k ∧ v2 < k) ∧ (∀p2 p1 k. reg_bound (Seq p1 p2) k ⇔ reg_bound p1 k ∧ reg_bound p2 k) ∧ (∀ri r p2 p1 k c. reg_bound (If c r ri p1 p2) k ⇔ r < k ∧ (case ri of Reg n => n < k | Imm v3 => T) ∧ reg_bound p1 k ∧ reg_bound p2 k) ∧ (∀p1 k. reg_bound (Loop p1) k ⇔ reg_bound p1 k) ∧ (∀ret' ptr2' ptr' len2' len' k ffi_index. reg_bound (FFI ffi_index ptr' len' ptr2' len2' ret') k ⇔ ptr' < k ∧ len' < k ∧ ptr2' < k ∧ len2' < k ∧ ret' < k) ∧ (∀x2 x1 k dest. reg_bound (Call x1 dest x2) k ⇔ (case dest of INL v2 => T | INR i => i < k) ∧ case x1 of NONE => T | SOME (v4,v6,v7) => reg_bound v4 k ∧ v6 < k ∧ case x2 of NONE => T | SOME (v1,v2) => reg_bound v1 k) ∧ (∀ret ptr len k dptr dlen. reg_bound (Install ptr len dptr dlen ret) k ⇔ ptr < k ∧ len < k ∧ dptr < k ∧ dlen < k ∧ ret < k) ∧ (∀v3 r op k a. reg_bound (ShMemOp op r (Addr a v3)) k ⇔ r < k ∧ a < k) ∧ (∀r2 r1 k. reg_bound (CodeBufferWrite r1 r2) k ⇔ r1 < k ∧ r2 < k) ∧ (∀r2 r1 k. reg_bound (DataBufferWrite r1 r2) k ⇔ r1 < k ∧ r2 < k) ∧ (∀v r k. reg_bound (BitmapLoad r v) k ⇔ r < k ∧ v < k) ∧ (∀k i. reg_bound (Inst i) k ⇔ reg_bound_inst i k) ∧ (∀v4 r k. reg_bound (StackStore r v4) k ⇔ r < k) ∧ (∀r k. reg_bound (StackSetSize r) k ⇔ r < k) ∧ (∀r k. reg_bound (StackGetSize r) k ⇔ r < k) ∧ (∀r n k. reg_bound (StackLoad r n) k ⇔ r < k) ∧ (∀r2 r k. reg_bound (StackLoadAny r r2) k ⇔ r < k ∧ r2 < k) ∧ (∀r2 r k. reg_bound (StackStoreAny r r2) k ⇔ r < k ∧ r2 < k) ∧ (∀k. reg_bound Skip k ⇔ T) ∧ (∀v32 k. reg_bound (Alloc v32) k ⇔ T) ∧
  (∀v38 k. reg_bound (Break v38) k ⇔ T) ∧ (∀v39 k. reg_bound (Continue v39) k ⇔ T) ∧ (∀k. reg_bound Tick k ⇔ T) ∧ (∀v61 k. reg_bound (RawCall v61) k ⇔ T) ∧ (∀v62 k. reg_bound (StackAlloc v62) k ⇔ T) ∧ ∀v63 k. reg_bound (StackFree v63) k ⇔ T
