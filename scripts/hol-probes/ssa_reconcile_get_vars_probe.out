ssa_reconcile_get_vars_original_proof=∀ls cur_ssa cst. ALL_DISTINCT ls ∧ (∀v. MEM v ls ⇒ ∃val. lookup (THE (lookup v cur_ssa)) cst.locals = SOME val) ⇒ ∃vs. get_vars (MAP (λv. THE (lookup v cur_ssa)) ls) cst = SOME vs ∧ LENGTH vs = LENGTH ls ∧ ∀i. i < LENGTH ls ⇒ lookup (THE (lookup ls❲i❳ cur_ssa)) cst.locals = SOME vs❲i❳
ssa_reconcile_get_vars_original_type=:num list | :num sptree$num_map | :(α, β, γ) state
