riscv_encoder_correct_jumpcmp_statement=∀(s2 :64 asm_state) (s1 :64 asm_state) (right :64 reg_imm) (r :num) (ms :riscv_state) (cmp :cmp) (a :word64). asm_step riscv_target.config s1 (JumpCmp cmp r right a) s2 ∧ target_state_rel riscv_target s1 ms ⇒ ∃(n :num). ∀(env :num -> riscv_state -> riscv_state). interference_ok env (riscv_target.proj s1.mem_domain) ⇒ (let (pcs :num -> word64 -> bool) = all_pcs (LENGTH (riscv_target.config.encode (JumpCmp cmp r right a))) s1.pc in asserts n (λ(k :num) (s :riscv_state). env (n − k) (riscv_target.next s)) ms (λ(ms' :riscv_state). riscv_target.state_ok ms' ∧ (∀(pc :word64). pc ∈ pcs (0 :num) ⇒ riscv_target.get_byte ms' pc = riscv_target.get_byte ms pc) ∧ riscv_target.get_pc ms' ∈ pcs riscv_target.config.code_alignment) (λ(ms' :riscv_state). target_state_rel riscv_target s2 ms') ∧ asserts2 (n + (1 :num)) (λ(k :num). env (n + (1 :num) − k)) riscv_target.next ms (λ(ms1 :riscv_state) (ms2 :riscv_state). ∀(x :word64). x ∉ s1.mem_domain ⇒ riscv_target.get_byte ms1 x = riscv_target.get_byte ms2 x))
