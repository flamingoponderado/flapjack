csa_statement=∀s res s2 t1 k off jump r n. evaluate (StackStoreAny r n,s) = (res,s2) ∧ res ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound (StackStoreAny r n) k ⇒ ∃ck t2. evaluate (comp jump off k (StackStoreAny r n),t1 with clock := ck + t1.clock) = (res,t2) ∧ case res of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
csa_proved=T
