wload2_full_register_transport=⊢ ∀x t s r' r lens k f' f c ac. wReg2 r (k,f,f') = (x,r') ∧ EVEN r ∧ get_var r s = SOME c ∧ state_rel ac k f f' s t lens 0 ⇒ ∃t'. evaluate (wStackLoad x Skip,t) = (NONE,t') ∧ t.clock = t'.clock ∧ t.bitmaps = t'.bitmaps ∧ state_rel ac k f f' s t' lens 0 ∧ LENGTH t'.stack = LENGTH t.stack ∧ t'.stack_space = t.stack_space ∧ (∀r. r ≠ k + 1 ⇒ get_var r t' = get_var r t) ∧ (∀r c. r ≠ k + 1 ⇒ word_exp t' (Op Add [Var r; Const c]) = word_exp t (Op Add [Var r; Const c])) ∧ get_var r' t' = SOME c
wload2_full_hypotheses=0
wload2_full_proved=T
wload2_original_register_compiler=⊢ ∀r k f f'. wReg2 r (k,f,f') = (let r = r DIV 2 in if r < k then ([],r) else ([(k + 1,f − 1 − (r − k))],k + 1))
