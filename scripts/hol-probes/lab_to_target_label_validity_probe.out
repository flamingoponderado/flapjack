enc_sec_list_sec_labels_ok=∀(enc :α asm -> word8 list) (code :α sec list).
  EVERY (sec_labels_ok :α sec -> bool) code ⇒
  EVERY (sec_labels_ok :α sec -> bool) (enc_sec_list enc code)
enc_sec_list_sec_labels_ok_types=(enc :α asm -> word8 list)::α asm -> word8 list;(code :α sec list)::α sec list;
enc_lines_again_sec_labels_ok=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (lines :α line list) (acc :α line list)
    (ok :bool) (res :α line list) (ok' :num # bool) (k :num).
  enc_lines_again labs ffis pos enc lines (acc,ok) = (res,ok') ∧
  EVERY (sec_label_ok k :α line -> bool) acc ∧
  EVERY (sec_label_ok k :α line -> bool) lines ⇒
  EVERY (sec_label_ok k :α line -> bool) res
enc_lines_again_sec_labels_ok_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α line list)::α line list;(acc :α line list)::α line list;(ok :bool)::bool;(res :α line list)::α line list;(ok' :num # bool)::num # bool;(k :num)::num;
enc_secs_again_sec_labels_ok=∀(pos :num) (ffis :num sptree$num_map sptree$num_map) (labs :ffiname list)
    (enc :α asm -> word8 list) (ls :α sec list) (res :α sec list) (ok :bool)
    (k :β).
  enc_secs_again pos ffis labs enc ls = (res,ok) ∧
  EVERY (sec_labels_ok :α sec -> bool) ls ⇒
  EVERY (sec_labels_ok :α sec -> bool) res
enc_secs_again_sec_labels_ok_types=(pos :num)::num;(ffis :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(labs :ffiname list)::ffiname list;(enc :α asm -> word8 list)::α asm -> word8 list;(ls :α sec list)::α sec list;(res :α sec list)::α sec list;(ok :bool)::bool;(k :β)::β;
lines_upd_lab_len_sec_label_ok=∀(pos :num) (lines :α line list) (acc :α line list) (k :num).
  EVERY (sec_label_ok k :α line -> bool) lines ∧
  EVERY (sec_label_ok k :α line -> bool) acc ⇒
  EVERY (sec_label_ok k :α line -> bool)
    (FST (lines_upd_lab_len pos lines acc))
lines_upd_lab_len_sec_label_ok_types=(pos :num)::num;(lines :α line list)::α line list;(acc :α line list)::α line list;(k :num)::num;
upd_lab_len_sec_labels_ok=∀(n :num) (ls :α sec list).
  EVERY (sec_labels_ok :α sec -> bool) ls ⇒
  EVERY (sec_labels_ok :α sec -> bool) (upd_lab_len n ls)
upd_lab_len_sec_labels_ok_types=(n :num)::num;(ls :α sec list)::α sec list;
add_nop_sec_label_ok=∀(nop :word8 list) (aux :α line list).
  EVERY (sec_label_ok (k :num) :α line -> bool) aux ⇒
  EVERY (sec_label_ok k :α line -> bool) (add_nop nop aux)
add_nop_sec_label_ok_types=(nop :word8 list)::word8 list;(aux :α line list)::α line list;(k :num)::num;
pad_section_sec_label_ok=∀(nop :word8 list) (xs :α line list) (acc :α line list) (k :num).
  EVERY (sec_label_ok k :α line -> bool) xs ∧
  EVERY (sec_label_ok k :α line -> bool) acc ⇒
  EVERY (sec_label_ok k :α line -> bool) (pad_section nop xs acc)
pad_section_sec_label_ok_types=(nop :word8 list)::word8 list;(xs :α line list)::α line list;(acc :α line list)::α line list;(k :num)::num;
pad_code_sec_labels_ok=∀(nop :word8 list) (code :α sec list).
  EVERY (sec_labels_ok :α sec -> bool) code ⇒
  EVERY (sec_labels_ok :α sec -> bool) (pad_code nop code)
pad_code_sec_labels_ok_types=(nop :word8 list)::word8 list;(code :α sec list)::α sec list;
