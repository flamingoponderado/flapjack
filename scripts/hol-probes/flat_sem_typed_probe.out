do_test_def_typed=(∀(ty :prim_type) (v1 :v) (v2 :v). do_test Equal ty v1 v2 = if check_type ty v1 ∧ check_type ty v2 then if ty = Float64T then Eq_val (fp64_equal (the_Litv_Float64 v1) (the_Litv_Float64 v2)) else do_eq v1 v2 else Eq_type_error) ∧ (∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (Compare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (v3,(NONE :lit option),v8) => Eq_type_error | (v3,SOME v10,(NONE :lit option)) => Eq_type_error | (BoolT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (IntT,SOME (IntLit i),SOME (IntLit j)) => Eq_val (int_cmp cmp i j) | (CharT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (StrT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (WordT v38,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (Float64T,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Char v32),SOME (IntLit j)) => Eq_type_error | (v3,SOME (StrLit v33),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word8 v34),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word64 v35),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Float64 v36),SOME (IntLit j)) => Eq_type_error | (v3,SOME (IntLit v45),SOME (Char d)) => Eq_type_error | (BoolT,SOME (Char c),SOME (Char d)) => Eq_type_error | (IntT,SOME (Char c),SOME (Char d)) => Eq_type_error | (CharT,SOME (Char c),SOME (Char d)) => Eq_val (num_cmp cmp (ORD c) (ORD d) :bool) | (StrT,SOME (Char c),SOME (Char d)) => Eq_type_error | (WordT v52,SOME (Char c),SOME (Char d)) => Eq_type_error | (Float64T,SOME (Char c),SOME (Char d)) => Eq_type_error | (v3,SOME (StrLit v47),SOME (Char d)) => Eq_type_error | (v3,SOME (Word8 v48),SOME (Char d)) => Eq_type_error | (v3,SOME (Word64 v49),SOME (Char d)) => Eq_type_error | (v3,SOME (Float64 v50),SOME (Char d)) => Eq_type_error | (v3,SOME (IntLit v59),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Char v60),SOME (StrLit t)) => Eq_type_error | (BoolT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (IntT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (CharT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (StrLit t)) => Eq_val (str_cmp F cmp s t) | (WordT v66,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (Float64T,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Word8 v62),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Word64 v63),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Float64 v64),SOME (StrLit t)) => Eq_type_error | (v3,SOME (IntLit v73),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Char v74),SOME (Word8 v)) => Eq_type_error | (v3,SOME (StrLit v75),SOME (Word8 v)) => Eq_type_error | (BoolT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (IntT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (CharT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (StrT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (WordT W8,SOME (Word8 w),SOME (Word8 v)) => Eq_val (num_cmp cmp (w2n w) (w2n v) :bool) | (WordT W64,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (Float64T,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Word64 v77),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Float64 v78),SOME (Word8 v)) => Eq_type_error | (v3,SOME v10,SOME (Word64 v23)) => Eq_type_error | (v3,SOME (IntLit v87),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Char v88),SOME (Float64 v')) => Eq_type_error | (v3,SOME (StrLit v89),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Word8 v90),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Word64 v91),SOME (Float64 v')) => Eq_type_error | (BoolT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (IntT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (CharT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (StrT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (WordT v94,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (Float64T,SOME (Float64 w'),SOME (Float64 v')) => Eq_val (fp_cmp cmp w' v')) ∧ ∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (AltCompare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (BoolT,v3) => Eq_type_error | (IntT,v3) => Eq_type_error | (CharT,v3) => Eq_type_error | (StrT,(NONE :lit option),v9) => Eq_type_error | (StrT,SOME (IntLit v18),v9) => Eq_type_error | (StrT,SOME (Char v19),v9) => Eq_type_error | (StrT,SOME (StrLit s),(NONE :lit option)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (IntLit v32)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Char v33)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (StrLit t)) => Eq_val (str_cmp T cmp s t) | (StrT,SOME (StrLit s),SOME (Word8 v35)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Word64 v36)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Float64 v37)) => Eq_type_error | (StrT,SOME (Word8 v21),v9) => Eq_type_error | (StrT,SOME (Word64 v22),v9) => Eq_type_error | (StrT,SOME (Float64 v23),v9) => Eq_type_error | (WordT v5,v3) => Eq_type_error | (Float64T,v3) => Eq_type_error
bind_exn_v_def_typed=bind_exn_v = Conv (SOME (bind_tag,(NONE :num option))) ([] :v list)
chr_exn_v_def_typed=chr_exn_v = Conv (SOME (chr_tag,(NONE :num option))) ([] :v list)
div_exn_v_def_typed=div_exn_v = Conv (SOME (div_tag,(NONE :num option))) ([] :v list)
subscript_exn_v_def_typed=subscript_exn_v = Conv (SOME (subscript_tag,(NONE :num option))) ([] :v list)
pmatch_def_typed=(∀(x :mlstring) (v' :v) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch s (Pvar x :pat) v' bindings :(mlstring # v) list match_result) = Match ((x,v')::bindings)) ∧ (∀(v' :v) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch s Pany v' bindings :(mlstring # v) list match_result) = Match bindings) ∧ (∀(s :(α, β) state) (l' :lit) (l :lit) (bindings :(mlstring # v) list). (pmatch s (Plit l :pat) (Litv l' :v) bindings :(mlstring # v) list match_result) = if l = l' then Match bindings else if lit_same_type l l' then (No_match :(mlstring # v) list match_result) else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(vs :v list) (stmp' :(num # num option) option) (stmp :(num # (num # (num # num) list) option) option) (s :(α, β) state) (ps :pat list) (bindings :(mlstring # v) list). (pmatch s (Pcon stmp ps) (Conv stmp' vs) bindings :(mlstring # v) list match_result) = if ¬pmatch_stamps_ok stmp stmp' (LENGTH ps) (LENGTH vs) then (Match_type_error :(mlstring # v) list match_result) else if OPTION_MAP (FST :num # (num # (num # num) list) option -> num) stmp = OPTION_MAP (FST :num # num option -> num) stmp' ∧ LENGTH ps = LENGTH vs then (pmatch_list s ps vs bindings :(mlstring # v) list match_result) else (No_match :(mlstring # v) list match_result)) ∧ (∀(v :v) (s :(α, β) state) (p :pat) (i :mlstring) (bindings :(mlstring # v) list). (pmatch s (Pas p i) v bindings :(mlstring # v) list match_result) = (pmatch s p v ((i,v)::bindings) :(mlstring # v) list match_result)) ∧ (∀(v0 :bool) (s :(α, β) state) (p :pat) (lnum :num) (bindings :(mlstring # v) list). (pmatch s (Pref p) (Loc v0 lnum :v) bindings :(mlstring # v) list match_result) = case store_lookup lnum s.refs of (NONE :v store_v option) => (Match_type_error :(mlstring # v) list match_result) | SOME (Refv v) => (pmatch s p v bindings :(mlstring # v) list match_result) | SOME (W8array v9 :v store_v) => (Match_type_error :(mlstring # v) list match_result) | SOME (Varray v10) => (Match_type_error :(mlstring # v) list match_result) | SOME (Thunk v11 v12) => (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v34 :v list) (v33 :(num # num option) option) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Conv v33 v34) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v37 :exp) (v36 :mlstring) (v35 :v environment) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Closure v35 v36 v37 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v40 :mlstring) (v39 :(mlstring # mlstring # exp) list) (v38 :v environment) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Recclosure v38 v39 v40 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v42 :num) (v41 :bool) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Loc v41 v42 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v43 :v list) (v19 :lit) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Plit v19 :pat) (Vectorv v43) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v56 :lit) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Litv v56 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v61 :exp) (v60 :mlstring) (v59 :v environment) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Closure v59 v60 v61 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v64 :mlstring) (v63 :(mlstring # mlstring # exp) list) (v62 :v environment) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Recclosure v62 v63 v64 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v66 :num) (v65 :bool) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Loc v65 v66 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v67 :v list) (v21 :pat list) (v20 :(num # (num # (num # num) list) option) option) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pcon v20 v21) (Vectorv v67) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v80 :lit) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Litv v80 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v82 :v list) (v81 :(num # num option) option) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Conv v81 v82) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v85 :exp) (v84 :mlstring) (v83 :v environment) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Closure v83 v84 v85 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v88 :mlstring) (v87 :(mlstring # mlstring # exp) list) (v86 :v environment) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Recclosure v86 v87 v88 :v) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v91 :v list) (v24 :pat) (v1 :(α, β) state) (bindings :(mlstring # v) list). (pmatch v1 (Pref v24) (Vectorv v91) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(s :(α, β) state) (bindings :(mlstring # v) list). (pmatch_list s ([] :pat list) ([] :v list) bindings :(mlstring # v) list match_result) = Match bindings) ∧ (∀(vs :v list) (v :v) (s :(α, β) state) (ps :pat list) (p :pat) (bindings :(mlstring # v) list). (pmatch_list s (p::ps) (v::vs) bindings :(mlstring # v) list match_result) = case (pmatch s p v bindings :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (case (pmatch_list s ps vs bindings :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match bindings' => (pmatch_list s ps vs bindings' :(mlstring # v) list match_result)) ∧ (∀(v115 :pat list) (v114 :pat) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch_list s (v114::v115) ([] :v list) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)) ∧ ∀(v111 :v list) (v110 :v) (s :(α, β) state) (bindings :(mlstring # v) list). (pmatch_list s ([] :pat list) (v110::v111) bindings :(mlstring # v) list match_result) = (Match_type_error :(mlstring # v) list match_result)
pmatch_rows_def_typed=(∀(v :v) (s :(β, γ) state). pmatch_rows ([] :(pat # α) list) s v = (No_match :((mlstring # v) list # pat # α) match_result)) ∧ ∀(v :v) (s :(β, γ) state) (pes :(pat # α) list) (p :pat) (e :α). pmatch_rows ((p,e)::pes) s v = case (pmatch s p v ([] :(mlstring # v) list) :(mlstring # v) list match_result) of (No_match :(mlstring # v) list match_result) => pmatch_rows pes s v | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :((mlstring # v) list # pat # α) match_result) | Match env => case pmatch_rows pes s v of (No_match :((mlstring # v) list # pat # α) match_result) => Match (env,p,e) | (Match_type_error :((mlstring # v) list # pat # α) match_result) => (Match_type_error :((mlstring # v) list # pat # α) match_result) | Match v1 => Match (env,p,e)
do_if_def_typed=∀(v :v) (e1 :α) (e2 :α). do_if v e1 e2 = if v = (Boolv T :v) then SOME e1 else if v = (Boolv F :v) then SOME e2 else (NONE :α option)
do_if_either_or_typed=do_if (v :v) (e1 :α) (e2 :α) = SOME (e :α) ⇒ e = e1 ∨ e = e2
AppUnit_def_typed=∀(x :exp). AppUnit x = (App None (Src Opapp) [x; (Con None (NONE :(num # num option) option) ([] :exp list) :exp)] :exp)
dec_clock_def_typed=∀(s :(α, β) state). dec_clock s = s with clock := s.clock − (1 :num)
fix_clock_def_typed=∀(s :(δ, ε) state) (s1 :(α, β) state) (res :γ). fix_clock s (s1,res) = (s1 with clock := MIN s.clock s1.clock,res)
v_to_bytes_def_typed=∀(lv :v). v_to_bytes lv = some(ns :word8 list). v_to_list lv = SOME (MAP (Litv ∘ Word8) ns)
v_to_words_def_typed=∀(lv :v). v_to_words lv = some(ns :word64 list). v_to_list lv = SOME (MAP (Litv ∘ Word64) ns)
do_eval_def_typed=∀(vs :v list) (eval_config :α install_config). (do_eval vs eval_config :(exp list # α install_config # v) option) = case vs of ([] :v list) => (NONE :(exp list # α install_config # v) option) | [v1] => (NONE :(exp list # α install_config # v) option) | [v1; v2] => (case (v_to_bytes v1,v_to_words v2) of ((NONE :word8 list option),v4) => (NONE :(exp list # α install_config # v) option) | (SOME bytes,(NONE :word64 list option)) => (NONE :(exp list # α install_config # v) option) | (SOME bytes,SOME data) => (let ((st :α),(decs :exp list)) = eval_config.compile_oracle (0 :num); (new_oracle :num -> α # exp list) = shift_seq (1 :num) eval_config.compile_oracle in case eval_config.compile st decs of (NONE :(word8 list # word64 list # α) option) => (NONE :(exp list # α install_config # v) option) | SOME (bytes',data',st') => if bytes = bytes' ∧ data = data' ∧ decs ≠ ([] :exp list) ∧ FST (new_oracle (0 :num)) = st' then SOME (decs,eval_config with compile_oracle := new_oracle,Unitv) else (NONE :(exp list # α install_config # v) option))) | v1::v2::v15::v16 => (NONE :(exp list # α install_config # v) option)
<<HOL warning: Type.mk_type: more than one possibility>>
dest_thunk_ret_typed=BadRef::semanticPrimitives$dest_thunk_ret; NotThunk::semanticPrimitives$dest_thunk_ret; IsThunk::thunk_mode -> semanticPrimitives$v -> semanticPrimitives$dest_thunk_ret
dest_thunk_def_typed=(dest_thunk [(Loc (b :bool) (n :num) :v)] (st :v store_v list) :dest_thunk_ret) = (case store_lookup n st of (NONE :v store_v option) => BadRef | SOME (Refv v7) => NotThunk | SOME (W8array v8 :v store_v) => NotThunk | SOME (Varray v9) => NotThunk | SOME (Thunk Evaluated v) => if b then BadRef else (IsThunk Evaluated v :dest_thunk_ret) | SOME (Thunk NotEvaluated v) => if b then BadRef else (IsThunk NotEvaluated v :dest_thunk_ret)) ∧ (dest_thunk ([] :v list) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Litv (v12 :lit) :v)::(v5 :v list)) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Conv (v13 :(num # num option) option) (v14 :v list)::v5) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Closure (v15 :v environment) (v16 :mlstring) (v17 :exp) :v)::v5) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Recclosure (v18 :v environment) (v19 :(mlstring # mlstring # exp) list) (v20 :mlstring) :v)::v5) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk ((Loc (v21 :bool) (v22 :num) :v)::(v36 :v)::(v37 :v list)) st :dest_thunk_ret) = NotThunk ∧ (dest_thunk (Vectorv (v23 :v list)::v5) st :dest_thunk_ret) = NotThunk
update_thunk_def_typed=update_thunk [(Loc F (n :num) :v)] (st :v store_v list) [(v :v)] = (case (dest_thunk [v] st :dest_thunk_ret) of BadRef => (NONE :v store_v list option) | NotThunk => store_assign n (Thunk Evaluated v) st | (IsThunk v3 v4 :dest_thunk_ret) => (NONE :v store_v list option)) ∧ update_thunk ([] :v list) st (v1 :v list) = (NONE :v store_v list option) ∧ update_thunk ((Litv (v12 :lit) :v)::(v7 :v list)) st v1 = (NONE :v store_v list option) ∧ update_thunk (Conv (v13 :(num # num option) option) (v14 :v list)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk ((Closure (v15 :v environment) (v16 :mlstring) (v17 :exp) :v)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk ((Recclosure (v18 :v environment) (v19 :(mlstring # mlstring # exp) list) (v20 :mlstring) :v)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk ((Loc T (v22 :num) :v)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk [(Loc F v22 :v)] st ([] :v list) = (NONE :v store_v list option) ∧ update_thunk [(Loc F v22 :v)] st ((v52 :v)::(v56 :v)::(v57 :v list)) = (NONE :v store_v list option) ∧ update_thunk ((Loc F v22 :v)::(v46 :v)::(v47 :v list)) st v1 = (NONE :v store_v list option) ∧ update_thunk (Vectorv (v23 :v list)::v7) st v1 = (NONE :v store_v list option)
bad_thunk_update_def_typed=∀(m :thunk_mode) (v :v) (refs :v store_v list). bad_thunk_update m v refs ⇔ m = Evaluated ∧ (dest_thunk [v] refs :dest_thunk_ret) ≠ NotThunk
do_app_const_typed=do_app (s :(α, β) state) (op :op) (vs :v list) = SOME ((s' :(α, β) state),(r :(v, v) result)) ⇒ s.clock = s'.clock
