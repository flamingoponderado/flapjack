comp_def_typed=∀(p :α prog) (off :α word # α word) (k :num) (jump :bool). comp jump off k p = case p of (Skip :α prog) => (Skip :α prog) | (Inst v70 :α prog) => (Inst v70 :α prog) | (Get r CurrHeap :α prog) => (move r (k + (2 :num)) :α prog) | (Get r name :α prog) => (Inst (Mem Load r (Addr (k + (1 :num)) (store_offset name :α word))) :α prog) | (Set CurrHeap r' :α prog) => (move (k + (2 :num)) r' :α prog) | (Set name' r' :α prog) => (Inst (Mem Store r' (Addr (k + (1 :num)) (store_offset name' :α word))) :α prog) | (OpCurrHeap op r'' n :α prog) => (Inst (Arith (Binop op r'' n (Reg (k + (2 :num)) :α reg_imm)) :α inst) :α prog) | (Call ret dest exc :α prog) => (Call (case ret of (NONE :(α prog # num # num # num) option) => (NONE :(α prog # num # num # num) option) | SOME (p1,lr,l1,l2) => SOME (comp jump off k p1,lr,l1,l2)) dest (case exc of (NONE :(α prog # num # num) option) => (NONE :(α prog # num # num) option) | SOME (p2,l1,l2) => SOME (comp jump off k p2,l1,l2)) :α prog) | Seq p1 p2 => Seq (comp jump off k p1) (comp jump off k p2) | (If c r'¹⁰' ri p1' p2' :α prog) => (If c r'¹⁰' ri (comp jump off k p1') (comp jump off k p2') :α prog) | Loop p1'' => Loop (comp jump off k p1'') | (JumpLower v89 v90 v91 :α prog) => (JumpLower v89 v90 v91 :α prog) | (Alloc v92 :α prog) => (Alloc v92 :α prog) | (StoreConsts t1 t2 v95 :α prog) => list_Seq [(Inst (Mem Load t2 (Addr (k + (1 :num)) (store_offset BitmapBase :α word))) :α prog); (add_inst t2 (1 :num) :α prog); (left_shift_inst t2 (word_shift (:α)) :α prog); (copy_loop t1 t2 :α prog); (move t1 (1 :num) :α prog); (move t2 (1 :num) :α prog)] | (Raise v96 :α prog) => (Raise v96 :α prog) | (Return v97 :α prog) => (Return v97 :α prog) | (Break v98 :α prog) => (Break v98 :α prog) | (Continue v99 :α prog) => (Continue v99 :α prog) | (FFI v100 v101 v102 v103 v104 v105 :α prog) => (FFI v100 v101 v102 v103 v104 v105 :α prog) | (Tick :α prog) => (Tick :α prog) | (LocValue v106 v107 v108 :α prog) => (LocValue v106 v107 v108 :α prog) | (