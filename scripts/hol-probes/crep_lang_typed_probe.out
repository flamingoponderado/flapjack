assign_ret_def_typed=∀(ns :num list). (assign_ret ns :α prog) = nested_seq (MAP2 (Assign :num -> α exp -> α prog) ns (load_globals (0w :word5) (LENGTH ns) :α exp list) :α prog list)
assigned_free_vars_def_typed=assigned_free_vars (Skip :α prog) = ([] :num list) ∧ (∀(p :α prog) (n :num) (e :α exp). assigned_free_vars (Dec n e p :α prog) = FILTER (λ(y :num). n ≠ y) (assigned_free_vars p)) ∧ (∀(n :num) (e :α exp). assigned_free_vars (Assign n e :α prog) = [n]) ∧ (∀(rhss :num list) (pop :primop) (lhss :num list). assigned_free_vars (Primitive lhss pop rhss :α prog) = lhss) ∧ (∀(p' :α prog) (p :α prog). assigned_free_vars (Seq p p') = assigned_free_vars p ++ assigned_free_vars p') ∧ (∀(p' :α prog) (p :α prog) (e :α exp). assigned_free_vars (If e p p') = assigned_free_vars p ++ assigned_free_vars p') ∧ (∀(p :α prog) (e :α exp). assigned_free_vars (While e p) = assigned_free_vars p) ∧ (∀(v0 :α word) (rts :num list) (p :α prog) (es :α exp list) (e :mlstring). assigned_free_vars (Call (SOME (rts,SOME (v0,p))) e es :α prog) = rts ++ assigned_free_vars p) ∧ (∀(rts :num list) (es :α exp list) (e :mlstring). assigned_free_vars (Call (SOME (rts,(NONE :(α word # α prog) option))) e es :α prog) = rts) ∧ (∀(r :num) (op :memop) (ad :α exp). assigned_free_vars (ShMem op r ad) = [r]) ∧ (∀(v9 :α exp) (v10 :α exp). assigned_free_vars (Store v9 v10 :α prog) = ([] :num list)) ∧ (∀(v12 :α exp) (v11 :α exp). assigned_free_vars (Store32 v11 v12 :α prog) = ([] :num list)) ∧ (∀(v14 :α exp) (v13 :α exp). assigned_free_vars (StoreByte v13 v14 :α prog) = ([] :num list)) ∧ (∀(v16 :α exp) (v15 :word5). assigned_free_vars (StoreGlob v15 v16) = ([] :num list)) ∧ (∀(v24 :num). assigned_free_vars (Break v24 :α prog) = ([] :num list)) ∧ (∀(v25 :num). assigned_free_vars (Continue v25 :α prog) = ([] :num list)) ∧ (∀(v28 :α exp list) (v27 :mlstring). assigned_free_vars (Call (NONE :(num list # (α word # α prog) option) option) v27 v28 :α prog) = ([] :num list)) ∧ (∀(v33 :num) (v32 :num) (v31 :num) (v30 :num) (v29 :mlstring). assigned_free_vars (ExtCall v29 v30 v31 v32 v33 :α prog) = ([] :num list)) ∧ (∀(v34 :α word). assigned_free_vars (Raise v34 :α prog) = ([] :num list)) ∧ (∀(v35 :α exp list). assigned_free_vars (Return v35 :α prog) = ([] :num list)) ∧ assigned_free_vars (Tick :α prog) = ([] :num list)
assigned_vars_def_typed=assigned_vars (Skip :α prog) = ([] :num list) ∧ (∀(p :α prog) (n :num) (e :α exp). assigned_vars (Dec n e p :α prog) = n::assigned_vars p) ∧ (∀(n :num) (e :α exp). assigned_vars (Assign n e :α prog) = [n]) ∧ (∀(rhss :num list) (pop :primop) (lhss :num list). assigned_vars (Primitive lhss pop rhss :α prog) = lhss) ∧ (∀(p' :α prog) (p :α prog). assigned_vars (Seq p p') = assigned_vars p ++ assigned_vars p') ∧ (∀(p' :α prog) (p :α prog) (e :α exp). assigned_vars (If e p p') = assigned_vars p ++ assigned_vars p') ∧ (∀(p :α prog) (e :α exp). assigned_vars (While e p) = assigned_vars p) ∧ (∀(v0 :α word) (rts :num list) (p :α prog) (es :α exp list) (e :mlstring). assigned_vars (Call (SOME (rts,SOME (v0,p))) e es :α prog) = rts ++ assigned_vars p) ∧ (∀(rts :num list) (es :α exp list) (e :mlstring). assigned_vars (Call (SOME (rts,(NONE :(α word # α prog) option))) e es :α prog) = rts) ∧ (∀(r :num) (op :memop) (ad :α exp). assigned_vars (ShMem op r ad) = [r]) ∧ (∀(v9 :α exp) (v10 :α exp). assigned_vars (Store v9 v10 :α prog) = ([] :num list)) ∧ (∀(v12 :α exp) (v11 :α exp). assigned_vars (Store32 v11 v12 :α prog) = ([] :num list)) ∧ (∀(v14 :α exp) (v13 :α exp). assigned_vars (StoreByte v13 v14 :α prog) = ([] :num list)) ∧ (∀(v16 :α exp) (v15 :word5). assigned_vars (StoreGlob v15 v16) = ([] :num list)) ∧ (∀(v24 :num). assigned_vars (Break v24 :α prog) = ([] :num list)) ∧ (∀(v25 :num). assigned_vars (Continue v25 :α prog) = ([] :num list)) ∧ (∀(v28 :α exp list) (v27 :mlstring). assigned_vars (Call (NONE :(num list # (α word # α prog) option) option) v27 v28 :α prog) = ([] :num list)) ∧ (∀(v33 :num) (v32 :num) (v31 :num) (v30 :num) (v29 :mlstring). assigned_vars (ExtCall v29 v30 v31 v32 v33 :α prog) = ([] :num list)) ∧ (∀(v34 :α word). assigned_vars (Raise v34 :α prog) = ([] :num list)) ∧ (∀(v35 :α exp list). assigned_vars (Return v35 :α prog) = ([] :num list)) ∧ assigned_vars (Tick :α prog) = ([] :num list)
var_cexp_def_typed=(∀(w :α word). var_cexp (Const w :α exp) = ([] :num list)) ∧ (∀(v :num). var_cexp (Var v :α exp) = [v]) ∧ (∀(e :α exp). var_cexp (Load e :α exp) = var_cexp e) ∧ (∀(e :α exp). var_cexp (Load32 e :α exp) = var_cexp e) ∧ (∀(e :α exp). var_cexp (LoadByte e) = var_cexp e) ∧ (∀(a :word5). var_cexp (LoadGlob a :α exp) = ([] :num list)) ∧ (∀(es :α exp list) (bop :binop). var_cexp (Op bop es) = FLAT (MAP (λ(a :α exp). var_cexp a) es)) ∧ (∀(es :α exp list) (cop :crepop). var_cexp (Crepop cop es) = FLAT (MAP (λ(a :α exp). var_cexp a) es)) ∧ (∀(e2 :α exp) (e1 :α exp) (c :cmp). var_cexp (Cmp c e1 e2) = var_cexp e1 ++ var_cexp e2) ∧ (∀(sh :ast$shift) (e2 :α exp) (e1 :α exp). var_cexp (Shift sh e1 e2 :α exp) = var_cexp e1 ++ var_cexp e2) ∧ var_cexp (BaseAddr :α exp) = ([] :num list) ∧ var_cexp (TopAddr :α exp) = ([] :num list)
exps_def_typed=(∀(w :α word). exps (Const w :α exp) = [(Const w :α exp)]) ∧ (∀(v :num). exps (Var v :α exp) = [(Var v :α exp)]) ∧ (∀(e :α exp). exps (Load e :α exp) = exps e) ∧ (∀(e :α exp). exps (Load32 e :α exp) = exps e) ∧ (∀(e :α exp). exps (LoadByte e) = exps e) ∧ (∀(a :word5). exps (LoadGlob a :α exp) = [(LoadGlob a :α exp)]) ∧ (∀(es :α exp list) (bop :binop). exps (Op bop es) = FLAT (MAP (λ(a :α exp). exps a) es)) ∧ (∀(pop :crepop) (es :α exp list). exps (Crepop pop es) = FLAT (MAP (λ(a :α exp). exps a) es)) ∧ (∀(e2 :α exp) (e1 :α exp) (c :cmp). exps (Cmp c e1 e2) = exps e1 ++ exps e2) ∧ (∀(sh :ast$shift) (e2 :α exp) (e1 :α exp). exps (Shift sh e1 e2 :α exp) = exps e1 ++ exps e2) ∧ exps (BaseAddr :α exp) = [(BaseAddr :α exp)] ∧ exps (TopAddr :α exp) = [(TopAddr :α exp)]
nested_seq_def_typed=nested_seq ([] :α prog list) = (Skip :α prog) ∧ ∀(e :α prog) (es :α prog list). nested_seq (e::es) = Seq e (nested_seq es)
load_globals_def_typed=(∀(v0 :word5). (load_globals v0 (0 :num) :α exp list) = ([] :α exp list)) ∧ ∀(ad :word5) (n :num). (load_globals ad (SUC n) :α exp list) = (LoadGlob ad :α exp)::(load_globals (ad + (1w :word5)) n :α exp list)
nested_decs_def_typed=(∀(p :α prog). nested_decs ([] :num list) ([] :α exp list) p = p) ∧ (∀(p :α prog) (ns :num list) (n :num) (es :α exp list) (e :α exp). nested_decs (n::ns) (e::es) p = (Dec n e (nested_decs ns es p) :α prog)) ∧ (∀(v9 :α exp) (v10 :α exp list) (p :α prog). nested_decs ([] :num list) (v9::v10) p = (Skip :α prog)) ∧ ∀(v6 :num list) (v5 :num) (p :α prog). nested_decs (v5::v6) ([] :α exp list) p = (Skip :α prog)
store_globals_def_typed=(∀(ad :word5). store_globals ad ([] :α exp list) = ([] :α prog list)) ∧ ∀(ad :word5) (e :α exp) (es :α exp list). store_globals ad (e::es) = StoreGlob ad e::store_globals (ad + (1w :word5)) es
stores_def_typed=(∀(ad :α exp) (a :α word). stores ad ([] :α exp list) a = ([] :α prog list)) ∧ ∀(ad :α exp) (e :α exp) (es :α exp list) (a :α word). stores ad (e::es) a = if a = (0w :α word) then (Store ad e :α prog)::stores ad es (a + (bytes_in_word :α word)) else (Store (Op Add [ad; (Const a :α exp)]) e :α prog)::stores ad es (a + (bytes_in_word :α word))
