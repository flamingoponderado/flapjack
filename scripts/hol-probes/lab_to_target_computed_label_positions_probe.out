lab_lookup_compute_labels_test=∀(pos :num) (sec_list :α sec list) (acc :num sptree$num_map sptree$num_map)
    (l1 :num) (l2 :num) (x2 :num) (c :α asm_config)
    (labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (nop :β).
  EVERY (sec_labels_ok :α sec -> bool) sec_list ∧
  ALL_DISTINCT (MAP (Section_num :α sec -> num) sec_list) ∧
  EVERY
    ((ALL_DISTINCT :(num # num) list -> bool) ∘
     (extract_labels :α line list -> (num # num) list) ∘
     (Section_lines :α sec -> α line list)) sec_list ∧
  EVERY (sec_label_zero :α sec -> bool) sec_list ∧
  all_enc_ok c labs ffis pos sec_list ∧ loc_to_pc l1 l2 sec_list = SOME x2 ⇒
  lab_lookup l1 l2 (compute_labels_alt pos sec_list acc) =
  SOME (pos_val x2 pos sec_list)
lab_lookup_compute_labels_test_types=(pos :num)::num;(sec_list :α sec list)::α sec list;(acc :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(l1 :num)::num;(l2 :num)::num;(x2 :num)::num;(c :α asm_config)::α asm_config;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(nop :β)::β;
hypotheses=0
head_zero=T
trailing_label=T
next_instruction=T
tail_section=T
empty_prefix=T
