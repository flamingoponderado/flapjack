fm2sp_delete_typed=∀*(k :num) (fm :num |-> α) . fm2sp ((fm :num |-> α) \\ (k :num)) = delete k (fm2sp fm)
domain_fm2sp_typed=∀(fm :num |-> α). (domain (fm2sp fm) :num -> bool) = FDOM fm
RKC_def_typed=∀(rkt :atom term) (ct :infer_t). RKC rkt ct ⇔ encode_infer_t ct = rkt
surj_RKC_typed=surj RKC
substR_FDOM_typed=(substR |==> ($= :(num -> bool) -> (num -> bool) -> bool)) (FDOM :atom subst -> num -> bool) (domain :infer_t sptree$num_map -> num -> bool)
substR_FLOOKUP_typed=(substR |==> ($= :num -> num -> bool) |==> OPTREL RKC) (FLOOKUP :atom subst -> num -> atom term option) (flip (lookup :num -> infer_t sptree$num_map -> infer_t option))
substR_RFORALL_typed=((substR |==> $==>) |==> $==>) (RES_FORALL (wfs :atom subst -> bool)) (RES_FORALL cwfs)
