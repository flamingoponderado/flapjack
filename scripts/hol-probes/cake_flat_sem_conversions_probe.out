vs_to_string=vs_to_string ([] :v list) = SOME «» ∧ (∀(vs :v list) (s1 :mlstring). vs_to_string ((Litv (StrLit s1) :v)::vs) = case vs_to_string vs of (NONE :mlstring option) => (NONE :mlstring option) | SOME s2 => SOME (s1 ^ s2)) ∧ (∀(v28 :int) (v1 :v list). vs_to_string ((Litv (IntLit v28) :v)::v1) = (NONE :mlstring option)) ∧ (∀(v29 :char) (v1 :v list). vs_to_string ((Litv (Char v29) :v)::v1) = (NONE :mlstring option)) ∧ (∀(v31 :word8) (v1 :v list). vs_to_string ((Litv (Word8 v31) :v)::v1) = (NONE :mlstring option)) ∧ (∀(v32 :word64) (v1 :v list). vs_to_string ((Litv (Word64 v32) :v)::v1) = (NONE :mlstring option)) ∧ (∀(v33 :word64) (v1 :v list). vs_to_string ((Litv (Float64 v33) :v)::v1) = (NONE :mlstring option)) ∧ (∀(v6 :v list) (v5 :(num # num option) option) (v1 :v list). vs_to_string (Conv v5 v6::v1) = (NONE :mlstring option)) ∧ (∀(v9 :exp) (v8 :mlstring) (v7 :v environment) (v1 :v list). vs_to_string ((Closure v7 v8 v9 :v)::v1) = (NONE :mlstring option)) ∧ (∀(v12 :mlstring) (v11 :(mlstring # mlstring # exp) list) (v10 :v environment) (v1 :v list). vs_to_string ((Recclosure v10 v11 v12 :v)::v1) = (NONE :mlstring option)) ∧ (∀(v14 :num) (v13 :bool) (v1 :v list). vs_to_string ((Loc v13 v14 :v)::v1) = (NONE :mlstring option)) ∧ ∀(v15 :v list) (v1 :v list). vs_to_string (Vectorv v15::v1) = (NONE :mlstring option)
