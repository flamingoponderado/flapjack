v_to_list=(∀(tid :num option) (cid :num). v_to_list (Conv (SOME (cid,tid)) ([] :v list)) = if cid = nil_tag ∧ tid = SOME list_id then SOME ([] :v list) else (NONE :v list option)) ∧ (∀(v2 :v) (v1 :v) (tid :num option) (cid :num). v_to_list (Conv (SOME (cid,tid)) [v1; v2]) = if cid = cons_tag ∧ tid = SOME list_id then case v_to_list v2 of (NONE :v list option) => (NONE :v list option) | SOME vs => SOME (v1::vs) else (NONE :v list option)) ∧ (∀(v :lit). v_to_list (Litv v :v) = (NONE :v list option)) ∧ (∀(v4 :v list). v_to_list (Conv (NONE :(num # num option) option) v4) = (NONE :v list option)) ∧ (∀(v32 :v) (v29 :num option) (v28 :num). v_to_list (Conv (SOME (v28,v29)) [v32]) = (NONE :v list option)) ∧ (∀(v41 :v list) (v40 :v) (v36 :v) (v32 :v) (v29 :num option) (v28 :num). v_to_list (Conv (SOME (v28,v29)) (v32::v36::v40::v41)) = (NONE :v list option)) ∧ (∀(v7 :exp) (v6 :mlstring) (v5 :v environment). v_to_list (Closure v5 v6 v7 :v) = (NONE :v list option)) ∧ (∀(v9 :(mlstring # mlstring # exp) list) (v8 :v environment) (v10 :mlstring). v_to_list (Recclosure v8 v9 v10 :v) = (NONE :v list option)) ∧ (∀(v12 :num) (v11 :bool). v_to_list (Loc v11 v12 :v) = (NONE :v list option)) ∧ ∀(v13 :v list). v_to_list (Vectorv v13) = (NONE :v list option)
list_to_v=list_to_v ([] :v list) = Conv (SOME (nil_tag,SOME list_id)) ([] :v list) ∧ ∀(x :v) (xs :v list). list_to_v (x::xs) = Conv (SOME (cons_tag,SOME list_id)) [x; list_to_v xs]
v_to_char_list=(∀(tid :num option) (cid :num). v_to_char_list (Conv (SOME (cid,tid)) ([] :v list)) = if cid = nil_tag ∧ tid = SOME list_id then SOME ("" :string) else (NONE :string option)) ∧ (∀(v :v) (tid :num option) (cid :num) (c :char). v_to_char_list (Conv (SOME (cid,tid)) [(Litv (Char c) :v); v]) = if cid = cons_tag ∧ tid = SOME list_id then case v_to_char_list v of (NONE :string option) => (NONE :string option) | SOME cs => SOME (STRING c cs) else (NONE :string option)) ∧ (∀(v1 :lit). v_to_char_list (Litv v1 :v) = (NONE :string option)) ∧ (∀(v3 :v list). v_to_char_list (Conv (NONE :(num # num option) option) v3) = (NONE :string option)) ∧ (∀(v59 :int) (v32 :v list) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) ((Litv (IntLit v59) :v)::v32)) = (NONE :string option)) ∧ (∀(v60 :char) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) [(Litv (Char v60) :v)]) = (NONE :string option)) ∧ (∀(v76 :v list) (v75 :v) (v71 :v) (v60 :char) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) ((Litv (Char v60) :v)::v71::v75::v76)) = (NONE :string option)) ∧ (∀(v61 :mlstring) (v32 :v list) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) ((Litv (StrLit v61) :v)::v32)) = (NONE :string option)) ∧ (∀(v62 :word8) (v32 :v list) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) ((Litv (Word8 v62) :v)::v32)) = (NONE :string option)) ∧ (∀(v63 :word64) (v32 :v list) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) ((Litv (Word64 v63) :v)::v32)) = (NONE :string option)) ∧ (∀(v64 :word64) (v32 :v list) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) ((Litv (Float64 v64) :v)::v32)) = (NONE :string option)) ∧ (∀(v37 :v list) (v36 :(num # num option) option) (v32 :v list) (v28 :num option) (v27 :num). v_to_char_list (Conv (SOME (v27,v28)) (Conv v36 v37::v32)) = (NONE :string option)) ∧ (∀(v40 :exp) (v39 :mlstring) (v38 :v environment) (v32 :v list) (v28 :num op