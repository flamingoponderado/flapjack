loop_inst_ok_def_typed=(loop_inst_ok (c :α asm_config) (Arith (LDiv (r1 :num) (r2 :num) (r3 :num)) :β prog) ⇔ c.ISA ∈ {ARMv8; MIPS; RISC_V}) ∧ (loop_inst_ok c (Arith (LLongMul r1 r2 r3 (r4 :num)) :β prog) ⇔ (c.ISA = ARMv7 ⇒ r1 ≠ r2) ∧ (c.ISA = ARMv8 ∨ c.ISA = RISC_V ∨ c.ISA = Ag32 ⇒ r1 ≠ r3 ∧ r1 ≠ r4)) ∧ (loop_inst_ok c (Arith (LLongDiv r1 r2 r3 r4 (r5 :num)) :β prog) ⇔ c.ISA = x86_64) ∧ (loop_inst_ok c (Skip :β prog) ⇔ T) ∧ (loop_inst_ok c (Assign (v2 :num) (v3 :β exp) :β prog) ⇔ T) ∧ (loop_inst_ok c (Primitive (v4 :num list) (v5 :primop) (v6 :num list) :β prog) ⇔ T) ∧ (loop_inst_ok c (Store (v8 :β exp) (v9 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (SetGlobal (v10 :word5) (v11 :β exp)) ⇔ T) ∧ (loop_inst_ok c (Load32 (v12 :num) (v13 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (LoadByte (v14 :num) (v15 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Store32 (v16 :num) (v17 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (StoreByte (v18 :num) (v19 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Seq (v20 :β prog) (v21 :β prog)) ⇔ T) ∧ (loop_inst_ok c (If (v22 :cmp) (v23 :num) (v24 :β reg_imm) (v25 :β prog) (v26 :β prog) (v27 :sptree$num_set) :β prog) ⇔ T) ∧ (loop_inst_ok c (Loop (v28 :sptree$num_set) (v29 :β prog) (v30 :sptree$num_set) :β prog) ⇔ T) ∧ (loop_inst_ok c (Break (v31 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Continue (v32 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Raise (v33 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Return (v34 :num list) :β prog) ⇔ T) ∧ (loop_inst_ok c (ShMem (v35 :memop) (v36 :num) (v37 :β exp)) ⇔ T) ∧ (loop_inst_ok c (Tick :β prog) ⇔ T) ∧ (loop_inst_ok c (Mark (v38 :β prog)) ⇔ T) ∧ (loop_inst_ok c (Fail :β prog) ⇔ T) ∧ (loop_inst_ok c (LocValue (v39 :num) (v40 :num) :β prog) ⇔ T) ∧ (loop_inst_ok c (Call (v41 :(num list # sptree$num_set) option) (v42 :num option) (v43 :num list) (v44 :(num # β prog # β prog # sptree$num_set) option) :β prog) ⇔ T) ∧ (loop_inst_ok c (FFI (v45 :mlstring) (v46 :num) (v47 :num) (v48 :num) (v49 :num) (v50 :sptree$num_set) :β prog) ⇔ T)
loop_to_word_comp_every_inst_ok_less_typed=∀(ctxt :num sptree$num_map) (prog :α prog) (l :num # num). byte_offset_ok (c :α asm_config) (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ every_prog (loop_inst_ok c :α prog -> bool) prog ∧ (domain (acc_vars prog (LN :sptree$num_set)) :num -> bool) ⊆ (domain ctxt :num -> bool) ∧ INJ (find_var ctxt) (domain ctxt :num -> bool) 𝕌(:num) ∧ (∀(n :num) (m :num). lookup n ctxt = SOME m ⇒ m ≠ (0 :num) ∧ EVEN m) ⇒ every_inst (inst_ok_less c) (FST (comp ctxt prog l))
loop_to_word_comp_func_every_inst_ok_less_typed=comp_func (n :num) (params :num list) (body :α prog) = (p :α wordLang$prog) ∧ every_prog (loop_inst_ok (c :α asm_config) :α prog -> bool) body ∧ addr_offset_ok c (0w :α word) ∧ byte_offset_ok c (0w :α word) ⇒ every_inst (inst_ok_less c) p
loop_to_word_compile_prog_every_inst_ok_less_typed=compile_prog (lprog :(num # num list # α prog) list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ byte_offset_ok (c :α asm_config) (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ EVERY (λ((n :num),(params :num list),(body :α prog)). every_prog (loop_inst_ok c :α prog -> bool) body) lprog ⇒ EVERY (λ((n :num),(m :num),(p :α wordLang$prog)). every_inst (inst_ok_less c) p) wprog0
loop_to_word_every_inst_ok_less_typed=compile (lprog :(num # num list # α prog) list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ byte_offset_ok (c :α asm_config) (0w :α word) ∧ addr_offset_ok c (0w :α word) ∧ EVERY (λ((n :num),(params :num list),(body :α prog)). every_prog (loop_inst_ok c :α prog -> bool) body) lprog ⇒ EVERY (λ((n :num),(m :num),(p :α wordLang$prog)). every_inst (inst_ok_less c) p) wprog0
