mc_init_ok_def_typed=∀(asm_conf :α asm_config) (c :config) (mc :(α, β, γ) machine_config). mc_init_ok asm_conf c mc ⇔ EVERY (λ(r :num). MEM (find_name c.stack_conf.reg_names (r + mc.target.config.reg_count − (LENGTH mc.target.config.avoid_regs + (5 :num)))) mc.callee_saved_regs) [(2 :num); (3 :num); (4 :num)] ∧ find_name c.stack_conf.reg_names (4 :num) = mc.len2_reg ∧ find_name c.stack_conf.reg_names (3 :num) = mc.ptr2_reg ∧ find_name c.stack_conf.reg_names (2 :num) = mc.len_reg ∧ find_name c.stack_conf.reg_names (1 :num) = mc.ptr_reg ∧ find_name c.stack_conf.reg_names (0 :num) = (case mc.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ∧ (c.data_conf.be ⇔ mc.target.config.big_endian) ∧ (case mc.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ≠ mc.len_reg ∧ (case mc.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ≠ mc.ptr_reg ∧ (case mc.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ≠ mc.len2_reg ∧ (case mc.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) ≠ mc.ptr2_reg ∧ ¬MEM (case mc.target.config.link_reg of (NONE :num option) => (0 :num) | SOME n => n) mc.callee_saved_regs ∧ asm_conf = mc.target.config
heap_regs_def_typed=∀(reg_names :num sptree$num_map). heap_regs reg_names = (find_name reg_names (2 :num),find_name reg_names (4 :num))
byte_aligned_MOD_typed=good_dimindex (:α) ⇒ ∀(x :α word). x ∈ (byte_aligned :α word -> bool) ⇒ w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num)
word_list_exists_imp_typed=(dm :α word -> bool) = addresses (a :α word) (n :num) ∧ dimindex (:α) DIV (8 :num) * n < dimword (:α) ∧ good_dimindex (:α) ⇒ word_list_exists a n (fun2set ((m1 :α word -> β),dm))
