res_var_commutes_typed=(n :α) ≠ (h :α) ⇒ res_var (res_var (lc :α |-> β) (h,FLOOKUP (lc' :α |-> β) h)) (n,FLOOKUP lc' n) = res_var (res_var lc (n,FLOOKUP lc' n)) (h,FLOOKUP lc' h)
res_var_commutes_vars=lc',lc,h,n
flookup_res_var_distinct_eq_typed=∀(xs :(α # β option) list) (x :α) (fm :α |-> β). ¬MEM x (MAP (FST :α # β option -> α) xs) ⇒ FLOOKUP (FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) fm xs) x = FLOOKUP fm x
flookup_res_var_distinct_typed=∀(ys :α list) (xs :α list) (zs :β option list) (fm :α |-> β). distinct_lists xs ys ∧ LENGTH xs = LENGTH zs ⇒ MAP (FLOOKUP (FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) fm (ZIP (xs,zs)))) ys = MAP (FLOOKUP fm) ys
flookup_res_var_zip_distinct_typed=∀(ys :α list) (xs :α list) (as :β list) (cs :β option list) (fm :α |-> β). distinct_lists xs ys ∧ LENGTH xs = LENGTH as ∧ LENGTH xs = LENGTH cs ⇒ MAP (FLOOKUP (FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) (fm |++ ZIP (xs,as)) (ZIP (xs,cs)))) ys = MAP (FLOOKUP fm) ys
update_locals_not_vars_eval_eq_pp_typed=∀(s :(α, β) state) (e :α crepLang$exp) (v :γ) (n :num) (w :α word_lab) (locals :num |-> α word_lab). ¬MEM n (var_cexp e) ⇒ (eval (s with locals := locals⟨n ↦ w⟩) e :α word_lab option) = (eval (s with locals := locals) e :α word_lab option)
load_glob_not_mem_load_vars=
set_mem_op_FLOOKUP_locals_vars=k,n,t,res,s,ad,r,op
eval_exps_not_load_global_eq_vars=
load_glob_not_mem_load_typed=∀(i :num) (a :α word) (h :α crepLang$exp) (ad :word5). ¬MEM (LoadGlob ad :α crepLang$exp) (exps h) ⇒ ¬MEM (LoadGlob ad :α crepLang$exp) (FLAT (MAP (exps :α crepLang$exp -> α crepLang$exp list) (load_shape a i h)))
set_mem_op_FLOOKUP_locals_typed=(sh_mem_op (op :memop) (r :num) (ad :β word) (s :(β, γ) state) :α result option # (β, γ) state) = ((res :α result option),(t :(β, γ) state)) ∧ r ≠ (n :num) ∧ (res = (NONE :α result option) ∨ res = SOME (Continue (k :num) :α result) ∨ res = SOME (Break k :α result)) ⇒ FLOOKUP t.locals n = FLOOKUP s.locals n
eval_exps_not_load_global_eq_typed=∀(s :(α, β) state) (e :α crepLang$exp) (v :α word_lab) (g :word5 |-> α word_lab). (eval s e :α word_lab option) = SOME v ∧ (∀(ad :word5). ¬MEM (LoadGlob ad :α crepLang$exp) (exps e)) ⇒ (eval (s with globals := g) e :α word_lab option) = SOME v
mem_loads_flat_rel_typed=(∀(sh :shape) (adr :α word) (dm :α word -> bool) (m :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α v). (mem_load sh adr dm m stcs :α v option) = SOME v ∧ is_wf_shape_nil sh ⇒ ∀(s :(α, β) state) (n :num). n < LENGTH (flatten v) ⇒ dm = s.memaddrs ⇒ m = s.memory ⇒ (mem_load (adr + (bytes_in_word :α word) * (n2w n :α word)) s :α word_lab option) = SOME (flatten v)❲n❳) ∧ (∀(shs :shape list) (adr :α word) (dm :α word -> bool) (m :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α v list). mem_loads shs adr dm m stcs = SOME v ∧ EVERY is_wf_shape_nil shs ⇒ ∀(s :(α, β) state) (n :num). n < LENGTH (FLAT (MAP (flatten :α v -> α word_lab list) v)) ⇒ dm = s.memaddrs ⇒ m = s.memory ⇒ (mem_load (adr + (bytes_in_word :α word) * (n2w n :α word)) s :α word_lab option) = SOME (FLAT (MAP (flatten :α v -> α word_lab list) v))❲n❳) ∧ ∀(flds :(mlstring # shape) list) (adr :α word) (dm :α word -> bool) (m :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (vs :(mlstring # α v) list). mem_load_flds flds adr dm m stcs = SOME vs ⇒ T
unassigned_vars_evaluate_same_typed=∀(p :α crepLang$prog) (s :(α, β) state) (res :α result option) (t :(α, β) state) (n :num) (k :num). (evaluate (p,s) :α result option # (α, β) state) = (res,t) ∧ (res = (NONE :α result option) ∨ res = SOME (Continue k :α result) ∨ res = SOME (Break k :α result)) ∧ ¬MEM n (assigned_free_vars p) ⇒ FLOOKUP t.locals n = FLOOKUP s.locals n
