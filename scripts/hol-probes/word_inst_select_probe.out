add3=Seq (Seq (Move 0 [(100,2)]) (Seq (Move 0 [(101,1)]) (Inst (Arith (Binop Add 100 100 (Reg 101)))))) (Inst (Arith (Binop Add 5 100 (Imm 3w))))
sub_const=Seq (Move 0 [(100,1)]) (Inst (Arith (Binop Add 5 100 (Imm 0xFFFFFFFFFFFFFFFDw))))
