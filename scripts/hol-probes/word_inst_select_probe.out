store_off=Seq (Move 0 [(100,1)]) (Inst (Mem Store 4 (Addr 100 8w)))
load_off=Seq (Move 0 [(100,1)]) (Inst (Mem Load 5 (Addr 100 16w)))
shifts=Seq (Seq (Move 0 [(100,1)]) (Inst (Arith (Shift Lsl 5 100 (Imm 3w))))) (Seq (Seq (Move 0 [(100,1)]) (Move 0 [(6,100)])) (Inst (Const 7 0w)))
curr_heap=Seq (Move 0 [(100,1)]) (OpCurrHeap Add 5 100)
