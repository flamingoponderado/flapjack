EVERY_get_forced_typed=EVERY (P :num # num -> bool) (get_forced (c :α asm_config) (p :α prog) (ls :(num # num) list)) ⇔ EVERY P (get_forced c p ([] :(num # num) list)) ∧ EVERY P ls
INJ_IMP_IMAGE_DIFF_typed=INJ (f :α -> β) ((s :α -> bool) ∪ (t :α -> bool)) 𝕌(:β) ⇒ IMAGE f (s DIFF t) = IMAGE f s DIFF IMAGE f t
INJ_IMP_IMAGE_DIFF_single_typed=INJ (f :α -> β) ((s :α -> bool) ∪ {(n :α)}) 𝕌(:β) ⇒ IMAGE f s DIFF {f n} = IMAGE f (s DIFF {n})
INJ_UNION_typed=∀(f :α -> β) (A :α -> bool) (B :α -> bool). INJ f (A ∪ B) 𝕌(:β) ⇒ INJ f A 𝕌(:β) ∧ INJ f B 𝕌(:β)
LENGTH_list_rerrange_typed=LENGTH (list_rearrange (mover :num -> num) (xs :α list)) = LENGTH xs
MAP_FST_keys_SORT_typed=set (MAP (FST :num # α -> num) (sort (f :num # α -> num # α -> bool) (toAList (x :α sptree$num_map)))) = (domain x :num -> bool)
alookup_zip_map_option_lookup_none_typed=∀(ls :num list) (vs :α list) (n :num) (ns :β sptree$num_map) (f :num -> γ). INJ f (domain ns :num -> bool) 𝕌(:γ) ∧ n ∈ (domain ns :num -> bool) ∧ ¬MEM n ls ∧ (∀(v :num). MEM v ls ⇒ v ∈ (domain ns :num -> bool)) ∧ LENGTH vs = LENGTH ls ⇒ ALOOKUP (ZIP (MAP f ls,vs)) (f n) = (NONE :α option)
alookup_zip_map_some_typed=∀(ls :α list) (vs :β list) (i :num) (f :α -> γ). ALL_DISTINCT (MAP f ls) ∧ i < LENGTH ls ∧ LENGTH vs = LENGTH ls ⇒ ALOOKUP (ZIP (MAP f ls,vs)) (f ls❲i❳) = SOME vs❲i❳
apply_colour_exp_lemma_typed=∀(st :(α, β, γ) state) (w :α exp) (cst :(α, β, γ) state) (f :num -> num) (res :α word_loc). (word_exp st w :α word_loc option) = SOME res ∧ word_state_eq_rel st cst ∧ strong_locals_rel f (domain (get_live_exp w) :num -> bool) st.locals cst.locals ⇒ (word_exp cst (apply_colour_exp f w) :α word_loc option) = SOME res
apply_nummap_key_domain_typed=∀(f :num -> num) (names :α sptree$num_map). (domain (apply_nummap_key f names) :num -> bool) = IMAGE f (domain names :num -> bool)
call_arg_convention_preservation_typed=∀(prog :α prog) (f :num -> num). every_var (λ(x :num). is_phy_var x ⇒ f x = x) prog ∧ call_arg_convention prog ⇒ call_arg_convention (apply_colour f prog)
cut_env_fromAList_LN_typed=cut_env ((a :sptree$num_set),fromAList (MAP (g :num # unit -> num # unit) (toAList (LN :sptree$num_set)))) (v :α sptree$num_map) = cut_env (a,(LN :sptree$num_set)) v
domain_big_union_subset_typed=∀(ls :α exp list) (a :α exp). MEM a ls ⇒ (domain (get_live_exp a) :num -> bool) ⊆ (domain (big_union (MAP (get_live_exp :α exp -> sptree$num_set) ls)) :num -> bool)
domain_insert_eq_union_typed=(domain (insert (num :num) () (live :sptree$num_set)) :num -> bool) = (domain (union (insert num () (LN :sptree$num_set)) live) :num -> bool)
domain_numset_list_insert_eq_union_typed=(domain (numset_list_insert (ls :num list) (live :sptree$num_set)) :num -> bool) = (domain (union (numset_list_insert ls (LN :sptree$num_set)) live) :num -> bool)
env_to_list_keys_typed=let ((l :(num # α word_loc) list),(permute :num -> num -> num)) = env_to_list (x :α word_loc sptree$num_map) (perm :num -> num -> num) in set (MAP (FST :num # α word_loc -> num) l) = (domain x :num -> bool)
env_to_list_perm_typed=∀(y :α word_loc sptree$num_map) (x :α word_loc sptree$num_map) (f :num -> num) (perm :num -> num -> num) (tperm :num -> num -> num). (domain y :num -> bool) = IMAGE f (domain x :num -> bool) ∧ INJ f (domain x :num -> bool) 𝕌(:num) ∧ strong_locals_rel f (domain x :num -> bool) x y ⇒ (let ((l :(num # α word_loc) list),(permute :num -> num -> num)) = env_to_list y perm in ∃(perm' :num -> num -> num). (let ((l' :(num # α word_loc) list),(permute' :num -> num -> num)) = env_to_list x perm' in permute' = tperm ∧ MAP (λ((x :num),(y :α word_loc)). (f x,y)) l' = l))
evaluate_apply_colour_Loop_helper_typed=∀(st :(α, γ, 'ffi) state) (cst :(α, γ, 'ffi) state) (f :num -> num) (names :sptree$num_set) (body :α prog) (exit_names :sptree$num_set) (live :sptree$num_set) (lt :(sptree$num_set # sptree$num_set) list). colouring_ok f (Loop names body exit_names :α prog) live lt ∧ word_state_eq_rel st cst ∧ strong_locals_rel f (domain (get_live (Loop names body exit_names :α prog) live lt) :num -> bool) st.locals cst.locals ∧ (∀(st :(α, γ, 'ffi) state) (cst :(α, γ, 'ffi) state) (f :num -> num) (live :sptree$num_set) (lt :(sptree$num_set # sptree$num_set) list). colouring_ok f body live lt ∧ word_state_eq_rel st cst ∧ strong_locals_rel f (domain (get_live body live lt) :num -> bool) st.locals cst.locals ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, γ, 'ffi) state)) = evaluate (body,st with permute := perm') in res = SOME (Error :α result) ∨ (let ((res' :α result option),(rcst :(α, γ, 'ffi) state)) = evaluate (apply_colour f body,cst) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => strong_locals_rel f (domain live :num -> bool) rst.locals rcst.locals | SOME (Result v11 v12) => rst.locals = rcst.locals | SOME (Exception v13 v14) => rst.locals = rcst.locals | SOME (Break n :α result) => (case LLOOKUP lt n of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (v1,exit_names) => strong_locals_rel f (domain exit_names :num -> bool) rst.locals rcst.locals) | SOME (Continue n' :α result) => (case LLOOKUP lt n' of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (names,v2) => strong_locals_rel f (domain names :num -> bool) rst.locals rcst.locals) | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v17 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals))) ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, γ, 'ffi) state)) = evaluate ((Loop names body exit_names :α prog),st with permute := perm') in res = SOME (Error :α result) ∨ (let ((res' :α result option),(rcst :(α, γ, 'ffi) state)) = evaluate (apply_colour f (Loop names body exit_names :α prog),cst) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => strong_locals_rel f (domain live :num -> bool) rst.locals rcst.locals | SOME (Result v11 v12) => rst.locals = rcst.locals | SOME (Exception v13 v14) => rst.locals = rcst.locals | SOME (Break n :α result) => (case LLOOKUP lt n of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (v1,exit_names) => strong_locals_rel f (domain exit_names :num -> bool) rst.locals rcst.locals) | SOME (Continue n' :α result) => (case LLOOKUP lt n' of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (names,v2) => strong_locals_rel f (domain names :num -> bool) rst.locals rcst.locals) | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v17 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals))
evaluate_fake_const_chain_typed=∀(rs :num list) (cst :(α, β, γ) state). evaluate (FOLDR (Seq :α prog -> α prog -> α prog) (Skip :α prog) (MAP (λ(r :num). (fake_move r :α prog)) rs),cst) = ((NONE :α result option),cst with locals := FOLDR (λ(r :num) (loc :α word_loc sptree$num_map). insert r (Word (0w :α word)) loc) cst.locals rs)
evaluate_fake_const_chain_locals_typed=∀(rs :num list) (cst :(α, β, γ) state). (let (rcst :(α, β, γ) state) = SND (evaluate (FOLDR (Seq :α prog -> α prog -> α prog) (Skip :α prog) (MAP (λ(r :num). (fake_move r :α prog)) rs),cst)) in word_state_eq_rel cst rcst ∧ (domain rcst.locals :num -> bool) = (domain cst.locals :num -> bool) ∪ set rs ∧ (∀(r :num). ¬MEM r rs ⇒ lookup r rcst.locals = lookup r cst.locals) ∧ ∀(r :num). MEM r rs ⇒ lookup r rcst.locals = SOME (Word (0w :α word)))
evaluate_remove_dead_Loop_helper_typed=∀(st :(α, γ, 'ffi) state) (t :α word_loc sptree$num_map) (tstore :store_name |-> α word_loc) (names :sptree$num_set) (body :α prog) (exit_names :sptree$num_set) (live :sptree$num_set) (nlive :store_name list) (lt :(sptree$num_set # sptree$num_set) list) (prog' :α prog) (livein :sptree$num_set) (nlivein :store_name list) (res :α result option) (rst :(α, γ, 'ffi) state). strong_locals_rel (I :num -> num) (domain livein :num -> bool) st.locals t ∧ live_store_rel nlivein st.store tstore ∧ evaluate ((Loop names body exit_names :α prog),st) = (res,rst) ∧ flat_exp_conventions body ∧ remove_dead (Loop names body exit_names :α prog) live nlive lt = (prog',livein,nlivein) ∧ nlivein = ([] :store_name list) ∧ res ≠ SOME (Error :α result) ∧ (∀(st' :(α, γ, 'ffi) state) (t' :α word_loc sptree$num_map) (tstore' :store_name |-> α word_loc) (prog'' :α prog) (livein' :sptree$num_set) (nlivein' :store_name list) (res' :α result option) (rst' :(α, γ, 'ffi) state). strong_locals_rel (I :num -> num) (domain livein' :num -> bool) st'.locals t' ∧ live_store_rel nlivein' st'.store tstore' ∧ evaluate (body,st') = (res',rst') ∧ remove_dead body names ([] :store_name list) ((names,exit_names)::lt) = (prog'',livein',nlivein') ∧ res' ≠ SOME (Error :α result) ⇒ ∃(t'' :α word_loc sptree$num_map) (tstore'' :store_name |-> α word_loc). evaluate (prog'',st' with <|locals := t'; store := tstore'|>) = (res',rst' with <|locals := t''; store := tstore''|>) ∧ case res' of (NONE :α result option) => strong_locals_rel (I :num -> num) (domain names :num -> bool) rst'.locals t'' ∧ live_store_rel ([] :store_name list) rst'.store tstore'' | SOME (Result v11 v12) => rst'.locals = t'' ∧ rst'.store = tstore'' | SOME (Exception v13 v14) => rst'.locals = t'' ∧ rst'.store = tstore'' | SOME (Break n :α result) => rst'.store = tstore'' ∧ (case LLOOKUP ((names,exit_names)::lt) n of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (v1,exit_names) => strong_locals_rel (I :num -> num) (domain exit_names :num -> bool) rst'.locals t'') | SOME (Continue n' :α result) => rst'.store = tstore'' ∧ (case LLOOKUP ((names,exit_names)::lt) n' of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (names,v2) => strong_locals_rel (I :num -> num) (domain names :num -> bool) rst'.locals t'') | SOME (TimeOut :α result) => rst'.locals = t'' ∧ rst'.store = tstore'' | SOME (NotEnoughSpace :α result) => rst'.locals = t'' ∧ rst'.store = tstore'' | SOME (FinalFFI v17 :α result) => rst'.locals = t'' ∧ rst'.store = tstore'' | SOME (Error :α result) => rst'.locals = t'' ∧ rst'.store = tstore'') ⇒ ∃(t' :α word_loc sptree$num_map) (tstore' :store_name |-> α word_loc). evaluate (prog',st with <|locals := t; store := tstore|>) = (res,rst with <|locals := t'; store := tstore'|>) ∧ case res of (NONE :α result option) => strong_locals_rel (I :num -> num) (domain live :num -> bool) rst.locals t' ∧ live_store_rel nlive rst.store tstore' | SOME (Result v11 v12) => rst.locals = t' ∧ rst.store = tstore' | SOME (Exception v13 v14) => rst.locals = t' ∧ rst.store = tstore' | SOME (Break n :α result) => rst.store = tstore' ∧ (case LLOOKUP lt n of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (v1,exit_names) => strong_locals_rel (I :num -> num) (domain exit_names :num -> bool) rst.locals t') | SOME (Continue n' :α result) => rst.store = tstore' ∧ (case LLOOKUP lt n' of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (names,v2) => strong_locals_rel (I :num -> num) (domain names :num -> bool) rst.locals t') | SOME (TimeOut :α result) => rst.locals = t' ∧ rst.store = tstore' | SOME (NotEnoughSpace :α result) => rst.locals = t' ∧ rst.store = tstore' | SOME (FinalFFI v17 :α result) => rst.locals = t' ∧ rst.store = tstore' | SOME (Error :α result) => rst.locals = t' ∧ rst.store = tstore'
evaluate_seq_collapse_typed=evaluate ((P :α prog),(s :(α, β, γ) state)) = ((NONE :α result option),(t :(α, β, γ) state)) ⇒ evaluate (Seq P (Q :α prog),s) = evaluate (Q,t)
evaluate_ssa_reconcile_typed=ssa_locals_rel (na :num) (cur_ssa :num sptree$num_map) (st_locs :α word_loc sptree$num_map) (cst :(α, β, γ) state).locals ∧ INJ (option_lookup (tgt_ssa :num sptree$num_map)) (domain (ns :δ sptree$num_map) :num -> bool) 𝕌(:num) ⇒ ∃(cst' :(α, β, γ) state). evaluate ((ssa_reconcile cur_ssa tgt_ssa ns :α prog),cst) = ((NONE :α result option),cst') ∧ word_state_eq_rel cst cst' ∧ strong_locals_rel (option_lookup tgt_ssa) (domain ns :num -> bool) st_locs cst'.locals
every_apply_nummap_key_helper_typed=∀(f :num -> num) (names :sptree$num_set) (P :num -> bool) (Q :num -> bool). EVERY P (MAP (FST :num # unit -> num) (toAList names)) ∧ (∀(x :num). P x ⇒ Q (f x)) ⇒ EVERY Q (MAP (FST :num # unit -> num) (toAList (fromAList (MAP (λ((x :num),(y :unit)). (f x,())) (toAList names)))))
every_var_T_typed=∀(prog :α prog). every_var (λ(x :num). T) prog
every_var_exp_get_live_exp_typed=∀(exp :α exp). every_var_exp (λ(x :num). x ∈ (domain (get_live_exp exp) :num -> bool)) exp
every_var_exp_get_reads_exp_typed=∀(exp :α exp). every_var_exp (λ(x :num). MEM x (get_reads_exp exp)) exp
every_var_in_get_clash_tree_typed=∀(prog :α prog) (lt :(sptree$num_set # sptree$num_set) list). every_var (in_clash_tree (get_clash_tree prog lt)) prog
every_var_is_phy_var_total_colour_typed=every_var is_phy_var (apply_colour (total_colour (col :num sptree$num_map)) (prog :α prog))
exp_to_addr_ShareInst_typed=exp_to_addr (exp :α exp) = SOME (Addr (n :num) (c :α word)) ⇔ exp = (Var n :α exp) ∧ c = (0w :α word) ∨ exp = Op Add [(Var n :α exp); (Const c :α exp)]
fake_moves_conventions_typed=∀(ls :num list) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (na :num). (let ((a :α prog),(b :α prog),(c :num),(d :num sptree$num_map),(e :num sptree$num_map)) = (fake_moves (prio :(unit + unit) option) ls ssaL ssaR na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) in every_stack_var is_stack_var a ∧ every_stack_var is_stack_var b ∧ call_arg_convention a ∧ call_arg_convention b)
fake_moves_conventions2_typed=∀(ls :num list) (ssal :num sptree$num_map) (ssar :num sptree$num_map) (na :num) (l :α prog) (r :α prog) (a :num) (b :num sptree$num_map) (c :num sptree$num_map) (conf :α asm_config). (fake_moves (prio :(unit + unit) option) ls ssal ssar na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) = (l,r,a,b,c) ⇒ full_inst_ok_less conf l ∧ full_inst_ok_less conf r ∧ every_inst (distinct_tar_reg :α inst -> bool) l ∧ every_inst (distinct_tar_reg :α inst -> bool) r
fake_moves_correctL_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (stL :(α, β, γ) state) (cstL :(α, δ, ε) state). is_alloc_var na ∧ ALL_DISTINCT ls ∧ ssa_map_ok na ssaL ⇒ (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = (fake_moves (prio :(unit + unit) option) ls ssaL ssaR na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) in ssa_locals_rel na ssaL stL.locals cstL.locals ⇒ (let ((resL :α result option),(rcstL :(α, δ, ε) state)) = evaluate (moveL,cstL) in resL = (NONE :α result option) ∧ (∀(x :num). ¬MEM x ls ⇒ lookup x ssaL' = lookup x ssaL) ∧ (∀(x :num) (y :α word_loc). x < na ∧ lookup x cstL.locals = SOME y ⇒ lookup x rcstL.locals = SOME y) ∧ ssa_locals_rel na' ssaL' stL.locals rcstL.locals ∧ word_state_eq_rel cstL rcstL))
fake_moves_correctR_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (stR :(α, β, γ) state) (cstR :(α, δ, ε) state). is_alloc_var na ∧ ALL_DISTINCT ls ∧ ssa_map_ok na ssaR ⇒ (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = (fake_moves (prio :(unit + unit) option) ls ssaL ssaR na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) in ssa_locals_rel na ssaR stR.locals cstR.locals ⇒ (let ((resR :α result option),(rcstR :(α, δ, ε) state)) = evaluate (moveR,cstR) in resR = (NONE :α result option) ∧ (∀(x :num). ¬MEM x ls ⇒ lookup x ssaR' = lookup x ssaR) ∧ (∀(x :num) (y :α word_loc). x < na ∧ lookup x cstR.locals = SOME y ⇒ lookup x rcstR.locals = SOME y) ∧ ssa_locals_rel na' ssaR' stR.locals rcstR.locals ∧ word_state_eq_rel cstR rcstR))
fake_moves_distinct_tar_reg_typed=∀(ls :num list) (ssal :num sptree$num_map) (ssar :num sptree$num_map) (na :num) (l :α prog) (r :α prog) (a :num) (b :num sptree$num_map) (c :num sptree$num_map) (conf :β). (fake_moves (prio :(unit + unit) option) ls ssal ssar na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) = (l,r,a,b,c) ⇒ every_inst (distinct_tar_reg :α inst -> bool) l ∧ every_inst (distinct_tar_reg :α inst -> bool) r
fake_moves_frame_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). is_alloc_var na ⇒ (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = (fake_moves (prio :(unit + unit) option) ls ssaL ssaR na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) in is_alloc_var na' ∧ na ≤ na' ∧ (ssa_map_ok na ssaL ⇒ ssa_map_ok na' ssaL') ∧ (ssa_map_ok na ssaR ⇒ ssa_map_ok na' ssaR'))
fake_moves_frame2_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = (fake_moves (prio :(unit + unit) option) ls ssaL ssaR na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) in (domain ssaL' :num -> bool) = (domain ssaL :num -> bool) ∪ set ls ∩ ((domain ssaR :num -> bool) ∪ (domain ssaL :num -> bool)) ∧ (domain ssaR' :num -> bool) = (domain ssaR :num -> bool) ∪ set ls ∩ ((domain ssaR :num -> bool) ∪ (domain ssaL :num -> bool)) ∧ ∀(x :num). MEM x ls ∧ x ∉ (domain (inter ssaL ssaR) :num -> bool) ⇒ lookup x ssaL' = lookup x ssaR')
fake_moves_frame3_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = (fake_moves (prio :(unit + unit) option) ls ssaL ssaR na :α prog # α prog # num # num sptree$num_map # num sptree$num_map) in ∀(x :num). ¬MEM x ls ∨ x ∈ (domain (inter ssaL ssaR) :num -> bool) ⇒ lookup x ssaL' = lookup x ssaL ∧ lookup x ssaR' = lookup x ssaR)
fake_seq_every_inst_distinct_tar_reg_typed=∀(ls :num list). every_inst (distinct_tar_reg :α inst -> bool) (FOLDR (Seq :α prog -> α prog -> α prog) (Skip :α prog) (MAP (λ(r :num). (fake_move r :α prog)) ls))
fake_seq_full_inst_ok_less_typed=∀(c :α asm_config) (ls :num list). full_inst_ok_less c (FOLDR (Seq :α prog -> α prog -> α prog) (Skip :α prog) (MAP (λ(r :num). (fake_move r :α prog)) ls))
fake_seq_pre_alloc_conventions_typed=∀(ls :num list). pre_alloc_conventions (FOLDR (Seq :α prog -> α prog -> α prog) (Skip :α prog) (MAP (λ(r :num). (fake_move r :α prog)) ls))
fix_inconsistencies_conventions_typed=∀(ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (na :num) (prio :(unit + unit) option). (let ((a :α prog),(b :α prog),(c :num),(d :num sptree$num_map)) = (fix_inconsistencies prio ssaL ssaR na :α prog # α prog # num # num sptree$num_map) in every_stack_var is_stack_var a ∧ every_stack_var is_stack_var b ∧ call_arg_convention a ∧ call_arg_convention b)
fix_inconsistencies_correctL_typed=∀(na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). is_alloc_var na ∧ ssa_map_ok na ssaL ⇒ (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaU :num sptree$num_map)) = (fix_inconsistencies (prio :(unit + unit) option) ssaL ssaR na :α prog # α prog # num # num sptree$num_map) in ∀(stL :(α, β, γ) state) (cstL :(α, β, γ) state). ssa_locals_rel na ssaL stL.locals cstL.locals ⇒ (let ((resL :α result option),(rcstL :(α, β, γ) state)) = evaluate (moveL,cstL) in resL = (NONE :α result option) ∧ ssa_locals_rel na' ssaU stL.locals rcstL.locals ∧ word_state_eq_rel cstL rcstL))
fix_inconsistencies_correctR_typed=∀(na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (prio :(unit + unit) option). is_alloc_var na ∧ ssa_map_ok na ssaR ⇒ (let ((moveL :α prog),(moveR :α prog),(na' :num),(ssaU :num sptree$num_map)) = (fix_inconsistencies prio ssaL ssaR na :α prog # α prog # num # num sptree$num_map) in ∀(stR :(α, β, γ) state) (cstR :(α, β, γ) state). ssa_locals_rel na ssaR stR.locals cstR.locals ⇒ (let ((resR :α result option),(rcstR :(α, β, γ) state)) = evaluate (moveR,cstR) in resR = (NONE :α result option) ∧ ssa_locals_rel na' ssaU stR.locals rcstR.locals ∧ word_state_eq_rel cstR rcstR))
fix_inconsistencies_props_typed=∀(ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (na :num) (a :α prog) (b :α prog) (na' :num) (ssaU :num sptree$num_map). (fix_inconsistencies (prio :(unit + unit) option) ssaL ssaR na :α prog # α prog # num # num sptree$num_map) = (a,b,na',ssaU) ⇒ is_alloc_var na ∧ ssa_map_ok na ssaL ∧ ssa_map_ok na ssaR ⇒ na ≤ na' ∧ is_alloc_var na' ∧ ssa_map_ok na' ssaU
flip_rw_typed=(is_stack_var ((na :num) + (2 :num)) ⇔ is_alloc_var na) ∧ (is_alloc_var (na + (2 :num)) ⇔ is_stack_var na)
foldr_insert_const_swap_typed=∀(rs :num list) (h :num) (v :α word_loc) (m :α word_loc sptree$num_map). FOLDR (λ(r :num) (loc :α word_loc sptree$num_map). insert r v loc) (insert h v m) rs = insert h v (FOLDR (λ(r :num) (loc :α word_loc sptree$num_map). insert r v loc) m rs)
forced_distinct_col_typed=EVERY (λ((x :num),(y :num)). sp_default (spcol :num sptree$num_map) x = sp_default spcol y ⇒ x = y) (ls :(num # num) list) ∧ EVERY (λ((x :num),(y :num)). x ≠ y) ls ⇒ EVERY (λ((x :num),(y :num)). total_colour spcol x ≠ total_colour spcol y) ls
get_forced_in_get_clash_tree_typed=∀(prog :α prog) (lt :(sptree$num_set # sptree$num_set) list) (c :α asm_config). EVERY (λ((x :num),(y :num)). in_clash_tree (get_clash_tree prog lt) x ∧ in_clash_tree (get_clash_tree prog lt) y) (get_forced c prog ([] :(num # num) list))
get_forced_pairwise_distinct_typed=∀(c :α asm_config) (prog :α prog) (ls :(num # num) list). EVERY (λ((x :num),(y :num)). x ≠ y) ls ⇒ EVERY (λ((x :num),(y :num)). x ≠ y) (get_forced c prog ls)
get_forced_tail_split_typed=∀(c :α asm_config) (p :α prog) (ls :(num # num) list) (ls' :(num # num) list). get_forced c p (ls ++ ls') = get_forced c p ls ++ ls'
get_reads_exp_get_live_exp_typed=∀(exp :α exp). set (get_reads_exp exp) = (domain (get_live_exp exp) :num -> bool)
get_vars_eq_typed=set (ls :num list) ⊆ (domain (st :(α, β, γ) state).locals :num -> bool) ⇒ ∃(z :α word_loc list). get_vars ls st = SOME z ∧ z = MAP (λ(x :num). THE (lookup x st.locals)) ls
get_vars_exists_typed=∀(ls :num list). (∃(z :α word_loc list). get_vars ls (st :(α, β, γ) state) = SOME z) ⇔ set ls ⊆ (domain st.locals :num -> bool)
get_vars_list_insert_eq_gen_typed=∀(ls :num list) (x :α word_loc list) (locs :α word_loc sptree$num_map) (a :num list) (b :α word_loc list). LENGTH ls = LENGTH x ∧ ALL_DISTINCT ls ∧ LENGTH a = LENGTH b ∧ (∀(e :num). MEM e ls ⇒ ¬MEM e a) ⇒ get_vars ls ((st :(α, β, γ) state) with locals := alist_insert (a ++ ls) (b ++ x) locs) = SOME x
get_vars_set_vars_eq_typed=∀(ls :num list) (x :α word_loc list). ALL_DISTINCT ls ∧ LENGTH x = LENGTH ls ⇒ get_vars ls (set_vars ls x (cst :(α, β, γ) state)) = SOME x
is_alloc_var_add_typed=is_alloc_var (na :num) ⇒ is_alloc_var (na + (4 :num))
is_alloc_var_flip_typed=is_alloc_var (na :num) ⇒ is_stack_var (na + (2 :num))
is_stack_var_add_typed=is_stack_var (na :num) ⇒ is_stack_var (na + (4 :num))
is_stack_var_flip_typed=is_stack_var (na :num) ⇒ is_alloc_var (na + (2 :num))
limit_var_props_typed=limit_var (prog :α prog) = (lim :num) ⇒ is_alloc_var lim ∧ every_var (λ(x :num). x < lim) prog
list_next_var_rename_lemma_1_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num) (ls' :num list) (ssa' :num sptree$num_map) (na' :num). list_next_var_rename ls ssa na = (ls',ssa',na') ⇒ (let (len :num) = LENGTH ls in ALL_DISTINCT ls' ∧ ls' = MAP (λ(x :num). (4 :num) * x + na) (COUNT_LIST len) ∧ na' = na + (4 :num) * len)
list_next_var_rename_lemma_2_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num). ALL_DISTINCT ls ⇒ (let ((ls' :num list),(ssa' :num sptree$num_map),(na' :num)) = list_next_var_rename ls ssa na in ls' = MAP (λ(x :num). THE (lookup x ssa')) ls ∧ (domain ssa' :num -> bool) = (domain ssa :num -> bool) ∪ set ls ∧ (∀(x :num). ¬MEM x ls ⇒ lookup x ssa' = lookup x ssa) ∧ ∀(x :num). MEM x ls ⇒ ∃(y :num). lookup x ssa' = SOME y)
list_next_var_rename_lemma_2_prime_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num) (ls' :num list) (ssa' :num sptree$num_map) (na' :num). list_next_var_rename ls ssa na = (ls',ssa',na') ⇒ ALL_DISTINCT ls ⇒ ls' = MAP (λ(x :num). THE (lookup x ssa')) ls ∧ (domain ssa' :num -> bool) = (domain ssa :num -> bool) ∪ set ls ∧ (∀(x :num). ¬MEM x ls ⇒ lookup x ssa' = lookup x ssa) ∧ ∀(x :num). MEM x ls ⇒ ∃(y :num). lookup x ssa' = SOME y
list_next_var_rename_move_preserve_typed=∀(st :(α, β, γ) state) (ssa :num sptree$num_map) (na :num) (ls :num list) (cst :(α, β, γ) state). ssa_locals_rel na ssa st.locals cst.locals ∧ set ls ⊆ (domain st.locals :num -> bool) ∧ ALL_DISTINCT ls ∧ ssa_map_ok na ssa ∧ word_state_eq_rel st cst ⇒ (let ((mov :α prog),(ssa' :num sptree$num_map),(na' :num)) = (list_next_var_rename_move ssa na ls :α prog # num sptree$num_map # num); ((res :α result option),(rcst :(α, β, γ) state)) = evaluate (mov,cst) in res = (NONE :α result option) ∧ ssa_locals_rel na' ssa' st.locals rcst.locals ∧ word_state_eq_rel st rcst ∧ (¬is_phy_var na ⇒ ∀(w :num). is_phy_var w ⇒ lookup w rcst.locals = lookup w cst.locals) ∧ ∀(x :num) (y :α word_loc). lookup x st.locals = SOME y ⇒ lookup (THE (lookup x ssa)) rcst.locals = SOME y)
list_next_var_rename_move_preserve_weak_typed=∀(st :(α, β, γ) state) (ssa :num sptree$num_map) (na :num) (ls :num list) (cst :(α, β, γ) state). ssa_locals_rel na ssa st.locals cst.locals ∧ set ls ⊆ (domain ssa :num -> bool) ∧ ALL_DISTINCT ls ∧ ssa_map_ok na ssa ∧ word_state_eq_rel st cst ⇒ (let ((mov :α prog),(ssa' :num sptree$num_map),(na' :num)) = (list_next_var_rename_move ssa na ls :α prog # num sptree$num_map # num); ((res :α result option),(rcst :(α, β, γ) state)) = evaluate (mov,cst) in res = (NONE :α result option) ∧ ssa_locals_rel na' ssa' st.locals rcst.locals ∧ word_state_eq_rel st rcst)
list_next_var_rename_move_props_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num) (ls' :α prog) (ssa' :num sptree$num_map) (na' :num). (list_next_var_rename_move ssa na ls :α prog # num sptree$num_map # num) = (ls',ssa',na') ⇒ (is_alloc_var na ∨ is_stack_var na) ∧ ssa_map_ok na ssa ⇒ na ≤ na' ∧ (is_alloc_var na ⇒ is_alloc_var na') ∧ (is_stack_var na ⇒ is_stack_var na') ∧ ssa_map_ok na' ssa'
list_next_var_rename_move_props_2_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num) (ls' :α prog) (ssa' :num sptree$num_map) (na' :num). (list_next_var_rename_move ssa (na + (2 :num)) ls :α prog # num sptree$num_map # num) = (ls',ssa',na') ⇒ (is_alloc_var na ∨ is_stack_var na) ∧ ssa_map_ok na ssa ⇒ na + (2 :num) ≤ na' ∧ (is_alloc_var na ⇒ is_stack_var na') ∧ (is_stack_var na ⇒ is_alloc_var na') ∧ ssa_map_ok na' ssa'
list_next_var_rename_props_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num) (ls' :num list) (ssa' :num sptree$num_map) (na' :num). list_next_var_rename ls ssa na = (ls',ssa',na') ⇒ (is_alloc_var na ∨ is_stack_var na) ∧ ssa_map_ok na ssa ⇒ na ≤ na' ∧ (is_alloc_var na ⇒ is_alloc_var na') ∧ (is_stack_var na ⇒ is_stack_var na') ∧ ssa_map_ok na' ssa'
list_next_var_rename_props_2_typed=∀(ls :num list) (ssa :num sptree$num_map) (na :num) (ls' :num list) (ssa' :num sptree$num_map) (na' :num). list_next_var_rename ls ssa na = (ls',ssa',na') ⇒ (is_alloc_var na ∨ is_stack_var na) ∧ ssa_map_ok na ssa ⇒ na ≤ na' ∧ (is_alloc_var na ⇒ is_alloc_var na') ∧ (is_stack_var na ⇒ is_stack_var na') ∧ ssa_map_ok na' ssa'
