live_store_rel_NIL_typed=live_store_rel ([] :α list) (sstore :α |-> β) (tstore :α |-> β) ⇔ sstore = tstore
live_store_rel_refl_typed=live_store_rel (ls :α list) (sstore :α |-> β) sstore
lookup_numset_list_insert_typed=∀(ls :num list) (n :num) (t :sptree$num_set). lookup n (numset_list_insert ls t) = if MEM n ls then SOME () else lookup n t
loop_setup_correct_typed=∀(st :(α, β, γ) state) (cst :(α, β, γ) state) (ssa :num sptree$num_map) (na :num) (names :sptree$num_set) (exit_names :sptree$num_set) (setup_prog :α prog) (ssa_refreshed :num sptree$num_map) (na_refreshed :num). word_state_eq_rel st cst ∧ ssa_locals_rel na ssa st.locals cst.locals ∧ ssa_map_ok na ssa ∧ is_alloc_var na ∧ (loop_setup names exit_names ssa na :α prog # num sptree$num_map # num) = (setup_prog,ssa_refreshed,na_refreshed) ⇒ ∃(rcst :(α, β, γ) state). evaluate (setup_prog,cst) = ((NONE :α result option),rcst) ∧ word_state_eq_rel st rcst ∧ ssa_locals_rel na_refreshed ssa_refreshed st.locals rcst.locals ∧ na ≤ na_refreshed ∧ is_alloc_var na_refreshed ∧ ssa_map_ok na_refreshed ssa_refreshed ∧ (domain ssa_refreshed :num -> bool) = (domain ssa :num -> bool) ∪ (domain (union names exit_names) :num -> bool) ∧ INJ (option_lookup ssa_refreshed) (domain names :num -> bool) 𝕌(:num) ∧ INJ (option_lookup ssa_refreshed) (domain exit_names :num -> bool) 𝕌(:num) ∧ ∀(v :num). v ∈ (domain ssa_refreshed :num -> bool) ⇒ option_lookup ssa_refreshed v ∈ (domain rcst.locals :num -> bool)
loop_setup_every_inst_distinct_tar_reg_typed=(loop_setup (names :sptree$num_set) (exit_names :sptree$num_set) (ssa :num sptree$num_map) (na :num) :α prog # num sptree$num_map # num) = ((setup_prog :α prog),(ssa_refreshed :num sptree$num_map),(na_refreshed :num)) ⇒ every_inst (distinct_tar_reg :α inst -> bool) setup_prog
loop_setup_full_inst_ok_less_typed=(loop_setup (names :sptree$num_set) (exit_names :sptree$num_set) (ssa :num sptree$num_map) (na :num) :α prog # num sptree$num_map # num) = ((setup_prog :α prog),(ssa_refreshed :num sptree$num_map),(na_refreshed :num)) ⇒ full_inst_ok_less (c :α asm_config) setup_prog
