loop_setup_props_local_typed=(loop_setup (names :sptree$num_set) (exit_names :sptree$num_set) (ssa :num sptree$num_map) (na :num) :α prog # num sptree$num_map # num) = ((setup_prog :α prog),(ssa_refreshed :num sptree$num_map),(na_refreshed :num)) ∧ ssa_map_ok na ssa ∧ is_alloc_var na ⇒ is_alloc_var na_refreshed ∧ ssa_map_ok na_refreshed ssa_refreshed ∧ na ≤ na_refreshed
max3_eq_typed=∀(x :num) (y :num) (z :num). max3 x y z = MAX x (MAX y z)
max_var_exp_max_typed=∀(exp :α exp). every_var_exp (λ(x :num). x ≤ max_var_exp exp) exp
max_var_inst_max_typed=∀(inst :α inst). every_var_inst (λ(x :num). x ≤ max_var_inst inst) inst
merge_moves_correctL_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (stL :(α, β, γ) state) (cstL :(α, δ, ε) state) (pri :num). is_alloc_var na ∧ ALL_DISTINCT ls ∧ ssa_map_ok na ssaL ⇒ (let ((moveL :(num # num) list),(moveR :(num # num) list),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = merge_moves ls ssaL ssaR na in ssa_locals_rel na ssaL stL.locals cstL.locals ⇒ (let ((resL :α result option),(rcstL :(α, δ, ε) state)) = evaluate ((Move pri moveL :α prog),cstL) in resL = (NONE :α result option) ∧ (∀(x :num). ¬MEM x ls ⇒ lookup x ssaL' = lookup x ssaL) ∧ (∀(x :num) (y :α word_loc). x < na ∧ lookup x cstL.locals = SOME y ⇒ lookup x rcstL.locals = SOME y) ∧ ssa_locals_rel na' ssaL' stL.locals rcstL.locals ∧ word_state_eq_rel cstL rcstL))
merge_moves_correctR_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map) (stR :(α, β, γ) state) (cstR :(α, δ, ε) state) (pri :num). is_alloc_var na ∧ ALL_DISTINCT ls ∧ ssa_map_ok na ssaR ⇒ (let ((moveL :(num # num) list),(moveR :(num # num) list),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = merge_moves ls ssaL ssaR na in ssa_locals_rel na ssaR stR.locals cstR.locals ⇒ (let ((resR :α result option),(rcstR :(α, δ, ε) state)) = evaluate ((Move pri moveR :α prog),cstR) in resR = (NONE :α result option) ∧ (∀(x :num). ¬MEM x ls ⇒ lookup x ssaR' = lookup x ssaR) ∧ (∀(x :num) (y :α word_loc). x < na ∧ lookup x cstR.locals = SOME y ⇒ lookup x rcstR.locals = SOME y) ∧ ssa_locals_rel na' ssaR' stR.locals rcstR.locals ∧ word_state_eq_rel cstR rcstR))
merge_moves_frame_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). is_alloc_var na ⇒ (let ((moveL :(num # num) list),(moveR :(num # num) list),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = merge_moves ls ssaL ssaR na in is_alloc_var na' ∧ na ≤ na' ∧ (ssa_map_ok na ssaL ⇒ ssa_map_ok na' ssaL') ∧ (ssa_map_ok na ssaR ⇒ ssa_map_ok na' ssaR'))
merge_moves_frame2_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). (let ((moveL :(num # num) list),(moveR :(num # num) list),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = merge_moves ls ssaL ssaR na in (domain ssaL' :num -> bool) = (domain ssaL :num -> bool) ∧ (domain ssaR' :num -> bool) = (domain ssaR :num -> bool) ∧ ∀(x :num). MEM x ls ∧ x ∈ (domain (inter ssaL ssaR) :num -> bool) ⇒ lookup x ssaL' = lookup x ssaR')
merge_moves_frame3_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). (let ((moveL :(num # num) list),(moveR :(num # num) list),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = merge_moves ls ssaL ssaR na in ∀(x :num). ¬MEM x ls ∨ x ∉ (domain (inter ssaL ssaR) :num -> bool) ⇒ lookup x ssaL' = lookup x ssaL ∧ lookup x ssaR' = lookup x ssaR)
merge_moves_fst_typed=∀(ls :num list) (na :num) (ssaL :num sptree$num_map) (ssaR :num sptree$num_map). (let ((moveL :(num # num) list),(moveR :(num # num) list),(na' :num),(ssaL' :num sptree$num_map),(ssaR' :num sptree$num_map)) = merge_moves ls ssaL ssaR na in na ≤ na' ∧ EVERY (λ(x :num). x < na' ∧ x ≥ na) (MAP (FST :num # num -> num) moveL) ∧ EVERY (λ(x :num). x < na' ∧ x ≥ na) (MAP (FST :num # num -> num) moveR))
mov_eval_head_typed=evaluate ((Move (p :num) (moves :(num # num) list) :α prog),(st :(α, β, γ) state)) = ((NONE :α result option),(rst :(α, β, γ) state)) ∧ (y :num) ∈ (domain st.locals :num -> bool) ∧ ¬MEM y (MAP (FST :num # num -> num) moves) ∧ ¬MEM (x :num) (MAP (FST :num # num -> num) moves) ⇒ evaluate ((Move p ((x,y)::moves) :α prog),st) = ((NONE :α result option),rst with locals := insert x (THE (lookup y st.locals)) rst.locals)
next_var_rename_props_typed=next_var_rename (ls :num) (ssa :num sptree$num_map) (na :num) = ((ls' :num),(ssa' :num sptree$num_map),(na' :num)) ⇒ (is_alloc_var na ∨ is_stack_var na) ∧ ssa_map_ok na ssa ⇒ na ≤ na' ∧ (is_alloc_var na ⇒ is_alloc_var na') ∧ (is_stack_var na ⇒ is_stack_var na') ∧ ssa_map_ok na' ssa'
nummaps_to_nummap_typed=FST (apply_nummaps_key (f :num -> num) (a :α sptree$num_map # β sptree$num_map)) = apply_nummap_key f (FST a) ∧ SND (apply_nummaps_key f a) = apply_nummap_key f (SND a)
numset_list_delete_swap_typed=∀(ls :num list) (h :num) (live :α sptree$num_map). wf live ⇒ wf (numset_list_delete ls live) ∧ numset_list_delete ls (delete h live) = delete h (numset_list_delete ls live)
numset_list_insert_eq_UNION_typed=∀(t :sptree$num_set) (t' :sptree$num_set) (ls :num list). wf t ∧ wf t' ∧ (domain t' :num -> bool) = set ls ⇒ numset_list_insert ls t = union t' t
numset_list_insert_swap_typed=∀(ls :num list) (h :num) (live :sptree$num_set). wf live ⇒ wf (numset_list_insert ls live) ∧ numset_list_insert ls (insert h () live) = insert h () (numset_list_insert ls live)
option_lookup_subset_helper_typed=∀(ssa :num sptree$num_map) (cst_locs :α sptree$num_map) (ls :num list). (∀(x :num) (y :num). lookup x ssa = SOME y ⇒ y ∈ (domain cst_locs :num -> bool)) ∧ set ls ⊆ (domain ssa :num -> bool) ⇒ set (MAP (option_lookup ssa) ls) ⊆ (domain cst_locs :num -> bool)
oracle_colour_ok_conventions_typed=pre_alloc_conventions (prog :α prog) ∧ oracle_colour_ok (k :num) (col_opt :num sptree$num_map option) (get_clash_tree prog (lt :(sptree$num_set # sptree$num_set) list)) prog (ls :(num # num) list) = SOME (x :α prog) ⇒ post_alloc_conventions k x
setup_ssa_props_typed=is_alloc_var (lim :num) ∧ (domain (st :(α, β, γ) state).locals :num -> bool) = set (even_list (n :num)) ⇒ (let ((mov :α prog),(ssa :num sptree$num_map),(na :num)) = (setup_ssa n lim (prog :α prog) :α prog # num sptree$num_map # num); ((res :α result option),(cst :(α, β, γ) state)) = evaluate (mov,st) in res = (NONE :α result option) ∧ word_state_eq_rel st cst ∧ ssa_map_ok na ssa ∧ ssa_locals_rel na ssa st.locals cst.locals ∧ is_alloc_var na ∧ lim ≤ na)
setup_ssa_props_2_typed=is_alloc_var (lim :num) ⇒ (let ((mov :α prog),(ssa :num sptree$num_map),(na :num)) = (setup_ssa (n :num) lim (prog :α prog) :α prog # num sptree$num_map # num) in ssa_map_ok na ssa ∧ is_alloc_var na ∧ pre_alloc_conventions mov ∧ lim ≤ na)
ssa_cc_trans_Loop_helper_typed=∀(st :(α, β, γ) state) (cst :(α, β, γ) state) (ssa_refreshed :num sptree$num_map) (na_refreshed :num) (names :sptree$num_set) (body :α prog) (exit_names :sptree$num_set) (lt :(num sptree$num_map # sptree$num_set # sptree$num_set) list) (body' :α prog) (ssa' :num sptree$num_map) (na' :num). word_state_eq_rel st cst ∧ strong_locals_rel (option_lookup ssa_refreshed) (domain names :num -> bool) st.locals cst.locals ∧ (∀(v :num). v ∈ (domain names :num -> bool) ⇒ option_lookup ssa_refreshed v ∈ (domain cst.locals :num -> bool)) ∧ ssa_map_ok na_refreshed ssa_refreshed ∧ is_alloc_var na_refreshed ∧ every_var (λ(x :num). x < na_refreshed) body ∧ INJ (option_lookup ssa_refreshed) (domain names :num -> bool) 𝕌(:num) ∧ INJ (option_lookup ssa_refreshed) (domain exit_names :num -> bool) 𝕌(:num) ∧ (domain names :num -> bool) ⊆ (domain ssa_refreshed :num -> bool) ∧ (domain exit_names :num -> bool) ⊆ (domain ssa_refreshed :num -> bool) ∧ EVERY (λ(x :num). x < na_refreshed) (MAP (FST :num # unit -> num) (toAList names)) ∧ EVERY (λ(x :num). x < na_refreshed) (MAP (FST :num # unit -> num) (toAList exit_names)) ∧ lt_ok lt ∧ ssa_cc_trans body (inter ssa_refreshed names) na_refreshed ((ssa_refreshed,names,exit_names)::lt) = (body',ssa',na') ∧ (∀(st' :(α, β, γ) state) (cst' :(α, β, γ) state) (ssa'' :num sptree$num_map) (na'' :num) (lt' :(num sptree$num_map # sptree$num_set # sptree$num_set) list). word_state_eq_rel st' cst' ∧ ssa_locals_rel na'' ssa'' st'.locals cst'.locals ∧ is_alloc_var na'' ∧ every_var (λ(x :num). x < na'') body ∧ ssa_map_ok na'' ssa'' ∧ lt_ok lt' ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (body,st' with permute := perm') in res = SOME (Error :α result) ∨ (let ((prog' :α prog),(ssaB :num sptree$num_map),(naB :num)) = ssa_cc_trans body ssa'' na'' lt'; ((res' :α result option),(rcst :(α, β, γ) state)) = evaluate (prog',cst') in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => ssa_locals_rel naB ssaB rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n :α result) => (case LLOOKUP lt' n of (NONE :(num sptree$num_map # sptree$num_set # sptree$num_set) option) => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names :num -> bool) rst.locals rcst.locals) | SOME (Continue n' :α result) => (case LLOOKUP lt' n' of (NONE :(num sptree$num_map # sptree$num_set # sptree$num_set) option) => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names :num -> bool) rst.locals rcst.locals) | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v18 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals))) ⇒ (let (back_moves :α prog) = (ssa_reconcile ssa' ssa_refreshed names :α prog); (body_final :α prog) = if back_moves = (Skip :α prog) then body' else Seq body' back_moves; (ssa_names :sptree$num_set) = apply_nummap_key (option_lookup ssa_refreshed) names; (ssa_exit :sptree$num_set) = apply_nummap_key (option_lookup ssa_refreshed) exit_names in ∀(res' :α result option) (rcst :(α, β, γ) state). evaluate ((Loop ssa_names body_final ssa_exit :α prog),cst) = (res',rcst) ⇒ ∃(perm' :num -> num -> num). (λ((res :α result option),(rst :(α, β, γ) state)). res = SOME (Error :α result) ∨ res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => ssa_locals_rel na' (inter ssa_refreshed exit_names) rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n :α result) => (case LLOOKUP lt n of (NONE :(num sptree$num_map # sptree$num_set # sptree$num_set) option) => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names :num -> bool) rst.locals rcst.locals) | SOME (Continue n' :α result) => (case LLOOKUP lt n' of (NONE :(num sptree$num_map # sptree$num_set # sptree$num_set) option) => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names :num -> bool) rst.locals rcst.locals) | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v18 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals) (evaluate ((Loop names body exit_names :α prog),st with permute := perm')))
ssa_cc_trans_exp_correct_typed=∀(st :(α, β, γ) state) (w :α exp) (cst :(α, β, γ) state) (ssa :num sptree$num_map) (na :num) (res :α word_loc). (word_exp st w :α word_loc option) = SOME res ∧ word_state_eq_rel st cst ∧ ssa_locals_rel na ssa st.locals cst.locals ⇒ (word_exp cst (ssa_cc_trans_exp ssa w) :α word_loc option) = SOME res
ssa_cc_trans_inst_props_typed=∀(i :α inst) (ssa :num sptree$num_map) (na :num) (i' :α prog) (ssa' :num sptree$num_map) (na' :num). ssa_cc_trans_inst i ssa na = (i',ssa',na') ⇒ ssa_map_ok na ssa ∧ is_alloc_var na ⇒ na ≤ na' ∧ is_alloc_var na' ∧ ssa_map_ok na' ssa'
ssa_eq_rel_swap_typed=ssa_locals_rel (na :num) (ssaR :num sptree$num_map) (st :(α, β, γ) state).locals (cst :(α, δ, ε) state).locals ∧ (domain (ssaL :num sptree$num_map) :num -> bool) = (domain ssaR :num -> bool) ∧ (∀(x :num). lookup x ssaL = lookup x ssaR) ⇒ ssa_locals_rel na ssaL st.locals cst.locals
ssa_locals_rel_get_var_typed=ssa_locals_rel (na :num) (ssa :num sptree$num_map) (st :(α, β, γ) state).locals (cst :(α, δ, ε) state).locals ∧ get_var (n :num) st = SOME (x :α word_loc) ⇒ get_var (option_lookup ssa n) cst = SOME x
ssa_locals_rel_get_vars_typed=∀(ls :num list) (y :α word_loc list) (na :num) (ssa :num sptree$num_map) (st :(α, β, γ) state) (cst :(α, δ, ε) state). ssa_locals_rel na ssa st.locals cst.locals ∧ get_vars ls st = SOME y ⇒ get_vars (MAP (option_lookup ssa) ls) cst = SOME y
ssa_locals_rel_ignore_insert_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ∧ ssa_locals_rel na ssa (stloc :α sptree$num_map) (cstloc :α sptree$num_map) ∧ is_phy_var (v :num) ⇒ ssa_locals_rel na ssa stloc (insert v (a :α) cstloc)
ssa_locals_rel_ignore_list_insert_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ∧ ssa_locals_rel na ssa (st :(α, β, γ) state).locals (cst :(α, δ, ε) state).locals ∧ EVERY is_phy_var (ls :num list) ∧ LENGTH ls = LENGTH (x :α word_loc list) ⇒ ssa_locals_rel na ssa st.locals (alist_insert ls x cst.locals)
ssa_locals_rel_ignore_set_var_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ∧ ssa_locals_rel na ssa (st :(α, β, γ) state).locals (cst :(α, δ, ε) state).locals ∧ is_phy_var (v :num) ⇒ ssa_locals_rel na ssa st.locals (set_var v (a :α word_loc) cst).locals
ssa_locals_rel_insert_typed=ssa_locals_rel (na :num) (ssa :num sptree$num_map) (stloc :α sptree$num_map) (cstloc :α sptree$num_map) ∧ ssa_map_ok na ssa ∧ (n :num) < na ⇒ ssa_locals_rel (na + (4 :num)) (insert n na ssa) (insert n (w :α) stloc) (insert na w cstloc)
ssa_locals_rel_list_next_var_rename_typed=∀(xs :num list) (ssa :num sptree$num_map) (na :num) (stloc :α sptree$num_map) (cstloc :α sptree$num_map) (ys :num list) (ssa' :num sptree$num_map) (na' :num) (ls :α list). list_next_var_rename xs ssa na = (ys,ssa',na') ∧ ssa_locals_rel na ssa stloc cstloc ∧ ssa_map_ok na ssa ∧ LENGTH xs = LENGTH ls ∧ EVERY (λ(x :num). x < na) xs ∧ ALL_DISTINCT xs ∧ ¬is_phy_var na ⇒ ssa_locals_rel na' ssa' (alist_insert xs ls stloc) (alist_insert ys ls cstloc)
ssa_locals_rel_more_typed=ssa_locals_rel (na :num) (ssa :num sptree$num_map) (stlocs :α sptree$num_map) (cstlocs :α sptree$num_map) ∧ na ≤ (na' :num) ⇒ ssa_locals_rel na' ssa stlocs cstlocs
ssa_locals_rel_set_var_typed=ssa_locals_rel (na :num) (ssa :num sptree$num_map) (stl :α sptree$num_map) (cstl :α sptree$num_map) ∧ ssa_map_ok na ssa ∧ (n :num) < na ⇒ ssa_locals_rel (na + (4 :num)) (insert n na ssa) (insert n (w :α) stl) (insert na w cstl)
ssa_map_ok_extend_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ∧ ¬is_phy_var na ⇒ ssa_map_ok (na + (4 :num)) (insert (h :num) na ssa)
ssa_map_ok_inter_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ⇒ ssa_map_ok na (inter ssa (ssa' :α sptree$num_map))
ssa_map_ok_lem_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ⇒ ssa_map_ok (na + (2 :num)) ssa
ssa_map_ok_more_typed=ssa_map_ok (na :num) (ssa :num sptree$num_map) ∧ na ≤ (na' :num) ⇒ ssa_map_ok na' ssa
ssa_reconcile_filtered_all_distinct_typed=ALL_DISTINCT (FILTER (λ(v :num). case lookup v (cur_ssa :num sptree$num_map) of (NONE :num option) => F | SOME cv => option_lookup (tgt_ssa :num sptree$num_map) v ≠ cv) (MAP (FST :num # α -> num) (toAList (ns :α sptree$num_map))))
ssa_reconcile_get_vars_lemma_typed=∀(ls :num list) (cur_ssa :num sptree$num_map) (cst :(α, β, γ) state). ALL_DISTINCT ls ∧ (∀(v :num). MEM v ls ⇒ ∃(val :α word_loc). lookup (THE (lookup v cur_ssa)) cst.locals = SOME val) ⇒ ∃(vs :α word_loc list). get_vars (MAP (λ(v :num). THE (lookup v cur_ssa)) ls) cst = SOME vs ∧ LENGTH vs = LENGTH ls ∧ ∀(i :num). i < LENGTH ls ⇒ lookup (THE (lookup ls❲i❳ cur_ssa)) cst.locals = SOME vs❲i❳
ssa_reconcile_moves_eq_typed=∀(L :num list). FILTER (λ((a :α),(b :α)). a ≠ b) (FLAT (MAP (λ(v :num). case lookup v (m :α sptree$num_map) of (NONE :α option) => ([] :(α # α) list) | SOME cv => [((f :num -> α) v,cv)]) L)) = MAP (λ(v :num). (f v,THE (lookup v m))) (FILTER (λ(v :num). case lookup v m of (NONE :α option) => F | SOME cv => f v ≠ cv) L)
st_eq_typed=(rst :(α, β, γ) state) with <|locals := (t :α word_loc sptree$num_map); store := (tstore :store_name |-> α word_loc)|> = rst with <|locals := (t' :α word_loc sptree$num_map); store := (tstore' :store_name |-> α word_loc)|> ⇔ t = t' ∧ tstore = tstore'
strong_locals_rel_I_cut_env_typed=strong_locals_rel (I :num -> num) ((domain (FST (cutset :sptree$num_set # sptree$num_set)) :num -> bool) ∪ (domain (SND cutset) :num -> bool)) (st :(α, β, γ) state).locals (t :α word_loc sptree$num_map) ∧ cut_env cutset st.locals = SOME (x :α word_loc sptree$num_map) ⇒ cut_env cutset t = SOME x
strong_locals_rel_I_cut_envs_typed=strong_locals_rel (I :num -> num) ((domain (FST (cutset :sptree$num_set # sptree$num_set)) :num -> bool) ∪ (domain (SND cutset) :num -> bool)) (st :(α, β, γ) state).locals (t :α word_loc sptree$num_map) ∧ cut_envs cutset st.locals = SOME (x :α word_loc sptree$num_map # α word_loc sptree$num_map) ⇒ cut_envs cutset t = SOME x
strong_locals_rel_I_get_var_typed=get_var (x :num) (st :(α, β, γ) state) = SOME (v :α word_loc) ∧ strong_locals_rel (I :num -> num) (x INSERT (live :num -> bool)) st.locals (t :α word_loc sptree$num_map) ⇒ get_var x (st with <|locals := t; store := (tstore :store_name |-> α word_loc)|>) = SOME v
strong_locals_rel_I_get_var_prime_typed=get_var (x :num) (st :(α, β, γ) state) = SOME (v :α word_loc) ∧ strong_locals_rel (I :num -> num) (x INSERT (live :num -> bool)) st.locals (t :α word_loc sptree$num_map) ⇒ get_var x (st with locals := t) = SOME v
strong_locals_rel_I_get_vars_prime_typed=∀(ls :num list) (live :num -> bool) (st :(α, β, γ) state) (t :α word_loc sptree$num_map) (vs :α word_loc list). (∀(x :num). MEM x ls ⇒ x ∈ live) ∧ strong_locals_rel (I :num -> num) live st.locals t ∧ get_vars ls st = SOME vs ⇒ get_vars ls (st with locals := t) = SOME vs
strong_locals_rel_I_insert_insert_typed=strong_locals_rel (I :num -> num) ((live :num -> bool) DELETE (p :num)) (A :α sptree$num_map) (B :α sptree$num_map) ∧ (v :α) = (v' :α) ⇒ strong_locals_rel (I :num -> num) live (insert p v A) (insert p v' B)
strong_locals_rel_I_word_exp_typed=∀(st :(α, β, γ) state) (exp :α exp) (res :α word_loc). (word_exp st exp :α word_loc option) = SOME res ∧ strong_locals_rel (I :num -> num) (domain (union (get_live_exp exp) (live :sptree$num_set)) :num -> bool) st.locals (t :α word_loc sptree$num_map) ∧ live_store_rel (nlive :store_name list) st.store (tstore :store_name |-> α word_loc) ∧ nlive_store nlive exp ⇒ (word_exp (st with <|locals := t; store := tstore|>) exp :α word_loc option) = SOME res
strong_locals_rel_extend_aux_typed=(domain (src :α sptree$num_map) :num -> bool) ⊆ (s :num -> bool) ∧ strong_locals_rel (f :num -> num) s src (tgt :α sptree$num_map) ⇒ strong_locals_rel f (t :num -> bool) src tgt
strong_locals_rel_get_var_typed=strong_locals_rel (f :num -> num) (live :num -> bool) (st :(α, β, γ) state).locals (cst :(α, δ, ε) state).locals ∧ (n :num) ∈ live ∧ get_var n st = SOME (x :α word_loc) ⇒ get_var (f n) cst = SOME x
strong_locals_rel_get_var_imm_typed=strong_locals_rel (f :num -> num) (live :num -> bool) (st :(α, β, γ) state).locals (cst :(α, δ, ε) state).locals ∧ (case (n :α reg_imm) of (Reg n :α reg_imm) => n ∈ live | Imm v3 => T) ∧ get_var_imm n st = SOME (x :α word_loc) ⇒ get_var_imm (apply_colour_imm f n) cst = SOME x
strong_locals_rel_get_vars_typed=∀(ls :num list) (y :α word_loc list) (f :num -> num) (live :num -> bool) (st :(α, β, γ) state) (cst :(α, δ, ε) state). strong_locals_rel f live st.locals cst.locals ∧ (∀(x :num). MEM x ls ⇒ x ∈ live) ∧ get_vars ls st = SOME y ⇒ get_vars (MAP f ls) cst = SOME y
strong_locals_rel_insert_notin_typed=strong_locals_rel (f :num -> num) (live :num -> bool) (s :α sptree$num_map) (t :α sptree$num_map) ∧ (n :num) ∉ live ⇒ strong_locals_rel f live (insert n (v :α) s) t
strong_locals_rel_subset_typed=(s :num -> bool) ⊆ (s' :num -> bool) ∧ strong_locals_rel (f :num -> num) s' (stl :α sptree$num_map) (cstl :α sptree$num_map) ⇒ strong_locals_rel f s stl cstl
strong_locals_rel_subset_domain_typed=strong_locals_rel (f :num -> num) (s :num -> bool) (l1 :α sptree$num_map) (l2 :α sptree$num_map) ∧ s ⊆ (domain l1 :num -> bool) ⇒ ∀(v :num). v ∈ s ⇒ f v ∈ (domain l2 :num -> bool)
union_apply_nummaps_key_typed=(domain (union (FST (apply_nummaps_key (f :num -> num) (p :α sptree$num_map # α sptree$num_map))) (SND (apply_nummaps_key f p))) :num -> bool) = (domain (apply_nummap_key f (union (FST p) (SND p))) :num -> bool)
wf_delete_swap_typed=wf (t :α sptree$num_map) ⇒ delete (a :num) (delete (c :num) t) = delete c (delete a t)
wf_get_live_exp_typed=∀(exp :α exp). wf (get_live_exp exp)
wf_insert_swap_typed=wf (t :sptree$num_set) ⇒ insert (a :num) () (insert (c :num) () t) = insert c () (insert a () t)
wf_numset_list_delete_eq_typed=∀(ls :num list) (t :α sptree$num_map) (live :β). wf t ⇒ FOLDR (delete :num -> α sptree$num_map -> α sptree$num_map) t ls = numset_list_delete ls t
with_same_locals_typed=(st :(α, β, γ) state) with locals := st.locals = st
with_same_store_typed=(st :(α, β, γ) state) with store := st.store = st
word_alloc_full_inst_ok_less_lem_typed=∀(f :num -> num) (prog :α prog) (c :α asm_config). full_inst_ok_less c prog ∧ EVERY (λ((x :num),(y :num)). f x ≠ f y) (get_forced c prog ([] :(num # num) list)) ⇒ full_inst_ok_less c (apply_colour f prog)
