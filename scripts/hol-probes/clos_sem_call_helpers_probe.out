find_code_typed=!(p :'c) (args :'a list) (code :'c |-> num # 'b). find_code p args code = case FLOOKUP code p of (NONE :(num # 'b) option) => (NONE :('a list # 'b) option) | SOME (arity,exp) => if LENGTH args = arity then SOME (args,exp) else (NONE :('a list # 'b) option)
check_loc_typed=(!(max_app :num) (loc :'a option) (num_params :num) (num_args :num) (so_far :num). check_loc max_app (NONE :'a option) loc num_params num_args so_far <=> num_args <= max_app) /\ !(max_app :num) (p :'a) (loc :'a option) (num_params :num) (num_args :num) (so_far :num). check_loc max_app (SOME p) loc num_params num_args so_far <=> num_params = num_args /\ so_far = (0 :num) /\ SOME p = loc
partial_type=:v -> app_kind
full_type=:closLang$exp -> v list -> v list -> app_kind
dest_closure_typed=!(max_app :num) (loc_opt :num option) (f :v) (args :v list). dest_closure max_app loc_opt f args = case f of Number v17 => (NONE :app_kind option) | (Word64 v18 :v) => (NONE :app_kind option) | Block v19 v20 => (NONE :app_kind option) | ByteVector v21 => (NONE :app_kind option) | RefPtr v22 v23 => (NONE :app_kind option) | (Closure loc arg_env clo_env num_args exp :v) => if check_loc max_app loc_opt loc num_args (LENGTH args) (LENGTH arg_env) /\ LENGTH arg_env < num_args then if ((~(LENGTH args + LENGTH arg_env < num_args)) :bool) then SOME (Full_app exp (REVERSE (TAKE (num_args - LENGTH arg_env) (REVERSE args)) ++ arg_env ++ clo_env) (REVERSE (DROP (num_args - LENGTH arg_env) (REVERSE args)))) else SOME (Partial_app (Closure loc (args ++ arg_env) clo_env num_args exp :v)) else (NONE :app_kind option) | (Recclosure loc' arg_env' clo_env' fns i :v) => (let ((num_args :num),(exp :closLang$exp)) = fEL fns i in if LENGTH fns <= i \/ ((~check_loc max_app loc_opt (OPTION_MAP ($+ ((2 :num) * i)) loc') num_args (LENGTH args) (LENGTH arg_env')) :bool) \/ ((~(LENGTH arg_env' < num_args)) :bool) then (NONE :app_kind option) else (let (rs :v list) = GENLIST (Recclosure loc' ([] :v list) clo_env' fns :num -> v) (LENGTH fns) in if ((~(LENGTH args + LENGTH arg_env' < num_args)) :bool) then SOME (Full_app exp (REVERSE (TAKE (num_args - LENGTH arg_env') (REVERSE args)) ++ arg_env' ++ rs ++ clo_env') (REVERSE (DROP (num_args - LENGTH arg_env') (REVERSE args)))) else SOME (Partial_app (Recclosure loc' (args ++ arg_env') clo_env' fns i :v))))
lookup_vars_typed=(!(env :'a list). lookup_vars ([] :num list) env = SOME ([] :'a list)) /\ !(v :num) (vs :num list) (env :'a list). lookup_vars (v::vs) env = if v < LENGTH env then case lookup_vars vs env of (NONE :'a list option) => (NONE :'a list option) | SOME xs => SOME (fEL env v::xs) else (NONE :'a list option)
clos_env_typed=!(restrict :bool) (names :num list) (env :'a list). clos_env restrict names env = if restrict then lookup_vars names env else SOME env
build_recc_typed=!(restrict :bool) (loc :num option) (env :v list) (names :num list) (fns :(num # closLang$exp) list). build_recc restrict loc env names fns = case clos_env restrict names env of (NONE :v list option) => (NONE :v list option) | SOME env1 => SOME (GENLIST (Recclosure loc ([] :v list) env1 fns :num -> v) (LENGTH fns))
dest_closure_length_typed=!(max_app :num) (loc_opt :num option) (f :v) (args :v list) (exp :closLang$exp) (args1 :v list) (args2 :v list) (so_far :'a). dest_closure max_app loc_opt f args = SOME (Full_app exp args1 args2) ==> LENGTH args2 < LENGTH args
