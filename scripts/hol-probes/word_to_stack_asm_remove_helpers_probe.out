arh_call_dest_stack_asm_remove=⊢ FST k + 1 < c.reg_count − LENGTH c.avoid_regs ∧ call_dest d a k = (q0,d') ⇒ stack_asm_remove c q0 ∧ case d' of INL l => T | INR r => r ≤ FST k + 1
arh_wLive_stack_asm_remove=⊢ FST kf + 1 < c.reg_count − LENGTH c.avoid_regs ∧ wLive q bs kf = (q1,bs') ⇒ stack_asm_remove c q1
arh_stack_move_stack_asm_remove=⊢ ∀n start offset i p. reg_name i c ⇒ (stack_asm_remove c (stack_move n start offset i p) ⇔ stack_asm_remove c p)
arh_copy_ret_aux_stack_asm_remove=⊢ ∀k f n. reg_name k c ⇒ stack_asm_remove c (copy_ret_aux k f n)
arh_copy_ret_stack_asm_remove=⊢ reg_name (FST kf) c ⇒ (stack_asm_remove c (copy_ret F b kf vs kont) ⇔ stack_asm_remove c kont)
