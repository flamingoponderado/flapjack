reset_env_generation_orac_eqs_typed=(is_record (ci :α compiler_instance) (reset_env_generation (es2 :eval_state option) (es3 :eval_state option)) ⇔ is_record ci es3) ∧ (record_forward (es1 :eval_state option) (reset_env_generation es2 es3) ⇔ record_forward es1 es3) ∧ (orac_agrees (orac :num -> (num # num) # v # dec list) (reset_env_generation es2 es3) ⇔ orac_agrees orac es3) ∧ reset_env_generation (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es1) es2 = reset_env_generation es1 es2 ∧ reset_env_generation es1 (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es2) = insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac (reset_env_generation es1 es2) ∧ (orac_s (reset_env_generation es2 es3)).oracle = (orac_s es3).oracle
insert_declare_env_typed=declare_env (es1 :eval_state option) (env :v sem_env) = SOME ((x :v),(es2 :eval_state option)) ∧ is_record (ci :α compiler_instance) es1 ⇒ is_record ci es2 ∧ record_forward es1 es2 ∧ (orac_agrees (orac :num -> (num # num) # v # dec list) es2 ⇒ declare_env (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es1) env = SOME (x,insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es2)) ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es1).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es2).oracle)
insert_do_eval_typed=do_eval (vs :v list) (es :eval_state option) = SOME ((env :v sem_env),(decs :dec list),(es' :eval_state option)) ∧ is_record (ci :α compiler_instance) es ⇒ is_record ci es' ∧ record_forward es es' ∧ (orac_agrees (orac :num -> (num # num) # v # dec list) es' ∧ orac_extended_wf (mk_compiler_fun_from_ci ci) orac ⇒ do_eval vs (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es) = SOME (env,decs,insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es')) ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es').oracle)
v_to_list_concrete_typed=∀(x :v) (xs :v list). v_to_list x = SOME xs ⇒ (concrete_v x ⇔ EVERY concrete_v xs)
maybe_all_list_SOME_typed=∀(xs :α option list) (ys :α list). maybe_all_list xs = SOME ys ⇒ xs = MAP (SOME :α -> α option) ys
maybe_all_list_EVERY_typed=maybe_all_list (xs :α option list) = SOME (ys :α list) ⇒ EVERY (λ(x :α option). x ≠ (NONE :α option)) xs
