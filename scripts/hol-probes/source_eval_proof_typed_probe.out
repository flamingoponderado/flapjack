oracle_semantics_prog_typed=¬semantics_prog (s1 :α semanticPrimitives$state) (env :v sem_env) (decs :dec list) Fail ∧ semantics_prog (s1 with eval_state := put_oracle (ci :'cfg compiler_instance) (orac :num -> (num # num) # v # dec list)) env decs (outcome :behaviour) ∧ precond_eval_state orac ci s1 env decs ∧ s1.refs = ([] :v store_v list) ∧ nsAll (K concrete_v :(mlstring, mlstring) id -> v -> bool) env.v ⇒ semantics_prog s1 env decs outcome
evaluate_prog_with_clock_put_oracle_typed=precond_eval_state (orac :num -> (num # num) # v # dec list) (ci :α compiler_instance) (s1 :β semanticPrimitives$state) (env :v sem_env) (decs :dec list) ∧ evaluate_prog_with_clock s1 env (k :num) decs = ((ffi :β ffi_state),(res :(v sem_env, v) result)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ∧ s1.refs = ([] :v store_v list) ∧ nsAll (K concrete_v :(mlstring, mlstring) id -> v -> bool) env.v ∧ ¬semantics_prog s1 env decs Fail ⇒ ∃(res' :(v sem_env, v) result). evaluate_prog_with_clock (s1 with eval_state := put_oracle ci orac) env k decs = (ffi,res') ∧ result_rel (K (K T :v sem_env -> bool) :v sem_env -> v sem_env -> bool) (K (K T :v -> bool) :v -> v -> bool) res res'
get_oracle_props_typed=nsAll (K concrete_v :(mlstring, mlstring) id -> v -> bool) (env :v sem_env).v ∧ (s :α semanticPrimitives$state).refs = ([] :v store_v list) ∧ s.eval_state = SOME (mk_init_eval_state (ci :β compiler_instance)) ∧ ¬semantics_prog s env (decs :dec list) Fail ⇒ (∀(r :(num # num) # v # dec list). get_oracle ci s env decs (0 :num) = SOME r ⇒ FST (SND r) = ci.config_v ci.init_state) ∧ ∀(i :num) (r' :(num # num) # v # dec list). get_oracle ci s env decs (SUC i) = SOME r' ⇒ ∃(r :(num # num) # v # dec list) (x :v # word8 list # word64 list). get_oracle ci s env decs i = SOME r ∧ mk_compiler_fun_from_ci ci r = SOME x ∧ FST (SND r') = FST x
