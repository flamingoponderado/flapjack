record_forward_def_typed=∀(es :eval_state option) (es' :eval_state option). record_forward es es' ⇔ case es of (NONE :eval_state option) => (case es' of (NONE :eval_state option) => T | SOME (EvalDecs v4) => T | SOME (EvalOracle v5) => F) | SOME (EvalDecs v7) => (case es' of (NONE :eval_state option) => T | SOME (EvalDecs v4) => T | SOME (EvalOracle v5) => F) | SOME (EvalOracle s) => ∃(s' :eval_oracle_state). es' = SOME (EvalOracle s') ∧ FST (FST (s.oracle (0 :num) :(num # num) # v # dec list)) ≤ FST (FST (s'.oracle (0 :num) :(num # num) # v # dec list)) ∧ ∀(j :num). (0 :num) < j ∧ j < FST (FST (s.oracle (0 :num) :(num # num) # v # dec list)) + (1 :num) ⇒ (s'.oracle j :(num # num) # v # dec list) = (s.oracle j :(num # num) # v # dec list)
