es_forward_refl_typed=es_forward (es :eval_oracle_state) es
es_forward_trans_typed=es_forward (es :eval_oracle_state) (es' :eval_oracle_state) ∧ es_forward es' (es'' :eval_oracle_state) ⇒ es_forward es es''
