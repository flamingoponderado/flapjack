do_eval_record_def_typed=∀(ci :α compiler_instance) (vs :v list) (orac :num -> (num # num) # v # dec list). do_eval_record ci vs orac = case vs of ([] :v list) => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v; st_v2] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v; st_v2; bs_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v; st_v2; bs_v; ws_v] => (let (((i :num),(_0' :num)),(st :v),(_1 :dec list)) = orac (0 :num) in case (v_to_env_id env_id_v,v_fun_abs ci.decs_dom ci.decs_v decs_v) of ((NONE :(num # num) option),v3) => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | (SOME env_id,(NONE :dec list option)) => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | (SOME env_id,SOME decs) => if compiler_agrees (mk_compiler_fun_from_ci ci) (env_id,st_v,decs) (st_v2,bs_v,ws_v) ∧ st_v = st then (let (orac' :num -> (num # num) # v # dec list) (j :num) = if j = (0 :num) then ((i + (1 :num),(0 :num)),st_v2,([] :dec list)) else if j = SUC i then (env_id,st,decs) else orac j in SOME (env_id,orac',decs)) else (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option)) | env_id_v::st_v::decs_v::st_v2::bs_v::ws_v::v28::v29 => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option)
