v_rel_typed=∀(es :eval_oracle_state). (∀(env :v sem_env) (id :num # num) (v :v) (env' :v sem_env). v_to_env_id v = SOME id ∧ lookup_env es id = SOME env' ∧ env_rel (v_rel es) env env' ⇒ v_rel es (Env env id) v) ∧ (∀(xs :v list) (ys :v list). LIST_REL (v_rel es) xs ys ⇒ v_rel es (Vectorv xs) (Vectorv ys)) ∧ (∀(stmp :stamp option) (xs :v list) (ys :v list). LIST_REL (v_rel es) xs ys ⇒ v_rel es (Conv stmp xs) (Conv stmp ys)) ∧ (∀(env :v sem_env) (env' :v sem_env) (nm :mlstring) (x :exp). env_rel (v_rel es) env env' ⇒ v_rel es (Closure env nm x) (Closure env' nm x)) ∧ (∀(env :v sem_env) (env' :v sem_env) (funs :(mlstring # mlstring # exp) list) (nm :mlstring). env_rel (v_rel es) env env' ⇒ v_rel es (Recclosure env funs nm) (Recclosure env' funs nm)) ∧ (∀(l :lit). v_rel es (Litv l) (Litv l)) ∧ ∀(br :bool) (n :num). v_rel es (Loc br n) (Loc br n)
