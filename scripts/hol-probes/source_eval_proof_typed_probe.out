env_rel_def_typed=∀(v_rel :v -> α -> bool) (env :v sem_env) (env' :α sem_env). env_rel v_rel env env' ⇔ env.c = env'.c ∧ nsDom env.v = nsDom env'.v ∧ nsDomMod env.v = nsDomMod env'.v ∧ ∀(nm :(mlstring, mlstring) id) (x :v) (y :α). nsLookup env.v nm = SOME x ∧ nsLookup env'.v nm = SOME y ⇒ v_rel x y
