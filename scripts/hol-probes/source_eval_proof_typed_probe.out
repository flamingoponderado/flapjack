num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac) env decs = (s' with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac,res)
