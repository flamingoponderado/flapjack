check_dup_ctors_thm_typed=check_dup_ctors ((tvs :mlstring list),(tn :mlstring),(condefs :(mlstring # ast_t list) list)) ⇔ ALL_DISTINCT (MAP (FST :mlstring # ast_t list -> mlstring) condefs)
eval_simulation_typed=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result) (es :α) (t :'ffi semanticPrimitives$state) (env' :v sem_env). evaluate s env exps = (s',res) ∧ s_rel (ci :'cfg compiler_instance) s t ∧ env_rel (v_rel (orac_s t.eval_state)) env env' ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(es' :eval_oracle_state) (t' :'ffi semanticPrimitives$state) (res' :(v list, v) result). evaluate t env' exps = (t',res') ∧ s_rel ci s' t' ∧ es' = orac_s t'.eval_state ∧ result_rel (LIST_REL (v_rel es')) (v_rel es') res res' ∧ es_forward (orac_s t.eval_state) es' ∧ (¬abort res' ⇒ es_stack_forward (orac_s t.eval_state) es')) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result) (es :eval_oracle_state) (t :'ffi semanticPrimitives$state) (env' :v sem_env) (y :v) (err_y :v). evaluate_match s env x pes err_x = (s',res) ∧ s_rel ci s t ∧ es = orac_s t.eval_state ∧ env_rel (v_rel es) env env' ∧ v_rel es x y ∧ v_rel es err_x err_y ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(es' :eval_oracle_state) (t' :'ffi semanticPrimitives$state) (res' :(v list, v) result). evaluate_match t env' y pes err_y = (t',res') ∧ s_rel ci s' t' ∧ es' = orac_s t'.eval_state ∧ result_rel (LIST_REL (v_rel es')) (v_rel es') res res' ∧ es_forward es es' ∧ (¬abort res' ⇒ es_stack_forward es es')) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (decs :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result) (t :'ffi semanticPrimitives$state) (env' :v sem_env). evaluate_decs s env decs = (s',res) ∧ s_rel ci s t ∧ env_rel (v_rel (orac_s t.eval_state)) env env' ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ ∃(es' :eval_oracle_state) (t' :'ffi semanticPrimitives$state) (res' :(v sem_env, v) result). evaluate_decs t env' decs = (t',res') ∧ s_rel ci s' t' ∧ es' = orac_s t'.eval_state ∧ result_rel (env_rel (v_rel es')) (v_rel es') res res' ∧ es_forward (orac_s t.eval_state) es' ∧ (¬abort res' ⇒ es_stack_forward (orac_s t.eval_state) es')
abort_def_typed=∀(r :(α, β) result). abort r ⇔ case r of (Rval v2 :(α, β) result) => F | (Rerr (Rraise v6) :(α, β) result) => F | (Rerr (Rabort a :β error_result) :(α, β) result) => T
abort_simps_typed=(abort (Rerr (Rabort (a :abort) :β error_result) :(α, β) result) ⇔ T) ∧ (abort (Rerr (Rraise (e :δ)) :(γ, δ) result) ⇔ F) ∧ (abort (Rval (v :ε) :(ε, ζ) result) ⇔ F)
do_eval_sim_typed=do_eval (REVERSE (xs :v list)) (s :α semanticPrimitives$state).eval_state = SOME ((env :v sem_env),(decs :dec list),(es :eval_state option)) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ LIST_REL (v_rel (orac_s t.eval_state)) xs (ys :v list) ⇒ ∃(env' :v sem_env) (es' :eval_state option). es_forward (orac_s t.eval_state) (orac_s es') ∧ do_eval (REVERSE ys) t.eval_state = SOME (env',decs,es') ∧ env_rel (v_rel (orac_s es')) env env' ∧ s_rel ci (s with eval_state := es) (t with eval_state := es') ∧ ∀(s2 :α semanticPrimitives$state) (t2 :α semanticPrimitives$state). s_rel ci s2 t2 ∧ es_forward (orac_s es') (orac_s t2.eval_state) ∧ es_stack_forward (orac_s es') (orac_s t2.eval_state) ⇒ es_forward (orac_s t2.eval_state) (orac_s (reset_env_generation t.eval_state t2.eval_state)) ∧ s_rel ci (s2 with eval_state := reset_env_generation s.eval_state s2.eval_state) (t2 with eval_state := reset_env_generation t.eval_state t2.eval_state) ∧ es_stack_forward (orac_s t.eval_state) (orac_s (reset_env_generation t.eval_state t2.eval_state))
do_app_sim_typed=do_app ((s :α semanticPrimitives$state).refs,s.ffi) (op :op) (REVERSE (xs :v list)) = SOME (((refs :v store_v list),(ffi :α ffi_state)),(r :(v, v) result)) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ LIST_REL (v_rel (orac_s t.eval_state)) xs (ys :v list) ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v, v) result) ⇒ ∃(ref1 :β) (refs' :v store_v list) (r' :(v, v) result) (es :eval_oracle_state). es = orac_s t.eval_state ∧ do_app (t.refs,t.ffi) op (REVERSE ys) = SOME ((refs',ffi),r') ∧ LIST_REL (sv_rel (v_rel es)) refs refs' ∧ result_rel (v_rel es) (v_rel es) r r'
declare_env_sim_typed=declare_env (s :α semanticPrimitives$state).eval_state (env :v sem_env) = SOME ((v :v),(es :eval_state option)) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ env_rel (v_rel (orac_s t.eval_state)) env (env' :v sem_env) ⇒ ∃(v' :v) (es2 :eval_state option). es_forward (orac_s t.eval_state) (orac_s es2) ∧ declare_env t.eval_state env' = SOME (v',es2) ∧ v_rel (orac_s es2) v v' ∧ s_rel ci (s with eval_state := es) (t with eval_state := es2) ∧ es_stack_forward (orac_s t.eval_state) (orac_s es2)
env_rel_nsLift_typed=env_rel (R :v -> α -> bool) ((env :β sem_env) with <|v := (v :(mlstring, mlstring, v) namespace); c := (c :(mlstring, mlstring, num # stamp) namespace)|>) ((env' :γ sem_env) with <|v := (v' :(mlstring, mlstring, α) namespace); c := (c' :(mlstring, mlstring, num # stamp) namespace)|>) ⇒ env_rel R (env with <|v := nsLift (mn :mlstring) v; c := nsLift mn c|>) (env' with <|v := nsLift mn v'; c := nsLift mn c'|>)
env_rel_nsAppend_typed=env_rel (R :v -> α -> bool) ((env :β sem_env) with v := (a :(mlstring, mlstring, v) namespace)) ((env' :γ sem_env) with v := (c :(mlstring, mlstring, α) namespace)) ∧ env_rel R (env with v := (b :(mlstring, mlstring, v) namespace)) (env' with v := (d :(mlstring, mlstring, α) namespace)) ⇒ env_rel R (env with v := nsAppend a b) (env' with v := nsAppend c d)
env_rel_extend_dec_env_typed=env_rel (R :v -> v -> bool) (env1 :v sem_env) (env2 :v sem_env) ∧ env_rel R (env3 :v sem_env) (env4 :v sem_env) ⇒ env_rel R ((env1 +++ env3) :v sem_env) ((env2 +++ env4) :v sem_env)
env_rel_add_nsBind_typed=env_rel (R :v -> α -> bool) ((env :β sem_env) with v := (ev :(mlstring, mlstring, v) namespace)) ((env' :γ sem_env) with v := (ev' :(mlstring, mlstring, α) namespace)) ∧ R (x :v) (y :α) ⇒ env_rel R (env with v := nsBind (n :mlstring) x ev) (env' with v := nsBind n y ev')
env_rel_add_nsBindList_typed=∀(xs :(mlstring # v) list) (ys :(mlstring # α) list). env_rel (R :v -> α -> bool) ((env :β sem_env) with v := (ev :(mlstring, mlstring, v) namespace)) ((env' :γ sem_env) with v := (ev' :(mlstring, mlstring, α) namespace)) ∧ LIST_REL (($= :mlstring -> mlstring -> bool) ### R) xs ys ⇒ env_rel R (env with v := nsBindList xs ev) (env' with v := nsBindList ys ev')
env_rel_nsLookup_v_typed=env_rel (R :v -> α -> bool) (env :v sem_env) (env' :α sem_env) ∧ nsLookup env.v (id :(mlstring, mlstring) id) = SOME (v :v) ⇒ ∃(v' :α). nsLookup env'.v id = SOME v' ∧ R v v'
pairarg_to_pair_map_typed=(λ((x :α),(y :β)). ((f :α -> γ) x,(g :β -> δ) y)) = f ## g
s_rel_clock_typed=s_rel (ci :'cfg compiler_instance) (s :α semanticPrimitives$state) (t :α semanticPrimitives$state) ⇒ s.clock = t.clock ∧ s_rel ci (dec_clock s) (dec_clock t)
concrete_v_rel_typed=∀(x :v) (y :v). v_rel (es :eval_oracle_state) x y ⇒ concrete_v x ⇒ y = x
v_rel_list_to_v_typed=∀(xs :v list) (ys :v list). v_rel (es :eval_oracle_state) (list_to_v xs) (list_to_v ys) ⇔ LIST_REL (v_rel es) xs ys
v_to_list_typed=∀(x :v) (y :v) (xs :v list). v_to_list x = SOME xs ∧ v_rel (es :eval_oracle_state) x y ⇒ ∃(ys :v list). v_to_list y = SOME ys ∧ LIST_REL (v_rel es) xs ys
v_to_char_list_typed=∀(x :v) (y :v) (xs :string). v_to_char_list x = SOME xs ∧ v_rel (es :eval_oracle_state) x y ⇒ v_to_char_list y = SOME xs
vs_to_string_typed=∀(xs :v list) (ys :v list) (s :mlstring). vs_to_string xs = SOME s ∧ LIST_REL (v_rel (es :eval_oracle_state)) xs ys ⇒ vs_to_string ys = SOME s
store_assign_typed=store_assign (lnum :num) (sv :α store_v) (refs :α store_v list) = SOME (refs2 :α store_v list) ∧ LIST_REL (sv_rel (R :α -> β -> bool)) refs (refs3 :β store_v list) ∧ sv_rel R sv (sv' :β store_v) ⇒ ∃(refs4 :β store_v list). LIST_REL (sv_rel R) refs2 refs4 ∧ store_assign lnum sv' refs3 = SOME refs4
store_lookup_typed=LIST_REL (sv_rel (R :α -> β -> bool)) (refs :α store_v list) (refs' :β store_v list) ∧ store_lookup (n :num) refs = SOME (sv :α store_v) ⇒ ∃(sv' :β store_v). sv_rel R sv sv' ∧ store_lookup n refs' = SOME sv'
Num_11_typed=(0 :int) ≤ (i :int) ∧ (0 :int) ≤ (j :int) ⇒ (Num i = Num j ⇔ i = j)
do_eq_typed=(∀(x :v) (y :v) (x' :v) (y' :v) (b :bool). do_eq x y = Eq_val b ∧ v_rel (es :eval_oracle_state) x x' ∧ v_rel es y y' ⇒ do_eq x' y' = Eq_val b) ∧ ∀(xs :v list) (ys :v list) (xs' :v list) (ys' :v list) (b :bool). do_eq_list xs ys = Eq_val b ∧ LIST_REL (v_rel es) xs xs' ∧ LIST_REL (v_rel es) ys ys' ⇒ do_eq_list xs' ys' = Eq_val b
can_pmatch_all_typed=can_pmatch_all (env :v sem_env).c (s :α semanticPrimitives$state).refs (pats :pat list) (x :v) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ env_rel (v_rel (orac_s t.eval_state)) env (env' :v sem_env) ∧ v_rel (orac_s t.eval_state) x (y :v) ⇒ can_pmatch_all env'.c t.refs pats y
pmatch_typed=s_rel (ci :'cfg compiler_instance) (s :α semanticPrimitives$state) (t :α semanticPrimitives$state) ∧ (es :eval_oracle_state) = orac_s t.eval_state ∧ env_rel (v_rel es) (env :v sem_env) (env' :v sem_env) ⇒ (∀(env_c :(mlstring, mlstring, num # stamp) namespace) (s_refs :v store_v list) (p :pat) (x :v) (binds :(mlstring # v) list) (y :v) (binds' :(mlstring # v) list). s_refs = s.refs ∧ env_c = env.c ∧ v_rel es x y ∧ LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es) binds binds' ⇒ match_result_rel T (LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es)) (pmatch env_c s_refs p x binds) (pmatch env'.c t.refs p y binds')) ∧ ∀(env_c :(mlstring, mlstring, num # stamp) namespace) (s_refs :v store_v list) (ps :pat list) (xs :v list) (binds :(mlstring # v) list) (ys :v list) (binds' :(mlstring # v) list). s_refs = s.refs ∧ env_c = env.c ∧ LIST_REL (v_rel es) xs ys ∧ LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es) binds binds' ⇒ match_result_rel T (LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es)) (pmatch_list env_c s_refs ps xs binds) (pmatch_list env'.c t.refs ps ys binds')
es_stack_forward_def_typed=∀(es :eval_oracle_state) (es' :eval_oracle_state). es_stack_forward es es' ⇔ es'.generation = es.generation ∧ ∀(j :num). j < es.generation ⇒ es'.envs❲j❳ = es.envs❲j❳
es_stack_forward_refl_typed=es_stack_forward (es :eval_oracle_state) es
