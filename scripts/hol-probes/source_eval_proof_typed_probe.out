forward_rules_typed=(v_rel (es :eval_oracle_state) (x :v) (y :v) ∧ es_forward es (es' :eval_oracle_state) ⇒ v_rel es' x y) ∧ (LIST_REL (v_rel es) (xs :v list) (ys :v list) ∧ es_forward es es' ⇒ LIST_REL (v_rel es') xs ys) ∧ (env_rel (v_rel es) (env :v sem_env) (env' :v sem_env) ∧ es_forward es es' ⇒ env_rel (v_rel es') env env') ∧ ∀(xs :v store_v list) (ys :v store_v list). LIST_REL (sv_rel (v_rel es)) xs ys ∧ es_forward es es' ⇒ LIST_REL (sv_rel (v_rel es')) xs ys
s_rel_def_typed=∀(ci :α compiler_instance) (s :β semanticPrimitives$state) (s' :β semanticPrimitives$state). s_rel ci s s' ⇔ ∃(dec_s :eval_decs_state) (orac_s :eval_oracle_state) (refs' :v store_v list). s' = s with <|refs := refs'; eval_state := SOME (EvalOracle orac_s)|> ∧ LIST_REL (sv_rel (v_rel orac_s)) s.refs refs' ∧ s.eval_state = SOME (EvalDecs dec_s) ∧ orac_s.custom_do_eval = do_eval_record ci ∧ dec_s.compiler_state = FST (SND (orac_s.oracle (0 :num) :(num # num) # v # dec list)) ∧ dec_s.decode_decs = v_fun_abs ci.decs_dom ci.decs_v ∧ dec_s.compiler = mk_compiler_fun_from_ci ci ∧ ((0 :num) = FST (FST (orac_s.oracle (0 :num) :(num # num) # v # dec list)) ⇒ dec_s.compiler_state = ci.config_v ci.init_state) ∧ ((0 :num) < FST (FST (orac_s.oracle (0 :num) :(num # num) # v # dec list)) ⇒ FST (SND (orac_s.oracle (1 :num) :(num # num) # v # dec list)) = ci.config_v ci.init_state) ∧ dec_s.env_id_counter = (orac_s.generation,LENGTH orac_s.envs❲orac_s.generation❳,LENGTH orac_s.envs) ∧ orac_s.generation < LENGTH orac_s.envs ∧ recorded_orac_wf (mk_compiler_fun_from_ci ci) orac_s.oracle
