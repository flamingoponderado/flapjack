adjust_oracle_evaluate_typed=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs s env ((compile_decs :dec list -> dec list) ds) = (s',res)) ⇒ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate s env exps = (s',res) ∧ is_insert_oracle (ci :α compiler_instance) (f :dec list -> dec list) s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env exps = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate_match s env x pes err_x = (s',res) ∧ is_insert_oracle ci f s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate_match (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env x pes err_x = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ is_insert_oracle ci f s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate_decs (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env ds = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)
result_rel_IMP_cases_typed=result_rel (r_rel :α -> β -> bool) (e_rel :γ -> δ -> bool) (r :(α, γ) result) (r' :(β, δ) result) ⇒ (∃(x :α). r = (Rval x :(α, γ) result)) ∨ (∃(y :γ). r = (Rerr (Rraise y) :(α, γ) result)) ∨ ∃(a :abort). r = (Rerr (Rabort a :γ error_result) :(α, γ) result)
adjust_oracle_semantics_prog_typed=∀(compile :dec list -> dec list) (f :dec list -> dec list). (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs s env (compile ds) = (s',res)) ⇒ is_insert_oracle (ci :α compiler_instance) f (s :'ffi semanticPrimitives$state).eval_state ∧ ¬semantics_prog s (env :v sem_env) (prog :dec list) Fail ∧ semantics_prog s env prog (outcome :behaviour) ⇒ semantics_prog (s with eval_state updated_by adjust_oracle ci (compile ∘ f)) env prog outcome
recorded_orac_wf_def_typed=∀(compiler :(num # num) # v # dec list -> (v # α) option) (orac :num -> (num # num) # v # dec list). recorded_orac_wf compiler orac ⇔ ((0 :num) < FST (FST (orac (0 :num))) ⇒ ∃(r :v # α). compiler (orac (FST (FST (orac (0 :num))))) = SOME r ∧ FST (SND (orac (0 :num))) = FST r) ∧ ∀(j :num). j < FST (FST (orac (0 :num))) ∧ (0 :num) < j ⇒ ∃(r :v # α). compiler (orac j) = SOME r ∧ FST (SND (orac (j + (1 :num)))) = FST r
orac_s_def_typed=orac_s (SOME (EvalOracle (es :eval_oracle_state))) = es ∧ orac_s (NONE :eval_state option) = (ARB "not EvalOracle" :eval_oracle_state) ∧ orac_s (SOME (EvalDecs (v2 :eval_decs_state))) = (ARB "not EvalOracle" :eval_oracle_state)
extract_oracle_def_typed=∀(s :α semanticPrimitives$state) (env :v sem_env) (decs :dec list) (n :num). extract_oracle s env decs n = case OLEAST(k :num). ∃(s' :α semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs (s with clock := k) env decs = (s',res) ∧ n < FST (FST ((orac_s s'.eval_state).oracle (0 :num) :(num # num) # v # dec list)) of (NONE :num option) => (NONE :((num # num) # v # dec list) option) | SOME k => (let ((s' :α semanticPrimitives$state),(_0 :(v sem_env, v) result)) = evaluate_decs (s with clock := k) env decs in SOME ((orac_s s'.eval_state).oracle (n + (1 :num)) :(num # num) # v # dec list))
get_oracle_def_typed=∀(ci :α compiler_instance) (s :β semanticPrimitives$state) (env :v sem_env) (decs :dec list). get_oracle ci s env decs = (let (es_record :eval_state) = EvalOracle <|oracle := (K (((0 :num),(0 :num)),ci.config_v ci.init_state,([] :dec list)) :num -> (num # num) # v # dec list); custom_do_eval := do_eval_record ci; envs := [([] :v sem_env list)]; generation := (0 :num)|> in extract_oracle (s with eval_state := SOME es_record) env decs)
put_oracle_def_typed=∀(ci :α compiler_instance) (orac :num -> (num # num) # v # dec list). put_oracle ci orac = insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac (SOME (EvalOracle <|oracle := (K (((0 :num),(0 :num)),ci.config_v ci.init_state,([] :dec list)) :num -> (num # num) # v # dec list); custom_do_eval := do_eval_record ci; envs := [([] :v sem_env list)]; generation := (0 :num)|>))
