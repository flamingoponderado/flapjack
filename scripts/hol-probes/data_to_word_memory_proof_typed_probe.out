gc_combined_thm_typed=abs_ml_inv (conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ ((do_partial :bool) ⇒ has_gen gens) ⇒ ∃(roots2 :α word_loc heap_address list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list) (gens2 :gen_state) (n2 :num) (a2 :num). gc_combined (make_gc_conf limit :(tag # α word_loc list) gen_gc_conf) conf.gc_kind (roots,heap,gens,a + sp + sp1,do_partial) = (roots2,heap2,a2,n2,gens2,T) ∧ abs_ml_inv conf stack refs (roots2,heap2,be,a2,n2,(0 :num),gens2) limit ts ∧ (conf.gc_kind ≠ None ∧ (conf.gc_kind ≠ Simple ⇒ ¬do_partial) ⇒ all_reachable_from_roots roots2 heap2 ∧ heap_length heap2 = data_length heap2 + n2)
has_gen_def_typed=∀(v0 :num) (xs :num list). has_gen (GenState v0 xs) ⇔ xs ≠ ([] :num list)
gen_gc_partial_thm_typed=abs_ml_inv (conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ has_gen gens ∧ conf.gc_kind = Generational (xs :num list) ⇒ ∃(roots2 :α word_loc heap_address list) (state2 :(α word_loc, tag # α word_loc list) gc_state). partial_gc (make_partial_conf (make_gc_conf limit :(tag # α word_loc list) gen_gc_conf) gens (a + (sp + sp1))) (roots,heap) = (roots2,state2) ∧ abs_ml_inv conf stack refs (roots2,state2.old ++ state2.h1 ++ (heap_expand state2.n :(α word_loc, tag # α word_loc list) heap_element list) ++ state2.r1,be,state2.a,state2.n,(0 :num),reset_gens conf state2.a) limit ts ∧ state2.ok
reset_gens_def_typed=∀(conf :data_to_word$config) (a :num). reset_gens conf a = case conf.gc_kind of None => GenState (0 :num) ([] :num list) | Simple => GenState (0 :num) ([] :num list) | Generational sizes => GenState (0 :num) (MAP (K a :num -> num) sizes)
gen_gc_thm_typed=abs_ml_inv (conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ⇒ ∃(roots2 :α word_loc heap_address list) (state2 :(α word_loc, tag # α word_loc list) gc_state). gen_gc (make_gc_conf limit :(tag # α word_loc list) gen_gc_conf) (roots,heap) = (roots2,state2) ∧ abs_ml_inv conf stack refs (roots2,state2.h1 ++ (heap_expand state2.n :(α word_loc, tag # α word_loc list) heap_element list) ++ state2.r1,be,state2.a,state2.n,(0 :num),reset_gens conf state2.a) limit ts ∧ state2.ok ∧ heap_length (state2.h1 ++ state2.r1) = heap_length (heap_filter (reachable_addresses roots heap) heap) ∧ EVERY (isDataElement :(α word_loc, tag # α word_loc list) heap_element -> bool) state2.h1 ∧ EVERY (isDataElement :(α word_loc, tag # α word_loc list) heap_element -> bool) state2.r1 ∧ all_reachable_from_roots roots2 (state2.h1 ++ (heap_expand state2.n :(α word_loc, tag # α word_loc list) heap_element list) ++ state2.r1)
full_gc_thm_typed=abs_ml_inv (conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) ((roots :α word_loc heap_address list),(heap :(α word_loc, tag # α word_loc list) heap_element list),(be :bool),(a :num),(sp :num),(sp1 :num),(gens :gen_state)) (limit :num) (ts :num) ∧ conf.gc_kind = Simple ⇒ ∃(roots2 :α word_loc heap_address list) (heap2 :(α word_loc, tag # α word_loc list) heap_element list) (a2 :num). full_gc (roots,heap,limit) = (roots2,heap2,a2,T) ∧ abs_ml_inv conf stack refs (roots2,heap2 ++ (heap_expand (limit − a2) :(α word_loc, tag # α word_loc list) heap_element list),be,a2,limit − a2,(0 :num),gens) limit ts ∧ heap_length heap2 = a2 ∧ heap_length (heap_filter (reachable_addresses roots heap) heap) = heap_length heap2 ∧ all_reachable_from_roots roots2 (heap2 ++ (heap_expand (limit − a2) :(α word_loc, tag # α word_loc list) heap_element list)) ∧ EVERY (isDataElement :(α word_loc, tag # α word_loc list) heap_element -> bool) heap2
make_gc_conf_def_typed=∀(limit :num). (make_gc_conf limit :(tag # α) gen_gc_conf) = <|limit := limit; isRef := isMutTag ∘ (FST :tag # α -> tag)|>
heap_lookup_expand_eq_SOME_typed=heap_lookup (a :num) ((heap :(α, β) heap_element list) ++ (heap_expand (n :num) :(α, β) heap_element list)) = SOME (DataElement (ys :α heap_address list) (l :num) (d :β)) ⇔ heap_lookup a heap = SOME (DataElement ys l d)
isSomeDataElement_heap_lookup_typed=∀(n :num) (a :(α, β) heap_element list) (sp :num) (b :(α, β) heap_element list). isSomeDataElement (heap_lookup n (a ++ [(Unused sp :(α, β) heap_element)] ++ b)) ⇒ n < heap_length a ∨ el_length (Unused sp :(γ, δ) heap_element) + heap_length a ≤ n
data_pointers_def_typed=data_pointers ([] :(α, β) heap_element list) = ([] :num list) ∧ (∀(z :β) (y :num) (x :α heap_address list) (rest :(α, β) heap_element list). data_pointers (DataElement x y z::rest) = (0 :num)::MAP (λ(n :num). n + el_length (DataElement x y z)) (data_pointers rest)) ∧ (∀(v2 :num) (rest :(α, β) heap_element list). data_pointers ((Unused v2 :(α, β) heap_element)::rest) = MAP (λ(n :num). n + el_length (Unused v2 :(α, β) heap_element)) (data_pointers rest)) ∧ ∀(v5 :num) (v4 :α) (v3 :num) (rest :(α, β) heap_element list). data_pointers ((ForwardPointer v3 v4 v5 :(α, β) heap_element)::rest) = MAP (λ(n :num). n + el_length (ForwardPointer v3 v4 v5 :(α, β) heap_element)) (data_pointers rest)
lookup_len_def_typed=∀(heap :(α, β) heap_element list) (p :num). lookup_len heap p = case heap_lookup p heap of (NONE :(α, β) heap_element option) => (0 :num) | SOME x => el_length x
data_length_def_typed=∀(heap :(α, β) heap_element list). data_length heap = (SUM (MAP (lookup_len heap) (data_pointers heap)) :num)
data_pointers_heap_expand_typed=data_pointers ((heap :(α, β) heap_element list) ++ (heap_expand (n :num) :(α, β) heap_element list)) = data_pointers heap
data_length_heap_expand_typed=data_length (heap_expand (n :num) :(α, β) heap_element list) = (0 :num)
data_length_CONS_typed=∀(x :(α, β) heap_element) (xs :(α, β) heap_element list). data_length (x::xs) = data_length [x] + data_length xs
data_length_APPEND_typed=∀(xs :(α, β) heap_element list) (ys :(α, β) heap_element list). data_length (xs ++ ys) = data_length xs + data_length ys
data_length_APPEND_heap_expand_typed=data_length ((heap :(α, β) heap_element list) ++ (heap_expand (n :num) :(α, β) heap_element list)) = data_length heap
data_length_heap_length_typed=EVERY (isDataElement :(α, β) heap_element -> bool) (heap :(α, β) heap_element list) ⇒ data_length heap = heap_length heap
all_reachable_from_roots_def_typed=∀(roots :α heap_address list) (heap :(β, γ) heap_element list). all_reachable_from_roots roots heap ⇔ ∀(p :num) (xs :β heap_address list) (l :num) (d :γ). heap_lookup p heap = SOME (DataElement xs l d) ⇒ p ∈ reachable_addresses roots heap
reachable_addresses_related_typed=(k :num) ∈ reachable_addresses (roots :α heap_address list) (heap :(β, γ) heap_element list) ∧ gc_related (f :num |-> num) heap (heap2 :(β, γ) heap_element list) ∧ reachable_addresses roots heap ⊆ FDOM f ⇒ f⟨k⟩ ∈ reachable_addresses (ADDR_MAP (FAPPLY f) roots) heap2
IMP_all_reachable_from_roots_typed=FDOM (f :num |-> num) = reachable_addresses (roots :α heap_address list) (heap :(β, γ) heap_element list) ∧ FRANGE f = {a | isSomeDataElement (heap_lookup a (heap2 :(β, γ) heap_element list))} ∧ gc_related f heap heap2 ⇒ all_reachable_from_roots (ADDR_MAP (FAPPLY f) roots) heap2
gc_related_APPEND_heap_expand_typed=gc_related (f :num |-> num) (heap :(α, β) heap_element list) ((heap2 :(α, β) heap_element list) ++ (heap_expand (n :num) :(α, β) heap_element list)) ⇔ gc_related f heap heap2
word_heap_heap_expand_typed=word_heap (a :α word) (heap_expand (n :num) :(β word_loc, tag # β word_loc list) heap_element list) (conf :data_to_word$config) = (word_list_exists a n :(α word # β word_loc -> bool) -> bool)
word_el_IMP_word_list_exists_typed=∀(temp :(α word_loc, tag # α word_loc list) heap_element) (p :(β word # α word_loc -> bool) -> bool) (curr :β word). (p * word_el curr temp (conf :data_to_word$config)) (s :β word # α word_loc -> bool) ⇒ (p * (word_list_exists curr (el_length temp) :(β word # α word_loc -> bool) -> bool)) s
word_heap_IMP_word_list_exists_typed=∀(temp :(α word_loc, tag # α word_loc list) heap_element list) (p :(β word # α word_loc -> bool) -> bool) (curr :β word). (p * word_heap curr temp (conf :data_to_word$config)) (s :β word # α word_loc -> bool) ⇒ (p * (word_list_exists curr (heap_length temp) :(β word # α word_loc -> bool) -> bool)) s
