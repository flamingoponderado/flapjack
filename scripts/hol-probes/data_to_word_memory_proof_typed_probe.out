memory_rel_tail_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((v :v # α word_loc)::(vars :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm vars
memory_rel_drop_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((vs :(v # α word_loc) list) ++ (vars :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm vars
memory_rel_swap_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) ((x :v # α word_loc)::(y :v # α word_loc)::(z :(v # α word_loc) list)) ⇒ memory_rel c be ts refs sp st m dm (y::x::z)
v_all_vs_ts_MEM_typed=∀(x :v) (y :v) (ts :num). MEM ts (v_all_ts x) ∧ MEM x (v_all_vs [y]) ⇒ MEM ts (v_all_ts y)
v_all_vs_ts_typed=∀(x :v) (ts :num) (tag :num) (xs :v list). MEM (Block ts tag xs :v) (v_all_vs [x]) ⇒ MEM ts (v_all_ts x)
v_all_vs_MEM2_typed=∀(l :v list) (ts :num) (tag :num) (xs :v list). MEM (Block ts tag xs :v) (v_all_vs l) ⇒ ∃(x :v). MEM x l ∧ MEM (Block ts tag xs :v) (v_all_vs [x])
v_all_vs_ts_list_typed=∀(x :v) (y :v list) (ts :num). MEM x (v_all_vs y) ∧ MEM ts (v_all_ts x) ⇒ MEM ts (FLAT (MAP v_all_ts y))
MEM_in_all_ts_typed=∀(x :v) (ts :num) (stack :v list) (refs :v ref sptree$num_map). x ∈ all_vs refs stack ∧ MEM ts (v_all_ts x) ⇒ ts ∈ all_ts refs stack
v_inv_tf_restrict_lemma_typed=∀(ck :num) (v1 :v) (refs :v ref sptree$num_map) (y :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list). v_inv (conf :data_to_word$config) v1 refs (y,f,tf,heap) ⇒ (∀(x :num). MEM x (v_all_ts v1) ⇒ x ∈ (P :num -> bool)) ∧ (∀(x :num). x ∈ all_ts refs (stack :v list) ⇒ x ∈ P) ⇒ v_inv_ck ck conf v1 refs (y,f,DRESTRICT tf P,heap)
v_inv_ByteArray_insert_typed=∀(conf :data_to_word$config) (v1 :v) (refs :v ref sptree$num_map) (v2 :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (ptr :num) (fl :bool) (xs :word8 list). v_inv conf v1 refs (v2,f,tf,heap) ∧ (ptr ∈ (domain refs :num -> bool) ⇒ ∃(a :bool) (b :word8 list). (lookup ptr refs :v ref option) = SOME (ByteArray a b :v ref)) ⇒ v_inv conf v1 (insert ptr (ByteArray fl xs :v ref) refs :v ref sptree$num_map) (v2,f,tf,heap)
v_inv_tf_restrict_typed=∀(conf :data_to_word$config) (v :v) (refs :v ref sptree$num_map) (stack :v list) (y :α word_loc heap_address) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (P :num -> bool). v_inv conf v refs (y,f,tf,heap) ∧ (∀(x :num). MEM x (v_all_ts v) ⇒ x ∈ P) ∧ (∀(x :num). x ∈ all_ts refs stack ⇒ x ∈ P) ⇒ v_inv conf v refs (y,f,DRESTRICT tf P,heap)
MEM_v_all_vs_typed=∀(l :v list) (v :v). MEM v l ⇒ MEM v (v_all_vs l)
MEM_stack_all_vs_typed=∀(v :v) (stack :v list) (refs :v ref sptree$num_map). MEM v stack ⇒ v ∈ all_vs refs stack
v_all_vs_append_typed=∀(x :v list) (y :v list). v_all_vs (x ++ y) = v_all_vs x ++ v_all_vs y
MEM_v_all_vs_FST_typed=∀(xs :(v # α) list) (h0 :v) (h1 :α) (x :v). MEM (h0,h1) xs ∧ MEM x (v_all_vs [h0]) ⇒ MEM x (v_all_vs (MAP (FST :v # α -> v) xs))
MEM_v_all_vs_SUBSET_typed=∀(ys :(v # α) list) (xs :(v # α) list) (x :v). set ys ⊆ set xs ∧ MEM x (v_all_vs (MAP (FST :v # α -> v) ys)) ⇒ MEM x (v_all_vs (MAP (FST :v # α -> v) xs))
blocks_unique_stack_permute_typed=set (ys :(v # α) list) ⊆ set (xs :(v # α) list) ∧ blocks_unique (ts :num) (all_vs (refs :v ref sptree$num_map) (MAP (FST :v # α -> v) xs ++ (stack :v list))) ⇒ blocks_unique ts (all_vs refs (MAP (FST :v # α -> v) ys ++ stack))
reachable_refs_stack_subset_typed=∀(x :v list) (y :v list) (refs :v ref sptree$num_map) (n :num). reachable_refs y refs n ∧ set y ⊆ set x ⇒ reachable_refs x refs n
memory_rel_less_space_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list) ∧ (sp' :num) ≤ sp ⇒ memory_rel c be ts refs sp' st m dm vars
memory_rel_space_max_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (old_sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list) ⇒ ∃(next_free :α word) (trig_gc :α word) (sp :num). FLOOKUP st NextFree = SOME (Word next_free) ∧ FLOOKUP st TriggerGC = SOME (Word trig_gc) ∧ trig_gc − next_free = (bytes_in_word :α word) * (n2w sp :α word) ∧ old_sp ≤ sp ∧ memory_rel c be ts refs sp st m dm vars ∧ (good_dimindex (:α) ⇒ dimindex (:α) DIV (8 :num) * sp < dimword (:α))
memory_rel_zero_space_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list) ⇒ memory_rel c be ts refs (0 :num) st m dm vars
memory_rel_Number_IMP_Word_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((Number (i :int) :v),(v :α word_loc))::(vars :(v # α word_loc) list)) ⇒ ∃(w :α word). v = Word w
memory_rel_Number_IMP_Word_2_typed=memory_rel (c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (sp :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (((Number (i :int) :v),(v :α word_loc))::((Number (j :int) :v),(w :α word_loc))::(vars :(v # α word_loc) list)) ⇒ ∃(w1 :α word) (w2 :α word). v = Word w1 ∧ w = Word w2
abs_ml_inv_def_typed=∀(conf :data_to_word$config) (stack :v list) (refs :v ref sptree$num_map) (roots :α word_loc heap_address list) (heap :(α word_loc, tag # α word_loc list) heap_element list) (be :bool) (a :num) (sp :num) (sp1 :num) (gens :gen_state) (limit :num) (ts :num). abs_ml_inv conf stack refs (roots,heap,be,a,sp,sp1,gens) limit ts ⇔ roots_ok roots heap ∧ heap_ok heap limit ∧ gc_kind_inv conf a sp sp1 gens heap ∧ unused_space_inv a (sp + sp1) heap ∧ bc_stack_ref_inv conf ts stack refs (roots,heap,be)
word_ml_inv_def_typed=∀(heap :(α word_loc, tag # α word_loc list) heap_element list) (be :bool) (a :num) (sp :num) (sp1 :num) (gens :gen_state) (limit :num) (ts :num) (c :data_to_word$config) (refs :v ref sptree$num_map) (stack :(v # α word_loc) list). word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c refs stack ⇔ ∃(hs :α word_loc heap_address list). abs_ml_inv c (MAP (FST :v # α word_loc -> v) stack) refs (hs,heap,be,a,sp,sp1,gens) limit ts ∧ LIST_REL (λ(v :α word_loc heap_address) (w :α word_loc). word_addr c v = w) hs (MAP (SND :v # α word_loc -> α word_loc) stack)
memory_rel_def_typed=∀(c :data_to_word$config) (be :bool) (ts :num) (refs :v ref sptree$num_map) (space :num) (st :store_name |-> α word_loc) (m :α word -> α word_loc) (dm :α word -> bool) (vars :(v # α word_loc) list). memory_rel c be ts refs space st m dm vars ⇔ ∃(heap :(α word_loc, tag # α word_loc list) heap_element list) (limit :num) (a :num) (sp :num) (sp1 :num) (gens :gen_state). heap_in_memory_store heap a sp sp1 gens c st m dm limit ∧ word_ml_inv (heap,be,a,sp,sp1,gens) limit ts c refs vars ∧ (limit + (3 :num)) * (dimindex (:α) DIV (8 :num)) + (1 :num) < dimword (:α) ∧ space ≤ sp
bc_stack_ref_inv_def_typed=∀(conf :data_to_word$config) (ts :num) (stack :v list) (refs :v ref sptree$num_map) (roots :α word_loc heap_address list) (heap :(α word_loc, tag # α word_loc list) heap_element list) (be :bool). bc_stack_ref_inv conf ts stack refs (roots,heap,be) ⇔ ∃(f :num |-> num) (tf :num |-> num). INJ (FAPPLY f) (FDOM f) {a | isSomeDataElement (heap_lookup a heap)} ∧ FDOM f ⊆ (domain refs :num -> bool) ∧ INJ (FAPPLY tf) (FDOM tf) {a | isSomeDataElement (heap_lookup a heap)} ∧ FDOM tf ⊆ all_ts refs stack ∧ FDOM tf ⊆ {n | n < ts} ∧ be_ok conf.be be ∧ blocks_unique ts (all_vs refs stack) ∧ LIST_REL (λ(v :v) (x :α word_loc heap_address). v_inv conf v refs (x,f,tf,heap)) stack roots ∧ ∀(n :num). reachable_refs stack refs n ∧ n ∈ FDOM f ⇒ bc_ref_inv conf n refs (f,tf,heap,be)
bc_ref_inv_def_typed=∀(conf :data_to_word$config) (n :num) (refs :v ref sptree$num_map) (f :num |-> num) (tf :num |-> num) (heap :(α word_loc, tag # α word_loc list) heap_element list) (be :bool). bc_ref_inv conf n refs (f,tf,heap,be) ⇔ case (FLOOKUP f n,(lookup n refs :v ref option)) of ((NONE :num option),v4) => F | (SOME x,(NONE :v ref option)) => F | (SOME x,SOME (ValueArray ys :v ref)) => ∃(zs :α word_loc heap_address list). heap_lookup x heap = SOME (RefBlock zs :(α word_loc, tag # α word_loc list) heap_element) ∧ LIST_REL (λ(z :α word_loc heap_address) (y :v). v_inv conf y refs (z,f,tf,heap)) zs ys | (SOME x,SOME (ByteArray flag bs :v ref)) => (let (ws :num) = LENGTH bs DIV (dimindex (:α) DIV (8 :num)) + (1 :num) in heap_lookup x heap = SOME (Bytes be flag bs (REPLICATE ws (0w :α word)))) | (SOME x,SOME (Thunk ev v :v ref)) => ∃(z :α word_loc heap_address). heap_lookup x heap = SOME (ThunkBlock ev z :(α word_loc, tag # α word_loc list) heap_element) ∧ (ev = Evaluated ⇒ (dest_thunk v refs :dest_thunk_ret) = NotThunk) ∧ v_inv conf v refs (z,f,tf,heap) | (SOME x,SOME (MutBlock tg fin l c r)) => (∀(gs :num list). conf.gc_kind ≠ Generational gs) ∧ (¬fin ⇒ x ∉ IMAGE (FAPPLY tf) (FDOM tf)) ∧ ∃(zs :α word_loc heap_address list). heap_lookup x heap = SOME (BlockRep tg zs :(α word_loc, tag # α word_loc list) heap_element) ∧ LIST_REL (λ(z :α word_loc heap_address) (y :v). v_inv conf y refs (z,f,tf,heap)) zs (l ++ [c] ++ r)
v_inv_RefPtr_T_typed=v_inv (conf :data_to_word$config) (RefPtr T (n :num) :v) (refs :v ref sptree$num_map) ((x :α word_loc heap_address),(f :num |-> num),(tf :num |-> num),(heap :(α word_loc, tag # α word_loc list) heap_element list)) ⇔ n ∈ FDOM f ∧ (∀(ev :thunk_mode) (v :v). (lookup n refs :v ref option) ≠ SOME (Thunk ev v :v ref)) ∧ (∀(tg :num) (fin :bool) (l :v list) (c :v) (r :v list). (lookup n refs :v ref option) ≠ SOME (MutBlock tg fin l c r)) ∧ x = Pointer f⟨n⟩ (Word (0w :α word))
