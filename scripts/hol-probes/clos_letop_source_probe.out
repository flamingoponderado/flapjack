var_list_typed=(∀(n :num). var_list n ([] :exp list) ([] :α list) ⇔ T) ∧ (∀(ys :α list) (y :α) (xs :exp list) (t :tra) (n :num) (m :num). var_list n ((Var t m :exp)::xs) (y::ys) ⇔ m = n ∧ var_list (n + (1 :num)) xs ys) ∧ (∀(v11 :α list) (v10 :α) (v0 :num). var_list v0 ([] :exp list) (v10::v11) ⇔ F) ∧ (∀(v7 :exp list) (v15 :num) (v14 :tra) (v0 :num). var_list v0 ((Var v14 v15 :exp)::v7) ([] :α list) ⇔ F) ∧ (∀(v7 :exp list) (v2 :α list) (v19 :exp) (v18 :exp) (v17 :exp) (v16 :tra) (v0 :num). var_list v0 ((If v16 v17 v18 v19 :exp)::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v22 :exp) (v21 :exp list) (v20 :tra) (v2 :α list) (v0 :num). var_list v0 (Let v20 v21 v22::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v24 :exp) (v23 :tra) (v2 :α list) (v0 :num). var_list v0 ((Raise v23 v24 :exp)::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v27 :exp) (v26 :exp) (v25 :tra) (v2 :α list) (v0 :num). var_list v0 ((Handle v25 v26 v27 :exp)::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v29 :exp) (v28 :tra) (v2 :α list) (v0 :num). var_list v0 (Tick v28 v29::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v33 :exp list) (v32 :num) (v31 :num) (v30 :tra) (v2 :α list) (v0 :num). var_list v0 (Call v30 v31 v32 v33::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v37 :exp list) (v36 :exp) (v35 :num option) (v34 :tra) (v2 :α list) (v0 :num). var_list v0 ((App v34 v35 v36 v37 :exp)::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v42 :exp) (v41 :num) (v40 :num list option) (v39 :num option) (v38 :mlstring) (v2 :α list) (v0 :num). var_list v0 (Fn v38 v39 v40 v41 v42::v7) v2 ⇔ F) ∧ (∀(v7 :exp list) (v47 :exp) (v46 :(num # exp) list) (v45 :num list option) (v44 :num option) (v43 :mlstring list) (v2 :α list) (v0 :num). var_list v0 ((Letrec v43 v44 v45 v46 v47 :exp)::v7) v2 ⇔ F) ∧ ∀(v7 :exp list) (v50 :exp list) (v49 :op) (v48 :tra) (v2 :α list) (v0 :num). var_list v0 (Op v48 v49 v50::v7) v2 ⇔ F
dest_op_typed=dest_op (Op (t :tra) (op :op) (xs :exp list)) (args :α list) = (if var_list (0 :num) xs args then SOME op else (NONE :op option)) ∧ dest_op (Var (v3 :tra) (v4 :num) :exp) (v1 :α list) = (NONE :op option) ∧ dest_op (If (v5 :tra) (v6 :exp) (v7 :exp) (v8 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Let (v9 :tra) (v10 :exp list) (v11 :exp)) v1 = (NONE :op option) ∧ dest_op (Raise (v12 :tra) (v13 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Handle (v14 :tra) (v15 :exp) (v16 :exp) :exp) v1 = (NONE :op option) ∧ dest_op (Tick (v17 :tra) (v18 :exp)) v1 = (NONE :op option) ∧ dest_op (Call (v19 :tra) (v20 :num) (v21 :num) (v22 :exp list)) v1 = (NONE :op option) ∧ dest_op (App (v23 :tra) (v24 :num option) (v25 :exp) (v26 :exp list) :exp) v1 = (NONE :op option) ∧ dest_op (Fn (v27 :mlstring) (v28 :num option) (v29 :num list option) (v30 :num) (v31 :exp)) v1 = (NONE :op option) ∧ dest_op (Letrec (v32 :mlstring list) (v33 :num option) (v34 :num list option) (v35 :(num # exp) list) (v36 :exp) :exp) v1 = (NONE :op option)
let_op_sing_typed=(∀(v :num) (t :tra). let_op_sing (Var t v :exp) = (Var t v :exp)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (t :tra). let_op_sing (If t x1 x2 x3 :exp) = (If t (let_op_sing x1) (let_op_sing x2) (let_op_sing x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp) (t :tra). let_op_sing (Let t xs x2) = (let (xs' :exp list) = let_op_list xs; (x2' :exp) = let_op_sing x2 in case dest_op x2' xs' of (NONE :op option) => Let t xs' x2' | SOME op => Op t op xs')) ∧ (∀(x1 :exp) (t :tra). let_op_sing (Raise t x1 :exp) = (Raise t (let_op_sing x1) :exp)) ∧ (∀(x2 :exp) (x1 :exp) (t :tra). let_op_sing (Handle t x1 x2 :exp) = (Handle t (let_op_sing x1) (let_op_sing x2) :exp)) ∧ (∀(xs :exp list) (t :tra) (op :op). let_op_sing (Op t op xs) = Op t op (let_op_list xs)) ∧ (∀(x :exp) (t :tra). let_op_sing (Tick t x) = Tick t (let_op_sing x)) ∧ (∀(xs :exp list) (ticks :num) (t :tra) (dest :num). let_op_sing (Call t ticks dest xs) = Call t ticks dest (let_op_list xs)) ∧ (∀(xs :exp list) (x1 :exp) (t :tra) (loc_opt :num option). let_op_sing (App t loc_opt x1 xs :exp) = (App t loc_opt (let_op_sing x1) (let_op_list xs) :exp)) ∧ (∀(x1 :exp) (vs :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # exp) list). let_op_sing (Letrec t loc_opt vs fns x1 :exp) = (let (new_fns :(num # exp) list) = let_op_let fns in (Letrec t loc_opt vs new_fns (let_op_sing x1) :exp))) ∧ (∀(x1 :exp) (vs :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). let_op_sing (Fn t loc_opt vs num_args x1) = Fn t loc_opt vs num_args (let_op_sing x1)) ∧ let_op_list ([] :exp list) = ([] :exp list) ∧ (∀(xs :exp list) (x :exp). let_op_list (x::xs) = let_op_sing x::let_op_list xs) ∧ let_op_let ([] :(num # exp) list) = ([] :(num # exp) list) ∧ ∀(xs :(num # exp) list) (x :exp) (num_args :num). let_op_let ((num_args,x)::xs) = (num_args,let_op_sing x)::let_op_let xs
let_op_sing_eq_typed=(∀(e :exp). let_op [e] = [let_op_sing e]) ∧ (∀(es :exp list). let_op es = let_op_list es) ∧ ∀(fns :(num # exp) list). let_op_let fns = MAP (λ((num_args :num),(x :exp)). (num_args,HD (let_op [x]))) fns
compile_inc_typed=∀(e :exp list) (xs :β). (compile_inc (e,xs) :exp list # α list) = (let_op e,([] :α list))
