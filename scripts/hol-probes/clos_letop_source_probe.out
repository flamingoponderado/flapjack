value_rel_typed=(∀(i :int). v_rel (Number i) (Number i)) ∧ (∀(w :word64). v_rel (Word64 w :v) (Word64 w :v)) ∧ (∀(w :word8 list). v_rel (ByteVector w) (ByteVector w)) ∧ (∀(n :num) (b :bool). v_rel (RefPtr b n) (RefPtr b n)) ∧ (∀(tag :num) (xs :v list) (ys :v list). LIST_REL v_rel xs ys ⇒ v_rel (Block tag xs) (Block tag ys)) ∧ (∀(loc :num option) (args1 :v list) (args2 :v list) (env1 :v list) (env2 :v list) (num_args :num) (e1 :closLang$exp) (e2 :closLang$exp). LIST_REL v_rel env1 env2 ∧ LIST_REL v_rel args1 args2 ∧ code_rel [e1] [e2] ⇒ v_rel (Closure loc args1 env1 num_args e1 :v) (Closure loc args2 env2 num_args e2 :v)) ∧ ∀(funs1 :(num # closLang$exp) list) (funs2 :(num # closLang$exp) list) (loc :num option) (args1 :v list) (args2 :v list) (env1 :v list) (env2 :v list) (k :num). LIST_REL v_rel env1 env2 ∧ LIST_REL v_rel args1 args2 ∧ LIST_REL (f_rel :num # closLang$exp -> num # closLang$exp -> bool) funs1 funs2 ⇒ v_rel (Recclosure loc args1 env1 funs1 k :v) (Recclosure loc args2 env2 funs2 k :v)
value_rel_simps_typed=(v_rel (Number (n :int)) (x :v) ⇔ x = Number n) ∧ (v_rel (Block (n :num) (p :v list)) x ⇔ ∃(ys :v list). x = Block n ys ∧ LIST_REL v_rel p ys) ∧ (v_rel (Word64 (p :word64) :v) x ⇔ x = (Word64 p :v)) ∧ (v_rel (ByteVector (p :word8 list)) x ⇔ x = ByteVector p) ∧ (v_rel (RefPtr (b :bool) (p :num)) x ⇔ x = RefPtr b p) ∧ (v_rel (Closure (x1 :num option) (x2 :v list) (x3 :v list) (x4 :num) (x5 :closLang$exp) :v) x ⇔ ∃(args2 :v list) (env2 :v list) (e2 :closLang$exp). x = (Closure x1 args2 env2 x4 e2 :v) ∧ LIST_REL v_rel x3 env2 ∧ LIST_REL v_rel x2 args2 ∧ code_rel [x5] [e2]) ∧ (v_rel (Recclosure (y1 :num option) (y2 :v list) (y3 :v list) (y4 :(num # closLang$exp) list) (y5 :num) :v) x ⇔ ∃(funs2 :(num # closLang$exp) list) (args2 :v list) (env2 :v list). x = (Recclosure y1 args2 env2 funs2 y5 :v) ∧ LIST_REL v_rel y3 env2 ∧ LIST_REL v_rel y2 args2 ∧ LIST_REL (f_rel :num # closLang$exp -> num # closLang$exp -> bool) y4 funs2) ∧ (v_rel (Boolv b :v) x ⇔ x = (Boolv b :v)) ∧ (v_rel Unit x ⇔ x = Unit)
value_bytes_list_replay_typed=∀(x :v) (y :v). v_rel x y ⇒ ∀(ns :word8 list). v_to_list x = SOME (MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns) ⇔ v_to_list y = SOME (MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns)
