let_op_typed=let_op ([] :closLang$exp list) = ([] :closLang$exp list) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). let_op (x::y::xs) = HD (let_op [x])::let_op (y::xs)) ∧ (∀(v :num) (t :tra). let_op [(Var t v :closLang$exp)] = [(Var t v :closLang$exp)]) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). let_op [(If t x1 x2 x3 :closLang$exp)] = [(If t (HD (let_op [x1])) (HD (let_op [x2])) (HD (let_op [x3])) :closLang$exp)]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). let_op [(Let t xs x2 :closLang$exp)] = (let (xs' :closLang$exp list) = let_op xs; (x2' :closLang$exp) = HD (let_op [x2]) in case dest_op x2' xs' of (NONE :closLang$op option) => [(Let t xs' x2' :closLang$exp)] | SOME op => [Op t op xs'])) ∧ (∀(x1 :closLang$exp) (t :tra). let_op [(Raise t x1 :closLang$exp)] = [(Raise t (HD (let_op [x1])) :closLang$exp)]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). let_op [(Handle t x1 x2 :closLang$exp)] = [(Handle t (HD (let_op [x1])) (HD (let_op [x2])) :closLang$exp)]) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). let_op [Op t op xs] = [Op t op (let_op xs)]) ∧ (∀(x :closLang$exp) (t :tra). let_op [Tick t x] = [Tick t (HD (let_op [x]))]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). let_op [Call t ticks dest xs] = [Call t ticks dest (let_op xs)]) ∧ (∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). let_op [(App t loc_opt x1 xs :closLang$exp)] = [(App t loc_opt (HD (let_op [x1])) (let_op xs) :closLang$exp)]) ∧ (∀(x1 :closLang$exp) (vs :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). let_op [(Letrec t loc_opt vs fns x1 :closLang$exp)] = (let (new_fns :(num # closLang$exp) list) = MAP (λ((num_args :num),(x :closLang$exp)). (num_args,HD (let_op [x]))) fns in [(Letrec t loc_opt vs new_fns (HD (let_op [x1])) :closLang$exp)])) ∧ ∀(x1 :closLang$exp) (vs :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). le