do_app_lemma_replay_typed=state_rel (s :(α, β) state) (t :(α, β) state) ∧ LIST_REL v_rel (xs :v list) (ys :v list) ⇒ case (do_app (opp :closLang$op) xs s :(v # (α, β) state, v) result) of (Rval (x,s1) :(v # (α, β) state, v) result) => ∃(y :v) (t1 :(α, β) state). v_rel x y ∧ state_rel s1 t1 ∧ (do_app opp ys t :(v # (α, β) state, v) result) = (Rval (y,t1) :(v # (α, β) state, v) result) | (Rerr err1 :(v # (α, β) state, v) result) => ∃(err2 :v error_result). (do_app opp ys t :(v # (α, β) state, v) result) = (Rerr err2 :(v # (α, β) state, v) result) ∧ exc_rel v_rel err1 err2
