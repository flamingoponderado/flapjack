do_install_lemma_replay_typed=state_rel (s :(α, β) state) (t :(α, β) state) ∧ LIST_REL v_rel (xs :v list) (ys :v list) ⇒ case do_install xs s of ((Rval exps1 :(closLang$exp list, v) result),s1) => ∃(exps2 :closLang$exp list) (t1 :(α, β) state). state_rel s1 t1 ∧ exps1 ≠ ([] :closLang$exp list) ∧ code_rel exps1 exps2 ∧ do_install ys t = ((Rval exps2 :(closLang$exp list, v) result),t1) | ((Rerr err1 :(closLang$exp list, v) result),s1) => ∃(err2 :v error_result) (t1 :(α, β) state). do_install ys t = ((Rerr err2 :(closLang$exp list, v) result),t1) ∧ exc_rel v_rel err1 err2 ∧ state_rel s1 t1
rel_update_thunk_replay_typed=state_rel (s1 :(α, β) state) (s2 :(α, β) state) ∧ LIST_REL v_rel (vs :v list) (ys :v list) ⇒ (update_thunk [RefPtr (v :bool) (ptr :num)] s1.refs vs = (NONE :(num |-> v ref) option) ⇒ update_thunk [RefPtr v ptr] s2.refs ys = (NONE :(num |-> v ref) option)) ∧ (update_thunk [RefPtr v ptr] s1.refs vs = SOME (refs1 :num |-> v ref) ⇒ ∃(refs2 :num |-> v ref). update_thunk [RefPtr v ptr] s2.refs ys = SOME refs2 ∧ state_rel (s1 with refs := refs1) (s2 with refs := refs2))
dest_closure_shape_typed=dest_closure (max_app :num) (loc_opt :num option) (f2 :v) (xs :v list) = SOME (x :app_kind) ⇒ (∃(loc :num option) (arg_env :v list) (clo_env :v list) (num_args :num) (e :closLang$exp). f2 = (Closure loc arg_env clo_env num_args e :v)) ∨ ∃(loc :num option) (arg_env :v list) (clo_env :v list) (fns :(num # closLang$exp) list) (i :num). f2 = (Recclosure loc arg_env clo_env fns i :v)
dest_closure_full_typed=v_rel (f1 :v) (f2 :v) ∧ v_rel (a1 :v) (a2 :v) ∧ LIST_REL v_rel (args1 :v list) (args2 :v list) ∧ dest_closure (max_app :num) (loc_opt :num option) f1 (a1::args1) = SOME (Full_app (exp1 :closLang$exp) (env1 :v list) (rest_args1 :v list)) ⇒ ∃(exp2 :closLang$exp) (env2 :v list) (rest_args2 :v list). code_rel [exp1] [exp2] ∧ LIST_REL v_rel env1 env2 ∧ LIST_REL v_rel rest_args1 rest_args2 ∧ dest_closure max_app loc_opt f2 (a2::args2) = SOME (Full_app exp2 env2 rest_args2)
let_op_correct_typed=∀(xs :closLang$exp list) (env1 :v list) (s1 :(γ, 'ffi) state) (res1 :(v list, v) result) (s2 :(γ, 'ffi) state) (env2 :v list) (t1 :(γ, 'ffi) state). evaluate (xs,env1,s1) = (res1,s2) ∧ LIST_REL v_rel env1 env2 ∧ state_rel s1 t1 ⇒ ∃(res2 :(v list, v) result) (t2 :(γ, 'ffi) state). evaluate (let_op xs,env2,t1) = (res2,t2) ∧ result_rel (LIST_REL v_rel) v_rel res1 res2 ∧ state_rel s2 t2
semantics_let_op_typed=semantics (ffi :'ffi ffi_state) (max_app :num) (FEMPTY :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option)) (xs :closLang$exp list) ≠ Fail ⇒ (∀(n :num). SND (SND (co n)) = ([] :(num # num # closLang$exp) list)) ∧ (1 :num) ≤ max_app ⇒ semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) ((pure_co (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :α # closLang$exp list # (num # num # closLang$exp) list -> α # closLang$exp list # (num # num # closLang$exp) list) ∘ co) cc (let_op xs) = semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) co (pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) cc) xs
known_compile_typed=(∀(exps :closLang$exp list). (compile (NONE :config option) exps :config option # closLang$exp list) = ((NONE :config option),exps)) ∧ ∀(c :config) (exps :closLang$exp list). (compile (SOME c) exps :config option # closLang$exp list) = (let (exps :closLang$exp list) = (compile exps :closLang$exp list); ((es :(closLang$exp # val_approx) list),(g :val_approx sptree$num_map)) = known c exps ([] :val_approx list) (LN :val_approx sptree$num_map); (es1 :closLang$exp list) = remove_ticks (MAP (FST :closLang$exp # val_approx -> closLang$exp) es); (es2 :closLang$exp list) = let_op es1 in (SOME (c with val_approx_spt := g),es2))
known_static_conf_typed=∀(kc :config option). known_static_conf kc = case kc of (NONE :config option) => (NONE :config option) | SOME kc => SOME (reset_inline_factor kc with val_approx_spt := (LN :val_approx sptree$num_map))
known_compile_inc_typed=(∀(spt :val_approx sptree$num_map) (p :closLang$exp list # α list). known_compile_inc (NONE :config option) spt p = (spt,p)) ∧ ∀(c :config) (spt :val_approx sptree$num_map) (p :closLang$exp list # α list). known_compile_inc (SOME c) spt p = (let (p :closLang$exp list # (num # num # closLang$exp) list) = (compile_inc p :closLang$exp list # (num # num # closLang$exp) list); ((spt :val_approx sptree$num_map),(p :closLang$exp list # (num # num # closLang$exp) list)) = (compile_inc c spt p :val_approx sptree$num_map # closLang$exp list # (num # num # closLang$exp) list); (p :closLang$exp list # (num # num # closLang$exp) list) = (compile_inc p :closLang$exp list # (num # num # closLang$exp) list); (p :closLang$exp list # α list) = (compile_inc p :closLang$exp list # α list) in (spt,p))
