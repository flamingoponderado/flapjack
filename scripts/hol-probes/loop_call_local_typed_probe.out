labels_in_def_typed=∀(l :num sptree$num_map) (locals :α word_loc sptree$num_map). labels_in l locals ⇔ ∀(n :num) (x :num). lookup n l = SOME x ⇒ lookup n locals = SOME (Loc x (0 :num) :α word_loc)
get_vars_front_typed=∀(xs :num list) (ys :α word_loc list) (s :(α, β) state). (get_vars xs s :α word_loc list option) = SOME ys ∧ xs ≠ ([] :num list) ⇒ (get_vars (FRONT xs) s :α word_loc list option) = SOME (FRONT ys)
get_vars_last_typed=∀(xs :num list) (ys :α word_loc list) (s :(α, β) state). (get_vars xs s :α word_loc list option) = SOME ys ∧ xs ≠ ([] :num list) ⇒ lookup (LAST xs) s.locals = SOME (LAST ys)
evaluate_ShMem_neq_locals_typed=(evaluate (ShMem (op :memop) (v :num) (ad :α loopLang$exp),(s :(α, β) state)) :α result option # (α, β) state) = ((res :α result option),(s' :(α, β) state)) ∧ v ≠ (n :num) ∧ ¬(∃(x :final_event). res = SOME (FinalFFI x :α result)) ∧ lookup n s.locals = (x :α word_loc option) ⇒ lookup n s'.locals = x
evaluate_ShMem_not_load_locals_typed=(evaluate (ShMem (op :memop) (v :num) (ad :α loopLang$exp),(s :(α, β) state)) :α result option # (α, β) state) = ((res :α result option),(s' :(α, β) state)) ∧ ¬is_load op ∧ ¬(∃(x :final_event). res = SOME (FinalFFI x :α result)) ⇒ s.locals = s'.locals
