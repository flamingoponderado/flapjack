extract_full_the_words_SOME_eq=⊢ ∀ls x. the_words ls = SOME x ⇒ x = MAP (λx. case x of NONE => ARB | SOME (Word y) => y | SOME (Loc v2 v3) => ARB) ls
extract_full_the_words_MAP_exists=⊢ ∀ls x a f. the_words (MAP f ls) = SOME x ∧ MEM a ls ⇒ ∃w. f a = SOME (Word w)
