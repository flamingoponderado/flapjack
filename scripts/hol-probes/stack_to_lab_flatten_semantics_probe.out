flatten_call_correct_statement=∀t1 start s2 s1 res. evaluate (Call NONE (INL start) NONE,s1) = (res,s2) ∧ state_rel s1 t1 ∧ loc_to_pc start 0 t1.code = SOME t1.pc ∧ res ≠ SOME Error ∧ (res ≠ SOME TimeOut ⇒ (∃w. res = SOME (Halt (Word w))) ∨ (∃f. res = SOME (FinalFFI f)) ∨ ∃n. res = SOME (Result (Loc n 0)) ∧ ∀s. subspt s1.code s.code ∧ s.clock ≠ 0 ⇒ ∃t. evaluate (Call NONE (INL n) NONE,s) = (SOME (Halt (Word 0w)),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − 1) ⇒ ∃ck r2 t2. evaluate (t1 with clock := t1.clock − 1 + ck) = (r2,t2) ∧ (∀f. res = SOME (FinalFFI f) ⇒ r2 = Halt (FFI_outcome f)) ∧ (∀w. res = SOME (Halt w) ⇒ r2 = case w of Word 0w => Halt Success | Word v6 => Halt Resource_limit_hit | Loc v4 v5 => Error) ∧ (∀n. res = SOME (Result (Loc n 0)) ⇒ r2 = Halt Success) ∧ t2.ffi = s2.ffi ∧ r2 ≠ Error ∧ (res = SOME TimeOut ⇒ r2 = TimeOut)
flatten_call_correct_statement_typed=∀(t1 :(α, γ, 'ffi) labSem$state) (start :num) (s2 :(α, γ, 'ffi) stackSem$state) (s1 :(α, γ, 'ffi) stackSem$state) (res :α stackSem$result option). (evaluate ((Call (NONE :(α prog # num # num # num) option) (INL start :num + num) (NONE :(α prog # num # num) option) :α prog),s1) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (res,s2) ∧ (state_rel s1 t1 :bool) ∧ loc_to_pc start (0 :num) t1.code = SOME t1.pc ∧ res ≠ SOME (Error :α stackSem$result) ∧ (res ≠ SOME (TimeOut :α stackSem$result) ⇒ (∃(w :α word). res = SOME (Halt (Word w) :α stackSem$result)) ∨ (∃(f :final_event). res = SOME (FinalFFI f :α stackSem$result)) ∨ ∃(n :num). res = SOME (Result (Loc n (0 :num) :α word_loc) :α stackSem$result) ∧ ∀(s :(α, γ, 'ffi) stackSem$state). subspt s1.code s.code ∧ s.clock ≠ (0 :num) ⇒ ∃(t :(α, γ, 'ffi) stackSem$state). (evaluate ((Call (NONE :(α prog # num # num # num) option) (INL n :num + num) (NONE :(α prog # num # num) option) :α prog),s) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (SOME (Halt (Word (0w :α word)) :α stackSem$result),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − (1 :num)) ⇒ ∃(ck :num) (r2 :machine_result) (t2 :(α, γ, 'ffi) labSem$state). (evaluate (t1 with clock := t1.clock − (1 :num) + ck) :machine_result # (α, γ, 'ffi) labSem$state) = (r2,t2) ∧ (∀(f :final_event). res = SOME (FinalFFI f :α stackSem$result) ⇒ r2 = (Halt (FFI_outcome f) :machine_result)) ∧ (∀(w :α word_loc). res = SOME (Halt w :α stackSem$result) ⇒ r2 = case w of Word (0w :α word) => (Halt Success :machine_result) | Word v6 => (Halt Resource_limit_hit :machine_result) | (Loc v4 v5 :α word_loc) => Error) ∧ (∀(n :num). res = SOME (Result (Loc n (0 :num) :α word_loc) :α stackSem$result) ⇒ r2 = (Halt Success :machine_result)) ∧ t2.ffi = s2.ffi ∧ r2 ≠ Error ∧ (res = SOME (TimeOut :α stackSem$result) ⇒ r2 = TimeOut)
flatten_call_correct_statement_types=(t1 :(α, γ, 'ffi) labSem$state)::(α, γ, 'ffi) labSem$state;(start :num)::num;(s2 :(α, γ, 'ffi) stackSem$state)::(α, γ, 'ffi) stackSem$state;(s1 :(α, γ, 'ffi) stackSem$state)::(α, γ, 'ffi) stackSem$state;(res :α stackSem$result option)::α stackSem$result option;
halt_assum_def_statement=∀code. halt_assum (:'ffi # γ) code ⇔ ∀s. subspt code s.code ∧ s.clock ≠ 0 ⇒ ∃t. evaluate (Call NONE (INL 1) NONE,s) = (SOME (Halt (Word 0w)),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − 1
halt_assum_def_statement_typed=∀(code :α prog sptree$num_map). halt_assum (:'ffi # γ) code ⇔ ∀(s :(α, γ, 'ffi) stackSem$state). subspt code s.code ∧ s.clock ≠ (0 :num) ⇒ ∃(t :(α, γ, 'ffi) stackSem$state). (evaluate ((Call (NONE :(α prog # num # num # num) option) (INL (1 :num) :num + num) (NONE :(α prog # num # num) option) :α prog),s) :α stackSem$result option # (α, γ, 'ffi) stackSem$state) = (SOME (Halt (Word (0w :α word)) :α stackSem$result),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − (1 :num)
halt_assum_def_statement_types=(code :α prog sptree$num_map)::α prog sptree$num_map;
flatten_semantics_statement=∀start s2 s1. halt_assum (:'ffi # γ) s1.code ∧ state_rel s1 s2 ∧ loc_to_pc start 0 s2.code = SOME s2.pc ∧ semantics start s1 ≠ Fail ⇒ semantics s2 = semantics start s1
flatten_semantics_statement_typed=∀(start :num) (s2 :(α, γ, 'ffi) labSem$state) (s1 :(α, γ, 'ffi) stackSem$state). halt_assum (:'ffi # γ) s1.code ∧ (state_rel s1 s2 :bool) ∧ loc_to_pc start (0 :num) s2.code = SOME s2.pc ∧ (semantics start s1 :behaviour) ≠ Fail ⇒ (semantics s2 :behaviour) = (semantics start s1 :behaviour)
flatten_semantics_statement_types=(start :num)::num;(s2 :(α, γ, 'ffi) labSem$state)::(α, γ, 'ffi) labSem$state;(s1 :(α, γ, 'ffi) stackSem$state)::(α, γ, 'ffi) stackSem$state;
