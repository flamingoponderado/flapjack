flatten_call_correct_statement=∀t1 start s2 s1 res. evaluate (Call NONE (INL start) NONE,s1) = (res,s2) ∧ state_rel s1 t1 ∧ loc_to_pc start 0 t1.code = SOME t1.pc ∧ res ≠ SOME Error ∧ (res ≠ SOME TimeOut ⇒ (∃w. res = SOME (Halt (Word w))) ∨ (∃f. res = SOME (FinalFFI f)) ∨ ∃n. res = SOME (Result (Loc n 0)) ∧ ∀s. subspt s1.code s.code ∧ s.clock ≠ 0 ⇒ ∃t. evaluate (Call NONE (INL n) NONE,s) = (SOME (Halt (Word 0w)),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − 1) ⇒ ∃ck r2 t2. evaluate (t1 with clock := t1.clock − 1 + ck) = (r2,t2) ∧ (∀f. res = SOME (FinalFFI f) ⇒ r2 = Halt (FFI_outcome f)) ∧ (∀w. res = SOME (Halt w) ⇒ r2 = case w of Word 0w => Halt Success | Word v6 => Halt Resource_limit_hit | Loc v4 v5 => Error) ∧ (∀n. res = SOME (Result (Loc n 0)) ⇒ r2 = Halt Success) ∧ t2.ffi = s2.ffi ∧ r2 ≠ Error ∧ (res = SOME TimeOut ⇒ r2 = TimeOut)
halt_assum_def_statement=∀code. halt_assum (:'ffi # γ) code ⇔ ∀s. subspt code s.code ∧ s.clock ≠ 0 ⇒ ∃t. evaluate (Call NONE (INL 1) NONE,s) = (SOME (Halt (Word 0w)),t) ∧ t.ffi = s.ffi ∧ t.clock = s.clock − 1
flatten_semantics_statement=∀start s2 s1. halt_assum (:'ffi # γ) s1.code ∧ state_rel s1 s2 ∧ loc_to_pc start 0 s2.code = SOME s2.pc ∧ semantics start s1 ≠ Fail ⇒ semantics s2 = semantics start s1
