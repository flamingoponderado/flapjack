LESS_EQ_dec_clock_typed=(r :(γ, 'ffi) state).clock ≤ (dec_clock (n :num) (s :(α, β) state)).clock ⇒ r.clock ≤ s.clock
fix_clock_IMP_typed=fix_clock (s :(δ, ε) state) (x :α # (β, γ) state) = ((res :α),(s1 :(β, γ) state)) ⇒ s1.clock ≤ s.clock
evaluate_app_NIL_typed=evaluate_app (loc :num option) (v :v) ([] :v list) (s :(α, β) state) = ((Rval [v] :(v list, v) result),s)
do_app_const_typed=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((res :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ s2.clock = s1.clock ∧ s2.max_app = s1.max_app ∧ s2.code = s1.code ∧ s2.compile_oracle = s1.compile_oracle ∧ s2.compile = s1.compile
evaluate_clock_help_typed=(∀(tup :closLang$exp list # v list # (γ, 'ffi) state) (vs :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate tup = (vs,s2) ⇒ s2.clock ≤ (SND (SND tup)).clock) ∧ ∀(loc_opt :num option) (f :v) (args :v list) (s1 :(γ, 'ffi) state) (vs :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate_app loc_opt f args s1 = (vs,s2) ⇒ s2.clock ≤ s1.clock
