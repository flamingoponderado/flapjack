gc_fun_sf_gc_consts_statement=∀(s :α stack_frame list) (s'l :α word_loc list) (s' :α stack_frame list) (gc_fun :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) (memory :α word -> α word_loc) (memory' :α word -> α word_loc) (mdomain :α word -> bool) (store :store_name |-> α word_loc) (store' :store_name |-> α word_loc). gc_fun_const_ok gc_fun ∧ gc_fun (enc_stack s,memory,mdomain,store) = SOME (s'l,memory',store') ∧ dec_stack s'l s = SOME s' ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s s'
gc_fun_sf_gc_consts_hypotheses=0
