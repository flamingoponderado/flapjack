compile_exp_thm_typed=evaluate ((prog :α prog),(s :(α, γ, 'ffi) state)) = ((res :α result option),(s2 :(α, γ, 'ffi) state)) ∧ res ≠ SOME (Error :α result) ∧ gc_fun_const_ok s.gc_fun ⇒ evaluate (compile_exp prog,s) = (res,s2)
evaluate_simp_duplicate_if_typed=∀(p :α prog) (s :(α, β, γ) state). gc_fun_const_ok s.gc_fun ⇒ evaluate (simp_duplicate_if p,s) = evaluate (p,s)
evaluate_simp_push_out_if_typed=∀(p :α prog) (s :(α, β, γ) state). evaluate (push_out_if p,s) = evaluate (p,s)
evaluate_const_fp_typed=∀(p :α prog) (s :(α, β, γ) state). gc_fun_const_ok s.gc_fun ⇒ evaluate (const_fp p,s) = evaluate (p,s)
evaluate_const_fp_loop_typed=∀(p :α prog) (cs :α word sptree$num_map) (p' :α prog) (cs' :α word sptree$num_map) (s :(α, β, γ) state) (res :α result option) (s' :(α, β, γ) state). evaluate (p,s) = (res,s') ∧ const_fp_loop p cs = (p',cs') ∧ gc_fun_const_ok s.gc_fun ∧ (∀(v :num) (w :α word). lookup v cs = SOME w ⇒ get_var v s = SOME (Word w)) ⇒ evaluate (p',s) = (res,s') ∧ (res = (NONE :α result option) ⇒ ∀(v :num) (w :α word). lookup v cs' = SOME w ⇒ get_var v s' = SOME (Word w))
evaluate_drop_consts_typed=(∀(v :num) (w :α word). lookup v (cs :α word sptree$num_map) = SOME w ⇒ get_var v (s :(α, β, γ) state) = SOME (Word w)) ⇒ evaluate (SmartSeq (drop_consts cs (vs :num list)) (p :α prog),s) = evaluate (p,s)
evaluate_drop_consts_1_typed=∀(vs :num list) (rest :α) (s :(β, γ, δ) state). (∀(v :num) (w :β word). lookup v (cs :β word sptree$num_map) = SOME w ⇒ get_var v s = SOME (Word w)) ⇒ evaluate (drop_consts cs vs,s) = ((NONE :β result option),s)
get_var_set_vars_ignore_typed=∀(xs :num list) (l :α word_loc list) (m :(α, β, γ) state). ¬MEM (v :num) xs ⇒ get_var v (set_vars xs l m) = get_var v m
LIST_REL_append_left_typed=∀(l0 :α list) (l1 :α list) (l2 :β list) (R :α -> β -> bool). LIST_REL R (l0 ++ l1) l2 ⇒ LIST_REL R l0 (TAKE (LENGTH l0) l2) ∧ LIST_REL R l1 (DROP (LENGTH l0) l2)
LIST_REL_prefix_typed=∀(R :α -> β -> bool) (l1 :α list) (l2 :α list) (l1' :β list) (l2' :β list). LIST_REL R (l1 ++ l2) (l1' ++ l2') ∧ LENGTH l1 = LENGTH l1' ⇒ LIST_REL R l1 l1'
const_fp_exp_word_exp_typed=∀(e :α exp) (cs :α word sptree$num_map) (s :(α, β, γ) state). (∀(v :num) (w :α word). lookup v cs = SOME w ⇒ get_var v s = SOME (Word w)) ⇒ (word_exp s (const_fp_exp e cs) :α word_loc option) = (word_exp s e :α word_loc option)
const_fp_exp_word_exp_const_typed=∀(e :α exp) (cs :α word sptree$num_map) (s :(α, β, γ) state) (c :α word). (∀(v :num) (w :α word). lookup v cs = SOME w ⇒ get_var v s = SOME (Word w)) ∧ const_fp_exp e cs = (Const c :α exp) ⇒ (word_exp s e :α word_loc option) = SOME (Word c)
cs_delete_if_set_typed=∀(x :α word_loc) (v1 :num) (v2 :num) (s :(α, β, γ) state) (cs :α word sptree$num_map) (w :α word). (∀(v :num) (w :α word). lookup v cs = SOME w ⇒ get_var v s = SOME (Word w)) ∧ lookup v2 (delete v1 cs) = SOME w ⇒ get_var v2 (set_var v1 x s) = SOME (Word w)
cs_delete_if_set_x2_typed=∀(x1 :α word_loc) (x2 :α word_loc) (v1 :num) (v2 :num) (v3 :num) (s :(α, β, γ) state) (cs :α word sptree$num_map) (w :α word). (∀(v :num) (w :α word). lookup v cs = SOME w ⇒ get_var v s = SOME (Word w)) ∧ lookup v3 (delete v2 (delete v1 cs)) = SOME w ⇒ get_var v3 (set_var v2 x2 (set_var v1 x1 s)) = SOME (Word w)
gc_fun_const_ok_def_typed=∀(f :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option). gc_fun_const_ok f ⇔ ∀(x :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc)) (y :α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)). f x = SOME y ⇒ LIST_REL (λ(a :α word_loc) (b :α word_loc). is_gc_word_const a ⇒ b = a) (FST x) (FST y)
get_var_imm_cs_imp_get_var_imm_typed=∀(x :α reg_imm) (y :α word) (s :(α, β, γ) state) (cs :α word sptree$num_map). (∀(v :num) (w :α word). lookup v cs = SOME w ⇒ get_var v s = SOME (Word w)) ∧ get_var_imm_cs x cs = SOME y ⇒ get_var_imm x s = SOME (Word y)
get_var_mem_store_thm_typed=∀(v :num) (addr :α word) (x :α word_loc) (s :(α, β, γ) state). mem_store addr x s = SOME (s' :(α, β, γ) state) ⇒ get_var v s' = get_var v s
get_var_move_thm_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state) (moves :(num # num) list) (x :α word_loc list) (v :num). get_vars (MAP (SND :num # num -> num) moves) s = SOME x ∧ set_vars (MAP (FST :num # num -> num) moves) x s = s' ⇒ get_var v s' = case ALOOKUP moves v of (NONE :num option) => get_var v s | SOME w => get_var w s
get_var_set_var_thm_typed=∀(k1 :num) (k2 :num) (v :α word_loc) (s :(α, β, γ) state). get_var k1 (set_var k2 v s) = if k1 = k2 then SOME v else get_var k1 s
lookup_const_fp_move_cs_typed=∀(v :num) (moves :(num # num) list) (cs :α sptree$num_map). ALL_DISTINCT (MAP (FST :num # num -> num) moves) ⇒ lookup v (const_fp_move_cs moves cs cs) = case ALOOKUP moves v of (NONE :num option) => lookup v cs | SOME w => lookup w cs
lookup_const_fp_move_cs_NONE_typed=∀(moves :(num # num) list) (v :num) (cs :α sptree$num_map) (cs' :α sptree$num_map). ALOOKUP moves v = (NONE :num option) ∧ lookup v cs = lookup v cs' ⇒ lookup v (const_fp_move_cs moves cs cs') = lookup v cs'
lookup_const_fp_move_cs_SOME_typed=∀(moves :(num # num) list) (v :num) (w :num) (cs :α sptree$num_map) (cs' :α sptree$num_map). ALOOKUP moves v = SOME w ∧ ALL_DISTINCT (MAP (FST :num # num -> num) moves) ∧ lookup v cs = lookup v cs' ⇒ lookup v (const_fp_move_cs moves cs cs') = lookup w cs
lookup_const_fp_move_cs_SOME_part_typed=∀(moves :(num # num) list) (q :num) (cs :α sptree$num_map) (cs' :α sptree$num_map) (x :α option). ¬MEM q (MAP (FST :num # num -> num) moves) ∧ lookup q cs' = x ⇒ lookup q (const_fp_move_cs moves cs cs') = x
lookup_filter_v_SOME_typed=∀(t :α sptree$num_map) (k :num) (v :α) (f :α -> bool). lookup k (filter_v f t) = SOME v ⇒ f v
lookup_filter_v_SOME_imp_typed=∀(t :α sptree$num_map) (k :num) (v :α) (f :α -> bool). lookup k (filter_v f t) = SOME v ⇒ lookup k t = SOME v
lookup_inter_eq_some_typed=∀(m1 :α sptree$num_map) (m2 :α sptree$num_map) (k :num) (x :α). lookup k (inter_eq m1 m2) = SOME x ⇒ lookup k m1 = SOME x ∧ lookup k m2 = SOME x
push_env_set_store_stack_typed=∀(x1 :α word_loc sptree$num_map # α word_loc sptree$num_map) (x2 :(num # α prog # num # num) option) (x3 :store_name) (x4 :α word_loc) (s :(α, β, γ) state). (push_env x1 x2 (set_store x3 x4 s)).stack = (push_env x1 x2 s).stack
set_vars_move_NONE_typed=∀(moves :(num # α) list) (x :β word_loc list) (s :(β, γ, δ) state) (s' :(β, γ, δ) state) (v :num). set_vars (MAP (FST :num # α -> num) moves) x s = s' ∧ ALOOKUP moves v = (NONE :α option) ⇒ get_var v s' = get_var v s
set_vars_move_SOME_typed=∀(moves :(num # num) list) (x :α word_loc list) (v :num) (w :num) (s :(α, β, γ) state) (s' :(α, β, γ) state). set_vars (MAP (FST :num # num -> num) moves) x s = s' ∧ get_vars (MAP (SND :num # num -> num) moves) s = SOME x ∧ ALOOKUP moves v = SOME w ⇒ get_var v s' = get_var w s
sf_gc_consts_def_typed=sf_gc_consts (StackFrame (v0 :num option) (l0 :(num # α word_loc) list) (sv :(num # α word_loc) list) (h :(num # num # num) option)) (StackFrame (v1 :num option) (l0' :(num # α word_loc) list) (sw :(num # α word_loc) list) (h' :(num # num # num) option)) ⇔ LIST_REL (λ((ak :num),(av :α word_loc)) ((bk :num),(bv :α word_loc)). ak = bk ∧ (is_gc_word_const av ⇒ bv = av)) sv sw ∧ l0 = l0' ∧ h = h'
sf_gc_consts_refl_typed=∀(x :α stack_frame). sf_gc_consts x x
sf_gc_consts_trans_typed=∀(a :α stack_frame) (b :α stack_frame) (c :α stack_frame). sf_gc_consts a b ∧ sf_gc_consts b c ⇒ sf_gc_consts a c
strip_const_thm_typed=∀(xs :α exp list) (x :α word list) (s :(α, β, γ) state). strip_const xs = SOME x ⇒ MAP (λ(a :α exp). (word_exp s a :α word_loc option)) xs = MAP ((SOME :α word_loc -> α word_loc option) ∘ (Word :α word -> α word_loc)) x
the_words_thm_typed=∀(x :α word list). the_words (MAP ((SOME :α word_loc -> α word_loc option) ∘ (Word :α word -> α word_loc)) x) = SOME x
ALL_DISTINCT_PERM_FST_typed=∀(l :(α # β) list). ALL_DISTINCT (MAP (FST :α # β -> α) l) ∧ PERM l ((f :(α # β) list -> (α # β) list) l) ⇒ ALL_DISTINCT (MAP (FST :α # β -> α) (f l))
ALOOKUP_ALL_DISTINCT_FST_PERM_typed=∀(l1 :(α # β) list) (l2 :(α # β) list). ALL_DISTINCT (MAP (FST :α # β -> α) l1) ∧ PERM l1 l2 ⇒ ALOOKUP l1 = ALOOKUP l2
ALOOKUP_ALL_DISTINCT_FST_PERM_SOME_typed=∀(l1 :(α # β) list) (f :(α # β) list -> (α # β) list) (k :α) (v :β). ALL_DISTINCT (MAP (FST :α # β -> α) l1) ∧ PERM l1 (f l1) ∧ ALOOKUP l1 k = SOME v ⇒ ALOOKUP (f l1) k = SOME v
ALOOKUP_LIST_REL_sf_gc_consts_typed=∀(l1 :(α # β word_loc) list) (l2 :(α # β word_loc) list) (k :α) (v :β word_loc). LIST_REL (λ((ak :α),(av :β word_loc)) ((bk :α),(bv :β word_loc)). ak = bk ∧ (is_gc_word_const av ⇒ bv = av)) l1 l2 ∧ is_gc_word_const v ∧ ALOOKUP l1 k = SOME v ⇒ ALOOKUP l2 k = SOME v
ALOOKUP_LIST_REL_sf_gc_consts_NONE_typed=∀(l1 :(α # β word_loc) list) (l2 :(α # β word_loc) list) (k :α) (v :γ). LIST_REL (λ((ak :α),(av :β word_loc)) ((bk :α),(bv :β word_loc)). ak = bk ∧ (is_gc_word_const av ⇒ bv = av)) l1 l2 ∧ ALOOKUP l1 k = (NONE :β word_loc option) ⇒ ALOOKUP l2 k = (NONE :β word_loc option)
ALOOKUP_LIST_REL_value_rel_typed=∀(f :α -> bool) (l' :(β # α) list) (l :(β # α) list) (k :β) (v :α). LIST_REL (λ((ak :β),(av :α)) ((bk :β),(bv :α)). ak = bk ∧ (f av ⇒ bv = av)) l' l ∧ ALOOKUP l' k = SOME v ∧ f v ⇒ ALOOKUP l k = SOME v
EVERY2_trans_LASTN_sf_gc_consts_typed=∀(l :α stack_frame list) (l' :α stack_frame list) (l'' :α stack_frame list) (n :num) (R :β). n ≤ LENGTH l ∧ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) l l' ∧ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) (LASTN n l') l'' ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) (LASTN n l) l''
HD_LASTN_typed=∀(l :α list) (n :num). (0 :num) < n ∧ n ≤ LENGTH l ⇒ HD (LASTN n l) = l❲LENGTH l − n❳
LASTN_LENGTH_CONS_typed=∀(l :α list) (h :α). LASTN (LENGTH l) (h::l) = l
LASTN_TL_res_typed=∀(l :α list) (n :num) (h :α) (t :α list). n < LENGTH l ∧ LASTN (n + (1 :num)) l = h::t ⇒ t = LASTN n l
LIST_REL_call_Result_typed=∀(s :(α, β, γ) state) (s' :δ) (s'' :(α, ε, ζ) state) (s'³' :(α, ε, ζ) state) (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (handler :(num # α prog # num # num) option). LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) (push_env env handler s).stack s''.stack ∧ pop_env s'' = SOME s'³' ∧ s''.handler = (push_env env handler s).handler ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'³'.stack ∧ s'³'.handler = s.handler
LIST_REL_push_env_typed=∀(R :α stack_frame -> β stack_frame -> bool) (s :(α, γ, δ) state) (s' :(β, ε, ζ) state) (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (h :(num # α prog # num # num) option). LIST_REL R (push_env env h s).stack s'.stack ⇒ LIST_REL R s.stack (TL s'.stack)
call_env_push_env_dec_clock_handler_length_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state) (args :α word_loc list) (lsz :num option) (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (x0 :num) (x1 :α prog) (x2 :num) (x3 :num). s' = call_env args lsz (push_env env (SOME (x0,x1,x2,x3)) (dec_clock s)) ⇒ s'.handler < LENGTH s'.stack
enc_stack_dec_stack_is_gc_word_const_typed=∀(s :α stack_frame list) (s' :α stack_frame list) (s'l :α word_loc list). LIST_REL (λ(a :α word_loc) (b :α word_loc). is_gc_word_const a ⇒ b = a) (enc_stack s) s'l ∧ dec_stack s'l s = SOME s' ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s s'
evaluate_gc_fun_const_ok_typed=∀(p :α prog) (s :(α, β, γ) state) (res :α result option) (s' :(α, β, γ) state). evaluate (p,s) = (res,s') ∧ gc_fun_const_ok s.gc_fun ⇒ gc_fun_const_ok s'.gc_fun
evaluate_sf_gc_consts_typed=∀(p :α prog) (s :(α, β, γ) state) (s' :(α, β, γ) state) (res :α result option). evaluate (p,s) = (res,s') ∧ gc_fun_const_ok s.gc_fun ⇒ case res of (NONE :α result option) => LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'.stack ∧ s'.handler = s.handler | SOME (Result v9 v10) => LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'.stack ∧ s'.handler = s.handler | SOME (Exception v11 v12) => s.handler < LENGTH s.stack ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) (LASTN s.handler s.stack) s'.stack ∧ s'.handler = get_above_handler s | SOME (Break v13 :α result) => LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'.stack ∧ s'.handler = s.handler | SOME (Continue v14 :α result) => LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'.stack ∧ s'.handler = s.handler | SOME (TimeOut :α result) => T | SOME (NotEnoughSpace :α result) => T | SOME (FinalFFI v15 :α result) => T | SOME (Error :α result) => T
gc_fun_sf_gc_consts_typed=∀(s :α stack_frame list) (s'l :α word_loc list) (s' :α stack_frame list) (gc_fun :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) (memory :α word -> α word_loc) (memory' :α word -> α word_loc) (mdomain :α word -> bool) (store :store_name |-> α word_loc) (store' :store_name |-> α word_loc). gc_fun_const_ok gc_fun ∧ gc_fun (enc_stack s,memory,mdomain,store) = SOME (s'l,memory',store') ∧ dec_stack s'l s = SOME s' ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s s'
gc_handler_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state). gc s = SOME s' ⇒ s'.handler = s.handler
gc_sf_gc_consts_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state). gc_fun_const_ok s.gc_fun ∧ gc s = SOME s' ⇒ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'.stack
get_above_handler_def_typed=∀(s :(α, β, γ) state). get_above_handler s = case s.stack❲LENGTH s.stack − (s.handler + (1 :num))❳ of StackFrame v v1 v2 (NONE :(num # num # num) option) => (ARB :num) | StackFrame v v1 v2 (SOME (v8,v9)) => v8
get_above_handler_call_env_push_env_dec_clock_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state) (s'' :(δ, ε, ζ) state) (args :α word_loc list) (lsz :num option) (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (x0 :num) (x1 :α prog) (x2 :num) (x3 :num). s' = call_env args lsz (push_env env (SOME (x0,x1,x2,x3)) (dec_clock s)) ∧ s''.handler = get_above_handler s' ⇒ s''.handler = s.handler
pop_env_gc_fun_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state). pop_env s = SOME s' ⇒ s'.gc_fun = s.gc_fun
pop_env_gc_fun_const_ok_typed=∀(s :(α, β, γ) state) (s' :(α, β, γ) state). pop_env s = SOME s' ∧ gc_fun_const_ok s.gc_fun ⇒ gc_fun_const_ok s'.gc_fun
push_env_pop_env_locals_thm_typed=∀(s :(α, γ, 'ffi) state) (s' :(α, γ, 'ffi) state) (s'' :(α, γ, 'ffi) state) (s'³' :(α, γ, 'ffi) state) (env :α word_loc sptree$num_map # α word_loc sptree$num_map) (names :sptree$num_set # sptree$num_set) (handler :(num # α prog # num # num) option). cut_envs names s.locals = SOME env ∧ push_env env handler s = s' ∧ LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s'.stack s''.stack ∧ pop_env s'' = SOME s'³' ⇒ ∀(v :num) (w :α word_loc). get_var v s = SOME w ∧ is_gc_word_const w ∧ lookup v (all_names names) ≠ (NONE :unit option) ⇒ get_var v s'³' = SOME w
sf_gc_consts_get_above_handler_typed=∀(s :(α, β, γ) state) (s' :(α, δ, ε) state). LIST_REL (sf_gc_consts :α stack_frame -> α stack_frame -> bool) s.stack s'.stack ∧ s'.handler = s.handler ∧ s.handler < LENGTH s.stack ⇒ get_above_handler s' = get_above_handler s
is_gc_word_const_def_typed=(∀(v0 :num) (v1 :num). is_gc_word_const (Loc v0 v1 :α word_loc) ⇔ T) ∧ ∀(w :α word). is_gc_word_const (Word w) ⇔ is_gc_const w
dest_If_Eq_Imm_thm_typed=dest_If_Eq_Imm (x2 :α prog) = SOME ((n :num),(w :α word),(p1 :α prog),(p2 :α prog)) ⇔ x2 = (If Equal n (Imm w) p1 p2 :α prog)
dest_If_thm_typed=dest_If (x2 :α prog) = SOME ((g1 :cmp),(g2 :num),(g3 :α reg_imm),(g4 :α prog),(g5 :α prog)) ⇔ x2 = (If g1 g2 g3 g4 g5 :α prog)
dest_Seq_Assign_Const_IMP_typed=dest_Seq_Assign_Const (v :num) (p :α prog) = SOME ((q :α prog),(w :α word)) ⇒ evaluate (p,(s :(α, γ, 'ffi) state)) = evaluate (Seq q (Assign v (Const w :α exp)),s)
dest_Seq_IMP_typed=dest_Seq (p1 :α prog) = ((x1 :α prog),(x2 :α prog)) ⇒ evaluate (p1,(s :(α, γ, 'ffi) state)) = evaluate (Seq x1 x2,s)
evaluate_Loop_body_cong_typed=∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (c :α prog) (c' :α prog) (exit_names :sptree$num_set). (∀(v :(α, γ, 'ffi) state). evaluate (c',v) = evaluate (c,v)) ⇒ evaluate ((Loop names c' exit_names :α prog),s) = evaluate ((Loop names c exit_names :α prog),s)
evaluate_Loop_body_cong_gc_typed=∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (c :α prog) (c' :α prog) (exit_names :sptree$num_set). (∀(v :(α, γ, 'ffi) state). (R :(α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option) -> bool) v.gc_fun ⇒ evaluate (c',v) = evaluate (c,v)) ⇒ R s.gc_fun ⇒ evaluate ((Loop names c' exit_names :α prog),s) = evaluate ((Loop names c exit_names :α prog),s)
evaluate_Seq_Skip_typed=∀(p1 :α prog) (s :(α, γ, 'ffi) state). evaluate (Seq p1 (Skip :α prog),s) = evaluate (p1,s)
evaluate_Seq_assoc_typed=∀(p :α prog) (s :(α, γ, 'ffi) state). evaluate (Seq_assoc (Skip :α prog) p,s) = evaluate (p,s)
evaluate_Seq_assoc_lemma_typed=∀(p1 :α prog) (p2 :α prog) (s :(α, γ, 'ffi) state). evaluate (Seq_assoc p1 p2,s) = evaluate (Seq p1 p2,s)
evaluate_Skip_Seq_typed=evaluate (Seq (Skip :α prog) (p :α prog),(s :(α, γ, 'ffi) state)) = evaluate (p,s)
evaluate_SmartSeq_typed=evaluate (SmartSeq (p1 :α prog) (p2 :α prog),(s :(α, γ, 'ffi) state)) = evaluate (Seq p1 p2,s)
