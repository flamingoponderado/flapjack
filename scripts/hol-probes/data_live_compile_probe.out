is_pure_def_typed=(is_pure (FFI (v0 :mlstring) :op) ⇔ F) ∧ (is_pure (IntOp Add) ⇔ F) ∧ (is_pure (IntOp Sub) ⇔ F) ∧ (is_pure (IntOp Mult) ⇔ F) ∧ (is_pure (IntOp Div) ⇔ F) ∧ (is_pure (IntOp Mod) ⇔ F) ∧ (is_pure (IntOp Less) ⇔ F) ∧ (is_pure (IntOp LessEq) ⇔ F) ∧ (is_pure (WordOp (WordOpw W64 (v1 :opw))) ⇔ F) ∧ (is_pure (WordOp (WordShift W64 (v2 :shift) (v3 :num))) ⇔ F) ∧ (is_pure (WordOp WordFromInt) ⇔ F) ∧ (is_pure (WordOp WordToInt) ⇔ F) ∧ (is_pure (WordOp (WordFromWord (b :bool))) ⇔ F) ∧ (is_pure (WordOp (FP_uop (v4 :fp_uop))) ⇔ F) ∧ (is_pure (WordOp (FP_bop (v5 :fp_bop))) ⇔ F) ∧ (is_pure (WordOp (FP_top (v6 :fp_top))) ⇔ F) ∧ (is_pure (BlockOp (Build (v7 :const_part list))) ⇔ F) ∧ (is_pure (BlockOp (Cons (v8 :num) :block_op)) ⇔ F) ∧ (is_pure (BlockOp (ConsExtend (v9 :num))) ⇔ F) ∧ (is_pure (BlockOp (FromList (v10 :num))) ⇔ F) ∧ (is_pure (BlockOp ListAppend) ⇔ F) ∧ (is_pure (BlockOp Equal) ⇔ F) ∧ (is_pure (GlobOp (SetGlobal (v11 :num))) ⇔ F) ∧ (is_pure (GlobOp SetGlobalsPtr) ⇔ F) ∧ (is_pure (MemOp Ref) ⇔ F) ∧ (is_pure (MemOp (RefByte (v12 :bool))) ⇔ F) ∧ (is_pure (MemOp RefArray) ⇔ F) ∧ (is_pure (MemOp Update) ⇔ F) ∧ (is_pure (MemOp (MutCons (v13 :num) (v14 :num))) ⇔ F) ∧ (is_pure (MemOp UpdateCons) ⇔ F) ∧ (is_pure (MemOp FinaliseCons) ⇔ F) ∧ (is_pure (MemOp UpdateByte) ⇔ F) ∧ (is_pure (MemOp FromListByte) ⇔ F) ∧ (is_pure (MemOp (CopyByte (v15 :bool))) ⇔ F) ∧ (is_pure (MemOp XorByte) ⇔ F) ∧ (is_pure (MemOp ConfigGC) ⇔ F) ∧ (is_pure Install ⇔ F) ∧ (is_pure (ThunkOp (v16 :thunk_op) :op) ⇔ F) ∧ (is_pure (Label (v :num)) ⇔ T) ∧ (is_pure (IntOp (Const (v33 :int))) ⇔ T) ∧ (is_pure (IntOp Greater) ⇔ T) ∧ (is_pure (IntOp GreaterEq) ⇔ T) ∧ (is_pure (IntOp (LessConstSmall (v34 :num))) ⇔ T) ∧ (is_pure (WordOp (WordOpw W8 (v38 :opw))) ⇔ T) ∧ (is_pure (WordOp (WordShift W8 (v40 :shift) (v41 :num))) ⇔ T) ∧ (is_pure (WordOp (WordTest (v42 :word_size) (v43 :test))) ⇔ T) ∧ (is_pure (WordOp (FP_cmp (v45 :fp_cmp))) ⇔ T) ∧ (is_pure (BlockOp (ElemAt (v62 :num))) ⇔ T) ∧ (is_pure (BlockOp (TagLenEq (v63 :num) (v64 :num))) ⇔ T) ∧ (is_pure (BlockOp (LenEq (v65 :num))) ⇔ T) ∧ (is_pure (BlockOp (TagEq (v66 :num))) ⇔ T) ∧ (is_pure (BlockOp LengthBlock) ⇔ T) ∧ (is_pure (BlockOp (BoolTest (v67 :test))) ⇔ T) ∧ (is_pure (BlockOp BoolNot) ⇔ T) ∧ (is_pure (BlockOp BoundsCheckBlock) ⇔ T) ∧ (is_pure (BlockOp (Constant (v70 :const))) ⇔ T) ∧ (is_pure (BlockOp (EqualConst (v71 :const_part))) ⇔ T) ∧ (is_pure (GlobOp (Global (v85 :num))) ⇔ T) ∧ (is_pure (GlobOp AllocGlobal) ⇔ T) ∧ (is_pure (GlobOp GlobalsPtr) ⇔ T) ∧ (is_pure (MemOp El) ⇔ T) ∧ (is_pure (MemOp Length) ⇔ T) ∧ (is_pure (MemOp LengthByte) ⇔ T) ∧ (is_pure (MemOp DerefByte) ⇔ T) ∧ (is_pure (MemOp ConcatByteVec) ⇔ T) ∧ (is_pure (MemOp ToListByte) ⇔ T) ∧ (is_pure (MemOp LengthByteVec) ⇔ T) ∧ (is_pure (MemOp DerefByteVec) ⇔ T) ∧ (is_pure (MemOp (StringCmp (v91 :bool) (v92 :opb))) ⇔ T) ∧ (is_pure (MemOp BoundsCheckArray) ⇔ T) ∧ (is_pure (MemOp (BoundsCheckByte (v93 :bool))) ⇔ T)
compile_def_typed=(∀(live :sptree$num_set). compile Skip live = (Skip,live)) ∧ (∀(ns :num list) (live :sptree$num_set). compile (Return ns) live = (Return ns,list_insert ns (LN :sptree$num_set))) ∧ (∀(n :num) (live :sptree$num_set). compile (Raise n :prog) live = ((Raise n :prog),insert n () (LN :sptree$num_set))) ∧ (∀(n2 :num) (n1 :num) (live :sptree$num_set). compile (Move n1 n2) live = (Move n1 n2,insert n2 () (delete n1 live))) ∧ (∀(live :sptree$num_set) (c2 :prog) (c1 :prog). compile (Seq c1 c2) live = (let ((d2 :prog),(l2 :sptree$num_set)) = compile c2 live; ((d1 :prog),(l1 :sptree$num_set)) = compile c1 l2 in (Seq d1 d2,l1))) ∧ (∀(live :sptree$num_set). compile Tick live = (Tick,live)) ∧ (∀(names :sptree$num_set) (live :sptree$num_set) (k :num). compile (MakeSpace k names) live = (let (l1 :sptree$num_set) = inter names live in (MakeSpace k l1,l1))) ∧ (∀(vs :num list) (v :num) (op :op) (live :sptree$num_set). compile (Assign v op vs (NONE :sptree$num_set option)) live = if IS_NONE (lookup v live) ∧ is_pure op then (Skip,live) else (let (l1 :sptree$num_set) = list_insert vs (delete v live) in (Assign v op vs (NONE :sptree$num_set option),l1))) ∧ (∀(vs :num list) (v :num) (op :op) (names :sptree$num_set) (live :sptree$num_set). compile (Assign v op vs (SOME names)) live = (let (l1 :sptree$num_set) = inter names (delete v live) in (Assign v op vs (SOME l1),list_insert vs l1))) ∧ (∀(n :num) (live :sptree$num_set) (c3 :prog) (c2 :prog). compile (If n c2 c3 :prog) live = (let ((d3 :prog),(l3 :sptree$num_set)) = compile c3 live; ((d2 :prog),(l2 :sptree$num_set)) = compile c2 live in ((If n d2 d3 :prog),insert n () (union l2 l3)))) ∧ (∀(src :num) (loc :num) (live :sptree$num_set). compile (Force (NONE :(num # sptree$num_set) option) loc src :prog) live = ((Force (NONE :(num # sptree$num_set) option) loc src :prog),insert src () (LN :sptree$num_set))) ∧ (∀(src :num) (names :sptree$num_set) (n :num) (loc :num) (live :sptree$num_set). compile (Force (SOME (n,names)) loc src :prog) live = (let (l1 :sptree$num_set) = inter names (delete n live); (l2 :sptree$num_set) = insert src () l1 in ((Force (SOME (n,l1)) loc src :prog),l2))) ∧ (∀(vs :num list) (live :sptree$num_set) (handler :(num # prog) option) (dest :num option). compile (Call (NONE :(num list # sptree$num_set) option) dest vs handler :prog) live = ((Call (NONE :(num list # sptree$num_set) option) dest vs handler :prog),list_to_num_set vs)) ∧ (∀(vs :num list) (ns :num list) (names :sptree$num_set) (live :sptree$num_set) (dest :num option). compile (Call (SOME (ns,names)) dest vs (NONE :(num # prog) option) :prog) live = (let (l1 :sptree$num_set) = inter names (list_delete ns live); (l2 :sptree$num_set) = list_insert vs l1 in ((Call (SOME (ns,l1)) dest vs (NONE :(num # prog) option) :prog),l2))) ∧ ∀(vs :num list) (v :num) (ns :num list) (names :sptree$num_set) (live :sptree$num_set) (dest :num option) (c :prog). compile (Call (SOME (ns,names)) dest vs (SOME (v,c)) :prog) live = (let ((d :prog),(l3 :sptree$num_set)) = compile c live; (l0 :sptree$num_set) = union (list_delete ns live) (delete v l3); (l1 :sptree$num_set) = inter names l0; (l2 :sptree$num_set) = list_insert vs l1 in ((Call (SOME (ns,l1)) dest vs (SOME (v,d)) :prog),l2))
get_code_labels_compile_typed=∀(x :dataLang$prog) (y :sptree$num_set). get_code_labels (FST (compile x y :dataLang$prog # sptree$num_set)) ⊆ get_code_labels x
