find_code_independent_carriers_typed=(∀(n :num) (v :num # α prog). (lookup n (st :(α, β, γ) state).code :(num # α prog) option) = SOME v ⇒ ∃(t :bool) (k :num) (a :num) (c :α asm_config) (col :num sptree$num_map option). (lookup n (l :(num # α prog) sptree$num_map) :(num # α prog) option) = SOME (SND (compile_single t k a c ((n,v),col)))) ∧ find_code (o1 :num option) (add_ret_loc (o' :(ε # ζ # η # num # num) option) (x :δ word_loc list)) st.code st.stack_size = SOME ((args :δ word_loc list),(prog :α prog),(locsize :num option)) ⇒ ∃(t :bool) (k :num) (a :num) (c :α asm_config) (col :num sptree$num_map option) (n :num) (prog' :α prog). SND (compile_single t k a c ((n,LENGTH args,prog),col)) = (LENGTH args,prog') ∧ find_code o1 (add_ret_loc o' x) l st.stack_size = SOME (args,prog',locsize)
find_code_independent_carriers_hypotheses=0
