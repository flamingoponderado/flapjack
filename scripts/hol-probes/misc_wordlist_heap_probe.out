wl_def=(∀a. word_list a [] = emp) ∧ ∀a x xs. word_list a (x::xs) = one (a,x) * word_list (a + bytes_in_word) xs
wl_type=:α word -> β list -> (α word # β -> bool) -> bool
we_def=∀a n. word_list_exists a n = SEP_EXISTS xs. word_list a xs * cond (LENGTH xs = n)
we_type=:α word -> num -> (α word # β -> bool) -> bool
wl_empty=T
