store_pos_full_def=∀name. store_pos name = case INDEX_FIND 0 (λn. n = name) store_list of NONE => 0 | SOME (i,v2) => i + 1
store_pos_type=:store_name -> num
store_offset_full_def=∀name. store_offset name = 0w − word_offset (store_pos name)
store_offset_type=:store_name -> α word
