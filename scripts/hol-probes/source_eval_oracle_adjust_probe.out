 s p v env ⇒ P0 envC s (Ptannot p t) v env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v21 :lit) (v39 :stamp option) (v40 :v list) (env :(mlstring # v) list). P0 envC s (Plit v21) (Conv v39 v40) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v21 :lit) (v41 :v sem_env) (v42 :mlstring) (v43 :exp) (env :(mlstring # v) list). P0 envC s (Plit v21) (Closure v41 v42 v43) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v21 :lit) (v44 :v sem_env) (v45 :(mlstring # mlstring # exp) list) (v46 :mlstring) (env :(mlstring # v) list). P0 envC s (Plit v21) (Recclosure v44 v45 v46) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v21 :lit) (v47 :bool) (v48 :num) (env :(mlstring # v) list). P0 envC s (Plit v21) (Loc v47 v48) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v21 :lit) (v49 :v list) (env :(mlstring # v) list). P0 envC s (Plit v21) (Vectorv v49) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v21 :lit) (v50 :v sem_env) (v51 :num # num) (env :(mlstring # v) list). P0 envC s (Plit v21) (Env v50 v51) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v22 :(mlstring, mlstring) id option) (v23 :pat list) (v66 :lit) (env :(mlstring # v) list). P0 envC s (Pcon v22 v23) (Litv v66) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v96 :(mlstring, mlstring) id) (v23 :pat list) (v68 :v list) (env :(mlstring # v) list). P0 envC s (Pcon (SOME v96) v23) (Conv (NONE :stamp option) v68) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v23 :pat list) (v94 :stamp) (v68 :v list) (env :(mlstring # v) list). P0 envC s (Pcon (NONE :(mlstring, mlstring) id option) v23) (Conv (SOME v94) v68) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v22 :(mlstring, mlstring) id option) (v23 :pat list) (v69 :v sem_env) (v70 :mlstring) (v71 :exp) (env :(mlstring # v) list). P0 envC s (Pcon v22 v23) (Closure v69 v70 v71) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v22 :(mlstring, mlstring) id option) (v23 :pat list) (v72 :v sem_env) (v73 :(mlstring # mlstring # exp) list) (v74 :mlstring) (env :(mlstring # v) list). P0 envC s (Pcon v22 v23) (Recclosure v72 v73 v74) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v22 :(mlstring, mlstring) id option) (v23 :pat list) (v75 :bool) (v76 :num) (env :(mlstring # v) list). P0 envC s (Pcon v22 v23) (Loc v75 v76) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v22 :(mlstring, mlstring) id option) (v23 :pat list) (v77 :v list) (env :(mlstring # v) list). P0 envC s (Pcon v22 v23) (Vectorv v77) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v22 :(mlstring, mlstring) id option) (v23 :pat list) (v78 :v sem_env) (v79 :num # num) (env :(mlstring # v) list). P0 envC s (Pcon v22 v23) (Env v78 v79) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v24 :pat) (v100 :lit) (env :(mlstring # v) list). P0 envC s (Pref v24) (Litv v100) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v24 :pat) (v101 :stamp option) (v102 :v list) (env :(mlstring # v) list). P0 envC s (Pref v24) (Conv v101 v102) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v24 :pat) (v103 :v sem_env) (v104 :mlstring) (v105 :exp) (env :(mlstring # v) list). P0 envC s (Pref v24) (Closure v103 v104 v105) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v24 :pat) (v106 :v sem_env) (v107 :(mlstring # mlstring # exp) list) (v108 :mlstring) (env :(mlstring # v) list). P0 envC s (Pref v24) (Recclosure v106 v107 v108) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v24 :pat) (v111 :v list) (env :(mlstring # v) list). P0 envC s (Pref v24) (Vectorv v111) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v24 :pat) (v112 :v sem_env) (v113 :num # num) (env :(mlstring # v) list). P0 envC s (Pref v24) (Env v112 v113) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (env :(mlstring # v) list). P1 envC s ([] :pat list) ([] :v list) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (p :pat) (ps :pat list) (v :v) (vs :v list) (env :(mlstring # v) list). (∀(env' :(mlstring # v) list). pmatch envC s p v env = Match env' ⇒ P1 envC s ps vs env') ∧ P0 envC s p v env ∧ (pmatch envC s p v env = (No_match :(mlstring # v) list match_result) ⇒ P1 envC s ps vs env) ⇒ P1 envC s (p::ps) (v::vs) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v140 :pat) (v141 :pat list) (env :(mlstring # v) list). P1 envC s (v140::v141) ([] :v list) env) ∧ (∀(envC :(mlstring, mlstring, num # stamp) namespace) (s :v store_v list) (v136 :v) (v137 :v list) (env :(mlstring # v) list). P1 envC s ([] :pat list) (v136::v137) env) ⇒ (∀(v0 :(mlstring, mlstring, num # stamp) namespace) (v1 :v store_v list) (v2 :pat) (v3 :v) (v4 :(mlstring # v) list). P0 v0 v1 v2 v3 v4) ∧ ∀(v0 :(mlstring, mlstring, num # stamp) namespace) (v1 :v store_v list) (v2 :pat list) (v3 :v list) (v4 :(mlstring # v) list). P1 v0 v1 v2 v3 v4
product_relation_definition=∀(R1 :α -> β -> bool) (R2 :γ -> δ -> bool). R1 ### R2 = (λ((s :α),(t :γ)) ((u :β),(v :δ)). R1 s u ∧ R2 t v)
source_pmatch_drule_replay=pmatch (env :v sem_env).c (s :α semanticPrimitives$state).refs (p :pat) (x :v) ([] :(mlstring # v) list) = (res :(mlstring # v) list match_result) ∧ s_rel (ci :β compiler_instance) s (t :α semanticPrimitives$state) ∧ env_rel (v_rel (orac_s t.eval_state)) env (env' :v sem_env) ∧ v_rel (orac_s t.eval_state) x (y :v) ⇒ match_result_rel T (LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel (orac_s t.eval_state))) res (pmatch env'.c t.refs p y ([] :(mlstring # v) list))
source_can_pmatch_all=can_pmatch_all (env :v sem_env).c (s :α semanticPrimitives$state).refs (pats :pat list) (x :v) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ env_rel (v_rel (orac_s t.eval_state)) env (env' :v sem_env) ∧ v_rel (orac_s t.eval_state) x (y :v) ⇒ can_pmatch_all env'.c t.refs pats y
source_num_injective=(0 :int) ≤ (i :int) ∧ (0 :int) ≤ (j :int) ⇒ (Num i = Num j ⇔ i = j)
source_do_eq_simulation=(∀(x :v) (y :v) (x' :v) (y' :v) (b :bool). do_eq x y = Eq_val b ∧ v_rel (es :eval_oracle_state) x x' ∧ v_rel es y y' ⇒ do_eq x' y' = Eq_val b) ∧ ∀(xs :v list) (ys :v list) (xs' :v list) (ys' :v list) (b :bool). do_eq_list xs ys = Eq_val b ∧ LIST_REL (v_rel es) xs xs' ∧ LIST_REL (v_rel es) ys ys' ⇒ do_eq_list xs' ys' = Eq_val b
source_do_eq_induction=∀(P0 :v -> v -> bool) (P1 :v list -> v list -> bool). (∀(l1 :lit) (l2 :lit). P0 (Litv l1) (Litv l2)) ∧ (∀(b1 :bool) (l1 :num) (b2 :bool) (l2 :num). P0 (Loc b1 l1) (Loc b2 l2)) ∧ (∀(cn1 :stamp option) (vs1 :v list) (cn2 :stamp option) (vs2 :v list). (cn1 = cn2 ∧ LENGTH vs1 = LENGTH vs2 ⇒ P1 vs1 vs2) ⇒ P0 (Conv cn1 vs1) (Conv cn2 vs2)) ∧ (∀(vs1 :v list) (vs2 :v list). (LENGTH vs1 = LENGTH vs2 ⇒ P1 vs1 vs2) ⇒ P0 (Vectorv vs1) (Vectorv vs2)) ∧ (∀(v0 :v sem_env) (v3 :mlstring) (v4 :exp) (v5 :v sem_env) (v6 :mlstring) (v7 :exp). P0 (Closure v0 v3 v4) (Closure v5 v6 v7)) ∧ (∀(v8 :v sem_env) (v9 :mlstring) (v10 :exp) (v11 :v sem_env) (v12 :(mlstring # mlstring # exp) list) (v13 :mlstring). P0 (Closure v8 v9 v10) (Recclosure v11 v12 v13)) ∧ (∀(v14 :v sem_env) (v15 :(mlstring # mlstring # exp) list) (v16 :mlstring) (v17 :v sem_env) (v18 :mlstring) (v19 :exp). P0 (Recclosure v14 v15 v16) (Closure v17 v18 v19)) ∧ (∀(v20 :v sem_env) (v21 :(mlstring # mlstring # exp) list) (v22 :mlstring) (v23 :v sem_env) (v24 :(mlstring # mlstring # exp) list) (v25 :mlstring). P0 (Recclosure v20 v21 v22) (Recclosure v23 v24 v25)) ∧ (∀(v26 :v sem_env) (gen1 :num) (id1 :num) (v27 :v sem_env) (gen2 :num) (id2 :num). P0 (Env v26 (gen1,id1)) (Env v27 (gen2,id2))) ∧ (∀(v35 :lit) (v64 :stamp option) (v65 :v list). P0 (Litv v35) (Conv v64 v65)) ∧ (∀(v35 :lit) (v66 :v sem_env) (v67 :mlstring) (v68 :exp). P0 (Litv v35) (Closure v66 v67 v68)) ∧ (∀(v35 :lit) (v69 :v sem_env) (v70 :(mlstring # mlstring # exp) list) (v71 :mlstring). P0 (Litv v35) (Recclosure v69 v70 v71)) ∧ (∀(v35 :lit) (v72 :bool) (v73 :num). P0 (Litv v35) (Loc v72 v73)) ∧ (∀(v35 :lit) (v74 :v list). P0 (Litv v35) (Vectorv v74)) ∧ (∀(v35 :lit) (v75 :v sem_env) (v76 :num # num). P0 (Litv v35) (Env v75 v76)) ∧ (∀(v36 :stamp option) (v37 :v list) (v91 :lit). P0 (Conv v36 v37) (Litv v91)) ∧ (∀(v36 :stamp option) (v37 :v list) (v94 :v sem_env) (v95 :mlstring) (v96 :exp). P0 (Conv v36 v37) (Closure v94 v95 v96)) ∧ (∀(v36 :stamp option) (v37 :v list) (v97 :v sem_env) (v98 :(mlstring # mlstring # exp) list) (v99 :mlstring). P0 (Conv v36 v37) (Recclosure v97 v98 v99)) ∧ (∀(v36 :stamp option) (v37 :v list) (v100 :bool) (v101 :num). P0 (Conv v36 v37) (Loc v100 v101)) ∧ (∀(v36 :stamp option) (v37 :v list) (v102 :v list). P0 (Conv v36 v37) (Vectorv v102)) ∧ (∀(v36 :stamp option) (v37 :v list) (v103 :v sem_env) (v104 :num # num). P0 (Conv v36 v37) (Env v103 v104)) ∧ (∀(v38 :v sem_env) (v39 :mlstring) (v40 :exp) (v119 :lit). P0 (Closure v38 v39 v40) (Litv v119)) ∧ (∀(v38 :v sem_env) (v39 :mlstring) (v40 :exp) (v120 :stamp option) (v121 :v list). P0 (Closure v38 v39 v40) (Conv v120 v121)) ∧ (∀(v38 :v sem_env) (v39 :mlstring) (v40 :exp) (v128 :bool) (v129 :num). P0 (Closure v38 v39 v40) (Loc v128 v129)) ∧ (∀(v38 :v sem_env) (v39 :mlstring) (v40 :exp) (v130 :v list). P0 (Closure v38 v39 v40) (Vectorv v130)) ∧ (∀(v38 :v sem_env) (v39 :mlstring) (v40 :exp) (v131 :v sem_env) (v132 :num # num). P0 (Closure v38 v39 v40) (Env v131 v132)) ∧ (∀(v41 :v sem_env) (v42 :(mlstring # mlstring # exp) list) (v43 :mlstring) (v147 :lit). P0 (Recclosure v41 v42 v43) (Litv v147)) ∧ (∀(v41 :v sem_env) (v42 :(mlstring # mlstring # exp) list) (v43 :mlstring) (v148 :stamp option) (v149 :v list). P0 (Recclosure v41 v42 v43) (Conv v148 v149)) ∧ (∀(v41 :v sem_env) (v42 :(mlstring # mlstring # exp) list) (v43 :mlstring) (v156 :bool) (v157 :num). P0 (Recclosure v41 v42 v43) (Loc v156 v157)) ∧ (∀(v41 :v sem_env) (v42 :(mlstring # mlstring # exp) list) (v43 :mlstring) (v158 :v list). P0 (Recclosure v41 v42 v43) (Vectorv v158)) ∧ (∀(v41 :v sem_env) (v42 :(mlstring # mlstring # exp) list) (v43 :mlstring) (v159 :v sem_env) (v160 :num # num). P0 (Recclosure v41 v42 v43) (Env v159 v160)) ∧ (∀(v44 :bool) (v45 :num) (v175 :lit). P0 (Loc v44 v45) (Litv v175)) ∧ (∀(v44 :bool) (v45 :num) (v176 :stamp option) (v177 :v list). P0 (Loc v44 v45) (Conv v176 v177)) ∧ (∀(v44 :bool) (v45 :num) (v178 :v sem_env) (v179 :mlstring) (v180 :exp). P0 (Loc v44 v45) (Closure v178 v179 v180)) ∧ (∀(v44 :bool) (v45 :num) (v181 :v sem_env) (v182 :(mlstring # mlstring # exp) list) (v183 :mlstring). P0 (Loc v44 v45) (Recclosure v181 v182 v183)) ∧ (∀(v44 :bool) (v45 :num) (v186 :v list). P0 (Loc v44 v45) (Vectorv v186)) ∧ (∀(v44 :bool) (v45 :num) (v187 :v sem_env) (v188 :num # num). P0 (Loc v44 v45) (Env v187 v188)) ∧ (∀(v46 :v list) (v203 :lit). P0 (Vectorv v46) (Litv v203)) ∧ (∀(v46 :v list) (v204 :stamp option) (v205 :v list). P0 (Vectorv v46) (Conv v204 v205)) ∧ (∀(v46 :v list) (v206 :v sem_env) (v207 :mlstring) (v208 :exp). P0 (Vectorv v46) (Closure v206 v207 v208)) ∧ (∀(v46 :v list) (v209 :v sem_env) (v210 :(mlstring # mlstring # exp) list) (v211 :mlstring). P0 (Vectorv v46) (Recclosure v209 v210 v211)) ∧ (∀(v46 :v list) (v212 :bool) (v213 :num). P0 (Vectorv v46) (Loc v212 v213)) ∧ (∀(v46 :v list) (v215 :v sem_env) (v216 :num # num). P0 (Vectorv v46) (Env v215 v216)) ∧ (∀(v47 :v sem_env) (v48 :num # num) (v231 :lit). P0 (Env v47 v48) (Litv v231)) ∧ (∀(v47 :v sem_env) (v48 :num # num) (v232 :stamp option) (v233 :v list). P0 (Env v47 v48) (Conv v232 v233)) ∧ (∀(v47 :v sem_env) (v48 :num # num) (v234 :v sem_env) (v235 :mlstring) (v236 :exp). P0 (Env v47 v48) (Closure v234 v235 v236)) ∧ (∀(v47 :v sem_env) (v48 :num # num) (v237 :v sem_env) (v238 :(mlstring # mlstring # exp) list) (v239 :mlstring). P0 (Env v47 v48) (Recclosure v237 v238 v239)) ∧ (∀(v47 :v sem_env) (v48 :num # num) (v240 :bool) (v241 :num). P0 (Env v47 v48) (Loc v240 v241)) ∧ (∀(v47 :v sem_env) (v48 :num # num) (v242 :v list). P0 (Env v47 v48) (Vectorv v242)) ∧ P1 ([] :v list) ([] :v list) ∧ (∀(v1 :v) (vs1 :v list) (v2 :v) (vs2 :v list). (∀(r :bool). do_eq v1 v2 = Eq_val r ∧ ¬¬r ⇒ P1 vs1 vs2) ∧ P0 v1 v2 ⇒ P1 (v1::vs1) (v2::vs2)) ∧ (∀(v273 :v) (v274 :v list). P1 ([] :v list) (v273::v274)) ∧ (∀(v269 :v) (v270 :v list). P1 (v269::v270) ([] :v list)) ⇒ (∀(v0 :v) (v1 :v). P0 v0 v1) ∧ ∀(v0 :v list) (v1 :v list). P1 v0 v1
source_store_assign=store_assign (lnum :num) (sv :α store_v) (refs :α store_v list) = SOME (refs2 :α store_v list) ∧ LIST_REL (sv_rel (R :α -> β -> bool)) refs (refs3 :β store_v list) ∧ sv_rel R sv (sv' :β store_v) ⇒ ∃(refs4 :β store_v list). LIST_REL (sv_rel R) refs2 refs4 ∧ store_assign lnum sv' refs3 = SOME refs4
source_store_lookup=LIST_REL (sv_rel (R :α -> β -> bool)) (refs :α store_v list) (refs' :β store_v list) ∧ store_lookup (n :num) refs = SOME (sv :α store_v) ⇒ ∃(sv' :β store_v). sv_rel R sv sv' ∧ store_lookup n refs' = SOME sv'
source_value_relation_list_encoding=∀(xs :v list) (ys :v list). v_rel (es :eval_oracle_state) (list_to_v xs) (list_to_v ys) ⇔ LIST_REL (v_rel es) xs ys
source_value_to_list_relation=∀(x :v) (y :v) (xs :v list). v_to_list x = SOME xs ∧ v_rel (es :eval_oracle_state) x y ⇒ ∃(ys :v list). v_to_list y = SOME ys ∧ LIST_REL (v_rel es) xs ys
source_value_to_char_list_relation=∀(x :v) (y :v) (xs :string). v_to_char_list x = SOME xs ∧ v_rel (es :eval_oracle_state) x y ⇒ v_to_char_list y = SOME xs
source_values_to_string_relation=∀(xs :v list) (ys :v list) (s :mlstring). vs_to_string xs = SOME s ∧ LIST_REL (v_rel (es :eval_oracle_state)) xs ys ⇒ vs_to_string ys = SOME s
source_store_value_relation_left_cases=(∀(v :β store_v) (rv :α) (R :α -> β -> bool). sv_rel R (Refv rv) v ⇔ ∃(v2 :β). v = Refv v2 ∧ R rv v2) ∧ (∀(xs :word8 list) (v :β store_v) (R :α -> β -> bool). sv_rel R (W8array xs :α store_v) v ⇔ v = (W8array xs :β store_v)) ∧ ∀(vs :α list) (v :β store_v) (R :α -> β -> bool). sv_rel R (Varray vs) v ⇔ ∃(vs2 :β list). v = Varray vs2 ∧ LIST_REL R vs vs2
source_v_rel_check_type_replay=v_rel (x :eval_oracle_state) (v1 :v) (v2 :v) ⇒ (check_type (ty :prim_type) v1 ⇔ check_type ty v2) ∧ dest_Litv v1 = dest_Litv v2
source_list_rel_check_type_replay=LIST_REL (v_rel (x :eval_oracle_state)) (vs1 :v list) (vs2 :v list) ⇒ (EVERY (check_type (ty :prim_type)) vs1 ⇔ EVERY (check_type ty) vs2)
source_state_relation_clock=s_rel (ci :'cfg compiler_instance) (s :α semanticPrimitives$state) (t :α semanticPrimitives$state) ⇒ s.clock = t.clock ∧ s_rel ci (dec_clock s) (dec_clock t)
source_concrete_value_relation=∀(x :v) (y :v). v_rel (es :eval_oracle_state) x y ⇒ concrete_v x ⇒ y = x
extend_declaration_environment_assoc=∀(env1 :v sem_env) (env2 :v sem_env) (env3 :v sem_env). ((env1 +++ ((env2 +++ env3) :v sem_env)) :v sem_env) = ((((env1 +++ env2) :v sem_env) +++ env3) :v sem_env)
source_do_opapp_cases=∀(env' :v sem_env) (vs :v list) (v :exp). do_opapp vs = SOME (env',v) ⇔ (∃(v2 :v) (env'' :v sem_env) (n :mlstring) (e :exp). vs = [Closure env'' n e; v2] ∧ env' = env'' with v := nsBind n v2 env''.v ∧ v = e) ∨ ∃(v2 :v) (env'' :v sem_env) (funs :(mlstring # mlstring # exp) list) (n' :mlstring) (n'' :mlstring) (e :exp). vs = [Recclosure env'' funs n'; v2] ∧ find_recfun n' funs = SOME (n'',e) ∧ ALL_DISTINCT (MAP (λ((f :mlstring),(x :mlstring),(e :exp)). f) funs) ∧ env' = env'' with v := nsBind n'' v2 (build_rec_env funs env'' env''.v) ∧ v = e
source_do_app_simulation=do_app ((s :α semanticPrimitives$state).refs,s.ffi) (op :op) (REVERSE (xs :v list)) = SOME (((refs :v store_v list),(ffi :α ffi_state)),(r :(v, v) result)) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ LIST_REL (v_rel (orac_s t.eval_state)) xs (ys :v list) ∧ r ≠ (Rerr (Rabort Rtype_error :v error_result) :(v, v) result) ⇒ ∃(ref1 :β) (refs' :v store_v list) (r' :(v, v) result) (es :eval_oracle_state). es = orac_s t.eval_state ∧ do_app (t.refs,t.ffi) op (REVERSE ys) = SOME ((refs',ffi),r') ∧ LIST_REL (sv_rel (v_rel es)) refs refs' ∧ result_rel (v_rel es) (v_rel es) r r'
source_abort_definition=∀(r :(α, β) result). abort r ⇔ case r of (Rval v2 :(α, β) result) => F | (Rerr (Rraise v6) :(α, β) result) => F | (Rerr (Rabort a :β error_result) :(α, β) result) => T
source_abort_simps=(abort (Rerr (Rabort (a :abort) :β error_result) :(α, β) result) ⇔ T) ∧ (abort (Rerr (Rraise (e :δ)) :(γ, δ) result) ⇔ F) ∧ (abort (Rval (v :ε) :(ε, ζ) result) ⇔ F)
source_abort_imp_intro_replay=(∀(v :α). (x :(α, β) result) = (Rval v :(α, β) result) ⇒ (P :bool)) ∧ (∀(e :β). x = (Rerr (Rraise e) :(α, β) result) ⇒ P) ⇒ ¬abort x ⇒ P
source_eval_simulation=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result) (es :α) (t :'ffi semanticPrimitives$state) (env' :v sem_env). evaluate s env exps = (s',res) ∧ s_rel (ci :'cfg compiler_instance) s t ∧ env_rel (v_rel (orac_s t.eval_state)) env env' ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(es' :eval_oracle_state) (t' :'ffi semanticPrimitives$state) (res' :(v list, v) result). evaluate t env' exps = (t',res') ∧ s_rel ci s' t' ∧ es' = orac_s t'.eval_state ∧ result_rel (LIST_REL (v_rel es')) (v_rel es') res res' ∧ es_forward (orac_s t.eval_state) es' ∧ (¬abort res' ⇒ es_stack_forward (orac_s t.eval_state) es')) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result) (es :eval_oracle_state) (t :'ffi semanticPrimitives$state) (env' :v sem_env) (y :v) (err_y :v). evaluate_match s env x pes err_x = (s',res) ∧ s_rel ci s t ∧ es = orac_s t.eval_state ∧ env_rel (v_rel es) env env' ∧ v_rel es x y ∧ v_rel es err_x err_y ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(es' :eval_oracle_state) (t' :'ffi semanticPrimitives$state) (res' :(v list, v) result). evaluate_match t env' y pes err_y = (t',res') ∧ s_rel ci s' t' ∧ es' = orac_s t'.eval_state ∧ result_rel (LIST_REL (v_rel es')) (v_rel es') res res' ∧ es_forward es es' ∧ (¬abort res' ⇒ es_stack_forward es es')) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (decs :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result) (t :'ffi semanticPrimitives$state) (env' :v sem_env). evaluate_decs s env decs = (s',res) ∧ s_rel ci s t ∧ env_rel (v_rel (orac_s t.eval_state)) env env' ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ ∃(es' :eval_oracle_state) (t' :'ffi semanticPrimitives$state) (res' :(v sem_env, v) result). evaluate_decs t env' decs = (t',res') ∧ s_rel ci s' t' ∧ es' = orac_s t'.eval_state ∧ result_rel (env_rel (v_rel es')) (v_rel es') res res' ∧ es_forward (orac_s t.eval_state) es' ∧ (¬abort res' ⇒ es_stack_forward (orac_s t.eval_state) es')
source_check_dup_ctors_thm=check_dup_ctors ((tvs :mlstring list),(tn :mlstring),(condefs :(mlstring # ast_t list) list)) ⇔ ALL_DISTINCT (MAP (FST :mlstring # ast_t list -> mlstring) condefs)
source_do_eval_simulation=do_eval (REVERSE (xs :v list)) (s :α semanticPrimitives$state).eval_state = SOME ((env :v sem_env),(decs :dec list),(es :eval_state option)) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ LIST_REL (v_rel (orac_s t.eval_state)) xs (ys :v list) ⇒ ∃(env' :v sem_env) (es' :eval_state option). es_forward (orac_s t.eval_state) (orac_s es') ∧ do_eval (REVERSE ys) t.eval_state = SOME (env',decs,es') ∧ env_rel (v_rel (orac_s es')) env env' ∧ s_rel ci (s with eval_state := es) (t with eval_state := es') ∧ ∀(s2 :α semanticPrimitives$state) (t2 :α semanticPrimitives$state). s_rel ci s2 t2 ∧ es_forward (orac_s es') (orac_s t2.eval_state) ∧ es_stack_forward (orac_s es') (orac_s t2.eval_state) ⇒ es_forward (orac_s t2.eval_state) (orac_s (reset_env_generation t.eval_state t2.eval_state)) ∧ s_rel ci (s2 with eval_state := reset_env_generation s.eval_state s2.eval_state) (t2 with eval_state := reset_env_generation t.eval_state t2.eval_state) ∧ es_stack_forward (orac_s t.eval_state) (orac_s (reset_env_generation t.eval_state t2.eval_state))
source_declare_env_simulation=declare_env (s :α semanticPrimitives$state).eval_state (env :v sem_env) = SOME ((v :v),(es :eval_state option)) ∧ s_rel (ci :'cfg compiler_instance) s (t :α semanticPrimitives$state) ∧ env_rel (v_rel (orac_s t.eval_state)) env (env' :v sem_env) ⇒ ∃(v' :v) (es2 :eval_state option). es_forward (orac_s t.eval_state) (orac_s es2) ∧ declare_env t.eval_state env' = SOME (v',es2) ∧ v_rel (orac_s es2) v v' ∧ s_rel ci (s with eval_state := es) (t with eval_state := es2) ∧ es_stack_forward (orac_s t.eval_state) (orac_s es2)
source_pairarg_to_pair_map=(λ((x :α),(y :β)). ((f :α -> γ) x,(g :β -> δ) y)) = f ## g
