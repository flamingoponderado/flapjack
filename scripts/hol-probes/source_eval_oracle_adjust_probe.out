[d1] = (st1,v1) ∧ v1 = (Rval env1 :(v sem_env, v) result) ⇒ P2 st1 ((env1 +++ env) :v sem_env) (d2::ds)) ∧ P2 st env [d1] ⇒ P2 st env (d1::d2::ds)) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (locs :locs) (p :pat) (e :exp). (ALL_DISTINCT (pat_bindings p) ∧ every_exp (one_con_check env.c) e ⇒ P0 st env [e]) ⇒ P2 st env [Dlet locs p e]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (locs :locs) (funs :(mlstring # mlstring # exp) list). P2 st env [Dletrec locs funs]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (locs :locs) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list). P2 st env [Dtype locs tds]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (locs :locs) (tvs :mlstring list) (tn :mlstring) (t :ast_t). P2 st env [Dtabbrev locs tvs tn t]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (n :mlstring). P2 st env [Denv n]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (locs :locs) (cn :mlstring) (ts :ast_t list). P2 st env [Dexn locs cn ts]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (mn :mlstring) (ds :dec list). P2 st env ds ⇒ P2 st env [Dmod mn ds]) ∧ (∀(st :'ffi semanticPrimitives$state) (env :v sem_env) (lds :dec list) (ds :dec list). (∀(st1 :'ffi semanticPrimitives$state) (v1 :(v sem_env, v) result) (env1 :v sem_env). evaluate_decs st env lds = (st1,v1) ∧ v1 = (Rval env1 :(v sem_env, v) result) ⇒ P2 st1 ((env1 +++ env) :v sem_env) ds) ∧ P2 st env lds ⇒ P2 st env [Dlocal lds ds]) ⇒ (∀(v0 :'ffi semanticPrimitives$state) (v1 :v sem_env) (v2 :exp list). P0 v0 v1 v2) ∧ (∀(v0 :'ffi semanticPrimitives$state) (v1 :v sem_env) (v2 :v) (v3 :(pat # exp) list) (v4 :v). P1 v0 v1 v2 v3 v4) ∧ ∀(v0 :'ffi semanticPrimitives$state) (v1 :v sem_env) (v2 :dec list). P2 v0 v1 v2
ci_compiler_type=:α compiler_instance -> (num # num) # α # dec list -> (α # word8 list # word64 list) option
ci_config_value_type=:α compiler_instance -> α -> v
ci_config_domain_type=:α compiler_instance -> α -> bool
ci_decs_value_type=:α compiler_instance -> dec list -> v
ci_decs_domain_type=:α compiler_instance -> dec list -> bool
ci_initial_type=:α compiler_instance -> α
adjust_ev_decs_replay=∀(env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs s env ((compile_decs :dec list -> dec list) ds) = (s',res)) ⇒ evaluate_decs ((s :'ffi semanticPrimitives$state) with clock := (k :num)) env ds = (s',res) ∧ is_insert_oracle (ci :α compiler_instance) (f :dec list -> dec list) s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate_decs (s with <|clock := k; eval_state updated_by adjust_oracle ci (compile_decs ∘ f)|>) env ds = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)
result_rel_cases=result_rel (r_rel :α -> β -> bool) (e_rel :γ -> δ -> bool) (r :(α, γ) result) (r' :(β, δ) result) ⇒ (∃(x :α). r = (Rval x :(α, γ) result)) ∨ (∃(y :γ). r = (Rerr (Rraise y) :(α, γ) result)) ∨ ∃(a :abort). r = (Rerr (Rabort a :γ error_result) :(α, γ) result)
oleast_definition=∀(P :num -> bool). $OLEAST P = if ∃(n :num). P n then SOME (LEAST(n :num). P n) else (NONE :num option)
oleast_intro=((∀(n :num). ¬(P :num -> bool) n) ⇒ (Q :num option -> bool) (NONE :num option)) ∧ (∀(n :num). P n ∧ (∀(m :num). m < n ⇒ ¬P m) ⇒ Q (SOME n)) ⇒ Q ($OLEAST P)
least_exists_imp=∀(p :num -> bool). (∃(n :num). p n) ⇒ p ($LEAST p) ∧ ∀(n :num). n < $LEAST p ⇒ ¬p n
recorded_oracle_wf=∀(compiler :(num # num) # v # dec list -> (v # α) option) (orac :num -> (num # num) # v # dec list). recorded_orac_wf compiler orac ⇔ ((0 :num) < FST (FST (orac (0 :num))) ⇒ ∃(r :v # α). compiler (orac (FST (FST (orac (0 :num))))) = SOME r ∧ FST (SND (orac (0 :num))) = FST r) ∧ ∀(j :num). j < FST (FST (orac (0 :num))) ∧ (0 :num) < j ⇒ ∃(r :v # α). compiler (orac j) = SOME r ∧ FST (SND (orac (j + (1 :num)))) = FST r
oracle_state_projection=orac_s (SOME (EvalOracle (es :eval_oracle_state))) = es ∧ orac_s (NONE :eval_state option) = (ARB "not EvalOracle" :eval_oracle_state) ∧ orac_s (SOME (EvalDecs (v2 :eval_decs_state))) = (ARB "not EvalOracle" :eval_oracle_state)
oracle_arb_type=:string -> eval_oracle_state
oracle_arb_argument_type=:string
extract_oracle=∀(s :α semanticPrimitives$state) (env :v sem_env) (decs :dec list) (n :num). extract_oracle s env decs n = case OLEAST(k :num). ∃(s' :α semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs (s with clock := k) env decs = (s',res) ∧ n < FST (FST ((orac_s s'.eval_state).oracle (0 :num) :(num # num) # v # dec list)) of (NONE :num option) => (NONE :((num # num) # v # dec list) option) | SOME k => (let ((s' :α semanticPrimitives$state),(_0 :(v sem_env, v) result)) = evaluate_decs (s with clock := k) env decs in SOME ((orac_s s'.eval_state).oracle (n + (1 :num)) :(num # num) # v # dec list))
get_oracle=∀(ci :α compiler_instance) (s :β semanticPrimitives$state) (env :v sem_env) (decs :dec list). get_oracle ci s env decs = (let (es_record :eval_state) = EvalOracle <|oracle := (K (((0 :num),(0 :num)),ci.config_v ci.init_state,([] :dec list)) :num -> (num # num) # v # dec list); custom_do_eval := do_eval_record ci; envs := [([] :v sem_env list)]; generation := (0 :num)|> in extract_oracle (s with eval_state := SOME es_record) env decs)
put_oracle=∀(ci :α compiler_instance) (orac :num -> (num # num) # v # dec list). put_oracle ci orac = insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac (SOME (EvalOracle <|oracle := (K (((0 :num),(0 :num)),ci.config_v ci.init_state,([] :dec list)) :num -> (num # num) # v # dec list); custom_do_eval := do_eval_record ci; envs := [([] :v sem_env list)]; generation := (0 :num)|>))
precond_eval_state=∀(orac :num -> (num # num) # v # dec list) (ci :α compiler_instance) (s :β semanticPrimitives$state) (env :v sem_env) (decs :dec list). precond_eval_state orac ci s env decs ⇔ case s.eval_state of (NONE :eval_state option) => T | SOME (EvalDecs eds) => EvalDecs eds = mk_init_eval_state ci ∧ orac_extended_wf (mk_compiler_fun_from_ci ci) orac ∧ ∀(i :num) (r :(num # num) # v # dec list) (x :v # word8 list # word64 list). get_oracle ci s env decs i = SOME r ∧ mk_compiler_fun_from_ci ci r = SOME x ⇒ orac i = r | SOME (EvalOracle v2) => F
alist_lookup_append=∀(l1 :(α # β) list) (l2 :(α # β) list) (k :α). ALOOKUP (l1 ++ l2) k = case ALOOKUP l1 k of (NONE :β option) => ALOOKUP l2 k | SOME v => SOME v
oracle_agrees=∀(orac :num -> (num # num) # v # dec list) (es :eval_state option). orac_agrees orac es ⇔ case es of (NONE :eval_state option) => F | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => ∀(j :num). j < FST (FST (s.oracle (0 :num) :(num # num) # v # dec list)) ⇒ orac j = (s.oracle (j + (1 :num)) :(num # num) # v # dec list)
oracle_extended_wf=∀(f :α # β # γ -> (β # δ) option) (orac :num -> α # β # γ). orac_extended_wf f orac ⇔ ∀(i :num) (x :β # δ). f (orac i) = SOME x ⇒ FST x = FST (SND (orac (SUC i)))
record_forward=∀(es :eval_state option) (es' :eval_state option). record_forward es es' ⇔ case es of (NONE :eval_state option) => (case es' of (NONE :eval_state option) => T | SOME (EvalDecs v4) => T | SOME (EvalOracle v5) => F) | SOME (EvalDecs v7) => (case es' of (NONE :eval_state option) => T | SOME (EvalDecs v4) => T | SOME (EvalOracle v5) => F) | SOME (EvalOracle s) => ∃(s' :eval_oracle_state). es' = SOME (EvalOracle s') ∧ FST (FST (s.oracle (0 :num) :(num # num) # v # dec list)) ≤ FST (FST (s'.oracle (0 :num) :(num # num) # v # dec list)) ∧ ∀(j :num). (0 :num) < j ∧ j < FST (FST (s.oracle (0 :num) :(num # num) # v # dec list)) + (1 :num) ⇒ (s'.oracle j :(num # num) # v # dec list) = (s.oracle j :(num # num) # v # dec list)
record_forward_refl=record_forward (es :eval_state option) es
record_forward_trans=record_forward (es1 :eval_state option) (es2 :eval_state option) ∧ record_forward es2 (es3 :eval_state option) ⇒ record_forward es1 es3
oracle_agrees_backward=orac_agrees (orac :num -> (num # num) # v # dec list) (es2 :eval_state option) ∧ record_forward (es1 :eval_state option) es2 ⇒ orac_agrees orac es1
value_to_nat=∀(v :v). v_to_nat v = case v of Litv (IntLit i) => if (0 :int) ≤ i then SOME (Num i) else (NONE :num option) | Litv (Char v35) => (NONE :num option) | Litv (StrLit v36) => (NONE :num option) | Litv (Word8 v37) => (NONE :num option) | Litv (Word64 v38) => (NONE :num option) | Litv (Float64 v39) => (NONE :num option) | Conv v15 v16 => (NONE :num option) | Closure v17 v18 v19 => (NONE :num option) | Recclosure v20 v21 v22 => (NONE :num option) | Loc v23 v24 => (NONE :num option) | Vectorv v25 => (NONE :num option) | Env v26 v27 => (NONE :num option)
value_to_env_id=∀(v :v). v_to_env_id v = case v of Litv v16 => (NONE :(num # num) option) | Conv v17 ([] :v list) => (NONE :(num # num) option) | Conv v17 [gen_id_v] => (NONE :(num # num) option) | Conv (NONE :stamp option) [gen_id_v; id_v] => (case (v_to_nat gen_id_v,v_to_nat id_v) of ((NONE :num option),v3) => (NONE :(num # num) option) | (SOME gen_id,(NONE :num option)) => (NONE :(num # num) option) | (SOME gen_id,SOME id) => SOME (gen_id,id)) | Conv (SOME v43) [gen_id_v; id_v] => (NONE :(num # num) option) | Conv v17 (gen_id_v::id_v::v40::v41) => (NONE :(num # num) option) | Closure v19 v20 v21 => (NONE :(num # num) option) | Recclosure v22 v23 v24 => (NONE :(num # num) option) | Loc v25 v26 => (NONE :(num # num) option) | Vectorv v27 => (NONE :(num # num) option) | Env v28 v29 => (NONE :(num # num) option)
do_eval_record=∀(ci :α compiler_instance) (vs :v list) (orac :num -> (num # num) # v # dec list). do_eval_record ci vs orac = case vs of ([] :v list) => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v; st_v2] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v; st_v2; bs_v] => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | [env_id_v; st_v; decs_v; st_v2; bs_v; ws_v] => (let (((i :num),(_0' :num)),(st :v),(_1 :dec list)) = orac (0 :num) in case (v_to_env_id env_id_v,v_fun_abs ci.decs_dom ci.decs_v decs_v) of ((NONE :(num # num) option),v3) => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | (SOME env_id,(NONE :dec list option)) => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option) | (SOME env_id,SOME decs) => if compiler_agrees (mk_compiler_fun_from_ci ci) (env_id,st_v,decs) (st_v2,bs_v,ws_v) ∧ st_v = st then (let (orac' :num -> (num # num) # v # dec list) (j :num) = if j = (0 :num) then ((i + (1 :num),(0 :num)),st_v2,([] :dec list)) else if j = SUC i then (env_id,st,decs) else orac j in SOME (env_id,orac',decs)) else (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option)) | env_id_v::st_v::decs_v::st_v2::bs_v::ws_v::v28::v29 => (NONE :((num # num) # (num -> (num # num) # v # dec list) # dec list) option)
is_record=∀(ci :α compiler_instance) (es :eval_state option). is_record ci es ⇔ case es of (NONE :eval_state option) => F | SOME (EvalDecs v4) => F | SOME (EvalOracle s) => s.custom_do_eval = do_eval_record ci
is_record_imp=is_record (ci :'cfg compiler_instance) (es :eval_state option) ⇒ ∃(orac_st :eval_oracle_state). es = SOME (EvalOracle orac_st)
recorded_wf_step=recorded_orac_wf (compiler :(num # num) # v # dec list -> (v # word8 list # word64 list) option) (orac :num -> (num # num) # v # dec list) ∧ compiler_agrees compiler (args :(num # num) # v # dec list) ((st_v2 :v),(bs_v :v),(ws_v :v)) ∧ ((0 :num) < FST (FST (orac (0 :num))) ⇒ FST (SND args) = FST (SND (orac (0 :num)))) ⇒ recorded_orac_wf compiler (λ(j :num). if j = (0 :num) then ((FST (FST (orac (0 :num))) + (1 :num),(0 :num)),st_v2,([] :dec list)) else if j = SUC (FST (FST (orac (0 :num)))) then args else orac j)
value_to_nat_some=v_to_nat (v :v) = SOME (n :num) ⇒ v = nat_to_v n
value_to_env_id_some=v_to_env_id (v :v) = SOME (id :num # num) ⇒ v = Conv (NONE :stamp option) [nat_to_v (FST id); nat_to_v (SND id)]
value_to_list_concrete=∀(x :v) (xs :v list). v_to_list x = SOME xs ⇒ (concrete_v x ⇔ EVERY concrete_v xs)
maybe_all_list_some=∀(xs :α option list) (ys :α list). maybe_all_list xs = SOME ys ⇒ xs = MAP (SOME :α -> α option) ys
maybe_all_list_every=maybe_all_list (xs :α option list) = SOME (ys :α list) ⇒ EVERY (λ(x :α option). x ≠ (NONE :α option)) xs
word8_list_concrete=v_to_word8_list (x :v) = SOME (xs :word8 list) ⇒ concrete_v x
word64_list_concrete=v_to_word64_list (x :v) = SOME (xs :word64 list) ⇒ concrete_v x
compiler_agrees_concrete=compiler_agrees (f :(num # num) # v # dec list -> (v # word8 list # word64 list) option) ((id :num # num),(st_v :v),(decs :dec list)) ((st_v2 :v),(bs_v :v),(ws_v :v)) ⇒ concrete_v st_v ∧ concrete_v st_v2 ∧ concrete_v bs_v ∧ concrete_v ws_v
reset_oracle_eqs=(is_record (ci :α compiler_instance) (reset_env_generation (es2 :eval_state option) (es3 :eval_state option)) ⇔ is_record ci es3) ∧ (record_forward (es1 :eval_state option) (reset_env_generation es2 es3) ⇔ record_forward es1 es3) ∧ (orac_agrees (orac :num -> (num # num) # v # dec list) (reset_env_generation es2 es3) ⇔ orac_agrees orac es3) ∧ reset_env_generation (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es1) es2 = reset_env_generation es1 es2 ∧ reset_env_generation es1 (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es2) = insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac (reset_env_generation es1 es2) ∧ (orac_s (reset_env_generation es2 es3)).oracle = (orac_s es3).oracle
insert_declare_env=declare_env (es1 :eval_state option) (env :v sem_env) = SOME ((x :v),(es2 :eval_state option)) ∧ is_record (ci :α compiler_instance) es1 ⇒ is_record ci es2 ∧ record_forward es1 es2 ∧ (orac_agrees (orac :num -> (num # num) # v # dec list) es2 ⇒ declare_env (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es1) env = SOME (x,insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es2)) ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es1).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es2).oracle)
insert_do_eval=do_eval (vs :v list) (es :eval_state option) = SOME ((env :v sem_env),(decs :dec list),(es' :eval_state option)) ∧ is_record (ci :α compiler_instance) es ⇒ is_record ci es' ∧ record_forward es es' ∧ (orac_agrees (orac :num -> (num # num) # v # dec list) es' ∧ orac_extended_wf (mk_compiler_fun_from_ci ci) orac ⇒ do_eval vs (insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es) = SOME (env,decs,insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac es')) ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s es').oracle)
record_forward_trans_sym_replay=record_forward (es2 :eval_state option) (es3 :eval_state option) ∧ record_forward (es1 :eval_state option) es2 ⇒ record_forward es1 es3
evaluate_record_forward=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate s env exps = (s',res) ∧ is_record (ci :'cfg compiler_instance) s.eval_state ⇒ is_record ci s'.eval_state ∧ record_forward s.eval_state s'.eval_state ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s s.eval_state).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s s'.eval_state).oracle)) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate_match s env x pes err_x = (s',res) ∧ is_record ci s.eval_state ⇒ is_record ci s'.eval_state ∧ record_forward s.eval_state s'.eval_state ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s s.eval_state).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s s'.eval_state).oracle)) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (decs :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env decs = (s',res) ∧ is_record ci s.eval_state ⇒ is_record ci s'.eval_state ∧ record_forward s.eval_state s'.eval_state ∧ (recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s s.eval_state).oracle ⇒ recorded_orac_wf (mk_compiler_fun_from_ci ci) (orac_s s'.eval_state).oracle)
insert_oracle_correct=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate s env exps = (s',res) ∧ is_record (ci :α compiler_instance) s.eval_state ∧ orac_agrees (orac :num -> (num # num) # v # dec list) s'.eval_state ∧ orac_extended_wf (mk_compiler_fun_from_ci ci) orac ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate (s with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac) env exps = (s' with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac,res)) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate_match s env x pes err_x = (s',res) ∧ is_record ci s.eval_state ∧ orac_agrees orac s'.eval_state ∧ orac_extended_wf (mk_compiler_fun_from_ci ci) orac ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate_match (s with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac) env x pes err_x = (s' with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac,res)) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (decs :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env decs = (s',res) ∧ is_record ci s.eval_state ∧ orac_agrees orac s'.eval_state ∧ orac_extended_wf (mk_compiler_fun_from_ci ci) orac ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs (s with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac) env decs = (s' with eval_state updated_by insert_gen_oracle ci (I :dec list -> dec list) ((FST :num # num -> num) ∘ (FST :(num # num) # v # dec list -> num # num)) orac,res)
evaluate_record_suffix=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate s env exps = (s',res) ∧ is_record (ci :α compiler_instance) s.eval_state ∧ (k :num) ≤ s.clock ⇒ (let (ev :'ffi semanticPrimitives$state # (v list, v) result) = evaluate (s with clock updated_by (λ(c :num). c − k)) env exps in k ≤ s'.clock ∧ ev = (s' with clock updated_by (λ(c :num). c − k),res) ∨ ∃(s'' :'ffi semanticPrimitives$state). ev = (s'',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) ∧ record_forward s''.eval_state s'.eval_state)) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate_match s env x pes err_x = (s',res) ∧ is_record ci s.eval_state ∧ k ≤ s.clock ⇒ (let (ev :'ffi semanticPrimitives$state # (v list, v) result) = evaluate_match (s with clock updated_by (λ(c :num). c − k)) env x pes err_x in k ≤ s'.clock ∧ ev = (s' with clock updated_by (λ(c :num). c − k),res) ∨ ∃(s'' :'ffi semanticPrimitives$state). ev = (s'',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) ∧ record_forward s''.eval_state s'.eval_state)) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (decs :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env decs = (s',res) ∧ is_record ci s.eval_state ∧ k ≤ s.clock ⇒ (let (ev :'ffi semanticPrimitives$state # (v sem_env, v) result) = evaluate_decs (s with clock updated_by (λ(c :num). c − k)) env decs in k ≤ s'.clock ∧ ev = (s' with clock updated_by (λ(c :num). c − k),res) ∨ ∃(s'' :'ffi semanticPrimitives$state). ev = (s'',(Rerr (Rabort Rtimeout_error :v error_result) :(v sem_env, v) result)) ∧ record_forward s''.eval_state s'.eval_state)
spt_mem_to_list_a_replay=∀(t :α sptree$num_map) (acc :α list) (x :α). MEM x (toListA acc t) ⇔ MEM x acc ∨ ∃(k :num). lookup k t = SOME x
spt_mem_to_list=∀(x :α) (t :α sptree$num_map). MEM x (toList t :α list) ⇔ ∃(k :num). lookup k t = SOME x
spt_to_list_a_def=(∀(acc :α list). toListA acc (LN :α sptree$num_map) = acc) ∧ (∀(acc :α list) (a :α). toListA acc ⦕ 0 ↦ a ⦖ = a::acc) ∧ (∀(acc :α list) (t1 :α sptree$num_map) (t2 :α sptree$num_map). toListA acc (BN t1 t2) = toListA (toListA acc t2) t1) ∧ ∀(acc :α list) (t1 :α sptree$num_map) (a :α) (t2 :α sptree$num_map). toListA acc (BS t1 a t2) = toListA (a::toListA acc t2) t1
spt_to_list_def=∀(m :α sptree$num_map). (toList m :α list) = toListA ([] :α list) m
environment_relation_definition=∀(v_rel :v -> α -> bool) (env :v sem_env) (env' :α sem_env). env_rel v_rel env env' ⇔ env.c = env'.c ∧ nsDom env.v = nsDom env'.v ∧ nsDomMod env.v = nsDomMod env'.v ∧ ∀(nm :(mlstring, mlstring) id) (x :v) (y :α). nsLookup env.v nm = SOME x ∧ nsLookup env'.v nm = SOME y ⇒ v_rel x y
environment_relation_monotonic=(∀(y :v) (z :α). (R :v -> α -> bool) y z ⇒ (R' :v -> α -> bool) y z) ⇒ env_rel R (env :v sem_env) (env' :α sem_env) ⇒ env_rel R' env env'
environment_relation_lookup=env_rel (R :v -> α -> bool) (env :v sem_env) (env' :α sem_env) ∧ nsLookup env.v (id :(mlstring, mlstring) id) = SOME (v :v) ⇒ ∃(v' :α). nsLookup env'.v id = SOME v' ∧ R v v'
environment_relation_bind=env_rel (R :v -> α -> bool) ((env :β sem_env) with v := (ev :(mlstring, mlstring, v) namespace)) ((env' :γ sem_env) with v := (ev' :(mlstring, mlstring, α) namespace)) ∧ R (x :v) (y :α) ⇒ env_rel R (env with v := nsBind (n :mlstring) x ev) (env' with v := nsBind n y ev')
environment_relation_bind_list=∀(xs :(mlstring # v) list) (ys :(mlstring # α) list). env_rel (R :v -> α -> bool) ((env :β sem_env) with v := (ev :(mlstring, mlstring, v) namespace)) ((env' :γ sem_env) with v := (ev' :(mlstring, mlstring, α) namespace)) ∧ LIST_REL (($= :mlstring -> mlstring -> bool) ### R) xs ys ⇒ env_rel R (env with v := nsBindList xs ev) (env' with v := nsBindList ys ev')
environment_relation_lift=env_rel (R :v -> α -> bool) ((env :β sem_env) with <|v := (v :(mlstring, mlstring, v) namespace); c := (c :(mlstring, mlstring, num # stamp) namespace)|>) ((env' :γ sem_env) with <|v := (v' :(mlstring, mlstring, α) namespace); c := (c' :(mlstring, mlstring, num # stamp) namespace)|>) ⇒ env_rel R (env with <|v := nsLift (mn :mlstring) v; c := nsLift mn c|>) (env' with <|v := nsLift mn v'; c := nsLift mn c'|>)
environment_relation_empty=(∀(env' :α sem_env). env_rel (R :v -> α -> bool) ((x :α sem_env) with v := (nsEmpty :(mlstring, mlstring, v) namespace)) env' ⇔ x.c = env'.c ∧ nsDom (nsEmpty :(mlstring, mlstring, v) namespace) = nsDom env'.v ∧ nsDomMod (nsEmpty :(mlstring, mlstring, v) namespace) = nsDomMod env'.v) ∧ (env_rel R (x :v sem_env) ((y :β sem_env) with v := (nsEmpty :(mlstring, mlstring, α) namespace)) ⇔ x.c = y.c ∧ nsDom x.v = nsDom (nsEmpty :(mlstring, mlstring, α) namespace) ∧ nsDomMod x.v = nsDomMod (nsEmpty :(mlstring, mlstring, α) namespace))
environment_relation_append=env_rel (R :v -> α -> bool) ((env :β sem_env) with v := (a :(mlstring, mlstring, v) namespace)) ((env' :γ sem_env) with v := (c :(mlstring, mlstring, α) namespace)) ∧ env_rel R (env with v := (b :(mlstring, mlstring, v) namespace)) (env' with v := (d :(mlstring, mlstring, α) namespace)) ⇒ env_rel R (env with v := nsAppend a b) (env' with v := nsAppend c d)
environment_relation_extend_dec=env_rel (R :v -> v -> bool) (env1 :v sem_env) (env2 :v sem_env) ∧ env_rel R (env3 :v sem_env) (env4 :v sem_env) ⇒ env_rel R ((env1 +++ env3) :v sem_env) ((env2 +++ env4) :v sem_env)
namespace_append_domains=∀(n1 :(α, β, γ) namespace) (n2 :(α, β, γ) namespace) (n3 :(α, β, δ) namespace) (n4 :(α, β, δ) namespace). nsDom n1 = nsDom n3 ∧ nsDom n2 = nsDom n4 ∧ nsDomMod n1 = nsDomMod n3 ∧ nsDomMod n2 = nsDomMod n4 ⇒ nsDom (nsAppend n1 n2) = nsDom (nsAppend n3 n4) ∧ nsDomMod (nsAppend n1 n2) = nsDomMod (nsAppend n3 n4)
namespace_lift_domain=∀(mn :α) (n :(α, β, γ) namespace). nsDom (nsLift mn n) = IMAGE (Long mn :(α, β) id -> (α, β) id) (nsDom n)
namespace_lift_module_domain=∀(mn :α) (n :(α, β, γ) namespace). nsDomMod (nsLift mn n) = ([] :α list) INSERT IMAGE (CONS mn) (nsDomMod n)
namespace_lift_lookup=∀(mn :α) (e :(α, β, γ) namespace) (id :(α, β) id). nsLookup (nsLift mn e) id = case id of (Short v :(α, β) id) => (NONE :γ option) | Long mn' id' => if mn = mn' then nsLookup e id' else (NONE :γ option)
namespace_lift_module_lookup=∀(mn :α) (e :(α, β, γ) namespace) (path :α list). nsLookupMod (nsLift mn e) path = case path of ([] :α list) => SOME (nsLift mn e) | mn'::path' => if mn = mn' then nsLookupMod e path' else (NONE :(α, β, γ) namespace option)
namespace_empty_lookup=∀(id :(α, β) id). nsLookup (nsEmpty :(α, β, γ) namespace) id = (NONE :γ option)
namespace_empty_module_lookup=∀(x :α) (y :α list). nsLookupMod (nsEmpty :(α, β, γ) namespace) (x::y) = (NONE :(α, β, γ) namespace option)
source_value_relation_rules=∀(es :eval_oracle_state). (∀(env :v sem_env) (id :num # num) (v :v) (env' :v sem_env). v_to_env_id v = SOME id ∧ lookup_env es id = SOME env' ∧ env_rel (v_rel es) env env' ⇒ v_rel es (Env env id) v) ∧ (∀(xs :v list) (ys :v list). LIST_REL (v_rel es) xs ys ⇒ v_rel es (Vectorv xs) (Vectorv ys)) ∧ (∀(stmp :stamp option) (xs :v list) (ys :v list). LIST_REL (v_rel es) xs ys ⇒ v_rel es (Conv stmp xs) (Conv stmp ys)) ∧ (∀(env :v sem_env) (env' :v sem_env) (nm :mlstring) (x :exp). env_rel (v_rel es) env env' ⇒ v_rel es (Closure env nm x) (Closure env' nm x)) ∧ (∀(env :v sem_env) (env' :v sem_env) (funs :(mlstring # mlstring # exp) list) (nm :mlstring). env_rel (v_rel es) env env' ⇒ v_rel es (Recclosure env funs nm) (Recclosure env' funs nm)) ∧ (∀(l :lit). v_rel es (Litv l) (Litv l)) ∧ ∀(br :bool) (n :num). v_rel es (Loc br n) (Loc br n)
source_value_relation_cases=∀(es :eval_oracle_state) (a0 :v) (a1 :v). v_rel es a0 a1 ⇔ (∃(env :v sem_env) (id :num # num) (env' :v sem_env). a0 = Env env id ∧ v_to_env_id a1 = SOME id ∧ lookup_env es id = SOME env' ∧ env_rel (v_rel es) env env') ∨ (∃(xs :v list) (ys :v list). a0 = Vectorv xs ∧ a1 = Vectorv ys ∧ LIST_REL (v_rel es) xs ys) ∨ (∃(stmp :stamp option) (xs :v list) (ys :v list). a0 = Conv stmp xs ∧ a1 = Conv stmp ys ∧ LIST_REL (v_rel es) xs ys) ∨ (∃(env :v sem_env) (env' :v sem_env) (nm :mlstring) (x :exp). a0 = Closure env nm x ∧ a1 = Closure env' nm x ∧ env_rel (v_rel es) env env') ∨ (∃(env :v sem_env) (env' :v sem_env) (funs :(mlstring # mlstring # exp) list) (nm :mlstring). a0 = Recclosure env funs nm ∧ a1 = Recclosure env' funs nm ∧ env_rel (v_rel es) env env') ∨ (∃(l :lit). a0 = Litv l ∧ a1 = Litv l) ∨ ∃(br :bool) (n :num). a0 = Loc br n ∧ a1 = Loc br n
source_value_relation_induction=∀(es :eval_oracle_state) (v_rel' :v -> v -> bool). (∀(env :v sem_env) (id :num # num) (v :v) (env' :v sem_env). v_to_env_id v = SOME id ∧ lookup_env es id = SOME env' ∧ env_rel v_rel' env env' ⇒ v_rel' (Env env id) v) ∧ (∀(xs :v list) (ys :v list). LIST_REL v_rel' xs ys ⇒ v_rel' (Vectorv xs) (Vectorv ys)) ∧ (∀(stmp :stamp option) (xs :v list) (ys :v list). LIST_REL v_rel' xs ys ⇒ v_rel' (Conv stmp xs) (Conv stmp ys)) ∧ (∀(env :v sem_env) (env' :v sem_env) (nm :mlstring) (x :exp). env_rel v_rel' env env' ⇒ v_rel' (Closure env nm x) (Closure env' nm x)) ∧ (∀(env :v sem_env) (env' :v sem_env) (funs :(mlstring # mlstring # exp) list) (nm :mlstring). env_rel v_rel' env env' ⇒ v_rel' (Recclosure env funs nm) (Recclosure env' funs nm)) ∧ (∀(l :lit). v_rel' (Litv l) (Litv l)) ∧ (∀(br :bool) (n :num). v_rel' (Loc br n) (Loc br n)) ⇒ ∀(a0 :v) (a1 :v). v_rel es a0 a1 ⇒ v_rel' a0 a1
source_value_relation_concrete=(∀(v :v). concrete_v v ⇒ v_rel (es :eval_oracle_state) v v) ∧ ∀(vs :v list). concrete_v_list vs ⇒ LIST_REL (v_rel es) vs vs
source_environment_relation_concrete=nsAll (K concrete_v :(mlstring, mlstring) id -> v -> bool) (env :v sem_env).v ⇒ env_rel (v_rel (es :eval_oracle_state)) env env
source_value_relation_left_simps=(∀(v :v) (l :lit) (es :eval_oracle_state). v_rel es (Litv l) v ⇔ v = Litv l) ∧ (∀(vs :v list) (v :v) (es :eval_oracle_state) (cn :stamp option). v_rel es (Conv cn vs) v ⇔ ∃(ys :v list). v = Conv cn ys ∧ LIST_REL (v_rel es) vs ys) ∧ (∀(v :v) (l :num) (es :eval_oracle_state) (b :bool). v_rel es (Loc b l) v ⇔ v = Loc b l) ∧ (∀(vs :v list) (v :v) (es :eval_oracle_state). v_rel es (Vectorv vs) v ⇔ ∃(ys :v list). v = Vectorv ys ∧ LIST_REL (v_rel es) vs ys) ∧ (∀(v :v) (id :num # num) (es :eval_oracle_state) (e :v sem_env). v_rel es (Env e id) v ⇔ ∃(env' :v sem_env). v_to_env_id v = SOME id ∧ lookup_env es id = SOME env' ∧ env_rel (v_rel es) e env') ∧ (∀(v :v) (nm :mlstring) (funs :(mlstring # mlstring # exp) list) (es :eval_oracle_state) (env :v sem_env). v_rel es (Recclosure env funs nm) v ⇔ ∃(env'' :v sem_env). v = Recclosure env'' funs nm ∧ env_rel (v_rel es) env env'') ∧ ∀(x :exp) (v :v) (nm :mlstring) (es :eval_oracle_state) (env :v sem_env). v_rel es (Closure env nm x) v ⇔ ∃(env'' :v sem_env). v = Closure env'' nm x ∧ env_rel (v_rel es) env env''
source_value_relation_boolean=v_rel (es :eval_oracle_state) (Boolv (b :bool)) (v :v) ⇔ v = Boolv b
source_state_relation_definition=∀(ci :α compiler_instance) (s :β semanticPrimitives$state) (s' :β semanticPrimitives$state). s_rel ci s s' ⇔ ∃(dec_s :eval_decs_state) (orac_s :eval_oracle_state) (refs' :v store_v list). s' = s with <|refs := refs'; eval_state := SOME (EvalOracle orac_s)|> ∧ LIST_REL (sv_rel (v_rel orac_s)) s.refs refs' ∧ s.eval_state = SOME (EvalDecs dec_s) ∧ orac_s.custom_do_eval = do_eval_record ci ∧ dec_s.compiler_state = FST (SND (orac_s.oracle (0 :num) :(num # num) # v # dec list)) ∧ dec_s.decode_decs = v_fun_abs ci.decs_dom ci.decs_v ∧ dec_s.compiler = mk_compiler_fun_from_ci ci ∧ ((0 :num) = FST (FST (orac_s.oracle (0 :num) :(num # num) # v # dec list)) ⇒ dec_s.compiler_state = ci.config_v ci.init_state) ∧ ((0 :num) < FST (FST (orac_s.oracle (0 :num) :(num # num) # v # dec list)) ⇒ FST (SND (orac_s.oracle (1 :num) :(num # num) # v # dec list)) = ci.config_v ci.init_state) ∧ dec_s.env_id_counter = (orac_s.generation,LENGTH orac_s.envs❲orac_s.generation❳,LENGTH orac_s.envs) ∧ orac_s.generation < LENGTH orac_s.envs ∧ recorded_orac_wf (mk_compiler_fun_from_ci ci) orac_s.oracle
source_environment_forward_definition=∀(es :eval_oracle_state) (es' :eval_oracle_state). es_forward es es' ⇔ LENGTH es.envs ≤ LENGTH es'.envs ∧ ∀(env_id :num # num) (env :v sem_env). lookup_env es env_id = SOME env ⇒ lookup_env es' env_id = SOME env
source_environment_forward_refl=es_forward (es :eval_oracle_state) es
source_environment_forward_trans=es_forward (es :eval_oracle_state) (es' :eval_oracle_state) ∧ es_forward es' (es'' :eval_oracle_state) ⇒ es_forward es es''
source_value_relation_forward=∀(x :v) (y :v). v_rel (es :eval_oracle_state) x y ⇒ es_forward es (es' :eval_oracle_state) ⇒ v_rel es' x y
store_value_relation_monotonic=(∀(x :α) (y :β). (P :α -> β -> bool) x y ⇒ (Q :α -> β -> bool) x y) ⇒ sv_rel P (x :α store_v) (y :β store_v) ⇒ sv_rel Q x y
source_forward_rules=(v_rel (es :eval_oracle_state) (x :v) (y :v) ∧ es_forward es (es' :eval_oracle_state) ⇒ v_rel es' x y) ∧ (LIST_REL (v_rel es) (xs :v list) (ys :v list) ∧ es_forward es es' ⇒ LIST_REL (v_rel es') xs ys) ∧ (env_rel (v_rel es) (env :v sem_env) (env' :v sem_env) ∧ es_forward es es' ⇒ env_rel (v_rel es') env env') ∧ ∀(xs :v store_v list) (ys :v store_v list). LIST_REL (sv_rel (v_rel es)) xs ys ∧ es_forward es es' ⇒ LIST_REL (sv_rel (v_rel es')) xs ys
source_stack_forward_definition=∀(es :eval_oracle_state) (es' :eval_oracle_state). es_stack_forward es es' ⇔ es'.generation = es.generation ∧ ∀(j :num). j < es.generation ⇒ es'.envs❲j❳ = es.envs❲j❳
source_stack_forward_refl=es_stack_forward (es :eval_oracle_state) es
source_stack_forward_trans=es_stack_forward (es1 :eval_oracle_state) (es2 :eval_oracle_state) ∧ es_stack_forward es2 (es3 :eval_oracle_state) ⇒ es_stack_forward es1 es3
source_match_result_relation_definition=∀(nerr :bool) (R :α -> β -> bool) (mr1 :α match_result) (mr2 :β match_result). match_result_rel nerr R mr1 mr2 ⇔ case mr1 of (No_match :α match_result) => mr2 = (No_match :β match_result) | (Match_type_error :α match_result) => nerr ∨ mr2 = (Match_type_error :β match_result) | Match x => ∃(y :β). mr2 = Match y ∧ R x y
source_store_lookup_relation=LIST_REL (sv_rel (R :α -> β -> bool)) (refs :α store_v list) (refs' :β store_v list) ⇒ OPTREL (sv_rel R) (store_lookup (i :num) refs) (store_lookup i refs')
source_state_store_lookup=s_rel (ci :'cfg compiler_instance) (s :α semanticPrimitives$state) (t :α semanticPrimitives$state) ∧ (j :num) = (i :num) ∧ (es :eval_oracle_state) = orac_s t.eval_state ⇒ OPTREL (sv_rel (v_rel es)) (store_lookup i s.refs) (store_lookup j t.refs)
source_pmatch_simulation=s_rel (ci :'cfg compiler_instance) (s :α semanticPrimitives$state) (t :α semanticPrimitives$state) ∧ (es :eval_oracle_state) = orac_s t.eval_state ∧ env_rel (v_rel es) (env :v sem_env) (env' :v sem_env) ⇒ (∀(env_c :(mlstring, mlstring, num # stamp) namespace) (s_refs :v store_v list) (p :pat) (x :v) (binds :(mlstring # v) list) (y :v) (binds' :(mlstring # v) list). s_refs = s.refs ∧ env_c = env.c ∧ v_rel es x y ∧ LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es) binds binds' ⇒ match_result_rel T (LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es)) (pmatch env_c s_refs p x binds) (pmatch env'.c t.refs p y binds')) ∧ ∀(env_c :(mlstring, mlstring, num # stamp) namespace) (s_refs :v store_v list) (ps :pat list) (xs :v list) (binds :(mlstring # v) list) (ys :v list) (binds' :(mlstring # v) list). s_refs = s.refs ∧ env_c = env.c ∧ LIST_REL (v_rel es) xs ys ∧ LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es) binds binds' ⇒ match_result_rel T (LIST_REL (($= :mlstring -> mlstring -> bool) ### v_rel es)) (pmatch_list env_c s_refs ps xs binds) (pmatch_list env'.c t.refs ps ys binds')
