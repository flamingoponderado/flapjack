v_rel_abs=∀(fun_dom :α -> bool) (fun_v :α -> β) (v :β). v_fun_abs fun_dom fun_v v = some(x :α). fun_v x = v ∧ x ∈ fun_dom
compiler_fun=∀(ci :α compiler_instance) (env_id :num # num) (cfg_v :v) (decs :dec list). mk_compiler_fun_from_ci ci (env_id,cfg_v,decs) = OPTION_BIND (v_fun_abs ci.config_dom ci.config_v cfg_v) (λ(cfg :α). OPTION_BIND (ci.compiler_fun (env_id,cfg,decs)) (λ((cfg2 :α),(bs :word8 list),(ws :word64 list)). SOME (ci.config_v cfg2,bs,ws)))
init_eval=∀(ci :α compiler_instance). mk_init_eval_state ci = EvalDecs <|compiler := mk_compiler_fun_from_ci ci; decode_decs := v_fun_abs ci.decs_dom ci.decs_v; env_id_counter := ((0 :num),(0 :num),(1 :num)); compiler_state := ci.config_v ci.init_state|>
insert=∀(ci :α compiler_instance) (g :dec list -> dec list) (shift_f :(num # num) # v # dec list -> num) (orac :num -> (num # num) # v # dec list) (es :eval_state option). insert_gen_oracle ci g shift_f orac es = case es of (NONE :eval_state option) => es | SOME (EvalDecs v4) => es | SOME (EvalOracle s) => SOME (EvalOracle (s with <|custom_do_eval := do_eval_oracle (mk_compiler_fun_from_ci ci) g; oracle := shift_seq (shift_f (s.oracle (0 :num) :(num # num) # v # dec list)) orac|>))
adjust=∀(ci :α compiler_instance) (f :dec list -> dec list) (es :eval_state option). adjust_oracle ci f es = case es of (NONE :eval_state option) => es | SOME (EvalDecs v1) => es | SOME (EvalOracle o_s) => SOME (EvalOracle (o_s with custom_do_eval := do_eval_oracle (mk_compiler_fun_from_ci ci) f))
is_insert=∀(ci :α compiler_instance) (f :dec list -> dec list) (es :eval_state option). is_insert_oracle ci f es ⇔ ∃(es' :eval_state option) (shift_f :(num # num) # v # dec list -> num) (orac :num -> (num # num) # v # dec list). es = insert_gen_oracle ci f shift_f orac es'
adjust_insert=adjust_oracle (ci :α compiler_instance) (f :dec list -> dec list) (insert_gen_oracle ci (g :dec list -> dec list) (shift_f :(num # num) # v # dec list -> num) (orac :num -> (num # num) # v # dec list) (es :eval_state option)) = insert_gen_oracle ci f shift_f orac es
adjust_evaluate=(∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs s env ((compile_decs :dec list -> dec list) ds) = (s',res)) ⇒ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (exps :exp list) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate s env exps = (s',res) ∧ is_insert_oracle (ci :α compiler_instance) (f :dec list -> dec list) s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env exps = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)) ∧ (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (x :v) (pes :(pat # exp) list) (err_x :v) (s' :'ffi semanticPrimitives$state) (res :(v list, v) result). evaluate_match s env x pes err_x = (s',res) ∧ is_insert_oracle ci f s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate_match (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env x pes err_x = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)) ∧ ∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ is_insert_oracle ci f s.eval_state ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ is_insert_oracle ci f s'.eval_state ∧ evaluate_decs (s with eval_state updated_by adjust_oracle ci (compile_decs ∘ f)) env ds = (s' with eval_state updated_by adjust_oracle ci (compile_decs ∘ f),res)
adjust_semantics=∀(compile :dec list -> dec list) (f :dec list -> dec list). (∀(s :'ffi semanticPrimitives$state) (env :v sem_env) (ds :dec list) (s' :'ffi semanticPrimitives$state) (res :(v sem_env, v) result). evaluate_decs s env ds = (s',res) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) ⇒ evaluate_decs s env (compile ds) = (s',res)) ⇒ is_insert_oracle (ci :α compiler_instance) f (s :'ffi semanticPrimitives$state).eval_state ∧ ¬semantics_prog s (env :v sem_env) (prog :dec list) Fail ∧ semantics_prog s env prog (outcome :behaviour) ⇒ semantics_prog (s with eval_state updated_by adjust_oracle ci (compile ∘ f)) env prog outcome
