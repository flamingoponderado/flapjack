do_test_definition=(∀(ty :prim_type) (v1 :v) (v2 :v). do_test Equal ty v1 v2 = if check_type ty v1 ∧ check_type ty v2 then if ty = Float64T then Eq_val (fp64_equal (the_Litv_Float64 v1) (the_Litv_Float64 v2)) else do_eq v1 v2 else Eq_type_error) ∧ (∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (Compare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (v3,(NONE :lit option),v8) => Eq_type_error | (v3,SOME v10,(NONE :lit option)) => Eq_type_error | (BoolT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (IntT,SOME (IntLit i),SOME (IntLit j)) => Eq_val (int_cmp cmp i j) | (CharT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (StrT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (WordT v38,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (Float64T,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Char v32),SOME (IntLit j)) => Eq_type_error | (v3,SOME (StrLit v33),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word8 v34),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word64 v35),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Float64 v36),SOME (IntLit j)) => Eq_type_error | (v3,SOME (IntLit v45),SOME (Char d)) => Eq_type_error | (BoolT,SOME (Char c),SOME (Char d)) => Eq_type_error | (IntT,SOME (Char c),SOME (Char d)) => Eq_type_error | (CharT,SOME (Char c),SOME (Char d)) => Eq_val (num_cmp cmp (ORD c) (ORD d) :bool) | (StrT,SOME (Char c),SOME (Char d)) => Eq_type_error | (WordT v52,SOME (Char c),SOME (Char d)) => Eq_type_error | (Float64T,SOME (Char c),SOME (Char d)) => Eq_type_error | (v3,SOME (StrLit v47),SOME (Char d)) => Eq_type_error | (v3,SOME (Word8 v48),SOME (Char d)) => Eq_type_error | (v3,SOME (Word64 v49),SOME (Char d)) => Eq_type_error | (v3,SOME (Float64 v50),SOME (Char d)) => Eq_type_error | (v3,SOME (IntLit v59),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Char v60),SOME (StrLit t)) => Eq_type_error | (BoolT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (IntT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (Ch