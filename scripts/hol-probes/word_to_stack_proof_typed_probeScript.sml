fun fetch1 thy name = DB.lookup {Thy=thy,Name=name};

fun show label th = (print (label ^ "=");
  app (fn h => (print_term h; print " ==> ")) (hyp th);
  print_term (concl th); print "\n");

fun emit label name =
  case fetch1 "word_to_stackProof" name of
    NONE => raise Fail (label ^ " is not exported by word_to_stackProof")
  | SOME (th,_) => show label th;

fun emit_sem label name =
  case fetch1 "wordSem" name of
    NONE => raise Fail (label ^ " is not exported by wordSem")
  | SOME (th,_) => show label th;

