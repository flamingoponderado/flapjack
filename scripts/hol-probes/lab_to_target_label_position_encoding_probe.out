enc_lines_again_simp_pos_ok=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (lines :α line list) (res :α line list).
  enc_lines_again_simp labs ffis pos enc lines = (res,T) ∧
  lab_len_pos_ok pos lines ⇒
  lab_len_pos_ok pos res
