compile_exp_correct_full_statement=∀ctxt s e v. eval s e = SOME v ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt e = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt e) = SOME (convert_v v)
compile_exp_correct_full_hypotheses=0
compile_exp_correct_rstruct_statement=∀s expressions ctxt v. eval s (RStruct expressions) = SOME v ∧ alist_to_fmap ctxt.locals = FMAP_MAP2 (shape_of ∘ SND) s.locals ∧ alist_to_fmap ctxt.globals = FMAP_MAP2 (shape_of ∘ SND) s.globals ∧ ctxt.structs = MAP (λ(nm,info). (nm,info.fields)) s.structs ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.locals ∧ FEVERY (λ(nm,v). v_flds_ok s.structs v) s.globals ∧ struct_infos_ok s.structs ⇒ old_exp_shape ctxt (RStruct expressions) = shape_of v ∧ v_flds_ok s.structs v ∧ eval (convert_s ctxt s) (compile_exp ctxt (RStruct expressions)) = SOME (convert_v v)
compile_exp_correct_rstruct_proved=T
eval_ind_full_statement=∀P. (∀s w. P s (Const w)) ∧ (∀s v. P s (Var Local v)) ∧ (∀s v. P s (Var Global v)) ∧ (∀s es. (∀a. MEM a es ⇒ P s a) ⇒ P s (RStruct es)) ∧ (∀s index e. P s e ⇒ P s (RField index e)) ∧ (∀s nm eflds. (∀field_names field_exps info field_names' field_shapes a. (field_names,field_exps) = UNZIP eflds ∧ ALOOKUP s.structs nm = SOME info ∧ (field_names',field_shapes) = UNZIP info.fields ∧ field_names' = field_names ∧ MEM a field_exps ⇒ P s a) ⇒ P s (NStruct nm eflds)) ∧ (∀s fld e. P s e ⇒ P s (NField fld e)) ∧ (∀s shape addr. (is_wf_shape s.structs shape ⇒ P s addr) ⇒ P s (Load shape addr)) ∧ (∀s addr. P s addr ⇒ P s (Load32 addr)) ∧ (∀s addr. P s addr ⇒ P s (LoadByte addr)) ∧ (∀s op es. (∀a. MEM a es ⇒ P s a) ⇒ P s (Op op es)) ∧ (∀s op es. (∀a. MEM a es ⇒ P s a) ⇒ P s (Panop op es)) ∧ (∀s cmp e1 e2. P s e1 ∧ P s e2 ⇒ P s (Cmp cmp e1 e2)) ∧ (∀s sh e1 e2. P s e1 ∧ P s e2 ⇒ P s (Shift sh e1 e2)) ∧ (∀s. P s BaseAddr) ∧ (∀s. P s TopAddr) ∧ (∀s. P s BytesInWord) ⇒ ∀v v1. P v v1
