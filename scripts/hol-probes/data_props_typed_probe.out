initial_state_simp_typed=(initial_state (f :β ffi_state) (c :(num # dataLang$prog) sptree$num_map) (co :num -> α # (num # num # dataLang$prog) list) (cc :α -> (num # num # dataLang$prog) list -> (word8 list # word64 list # α) option) (ts :bool) (l :limits) (ss :num sptree$num_map) (k :num) :(α, β) dataSem$state).clock = k ∧ isEmpty (initial_state f c co cc ts l ss k :(α, β) dataSem$state).locals ∧ (initial_state f c co cc ts l ss k :(α, β) dataSem$state).code = c ∧ (initial_state f c co cc ts l ss k :(α, β) dataSem$state).ffi = f ∧ (initial_state f c co cc ts l ss k :(α, β) dataSem$state).compile_oracle = co ∧ (initial_state f c co cc ts l ss k :(α, β) dataSem$state).compile = cc ∧ (initial_state f c co cc ts l ss k :(α, β) dataSem$state).stack = ([] :stack list) ∧ (initial_state f c co cc ts l ss k :(α, β) dataSem$state).peak_heap_length = (0 :num)
