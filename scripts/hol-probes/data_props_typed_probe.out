add_space_const_typed=(add_space (s :(β, α) dataSem$state) (k :num)).ffi = s.ffi
with_clock_ffi_typed=((s :(γ, 'ffi) dataSem$state) with clock := (y :num)).ffi = s.ffi
with_same_clock_typed=(s :(γ, 'ffi) dataSem$state) with clock := s.clock = s
cut_state_eq_some_typed=cut_state (names :sptree$num_set) (s :(α, β) dataSem$state) = SOME (y :(α, β) dataSem$state) ⇔ ∃(z :v sptree$num_map). cut_env names s.locals = SOME z ∧ y = s with locals := z
cut_state_eq_none_typed=cut_state (names :sptree$num_set) (s :(α, β) dataSem$state) = (NONE :(α, β) dataSem$state option) ⇔ cut_env names s.locals = (NONE :v sptree$num_map option)
