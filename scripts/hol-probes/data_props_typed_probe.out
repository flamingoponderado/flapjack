pop_env_const_typed=pop_env (a :(α, β) dataSem$state) = SOME (b :(α, β) dataSem$state) ⇒ b.ffi = a.ffi ∧ b.clock = a.clock ∧ b.stack_max = a.stack_max
pop_env_safe_for_space_typed=pop_env (s2 :(α, β) dataSem$state) = SOME (s1 :(α, β) dataSem$state) ⇒ (s1.safe_for_space ⇔ s2.safe_for_space)
do_app_io_events_mono_typed=(do_app (x :closLang$op) (y :v list) (z :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((a :v),(b :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.ffi.io_events ≼ b.ffi.io_events
do_app_stack_max_typed=(do_app (op :closLang$op) (xs :v list) (s1 :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((v :v),(s2 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ option_le s1.stack_max s2.stack_max
do_app_safe_for_space_mono_typed=(do_app (op :closLang$op) (xs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((r :v),(s1 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ∧ s1.safe_for_space ⇒ s.safe_for_space
evaluate_io_events_mono_typed=∀(exps :dataLang$prog) (s1 :(α, β) dataSem$state) (res :(v list, v) result option) (s2 :(α, β) dataSem$state). (evaluate (exps,s1) :(v list, v) result option # (α, β) dataSem$state) = (res,s2) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
evaluate_safe_for_space_mono_typed=∀(prog :dataLang$prog) (s :(γ, 'ffi) dataSem$state) (res :(v list, v) result option) (s1 :(γ, 'ffi) dataSem$state). (evaluate (prog,s) :(v list, v) result option # (γ, 'ffi) dataSem$state) = (res,s1) ∧ s1.safe_for_space ⇒ s.safe_for_space
evaluate_option_le_stack_max_typed=∀(c2 :dataLang$prog) (s :(α, β) dataSem$state) (res :(v list, v) result option) (s1 :(α, β) dataSem$state). (evaluate (c2,s) :(v list, v) result option # (α, β) dataSem$state) = (res,s1) ⇒ option_le s.stack_max s1.stack_max
do_app_aux_const_typed=do_app_aux (op :closLang$op) (vs :v list) (x :(α, β) dataSem$state) = (Rval ((y :v),(z :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.stack = x.stack ∧ z.handler = x.handler ∧ z.locals = x.locals ∧ z.clock = x.clock ∧ z.compile = x.compile
do_app_const_typed=(do_app (op :closLang$op) (vs :v list) (x :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rval ((y :v),(z :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) result) ⇒ z.stack = x.stack ∧ z.handler = x.handler ∧ z.locals = x.locals ∧ z.clock = x.clock ∧ z.compile = x.compile
do_app_aux_err_typed=do_app_aux (op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) = (Rerr (e :v error_result) :(v # (α, β) dataSem$state, v) result) ⇒ e = (Rabort Rtype_error :v error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :v error_result)
do_app_err_typed=(do_app (op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) result) = (Rerr (e :v error_result) :(v # (α, β) dataSem$state, v) result) ⇒ e = (Rabort Rtype_error :v error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :v error_result)
EVERY_get_vars_typed=∀(args :num list) (s1 :α sptree$num_map) (s2 :α sptree$num_map). EVERY (λ(a :num). (lookup a s1 :α option) = (lookup a s2 :α option)) args ⇒ get_vars args s1 = get_vars args s2
get_vars_IMP_domain_typed=∀(args :num list) (x :num) (s :α sptree$num_map) (vs :α list). MEM x args ∧ get_vars args s = SOME vs ⇒ x ∈ (domain s :num -> bool)
get_vars_append_typed=∀(l1 :num list) (l2 :num list) (s :α sptree$num_map). get_vars (l1 ++ l2) s = OPTION_BIND (get_vars l1 s) (λ(y1 :α list). OPTION_BIND (get_vars l2 s) (λ(y2 :α list). SOME (y1 ++ y2)))
get_vars_reverse_typed=∀(ls :num list) (s :α sptree$num_map) (ys :α list). get_vars ls s = SOME ys ⇒ get_vars (REVERSE ls) s = SOME (REVERSE ys)
var_corr_def_typed=∀(env :α list) (corr :num list) (t :α sptree$num_map). var_corr env corr t ⇔ LIST_REL (λ(v :num) (x :α). (get_var v t :α option) = SOME x) corr env
get_vars_thm_typed=∀(vs :num list) (a :α list) (t2 :α sptree$num_map). var_corr a vs t2 ⇒ get_vars vs t2 = SOME a
get_code_labels_def_typed=(∀(r :(num list # sptree$num_set) option) (h :(num # dataLang$prog) option) (d :num option) (a :num list). get_code_labels (Call r d a h :dataLang$prog) = (case d of (NONE :num option) => (∅ :num -> bool) | SOME x => {x}) ∪ case h of (NONE :(num # dataLang$prog) option) => (∅ :num -> bool) | SOME (n,p) => get_code_labels p) ∧ (∀(v1 :num) (v0 :(num # sptree$num_set) option) (loc :num). get_code_labels (Force v0 loc v1 :dataLang$prog) = {loc}) ∧ (∀(p2 :dataLang$prog) (p1 :dataLang$prog). get_code_labels (Seq p1 p2) = get_code_labels p1 ∪ get_code_labels p2) ∧ (∀(v2 :num) (p2 :dataLang$prog) (p1 :dataLang$prog). get_code_labels (If v2 p1 p2 :dataLang$prog) = get_code_labels p1 ∪ get_code_labels p2) ∧ (∀(v5 :sptree$num_set option) (v4 :num list) (v3 :num) (op :closLang$op). get_code_labels (Assign v3 op v4 v5 :dataLang$prog) = assign_get_code_label op) ∧ get_code_labels Skip = (∅ :num -> bool) ∧ (∀(v7 :num) (v :num). get_code_labels (Move v v7 :dataLang$prog) = (∅ :num -> bool)) ∧ (∀(v22 :sptree$num_set) (v21 :num). get_code_labels (MakeSpace v21 v22) = (∅ :num -> bool)) ∧ (∀(v23 :num). get_code_labels (Raise v23 :dataLang$prog) = (∅ :num -> bool)) ∧ (∀(v24 :num list). get_code_labels (Return v24 :dataLang$prog) = (∅ :num -> bool)) ∧ get_code_labels Tick = (∅ :num -> bool)
cut_state_opt_with_const_typed=cut_state_opt (x :sptree$num_set option) ((y :(α, β) dataSem$state) with stack := (z :stack list)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with stack := z) (cut_state_opt x y) ∧ cut_state_opt x (y with clock := (k :num)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with clock := k) (cut_state_opt x y) ∧ cut_state_opt x (y with locals_size := (lsz :num option)) = OPTION_MAP (λ(s :(α, β) dataSem$state). s with locals_size := lsz) (cut_state_opt x y)
do_app_aux_with_locals_typed=do_app_aux (op :closLang$op) (vs :v list) ((s :(α, β) dataSem$state) with locals := (z :v sptree$num_map)) = map_result (λ((x :v),(y :(α, β) dataSem$state)). (x,y with locals := z)) (I :v -> v) (do_app_aux op vs s)
do_app_aux_with_space_typed=do_app_aux (op :closLang$op) (vs :v list) ((s :(α, β) dataSem$state) with space := (z :num)) = map_result (λ((x :v),(y :(α, β) dataSem$state)). (x,y with space := z)) (I :v -> v) (do_app_aux op vs s)
consume_space_add_space_typed=∃(sf :bool) (hp :num). consume_space (k :num) (add_space ((t :(α, β) dataSem$state) with locals := (env1 :v sptree$num_map)) k) = SOME (t with <|locals := env1; space := (0 :num); safe_for_space := sf; peak_heap_length := hp|>)
same_stack_size_def_typed=∀(x :stack) (y :stack). same_stack_size x y ⇔ size_of_stack_frame x = size_of_stack_frame y
same_stack_size_size_of_stack_typed=∀(xs :stack list) (ys :stack list). LIST_REL same_stack_size xs ys ⇒ size_of_stack xs = size_of_stack ys
s_peak_heap_typed=(s :(α, β) dataSem$state) with peak_heap_length := s.peak_heap_length = s ∧ s with safe_for_space := s.safe_for_space = s ∧ s with stack_max := s.stack_max = s ∧ s with locals_size := s.locals_size = s ∧ s with <|stack := s.stack; stack_max := (smnew :num option); clock := (clock :num); safe_for_space := (ssnew :bool)|> = s with <|stack_max := smnew; clock := clock; safe_for_space := ssnew|> ∧ s with <|handler := s.handler; safe_for_space := ssnew; peak_heap_length := (plnnew :num)|> = s with <|safe_for_space := ssnew; peak_heap_length := plnnew|>
evaluate_smx_safe_peak_swap_aux_typed=∀(smx :num option) (safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ (let (s0 :(α, β) dataSem$state) = s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|> in ∃(smx :num option) (safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>))
evaluate_smx_safe_peak_swap_typed=∀(smx :num option) (safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ ∃(smx' :num option) (safe' :bool) (peak' :num). (evaluate (c,s with <|stack_max := smx; safe_for_space := safe; peak_heap_length := peak|>) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := smx'; safe_for_space := safe'; peak_heap_length := peak'|>)
evaluate_safe_peak_swap_aux_typed=∀(safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ (let (s0 :(α, β) dataSem$state) = s with <|stack_max := s.stack_max; safe_for_space := safe; peak_heap_length := peak|> in ∃(safe :bool) (peak :num). (evaluate (c,s0) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|stack_max := s'.stack_max; safe_for_space := safe; peak_heap_length := peak|>))
evaluate_safe_peak_swap_typed=∀(safe :bool) (s' :(α, β) dataSem$state) (s :(α, β) dataSem$state) (r :(v list, v) result option) (peak :num) (c :dataLang$prog). (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (r,s') ⇒ ∃(safe' :bool) (peak' :num). (evaluate (c,s with <|safe_for_space := safe; peak_heap_length := peak|>) :(v list, v) result option # (α, β) dataSem$state) = (r,s' with <|safe_for_space := safe'; peak_heap_length := peak'|>)
do_app_safe_peak_swap_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (q :v) (s' :(α, β) dataSem$state) (safe :bool) (peak :num). (do_app op vs s :(v # (α, β) dataSem$state, v) result) = (Rval (q,s') :(v # (α, β) dataSem$state, v) result) ⇒ ∃(new_safe :bool) (new_peak :num). (do_app op vs (s with <|safe_for_space := safe; peak_heap_length := peak|>) :(v # (α, β) dataSem$state, v) result) = (Rval (q,s' with <|safe_for_space := new_safe; peak_heap_length := new_peak|>) :(v # (α, β) dataSem$state, v) result)
