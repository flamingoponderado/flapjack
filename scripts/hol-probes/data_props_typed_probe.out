do_space_alt_typed=do_space (op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) = if op_space_reset op then SOME (s with <|space := (0 :num); safe_for_space := do_space_safe op vs s; peak_heap_length := do_space_peak op vs s|>) else consume_space (op_space_req op (LENGTH vs)) s
evaluate_safe_alt_typed=∀(c :dataLang$prog) (s :(α, β) dataSem$state). evaluate_safe c s ⇔ (SND (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state)).safe_for_space
evaluate_peak_alt_typed=∀(c :dataLang$prog) (s :(α, β) dataSem$state). evaluate_peak c s = (SND (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state)).peak_heap_length
set_var_const_typed=(set_var (x :num) (y :v) (z :(β, α) dataSem$state)).ffi = z.ffi ∧ (set_var x y z).clock = z.clock
set_var_with_const_typed=set_var (x :num) (y :v) ((z :(α, β) dataSem$state) with clock := (k :num)) = set_var x y z with clock := k
set_vars_const_typed=(set_vars (xs :num list) (ys :v list) (z :(β, α) dataSem$state)).ffi = z.ffi ∧ (set_vars xs ys z).clock = z.clock
set_vars_with_const_typed=set_vars (xs :num list) (ys :v list) ((z :(α, β) dataSem$state) with clock := (k :num)) = set_vars xs ys z with clock := k
