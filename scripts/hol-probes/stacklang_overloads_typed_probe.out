add_1_inst_typed=λ(r1 :num). (Inst (Arith (Binop Add r1 r1 (Imm (1w :α word))) :α inst) :α prog)
add_bytes_in_word_inst_typed=λ(r1 :num). (Inst (Arith (Binop Add r1 r1 (Imm (bytes_in_word :α word))) :α inst) :α prog)
add_inst_typed=λ(r1 :num) (r2 :num). (Inst (Arith (Binop Add r1 r1 (Reg r2 :α reg_imm)) :α inst) :α prog)
and_inst_typed=λ(r1 :num) (r2 :num). (Inst (Arith (Binop And r1 r1 (Reg r2 :α reg_imm)) :α inst) :α prog)
div2_inst_typed=λ(r :num). (right_shift_inst r (1 :num) :α prog)
move_typed=λ(dest :num) (src :num). (Inst (Arith (Binop Or dest src (Reg src :α reg_imm)) :α inst) :α prog)
or_inst_typed=λ(r1 :num) (r2 :num). (Inst (Arith (Binop Or r1 r1 (Reg r2 :α reg_imm)) :α inst) :α prog)
sub_1_inst_typed=λ(r1 :num). (Inst (Arith (Binop Sub r1 r1 (Imm (1w :α word))) :α inst) :α prog)
sub_inst_typed=λ(r1 :num) (r2 :num). (Inst (Arith (Binop Sub r1 r1 (Reg r2 :α reg_imm)) :α inst) :α prog)
While_typed=λ(cmp :cmp) (r :num) (ri :α reg_imm) (c :α prog). Loop (If cmp r ri c (Break (0 :num) :α prog) :α prog)
xor_inst_typed=λ(r1 :num) (r2 :num). (Inst (Arith (Binop Xor r1 r1 (Reg r2 :α reg_imm)) :α inst) :α prog)
const_inst_typed=λ(r :num) (w :α word). (Inst (Const r w) :α prog)
left_shift_inst_typed=λ(r :num) (v :num). (Inst (Arith (Shift Lsl r r (Imm (n2w v :α word)) :α arith) :α inst) :α prog)
load_inst_typed=λ(r :num) (a :num). (Inst (Mem Load r (Addr a (0w :α word))) :α prog)
right_shift_inst_typed=λ(r :num) (v :num). (Inst (Arith (Shift Lsr r r (Imm (n2w v :α word)) :α arith) :α inst) :α prog)
store_inst_typed=λ(r :num) (a :num). (Inst (Mem Store r (Addr a (0w :α word))) :α prog)
