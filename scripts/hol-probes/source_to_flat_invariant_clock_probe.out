change_clock_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (env :next_indices # next_indices # (num # idx_types -> bool)) (st1 :'b semanticPrimitives$state) (st2 :('a, 'b) flatSem$state) ==> invariant interp g gen genv env (st1 with clock := (k :num)) (st2 with clock := k)
dec_clock_typed=invariant (interp :(semanticPrimitives$v -> (config # 'a) option) option) (g :dec list -> dec list) (gen :environment_generation_store) (genv :global_env) (env :next_indices # next_indices # (num # idx_types -> bool)) (st1 :'b semanticPrimitives$state) (st2 :('a, 'b) flatSem$state) ==> st1.clock = st2.clock /\ invariant interp g gen genv env (dec_clock st1) (dec_clock st2)
