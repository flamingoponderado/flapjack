alloc_env_ref_def_typed=alloc_env_ref = (App None (GlobalVarInit (0 :num)) [(App None (Src Opref) [(Con None (NONE :(num # num option) option) ([] :exp list) :exp)] :exp)] :exp)
compile_flat_def_typed=∀(pcfg :flat_pattern$config). compile_flat pcfg = MAP (compile_dec pcfg) ∘ remove_flat_prog
environment_generation_store_typed=recordtype.environment_generation_store::num -> num -> environment sptree$num_map -> environment_generation_store
environment_store_typed=recordtype.environment_store::num -> environment sptree$num_map sptree$num_map -> environment_store
glob_alloc_def_typed=∀(next :next_indices) (c :config). glob_alloc next c = (Let om_tra (NONE :mlstring option) (App om_tra (GlobalVarAlloc (next.vidx − c.next.vidx)) ([] :exp list) :exp) (Con om_tra (NONE :(num # num option) option) ([] :exp list) :exp) :exp)
inc_compile_def_typed=∀(env_id :num # num) (c :config) (p :dec list). inc_compile env_id c p = (let ((c' :config),(p' :exp list)) = inc_compile_prog env_id c p; (p' :exp list) = MAP (compile_dec c'.pattern_cfg) p' in (c',p'))
inc_compile_prog_def_typed=∀(env_id :num # num) (c :config) (p :dec list). inc_compile_prog env_id c p = (let (env :environment) = lookup_env_id env_id c.envs; (envs :environment_generation_store) = <|next := (0 :num); generation := c.envs.next; envs := (LN :environment sptree$num_map)|>; ((_0 :num),(next :next_indices),(e :environment),(gen :environment_generation_store),(p' :exp list)) = compile_decs ([] :mlstring list) (1 :num) c.next env envs p; (gen_envs :environment sptree$num_map) = insert gen.next (extend_env e env) gen.envs; (envs2 :environment_store) = <|next := c.envs.next + (1 :num); env_gens := insert c.envs.next gen_envs c.envs.env_gens|> in (c with <|next := next; envs := envs2|>,glob_alloc next c::p' ++ [store_env_id gen.generation gen.next]))
lookup_env_id_def_typed=∀(env_id :num # num) (envs :environment_store). lookup_env_id env_id envs = case lookup (FST env_id) envs.env_gens of (NONE :environment sptree$num_map option) => empty_env | SOME gen => case lookup (SND env_id) gen of (NONE :environment option) => empty_env | SOME env => env
next_indices_typed=recordtype.next_indices::num -> num -> num -> next_indices
store_env_id_def_typed=∀(gen :num) (id :num). store_env_id gen id = (Let None (SOME «r») (App None (GlobalVarLookup (0 :num)) ([] :exp list) :exp) (App None (Src Opassign) [Var_local None «r»; env_id_tuple gen id] :exp) :exp)
var_name_typed=Glob::tra -> num -> var_name; Local::tra -> mlstring -> var_name
compile_exps_append_typed=∀(env :environment) (es :ast$exp list) (es' :ast$exp list). (compile_exps (t :mlstring list) env (es ++ es') :exp list) = (compile_exps t env es :exp list) ++ (compile_exps t env es' :exp list)
compile_funs_dom_typed=∀(funs :(mlstring # mlstring # ast$exp) list). MAP (λ((x :mlstring),(y :mlstring),(z :ast$exp)). x) funs = MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) (compile_funs (t :mlstring list) (env :environment) funs)
alloc_defs_append_typed=∀(m :num) (n :num) (l1 :α list) (l2 :α list). alloc_defs m n (l1 ++ l2) = alloc_defs m n l1 ++ alloc_defs (m + LENGTH l1) (n + LENGTH l1) l2
type_group_id_type_MAP_typed=(type_group_id_type :(α # (β # γ) option) option -> (α # β option) option) = OPTION_MAP ((I :α -> α) ## OPTION_MAP (FST :β # γ -> β))
