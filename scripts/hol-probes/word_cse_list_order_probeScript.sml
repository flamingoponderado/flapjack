load "preamble"; load "word_cseProofTheory";
open HolKernel Parse bossLib preamble word_cseProofTheory word_cseTheory;
val _ = Globals.linewidth := 2000;
val _ = (print "lo_definition="; print_thm word_cseTheory.listCmp_def; print "\n");
val replay_eq = prove(``  ∀L1 L2. listCmp L1 L2 = Equal ⇔ L1 = L2``,   strip_tac
  \\Induct_on ‘L1’
    >- (Cases_on ‘L2’
        \\ rw[listCmp_def])
    >- (Cases_on ‘L2’
        >- rw[listCmp_def]
        >- (strip_tac >>
            Cases_on ‘h=h'’
            \\ rw[listCmp_def])));
val _ = (if null(hyp replay_eq) then () else raise Fail "open replay premise"; print "lo_full_eq="; print_thm replay_eq; print "\n");
val replay_reverse = prove(``  ∀x y. listCmp x y = Greater ⇔ listCmp y x = Less``,   gen_tac \\ Induct_on ‘x’
  >- (Cases_on ‘y’ \\ gvs [listCmp_def])
  \\ rpt gen_tac
  \\ Cases_on ‘y’ \\ gvs [listCmp_def]
  \\ Cases_on ‘h=h'’ \\ gvs []
  \\ Cases_on ‘h>h'’ \\ gvs []);
val _ = (if null(hyp replay_reverse) then () else raise Fail "open replay premise"; print "lo_full_reverse="; print_thm replay_reverse; print "\n");
val replay_transit = prove(``  ∀x y z. listCmp x y = Less ∧ listCmp y z = Less ⇒ listCmp x z = Less``,   gen_tac
  \\ Induct_on ‘x’
  >- (Cases_on ‘y’ \\ Cases_on ‘z’ \\ gvs [listCmp_def])
  \\ rpt gen_tac \\ strip_tac
  \\ Cases_on ‘y’ \\ Cases_on ‘z’ \\ gvs [listCmp_def]
  \\ Cases_on ‘h=h'’ \\ Cases_on ‘h'=h''’ \\ gvs [listCmp_def]
  >- (‘listCmp x t = Less ∧ listCmp t t' = Less’ by gvs []
      \\ first_x_assum drule_all \\ gvs [])
  \\ Cases_on ‘h>h'’ \\ Cases_on ‘h'>h''’ \\ gvs []);
val _ = (if null(hyp replay_transit) then () else raise Fail "open replay premise"; print "lo_full_transit="; print_thm replay_transit; print "\n");
fun emit label q = let val th = EVAL q in print(label ^ "="); print_thm th; print "\n" end;
fun proved label q tac = let val th = prove(q,tac) in if null(hyp th) then () else raise Fail "open application premise"; print(label ^ "="); print_thm th; print "\n" end;
