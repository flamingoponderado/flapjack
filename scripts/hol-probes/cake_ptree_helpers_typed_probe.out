isLower_def_typed=∀(c :char). isLower c ⇔ (97 :num) ≤ ORD c ∧ ORD c ≤ (122 :num)
isUpper_def_typed=∀(c :char). isUpper c ⇔ (65 :num) ≤ ORD c ∧ ORD c ≤ (90 :num)
isAlpha_def_typed=∀(c :char). isAlpha c ⇔ isLower c ∨ isUpper c
oHD_def_typed=∀(l :α list). oHD l = case l of ([] :α list) => (NONE :α option) | h::v1 => SOME h
ifM_def_typed=∀(bM :bool option) (tM :α option) (eM :α option). ifM bM tM eM = OPTION_BIND bM (λ(b :bool). if b then tM else eM)
tokcheckl_def_typed=∀(toks :α list) (pts :(α, β, γ) parsetree list). tokcheckl pts toks ⇔ case (pts,toks) of (([] :(α, β, γ) parsetree list),([] :α list)) => T | (([] :(α, β, γ) parsetree list),v10::v11) => F | (pt::prest,([] :α list)) => F | (pt::prest,tok::tokrest) => tokcheck pt tok ∧ tokcheckl prest tokrest
singleSymP_def_typed=(singleSymP (P :mlstring -> bool) [(pt :(token, β, γ) parsetree)] :(α, mlstring) id option) = OPTION_BIND (OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, β) symbol -> token option)) destSymbolT) (λ(s :mlstring). OPTION_IGNORE_BIND (OPTION_GUARD (P s)) (SOME (Short s :(α, mlstring) id))) ∧ (singleSymP (v0 :mlstring -> bool) ([] :(token, β, γ) parsetree list) :(α, mlstring) id option) = (NONE :(α, mlstring) id option) ∧ (singleSymP v0 ((v3 :(token, β, γ) parsetree)::(v7 :(token, β, γ) parsetree)::(v8 :(token, β, γ) parsetree list)) :(α, mlstring) id option) = (NONE :(α, mlstring) id option)
isSymbolicConstructor_def_typed=∀(s :string). isSymbolicConstructor s = SOME (s = "::")
isConstructor_def_typed=∀(s :string). isConstructor s = ifM (isSymbolicConstructor s) (SOME T) (SOME (case oHD s of (NONE :char option) => F | SOME c => isAlpha c ∧ isUpper c))
