rca_definition=⊢ (∀ret ptr2 ptr p2 p1 len2 len. call_args (Seq p1 p2) ptr len ptr2 len2 ret ⇔ call_args p1 ptr len ptr2 len2 ret ∧ call_args p2 ptr len ptr2 len2 ret) ∧ (∀ri ret r ptr2 ptr p2 p1 len2 len c. call_args (If c r ri p1 p2) ptr len ptr2 len2 ret ⇔ call_args p1 ptr len ptr2 len2 ret ∧ call_args p2 ptr len ptr2 len2 ret) ∧ (∀ret ptr2 ptr p1 len2 len. call_args (Loop p1) ptr len ptr2 len2 ret ⇔ call_args p1 ptr len ptr2 len2 ret) ∧ (∀ret ptr2 ptr n len2 len. call_args (Halt n) ptr len ptr2 len2 ret ⇔ n = ptr) ∧ (∀ret' ret ptr2' ptr2 ptr' ptr len2' len2 len' len ffi_index. call_args (FFI ffi_index ptr' len' ptr2' len2' ret') ptr len ptr2 len2 ret ⇔ ptr' = ptr ∧ len' = len ∧ ptr2' = ptr2 ∧ len2' = len2 ∧ ret' = ret) ∧ (∀x2 x1 v0 ret ptr2 ptr len2 len. call_args (Call x1 v0 x2) ptr len ptr2 len2 ret ⇔ case x1 of NONE => T | SOME (v4,v6,v7) => call_args v4 ptr len ptr2 len2 ret ∧ v6 = ret ∧ case x2 of NONE => T | SOME (v1,v2) => call_args v1 ptr len ptr2 len2 ret) ∧ (∀v2 v1 ret' ret ptr2 ptr' ptr len2 len' len. call_args (Install ptr' len' v1 v2 ret') ptr len ptr2 len2 ret ⇔ ptr' = ptr ∧ len' = len ∧ ret' = ret) ∧ (∀ret ptr2 ptr len2 len. call_args Skip ptr len ptr2 len2 ret ⇔ T) ∧ (∀v18 ret ptr2 ptr len2 len. call_args (Inst v18) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v20 v19 ret ptr2 ptr len2 len. call_args (Get v19 v20) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v22 v21 ret ptr2 ptr len2 len. call_args (Set v21 v22) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v25 v24 v23 ret ptr2 ptr len2 len. call_args (OpCurrHeap v23 v24 v25) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v39 v38 v37 ret ptr2 ptr len2 len. call_args (JumpLower v37 v38 v39) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v40 ret ptr2 ptr len2 len. call_args (Alloc v40) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v43 v42 v41 ret ptr2 ptr len2 len. call_args (StoreConsts v41 v42 v43) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v44 ret ptr2 ptr len2 len. call_args (Raise v44) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v45 ret ptr2 ptr len2 len. call_args (Return v45) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v46 ret ptr2 ptr len2 len. call_args (Break v46) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v47 ret ptr2 ptr len2 len. call_args (Continue v47) ptr len ptr2 len2 ret ⇔ T) ∧ (∀ret ptr2 ptr len2 len. call_args Tick ptr len ptr2 len2 ret ⇔ T) ∧ (∀v56 v55 v54 ret ptr2 ptr len2 len. call_args (LocValue v54 v55 v56) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v64 v63 v62 ret ptr2 ptr len2 len. call_args (ShMemOp v62 v63 v64) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v66 v65 ret ptr2 ptr len2 len. call_args (CodeBufferWrite v65 v66) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v68 v67 ret ptr2 ptr len2 len. call_args (DataBufferWrite v67 v68) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v69 ret ptr2 ptr len2 len. call_args (RawCall v69) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v70 ret ptr2 ptr len2 len. call_args (StackAlloc v70) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v71 ret ptr2 ptr len2 len. call_args (StackFree v71) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v73 v72 ret ptr2 ptr len2 len. call_args (StackStore v72 v73) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v75 v74 ret ptr2 ptr len2 len. call_args (StackStoreAny v74 v75) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v77 v76 ret ptr2 ptr len2 len. call_args (StackLoad v76 v77) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v79 v78 ret ptr2 ptr len2 len. call_args (StackLoadAny v78 v79) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v80 ret ptr2 ptr len2 len. call_args (StackGetSize v80) ptr len ptr2 len2 ret ⇔ T) ∧ (∀v81 ret ptr2 ptr len2 len. call_args (StackSetSize v81) ptr len ptr2 len2 ret ⇔ T) ∧ ∀v83 v82 ret ptr2 ptr len2 len. call_args (BitmapLoad v82 v83) ptr len ptr2 len2 ret ⇔ T
rca_full_stack_move_call_args=⊢ ∀n st off i p. call_args p 1 2 3 4 0 ⇒ call_args (stack_move n st off i p) 1 2 3 4 0
rca_full_copy_ret_aux_call_args=⊢ ∀k f n. call_args (copy_ret_aux k f n) 1 2 3 4 0
rca_full_copy_ret_call_args=⊢ call_args (copy_ret perf b kf vs kont) 1 2 3 4 0 ⇔ call_args kont 1 2 3 4 0
