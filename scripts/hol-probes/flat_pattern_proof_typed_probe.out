naive_pattern_match_correct_typed=∀(t :tra) (mats :(flatLang$pat # exp) list) (vs :v list) (bindings :(mlstring # v) list) (exp :exp) (res :(mlstring # v) list match_result). LIST_REL (pure_eval_to (s :(α, β) state) (env :v environment)) (MAP (SND :flatLang$pat # exp -> exp) mats) vs ∧ (pmatch_list s (MAP (FST :flatLang$pat # exp -> flatLang$pat) mats) vs bindings :(mlstring # v) list match_result) = res ∧ res ≠ (Match_type_error :(mlstring # v) list match_result) ∧ naive_pattern_match t mats = exp ⇒ pure_eval_to s env exp (Boolv (res ≠ (No_match :(mlstring # v) list match_result)) :v)
FLOOKUP_encode_refs_typed=FLOOKUP (encode_refs (s :(α, β) state)) (n :num) = if n < LENGTH s.refs then case s.refs❲n❳ of Refv v => SOME (encode_val v) | (W8array v7 :v store_v) => (NONE :term option) | Varray v8 => (NONE :term option) | Thunk v9 v10 => (NONE :term option) else (NONE :term option)
ALOOKUP_FILTER_EQ_typed=∀(xs :(α # β) list). (∀(z :β). (P :α # β -> bool) ((x :α),z)) ⇒ ALOOKUP (FILTER P xs) x = ALOOKUP xs x
FILTER_EQ_MONO_typed=∀(xs :α list) (ys :α list). FILTER (P1 :α -> bool) xs = FILTER (P2 :α -> bool) ys ∧ (∀(x :α). MEM x xs ∧ (P3 :α -> bool) x ⇒ P1 x) ∧ (∀(y :α). MEM y ys ∧ (P4 :α -> bool) y ⇒ P2 y) ∧ (∀(x :α) (y :α). MEM x xs ∧ MEM y ys ∧ x = y ⇒ (P3 x ⇔ P4 y)) ⇒ FILTER P3 xs = FILTER P4 ys
FILTER_EQ_MONO_TRANS_typed=∀(xs :α list) (ys :α list). FILTER (P1 :α -> bool) xs = ys ∧ (∀(x :α). MEM x xs ∧ (P3 :α -> bool) x ⇒ P1 x) ∧ (∀(x :α) (y :α). MEM x xs ∧ MEM y ys ∧ x = y ⇒ (P3 x ⇔ P3 y)) ⇒ FILTER P3 xs = FILTER P3 ys
v_rel_l_cases_typed=(v_rel (Litv (l :lit) :v) (v2 :v) ⇔ v2 = (Litv l :v) ∧ v_container_xs v2 = ([] :v list)) ∧ (v_rel (Conv (o' :(num # num option) option) (l :v list)) v2 ⇔ (∃(vs2 :v list). v2 = Conv o' vs2) ∧ LIST_REL v_rel l (v_container_xs v2)) ∧ (v_rel (Closure (e :v environment) (m :mlstring) (e0 :exp) :v) v2 ⇔ ∃(N :num) (env2 :v environment) (cfg :config). v2 = (Closure env2 m (SND (SND (compile_exp cfg e0))) :v) ∧ env_rel N e env2 ∧ FST (compile_exp cfg e0) < N) ∧ (v_rel (Recclosure e (l :(mlstring # mlstring # exp) list) m :v) v2 ⇔ ∃(N :num) (env2 :v environment) (cfg :config). v2 = (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) l) m :v) ∧ env_rel N e env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) l) ∧ (v_rel (Loc (b :bool) (n :num) :v) v2 ⇔ v2 = (Loc b n :v) ∧ v_container_xs v2 = ([] :v list)) ∧ (v_rel (Vectorv l) v2 ⇔ (∃(vs2 :v list). v2 = Vectorv vs2) ∧ LIST_REL v_rel l (v_container_xs v2))
naive_pattern_match_correct_inst_typed=∀(x :exp) (v :v) (t :tra) (s :(α, β) state) (p :flatLang$pat) (env :v environment). pure_eval_to s env x v ∧ (pmatch_list s [p] [v] ([] :(mlstring # v) list) :(mlstring # v) list match_result) ≠ (Match_type_error :(mlstring # v) list match_result) ⇒ (evaluate env s [naive_pattern_match t [(p,x)]] :(α, β) state # (v list, v) result) = (s,(Rval [(Boolv ((pmatch_list s [p] [v] ([] :(mlstring # v) list) :(mlstring # v) list match_result) ≠ (No_match :(mlstring # v) list match_result)) :v)] :(v list, v) result))
fold_Boolv_typed=(∀(b :bool). Conv (SOME (bool_to_tag b,SOME bool_id)) ([] :v list) = (Boolv b :v)) ∧ ∀(b :bool). (if b then true_tag else false_tag) = bool_to_tag b
do_app_thm_typed=∀(s1 :(α, β) state) (vs1 :v list) (t1 :(α, β) state) (r1 :(v, v) result) (s2 :(α, β) state) (vs2 :v list). do_app s1 (op :op) vs1 = SOME (t1,r1) ⇒ state_rel (cfg :config) s1 s2 ∧ LIST_REL v_rel vs1 vs2 ⇒ ∃(t2 :(α, β) state) (r2 :(v, v) result). result_rel v_rel v_rel r1 r2 ∧ state_rel cfg t1 t2 ∧ do_app s2 op vs2 = SOME (t2,r2)
state_rel_IMP_clock_typed=state_rel (cfg :config) (s :(α, β) state) (t :(α, β) state) ⇒ t.clock = s.clock
v_rel_ind_typed=∀(v_rel' :v -> v -> bool) (env_rel' :num -> v environment -> v environment -> bool). (∀(v :v) (v' :v). simple_basic_val_rel v v' ∧ LIST_REL v_rel' (v_container_xs v) (v_container_xs v') ⇒ v_rel' v v') ∧ (∀(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). env_rel' N env1 env2 ∧ FST (compile_exp cfg x) < N ⇒ v_rel' (Closure env1 n x :v) (Closure env2 n (SND (SND (compile_exp cfg x))) :v)) ∧ (∀(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). env_rel' N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs ⇒ v_rel' (Recclosure env1 fs x :v) (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v)) ∧ (∀(N :num) (env1 :v environment) (env2 :v environment). ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel' env1.v env2.v ⇒ env_rel' N env1 env2) ⇒ (∀(a0 :v) (a1 :v). v_rel a0 a1 ⇒ v_rel' a0 a1) ∧ ∀(a2 :num) (a3 :v environment) (a4 :v environment). env_rel a2 a3 a4 ⇒ env_rel' a2 a3 a4
v_rel_cases_typed=(∀(a0 :v) (a1 :v). v_rel a0 a1 ⇔ simple_basic_val_rel a0 a1 ∧ LIST_REL v_rel (v_container_xs a0) (v_container_xs a1) ∨ (∃(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). a0 = (Closure env1 n x :v) ∧ a1 = (Closure env2 n (SND (SND (compile_exp cfg x))) :v) ∧ env_rel N env1 env2 ∧ FST (compile_exp cfg x) < N) ∨ ∃(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). a0 = (Recclosure env1 fs x :v) ∧ a1 = (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v) ∧ env_rel N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs) ∧ ∀(a2 :num) (a3 :v environment) (a4 :v environment). env_rel a2 a3 a4 ⇔ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < a2) v_rel a3.v a4.v
comp_thm_typed=∀(x :matchResult). match (refs :num |-> term) (rows :(pat # num) list) (v :term) = SOME x ⇒ dt_eval refs v (comp rows) = SOME x
