OPTION_ALL_FORALL_typed=OPTION_ALL (P :α -> bool) (x :α option) ⇔ ∀(y :α). x = SOME y ⇒ P y
pmatch_rows_encode_typed=∀(pats :(flatLang$pat # α) list) (j_offs :num). pmatch_rows pats (s :(β, γ) state) (v :v) ≠ (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) ⇒ case match (encode_refs s) (MAPi (λ(j :num) ((p :flatLang$pat),(_0 :α)). (encode_pat p,j + j_offs)) pats) (encode_val v) of (NONE :matchResult option) => F | SOME (MatchSuccess n) => ∃(i :num) (env :(mlstring # v) list). n = i + j_offs ∧ i < LENGTH pats ∧ (pmatch s (FST pats❲i❳) v ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match env ∧ pmatch_rows pats s v = Match (env,pats❲i❳) | SOME MatchFailure => pmatch_rows pats s v = (No_match :((mlstring # v) list # flatLang$pat # α) match_result)
SmartIf_thm_typed=SmartIf (t :tra) (e :exp) (p :exp) (q :exp) = if ∃(t :tra). e = Bool t T then p else if ∃(t :tra). e = Bool t F then q else (If t e p q :exp)
do_eq_Boolv_typed=do_eq (Boolv (x :bool) :v) (Boolv (y :bool) :v) = Eq_val (x ⇔ y)
app_pos_Term_IMP_typed=∀(xs :term list) (n :num). app_pos (refs :num |-> term) (Pos n (pos :position)) (Term (c :num option) xs) = SOME (y :term) ⇒ n < LENGTH xs ∧ app_pos refs pos xs❲n❳ = SOME y
MAX_LIST_LESS_EVERY_typed=MAX_LIST (xs :num list) < (N :num) ⇔ (0 :num) < N ∧ EVERY (λ(x :num). x < N) xs
do_if_helper_typed=do_if (b :v) (x :α) (y :α) = SOME (e :α) ∧ v_rel b (b' :v) ⇒ (b' = (Boolv T :v) ⇔ b = (Boolv T :v)) ∧ (b' = (Boolv F :v) ⇔ b = (Boolv F :v))
do_app_thm_REVERSE_typed=do_app (s1 :(α, β) state) (op :op) (REVERSE (vs1 :v list)) = SOME ((t1 :(α, β) state),(r1 :(v, v) result)) ∧ state_rel (cfg :config) s1 (s2 :(α, β) state) ∧ LIST_REL v_rel vs1 (vs2 :v list) ⇒ ∃(t2 :(α, β) state) (r2 :(v, v) result). result_rel v_rel v_rel r1 r2 ∧ state_rel cfg t1 t2 ∧ do_app s2 op (REVERSE vs2) = SOME (t2,r2)
pmatch_rows_same_FST_typed=∀(pats :(flatLang$pat # α) list) (pats2 :(flatLang$pat # β) list). MAP (FST :flatLang$pat # α -> flatLang$pat) pats = MAP (FST :flatLang$pat # β -> flatLang$pat) pats2 ⇒ case pmatch_rows pats (s :(γ, δ) state) (v :v) of (No_match :((mlstring # v) list # flatLang$pat # α) match_result) => pmatch_rows pats2 s v = (No_match :((mlstring # v) list # flatLang$pat # β) match_result) | (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) => pmatch_rows pats2 s v = (Match_type_error :((mlstring # v) list # flatLang$pat # β) match_result) | Match (env,p,e) => ∃(i :num). i < LENGTH pats2 ∧ pats❲i❳ = (p,e) ∧ pmatch_rows pats2 s v = Match (env,pats2❲i❳)
max_dec_name_LESS_EVERY_typed=max_dec_name (ns :mlstring list) < (N :num) ⇔ (0 :num) < N ∧ EVERY (λ(n :mlstring). dec_name_to_num n < N) ns
