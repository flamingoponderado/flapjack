set_toList_fromList_typed=set (toList (fromList (xs :α list) :α sptree$num_map) :α list) = set xs
decode_pos_no_Mat_typed=∀(p :position) (exp :exp). no_Mat exp ⇒ no_Mat (decode_pos (t :tra) exp p)
decode_test_no_Mat_typed=no_Mat (exp :exp) ⇒ no_Mat (decode_test (t :tra) (d :dTest) exp)
decode_guard_no_Mat_typed=no_Mat (exp :exp) ⇒ no_Mat (decode_guard (t :tra) exp (gd :dGuard))
compile_pat_bindings_no_Mat_typed=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). no_Mat exp ∧ EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). no_Mat v_exp) n_bindings ⇒ no_Mat (SND (compile_pat_bindings t i n_bindings exp))
naive_pattern_match_no_Mat_typed=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY (no_Mat ∘ (SND :flatLang$pat # exp -> exp)) xs ⇒ no_Mat (naive_pattern_match t xs)
naive_pattern_matches_no_Mat_typed=∀(t :tra) (x :exp) (xs :(flatLang$pat # exp) list) (dflt :exp). EVERY no_Mat (x::dflt::MAP (SND :flatLang$pat # exp -> exp) xs) ⇒ no_Mat (naive_pattern_matches t x xs dflt)
simp_guard_thm_typed=∀(gd :dGuard) (x :bool). dt_eval_guard (r :num |-> term) (v :term) gd = SOME x ⇒ dt_eval_guard r v (simp_guard gd) = SOME x
encode_pat_match_simulation_typed=(∀(s :(γ, 'ffi) state) (pat :flatLang$pat) (v :v) (pre_bindings :(mlstring # v) list) (res :(mlstring # v) list match_result). (pmatch s pat v pre_bindings :(mlstring # v) list match_result) = res ∧ res ≠ (Match_type_error :(mlstring # v) list match_result) ⇒ (pmatch (encode_refs s) (encode_pat pat) (encode_val v) :pmatchResult) = if res = (No_match :(mlstring # v) list match_result) then PMatchFailure else PMatchSuccess) ∧ ∀(s :(γ, 'ffi) state) (ps :flatLang$pat list) (vs :v list) (pre_bindings :(mlstring # v) list) (res :(mlstring # v) list match_result). (pmatch_list s ps vs pre_bindings :(mlstring # v) list match_result) = res ∧ res ≠ (Match_type_error :(mlstring # v) list match_result) ⇒ (pmatch_list (encode_refs s) (MAP encode_pat ps) (MAP encode_val vs) :pmatchResult) = if res = (No_match :(mlstring # v) list match_result) then PMatchFailure else PMatchSuccess
compile_match_pmatch_rows_typed=∀(pats :(flatLang$pat # exp) list) (k :num) (sg :bool) (pats2 :(flatLang$pat # exp) list) (res :((mlstring # v) list # flatLang$pat # exp) match_result). compile_match (cfg :config) pats = (k,sg,pats2) ∧ state_rel (s_cfg :config) (s :(α, β) state) (t :(α, β) state) ∧ v_rel (v :v) (v' :v) ∧ k ≤ (N :num) ∧ pmatch_rows pats s v = res ⇒ case res of (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) => pmatch_rows pats2 t v' = (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) | (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) => T | Match (env,p,e) => ∃(i :num) (env' :(mlstring # v) list). i < LENGTH pats ∧ i < LENGTH pats2 ∧ (p,e) = pats❲i❳ ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env env' ∧ pmatch_rows pats2 t v' = Match (env',pats2❲i❳)
compile_match_EL_typed=∀(pats :(flatLang$pat # exp) list) (pats2 :(flatLang$pat # exp) list) (k :num) (sg :bool) (i :num). compile_match (cfg :config) pats = (k,sg,pats2) ∧ i < LENGTH pats ∧ pats❲i❳ = ((pat :flatLang$pat),(exp :exp)) ⇒ ∃(exp_i :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (exp_i,sg,exp') ∧ pats2❲i❳ = (pat,exp') ∧ exp_i ≤ k ∧ max_dec_name (pat_bindings pat) ≤ k
compile_pats_no_Mat_typed=no_Mat (dflt :exp) ∧ no_Mat (x :exp) ∧ EVERY no_Mat (MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) ⇒ no_Mat (compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) x dflt ps)
decode_dtree_no_Mat_typed=no_Mat (v_exp :exp) ∧ no_Mat (dflt :exp) ∧ EVERY no_Mat (toList (br_spt :exp sptree$num_map) :exp list) ⇒ no_Mat (decode_dtree (t :tra) br_spt v_exp dflt (dtree :dTree))
set_globals_decode_dtree_empty_typed=set_globals (x :exp) = ({||} :num -> num) ∧ set_globals (dflt :exp) = ({||} :num -> num) ∧ EVERY (λ(y :exp). set_globals y = ({||} :num -> num)) (toList (br_spt :exp sptree$num_map) :exp list) ⇒ set_globals (decode_dtree (t :tra) br_spt x dflt (dtree :dTree)) = ({||} :num -> num)
esgc_free_decode_dtree_typed=esgc_free (v_exp :exp) ∧ esgc_free (dflt :exp) ∧ EVERY (λ(y :exp). esgc_free y) (toList (br_spt :exp sptree$num_map) :exp list) ⇒ esgc_free (decode_dtree (t :tra) br_spt v_exp dflt (dtree :dTree))
naive_pattern_matches_correct_typed=∀(t :tra) (x :exp) (mats :(flatLang$pat # exp) list) (dflt :exp) (exp :exp) (v :v) (res :((mlstring # v) list # flatLang$pat # exp) match_result). naive_pattern_matches t x mats dflt = exp ∧ pure_eval_to (s :(α, β) state) (env :v environment) x v ∧ pmatch_rows mats s v = res ∧ res ≠ (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) ⇒ (evaluate env s [exp] :(α, β) state # (v list, v) result) = case res of (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) => (evaluate env s [dflt] :(α, β) state # (v list, v) result) | (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) => (evaluate env s [dflt] :(α, β) state # (v list, v) result) | Match (v4,v8,exp) => (evaluate env s [exp] :(α, β) state # (v list, v) result)
evaluate_compile_pat_rhs_typed=(evaluate ((env3 :γ environment) with v updated_by (f :(mlstring # γ) list -> (mlstring # v) list)) (s :(α, β) state) [compile_pat_rhs (tr :tra) (N :num) (Var_local tr (enc_num_to_name N)) ((p :flatLang$pat),(exp :exp))] :(α, β) state # (v list, v) result) = ((t :(α, β) state),(res :(v list, v) result)) ∧ (pmatch s p (v :v) ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match (bindings :(mlstring # v) list) ∧ env_rel (M :num) (env1 :v environment) (env2 :v environment) ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < M) v_rel (l_bindings :(mlstring # v) list) bindings ∧ f env3.v = (enc_num_to_name N,v)::env2.v ∧ N ≤ M ∧ max_dec_name (pat_bindings p) < N − (1 :num) ⇒ ∃(ext_env :v environment). (evaluate ext_env s [exp] :(α, β) state # (v list, v) result) = (t,res) ∧ env_rel (N − (1 :num)) (env1 with v := l_bindings ++ env1.v) ext_env
evaluate_compile_pats_typed=pmatch_rows (pats :(flatLang$pat # exp) list) (s :(α, β) state) (v :v) ≠ (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) ∧ pure_eval_to s (env :v environment) (exp :exp) v ⇒ (evaluate env s [compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) exp (default_x :exp) pats] :(α, β) state # (v list, v) result) = (evaluate env s [case pmatch_rows pats s v of (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) => default_x | (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) => default_x | Match (env',p',e') => compile_pat_rhs t N exp (p',e')] :(α, β) state # (v list, v) result)
evaluate_SmartIf_typed=(evaluate (env :v environment) (s :(α, β) state) [SmartIf (t :tra) (x :exp) (y :exp) (z :exp)] :(α, β) state # (v list, v) result) = (evaluate env s [(If t x y z :exp)] :(α, β) state # (v list, v) result)
state_rel_dec_clock_typed=state_rel (cfg :config) (s1 :(α, β) state) (s2 :(α, β) state) ⇒ state_rel cfg (dec_clock s1) (dec_clock s2)
encode_val_def_typed=(∀(l :lit). encode_val (Litv l :v) = (Litv l :term)) ∧ (∀(xs :v list) (stmp :(num # num option) option). encode_val (Conv stmp xs) = Term (case stmp of (NONE :(num # num option) option) => (NONE :num option) | SOME (i,v2) => SOME i) (MAP (λ(a :v). encode_val a) xs)) ∧ (∀(v0 :bool) (n :num). encode_val (Loc v0 n :v) = RefPtr n) ∧ (∀(v7 :exp) (v6 :mlstring) (v5 :v environment). encode_val (Closure v5 v6 v7 :v) = Other) ∧ (∀(v9 :(mlstring # mlstring # exp) list) (v8 :v environment) (v10 :mlstring). encode_val (Recclosure v8 v9 v10 :v) = Other) ∧ ∀(v13 :v list). encode_val (Vectorv v13) = Other
encode_refs_def_typed=∀(s :(α, β) state). encode_refs s = FUN_FMAP (λ(i :num). encode_val (case s.refs❲i❳ of Refv v => v | (W8array v2 :v store_v) => (ARB :v) | Varray v4 => (ARB :v) | Thunk v6 v7 => (ARB :v))) (count (LENGTH s.refs) ∩ {i | ∃(v :v). s.refs❲i❳ = Refv v})
decode_test_simulation_typed=dt_test (test :dTest) (enc_v :term) = SOME (b :bool) ∧ pure_eval_to (s :(α, β) state) (env :v environment) (x :exp) (v :v) ∧ enc_v = encode_val v ⇒ pure_eval_to s env (decode_test (tr :tra) test x) (Boolv b :v)
decode_pos_simulation_typed=∀(pos :position) (exp :exp) (x :v). app_pos (encode_refs (s :(α, β) state)) pos (encode_val x) = SOME (enc_y :term) ∧ pure_eval_to s (env :v environment) exp x ⇒ ∃(y :v). enc_y = encode_val y ∧ pure_eval_to s env (decode_pos (tr :tra) exp pos) y
decode_guard_simulation_typed=∀(b :bool). dt_eval_guard (encode_refs (s :(α, β) state)) (encode_val (y :v)) (gd :dGuard) = SOME b ∧ pure_eval_to s (env :v environment) (x :exp) y ⇒ pure_eval_to s env (decode_guard (tr :tra) x gd) (Boolv b :v)
decode_dtree_simulation_typed=dt_eval (encode_refs (s :(α, β) state)) (encode_val (y :v)) (dtree :dTree) = SOME (v :matchResult) ∧ pure_eval_to s (env :v environment) (x :exp) y ⇒ (evaluate env s [decode_dtree (tr :tra) (exps :exp sptree$num_map) x (default_x :exp) dtree] :(α, β) state # (v list, v) result) = (evaluate env s [case v of MatchSuccess i => (case lookup i exps of (NONE :exp option) => default_x | SOME exp => exp) | MatchFailure => default_x] :(α, β) state # (v list, v) result)
evaluate_Bool_typed=(evaluate (env :v environment) (s :(α, β) state) [Bool (t :tra) (b :bool)] :(α, β) state # (v list, v) result) = (s,(Rval [(Boolv b :v)] :(v list, v) result))
compile_pat_bindings_simulation_typed=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp) (exp2 :exp) (spt :sptree$num_set) (s :(α, β) state) (vs :v list) (pre_bindings :(mlstring # v) list) (bindings :(mlstring # v) list) (env :v environment) (s2 :(α, β) state) (res :(v list, v) result) (vset :γ). compile_pat_bindings t i n_bindings exp = (spt,exp2) ∧ (pmatch_list s (MAP (FST :flatLang$pat # num # exp -> flatLang$pat) n_bindings) vs pre_bindings :(mlstring # v) list match_result) = Match bindings ∧ (evaluate env s [exp2] :(α, β) state # (v list, v) result) = (s2,res) ∧ LIST_REL (λ((_0 :flatLang$pat),(k :num),(v_exp :exp)) (v :v). ∀(env2 :v environment). k ∈ (domain spt :num -> bool) ∧ ALOOKUP_rel ((λ(k :num). k > (j :num) ∧ k < i) ∘ dec_name_to_num) ($= :v -> v -> bool) env2.v env.v ⇒ pure_eval_to s env2 v_exp v) n_bindings vs ∧ EVERY ((λ(k :num). k < j) ∘ dec_name_to_num ∘ (FST :mlstring # v -> mlstring)) pre_bindings ∧ j < i ∧ ALOOKUP_rel ((λ(k :num). k < j) ∘ dec_name_to_num) ($= :v -> v -> bool) env.v (pre_bindings ++ (base_vs :(mlstring # v) list)) ∧ EVERY (λ((p :flatLang$pat),(k :num),(_1 :exp)). EVERY (λ(nm :mlstring). dec_name_to_num nm < j) (pat_bindings p) ∧ j < k ∧ k < i) n_bindings ⇒ ∃(env2 :v environment). (evaluate env2 s [exp] :(α, β) state # (v list, v) result) = (s2,res) ∧ ALOOKUP_rel ((λ(k :num). k < j) ∘ dec_name_to_num) ($= :v -> v -> bool) env2.v (bindings ++ base_vs)
pmatch_list_append_Match_exists_typed=(pmatch_list (s :(α, β) state) ((xs :flatLang$pat list) ++ (ys :flatLang$pat list)) (vs :v list) (pre_bindings :(mlstring # v) list) :(mlstring # v) list match_result) = Match (bindings :(mlstring # v) list) ⇔ ∃(vs1 :v list) (vs2 :v list) (bindings1 :(mlstring # v) list). vs = vs1 ++ vs2 ∧ (pmatch_list s xs vs1 pre_bindings :(mlstring # v) list match_result) = Match bindings1 ∧ (pmatch_list s ys vs2 bindings1 :(mlstring # v) list match_result) = Match bindings
APPEND_LENGTH_EQ_typed=∀(xs :α list) (xs' :α list). LENGTH xs = LENGTH xs' ⇒ (xs ++ (ys :α list) = xs' ++ (ys' :α list) ⇔ xs = xs' ∧ ys = ys')
pmatch_list_Match_IMP_LENGTH_typed=∀(xs :flatLang$pat list) (ys :v list) (env :(mlstring # v) list) (env' :(mlstring # v) list) (s :(α, β) state). (pmatch_list s xs ys env :(mlstring # v) list match_result) = Match env' ⇒ LENGTH xs = LENGTH ys
pure_eval_to_def_typed=∀(s :(α, β) state) (env :v environment) (exp :exp) (v :v). pure_eval_to s env exp v ⇔ (evaluate env s [exp] :(α, β) state # (v list, v) result) = (s,(Rval [v] :(v list, v) result))
MEM_enumerate_EL_typed=∀(xs :α list) (i :num) (x :num # α). MEM x (enumerate i xs :(num # α) list) ⇔ ∃(j :num). j < LENGTH xs ∧ x = (i + j,xs❲j❳)
ALL_DISTINCT_enumerate_typed=∀(xs :α list) (i :num). ALL_DISTINCT (enumerate i xs :(num # α) list)
FILTER_EQ_ALOOKUP_EQ_typed=∀(xs :(α # β) list) (ys :(α # β) list). FILTER (P :α # β -> bool) xs = ys ∧ (∀(z :β). P ((x :α),z)) ⇒ ALOOKUP xs x = ALOOKUP ys x
COND_false_typed=¬(P :bool) ⇒ (if P then (x :α) else (y :α)) = y
COND_true_typed=(P :bool) ⇒ (if P then (x :α) else (y :α)) = x
LIST_REL_FILTER_MONO_typed=∀(xs :α list) (ys :β list). LIST_REL (R :α -> β -> bool) (FILTER (P1 :α -> bool) xs) (FILTER (P2 :β -> bool) ys) ∧ (∀(x :α). MEM x xs ∧ (P3 :α -> bool) x ⇒ P1 x) ∧ (∀(y :β). MEM y ys ∧ (P4 :β -> bool) y ⇒ P2 y) ∧ (∀(x :α) (y :β). MEM x xs ∧ MEM y ys ∧ R x y ⇒ (P3 x ⇔ P4 y)) ⇒ LIST_REL R (FILTER P3 xs) (FILTER P4 ys)
LIST_REL_ALOOKUP_typed=∀(xs :(α # β) list) (ys :(α # β) list). LIST_REL (R :α # β -> α # β -> bool) xs ys ∧ (∀(x :α # β) (y :α # β). R x y ∧ MEM x xs ∧ MEM y ys ∧ ((v :α) = FST x ∨ v = FST y) ⇒ x = y) ⇒ ALOOKUP xs v = ALOOKUP ys v
LIST_REL_ALOOKUP_OPTREL_typed=∀(xs :(α # β) list) (ys :(α # γ) list). LIST_REL (R :α # β -> α # γ -> bool) xs ys ∧ (∀(x :α # β) (y :α # γ). R x y ∧ MEM x xs ∧ MEM y ys ∧ ((v :α) = FST x ∨ v = FST y) ⇒ FST x = FST y ∧ (R2 :β -> γ -> bool) (SND x) (SND y)) ⇒ OPTREL R2 (ALOOKUP xs v) (ALOOKUP ys v)
state_rel_def_typed=∀(cfg :config) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel cfg s t ⇔ t.clock = s.clock ∧ LIST_REL (sv_rel v_rel) s.refs t.refs ∧ t.ffi = s.ffi ∧ LIST_REL (OPTREL v_rel) s.globals t.globals ∧ install_conf_rel cfg s.eval_config t.eval_config
state_rel_initial_state_typed=install_conf_rel (cfg :config) (ic1 :α install_config) (ic2 :α install_config) ⇒ state_rel cfg (initial_state (ffi :β ffi_state) (k :num) ic1) (initial_state ffi k ic2)
v_rel_typed=(∀(v :v) (v' :v). simple_basic_val_rel v v' ∧ LIST_REL v_rel (v_container_xs v) (v_container_xs v') ⇒ v_rel v v') ∧ (∀(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). env_rel N env1 env2 ∧ FST (compile_exp cfg x) < N ⇒ v_rel (Closure env1 n x :v) (Closure env2 n (SND (SND (compile_exp cfg x))) :v)) ∧ (∀(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). env_rel N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs ⇒ v_rel (Recclosure env1 fs x :v) (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v)) ∧ ∀(N :num) (env1 :v environment) (env2 :v environment). ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env1.v env2.v ⇒ env_rel N env1 env2
compile_exp_no_Mat_typed=(∀(cfg :config) (exp :exp) (N :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (N,sg,exp') ⇒ no_Mat exp') ∧ (∀(cfg :config) (exps :exp list) (N :num) (sg :bool) (exps' :exp list). compile_exps cfg exps = (N,sg,exps') ⇒ EVERY no_Mat exps') ∧ ∀(cfg :config) (pats :(flatLang$pat # exp) list) (N :num) (sg :bool) (pats' :(flatLang$pat # exp) list). compile_match cfg pats = (N,sg,pats') ⇒ EVERY no_Mat (MAP (SND :flatLang$pat # exp -> exp) pats')
compile_decs_no_Mat_typed=∀(decs :exp list). no_Mat_decs (MAP (compile_dec (cfg :config)) decs)
compile_exp_esgc_free_typed=(∀(cfg :config) (exp :exp) (N :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (N,sg,exp') ∧ esgc_free exp ⇒ esgc_free exp') ∧ (∀(cfg :config) (exps :exp list) (N :num) (sg :bool) (exps' :exp list). compile_exps cfg exps = (N,sg,exps') ∧ EVERY esgc_free exps ⇒ EVERY esgc_free exps') ∧ ∀(cfg :config) (m :(flatLang$pat # exp) list) (N :num) (sg :bool) (m' :(flatLang$pat # exp) list). compile_match cfg m = (N,sg,m') ∧ EVERY (esgc_free ∘ (SND :flatLang$pat # exp -> exp)) m ⇒ EVERY (esgc_free ∘ (SND :flatLang$pat # exp -> exp)) m'
compile_decs_esgc_free_typed=∀(decs :exp list). EVERY esgc_free decs ⇒ EVERY esgc_free (MAP (compile_dec (cfg :config)) decs)
compile_exp_set_globals_typed=(∀(cfg :config) (exp :exp) (N :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (N,sg,exp') ⇒ set_globals exp' ≤ set_globals exp) ∧ (∀(cfg :config) (exps :exp list) (N :num) (sg :bool) (exps' :exp list). compile_exps cfg exps = (N,sg,exps') ⇒ elist_globals exps' ≤ elist_globals exps) ∧ ∀(cfg :config) (m :(flatLang$pat # exp) list) (N :num) (sg :bool) (m' :(flatLang$pat # exp) list). compile_match cfg m = (N,sg,m') ⇒ elist_globals (MAP (SND :flatLang$pat # exp -> exp) m') ≤ elist_globals (MAP (SND :flatLang$pat # exp -> exp) m)
compile_decs_elist_globals_typed=∀(decs :exp list). elist_globals (MAP (compile_dec (cfg :config)) decs) ≤ elist_globals decs
set_globals_naive_pattern_matches_typed=set_globals (x :exp) = ({||} :num -> num) ⇒ set_globals (naive_pattern_matches (t :tra) x (ps :(flatLang$pat # exp) list) (dflt :exp)) ≤ elist_globals (dflt::MAP (SND :flatLang$pat # exp -> exp) ps)
set_globals_compile_pats_typed=(¬(naive :bool) ⇒ elist_globals ((dflt :exp)::MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) = ({||} :num -> num)) ∧ set_globals (x :exp) = ({||} :num -> num) ⇒ set_globals (compile_pats (cfg :config) naive (t :tra) (N :num) x dflt ps) ≤ elist_globals (dflt::MAP (SND :flatLang$pat # exp -> exp) ps)
set_globals_decode_pos_typed=∀(p :position) (exp :exp). set_globals exp = ({||} :num -> num) ⇒ set_globals (decode_pos (t :tra) exp p) = ({||} :num -> num)
set_globals_decode_test_typed=set_globals (exp :exp) = ({||} :num -> num) ⇒ set_globals (decode_test (t :tra) (d :dTest) exp) = ({||} :num -> num)
set_globals_decode_guard_typed=set_globals (exp :exp) = ({||} :num -> num) ⇒ set_globals (decode_guard (t :tra) exp (gd :dGuard)) = ({||} :num -> num)
set_globals_compile_pat_bindings_typed=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp). EVERY (λ((_0 :flatLang$pat),(_1 :num),(v_exp :exp)). set_globals v_exp = ({||} :num -> num)) n_bindings ⇒ set_globals (SND (compile_pat_bindings t i n_bindings exp)) = set_globals exp
set_globals_naive_pattern_match_typed=∀(t :tra) (xs :(flatLang$pat # exp) list). EVERY (λ(v :flatLang$pat # exp). set_globals (SND v) = ({||} :num -> num)) xs ⇒ set_globals (naive_pattern_match t xs) = ({||} :num -> num)
esgc_free_compile_pats_typed=esgc_free (dflt :exp) ∧ EVERY esgc_free (MAP (SND :flatLang$pat # exp -> exp) (ps :(flatLang$pat # exp) list)) ⇒ esgc_free (compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) (Var_local (t' :tra) (nm :mlstring)) dflt ps)
esgc_free_decode_pos_typed=∀(p :position) (exp :exp). esgc_free exp ⇒ esgc_free (decode_pos (t :tra) exp p)
esgc_free_decode_test_typed=esgc_free (exp :exp) ⇒ esgc_free (decode_test (t :tra) (d :dTest) exp)
