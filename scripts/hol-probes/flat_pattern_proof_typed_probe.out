match_rel_def_typed=(match_rel (N :num) (Match (env1 :(mlstring # v) list)) (Match (env2 :(mlstring # v) list)) ⇔ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env1 env2) ∧ (match_rel N (No_match :(mlstring # v) list match_result) (No_match :(mlstring # v) list match_result) ⇔ T) ∧ (match_rel N (Match_type_error :(mlstring # v) list match_result) (Match_type_error :(mlstring # v) list match_result) ⇔ T) ∧ (match_rel N (No_match :(mlstring # v) list match_result) (Match_type_error :(mlstring # v) list match_result) ⇔ F) ∧ (match_rel N (No_match :(mlstring # v) list match_result) (Match (v7 :(mlstring # v) list)) ⇔ F) ∧ (match_rel N (Match_type_error :(mlstring # v) list match_result) (No_match :(mlstring # v) list match_result) ⇔ F) ∧ (match_rel N (Match_type_error :(mlstring # v) list match_result) (Match (v9 :(mlstring # v) list)) ⇔ F) ∧ (match_rel N (Match (v5 :(mlstring # v) list)) (No_match :(mlstring # v) list match_result) ⇔ F) ∧ (match_rel N (Match v5) (Match_type_error :(mlstring # v) list match_result) ⇔ F)
