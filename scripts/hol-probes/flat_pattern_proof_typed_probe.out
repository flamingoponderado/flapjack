pat_bindings_evaluate_FOLDR_lemma_typed=∀(h :α -> v) (xs :α list). (∀(x :α). MEM x xs ⇒ IS_SOME ((f :α -> mlstring option) x)) ∧ (∀(x :β). IMAGE ((THE :mlstring option -> mlstring) ∘ f) (set xs) ⊆ (new_names :mlstring -> bool)) ∧ (∀(x :α). MEM x xs ⇒ ∀(env2 :v environment). ALOOKUP_rel (λ(x :mlstring). x ∉ new_names) ($= :v -> v -> bool) env2.v (env :v environment).v ⇒ (evaluate env2 (s :(γ, δ) state) [(g :α -> exp) x] :(γ, δ) state # (v list, v) result) = (s,(Rval [h x] :(v list, v) result))) ⇒ ∀(env2 :v environment). ALOOKUP_rel (λ(x :mlstring). x ∉ new_names) ($= :v -> v -> bool) env2.v env.v ⇒ (evaluate env2 s [FOLDR (λ(x :α) (exp :exp). (Let (t :tra) (f x) (g x) exp :exp)) (exp :exp) xs] :(γ, δ) state # (v list, v) result) = (evaluate (env2 with v := MAP (λ(x :α). (THE (f x),h x)) (REVERSE xs) ++ env2.v) s [exp] :(γ, δ) state # (v list, v) result)
