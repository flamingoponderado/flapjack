  LabAsm (Jump (Lab 1 2)) 254w [2w; 3w; 4w] 3],5,F)
es_again_unchanged=([Asm (Asmi (Inst Skip)) [9w] 4; LabAsm (Jump (Lab 1 2)) 254w [7w] 4],6,F)
es_again_no_growth=([Asm (Asmi (Inst Skip)) [9w] 4; LabAsm (Jump (Lab 1 2)) 254w [2w; 3w; 4w] 4],
 6,T)
es_sections_value=([Section 4
    [Label 1 2 1; Asm (Asmi (Inst Skip)) [6w] 1;
     LabAsm (Jump (Lab 1 2)) 254w [2w; 3w; 4w] 3]; Section 8 []],F)
es_sections_similar=T
