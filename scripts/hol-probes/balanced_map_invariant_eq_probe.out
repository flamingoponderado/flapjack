bmi_full=⊢ (invariant cmp Tip ⇔ T) ∧ (invariant cmp (Bin s k v l r) ⇔ (good_cmp cmp ⇒ DISJOINT (FDOM (to_fmap cmp l)) (FDOM (to_fmap cmp r))) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp l)) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp r)) ∧ s = 1 + structure_size l + structure_size r ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ balanced (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r)
bmi_typed=⊢ (invariant (cmp :α -> α -> ordering) (Tip :(α, β) balanced_map) ⇔ T) ∧ (invariant cmp (Bin (s :num) (k :α) (v :γ) (l :(α, γ) balanced_map) (r :(α, γ) balanced_map)) ⇔ (good_cmp cmp ⇒ DISJOINT (FDOM (to_fmap cmp l)) (FDOM (to_fmap cmp r))) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp l)) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp r)) ∧ s = (1 :num) + structure_size l + structure_size r ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ balanced (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r)
bmi_replay=⊢ (invariant cmp Tip ⇔ T) ∧ (invariant cmp (Bin s k v l r) ⇔ (good_cmp cmp ⇒ DISJOINT (FDOM (to_fmap cmp l)) (FDOM (to_fmap cmp r))) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp l)) ∧ (good_cmp cmp ⇒ key_set cmp k ∉ FDOM (to_fmap cmp r)) ∧ s = 1 + structure_size l + structure_size r ∧ key_ordered cmp k l Greater ∧ key_ordered cmp k r Less ∧ balanced (size l) (size r) ∧ invariant cmp l ∧ invariant cmp r)
bmi_singleton=T
bmi_badsize=F
bmi_equal_child=F
