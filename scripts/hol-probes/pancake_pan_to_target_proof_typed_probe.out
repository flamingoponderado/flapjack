pan_to_lab_labels_ok_typed=(compile_prog (mc :(α, β, γ) machine_config).target.config.ISA (pan_code :α decl list) :(num # num # α wordLang$prog) list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ (compile (c :config).word_to_word_conf mc.target.config wprog0 :num sptree$num_map option list # (num # num # α wordLang$prog) list) = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ mc.target.config.ISA ≠ Ag32 ∧ (compile mc.target.config F wprog :α word list # word_to_stack$config # num list # (num # α stack_rawcallProof$prog) list) = ((bitmaps :α word list),(c'' :word_to_stack$config),(fs :num list),(p :(num # α stack_rawcallProof$prog) list)) ∧ (compile c.stack_conf c.data_conf (max_heap :num) (sp :num) mc.target.config.addr_offset p :α sec list) = (lprog :α sec list) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ⇒ labels_ok lprog
word_to_stack_good_code_lemma_typed=(compile (c :config).word_to_word_conf (mc :(α, β, γ) machine_config).target.config (compile_prog mc.target.config.ISA (pan_code :α decl list) :(num # num # α wordLang$prog) list) :num sptree$num_map option list # (num # num # α wordLang$prog) list) = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ mc.target.config.ISA ≠ Ag32 ∧ (compile mc.target.config F wprog :α word list # word_to_stack$config # num list # (num # α stack_rawcallProof$prog) list) = ((bitmaps :α word list),(c'' :word_to_stack$config),(fs :num list),(p :(num # α stack_rawcallProof$prog) list)) ∧ LENGTH mc.target.config.avoid_regs + (13 :num) ≤ mc.target.config.reg_count ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ⇒ (good_code (mc.target.config.reg_count − (LENGTH mc.target.config.avoid_regs + (3 :num))) p :bool)
from_pan_to_lab_no_install_typed=ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions (pan_code :α decl list))) ∧ (ac :α asm_config).ISA ≠ Ag32 ∧ (compile_prog (isa :architecture) pan_code :(num # num # α wordLang$prog) list) = (wprog0 :(num # num # α wordLang$prog) list) ∧ (compile (wc :word_to_word$config) ac wprog0 :num sptree$num_map option list # (num # num # α wordLang$prog) list) = ((col :num sptree$num_map option list),(wprog :(num # num # α wordLang$prog) list)) ∧ (compile ac F wprog :α word list # word_to_stack$config # num list # (num # α stack_rawcallProof$prog) list) = ((bm :α word list),(c :word_to_stack$config),(fs :num list),(p :(num # α stack_rawcallProof$prog) list)) ⇒ no_install (compile (scc :stack_to_lab$config) (dc :data_to_word$config) (lim :num) (regc :num) (off :α word # α word) p :α sec list)
pan_to_lab_good_code_lemma_typed=(compile (c :config).stack_conf c.data_conf (lim1 :num) (lim2 :num) (offs :α word # α word) (stack_prog :(num # α stack_rawcallProof$prog) list) :α sec list) = (code :α sec list) ∧ (compile (asm_conf3 :α asm_config) F (word_prog :(num # num # α wordLang$prog) list) :α word list # word_to_stack$config # num list # (num # α stack_rawcallProof$prog) list) = ((bm :α word list),(wc :word_to_stack$config),(fs :num list),stack_prog) ∧ (compile (word_conf :word_to_word$config) asm_conf3 (word_prog0 :(num # num # α wordLang$prog) list) :num sptree$num_map option list # (num # num # α wordLang$prog) list) = ((col :num sptree$num_map option list),word_prog) ∧ (compile_prog asm_conf3.ISA (pan_prog :α decl list) :(num # num # α wordLang$prog) list) = word_prog0 ∧ labels_ok code ∧ all_enc_ok_pre (conf :α asm_config) code ⇒ (good_code conf (LN :β sptree$num_map sptree$num_map) code :bool)
pancake_good_code_def_typed=∀(pan_code :α decl list). pancake_good_code pan_code ⇔ EVERY (good_panops :α decl -> bool) pan_code
pan_to_target_compile_semantics_typed=compile_prog_max (c :config) (mc :(α, β, γ) machine_config) (pan_code :α decl list) = (SOME ((bytes :word8 list),(bitmaps :α word list),(c' :config)),(stack_max :num option)) ∧ pancake_good_code pan_code ∧ distinct_params (functions pan_code) ∧ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α panLang$prog # shape -> mlstring) (functions pan_code)) ∧ (s :(α, 'ffi) panSem$state).code = (FEMPTY :mlstring |-> (mlstring # shape) list # α panLang$prog # shape) ∧ s.locals = (FEMPTY :mlstring |-> α v) ∧ s.globals = (FEMPTY :mlstring |-> α v) ∧ size_of_eids pan_code < dimword (:α) ∧ s.eshapes = (FEMPTY :mlstring |-> shape) ∧ backend_config_ok mc.target.config c ∧ mc_conf_ok mc ∧ mc_init_ok mc.target.config c mc ∧ mc.target.config.ISA ≠ Ag32 ∧ (0w :α word) <₊ mc.target.get_reg (ms :β) mc.len_reg ∧ (globals_size :num) = (let (dec_shs :shape list) = dec_shapes pan_code; (struct_ctxt :(mlstring # struct_info) list option) = decs_stcnames ([] :(mlstring # struct_info) list) pan_code in (SUM (MAP (size_of_sh_with_ctxt (THE struct_ctxt)) dec_shs) :num)) ∧ mc.target.get_reg ms mc.len_reg <₊ mc.target.get_reg ms mc.ptr2_reg ∧ mc.target.get_reg ms mc.len_reg = s.base_addr ∧ globals_allocatable s pan_code ∧ (heap_len :num) = w2n (mc.target.get_reg ms mc.ptr2_reg + -(1w :α word) * s.base_addr) DIV (dimindex (:α) DIV (8 :num)) ∧ s.top_addr = s.base_addr + (bytes_in_word :α word) * (n2w heap_len :α word) − (n2w (globals_size * dimindex (:α) DIV (8 :num)) :α word) ∧ globals_size ≤ heap_len ∧ s.memaddrs = addresses (mc.target.get_reg ms mc.len_reg) (heap_len − globals_size) ∧ aligned ((shift (:α) :num) + (1 :num)) (mc.target.get_reg ms mc.ptr2_reg + -(1w :α word) * mc.target.get_reg ms mc.len_reg) ∧ (adj_ptr2 :α word) = mc.target.get_reg ms mc.len_reg + (bytes_in_word :α word) * (n2w max_stack_alloc :α word) ∧ (adj_ptr4 :α word) = mc.target.get_reg ms mc.len2_reg − (bytes_in_word :α word) * (n2w max_stack_alloc :α word) ∧ adj_ptr2 ≤₊ mc.target.get_reg ms mc.ptr2_reg ∧ mc.target.get_reg ms mc.ptr2_reg ≤₊ adj_ptr4 ∧ w2n (mc.target.get_reg ms mc.ptr2_reg + -(1w :α word) * mc.target.get_reg ms mc.len_reg) ≤ w2n (bytes_in_word :α word) * ((2 :num) * max_heap_limit (:α) c.data_conf − (1 :num)) ∧ w2n (bytes_in_word :α word) * ((2 :num) * max_heap_limit (:α) c.data_conf − (1 :num)) < dimword (:α) ∧ s.ffi = (ffi :'ffi ffi_state) ∧ (mc.target.config.big_endian ⇔ s.be) ∧ OPTION_ALL (EVERY (λ(x :ffiname). ∃(s :mlstring). x = (ExtCall s :ffiname))) c.lab_conf.ffi_names ∧ pan_installed bytes (cbspace :num) bitmaps (data_sp :num) c'.lab_conf.ffi_names (heap_regs c.stack_conf.reg_names) mc c'.lab_conf.shmem_extra ms ((wlab_wloc :α word_lab -> α word_loc) ∘ s.memory) s.memaddrs s.sh_memaddrs ∧ (start :mlstring) = «main» ∧ semantics_decls s start pan_code ≠ Fail ⇒ machine_sem mc ffi ms ⊆ extend_with_resource_limit' (option_lt stack_max (SOME (FST (read_limits mc.target.config c mc ms)))) {semantics_decls s start pan_code}
cut_state_with_mem_const_typed=cut_state (x :sptree$num_set # sptree$num_set) ((s :(α, β, γ) word_to_stackProof$state) with memory := (m :α word -> α word_loc)) = OPTION_MAP (λ(s' :(α, β, γ) word_to_stackProof$state). s' with memory := m) (cut_state x s)
mem_upd_lemma_typed=(s :(α, β, γ) word_to_stackProof$state) with memory := (ARB :α word -> α word_loc) = (t :(α, β, γ) word_to_stackProof$state) with memory := (ARB :α word -> α word_loc) ⇒ ∃(m :α word -> α word_loc). s = t with memory := m
push_env_mem_const_typed=∀(env :α word_loc sptree$num_map # α word_loc sptree$num_map) (params :(num # α wordLang$prog # num # num) option) (s :(α, β, γ) word_to_stackProof$state). (push_env env params s).memory = s.memory ∧ (push_env env params s).mdomain = s.mdomain
push_env_mem_upd_typed=∀(env :α word_loc sptree$num_map # α word_loc sptree$num_map) (params :(num # α wordLang$prog # num # num) option) (s :(α, β, γ) word_to_stackProof$state). push_env env params (s with memory := (m :α word -> α word_loc)) = push_env env params s with memory := m
aligned_n2w_IMP_typed=aligned (k :num) (n2w (n :num) :α word) ∧ n < dimword (:α) ⇒ divides ((2 :num) ** k) n
n2w_sub_alt_typed=∀(a :num) (b :num). b ≤ a ⇒ (n2w (a − b) :α word) = (n2w a :α word) + -(1w :α word) * (n2w b :α word)
memory_swap_lemma_typed=∀(prog :α wordLang$prog) (st :(α, β, γ) word_to_stackProof$state) (res :α word_instProof$result option) (rst :(α, β, γ) word_to_stackProof$state) (m :α word -> α word_loc). (evaluate (prog,st) :α word_instProof$result option # (α, β, γ) word_to_stackProof$state) = (res,rst) ∧ fun2set (st.memory,st.mdomain) = fun2set (m,st.mdomain) ∧ no_alloc_code st.code ∧ no_install_code st.code ∧ no_alloc prog ∧ no_install prog ⇒ ∃(m' :α word -> α word_loc). (evaluate (prog,st with memory := m) :α word_instProof$result option # (α, β, γ) word_to_stackProof$state) = (res,rst with memory := m') ∧ fun2set (rst.memory,rst.mdomain) = fun2set (m',rst.mdomain)
memory_swap_lemma1_typed=∀(prog :α wordLang$prog) (st :(α, β, γ) word_to_stackProof$state) (res :α word_instProof$result option) (rst :(α, β, γ) word_to_stackProof$state) (m :α word -> α word_loc). (evaluate (prog,st) :α word_instProof$result option # (α, β, γ) word_to_stackProof$state) = (res,rst) ∧ fun2set (st.memory,st.mdomain) = fun2set (m,st.mdomain) ∧ no_alloc_code st.code ∧ no_install_code st.code ∧ no_alloc prog ∧ no_install prog ⇒ ∃(st' :(α, β, γ) word_to_stackProof$state). (evaluate (prog,st with memory := m) :α word_instProof$result option # (α, β, γ) word_to_stackProof$state) = (res,st') ∧ st' with memory := (ARB :α word -> α word_loc) = rst with memory := (ARB :α word -> α word_loc) ∧ fun2set (rst.memory,rst.mdomain) = fun2set (st'.memory,rst.mdomain)
