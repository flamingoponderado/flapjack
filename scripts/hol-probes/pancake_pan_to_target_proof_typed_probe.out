data_sp :(α word # α word_loc -> bool) -> bool)) (fun2set (m,(byte_aligned :α word -> bool) ∩ bitmaps_dm)) ∧ ffi_names = SOME mc_conf.ffi_names ∧ ∀(i :num). mmio_pcs_min_index mc_conf.ffi_names = SOME i ⇒ MAP (λ(rec :shmem_info_num). w2n (mc_conf.target.get_pc ms) + rec.entry_pc) shmem_extra = DROP i (MAP (w2n :α word -> num) mc_conf.ffi_entry_pcs) ∧ mc_conf.mmio_info = ZIP (GENLIST (λ(index :num). index + i) (LENGTH shmem_extra),MAP (λ(rec :shmem_info_num). (rec.nbytes,Addr rec.addr_reg (n2w rec.addr_off :α word),rec.reg,(n2w rec.exit_pc :α word) + mc_conf.target.get_pc ms)) shmem_extra) ∧ cbspace + LENGTH bytes + ffi_offset * (i + (3 :num)) < dimword (:α))
