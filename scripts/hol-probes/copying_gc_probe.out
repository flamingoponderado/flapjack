gc_forward_ptr_typed=(∀(a :num) (ptr :num) (d :α) (ok :bool). gc_forward_ptr a ([] :(α, β) heap_element list) ptr d ok = (([] :(α, β) heap_element list),F)) ∧ ∀(a :num) (x :(α, β) heap_element) (xs :(α, β) heap_element list) (ptr :num) (d :α) (ok :bool). gc_forward_ptr a (x::xs) ptr d ok = if a = (0 :num) then ((ForwardPointer ptr d (el_length x − (1 :num)) :(α, β) heap_element)::xs,isDataElement x ∧ ok) else if a < el_length x then (x::xs,F) else (let ((xs :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr (a − el_length x) xs ptr d ok in (x::xs,ok))
gc_forward_ptr_thm_typed=∀(ha :(α, β) heap_element list). gc_forward_ptr (heap_length ha) (ha ++ DataElement (ys :α heap_address list) (l :num) (d :β)::(hb :(α, β) heap_element list)) (a :num) (u :α) (c :bool) = (ha ++ (ForwardPointer a u l :(α, β) heap_element)::hb,c)
gc_move_typed=gc_move (Data (d :α),(h2 :(α, β) heap_element list),(a :num),(n :num),(heap :(α, β) heap_element list),(c :bool),(limit :num)) = (Data d,h2,a,n,heap,c) ∧ gc_move (Pointer (ptr :num) d,h2,a,n,heap,c,limit) = case heap_lookup ptr heap of (NONE :(α, β) heap_element option) => ((ARB :α heap_address),h2,a,n,heap,F) | SOME (Unused v9 :(α, β) heap_element) => ((ARB :α heap_address),h2,a,n,heap,F) | SOME (ForwardPointer v10 v11 v12 :(α, β) heap_element) => (Pointer v10 d,h2,a,n,heap,c) | SOME (DataElement xs l dd) => (let (c :bool) = (c ∧ l + (1 :num) ≤ n ∧ a + n = limit); (n :num) = n − (l + (1 :num)); (h2 :(α, β) heap_element list) = h2 ++ [DataElement xs l dd]; ((heap :(α, β) heap_element list),(c :bool)) = gc_forward_ptr ptr heap a d c in (Pointer a d,h2,a + (l + (1 :num)),n,heap,c))
gc_move_list_typed=(∀(n :num) (limit :num) (heap :(α, β) heap_element list) (h2 :(α, β) heap_element list) (c :bool) (a :num). gc_move_list (([] :α heap_address list),h2,a,n,heap,c,limit) = (([] :α heap_address list),h2,a,n,heap,c)) ∧ ∀(xs :α heap_address list) (x :α heap_address) (n :num) (limit :num) (heap :(α, β) heap_element list) (h2 :(α, β) heap_element list) (c :bool) (a :num). gc_move_list (x::xs,h2,a,n,heap,c,limit) = (let ((x' :α heap_address),(h2' :(α, β) heap_element list),(a' :num),(n' :num),(heap' :(α, β) heap_element list),(c' :bool)) = gc_move (x,h2,a,n,heap,c,limit); ((xs' :α heap_address list),(h2'' :(α, β) heap_element list),(a'' :num),(n'' :num),(heap'' :(α, β) heap_element list),(c'' :bool)) = gc_move_list (xs,h2',a',n',heap',c',limit) in (x'::xs',h2'',a'',n'',heap'',c''))
gc_move_loop_typed=(∀(n :num) (limit :num) (heap :(α, β) heap_element list) (h1 :(α, β) heap_element list) (c :bool) (a :num). gc_move_loop (h1,([] :(α, β) heap_element list),a,n,heap,c,limit) = (h1,a,n,heap,c)) ∧ ∀(n :num) (limit :num) (heap :(α, β) heap_element list) (h2 :(α, β) heap_element list) (h1 :(α, β) heap_element list) (h :(α, β) heap_element) (c :bool) (a :num). gc_move_loop (h1,h::h2,a,n,heap,c,limit) = if limit < heap_length (h1 ++ h::h2) then (h1,a,n,heap,F) else case h of (Unused v7 :(α, β) heap_element) => (h1,a,n,heap,F) | (ForwardPointer v8 v9 v10 :(α, β) heap_element) => (h1,a,n,heap,F) | DataElement xs l d => (let ((xs' :α heap_address list),(h2' :(α, β) heap_element list),(a' :num),(n' :num),(heap' :(α, β) heap_element list),(c' :bool)) = gc_move_list (xs,h::h2,a,n,heap,c,limit); (c'' :bool) = (c' ∧ h2' ≠ ([] :(α, β) heap_element list) ∧ HD h2' = h); (h2'' :(α, β) heap_element list) = TL h2'; (h1' :(α, β) heap_element list) = h1 ++ [DataElement xs' l d] in gc_move_loop (h1',h2'',a',n',heap',c'',limit))
full_gc_typed=∀(roots :α heap_address list) (heap :(α, β) heap_element list) (limit :num). full_gc (roots,heap,limit) = (let (c0 :bool) = (heap_length heap = limit); ((roots :α heap_address list),(h2 :(α, β) heap_element list),(a :num),(n :num),(heap :(α, β) heap_element list),(c :bool)) = gc_move_list (roots,([] :(α, β) heap_element list),(0 :num),limit,heap,T,limit); ((heap :(α, β) heap_element list),(a :num),(n :num),(temp :(α, β) heap_element list),(c :bool)) = gc_move_loop (([] :(α, β) heap_element list),h2,a,n,heap,c,limit); (c :bool) = (c ∧ a = heap_length heap ∧ heap_length temp = limit ∧ c0 ∧ n = limit − a ∧ a ≤ limit) in (roots,heap,a,c))
gc_move_list_repeat=gc_move_list ([Pointer (0 :num) (9 :num); Pointer (0 :num) (10 :num)],([] :(num, num) heap_element list),(0 :num),(2 :num),[DataElement ([] :num heap_address list) (1 :num) (4 :num)],T,(2 :num)) = ([Pointer (0 :num) (9 :num); Pointer (0 :num) (10 :num)],[DataElement ([] :num heap_address list) (1 :num) (4 :num)],(2 :num),(0 :num),[(ForwardPointer (0 :num) (9 :num) (1 :num) :(num, num) heap_element)],T)
full_gc_data=full_gc ([Data (7 :num)],[(Unused (1 :num) :(num, num) heap_element)],(2 :num)) = ([Data (7 :num)],([] :(num, num) heap_element list),(0 :num),T)
full_gc_pointer=full_gc ([Pointer (0 :num) (9 :num)],[DataElement [Data (5 :num)] (1 :num) (4 :num)],(2 :num)) = ([Pointer (0 :num) (9 :num)],[DataElement [Data (5 :num)] (1 :num) (4 :num)],(2 :num),T)
gc_forward_ptr_ok_typed=∀(heap :(α, β) heap_element list) (n :num) (a :num) (c :bool) (x :(α, β) heap_element list). gc_forward_ptr n heap a (d :α) c = (x,T) ⇒ c
gc_move_ok_typed=gc_move ((x :α heap_address),(h2 :(α, β) heap_element list),(a :num),(n :num),(heap :(α, β) heap_element list),(c :bool),(limit :num)) = ((x' :α heap_address),(h2' :(α, β) heap_element list),(a' :num),(n' :num),(heap' :(α, β) heap_element list),T) ⇒ c ∧ (a = (b :num) + heap_length h2 ⇒ a' = b + heap_length h2')
gc_move_list_ok_typed=∀(xs :α heap_address list) (h2 :(α, β) heap_element list) (a :num) (n :num) (heap :(α, β) heap_element list) (c :bool) (limit :num) (xs' :α heap_address list) (h2' :(α, β) heap_element list) (a' :num) (n' :num) (heap' :(α, β) heap_element list) (c' :γ). gc_move_list (xs,h2,a,n,heap,c,limit) = (xs',h2',a',n',heap',T) ⇒ c ∧ (a = (b :num) + heap_length h2 ⇒ a' = b + heap_length h2')
gc_move_loop_ok_typed=gc_move_loop ((h1 :(α, β) heap_element list),(h2 :(α, β) heap_element list),(a :num),(n :num),(heap :(α, β) heap_element list),(c :bool),(limit :num)) = ((h1' :(α, β) heap_element list),(a' :num),(n' :num),(heap' :(α, β) heap_element list),T) ⇒ c
gc_move_list_IMP_LENGTH_typed=∀(l5 :α heap_address list) (h :(α, β) heap_element list) (a :num) (n :num) (heap :(α, β) heap_element list) (c :bool) (k :num) (xs :α heap_address list) (ys :(α, β) heap_element list) (a1 :num) (xs1 :num) (heap1 :(α, β) heap_element list) (c1 :bool). gc_move_list (l5,h,a,n,heap,c,k) = (xs,ys,a1,xs1,heap1,c1) ⇒ LENGTH xs = LENGTH l5
full_gc_IMP_LENGTH_typed=full_gc ((xs :α heap_address list),(heap :(α, β) heap_element list),(limit :num)) = ((roots2 :α heap_address list),(heap2 :(α, β) heap_element list),(h :num),T) ⇒ LENGTH roots2 = LENGTH xs
gc_move_IMP_isDataElement_typed=∀(l5 :α heap_address) (h :(α, β) heap_element list) (a :num) (n :num) (heap :(α, β) heap_element list) (c :bool) (k :num) (xs :α heap_address) (ys :(α, β) heap_element list) (a1 :num) (xs1 :num) (heap1 :(α, β) heap_element list) (c1 :bool). EVERY (isDataElement :(α, β) heap_element -> bool) h ∧ gc_move (l5,h,a,n,heap,c,k) = (xs,ys,a1,xs1,heap1,c1) ⇒ EVERY (isDataElement :(α, β) heap_element -> bool) ys
gc_move_list_IMP_isDataElement_typed=∀(l5 :α heap_address list) (h :(α, β) heap_element list) (a :num) (n :num) (heap :(α, β) heap_element list) (c :bool) (k :num) (xs :α heap_address list) (ys :(α, β) heap_element list) (a1 :num) (xs1 :num) (heap1 :(α, β) heap_element list) (c1 :bool). EVERY (isDataElement :(α, β) heap_element -> bool) h ∧ gc_move_list (l5,h,a,n,heap,c,k) = (xs,ys,a1,xs1,heap1,c1) ⇒ EVERY (isDataElement :(α, β) heap_element -> bool) ys
gc_move_loop_IMP_isDataElement_typed=∀(h1 :(α, β) heap_element list) (h2 :(α, β) heap_element list) (a :num) (n :num) (heap :(α, β) heap_element list) (c :bool) (limit :num) (h1' :(α, β) heap_element list) (a' :num) (n' :num) (heap' :(α, β) heap_element list) (c' :γ). EVERY (isDataElement :(α, β) heap_element -> bool) h1 ∧ EVERY (isDataElement :(α, β) heap_element -> bool) h2 ∧ gc_move_loop (h1,h2,a,n,heap,c,limit) = (h1',a',n',heap',T) ⇒ EVERY (isDataElement :(α, β) heap_element -> bool) h1'
full_gc_IMP_isDataElement_typed=full_gc ((roots :α heap_address list),(heap :(α, β) heap_element list),(limit :num)) = ((roots1 :α heap_address list),(heap1 :(α, β) heap_element list),(a :num),T) ⇒ EVERY (isDataElement :(α, β) heap_element -> bool) heap1
