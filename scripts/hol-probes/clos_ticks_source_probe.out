remove_sing_typed=(∀(v :num) (t :tra). remove_ticks_sing (Var t v :exp) = (Var t v :exp)) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (t :tra). remove_ticks_sing (If t x1 x2 x3 :exp) = (If t (remove_ticks_sing x1) (remove_ticks_sing x2) (remove_ticks_sing x3) :exp)) ∧ (∀(xs :exp list) (x2 :exp) (t :tra). remove_ticks_sing (Let t xs x2) = Let t (remove_ticks_list xs) (remove_ticks_sing x2)) ∧ (∀(x1 :exp) (t :tra). remove_ticks_sing (Raise t x1 :exp) = (Raise t (remove_ticks_sing x1) :exp)) ∧ (∀(x2 :exp) (x1 :exp) (t :tra). remove_ticks_sing (Handle t x1 x2 :exp) = (Handle t (remove_ticks_sing x1) (remove_ticks_sing x2) :exp)) ∧ (∀(xs :exp list) (t :tra) (op :op). remove_ticks_sing (Op t op xs) = Op t op (remove_ticks_list xs)) ∧ (∀(x1 :exp) (t :tra). remove_ticks_sing (Tick t x1) = remove_ticks_sing x1) ∧ (∀(xs :exp list) (ticks :num) (t :tra) (dest :num). remove_ticks_sing (Call t ticks dest xs) = Call t (0 :num) dest (remove_ticks_list xs)) ∧ (∀(xs :exp list) (x1 :exp) (t :tra) (loc_opt :num option). remove_ticks_sing (App t loc_opt x1 xs :exp) = (App t loc_opt (remove_ticks_sing x1) (remove_ticks_list xs) :exp)) ∧ (∀(x1 :exp) (vs :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # exp) list). remove_ticks_sing (Letrec t loc_opt vs fns x1 :exp) = (let (new_fns :(num # exp) list) = remove_ticks_let fns in (Letrec t loc_opt vs new_fns (remove_ticks_sing x1) :exp))) ∧ (∀(x1 :exp) (vs :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). remove_ticks_sing (Fn t loc_opt vs num_args x1) = Fn t loc_opt vs num_args (remove_ticks_sing x1)) ∧ remove_ticks_list ([] :exp list) = ([] :exp list) ∧ (∀(xs :exp list) (x :exp). remove_ticks_list (x::xs) = remove_ticks_sing x::remove_ticks_list xs) ∧ remove_ticks_let ([] :(num # exp) list) = ([] :(num # exp) list) ∧ ∀(xs :(num # exp) list) (x :exp) (num_args :num). remove_ticks_let ((num_args,x)::xs) = (num_args,remove_ticks_sing x)::remove_ticks_let xs
remove_sing_eq_typed=(∀(e :exp). remove_ticks [e] = [remove_ticks_sing e]) ∧ (∀(es :exp list). remove_ticks es = remove_ticks_list es) ∧ ∀(fns :(num # exp) list). remove_ticks_let fns = MAP (λ((num_args :num),(x :exp)). (num_args,HD (remove_ticks [x]))) fns
compile_inc_typed=∀(e :exp list) (xs :β). (compile_inc (e,xs) :exp list # α list) = (remove_ticks e,([] :α list))
