remove_var_ticks_typed=∀(x :closLang$exp) (tr :tra) (n :num). [(Var tr n :closLang$exp)] = remove_ticks [x] ⇒ ∃(ts :tra list). x = mk_Ticks ts (Var tr n :closLang$exp)
remove_raise_ticks_typed=∀(x :closLang$exp) (t :tra) (e :closLang$exp). [(Raise t e :closLang$exp)] = remove_ticks [x] ⇒ ∃(ts :tra list) (e' :closLang$exp). x = mk_Ticks ts (Raise t e' :closLang$exp) ∧ [e] = remove_ticks [e']
