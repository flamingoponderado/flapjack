do_app_lemma_typed=state_rel (s :(γ, 'ffi) state) (t :(γ, 'ffi) state) ∧ LIST_REL v_rel (xs :v list) (ys :v list) ⇒ case (do_app (opp :closLang$op) ys t :(v # (γ, 'ffi) state, v) result) of (Rval (y,t1) :(v # (γ, 'ffi) state, v) result) => ∃(x :v) (s1 :(γ, 'ffi) state). v_rel x y ∧ state_rel s1 t1 ∧ (do_app opp xs s :(v # (γ, 'ffi) state, v) result) = (Rval (x,s1) :(v # (γ, 'ffi) state, v) result) | (Rerr err2 :(v # (γ, 'ffi) state, v) result) => ∃(err1 :v error_result). (do_app opp xs s :(v # (γ, 'ffi) state, v) result) = (Rerr err1 :(v # (γ, 'ffi) state, v) result) ∧ exc_rel v_rel err1 err2
bytes_statement_typed=v_rel (x :v) (y :v) ⇒ v_to_bytes y = v_to_bytes x
words_statement_typed=v_rel (x :v) (y :v) ⇒ v_to_words y = v_to_words x
do_install_lemma_typed=state_rel (s :(γ, 'ffi) state) (t :(γ, 'ffi) state) ∧ LIST_REL v_rel (xs :v list) (ys :v list) ⇒ case do_install xs s of ((Rval exps1 :(closLang$exp list, v) result),s1) => ∃(exps2 :closLang$exp list) (t1 :(γ, 'ffi) state). state_rel s1 t1 ∧ exps1 ≠ ([] :closLang$exp list) ∧ code_rel exps1 exps2 ∧ do_install ys t = ((Rval exps2 :(closLang$exp list, v) result),t1) | ((Rerr err1 :(closLang$exp list, v) result),s1) => ∃(err2 :v error_result) (t1 :(γ, 'ffi) state). do_install ys t = ((Rerr err2 :(closLang$exp list, v) result),t1) ∧ exc_rel v_rel err1 err2 ∧ state_rel s1 t1
remove_ticks_correct_typed=∀(xs :closLang$exp list) (env2 :v list) (t1 :(γ, 'ffi) state) (res2 :(v list, v) result) (t2 :(γ, 'ffi) state) (env1 :v list) (s1 :(γ, 'ffi) state). evaluate (remove_ticks xs,env2,t1) = (res2,t2) ∧ LIST_REL v_rel env1 env2 ∧ state_rel s1 t1 ⇒ ∃(ck :num) (res1 :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate (xs,env1,s1 with clock := s1.clock + ck) = (res1,s2) ∧ result_rel (LIST_REL v_rel) v_rel res1 res2 ∧ state_rel s2 t2
semantics_remove_ticks_typed=semantics (ffi :'ffi ffi_state) (max_app :num) (FEMPTY :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option)) (xs :closLang$exp list) ≠ Fail ⇒ (∀(n :num). SND (SND (co n)) = ([] :(num # num # closLang$exp) list)) ∧ (1 :num) ≤ max_app ⇒ semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) co (pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) cc) xs = semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) ((pure_co (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :α # closLang$exp list # (num # num # closLang$exp) list -> α # closLang$exp list # (num # num # closLang$exp) list) ∘ co) cc (remove_ticks xs)
rel_update_thunk_statement_typed=state_rel (s1 :(γ, 'ffi) state) (s2 :(γ, 'ffi) state) ∧ LIST_REL v_rel (vs :v list) (ys :v list) ⇒ (update_thunk [RefPtr (v :bool) (ptr :num)] s2.refs ys = (NONE :(num |-> v ref) option) ⇒ update_thunk [RefPtr v ptr] s1.refs vs = (NONE :(num |-> v ref) option)) ∧ (update_thunk [RefPtr v ptr] s2.refs ys = SOME (refs2 :num |-> v ref) ⇒ ∃(refs1 :num |-> v ref). update_thunk [RefPtr v ptr] s1.refs vs = SOME refs1 ∧ state_rel (s1 with refs := refs1) (s2 with refs := refs2))
rel_update_thunk_replay_typed=state_rel (s1 :(γ, 'ffi) state) (s2 :(γ, 'ffi) state) ∧ LIST_REL v_rel (vs :v list) (ys :v list) ⇒ (update_thunk [RefPtr (v :bool) (ptr :num)] s2.refs ys = (NONE :(num |-> v ref) option) ⇒ update_thunk [RefPtr v ptr] s1.refs vs = (NONE :(num |-> v ref) option)) ∧ (update_thunk [RefPtr v ptr] s2.refs ys = SOME (refs2 :num |-> v ref) ⇒ ∃(refs1 :num |-> v ref). update_thunk [RefPtr v ptr] s1.refs vs = SOME refs1 ∧ state_rel (s1 with refs := refs1) (s2 with refs := refs2))
state_rel_dec_clock_typed=state_rel (s1 :(γ, 'ffi) state) (s2 :(γ, 'ffi) state) ⇒ state_rel (dec_clock (1 :num) s1) (dec_clock (1 :num) s2)
