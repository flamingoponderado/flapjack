remove_ticks_typed=remove_ticks ([] :closLang$exp list) = ([] :closLang$exp list) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp). remove_ticks (x::y::xs) = HD (remove_ticks [x])::remove_ticks (y::xs)) ∧ (∀(v :num) (t :tra). remove_ticks [(Var t v :closLang$exp)] = [(Var t v :closLang$exp)]) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). remove_ticks [(If t x1 x2 x3 :closLang$exp)] = [(If t (HD (remove_ticks [x1])) (HD (remove_ticks [x2])) (HD (remove_ticks [x3])) :closLang$exp)]) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). remove_ticks [(Let t xs x2 :closLang$exp)] = [(Let t (remove_ticks xs) (HD (remove_ticks [x2])) :closLang$exp)]) ∧ (∀(x1 :closLang$exp) (t :tra). remove_ticks [(Raise t x1 :closLang$exp)] = [(Raise t (HD (remove_ticks [x1])) :closLang$exp)]) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). remove_ticks [(Handle t x1 x2 :closLang$exp)] = [(Handle t (HD (remove_ticks [x1])) (HD (remove_ticks [x2])) :closLang$exp)]) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). remove_ticks [Op t op xs] = [Op t op (remove_ticks xs)]) ∧ (∀(x1 :closLang$exp) (t :tra). remove_ticks [Tick t x1] = remove_ticks [x1]) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). remove_ticks [Call t ticks dest xs] = [Call t (0 :num) dest (remove_ticks xs)]) ∧ (∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). remove_ticks [(App t loc_opt x1 xs :closLang$exp)] = [(App t loc_opt (HD (remove_ticks [x1])) (remove_ticks xs) :closLang$exp)]) ∧ (∀(x1 :closLang$exp) (vs :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). remove_ticks [(Letrec t loc_opt vs fns x1 :closLang$exp)] = (let (new_fns :(num # closLang$exp) list) = MAP (λ((num_args :num),(x :closLang$exp)). (num_args,HD (remove_ticks [x]))) fns in [(Letrec t loc_opt vs new_fns (HD (remove_ticks [x1])) :closLang$exp)])) ∧ ∀(x1 :closLang$exp) (vs :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). remove_ticks [Fn t loc_opt vs num_args x1] = [Fn t loc_opt vs num_args (HD (remove_ticks [x1]))]
remove_sing_typed=(∀(v :num) (t :tra). remove_ticks_sing (Var t v :closLang$exp) = (Var t v :closLang$exp)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra). remove_ticks_sing (If t x1 x2 x3 :closLang$exp) = (If t (remove_ticks_sing x1) (remove_ticks_sing x2) (remove_ticks_sing x3) :closLang$exp)) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra). remove_ticks_sing (Let t xs x2 :closLang$exp) = (Let t (remove_ticks_list xs) (remove_ticks_sing x2) :closLang$exp)) ∧ (∀(x1 :closLang$exp) (t :tra). remove_ticks_sing (Raise t x1 :closLang$exp) = (Raise t (remove_ticks_sing x1) :closLang$exp)) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra). remove_ticks_sing (Handle t x1 x2 :closLang$exp) = (Handle t (remove_ticks_sing x1) (remove_ticks_sing x2) :closLang$exp)) ∧ (∀(xs :closLang$exp list) (t :tra) (op :closLang$op). remove_ticks_sing (Op t op xs) = Op t op (remove_ticks_list xs)) ∧ (∀(x1 :closLang$exp) (t :tra). remove_ticks_sing (Tick t x1) = remove_ticks_sing x1) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (dest :num). remove_ticks_sing (Call t ticks dest xs) = Call t (0 :num) dest (remove_ticks_list xs)) ∧ (∀(xs :closLang$exp list) (x1 :closLang$exp) (t :tra) (loc_opt :num option). remove_ticks_sing (App t loc_opt x1 xs :closLang$exp) = (App t loc_opt (remove_ticks_sing x1) (remove_ticks_list xs) :closLang$exp)) ∧ (∀(x1 :closLang$exp) (vs :num list option) (t :mlstring list) (loc_opt :num option) (fns :(num # closLang$exp) list). remove_ticks_sing (Letrec t loc_opt vs fns x1 :closLang$exp) = (let (new_fns :(num # closLang$exp) list) = remove_ticks_let fns in (Letrec t loc_opt vs new_fns (remove_ticks_sing x1) :closLang$exp))) ∧ (∀(x1 :closLang$exp) (vs :num list option) (t :mlstring) (num_args :num) (loc_opt :num option). remove_ticks_sing (Fn t loc_opt vs num_args x1) = Fn t loc_opt vs num_args (remove_ticks_sing x1)) ∧ remove_ticks_list ([] :closLang$exp list) = ([] :closLang$exp list) ∧ (∀(xs :closLang$exp list) (x :closLang$exp). remove_ticks_list (x::xs) = remove_ticks_sing x::remove_ticks_list xs) ∧ remove_ticks_let ([] :(num # closLang$exp) list) = ([] :(num # closLang$exp) list) ∧ ∀(xs :(num # closLang$exp) list) (x :closLang$exp) (num_args :num). remove_ticks_let ((num_args,x)::xs) = (num_args,remove_ticks_sing x)::remove_ticks_let xs
remove_sing_eq_typed=(∀(e :closLang$exp). remove_ticks [e] = [remove_ticks_sing e]) ∧ (∀(es :closLang$exp list). remove_ticks es = remove_ticks_list es) ∧ ∀(fns :(num # closLang$exp) list). remove_ticks_let fns = MAP (λ((num_args :num),(x :closLang$exp)). (num_args,HD (remove_ticks [x]))) fns
compile_inc_typed=∀(e :closLang$exp list) (xs :β). (compile_inc (e,xs) :closLang$exp list # α list) = (remove_ticks e,([] :α list))
remove_vars_none_typed=∀(ls :closLang$exp list). every_Fn_vs_NONE (remove_ticks ls) ⇔ every_Fn_vs_NONE ls
code_rel_typed=∀(e1 :closLang$exp list) (e2 :closLang$exp list). code_rel e1 e2 ⇔ e2 = remove_ticks e1
function_rel_typed=∀(a1 :α) (e1 :closLang$exp) (a2 :α) (e2 :closLang$exp). f_rel (a1,e1) (a2,e2) ⇔ a1 = a2 ∧ code_rel [e1] [e2]
value_rel_typed=(∀(i :int). v_rel (Number i) (Number i)) ∧ (∀(w :word64). v_rel (Word64 w :v) (Word64 w :v)) ∧ (∀(w :word8 list). v_rel (ByteVector w) (ByteVector w)) ∧ (∀(n :num) (b :bool). v_rel (RefPtr b n) (RefPtr b n)) ∧ (∀(tag :num) (xs :v list) (ys :v list). LIST_REL v_rel xs ys ⇒ v_rel (Block tag xs) (Block tag ys)) ∧ (∀(loc :num option) (args1 :v list) (args2 :v list) (env1 :v list) (env2 :v list) (num_args :num) (e1 :closLang$exp) (e2 :closLang$exp). LIST_REL v_rel env1 env2 ∧ LIST_REL v_rel args1 args2 ∧ code_rel [e1] [e2] ⇒ v_rel (Closure loc args1 env1 num_args e1 :v) (Closure loc args2 env2 num_args e2 :v)) ∧ ∀(funs1 :(num # closLang$exp) list) (funs2 :(num # closLang$exp) list) (loc :num option) (args1 :v list) (args2 :v list) (env1 :v list) (env2 :v list) (k :num). LIST_REL v_rel env1 env2 ∧ LIST_REL v_rel args1 args2 ∧ LIST_REL (f_rel :num # closLang$exp -> num # closLang$exp -> bool) funs1 funs2 ⇒ v_rel (Recclosure loc args1 env1 funs1 k :v) (Recclosure loc args2 env2 funs2 k :v)
ref_rel_typed=(∀(bs :word8 list). (ref_rel (ByteArray bs :v ref) (ByteArray bs :v ref) :bool)) ∧ (∀(xs :v list) (ys :v list). LIST_REL v_rel xs ys ⇒ (ref_rel (ValueArray xs) (ValueArray ys) :bool)) ∧ ∀(m :thunk_mode) (v :v) (w :v). v_rel v w ⇒ (ref_rel (Thunk m v :v ref) (Thunk m w :v ref) :bool)
state_rel_typed=∀(s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list)) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.max_app = s.max_app ∧ (1 :num) ≤ s.max_app ∧ t.clock = s.clock ∧ t.ffi = s.ffi ∧ LIST_REL (OPTREL v_rel) s.globals t.globals ∧ FMAP_REL ref_rel s.refs t.refs ∧ s.compile = pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) t.compile ∧ t.compile_oracle = (pure_co (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :γ # closLang$exp list # (num # num # closLang$exp) list -> γ # closLang$exp list # (num # num # closLang$exp) list) ∘ s.compile_oracle
code_rel_length_typed=∀(xs :closLang$exp list) (ys :closLang$exp list). code_rel xs ys ⇒ LENGTH xs = LENGTH ys
