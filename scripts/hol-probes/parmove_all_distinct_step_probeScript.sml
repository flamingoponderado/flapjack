load "bossLib"; load "preamble"; load "parmoveTheory";
open bossLib HolKernel Parse preamble parmoveTheory;
fun observe label term = let val th = EVAL term in print (label ^ "="); print_term (rhs (concl th)); print "\n" end;
observe "ads_remove" ``let s1 = (([(SOME 1,SOME 1)],[],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list); s2 = (([],[],[]) : (num option # num option) list # (num option # num option) list # (num option # num option) list) in ALL_DISTINCT (FILTER IS_SOME (MAP FST (FST s1 ++ FST(SND s1) ++ SND(SND s1)))) /\ ALL_DISTINCT (FILTER IS_SOME (MAP FST (FST s2 ++ FST(SND s2) ++ SND(SND s2))))``;
