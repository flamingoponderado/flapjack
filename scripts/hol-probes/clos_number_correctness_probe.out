v_rel_rules_typed=∀(max_app :num). (∀(j :int). v_rel max_app (Number j) (Number j)) ∧ (∀(w :word64). v_rel max_app (Word64 w :v) (Word64 w :v)) ∧ (∀(t :num) (xs :v list) (ys :v list). LIST_REL (v_rel max_app) xs ys ⇒ v_rel max_app (Block t xs) (Block t ys)) ∧ (∀(ws :word8 list). v_rel max_app (ByteVector ws) (ByteVector ws)) ∧ (∀(b :bool) (r1 :num). v_rel max_app (RefPtr b r1) (RefPtr b r1)) ∧ (∀(argenv :v list) (argenv' :v list) (c :closLang$exp) (c' :closLang$exp) (env :v list) (env' :v list) (n :num) (num_args :num) (p :num option) (p' :num option). LIST_REL (v_rel max_app) env env' ∧ LIST_REL (v_rel max_app) argenv argenv' ∧ ¬contains_App_SOME max_app [c] ∧ c' = SND (renumber_code_locs n c) ⇒ v_rel max_app (Closure p argenv env num_args c :v) (Closure p' argenv' env' num_args c' :v)) ∧ ∀(argenv :v list) (argenv' :v list) (env :v list) (env' :v list) (es :(num # closLang$exp) list) (es' :(num # closLang$exp) list) (k :num) (n :num) (p :num option) (p' :num option). LIST_REL (v_rel max_app) env env' ∧ LIST_REL (v_rel max_app) argenv argenv' ∧ ¬contains_App_SOME max_app (MAP (SND :num # closLang$exp -> closLang$exp) es) ∧ es' = ZIP (MAP (FST :num # closLang$exp -> num) es,SND (renumber_code_locs_list n (MAP (SND :num # closLang$exp -> closLang$exp) es))) ⇒ v_rel max_app (Recclosure p argenv env es k :v) (Recclosure p' argenv' env' es' k :v)
state_rel_typed=∀(s :(num # γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel s t ⇔ s.clock = t.clock ∧ s.ffi = t.ffi ∧ t.max_app = s.max_app ∧ s.compile = state_cc (ignore_table compile_inc :num -> closLang$exp list # (num # num # closLang$exp) list -> num # closLang$exp list # (num # num # closLang$exp) list) t.compile ∧ t.compile_oracle = state_co (ignore_table compile_inc :num -> closLang$exp list # (num # num # closLang$exp) list -> num # closLang$exp list # (num # num # closLang$exp) list) s.compile_oracle ∧ fmap_rel (ref_rel (v_rel s.max_app)) s.refs t.refs ∧ LIST_REL (OPTREL (v_rel s.max_app)) s.globals t.globals ∧ (∀(n :num). SND (SND (s.compile_oracle n)) = ([] :(num # num # closLang$exp) list) ∧ ¬contains_App_SOME s.max_app (FST (SND (s.compile_oracle n)))) ∧ s.code = (FEMPTY :num |-> num # closLang$exp) ∧ t.code = (FEMPTY :num |-> num # closLang$exp)
renumber_correct_typed=(∀(tmp :closLang$exp list # v list # (num # γ, 'ffi) state) (xs :closLang$exp list) (env :v list) (s1 :(num # γ, 'ffi) state) (env' :v list) (t1 :(γ, 'ffi) state) (res :(v list, v) result) (s2 :(num # γ, 'ffi) state) (n :num). tmp = (xs,env,s1) ∧ evaluate (xs,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ¬contains_App_SOME s1.max_app xs ∧ LIST_REL (v_rel s1.max_app) env env' ∧ state_rel s1 t1 ⇒ ∃(res' :(v list, v) result) (t2 :(γ, 'ffi) state). evaluate (SND (renumber_code_locs_list n xs),env',t1) = (res',t2) ∧ result_rel (LIST_REL (v_rel s1.max_app)) (v_rel s1.max_app) res res' ∧ state_rel s2 t2) ∧ ∀(loc :num option) (f :v) (args :v list) (s :(num # γ, 'ffi) state) (res :(v list, v) result) (s2 :(num # γ, 'ffi) state) (f' :v) (args' :v list) (t1 :(γ, 'ffi) state). evaluate_app loc f args s = (res,s2) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ v_rel s.max_app f f' ∧ loc = (NONE :num option) ∧ LIST_REL (v_rel s.max_app) args args' ∧ state_rel s t1 ⇒ ∃(res' :(v list, v) result) (t2 :(γ, 'ffi) state). evaluate_app loc f' args' t1 = (res',t2) ∧ result_rel (LIST_REL (v_rel s.max_app)) (v_rel s.max_app) res res' ∧ state_rel s2 t2
semantics_number_typed=semantics (ffi :'ffi ffi_state) (max_app :num) (FEMPTY :num |-> num # closLang$exp) (co :num -> (num # α) # closLang$exp list # (num # num # closLang$exp) list) (state_cc (ignore_table compile_inc :num -> closLang$exp list # (num # num # closLang$exp) list -> num # closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option)) (xs :closLang$exp list) ≠ Fail ⇒ ¬contains_App_SOME max_app xs ∧ (∀(n :num). SND (SND (co n)) = ([] :(num # num # closLang$exp) list) ∧ ¬contains_App_SOME max_app (FST (SND (co n)))) ⇒ semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) (state_co (ignore_table compile_inc :num -> closLang$exp list # (num # num # closLang$exp) list -> num # closLang$exp list # (num # num # closLang$exp) list) co) cc (SND (renumber_code_locs_list (n :num) xs)) = semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) co (state_cc (ignore_table compile_inc :num -> closLang$exp list # (num # num # closLang$exp) list -> num # closLang$exp list # (num # num # closLang$exp) list) cc) xs
