copy_each_statement=∀pattern i a off bs d m dm i1 a1 m1 x t. copy_words_for_pattern pattern i a off bs d m = SOME (i1,a1,m1) ∧ ALL_DISTINCT [1; 2; 3; t1; t2] ∧ dm = t.mdomain ∧ good_dimindex (:α) ∧ get_var 1 t = SOME (Word pattern) ∧ d ⊆ dm ∧ get_var 2 t = SOME (Word a) ∧ get_var 3 t = SOME (Word off) ∧ get_var t2 t = SOME (Word (x + bytes_in_word * n2w i)) ∧ (word_list x (MAP Word bs) * rest * memory m d) (fun2set (t.memory,dm)) ⇒ ∃ck y m2. evaluate (copy_each t1 t2,t with clock := t.clock + ck) = (NONE,t with <|memory := m2; regs := (if pattern = 1w then t.regs else t.regs⟨t1 ↦ Word y⟩)⟨t2 ↦ Word (x + bytes_in_word * n2w i1); 1 ↦ Word 1w; 2 ↦ Word a1⟩|>) ∧ (word_list x (MAP Word bs) * rest * memory m1 d) (fun2set (m2,dm))
copy_each_proved=T
