push_env_s_val_eq_typed=∀(tperm :num -> num -> num). (st :(α, β, γ) state).handler = (cst :(α, δ, ε) state).handler ∧ st.stack = cst.stack ∧ st.locals_size = cst.locals_size ∧ (domain (y :α word_loc sptree$num_map) :num -> bool) = IMAGE (f :num -> num) (domain (x :α word_loc sptree$num_map) :num -> bool) ∧ INJ f (domain x :num -> bool) 𝕌(:num) ∧ (domain (y' :α word_loc sptree$num_map) :num -> bool) = IMAGE f (domain (x' :α word_loc sptree$num_map) :num -> bool) ∧ INJ f (domain x' :num -> bool) 𝕌(:num) ∧ strong_locals_rel f (domain x :num -> bool) x y ∧ (case (b :(num # α prog # num # num) option) of (NONE :(num # α prog # num # num) option) => (b' :(num # α prog # num # num) option) = (NONE :(num # α prog # num # num) option) | SOME (w,h,l1,l2) => case b' of (NONE :(num # α prog # num # num) option) => F | SOME (a,b,c,d) => c = l1 ∧ d = l2) ⇒ ∃(perm :num -> num -> num). (let ((l :(num # α word_loc) list),(permute :num -> num -> num)) = env_to_list y cst.permute; ((l' :(num # α word_loc) list),(permute' :num -> num -> num)) = env_to_list x perm in permute' = tperm ∧ MAP (λ((x :num),(y :α word_loc)). (f x,y)) l' = l ∧ ∀(x :num) (y :num). MEM x (MAP (FST :num # α word_loc -> num) l') ∧ MEM y (MAP (FST :num # α word_loc -> num) l') ∧ f x = f y ⇒ x = y) ∧ s_val_eq (push_env (x',x) b (st with permute := perm)).stack (push_env (y',y) b' cst).stack
