cut_env_lemma_typed=INJ (f :num -> num) ((domain (FST (names :sptree$num_set # sptree$num_set)) :num -> bool) ∪ (domain (SND names) :num -> bool)) 𝕌(:num) ∧ cut_env names (sloc :α sptree$num_map) = SOME (x :α sptree$num_map) ∧ strong_locals_rel f ((domain (FST names) :num -> bool) ∪ (domain (SND names) :num -> bool)) sloc (tloc :α sptree$num_map) ⇒ ∃(y :α sptree$num_map). cut_env (apply_nummaps_key f names) tloc = SOME y ∧ (domain y :num -> bool) = IMAGE f (domain x :num -> bool) ∧ strong_locals_rel f ((domain (FST names) :num -> bool) ∪ (domain (SND names) :num -> bool)) x y ∧ INJ f (domain x :num -> bool) 𝕌(:num) ∧ (domain x :num -> bool) = (domain (FST names) :num -> bool) ∪ (domain (SND names) :num -> bool)
cut_envs_lemma_typed=INJ (f :num -> num) (domain (n1 :sptree$num_set) :num -> bool) 𝕌(:num) ∧ INJ f (domain (n2 :sptree$num_set) :num -> bool) 𝕌(:num) ∧ cut_envs (n1,n2) (sloc :α sptree$num_map) = SOME ((x1 :α sptree$num_map),(x2 :α sptree$num_map)) ∧ strong_locals_rel f (domain n1 :num -> bool) sloc (tloc :α sptree$num_map) ∧ strong_locals_rel f (domain n2 :num -> bool) sloc tloc ⇒ ∃(y1 :α sptree$num_map) (y2 :α sptree$num_map). cut_envs (apply_nummaps_key f (n1,n2)) tloc = SOME (y1,y2) ∧ (domain y1 :num -> bool) = IMAGE f (domain n1 :num -> bool) ∧ (domain y2 :num -> bool) = IMAGE f (domain n2 :num -> bool) ∧ strong_locals_rel f (domain n1 :num -> bool) x1 y1 ∧ strong_locals_rel f (domain n2 :num -> bool) x2 y2 ∧ INJ f (domain x1 :num -> bool) 𝕌(:num) ∧ INJ f (domain x2 :num -> bool) 𝕌(:num) ∧ (domain x1 :num -> bool) = (domain n1 :num -> bool) ∧ (domain x2 :num -> bool) = (domain n2 :num -> bool)
cut_names_lemma_typed=∀(names :α sptree$num_map) (sloc :β sptree$num_map) (tloc :β sptree$num_map) (x :β sptree$num_map) (f :num -> num). INJ f (domain names :num -> bool) 𝕌(:num) ∧ cut_names names sloc = SOME x ∧ strong_locals_rel f (domain names :num -> bool) sloc tloc ⇒ ∃(y :β sptree$num_map). cut_names (apply_nummap_key f names) tloc = SOME y ∧ (domain y :num -> bool) = IMAGE f (domain x :num -> bool) ∧ strong_locals_rel f (domain names :num -> bool) x y ∧ INJ f (domain x :num -> bool) 𝕌(:num) ∧ (domain x :num -> bool) = (domain names :num -> bool)
gc_frame_typed=gc (st :(α, β, γ) state) = SOME (st' :(α, β, γ) state) ⇒ st'.fp_regs = st.fp_regs ∧ st'.mdomain = st.mdomain ∧ st'.sh_mdomain = st.sh_mdomain ∧ st'.gc_fun = st.gc_fun ∧ st'.handler = st.handler ∧ st'.clock = st.clock ∧ st'.code = st.code ∧ st'.locals = st.locals ∧ st'.locals_size = st.locals_size ∧ st'.stack_size = st.stack_size ∧ st'.stack_max = st.stack_max ∧ st'.stack_limit = st.stack_limit ∧ (st'.be ⇔ st.be) ∧ st'.ffi = st.ffi ∧ st'.compile = st.compile ∧ st'.compile_oracle = st.compile_oracle ∧ st'.code_buffer = st.code_buffer ∧ st'.data_buffer = st.data_buffer ∧ st'.permute = st.permute ∧ st'.termdep = st.termdep
INJ_union_typed=INJ (f :α -> β) ((A :α -> bool) ∪ (B :α -> bool)) (C :β -> bool) ⇒ INJ f A C ∧ INJ f B C
key_map_implies_typed=MAP (λ((x :γ),(y :β)). ((f :γ -> α) x,y)) (l' :(γ # β) list) = (l :(α # β) list) ⇒ MAP f (MAP (FST :γ # β -> γ) l') = MAP (FST :α # β -> α) l
list_rearrange_keys_typed=list_rearrange (perm :num -> num) (ls :(α # β) list) = (e :(α # β) list) ⇒ set (MAP (FST :α # β -> α) e) = set (MAP (FST :α # β -> α) ls)
list_rearrange_keys_2_typed=set (MAP (FST :α # β -> α) (list_rearrange (perm :num -> num) (ls :(α # β) list))) = set (MAP (FST :α # β -> α) ls)
list_rearrange_MAP_typed=∀(l :α list) (f :α -> β) (m :num -> num). list_rearrange m (MAP f l) = MAP f (list_rearrange m l)
MAP_FST_list_rearrange_keys_SORT_typed=set (MAP (FST :num # α word_loc -> num) (list_rearrange (perm :num -> num) (sort (key_val_compare :num # α word_loc -> num # α word_loc -> bool) (toAList (x :α word_loc sptree$num_map))))) = (domain x :num -> bool)
