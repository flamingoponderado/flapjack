ALOOKUP_key_remap_INJ_typed=INJ (f :α -> β) ((n :α) INSERT set (ls :α list)) 𝕌(:β) ∧ LENGTH ls = LENGTH (vals :γ list) ⇒ ALOOKUP (ZIP (ls,vals)) n = ALOOKUP (ZIP (MAP f ls,vals)) (f n)
