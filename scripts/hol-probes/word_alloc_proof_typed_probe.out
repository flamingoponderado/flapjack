ssa_cc_trans_correct_typed=∀(prog :α prog) (st :(α, β, γ) state) (cst :(α, β, γ) state) (ssa :num sptree$num_map) (na :num) (lt :(num sptree$num_map # sptree$num_set # sptree$num_set) list). word_state_eq_rel st cst ∧ ssa_locals_rel na ssa st.locals cst.locals ∧ is_alloc_var na ∧ every_var (λ(x :num). x < na) prog ∧ ssa_map_ok na ssa ∧ lt_ok lt ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (prog,st with permute := perm') in if res = SOME (Error :α result) then T else (let ((prog' :α prog),(ssa' :num sptree$num_map),(na' :num)) = ssa_cc_trans prog ssa na lt; ((res' :α result option),(rcst :(α, β, γ) state)) = evaluate (prog',cst) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => ssa_locals_rel na' ssa' rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n :α result) => (case LLOOKUP lt n of (NONE :(num sptree$num_map # sptree$num_set # sptree$num_set) option) => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names :num -> bool) rst.locals rcst.locals) | SOME (Continue n' :α result) => (case LLOOKUP lt n' of (NONE :(num sptree$num_map # sptree$num_set # sptree$num_set) option) => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names :num -> bool) rst.locals rcst.locals) | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v18 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals))
select_reg_alloc_correct_typed=∀(alg :num) (spillcosts :num sptree$num_map option) (k :num) (heu_moves :(num # num # num) list) (tree :clash_tree) (forced :(num # num) list) (fs :sptree$num_set). EVERY (λ((r1 :num),(r2 :num)). in_clash_tree tree r1 ∧ in_clash_tree tree r2) forced ⇒ ∃(spcol :num sptree$num_map) (livein :sptree$num_set) (flivein :sptree$num_set). select_reg_alloc alg spillcosts k heu_moves tree forced fs = (M_success spcol :(num sptree$num_map, state_exn) exc) ∧ check_clash_tree (sp_default spcol) tree (LN :sptree$num_set) (LN :sptree$num_set) = SOME (livein,flivein) ∧ (∀(r :num). in_clash_tree tree r ⇒ r ∈ (domain spcol :num -> bool) ∧ if is_phy_var r then sp_default spcol r = r DIV (2 :num) else if is_stack_var r then k ≤ sp_default spcol r else T) ∧ (∀(r :num). r ∈ (domain spcol :num -> bool) ⇒ in_clash_tree tree r) ∧ EVERY (λ((r1 :num),(r2 :num)). sp_default spcol r1 = sp_default spcol r2 ⇒ r1 = r2) forced
word_state_eq_rel_def_typed=∀(s :(α, γ, 'ffi) state) (t :(α, γ, 'ffi) state). word_state_eq_rel s t ⇔ t.fp_regs = s.fp_regs ∧ t.store = s.store ∧ t.locals_size = s.locals_size ∧ t.stack = s.stack ∧ t.stack_limit = s.stack_limit ∧ t.stack_max = s.stack_max ∧ t.stack_size = s.stack_size ∧ t.memory = s.memory ∧ t.mdomain = s.mdomain ∧ t.sh_mdomain = s.sh_mdomain ∧ t.gc_fun = s.gc_fun ∧ t.handler = s.handler ∧ t.clock = s.clock ∧ t.code = s.code ∧ t.ffi = s.ffi ∧ (t.be ⇔ s.be) ∧ t.termdep = s.termdep ∧ t.compile = s.compile ∧ t.compile_oracle = s.compile_oracle ∧ t.code_buffer = s.code_buffer ∧ t.data_buffer = s.data_buffer
strong_locals_rel_def_typed=∀(f :num -> num) (ls :num -> bool) (slocs :α sptree$num_map) (tlocs :α sptree$num_map). strong_locals_rel f ls slocs tlocs ⇔ ∀(n :num) (v :α). n ∈ ls ∧ lookup n slocs = SOME v ⇒ lookup (f n) tlocs = SOME v
strong_locals_rel_insert_typed=INJ (f :num -> num) ((n :num) INSERT (l :num -> bool)) 𝕌(:num) ∧ strong_locals_rel f (l DELETE n) (st :α sptree$num_map) (cst :α sptree$num_map) ⇒ strong_locals_rel f l (insert n (v :α) st) (insert (f n) v cst)
strong_locals_rel_UNION_typed=strong_locals_rel (f :num -> num) ((A :num -> bool) ∪ (B :num -> bool)) (t :α sptree$num_map) (l :α sptree$num_map) ⇔ strong_locals_rel f A t l ∧ strong_locals_rel f B t l
strong_locals_rel_set_var_dom_typed=INJ (f :num -> num) (X :num -> bool) 𝕌(:num) ∧ (domain (s :(α, β, γ) state).locals :num -> bool) ⊆ X ∧ (n :num) ∈ X ∧ strong_locals_rel f (d :num -> bool) s.locals (t :(α, δ, ε) state).locals ⇒ strong_locals_rel f d (set_var n (l :α word_loc) s).locals (set_var (f n) l t).locals
strong_locals_rel_set_vars_dom_typed=LENGTH (ns :num list) = LENGTH (ls :α word_loc list) ∧ INJ (f :num -> num) (X :num -> bool) 𝕌(:num) ∧ (domain (s :(α, β, γ) state).locals :num -> bool) ⊆ X ∧ set ns ⊆ X ∧ strong_locals_rel f (d :num -> bool) s.locals (t :(α, δ, ε) state).locals ⇒ strong_locals_rel f d (set_vars ns ls s).locals (set_vars (MAP f ns) ls t).locals
word_alloc_correct_typed=∀(fc :num) (c :α asm_config) (alg :num) (prog :α prog) (k :num) (col_opt :num sptree$num_map option) (st :(α, β, γ) state). even_starting_locals st.locals ∧ wf_cutsets prog ⇒ ∃(perm' :num -> num -> num). (let ((res :α result option),(rst :(α, β, γ) state)) = evaluate (prog,st with permute := perm') in if res = SOME (Error :α result) then T else (let ((res' :α result option),(rcst :(α, β, γ) state)) = evaluate (word_alloc fc c alg k prog col_opt,st) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of (NONE :α result option) => T | SOME (Result v8 v9) => rst.locals = rcst.locals | SOME (Exception v10 v11) => rst.locals = rcst.locals | SOME (Break v12 :α result) => T | SOME (Continue v13 :α result) => T | SOME (TimeOut :α result) => rst.locals = rcst.locals | SOME (NotEnoughSpace :α result) => rst.locals = rcst.locals | SOME (FinalFFI v14 :α result) => rst.locals = rcst.locals | SOME (Error :α result) => rst.locals = rcst.locals))
