evaluate_remove_dead_typed=∀(prog :α prog) (live :sptree$num_set) (nlive :store_name list) (lt :(sptree$num_set # sptree$num_set) list) (prog' :α prog) (livein :sptree$num_set) (nlivein :store_name list) (st :(α, β, γ) state) (t :α word_loc sptree$num_map) (tstore :store_name |-> α word_loc) (res :α result option) (rst :(α, β, γ) state). strong_locals_rel (I :num -> num) (domain livein :num -> bool) st.locals t ∧ live_store_rel nlivein st.store tstore ∧ evaluate (prog,st) = (res,rst) ∧ flat_exp_conventions prog ∧ remove_dead prog live nlive lt = (prog',livein,nlivein) ∧ res ≠ SOME (Error :α result) ⇒ ∃(t' :α word_loc sptree$num_map) (tstore' :store_name |-> α word_loc). evaluate (prog',st with <|locals := t; store := tstore|>) = (res,rst with <|locals := t'; store := tstore'|>) ∧ case res of (NONE :α result option) => strong_locals_rel (I :num -> num) (domain live :num -> bool) rst.locals t' ∧ live_store_rel nlive rst.store tstore' | SOME (Result v11 v12) => rst.locals = t' ∧ rst.store = tstore' | SOME (Exception v13 v14) => rst.locals = t' ∧ rst.store = tstore' | SOME (Break n :α result) => rst.store = tstore' ∧ (case LLOOKUP lt n of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (v1,exit_names) => strong_locals_rel (I :num -> num) (domain exit_names :num -> bool) rst.locals t') | SOME (Continue n' :α result) => rst.store = tstore' ∧ (case LLOOKUP lt n' of (NONE :(sptree$num_set # sptree$num_set) option) => T | SOME (names,v2) => strong_locals_rel (I :num -> num) (domain names :num -> bool) rst.locals t') | SOME (TimeOut :α result) => rst.locals = t' ∧ rst.store = tstore' | SOME (NotEnoughSpace :α result) => rst.locals = t' ∧ rst.store = tstore' | SOME (FinalFFI v17 :α result) => rst.locals = t' ∧ rst.store = tstore' | SOME (Error :α result) => rst.locals = t' ∧ rst.store = tstore'
