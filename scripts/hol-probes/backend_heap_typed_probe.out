refs_to_addresses_def_statement=refs_to_addresses ([] :(α, β) heap_element list) = ([] :α heap_address list) ∧ (∀(v1 :β) (v0 :num) (refs :(α, β) heap_element list) (ptrs :α heap_address list). refs_to_addresses (DataElement ptrs v0 v1::refs) = ptrs ++ refs_to_addresses refs) ∧ (∀(v4 :num) (refs :(α, β) heap_element list). refs_to_addresses ((Unused v4 :(α, β) heap_element)::refs) = refs_to_addresses refs) ∧ ∀(v7 :num) (v6 :α) (v5 :num) (refs :(α, β) heap_element list). refs_to_addresses ((ForwardPointer v5 v6 v7 :(α, β) heap_element)::refs) = refs_to_addresses refs
compile_to_word_conventions2_source_statement_typed=(compile (wc :word_to_word$config) (ac :α asm_config) (p :(num # num # α prog) list) :num sptree$num_map option list # (num # num # α prog) list) = ((_0 :num sptree$num_map option list),(ps :(num # num # α prog) list)) ∧ EVERY (λ((_1 :num),(_2 :num),(prg :α prog)). no_share_inst prg ∨ ac.ISA ≠ Ag32) p ⇒ MAP (FST :num # num # α prog -> num) ps = MAP (FST :num # num # α prog -> num) p ∧ LIST_REL (labels_rel :(num # num) list -> (num # num) list -> bool) (MAP ((extract_labels :α prog -> (num # num) list) ∘ (SND :num # α prog -> α prog) ∘ (SND :num # num # α prog -> num # α prog)) p) (MAP ((extract_labels :α prog -> (num # num) list) ∘ (SND :num # α prog -> α prog) ∘ (SND :num # num # α prog -> num # α prog)) ps) ∧ EVERY (λ((n :num),(m :num),(prog :α prog)). flat_exp_conventions prog ∧ post_alloc_conventions (ac.reg_count − ((5 :num) + LENGTH ac.avoid_regs)) prog ∧ (EVERY (λ((n :num),(m :num),(prog :α prog)). every_inst (inst_ok_less ac) prog) p ∧ addr_offset_ok ac (0w :α word) ∧ hw_offset_ok ac (0w :α word) ∧ byte_offset_ok ac (0w :α word) ⇒ full_inst_ok_less ac prog) ∧ (ac.two_reg_arith ⇒ every_inst (two_reg_inst :α inst -> bool) prog) ∧ (no_share_inst prog ∨ ac.ISA ≠ Ag32)) ps
