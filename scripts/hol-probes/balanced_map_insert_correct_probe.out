insert_thm=⊢ ∀(t :(α, β) balanced_map). good_cmp (cmp :α -> α -> ordering) ∧ invariant cmp t ⇒ invariant cmp (insert cmp (k :α) (v :β) t) ∧ to_fmap cmp (insert cmp k v t) = (to_fmap cmp t)⟨key_set cmp k ↦ v⟩
