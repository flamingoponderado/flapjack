ogs P (Skip :α prog) ⇔ T) ∧ (not_created_subprogs P (Move (v18 :num) (v19 :(num # num) list) :α prog) ⇔ T) ∧ (not_created_subprogs P (Inst (v20 :α inst) :α prog) ⇔ T) ∧ (not_created_subprogs P (Assign (v21 :num) (v22 :α exp)) ⇔ T) ∧ (not_created_subprogs P (Get (v23 :num) (v24 :store_name) :α prog) ⇔ T) ∧ (not_created_subprogs P (Set (v25 :store_name) (v26 :α exp) :α prog) ⇔ T) ∧ (not_created_subprogs P (Store (v27 :α exp) (v28 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (StoreConsts (v46 :num) (v47 :num) (v48 :num) (v49 :num) (v50 :(bool # α word) list) :α prog) ⇔ T) ∧ (not_created_subprogs P (Raise (v51 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (Return (v52 :num) (v53 :num list) :α prog) ⇔ T) ∧ (not_created_subprogs P (Break (v54 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (Continue (v55 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (Tick :α prog) ⇔ T) ∧ (not_created_subprogs P (OpCurrHeap (v56 :binop) (v57 :num) (v58 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (CodeBufferWrite (v66 :num) (v67 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (DataBufferWrite (v68 :num) (v69 :num) :α prog) ⇔ T) ∧ (not_created_subprogs P (FFI (v70 :mlstring) (v71 :num) (v72 :num) (v73 :num) (v74 :num) (v75 :sptree$num_set # sptree$num_set) :α prog) ⇔ T)
