wc_every_var_inst_conj_typed=∀(P :num -> bool) (inst :α inst) (Q :num -> bool). every_var_inst P inst ∧ every_var_inst Q inst ⇔ every_var_inst (λ(x :num). P x ∧ Q x) inst
wc_every_var_exp_conj_typed=∀(P :num -> bool) (exp :α exp) (Q :num -> bool). every_var_exp P exp ∧ every_var_exp Q exp ⇔ every_var_exp (λ(x :num). P x ∧ Q x) exp
wc_every_var_conj_typed=∀(P :num -> bool) (prog :α prog) (Q :num -> bool). every_var P prog ∧ every_var Q prog ⇔ every_var (λ(x :num). P x ∧ Q x) prog
