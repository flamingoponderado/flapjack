write_full_write_bytearray_IGNORE_non_aligned=⊢ ∀m d be b new_bytes a. (∀x. b ≠ byte_align x) ⇒ write_bytearray a new_bytes m d be b = m b
write_full_write_bytearray_IGNORE=⊢ ∀m1 m d1 d be new_bytes a x xx. d1 ⊆ d ∧ read_bytearray a (LENGTH new_bytes) (mem_load_byte_aux m1 d1 be) = SOME x ∧ xx ∉ d1 ⇒ write_bytearray a new_bytes m d be xx = m xx
write_full_write_bytearray_EQ=⊢ ∀d1 d be new_bytes a m1 m y x. d1 ⊆ d ∧ (∀a. a ∈ d1 ⇒ m1 a = m a ∧ a ∈ d) ∧ read_bytearray a (LENGTH new_bytes) (mem_load_byte_aux m1 d1 be) = SOME y ∧ m1 x = m x ⇒ write_bytearray a new_bytes m1 d1 be x = write_bytearray a new_bytes m d be x
