filter_correct_typed=∀(s1 :(α, γ, 'ffi) labSem$state) (t1 :(α, γ, 'ffi) labSem$state) (res :machine_result) (s2 :(α, γ, 'ffi) labSem$state). (evaluate s1 :machine_result # (α, γ, 'ffi) labSem$state) = (res,s2) ∧ state_rel s1 t1 ∧ ¬t1.failed ⇒ ∃(k :num) (t2 :(α, γ, 'ffi) labSem$state). (evaluate (t1 with clock := s1.clock + k) :machine_result # (α, γ, 'ffi) labSem$state) = (res,t2) ∧ s2.ffi = t2.ffi
adjust_pc_def_typed=∀(xs :α sec list) (p :num). adjust_pc p xs = if p = (0 :num) then (0 :num) else case xs of ([] :α sec list) => p | Section n ([] :α line list)::rest => adjust_pc p rest | Section n (l::lines)::rest => if is_Label l then adjust_pc p (Section n lines::rest) else if not_skip l then adjust_pc (p − (1 :num)) (Section n lines::rest) + (1 :num) else adjust_pc (p − (1 :num)) (Section n lines::rest)
all_skips_def_typed=∀(pc :num) (code :α sec list) (k :num). all_skips pc code k ⇔ (∀(x :word8 list) (y :num). asm_fetch_aux (pc + k) code ≠ SOME (Asm (Asmi (Inst (Skip :α inst) :α asm)) x y)) ∧ ∀(i :num). i < k ⇒ ∃(x :word8 list) (y :num). asm_fetch_aux (pc + i) code = SOME (Asm (Asmi (Inst (Skip :α inst) :α asm)) x y)
asm_fetch_aux_eq_typed=∀(pc :num) (code :α sec list). ∃(k :num). asm_fetch_aux (pc + k) code = asm_fetch_aux (adjust_pc pc code) (filter_skip code) ∧ all_skips pc code k
sec_ends_with_label_filter_skip_typed=∀(code :α sec list). EVERY (sec_ends_with_label :α sec -> bool) code ⇒ EVERY (sec_ends_with_label :α sec -> bool) (filter_skip code)
filter_skip_semantics_typed=∀(s :(α, β, γ) labSem$state) (t :(α, β, γ) labSem$state). t.pc = (0 :num) ∧ ¬t.failed ∧ (∃(scompile :β -> α sec list -> (word8 list # β) option). s = t with <|code := filter_skip t.code; compile_oracle := (λ((a :β),(b :α sec list)). (a,filter_skip b)) ∘ t.compile_oracle; compile := scompile|> ∧ t.compile = (λ(c :β) (p :α sec list). scompile c (filter_skip p))) ∧ ¬t.failed ⇒ (semantics s :behaviour) = (semantics t :behaviour)
share_mem_op_FFI_final_filter_correct_typed=all_skips (t1 :(α, β, γ) labSem$state).pc t1.code (k :num) ∧ t1.clock ≠ (0 :num) ∧ t1.compile = (λ(c :β) (p :α sec list). (s1compile :β -> α sec list -> (word8 list # β) option) c (filter_skip p)) ∧ ¬t1.failed ∧ share_mem_op (m :memop) (r :num) (a :α addr) (t1 with <|pc := adjust_pc t1.pc t1.code; code := filter_skip t1.code; compile := s1compile; compile_oracle := (λ(n :num). (λ((a :β),(b :α sec list)). (a,filter_skip b)) (t1.compile_oracle n :β # α sec list))|>) = SOME ((FFI_final (f :final_event) :γ ffi_result),(s :(α, β, γ) labSem$state)) ⇒ ∃(s2 :(α, β, γ) labSem$state). share_mem_op m r a (t1 with pc := k + t1.pc) = SOME ((FFI_final f :γ ffi_result),s2) ∧ s.ffi = s2.ffi
share_mem_op_FFI_return_filter_correct_typed=all_skips (t1 :(α, β, γ) labSem$state).pc t1.code (k :num) ∧ t1.clock ≠ (0 :num) ∧ t1.compile = (λ(c :β) (p :α sec list). (s1compile :β -> α sec list -> (word8 list # β) option) c (filter_skip p)) ∧ ¬t1.failed ∧ share_mem_op (m :memop) (r :num) (a :α addr) (t1 with <|pc := adjust_pc t1.pc t1.code; code := filter_skip t1.code; compile := s1compile; compile_oracle := (λ(n :num). (λ((a :β),(b :α sec list)). (a,filter_skip b)) (t1.compile_oracle n :β # α sec list))|>) = SOME (FFI_return (f :γ ffi_state) (l :word8 list),(s :(α, β, γ) labSem$state)) ⇒ ∃(s2 :(α, β, γ) labSem$state). ∀(k' :num). share_mem_op m r a (t1 with pc := k + t1.pc) = SOME (FFI_return f l,s2) ∧ state_rel s s2 ∧ ¬s.failed ∧ ¬s2.failed ∧ share_mem_op m r a (t1 with <|pc := k + t1.pc; clock := k' + t1.clock|>) = SOME (FFI_return f l,s2 with clock := k' + s2.clock)
share_mem_op_NONE_filter_correct_typed=all_skips (t1 :(α, β, γ) labSem$state).pc t1.code (k :num) ∧ share_mem_op (m :memop) (r :num) (a :α addr) (t1 with <|pc := adjust_pc t1.pc t1.code; code := filter_skip t1.code; compile := (arb_compile :β -> α sec list -> (word8 list # β) option); compile_oracle := (arb_oracle :num -> β # α sec list)|>) = (NONE :(γ ffi_result # (α, β, γ) labSem$state) option) ⇒ share_mem_op m r a (t1 with pc := k + t1.pc) = (NONE :(γ ffi_result # (α, β, γ) labSem$state) option)
state_rel_def_typed=∀(s1 :(α, γ, 'ffi) labSem$state) (t1 :(α, γ, 'ffi) labSem$state). state_rel s1 t1 ⇔ (∃(s1compile :γ -> α sec list -> (word8 list # γ) option). s1 = t1 with <|code := filter_skip t1.code; pc := adjust_pc t1.pc t1.code; compile_oracle := (λ(n :num). (λ((a :γ),(b :α sec list)). (a,filter_skip b)) (t1.compile_oracle n :γ # α sec list)); compile := s1compile|> ∧ t1.compile = (λ(c :γ) (p :α sec list). s1compile c (filter_skip p))) ∧ ¬t1.failed
