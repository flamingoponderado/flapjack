load "bossLib";
load "preamble";
load "labPropsTheory";
open bossLib HolKernel Parse preamble labPropsTheory lab_to_targetTheory labSemTheory asmTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun captureTypes label th = (print(label ^ "="); app (fn v =>
 print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";"))
 (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _ = capture "extract_labels_def" extract_labels_def;
val _ = captureTypes "extract_labels_def_types" extract_labels_def;
val _ = capture "extract_labels_append" extract_labels_append;
val _ = captureTypes "extract_labels_append_types" extract_labels_append;
val _ = capture "labs_of_def" labs_of_def;
val _ = captureTypes "labs_of_def_types" labs_of_def;
val _ = capture "line_get_labels_def" line_get_labels_def;
val _ = captureTypes "line_get_labels_def_types" line_get_labels_def;
val _ = capture "sec_get_labels_def" sec_get_labels_def;
val _ = captureTypes "sec_get_labels_def_types" sec_get_labels_def;
val _ = capture "get_labels_def" get_labels_def;
val _ = captureTypes "get_labels_def_types" get_labels_def;
val _ = capture "get_labels_cons" get_labels_cons;
