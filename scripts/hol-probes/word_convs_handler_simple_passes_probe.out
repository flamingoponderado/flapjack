goodHandlers_instSelectExp_typed=∀(n :num) (a :α asm_config) (b :num) (c :num) (exp :α exp). word_good_handlers n (inst_select_exp a b c exp)
goodHandlers_instSelectExp_proved=T
goodHandlers_instSelectExp_hypotheses=0
goodHandlers_instSelect_typed=∀(n :num) (ac :α asm_config) (v :num) (ps :α prog). word_good_handlers n (inst_select ac v ps) ⇔ word_good_handlers n ps
goodHandlers_instSelect_proved=T
goodHandlers_instSelect_hypotheses=0
goodHandlers_threeToTwoRegProg_typed=∀(n :num) (b :bool) (ps :α prog). word_good_handlers n (three_to_two_reg_prog b ps) ⇔ word_good_handlers n ps
