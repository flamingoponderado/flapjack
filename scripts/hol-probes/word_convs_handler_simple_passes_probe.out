goodHandlers_simpSeq_hypotheses=0
goodHandlers_seqAssocRight_typed=∀(qs :α prog) (ps :α prog) (n :num). word_good_handlers n ps ∧ word_good_handlers n qs ⇒ word_good_handlers n (Seq_assoc_right ps qs)
