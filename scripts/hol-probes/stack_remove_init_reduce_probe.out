init_reduce_definition=∀gen_gc jump off k code bitmaps data_sp coracle s. init_reduce gen_gc jump off k code bitmaps data_sp coracle s = (let heap_ptr = theWord s.regs⟨k + 2⟩; bitmap_ptr = theWord s.regs⟨3⟩ ≪ shift (:α); stack_ptr = theWord s.regs⟨k⟩; base_ptr = theWord s.regs⟨k + 1⟩; heap_sp = w2n (base_ptr − heap_ptr) DIV (dimindex (:α) DIV 8) − LENGTH store_list; stack_sp = w2n (stack_ptr − base_ptr) DIV (dimindex (:α) DIV 8) in s with <|use_stack := T; use_store := T; use_alloc := F; mdomain := addresses heap_ptr heap_sp; bitmaps := bitmaps; code := code; compile := (λc p. s.compile c (MAP (prog_comp jump off k) p)); compile_oracle := coracle; data_buffer := <|buffer := []; position := bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps); space_left := data_sp|>; stack_space := stack_sp; stack := read_mem base_ptr s.memory (stack_sp + 1); store := FEMPTY |++ MAP (λn. case store_init gen_gc k n of INL w => (n,Word w) | INR i => (n,s.regs⟨i⟩)) (CurrHeap::store_list)|>)
init_reduce_type=:bool -> bool -> α word # α word -> num -> α stackLang$prog sptree$num_map -> α word list -> num -> (num -> β # (num # α stackLang$prog) list # α word list) -> (α, β, γ) stackSem$state -> (α, β, γ) stackSem$state
init_reduce_hypotheses=0
init_reduce_stack_space_statement=∀s8 off k jump gen_gc data_sp coracle code bitmaps. (init_reduce gen_gc jump off k code bitmaps data_sp coracle s8).stack_space ≤ LENGTH (init_reduce gen_gc jump off k code bitmaps data_sp coracle s8).stack
init_reduce_stack_space_hypotheses=0
init_reduce_stack_space_proved=T
