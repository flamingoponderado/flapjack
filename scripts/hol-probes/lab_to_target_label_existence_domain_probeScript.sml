load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _ = capture "line_labs_exist_get_labels" line_labs_exist_get_labels;
val _ = types "line_labs_exist_get_labels_types" line_labs_exist_get_labels;
val _ = capture "sec_labs_exist_get_labels" sec_labs_exist_get_labels;
val _ = types "sec_labs_exist_get_labels_types" sec_labs_exist_get_labels;
val _ = capture "all_labs_exist_get_labels" all_labs_exist_get_labels;
val _ = types "all_labs_exist_get_labels_types" all_labs_exist_get_labels;
val _ = show_types := false;
fun observe label q = (print(label ^ "=");print_term(rconc((QCONV(SIMP_CONV(srw_ss()) [line_labs_exist_def,sec_labs_exist_def,line_get_labels_def,sec_get_labels_def,get_labels_def,labs_of_def,labs_domain_def,lab_lookup_def,pred_setTheory.SUBSET_DEF,pred_setTheory.GSPECIFICATION,FORALL_PROD,EXISTS_PROD]) THENC EVAL THENC QCONV(SIMP_CONV(srw_ss())[sptreeTheory.lookup_insert,sptreeTheory.lookup_def,pred_setTheory.SUBSET_DEF,pred_setTheory.GSPECIFICATION,FORALL_PROD,EXISTS_PROD]) THENC EVAL THENC QCONV(SIMP_CONV(srw_ss())[FORALL_PROD,EXISTS_PROD,sptreeTheory.lookup_insert,sptreeTheory.lookup_def]) THENC EVAL) q));print "\n");
val labs=``sptree$insert 3 (sptree$insert 4 F sptree$LN) sptree$LN:bool sptree$num_map sptree$num_map``;
val jump=``LabAsm(Jump(Lab 3 4)) 99w [] 7:8 labLang$line``;
val lines=``[Label 99 77 42;Asm(Asmi(Inst Skip)) [9w] 3;^jump;LabAsm(Call(Lab 88 99)) 3w [] 17]:8 labLang$line list``;
val code=``[Section 7 ^lines;Section 8 [LabAsm(LocValue 2 (Lab 3 4)) 0w [7w;8w] 29];Section 9 []]:8 labLang$sec list``;
val _=observe "line_present_false_value" ``line_labs_exist ^labs ^jump /\ line_get_labels ^jump SUBSET labs_domain ^labs``;
val _=observe "line_missing_outer" ``~line_labs_exist ^labs (LabAsm(Jump(Lab 5 4)) 99w [] 7:8 labLang$line) /\ ~(line_get_labels(LabAsm(Jump(Lab 5 4)) 99w [] 7:8 labLang$line) SUBSET labs_domain ^labs)``;
val _=observe "line_missing_inner" ``~line_labs_exist ^labs (LabAsm(LocValue 2 (Lab 3 5)) 99w [] 7:8 labLang$line) /\ ~(line_get_labels(LabAsm(LocValue 2 (Lab 3 5)) 99w [] 7:8 labLang$line) SUBSET labs_domain ^labs)``;
val _=observe "call_nonreference_empty_domain" ``line_labs_exist (LN:bool sptree$num_map sptree$num_map) (LabAsm(Call(Lab 88 99)) 99w [] 7:8 labLang$line) /\ line_get_labels(LabAsm(Call(Lab 88 99)) 99w [] 7:8 labLang$line) SUBSET labs_domain (LN:bool sptree$num_map sptree$num_map)``;
val _=observe "section_full_extraction" ``sec_labs_exist ^labs (Section 7 ^lines) /\ sec_get_labels(Section 7 ^lines) = {(3,4)} /\ sec_get_labels(Section 7 ^lines) SUBSET labs_domain ^labs``;
val _=observe "code_full_extraction" ``all_labs_exist ^labs ^code /\ get_labels ^code = {(3,4)} /\ get_labels ^code SUBSET labs_domain ^labs``;
val _=observe "empty_inner_map_failure" ``~all_labs_exist (sptree$insert 3 (LN:bool sptree$num_map) LN) ^code /\ ~(get_labels ^code SUBSET labs_domain (sptree$insert 3 (LN:bool sptree$num_map) LN))``;
val _=observe "zero_label_reference" ``let ls=sptree$insert 3 (sptree$insert 0 F LN) LN in let l=LabAsm(Jump(Lab 3 0)) 99w [] 7:8 labLang$line in line_labs_exist ls l /\ line_get_labels l SUBSET labs_domain ls``;
val _=observe "unconstrained_nonreferences" ``line_labs_exist ^labs (Label 88 99 42:8 labLang$line) /\ line_get_labels(Label 88 99 42:8 labLang$line) SUBSET labs_domain ^labs /\ line_labs_exist ^labs (Asm(Asmi(Inst Skip)) [9w] 3:8 labLang$line) /\ line_get_labels(Asm(Asmi(Inst Skip)) [9w] 3:8 labLang$line) SUBSET labs_domain ^labs``;
val _=observe "empty_width1" ``all_labs_exist (LN:bool sptree$num_map sptree$num_map) ([]:1 labLang$sec list) /\ get_labels ([]:1 labLang$sec list) SUBSET labs_domain (LN:bool sptree$num_map sptree$num_map)``;
