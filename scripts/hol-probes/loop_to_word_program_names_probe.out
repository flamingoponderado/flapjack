first_compile_prog_all_distinct_source_replay=⊢ ∀prog.
    ALL_DISTINCT (MAP FST prog) ⇒ ALL_DISTINCT (MAP FST (compile_prog prog))
first_compile_all_distinct_source_replay=⊢ ∀prog. ALL_DISTINCT (MAP FST prog) ⇒ ALL_DISTINCT (MAP FST (compile prog))
mem_prog_mem_compile_prog_source_replay=⊢ ∀prog name params body.
    MEM (name,params,body) prog ⇒
    MEM (name,LENGTH params + 1,comp_func name params body)
      (compile_prog prog)
lookup_prog_some_lookup_compile_prog_source_replay=⊢ ∀prog name params body.
    lookup name (fromAList prog) = SOME (params,body) ⇒
    lookup name (fromAList (compile_prog prog)) =
    SOME (LENGTH params + 1,comp_func name params body)
