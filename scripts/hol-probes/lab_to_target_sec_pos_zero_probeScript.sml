load "bossLib";
load "preamble";
load "lab_to_targetProofTheory";
open bossLib HolKernel Parse preamble lab_to_targetProofTheory lab_to_targetTheory labLangTheory labPropsTheory;
val _ = show_types := true;
fun capture label th = (print(label ^ "="); print_term(concl th); print "\n");
fun types label th = (print(label ^ "="); app (fn v => print(term_to_string v ^ ":" ^ type_to_string(type_of v) ^ ";")) (fst(strip_forall(concl th)) @ free_vars(concl th)); print "\n");
val _=capture "sec_pos_val_0" sec_pos_val_0;
val _=types "sec_pos_val_0_types" sec_pos_val_0;
val _=print "sec_pos_val_0_hypotheses=";
val _=print(Int.toString(length(hyp sec_pos_val_0)) ^ "\n");
val _=show_types := false;
fun observe label q = (print(label ^ "="); print_term(rconc(EVAL q)); print "\n");
val _=observe "empty_guard_false" ``EVERY is_Label ([]:8 line list) /\ sec_pos_val 0 7 ([]:8 line list) = NONE``;
val _=observe "all_labels_none" ``EVERY is_Label ([Label 1 7 0;Label 1 8 0]:8 line list) /\ sec_pos_val 0 7 ([Label 1 7 0;Label 1 8 0]:8 line list) = NONE``;
val _=observe "zero_labels_asm" ``~EVERY is_Label ([Label 1 7 0;Label 1 8 0;Asm (Asmi (Inst Skip)) [0w] 99]:8 line list) /\ EVERY label_zero [Label 1 7 0;Label 1 8 0;Asm (Asmi (Inst Skip)) [0w] 99] /\ sec_pos_val 0 7 [Label 1 7 0;Label 1 8 0;Asm (Asmi (Inst Skip)) [0w] 99] = SOME 7``;
val _=observe "zero_labels_labasm" ``sec_pos_val 0 7 ([Label 1 7 0;LabAsm Halt 0w [] 99]:8 line list) = SOME 7``;
val _=observe "asm_unrestricted_annotation" ``sec_pos_val 0 7 ([Asm (Asmi (Inst Skip)) [] 1208925819614629174706176]:8 line list) = SOME 7``;
val _=observe "zero_guard_needed" ``~EVERY label_zero ([Label 1 7 1;Asm (Asmi (Inst Skip)) [] 0]:8 line list) /\ sec_pos_val 0 7 [Label 1 7 1;Asm (Asmi (Inst Skip)) [] 0] = SOME 8``;
val _=observe "physical_not_annotation" ``sec_pos_val 0 7 ([Label 1 7 2;Asm (Asmi (Inst Skip)) [] 0]:8 line list) = SOME 8``;
val _=observe "width1_large_pos" ``sec_pos_val 0 1208925819614629174706176 ([Label 1 7 0;Asm (Asmi (Inst Skip)) [] 99]:1 line list) = SOME 1208925819614629174706176``;
val _=observe "width80_large_pos" ``sec_pos_val 0 1208925819614629174706176 ([Label 1 7 0;LabAsm Halt 0w [] 99]:80 line list) = SOME 1208925819614629174706176``;
