address_type=:address
temp_in1_type=:store_name
temp_in2_type=:store_name
temp_out_type=:store_name
div_location_type=:num
seq_temp_type=:num -> num -> α prog -> α prog
seq_temp_imm_type=:num -> α reg_imm -> α prog -> α prog
seq_temp_imm_not_type=:num -> α reg_imm -> α prog -> α prog
load_regs_type=:num list -> α prog -> α prog
save_regs_type=:num list -> α prog
seq_index_type=:num -> num -> address -> α prog -> α prog
div_code_type=:num -> num -> num -> num -> num -> num -> num -> α prog
seq_temp=Seq (Assign (7 :num) (Lookup (Temp (33w :word5)) :64 exp) :64 prog) (Skip :64 prog)
imm_not_reg=Seq (Assign (4 :num) (Lookup (Temp (33w :word5)) :64 exp) :64 prog) (Seq (Assign (4 :num) (Op Xor [(Var (4 :num) :64 exp); (Const (0xFFFFFFFFFFFFFFFFw :word64) :64 exp)]) :64 prog) (Skip :64 prog))
imm_not_word=Seq (Assign (4 :num) (Const (0xFFFFFFFFFFFFFFFAw :word64) :64 exp) :64 prog) (Skip :64 prog)
load_regs=Seq (Get (2 :num) (Temp (0w :word5)) :64 prog) (Seq (Get (35 :num) (Temp (33w :word5)) :64 prog) (Skip :64 prog))
save_regs=Seq (Set (Temp (0w :word5)) (Var (2 :num) :64 exp) :64 prog) (Seq (Set (Temp (33w :word5)) (Var (35 :num) :64 exp) :64 prog) (Skip :64 prog))
seq_index_32=Seq (Assign (3 :num) (Op Add [(Lookup (Temp (30w :word5)) :32 exp); ShiftN Lsl (Lookup (Temp (33w :word5)) :32 exp) (2 :num)]) :32 prog) (Skip :32 prog)
seq_index_64=Seq (Assign (3 :num) (Op Add [(Lookup (Temp (29w :word5)) :64 exp); ShiftN Lsl (Lookup (Temp (33w :word5)) :64 exp) (3 :num)]) :64 prog) (Skip :64 prog)
div_code=MustTerminate (Seq (Call (SOME ([(3 :num)],(⦕ 0 ⦖,(LN :sptree$num_set)),(Skip :64 prog),(1 :num),(2 :num))) (SOME (23 :num)) [(5 :num); (6 :num); (7 :num)] (NONE :(num # 64 prog # num # num) option) :64 prog) (Assign (4 :num) (Lookup (Temp (28w :word5)) :64 exp) :64 prog))
