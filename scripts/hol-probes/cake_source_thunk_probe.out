dest_definition=dest_thunk [Loc (b :bool) (n :num)] (st :v store_v list) = (case store_lookup n st of (NONE :v store_v option) => BadRef | SOME (Refv v7) => NotThunk | SOME (W8array v8 :v store_v) => NotThunk | SOME (Varray v9) => NotThunk | SOME (Thunk Evaluated v) => if b then BadRef else IsThunk Evaluated v | SOME (Thunk NotEvaluated v) => if b then BadRef else IsThunk NotEvaluated v) ∧ dest_thunk ([] :v list) st = NotThunk ∧ dest_thunk (Litv (v12 :lit)::(v5 :v list)) st = NotThunk ∧ dest_thunk (Conv (v13 :stamp option) (v14 :v list)::v5) st = NotThunk ∧ dest_thunk (Closure (v15 :v sem_env) (v16 :mlstring) (v17 :exp)::v5) st = NotThunk ∧ dest_thunk (Recclosure (v18 :v sem_env) (v19 :(mlstring # mlstring # exp) list) (v20 :mlstring)::v5) st = NotThunk ∧ dest_thunk (Loc (v21 :bool) (v22 :num)::(v40 :v)::(v41 :v list)) st = NotThunk ∧ dest_thunk (Vectorv (v23 :v list)::v5) st = NotThunk ∧ dest_thunk (Env (v24 :v sem_env) (v25 :num # num)::v5) st = NotThunk
update_definition=update_thunk [Loc F (n :num)] (st :v store_v list) [(v :v)] = (case dest_thunk [v] st of BadRef => (NONE :v store_v list option) | NotThunk => store_assign n (Thunk Evaluated v) st | IsThunk v3 v4 => (NONE :v store_v list option)) ∧ update_thunk ([] :v list) st (v1 :v list) = (NONE :v store_v list option) ∧ update_thunk (Litv (v12 :lit)::(v7 :v list)) st v1 = (NONE :v store_v list option) ∧ update_thunk (Conv (v13 :stamp option) (v14 :v list)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk (Closure (v15 :v sem_env) (v16 :mlstring) (v17 :exp)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk (Recclosure (v18 :v sem_env) (v19 :(mlstring # mlstring # exp) list) (v20 :mlstring)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk (Loc T (v22 :num)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk [Loc F v22] st ([] :v list) = (NONE :v store_v list option) ∧ update_thunk [Loc F v22] st ((v56 :v)::(v60 :v)::(v61 :v list)) = (NONE :v store_v list option) ∧ update_thunk (Loc F v22::(v50 :v)::(v51 :v list)) st v1 = (NONE :v store_v list option) ∧ update_thunk (Vectorv (v23 :v list)::v7) st v1 = (NONE :v store_v list option) ∧ update_thunk (Env (v24 :v sem_env) (v25 :num # num)::v7) st v1 = (NONE :v store_v list option)
bad_update_definition=∀(m :thunk_mode) (v :v) (st :v store_v list). bad_thunk_update m v st ⇔ m = Evaluated ∧ dest_thunk [v] st ≠ NotThunk
thunk_op_definition=∀(s :v store_v list) (t :'ffi ffi_state) (th_op :thunk_op) (vs :v list). (thunk_op (s,t) th_op vs :((v store_v list # 'ffi ffi_state) # (v, α) result) option) = case (th_op,vs) of (v3,([] :v list)) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (AllocThunk m,[v]) => if bad_thunk_update m v s then (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) else (let ((s' :v store_v list),(n :num)) = store_alloc (Thunk m v) s in SOME ((s',t),(Rval (Loc F n) :(v, α) result))) | (AllocThunk m,v::v15::v16) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',[v]) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',Litv v35::v'::v20) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',Conv v36 v37::v'::v20) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',Closure v38 v39 v40::v'::v20) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',Recclosure v41 v42 v43::v'::v20) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',[Loc T lnum; v']) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',[Loc F lnum; v']) => if bad_thunk_update m' v' s then (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) else (case store_assign lnum (Thunk m' v') s of (NONE :v store_v list option) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | SOME s' => SOME ((s',t),(Rval (Conv (NONE :stamp option) ([] :v list)) :(v, α) result))) | (UpdateThunk m',Loc v44 lnum::v'::v51::v52) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',Vectorv v46::v'::v20) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (UpdateThunk m',Env v47 v48::v'::v20) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option) | (ForceThunk,v::v8) => (NONE :((v store_v list # 'ffi ffi_state) # (v, α) result) option)
do_opapp_definition=∀(vs :v list). do_opapp vs = case vs of ([] :v list) => (NONE :(v sem_env # exp) option) | [v4] => (NONE :(v sem_env # exp) option) | [Litv v28; v] => (NONE :(v sem_env # exp) option) | [Conv v29 v30; v] => (NONE :(v sem_env # exp) option) | [Closure env n e; v] => SOME (env with v := nsBind n v env.v,e) | [Recclosure env' funs n'; v] => if ALL_DISTINCT (MAP (λ((f :mlstring),(x :mlstring),(e :exp)). f) funs) then case find_recfun n' funs of (NONE :(mlstring # exp) option) => (NONE :(v sem_env # exp) option) | SOME (n,e) => SOME (env' with v := nsBind n v (build_rec_env funs env' env'.v),e) else (NONE :(v sem_env # exp) option) | [Loc v37 v38; v] => (NONE :(v sem_env # exp) option) | [Vectorv v39; v] => (NONE :(v sem_env # exp) option) | [Env v40 v41; v] => (NONE :(v sem_env # exp) option) | v4::v::v12::v13 => (NONE :(v sem_env # exp) option)
is_thunk_type=:thunk_mode -> v -> dest_thunk_ret
thunk_op_type=:v store_v list # α ffi_state -> thunk_op -> v list -> ((v store_v list # α ffi_state) # (v, β) result) option
dest_type=:v list -> v store_v list -> dest_thunk_ret
good=IsThunk NotEvaluated (Litv (IntLit (1 :int)))
bad=BadRef
ordinary=NotThunk
update=SOME [Thunk Evaluated (Litv (IntLit (2 :int)))]
nested=(NONE :v store_v list option)
operation=SOME [Thunk Evaluated (Litv (IntLit (2 :int)))]
xor_tail=SOME [(6w :word8); (7w :word8)]
xor_short=(NONE :word8 list option)
