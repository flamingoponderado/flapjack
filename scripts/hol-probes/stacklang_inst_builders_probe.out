While_expanded=λcmp r ri c. Loop (If cmp r ri c (Break 0))
move_expanded=λdest src. Inst (Arith (Binop Or dest src (Reg src)))
sub_inst_expanded=λr1 r2. Inst (Arith (Binop Sub r1 r1 (Reg r2)))
add_inst_expanded=λr1 r2. Inst (Arith (Binop Add r1 r1 (Reg r2)))
add_bytes_in_word_inst_expanded=λr1. Inst (Arith (Binop Add r1 r1 (Imm bytes_in_word)))
