While_term=λcmp r ri c. While cmp r ri c
While_type=:cmp -> num -> α reg_imm -> α prog -> α prog
move_term=λdest src. move dest src
move_type=:num -> num -> α prog
sub_inst_term=λr1 r2. sub_inst r1 r2
sub_inst_type=:num -> num -> α prog
add_inst_term=λr1 r2. add_inst r1 r2
add_inst_type=:num -> num -> α prog
add_bytes_in_word_inst_term=λr1. add_bytes_in_word_inst r1
add_bytes_in_word_inst_type=:num -> α prog
list_Seq_full_def=list_Seq [] = Skip ∧ (∀x. list_Seq [x] = x) ∧ ∀y xs x. list_Seq (x::y::xs) = Seq x (list_Seq (y::xs))
list_Seq_type=:α prog list -> α prog
move_1=move 1234 42
sub_inst_1=sub_inst 1234 42
add_inst_1=add_inst 1234 42
bytes_1=Inst (Arith (Binop Add 1234 1234 (Imm 0w)))
while_1=While NotEqual 1234 (Imm 1w) (Halt 42)
seq_1_0=Skip
seq_1_1=Halt 42
seq_1_2=Seq (Halt 42) Skip
seq_1_3=Seq (Halt 42) (Seq Skip (Break 7))
