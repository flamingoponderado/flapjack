sub_inst_8=sub_inst 1234 42
add_inst_8=add_inst 1234 42
bytes_8=add_1_inst 1234
while_8=While NotEqual 1234 (Imm 1w) (Halt 42)
seq_8_0=Skip
seq_8_1=Halt 42
seq_8_2=Seq (Halt 42) Skip
seq_8_3=Seq (Halt 42) (Seq Skip (Break 7))
