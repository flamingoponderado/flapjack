single_stack_alloc_full_def=∀jump k n. single_stack_alloc jump k n = if jump then Seq (Inst (Arith (Binop Sub k k (Imm (word_offset n))))) (JumpLower k (k + 1) stack_err_lab) else Seq (Inst (Arith (Binop Sub k k (Imm (word_offset n))))) (If Lower k (Reg (k + 1)) (halt_inst 2w) Skip)
single_stack_alloc_type=:bool -> num -> num -> α prog
stack_alloc_full_def=∀n k jump. stack_alloc jump k n = if n = 0 then Skip else if n ≤ max_stack_alloc then single_stack_alloc jump k n else Seq (single_stack_alloc jump k max_stack_alloc) (stack_alloc jump k (n − max_stack_alloc))
stack_alloc_type=:bool -> num -> num -> α prog
