foldl_Eapp_aux_def_typed=(∀(acc :(α, MMLnonT, locs) parsetree). foldl_Eapp_aux acc ([] :(α, MMLnonT, locs) parsetree list) = acc) ∧ ∀(acc :(α, MMLnonT, locs) parsetree) (x :(α, MMLnonT, locs) parsetree) (xs :(α, MMLnonT, locs) parsetree list). foldl_Eapp_aux acc (x::xs) = foldl_Eapp_aux (mkNd_fo (mkNT nEapp) [acc; x]) xs
foldl_DType_aux_def_typed=(∀(acc :(α, MMLnonT, locs) parsetree). foldl_DType_aux acc ([] :(α, MMLnonT, locs) parsetree list) = acc) ∧ ∀(acc :(α, MMLnonT, locs) parsetree) (x :(α, MMLnonT, locs) parsetree) (xs :(α, MMLnonT, locs) parsetree list). foldl_DType_aux acc (x::xs) = foldl_DType_aux (mkNd_fo (mkNT nDType) [acc; x]) xs
foldl_Eapp_fo_def_typed=foldl_Eapp_fo ([] :(α, MMLnonT, locs) parsetree list) = ([] :(α, MMLnonT, locs) parsetree list) ∧ ∀(h :(α, MMLnonT, locs) parsetree) (t :(α, MMLnonT, locs) parsetree list). foldl_Eapp_fo (h::t) = [foldl_Eapp_aux (mkNd_fo (mkNT nEapp) [h]) t]
foldl_DType_fo_def_typed=foldl_DType_fo ([] :(α, MMLnonT, locs) parsetree list) = ([] :(α, MMLnonT, locs) parsetree list) ∧ ∀(h :(α, MMLnonT, locs) parsetree) (t :(α, MMLnonT, locs) parsetree list). foldl_DType_fo (h::t) = [foldl_DType_aux (mkNd_fo (mkNT nDType) [h]) t]
ptPapply0_fo_def_typed=(∀(c :(α, MMLnonT, locs) parsetree). ptPapply0_fo c ([] :(α, MMLnonT, locs) parsetree list) = ([] :(α, MMLnonT, locs) parsetree list)) ∧ (∀(pb_pt :(α, MMLnonT, locs) parsetree) (c :(α, MMLnonT, locs) parsetree). ptPapply0_fo c [pb_pt] = [mkNd_fo (mkNT nPapp) [c; pb_pt]]) ∧ ∀(v5 :(α, MMLnonT, locs) parsetree list) (v4 :(α, MMLnonT, locs) parsetree) (pb :(α, MMLnonT, locs) parsetree) (c :(α, MMLnonT, locs) parsetree). ptPapply0_fo c (pb::v4::v5) = ptPapply0_fo (mkNd_fo (mkNT nPConApp) [c; pb]) (v4::v5)
ptPapply_fo_def_typed=ptPapply_fo ([] :(α, MMLnonT, locs) parsetree list) = ([] :(α, MMLnonT, locs) parsetree list) ∧ ptPapply_fo [(v0 :(α, MMLnonT, locs) parsetree)] = ([] :(α, MMLnonT, locs) parsetree list) ∧ ptPapply_fo ((c :(α, MMLnonT, locs) parsetree)::(v2 :(α, MMLnonT, locs) parsetree)::(v3 :(α, MMLnonT, locs) parsetree list)) = ptPapply0_fo (mkNd_fo (mkNT nPConApp) [c]) (v2::v3)
eval_fold_def_typed=∀(vs :α list list). eval_fold vs = FLAT vs
in_set_def_typed=(∀(x :α). in_set x ([] :α list) ⇔ F) ∧ ∀(x :α) (y :α) (ys :α list). in_set x (y::ys) ⇔ x = y ∨ in_set x ys
eval_combine_def_typed=∀(s :α + α). eval_combine s = case s of (INL x :α + α) => x | (INR y :α + α) => y
merge_err_option_def_typed=∀(eo :α option) (ox :α option). merge_err_option eo ox = case (eo,ox) of ((NONE :α option),(NONE :α option)) => (NONE :α option) | (SOME x,(NONE :α option)) => SOME x | (v,SOME v2) => SOME v2
map_ptree_loc_def_typed=map_ptree_loc ([] :(β, γ, α) parsetree list) = ([] :α list) ∧ ∀(x :(β, γ, α) parsetree) (ts :(β, γ, α) parsetree list). map_ptree_loc (x::ts) = ptree_loc x::map_ptree_loc ts
map_ptree_loc_thm_typed=MAP (ptree_loc :(β, γ, α) parsetree -> α) (l :(β, γ, α) parsetree list) = map_ptree_loc l
poplist_aux_def_typed=(∀(t :α option list) (h :α) (acc :α list). poplist_aux acc (SOME h::t) = poplist_aux (h::acc) t) ∧ (∀(t :α option list) (acc :α list). poplist_aux acc ((NONE :α option)::t) = (acc,t)) ∧ ∀(acc :α list). poplist_aux acc ([] :α option list) = (acc,([] :α option list))
poplistval_def_typed=∀(l :α list option list). poplistval l = (let ((values :α list list),(rest :α list option list)) = poplist_aux ([] :α list list) l in SOME (eval_fold values)::rest)
eval_token_longid_check_def_typed=(eval_token_longid_check TokenLongid_tail_nonempty ((str :α),(s :mlstring)) ⇔ s ≠ «») ∧ (eval_token_longid_check TokenLongid_tail_nonempty_head_alpha_not_upper (str,s) ⇔ s ≠ «» ∧ (isAlpha (strsub s (0 :num)) ⇒ ¬isUpper (strsub s (0 :num)))) ∧ (eval_token_longid_check TokenLongid_ctor_upper_initial (str,s) ⇔ s ≠ «» ∧ isAlpha (strsub s (0 :num)) ∧ isUpper (strsub s (0 :num)))
