ConditionTest_def_typed=∀(cond :word4) (N :bool) (Z :bool) (C :bool) (V :bool). ConditionTest (cond,N,Z,C,V) ⇔ (let (result :bool) = case (((3 :num) >< (1 :num)) cond :word3) of (0w :word3) => Z | (1w :word3) => C | (2w :word3) => N | (3w :word3) => V | (4w :word3) => C ∧ ¬Z | (5w :word3) => N ⇔ V | (6w :word3) => (N ⇔ V) ∧ ¬Z | (7w :word3) => T | v => (ARB :bool) in if word_bit (0 :num) cond ∧ cond ≠ (15w :word4) then ¬result else result)
