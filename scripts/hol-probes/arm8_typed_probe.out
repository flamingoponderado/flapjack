dfn_primeMoveImmediateProcState_def_typed=∀(field :PSTATEField) (operand :word4). dfn'MoveImmediateProcState (field,operand) = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "MoveImmediateProcState") state :unit # arm8_state))
