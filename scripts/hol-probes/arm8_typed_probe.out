dfn_primeConditionalSelect_def_typed=∀(sf :'N word) (else_inv :bool) (else_inc :bool) (cond :word4) (m :word5) (n :word5) (d :word5). dfn'ConditionalSelect (sf,else_inv,else_inc,cond,m,n,d) = (λ(state :arm8_state). (let (s :'N word # arm8_state) = if ConditionHolds cond state then ((X n state :'N word),state) else (let (s3 :'N word) = (X m state :'N word); (s0 :'N word) = if else_inv then ¬s3 else s3 in (if else_inc then s0 + (1w :'N word) else s0,state)) in write'X (FST s,d) (SND s)))
AddWithCarry_def_typed=∀(x :'N word) (y :'N word) (carry_in :bool). AddWithCarry (x,y,carry_in) = (let (unsigned_sum :num) = w2n x + w2n y + if carry_in then (1 :num) else (0 :num); (result :'N word) = (n2w unsigned_sum :'N word) in (result,word_msb result,result = (0w :'N word),w2n result ≠ unsigned_sum,w2i result ≠ w2i x + w2i y + if carry_in then (1 :int) else (0 :int)))
dfn_primeConditionalCompareRegister_def_typed=∀(sf :'N word) (sub_op :bool) (cond :word4) (nzcv :bool # bool # bool # bool) (m :word5) (n :word5). dfn'ConditionalCompareRegister (sf,sub_op,cond,nzcv,m,n) = (λ(state :arm8_state). (let (v0 :'N word) = (X m state :'N word) in if ConditionHolds cond state then (let ((operand2 :'N word),(carry_in :bool)) = if sub_op then (¬v0,T) else (v0,F); ((_ :'N word),(flags :bool # bool # bool # bool)) = AddWithCarry ((X n state :'N word),operand2,carry_in) in SetTheFlags (T,flags) state) else SetTheFlags (T,nzcv) state))
