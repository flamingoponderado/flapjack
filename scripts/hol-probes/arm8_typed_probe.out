Aligned_def_typed=∀(w :'N word) (n :num). Aligned (w,n) ⇔ w = Align (w,n)
CheckAlignment_def_typed=∀(address :word64) (size :num) (acctype :AccType) (iswrite :bool). CheckAlignment (address,size,acctype,iswrite) = (λ(state :arm8_state). if ¬Aligned (address,size) ∧ (acctype = AccType_ATOMIC ∨ acctype = AccType_ORDERED ∨ (SCTLR state).A) then SND (raise'exception ALIGNMENT_FAULT state :unit # arm8_state) else state)
ByteList_def_typed=∀(l :bool list). ByteList l = case l of ([] :bool list) => ([] :bool list list) | [b0] => [[b0]] | [b0; b1] => [[b0; b1]] | [b0; b1; b2] => [[b0; b1; b2]] | [b0; b1; b2; b3] => [[b0; b1; b2; b3]] | [b0; b1; b2; b3; b4] => [[b0; b1; b2; b3; b4]] | [b0; b1; b2; b3; b4; b5] => [[b0; b1; b2; b3; b4; b5]] | [b0; b1; b2; b3; b4; b5; b6] => [[b0; b1; b2; b3; b4; b5; b6]] | b0::b1::b2::b3::b4::b5::b6::v7::rest => [b0; b1; b2; b3; b4; b5; b6; v7]::ByteList rest
