DecodeBitMasks_def_typed=∀(immN :word1) (imms :word6) (immr :word6) (immediate :bool). (DecodeBitMasks (immN,imms,immr,immediate) :('M word # 'M word) option) = (let (len :int) = HighestSetBit ((immN @@ ¬imms) :word7) in if len < (1 :int) then (NONE :('M word # 'M word) option) else (let (len :num) = Num len; (levels :word6) = (v2w (Ones len) :word6); (S :word6) = imms && levels; (R :word6) = immr && levels in if immediate ∧ S = levels then (NONE :('M word # 'M word) option) else (let (esize :num) = (2 :num) ** len in SOME ((Replicate (rotate (PAD_LEFT F esize (Ones (w2n S + (1 :num)))) (w2n R)) :'M word),(Replicate (PAD_LEFT F esize (Ones (v2n (field (len − (1 :num)) (0 :num) (w2v (S − R))) + (1 :num)))) :'M word)))))
