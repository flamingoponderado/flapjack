BigEndian_def_typed=∀(state :arm8_state). BigEndian state ⇔ if state.PSTATE.EL = (0w :word2) then state.SCTLR_EL1.E0E else (SCTLR state).EE
Mem_def_typed=∀(address :word64) (size :num) (acctype :AccType). (Mem (address,size,acctype) :arm8_state -> 'N word # arm8_state) = (λ(state :arm8_state). (let ((r :'N word),(s1 :bool list # arm8_state)) = (let (s :bool list # arm8_state) = SND (FOR ((0 :num),size − (1 :num),(λ(i :num) (state :bool list # arm8_state). ((),w2v ((SND state).MEM (address + (n2w i :word64))) ⧺ FST state,SND state))) (([] :bool list),CheckAlignment (address,size,acctype,F) state)) in ((v2w (if BigEndian (SND s) then BigEndianReverse (FST s) else FST s) :'N word),s)) in (r,SND s1)))
