dfn_primeClearExclusive_def_typed=∀(imm :word4). dfn'ClearExclusive imm = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "ClearExclusive") state :unit # arm8_state))
Zeros_def_typed=∀(n :num). Zeros n = PAD_LEFT F n ([] :bool list)
Poly32Mod2_loop_def_typed=∀(poly :bool list) (i :num) (data :bool list). Poly32Mod2_loop (i,data,poly) = if i < (32 :num) then data else Poly32Mod2_loop (i − (1 :num),if testbit i data then field (LENGTH data − (1 :num)) i data ⧺ bxor (field (i − (1 :num)) (0 :num) data) (PAD_RIGHT F i poly) else data,poly)
Poly32Mod2_def_typed=∀(data :bool list) (poly :word32). Poly32Mod2 (data,poly) = (v2w (field (31 :num) (0 :num) (Poly32Mod2_loop (LENGTH data − (1 :num),data,w2v poly))) :word32)
