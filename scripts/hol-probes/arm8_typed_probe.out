dfn_primeReverse_def_typed=∀(sf :'N word) (op :RevOp) (n :word5) (d :word5). dfn'Reverse (sf,op,n,d) = (λ(state :arm8_state). if word_len (0w :'N word) = (32 :num) then (let (v :word32) = (X n state :word32) in write'X ((case op of RevOp_RBIT => word_reverse v | RevOp_REV16 => (((((23 :num) >< (16 :num)) v :word8) @@ (((((31 :num) >< (24 :num)) v :word8) @@ (((((7 :num) >< (0 :num)) v :word8) @@ (((15 :num) >< (8 :num)) v :word8)) :word16)) :word24)) :word32) | RevOp_REV32 => (((((7 :num) >< (0 :num)) v :word8) @@ (((((15 :num) >< (8 :num)) v :word8) @@ (((((23 :num) >< (16 :num)) v :word8) @@ (((31 :num) >< (24 :num)) v :word8)) :word16)) :word24)) :word32) | RevOp_REV64 => (ARB :word32)),d) state) else (let (v :word64) = (X n state :word64) in write'X ((case op of RevOp_RBIT => word_reverse v | RevOp_REV16 => (((((55 :num) >< (48 :num)) v :word8) @@ (((((63 :num) >< (56 :num)) v :word8) @@ (((((39 :num) >< (32 :num)) v :word8) @@ (((((47 :num) >< (40 :num)) v :word8) @@ (((((23 :num) >< (16 :num)) v :word8) @@ (((((31 :num) >< (24 :num)) v :word8) @@ (((((7 :num) >< (0 :num)) v :word8) @@ (((15 :num) >< (8 :num)) v :word8)) :word16)) :word24)) :word32)) :40 word)) :word48)) :word56)) :word64) | RevOp_REV32 => (((((39 :num) >< (32 :num)) v :word8) @@ (((((47 :num) >< (40 :num)) v :word8) @@ (((((55 :num) >< (48 :num)) v :word8) @@ (((((63 :num) >< (56 :num)) v :word8) @@ (((((7 :num) >< (0 :num)) v :word8) @@ (((((15 :num) >< (8 :num)) v :word8) @@ (((((23 :num) >< (16 :num)) v :word8) @@ (((31 :num) >< (24 :num)) v :word8)) :word16)) :word24)) :word32)) :40 word)) :word48)) :word56)) :word64) | RevOp_REV64 => (((((7 :num) >< (0 :num)) v :word8) @@ (((((15 :num) >< (8 :num)) v :word8) @@ (((((23 :num) >< (16 :num)) v :word8) @@ (((((31 :num) >< (24 :num)) v :word8) @@ (((((39 :num) >< (32 :num)) v :word8) @@ (((((47 :num) >< (40 :num)) v :word8) @@ (((((55 :num) >< (48 :num)) v :word8) @@ (((63 :num) >< (56 :num)) v :word8)) :word16)) :word24)) :word32)) :40 word)) :word48)) :word56)) :word64)),d) state))
dfn_primeMultiplyHigh_def_typed=∀(signed :bool) (m :word5) (n :word5) (d :word5). dfn'MultiplyHigh (signed,m,n,d) = (λ(state :arm8_state). write'X ((((127 :num) >< (64 :num)) ((ExtendWord ((X n state :word64),signed) :word128) * (ExtendWord ((X m state :word64),signed) :word128)) :word64),d) state)
dfn_primeMultiplyAddSubLong_def_typed=∀(sub_op :bool) (signed :bool) (m :word5) (a :word5) (n :word5) (d :word5). dfn'MultiplyAddSubLong (sub_op,signed,m,a,n,d) = (λ(state :arm8_state). (let (v1 :word64) = (X a state :word64); (product :word64) = (ExtendWord ((X n state :word32),signed) :word64) * (ExtendWord ((X m state :word32),signed) :word64) in write'X (if sub_op then v1 − product else v1 + product,d) state))
