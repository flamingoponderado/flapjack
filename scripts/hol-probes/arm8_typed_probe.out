dfn_primeReserved_def_typed=∀(state :arm8_state). dfn'Reserved state = SND (raise'exception (UNDEFINED_FAULT "Reserved") state :unit # arm8_state)
dfn_primeMemoryBarrier_def_typed=∀(op :MemBarrierOp) (crm :word4). dfn'MemoryBarrier (op,crm) = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "MemoryBarrier") state :unit # arm8_state))
X_def_typed=∀(n :word5). (X n :arm8_state -> 'N word) = (λ(state :arm8_state). if n = (31w :word5) then (0w :'N word) else (w2w (state.REG n) :'N word))
Extend_def_typed=∀(l :bool list) (unsigned :bool). (Extend (l,unsigned) :'N word) = if unsigned ∨ ¬HD l then (v2w l :'N word) else (v2w (PAD_LEFT T (word_len (0w :'N word)) l) :'N word)
ExtendValue_def_typed=∀(value :'N word) (ty :ExtendType) (sh :num). ExtendValue (value,ty,sh) = (let ((unsigned :bool),(len :num)) = case ty of ExtendType_UXTB => (T,(8 :num)) | ExtendType_UXTH => (T,(16 :num)) | ExtendType_UXTW => (T,(32 :num)) | ExtendType_UXTX => (T,(64 :num)) | ExtendType_SXTB => (F,(8 :num)) | ExtendType_SXTH => (F,(16 :num)) | ExtendType_SXTW => (F,(32 :num)) | ExtendType_SXTX => (F,(64 :num)) in (Extend (shiftl (field (MIN len (word_len (0w :'N word) − sh) − (1 :num)) (0 :num) (w2v value)) sh,unsigned) :'N word))
ExtendReg_def_typed=∀(reg :word5) (ty :ExtendType) (sh :num). (ExtendReg (reg,ty,sh) :arm8_state -> 'N word) = (λ(state :arm8_state). ExtendValue ((X reg state :'N word),ty,sh))
SP_def_typed=∀(state :arm8_state). (SP state :'N word) = (w2w (if (¬state.PSTATE.SPS) then state.SP_EL0 else (case state.PSTATE.EL of (0w :word2) => state.SP_EL0 | (1w :word2) => state.SP_EL1 | (2w :word2) => state.SP_EL2 | (3w :word2) => state.SP_EL3 | v => (ARB :word64))) :'N word)
CheckSPAlignment_def_typed=∀(state :arm8_state). CheckSPAlignment state = if (if state.PSTATE.EL = (0w :word2) then state.SCTLR_EL1.SA0 else (SCTLR state).SA) ∧ ¬Aligned ((SP state :word64),(16 :num)) then SND (raise'exception ALIGNMENT_FAULT state :unit # arm8_state) else state
write_primeMem_def_typed=∀(value :'N word) (address :word64) (size :num) (acctype :AccType). write'Mem (value,address,size,acctype) = (λ(state :arm8_state). (let ((v :bool),(s :arm8_state)) = (let (s :arm8_state) = CheckAlignment (address,size,acctype,T) state in (BigEndian s,s)) in SND (FOR ((0 :num),size − (1 :num),(λ(i :num) (state :arm8_state). ((),state with MEM := state.MEM⦇address + (n2w i :word64) ↦ (v2w (field ((8 :num) * i + (7 :num)) ((8 :num) * i) (if v then BigEndianReverse (w2v value) else w2v value)) :word8)⦈))) s)))
ExtendWord_def_typed=∀(w :'M word) (signed :bool). (ExtendWord (w,signed) :'N word) = if signed then (sw2sw w :'N word) else (w2w w :'N word)
write_primeX_def_typed=∀(value :'N word) (n :word5). write'X (value,n) = (λ(state :arm8_state). if n ≠ (31w :word5) then state with REG := state.REG⦇n ↦ (w2w value :word64)⦈ else state)
write_primeSP_def_typed=∀(value :'N word). write'SP value = (λ(state :arm8_state). (let (v :word64) = (w2w value :word64) in if ¬state.PSTATE.SPS then state with SP_EL0 := v else case state.PSTATE.EL of (0w :word2) => state with SP_EL0 := v | (1w :word2) => state with SP_EL1 := v | (2w :word2) => state with SP_EL2 := v | (3w :word2) => state with SP_EL3 := v | v1 => (ARB :arm8_state)))
LoadStoreSingle_def_typed=∀(size :'N word) (regsize_word :bool) (memop :MemOp) (acctype :AccType) (signed :bool) (wb_unknown :bool) (rt_unknown :bool) (wback :bool) (postindex :bool) (offset :word64) (n :word5) (t :word5). LoadStoreSingle (size,regsize_word,memop,acctype,signed,wb_unknown,rt_unknown,wback,postindex,offset,n,t) = (λ(state :arm8_state). (let (s :arm8_state) = if n = (31w :word5) ∧ memop ≠ MemOp_PREFETCH then CheckSPAlignment state else state; (v :word64) = if n = (31w :word5) then (SP s :word64) else (X n s :word64); (address :word64) = if postindex then v else v + offset; (s :arm8_state) = case memop of MemOp_LOAD => (let ((v :'N word),(s :arm8_state)) = (Mem (address,word_len (0w :'N word) DIV (8 :num),acctype) s :'N word # arm8_state) in if regsize_word then write'X ((ExtendWord (v,signed) :word32),t) s else write'X ((ExtendWord (v,signed) :word64),t) s) | MemOp_STORE => write'Mem (if rt_unknown then (ARB :'N word) else (X t s :'N word),address,word_len (0w :'N word) DIV (8 :num),acctype) s | MemOp_PREFETCH => s in if wback then (let (address :word64) = if wb_unknown then (ARB :word64) else if postindex then address + offset else address in if n = (31w :word5) then write'SP address s else write'X (address,n) s) else s))
dfn_primeLoadStoreRegister_def_typed=∀(size :'N word) (regsize_word :bool) (memop :MemOp) (signed :bool) (m :word5) (extend_type :ExtendType) (shift :num) (n :word5) (t :word5). dfn'LoadStoreRegister (size,regsize_word,memop,signed,m,extend_type,shift,n,t) = (λ(state :arm8_state). LoadStoreSingle (size,regsize_word,memop,AccType_NORMAL,signed,F,F,F,F,(ExtendReg (m,extend_type,shift) state :word64),n,t) state)
dfn_primeLoadStorePair_def_typed=∀(size :'N word) (memop :MemOp) (acctype :AccType) (signed :bool) (wb_unknown :bool) (rt_unknown :bool) (wback :bool) (postindex :bool) (offset :word64) (n :word5) (t :word5) (t2 :word5). dfn'LoadStorePair (size,memop,acctype,signed,wb_unknown,rt_unknown,wback,postindex,offset,n,t,t2) = (λ(state :arm8_state). (let (dbytes :num) = word_len (0w :'N word) DIV (8 :num); (s :arm8_state) = if n = (31w :word5) then CheckSPAlignment state else state; (v :word64) = if n = (31w :word5) then (SP s :word64) else (X n s :word64); (address :word64) = if postindex then v else v + offset; (s :arm8_state) = case memop of MemOp_LOAD => (let ((v :'N word # 'N word),(s :arm8_state)) = if rt_unknown then ((ARB :'N word # 'N word),s) else (let ((v :'N word),(s :arm8_state)) = (Mem (address,dbytes,acctype) s :'N word # arm8_state); ((v0 :'N word),(s :arm8_state)) = (Mem (address + (n2w dbytes :word64),dbytes,acctype) s :'N word # arm8_state) in ((v,v0),s)); ((data1 :'N word),(data2 :'N word)) = v in if signed then write'X ((ExtendWord (data2,signed) :word64),t2) (write'X ((ExtendWord (data1,signed) :word64),t) s) else write'X (data2,t2) (write'X (data1,t) s)) | MemOp_STORE => write'Mem (if rt_unknown ∧ t2 = n then (ARB :'N word) else (X t2 s :'N word),address + (n2w dbytes :word64),dbytes,acctype) (write'Mem (if rt_unknown ∧ t = n then (ARB :'N word) else (X t s :'N word),address,dbytes,acctype) s) | MemOp_PREFETCH => s in if wback then (let (address :word64) = if wb_unknown then (ARB :word64) else if postindex then address + offset else address in if n = (31w :word5) then write'SP address s else write'X (address,n) s) else s))
dfn_primeLoadStoreImmediate_def_typed=∀(size :'N word) (regsize_word :bool) (memop :MemOp) (acctype :AccType) (signed :bool) (wb_unknown :bool) (rt_unknown :bool) (wback :bool) (postindex :bool) (unsigned_offset :bool) (offset :word64) (n :word5) (t :word5). dfn'LoadStoreImmediate (size,regsize_word,memop,acctype,signed,wb_unknown,rt_unknown,wback,postindex,unsigned_offset,offset,n,t) = (λ(state :arm8_state). LoadStoreSingle (size,regsize_word,memop,acctype,signed,wb_unknown,rt_unknown,wback,postindex,offset,n,t) state)
ExclusiveMonitorStatus_def_typed=ExclusiveMonitorStatus = (ARB :word1)
ExclusiveMonitorPass_def_typed=∀(address :word64) (n :num). ExclusiveMonitorPass (address,n) ⇔ (ARB :bool)
dfn_primeLoadStoreAcquirePair_def_typed=∀(size :'N word) (memop :MemOp) (acctype :AccType) (rn_unknown :bool) (rt_unknown :bool) (s :word5) (n :word5) (t :word5) (t2 :word5). dfn'LoadStoreAcquirePair (size,memop,acctype,rn_unknown,rt_unknown,s,n,t,t2) = (λ(state :arm8_state). (let (dbytes :num) = word_len (0w :'N word) DIV (8 :num); (s0 :arm8_state) = if n = (31w :word5) then CheckSPAlignment state else state; (v :word64) = if n = (31w :word5) then (SP s0 :word64) else if rn_unknown then (ARB :word64) else (X n s0 :word64) in case memop of MemOp_LOAD => if rt_unknown then if word_len (0w :'N word) = (64 :num) then write'X ((ARB :word32),t) s0 else write'X ((ARB :word64),t) s0 else if word_len (0w :'N word) = (64 :num) then (let ((v :'N word),(s :arm8_state)) = (Mem (v,dbytes,acctype) s0 :'N word # arm8_state) in if BigEndian s then write'X ((((31 :num) >< (0 :num)) v :word32),t2) (write'X ((((63 :num) >< (32 :num)) v :word32),t) s) else write'X ((((63 :num) >< (32 :num)) v :word32),t2) (write'X ((((31 :num) >< (0 :num)) v :word32),t) s)) else (let ((v0 :word64),(s :arm8_state)) = (Mem (v,(8 :num),acctype) (if (¬Aligned (v,dbytes)) then SND (raise'exception ALIGNMENT_FAULT s0 :unit # arm8_state) else s0) :word64 # arm8_state); ((v :word64),(s :arm8_state)) = (Mem (v + (8w :word64),(8 :num),acctype) (write'X (v0,t) s) :word64 # arm8_state) in write'X (v,t2) s) | MemOp_STORE => if ExclusiveMonitorPass (v,dbytes) then write'X ((w2w ExclusiveMonitorStatus :word32),s) (write'Mem (if rt_unknown then (ARB :'N word) else if word_len (0w :'N word) = (64 :num) then if BigEndian s0 then (w2w (((X t s0 :word32) @@ (X t2 s0 :word32)) :word64) :'N word) else (w2w (((X t2 s0 :word32) @@ (X t s0 :word32)) :word64) :'N word) else if BigEndian s0 then (w2w (((X t s0 :word64) @@ (X t2 s0 :word64)) :word128) :'N word) else (w2w (((X t2 s0 :word64) @@ (X t s0 :word64)) :word128) :'N word),v,dbytes,acctype) s0) else write'X ((1w :word32),s) s0 | MemOp_PREFETCH => s0))
dfn_primeLoadStoreAcquire_def_typed=∀(size :'N word) (memop :MemOp) (acctype :AccType) (excl :bool) (rn_unknown :bool) (rt_unknown :bool) (s :word5) (n :word5) (t :word5). dfn'LoadStoreAcquire (size,memop,acctype,excl,rn_unknown,rt_unknown,s,n,t) = (λ(state :arm8_state). (let (dbytes :num) = word_len (0w :'N word) DIV (8 :num); (s0 :arm8_state) = if n = (31w :word5) then CheckSPAlignment state else state; (v :word64) = if n = (31w :word5) then (SP s0 :word64) else if rn_unknown then (ARB :word64) else (X n s0 :word64) in case memop of MemOp_LOAD => (let ((v :'N word),(s :arm8_state)) = (Mem (v,dbytes,acctype) s0 :'N word # arm8_state) in if word_len (0w :'N word) = (64 :num) then write'X (v,t) s else write'X ((w2w v :word32),t) s) | MemOp_STORE => (let (v0 :'N word) = if rt_unknown then (ARB :'N word) else (X t s0 :'N word) in if excl then if ExclusiveMonitorPass (v,dbytes) then write'X ((w2w ExclusiveMonitorStatus :word32),s) (write'Mem (v0,v,dbytes,acctype) s0) else write'X ((1w :word32),s) s0 else write'Mem (v0,v,dbytes,acctype) s0) | MemOp_PREFETCH => s0))
dfn_primeLoadLiteral_def_typed=∀(size :'N word) (memop :MemOp) (signed :bool) (offset :word64) (t :word5). dfn'LoadLiteral (size,memop,signed,offset,t) = (λ(state :arm8_state). case memop of MemOp_LOAD => (let ((v :'N word),(s :arm8_state)) = (Mem (state.PC + offset,word_len (0w :'N word) DIV (8 :num),AccType_NORMAL) state :'N word # arm8_state) in write'X ((ExtendWord (v,signed) :word64),t) s) | MemOp_STORE => state | MemOp_PREFETCH => state)
dfn_primeHint_def_typed=∀(op :SystemHintOp). dfn'Hint op = (λ(state :arm8_state). if op = SystemHintOp_NOP then state else SND (raise'exception (UNDEFINED_FAULT "Hint") state :unit # arm8_state))
dfn_primeHalt_def_typed=∀(imm16 :word16). dfn'Halt imm16 = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "Halt") state :unit # arm8_state))
dfn_primeDebugSwitch_def_typed=∀(target_level :word2). dfn'DebugSwitch target_level = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "DebugSwitch") state :unit # arm8_state))
dfn_primeDebugRestore_def_typed=∀(state :arm8_state). dfn'DebugRestore state = SND (raise'exception (UNDEFINED_FAULT "DebugRestore") state :unit # arm8_state)
dfn_primeBreakpoint_def_typed=∀(imm :word16). dfn'Breakpoint imm = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "Breakpoint") state :unit # arm8_state))
ShiftValue_def_typed=∀(value :'N word) (ty :ShiftType) (amount :num). ShiftValue (value,ty,amount) = case ty of ShiftType_LSL => value ≪ amount | ShiftType_LSR => value ⋙ amount | ShiftType_ASR => value ≫ amount | ShiftType_ROR => value ⇄ amount
