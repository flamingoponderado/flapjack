dfn_primeMoveWide_def_typed=∀(sf :'N word) (opcode :MoveWideOp) (hw :word2) (imm :word16) (d :word5). dfn'MoveWide (sf,opcode,hw,imm,d) = (λ(state :arm8_state). (let (pos :num) = w2n ((hw @@ (0w :word4)) :word6); (s0 :'N word) = bit_field_insert (pos + (15 :num)) pos imm (if opcode = MoveWideOp_K then (X d state :'N word) else (0w :'N word)) in write'X (if opcode = MoveWideOp_N then ¬s0 else s0,d) state))
