 op2) else SystemHintOp_NOP)) else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ ¬b'25 ∧ b'24 ∧ ¬b'23 ∧ ¬b'22 ∧ ¬b'21 ∧ ¬b'20 ∧ ¬b'19 ∧ ¬b'18 ∧ b'17 ∧ b'16 ∧ ¬b'15 ∧ ¬b'14 ∧ b'13 ∧ b'12 ∧ ¬b'7 ∧ b'6 ∧ ¬b'5 ∧ b'4 ∧ b'3 ∧ b'2 ∧ b'1 ∧ b'0 then ClearExclusive (v2w [b'11; b'10; b'9; b'8] :word4) else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ b'25 ∧ ¬b'24 ∧ b'23 ∧ ¬b'22 ∧ b'21 ∧ b'20 ∧ b'19 ∧ b'18 ∧ b'17 ∧ b'16 ∧ ¬b'15 ∧ ¬b'14 ∧ ¬b'13 ∧ ¬b'12 ∧ ¬b'11 ∧ ¬b'10 ∧ b'9 ∧ b'8 ∧ b'7 ∧ b'6 ∧ b'5 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 ∧ ¬b'1 ∧ ¬b'0 then Debug DebugRestore else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ ¬b'25 ∧ ¬b'24 ∧ b'23 ∧ ¬b'22 ∧ b'21 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 then Debug (DebugSwitch (v2w [b'1; b'0] :word2)) else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ ¬b'25 ∧ ¬b'24 ∧ ¬b'23 ∧ b'22 ∧ ¬b'21 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 ∧ ¬b'1 ∧ ¬b'0 then Debug (Halt (v2w [b'20; b'19; b'18; b'17; b'16; b'15; b'14; b'13; b'12; b'11; b'10; b'9; b'8; b'7; b'6; b'5] :word16)) else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ b'25 ∧ ¬b'24 ∧ b'23 ∧ ¬b'22 ∧ ¬b'21 ∧ b'20 ∧ b'19 ∧ b'18 ∧ b'17 ∧ b'16 ∧ ¬b'15 ∧ ¬b'14 ∧ ¬b'13 ∧ ¬b'12 ∧ ¬b'11 ∧ ¬b'10 ∧ b'9 ∧ b'8 ∧ b'7 ∧ b'6 ∧ b'5 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 ∧ ¬b'1 ∧ ¬b'0 then System ExceptionReturn else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ ¬b'25 ∧ ¬b'24 ∧ ¬b'23 ∧ ¬b'22 ∧ ¬b'21 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 ∧ ¬b'1 ∧ b'0 then System (SupervisorCall (v2w [b'20; b'19; b'18; b'17; b'16; b'15; b'14; b'13; b'12; b'11; b'10; b'9; b'8; b'7; b'6; b'5] :word16)) else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ ¬b'25 ∧ ¬b'24 ∧ ¬b'23 ∧ ¬b'22 ∧ ¬b'21 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 ∧ b'1 ∧ ¬b'0 then System (HypervisorCall (v2w [b'20; b'19; b'18; b'17; b'16; b'15; b'14; b'13; b'12; b'11; b'10; b'9; b'8; b'7; b'6; b'5] :word16)) else if b'31 ∧ b'30 ∧ ¬b'29 ∧ b'28 ∧ ¬b'27 ∧ b'26 ∧ ¬b'25 ∧ ¬b'24 ∧ ¬b'23 ∧ ¬b'22 ∧ ¬b'21 ∧ ¬b'4 ∧ ¬b'3 ∧ ¬b'2 ∧ b'1 ∧ b'0 then System (SecureMonitorCall (v2w [b'20; b'19; b'18; b'17; b'16; b'15; b'14; b'13; b'12; b'11; b'10; b'9; b'8; b'7; b'6; b'5] :word16))