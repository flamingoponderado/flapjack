dfn_primeUnallocated_def_typed=∀(state :arm8_state). dfn'Unallocated state = SND (raise'exception (UNDEFINED_FAULT "Unallocated") state :unit # arm8_state)
dfn_primeSystemInstruction_def_typed=∀(sys_op1 :word3) (sys_op2 :word3) (sys_crn :word4) (sys_crm :word4) (has_result :bool) (t :word5). dfn'SystemInstruction (sys_op1,sys_op2,sys_crn,sys_crm,has_result,t) = (λ(state :arm8_state). SND (raise'exception (UNDEFINED_FAULT "System") state :unit # arm8_state))
