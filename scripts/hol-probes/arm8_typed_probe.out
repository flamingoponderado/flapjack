dfn_primeLogicalShiftedRegister_def_typed=∀(sf :'N word) (opc :LogicalOp) (invert :bool) (setflags :bool) (shift_type :ShiftType) (shift_amount :num) (m :word5) (n :word5) (d :word5). dfn'LogicalShiftedRegister (sf,opc,invert,setflags,shift_type,shift_amount,m,n,d) = (λ(state :arm8_state). (let (v :'N word) = (X n state :'N word); (v0 :'N word) = (ShiftReg (m,shift_type,shift_amount) state :'N word); (operand2 :'N word) = if invert then ¬v0 else v0; (result :'N word) = case opc of LogicalOp_AND => v && operand2 | LogicalOp_ORR => v ‖ operand2 | LogicalOp_EOR => v ⊕ operand2 in write'X (result,d) (SetTheFlags (setflags,word_msb result,result = (0w :'N word),F,F) state)))
