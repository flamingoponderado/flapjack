ALL_DISTINCT_compile_top_typed=∀(start :mlstring) (code :α decl list). ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions code)) ⇒ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions (compile_top code start)))
ALL_DISTINCT_fperm_decs_typed=∀(x :mlstring) (y :mlstring) (code :α decl list). ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions code)) ⇒ ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions (fperm_decs x y code)))
DISJOINT_addresses_lemma_typed=(addr1 :α word) + (bytes_in_word :α word) * (n2w (offs :num) :α word) = (addr2 :α word) ∧ good_dimindex (:α) ∧ w2n (bytes_in_word :α word) * (offs + (offs' :num)) < dimword (:α) ⇒ DISJOINT (addresses addr1 offs) (addresses addr2 offs')
FILTER_decs_fperm_decs_typed=∀(f :mlstring) (g :mlstring) (code :α decl list). FILTER ($¬ ∘ (is_function :α decl -> bool)) (fperm_decs f g code) = FILTER ($¬ ∘ (is_function :α decl -> bool)) code
FLOOKUP_fperm_code_typed=FLOOKUP (fperm_code (f :mlstring) (g :mlstring) (code :mlstring |-> α # β prog # γ)) (fperm_name f g (name :mlstring)) = OPTION_MAP ((I :α -> α) ## (fperm f g :β prog -> β prog) ## (I :γ -> γ)) (FLOOKUP code name)
FLOOKUP_fperm_code_prime_typed=FLOOKUP (fperm_code (f :mlstring) (g :mlstring) (code :mlstring |-> α # β prog # γ)) (name :mlstring) = OPTION_MAP ((I :α -> α) ## (fperm f g :β prog -> β prog) ## (I :γ -> γ)) (FLOOKUP code (fperm_name f g name))
FLOOKUP_globals_val_state_rel_typed=FLOOKUP (s :(α, β) state).globals (nm :mlstring) = SOME (Val (v :α word_lab) :α v) ∧ (state_rel (b :bool) (ctxt :α context) s (t :(α, β) state) :bool) ⇒ ∃(addr_diff :α word). FLOOKUP ctxt.globals nm = SOME (shape_of (Val v :α v),addr_diff) ∧ (mem_load (shape_of (Val v :α v)) (t.top_addr − addr_diff) t.memaddrs t.memory ([] :(mlstring # struct_info) list) :α v option) = SOME (Val v :α v) ∧ DISJOINT s.memaddrs (addresses (t.top_addr − addr_diff) (size_of_shape (shape_of (Val v :α v)))) ∧ byte_aligned addr_diff
OPT_MMAP_eval_correct_typed=(state_rel T (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ∧ OPT_MMAP (eval s) (argexps :α exp list) = SOME (args :α v list) ⇒ OPT_MMAP (eval t) (MAP (compile_exp ctxt) argexps) = SOME args
OPT_MMAP_eval_fresh_var_typed=∀(s :(α, β) state) (es :α exp list) (n :mlstring) (w :α v). ¬MEM n (FLAT (MAP (var_exp :α exp -> mlstring list) es)) ⇒ OPT_MMAP (eval (s with locals := s.locals⟨n ↦ w⟩)) es = OPT_MMAP (eval s) es
OPT_MMAP_eval_two_fresh_vars_typed=∀(s :(α, β) state) (es :α exp list) (n1 :mlstring) (w1 :α v) (n2 :mlstring) (w2 :α v). ¬MEM n1 (FLAT (MAP (var_exp :α exp -> mlstring list) es)) ∧ ¬MEM n2 (FLAT (MAP (var_exp :α exp -> mlstring list) es)) ⇒ OPT_MMAP (eval (s with locals := s.locals⟨n2 ↦ w2; n1 ↦ w1⟩)) es = OPT_MMAP (eval s) es
byte_aligned_bytes_in_word_mul_typed=good_dimindex (:α) ⇒ byte_aligned ((bytes_in_word :α word) * (x :α word))
byte_aligned_mul_bytes_in_word_typed=good_dimindex (:α) ∧ byte_aligned (a :α word) ⇒ ∃(b :α word). a = b * (bytes_in_word :α word) ∧ w2n b * w2n (bytes_in_word :α word) < dimword (:α)
compile_correct_typed=∀(v :α prog) (v1 :(α, β) state) (res :α result option) (ctxt :α context) (t :(α, β) state) (s' :(α, β) state). (state_rel T ctxt v1 t :bool) ∧ (evaluate (v,v1) :α result option # (α, β) state) = (res,s') ∧ res ≠ SOME (Error :α result) ⇒ ∃(t' :(α, β) state). (evaluate ((compile ctxt v :α prog),t) :α result option # (α, β) state) = (res,t') ∧ (state_rel (good_res res) ctxt s' t' :bool)
compile_decls_append_typed=∀(decs' :α decl list) (ctxt :α context) (decs :α decl list). compile_decs ctxt (decs ++ decs') = (let ((decls :α prog list),(funs :α decl list),(exns :α decl list),(ctxt' :α context)) = compile_decs ctxt decs; ((decls' :α prog list),(funs' :α decl list),(exns' :α decl list),(ctxt'' :α context)) = compile_decs ctxt' decs' in (decls ++ decls',funs ++ funs',exns ++ exns',ctxt''))
compile_decs_EVERY_typed=∀(ctxt :α context) (decs :α decl list) (decls :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt decs = (decls,funs,exns,ctxt') ∧ EVERY (λ(d :α decl). ∀(fi :α fun_decl) (ctxt :α context). d = Function fi ⇒ (P :α decl -> bool) (Function (fi with body := (compile ctxt fi.body :α prog)))) decs ⇒ EVERY P funs
compile_decs_EVERY_is_function_typed=∀(ctxt :α context) (decs :α decl list) (decls :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt decs = (decls,funs,exns,ctxt') ⇒ EVERY (is_function :α decl -> bool) funs
compile_decs_FILTER_decs_typed=∀(ctxt :α context) (code :α decl list) (decls :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt code = (decls,funs,exns,ctxt') ⇒ compile_decs ctxt (FILTER (is_decl :α decl -> bool) code) = (decls,([] :α decl list),([] :α decl list),ctxt')
compile_decs_decls_thm_typed=∀(ctxt :α context) (fdecs :α decl list) (decls :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt fdecs = (decls,funs,exns,ctxt') ∧ EVERY (λ(d :α decl). ¬is_function d) fdecs ⇒ funs = ([] :α decl list)
compile_decs_exns_are_exns_typed=∀(ctxt :α context) (code :α decl list) (decls :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt code = (decls,funs,exns,ctxt') ⇒ exns = FILTER (is_exn_decl :α decl -> bool) code
compile_decs_functions_thm_typed=∀(ctxt :α context) (fdecs :α decl list) (decls :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt fdecs = (decls,funs,exns,ctxt') ∧ EVERY (is_function :α decl -> bool) fdecs ⇒ decls = ([] :α prog list) ∧ exns = ([] :α decl list) ∧ ctxt' = ctxt ∧ funs = MAP (λ(x :α decl). case x of Function fi => Function (fi with body := (compile ctxt fi.body :α prog)) | Decl v9 v10 v11 => (ARB :α decl) | (ExnDecl v12 v13 :α decl) => (ARB :α decl) | (Name v14 v15 :α decl) => (ARB :α decl)) fdecs
compile_decs_localised_typed=∀(ctxt :α context) (code :α decl list). EVERY ((localised_prog :α prog -> bool) ∘ (FST :α prog # shape -> α prog) ∘ (SND :(mlstring # shape) list # α prog # shape -> α prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α prog # shape -> (mlstring # shape) list # α prog # shape)) (functions (FST (SND (compile_decs ctxt code))))
compile_decs_localised_prime_typed=∀(ctxt :α context) (code :α decl list). EVERY ((localised_prog :α prog -> bool) ∘ (FST :α prog # shape -> α prog) ∘ (SND :(mlstring # shape) list # α prog # shape -> α prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α prog # shape -> (mlstring # shape) list # α prog # shape)) (functions (FST (SND (SND (compile_decs ctxt code)))))
compile_decs_localised_main_typed=∀(ctxt :α context) (code :α decl list). EVERY (localised_prog :α prog -> bool) (FST (compile_decs ctxt code))
compile_decs_preserve_functions_typed=∀(code :α decl list) (ctxt :α context) (decs :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context). compile_decs ctxt code = (decs,funs,exns,ctxt') ⇒ MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions funs) = MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions code)
compile_exp_correct_typed=∀(s :(α, β) state) (e :α exp) (v :α v) (ctxt :α context) (t :(α, β) state). (state_rel T ctxt s t :bool) ∧ eval s e = SOME v ⇒ eval t (compile_exp ctxt e) = SOME v
compile_exp_localised_typed=∀(ctxt :α context) (e :α exp). localised_exp (compile_exp ctxt e)
compile_localised_typed=∀(ctxt :α context) (body :α prog). localised_prog (compile ctxt body :α prog)
compile_top_localised_typed=∀(pan_code :α decl list) (main :mlstring). EVERY ((localised_prog :α prog -> bool) ∘ (FST :α prog # shape -> α prog) ∘ (SND :(mlstring # shape) list # α prog # shape -> α prog # shape) ∘ (SND :mlstring # (mlstring # shape) list # α prog # shape -> (mlstring # shape) list # α prog # shape)) (functions (compile_top pan_code main))
compile_top_only_functions_or_exns_typed=EVERY (λ(d :α decl). is_function d ∨ is_exn_decl d) (compile_top (code :α decl list) (start :mlstring))
compile_top_semantics_decls_typed=ALL_DISTINCT (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions (code :α decl list))) ∧ (t :(α, β) state) = (s :(α, β) state) with <|top_addr := s.top_addr + (mgs :α word); memaddrs := s.memaddrs ∪ (free_addrs :α word -> bool); memory := (tmem :α word -> α word_lab); locals := (tlocals :mlstring |-> α v)|> ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α prog # shape) ∧ s.globals = (FEMPTY :mlstring |-> α v) ∧ byte_aligned s.top_addr ∧ good_dimindex (:α) ∧ mgs = (bytes_in_word :α word) * (n2w (SUM (MAP size_of_shape (dec_shapes code)) :num) :α word) ∧ free_addrs = addresses s.top_addr (SUM (MAP size_of_shape (dec_shapes code)) :num) ∧ DISJOINT s.memaddrs free_addrs ∧ (∀(addr' :α word). addr' ∈ s.memaddrs ⇒ (s.memory addr' :α word_lab) = tmem addr') ∧ s.top_addr + mgs ∉ s.memaddrs ∧ w2n (bytes_in_word :α word) * (SUM (MAP size_of_shape (dec_shapes code)) :num) < dimword (:α) ∧ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) code ∧ semantics_decls s (start :mlstring) code ≠ Fail ⇒ semantics_decls s start code = semantics_decls t start (compile_top code start)
dec_shapes_FILTER_typed=dec_shapes (FILTER ($¬ ∘ (is_function :α decl -> bool)) (xs :α decl list)) = dec_shapes xs ∧ dec_shapes (FILTER (is_name :α decl -> bool) xs) = ([] :shape list) ∧ dec_shapes (FILTER (is_decl :α decl -> bool) xs) = dec_shapes xs ∧ dec_shapes (FILTER (is_exn_decl :α decl -> bool) xs) = ([] :shape list)
dec_shapes_append_typed=dec_shapes ((xs :α decl list) ++ (ys :α decl list)) = dec_shapes xs ++ dec_shapes ys
dec_shapes_fperm_decs_typed=dec_shapes (fperm_decs (f :mlstring) (g :mlstring) (xs :α decl list)) = dec_shapes xs
dec_shapes_functions_typed=EVERY (is_function :α decl -> bool) (xs :α decl list) ⇒ dec_shapes xs = ([] :shape list)
dec_shapes_resort_decls_def_typed=dec_shapes (resort_decls (xs :α decl list)) = dec_shapes xs
decl_distinct_typed=(is_decl (x :α decl) ∧ is_name x ⇔ F) ∧ (is_decl x ∧ is_function x ⇔ F) ∧ (is_decl x ∧ is_exn_decl x ⇔ F)
disjoint_globals_def_typed=∀(top_addr :α word) (cglobals :β |-> shape # α word) (globals :β |-> γ). disjoint_globals top_addr cglobals globals ⇔ ∀(v :β) (v' :β) (sh :shape) (addr :α word) (sh' :shape) (addr' :α word). v ≠ v' ∧ IS_SOME (FLOOKUP globals v) ∧ IS_SOME (FLOOKUP globals v') ∧ FLOOKUP cglobals v = SOME (sh,addr) ∧ FLOOKUP cglobals v' = SOME (sh',addr') ⇒ DISJOINT (addresses (top_addr − addr) (size_of_shape sh)) (addresses (top_addr − addr') (size_of_shape sh'))
eval_shape_val_NONE_typed=(∀(sh :shape). eval (t :(α, β) state) (shape_val sh :α exp) = (NONE :α v option) ⇔ F) ∧ ∀(shs :shape list). OPT_MMAP (eval t) (shape_vals shs :α exp list) = (NONE :α v list option) ⇔ F
eval_shape_val_thm_typed=(∀(sh :shape) (v :α v). eval (t :(α, β) state) (shape_val sh :α exp) = SOME v ∧ is_wf_shape_nil sh ⇒ sh = shape_of v) ∧ ∀(shs :shape list) (vs :α v list). OPT_MMAP (eval t) (shape_vals shs :α exp list) = SOME vs ∧ EVERY is_wf_shape_nil shs ⇒ shs = MAP (shape_of :α v -> shape) vs
eval_upd_code_eta_typed=∀(t :(α, β) state) (code :mlstring |-> (mlstring # shape) list # α prog # shape). eval (t with code := code) = eval t
evaluate_decls_compile_top_typed=evaluate_decls (s :(α, β) state) (decs :α decl list) = SOME (s' :(α, β) state) ∧ ALOOKUP (functions decs) (start :mlstring) = SOME ((args :(mlstring # shape) list),(body :α prog),(rshape :shape)) ∧ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) decs ∧ compile_decs <|globals := (FEMPTY :mlstring |-> shape # α word); globals_size := (0w :α word); max_globals_size := (bytes_in_word :α word) * (n2w (SUM (MAP size_of_shape (dec_shapes decs)) :num) :α word)|> (fperm_decs start (new_main_name decs) (resort_decls decs)) = ((ndecls :α prog list),(nfuns :α decl list),(nexns :α decl list),(nctxt :α context)) ⇒ evaluate_decls s (compile_top decs start) = SOME (s with <|code := s.code⟨start ↦ (args,Seq (nested_seq ndecls) (TailCall (new_main_name decs) (MAP ((Var Local :mlstring -> α exp) ∘ (FST :mlstring # shape -> mlstring)) args)),rshape)⟩ |++ MAP (λ((x :mlstring),(y :(mlstring # shape) list),(z :α prog),(t :shape)). (x,y,(compile nctxt z :α prog),t)) (functions (fperm_decs start (new_main_name decs) decs)); eshapes := s.eshapes |++ exceptions nexns|>)
evaluate_decls_fperm_typed=∀(s :(α, β) state) (decs :α decl list) (s' :(α, β) state) (f :mlstring) (g :mlstring). evaluate_decls s decs = SOME s' ⇒ evaluate_decls (s with code := fperm_code f g s.code) (fperm_decs f g decs) = SOME (s' with code := fperm_code f g s'.code)
evaluate_decls_init_globals_lemma_typed=∀(s :(α, 'ffi) state) (decls :α decl list) (s' :(α, 'ffi) state) (decls' :α prog list) (funs :α decl list) (exns :α decl list) (ctxt' :α context) (ctxt :α context) (t :(α, 'ffi) state) (free_addrs :α word -> bool). evaluate_decls s decls = SOME s' ∧ EVERY (is_decl :α decl -> bool) decls ∧ compile_decs ctxt decls = (decls',funs,exns,ctxt') ∧ (state_rel F ctxt s t :bool) ∧ free_addrs = addresses (t.top_addr − (bytes_in_word :α word) * (n2w (SUM (MAP size_of_shape (dec_shapes decls)) :num) :α word) − ctxt.globals_size) (SUM (MAP size_of_shape (dec_shapes decls)) :num) ∧ DISJOINT s.memaddrs free_addrs ∧ free_addrs ⊆ t.memaddrs ∧ byte_aligned ctxt.globals_size ∧ s.code = (FEMPTY :mlstring |-> (mlstring # shape) list # α prog # shape) ∧ (∀(v :mlstring) (sh :shape) (addr' :α word). IS_SOME (FLOOKUP s.globals v) ∧ FLOOKUP ctxt.globals v = SOME (sh,addr') ⇒ DISJOINT (addresses (t.top_addr − addr') (size_of_shape sh)) free_addrs) ∧ w2n (bytes_in_word :α word) * (SUM (MAP size_of_shape (dec_shapes decls)) :num) < dimword (:α) ⇒ ∃(t' :(α, 'ffi) state). (evaluate (nested_seq decls',t) :α result option # (α, 'ffi) state) = ((NONE :α result option),t') ∧ (state_rel F ctxt' s' t' :bool) ∧ t'.clock = t.clock ∧ t'.ffi = t.ffi ∧ t'.locals = t.locals ∧ byte_aligned ctxt'.globals_size
evaluate_fperm_typed=∀(f :mlstring) (g :mlstring) (p :α prog) (s :(α, β) state) (res :α result option) (s' :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (res,s') ⇒ (evaluate (fperm f g p,s with code := fperm_code f g s.code) :α result option # (α, β) state) = (res,s' with code := fperm_code f g s'.code)
evaluate_fperm_prime_typed=(evaluate (fperm (f :mlstring) (g :mlstring) (p :α prog),(s :(α, β) state) with <|code := fperm_code f g s.code; clock := (k :num)|>) :α result option # (α, β) state) = (λ((x :α result option),(s' :(α, β) state)). (x,s' with code := fperm_code f g s'.code)) (evaluate (p,s with clock := k) :α result option # (α, β) state)
evaluate_fresh_local_typed=∀(z :mlstring) (v :α v) (p :α prog) (s :(α, β) state) (res :α result option) (s' :(α, β) state). ¬MEM z (free_var_ids p) ∧ (evaluate (p,s) :α result option # (α, β) state) = (res,s') ⇒ ∃(locals :mlstring |-> α v). (evaluate (p,s with locals := s.locals⟨z ↦ v⟩) :α result option # (α, β) state) = (res,s' with locals := locals) ∧ (good_res res ∧ res ≠ SOME (Error :α result) ⇒ locals = s'.locals⟨z ↦ v⟩)
evaluate_unchanged_local_typed=∀(z :mlstring) (v :α) (p :β prog) (s :(β, γ) state) (res :β result option) (s' :(β, γ) state). ¬MEM z (free_var_ids p) ∧ (evaluate (p,s) :β result option # (β, γ) state) = (res,s') ∧ good_res res ∧ res ≠ SOME (Error :β result) ⇒ FLOOKUP s'.locals z = FLOOKUP s.locals z
exceptions_FILTER_is_function_typed=exceptions (FILTER (is_function :α decl -> bool) (decs :α decl list)) = ([] :(mlstring # shape) list) ∧ exceptions (FILTER ($¬ ∘ (is_function :α decl -> bool)) decs) = exceptions decs ∧ exceptions (FILTER (is_exn_decl :α decl -> bool) decs) = exceptions decs ∧ exceptions (FILTER (is_name :α decl -> bool) decs) = ([] :(mlstring # shape) list) ∧ exceptions (FILTER (is_decl :α decl -> bool) decs) = ([] :(mlstring # shape) list)
exceptions_append_typed=∀(ds :α decl list) (ds' :α decl list). exceptions (ds ++ ds') = exceptions ds ++ exceptions ds'
exceptions_compile_top_typed=ALOOKUP (functions (code :α decl list)) (start :mlstring) = SOME (x :(mlstring # shape) list # α prog # shape) ⇒ exceptions (compile_top code start) = exceptions code
fperm_code_FEMPTY_typed=fperm_code (f :mlstring) (g :mlstring) (FEMPTY :mlstring |-> α # β prog # γ) = (FEMPTY :mlstring |-> α # β prog # γ)
fperm_code_FUPDATE_LIST_functions_typed=∀(code :α decl list). fperm_code (f :mlstring) (g :mlstring) ((fm :mlstring |-> (mlstring # shape) list # α prog # shape) |++ functions code) = fperm_code f g fm |++ functions (fperm_decs f g code)
fperm_code_def_typed=∀(f :mlstring) (g :mlstring) (code :mlstring |-> α # β prog # γ). fperm_code f g code = FUN_FMAP (((I :α -> α) ## (fperm f g :β prog -> β prog) ## (I :γ -> γ)) ∘ (THE :(α # β prog # γ) option -> α # β prog # γ) ∘ FLOOKUP code ∘ fperm_name f g) (PREIMAGE (fperm_name f g) (FDOM code))
fperm_decs_FILTER_is_function_typed=∀(f :mlstring) (g :mlstring) (decs :α decl list). fperm_decs f g (FILTER (is_function :α decl -> bool) decs) = FILTER (is_function :α decl -> bool) (fperm_decs f g decs)
fperm_decs_append_typed=∀(f :mlstring) (g :mlstring) (xs :α decl list) (ys :α decl list). fperm_decs f g (xs ++ ys) = fperm_decs f g xs ++ fperm_decs f g ys
fperm_decs_decls_typed=∀(f :mlstring) (g :mlstring) (xs :α decl list) (ys :β). EVERY ($¬ ∘ (is_function :α decl -> bool)) xs ⇒ fperm_decs f g xs = xs
fperm_name_cancel_typed=fperm_name (f :α) (g :α) (fperm_name f g (name :α)) = name
fperm_name_cong_typed=fperm_name (f :α) (g :α) (x :α) = fperm_name f g (y :α) ⇔ x = y
fresh_name_correct_typed=∀(name :mlstring) (names :mlstring list). MEM (fresh_name name names) names ⇒ F
fresh_name_correct_prime_typed=∀(name :mlstring) (names :mlstring list) (names' :mlstring list). MEM (fresh_name name names) names' ⇒ set names' ⊆ set names ⇒ F
functions_FILTER_exn_decl_typed=∀(prog :α decl list). functions (FILTER (is_exn_decl :α decl -> bool) prog) = ([] :(mlstring # (mlstring # shape) list # α prog # shape) list)
functions_FILTER_is_name_typed=∀(prog :α decl list). functions (FILTER (is_name :α decl -> bool) prog) = ([] :(mlstring # (mlstring # shape) list # α prog # shape) list)
functions_fperm_decs_typed=∀(x :mlstring) (y :mlstring) (code :α decl list). functions (fperm_decs x y code) = MAP (λ((a :mlstring),(b :(mlstring # shape) list),(c :α prog),(d :shape)). (fperm_name x y a,b,fperm x y c,d)) (functions code)
good_dimindex_w2n_add_typed=good_dimindex (:α) ∧ byte_aligned (a :α word) ∧ a ≠ -(1w :α word) * (bytes_in_word :α word) ⇒ w2n a + w2n (bytes_in_word :α word) = w2n (a + (bytes_in_word :α word))
good_res_def_typed=(good_res (SOME (TimeOut :α result)) ⇔ F) ∧ (good_res (SOME (Return (v :α v) :α result)) ⇔ F) ∧ (good_res (SOME (Exception (l :mlstring) v :α result)) ⇔ F) ∧ (good_res (SOME (FinalFFI (ev :final_event) :α result)) ⇔ F) ∧ (good_res (NONE :α result option) ⇔ T) ∧ (good_res (SOME (Error :α result)) ⇔ T) ∧ (good_res (SOME (Break :α result)) ⇔ T) ∧ (good_res (SOME (Continue :α result)) ⇔ T)
localised_exp_shape_val_typed=(∀(sh :shape). localised_exp (shape_val sh :α exp)) ∧ ∀(shs :shape list). EVERY (localised_exp :α exp -> bool) (shape_vals shs :α exp list)
lookup_code_fperm_code_typed=lookup_code (fperm_code (f :mlstring) (g :mlstring) (code :mlstring |-> (β # shape) list # α prog # δ)) (fperm_name f g (name :mlstring)) (args :γ v list) = OPTION_MAP ((fperm f g :α prog -> α prog) ## (I :(β |-> γ v) # δ -> (β |-> γ v) # δ)) (lookup_code code name args)
mem_load_disjoint_typed=(∀(val :α v) (addr'' :α word) (memory :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α word_lab) (addr' :α word) (addrs :α word -> bool). (mem_load (shape_of val) addr' addrs memory stcs :α v option) = SOME val ∧ addr'' ∉ addresses addr' (size_of_shape (shape_of val)) ∧ is_wf_shape_nil (shape_of val) ⇒ (mem_load (shape_of val) addr' addrs memory⦇addr'' ↦ v⦈ stcs :α v option) = SOME val) ∧ ∀(vals :α v list) (addr'' :α word) (memory :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (v :α word_lab) (addr' :α word) (addrs :α word -> bool). mem_loads (MAP (shape_of :α v -> shape) vals) addr' addrs memory stcs = SOME vals ∧ addr'' ∉ addresses addr' (SUM (MAP (size_of_shape ∘ (shape_of :α v -> shape)) vals) :num) ∧ EVERY is_wf_shape_nil (MAP (shape_of :α v -> shape) vals) ⇒ mem_loads (MAP (shape_of :α v -> shape) vals) addr' addrs memory⦇addr'' ↦ v⦈ stcs = SOME vals
mem_load_mem_store_typed=(∀(s :shape) (addr :α word) (addrs :α word -> bool) (memory :α word -> α word_lab) (sctxt :(mlstring # struct_info) list) (v :α v) (w :α v). (mem_load s addr addrs memory sctxt :α v option) = SOME v ∧ sctxt = ([] :(mlstring # struct_info) list) ∧ is_wf_shape sctxt s ∧ shape_of w = s ⇒ ∃(m :α word -> α word_lab). mem_stores addr (flatten w) addrs memory = SOME m) ∧ (∀(ss :shape list) (addr :α word) (addrs :α word -> bool) (memory :α word -> α word_lab) (sctxt :(mlstring # struct_info) list) (vs :α v list) (ws :α v list). mem_loads ss addr addrs memory sctxt = SOME vs ∧ sctxt = ([] :(mlstring # struct_info) list) ∧ EVERY (is_wf_shape sctxt) ss ∧ ss = MAP (shape_of :α v -> shape) ws ⇒ ∃(m :α word -> α word_lab). mem_stores addr (FLAT (MAP (λ(a :α v). flatten a) ws)) addrs memory = SOME m) ∧ ∀(fs :(mlstring # shape) list) (addr :α word) (addrs :α word -> bool) (memory :α word -> α word_lab) (sctxt :(mlstring # struct_info) list) (vfs :(mlstring # α v) list). mem_load_flds fs addr addrs memory sctxt = SOME vfs ∧ sctxt = ([] :(mlstring # struct_info) list) ∧ T ⇒ T
mem_stores_addrs_IS_SOME_typed=∀(addr' :α word) (ws :α word_lab list) (memaddrs :α word -> bool) (memory :α word -> α word_lab). addresses addr' (LENGTH ws) ⊆ memaddrs ⇒ ∃(m :α word -> α word_lab). mem_stores addr' ws memaddrs memory = SOME m
mem_stores_append_typed=∀(addr :α word) (vs :α word_lab list) (addrs :α word -> bool) (memory :α word -> α word_lab) (vs' :α word_lab list). mem_stores addr (vs ++ vs') addrs memory = case mem_stores addr vs addrs memory of (NONE :(α word -> α word_lab) option) => (NONE :(α word -> α word_lab) option) | SOME memory' => mem_stores (addr + (bytes_in_word :α word) * (n2w (LENGTH vs) :α word)) vs' addrs memory'
mem_stores_bounded_length_typed=∀(addr :α word) (ws :α word_lab list) (addrs :α word -> bool) (memory :α word -> α word_lab) (m :α word -> α word_lab) (addr' :α word). mem_stores addr ws addrs memory = SOME m ∧ addr' ∉ addrs ∧ byte_aligned addr ∧ byte_aligned addr' ∧ good_dimindex (:α) ⇒ w2n (bytes_in_word :α word) * LENGTH ws ≤ w2n (addr' − addr)
mem_stores_load_disjoint_typed=(∀(sh :shape) (addr :α word) (vs :α word_lab list) (addrs :α word -> bool) (memory :α word -> α word_lab) (m :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (addr' :α word). mem_stores addr vs addrs memory = SOME m ∧ stcs = ([] :(mlstring # struct_info) list) ∧ is_wf_shape stcs sh ∧ DISJOINT (addresses addr' (size_of_shape sh)) (addresses addr (LENGTH vs)) ⇒ (mem_load sh addr' addrs m stcs :α v option) = (mem_load sh addr' addrs memory ([] :(mlstring # struct_info) list) :α v option)) ∧ ∀(shs :shape list) (addr :α word) (vs :α word_lab list) (addrs :α word -> bool) (memory :α word -> α word_lab) (m :α word -> α word_lab) (stcs :(mlstring # struct_info) list) (addr' :α word). mem_stores addr vs addrs memory = SOME m ∧ stcs = ([] :(mlstring # struct_info) list) ∧ EVERY (is_wf_shape stcs) shs ∧ DISJOINT (addresses addr' (SUM (MAP size_of_shape shs) :num)) (addresses addr (LENGTH vs)) ⇒ mem_loads shs addr' addrs m stcs = mem_loads shs addr' addrs memory ([] :(mlstring # struct_info) list)
mem_stores_lookup_typed=∀(addr :α word) (vs :α word_lab list) (addrs :α word -> bool) (memory :α word -> α word_lab) (m :α word -> α word_lab) (addr' :α word). mem_stores addr vs addrs memory = SOME m ∧ addr' ∉ addresses addr (LENGTH vs) ⇒ m addr' = memory addr'
mem_stores_mem_load_back_typed=(∀(val :α v) (addr :α word) (addrs :α word -> bool) (memory :α word -> α word_lab) (m :α word -> α word_lab) (sctxt :(mlstring # struct_info) list). mem_stores addr (flatten val) addrs memory = SOME m ∧ LENGTH (flatten val) * w2n (bytes_in_word :α word) < dimword (:α) ∧ is_wf_shape sctxt (shape_of val) ∧ sctxt = ([] :(mlstring # struct_info) list) ∧ good_dimindex (:α) ⇒ (mem_load (shape_of val) addr addrs m sctxt :α v option) = SOME val) ∧ ∀(vals :α v list) (addr :α word) (addrs :α word -> bool) (memory :α word -> α word_lab) (m :α word -> α word_lab) (sctxt :(mlstring # struct_info) list). mem_stores addr (FLAT (MAP (λ(a :α v). flatten a) vals)) addrs memory = SOME m ∧ LENGTH (FLAT (MAP (λ(a :α v). flatten a) vals)) * w2n (bytes_in_word :α word) < dimword (:α) ∧ EVERY (is_wf_shape sctxt) (MAP (shape_of :α v -> shape) vals) ∧ sctxt = ([] :(mlstring # struct_info) list) ∧ good_dimindex (:α) ⇒ mem_loads (MAP (shape_of :α v -> shape) vals) addr addrs m sctxt = SOME vals
mem_stores_memory_swap_typed=∀(addr :α word) (vs :α word_lab list) (addrs :α word -> bool) (memory :α word -> α word_lab) (memory' :α word -> α word_lab) (m :α word -> α word_lab). mem_stores addr vs addrs memory = SOME m ⇒ ∃(m' :α word -> α word_lab). mem_stores addr vs addrs memory' = SOME m'
nested_seqs_localised_typed=∀(ps :α prog list). localised_prog (nested_seq ps) ⇔ EVERY (localised_prog :α prog -> bool) ps
new_main_name_correct_typed=MEM (new_main_name (code :α decl list)) (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions code)) ⇒ F
not_is_function_typed=(is_name (x :α decl) ⇒ ¬is_function x) ∧ (is_decl x ⇒ ¬is_function x) ∧ (is_exn_decl x ⇒ ¬is_function x)
res_var_FEMPTY_typed=res_var (FEMPTY :α |-> β) ((n :α),(NONE :β option)) = (FEMPTY :α |-> β)
resort_decls_evaluate_typed=∀(s :(α, β) state) (decs :α decl list). EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) decs ⇒ evaluate_decls s (resort_decls decs) = evaluate_decls s decs
resort_decls_preserve_functions_typed=∀(code :α decl list). functions (resort_decls code) = functions code
semantics_empty_locals_typed=(semantics (t :(α, β) state) (start :mlstring) :behaviour) = (semantics (t with locals := (FEMPTY :mlstring |-> α v)) start :behaviour)
semantics_fperm_typed=(semantics ((s :(α, β) state) with code := fperm_code (f :mlstring) (g :mlstring) s.code) (fperm_name f g (start :mlstring)) :behaviour) = (semantics s start :behaviour)
semantics_init_call_typed=FLOOKUP (s :(α, β) state).code (start :mlstring) = SOME (([] :(mlstring # shape) list),Seq (body :α prog) (TailCall (start' :mlstring) ([] :α exp list)),(rshape :shape)) ∧ FLOOKUP s.code start' = SOME ((args' :(mlstring # shape) list),(body' :α prog),rshape) ∧ (∀(k :num). (evaluate (body,s with <|locals := (FEMPTY :mlstring |-> α v); clock := k|>) :α result option # (α, β) state) = ((NONE :α result option),(s' :(α, β) state) with clock := k)) ∧ s'.ffi.io_events = s.ffi.io_events ⇒ (semantics s start :behaviour) = (semantics s' start' :behaviour)
semantics_init_call_prime_typed=FLOOKUP (s :(α, β) state).code (start :mlstring) = SOME (([] :(mlstring # shape) list),Seq (body :α prog) (TailCall (start' :mlstring) ([] :α exp list)),(rshape :shape)) ∧ FLOOKUP s.code start' = SOME ((args' :(mlstring # shape) list),(body' :α prog),rshape) ∧ (evaluate (body,s with locals := (FEMPTY :mlstring |-> α v)) :α result option # (α, β) state) = ((NONE :α result option),(s' :(α, β) state)) ∧ s'.clock = s.clock ∧ s'.ffi.io_events = s.ffi.io_events ⇒ (semantics s start :behaviour) = (semantics s' start' :behaviour)
state_rel_change_ffi_typed=(state_rel (ls' :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ⇒ (state_rel ls' ctxt (s with ffi := (x :γ ffi_state)) (t with ffi := x) :bool)
state_rel_change_locals_typed=((state_rel T (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ⇒ (state_rel (ls' :bool) ctxt (s with locals := (x :mlstring |-> α v)) (t with locals := x) :bool)) ∧ ((state_rel F ctxt s t :bool) ⇒ (state_rel ls' ctxt (s with locals := x) (t with locals := x) :bool))
state_rel_def_typed=∀(ls :bool) (ctxt :α context) (s :(α, 'ffi) state) (t :(α, 'ffi) state). (state_rel ls ctxt s t :bool) ⇔ s.top_addr = t.top_addr − ctxt.max_globals_size ∧ (ls ⇒ s.locals = t.locals) ∧ s.base_addr = t.base_addr ∧ (s.be ⇔ t.be) ∧ s.eshapes = t.eshapes ∧ s.clock = t.clock ∧ s.structs = ([] :(mlstring # struct_info) list) ∧ t.structs = ([] :(mlstring # struct_info) list) ∧ (∀(v :mlstring) (val :α v). FLOOKUP s.globals v = SOME val ⇒ ∃(addr :α word). FLOOKUP ctxt.globals v = SOME (shape_of val,addr) ∧ is_wf_shape_nil (shape_of val) ∧ (mem_load (shape_of val) (t.top_addr − addr) t.memaddrs t.memory ([] :(mlstring # struct_info) list) :α v option) = SOME val ∧ DISJOINT s.memaddrs (addresses (t.top_addr − addr) (size_of_shape (shape_of val))) ∧ byte_aligned addr) ∧ FEVERY (λ((nm :mlstring),(sh :shape),(addr :α word)). is_wf_shape_nil sh) ctxt.globals ∧ s.memaddrs ⊆ t.memaddrs ∧ s.sh_memaddrs = t.sh_memaddrs ∧ (∀(addr :α word). addr ∈ s.memaddrs ⇒ (s.memory addr :α word_lab) = (t.memory addr :α word_lab)) ∧ s.ffi = t.ffi ∧ (∀(fname :mlstring) (vshapes :(mlstring # shape) list) (prog :α prog) (rshape :shape). FLOOKUP s.code fname = SOME (vshapes,prog,rshape) ⇒ FLOOKUP t.code fname = SOME (vshapes,(compile ctxt prog :α prog),rshape)) ∧ disjoint_globals t.top_addr ctxt.globals s.globals ∧ t.top_addr ∉ t.memaddrs ∧ byte_aligned t.top_addr ∧ good_dimindex (:α)
state_rel_empty_locals_typed=((state_rel T (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ⇒ (state_rel (ls' :bool) ctxt (empty_locals s) (empty_locals t) :bool)) ∧ ((state_rel F ctxt s t :bool) ⇒ (state_rel ls' ctxt (empty_locals s) (empty_locals t) :bool))
state_rel_imp_semantics_typed=(state_rel T (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ∧ (semantics s (start :mlstring) :behaviour) ≠ Fail ⇒ (semantics t start :behaviour) = (semantics s start :behaviour)
state_rel_lookup_code_typed=(state_rel (ls :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ∧ lookup_code s.code (fname :mlstring) (args :γ v list) = SOME ((prog :α prog),(newlocals :(mlstring |-> γ v) # shape)) ⇒ lookup_code t.code fname args = SOME ((compile ctxt prog :α prog),newlocals)
state_rel_mem_load_typed=(state_rel (ls :bool) (ctxt :α context) (s :(α, 'ffi) state) (t :(α, 'ffi) state) :bool) ∧ (mem_load (shape :shape) (w :α word) s.memaddrs s.memory ([] :(mlstring # struct_info) list) :α v option) = SOME (v :α v) ⇒ (mem_load shape w t.memaddrs t.memory ([] :(mlstring # struct_info) list) :α v option) = SOME v
state_rel_mem_store_byte_typed=(state_rel (ls :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ∧ mem_store_byte s.memory s.memaddrs s.be (addr' :α word) (b :word8) = SOME (m' :α word -> α word_lab) ⇒ ∃(m'' :α word -> α word_lab). mem_store_byte t.memory t.memaddrs t.be addr' b = SOME m'' ∧ (state_rel ls ctxt (s with memory := m') (t with memory := m'') :bool)
state_rel_memory_update_typed=(state_rel T (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ∧ (addr' :α word) ∈ s.memaddrs ⇒ (state_rel T ctxt (s with memory := s.memory⦇addr' ↦ (h :α word_lab)⦈) (t with memory := t.memory⦇addr' ↦ h⦈) :bool)
state_rel_read_bytearray_typed=∀(ls :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) (bytes :word8 list) (sz :α word) (ad :num). (state_rel ls ctxt s t :bool) ∧ read_bytearray sz ad (mem_load_byte s.memory s.memaddrs s.be) = SOME bytes ⇒ read_bytearray sz ad (mem_load_byte t.memory t.memaddrs t.be) = SOME bytes
state_rel_set_var_typed=(state_rel T (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ⇒ (state_rel (ls' :bool) ctxt (set_var (rt :mlstring) (retv :α v) s) (set_var rt retv t) :bool)
state_rel_write_bytearray_typed=∀(a :α) (ls :bool) (ctxt :β context) (s :(β, γ) state) (t :(β, γ) state) (sz :β word) (nbw :word8 list) (bs :word8 list). (state_rel ls ctxt s t :bool) ∧ read_bytearray sz (LENGTH nbw) (mem_load_byte s.memory s.memaddrs s.be) = SOME bs ⇒ (state_rel ls ctxt (s with memory := write_bytearray sz nbw s.memory s.memaddrs s.be) (t with memory := write_bytearray sz nbw t.memory t.memaddrs t.be) :bool)
w2n_add_alt_typed=∀(a :α word) (b :α word). w2n a + w2n b < dimword (:α) ⇒ w2n a + w2n b = w2n (a + b)
EVERY_fperm_decs_typed=∀(f :mlstring) (g :mlstring) (decs :α decl list). EVERY (λ(d :α decl). ¬is_function d ⇒ (P :α decl -> bool) d) decs ∧ EVERY (λ(d :α decl). ∀(fi :α fun_decl). d = Function fi ⇒ P (Function (fi with <|name := fperm_name f g fi.name; body := fperm f g fi.body|>))) decs ⇒ EVERY P (fperm_decs f g decs)
LESS_MULT_MONO_prime_typed=(0 :num) < (a :num) ⇒ (a * (m :num) < a * (n :num) ⇔ m < n)
LUB_IMAGE_SUC_typed=(∀(x :num). LPREFIX ((f :num -> α llist) x) (f (SUC x))) ⇒ LUB (IMAGE f 𝕌(:num)) = LUB (IMAGE (f ∘ SUC) 𝕌(:num))
MEM_functions_typed=∀(decs :α decl list). MEM (t :mlstring # (mlstring # shape) list # α prog # shape) (functions decs) ⇒ ∃(fi :α fun_decl). MEM (Function fi) decs ∧ t = (fi.name,fi.params,fi.body,fi.return)
compile_decls_append_IMP_typed=compile_decs (ctxt :α context) ((decs :α decl list) ++ (decs' :α decl list)) = (X :α prog list # α decl list # α decl list # α context) ⇒ (let ((decls :α prog list),(funs :α decl list),(exns :α decl list),(ctxt' :α context)) = compile_decs ctxt decs; ((decls' :α prog list),(funs' :α decl list),(exns' :α decl list),(ctxt'' :α context)) = compile_decs ctxt' decs' in (decls ++ decls',funs ++ funs',exns ++ exns',ctxt'') = X)
compile_top_shape_wf_typed=evaluate_decls (s :(α, β) state) (code :α decl list) = SOME (s' :(α, β) state) ∧ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) code ⇒ EVERY (λ(d :α decl). ∀(fi :α fun_decl). d = Function fi ⇒ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) fi.params ∧ is_wf_shape s.structs fi.return) (compile_top code (start :mlstring))
compile_top_shape_wf_nil_typed=evaluate_decls (s :(α, β) state) (code :α decl list) = SOME (s' :(α, β) state) ∧ s.structs = ([] :(mlstring # struct_info) list) ∧ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) code ⇒ EVERY (λ(d :α decl). ∀(fi :α fun_decl). d = Function fi ⇒ EVERY (is_wf_shape_nil ∘ (SND :mlstring # shape -> shape)) fi.params ∧ is_wf_shape_nil fi.return) (compile_top code (start :mlstring))
eval_state_rel_is_wf_shape_typed=eval (s :(α, β) state) (exp :α exp) = SOME (v :α v) ∧ (state_rel (b :bool) (ctxt :α context) s (t :(α, β) state) :bool) ∧ FEVERY (λ((nm :mlstring),(v :α v)). is_wf_shape_v s.structs v) s.locals ⇒ is_wf_shape_nil (shape_of v)
evaluate_decls_functions_wf_typed=∀(s :(α, β) state) (decs :α decl list). evaluate_decls s decs = SOME (s' :(α, β) state) ∧ MEM (Function (fi :α fun_decl)) decs ∧ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) decs ⇒ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) fi.params ∧ is_wf_shape s.structs fi.return
evaluate_decls_one_fun_last_typed=∀(s :(α, β) state). is_function (y :α decl) ∧ EVERY (λ(d :α decl). case d of Function v8 => F | Decl v9 v10 v11 => T | (ExnDecl v12 v13 :α decl) => T | (Name v14 v15 :α decl) => F) (xs :α decl list) ⇒ evaluate_decls s (xs ++ [y]) = evaluate_decls s (y::xs)
evaluate_decls_only_functions_SOME_typed=∀(s :(α, β) state) (pan_code :α decl list). EVERY (is_function :α decl -> bool) pan_code ∧ EVERY (λ(d :α decl). ∀(fi :α fun_decl). d = Function fi ⇒ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) fi.params ∧ is_wf_shape s.structs fi.return) pan_code ⇒ evaluate_decls s pan_code = SOME (s with code := s.code |++ functions pan_code)
evaluate_decls_only_functions_and_exns_SOME_typed=∀(s :(α, β) state) (pan_code :α decl list). EVERY (λ(d :α decl). is_function d ∨ is_exn_decl d) pan_code ∧ EVERY (λ(d :α decl). ∀(fi :α fun_decl). d = Function fi ⇒ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) fi.params ∧ is_wf_shape s.structs fi.return) pan_code ∧ ALL_DISTINCT (MAP (FST :mlstring # shape -> mlstring) (exceptions pan_code)) ∧ EVERY (λ((eid :mlstring),(sh :shape)). FLOOKUP s.eshapes eid = (NONE :shape option)) (exceptions pan_code) ∧ EVERY (is_wf_shape s.structs ∘ (SND :mlstring # shape -> shape)) (exceptions pan_code) ⇒ evaluate_decls s pan_code = SOME (s with <|code := s.code |++ functions pan_code; eshapes := s.eshapes |++ exceptions pan_code|>)
evaluate_two_typed=∀(z1 :mlstring) (v1 :α v) (z2 :mlstring) (v2 :α v) (p :α prog) (s :(α, β) state) (res :α result option) (s' :(α, β) state). ¬MEM z1 (free_var_ids p) ∧ ¬MEM z2 (free_var_ids p) ∧ (evaluate (p,s) :α result option # (α, β) state) = (res,s') ⇒ ∃(locals :mlstring |-> α v). (evaluate (p,s with locals := s.locals⟨z2 ↦ v2; z1 ↦ v1⟩) :α result option # (α, β) state) = (res,s' with locals := locals) ∧ (good_res res ∧ res ≠ SOME (Error :α result) ⇒ locals = s'.locals⟨z2 ↦ v2; z1 ↦ v1⟩)
evaluate_two_fresh_locals_typed=∀(z1 :mlstring) (v1 :α v) (z2 :mlstring) (v2 :α v) (p :α prog) (s :(α, β) state) (res :α result option) (s' :(α, β) state). ¬MEM z1 (free_var_ids p) ∧ ¬MEM z2 (free_var_ids p) ∧ (evaluate (p,s) :α result option # (α, β) state) = (res,s') ⇒ ∃(locals :mlstring |-> α v). (evaluate (p,s with locals := s.locals⟨z2 ↦ v2; z1 ↦ v1⟩) :α result option # (α, β) state) = (res,s' with locals := locals) ∧ (good_res res ∧ res ≠ SOME (Error :α result) ⇒ locals = s'.locals⟨z2 ↦ v2; z1 ↦ v1⟩)
functions_filter_nil_typed=∀(decls :α decl list). functions (FILTER ($¬ ∘ (is_function :α decl -> bool)) decls) = ([] :(mlstring # (mlstring # shape) list # α prog # shape) list)
map_pick_up_first_typed=MAP (FST :α # β # γ # δ -> α) (MAP (λ((x :ε),(y :ζ),(z :η),(t :θ)). ((f1 :ε -> α) x,(f2 :ζ -> β) y,(f3 :η -> γ) z,(f4 :θ -> δ) t)) (l :(ε # ζ # η # θ) list)) = MAP f1 (MAP (FST :ε # ζ # η # θ -> ε) l)
num_cases_lemma_typed=$! (P :num -> bool) ⇒ P (0 :num) ∧ ∀(x :num). P (SUC x)
resort_decls_evaluate_IMP_typed=evaluate_decls (s :(α, β) state) (decs :α decl list) = SOME (s' :(α, β) state) ∧ EVERY (λ(d :α decl). is_function d ∨ is_decl d ∨ is_exn_decl d) decs ⇒ evaluate_decls s (resort_decls decs) = SOME s'
state_rel_dec_clock_typed=(state_rel (ls :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ⇒ (state_rel ls ctxt (dec_clock s) (dec_clock t) :bool)
state_rel_globals_wf_typed=FLOOKUP (ctxt :α context).globals (nm :mlstring) = SOME (x :shape # α word) ∧ (state_rel (ls :bool) ctxt (s :(α, β) state) (t :(α, β) state) :bool) ⇒ is_wf_shape_nil (FST x)
state_rel_res_var_typed=(state_rel (l :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ∧ (state_rel T ctxt (s' :(α, γ) state) (t' :(α, γ) state) :bool) ⇒ (state_rel l ctxt (s with locals := res_var s.locals ((v :mlstring),FLOOKUP s'.locals (v' :mlstring))) (t with locals := res_var t.locals (v,FLOOKUP t'.locals v')) :bool)
state_rel_structs_typed=(state_rel (ls :bool) (ctxt :α context) (s :(α, β) state) (t :(α, β) state) :bool) ⇒ s.structs = ([] :(mlstring # struct_info) list) ∧ t.structs = ([] :(mlstring # struct_info) list)
tuple_4_o_typed=(λ((x :ι),(y :κ),(z :'k),(t :μ)). ((f1 :ι -> ε) x,(f2 :κ -> ζ) y,(f3 :'k -> η) z,(f4 :μ -> θ) t)) ∘ (λ((x :α),(y :β),(z :γ),(t :δ)). ((g1 :α -> ι) x,(g2 :β -> κ) y,(g3 :γ -> 'k) z,(g4 :δ -> μ) t)) = (λ((x :α),(y :β),(z :γ),(t :δ)). (f1 (g1 x),f2 (g2 y),f3 (g3 z),f4 (g4 t)))
v_neq_v_prime_typed=(v :mlstring) ≠ v ^ «'»
