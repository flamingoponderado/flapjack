IMP_code_rel_typed=EVERY (λ((n :num),(p :α stackLang$prog)). reg_bound p (k :num) ∧ num_stubs ≤ n + (1 :num)) (code1 :(num # α stackLang$prog) list) ∧ (code2 :α stackLang$prog sptree$num_map) = fromAList (compile (jump :bool) (off :α word # α word) (gen_gc :bool) (max_heap :num) k (start :num) code1 :(num # α stackLang$prog) list) ⇒ code_rel jump off k (fromAList code1) code2
INSERT_DELETE_EQ_DELETE_typed=((x :α) INSERT (s :α -> bool)) DELETE x = s DELETE x
IN_addresses_typed=∀(n :num) (a :α word) (x :α word). x ∈ addresses a n ⇔ ∃(i :num). i < n ∧ x = a + (n2w i :α word) * (bytes_in_word :α word)
MAP_mem_val_MAP_INL_typed=∀(ws :α word list) (f :num |-> α word_loc). MAP (mem_val f) (MAP (INL :α word -> α word + num) ws) = MAP (Word :α word -> α word_loc) ws
MOD_EQ_IMP_MULT_typed=∀(n :num) (d :num). n MOD d = (0 :num) ∧ d ≠ (0 :num) ⇒ ∃(k :num). n = d * k
MOD_LESS_EQ_MOD_IMP_typed=(m :num) MOD (k :num) ≤ (n :num) ∧ m < k ⇒ m ≤ n
assoc_lem_typed=(A :(α -> bool) -> bool) * (B :(α -> bool) -> bool) * (C :(α -> bool) -> bool) = B * C * A
evaluate_downshift_typed=∀(r :num) (n :num) (st :(α, β, γ) stackSem$state) (w :α word). FLOOKUP st.regs r = SOME (Word w) ⇒ (evaluate ((downshift r n :α stackLang$prog),st) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),st with regs := st.regs⟨r ↦ Word (w − (word_offset n :α word))⟩)
evaluate_init_code_clock_typed=(evaluate ((init_code (gen_gc :bool) (max_heap :num) (k :num) :α stackLang$prog),(s :(α, β, γ) stackSem$state)) :α stackSem$result option # (α, β, γ) stackSem$state) = ((res :α stackSem$result option),(t :(α, β, γ) stackSem$state)) ⇒ (evaluate ((init_code gen_gc max_heap k :α stackLang$prog),s with clock := (c :num)) :α stackSem$result option # (α, β, γ) stackSem$state) = (res,t with clock := c)
evaluate_upshift_typed=∀(r :num) (n :num) (st :(α, β, γ) stackSem$state) (w :α word). FLOOKUP st.regs r = SOME (Word w) ⇒ (evaluate ((upshift r n :α stackLang$prog),st) :α stackSem$result option # (α, β, γ) stackSem$state) = ((NONE :α stackSem$result option),st with regs := st.regs⟨r ↦ Word (w + (word_offset n :α word))⟩)
find_code_lemma_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state) ∧ (case (dest :num + num) of (INL v2 :num + num) => T | (INR i :num + num) => i < k) ∧ (find_code dest s.regs s.code :α stackLang$prog option) = SOME (x :α stackLang$prog) ⇒ (find_code dest t1.regs t1.code :α stackLang$prog option) = SOME (comp jump off k x :α stackLang$prog) ∧ reg_bound x k
find_code_lemma2_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t1 :(α, β, γ) stackSem$state) ∧ (case (dest :num + num) of (INL v2 :num + num) => T | (INR i :num + num) => i < k) ∧ (find_code dest (s.regs \\ (x1 :num)) s.code :α stackLang$prog option) = SOME (x :α stackLang$prog) ⇒ (find_code dest (t1.regs \\ x1) t1.code :α stackLang$prog option) = SOME (comp jump off k x :α stackLang$prog) ∧ reg_bound x k
fmap_simp_lemma1_typed=(g :num |-> α)⟨(0 :num) ↦ (z :α); (5 :num) ↦ (y :α); (0 :num) ↦ (x :α)⟩ = g⟨(5 :num) ↦ y; (0 :num) ↦ z⟩
get_labels_downshift_typed=∀(n :num) (n0 :num). get_labels (downshift n n0 :α stackLang$prog) = (∅ :num # num -> bool)
get_labels_stack_alloc_typed=∀(jump :bool) (k :num) (n :num). get_labels (stack_alloc jump k n :α stackLang$prog) = (∅ :num # num -> bool)
get_labels_stack_free_typed=∀(k :num) (n :num). get_labels (stack_free k n :α stackLang$prog) = (∅ :num # num -> bool)
get_labels_upshift_typed=∀(n :num) (n0 :num). get_labels (upshift n n0 :α stackLang$prog) = (∅ :num # num -> bool)
get_stack_heap_limit_prime_prime_def_typed=∀(h2 :num) (h3 :num) (h4 :num). get_stack_heap_limit'' h2 h3 h4 = (h4 − h3 − LENGTH store_list,(h3 − h2) DIV (2 :num))
get_stack_heap_limit_prime_def_typed=∀(max_heap :num) (p2 :β word) (p3 :γ word) (p4 :α word). get_stack_heap_limit' max_heap p2 p3 p4 = (let (ptr2 :num) = w2n p2; (ptr3 :num) = w2n p3; (ptr4 :num) = w2n p4; (d :num) = dimindex (:α) DIV (8 :num); (max_heap_w :α word) = if max_heap * w2n (bytes_in_word :α word) < dimword (:α) then (bytes_in_word :α word) * (n2w max_heap :α word) else -(1w :α word); (reg3 :α word) = (n2w ptr2 :α word) + (-(1w :α word) * (n2w ptr2 :α word) + if max_heap_w <₊ -(1w :α word) * (n2w ptr2 :α word) + (n2w ptr3 :α word) then max_heap_w + (n2w ptr2 :α word) else (n2w ptr3 :α word)) ⋙ (shift (:α) + (1 :num)) ≪ (shift (:α) + (1 :num)) in get_stack_heap_limit'' (ptr2 DIV d) (w2n reg3 DIV d) (ptr4 DIV d))
init_reduce_stack_space_typed=(init_reduce (gen_gc :bool) (jump :bool) (off :α word # α word) (k :num) (code :α stackLang$prog sptree$num_map) (bitmaps :α word list) (data_sp :num) (coracle :num -> β # (num # α stackLang$prog) list # α word list) (s8 :(α, β, γ) stackSem$state)).stack_space ≤ LENGTH (init_reduce gen_gc jump off k code bitmaps data_sp coracle s8).stack
mem_load_32_IMP_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ mem_load_32 s.memory s.mdomain s.be (a :α word) = SOME (x :word32) ⇒ mem_load_32 t.memory t.mdomain t.be a = SOME x
mem_load_byte_aux_IMP_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ mem_load_byte_aux s.memory s.mdomain s.be (a :α word) = SOME (x :word8) ⇒ mem_load_byte_aux t.memory t.mdomain t.be a = SOME x
mem_load_lemma_typed=MEM (name :store_name) store_list ∧ FLOOKUP (s :(α, γ, β) stackSem$state).store name = SOME (x :α word_loc) ∧ (memory s.memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP (Word :α word -> α word_loc) s.bitmaps ++ MAP (Word :α word -> α word_loc) s.data_buffer.buffer) * (word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + (bytes_in_word :α word) * (n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps) :α word)) s.data_buffer.space_left :(α word # α word_loc -> bool) -> bool) * word_store (c :α word) s.store * word_list c s.stack) (fun2set ((t1 :(α, γ, β) stackSem$state).memory,t1.mdomain)) ⇒ mem_load (c + (store_offset name :α word)) t1 = SOME x
mem_load_lemma2_typed=MEM (name :store_name) store_list ∧ (memory (s :(α, δ, ε) stackSem$state).memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP (Word :α word -> α word_loc) s.bitmaps ++ MAP (Word :α word -> α word_loc) s.data_buffer.buffer) * (word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + (bytes_in_word :α word) * (n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps) :α word)) s.data_buffer.space_left :(α word # α word_loc -> bool) -> bool) * word_store (c :α word) s.store * word_list c s.stack) (fun2set ((t1 :(α, γ, β) stackSem$state).memory,t1.mdomain)) ⇒ c + (store_offset name :α word) ∈ t1.mdomain
memory_addresses_typed=∀(n :num) (a :α word) (m :α word -> α word_loc). n * (dimindex (:α) DIV (8 :num)) < dimword (:α) ∧ good_dimindex (:α) ⇒ memory m (addresses a n) = word_list a (read_mem a m n)
memory_fun2set_IMP_read_typed=(memory (m :α -> β) (d :α -> bool) * (p :(α # β -> bool) -> bool)) (fun2set ((m1 :α -> β),(d1 :α -> bool))) ∧ (a :α) ∈ d ⇒ a ∈ d1 ∧ m1 a = m a
name_cases_typed=∀(name :store_name). name ≠ CurrHeap ⇒ MEM name store_list
read_bytearray_IMP_read_bytearray_typed=∀(n :num) (a :α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) (x :word8 list). state_rel (jump :bool) (off :α word # α word) k s t ∧ read_bytearray a n (mem_load_byte_aux s.memory s.mdomain s.be) = SOME x ⇒ read_bytearray a n (mem_load_byte_aux t.memory t.mdomain t.be) = SOME x
star_move_lemma_typed=(p0 :(α -> bool) -> bool) * (p1 :(α -> bool) -> bool) * (p1' :(α -> bool) -> bool) * (p2 :(α -> bool) -> bool) * (p3 :(α -> bool) -> bool) * (p4 :(α -> bool) -> bool) = p2 * (p1 * p1' * (p3 * (p4 * p0)))
state_rel_get_var_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ (n :num) < k ⇒ (get_var n s :α word_loc option) = (get_var n t :α word_loc option)
state_rel_read_typed=state_rel (jump :bool) (off :α word # α word) (k :num) (s :(α, β, γ) stackSem$state) (t :(α, β, γ) stackSem$state) ∧ (a :α word) ∈ s.mdomain ⇒ a ∈ t.mdomain ∧ t.memory a = s.memory a
store_write_lemma_typed=MEM (name :store_name) store_list ∧ (memory (s :(β, γ, δ) stackSem$state).memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP (Word :β word -> β word_loc) s.bitmaps ++ MAP (Word :β word -> β word_loc) s.data_buffer.buffer) * (word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + (bytes_in_word :β word) * (n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps) :β word)) s.data_buffer.space_left :(β word # β word_loc -> bool) -> bool) * word_store (c :β word) s.store * word_list c s.stack) (fun2set ((m :β word -> β word_loc),(d :β word -> bool))) ⇒ (memory s.memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP (Word :β word -> β word_loc) s.bitmaps ++ MAP (Word :β word -> β word_loc) s.data_buffer.buffer) * (word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + (bytes_in_word :β word) * (n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps) :β word)) s.data_buffer.space_left :(β word # β word_loc -> bool) -> bool) * word_store c s.store⟨name ↦ (x :β word_loc)⟩ * word_list c s.stack) (fun2set (m⦇c + (store_offset name :β word) ↦ x⦈,d))
word_list_IMP_read_mem_typed=∀(xs :α list) (a :β word) (p :(β word # α -> bool) -> bool). (p * word_list a xs) (fun2set ((m :β word -> α),(dm :β word -> bool))) ⇒ read_mem a m (LENGTH xs) = xs
word_list_and_rev_join_lemma_typed=(b :α word) = (a :α word) + (n2w (LENGTH (xs :β list) + LENGTH (ys :β list)) :α word) * (bytes_in_word :α word) ∧ ((p :(α word # β -> bool) -> bool) * word_list a (xs ++ REVERSE ys) * (q :(α word # β -> bool) -> bool)) (ss :α word # β -> bool) ∧ (b1 :bool) ⇒ (p * word_list a xs * word_list_rev b ys * q) ss ∧ b1
word_store_CurrHeap_typed=word_store (base :α word) (s :(β, γ, δ) stackSem$state).store⟨CurrHeap ↦ (x :β word_loc)⟩ = word_store base s.store
write_bytearray_EQ_typed=∀(new_bytes :word8 list) (a :α word) (m1 :α word -> α word_loc) (m :α word -> α word_loc) (y :word8 list) (x :α word). (d1 :α word -> bool) ⊆ (d :α word -> bool) ∧ (∀(a :α word). a ∈ d1 ⇒ m1 a = m a ∧ a ∈ d) ∧ read_bytearray a (LENGTH new_bytes) (mem_load_byte_aux m1 d1 (be :bool)) = SOME y ∧ m1 x = m x ⇒ write_bytearray a new_bytes m1 d1 be x = write_bytearray a new_bytes m d be x
write_bytearray_IGNORE_typed=∀(new_bytes :word8 list) (a :α word) (x :word8 list) (xx :α word). (d1 :α word -> bool) ⊆ (d :α word -> bool) ∧ read_bytearray a (LENGTH new_bytes) (mem_load_byte_aux (m1 :α word -> α word_loc) d1 (be :bool)) = SOME x ∧ xx ∉ d1 ⇒ write_bytearray a new_bytes (m :α word -> α word_loc) d be xx = m xx
write_bytearray_IGNORE_non_aligned_typed=∀(new_bytes :word8 list) (a :α word). (∀(x :α word). (b :α word) ≠ byte_align x) ⇒ write_bytearray a new_bytes (m :α word -> α word_loc) (d :α word -> bool) (be :bool) b = m b
write_bytearray_lemma_typed=∀(new_bytes :word8 list) (a :α word) (m1 :α word -> α word_loc) (d1 :α word -> bool) (be :bool) (x :word8 list) (p :(α word # α word_loc -> bool) -> bool) (m :α word -> α word_loc) (d :α word -> bool). (memory m1 d1 * p) (fun2set (m,d)) ∧ read_bytearray a (LENGTH new_bytes) (mem_load_byte_aux m1 d1 be) = SOME x ⇒ (memory (write_bytearray a new_bytes m1 d1 be) d1 * p) (fun2set (write_bytearray a new_bytes m d be,d))
