(* Typed captures of every exported theorem and definition of the HOL
   multiword and mc_multiword libraries (HOL/examples/machine-code/multiword),
   for the bottom-up Lean port beneath Flapjack/Misc/Multiword. Each label is
   the theory name, an underscore, the exported name and `_typed`. *)
load "multiwordTheory";
load "mc_multiwordTheory";
open HolKernel Parse boolLib bossLib;
val _ = Globals.linewidth := 1000000;
val _ = show_types := true;

fun emit label th = (print (label ^ "=");
  app (fn h => (print_term h; print " ==> ")) (hyp th);
  print_term (concl th); print "\n");

