load "preamble"; load "word_cseProofTheory";
open HolKernel Parse bossLib preamble word_cseProofTheory word_cseTheory wordSemTheory;
val _ = Globals.linewidth := 2000;
val replay_any = prove(``∀op r0 a ofs w s r.
    ¬is_store op ∧
    evaluate (Inst (Mem op r0 (Addr a ofs)), s) = (NONE, set_var r0 w s) ⇒
    evaluate (Inst (Mem op r (Addr a ofs)), s) = (NONE, set_var r w s)``, rpt strip_tac \\ Cases_on ‘op’
  \\ gvs [is_store_def, evaluate_def, inst_def, AllCaseEqs(), set_var_def,
          insert_eq]);
val _ = (if null(hyp replay_any) then () else raise Fail "open replay premise"; print "ld_full_any="; print_thm replay_any; print "\n");
val replay_write = prove(``∀op r a ofs n u w s.
    ¬is_store op ∧ a ≠ n ⇒
    (evaluate (Inst (Mem op r (Addr a ofs)), set_var n u s) =
       (NONE, set_var r w (set_var n u s)) ⇔
     evaluate (Inst (Mem op r (Addr a ofs)), s) = (NONE, set_var r w s))``, rpt strip_tac
  \\ Cases_on ‘op’ \\ gvs [is_store_def]
  \\ gvs [evaluate_def, inst_def, word_exp_def, the_words_def, set_var_def,
          lookup_insert, mem_load_def, get_var_def]
  >- (Cases_on ‘lookup a s.locals’ \\ gvs []
      \\ Cases_on ‘x’ \\ gvs [wordLangTheory.word_op_def]
      \\ IF_CASES_TAC \\ gvs [state_component_equality, insert_eq])
  \\ Cases_on ‘lookup a s.locals’ \\ gvs []
  \\ Cases_on ‘x’ \\ gvs [wordLangTheory.word_op_def]
  \\ TOP_CASE_TAC
  \\ gvs [AllCaseEqs()] \\ gvs [state_component_equality, insert_eq]);
val _ = (if null(hyp replay_write) then () else raise Fail "open replay premise"; print "ld_full_write="; print_thm replay_write; print "\n");
val replay_addr = prove(``∀op r a a' ofs w (s:('a,'c,'ffi) wordSem$state).
    ¬is_store op ∧
    lookup a' s.locals = lookup a s.locals ∧
    evaluate (Inst (Mem op r (Addr a ofs)), s) = (NONE, set_var r w s) ⇒
    evaluate (Inst (Mem op r (Addr a' ofs)), s) = (NONE, set_var r w s)``, rpt strip_tac \\ Cases_on ‘op’
  \\ gvs [is_store_def, evaluate_def, inst_def, word_exp_def, the_words_def,
          get_var_def, AllCaseEqs()]);
val _ = (if null(hyp replay_addr) then () else raise Fail "open replay premise"; print "ld_full_addr="; print_thm replay_addr; print "\n");
fun typ label q = (print(label ^ "="); print_type(type_of q); print "\n");
val _ = typ "ld_type_state" ``(s:('a,'c,'ffi)wordSem$state)``;
val _ = typ "ld_type_word" ``(ofs:'a word)``;
val _ = typ "ld_type_value" ``(w:'a word_loc)``;
val _ = typ "ld_type_op" ``(op:memop)``;
fun proved label q tac = let val th = prove(q,tac) in if null(hyp th) then () else raise Fail "open application premise"; print(label ^ "="); print_thm th; print "\n" end;
val _ = proved "ld_any_load_98_1" ``! (w:1 word_loc) (s:(1,'c,'ffi)wordSem$state). evaluate (Inst (Mem Load 99 (Addr 3 (-1w:1 word))),s) = (NONE,set_var 99 w s) ==> evaluate (Inst (Mem Load 98 (Addr 3 (-1w:1 word))),s) = (NONE,set_var 98 w s)`` (rpt strip_tac >> match_mp_tac replay_any >> qexists_tac `99` >> simp[is_store_def]);
