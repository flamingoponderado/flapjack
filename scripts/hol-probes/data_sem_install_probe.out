v_to_bytes=∀(lv :v). v_to_bytes lv = some(ns :word8 list). v_to_list lv = SOME (MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns)
v_to_words=∀(lv :v). v_to_words lv = some(ns :word64 list). v_to_list lv = SOME (MAP Word64 ns)
do_install=∀(vs :v list) (s :(γ, 'ffi) state). (do_install vs s :(v # (γ, 'ffi) state, α) result) = case vs of ([] :v list) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | [v1] => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | [v1; v2] => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | [v1; v2; vl1] => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | [v1; v2; vl1; vl2] => (case (v_to_bytes v1,v_to_words v2) of ((NONE :word8 list option),v5) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | (SOME bytes,(NONE :word64 list option)) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | (SOME bytes,SOME data) => if vl1 ≠ (Number ((&LENGTH bytes) :int) :v) ∨ vl2 ≠ (Number ((&LENGTH data) :int) :v) then (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) else (let ((cfg :γ),(progs :(num # num # dataLang$prog) list)) = (s.compile_oracle (0 :num) :γ # (num # num # dataLang$prog) list); (new_oracle :num -> γ # (num # num # dataLang$prog) list) = shift_seq (1 :num) s.compile_oracle in case (s.compile cfg progs,progs) of (v2,([] :(num # num # dataLang$prog) list)) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | ((NONE :(word8 list # word64 list # γ) option),v6::v7) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | (SOME (bytes',data',cfg'),(k,prog)::v7) => if bytes = bytes' ∧ data = data' ∧ FST (new_oracle (0 :num)) = cfg' then (let (s' :(γ, 'ffi) state) = s with <|safe_for_space := F; code := (union s.code (fromAList progs) :(num # dataLang$prog) sptree$num_map); compile_oracle := new_oracle|> in (Rval ((CodePtr k :v),s') :(v # (γ, 'ffi) state, α) result)) else (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result))) | v1::v2::vl1::vl2::v27::v28 => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result)
do_app=∀(op :closLang$op) (vs :v list) (s :(γ, 'ffi) state). (do_app op vs s :(v # (γ, 'ffi) state, v) result) = if op = Install then (do_install vs (s with <|stack_max := (NONE :num option); stack_frame_sizes := (LN :num sptree$num_map)|>) :(v # (γ, 'ffi) state, v) result) else if MEM op [IntOp Greater; IntOp GreaterEq] then (Rerr (Rabort Rtype_error :v error_result) :(v # (γ, 'ffi) state, v) result) else case do_space op vs s of (NONE :(γ, 'ffi) state option) => (Rerr (Rabort Rtype_error :v error_result) :(v # (γ, 'ffi) state, v) result) | SOME s1 => do_app_aux op vs (do_stack op vs (do_lim_safe s1 op vs))
install_bad_arity=(do_install ([] :v list) (s :(γ, 'ffi) state) :(v # (γ, 'ffi) state, α) result) = (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result)
greater_rejected=(do_app (IntOp Greater) ([] :v list) (s :(γ, 'ffi) state) :(v # (γ, 'ffi) state, v) result) = (Rerr (Rabort Rtype_error :v error_result) :(v # (γ, 'ffi) state, v) result)
outer_install_bad_arity=(do_app Install ([] :v list) (s :(γ, 'ffi) state) :(v # (γ, 'ffi) state, v) result) = (Rerr (Rabort Rtype_error :v error_result) :(v # (γ, 'ffi) state, v) result)
bytes_nil=v_to_bytes Block_nil = some(ns :word8 list). ([] :v list) = MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns
words_nil=v_to_words Block_nil = some(ns :word64 list). ([] :v list) = MAP Word64 ns
