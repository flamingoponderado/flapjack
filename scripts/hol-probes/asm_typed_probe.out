architecture_typed=ARMv7::architecture; ARMv8::architecture; MIPS::architecture; RISC_V::architecture; Ag32::architecture; x86_64::architecture
asm_config_typed=recordtype.asm_config::architecture -> (α asm -> word8 list) -> bool -> num -> num option -> num list -> num -> num -> bool -> (binop + cmp -> α word -> bool) -> α word # α word -> α word # α word -> α word # α word -> α word # α word -> α word # α word -> α word # α word -> α asm_config
addr_typed=Addr::num -> α word -> α addr
<<HOL warning: Type.mk_type: more than one possibility>>
arith_typed=Add::ast$arith; Sub::ast$arith; Mul::ast$arith; Div::ast$arith; Mod::ast$arith; Neg::ast$arith; And::ast$arith; Xor::ast$arith; Or::ast$arith; Not::ast$arith; Abs::ast$arith; Sqrt::ast$arith; FMA::ast$arith
asm_typed=Inst::α inst -> α asm; Jump::α word -> α asm; JumpCmp::cmp -> num -> α reg_imm -> α word -> α asm; Call::α word -> α asm; JumpReg::num -> α asm; Loc::num -> α word -> α asm
binop_typed=Add::binop; Sub::binop; And::binop; Or::binop; Xor::binop
cmp_typed=Equal::cmp; Lower::cmp; Less::cmp; Test::cmp; NotEqual::cmp; NotLower::cmp; NotLess::cmp; NotTest::cmp
fp_typed=FPLess::num -> num -> num -> fp; FPLessEqual::num -> num -> num -> fp; FPEqual::num -> num -> num -> fp; FPAbs::num -> num -> fp; FPNeg::num -> num -> fp; FPSqrt::num -> num -> fp; FPAdd::num -> num -> num -> fp; FPSub::num -> num -> num -> fp; FPMul::num -> num -> num -> fp; FPDiv::num -> num -> num -> fp; FPFma::num -> num -> num -> fp; FPMov::num -> num -> fp; FPMovToReg::num -> num -> num -> fp; FPMovFromReg::num -> num -> num -> fp; FPToInt::num -> num -> fp; FPFromInt::num -> num -> fp
inst_typed=Skip::α inst; Const::num -> α word -> α inst; Arith::α arith -> α inst; Mem::memop -> num -> α addr -> α inst; FP::fp -> α inst
memop_typed=Load::memop; Load8::memop; Load16::memop; Load32::memop; Store::memop; Store8::memop; Store16::memop; Store32::memop
reg_imm_typed=Reg::num -> α reg_imm; Imm::α word -> α reg_imm
arith_ok_def_typed=(∀(b :binop) (r1 :num) (r2 :num) (ri :α reg_imm) (c :α asm_config). arith_ok (Binop b r1 r2 ri) c ⇔ (c.two_reg_arith ⇒ r1 = r2 ∨ b = Or ∧ ri = (Reg r2 :α reg_imm)) ∧ reg_ok r1 c ∧ reg_ok r2 c ∧ reg_imm_ok (INL b :binop + cmp) ri c) ∧ (∀(l :shift) (r1 :num) (r2 :num) (ri :α reg_imm) (c :α asm_config). arith_ok (Shift l r1 r2 ri :α arith) c ⇔ (c.two_reg_arith ⇒ r1 = r2) ∧ reg_ok r1 c ∧ reg_ok r2 c ∧ case ri of (Reg r :α reg_imm) => reg_ok r c ∧ (c.ISA = x86_64 ⇒ r = (1 :num)) | Imm i => (i = (0w :α word) ⇒ l = Lsl) ∧ w2n i < dimindex (:α)) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (c :α asm_config). arith_ok (Div r1 r2 r3 :α arith) c ⇔ reg_ok r1 c ∧ reg_ok r2 c ∧ reg_ok r3 c ∧ c.ISA ∈ {ARMv8; MIPS; RISC_V}) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (c :α asm_config). arith_ok (LongMul r1 r2 r3 r4 :α arith) c ⇔ reg_ok r1 c ∧ reg_ok r2 c ∧ reg_ok r3 c ∧ reg_ok r4 c ∧ (c.ISA = x86_64 ⇒ r1 = (2 :num) ∧ r2 = (0 :num) ∧ r3 = (0 :num)) ∧ (c.ISA = ARMv7 ⇒ r1 ≠ r2) ∧ (c.ISA ∈ {ARMv8; RISC_V; Ag32} ⇒ r1 ≠ r3 ∧ r1 ≠ r4)) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num) (c :α asm_config). arith_ok (LongDiv r1 r2 r3 r4 r5 :α arith) c ⇔ c.ISA = x86_64 ∧ r1 = (0 :num) ∧ r2 = (2 :num) ∧ r3 = (2 :num) ∧ r4 = (0 :num) ∧ reg_ok r5 c) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (c :α asm_config). arith_ok (AddCarry r1 r2 r3 r4 :α arith) c ⇔ (c.two_reg_arith ⇒ r1 = r2) ∧ reg_ok r1 c ∧ reg_ok r2 c ∧ reg_ok r3 c ∧ reg_ok r4 c ∧ (c.ISA = MIPS ∨ c.ISA = RISC_V ⇒ r1 ≠ r3 ∧ r1 ≠ r4)) ∧ (∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (c :α asm_config). arith_ok (AddOverflow r1 r2 r3 r4 :α arith) c ⇔ (c.two_reg_arith ⇒ r1 = r2) ∧ reg_ok r1 c ∧ reg_ok r2 c ∧ reg_ok r3 c ∧ reg_ok r4 c ∧ (c.ISA = MIPS ∨ c.ISA = RISC_V ⇒ r1 ≠ r3)) ∧ ∀(r1 :num) (r2 :num) (r3 :num) (r4 :num) (c :α asm_config). arith_ok (SubOverflow r1 r2 r3 r4 :α arith) c ⇔ (c.two_reg_arith ⇒ r1 = r2) ∧ reg_ok r1 c ∧ reg_ok r2 c ∧ reg_ok r3 c ∧ reg_ok r4 c ∧ (c.ISA = MIPS ∨ c.ISA = RISC_V ⇒ r1 ≠ r3)
cmp_ok_def_typed=∀(cmp :cmp) (r :num) (ri :α reg_imm) (c :α asm_config). cmp_ok cmp r ri c ⇔ reg_ok r c ∧ reg_imm_ok (INR cmp :binop + cmp) ri c
fp_ok_def_typed=(∀(r :num) (d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPLess r d1 d2) c ⇔ reg_ok r c ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(r :num) (d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPLessEqual r d1 d2) c ⇔ reg_ok r c ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(r :num) (d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPEqual r d1 d2) c ⇔ reg_ok r c ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPAbs d1 d2) c ⇔ (c.two_reg_arith ⇒ d1 ≠ d2) ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPNeg d1 d2) c ⇔ (c.two_reg_arith ⇒ d1 ≠ d2) ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPSqrt d1 d2) c ⇔ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (c :α asm_config). fp_ok (FPAdd d1 d2 d3) c ⇔ (c.two_reg_arith ⇒ d1 = d2) ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c ∧ fp_reg_ok d3 c) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (c :α asm_config). fp_ok (FPSub d1 d2 d3) c ⇔ (c.two_reg_arith ⇒ d1 = d2) ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c ∧ fp_reg_ok d3 c) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (c :α asm_config). fp_ok (FPMul d1 d2 d3) c ⇔ (c.two_reg_arith ⇒ d1 = d2) ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c ∧ fp_reg_ok d3 c) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (c :α asm_config). fp_ok (FPDiv d1 d2 d3) c ⇔ (c.two_reg_arith ⇒ d1 = d2) ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c ∧ fp_reg_ok d3 c) ∧ (∀(d1 :num) (d2 :num) (d3 :num) (c :α asm_config). fp_ok (FPFma d1 d2 d3) c ⇔ c.ISA = ARMv7 ∧ (2 :num) < c.fp_reg_count ∧ fp_reg_ok d1 c ∧ fp_reg_ok d2 c ∧ fp_reg_ok d3 c) ∧ (∀(d1 :num) (d2 :num) (c :α asm_config). fp_ok (FPMov d1 d2) c ⇔ fp_reg_ok d1 c ∧ fp_reg_ok d2 c) ∧ (∀(r1 :num) (r2 :num) (d :num) (c :α asm_config). fp_ok (FPMovToReg r1 r2 d) c ⇔ reg_ok r1 c ∧ (dimindex (:α) = (32 :num) ⇒ r1 ≠ r2 ∧ reg_ok r2 c) ∧ fp_reg_ok d c) ∧ (∀(d :num) (r1 :num) (r2 :num) (c :α asm_config). fp_ok (FPMovFromReg d r1 r2) c ⇔ reg_ok r1 c ∧ (dimindex (:α) = (32 :num) ⇒ r1 ≠ r2 ∧ reg_ok r2 c) ∧ fp_reg_ok d c) ∧ (∀(r :num) (d :num) (c :α asm_config). fp_ok (FPToInt r d) c ⇔ fp_reg_ok r c ∧ fp_reg_ok d c) ∧ ∀(d :num) (r :num) (c :α asm_config). fp_ok (FPFromInt d r) c ⇔ fp_reg_ok r c ∧ fp_reg_ok d c
fp_reg_ok_def_typed=∀(d :num) (c :α asm_config). fp_reg_ok d c ⇔ d < c.fp_reg_count
inst_ok_def_typed=(inst_ok (Skip :α inst) (c :α asm_config) ⇔ T) ∧ (inst_ok (Const (r :num) (w :α word)) c ⇔ reg_ok r c) ∧ (inst_ok (Arith (x' :α arith) :α inst) c ⇔ arith_ok x' c) ∧ (inst_ok (FP (x :fp) :α inst) c ⇔ fp_ok x c) ∧ (inst_ok (Mem (m :memop) (r1 :num) (Addr (r2 :num) w)) c ⇔ reg_ok r1 c ∧ reg_ok r2 c ∧ if m ∈ {Load; Store; Load32; Store32} then addr_offset_ok c w else if m ∈ {Load16; Store16} then hw_offset_ok c w ∧ c.ISA ≠ Ag32 else byte_offset_ok c w)
is_load_def_typed=(is_load Load ⇔ T) ∧ (is_load Load8 ⇔ T) ∧ (is_load Load16 ⇔ T) ∧ (is_load Load32 ⇔ T) ∧ (is_load Store ⇔ F) ∧ (is_load Store8 ⇔ F) ∧ (is_load Store16 ⇔ F) ∧ (is_load Store32 ⇔ F)
offset_ok_def_typed=∀(a :num) (offset :α word # α word) (w :α word). offset_ok a offset w ⇔ (let ((min :α word),(max :α word)) = offset in min ≤ w ∧ w ≤ max ∧ aligned a w)
asm_ok_def_typed=(∀(i :α inst) (c :α asm_config). asm_ok (Inst i) c ⇔ inst_ok i c) ∧ (∀(w :α word) (c :α asm_config). asm_ok (Jump w) c ⇔ jump_offset_ok c w) ∧ (∀(cmp :cmp) (r :num) (ri :α reg_imm) (w :α word) (c :α asm_config). asm_ok (JumpCmp cmp r ri w) c ⇔ cjump_offset_ok c w ∧ cmp_ok cmp r ri c) ∧ (∀(w :α word) (c :α asm_config). asm_ok (Call w) c ⇔ (case c.link_reg of (NONE :num option) => F | SOME r => reg_ok r c) ∧ jump_offset_ok c w) ∧ (∀(r :num) (c :α asm_config). asm_ok (JumpReg r :α asm) c ⇔ reg_ok r c) ∧ ∀(r :num) (w :α word) (c :α asm_config). asm_ok (Loc r w) c ⇔ reg_ok r c ∧ loc_offset_ok c w
reg_imm_ok_def_typed=(∀(b :binop + cmp) (r :num) (c :α asm_config). reg_imm_ok b (Reg r :α reg_imm) c ⇔ reg_ok r c) ∧ ∀(b :binop + cmp) (w :α word) (c :α asm_config). reg_imm_ok b (Imm w) c ⇔ b = (INL Xor :binop + cmp) ∧ w = -(1w :α word) ∨ c.valid_imm b w
reg_ok_def_typed=∀(r :num) (c :α asm_config). reg_ok r c ⇔ r < c.reg_count ∧ ¬MEM r c.avoid_regs
word_cmp_def_typed=(∀(w1 :α word) (w2 :α word). word_cmp Equal w1 w2 ⇔ w1 = w2) ∧ (∀(w1 :α word) (w2 :α word). word_cmp Less w1 w2 ⇔ w1 < w2) ∧ (∀(w1 :α word) (w2 :α word). word_cmp Lower w1 w2 ⇔ w1 <₊ w2) ∧ (∀(w1 :α word) (w2 :α word). word_cmp Test w1 w2 ⇔ w1 && w2 = (0w :α word)) ∧ (∀(w1 :α word) (w2 :α word). word_cmp NotEqual w1 w2 ⇔ w1 ≠ w2) ∧ (∀(w1 :α word) (w2 :α word). word_cmp NotLess w1 w2 ⇔ ¬(w1 < w2)) ∧ (∀(w1 :α word) (w2 :α word). word_cmp NotLower w1 w2 ⇔ ¬(w1 <₊ w2)) ∧ ∀(w1 :α word) (w2 :α word). word_cmp NotTest w1 w2 ⇔ w1 && w2 ≠ (0w :α word)
