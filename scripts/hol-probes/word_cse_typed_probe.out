ALL_DISTINCT_MAP_FST_FILTER_typed=∀(l :(α # β) list) (P :α # β -> bool). ALL_DISTINCT (MAP (FST :α # β -> α) l) ⇒ ALL_DISTINCT (MAP (FST :α # β -> α) (FILTER P l))
MAP_FST_lemma_typed=∀(moves :(α # num) list). MAP (FST :α # num -> α) (MAP (λ((a :α),(b :num)). (a,canonicalRegs (data :knowledge) b)) moves) = MAP (FST :α # num -> α) moves
MAP_SND_lemma_typed=∀(moves :(α # num) list) (x :β word_loc list). get_vars (MAP (SND :α # num -> num) moves) (s :(β, γ, δ) state) = SOME x ∧ data_inv (data :knowledge) s ⇒ get_vars (MAP (SND :α # num -> num) (MAP (λ((a :α),(b :num)). (a,canonicalRegs data b)) moves)) s = SOME x
can_mem_arith_ODD_reads_typed=∀(a :α arith). can_mem_arith a ⇒ EVERY ODD (arithReads a)
canonicalArith_reads_self_or_fresh_typed=∀(data :knowledge) (a :α arith). wf_data (:α) data ∧ can_mem_arith (canonicalArith data a) ∧ (lookup (firstRegOfArith a) data.to_canonical :num option) = (NONE :num option) ⇒ EVERY (λ(w :num). (lookup w data.to_canonical :num option) = (NONE :num option) ∨ (lookup w data.to_canonical :num option) = SOME w) (arithReads (canonicalArith data a))
canonicalRegs_prime_self_or_fresh_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r1 :num) (x :num). data_inv data s ∧ (lookup r1 data.to_canonical :num option) = (NONE :num option) ⇒ (lookup (canonicalRegs' r1 data x) data.to_canonical :num option) = SOME (canonicalRegs' r1 data x) ∨ (lookup (canonicalRegs' r1 data x) data.to_canonical :num option) = (NONE :num option)
canonicalRegs_prime_self_or_fresh_wf_typed=∀(data :knowledge) (r1 :num) (x :num). wf_data (:α) data ∧ (lookup r1 data.to_canonical :num option) = (NONE :num option) ⇒ (lookup (canonicalRegs' r1 data x) data.to_canonical :num option) = SOME (canonicalRegs' r1 data x) ∨ (lookup (canonicalRegs' r1 data x) data.to_canonical :num option) = (NONE :num option)
canonicalRegs_self_or_fresh_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num). data_inv data s ⇒ (lookup (canonicalRegs data x) data.to_canonical :num option) = SOME (canonicalRegs data x) ∨ (lookup (canonicalRegs data x) data.to_canonical :num option) = (NONE :num option)
canonicalRegs_self_or_fresh_wf_typed=∀(data :knowledge) (x :num). wf_data (:α) data ⇒ (lookup (canonicalRegs data x) data.to_canonical :num option) = SOME (canonicalRegs data x) ∨ (lookup (canonicalRegs data x) data.to_canonical :num option) = (NONE :num option)
data_inv_alist_insert_locals_typed=∀(xs :num list) (ys :α word_loc list) (data :knowledge) (s :(α, γ, 'ffi) state) (l :α word_loc sptree$num_map). EVERY (λ(x :num). (lookup x data.to_canonical :num option) = (NONE :num option)) xs ⇒ (data_inv data (s with locals := alist_insert xs ys l) ⇔ data_inv data (s with locals := l))
data_inv_cons_gets_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :store_name) (h :num) (w :α word_loc). data_inv data s ∧ ALOOKUP data.gets_mem x = (NONE :num option) ∧ (lookup h data.to_canonical :num option) = SOME h ∧ FLOOKUP s.store x = SOME w ∧ get_var h s = SOME w ⇒ data_inv (data with gets_mem := (x,h)::data.gets_mem) s
data_inv_filter_gets_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :store_name). data_inv data s ⇒ data_inv (data with gets_mem := FILTER (λ((m :store_name),(n :num)). m ≠ x) data.gets_mem) s
data_inv_insert_canonical_pair_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num) (tc :num sptree$num_map) (tl :num sptree$num_map). data_inv (data with <|to_canonical := tc; to_latest := tl|>) s ∧ (lookup x tc :num option) = (NONE :num option) ∧ (lookup y (insert x y tc :num sptree$num_map) :num option) = SOME y ∧ ODD x ∧ ODD y ∧ get_var x s = get_var y s ⇒ data_inv (data with <|to_canonical := (insert x y tc :num sptree$num_map); to_latest := tl|>) s
data_inv_insert_gets_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (name :store_name) (v :num) (w :α word_loc). data_inv data s ∧ (lookup v data.to_canonical :num option) = (NONE :num option) ∧ ODD v ∧ ALOOKUP data.gets_mem name = (NONE :num option) ∧ FLOOKUP s.store name = SOME w ∧ get_var v s = SOME w ⇒ data_inv (data with <|to_canonical := (insert v v data.to_canonical :num sptree$num_map); to_latest := (insert v v data.to_latest :num sptree$num_map); gets_mem := (name,v)::data.gets_mem|>) s
data_inv_insert_instrs_Arith_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (a :α arith) (w :α word_loc). data_inv data s ∧ (lookup r data.to_canonical :num option) = SOME r ∧ can_mem_arith a ∧ in_names_set a data.to_canonical ∧ get_var r s = SOME w ∧ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s) ⇒ data_inv (data with instrs_mem := (insert listCmp (instToNumList (Arith a :α inst)) r data.instrs_mem :(num list, num) balanced_map)) s
data_inv_insert_instrs_Const_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (n :num) (w :α word). data_inv data s ∧ (lookup r data.to_canonical :num option) = SOME r ∧ (lookup r s.locals :α word_loc option) = SOME (Word w) ⇒ data_inv (data with instrs_mem := (insert listCmp (instToNumList (Const n w :α inst)) r data.instrs_mem :(num list, num) balanced_map)) s
data_inv_insert_instrs_LocValue_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (l :num). data_inv data s ∧ (lookup r data.to_canonical :num option) = SOME r ∧ (lookup r s.locals :α word_loc option) = SOME (Loc l (0 :num) :α word_loc) ⇒ data_inv (data with instrs_mem := (insert listCmp [(48 :num); l] r data.instrs_mem :(num list, num) balanced_map)) s
data_inv_insert_instrs_OpCurrHeap_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (op :binop) (src :num) (w :α word_loc). data_inv data s ∧ (lookup r data.to_canonical :num option) = SOME r ∧ (lookup src data.to_canonical :num option) = SOME src ∧ (word_exp s (Op op [(Var src :α exp); (Lookup CurrHeap :α exp)]) :α word_loc option) = SOME w ∧ get_var r s = SOME w ⇒ data_inv (data with instrs_mem := (insert listCmp (OpCurrHeapToNumList op src) r data.instrs_mem :(num list, num) balanced_map)) s
data_inv_insert_loads_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (op :memop) (a :num) (ofs :α word) (w :α word_loc). data_inv data s ∧ (lookup r data.to_canonical :num option) = SOME r ∧ (lookup a data.to_canonical :num option) = SOME a ∧ ¬is_store op ∧ get_var r s = SOME w ∧ (∀(r' :num). evaluate ((Inst (Mem op r' (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r' w s)) ⇒ data_inv (data with loads_mem := (insert listCmp (loadToNumList op a ofs) r data.loads_mem :(num list, num) balanced_map)) s
data_inv_insert_pair_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num) (tc :num sptree$num_map) (tl :num sptree$num_map). data_inv (data with <|to_canonical := tc; to_latest := tl|>) s ∧ (lookup x tc :num option) = (NONE :num option) ∧ (lookup y tc :num option) = SOME y ∧ ODD x ∧ ODD y ∧ get_var x s = get_var y s ⇒ data_inv (data with <|to_canonical := (insert x y tc :num sptree$num_map); to_latest := (insert y x tl :num sptree$num_map)|>) s
data_inv_invalidate_regs_typed=∀(ws :num list) (data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ⇒ data_inv (invalidate_regs data ws) s
data_inv_move_pairs_typed=∀(ps :(num # num) list) (data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ∧ ALL_DISTINCT (MAP (FST :num # num -> num) ps) ∧ EVERY (λ((x :num),(y :num)). (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y data.to_canonical :num option) = SOME y ∧ ODD x ∧ get_var x s = get_var y s) ps ⇒ data_inv (data with <|to_canonical := map_insert ps data.to_canonical; to_latest := map_insert (MAP (λ((a :num),(b :num)). (b,a)) ps) data.to_latest|>) s
data_inv_reinsert_canonical_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (v :num). data_inv data s ∧ ODD v ⇒ data_inv (data with to_canonical := (insert v (lookup_any v data.to_canonical v) data.to_canonical :num sptree$num_map)) s
evaluate_arith_agree_typed=∀(a :α arith) (w :α word_loc) (s1 :(α, γ, 'ffi) state) (s2 :(α, γ, 'ffi) state). evaluate ((Inst (Arith a :α inst) :α prog),s1) = ((NONE :α result option),set_var (firstRegOfArith a) w s1) ∧ can_mem_arith a ∧ s2.locals = s1.locals ⇒ evaluate ((Inst (Arith a :α inst) :α prog),s2) = ((NONE :α result option),set_var (firstRegOfArith a) w s2)
evaluate_arith_clock_typed=∀(a :α arith) (w :α word_loc) (s :(α, β, γ) state) (c :num) (td :num). can_mem_arith a ⇒ (evaluate ((Inst (Arith a :α inst) :α prog),s with <|clock := c; termdep := td|>) = ((NONE :α result option),set_var (firstRegOfArith a) w s with <|clock := c; termdep := td|>) ⇔ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s))
evaluate_arith_memory_typed=∀(a :α arith) (w :α word_loc) (s :(α, β, γ) state) (m :α word -> α word_loc). can_mem_arith a ⇒ (evaluate ((Inst (Arith a :α inst) :α prog),s with memory := m) = ((NONE :α result option),set_var (firstRegOfArith a) w s with memory := m) ⇔ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s))
evaluate_arith_unset_var_typed=∀(a :α arith) (r :num) (w :α word_loc) (s :(α, γ, 'ffi) state). can_mem_arith a ∧ ¬MEM r (arithReads a) ⇒ (evaluate ((Inst (Arith a :α inst) :α prog),unset_var r s) = ((NONE :α result option),set_var (firstRegOfArith a) w (unset_var r s)) ⇔ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s))
evaluate_load_agree_typed=∀(op :memop) (r :num) (a :num) (ofs :α word) (w :α word_loc) (s1 :(α, γ, 'ffi) state) (s2 :(α, γ, 'ffi) state). evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s1) = ((NONE :α result option),set_var r w s1) ∧ ¬is_store op ∧ s2.locals = s1.locals ∧ s2.memory = s1.memory ∧ s2.mdomain = s1.mdomain ∧ (s2.be ⇔ s1.be) ⇒ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s2) = ((NONE :α result option),set_var r w s2)
evaluate_load_change_addr_typed=∀(op :memop) (r :num) (a :num) (a' :num) (ofs :α word) (w :α word_loc) (s :(α, γ, 'ffi) state). ¬is_store op ∧ (lookup a' s.locals :α word_loc option) = (lookup a s.locals :α word_loc option) ∧ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s) ⇒ evaluate ((Inst (Mem op r (Addr a' ofs)) :α prog),s) = ((NONE :α result option),set_var r w s)
evaluate_load_clock_typed=∀(op :memop) (r :num) (a :num) (ofs :α word) (w :α word_loc) (s :(α, β, γ) state) (c :num) (td :num). ¬is_store op ⇒ (evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s with <|clock := c; termdep := td|>) = ((NONE :α result option),set_var r w s with <|clock := c; termdep := td|>) ⇔ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s))
evaluate_load_unset_var_typed=∀(op :memop) (r :num) (a :num) (ofs :α word) (n :num) (w :α word_loc) (s :(α, γ, 'ffi) state). ¬is_store op ∧ a ≠ n ⇒ (evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),unset_var n s) = ((NONE :α result option),set_var r w (unset_var n s)) ⇔ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s))
get_set_vars_in_typed=∀(moves :(num # num) list) (r :num) (p_2 :num) (x :α word_loc list) (s :(α, β, γ) state). MEM (r,p_2) moves ⇒ ALL_DISTINCT (MAP (FST :num # num -> num) moves) ⇒ get_vars (MAP (SND :num # num -> num) moves) s = SOME x ⇒ get_var r (set_vars (MAP (FST :num # num -> num) moves) x s) = get_var p_2 s
get_set_vars_in_2_typed=∀(moves :(num # num) list) (r :num) (p_2 :num) (x' :num) (x :α word_loc list) (data :knowledge) (s :(α, β, γ) state). MEM (r,p_2) moves ⇒ ALL_DISTINCT (MAP (FST :num # num -> num) moves) ⇒ (lookup p_2 data.to_canonical :num option) = SOME x' ⇒ get_vars (MAP (SND :num # num -> num) (MAP (λ((a :num),(b :num)). (a,canonicalRegs data b)) moves)) s = SOME x ⇒ get_var r (set_vars (MAP (FST :num # num -> num) moves) x s) = get_var x' s
get_set_vars_not_in_typed=∀(rs :num list) (vs :α word_loc list) (r :num) (s :(α, β, γ) state). ¬MEM r rs ⇒ get_var r (set_vars rs vs s) = get_var r s
if_eq_rw_typed=(if (x :α) = (y :α) then y else x) = x
in_names_set_insert_self_typed=∀(a :α arith) (tc :num sptree$num_map) (x :num). in_names_set a tc ⇒ in_names_set a (insert x x tc :num sptree$num_map)
in_names_set_register_reads_typed=∀(a :α arith) (data :knowledge). EVERY ODD (arithReads a) ∧ EVERY (λ(w :num). (lookup w data.to_canonical :num option) = (NONE :num option) ∨ (lookup w data.to_canonical :num option) = SOME w) (arithReads a) ⇒ in_names_set a (register_reads data (arithReads a)).to_canonical
lookup_invalidate_regs_typed=∀(ws :num list) (data :knowledge) (r :num). MEM r ws ⇒ (lookup r (invalidate_regs data ws).to_canonical :num option) = (NONE :num option)
lookup_invalidate_regs_mono_typed=∀(ws :num list) (data :knowledge) (r :num). (lookup r data.to_canonical :num option) = (NONE :num option) ⇒ (lookup r (invalidate_regs data ws).to_canonical :num option) = (NONE :num option)
lookup_set_vars_not_in_typed=∀(moves :(num # α) list) (v :num) (data :β) (c :γ word) (x :γ word_loc list). ¬MEM v (MAP (FST :num # α -> num) moves) ⇒ (lookup v (s :(γ, δ, ε) state).locals :γ word_loc option) = SOME (Word c) ⇒ (lookup v (set_vars (MAP (FST :num # α -> num) moves) x s).locals :γ word_loc option) = SOME (Word c)
wf_data_cons_gets_typed=∀(data :knowledge) (x :store_name) (h :num). wf_data (:α) data ∧ ALOOKUP data.gets_mem x = (NONE :num option) ∧ (lookup h data.to_canonical :num option) = SOME h ⇒ wf_data (:α) (data with gets_mem := (x,h)::data.gets_mem)
wf_data_filter_gets_typed=∀(data :knowledge) (x :store_name). wf_data (:α) data ⇒ wf_data (:α) (data with gets_mem := FILTER (λ((m :store_name),(n :num)). m ≠ x) data.gets_mem)
wf_data_insert_gets_typed=∀(data :knowledge) (name :store_name) (v :num). wf_data (:α) data ∧ (lookup v data.to_canonical :num option) = (NONE :num option) ∧ ODD v ∧ ALOOKUP data.gets_mem name = (NONE :num option) ⇒ wf_data (:α) (data with <|to_canonical := (insert v v data.to_canonical :num sptree$num_map); to_latest := (insert v v data.to_latest :num sptree$num_map); gets_mem := (name,v)::data.gets_mem|>)
wf_data_insert_instrs_Arith_typed=∀(data :knowledge) (r :num) (a :α arith). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = SOME r ∧ can_mem_arith a ∧ in_names_set a data.to_canonical ⇒ wf_data (:α) (data with instrs_mem := (insert listCmp (instToNumList (Arith a :α inst)) r data.instrs_mem :(num list, num) balanced_map))
wf_data_insert_instrs_Const_typed=∀(data :knowledge) (r :num) (n :num) (w :α word). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = SOME r ⇒ wf_data (:α) (data with instrs_mem := (insert listCmp (instToNumList (Const n w :α inst)) r data.instrs_mem :(num list, num) balanced_map))
wf_data_insert_instrs_LocValue_typed=∀(data :knowledge) (r :num) (l :num). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = SOME r ⇒ wf_data (:α) (data with instrs_mem := (insert listCmp [(48 :num); l] r data.instrs_mem :(num list, num) balanced_map))
wf_data_insert_instrs_OpCurrHeap_typed=∀(data :knowledge) (r :num) (op :binop) (src :num). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = SOME r ∧ (lookup src data.to_canonical :num option) = SOME src ⇒ wf_data (:α) (data with instrs_mem := (insert listCmp (OpCurrHeapToNumList op src) r data.instrs_mem :(num list, num) balanced_map))
wf_data_insert_loads_typed=∀(data :knowledge) (r :num) (op :memop) (a :num) (ofs :α word). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = SOME r ∧ (lookup a data.to_canonical :num option) = SOME a ⇒ wf_data (:α) (data with loads_mem := (insert listCmp (loadToNumList op a ofs) r data.loads_mem :(num list, num) balanced_map))
wf_data_move_pairs_typed=∀(ps :(num # num) list) (data :knowledge). wf_data (:α) data ∧ EVERY (λ((x :num),(y :num)). (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y data.to_canonical :num option) = SOME y ∧ ODD x ∧ ODD y) ps ⇒ wf_data (:α) (data with <|to_canonical := map_insert ps data.to_canonical; to_latest := map_insert (MAP (λ((a :num),(b :num)). (b,a)) ps) data.to_latest|>)
wf_data_reinsert_canonical_typed=∀(data :knowledge) (v :num). wf_data (:α) data ∧ ODD v ⇒ wf_data (:α) (data with to_canonical := (insert v (lookup_any v data.to_canonical v) data.to_canonical :num sptree$num_map))
with_locals_insert_typed=(s :(α, β, γ) state) with locals := (insert (r :num) (v :α word_loc) (l :α word_loc sptree$num_map) :α word_loc sptree$num_map) = set_var r v (s with locals := l)
