load "bossLib"; load "preamble"; load "presLangTheory";
open bossLib HolKernel Parse preamble presLangTheory;
val th = DB.fetch "presLang" "default_tap_config_def";
val _ = show_types := true;
val _ = print "default_tap_config=";
val _ = print_term (concl th);
val _ = print "\n";
val _ = print "default_tap_config_types=";
val _ = app (fn v => print (term_to_string v ^ ":" ^ type_to_string (type_of v) ^ ";")) (fst (strip_forall (concl th)) @ free_vars (concl th));
val _ = print "\n";
val _ = print ("default_tap_config_hypotheses=" ^ Int.toString (length (hyp th)) ^ "\n");
val _ = show_types := false;
val _ = print "default_tap_config_proved=";
val _ = print_term (rhs (concl (EQT_INTRO (prove (concl th, ACCEPT_TAC th)))));
val _ = print "\n";
val _ = show_types := true;
val _ = print "default_tap_config_type="; val _ = print (type_to_string (type_of ``presLang$default_tap_config``)); val _ = print "\n";
val _ = print "tap_config_explore_flag_type="; val _ = print (type_to_string (type_of ``\(c:presLang$tap_config). c.explore_flag``)); val _ = print "\n";
val _ = print "tap_config_component_equality="; val _ = print_term (concl (DB.fetch "presLang" "tap_config_component_equality")); val _ = print "\n";
