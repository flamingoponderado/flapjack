dest_Constants_def_typed=dest_Constants ([] :closLang$exp list) = SOME ([] :const list) ∧ ∀(c :closLang$exp) (cs :closLang$exp list). dest_Constants (c::cs) = case dest_Constant c of (NONE :const option) => (NONE :const list option) | SOME x => case dest_Constants cs of (NONE :const list option) => (NONE :const list option) | SOME xs => SOME (x::xs)
