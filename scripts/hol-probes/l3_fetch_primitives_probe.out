pc_full_definition=∀state. PC state = state.c_PC state.procID
pc_full_type=:riscv_state -> word64
skip_full_definition=∀value. write'Skip value = (λstate. state with c_Skip := state.c_Skip⦇state.procID ↦ value⦈)
skip_full_type=:word64 -> riscv_state -> riscv_state
pc_generic_equation=PC s = s.c_PC s.procID
skip_generic_equation=write'Skip v s = s with c_Skip := s.c_Skip⦇s.procID ↦ v⦈
rawReadInst_full_definition=∀pAddr. rawReadInst pAddr = (λstate. (let (b'7,b'6,b'5,b'4,b'3,b'2,b'1,b'0) = boolify8 (state.MEM8 pAddr) in if b'1 ∧ b'0 then (let s = write'Skip 4w state in (Word (s.MEM8 (pAddr + 3w) @@ s.MEM8 (pAddr + 2w) @@ s.MEM8 (pAddr + 1w) @@ s.MEM8 pAddr),s)) else (let s = write'Skip 2w state in (Half (s.MEM8 (pAddr + 1w) @@ s.MEM8 pAddr),s))))
rawReadInst_full_type=:word64 -> riscv_state -> rawInstType # riscv_state
