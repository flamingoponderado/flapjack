flush_definition=∀asid addr curTLB. flushTLB (asid,addr,curTLB) = FST (SND (FOR (0,TLBEntries − 1,(λi state. case (FST state (n2w i),addr) of (NONE,v1) => ((),state) | (SOME e,NONE) => ((),if asid = 0w ∨ asid = e.asid ∧ ¬e.global then ((FST state)⦇n2w i ↦ NONE⦈,()) else state) | (SOME e,SOME va) => ((),if (asid = 0w ∨ asid = e.asid ∧ ¬e.global) ∧ e.vAddr = va && e.vMatchMask then ((FST state)⦇n2w i ↦ NONE⦈,()) else state))) (curTLB,())))
sfence_definition=∀rs1. dfn'SFENCE_VM rs1 = (λstate. write'TLB (flushTLB (curASID () state,if rs1 = 0w then NONE else SOME (GPR rs1 state),TLB state)) state)
flush_type=:word6 # word64 option # (word4 -> TLBEntry option) -> word4 -> TLBEntry option
sfence_type=:word5 -> riscv_state -> riscv_state
