word_gen_gc_move_roots_IMP_LENGTH_typed=∀(xs :α word_loc list) (r0 :α word) (r1 :α word) (r3 :α word) (r4 :α word) (curr :α word) (r2 :α word -> α word_loc) (dm :α word -> bool) (ys :α word_loc list) (i2 :α word) (pa2 :α word) (m2 :α word -> α word_loc) (c :bool) (conf :config) (ib2 :α word) (pb2 :α word). word_gen_gc_move_roots conf (xs,r0,r1,r3,r4,curr,r2,dm) = (ys,i2,pa2,ib2,pb2,m2,c) ⇒ LENGTH ys = LENGTH xs
