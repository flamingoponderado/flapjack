word_gen_gc_move_bitmaps_LENGTH_typed=word_gen_gc_move_bitmaps (conf :config) ((w :β word_loc),(stack :α word_loc list),(bitmaps :γ word list),(i :α word),(pa :α word),(ib :α word),(pb :α word),(curr :α word),(m :α word -> α word_loc),(dm :α word -> bool)) = SOME ((xs :α word_loc list),(stack1 :α word_loc list),(i1 :α word),(pa1 :α word),(ib1 :α word),(pb1 :α word),(m1 :α word -> α word_loc),T) ⇒ LENGTH stack = LENGTH xs + LENGTH stack1
