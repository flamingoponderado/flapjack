word_gen_gc_partial_move_bitmaps_LENGTH_typed=word_gen_gc_partial_move_bitmaps (conf :config) ((w :β word_loc),(stack :α word_loc list),(bitmaps :γ word list),(i :α word),(pa :α word),(curr :α word),(m :α word -> α word_loc),(dm :α word -> bool),(gs :α word),(rs :α word)) = SOME ((xs :α word_loc list),(stack1 :α word_loc list),(i1 :α word),(pa1 :α word),(m1 :α word -> α word_loc),T) ⇒ LENGTH stack = LENGTH xs + LENGTH stack1
word_gen_gc_partial_move_roots_bitmaps_def_typed=∀(conf :config) (stack :α word_loc list) (bitmaps :β word list) (i1 :α word) (pa1 :α word) (curr :α word) (m :α word -> α word_loc) (dm :α word -> bool) (gs :α word) (rs :α word). word_gen_gc_partial_move_roots_bitmaps conf (stack,bitmaps,i1,pa1,curr,m,dm,gs,rs) = case (enc_stack bitmaps stack :α word_loc list option) of (NONE :α word_loc list option) => ((ARB :α word_loc list),(ARB :α word),(ARB :α word),(ARB :α word -> α word_loc),F) | SOME wl_list => (let ((wl :α word_loc list),(i2 :α word),(pa2 :α word),(m2 :α word -> α word_loc),(c2 :bool)) = word_gen_gc_partial_move_roots conf (wl_list,i1,pa1,curr,m,dm,gs,rs) in case (dec_stack bitmaps wl stack :α word_loc list option) of (NONE :α word_loc list option) => ((ARB :α word_loc list),(ARB :α word),(ARB :α word),(ARB :α word -> α word_loc),F) | SOME stack => (stack,i2,pa2,m2,c2))
word_gen_gc_partial_move_roots_IMP_LENGTH_typed=∀(xs :α word_loc list) (r0 :α word) (r1 :α word) (r3 :α word) (r4 :α word) (curr :α word) (r2 :α word -> α word_loc) (dm :α word -> bool) (ys :α word_loc list) (i2 :α word) (pa2 :α word) (m2 :α word -> α word_loc) (c :bool) (conf :config). word_gen_gc_partial_move_roots conf (xs,r0,r1,curr,r2,dm,r3,r4) = (ys,i2,pa2,m2,c) ⇒ LENGTH ys = LENGTH xs
extract_labels_next_lab_typed=∀(p :α stackLang$prog) (aux :num) (e :num # num). MEM e (extract_labels p) ⇒ SND e < next_lab p (2 :num)
next_lab_EQ_MAX_typed=∀(q :α stackLang$prog) (aux :num). next_lab q aux = MAX aux (next_lab q (0 :num))
next_lab_thm_typed=∀(p :α stackLang$prog). next_lab p (2 :num) = case p of (Skip :α stackLang$prog) => (2 :num) | (Inst v67 :α stackLang$prog) => (2 :num) | (Get v68 v69 :α stackLang$prog) => (2 :num) | (Set v70 v71 :α stackLang$prog) => (2 :num) | (OpCurrHeap v72 v73 v74 :α stackLang$prog) => (2 :num) | (Call (NONE :(α stackLang$prog # num # num # num) option) v76 (NONE :(α stackLang$prog # num # num) option) :α stackLang$prog) => (2 :num) | (Call (NONE :(α stackLang$prog # num # num # num) option) v76 (SOME (v140,v144,l2)) :α stackLang$prog) => MAX (l2 + (2 :num)) (2 :num) | (Call (SOME (p',v152,v156,l2')) v76 (NONE :(α stackLang$prog # num # num) option) :α stackLang$prog) => MAX (next_lab p' (2 :num)) (l2' + (2 :num)) | (Call (SOME (p',v152,v156,l2')) v76 (SOME (p'',v166,l3)) :α stackLang$prog) => MAX (MAX (next_lab p' (2 :num)) (next_lab p'' (2 :num))) (MAX l2' l3 + (2 :num)) | Seq p1 p2 => MAX (next_lab p1 (2 :num)) (next_lab p2 (2 :num)) | (If v80 v81 v82 p1' p2' :α stackLang$prog) => MAX (next_lab p1' (2 :num)) (next_lab p2' (2 :num)) | (Loop p :α stackLang$prog) => next_lab p (2 :num) | (JumpLower v86 v87 v88 :α stackLang$prog) => (2 :num) | (Alloc v89 :α stackLang$prog) => (2 :num) | (StoreConsts v90 v91 v92 :α stackLang$prog) => (2 :num) | (Raise v93 :α stackLang$prog) => (2 :num) | (Return v94 :α stackLang$prog) => (2 :num) | (Break v95 :α stackLang$prog) => (2 :num) | (Continue v96 :α stackLang$prog) => (2 :num) | (FFI v97 v98 v99 v100 v101 v102 :α stackLang$prog) => (2 :num) | (Tick :α stackLang$prog) => (2 :num) | (LocValue v103 v104 v105 :α stackLang$prog) => (2 :num) | (Install v106 v107 v108 v109 v110 :α stackLang$prog) => (2 :num) | ShMemOp v111 v112 v113 => (2 :num) | (CodeBufferWrite v114 v115 :α stackLang$prog) => (2 :num) | (DataBufferWrite v116 v117 :α stackLang$prog) => (2 :num) | (RawCall v118 :α stackLang$prog) => (2 :num) | (StackAlloc v119 :α stackLang$prog) => (2 :num) | (StackFree v120 :α stackLang$prog) => (2 :num) | (StackStore v121 v122 :α stackLang$prog) => (2 :num) | (StackStoreAny v123 v124 :α stackLang$prog) => (2 :num) | (StackLoad v125 v126 :α stackLang$prog) => (2 :num) | (StackLoadAny v127 v128 :α stackLang$prog) => (2 :num) | (StackGetSize v129 :α stackLang$prog) => (2 :num) | (StackSetSize v130 :α stackLang$prog) => (2 :num) | (BitmapLoad v131 v132 :α stackLang$prog) => (2 :num) | (Halt v133 :α stackLang$prog) => (2 :num)
stack_alloc_lab_pres_typed=∀(n :num) (nl :num) (p :α stackLang$prog) (aux :β). EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p) ∧ next_lab p (2 :num) ≤ nl ⇒ (let ((cp :α stackLang$prog),(nl' :num)) = (comp n nl p :α stackLang$prog # num) in EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) (extract_labels cp) ∧ ALL_DISTINCT (extract_labels cp) ∧ (∀(lab :num # num). MEM lab (extract_labels cp) ⇒ MEM lab (extract_labels p) ∨ nl ≤ SND lab ∧ SND lab < nl') ∧ nl ≤ nl')
make_init_def_typed=∀(c :config) (code :α stackLang$prog sptree$num_map) (oracle :num -> β # (num # α stackLang$prog) list # α word list) (s :(α, β, γ) state). make_init c code oracle s = s with <|code := code; use_alloc := T; use_stack := T; gc_fun := (word_gc_fun c :α word_loc list # (α word -> α word_loc) # (α word -> bool) # (store_name |-> α word_loc) -> (α word_loc list # (α word -> α word_loc) # (store_name |-> α word_loc)) option); compile := (λ(c :β). (s.compile c :(num # α stackLang$prog) list -> (word8 list # β) option) ∘ MAP (prog_comp :num # α stackLang$prog -> num # α stackLang$prog)); compile_oracle := oracle|>
make_init_semantics_typed=(∀(k :num) (prog :α stackLang$prog). ALOOKUP (code :(num # α stackLang$prog) list) k = SOME prog ⇒ k ≠ gc_stub_location ∧ alloc_arg prog) ∧ (∀(n :num) (k :num) (p :α stackLang$prog). MEM (k,p) (FST (SND ((oracle :num -> γ # (num # α stackLang$prog) list # α word list) n))) ⇒ k ≠ gc_stub_location ∧ alloc_arg p) ∧ (s :(α, γ, 'ffi) state).use_stack ∧ s.use_store ∧ ¬s.use_alloc ∧ s.code = fromAList (compile (c :config) code :(num # α stackLang$prog) list) ∧ s.compile_oracle = ((I :γ -> γ) ## MAP (prog_comp :num # α stackLang$prog -> num # α stackLang$prog) ## (I :α word list -> α word list)) ∘ oracle ∧ LENGTH s.bitmaps + LENGTH s.data_buffer.buffer + s.data_buffer.space_left < dimword (:α) − (1 :num) ∧ LENGTH s.stack * (dimindex (:α) DIV (8 :num)) < dimword (:α) ∧ ALL_DISTINCT (MAP (FST :num # α stackLang$prog -> num) code) ∧ semantics (start :num) (make_init c (fromAList code) oracle s) ≠ Fail ⇒ semantics start s = semantics start (make_init c (fromAList code) oracle s)
prog_comp_lambda_typed=(prog_comp :num # α stackLang$prog -> num # α stackLang$prog) = (λ((n :num),(p :α stackLang$prog)). (n,FST (comp n (next_lab p (2 :num)) p :α stackLang$prog # num)))
ALOOKUP_prog_comp_typed=∀(xs :(num # α stackLang$prog) list) (a :num) (y :α stackLang$prog). ALOOKUP xs a = SOME y ⇒ ALOOKUP (MAP (prog_comp :num # α stackLang$prog -> num # α stackLang$prog) xs) a = SOME (FST (comp a (next_lab y (2 :num)) y :α stackLang$prog # num))
FST_prog_comp_typed=FST (prog_comp (pp :num # α stackLang$prog) :num # α stackLang$prog) = FST pp
find_code_regs_SUBMAP_typed=(r1 :α |-> β word_loc) ⊑ (r2 :α |-> β word_loc) ∧ (find_code (dest :num + α) r1 (c :γ sptree$num_map) :γ option) = SOME (x :γ) ⇒ (find_code dest r2 c :γ option) = SOME x
get_labels_comp_typed=∀(n :num) (p :num) (e :α stackLang$prog). get_labels e ⊆ get_labels (FST (comp n p e :α stackLang$prog # num))
loc_check_compile_typed=loc_check (s :(α, β, γ) state).code ((l1 :num),(l2 :num)) ∧ (∀(k :num) (prog :α stackLang$prog). (lookup k s.code :α stackLang$prog option) = SOME prog ⇒ k ≠ gc_stub_location) ⇒ loc_check (fromAList (compile (c :config) (toAList s.code) :(num # α stackLang$prog) list)) (l1,l2)
lookup_fromAList_prog_comp_typed=(lookup (x :num) (s :(α, β, γ) state).code :α stackLang$prog option) = SOME (p :α stackLang$prog) ⇒ (lookup x (fromAList (MAP (prog_comp :num # α stackLang$prog -> num # α stackLang$prog) (toAList s.code))) :α stackLang$prog option) = SOME (FST (comp x (next_lab p (2 :num)) p :α stackLang$prog # num))
bit_length_eq_1_typed=bit_length (w :α word) = (1 :num) ⇔ w = (1w :α word)
bit_length_LESS_EQ_dimindex_typed=bit_length (w :α word) ≤ dimindex (:α)
bit_length_minus_1_typed=(w :α word) ≠ (0w :α word) ⇒ bit_length w − (1 :num) = bit_length (w ⋙ (1 :num))
bit_length_thm_typed=∀(w :α word). w ⋙ bit_length w = (0w :α word) ∧ ∀(n :num). n < bit_length w ⇒ w ⋙ n ≠ (0w :α word)
bytes_in_word_word_shift_typed=good_dimindex (:α) ∧ w2n (bytes_in_word :α word) * w2n (n :α word) < dimword (:α) ⇒ ((bytes_in_word :α word) * n) ⋙ shift (:α) = n
bytes_in_word_word_shift_n2w_typed=good_dimindex (:α) ∧ dimindex (:α) DIV (8 :num) * (n :num) < dimword (:α) ⇒ ((bytes_in_word :α word) * (n2w n :α word)) ⋙ shift (:α) = (n2w n :α word)
get_bits_def_typed=∀(w :α word). get_bits w = GENLIST (λ(i :num). ((w ' i) :bool)) (bit_length w − (1 :num))
good_dimindex_byte_aligned_eq_typed=good_dimindex (:α) ⇒ (byte_aligned (w :α word) ⇔ w && (if dimindex (:α) = (32 :num) then (3w :α word) else (7w :α word)) = (0w :α word))
lsl_lsr_typed=w2n (n :α word) * (2 :num) ** (a :num) < dimword (:α) ⇒ n ≪ a ⋙ a = n
select_eq_select_0_typed=(k :num) ≤ (n :num) ⇒ (n -- k) (w :α word) = (n − k -- (0 :num)) (w ⋙ k)
select_lower_lemma_typed=((n :num) -- (0 :num)) (w :α word) = w ≪ (dimindex (:α) − n − (1 :num)) ⋙ (dimindex (:α) − n − (1 :num))
shift_to_zero_word_msb_typed=(w :α word) ⋙ (n :num) = (0w :α word) ∧ word_msb w ⇒ dimindex (:α) ≤ n
word_shift_not_0_typed=shift (:α) ≠ (0 :num)
word_and_one_eq_0_iff_typed=∀(w :α word). w && (1w :α word) = (0w :α word) ⇔ ¬((w ' (0 :num)) :bool)
word_msb_IFF_lsr_EQ_0_typed=word_msb (h :α word) ⇔ h ⋙ (dimindex (:α) − (1 :num)) ≠ (0w :α word)
