type_p_typed=(∀(tvs :num) (tenv :type_env) (t :t). check_freevars tvs ([] :mlstring list) t ⇒ type_p tvs tenv Pany t ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (n :mlstring) (t :t). check_freevars tvs ([] :mlstring list) t ⇒ type_p tvs tenv (Pvar n) t [(n,t)]) ∧ (∀(tvs :num) (tenv :type_env) (n :int). T ⇒ type_p tvs tenv (Plit (IntLit n)) Tint ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (c :char). T ⇒ type_p tvs tenv (Plit (Char c)) Tchar ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (s :mlstring). T ⇒ type_p tvs tenv (Plit (StrLit s)) Tstring ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (w :word8). T ⇒ type_p tvs tenv (Plit (Word8 w)) Tword8 ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (w :word64). T ⇒ type_p tvs tenv (Plit (Word64 w)) Tword64 ([] :(mlstring # t) list)) ∧ (∀(tvs :num) (tenv :type_env) (cn :(mlstring, mlstring) id) (ps :pat list) (ts :t list) (tvs' :mlstring list) (tn :num) (ts' :t list) (bindings :(mlstring # t) list). EVERY (check_freevars tvs ([] :mlstring list)) ts' ∧ LENGTH ts' = LENGTH tvs' ∧ type_ps tvs tenv ps (MAP (type_subst (alist_to_fmap (ZIP (tvs',ts')))) ts) bindings ∧ nsLookup tenv.c cn = SOME (tvs',ts,tn) ⇒ type_p tvs tenv (Pcon (SOME cn) ps) (Tapp ts' tn) bindings) ∧ (∀(tvs :num) (tenv :type_env) (ps :pat list) (ts :t list) (bindings :(mlstring # t) list). type_ps tvs tenv ps ts bindings ⇒ type_p tvs tenv (Pcon (NONE :(mlstring, mlstring) id option) ps) (Ttup ts) bindings) ∧ (∀(tvs :num) (tenv :type_env) (p :pat) (t :t) (bindings :(mlstring # t) list). type_p tvs tenv p t bindings ⇒ type_p tvs tenv (Pref p) (Tref t) bindings) ∧ (∀(tvs :num) (tenv :type_env) (pat :pat) (v :mlstring) (t :t) (bindings :(mlstring # t) list). type_p tvs tenv pat t bindings ⇒ type_p tvs tenv (Pas pat v) t (bindings ++ [(v,t)])) ∧ (∀(tvs :num) (tenv :type_env) (p :pat) (t :ast_t) (bindings :(mlstring # t) list). check_freevars_ast ([] :mlstring list) t ∧ check_type_names tenv.t t ∧ type_p tvs tenv p (type_name_subst tenv.t t) bindings ⇒ type_p tvs tenv (Ptannot p t) (type_name_subst tenv.t t) bindings) ∧ (∀(tvs :num) (tenv :type_env). T ⇒ type_ps tvs tenv ([] :pat list) ([] :t list) ([] :(mlstring # t) list)) ∧ ∀(tvs :num) (tenv :type_env) (p :pat) (ps :pat list) (t :t) (ts :t list) (bindings :(mlstring # t) list) (bindings' :(mlstring # t) list). type_p tvs tenv p t bindings ∧ type_ps tvs tenv ps ts bindings' ⇒ type_ps tvs tenv (p::ps) (t::ts) (bindings' ++ bindings)
type_e_typed=(∀(tenv :type_env) (tenvE :tenv_val_exp) (n :int). T ⇒ type_e tenv tenvE (Lit (IntLit n)) Tint) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (c :char). T ⇒ type_e tenv tenvE (Lit (Char c)) Tchar) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (s :mlstring). T ⇒ type_e tenv tenvE (Lit (StrLit s)) Tstring) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word8). T ⇒ type_e tenv tenvE (Lit (Word8 w)) Tword8) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word64). T ⇒ type_e tenv tenvE (Lit (Word64 w)) Tword64) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (w :word64). T ⇒ type_e tenv tenvE (Lit (Float64 w)) Tdouble) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :t). check_freevars (num_tvs tenvE) ([] :mlstring list) t ∧ type_e tenv tenvE e Texn ⇒ type_e tenv tenvE (Raise e) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (pes :(pat # exp) list) (t :t). type_e tenv tenvE e t ∧ pes ≠ ([] :(pat # exp) list) ∧ (∀((p :pat),(e :exp))::set pes. ∃(bindings :(mlstring # t) list). ALL_DISTINCT (pat_bindings p) ∧ type_p (num_tvs tenvE) tenv p Texn bindings ∧ type_e tenv (bind_var_list (0 :num) bindings tenvE) e t) ⇒ type_e tenv tenvE (Handle e pes) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (cn :(mlstring, mlstring) id) (es :exp list) (tvs :mlstring list) (tn :num) (ts' :t list) (ts :t list). EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) ts' ∧ LENGTH tvs = LENGTH ts' ∧ type_es tenv tenvE es (MAP (type_subst (alist_to_fmap (ZIP (tvs,ts')))) ts) ∧ nsLookup tenv.c cn = SOME (tvs,ts,tn) ⇒ type_e tenv tenvE (Con (SOME cn) es) (Tapp ts' tn)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (es :exp list) (ts :t list). type_es tenv tenvE es ts ⇒ type_e tenv tenvE (Con (NONE :(mlstring, mlstring) id option) es) (Ttup ts)) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (n :(mlstring, mlstring) id) (t :t) (targs :t list) (tvs :num). tvs = LENGTH targs ∧ EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) targs ∧ lookup_var n tenvE tenv = SOME (tvs,t) ⇒ type_e