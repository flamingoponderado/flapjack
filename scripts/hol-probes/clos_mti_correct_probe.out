evaluate_apps_def=(∀(f :v) (s :(α, β) state). evaluate_apps f ([] :v list) s = ((Rval [f] :(v list, v) result),s)) ∧ ∀(f :v) (x :v) (xs :v list) (s :(α, β) state). evaluate_apps f (x::xs) s = case evaluate_apps f xs s of ((Rval ([] :v list) :(v list, v) result),s1) => ((Rval ([] :v list) :(v list, v) result),s1) | ((Rval [v] :(v list, v) result),s1) => evaluate_app (NONE :num option) v [x] s1 | ((Rval (v::v15::v16) :(v list, v) result),s1) => ((Rval (v::v15::v16) :(v list, v) result),s1) | ((Rerr v8 :(v list, v) result),s1) => ((Rerr v8 :(v list, v) result),s1)
evaluate_intro_multi=(∀(ys :closLang$exp list) (env2 :v list) (t1 :(γ, 'ffi) state) (env1 :v list) (t2 :(γ, 'ffi) state) (s1 :(γ, 'ffi) state) (res2 :(v list, v) result) (xs :closLang$exp list). evaluate (ys,env2,t1) = (res2,t2) ∧ LIST_REL (v_rel s1.max_app) env1 env2 ∧ state_rel s1 t1 ∧ code_rel s1.max_app xs ys ⇒ ∃(res1 :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate (xs,env1,s1) = (res1,s2) ∧ result_rel (LIST_REL (v_rel s1.max_app)) (v_rel s1.max_app) res1 res2 ∧ state_rel s2 t2) ∧ ∀(loc_opt :num option) (f2 :v) (args2 :v list) (t1 :(γ, 'ffi) state) (res2 :(v list, v) result) (t2 :(γ, 'ffi) state) (f1 :v) (args1 :v list) (s1 :(γ, 'ffi) state). evaluate_app loc_opt f2 args2 t1 = (res2,t2) ∧ loc_opt = (NONE :num option) ∧ v_rel s1.max_app f1 f2 ∧ LIST_REL (v_rel s1.max_app) args1 args2 ∧ state_rel s1 t1 ∧ LENGTH args1 ≤ s1.max_app ⇒ ∃(res1 :(v list, v) result) (s2 :(γ, 'ffi) state). evaluate_apps f1 args1 s1 = (res1,s2) ∧ result_rel (LIST_REL (v_rel s1.max_app)) (v_rel s1.max_app) res1 res2 ∧ state_rel s2 t2
intro_multi_correct=∀(xs :closLang$exp list) (env1 :v list) (s1 :(γ, 'ffi) state) (res1 :(v list, v) result) (s2 :(γ, 'ffi) state) (env2 :v list) (t2 :α) (t1 :(γ, 'ffi) state). evaluate (xs,env1,s1) = (res1,s2) ∧ EVERY no_mti xs ∧ LIST_REL (v_rel s1.max_app) env1 env2 ∧ state_rel s1 t1 ⇒ ∃(res2 :(v list, v) result) (t2 :(γ, 'ffi) state). evaluate (intro_multi s1.max_app xs,env2,t1) = (res2,t2) ∧ result_rel (LIST_REL (v_rel s1.max_app)) (v_rel s1.max_app) res1 res2 ∧ state_rel s2 t2
semantics_intro_multi=semantics (ffi :'ffi ffi_state) (max_app :num) (FEMPTY :num |-> num # closLang$exp) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (pure_cc (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option)) (xs :closLang$exp list) ≠ Fail ⇒ (∀(n :num). SND (SND (co n)) = ([] :(num # num # closLang$exp) list) ∧ EVERY no_mti (FST (SND (co n)))) ∧ (1 :num) ≤ max_app ∧ EVERY no_mti xs ⇒ semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) ((pure_co (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :α # closLang$exp list # (num # num # closLang$exp) list -> α # closLang$exp list # (num # num # closLang$exp) list) ∘ co) cc (intro_multi max_app xs) = semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) co (pure_cc (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) cc) xs
semantics_compile=semantics (ffi :α ffi_state) (max_app :num) (FEMPTY :num |-> num # closLang$exp) (co :num -> β # closLang$exp list # (num # num # closLang$exp) list) (cc1 :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) (xs :closLang$exp list) ≠ Fail ∧ cc1 = ((if (do_mti :bool) then pure_cc (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) else I) (cc :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) :β -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # β) option) ∧ (co1 :num -> β # closLang$exp list # (num # num # closLang$exp) list) = (if do_mti then (pure_co (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :β # closLang$exp list # (num # num # closLang$exp) list -> β # closLang$exp list # (num # num # closLang$exp) list) else (I :β # closLang$exp list # (num # num # closLang$exp) list -> β # closLang$exp list # (num # num # closLang$exp) list)) ∘ co ∧ (do_mti ⇒ (∀(n :num). SND (SND (co n)) = ([] :(num # num # closLang$exp) list) ∧ EVERY no_mti (FST (SND (co n)))) ∧ (1 :num) ≤ max_app ∧ EVERY no_mti xs) ⇒ semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) co1 cc (compile do_mti max_app xs) = semantics ffi max_app (FEMPTY :num |-> num # closLang$exp) co cc1 xs
contains_App_SOME_intro_multi=∀(max_app :num) (es :closLang$exp list). contains_App_SOME max_app (intro_multi max_app es) ⇔ contains_App_SOME max_app es
every_Fn_vs_NONE_intro_multi=∀(max_app :num) (es :closLang$exp list). every_Fn_vs_NONE (intro_multi max_app es) ⇔ every_Fn_vs_NONE es
contains_App_SOME_collect_args=∀(m :num) (x :num) (y :closLang$exp) (a :num) (b :closLang$exp). collect_args m x y = (a,b) ⇒ (contains_App_SOME m [y] ⇔ contains_App_SOME m [b])
contains_App_SOME_collect_apps=∀(max_app :num) (x :closLang$exp list) (y :closLang$exp) (a :closLang$exp list) (b :closLang$exp). collect_apps max_app x y = (a,b) ⇒ (max_app < LENGTH x ∨ contains_App_SOME max_app x ∨ contains_App_SOME max_app [y] ⇔ max_app < LENGTH a ∨ contains_App_SOME max_app a ∨ contains_App_SOME max_app [b])
every_Fn_vs_NONE_collect_apps_replay=∀(max_app :num) (es :closLang$exp list) (e :closLang$exp) (x :closLang$exp list) (y :closLang$exp). collect_apps max_app es e = (x,y) ⇒ (every_Fn_vs_NONE x ∧ every_Fn_vs_NONE [y] ⇔ every_Fn_vs_NONE es ∧ every_Fn_vs_NONE [e])
every_Fn_vs_NONE_collect_args_replay=∀(max_app :num) (es :num) (e :closLang$exp) (x :num) (y :closLang$exp). collect_args max_app es e = (x,y) ⇒ (every_Fn_vs_NONE [y] ⇔ every_Fn_vs_NONE [e])
collect_apps_no_Labels=∀(m :num) (es :closLang$exp list) (e :closLang$exp) (es' :closLang$exp list) (e' :closLang$exp). collect_apps m es e = (es',e') ∧ EVERY no_Labels es ∧ no_Labels e ⇒ EVERY no_Labels es' ∧ no_Labels e'
collect_args_no_Labels=∀(m :num) (na :num) (e :closLang$exp) (es' :num) (e' :closLang$exp). collect_args m na e = (es',e') ∧ no_Labels e ⇒ no_Labels e'
EVERY_intro_multi=∀(m :num) (xs :closLang$exp list). EVERY (P :closLang$exp -> bool) (intro_multi m xs) ⇔ EVERY (λ(x :closLang$exp). P (HD (intro_multi m [x]))) xs
HD_intro_multi=[HD (intro_multi (max_app :num) [(e2 :closLang$exp)])] = intro_multi max_app [e2]
intro_multi_cons=∀(xs :closLang$exp list) (x :closLang$exp). intro_multi (m :num) (x::xs) = HD (intro_multi m [x])::intro_multi m xs
intro_multi_no_Labels=∀(m :num) (xs :closLang$exp list). EVERY no_Labels xs ⇒ EVERY no_Labels (intro_multi m xs)
intro_multi_obeys_max_app=∀(m :num) (xs :closLang$exp list). m ≠ (0 :num) ∧ EVERY no_mti xs ⇒ EVERY (obeys_max_app m) (intro_multi m xs)
collect_args_preserves_set_globals=∀(max_app :num) (n :num) (e :closLang$exp) (n' :num) (e' :closLang$exp). collect_args max_app n e = (n',e') ⇒ set_globals e' = set_globals e
collect_args_preserves_esgc_free=∀(max_app :num) (n :num) (e :closLang$exp) (n' :num) (e' :closLang$exp). collect_args max_app n e = (n',e') ∧ esgc_free e ⇒ esgc_free e'
collect_apps_preserves_set_globals=∀(max_app :num) (es :closLang$exp list) (e :closLang$exp) (es' :closLang$exp list) (e' :closLang$exp). collect_apps max_app es e = (es',e') ⇒ elist_globals es ⊎ set_globals e = elist_globals es' ⊎ set_globals e'
collect_apps_preserves_esgc_free=∀(max_app :num) (es :closLang$exp list) (e :closLang$exp) (es' :closLang$exp list) (e' :closLang$exp). collect_apps max_app es e = (es',e') ∧ EVERY esgc_free es ∧ esgc_free e ⇒ EVERY esgc_free es' ∧ esgc_free e'
