exp_typed=Const::α word -> α exp; Var::varkind -> mlstring -> α exp; RStruct::α exp list -> α exp; RField::num -> α exp -> α exp; NStruct::mlstring -> (mlstring # α exp) list -> α exp; NField::mlstring -> α exp -> α exp; Load::shape -> α exp -> α exp; Load32::α exp -> α exp; LoadByte::α exp -> α exp; Op::binop -> α exp list -> α exp; Panop::panop -> α exp list -> α exp; Cmp::cmp -> α exp -> α exp -> α exp; Shift::ast$shift -> α exp -> α exp -> α exp; BaseAddr::α exp; TopAddr::α exp; BytesInWord::α exp
global_var_exp_def_typed=(∀(w :α word). global_var_exp (Const w :α exp) = ([] :mlstring list)) ∧ (∀(v :mlstring). global_var_exp (Var Local v :α exp) = ([] :mlstring list)) ∧ (∀(v :mlstring). global_var_exp (Var Global v :α exp) = [v]) ∧ (∀(es :α exp list). global_var_exp (RStruct es) = FLAT (MAP (λ(a :α exp). global_var_exp a) es)) ∧ (∀(i :num) (e :α exp). global_var_exp (RField i e) = global_var_exp e) ∧ (∀(sn :mlstring) (fes :(mlstring # α exp) list). global_var_exp (NStruct sn fes) = FLAT (MAP ((λ(a :α exp). global_var_exp a) ∘ (SND :mlstring # α exp -> α exp)) fes)) ∧ (∀(fld :mlstring) (e :α exp). global_var_exp (NField fld e) = global_var_exp e) ∧ (∀(sh :shape) (e :α exp). global_var_exp (Load sh e :α exp) = global_var_exp e) ∧ (∀(e :α exp). global_var_exp (LoadByte e) = global_var_exp e) ∧ (∀(es :α exp list) (bop :binop). global_var_exp (Op bop es) = FLAT (MAP (λ(a :α exp). global_var_exp a) es)) ∧ (∀(op :panop) (es :α exp list). global_var_exp (Panop op es) = FLAT (MAP (λ(a :α exp). global_var_exp a) es)) ∧ (∀(e2 :α exp) (e1 :α exp) (c :cmp). global_var_exp (Cmp c e1 e2) = global_var_exp e1 ++ global_var_exp e2) ∧ ∀(sh :ast$shift) (e2 :α exp) (e1 :α exp). global_var_exp (Shift sh e1 e2 :α exp) = global_var_exp e1 ++ global_var_exp e2
MEM_IMP_exp_size_typed=(∀(xs :α exp list) (a :α exp). MEM a xs ⇒ (exp_size (l :α -> num) a :num) < (exp3_size l xs :num)) ∧ ∀(xs :(mlstring # α exp) list) (a :mlstring # α exp). MEM a xs ⇒ (exp_size l (SND a) :num) < (exp1_size l xs :num)
shape_val_def_typed=(shape_val One :α exp) = (Const (0w :α word) :α exp) ∧ (∀(shapes :shape list). (shape_val (Comb shapes) :α exp) = RStruct (shape_vals shapes :α exp list)) ∧ (∀(nm :mlstring). (shape_val (Named nm) :α exp) = (Const (0w :α word) :α exp)) ∧ (shape_vals ([] :shape list) :α exp list) = ([] :α exp list) ∧ ∀(sh :shape) (shs :shape list). (shape_vals (sh::shs) :α exp list) = (shape_val sh :α exp)::(shape_vals shs :α exp list)
var_exp_def_typed=(∀(w :α word). var_exp (Const w :α exp) = ([] :mlstring list)) ∧ (∀(v :mlstring). var_exp (Var Local v :α exp) = [v]) ∧ (∀(v :mlstring). var_exp (Var Global v :α exp) = ([] :mlstring list)) ∧ (∀(es :α exp list). var_exp (RStruct es) = FLAT (MAP (λ(a :α exp). var_exp a) es)) ∧ (∀(i :num) (e :α exp). var_exp (RField i e) = var_exp e) ∧ (∀(sn :mlstring) (fes :(mlstring # α exp) list). var_exp (NStruct sn fes) = FLAT (MAP (λ(a :α exp). var_exp a) (MAP (SND :mlstring # α exp -> α exp) fes))) ∧ (∀(fld :mlstring) (e :α exp). var_exp (NField fld e) = var_exp e) ∧ (∀(sh :shape) (e :α exp). var_exp (Load sh e :α exp) = var_exp e) ∧ (∀(e :α exp). var_exp (Load32 e :α exp) = var_exp e) ∧ (∀(e :α exp). var_exp (LoadByte e) = var_exp e) ∧ (∀(es :α exp list) (bop :binop). var_exp (Op bop es) = FLAT (MAP (λ(a :α exp). var_exp a) es)) ∧ (∀(op :panop) (es :α exp list). var_exp (Panop op es) = FLAT (MAP (λ(a :α exp). var_exp a) es)) ∧ (∀(e2 :α exp) (e1 :α exp) (c :cmp). var_exp (Cmp c e1 e2) = var_exp e1 ++ var_exp e2) ∧ (∀(sh :ast$shift) (e2 :α exp) (e1 :α exp). var_exp (Shift sh e1 e2 :α exp) = var_exp e1 ++ var_exp e2) ∧ var_exp (BaseAddr :α exp) = ([] :mlstring list) ∧ var_exp (TopAddr :α exp) = ([] :mlstring list) ∧ var_exp (BytesInWord :α exp) = ([] :mlstring list)
prog_typed=Skip::α prog; Dec::mlstring -> shape -> α exp -> α prog -> α prog; Assign::varkind -> mlstring -> α exp -> α prog; Primitive::mlstring -> primop -> α exp list -> α prog; Store::α exp -> α exp -> α prog; Store32::α exp -> α exp -> α prog; StoreByte::α exp -> α exp -> α prog; Seq::α prog -> α prog -> α prog; If::α exp -> α prog -> α prog -> α prog; While::α exp -> α prog -> α prog; Break::α prog; Continue::α prog; Call::((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option -> mlstring -> α exp list -> α prog; DecCall::mlstring -> shape -> mlstring -> α exp list -> α prog -> α prog; ExtCall::mlstring -> α exp -> α exp -> α exp -> α exp -> α prog; Raise::mlstring -> α exp -> α prog; Return::α exp -> α prog; ShMemLoad::opsize -> varkind -> mlstring -> α exp -> α prog; ShMemStore::opsize -> α exp -> α exp -> α prog; Tick::α prog; Annot::mlstring -> mlstring -> α prog
exp_ids_def_typed=exp_ids (Skip :α prog) = ([] :mlstring list) ∧ (∀(v0 :α exp) (e :mlstring). exp_ids (Raise e v0 :α prog) = [e]) ∧ (∀(v3 :α exp) (v2 :shape) (v1 :mlstring) (p :α prog). exp_ids (Dec v1 v2 v3 p) = exp_ids p) ∧ (∀(q :α prog) (p :α prog). exp_ids (Seq p q) = exp_ids p ++ exp_ids q) ∧ (∀(v4 :α exp) (q :α prog) (p :α prog). exp_ids (If v4 p q) = exp_ids p ++ exp_ids q) ∧ (∀(v5 :α exp) (p :α prog). exp_ids (While v5 p) = exp_ids p) ∧ (∀(v9 :α exp list) (v8 :mlstring) (v7 :mlstring) (v6 :(varkind # mlstring) option) (ep :α prog) (e :mlstring). exp_ids (Call (SOME (v6,SOME (e,v7,ep))) v8 v9 :α prog) = e::exp_ids ep) ∧ (∀(v13 :α exp list) (v12 :mlstring) (v11 :shape) (v10 :mlstring) (p :α prog). exp_ids (DecCall v10 v11 v12 v13 p) = exp_ids p) ∧ (∀(v20 :α exp) (v19 :mlstring) (v18 :varkind). exp_ids (Assign v18 v19 v20) = ([] :mlstring list)) ∧ (∀(v23 :α exp list) (v22 :primop) (v21 :mlstring). exp_ids (Primitive v21 v22 v23) = ([] :mlstring list)) ∧ (∀(v25 :α exp) (v24 :α exp). exp_ids (Store v24 v25 :α prog) = ([] :mlstring list)) ∧ (∀(v27 :α exp) (v26 :α exp). exp_ids (Store32 v26 v27 :α prog) = ([] :mlstring list)) ∧ (∀(v29 :α exp) (v28 :α exp). exp_ids (StoreByte v28 v29) = ([] :mlstring list)) ∧ exp_ids (Break :α prog) = ([] :mlstring list) ∧ exp_ids (Continue :α prog) = ([] :mlstring list) ∧ (∀(v39 :α exp list) (v38 :mlstring). exp_ids (TailCall v38 v39) = ([] :mlstring list)) ∧ (∀(v39 :α exp list) (v38 :mlstring) (v112 :(varkind # mlstring) option). exp_ids (Call (SOME (v112,(NONE :(mlstring # mlstring # α prog) option))) v38 v39 :α prog) = ([] :mlstring list)) ∧ (∀(v49 :α exp) (v48 :α exp) (v47 :α exp) (v46 :α exp) (v45 :mlstring). exp_ids (ExtCall v45 v46 v47 v48 v49) = ([] :mlstring list)) ∧ (∀(v52 :α exp). exp_ids (Return v52) = ([] :mlstring list)) ∧ (∀(v56 :α exp) (v55 :mlstring) (v54 :varkind) (v53 :opsize). exp_ids (ShMemLoad v53 v54 v55 v56) = ([] :mlstring list)) ∧ (∀(v59 :α exp) (v58 :α exp) (v57 :opsize). exp_ids (ShMemStore v57 v58 v59) = ([] :mlstring list)) ∧ exp_ids (Tick :α prog) = ([] :mlstring list) ∧ ∀(v61 :mlstring) (v60 :mlstring). exp_ids (Annot v60 v61 :α prog) = ([] :mlstring list)
free_var_ids_def_typed=(∀(vn :mlstring) (sh :shape) (p :α prog) (e :α exp). free_var_ids (Dec vn sh e p) = var_exp e ++ FILTER (λ(y :mlstring). vn ≠ y) (free_var_ids p)) ∧ (∀(q :α prog) (p :α prog). free_var_ids (Seq p q) = free_var_ids p ++ free_var_ids q) ∧ (∀(q :α prog) (p :α prog) (g :α exp). free_var_ids (If g p q) = var_exp g ++ free_var_ids p ++ free_var_ids q) ∧ (∀(p :α prog) (g :α exp). free_var_ids (While g p) = var_exp g ++ free_var_ids p) ∧ (∀(vk :varkind) (v :mlstring) (e :α exp). free_var_ids (Assign vk v e) = if vk = Local then v::var_exp e else var_exp e) ∧ (∀(v :mlstring) (pop :primop) (es :α exp list). free_var_ids (Primitive v pop es) = v::FLAT (MAP (var_exp :α exp -> mlstring list) es)) ∧ (∀(e2 :α exp) (e1 :α exp). free_var_ids (Store e1 e2 :α prog) = var_exp e1 ++ var_exp e2) ∧ (∀(e2 :α exp) (e1 :α exp). free_var_ids (Store32 e1 e2 :α prog) = var_exp e1 ++ var_exp e2) ∧ (∀(e2 :α exp) (e1 :α exp). free_var_ids (StoreByte e1 e2) = var_exp e1 ++ var_exp e2) ∧ (∀(eid :mlstring) (e :α exp). free_var_ids (Raise eid e :α prog) = var_exp e) ∧ (∀(e :α exp). free_var_ids (Return e) = var_exp e) ∧ (∀(fn :mlstring) (e4 :α exp) (e3 :α exp) (e2 :α exp) (e1 :α exp). free_var_ids (ExtCall fn e1 e2 e3 e4) = var_exp e1 ++ var_exp e2 ++ var_exp e3 ++ var_exp e4) ∧ (∀(vk :varkind) (v :mlstring) (os :opsize) (e :α exp). free_var_ids (ShMemLoad os vk v e) = if vk = Local then v::var_exp e else var_exp e) ∧ (∀(os :opsize) (e2 :α exp) (e1 :α exp). free_var_ids (ShMemStore os e1 e2) = var_exp e1 ++ var_exp e2) ∧ (∀(vn :mlstring) (v1 :mlstring) (v0 :mlstring) (ep :α prog) (args :α exp list). free_var_ids (StandAloneCall (SOME (v0,vn,ep)) v1 args) = vn::free_var_ids ep ++ FLAT (MAP (var_exp :α exp -> mlstring list) args)) ∧ (∀(vn :mlstring) (vk :varkind) (v3 :mlstring) (v2 :mlstring) (ep :α prog) (en :mlstring) (args :α exp list). free_var_ids (AssignCall (vk,vn) (SOME (v2,en,ep)) v3 args) = (if vk = Local then [vn] else ([] :mlstring list)) ++ en::free_var_ids ep ++ FLAT (MAP (var_exp :α exp -> mlstring list) args)) ∧ (∀(vn :mlstring) (vk :varkind) (v4 :mlstring) (args :α exp list). free_var_ids (AssignCall (vk,vn) (NONE :(mlstring # mlstring # α prog) option) v4 args) = (if vk = Local then [vn] else ([] :mlstring list)) ++ FLAT (MAP (var_exp :α exp -> mlstring list) args)) ∧ (∀(v5 :mlstring) (args :α exp list). free_var_ids (StandAloneCall (NONE :(mlstring # mlstring # α prog) option) v5 args) = FLAT (MAP (var_exp :α exp -> mlstring list) args)) ∧ (∀(v6 :mlstring) (args :α exp list). free_var_ids (TailCall v6 args) = FLAT (MAP (var_exp :α exp -> mlstring list) args)) ∧ (∀(vn :mlstring) (v8 :mlstring) (v7 :shape) (p :α prog) (args :α exp list). free_var_ids (DecCall vn v7 v8 args p) = vn::free_var_ids p ++ FLAT (MAP (var_exp :α exp -> mlstring list) args)) ∧ free_var_ids (Skip :α prog) = ([] :mlstring list) ∧ free_var_ids (Break :α prog) = ([] :mlstring list) ∧ free_var_ids (Continue :α prog) = ([] :mlstring list) ∧ free_var_ids (Tick :α prog) = ([] :mlstring list) ∧ ∀(v57 :mlstring) (v56 :mlstring). free_var_ids (Annot v56 v57 :α prog) = ([] :mlstring list)
fun_ids_def_typed=(∀(v2 :α exp) (v1 :shape) (v0 :mlstring) (p :α prog). fun_ids (Dec v0 v1 v2 p) = fun_ids p) ∧ (∀(q :α prog) (p :α prog). fun_ids (Seq p q) = fun_ids p ++ fun_ids q) ∧ (∀(v3 :α exp) (q :α prog) (p :α prog). fun_ids (If v3 p q) = fun_ids p ++ fun_ids q) ∧ (∀(v4 :α exp) (p :α prog). fun_ids (While v4 p) = fun_ids p) ∧ (∀(v8 :α exp list) (v7 :mlstring) (v6 :mlstring) (v5 :(varkind # mlstring) option) (nm :mlstring) (ep :α prog). fun_ids (Call (SOME (v5,SOME (v6,v7,ep))) nm v8 :α prog) = nm::fun_ids ep) ∧ (∀(v10 :α exp list) (nm :mlstring). fun_ids (TailCall nm v10) = [nm]) ∧ (∀(v113 :(varkind # mlstring) option) (v10 :α exp list) (nm :mlstring). fun_ids (Call (SOME (v113,(NONE :(mlstring # mlstring # α prog) option))) nm v10 :α prog) = [nm]) ∧ (∀(v13 :α exp list) (v12 :shape) (v11 :mlstring) (p :α prog) (nm :mlstring). fun_ids (DecCall v11 v12 nm v13 p) = nm::fun_ids p) ∧ fun_ids (Skip :α prog) = ([] :mlstring list) ∧ (∀(v20 :α exp) (v19 :mlstring) (v18 :varkind). fun_ids (Assign v18 v19 v20) = ([] :mlstring list)) ∧ (∀(v23 :α exp list) (v22 :primop) (v21 :mlstring). fun_ids (Primitive v21 v22 v23) = ([] :mlstring list)) ∧ (∀(v25 :α exp) (v24 :α exp). fun_ids (Store v24 v25 :α prog) = ([] :mlstring list)) ∧ (∀(v27 :α exp) (v26 :α exp). fun_ids (Store32 v26 v27 :α prog) = ([] :mlstring list)) ∧ (∀(v29 :α exp) (v28 :α exp). fun_ids (StoreByte v28 v29) = ([] :mlstring list)) ∧ fun_ids (Break :α prog) = ([] :mlstring list) ∧ fun_ids (Continue :α prog) = ([] :mlstring list) ∧ (∀(v49 :α exp) (v48 :α exp) (v47 :α exp) (v46 :α exp) (v45 :mlstring). fun_ids (ExtCall v45 v46 v47 v48 v49) = ([] :mlstring list)) ∧ (∀(v51 :α exp) (v50 :mlstring). fun_ids (Raise v50 v51 :α prog) = ([] :mlstring list)) ∧ (∀(v52 :α exp). fun_ids (Return v52) = ([] :mlstring list)) ∧ (∀(v56 :α exp) (v55 :mlstring) (v54 :varkind) (v53 :opsize). fun_ids (ShMemLoad v53 v54 v55 v56) = ([] :mlstring list)) ∧ (∀(v59 :α exp) (v58 :α exp) (v57 :opsize). fun_ids (ShMemStore v57 v58 v59) = ([] :mlstring list)) ∧ fun_ids (Tick :α prog) = ([] :mlstring list) ∧ ∀(v61 :mlstring) (v60 :mlstring). fun_ids (Annot v60 v61 :α prog) = ([] :mlstring list)
nested_seq_def_typed=nested_seq ([] :α prog list) = (Skip :α prog) ∧ ∀(e :α prog) (es :α prog list). nested_seq (e::es) = Seq e (nested_seq es)
shape_typed=One::shape; Comb::shape list -> shape; Named::mlstring -> shape
MEM_IMP_shape_size_typed=∀(shapes :shape list) (a :shape). MEM a shapes ⇒ shape_size a < (1 :num) + shape1_size shapes
shape_to_str_def_typed=shape_to_str One = «1» ∧ shape_to_str (Comb ([] :shape list)) = «{}» ∧ (∀(xs :shape list) (x :shape). shape_to_str (Comb (x::xs)) = concat («{»::shape_to_str x::MAP (λ(x :mlstring). «,» ^ x) (MAP (λ(a :shape). shape_to_str a) xs) ++ [«}»])) ∧ ∀(nm :mlstring). shape_to_str (Named nm) = nm
size_of_shape_def_typed=size_of_shape One = (1 :num) ∧ (∀(shapes :shape list). size_of_shape (Comb shapes) = (SUM (MAP (λ(a :shape). size_of_shape a) shapes) :num)) ∧ ∀(name :mlstring). size_of_shape (Named name) = (1 :num)
with_shape_def_typed=(∀(v0 :α list). with_shape ([] :shape list) v0 = ([] :α list list)) ∧ ∀(sh :shape) (shs :shape list) (e :α list). with_shape (sh::shs) e = TAKE (size_of_shape sh) e::with_shape shs (DROP (size_of_shape sh) e)
load_op_def_typed=load_op Op8 = Load8 ∧ load_op Op16 = Load16 ∧ load_op OpW = Load ∧ load_op Op32 = Load32
store_op_def_typed=store_op Op8 = Store8 ∧ store_op Op16 = Store16 ∧ store_op OpW = Store ∧ store_op Op32 = Store32
