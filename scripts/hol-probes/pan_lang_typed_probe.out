exceptions_def_typed=exceptions ([] :α decl list) = ([] :(mlstring # shape) list) ∧ (∀(fs :α decl list) (fi :α fun_decl). exceptions (Function fi::fs) = exceptions fs) ∧ (∀(v2 :α exp) (v1 :mlstring) (v0 :shape) (fs :α decl list). exceptions (Decl v0 v1 v2::fs) = exceptions fs) ∧ (∀(sh :shape) (fs :α decl list) (eid :mlstring). exceptions ((ExnDecl eid sh :α decl)::fs) = (eid,sh)::exceptions fs) ∧ ∀(v4 :(mlstring # shape) list) (v3 :mlstring) (fs :α decl list). exceptions ((Name v3 v4 :α decl)::fs) = exceptions fs
functions_def_typed=functions ([] :α decl list) = ([] :(mlstring # (mlstring # shape) list # α prog # shape) list) ∧ (∀(fs :α decl list) (fi :α fun_decl). functions (Function fi::fs) = (fi.name,fi.params,fi.body,fi.return)::functions fs) ∧ (∀(v2 :α exp) (v1 :mlstring) (v0 :shape) (fs :α decl list). functions (Decl v0 v1 v2::fs) = functions fs) ∧ (∀(v4 :shape) (v3 :mlstring) (fs :α decl list). functions ((ExnDecl v3 v4 :α decl)::fs) = functions fs) ∧ ∀(v6 :(mlstring # shape) list) (v5 :mlstring) (fs :α decl list). functions ((Name v5 v6 :α decl)::fs) = functions fs
inlinable_def_typed=(inlinable (Function (fi :α fun_decl)) ⇔ fi.inline) ∧ (inlinable (Decl (v1 :shape) (v2 :mlstring) (v3 :α exp)) ⇔ F) ∧ (inlinable (ExnDecl (v4 :mlstring) (v5 :shape) :α decl) ⇔ F) ∧ (inlinable (Name (v6 :mlstring) (v7 :(mlstring # shape) list) :α decl) ⇔ F)
is_decl_def_typed=(is_decl (Decl (sh :shape) (v :mlstring) (e :α exp)) ⇔ T) ∧ (is_decl (Function (v1 :α fun_decl)) ⇔ F) ∧ (is_decl (ExnDecl (v5 :mlstring) (v6 :shape) :α decl) ⇔ F) ∧ (is_decl (Name (v7 :mlstring) (v8 :(mlstring # shape) list) :α decl) ⇔ F)
is_exn_decl_def_typed=(is_exn_decl (ExnDecl (eid :mlstring) (sh :shape) :α decl) ⇔ T) ∧ (is_exn_decl (Function (v :α fun_decl)) ⇔ F) ∧ (is_exn_decl (Decl (v1 :shape) (v2 :mlstring) (v3 :α exp)) ⇔ F) ∧ (is_exn_decl (Name (v6 :mlstring) (v7 :(mlstring # shape) list) :α decl) ⇔ F)
is_function_def_typed=(is_function (Function (v0 :α fun_decl)) ⇔ T) ∧ (is_function (Decl (v2 :shape) (v3 :mlstring) (v4 :α exp)) ⇔ F) ∧ (is_function (ExnDecl (v5 :mlstring) (v6 :shape) :α decl) ⇔ F) ∧ (is_function (Name (v7 :mlstring) (v8 :(mlstring # shape) list) :α decl) ⇔ F)
is_name_def_typed=(is_name (Name (v0 :mlstring) (v1 :(mlstring # shape) list) :α decl) ⇔ T) ∧ (is_name (Function (v :α fun_decl)) ⇔ F) ∧ (is_name (Decl (v3 :shape) (v4 :mlstring) (v5 :α exp)) ⇔ F) ∧ (is_name (ExnDecl (v6 :mlstring) (v7 :shape) :α decl) ⇔ F)
is_wf_ctxt_def_typed=(is_wf_ctxt ([] :(mlstring # struct_info) list) ⇔ T) ∧ ∀(nm :mlstring) (info :struct_info) (ctxt' :(mlstring # struct_info) list). is_wf_ctxt ((nm,info)::ctxt') ⇔ ALOOKUP ctxt' nm = (NONE :struct_info option) ∧ is_wf_flds ctxt' info.fields ∧ is_wf_ctxt ctxt'
is_wf_flds_def_typed=(∀(ctxt :(mlstring # α) list). is_wf_flds ctxt ([] :(β # shape) list) ⇔ T) ∧ ∀(sh :shape) (flds :(β # shape) list) (fld :β) (ctxt :(mlstring # α) list). is_wf_flds ctxt ((fld,sh)::flds) ⇔ is_wf_shape ctxt sh ∧ is_wf_flds ctxt flds
is_wf_shape_def_typed=(∀(ctxt :(mlstring # α) list). is_wf_shape ctxt One ⇔ T) ∧ (∀(shs :shape list) (ctxt :(mlstring # α) list). is_wf_shape ctxt (Comb shs) ⇔ EVERY (λ(a :shape). is_wf_shape ctxt a) shs) ∧ ∀(nm :mlstring) (ctxt :(mlstring # α) list). is_wf_shape ctxt (Named nm) ⇔ case ALOOKUP ctxt nm of (NONE :α option) => F | SOME flds => T
size_of_eids_def_typed=∀(prog :α decl list). size_of_eids prog = LENGTH (FILTER (is_exn_decl :α decl -> bool) prog)
size_of_sh_with_ctxt_def_typed=(∀(ctxt :(mlstring # struct_info) list). size_of_sh_with_ctxt ctxt One = (1 :num)) ∧ (∀(shapes :shape list) (ctxt :(mlstring # struct_info) list). size_of_sh_with_ctxt ctxt (Comb shapes) = (SUM (MAP (λ(a :shape). size_of_sh_with_ctxt ctxt a) shapes) :num)) ∧ ∀(name :mlstring) (ctxt :(mlstring # struct_info) list). size_of_sh_with_ctxt ctxt (Named name) = case ALOOKUP ctxt name of (NONE :struct_info option) => (1 :num) | SOME info => info.size
