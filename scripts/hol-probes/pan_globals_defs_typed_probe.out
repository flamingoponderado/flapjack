dec_shapes_def_typed=(∀(v0 :α fun_decl) (ds :α decl list). dec_shapes (Function v0::ds) = dec_shapes ds) ∧ (∀(v2 :α exp) (v1 :mlstring) (sh :shape) (ds :α decl list). dec_shapes (Decl sh v1 v2::ds) = sh::dec_shapes ds) ∧ (∀(v4 :(mlstring # shape) list) (v3 :mlstring) (ds :α decl list). dec_shapes ((Name v3 v4 :α decl)::ds) = dec_shapes ds) ∧ (∀(v6 :shape) (v5 :mlstring) (ds :α decl list). dec_shapes ((ExnDecl v5 v6 :α decl)::ds) = dec_shapes ds) ∧ dec_shapes ([] :α decl list) = ([] :shape list)
fperm_decs_def_typed=(∀(g :mlstring) (f :mlstring). fperm_decs f g ([] :α decl list) = ([] :α decl list)) ∧ (∀(g :mlstring) (fi :α fun_decl) (f :mlstring) (decs :α decl list). fperm_decs f g (Function fi::decs) = Function (fi with <|name := fperm_name f g fi.name; body := fperm f g fi.body|>)::fperm_decs f g decs) ∧ (∀(v9 :α exp) (v8 :mlstring) (v7 :shape) (g :mlstring) (f :mlstring) (decs :α decl list). fperm_decs f g (Decl v7 v8 v9::decs) = Decl v7 v8 v9::fperm_decs f g decs) ∧ (∀(v11 :shape) (v10 :mlstring) (g :mlstring) (f :mlstring) (decs :α decl list). fperm_decs f g ((ExnDecl v10 v11 :α decl)::decs) = (ExnDecl v10 v11 :α decl)::fperm_decs f g decs) ∧ ∀(v13 :(mlstring # shape) list) (v12 :mlstring) (g :mlstring) (f :mlstring) (decs :α decl list). fperm_decs f g ((Name v12 v13 :α decl)::decs) = (Name v12 v13 :α decl)::fperm_decs f g decs
fperm_def_typed=(∀(v :mlstring) (s :shape) (p :α prog) (g :mlstring) (f :mlstring) (e :α exp). fperm f g (Dec v s e p) = Dec v s e (fperm f g p)) ∧ (∀(p' :α prog) (p :α prog) (g :mlstring) (f :mlstring). fperm f g (Seq p p') = Seq (fperm f g p) (fperm f g p')) ∧ (∀(p' :α prog) (p :α prog) (g :mlstring) (f :mlstring) (e :α exp). fperm f g (If e p p') = If e (fperm f g p) (fperm f g p')) ∧ (∀(p :α prog) (g :mlstring) (f :mlstring) (e :α exp). fperm f g (While e p) = While e (fperm f g p)) ∧ (∀(rtyp :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) (g :mlstring) (f :mlstring) (es :α exp list) (e :mlstring). fperm f g (Call rtyp e es :α prog) = (Call (case rtyp of (NONE :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) => (NONE :((varkind # mlstring) option # (mlstring # mlstring # α prog) option) option) | SOME (tl,hdl) => SOME (tl,case hdl of (NONE :(mlstring # mlstring # α prog) option) => (NONE :(mlstring # mlstring # α prog) option) | SOME (eid,evar,p) => SOME (eid,evar,fperm f g p))) (fperm_name f g e) es :α prog)) ∧ (∀(v :mlstring) (s :shape) (p :α prog) (g :mlstring) (f :mlstring) (es :α exp list) (e :mlstring). fperm f g (DecCall v s e es p) = DecCall v s (fperm_name f g e) es (fperm f g p)) ∧ (∀(v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Skip :α prog) = (Skip :α prog)) ∧ (∀(v13 :α exp) (v12 :mlstring) (v11 :varkind) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Assign v11 v12 v13) = Assign v11 v12 v13) ∧ (∀(v16 :α exp list) (v15 :primop) (v14 :mlstring) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Primitive v14 v15 v16) = Primitive v14 v15 v16) ∧ (∀(v18 :α exp) (v17 :α exp) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Store v17 v18 :α prog) = (Store v17 v18 :α prog)) ∧ (∀(v20 :α exp) (v19 :α exp) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Store32 v19 v20 :α prog) = (Store32 v19 v20 :α prog)) ∧ (∀(v22 :α exp) (v21 :α exp) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (StoreByte v21 v22) = StoreByte v21 v22) ∧ (∀(v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Break :α prog) = (Break :α prog)) ∧ (∀(v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Continue :α prog) = (Continue :α prog)) ∧ (∀(v42 :α exp) (v41 :α exp) (v40 :α exp) (v39 :α exp) (v38 :mlstring) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (ExtCall v38 v39 v40 v41 v42) = ExtCall v38 v39 v40 v41 v42) ∧ (∀(v44 :α exp) (v43 :mlstring) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Raise v43 v44 :α prog) = (Raise v43 v44 :α prog)) ∧ (∀(v45 :α exp) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Return v45) = Return v45) ∧ (∀(v49 :α exp) (v48 :mlstring) (v47 :varkind) (v46 :opsize) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (ShMemLoad v46 v47 v48 v49) = ShMemLoad v46 v47 v48 v49) ∧ (∀(v52 :α exp) (v51 :α exp) (v50 :opsize) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (ShMemStore v50 v51 v52) = ShMemStore v50 v51 v52) ∧ (∀(v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Tick :α prog) = (Tick :α prog)) ∧ ∀(v54 :mlstring) (v53 :mlstring) (v1 :mlstring) (v0 :mlstring). fperm v0 v1 (Annot v53 v54 :α prog) = (Annot v53 v54 :α prog)
fperm_name_def_typed=∀(f :α) (g :α) (h :α). fperm_name f g h = if f = h then g else if g = h then f else h
fresh_name_def_typed=∀(names :mlstring list) (name :mlstring). fresh_name name names = if MEM name names then fresh_name (name ^ «'») names else name
new_main_name_def_typed=∀(decls :α decl list). new_main_name decls = fresh_name «main» (MAP (FST :mlstring # (mlstring # shape) list # α prog # shape -> mlstring) (functions decls))
resort_decls_def_typed=∀(decs :α decl list). resort_decls decs = FILTER (is_name :α decl -> bool) decs ++ FILTER (is_exn_decl :α decl -> bool) decs ++ FILTER (is_decl :α decl -> bool) decs ++ FILTER (is_function :α decl -> bool) decs
compile_top_def_typed=∀(decs :α decl list) (start :mlstring). compile_top decs start = case ALOOKUP (functions decs) start of (NONE :((mlstring # shape) list # α prog # shape) option) => ([] :α decl list) | SOME (args,body,rshape) => (let (nds :α decl list) = resort_decls decs; (start' :mlstring) = new_main_name decs; (nds' :α decl list) = fperm_decs start start' nds; ((decls :α prog list),(funs :α decl list),(exns :α decl list),(ctxt :α context)) = compile_decs <|globals := (FEMPTY :mlstring |-> shape # α word); globals_size := (0w :α word); max_globals_size := (bytes_in_word :α word) * (n2w (SUM (MAP size_of_shape (dec_shapes nds')) :num) :α word)|> nds'; (params :α exp list) = MAP ((Var Local :mlstring -> α exp) ∘ (FST :mlstring # shape -> mlstring)) args; (new_main :α decl) = Function <|name := start; inline := F; export := F; params := args; body := Seq (nested_seq decls) (TailCall start' params); return := rshape|> in exns ++ new_main::funs)
