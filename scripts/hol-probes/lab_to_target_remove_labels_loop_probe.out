remove_labels_loop_thm=∀(n :num) (c :α asm_config) (init_pos :num)
    (init_labs :num sptree$num_map sptree$num_map) (ffis :ffiname list)
    (code :α sec list) (code2 :α sec list)
    (labs :num sptree$num_map sptree$num_map).
  remove_labels_loop n c init_pos init_labs ffis code = SOME (code2,labs) ∧
  EVERY (sec_ends_with_label :α sec -> bool) code ∧
  EVERY (sec_labels_ok :α sec -> bool) code ∧
  ALL_DISTINCT (MAP (Section_num :α sec -> num) code) ∧
  EVERY
    ((ALL_DISTINCT :(num # num) list -> bool) ∘
     (extract_labels :α line list -> (num # num) list) ∘
     (Section_lines :α sec -> α line list)) code ∧
  DISJOINT (domain init_labs :num -> bool)
    (set (MAP (Section_num :α sec -> num) code)) ∧
  restrict_nonzero (get_labels code) ⊆
  get_code_labels code ∪ labs_domain init_labs ∧ all_enc_ok_pre c code ∧
  all_encd0 c.encode code ∧ enc_ok c ∧ EVEN init_pos ∧
  (∀(l1 :num) (l2 :num). OPTION_ALL EVEN (lab_lookup l1 l2 init_labs)) ⇒
  all_enc_ok_pre c code2 ∧ EVERY (sec_labels_ok :α sec -> bool) code2 ∧
  all_enc_ok c labs ffis init_pos code2 ∧ code_similar code code2 ∧
  (has_odd_inst code2 ⇒ c.code_alignment = (0 :num)) ∧
  (∀(l1 :num) (l2 :num) (x :num). lab_lookup l1 l2 labs = SOME x ⇒ EVEN x) ∧
  (∀(l1 :num) (l2 :num) (x :num).
     lab_lookup l1 l2 init_labs = SOME x ⇒ lab_lookup l1 l2 labs = SOME x) ∧
  ∀(l1 :num) (l2 :num) (x2 :num).
    loc_to_pc l1 l2 code = SOME x2 ⇒
    lab_lookup l1 l2 labs = SOME (pos_val x2 init_pos code2)
remove_labels_loop_thm_types=(n :num)::num;(c :α asm_config)::α asm_config;(init_pos :num)::num;(init_labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(code :α sec list)::α sec list;(code2 :α sec list)::α sec list;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;
hypotheses=0
empty=T
retry_zero=T
retry_one=T
odd_padding=T
labels_only=T
light_reject=T
width1_large=T
width80_large=T
