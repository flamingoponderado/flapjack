enc_lines_again_line_labs_exist=∀(labs :num sptree$num_map sptree$num_map) (ffis :ffiname list) (pos :num)
    (enc :α asm -> word8 list) (lines :α line list) (acc :α line list)
    (ok :bool) (res :α line list) (ok' :num # bool) (k :β).
  enc_lines_again labs ffis pos enc lines (acc,ok) = (res,ok') ∧
  EVERY
    (line_labs_exist (labs' :γ sptree$num_map sptree$num_map) :α line -> bool)
    acc ∧ EVERY (line_labs_exist labs' :α line -> bool) lines ⇒
  EVERY (line_labs_exist labs' :α line -> bool) res
enc_lines_again_line_labs_exist_types=(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(ffis :ffiname list)::ffiname list;(pos :num)::num;(enc :α asm -> word8 list)::α asm -> word8 list;(lines :α line list)::α line list;(acc :α line list)::α line list;(ok :bool)::bool;(res :α line list)::α line list;(ok' :num # bool)::num # bool;(k :β)::β;(labs' :γ sptree$num_map sptree$num_map)::γ sptree$num_map sptree$num_map;
enc_secs_again_all_labs_exist=∀(pos :num) (ffis :num sptree$num_map sptree$num_map) (labs :ffiname list)
    (enc :α asm -> word8 list) (ls :α sec list) (res :α sec list) (ok :bool)
    (k :β).
  enc_secs_again pos ffis labs enc ls = (res,ok) ∧
  all_labs_exist (labs' :γ sptree$num_map sptree$num_map) ls ⇒
  all_labs_exist labs' res
