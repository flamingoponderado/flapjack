word_test_lemma2_typed=good_dimindex (:α) ⇒ ((60w :α word) && (x :α word) = (n2w (((0 :num) + (6 :num)) * (4 :num)) :α word) ⇔ ¬word_bit (2 :num) x ∧ word_bit (3 :num) x ∧ word_bit (4 :num) x ∧ ¬word_bit (5 :num) x)
