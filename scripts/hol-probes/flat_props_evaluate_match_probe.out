evaluate_match_typed=!(env :v environment) (s :('a, 'b) state) (v :v) (pes :(pat # exp) list) (err_v :v). (evaluate_match env s v pes err_v :('a, 'b) state # (v list, v) result) = case pmatch_rows pes s v of (No_match :((mlstring # v) list # pat # exp) match_result) => (s,(Rerr (Rraise err_v) :(v list, v) result)) | (Match_type_error :((mlstring # v) list # pat # exp) match_result) => (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | Match (env',p',e') => if ALL_DISTINCT (pat_bindings p') then (evaluate (env with v := env' ++ env.v) s [e'] :('a, 'b) state # (v list, v) result) else (s,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))
