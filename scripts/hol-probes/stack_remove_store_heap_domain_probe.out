sd_statement=MEM name store_list ∧ (memory s.memory s.mdomain * word_list (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α)) (MAP Word s.bitmaps ++ MAP Word s.data_buffer.buffer) * word_list_exists (the_SOME_Word (FLOOKUP s.store BitmapBase) ≪ shift (:α) + bytes_in_word * n2w (LENGTH s.data_buffer.buffer + LENGTH s.bitmaps)) s.data_buffer.space_left * word_store c s.store * word_list c s.stack) (fun2set (t1.memory,t1.mdomain)) ⇒ c + store_offset name ∈ t1.mdomain
sd_types=t1:(α, γ, β) stackSem$state;c:α word;s:(α, δ, ε) stackSem$state;name:store_name
