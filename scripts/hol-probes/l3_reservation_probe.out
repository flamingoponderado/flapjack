reserve_read_definition=∀state. ReserveLoad state = state.c_ReserveLoad state.procID
reserve_read_type=:riscv_state -> word64 option
reserve_write_definition=∀value. write'ReserveLoad value = (λstate. state with c_ReserveLoad := state.c_ReserveLoad⦇state.procID ↦ value⦈)
reserve_write_type=:word64 option -> riscv_state -> riscv_state
reserve_match_definition=∀vAddr. matchLoadReservation vAddr = (λstate. IS_SOME (ReserveLoad state) ∧ THE (ReserveLoad state) = vAddr)
reserve_match_type=:word64 -> riscv_state -> bool
