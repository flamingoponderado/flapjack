signal0_definition=∀_. signalEnvCall _ = (λstate. signalException (case privilege (MCSR state).mstatus.MPRV of User => UMode_Env_Call | Supervisor => SMode_Env_Call | Hypervisor => HMode_Env_Call | Machine => MMode_Env_Call) state)
signal0_type=:unit -> riscv_state -> riscv_state
signal1_definition=∀state. dfn'ECALL state = signalEnvCall () state
signal1_type=:riscv_state -> riscv_state
signal2_definition=∀state. dfn'EBREAK state = signalException Breakpoint state
signal2_type=:riscv_state -> riscv_state
signal3_definition=∀state. dfn'ERET state = write'NextFetch (SOME Ereturn) state
signal3_type=:riscv_state -> riscv_state
signal4_definition=∀state. dfn'UnknownInstruction state = signalException Illegal_Instr state
signal4_type=:riscv_state -> riscv_state
