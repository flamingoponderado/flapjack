is_final_def_typed=∀(conf :α) (state :(β, γ) gc_state) (ptr :num). is_final conf state ptr ⇔ (let (h1end :num) = heap_length state.h1; (r3start :num) = state.a + state.n + heap_length state.r4; (r3end :num) = r3start + heap_length state.r3; (r1start :num) = r3end + heap_length state.r2 in ptr < h1end ∨ r1start ≤ ptr ∨ r3start ≤ ptr ∧ ptr < r3end)
heap_lookup_APPEND_typed=∀(j :num) (xs :(α, β) heap_element list) (ys :(α, β) heap_element list). heap_lookup j (xs ++ ys) = if j < heap_length xs then heap_lookup j xs else heap_lookup (j − heap_length xs) ys
gc_move_list_length_typed=∀(xs :α heap_address list) (xs' :α heap_address list) (state :(α, β) gc_state) (state' :(α, β) gc_state). gc_move_list (conf :β gen_gc_conf) state xs = (xs',state') ⇒ LENGTH xs' = LENGTH xs
gen_gc_LENGTH_typed=gen_gc (c :β gen_gc_conf) ((xs :α heap_address list),(heap :(α, β) heap_element list)) = ((ys :α heap_address list),(s :(α, β) gc_state)) ⇒ LENGTH ys = LENGTH xs
gc_move_loop_ok_typed=∀(conf :α gen_gc_conf) (s :(β, α) gc_state) (c :num). (gc_move_loop conf s c).ok ⇒ s.ok
gc_move_refs_ok_typed=∀(conf :α gen_gc_conf) (s :(β, α) gc_state). (gc_move_refs conf s).ok ⇒ s.ok
gc_move_data_ok_typed=∀(conf :α gen_gc_conf) (s :(β, α) gc_state). (gc_move_data conf s).ok ⇒ s.ok
gc_move_data_h2_typed=∀(conf :α gen_gc_conf) (s :(β, α) gc_state). (gc_move_data conf s).ok ⇒ (gc_move_data conf s).h2 = ([] :(β, α) heap_element list)
gc_move_ok_typed=gc_move (conf :β gen_gc_conf) (state :(α, β) gc_state) (x :α heap_address) = ((x' :α heap_address),(state' :(α, β) gc_state)) ∧ state'.ok ⇒ state.ok
gc_move_list_ok_typed=∀(xs :α heap_address list) (xs' :α heap_address list) (state :(α, β) gc_state) (state' :(α, β) gc_state). gc_move_list (conf :β gen_gc_conf) state xs = (xs',state') ∧ state'.ok ⇒ state.ok
gen_gc_conf_typed=recordtype.gen_gc_conf::num -> (α -> bool) -> α gen_gc_conf
gc_move_def_typed=(∀(conf :β gen_gc_conf) (state :(α, β) gc_state) (d :α). gc_move conf state (Data d) = (Data d,state)) ∧ ∀(conf :β gen_gc_conf) (state :(α, β) gc_state) (ptr :num) (d :α). gc_move conf state (Pointer ptr d) = case heap_lookup ptr state.heap of (NONE :(α, β) heap_element option) => (Pointer ptr d,state with ok := F) | SOME (Unused v9 :(α, β) heap_element) => (Pointer ptr d,state with ok := F) | SOME (ForwardPointer v10 v11 v12 :(α, β) heap_element) => (Pointer v10 d,state) | SOME (DataElement xs l dd) => (let (ok :bool) = (state.ok ∧ l + (1 :num) ≤ state.n); (n :num) = state.n − (l + (1 :num)) in if conf.isRef dd then (let (r4 :(α, β) heap_element list) = DataElement xs l dd::state.r4; ((heap :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr ptr state.heap (state.a + n) d ok in (Pointer (state.a + n) d,state with <|r4 := r4; n := n; heap := heap; ok := ok|>)) else (let (h2 :(α, β) heap_element list) = state.h2 ++ [DataElement xs l dd]; ((heap :(α, β) heap_element list),(ok :bool)) = gc_forward_ptr ptr state.heap state.a d ok; (a :num) = state.a + l + (1 :num) in (Pointer state.a d,state with <|h2 := h2; n := n; a := a; heap := heap; ok := ok|>)))
gc_move_list_def_typed=(∀(conf :β gen_gc_conf) (state :(α, β) gc_state). gc_move_list conf state ([] :α heap_address list) = (([] :α heap_address list),state)) ∧ ∀(conf :β gen_gc_conf) (state :(α, β) gc_state) (x :α heap_address) (xs :α heap_address list). gc_move_list conf state (x::xs) = (let ((x :α heap_address),(state :(α, β) gc_state)) = gc_move conf state x; ((xs :α heap_address list),(state :(α, β) gc_state)) = gc_move_list conf state xs in (x::xs,state))
gc_move_data_def_typed=∀(state :(α, β) gc_state) (conf :β gen_gc_conf). gc_move_data conf state = case state.h2 of ([] :(α, β) heap_element list) => state | h::h2 => if conf.limit < heap_length (state.h1 ++ h::h2) then state with ok := F else case h of (Unused v7 :(α, β) heap_element) => state with ok := F | (ForwardPointer v8 v9 v10 :(α, β) heap_element) => state with ok := F | DataElement xs l d => (let ((xs' :α heap_address list),(state' :(α, β) gc_state)) = gc_move_list conf state xs; (h1 :(α, β) heap_element list) = state'.h1 ++ [DataElement xs' l d]; (h2' :(α, β) heap_element list) = TL state'.h2; (ok :bool) = (state'.ok ∧ state'.h2 ≠ ([] :(α, β) heap_element list) ∧ HD state'.h2 = h) in gc_move_data conf (state' with <|h1 := h1; h2 := h2'; ok := ok|>))
gc_move_refs_def_typed=∀(state :(α, β) gc_state) (conf :β gen_gc_conf). gc_move_refs conf state = case state.r2 of ([] :(α, β) heap_element list) => state with <|r3 := ([] :(α, β) heap_element list); r1 := state.r3 ++ state.r1|> | (Unused v7 :(α, β) heap_element)::v1 => state with ok := F | (ForwardPointer v8 v9 v10 :(α, β) heap_element)::v1 => state with ok := F | DataElement xs l d::v1 => (let ((xs' :α heap_address list),(state' :(α, β) gc_state)) = gc_move_list conf state xs; (r3 :(α, β) heap_element list) = state'.r3 ++ [DataElement xs' l d] in gc_move_refs conf (state' with <|r2 := v1; r3 := r3|>))
gc_move_loop_def_typed=∀(state :(α, β) gc_state) (conf :β gen_gc_conf) (clock :num). gc_move_loop conf state clock = case state.r4 of ([] :(α, β) heap_element list) => (case state.h2 of ([] :(α, β) heap_element list) => state | h::h2 => (let (state' :(α, β) gc_state) = gc_move_data conf state in if clock = (0 :num) then state' with ok := F else gc_move_loop conf state' (clock − (1 :num)))) | h::r4 => (let (state' :(α, β) gc_state) = gc_move_refs conf (state with <|r2 := state.r4; r4 := ([] :(α, β) heap_element list)|>) in if clock = (0 :num) then state' with ok := F else gc_move_loop conf state' (clock − (1 :num)))
gen_gc_def_typed=∀(conf :β gen_gc_conf) (roots :α heap_address list) (heap :(α, β) heap_element list). gen_gc conf (roots,heap) = (let (state :(α, β) gc_state) = (empty_state :(α, β) gc_state) with <|heap := heap; n := conf.limit; ok := (heap_length heap = conf.limit)|>; ((roots :α heap_address list),(state :(α, β) gc_state)) = gc_move_list conf state roots; (state :(α, β) gc_state) = gc_move_loop conf state conf.limit in (roots,state))
heap_lookup_IMP_heap_addresses_typed=∀(xs :(α, β) heap_element list) (x :(α, β) heap_element) (j :num). heap_lookup j xs = SOME x ⇒ j ∈ heap_addresses (0 :num) xs
