bmct_lookup=⊢ (∀(cmp :β -> γ -> ordering) (k :β). lookup cmp k (Tip :(γ, α) balanced_map) = (NONE :α option)) ∧ ∀(cmp :β -> γ -> ordering) (k :β) (s :num) (k' :γ) (v :α) (l :(γ, α) balanced_map) (r :(γ, α) balanced_map). lookup cmp k (Bin s k' v l r) = case cmp k k' of Less => lookup cmp k l | Equal => SOME v | Greater => lookup cmp k r
bmct_member=⊢ (∀(cmp :α -> β -> ordering) (k :α). member cmp k (Tip :(β, γ) balanced_map) ⇔ F) ∧ ∀(cmp :α -> β -> ordering) (k :α) (s :num) (k' :β) (v :γ) (l :(β, γ) balanced_map) (r :(β, γ) balanced_map). member cmp k (Bin s k' v l r) ⇔ case cmp k k' of Less => member cmp k l | Equal => T | Greater => member cmp k r
