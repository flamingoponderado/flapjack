evaluate_delete_var_Rerr_SING_typed=∀(x :bvl$exp) (s :(α, β) state) (r :(α, β) state) (e :v error_result) (env2 :v list). evaluate ([x],env2,s) = ((Rerr e :(v list, v) result),r) ∧ e ≠ (Rabort Rtype_error :v error_result) ⇒ evaluate ([delete_var x],env2,s) = ((Rerr e :(v list, v) result),r)
SmartOp1_thm_typed=evaluate ([(Op (op :closLang$op) [(x :bvl$exp)] :bvl$exp)],(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([SmartOp1 op x],env,s) = (res,s2)
SmartOp_thm_typed=evaluate ([(Op (op :closLang$op) (xs :bvl$exp list) :bvl$exp)],(env :v list),(s :(α, β) state)) = ((res :(v list, v) result),(s2 :(α, β) state)) ∧ res ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ evaluate ([(SmartOp op xs :bvl$exp)],env,s) = (res,s2)
