pSeq_def_typed=∀(c1 :prog) (c2 :prog). pSeq c1 c2 = if c2 = Skip then c1 else Seq c1 c2
simp_def_typed=(∀(c :prog). simp Skip c = c) ∧ (∀(n :num list) (c :prog). simp (Return n) c = Return n) ∧ (∀(n :num) (c :prog). simp (Raise n :prog) c = (Raise n :prog)) ∧ (∀(c2 :prog) (c1 :prog) (c :prog). simp (Seq c1 c2) c = simp c1 (simp c2 c)) ∧ (∀(n :num) (c3 :prog) (c2 :prog) (c :prog). simp (If n c2 c3 :prog) c = pSeq (If n (simp c2 Skip) (simp c3 Skip) :prog) c) ∧ (∀(v :num) (ret :(num list # sptree$num_set) option) (handler :prog) (dest :num option) (c :prog) (args :num list). simp (Call ret dest args (SOME (v,handler)) :prog) c = pSeq (Call ret dest args (SOME (v,simp handler Skip)) :prog) c) ∧ (∀(v4 :num) (v3 :num) (c2 :prog). simp (Move v3 v4) c2 = pSeq (Move v3 v4) c2) ∧ (∀(v7 :num list) (v6 :num option) (v5 :(num list # sptree$num_set) option) (c2 :prog). simp (Call v5 v6 v7 (NONE :(num # prog) option) :prog) c2 = pSeq (Call v5 v6 v7 (NONE :(num # prog) option) :prog) c2) ∧ (∀(v9 :num) (v12 :sptree$num_set option) (v11 :num list) (v10 :op) (c2 :prog). simp (Assign v9 v10 v11 v12) c2 = pSeq (Assign v9 v10 v11 v12) c2) ∧ (∀(v19 :sptree$num_set) (v18 :num) (c2 :prog). simp (MakeSpace v18 v19) c2 = pSeq (MakeSpace v18 v19) c2) ∧ (∀(c2 :prog). simp Tick c2 = pSeq Tick c2) ∧ ∀(v24 :num) (v23 :num) (v22 :(num # sptree$num_set) option) (c2 :prog). simp (Force v22 v23 v24 :prog) c2 = pSeq (Force v22 v23 v24 :prog) c2
get_code_labels_simp_typed=∀(x :dataLang$prog) (y :dataLang$prog). get_code_labels (simp x y) ⊆ get_code_labels x ∪ get_code_labels y
