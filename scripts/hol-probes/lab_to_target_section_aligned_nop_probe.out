lines_enc_with_nop_pad_section01=∀(nop :word8 list) (code :α line list) (aux :α line list) (pos :num).
  nop = (enc :α asm -> word8 list) (Inst (Skip :α inst) :α asm) ∧
  (0 :num) < LENGTH nop ∧
  EVERY (line_aligned (LENGTH nop) :α line -> bool) code ∧
  lines_encd enc (labs :num sptree$num_map sptree$num_map)
    (ffis :ffiname list)
    (pos + (SUM (MAP (line_len :α line -> num) aux) :num)) code ∧
  lines_enc_with_nop enc labs ffis pos (REVERSE aux) ∧
  ¬EVERY (is_Label :α line -> bool) aux ∧
  EVERY (label_zero :α line -> bool) code ⇒
  lines_enc_with_nop enc labs ffis pos (pad_section nop code aux)
lines_enc_with_nop_pad_section01_types=(nop :word8 list)::word8 list;(code :α line list)::α line list;(aux :α line list)::α line list;(pos :num)::num;(ffis :ffiname list)::ffiname list;(labs :num sptree$num_map sptree$num_map)::num sptree$num_map sptree$num_map;(enc :α asm -> word8 list)::α asm -> word8 list;
