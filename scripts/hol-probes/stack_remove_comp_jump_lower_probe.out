cc_jump_lower_statement=∀r1 r2 dest s. (∀left right prog. get_var r1 s = SOME (Word left) ∧ get_var r2 s = SOME (Word right) ∧ word_cmp Lower left right ∧ lookup dest s.code = SOME prog ∧ s.clock ≠ 0 ⇒ ∀r s2 t1 k off jump. evaluate (prog,dec_clock s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k (dec_clock s) t1 ∧ reg_bound prog k ⇒ ∃ck t2. evaluate (comp jump off k prog,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2) ⇒ ∀r s2 t1 k off jump. evaluate (JumpLower r1 r2 dest,s) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s t1 ∧ reg_bound (JumpLower r1 r2 dest) k ⇒ ∃ck t2. evaluate (comp jump off k (JumpLower r1 r2 dest),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
cc_jump_lower_proved=T
