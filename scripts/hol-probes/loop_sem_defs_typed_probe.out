loop_arith_def_typed=(∀(s :(α, 'ffi) state) (r1 :num) (r2 :num) (r3 :num). loop_arith s (LDiv r1 r2 r3) = case (lookup r3 s.locals,lookup r2 s.locals) of ((NONE :α word_loc option),v3) => (NONE :(α, 'ffi) state option) | (SOME (Word q),(NONE :α word_loc option)) => (NONE :(α, 'ffi) state option) | (SOME (Word q),SOME (Word w2)) => if q ≠ (0w :α word) then SOME (set_var r1 (Word (w2 / q)) s) else (NONE :(α, 'ffi) state option) | (SOME (Word q),SOME (Loc v18 v19 :α word_loc)) => (NONE :(α, 'ffi) state option) | (SOME (Loc v10 v11 :α word_loc),v3) => (NONE :(α, 'ffi) state option)) ∧ (∀(s :(α, 'ffi) state) (r1 :num) (r2 :num) (r3 :num) (r4 :num). loop_arith s (LLongMul r1 r2 r3 r4) = case (lookup r3 s.locals,lookup r4 s.locals) of ((NONE :α word_loc option),v3) => (NONE :(α, 'ffi) state option) | (SOME (Word w3),(NONE :α word_loc option)) => (NONE :(α, 'ffi) state option) | (SOME (Word w3),SOME (Word w4)) => (let (r :num) = w2n w3 * w2n w4 in SOME (set_var r2 (Word (n2w r :α word)) (set_var r1 (Word (n2w (r DIV dimword (:α)) :α word)) s))) | (SOME (Word w3),SOME (Loc v18 v19 :α word_loc)) => (NONE :(α, 'ffi) state option) | (SOME (Loc v10 v11 :α word_loc),v3) => (NONE :(α, 'ffi) state option)) ∧ ∀(s :(α, 'ffi) state) (r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num). loop_arith s (LLongDiv r1 r2 r3 r4 r5) = case (lookup r3 s.locals,lookup r4 s.locals,lookup r5 s.locals) of ((NONE :α word_loc option),v3) => (NONE :(α, 'ffi) state option) | (SOME (Word w3),(NONE :α word_loc option),v15) => (NONE :(α, 'ffi) state option) | (SOME (Word w3),SOME (Word w4),(NONE :α word_loc option)) => (NONE :(α, 'ffi) state option) | (SOME (Word w3),SOME (Word w4),SOME (Word w5)) => (let (n :num) = w2n w3 * dimword (:α) + w2n w4; (d :num) = w2n w5; (q :num) = n DIV d in if d ≠ (0 :num) ∧ q < dimword (:α) then SOME (set_var r1 (Word (n2w q :α word)) (set_var r2 (Word (n2w (n MOD d) :α word)) s)) else (NONE :(α, 'ffi) state option)) | (SOME (Word w3),SOME (Word w4),SOME (Loc v30 v31 :α word_loc)) => (NONE :(α, 'ffi) state option) | (SOME (Word w3),SOME (Loc v22 v23 :α word_loc),v15) => (NONE :(α, 'ffi) state option) | (SOME (Loc v10 v11 :α word_loc),v3) => (NONE :(α, 'ffi) state option)
cut_res_def_typed=∀(live :δ sptree$num_map) (res :α result option) (s :(β, γ) state). cut_res live (res,s) = if res ≠ (NONE :α result option) then (res,s) else case cut_state live s of (NONE :(β, γ) state option) => (SOME (Error :α result),s) | SOME v => if v.clock = (0 :num) then (SOME (TimeOut :α result),v with locals := (LN :β word_loc sptree$num_map)) else (res,dec_clock v)
loop_primop_def_typed=∀(args :α word_loc list). loop_primop AddCarry args = if LENGTH args = (3 :num) ∧ EVERY (isWord :α word_loc -> bool) args then (let (l :α word) = theWord args❲(0 :num)❳; (r :α word) = theWord args❲(1 :num)❳; (ci :α word) = theWord args❲(2 :num)❳; ((res :α word),(co :α word)) = word_add_carry l r ci in SOME [Word res; Word co]) else (NONE :α word_loc list option)
