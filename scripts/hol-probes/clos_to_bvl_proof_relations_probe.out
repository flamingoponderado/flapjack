global_table_def_typed=∀(max_app :num). global_table max_app = Block tuple_tag (FLAT (GENLIST (λ(tot :num). GENLIST (λ(prev :num). CodePtr (partial_app_fn_location max_app tot prev)) tot) max_app))
ref_rel_def_typed=((ref_rel (R :α -> β -> bool) (ValueArray (vs :α list) :α closSem$ref) (ValueArray (ws :β list) :β ref) :bool) ⇔ LIST_REL R vs ws) ∧ ((ref_rel R (Thunk (m1 :thunk_mode) (v :α) :α closSem$ref) (Thunk (m2 :thunk_mode) (w :β) :β ref) :bool) ⇔ m1 = m2 ∧ R v w) ∧ ((ref_rel R (ByteArray (as :word8 list) :α closSem$ref) (ByteArray (g :bool) (bs :word8 list) :β ref) :bool) ⇔ ¬g ∧ as = bs) ∧ ((ref_rel (v0 :α -> β -> bool) (ByteArray (v28 :word8 list) :α closSem$ref) (ValueArray (v7 :β list) :β ref) :bool) ⇔ F) ∧ ((ref_rel v0 (Thunk (v29 :thunk_mode) (v30 :α) :α closSem$ref) (ValueArray v7 :β ref) :bool) ⇔ F) ∧ ((ref_rel v0 (ValueArray (v35 :α list) :α closSem$ref) (ByteArray (v8 :bool) (v9 :word8 list) :β ref) :bool) ⇔ F) ∧ ((ref_rel v0 (Thunk (v37 :thunk_mode) (v38 :α) :α closSem$ref) (ByteArray v8 v9 :β ref) :bool) ⇔ F) ∧ ((ref_rel v0 (ValueArray (v43 :α list) :α closSem$ref) (Thunk (v10 :thunk_mode) (v11 :β) :β ref) :bool) ⇔ F) ∧ ((ref_rel v0 (ByteArray (v44 :word8 list) :α closSem$ref) (Thunk v10 v11 :β ref) :bool) ⇔ F) ∧ ((ref_rel v0 (v1 :α closSem$ref) (MutBlock (v12 :num) (v13 :bool) (v14 :β list) (v15 :β) (v16 :β list)) :bool) ⇔ F)
ref_rel_simp_typed=((ref_rel (R :α -> β -> bool) (ValueArray (vs :α list) :α closSem$ref) (y :β ref) :bool) ⇔ ∃(ws :β list). y = (ValueArray ws :β ref) ∧ LIST_REL R vs ws) ∧ ((ref_rel R (Thunk (m :thunk_mode) (v :α) :α closSem$ref) y :bool) ⇔ ∃(w :β). y = (Thunk m w :β ref) ∧ R v w) ∧ ((ref_rel R (ByteArray (bs :word8 list) :α closSem$ref) y :bool) ⇔ y = (ByteArray F bs :β ref))
nth_code_def_typed=(∀(t_co :num -> β # (num # α) list). isEmpty (nth_code t_co (0 :num) :α sptree$num_map)) ∧ ∀(t_co :num -> β # (num # α) list) (n :num). (nth_code t_co (SUC n) :α sptree$num_map) = union (fromAList (SND (t_co (0 :num)))) (nth_code (shift_seq (1 :num) t_co) n :α sptree$num_map)
compile_oracle_inv_def_typed=∀(max_app :num) (s_code :α) (s_cc :β -> closLang$exp list # (num # num # closLang$exp) list -> γ) (s_co :num -> δ # closLang$exp list # (num # num # closLang$exp) list) (t_code :(num # bvl$exp) sptree$num_map) (t_cc :β -> (num # num # bvl$exp) list -> γ) (t_co :num -> δ # (num # num # bvl$exp) list). compile_oracle_inv max_app s_code s_cc s_co t_code t_cc t_co ⇔ s_cc = pure_cc (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> (num # num # bvl$exp) list) t_cc ∧ t_co = (pure_co (compile_inc max_app :closLang$exp list # (num # num # closLang$exp) list -> (num # num # bvl$exp) list) :δ # closLang$exp list # (num # num # closLang$exp) list -> δ # (num # num # bvl$exp) list) ∘ s_co ∧ (∀(n :num) (cfg :δ) (ps :(num # num # bvl$exp) list). t_co n = (cfg,ps) ⇒ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) ps)) ∧ (∀(n :num). DISJOINT (domain (union t_code (nth_code t_co n :(num # bvl$exp) sptree$num_map)) :num -> bool) (set (MAP (FST :num # num # bvl$exp -> num) (SND (t_co n))))) ∧ ∀(n :num) (cfg :δ) (e :closLang$exp list) (ps :(num # num # closLang$exp) list). s_co n = (cfg,e,ps) ⇒ every_Fn_SOME e ∧ every_Fn_vs_SOME e ∧ EVERY (λ(p :num # num # closLang$exp). every_Fn_SOME [SND (SND p)]) ps ∧ EVERY (λ(p :num # num # closLang$exp). every_Fn_vs_SOME [SND (SND p)]) ps
closure_code_installed_subspt_typed=closure_code_installed (a :num) (code1 :(num # bvl$exp) sptree$num_map) (b :((num # closLang$exp) # num) list) (c :closSem$v list) ∧ subspt code1 (code2 :(num # bvl$exp) sptree$num_map) ⇒ closure_code_installed a code2 b c
compile_exps_IMP_code_installed_typed=∀(max_app :num) (xs :closLang$exp list) (aux :(num # num # bvl$exp) list) (c :bvl$exp list) (aux1 :(num # num # bvl$exp) list) (code :(num # bvl$exp) sptree$num_map). compile_exps max_app xs aux = (c,aux1) ∧ code_installed aux1 code ⇒ code_installed aux code
