share_mem_op_align_sdm_simp=good_dimindex (:α) ⇒
(share_mem_op (m :memop) (r :num) (a :α addr) (s :(α, γ, β) labSem$state) =
 (NONE :(β ffi_result # (α, γ, β) labSem$state) option) ⇔
 share_mem_op m r a (align_sdm s) =
