align_sdm_aligned=good_dimindex (:α) ⇒
((x :α word) ∈ (s :(α, β, γ) labSem$state).shared_mem_domain ∧
 w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num) ⇔
 x ∈ (align_sdm s).shared_mem_domain)
align_sdm_aligned_types=(s :(α, β, γ) labSem$state)::(α, β, γ) labSem$state;(x :α word)::α word;
align_sdm_aligned_hypotheses=0
align_sdm_aligned_proved=T
share_mem_load_align_sdm=good_dimindex (:α) ⇒
(share_mem_load (r :num) (ad :α addr) (align_sdm (s :(α, γ, β) labSem$state))
   (n :num) = (NONE :(β ffi_result # (α, γ, β) labSem$state) option) ⇔
 share_mem_load r ad s n =
 (NONE :(β ffi_result # (α, γ, β) labSem$state) option)) ∧
(share_mem_load r ad s n =
 SOME ((res :β ffi_result),(s' :(α, γ, β) labSem$state)) ⇒
 share_mem_load r ad (align_sdm s) n = SOME (res,align_sdm s'))
