label_zero_def=(label_zero (Label (v0 :num) (v1 :num) (n :num) :α line) ⇔ n = (0 :num)) ∧
(label_zero (Asm (v5 :α asm_or_cbw) (v6 :word8 list) (v7 :num)) ⇔ T) ∧
(label_zero
   (LabAsm (v8 :α asm_with_lab) (v9 :α word) (v10 :word8 list) (v11 :num)) ⇔
 T)
label_zero_def_types=(v11 :num)::num;(v10 :word8 list)::word8 list;(v9 :α word)::α word;(v8 :α asm_with_lab)::α asm_with_lab;(v7 :num)::num;(v6 :word8 list)::word8 list;(v5 :α asm_or_cbw)::α asm_or_cbw;(n :num)::num;(v1 :num)::num;(v0 :num)::num;
sec_label_zero_def=∀(v0 :num) (ls :α line list).
  sec_label_zero (Section v0 ls) ⇔ EVERY (label_zero :α line -> bool) ls
sec_label_zero_def_types=(v0 :num)::num;(ls :α line list)::α line list;
sec_label_zero_pos_val_0=∀(xs :α sec list) (pos :num).
  EVERY (sec_label_zero :α sec -> bool) xs ⇒ pos_val (0 :num) pos xs = pos
sec_label_zero_pos_val_0_types=(xs :α sec list)::α sec list;(pos :num)::num;
pos_val_append=∀(c1 :α sec list) (i :num) (pos :num) (c2 :α sec list).
  EVERY (sec_label_zero :α sec -> bool) c2 ⇒
  pos_val i pos (c1 ++ c2) =
  if
    i ≤
    (SUM
       (MAP
          ((λ(xs :α line list).
                LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) xs)) ∘
           (Section_lines :α sec -> α line list)) c1) :num)
  then
    pos_val i pos c1
  else
    pos_val
      (i −
       (SUM
          (MAP
             ((λ(xs :α line list).
                   LENGTH (FILTER ($¬ ∘ (is_Label :α line -> bool)) xs)) ∘
              (Section_lines :α sec -> α line list)) c1) :num))
      (pos +
       (SUM
          (MAP
             (SUM ∘ MAP (line_length :α line -> num) ∘
              (Section_lines :α sec -> α line list)) c1) :num)) c2
pos_val_append_types=(c1 :α sec list)::α sec list;(i :num)::num;(pos :num)::num;(c2 :α sec list)::α sec list;
zero_label=T
nonzero_label=T
asm_annotation_ignored=T
labasm_annotation_ignored=T
