val nn = ``(NONE:(num # 'a wordLang$prog # num # num) option)``;
val push_env_set_store = prove(``  push_env env ^nn (set_store AllocSize (Word c) s) =
    set_store AllocSize (Word c) (push_env env ^nn s)``,   fs [push_env_def,set_store_def,env_to_list_def,LET_DEF]);
val _ = (if null(hyp push_env_set_store) then () else raise Fail "open premise"; print "ss_full_push_env_set_store="; print_thm push_env_set_store; print "\n");
val dec_stack_stack_size = prove(``  !xs st st'.
   dec_stack xs st = SOME st' ==>
   stack_size st = stack_size st'``,   ho_match_mp_tac dec_stack_ind >>
  rw[dec_stack_def,stack_size_eq2,CaseEq "option"] >>
  rw[stack_size_eq2] >>
  Cases_on `handler` >> rw[stack_size_frame_def] >>
  res_tac >> simp[]);
val _ = (if null(hyp dec_stack_stack_size) then () else raise Fail "open premise"; print "ss_full_dec_stack_stack_size="; print_thm dec_stack_stack_size; print "\n");
val s_key_eq_stack_size = prove(``  !stack stack'. s_key_eq stack stack' ==> stack_size stack = stack_size stack'``,   ho_match_mp_tac s_key_eq_ind >>
  rw[s_key_eq_def,stack_size_eq] >>
  rename1 `s_frame_key_eq x y` >>
  Cases_on `x` >>Cases_on `y` >>
  rename1 `s_frame_key_eq (StackFrame _ _ _ handler1) (StackFrame _ _ _ handler2)` >>
  Cases_on `handler1` >> Cases_on `handler2` >>
  fs[s_frame_key_eq_def,stack_size_eq]);
val _ = (if null(hyp s_key_eq_stack_size) then () else raise Fail "open premise"; print "ss_full_s_key_eq_stack_size="; print_thm s_key_eq_stack_size; print "\n");
val s_key_eq_push_env_locals_size = prove(``  s_key_eq (push_env env opt1 s).stack
           (StackFrame n l0 l opt2::stack')
  ==>
  n = s.locals_size /\ stack_size s.stack = stack_size stack'``,   MAP_EVERY qid_spec_tac [`s`,`opt1`,`env`] >>
  ho_match_mp_tac push_env_ind >>
  rw[push_env_def,s_key_eq_def,ELIM_UNCURRY] >>
  Cases_on `opt2` >> fs[s_frame_key_eq_def,s_key_eq_stack_size]);
val _ = (if null(hyp s_key_eq_push_env_locals_size) then () else raise Fail "open premise"; print "ss_full_s_key_eq_push_env_locals_size="; print_thm s_key_eq_push_env_locals_size; print "\n");
