load "preamble"; load "word_to_stackProofTheory";
open HolKernel Parse bossLib preamble word_to_stackProofTheory sortingTheory arithmeticTheory;
val _ = Globals.linewidth := 4000;
val SORTED_weaken2 = prove(``  ∀ls. SORTED R ls ∧
  ALL_DISTINCT ls ∧
  (∀x y. MEM x ls ∧ MEM y ls ∧ x ≠ y ∧ R x y ⇒ R' x y) ⇒
  SORTED R' ls``,   Induct>>rw[]>>Cases_on`ls`>>fs[SORTED_DEF]>>
  metis_tac[]);
val _ = (if null(hyp SORTED_weaken2) then () else raise Fail "open premise"; print "sr_full_SORTED_weaken2="; print_thm SORTED_weaken2; print "\n");
val EVEN_GT = prove(``  ∀a b.
  EVEN a ∧ EVEN b ∧
  a > b ⇒
  a DIV 2 > b DIV 2``,   fs[EVEN_EXISTS]>>rw[]>>
  fsrw_tac[][MULT_DIV,MULT_COMM]>>
  DECIDE_TAC);
val _ = (if null(hyp EVEN_GT) then () else raise Fail "open premise"; print "sr_full_EVEN_GT="; print_thm EVEN_GT; print "\n");
val transitive_GT = prove(``  transitive ($> : (num->num->bool))``,   fs[transitive_def]);
val _ = (if null(hyp transitive_GT) then () else raise Fail "open premise"; print "sr_full_transitive_GT="; print_thm transitive_GT; print "\n");
fun emit label q = let val th = EVAL q in print(label ^ "="); print_thm th; print "\n" end;
