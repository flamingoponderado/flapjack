tring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit v21) (Env v50 v51) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v66 :lit) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Litv v66) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v96 :(mlstring, mlstring) id) (v68 :v list) (v23 :pat list) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (SOME v96) v23) (Conv (NONE :stamp option) v68) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v94 :stamp) (v68 :v list) (v23 :pat list) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (NONE :(mlstring, mlstring) id option) v23) (Conv (SOME v94) v68) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v71 :exp) (v70 :mlstring) (v69 :v sem_env) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Closure v69 v70 v71) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v74 :mlstring) (v73 :(mlstring # mlstring # exp) list) (v72 :v sem_env) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Recclosure v72 v73 v74) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v76 :num) (v75 :bool) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Loc v75 v76) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v77 :v list) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Vectorv v77) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v79 :num # num) (v78 :v sem_env) (v23 :pat list) (v22 :(mlstring, mlstring) id option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon v22 v23) (Env v78 v79) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v100 :lit) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Litv v100) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v102 :v list) (v101 :stamp option) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Conv v101 v102) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v105 :exp) (v104 :mlstring) (v103 :v sem_env) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Closure v103 v104 v105) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v108 :mlstring) (v107 :(mlstring # mlstring # exp) list) (v106 :v sem_env) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Recclosure v106 v107 v108) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v111 :v list) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Vectorv v111) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v24 :pat) (v113 :num # num) (v112 :v sem_env) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref v24) (Env v112 v113) env = (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s ([] :pat list) ([] :v list) env = Match env) ∧ (∀(vs :v list) (v :v) (s :v store_v list) (ps :pat list) (p :pat) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s (p::ps) (v::vs) env = case pmatch envC s p v env of (No_match :(mlstring # v) list match_result) => (case pmatch_list envC s ps vs env of (No_match :(mlstring # v) list match_result) => (No_match :(mlstring # v) list match_result) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match v1 => (No_match :(mlstring # v) list match_result)) | (Match_type_error :(mlstring # v) list match_result) => (Match_type_error :(mlstring # v) list match_result) | Match env' => pmatch_list envC s ps vs env') ∧ (∀(v141 :pat list) (v140 :pat) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s (v140::v141) ([] :v list) env = (Match_type_error :(mlstring # v) list match_result)) ∧ ∀(v137 :v list) (v136 :v) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch_list envC s ([] :pat list) (v136::v137) env = (Match_type_error :(mlstring # v) list match_result)
