store_lookup_def_typed=∀(l :num) (st :α store_v list). store_lookup l st = if l < LENGTH st then SOME st❲l❳ else (NONE :α store_v option)
store_assign_def_typed=∀(n :num) (v :α store_v) (st :α store_v list). store_assign n v st = if n < LENGTH st ∧ store_v_same_type st❲n❳ v then SOME st❲n ↦ v❳ else (NONE :α store_v list option)
abort_typed=Rtype_error::abort; Rtimeout_error::abort; Rffi_error::final_event -> abort
error_result_typed=Rraise::α -> α error_result; Rabort::abort -> α error_result
result_typed=Rval::α -> (α, β) result; Rerr::β error_result -> (α, β) result
sem_env_typed=recordtype.sem_env::(mlstring, mlstring, φ) namespace -> (mlstring, mlstring, num # stamp) namespace -> φ sem_env
stamp_typed=TypeStamp::mlstring -> num -> stamp; ExnStamp::num -> stamp
store_v_typed=Refv::α -> α store_v; W8array::word8 list -> α store_v; Varray::α list -> α store_v; Thunk::thunk_mode -> α -> α store_v
v_typed=Litv::lit -> v; Conv::stamp option -> v list -> v; Closure::v sem_env -> mlstring -> exp -> v; Recclosure::v sem_env -> (mlstring # mlstring # exp) list -> mlstring -> v; Loc::bool -> num -> v; Vectorv::v list -> v; Env::v sem_env -> num # num -> v
bind_exn_v_def_typed=bind_exn_v = Conv (SOME bind_stamp) ([] :v list)
bind_stamp_def_typed=bind_stamp = ExnStamp (0 :num)
chr_exn_v_def_typed=chr_exn_v = Conv (SOME chr_stamp) ([] :v list)
chr_stamp_def_typed=chr_stamp = ExnStamp (1 :num)
div_exn_v_def_typed=div_exn_v = Conv (SOME div_stamp) ([] :v list)
div_stamp_def_typed=div_stamp = ExnStamp (2 :num)
empty_store_def_typed=(empty_store :α store_v list) = ([] :α store_v list)
store_alloc_def_typed=∀(v :α store_v) (st :α store_v list). store_alloc v st = (st ++ [v],LENGTH st)
store_v_same_type_def_typed=∀(v1 :α store_v) (v2 :α store_v). store_v_same_type v1 v2 ⇔ case (v1,v2) of (Refv v9,Refv v19) => T | (Refv v9,(W8array v20 :α store_v)) => F | (Refv v9,Varray v21) => F | (Refv v9,Thunk v22 v23) => F | ((W8array v10 :α store_v),Refv v29) => F | ((W8array v10 :α store_v),(W8array v30 :α store_v)) => T | ((W8array v10 :α store_v),Varray v31) => F | ((W8array v10 :α store_v),Thunk v32 v33) => F | (Varray v11,Refv v39) => F | (Varray v11,(W8array v40 :α store_v)) => F | (Varray v11,Varray v41) => T | (Varray v11,Thunk v42 v43) => F | (Thunk v12 v13,Refv v49) => F | (Thunk v12 v13,(W8array v50 :α store_v)) => F | (Thunk v12 v13,Varray v51) => F | (Thunk Evaluated v13,Thunk v52 v53) => F | (Thunk NotEvaluated v13,Thunk v52 v53) => T
sub_exn_v_def_typed=sub_exn_v = Conv (SOME subscript_stamp) ([] :v list)
subscript_stamp_def_typed=subscript_stamp = ExnStamp (3 :num)
eval_decs_state_typed=recordtype.eval_decs_state::((num # num) # v # dec list -> (v # word8 list # word64 list) option) -> v -> num # num # num -> (v -> dec list option) -> eval_decs_state
eval_oracle_state_typed=recordtype.eval_oracle_state::(num -> (num # num) # v # dec list) -> (v list -> (num -> (num # num) # v # dec list) -> ((num # num) # (num -> (num # num) # v # dec list) # dec list) option) -> v sem_env list list -> num -> eval_oracle_state
eval_state_typed=EvalDecs::eval_decs_state -> eval_state; EvalOracle::eval_oracle_state -> eval_state
state_typed=recordtype.state::num -> v store_v list -> 'ffi ffi_state -> num -> num -> eval_state option -> 'ffi state
match_result_typed=No_match::α match_result; Match_type_error::α match_result; Match::α -> α match_result
bool_type_num_def_typed=bool_type_num = (0 :num)
Boolv_def_typed=∀(b :bool). Boolv b = if b then Conv (SOME (TypeStamp «True» bool_type_num)) ([] :v list) else Conv (SOME (TypeStamp «False» bool_type_num)) ([] :v list)
build_conv_def_typed=∀(envC :(mlstring, mlstring, num # stamp) namespace) (cn :(mlstring, mlstring) id option) (vs :v list). build_conv envC cn vs = case cn of (NONE :(mlstring, mlstring) id option) => SOME (Conv (NONE :stamp option) vs) | SOME id => case nsLookup envC id of (NONE :(num # stamp) option) => (NONE :v option) | SOME (len,stamp) => SOME (Conv (SOME stamp) vs)
build_rec_env_def_typed=∀(funs :(mlstring # mlstring # exp) list) (cl_env :v sem_env) (add_to_env :(mlstring, mlstring, v) namespace). build_rec_env funs cl_env add_to_env = FOLDR (λ((f :mlstring),(x :mlstring),(e :exp)) (env' :(mlstring, mlstring, v) namespace). nsBind f (Recclosure cl_env funs f) env') add_to_env funs
ctor_same_type_def_typed=∀(c1 :stamp option) (c2 :stamp option). ctor_same_type c1 c2 ⇔ case (c1,c2) of ((NONE :stamp option),(NONE :stamp option)) => T | ((NONE :stamp option),SOME v7) => F | (SOME stamp1,(NONE :stamp option)) => F | (SOME stamp1,SOME stamp2) => same_type stamp1 stamp2
do_con_check_def_typed=∀(cenv :(mlstring, mlstring, num # stamp) namespace) (n_opt :(mlstring, mlstring) id option) (l :num). do_con_check cenv n_opt l ⇔ case n_opt of (NONE :(mlstring, mlstring) id option) => T | SOME n => case nsLookup cenv n of (NONE :(num # stamp) option) => F | SOME (l',v2) => l = l'
find_recfun_def_typed=∀(n :mlstring) (funs :(mlstring # α # β) list). find_recfun n funs = case funs of ([] :(mlstring # α # β) list) => (NONE :(α # β) option) | (f,x,e)::funs' => if f = n then SOME (x,e) else find_recfun n funs'
lit_same_type_def_typed=∀(l1 :lit) (l2 :lit). lit_same_type l1 l2 ⇔ case (l1,l2) of (IntLit v10,IntLit v22) => T | (IntLit v10,Char v23) => F | (IntLit v10,StrLit v24) => F | (IntLit v10,Word8 v25) => F | (IntLit v10,Word64 v26) => F | (IntLit v10,Float64 v27) => F | (Char v11,IntLit v34) => F | (Char v11,Char v35) => T | (Char v11,StrLit v36) => F | (Char v11,Word8 v37) => F | (Char v11,Word64 v38) => F | (Char v11,Float64 v39) => F | (StrLit v12,IntLit v46) => F | (StrLit v12,Char v47) => F | (StrLit v12,StrLit v48) => T | (StrLit v12,Word8 v49) => F | (StrLit v12,Word64 v50) => F | (StrLit v12,Float64 v51) => F | (Word8 v13,IntLit v58) => F | (Word8 v13,Char v59) => F | (Word8 v13,StrLit v60) => F | (Word8 v13,Word8 v61) => T | (Word8 v13,Word64 v62) => F | (Word8 v13,Float64 v63) => F | (Word64 v14,IntLit v70) => F | (Word64 v14,Char v71) => F | (Word64 v14,StrLit v72) => F | (Word64 v14,Word8 v73) => F | (Word64 v14,Word64 v74) => T | (Word64 v14,Float64 v75) => F | (Float64 v15,IntLit v82) => F | (Float64 v15,Char v83) => F | (Float64 v15,StrLit v84) => F | (Float64 v15,Word8 v85) => F | (Float64 v15,Word64 v86) => F | (Float64 v15,Float64 v87) => T
one_con_check_def_typed=(one_con_check (envc :(mlstring, mlstring, num # stamp) namespace) (Con (cn :(mlstring, mlstring) id option) (es :exp list)) ⇔ do_con_check envc cn (LENGTH es)) ∧ (one_con_check envc (Raise (v2 :exp)) ⇔ T) ∧ (one_con_check envc (Handle (v3 :exp) (v4 :(pat # exp) list)) ⇔ T) ∧ (one_con_check envc (Lit (v5 :lit)) ⇔ T) ∧ (one_con_check envc (Var (v8 :(mlstring, mlstring) id)) ⇔ T) ∧ (one_con_check envc (Fun (v9 :mlstring) (v10 :exp)) ⇔ T) ∧ (one_con_check envc (App (v11 :op) (v12 :exp list)) ⇔ T) ∧ (one_con_check envc (Log (v13 :lop) (v14 :exp) (v15 :exp)) ⇔ T) ∧ (one_con_check envc (If (v16 :exp) (v17 :exp) (v18 :exp)) ⇔ T) ∧ (one_con_check envc (Mat (v19 :exp) (v20 :(pat # exp) list)) ⇔ T) ∧ (one_con_check envc (Let (v21 :mlstring option) (v22 :exp) (v23 :exp)) ⇔ T) ∧ (one_con_check envc (Letrec (v24 :(mlstring # mlstring # exp) list) (v25 :exp)) ⇔ T) ∧ (one_con_check envc (Tannot (v26 :exp) (v27 :ast_t)) ⇔ T) ∧ (one_con_check envc (Lannot (v28 :exp) (v29 :locs)) ⇔ T)
same_ctor_def_typed=∀(stamp1 :stamp) (stamp2 :stamp). same_ctor stamp1 stamp2 ⇔ stamp1 = stamp2
same_type_def_typed=(same_type (TypeStamp (v0 :mlstring) (n1 :num)) (TypeStamp (v1 :mlstring) (n2 :num)) ⇔ n1 = n2) ∧ (same_type (ExnStamp (v2 :num)) (ExnStamp (v3 :num)) ⇔ T) ∧ (same_type (TypeStamp (v7 :mlstring) (v8 :num)) (ExnStamp (v15 :num)) ⇔ F) ∧ (same_type (ExnStamp (v9 :num)) (TypeStamp (v19 :mlstring) (v20 :num)) ⇔ F)
can_pmatch_all_def_typed=(∀(envC :(mlstring, mlstring, num # stamp) namespace) (refs :v store_v list) (v :v). can_pmatch_all envC refs ([] :pat list) v ⇔ T) ∧ ∀(envC :(mlstring, mlstring, num # stamp) namespace) (refs :v store_v list) (p :pat) (ps :pat list) (v :v). can_pmatch_all envC refs (p::ps) v ⇔ if pmatch envC refs p v ([] :(mlstring # v) list) = (Match_type_error :(mlstring # v) list match_result) then F else can_pmatch_all envC refs ps v
pmatch_def_typed=(∀(v' :v) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s Pany v' env = Match env) ∧ (∀(x :mlstring) (v' :v) (s :v store_v list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pvar x) v' env = Match ((x,v')::env)) ∧ (∀(s :v store_v list) (l' :lit) (l :lit) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Plit l) (Litv l') env = if l = l' then Match env else if lit_same_type l l' then (No_match :(mlstring # v) list match_result) else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(vs :v list) (stamp' :stamp) (s :v store_v list) (ps :pat list) (n :(mlstring, mlstring) id) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (SOME n) ps) (Conv (SOME stamp') vs) env = case nsLookup envC n of (NONE :(num # stamp) option) => (Match_type_error :(mlstring # v) list match_result) | SOME (l,stamp) => if same_type stamp stamp' ∧ LENGTH ps = l then if same_ctor stamp stamp' then if LENGTH vs = l then pmatch_list envC s ps vs env else (Match_type_error :(mlstring # v) list match_result) else (No_match :(mlstring # v) list match_result) else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(vs :v list) (s :v store_v list) (ps :pat list) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pcon (NONE :(mlstring, mlstring) id option) ps) (Conv (NONE :stamp option) vs) env = if LENGTH ps = LENGTH vs then pmatch_list envC s ps vs env else (Match_type_error :(mlstring # v) list match_result)) ∧ (∀(v0 :bool) (s :v store_v list) (p :pat) (lnum :num) (envC :(mlstring, mlstring, num # stamp) namespace) (env :(mlstring # v) list). pmatch envC s (Pref p) (Loc v0 lnum) env = case store_lookup lnum s of (NONE :v store_v option) => (Match_type_error :(mlstring # v) list match_result) | SOME (Refv v) => pmatch env