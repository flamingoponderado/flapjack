do_eq_def_typed=(∀(l2 :lit) (l1 :lit). do_eq (Litv l1) (Litv l2) = if lit_same_type l1 l2 then Eq_val (l1 = l2) else Eq_type_error) ∧ (∀(l2 :num) (l1 :num) (b2 :bool) (b1 :bool). do_eq (Loc b1 l1) (Loc b2 l2) = if b1 ∧ b2 then Eq_val (l1 = l2) else Eq_type_error) ∧ (∀(vs2 :v list) (vs1 :v list) (cn2 :stamp option) (cn1 :stamp option). do_eq (Conv cn1 vs1) (Conv cn2 vs2) = if cn1 = cn2 ∧ LENGTH vs1 = LENGTH vs2 then do_eq_list vs1 vs2 else if ctor_same_type cn1 cn2 then Eq_val F else Eq_type_error) ∧ (∀(vs2 :v list) (vs1 :v list). do_eq (Vectorv vs1) (Vectorv vs2) = if LENGTH vs1 = LENGTH vs2 then do_eq_list vs1 vs2 else Eq_val F) ∧ (∀(v7 :exp) (v6 :mlstring) (v5 :v sem_env) (v4 :exp) (v3 :mlstring) (v0 :v sem_env). do_eq (Closure v0 v3 v4) (Closure v5 v6 v7) = Eq_val T) ∧ (∀(v9 :mlstring) (v8 :v sem_env) (v13 :mlstring) (v12 :(mlstring # mlstring # exp) list) (v11 :v sem_env) (v10 :exp). do_eq (Closure v8 v9 v10) (Recclosure v11 v12 v13) = Eq_val T) ∧ (∀(v19 :exp) (v18 :mlstring) (v17 :v sem_env) (v16 :mlstring) (v15 :(mlstring # mlstring # exp) list) (v14 :v sem_env). do_eq (Recclosure v14 v15 v16) (Closure v17 v18 v19) = Eq_val T) ∧ (∀(v25 :mlstring) (v24 :(mlstring # mlstring # exp) list) (v23 :v sem_env) (v22 :mlstring) (v21 :(mlstring # mlstring # exp) list) (v20 :v sem_env). do_eq (Recclosure v20 v21 v22) (Recclosure v23 v24 v25) = Eq_val T) ∧ (∀(v27 :v sem_env) (v26 :v sem_env) (id2 :num) (id1 :num) (gen2 :num) (gen1 :num). do_eq (Env v26 (gen1,id1)) (Env v27 (gen2,id2)) = Eq_val (gen1 = gen2 ∧ id1 = id2)) ∧ (∀(v65 :v list) (v64 :stamp option) (v35 :lit). do_eq (Litv v35) (Conv v64 v65) = Eq_type_error) ∧ (∀(v68 :exp) (v67 :mlstring) (v66 :v sem_env) (v35 :lit). do_eq (Litv v35) (Closure v66 v67 v68) = Eq_type_error) ∧ (∀(v71 :mlstring) (v70 :(mlstring # mlstring # exp) list) (v69 :v sem_env) (v35 :lit). do_eq (Litv v35) (Recclosure v69 v70 v71) = Eq_type_error) ∧ (∀(v73 :num) (v72 :bool) (v35 :lit). do_eq (Litv v35) (Loc v72 v73) = Eq_type_error) ∧ (∀(v74 :v