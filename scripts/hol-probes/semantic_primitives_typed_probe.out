build_constrs_def_typed=∀(stamp :num) (condefs :(mlstring # α list) list). build_constrs stamp condefs = MAP (λ((conN :mlstring),(ts :α list)). (conN,LENGTH ts,TypeStamp conN stamp)) condefs
build_tdefs_def_typed=(∀(next_stamp :num). build_tdefs next_stamp ([] :(mlstring list # mlstring # (mlstring # ast_t list) list) list) = (alist_to_ns ([] :(mlstring # num # stamp) list) :(mlstring, mlstring, num # stamp) namespace)) ∧ ∀(tvs :mlstring list) (tn :mlstring) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (next_stamp :num) (condefs :(mlstring # ast_t list) list). build_tdefs next_stamp ((tvs,tn,condefs)::tds) = nsAppend (build_tdefs (next_stamp + (1 :num)) tds) (alist_to_ns (REVERSE (build_constrs next_stamp condefs)) :(mlstring, mlstring, num # stamp) namespace)
check_dup_ctors_def_typed=∀(tvs :mlstring list) (tn :mlstring) (condefs :(mlstring # ast_t list) list). check_dup_ctors (tvs,tn,condefs) ⇔ ALL_DISTINCT (let (x2 :mlstring list) = ([] :mlstring list) in FOLDR (λ((n :mlstring),(ts :ast_t list)) (x2 :mlstring list). if T then n::x2 else x2) x2 condefs)
combine_dec_result_def_typed=∀(env :v sem_env) (r :(v sem_env, α) result). combine_dec_result env r = case r of (Rval env' :(v sem_env, α) result) => (Rval <|v := nsAppend env'.v env.v; c := nsAppend env'.c env.c|> :(v sem_env, α) result) | (Rerr e :(v sem_env, α) result) => (Rerr e :(v sem_env, α) result)
do_if_def_typed=∀(v :v) (e1 :α) (e2 :α). do_if v e1 e2 = if v = Boolv T then SOME e1 else if v = Boolv F then SOME e2 else (NONE :α option)
do_log_def_typed=∀(l :lop) (v :v) (e :exp). do_log l v e = if l = Andalso ∧ v = Boolv T ∨ l = Orelse ∧ v = Boolv F then SOME (Exp e) else if l = Andalso ∧ v = Boolv F ∨ l = Orelse ∧ v = Boolv T then SOME (Val v) else (NONE :exp_or_val option)
extend_dec_env_def_typed=∀(new_env :v sem_env) (env :v sem_env). ((new_env +++ env) :v sem_env) = <|c := nsAppend new_env.c env.c; v := nsAppend new_env.v env.v|>
chars_to_ws_def_typed=∀(cs :string). chars_to_ws cs = MAP (λ(c :char). (i2w ((&ORD c) :int) :word8)) cs
copy_array_def_typed=∀(src :α list) (srcoff :int) (len :int) (d :(α list # int) option). copy_array (src,srcoff) len d = if srcoff < (0 :int) ∨ len < (0 :int) ∨ LENGTH src < Num (ABS (I (srcoff + len))) then (NONE :α list option) else (let (copied :α list) = TAKE (Num (ABS (I len))) (DROP (Num (ABS (I srcoff))) src) in case d of (NONE :(α list # int) option) => SOME copied | SOME (dst,dstoff) => if dstoff < (0 :int) ∨ LENGTH dst < Num (ABS (I (dstoff + len))) then (NONE :α list option) else SOME (TAKE (Num (ABS (I dstoff))) dst ++ copied ++ DROP (Num (ABS (I (dstoff + len)))) dst))
ws_to_chars_def_typed=∀(ws :word8 list). ws_to_chars ws = MAP (λ(w :word8). CHR (w2n w)) ws
check_type_def_typed=(check_type BoolT (v :v) ⇔ v = Boolv T ∨ v = Boolv F) ∧ (check_type IntT v ⇔ ∃(i :int). v = Litv (IntLit i)) ∧ (check_type CharT v ⇔ ∃(c :char). v = Litv (Char c)) ∧ (check_type StrT v ⇔ ∃(s :mlstring). v = Litv (StrLit s)) ∧ (check_type (WordT W8) v ⇔ ∃(w :word8). v = Litv (Word8 w)) ∧ (check_type (WordT W64) v ⇔ ∃(w :word64). v = Litv (Word64 w)) ∧ (check_type Float64T v ⇔ ∃(w :word64). v = Litv (Float64 w))
dest_Litv_def_typed=dest_Litv (Litv (v :lit)) = SOME v ∧ dest_Litv (Conv (v2 :stamp option) (v3 :v list)) = (NONE :lit option) ∧ dest_Litv (Closure (v4 :v sem_env) (v5 :mlstring) (v6 :exp)) = (NONE :lit option) ∧ dest_Litv (Recclosure (v7 :v sem_env) (v8 :(mlstring # mlstring # exp) list) (v9 :mlstring)) = (NONE :lit option) ∧ dest_Litv (Loc (v10 :bool) (v11 :num)) = (NONE :lit option) ∧ dest_Litv (Vectorv (v12 :v list)) = (NONE :lit option) ∧ dest_Litv (Env (v13 :v sem_env) (v14 :num # num)) = (NONE :lit option)
shift64_lookup_def_typed=∀(sh :shift). shift64_lookup sh = case sh of Lsl => ($<< :word64 -> num -> word64) | Lsr => ($>>> :word64 -> num -> word64) | Asr => ($>> :word64 -> num -> word64) | Ror => ($#>> :word64 -> num -> word64)
shift8_lookup_def_typed=∀(sh :shift). shift8_lookup sh = case sh of Lsl => ($<< :word8 -> num -> word8) | Lsr => ($>>> :word8 -> num -> word8) | Asr => ($>> :word8 -> num -> word8) | Ror => ($#>> :word8 -> num -> word8)
int_cmp_def_typed=(∀(i :int) (j :int). int_cmp Lt i j ⇔ i < j) ∧ (∀(i :int) (j :int). int_cmp Leq i j ⇔ i ≤ j) ∧ (∀(i :int) (j :int). int_cmp Gt i j ⇔ i > j) ∧ ∀(i :int) (j :int). int_cmp Geq i j ⇔ i ≥ j
num_cmp_def_typed=(∀(i :num) (j :num). (num_cmp Lt i j :bool) ⇔ i < j) ∧ (∀(i :num) (j :num). (num_cmp Leq i j :bool) ⇔ i ≤ j) ∧ (∀(i :num) (j :num). (num_cmp Gt i j :bool) ⇔ i > j) ∧ ∀(i :num) (j :num). (num_cmp Geq i j :bool) ⇔ i ≥ j
str_cmp_def_typed=(str_cmp F Lt (i :mlstring) (j :mlstring) ⇔ i < j) ∧ (str_cmp F Leq i j ⇔ i ≤ j) ∧ (str_cmp F Gt i j ⇔ i > j) ∧ (str_cmp F Geq i j ⇔ i ≥ j) ∧ (str_cmp T Lt i j ⇔ fast_lt i j) ∧ (str_cmp T Leq i j ⇔ fast_le i j) ∧ (str_cmp T Gt i j ⇔ fast_gt i j) ∧ (str_cmp T Geq i j ⇔ fast_ge i j)
do_test_def_typed=(∀(ty :prim_type) (v1 :v) (v2 :v). do_test Equal ty v1 v2 = if check_type ty v1 ∧ check_type ty v2 then if ty = Float64T then Eq_val (fp64_equal (the_Litv_Float64 v1) (the_Litv_Float64 v2)) else do_eq v1 v2 else Eq_type_error) ∧ (∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (Compare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (v3,(NONE :lit option),v8) => Eq_type_error | (v3,SOME v10,(NONE :lit option)) => Eq_type_error | (BoolT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (IntT,SOME (IntLit i),SOME (IntLit j)) => Eq_val (int_cmp cmp i j) | (CharT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (StrT,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (WordT v38,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (Float64T,SOME (IntLit i),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Char v32),SOME (IntLit j)) => Eq_type_error | (v3,SOME (StrLit v33),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word8 v34),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Word64 v35),SOME (IntLit j)) => Eq_type_error | (v3,SOME (Float64 v36),SOME (IntLit j)) => Eq_type_error | (v3,SOME (IntLit v45),SOME (Char d)) => Eq_type_error | (BoolT,SOME (Char c),SOME (Char d)) => Eq_type_error | (IntT,SOME (Char c),SOME (Char d)) => Eq_type_error | (CharT,SOME (Char c),SOME (Char d)) => Eq_val (num_cmp cmp (ORD c) (ORD d) :bool) | (StrT,SOME (Char c),SOME (Char d)) => Eq_type_error | (WordT v52,SOME (Char c),SOME (Char d)) => Eq_type_error | (Float64T,SOME (Char c),SOME (Char d)) => Eq_type_error | (v3,SOME (StrLit v47),SOME (Char d)) => Eq_type_error | (v3,SOME (Word8 v48),SOME (Char d)) => Eq_type_error | (v3,SOME (Word64 v49),SOME (Char d)) => Eq_type_error | (v3,SOME (Float64 v50),SOME (Char d)) => Eq_type_error | (v3,SOME (IntLit v59),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Char v60),SOME (StrLit t)) => Eq_type_error | (BoolT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (IntT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (CharT,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (StrLit t)) => Eq_val (str_cmp F cmp s t) | (WordT v66,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (Float64T,SOME (StrLit s),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Word8 v62),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Word64 v63),SOME (StrLit t)) => Eq_type_error | (v3,SOME (Float64 v64),SOME (StrLit t)) => Eq_type_error | (v3,SOME (IntLit v73),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Char v74),SOME (Word8 v)) => Eq_type_error | (v3,SOME (StrLit v75),SOME (Word8 v)) => Eq_type_error | (BoolT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (IntT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (CharT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (StrT,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (WordT W8,SOME (Word8 w),SOME (Word8 v)) => Eq_val (num_cmp cmp (w2n w) (w2n v) :bool) | (WordT W64,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (Float64T,SOME (Word8 w),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Word64 v77),SOME (Word8 v)) => Eq_type_error | (v3,SOME (Float64 v78),SOME (Word8 v)) => Eq_type_error | (v3,SOME v10,SOME (Word64 v23)) => Eq_type_error | (v3,SOME (IntLit v87),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Char v88),SOME (Float64 v')) => Eq_type_error | (v3,SOME (StrLit v89),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Word8 v90),SOME (Float64 v')) => Eq_type_error | (v3,SOME (Word64 v91),SOME (Float64 v')) => Eq_type_error | (BoolT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (IntT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (CharT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (StrT,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (WordT v94,SOME (Float64 w'),SOME (Float64 v')) => Eq_type_error | (Float64T,SOME (Float64 w'),SOME (Float64 v')) => Eq_val (fp_cmp cmp w' v')) ∧ ∀(cmp :opb) (ty :prim_type) (v1 :v) (v2 :v). do_test (AltCompare cmp) ty v1 v2 = case (ty,dest_Litv v1,dest_Litv v2) of (BoolT,v3) => Eq_type_error | (IntT,v3) => Eq_type_error | (CharT,v3) => Eq_type_error | (StrT,(NONE :lit option),v9) => Eq_type_error | (StrT,SOME (IntLit v18),v9) => Eq_type_error | (StrT,SOME (Char v19),v9) => Eq_type_error | (StrT,SOME (StrLit s),(NONE :lit option)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (IntLit v32)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Char v33)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (StrLit t)) => Eq_val (str_cmp T cmp s t) | (StrT,SOME (StrLit s),SOME (Word8 v35)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Word64 v36)) => Eq_type_error | (StrT,SOME (StrLit s),SOME (Float64 v37)) => Eq_type_error | (StrT,SOME (Word8 v21),v9) => Eq_type_error | (StrT,SOME (Word64 v22),v9) => Eq_type_error | (StrT,SOME (Float64 v23),v9) => Eq_type_error | (WordT v5,v3) => Eq_type_error | (Float64T,v3) => Eq_type_error
the_Litv_IntLit_def_typed=the_Litv_IntLit (Litv (IntLit (i :int))) = i
the_Litv_Word8_def_typed=the_Litv_Word8 (Litv (Word8 (w :word8))) = w
the_Litv_Word64_def_typed=the_Litv_Word64 (Litv (Word64 (w :word64))) = w
the_Litv_Float64_def_typed=the_Litv_Float64 (Litv (Float64 (w :word64))) = w
the_Litv_Char_def_typed=the_Litv_Char (Litv (Char (c :char))) = c
do_conversion_def_typed=do_conversion (v :v) (WordT W8) IntT = SOME (INR (Litv (IntLit ((&w2n (the_Litv_Word8 v)) :int))) :v + v) ∧ do_conversion v (WordT W64) IntT = SOME (INR (Litv (IntLit ((&w2n (the_Litv_Word64 v)) :int))) :v + v) ∧ do_conversion v IntT (WordT W8) = SOME (INR (Litv (Word8 (i2w (the_Litv_IntLit v) :word8))) :v + v) ∧ do_conversion v IntT (WordT W64) = SOME (INR (Litv (Word64 (i2w (the_Litv_IntLit v) :word64))) :v + v) ∧ do_conversion v CharT IntT = SOME (INR (Litv (IntLit ((&ORD (the_Litv_Char v)) :int))) :v + v) ∧ do_conversion v IntT CharT = (let (i :int) = the_Litv_IntLit v in if i < (0 :int) ∨ i > (255 :int) then SOME (INL chr_exn_v :v + v) else SOME (INR (Litv (Char (CHR (Num (ABS i))))) :v + v)) ∧ do_conversion v CharT (WordT W8) = SOME (INR (Litv (Word8 (char_to_word8 (the_Litv_Char v)))) :v + v) ∧ do_conversion v (WordT W8) CharT = SOME (INR (Litv (Char (word8_to_char (the_Litv_Word8 v)))) :v + v) ∧ do_conversion v Float64T (WordT W64) = SOME (INR (Litv (Word64 (the_Litv_Float64 v))) :v + v) ∧ do_conversion v (WordT W64) Float64T = SOME (INR (Litv (Float64 (the_Litv_Word64 v))) :v + v) ∧ do_conversion (v0 :v) (v1 :prim_type) BoolT = (NONE :(v + v) option) ∧ do_conversion v0 BoolT IntT = (NONE :(v + v) option) ∧ do_conversion v0 IntT IntT = (NONE :(v + v) option) ∧ do_conversion v0 StrT IntT = (NONE :(v + v) option) ∧ do_conversion v0 Float64T IntT = (NONE :(v + v) option) ∧ do_conversion v0 BoolT CharT = (NONE :(v + v) option) ∧ do_conversion v0 CharT CharT = (NONE :(v + v) option) ∧ do_conversion v0 StrT CharT = (NONE :(v + v) option) ∧ do_conversion v0 (WordT W64) CharT = (NONE :(v + v) option) ∧ do_conversion v0 Float64T CharT = (NONE :(v + v) option) ∧ do_conversion v0 v1 StrT = (NONE :(v + v) option) ∧ do_conversion v0 BoolT (WordT (v7 :word_size)) = (NONE :(v + v) option) ∧ do_conversion v0 CharT (WordT W64) = (NONE :(v + v) option) ∧ do_conversion v0 StrT (WordT v7) = (NONE :(v + v) option) ∧ do_conversion v0 (WordT (v13 :word_size)) (WordT v7) = (NONE :(v + v) option) ∧ do_conversion v0 Float64T (WordT W8) = (NONE :(v + v) option) ∧ do_conversion v0 BoolT Float64T = (NONE :(v + v) option) ∧ do_conversion v0 IntT Float64T = (NONE :(v + v) option) ∧ do_conversion v0 CharT Float64T = (NONE :(v + v) option) ∧ do_conversion v0 StrT Float64T = (NONE :(v + v) option) ∧ do_conversion v0 (WordT W8) Float64T = (NONE :(v + v) option) ∧ do_conversion v0 Float64T Float64T = (NONE :(v + v) option)
the_Boolv_def_typed=∀(v :v). the_Boolv v ⇔ v = Boolv T
do_arith_def_typed=do_arith (a :arith) Float64T (vals :v list) = (case (a,MAP the_Litv_Float64 vals) of (v5,([] :word64 list)) => (NONE :(v + v) option) | (Add,[v1]) => (NONE :(v + v) option) | (Add,[v1; v2]) => SOME (INR (Litv (Float64 (fp64_add roundTiesToEven v1 v2))) :v + v) | (Add,v1::v2::v17::v18) => (NONE :(v + v) option) | (Sub,[v1]) => (NONE :(v + v) option) | (Sub,[v1; v2']) => SOME (INR (Litv (Float64 (fp64_sub roundTiesToEven v1 v2'))) :v + v) | (Sub,v1::v2'::v25::v26) => (NONE :(v + v) option) | (Mul,[v1]) => (NONE :(v + v) option) | (Mul,[v1; v2'']) => SOME (INR (Litv (Float64 (fp64_mul roundTiesToEven v1 v2''))) :v + v) | (Mul,v1::v2''::v33::v34) => (NONE :(v + v) option) | (Div,[v1]) => (NONE :(v + v) option) | (Div,[v1; v2'³']) => SOME (INR (Litv (Float64 (fp64_div roundTiesToEven v1 v2'³'))) :v + v) | (Div,v1::v2'³'::v41::v42) => (NONE :(v + v) option) | (Mod,v1::v10) => (NONE :(v + v) option) | (Neg,[v1]) => SOME (INR (Litv (Float64 (fp64_negate v1))) :v + v) | (Neg,v1::v45::v46) => (NONE :(v + v) option) | (And,v1::v10) => (NONE :(v + v) option) | (Xor,v1::v10) => (NONE :(v + v) option) | (Or,v1::v10) => (NONE :(v + v) option) | (Not,v1::v10) => (NONE :(v + v) option) | (Abs,[v1]) => SOME (INR (Litv (Float64 (fp64_abs v1))) :v + v) | (Abs,v1::v49::v50) => (NONE :(v + v) option) | (Sqrt,[v1]) => SOME (INR (Litv (Float64 (fp64_sqrt roundTiesToEven v1))) :v + v) | (Sqrt,v1::v53::v54) => (NONE :(v + v) option) | (FMA,[v1]) => (NONE :(v + v) option) | (FMA,[v1; v2'⁴']) => (NONE :(v + v) option) | (FMA,[v1; v2'⁴'; v3]) => SOME (INR (Litv (Float64 (fp64_mul_add roundTiesToEven v2'⁴' v3 v1))) :v + v) | (FMA,v1::v2'⁴'::v3::v65::v66) => (NONE :(v + v) option)) ∧ do_arith a IntT vals = (case (a,MAP the_Litv_IntLit vals) of (v4,([] :int list)) => (NONE :(v + v) option) | (v4,[v1]) => (NONE :(v + v) option) | (Add,[v1; v2]) => SOME (INR (Litv (IntLit (v1 + v2))) :v + v) | (Sub,[v1; v2]) => SOME (INR (Litv (IntLit (v1 − v2))) :v + v) | (Mul,[v1; v2]) => SOME (INR (Litv (IntLit (v1 * v2))) :v + v) | (Div,[v1; v2]) => SOME (if v2 = (0 :int) then (INL div_exn_v :v + v) else (INR (Litv (IntLit (v1 / v2))) :v + v)) | (Mod,[v1; v2]) => SOME (if v2 = (0 :int) then (INL div_exn_v :v + v) else (INR (Litv (IntLit (v1 % v2))) :v + v)) | (Neg,[v1; v2]) => (NONE :(v + v) option) | (And,[v1; v2]) => (NONE :(v + v) option) | (Xor,[v1; v2]) => (NONE :(v + v) option) | (Or,[v1; v2]) => (NONE :(v + v) option) | (Not,[v1; v2]) => (NONE :(v + v) option) | (Abs,[v1; v2]) => (NONE :(v + v) option) | (Sqrt,[v1; v2]) => (NONE :(v + v) option) | (FMA,[v1; v2]) => (NONE :(v + v) option) | (v4,v1::v2::v16::v17) => (NONE :(v + v) option)) ∧ do_arith a (WordT W8) vals = (case (a,MAP the_Litv_Word8 vals) of (v4,([] :word8 list)) => (NONE :(v + v) option) | (v4,[v1]) => (NONE :(v + v) option) | (Add,[v1; v2]) => SOME (INR (Litv (Word8 (v1 + v2))) :v + v) | (Sub,[v1; v2]) => SOME (INR (Litv (Word8 (v1 − v2))) :v + v) | (Mul,[v1; v2]) => (NONE :(v + v) option) | (Div,[v1; v2]) => (NONE :(v + v) option) | (Mod,[v1; v2]) => (NONE :(v + v) option) | (Neg,[v1; v2]) => (NONE :(v + v) option) | (And,[v1; v2]) => SOME (INR (Litv (Word8 (v1 && v2))) :v + v) | (Xor,[v1; v2]) => SOME (INR (Litv (Word8 (v1 ⊕ v2))) :v + v) | (Or,[v1; v2]) => SOME (INR (Litv (Word8 (v1 ‖ v2))) :v + v) | (Not,[v1; v2]) => (NONE :(v + v) option) | (Abs,[v1; v2]) => (NONE :(v + v) option) | (Sqrt,[v1; v2]) => (NONE :(v + v) option) | (FMA,[v1; v2]) => (NONE :(v + v) option) | (v4,v1::v2::v16::v17) => (NONE :(v + v) option)) ∧ do_arith a (WordT W64) vals = (case (a,MAP the_Litv_Word64 vals) of (v4,([] :word64 list)) => (NONE :(v + v) option) | (v4,[v1]) => (NONE :(v + v) option) | (Add,[v1; v2]) => SOME (INR (Litv (Word64 (v1 + v2))) :v + v) | (Sub,[v1; v2]) => SOME (INR (Litv (Word64 (v1 − v2))) :v + v) | (Mul,[v1; v2]) => (NONE :(v + v) option) | (Div,[v1; v2]) => (NONE :(v + v) option) | (Mod,[v1; v2]) => (NONE :(v + v) option) | (Neg,[v1; v2]) => (NONE :(v + v) option) | (And,[v1; v2]) => SOME (INR (Litv (Word64 (v1 && v2))) :v + v) | (Xor,[v1; v2]) => SOME (INR (Litv (Word64 (v1 ⊕ v2))) :v + v) | (Or,[v1; v2]) => SOME (INR (Litv (Word64 (v1 ‖ v2))) :v + v) | (Not,[v1; v2]) => (NONE :(v + v) option) | (Abs,[v1; v2]) => (NONE :(v + v) option) | (Sqrt,[v1; v2]) => (NONE :(v + v) option) | (FMA,[v1; v2]) => (NONE :(v + v) option) | (v4,v1::v2::v16::v17) => (NONE :(v + v) option)) ∧ do_arith a BoolT vals = (case (a,vals) of (Add,v4) => (NONE :(v + v) option) | (Sub,v4) => (NONE :(v + v) option) | (Mul,v4) => (NONE :(v + v) option) | (Div,v4) => (NONE :(v + v) option) | (Mod,v4) => (NONE :(v + v) option) | (Neg,v4) => (NONE :(v + v) option) | (And,v4) => (NONE :(v + v) option) | (Xor,v4) => (NONE :(v + v) option) | (Or,v4) => (NONE :(v + v) option) | (Not,([] :v list)) => (NONE :(v + v) option) | (Not,[v1]) => SOME (INR (Boolv (¬the_Boolv v1)) :v + v) | (Not,v1::v11::v12) => (NONE :(v + v) option) | (Abs,v4) => (NONE :(v + v) option) | (Sqrt,v4) => (NONE :(v + v) option) | (FMA,v4) => (NONE :(v + v) option)) ∧ do_arith a CharT vals = (NONE :(v + v) option) ∧ do_arith a StrT vals = (NONE :(v + v) option)
