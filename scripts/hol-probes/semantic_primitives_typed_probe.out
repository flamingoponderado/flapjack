add_decs_generation_def_typed=∀(s :eval_decs_state). add_decs_generation s = case s.env_id_counter of (cur_gen,next_id,next_gen) => s with env_id_counter := (next_gen,(0 :num),next_gen + (1 :num))
add_env_generation_def_typed=∀(s :eval_oracle_state). add_env_generation s = s with <|generation := LENGTH s.envs; envs := s.envs ++ [([] :v sem_env list)]|>
declare_env_def_typed=∀(es :eval_state option) (env :v sem_env). declare_env es env = case es of (NONE :eval_state option) => (NONE :(v # eval_state option) option) | SOME (EvalDecs s) => (case s.env_id_counter of (cur_gen,next_id,next_gen) => SOME (Env env (cur_gen,next_id),SOME (EvalDecs (s with env_id_counter := (cur_gen,next_id + (1 :num),next_gen))))) | SOME (EvalOracle s') => case LLOOKUP s'.envs s'.generation of (NONE :v sem_env list option) => (NONE :(v # eval_state option) option) | SOME gen_envs => SOME (Conv (NONE :stamp option) [nat_to_v s'.generation; nat_to_v (LENGTH gen_envs)],SOME (EvalOracle (s' with envs := s'.envs❲s'.generation ↦ gen_envs ++ [env]❳)))
lookup_env_def_typed=∀(s :eval_oracle_state) (i :num) (j :num). lookup_env s (i,j) = case LLOOKUP s.envs i of (NONE :v sem_env list option) => (NONE :v sem_env option) | SOME gen_envs => LLOOKUP gen_envs j
