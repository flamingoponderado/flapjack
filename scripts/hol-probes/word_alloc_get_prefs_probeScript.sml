load "bossLib";
load "preamble";
load "word_allocTheory";
open bossLib HolKernel Parse preamble word_allocTheory;
fun observe label term = let val th = EVAL term in print (label ^ "="); print_term (rhs (concl th)); print "\n" end;
val _ = observe "prefs_skip" ``get_prefs (Skip:64 word wordLang$prog) [(9,8,7)] = [(9,8,7)]``;
val _ = observe "prefs_empty" ``get_prefs (Move 0 []:64 word wordLang$prog) [(9,8,7)] = [(9,8,7)]``;
val _ = observe "prefs_move" ``get_prefs (Move 2 [(1,3);(4,5)]:64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(2,4,5);(9,8,7)]``;
val _ = observe "prefs_duplicate" ``get_prefs (Move 2 [(1,3);(1,3)]:64 word wordLang$prog) [] = [(2,1,3);(2,1,3)]``;
val _ = observe "prefs_self" ``get_prefs (Move 0 [(3,3)]:64 word wordLang$prog) [] = [(0,3,3)]``;
val _ = observe "prefs_seq" ``get_prefs (Seq (Move 2 [(1,3)]) (Move 4 [(5,7)]):64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(4,5,7);(9,8,7)]``;
val _ = observe "prefs_if_reg" ``get_prefs (If Equal 0 (Reg 1) (Move 2 [(1,3)]) (Move 4 [(5,7)]):64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(4,5,7);(9,8,7)]``;
val _ = observe "prefs_if_imm" ``get_prefs (If Less 99 (Imm 0w) (Move 2 [(1,3)]) (Move 4 [(5,7)]):64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(4,5,7);(9,8,7)]``;
val _ = observe "prefs_must" ``get_prefs (MustTerminate (Move 2 [(1,3)]):64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(9,8,7)]``;
val _ = observe "prefs_loop" ``get_prefs (Loop LN (Move 2 [(1,3)]) (LS ()):64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(9,8,7)]``;
val _ = observe "prefs_tail" ``get_prefs (Call NONE (SOME 123) [1;2] NONE:64 word wordLang$prog) [(9,8,7)] = [(9,8,7)]``;
val _ = observe "prefs_tail_handler" ``get_prefs (Call NONE NONE [] (SOME (1,Move 4 [(5,7)],11,13)):64 word wordLang$prog) [(9,8,7)] = [(9,8,7)]``;
val _ = observe "prefs_return" ``get_prefs (Call (SOME ([1],(LN,LN),Move 2 [(1,3)],17,19)) NONE [] NONE:64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(9,8,7)]``;
val _ = observe "prefs_both" ``get_prefs (Call (SOME ([1],(LN,LN),Move 2 [(1,3)],17,19)) NONE [] (SOME (1,Move 4 [(5,7)],11,13)):64 word wordLang$prog) [(9,8,7)] = [(4,5,7);(2,1,3);(9,8,7)]``;
val _ = observe "prefs_nested" ``get_prefs (Seq (MustTerminate (Move 2 [(1,3)])) (Loop LN (Move 4 [(5,7)]) LN):64 word wordLang$prog) [(9,8,7)] = [(2,1,3);(4,5,7);(9,8,7)]``;
val _ = observe "prefs_ignored" ``get_prefs (Return 3 [1;2;3]:64 word wordLang$prog) [(9,8,7)] = [(9,8,7)]``;
val _ = observe "prefs_large" ``get_prefs (Move 18446744073709551616 [(18446744073709551617,18446744073709551619)]:64 word wordLang$prog) [] = [(18446744073709551616,18446744073709551617,18446744073709551619)]``;
