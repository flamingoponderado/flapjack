read_limits_def_typed=∀(asm_conf :α asm_config) (c :config) (mc :(α, β, γ) machine_config) (ms :β). read_limits asm_conf c mc ms = get_stack_heap_limit ((2 :num) * max_heap_limit (:α) c.data_conf − (1 :num)) (mc.target.get_reg ms (find_name c.stack_conf.reg_names (2 :num)),mc.target.get_reg ms (find_name c.stack_conf.reg_names (3 :num)),mc.target.get_reg ms (find_name c.stack_conf.reg_names (4 :num)))
