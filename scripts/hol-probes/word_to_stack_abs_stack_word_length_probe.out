asl_full_abs_stack_empty=⊢ ∀bs ls stack lens. abs_stack bs [] ls lens = SOME stack ⇒ ls = [Word 0w] ∧ lens = []
asl_full_abs_stack_CONS_NIL=⊢ abs_stack bm (x::rest) [] l = NONE
asl_full_abs_stack_LENGTH=⊢ ∀bitmaps wstack tstack lens astack. abs_stack bitmaps wstack tstack lens = SOME astack ⇒ handler_val astack = LENGTH tstack
asl_full_abs_stack_empty_prime=⊢ abs_stack bs xs [] lens = SOME stack ⇔ F
