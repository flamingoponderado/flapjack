mem_load_align_dm=good_dimindex (:α) ⇒
(mem_load (n :num) (a :α addr) (align_dm (s :(α, β, γ) labSem$state)) :
 (α, β, γ) labSem$state) = align_dm (mem_load n a s :(α, β, γ) labSem$state)
mem_load_align_dm_types=(s :(α, β, γ) labSem$state)::(α, β, γ) labSem$state;(a :α addr)::α addr;(n :num)::num;
