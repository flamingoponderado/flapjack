source_opref_typed=SOME (([Refv (Litv (IntLit (7 :int)) :semanticPrimitives$v)],(ffi :α ffi_state)),(Rval (Loc T (0 :num) :semanticPrimitives$v) :(semanticPrimitives$v, semanticPrimitives$v) result))
