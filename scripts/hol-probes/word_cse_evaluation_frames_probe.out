fr_full_write=⊢ ∀a r u w s. can_mem_arith a ∧ ¬MEM r (arithReads a) ⇒ (evaluate (Inst (Arith a),set_var r u s) = (NONE,set_var (firstRegOfArith a) w (set_var r u s)) ⇔ evaluate (Inst (Arith a),s) = (NONE,set_var (firstRegOfArith a) w s))
fr_full_memory=⊢ ∀a w s m. can_mem_arith a ⇒ (evaluate (Inst (Arith a),s with memory := m) = (NONE,set_var (firstRegOfArith a) w s with memory := m) ⇔ evaluate (Inst (Arith a),s) = (NONE,set_var (firstRegOfArith a) w s))
fr_full_arith_agree=⊢ ∀a w s1 s2. evaluate (Inst (Arith a),s1) = (NONE,set_var (firstRegOfArith a) w s1) ∧ can_mem_arith a ∧ s2.locals = s1.locals ⇒ evaluate (Inst (Arith a),s2) = (NONE,set_var (firstRegOfArith a) w s2)
fr_full_load_agree=⊢ ∀op r a ofs w s1 s2. evaluate (Inst (Mem op r (Addr a ofs)),s1) = (NONE,set_var r w s1) ∧ ¬is_store op ∧ s2.locals = s1.locals ∧ s2.memory = s1.memory ∧ s2.mdomain = s1.mdomain ∧ (s2.be ⇔ s1.be) ⇒ evaluate (Inst (Mem op r (Addr a ofs)),s2) = (NONE,set_var r w s2)
fr_type_arith=:α arith
fr_type_state=:(α, γ, 'ffi) state
fr_type_value=:α word_loc
fr_type_memory=:α word -> α word_loc
