compile_to_word_conventions2_typed=(compile (wc :word_to_word$config) (ac :α asm_config) (p :(num # num # α wordLang$prog) list) :num sptree$num_map option list # (num # num # α wordLang$prog) list) = ((_0 :num sptree$num_map option list),(ps :(num # num # α wordLang$prog) list)) ∧ EVERY (λ((_1 :num),(_2 :num),(prg :α wordLang$prog)). no_share_inst prg ∨ ac.ISA ≠ Ag32) p ⇒ MAP (FST :num # num # α wordLang$prog -> num) ps = MAP (FST :num # num # α wordLang$prog -> num) p ∧ LIST_REL (labels_rel :(num # num) list -> (num # num) list -> bool) (MAP ((extract_labels :α wordLang$prog -> (num # num) list) ∘ (SND :num # α wordLang$prog -> α wordLang$prog) ∘ (SND :num # num # α wordLang$prog -> num # α wordLang$prog)) p) (MAP ((extract_labels :α wordLang$prog -> (num # num) list) ∘ (SND :num # α wordLang$prog -> α wordLang$prog) ∘ (SND :num # num # α wordLang$prog -> num # α wordLang$prog)) ps) ∧ EVERY (λ((n :num),(m :num),(prog :α wordLang$prog)). flat_exp_conventions prog ∧ post_alloc_conventions (ac.reg_count − ((5 :num) + LENGTH ac.avoid_regs)) prog ∧ (EVERY (λ((n :num),(m :num),(prog :α wordLang$prog)). every_inst (inst_ok_less ac) prog) p ∧ addr_offset_ok ac (0w :α word) ∧ hw_offset_ok ac (0w :α word) ∧ byte_offset_ok ac (0w :α word) ⇒ full_inst_ok_less ac prog) ∧ (ac.two_reg_arith ⇒ every_inst (two_reg_inst :α inst -> bool) prog) ∧ (no_share_inst prog ∨ ac.ISA ≠ Ag32)) ps
