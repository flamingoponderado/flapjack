init_code_pre_definition=∀k bitmaps data_sp s. init_code_pre k bitmaps data_sp s ⇔ ∃ptr2 ptr3 ptr4 bitmap_ptr. good_dimindex (:α) ∧ 8 ≤ k ∧ 1 ∈ domain s.code ∧ {k; k + 1; k + 2} ⊆ s.ffi_save_regs ∧ ¬s.use_stack ∧ ¬s.use_store ∧ ¬s.use_alloc ∧ FLOOKUP s.regs 2 = SOME (Word ptr2) ∧ FLOOKUP s.regs 3 = SOME (Word ptr3) ∧ FLOOKUP s.regs 4 = SOME (Word ptr4) ∧ s.memory ptr2 = Word bitmap_ptr ∧ s.memory (ptr2 + bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) ∧ s.memory (ptr2 + 2w * bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps) + bytes_in_word * n2w data_sp) ∧ s.memory (ptr2 + 3w * bytes_in_word) = Word s.code_buffer.position ∧ s.memory (ptr2 + 4w * bytes_in_word) = Word (s.code_buffer.position + n2w s.code_buffer.space_left) ∧ ptr2 ≤₊ ptr4 ∧ 1024w * bytes_in_word ≤₊ ptr4 − ptr2 ∧ byte_aligned ptr2 ∧ byte_aligned ptr4 ∧ byte_aligned bitmap_ptr ∧ s.code_buffer.buffer = [] ∧ (word_list bitmap_ptr (MAP Word bitmaps) * word_list_exists (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) data_sp * word_list_exists ptr2 (w2n (ptr4 − ptr2) DIV w2n bytes_in_word)) (fun2set (s.memory,s.mdomain))
init_code_pre_type=:num -> α word list -> num -> (α, β, γ) stackSem$state -> bool
