fun theoremRow label th = (if null (hyp th) then () else raise Fail "open premise"; print(label ^ "="); print_thm th; print "\n");
val stack_move_reg_bound = prove(``∀n st off i p k.
    i < k ∧
    reg_bound p k ⇒
    reg_bound (stack_move n st off i p) k``, Induct>>rw[stack_move_def,reg_bound_def]);
val _ = theoremRow "rrb_full_stack_move_reg_bound" stack_move_reg_bound;
val copy_ret_aux_reg_bound = prove(``∀k f n.
  reg_bound (copy_ret_aux k f n) (k+2)``, ho_match_mp_tac copy_ret_aux_ind>>
  rw[]>>simp[Once copy_ret_aux_def]>>rw[]>>
  simp[reg_bound_def,stackLangTheory.list_Seq_def]);
val _ = theoremRow "rrb_full_copy_ret_aux_reg_bound" copy_ret_aux_reg_bound;
val copy_ret_reg_bound = prove(``reg_bound kont (k + 2) ⇒
  (reg_bound (copy_ret perf b (k,f,f') vs kont) (k + 2))``, rw[copy_ret_def]>>
  simp[reg_bound_def,SeqStackFree_def,copy_ret_aux_reg_bound]);
val _ = theoremRow "rrb_full_copy_ret_reg_bound" copy_ret_reg_bound;
