float_typed=recordtype.float::word1 -> χ word -> τ word -> (τ, χ) float
float_compare_typed=LT::float_compare; EQ::float_compare; GT::float_compare; UN::float_compare
float_abs_def_typed=∀(x :(τ, χ) float). float_abs x = x with Sign := (0w :word1)
float_compare_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_compare x y = case (float_value x,float_value y) of (Float r1,Float r2) => if r1 < r2 then LT else if r1 = r2 then EQ else GT | (Float r1,Infinity) => if y.Sign = (1w :word1) then GT else LT | (Float r1,NaN) => UN | (Infinity,Float v7) => if x.Sign = (1w :word1) then LT else GT | (Infinity,Infinity) => if x.Sign = y.Sign then EQ else if x.Sign = (1w :word1) then LT else GT | (Infinity,NaN) => UN | (NaN,v1) => UN
float_equal_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_equal x y ⇔ float_compare x y = EQ
float_greater_equal_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_greater_equal x y ⇔ case float_compare x y of LT => F | EQ => T | GT => T | UN => F
float_greater_than_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_greater_than x y ⇔ float_compare x y = GT
float_is_finite_def_typed=∀(x :(τ, χ) float). float_is_finite x ⇔ case float_value x of Float v1 => T | Infinity => F | NaN => F
float_is_infinite_def_typed=∀(x :(τ, χ) float). float_is_infinite x ⇔ case float_value x of Float v1 => F | Infinity => T | NaN => F
float_is_nan_def_typed=∀(x :(τ, χ) float). float_is_nan x ⇔ case float_value x of Float v1 => F | Infinity => F | NaN => T
float_is_normal_def_typed=∀(x :(τ, χ) float). float_is_normal x ⇔ x.Exponent ≠ (0w :χ word) ∧ x.Exponent ≠ (UINT_MAXw :χ word)
float_is_signalling_def_typed=∀(x :(τ, χ) float). float_is_signalling x ⇔ float_is_nan x ∧ ¬word_msb x.Significand
float_is_subnormal_def_typed=∀(x :(τ, χ) float). float_is_subnormal x ⇔ x.Exponent = (0w :χ word) ∧ x.Significand ≠ (0w :τ word)
float_is_zero_def_typed=∀(x :(τ, χ) float). float_is_zero x ⇔ case float_value x of Float r => r = (0 :real) | Infinity => F | NaN => F
float_less_equal_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_less_equal x y ⇔ case float_compare x y of LT => T | EQ => T | GT => F | UN => F
float_less_than_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_less_than x y ⇔ float_compare x y = LT
float_negate_def_typed=∀(x :(τ, χ) float). float_negate x = x with Sign := ¬x.Sign
float_to_real_def_typed=∀(x :(τ, χ) float). float_to_real x = if x.Exponent = (0w :χ word) then fsign x * ((2 :real) / (2 :real) pow INT_MAX (:χ)) * (((&w2n x.Significand) :real) / (2 :real) pow dimindex (:τ)) else fsign x * ((2 :real) pow w2n x.Exponent / (2 :real) pow INT_MAX (:χ)) * ((1 :real) + ((&w2n x.Significand) :real) / (2 :real) pow dimindex (:τ))
float_value_def_typed=∀(x :(τ, χ) float). float_value x = if x.Exponent = (UINT_MAXw :χ word) then if x.Significand = (0w :τ word) then Infinity else NaN else Float (float_to_real x)
float_add_def_typed=∀(mode :rounding) (x :(τ, χ) float) (y :(τ, χ) float). float_add mode x y = case (float_value x,float_value y) of (Float r1,Float r2) => (float_round_with_flags mode (if r1 = (0 :real) ∧ r2 = (0 :real) ∧ x.Sign = y.Sign then x.Sign = (1w :word1) else (mode = roundTowardNegative)) (r1 + r2) :flags # (τ, χ) float) | (Float r1,Infinity) => (clear_flags,y) | (Float r1,NaN) => (check_for_signalling [y],float_some_qnan (FP_Add mode x y)) | (Infinity,Float v7) => (clear_flags,x) | (Infinity,Infinity) => if x.Sign = y.Sign then (clear_flags,x) else (invalidop_flags,float_some_qnan (FP_Add mode x y)) | (Infinity,NaN) => (check_for_signalling [y],float_some_qnan (FP_Add mode x y)) | (NaN,v1) => (check_for_signalling [x; y],float_some_qnan (FP_Add mode x y))
float_div_def_typed=∀(mode :rounding) (x :(τ, χ) float) (y :(τ, χ) float). float_div mode x y = case (float_value x,float_value y) of (Float (0 :real),Float (0 :real)) => (invalidop_flags,float_some_qnan (FP_Div mode x y)) | (Float r1,Float (0 :real)) => (dividezero_flags,if x.Sign = y.Sign then float_plus_infinity (:τ # χ) else float_minus_infinity (:τ # χ)) | (Float r1,Float r2) => (float_round_with_flags mode (x.Sign ≠ y.Sign) (r1 / r2) :flags # (τ, χ) float) | (Float r1,Infinity) => (clear_flags,if x.Sign = y.Sign then POS0 else NEG0) | (Float r1,NaN) => (check_for_signalling [y],float_some_qnan (FP_Div mode x y)) | (Infinity,Float v7) => (clear_flags,if x.Sign = y.Sign then float_plus_infinity (:τ # χ) else float_minus_infinity (:τ # χ)) | (Infinity,Infinity) => (invalidop_flags,float_some_qnan (FP_Div mode x y)) | (Infinity,NaN) => (check_for_signalling [y],float_some_qnan (FP_Div mode x y)) | (NaN,v1) => (check_for_signalling [x; y],float_some_qnan (FP_Div mode x y))
float_mul_def_typed=∀(mode :rounding) (x :(τ, χ) float) (y :(τ, χ) float). float_mul mode x y = case (float_value x,float_value y) of (Float r',Float r2) => (float_round_with_flags mode (x.Sign ≠ y.Sign) (r' * r2) :flags # (τ, χ) float) | (Float (0 :real),Infinity) => (invalidop_flags,float_some_qnan (FP_Mul mode x y)) | (Float r',Infinity) => (clear_flags,if x.Sign = y.Sign then float_plus_infinity (:τ # χ) else float_minus_infinity (:τ # χ)) | (Float r',NaN) => (check_for_signalling [y],float_some_qnan (FP_Mul mode x y)) | (Infinity,Float (0 :real)) => (invalidop_flags,float_some_qnan (FP_Mul mode x y)) | (Infinity,Float r) => (clear_flags,if x.Sign = y.Sign then float_plus_infinity (:τ # χ) else float_minus_infinity (:τ # χ)) | (Infinity,Infinity) => (clear_flags,if x.Sign = y.Sign then float_plus_infinity (:τ # χ) else float_minus_infinity (:τ # χ)) | (Infinity,NaN) => (check_for_signalling [y],float_some_qnan (FP_Mul mode x y)) | (NaN,v1) => (check_for_signalling [x; y],float_some_qnan (FP_Mul mode x y))
float_mul_add_def_typed=∀(mode :rounding) (x :(τ, χ) float) (y :(τ, χ) float) (z :(τ, χ) float). float_mul_add mode x y z = (let (signP :word1) = x.Sign ⊕ y.Sign; (infP :bool) = (float_is_infinite x ∨ float_is_infinite y) in if float_is_nan x ∨ float_is_nan y ∨ float_is_nan z then (check_for_signalling [x; y; z],float_some_qnan (FP_MulAdd mode x y z)) else if float_is_infinite x ∧ float_is_zero y ∨ float_is_zero x ∧ float_is_infinite y ∨ float_is_infinite z ∧ infP ∧ signP ≠ z.Sign then (invalidop_flags,float_some_qnan (FP_MulAdd mode x y z)) else if float_is_infinite z ∧ z.Sign = (0w :word1) ∨ infP ∧ signP = (0w :word1) then (clear_flags,float_plus_infinity (:τ # χ)) else if float_is_infinite z ∧ z.Sign = (1w :word1) ∨ infP ∧ signP = (1w :word1) then (clear_flags,float_minus_infinity (:τ # χ)) else (let (r1 :real) = float_to_real x * float_to_real y; (r2 :real) = float_to_real z; (r :real) = r1 + r2 in (float_round_with_flags mode (r = (0 :real) ∧ (if r1 = (0 :real) ∧ r2 = (0 :real) ∧ signP = z.Sign then signP = (1w :word1) else mode = roundTowardNegative) ∨ r < (0 :real)) r :flags # (τ, χ) float)))
float_sub_def_typed=∀(mode :rounding) (x :(τ, χ) float) (y :(τ, χ) float). float_sub mode x y = case (float_value x,float_value y) of (Float r1,Float r2) => (float_round_with_flags mode (if r1 = (0 :real) ∧ r2 = (0 :real) ∧ x.Sign ≠ y.Sign then x.Sign = (1w :word1) else (mode = roundTowardNegative)) (r1 − r2) :flags # (τ, χ) float) | (Float r1,Infinity) => (clear_flags,float_negate y) | (Float r1,NaN) => (check_for_signalling [y],float_some_qnan (FP_Sub mode x y)) | (Infinity,Float v7) => (clear_flags,x) | (Infinity,Infinity) => if x.Sign = y.Sign then (invalidop_flags,float_some_qnan (FP_Sub mode x y)) else (clear_flags,x) | (Infinity,NaN) => (check_for_signalling [y],float_some_qnan (FP_Sub mode x y)) | (NaN,v1) => (check_for_signalling [x; y],float_some_qnan (FP_Sub mode x y))
float_to_int_def_typed=∀(mode :rounding) (x :(τ, χ) float). float_to_int mode x = case float_value x of Float r => SOME (case mode of roundTiesToEven => (let (f :int) = ⌊r⌋; (df :real) = abs (r − real_of_int f) in if df < (1 :real) / (2 :real) ∨ df = (1 :real) / (2 :real) ∧ EVEN (Num (ABS f)) then f else ⌈r⌉) | roundTowardPositive => ⌈r⌉ | roundTowardNegative => ⌊r⌋ | roundTowardZero => if x.Sign = (1w :word1) then ⌈r⌉ else ⌊r⌋) | Infinity => (NONE :int option) | NaN => (NONE :int option)
flags_typed=recordtype.flags::bool -> bool -> bool -> bool -> bool -> bool -> flags
fp_op_typed=FP_Sqrt::rounding -> (τ, χ) float -> (τ, χ) fp_op; FP_Add::rounding -> (τ, χ) float -> (τ, χ) float -> (τ, χ) fp_op; FP_Sub::rounding -> (τ, χ) float -> (τ, χ) float -> (τ, χ) fp_op; FP_Mul::rounding -> (τ, χ) float -> (τ, χ) float -> (τ, χ) fp_op; FP_Div::rounding -> (τ, χ) float -> (τ, χ) float -> (τ, χ) fp_op; FP_MulAdd::rounding -> (τ, χ) float -> (τ, χ) float -> (τ, χ) float -> (τ, χ) fp_op; FP_MulSub::rounding -> (τ, χ) float -> (τ, χ) float -> (τ, χ) float -> (τ, χ) fp_op
rounding_typed=roundTiesToEven::rounding; roundTowardPositive::rounding; roundTowardNegative::rounding; roundTowardZero::rounding
check_for_signalling_def_typed=∀(l :(α, β) float list). check_for_signalling l = clear_flags with InvalidOp := EXISTS (float_is_signalling :(α, β) float -> bool) l
clear_flags_def_typed=clear_flags = <|DivideByZero := F; InvalidOp := F; Overflow := F; Precision := F; Underflow_BeforeRounding := F; Underflow_AfterRounding := F|>
dividezero_flags_def_typed=dividezero_flags = clear_flags with DivideByZero := T
float_bottom_def_typed=float_bottom (:τ # χ) = float_negate FLT_MAX
float_minus_infinity_def_typed=float_minus_infinity (:τ # χ) = float_negate (float_plus_infinity (:τ # χ))
float_minus_min_def_typed=float_minus_min (:τ # χ) = float_negate (float_plus_min (:τ # χ))
float_minus_zero_def_typed=NEG0 = float_negate POS0
float_plus_infinity_def_typed=float_plus_infinity (:τ # χ) = <|Sign := (0w :word1); Exponent := (UINT_MAXw :χ word); Significand := (0w :τ word)|>
float_plus_min_def_typed=float_plus_min (:τ # χ) = <|Sign := (0w :word1); Exponent := (0w :χ word); Significand := (1w :τ word)|>
float_plus_zero_def_typed=POS0 = <|Sign := (0w :word1); Exponent := (0w :χ word); Significand := (0w :τ word)|>
float_some_qnan_def_typed=∀(fp_op :(τ, χ) fp_op). float_some_qnan fp_op = (@(f :(τ, χ) fp_op -> (τ, χ) float). (let (qnan :(τ, χ) float) = f fp_op in float_is_nan qnan ∧ ¬float_is_signalling qnan)) fp_op
float_top_def_typed=FLT_MAX = <|Sign := (0w :word1); Exponent := (UINT_MAXw :χ word) − (1w :χ word); Significand := (UINT_MAXw :τ word)|>
invalidop_flags_def_typed=invalidop_flags = clear_flags with InvalidOp := T
float_value_typed=Float::real -> float_value; Infinity::float_value; NaN::float_value
closest_def_typed=(closest :((α, β) float -> bool) -> real -> (α, β) float) = closest_such (K T :(α, β) float -> bool)
closest_such_def_typed=∀(p :(α, β) float -> bool) (s :(α, β) float -> bool) (x :real). closest_such p s x = @(a :(α, β) float). is_closest s x a ∧ ∀(b :(α, β) float). is_closest s x b ∧ p b ⇒ p a
largest_def_typed=largest (:τ # χ) = (2 :real) pow (UINT_MAX (:χ) − (1 :num)) / (2 :real) pow INT_MAX (:χ) * ((2 :real) − ((2 :real) pow dimindex (:τ))⁻¹)
float_round_def_typed=∀(mode :rounding) (toneg :bool) (r :real). (float_round mode toneg r :(τ, χ) float) = (let (x :(τ, χ) float) = (round mode r :(τ, χ) float) in if float_is_zero x then if toneg then NEG0 else POS0 else x)
float_round_with_flags_def_typed=∀(mode :rounding) (to_neg :bool) (r :real). (float_round_with_flags mode to_neg r :flags # (τ, χ) float) = (let (x :(τ, χ) float) = (float_round mode to_neg r :(τ, χ) float) and (a :real) = abs r; (inexact :bool) = (float_value x ≠ Float r) in (clear_flags with <|Overflow := (float_is_infinite x ∨ (2 :real) pow INT_MIN (:χ) ≤ a); Underflow_BeforeRounding := (inexact ∧ a < (2 :real) / (2 :real) pow INT_MAX (:χ)); Underflow_AfterRounding := (inexact ∧ (float_round mode to_neg r :(τ, χ + unit) float).Exponent ≤₊ (n2w (INT_MIN (:χ)) :(χ + unit) word)); Precision := inexact|>,x))
float_sqrt_def_typed=∀(mode :rounding) (x :(τ, χ) float). float_sqrt mode x = if x.Sign = (0w :word1) then case float_value x of Float r => (float_round_with_flags mode F (sqrt r) :flags # (τ, χ) float) | Infinity => (clear_flags,float_plus_infinity (:τ # χ)) | NaN => (check_for_signalling [x],float_some_qnan (FP_Sqrt mode x)) else if x = NEG0 then (clear_flags,NEG0) else (invalidop_flags,float_some_qnan (FP_Sqrt mode x))
threshold_def_typed=threshold (:τ # χ) = (2 :real) pow (UINT_MAX (:χ) − (1 :num)) / (2 :real) pow INT_MAX (:χ) * ((2 :real) − ((2 :real) pow SUC (dimindex (:τ)))⁻¹)
is_closest_def_typed=∀(s :(α, β) float -> bool) (x :real) (a :(α, β) float). is_closest s x a ⇔ a ∈ s ∧ ∀(b :(α, β) float). b ∈ s ⇒ abs (float_to_real a − x) ≤ abs (float_to_real b − x)
real_to_float_def_typed=∀(m :rounding). (real_to_float m :real -> (α, β) float) = (float_round m (m = roundTowardNegative) :real -> (α, β) float)
real_to_float_with_flags_def_typed=∀(m :rounding). (real_to_float_with_flags m :real -> flags # (α, β) float) = (float_round_with_flags m (m = roundTowardNegative) :real -> flags # (α, β) float)
round_def_typed=∀(mode :rounding) (x :real). (round mode x :(τ, χ) float) = case mode of roundTiesToEven => (let (t :real) = threshold (:τ # χ) in if x ≤ -t then float_minus_infinity (:τ # χ) else if x ≥ t then float_plus_infinity (:τ # χ) else closest_such (λ(a :(τ, χ) float). ¬word_lsb a.Significand) (float_is_finite :(τ, χ) float -> bool) x) | roundTowardPositive => (let (t :real) = largest (:τ # χ) in if x < -t then float_bottom (:τ # χ) else if x > t then float_plus_infinity (:τ # χ) else closest {a | float_is_finite a ∧ float_to_real a ≥ x} x) | roundTowardNegative => (let (t :real) = largest (:τ # χ) in if x < -t then float_minus_infinity (:τ # χ) else if x > t then FLT_MAX else closest {a | float_is_finite a ∧ float_to_real a ≤ x} x) | roundTowardZero => (let (t :real) = largest (:τ # χ) in if x < -t then float_bottom (:τ # χ) else if x > t then FLT_MAX else closest {a | float_is_finite a ∧ abs (float_to_real a) ≤ abs x} x)
is_integral_def_typed=∀(r :real). is_integral r ⇔ ∃(n :num). abs r = ((&n) :real)
float_is_integral_def_typed=∀(x :(τ, χ) float). float_is_integral x ⇔ case float_value x of Float r => is_integral r | Infinity => F | NaN => F
ULP_def_typed=∀*(e :χ word) . ULP ((e :χ word),(:τ)) = (2 :real) pow (if e = (0w :χ word) then (1 :num) else w2n e) / (2 :real) pow (INT_MAX (:χ) + dimindex (:τ))
ulp_def_typed=ulp (:τ # χ) = ULP ((0w :χ word),(:τ))
integral_round_def_typed=∀(mode :rounding) (x :real). (integral_round mode x :(τ, χ) float) = case mode of roundTiesToEven => (let (t :real) = threshold (:τ # χ) in if x ≤ -t then float_minus_infinity (:τ # χ) else if x ≥ t then float_plus_infinity (:τ # χ) else closest_such (λ(a :(τ, χ) float). ∃(n :num). EVEN n ∧ abs (float_to_real a) = ((&n) :real)) (float_is_integral :(τ, χ) float -> bool) x) | roundTowardPositive => (let (t :real) = largest (:τ # χ) in if x < -t then float_bottom (:τ # χ) else if x > t then float_plus_infinity (:τ # χ) else closest {a | float_is_integral a ∧ float_to_real a ≥ x} x) | roundTowardNegative => (let (t :real) = largest (:τ # χ) in if x < -t then float_minus_infinity (:τ # χ) else if x > t then FLT_MAX else closest {a | float_is_integral a ∧ float_to_real a ≤ x} x) | roundTowardZero => (let (t :real) = largest (:τ # χ) in if x < -t then float_bottom (:τ # χ) else if x > t then FLT_MAX else closest {a | float_is_integral a ∧ abs (float_to_real a) ≤ abs x} x)
float_round_to_integral_def_typed=∀(mode :rounding) (x :(τ, χ) float). float_round_to_integral mode x = case float_value x of Float r => (integral_round mode r :(τ, χ) float) | Infinity => x | NaN => x
float_mul_sub_def_typed=∀(mode :rounding) (x :(τ, χ) float) (y :(τ, χ) float) (z :(τ, χ) float). float_mul_sub mode x y z = (let (signP :word1) = x.Sign ⊕ y.Sign; (infP :bool) = (float_is_infinite x ∨ float_is_infinite y) in if float_is_nan x ∨ float_is_nan y ∨ float_is_nan z then (check_for_signalling [x; y; z],float_some_qnan (FP_MulSub mode x y z)) else if float_is_infinite x ∧ float_is_zero y ∨ float_is_zero x ∧ float_is_infinite y ∨ float_is_infinite z ∧ infP ∧ signP = z.Sign then (invalidop_flags,float_some_qnan (FP_MulAdd mode x y z)) else if float_is_infinite z ∧ z.Sign = (1w :word1) ∨ infP ∧ signP = (0w :word1) then (clear_flags,float_plus_infinity (:τ # χ)) else if float_is_infinite z ∧ z.Sign = (0w :word1) ∨ infP ∧ signP = (1w :word1) then (clear_flags,float_minus_infinity (:τ # χ)) else (let (r1 :real) = float_to_real x * float_to_real y and (r2 :real) = float_to_real z in (float_round_with_flags mode (if r1 = (0 :real) ∧ r2 = (0 :real) ∧ signP ≠ z.Sign then signP = (1w :word1) else (mode = roundTowardNegative)) (r1 − r2) :flags # (τ, χ) float)))
float_unordered_def_typed=∀(x :(τ, χ) float) (y :(τ, χ) float). float_unordered x y ⇔ float_compare x y = UN
exponent_boundary_def_typed=∀(y :(τ, χ) float) (x :(τ, χ) float). exponent_boundary y x ⇔ x.Sign = y.Sign ∧ w2n x.Exponent = w2n y.Exponent + (1 :num) ∧ x.Exponent ≠ (1w :χ word) ∧ y.Significand = -(1w :τ word) ∧ x.Significand = (0w :τ word)
float_ulp_def_typed=∀(f :(α, β) float). ulpᶠ f = ULP (f.Exponent,(:α))
next_hi_def_typed=∀(x :(τ, χ) float). next_hi x = if x.Significand <₊ (UINT_MAXw :τ word) then x with Significand := x.Significand + (1w :τ word) else <|Sign := x.Sign; Exponent := x.Exponent + (1w :χ word); Significand := (0w :τ word)|>
next_lo_def_typed=∀(x :(τ, χ) float). next_lo x = if (0w :τ word) <₊ x.Significand then x with Significand := x.Significand − (1w :τ word) else <|Sign := x.Sign; Exponent := x.Exponent − (1w :χ word); Significand := (UINT_MAXw :τ word)|>
