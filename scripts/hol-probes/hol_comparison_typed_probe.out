good_cmp_def_typed=∀(cmp :α -> α -> ordering). good_cmp cmp ⇔ (∀(x :α). cmp x x = Equal) ∧ (∀(x :α) (y :α). cmp x y = Equal ⇒ cmp y x = Equal) ∧ (∀(x :α) (y :α). cmp x y = Greater ⇔ cmp y x = Less) ∧ (∀(x :α) (y :α) (z :α). cmp x y = Equal ∧ cmp y z = Less ⇒ cmp x z = Less) ∧ (∀(x :α) (y :α) (z :α). cmp x y = Less ∧ cmp y z = Equal ⇒ cmp x z = Less) ∧ (∀(x :α) (y :α) (z :α). cmp x y = Equal ∧ cmp y z = Equal ⇒ cmp x z = Equal) ∧ ∀(x :α) (y :α) (z :α). cmp x y = Less ∧ cmp y z = Less ⇒ cmp x z = Less
totorder_imp_good_cmp_typed=∀(cmp :α -> α -> ordering). TotOrd cmp ⇒ good_cmp cmp
cmp_thms_typed=(Less ≠ Equal ∧ Less ≠ Greater ∧ Equal ≠ Greater) ∧ ((∀(v0 :α) (v1 :α) (v2 :α). (case Less of Less => v0 | Equal => v1 | Greater => v2) = v0) ∧ (∀(v0 :α) (v1 :α) (v2 :α). (case Equal of Less => v0 | Equal => v1 | Greater => v2) = v1) ∧ ∀(v0 :α) (v1 :α) (v2 :α). (case Greater of Less => v0 | Equal => v1 | Greater => v2) = v2) ∧ (∀(a :ordering). a = Less ∨ a = Equal ∨ a = Greater) ∧ ∀(cmp :α -> α -> ordering). good_cmp cmp ⇔ (∀(x :α). cmp x x = Equal) ∧ (∀(x :α) (y :α). cmp x y = Equal ⇒ cmp y x = Equal) ∧ (∀(x :α) (y :α). cmp x y = Greater ⇔ cmp y x = Less) ∧ (∀(x :α) (y :α) (z :α). cmp x y = Equal ∧ cmp y z = Less ⇒ cmp x z = Less) ∧ (∀(x :α) (y :α) (z :α). cmp x y = Less ∧ cmp y z = Equal ⇒ cmp x z = Less) ∧ (∀(x :α) (y :α) (z :α). cmp x y = Equal ∧ cmp y z = Equal ⇒ cmp x z = Equal) ∧ ∀(x :α) (y :α) (z :α). cmp x y = Less ∧ cmp y z = Less ⇒ cmp x z = Less
