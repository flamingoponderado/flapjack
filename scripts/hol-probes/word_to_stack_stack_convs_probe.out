wsc_full=⊢ compile ac F p = (bytes,c',f',p') ∧ EVERY (post_alloc_conventions k) (MAP (SND ∘ SND) p) ∧ k = ac.reg_count − (5 + LENGTH ac.avoid_regs) ∧ 4 ≤ k ⇒ EVERY alloc_arg (MAP SND p') ∧ EVERY (λp. reg_bound p (k + 2)) (MAP SND p') ∧ EVERY (λp. call_args p 1 2 3 4 0) (MAP SND p')
wsc_projected=⊢ ∀ac ps k. EVERY (post_alloc_conventions k) (MAP (SND ∘ SND) ps) ∧ k = ac.reg_count − (5 + LENGTH ac.avoid_regs) ∧ 4 ≤ k ⇒ EVERY alloc_arg (MAP SND (SND (SND (SND (compile ac F ps))))) ∧ EVERY (λp. reg_bound p (k + 2)) (MAP SND (SND (SND (SND (compile ac F ps))))) ∧ EVERY (λp. call_args p 1 2 3 4 0) (MAP SND (SND (SND (SND (compile ac F ps)))))
