t_compat_trans_typed=t_compat (a :num |-> infer_t) (b :num |-> infer_t) ∧ t_compat b (c :num |-> infer_t) ⇒ t_compat a c
SUBMAP_t_compat_typed=t_wfs (s' :num |-> infer_t) ∧ (s :num |-> infer_t) ⊑ s' ⇒ t_compat s s'
cvwalk_code_def_typed=∀(s :infer_t sptree$num_map). cvwalk_code s = (λ(n :num). case lookup n s of (NONE :infer_t option) => (INR (Infer_Tuvar n) :num + infer_t) | SOME (Infer_Tvar_db v9) => (INR (Infer_Tvar_db v9) :num + infer_t) | SOME (Infer_Tapp l n) => (INR (Infer_Tapp l n) :num + infer_t) | SOME (Infer_Tuvar u) => (INL u :num + infer_t))
tcvwalk_def_typed=∀(s :infer_t sptree$num_map) (n :num). tcvwalk s n = (TAILREC (cvwalk_code s) n :infer_t)
tcvwalk_thm_typed=∀(s :infer_t sptree$num_map) (n :num). tcvwalk s n = case lookup n s of (NONE :infer_t option) => Infer_Tuvar n | SOME (Infer_Tvar_db v9) => Infer_Tvar_db v9 | SOME (Infer_Tapp l n) => Infer_Tapp l n | SOME (Infer_Tuvar u) => tcvwalk s u
tcvwalk_correct_typed=∀(x :num). cwfs (s :infer_t sptree$num_map) ⇒ cvwalk s x = tcvwalk s x
tcwalk_def_typed=∀(s :infer_t sptree$num_map) (it :infer_t). tcwalk s it = case it of Infer_Tvar_db c => Infer_Tvar_db c | Infer_Tapp l n => Infer_Tapp l n | Infer_Tuvar v => tcvwalk s v
tcwalk_correct_typed=∀(s :infer_t sptree$num_map) (it :infer_t). cwfs s ⇒ cwalk s it = tcwalk s it
tcwalk_EQ_Infer_Tuvar_typed=cwfs (s :infer_t sptree$num_map) ∧ tcwalk s (t :infer_t) = Infer_Tuvar (v :num) ⇒ v ∉ (domain s :num -> bool) ∧ ∃(u :num). t = Infer_Tuvar u
kcocwl_code_def_typed=∀(s :infer_t sptree$num_map) (n :num). kcocwl_code s n = (λ(v :infer_t list list). case v of ([] :infer_t list list) => (INR F :infer_t list list + bool) | ([] :infer_t list)::v2 => (INL v2 :infer_t list list + bool) | (h::t)::v2 => case tcwalk s h of Infer_Tvar_db c => (INL (t::v2) :infer_t list list + bool) | Infer_Tapp l n' => (INL (l::t::v2) :infer_t list list + bool) | Infer_Tuvar v => if n = v then (INR T :infer_t list list + bool) else (INL (t::v2) :infer_t list list + bool))
tcocwl_thm_typed=∀(s :infer_t sptree$num_map) (n :num) (is :infer_t list list). tcocwl s n is ⇔ case is of ([] :infer_t list list) => F | ([] :infer_t list)::v2 => tcocwl s n v2 | (h::t)::v2 => case tcwalk s h of Infer_Tvar_db c => tcocwl s n (t::v2) | Infer_Tapp l n' => tcocwl s n (l::t::v2) | Infer_Tuvar v => if n = v then T else tcocwl s n (t::v2)
soc_encode_ts_typed=cwfs (s :infer_t sptree$num_map) ⇒ (soc (map encode_infer_t s) (encode_infer_ts (its :infer_t list)) (n :num) ⇔ EXISTS (λ(i :infer_t). soc (map encode_infer_t s) (encode_infer_t i) n) its)
coc_thm_typed=cwfs (s :infer_t sptree$num_map) ⇒ (coc s (it :infer_t) (n :num) ⇔ case cwalk s it of Infer_Tvar_db x => F | Infer_Tapp l n' => EXISTS (λ(i :infer_t). coc s i n) l | Infer_Tuvar u => n = u)
cocl_def_typed=(∀(s :infer_t sptree$num_map) (n :num). cocl s ([] :infer_t list) n ⇔ F) ∧ ∀(s :infer_t sptree$num_map) (i :infer_t) (is :infer_t list) (n :num). cocl s (i::is) n ⇔ coc s i n ∨ cocl s is n
cocl_EXISTS_typed=cocl (s :infer_t sptree$num_map) (its :infer_t list) (n :num) ⇔ EXISTS (λ(i :infer_t). coc s i n) its
tcocwl_correct_typed=cwfs (s :infer_t sptree$num_map) ⇒ (cocl s (ts :infer_t list) (n :num) ⇔ tcocwl s n [ts])
kcwalkstarwl_code_def_typed=∀(s :infer_t sptree$num_map). kcwalkstarwl_code s = (λ((v :bool),(t :infer_t list),(k :kclkont list)). if v then case k of ([] :kclkont list) => (INR t :bool # infer_t list # kclkont list + infer_t list) | DBk n::k => (INL (T,Infer_Tvar_db n::t,k) :bool # infer_t list # kclkont list + infer_t list) | APPk aits n'::k => (INL (T,Infer_Tapp aits n'::t,k) :bool # infer_t list # kclkont list + infer_t list) | UVk n''::k => (INL (T,Infer_Tuvar n''::t,k) :bool # infer_t list # kclkont list + infer_t list) | CONSk cits n'³'::k => (INL (F,cits,APPk t n'³'::k) :bool # infer_t list # kclkont list + infer_t list) else case t of ([] :infer_t list) => (INL (T,([] :infer_t list),k) :bool # infer_t list # kclkont list + infer_t list) | Infer_Tvar_db c::t => (INL (F,t,DBk c::k) :bool # infer_t list # kclkont list + infer_t list) | Infer_Tapp l n::t => (INL (F,l,CONSk t n::k) :bool # infer_t list # kclkont list + infer_t list) | Infer_Tuvar v::t => case tcvwalk s v of Infer_Tvar_db c => (INL (F,t,DBk c::k) :bool # infer_t list # kclkont list + infer_t list) | Infer_Tapp l n => (INL (F,l,CONSk t n::k) :bool # infer_t list # kclkont list + infer_t list) | Infer_Tuvar v => (INL (F,t,UVk v::k) :bool # infer_t list # kclkont list + infer_t list))
kclkont_axiom_typed=∀(f0 :num -> α) (f1 :infer_t list -> num -> α) (f2 :num -> α) (f3 :infer_t list -> num -> α). ∃(fn :kclkont -> α). (∀(a :num). fn (DBk a) = f0 a) ∧ (∀(a0 :infer_t list) (a1 :num). fn (APPk a0 a1) = f1 a0 a1) ∧ (∀(a :num). fn (UVk a) = f2 a) ∧ ∀(a0 :infer_t list) (a1 :num). fn (CONSk a0 a1) = f3 a0 a1
tcwalkstarwl_thm_typed=(∀(s :infer_t sptree$num_map) (k :kclkont list) (its :infer_t list). tcwalkstar_p2 s its k = case k of ([] :kclkont list) => its | DBk n::k => tcwalkstar_p2 s (Infer_Tvar_db n::its) k | APPk aits n'::k => tcwalkstar_p2 s (Infer_Tapp aits n'::its) k | UVk n''::k => tcwalkstar_p2 s (Infer_Tuvar n''::its) k | CONSk cits n'³'::k => tcwalkstar_p1 s cits (APPk its n'³'::k)) ∧ ∀(s :infer_t sptree$num_map) (k :kclkont list) (its :infer_t list). tcwalkstar_p1 s its k = case its of ([] :infer_t list) => tcwalkstar_p2 s ([] :infer_t list) k | Infer_Tvar_db c::t => tcwalkstar_p1 s t (DBk c::k) | Infer_Tapp l n::t => tcwalkstar_p1 s l (CONSk t n::k) | Infer_Tuvar v::t => case tcvwalk s v of Infer_Tvar_db c => tcwalkstar_p1 s t (DBk c::k) | Infer_Tapp l n => tcwalkstar_p1 s l (CONSk t n::k) | Infer_Tuvar v => tcwalkstar_p1 s t (UVk v::k)
tcwalkstarwl_correct_typed=cwfs (s :infer_t sptree$num_map) ⇒ cwalkstar s (it :infer_t) = HD (tcwalkstar_p1 s [it] ([] :kclkont list))
cunify_code_def_typed=cunify_code = (λ((s :infer_t sptree$num_map),(v :(infer_t list # infer_t list) list)). case v of ([] :(infer_t list # infer_t list) list) => (INR (SOME s) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | (([] :infer_t list),([] :infer_t list))::v2 => (INL (s,v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | (([] :infer_t list),h::t)::v2 => (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | (h::t,([] :infer_t list))::v2 => (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | (h::t,h'::t')::v2 => case tcwalk s h of Infer_Tvar_db c => (case tcwalk s h' of Infer_Tvar_db c' => if c = c' then (INL (s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) else (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | Infer_Tapp l n => (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | Infer_Tuvar v => (INL (insert v (Infer_Tvar_db c) s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option)) | Infer_Tapp l n => (case tcwalk s h' of Infer_Tvar_db c => (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | Infer_Tapp l' n' => if n = n' then (INL (s,(l,l')::(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) else (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | Infer_Tuvar v => if tcocwl s v [l] then (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) else (INL (insert v (Infer_Tapp l n) s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option)) | Infer_Tuvar v => case tcwalk s h' of Infer_Tvar_db c => (INL (insert v (Infer_Tvar_db c) s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | Infer_Tapp l n => if tcocwl s v [l] then (INR (NONE :infer_t sptree$num_map option) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) else (INL (insert v (Infer_Tapp l n) s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) | Infer_Tuvar v' => if v = v' then (INL (s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option) else (INL (insert v (Infer_Tuvar v') s,(t,t')::v2) :infer_t sptree$num_map # (infer_t list # infer_t list) list + infer_t sptree$num_map option))
tcunify_thm_typed=∀(s :infer_t sptree$num_map) (wl :(infer_t list # infer_t list) list). tcunify s wl = case wl of ([] :(infer_t list # infer_t list) list) => SOME s | (([] :infer_t list),([] :infer_t list))::v2 => tcunify s v2 | (([] :infer_t list),h::t)::v2 => (NONE :infer_t sptree$num_map option) | (h::t,([] :infer_t list))::v2 => (NONE :infer_t sptree$num_map option) | (h::t,h'::t')::v2 => case tcwalk s h of Infer_Tvar_db c => (case tcwalk s h' of Infer_Tvar_db c' => if c = c' then tcunify s ((t,t')::v2) else (NONE :infer_t sptree$num_map option) | Infer_Tapp l n => (NONE :infer_t sptree$num_map option) | Infer_Tuvar v => tcunify (insert v (Infer_Tvar_db c) s) ((t,t')::v2)) | Infer_Tapp l n => (case tcwalk s h' of Infer_Tvar_db c => (NONE :infer_t sptree$num_map option) | Infer_Tapp l' n' => if n = n' then tcunify s ((l,l')::(t,t')::v2) else (NONE :infer_t sptree$num_map option) | Infer_Tuvar v => if tcocwl s v [l] then (NONE :infer_t sptree$num_map option) else tcunify (insert v (Infer_Tapp l n) s) ((t,t')::v2)) | Infer_Tuvar v => case tcwalk s h' of Infer_Tvar_db c => tcunify (insert v (Infer_Tvar_db c) s) ((t,t')::v2) | Infer_Tapp l n => if tcocwl s v [l] then (NONE :infer_t sptree$num_map option) else tcunify (insert v (Infer_Tapp l n) s) ((t,t')::v2) | Infer_Tuvar v' => if v = v' then tcunify s ((t,t')::v2) else tcunify (insert v (Infer_Tuvar v') s) ((t,t')::v2)
sp2fm_def_typed=∀(sp :α sptree$num_map). sp2fm sp = FUN_FMAP (λ(k :num). THE (lookup k sp)) (domain sp :num -> bool)
FLOOKUP_sp2fm_typed=FLOOKUP (sp2fm (sp :α sptree$num_map)) (k :num) = lookup k sp
sp2fm_thm_typed=sp2fm (LN :α sptree$num_map) = (FEMPTY :num |-> α) ∧ sp2fm (insert (k :num) (v :β) (sp :β sptree$num_map)) = (sp2fm sp)⟨k ↦ v⟩
swfs_def_typed=∀(sp :α term sptree$num_map). swfs sp ⇔ wfs (sp2fm sp)
cwfs_def_typed=∀(s :infer_t sptree$num_map). cwfs s ⇔ swfs (map encode_infer_t s) ∧ wf s
cwfs_insert_tvar_db_typed=(v :num) ∉ (domain (s :infer_t sptree$num_map) :num -> bool) ∧ cwfs s ⇒ cwfs (insert v (Infer_Tvar_db (c :num)) s)
cwfs_var2_extend_typed=cwfs (s :infer_t sptree$num_map) ∧ (v1 :num) ≠ (v2 :num) ∧ v1 ∉ (domain s :num -> bool) ∧ v2 ∉ (domain s :num -> bool) ⇒ cwfs (insert v1 (Infer_Tuvar v2) s)
cvwalk_preserves_precond_typed=∀(x :num) (y :num). (λ(n :num). cwfs (s :infer_t sptree$num_map)) x ∧ cvwalk_code s x = (INL y :num + infer_t) ⇒ (λ(n :num). cwfs s) y
cvwalk_thm_typed=wf (map encode_infer_t (s :infer_t sptree$num_map)) ⇒ swfs (map encode_infer_t s) ⇒ cvwalk s (n :num) = case lookup n s of (NONE :infer_t option) => Infer_Tuvar n | SOME (Infer_Tvar_db v9) => Infer_Tvar_db v9 | SOME (Infer_Tapp l n) => Infer_Tapp l n | SOME (Infer_Tuvar u) => cvwalk s u
cwalk_thm_typed=cwfs (s :infer_t sptree$num_map) ⇒ cwalk s (it :infer_t) = case it of Infer_Tvar_db v8 => Infer_Tvar_db v8 | Infer_Tapp l n => Infer_Tapp l n | Infer_Tuvar v => cvwalk s v
sp2fm_map_typed=sp2fm (map (f :β -> α) (sp :β sptree$num_map)) = f o_f sp2fm sp
cvwalkR_def_typed=∀(σ :infer_t sptree$num_map). cvwalkR σ = (λ(v :num) (v0 :num). vR (encode_infer_t o_f sp2fm σ) v v0)
cvwalk_ensures_decrease_typed=∀(x :num) (y :num). (λ(n :num). cwfs (s :infer_t sptree$num_map)) x ∧ cvwalk_code s x = (INL y :num + infer_t) ⇒ cvwalkR s y x
WF_cvwalkR_typed=∀(x :α). (λ(n :α). cwfs (s :infer_t sptree$num_map)) x ⇒ WF (cvwalkR s)
