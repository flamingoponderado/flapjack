term_axiom_typed=∀(f0 :num -> β) (f1 :α term -> α term -> β -> β -> β) (f2 :α -> β). ∃(fn :α term -> β). (∀(a :num). fn (Var a :α term) = f0 a) ∧ (∀(a0 :α term) (a1 :α term). fn (Pair a0 a1) = f1 a0 a1 (fn a0) (fn a1)) ∧ ∀(a :α). fn (Const a) = f2 a
pair_count_def_typed=(∀(v :num). pair_count (Var v :α term) = (0 :num)) ∧ (∀(c :α). pair_count (Const c) = (0 :num)) ∧ ∀(t1 :α term) (t2 :α term). pair_count (Pair t1 t2) = (1 :num) + pair_count t1 + pair_count t2
vars_def_typed=(∀(x :num). vars (Var x :α term) = {x}) ∧ (∀(t1 :α term) (t2 :α term). vars (Pair t1 t2) = vars t1 ∪ vars t2) ∧ ∀(v0 :α). vars (Const v0) = (∅ :num -> bool)
atom_axiom_typed=∀(f0 :num -> α) (f1 :num -> α) (f2 :α) (f3 :α). ∃(fn :atom -> α). (∀(a :num). fn (TC_tag a) = f0 a) ∧ (∀(a :num). fn (DB_tag a) = f1 a) ∧ fn Tapp_tag = f2 ∧ fn Null_tag = f3
encode_infer_t_def_typed=(∀(n :num). encode_infer_t (Infer_Tvar_db n) = Const (DB_tag n)) ∧ (∀(ts :infer_t list) (tc :num). encode_infer_t (Infer_Tapp ts tc) = Pair (Const Tapp_tag) (Pair (Const (TC_tag tc)) (encode_infer_ts ts))) ∧ (∀(n :num). encode_infer_t (Infer_Tuvar n) = (Var n :atom term)) ∧ encode_infer_ts ([] :infer_t list) = Const Null_tag ∧ ∀(t :infer_t) (ts :infer_t list). encode_infer_ts (t::ts) = Pair (encode_infer_t t) (encode_infer_ts ts)
decode_infer_t_def_typed=(∀(n :num). decode_infer_t (Var n :atom term) = Infer_Tuvar n) ∧ (∀(n :num). decode_infer_t (Const (DB_tag n)) = Infer_Tvar_db n) ∧ (∀(tc :num) (s :atom term). decode_infer_t (Pair (Const Tapp_tag) (Pair (Const (TC_tag tc)) s)) = Infer_Tapp (decode_infer_ts s) tc) ∧ (∀(v5 :atom term) (v11 :num). decode_infer_t (Pair (Var v11 :atom term) v5) = Infer_Tuvar (5 :num)) ∧ (∀(v5 :atom term) (v13 :atom term) (v12 :atom term). decode_infer_t (Pair (Pair v12 v13) v5) = Infer_Tuvar (5 :num)) ∧ (∀(v5 :atom term) (v19 :num). decode_infer_t (Pair (Const (TC_tag v19)) v5) = Infer_Tuvar (5 :num)) ∧ (∀(v5 :atom term) (v20 :num). decode_infer_t (Pair (Const (DB_tag v20)) v5) = Infer_Tuvar (5 :num)) ∧ (∀(v23 :num). decode_infer_t (Pair (Const Tapp_tag) (Var v23 :atom term)) = Infer_Tuvar (5 :num)) ∧ (∀(v31 :num) (v25 :atom term). decode_infer_t (Pair (Const Tapp_tag) (Pair (Var v31 :atom term) v25)) = Infer_Tuvar (5 :num)) ∧ (∀(v33 :atom term) (v32 :atom term) (v25 :atom term). decode_infer_t (Pair (Const Tapp_tag) (Pair (Pair v32 v33) v25)) = Infer_Tuvar (5 :num)) ∧ (∀(v40 :num) (v25 :atom term). decode_infer_t (Pair (Const Tapp_tag) (Pair (Const (DB_tag v40)) v25)) = Infer_Tuvar (5 :num)) ∧ (∀(v25 :atom term). decode_infer_t (Pair (Const Tapp_tag) (Pair (Const Tapp_tag) v25)) = Infer_Tuvar (5 :num)) ∧ (∀(v25 :atom term). decode_infer_t (Pair (Const Tapp_tag) (Pair (Const Null_tag) v25)) = Infer_Tuvar (5 :num)) ∧ (∀(v26 :atom). decode_infer_t (Pair (Const Tapp_tag) (Const v26)) = Infer_Tuvar (5 :num)) ∧ (∀(v5 :atom term). decode_infer_t (Pair (Const Null_tag) v5) = Infer_Tuvar (5 :num)) ∧ (∀(v43 :num). decode_infer_t (Const (TC_tag v43)) = Infer_Tuvar (5 :num)) ∧ decode_infer_t (Const Tapp_tag) = Infer_Tuvar (5 :num) ∧ decode_infer_t (Const Null_tag) = Infer_Tuvar (5 :num) ∧ decode_infer_ts (Const Null_tag) = ([] :infer_t list) ∧ (∀(s2 :atom term) (s1 :atom term). decode_infer_ts (Pair s1 s2) = decode_infer_t s1::decode_infer_ts s2) ∧ (∀(v47 :num). decode_infer_ts (Var v47 :atom term) = ([] :infer_t list)) ∧ (∀(v55 :num). decode_infer_ts (Const (TC_tag v55)) = ([] :infer_t list)) ∧ (∀(v56 :num). decode_infer_ts (Const (DB_tag v56)) = ([] :infer_t list)) ∧ decode_infer_ts (Const Tapp_tag) = ([] :infer_t list)
encode_infer_t_11_typed=(∀(it1 :infer_t) (it2 :infer_t). encode_infer_t it1 = encode_infer_t it2 ⇔ it1 = it2) ∧ ∀(its1 :infer_t list) (its2 :infer_t list). encode_infer_ts its1 = encode_infer_ts its2 ⇔ its1 = its2
decode_left_inverse_typed=(∀(t :infer_t). decode_infer_t (encode_infer_t t) = t) ∧ ∀(ts :infer_t list). decode_infer_ts (encode_infer_ts ts) = ts
decode_left_inverse_I_typed=decode_infer_t ∘ encode_infer_t = (I :infer_t -> infer_t)
encode_eq_var_typed=((Var (n :num) :atom term) = encode_infer_t (i :infer_t) ⇔ i = Infer_Tuvar n) ∧ (encode_infer_t i = (Var n :atom term) ⇔ i = Infer_Tuvar n)
vR_def_typed=∀(s :α |-> β term) (y :num) (x :α). vR s y x ⇔ case FLOOKUP s x of (NONE :β term option) => F | SOME t => y ∈ vars t
wfs_def_typed=∀(s :α subst). wfs s ⇔ WF (vR s)
wfs_SUBMAP_typed=wfs (sx :α subst) ∧ (s :α subst) ⊑ sx ⇒ wfs s
vwalk_def_typed=wfs (s :α subst) ⇒ ∀(v :num). vwalk s v = case FLOOKUP s v of (NONE :α term option) => (Var v :α term) | SOME (Var u :α term) => vwalk s u | SOME (Pair v7 v8) => Pair v7 v8 | SOME (Const v9) => Const v9
NOT_FDOM_vwalk_typed=wfs (s :α subst) ∧ (v :num) ∉ FDOM s ⇒ vwalk s v = (Var v :α term)
vwalk_to_var_typed=wfs (s :α subst) ⇒ ∀(v :num) (u :num). vwalk s v = (Var u :α term) ⇒ u ∉ FDOM s
vwalk_vR_typed=wfs (s :α subst) ⇒ ∀(v :num) (u :num). u ∈ vars (vwalk s v) ∧ vwalk s v ≠ (Var v :α term) ⇒ (vR s)⁺ u v
walkstar_def_typed=wfs (s :α subst) ⇒ ∀(t :α term). s ◁ t = case walk s t of (Var v4 :α term) => (Var v4 :α term) | Pair t1 t2 => Pair (s ◁ t1) (s ◁ t2) | Const v7 => Const v7
t_vars_def_typed=∀(t :infer_t). t_vars t = vars (encode_infer_t t)
t_wfs_def_typed=∀(s :num |-> infer_t). t_wfs s ⇔ wfs (encode_infer_t o_f s)
t_vR_def_typed=∀(s :α |-> infer_t). t_vR s = vR (encode_infer_t o_f s)
t_vR_eqn_typed=∀(s :α |-> infer_t) (x :α) (y :num). t_vR s y x ⇔ case FLOOKUP s x of (NONE :infer_t option) => F | SOME t => y ∈ t_vars t
t_wfs_eqn_typed=∀(s :num |-> infer_t). t_wfs s ⇔ WF (t_vR s)
t_wfs_SUBMAP_typed=∀(s1 :num |-> infer_t) (s2 :num |-> infer_t). t_wfs s2 ∧ s1 ⊑ s2 ⇒ t_wfs s1
t_vwalk_eqn_typed=∀(s :num |-> infer_t). t_wfs s ⇒ ∀(v :num). t_vwalk s v = case FLOOKUP s v of (NONE :infer_t option) => Infer_Tuvar v | SOME (Infer_Tvar_db n) => Infer_Tvar_db n | SOME (Infer_Tapp ts tc) => Infer_Tapp ts tc | SOME (Infer_Tuvar u) => t_vwalk s u
encode_vwalk_replay_typed=∀(s :num |-> infer_t). t_wfs s ⇒ ∀(u :num). vwalk (encode_infer_t o_f s) u = encode_infer_t (t_vwalk s u)
t_walk_def_typed=∀(s :num |-> infer_t) (t :infer_t). t_walk s t = decode_infer_t (walk (encode_infer_t o_f s) (encode_infer_t t))
t_walk_eqn_typed=(∀(s :num |-> infer_t) (v :num). t_walk s (Infer_Tuvar v) = t_vwalk s v) ∧ (∀(s :num |-> infer_t) (ts :infer_t list) (tc :num). t_walk s (Infer_Tapp ts tc) = Infer_Tapp ts tc) ∧ ∀(s :num |-> infer_t) (n :num). t_walk s (Infer_Tvar_db n) = Infer_Tvar_db n
t_walkstar_eqn_typed=∀(s :num |-> infer_t). t_wfs s ⇒ ∀(t :infer_t). t_walkstar s t = case t_walk s t of Infer_Tvar_db n => Infer_Tvar_db n | Infer_Tapp ts tctor => Infer_Tapp (MAP (t_walkstar s) ts) tctor | Infer_Tuvar v => Infer_Tuvar v
encode_walk_replay_typed=∀(s :num |-> infer_t). t_wfs s ⇒ ∀(t :infer_t). walk (encode_infer_t o_f s) (encode_infer_t t) = encode_infer_t (t_walk s t)
ts_walkstar_replay_typed=∀(l :infer_t list) (s :num |-> infer_t). t_wfs s ⇒ decode_infer_ts (encode_infer_t o_f s ◁ encode_infer_ts l) = MAP (t_walkstar s) l
wfs_FEMPTY_typed=wfs (FEMPTY :α subst)
walkstar_FEMPTY_typed=∀(t :α term). (FEMPTY :α subst) ◁ t = t
t_walkstar_FEMPTY_typed=∀(t :infer_t). t_walkstar (FEMPTY :num |-> infer_t) t = t
t_vars_eqn_typed=(∀(x :num). t_vars (Infer_Tvar_db x) = (∅ :num -> bool)) ∧ (∀(ts :infer_t list) (tc :num). t_vars (Infer_Tapp ts tc) = BIGUNION (set (MAP t_vars ts))) ∧ ∀(u :num). t_vars (Infer_Tuvar u) = {u}
t_vwalk_to_var_typed=t_wfs (s :num |-> infer_t) ⇒ ∀(v :num) (u :num). t_vwalk s v = Infer_Tuvar u ⇒ u ∉ FDOM s
