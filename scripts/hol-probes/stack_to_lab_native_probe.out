native_flatten_definition=∀t p n m conts breaks. flatten t p n m conts breaks = case p of Skip => (List [],F,m) | Inst a => (List [Asm (Asmi (Inst a)) [] 0],F,m) | Get v70 v71 => (List [],F,m) | Set v72 v73 => (List [],F,m) | OpCurrHeap v74 v75 v76 => (List [],F,m) | Call NONE dest handler => (List [compile_jump dest],T,m) | Call (SOME (p1'³',lr,l1,l2)) dest handler => (let (xs,nr1,m') = flatten F p1'³' n m conts breaks; prefix = Append (List [LabAsm (LocValue lr (Lab l1 l2)) 0w [] 0; compile_jump dest; Label l1 l2 0]) xs in case handler of NONE => (prefix,nr1,m') | SOME (p2,k1,k2) => (let (ys,nr2,m'') = flatten F p2 n m' conts breaks in (Append prefix (Append (Append (List [LabAsm (Jump (Lab n m'')) 0w [] 0; Label k1 k2 0]) ys) (List [Label n m'' 0])),nr1 ∧ nr2,m'' + 1))) | Seq p1 p2 => (let (xs,nr1,m') = flatten F p1 n m conts breaks; (ys,nr2,m'') = flatten F p2 n m' conts breaks in if t then (Append (Append xs (List [Label n 1 0])) ys,nr1 ∨ nr2,m'') else (Append xs ys,nr1 ∨ nr2,m'')) | If c r ri p1' p2' => (let (xs,nr1,m') = flatten F p1' n m conts breaks; (ys,nr2,m'') = flatten F p2' n m' conts breaks in if p1' = Skip ∧ p2' = Skip then (List [],F,m'') else if p1' = Skip then (Append (Append (List [LabAsm (JumpCmp c r ri (Lab n m'')) 0w [] 0]) ys) (List [Label n m'' 0]),F,m'' + 1) else if p2' = Skip then (Append (Append (List [LabAsm (JumpCmp (negate c) r ri (Lab n m'')) 0w [] 0]) xs) (List [Label n m'' 0]),F,m'' + 1) else if nr1 then (Append (Append (Append (List [LabAsm (JumpCmp (negate c) r ri (Lab n m'')) 0w [] 0]) xs) (List [Label n m'' 0])) ys,nr2,m'' + 1) else if nr2 then (Append (Append (Append (List [LabAsm (JumpCmp c r ri (Lab n m'')) 0w [] 0]) ys) (List [Label n m'' 0])) xs,nr1,m'' + 1) else (Append (Append (Append (Append (List [LabAsm (JumpCmp c r ri (Lab n m'')) 0w [] 0]) ys) (List [LabAsm (Jump (Lab n (m'' + 1))) 0w [] 0; Label n m'' 0])) xs) (List [Label n (m'' + 1) 0]),nr1 ∧ nr2,m'' + 2)) | Loop p1'' => (let cont_lab = m; break_lab = m + 1; (xs,_0,m') = flatten F p1'' n (m + 2) (cont_lab::conts) (break_lab::breaks) in (Append (Append (List [Label n cont_lab 0]) xs) (List [LabAsm (Jump (Lab n cont_lab)) 0w [] 0; Label n break_lab 0]),F,m')) | JumpLower r1 r2 target => (List [LabAsm (JumpCmp Lower r1 (Reg r2) (Lab target 0)) 0w [] 0],F,m) | Alloc v91 => (List [],F,m) | StoreConsts v92 v93 v94 => (List [],F,m) | Raise r' => (List [Asm (Asmi (JumpReg r')) [] 0],T,m) | Return r'' => (List [Asm (Asmi (JumpReg r'')) [] 0],T,m) | Break k => (List [LabAsm (Jump (Lab n (find_lab k breaks))) 0w [] 0],T,m) | Continue k' => (List [LabAsm (Jump (Lab n (find_lab k' conts))) 0w [] 0],T,m) | FFI ffi_index v100 v101 v102 v103 lr' => (List [LabAsm (LocValue lr' (Lab n m)) 0w [] 0; LabAsm (CallFFI ffi_index) 0w [] 0; Label n m 0],F,m + 1) | Tick => (List [Asm (Asmi (Inst Skip)) [] 0],F,m) | LocValue i l1' l2' => (List [LabAsm (LocValue i (Lab l1' l2')) 0w [] 0],F,m) | Install v108 v109 v110 v111 ret => (List [LabAsm (LocValue ret (Lab n m)) 0w [] 0; LabAsm Install 0w [] 0; Label n m 0],F,m + 1) | ShMemOp op r'³' ad => (List [Asm (ShareMem op r'³' ad) [] 0],F,m) | CodeBufferWrite r1' r2' => (List [Asm (Cbw r1' r2') [] 0],F,m) | DataBufferWrite v118 v119 => (List [],F,m) | RawCall v120 => (List [LabAsm (Jump (Lab v120 1)) 0w [] 0],T,m) | StackAlloc v121 => (List [],F,m) | StackFree v122 => (List [],F,m) | StackStore v123 v124 => (List [],F,m) | StackStoreAny v125 v126 => (List [],F,m) | StackLoad v127 v128 => (List [],F,m) | StackLoadAny v129 v130 => (List [],F,m) | StackGetSize v131 => (List [],F,m) | StackSetSize v132 => (List [],F,m) | BitmapLoad v133 v134 => (List [],F,m) | Halt v135 => (List [LabAsm Halt 0w [] 0],T,m)
native_seq_tail_tree=(Append (Append (List [Asm (Asmi (Inst Skip)) [] 0]) (List [Label 7 1 0])) (List []),F,2)
native_if_left_skip_tree=(Append (Append (List [LabAsm (JumpCmp Less 3 (Reg 4) (Lab 7 2)) 0w [] 0]) (List [Asm (Asmi (Inst Skip)) [] 0])) (List [Label 7 2 0]),F,3)
native_if_right_skip_tree=(Append (Append (List [LabAsm (JumpCmp NotLess 3 (Reg 4) (Lab 7 2)) 0w [] 0]) (List [Asm (Asmi (Inst Skip)) [] 0])) (List [Label 7 2 0]),F,3)
native_if_left_noreturn_tree=(Append (Append (Append (List [LabAsm (JumpCmp NotLess 3 (Reg 4) (Lab 7 2)) 0w [] 0]) (List [LabAsm Halt 0w [] 0])) (List [Label 7 2 0])) (List [Asm (Asmi (Inst Skip)) [] 0]),F,3)
native_if_right_noreturn_tree=(Append (Append (Append (List [LabAsm (JumpCmp Less 3 (Reg 4) (Lab 7 2)) 0w [] 0]) (List [LabAsm Halt 0w [] 0])) (List [Label 7 2 0])) (List [Asm (Asmi (Inst Skip)) [] 0]),F,3)
native_if_fallthrough_tree=(Append (Append (Append (Append (List [LabAsm (JumpCmp Less 3 (Reg 4) (Lab 7 2)) 0w [] 0]) (List [Asm (Asmi (Inst Skip)) [] 0])) (List [LabAsm (Jump (Lab 7 3)) 0w [] 0; Label 7 2 0])) (List [Asm (Asmi (Inst Skip)) [] 0])) (List [Label 7 3 0]),F,4)
native_loop_tree=(Append (Append (List [Label 7 2 0]) (List [LabAsm (Jump (Lab 7 3)) 0w [] 0])) (List [LabAsm (Jump (Lab 7 2)) 0w [] 0; Label 7 3 0]),F,4)
native_call_handler_tree=(Append (Append (List [LabAsm (LocValue 3 (Lab 8 9)) 0w [] 0; LabAsm (Jump (Lab 4 0)) 0w [] 0; Label 8 9 0]) (List [Asm (Asmi (Inst Skip)) [] 0])) (Append (Append (List [LabAsm (Jump (Lab 7 2)) 0w [] 0; Label 10 11 0]) (List [Asm (Asmi (Inst Skip)) [] 0])) (List [Label 7 2 0])),F,3)
native_section_seq=Section 7 [Asm (Asmi (Inst Skip)) [] 0; Label 7 1 0; Label 7 2 0]
native_tick=(List [Asm (Asmi (Inst Skip)) [] 0],F,2)
native_inst=(List [Asm (Asmi (Inst Skip)) [] 0],F,2)
native_halt=(List [LabAsm Halt 0w [] 0],T,2)
native_raise=(List [Asm (Asmi (JumpReg 999)) [] 0],T,2)
native_return=(List [Asm (Asmi (JumpReg 999)) [] 0],T,2)
native_break_missing=(List [LabAsm (Jump (Lab 7 0)) 0w [] 0],T,2)
native_continue_missing=(List [LabAsm (Jump (Lab 7 0)) 0w [] 0],T,2)
native_rawcall=(List [LabAsm (Jump (Lab 999 1)) 0w [] 0],T,2)
native_tailcall_label=(List [LabAsm (Jump (Lab 999 0)) 0w [] 0],T,2)
native_tailcall_register=(List [Asm (Asmi (JumpReg 999)) [] 0],T,2)
native_lower=(List [LabAsm (JumpCmp Lower 3 (Reg 4) (Lab 999 0)) 0w [] 0],F,2)
native_location=(List [LabAsm (LocValue 3 (Lab 999 1000)) 0w [] 0],F,2)
native_install=(List [LabAsm (LocValue 5 (Lab 7 2)) 0w [] 0; LabAsm Install 0w [] 0; Label 7 2 0],F,3)
native_shared=(List [Asm (ShareMem Load 3 (Addr 4 0w)) [] 0],F,2)
native_buffer=(List [Asm (Cbw 3 4) [] 0],F,2)
native_fallback=(List [],F,2)
native_width1=(List [Asm (Asmi (Inst (Const 999 1w))) [] 0],F,2)
native_width80=(List [Asm (Asmi (Inst (Const 999 0xFFFFFFFFFFFFFFFFFFFFw))) [] 0],F,2)
native_ffi=(List [LabAsm (LocValue 5 (Lab 7 2)) 0w [] 0; LabAsm (CallFFI «ffi») 0w [] 0; Label 7 2 0],F,3)
native_fallback_01=(List [],F,2)
native_fallback_02=(List [],F,2)
native_fallback_03=(List [],F,2)
native_fallback_04=(List [],F,2)
native_fallback_05=(List [],F,2)
native_fallback_06=(List [],F,2)
native_fallback_07=(List [],F,2)
native_fallback_08=(List [],F,2)
native_fallback_09=(List [],F,2)
native_fallback_10=(List [],F,2)
native_fallback_11=(List [],F,2)
native_fallback_12=(List [],F,2)
native_fallback_13=(List [],F,2)
native_fallback_14=(List [],F,2)
native_fallback_15=(List [],F,2)
native_if_both_skip=(List [],F,2)
native_call_return_only=(Append (List [LabAsm (LocValue 3 (Lab 8 9)) 0w [] 0; Asm (Asmi (JumpReg 4)) [] 0; Label 8 9 0]) (List [Asm (Asmi (Inst Skip)) [] 0]),F,2)
