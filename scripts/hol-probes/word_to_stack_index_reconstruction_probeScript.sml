load "preamble"; load "word_to_stackProofTheory";
open HolKernel Parse bossLib preamble word_to_stackProofTheory listTheory rich_listTheory arithmeticTheory miscTheory alistTheory;
val _ = Globals.linewidth := 6000;
val _ = temp_delsimps ["NORMEQ_CONV"];
val _ = diminish_srw_ss ["ABBREV"];
val index_list_eq_ZIP = prove(``   index_list xs k = ZIP(REVERSE(MAP($+ k)(COUNT_LIST (LENGTH xs))),xs)``,   metis_tac[MAP_FST_index_list,MAP_SND_index_list,ZIP_MAP_FST_SND_EQ]);
val _ = (if null(hyp index_list_eq_ZIP) then () else raise Fail "open premise"; print "ir_full_index_list_eq_ZIP="; print_thm index_list_eq_ZIP; print "\n");
val MEM_index_list_LIM = prove(``  ∀ls n v k.
  MEM (n,v) (index_list ls k) ⇒
  n-k < LENGTH ls``,   Induct>>fs[index_list_def]>>rw[]
  >-
    DECIDE_TAC
  >>
  res_tac>>
  DECIDE_TAC);
val _ = (if null(hyp MEM_index_list_LIM) then () else raise Fail "open premise"; print "ir_full_MEM_index_list_LIM="; print_thm MEM_index_list_LIM; print "\n");
val MEM_index_list_EL = prove(``  ∀ls n v.
  MEM (n,v) (index_list ls k) ⇒
  EL (LENGTH ls - (n-k+1)) ls = v``,   Induct>>fs[index_list_def,FORALL_PROD]>>rw[]>>
  simp[ADD1]>>
  res_tac>>
  fs[]>>
  imp_res_tac MEM_index_list_LIM>>
  `LENGTH ls +1 - (n-k+1) = SUC(LENGTH ls - (n-k+1))` by DECIDE_TAC>>
  pop_assum SUBST_ALL_TAC>>
  simp[]);
val _ = (if null(hyp MEM_index_list_EL) then () else raise Fail "open premise"; print "ir_full_MEM_index_list_EL="; print_thm MEM_index_list_EL; print "\n");
val ALOOKUP_index_list = prove(``  ∀ls n.
  n < LENGTH ls + k ⇒
  ALOOKUP (index_list ls k) n =
  LLOOKUP ls ((LENGTH ls + k) - (n+1))``,   Induct>>rw[index_list_def,LLOOKUP_def]>>
  gvs[ADD1]);
val _ = (if null(hyp ALOOKUP_index_list) then () else raise Fail "open premise"; print "ir_full_ALOOKUP_index_list="; print_thm ALOOKUP_index_list; print "\n");
fun emit label q = let val th = EVAL q in print(label ^ "="); print_thm th; print "\n" end;
