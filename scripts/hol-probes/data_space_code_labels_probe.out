get_code_labels_compile=⊢ ∀x. get_code_labels (compile x) = get_code_labels x
compile_type=:dataLang$prog -> dataLang$prog
get_code_labels_space_typed=∀(x :dataLang$prog) (y :dataLang$prog) (y0 :num) (y1 :sptree$num_set) (y2 :dataLang$prog). (space x = (INL y :dataLang$prog + num # sptree$num_set # dataLang$prog) ⇒ get_code_labels y = get_code_labels x) ∧ (space x = (INR (y0,y1,y2) :dataLang$prog + num # sptree$num_set # dataLang$prog) ⇒ get_code_labels y2 = get_code_labels x)
get_vars_IMP_LENGTH_typed=∀(xs :num list) (s :α sptree$num_map) (l :α list). get_vars xs s = SOME l ⇒ LENGTH l = LENGTH xs
do_stack_with_space_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (z :num). do_stack op vs (s with space := z) = do_stack op vs s with space := z
do_stack_with_locals_typed=∀(op :closLang$op) (vs :v list) (s :(α, β) dataSem$state) (l :v sptree$num_map). do_stack op vs (s with locals := l) = do_stack op vs s with locals := l
locals_ok_def_typed=∀(l1 :α sptree$num_map) (l2 :α sptree$num_map). locals_ok l1 l2 ⇔ ∀(v :num) (x :α). (lookup v l1 :α option) = SOME x ⇒ (lookup v l2 :α option) = SOME x
locals_ok_get_vars_typed=∀(x :num list) (w :α list). locals_ok (s :α sptree$num_map) (l :α sptree$num_map) ∧ get_vars x s = SOME w ⇒ get_vars x l = SOME w
locals_ok_cut_env_typed=locals_ok (l1 :α sptree$num_map) (l2 :α sptree$num_map) ∧ cut_env (names :sptree$num_set) l1 = SOME (x :α sptree$num_map) ⇒ cut_env names l2 = SOME x
locals_ok_refl_typed=∀(l :α sptree$num_map). locals_ok l l
evaluate_locals_typed=∀(c :dataLang$prog) (s :(α, β) dataSem$state) (res :(v list, v) result option) (s2 :(α, β) dataSem$state) (vars :γ) (l :v sptree$num_map). res ≠ SOME (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ∧ (evaluate (c,s) :(v list, v) result option # (α, β) dataSem$state) = (res,s2) ∧ locals_ok s.locals l ⇒ ∃(w :v sptree$num_map) (safe :bool) (peak :num) (sm :num option). (evaluate (c,s with locals := l) :(v list, v) result option # (α, β) dataSem$state) = (res,if res = (NONE :(v list, v) result option) then s2 with <|locals := w; safe_for_space := safe; stack_max := sm; peak_heap_length := peak|> else s2 with <|safe_for_space := safe; stack_max := sm; peak_heap_length := peak|>) ∧ locals_ok s2.locals w
