cl_full_get_vars_eq=⊢ ∀ls z. get_vars ls st = SOME z ⇒ (let lookups = MAP (λx. lookup x st.locals) ls in EVERY IS_SOME lookups ∧ z = MAP THE lookups)
cl_full_get_vars_fromList2_eq=⊢ get_vars (GENLIST (λx. 2 * x) (LENGTH args)) s = SOME x ∧ lookup n (fromList2 x) = SOME y ⇒ lookup n s.locals = SOME y
cl_full_get_vars_fromList2_eq_cons=⊢ get_vars (GENLIST (λx. 2 * (x + 1)) (LENGTH args)) s = SOME x ∧ lookup n (fromList2 (Loc x3 x4::x)) = SOME y ∧ n ≠ 0 ⇒ lookup n s.locals = SOME y
cl_full_lookup_fromList2_prefix=⊢ ∀x z y. x ≼ z ∧ lookup n (fromList2 x) = SOME y ⇒ lookup n (fromList2 z) = SOME y
