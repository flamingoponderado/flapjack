csr_instruction_definition_CSRRW=∀rd rs1 csr. dfn'CSRRW (rd,rs1,csr) = (λstate. (let (v,s) = checkCSROp (csr,rs1,Write) state in if v then (let (v,s) = CSR csr s in write'GPR (v,rd) (writeCSR (csr,GPR rs1 s) s)) else signalException Illegal_Instr s))
csr_instruction_definition_CSRRS=∀rd rs1 csr. dfn'CSRRS (rd,rs1,csr) = (λstate. (let (v,s) = checkCSROp (csr,rs1,if rs1 = 0w then Read else Write) state in if v then (let (v,s) = CSR csr s in write'GPR (v,rd) (if rs1 ≠ 0w then writeCSR (csr,v ‖ GPR rs1 s) s else s)) else signalException Illegal_Instr s))
csr_instruction_definition_CSRRC=∀rd rs1 csr. dfn'CSRRC (rd,rs1,csr) = (λstate. (let (v,s) = checkCSROp (csr,rs1,if rs1 = 0w then Read else Write) state in if v then (let (v,s) = CSR csr s in write'GPR (v,rd) (if rs1 ≠ 0w then writeCSR (csr,v && ¬GPR rs1 s) s else s)) else signalException Illegal_Instr s))
csr_instruction_definition_CSRRWI=∀rd zimm csr. dfn'CSRRWI (rd,zimm,csr) = (λstate. (let (v,s) = checkCSROp (csr,zimm,if zimm = 0w then Read else Write) state in if v then (let (v,s) = CSR csr s in write'GPR (v,rd) (if zimm ≠ 0w then writeCSR (csr,w2w zimm) s else s)) else signalException Illegal_Instr s))
csr_instruction_definition_CSRRSI=∀rd zimm csr. dfn'CSRRSI (rd,zimm,csr) = (λstate. (let (v,s) = checkCSROp (csr,zimm,if zimm = 0w then Read else Write) state in if v then (let (v,s) = CSR csr s in write'GPR (v,rd) (if zimm ≠ 0w then writeCSR (csr,v ‖ w2w zimm) s else s)) else signalException Illegal_Instr s))
csr_instruction_definition_CSRRCI=∀rd zimm csr. dfn'CSRRCI (rd,zimm,csr) = (λstate. (let (v,s) = checkCSROp (csr,zimm,if zimm = 0w then Read else Write) state in if v then (let (v,s) = CSR csr s in write'GPR (v,rd) (if zimm ≠ 0w then writeCSR (csr,v && ¬w2w zimm) s else s)) else signalException Illegal_Instr s))
