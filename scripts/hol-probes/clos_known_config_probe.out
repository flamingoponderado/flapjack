val_approx_case_def=(∀(a0 :num) (a1 :num) (f :num -> num -> α)
     (f1 :num -> num -> exp -> num -> α) (f2 :num -> val_approx list -> α)
     (f3 :int -> α) (v :α) (v1 :α).
   (val_approx_CASE (ClosNoInline a0 a1) f f1 f2 f3 v v1 :α) = f a0 a1) ∧
(∀(a0 :num) (a1 :num) (a2 :exp) (a3 :num) (f :num -> num -> α)
     (f1 :num -> num -> exp -> num -> α) (f2 :num -> val_approx list -> α)
     (f3 :int -> α) (v :α) (v1 :α).
   (val_approx_CASE (Clos a0 a1 a2 a3) f f1 f2 f3 v v1 :α) = f1 a0 a1 a2 a3) ∧
(∀(a0 :num) (a1 :val_approx list) (f :num -> num -> α)
     (f1 :num -> num -> exp -> num -> α) (f2 :num -> val_approx list -> α)
     (f3 :int -> α) (v :α) (v1 :α).
   (val_approx_CASE (Tuple a0 a1) f f1 f2 f3 v v1 :α) = f2 a0 a1) ∧
(∀(a :int) (f :num -> num -> α) (f1 :num -> num -> exp -> num -> α)
     (f2 :num -> val_approx list -> α) (f3 :int -> α) (v :α) (v1 :α).
   (val_approx_CASE (Int a :val_approx) f f1 f2 f3 v v1 :α) = f3 a) ∧
(∀(f :num -> num -> α) (f1 :num -> num -> exp -> num -> α)
     (f2 :num -> val_approx list -> α) (f3 :int -> α) (v :α) (v1 :α).
   (val_approx_CASE Other f f1 f2 f3 v v1 :α) = v) ∧
∀(f :num -> num -> α) (f1 :num -> num -> exp -> num -> α)
    (f2 :num -> val_approx list -> α) (f3 :int -> α) (v :α) (v1 :α).
  (val_approx_CASE Impossible f f1 f2 f3 v v1 :α) = v1
val_approx_nchotomy=∀(vv :val_approx).
  (∃(n :num) (n0 :num). vv = ClosNoInline n n0) ∨
  (∃(n :num) (n0 :num) (e :exp) (n1 :num). vv = Clos n n0 e n1) ∨
  (∃(n :num) (l :val_approx list). vv = Tuple n l) ∨
  (∃(i :int). vv = (Int i :val_approx)) ∨ vv = Other ∨ vv = Impossible
inliningDecision_case_def=(∀(v :α) (f :num -> α) (f1 :exp -> α).
   (inliningDecision_CASE inlD_Nothing v f f1 :α) = v) ∧
(∀(a :num) (v :α) (f :num -> α) (f1 :exp -> α).
   (inliningDecision_CASE (inlD_Annotate a) v f f1 :α) = f a) ∧
∀(a :exp) (v :α) (f :num -> α) (f1 :exp -> α).
  (inliningDecision_CASE (inlD_LetInline a) v f f1 :α) = f1 a
inliningDecision_nchotomy=∀(ii :inliningDecision).
  ii = inlD_Nothing ∨ (∃(n :num). ii = inlD_Annotate n) ∨
  ∃(e :exp). ii = inlD_LetInline e
config_component_equality=∀(c1 :config) (c2 :config).
  c1 = c2 ⇔
  c1.inline_max_body_size = c2.inline_max_body_size ∧
  c1.inline_factor = c2.inline_factor ∧
  c1.initial_inline_factor = c2.initial_inline_factor ∧
  c1.val_approx_spt = c2.val_approx_spt
default_inline_factor_def=default_inline_factor = (8 :num)
default_max_body_size_def=∀(max_app :num) (inline_factor :num).
  default_max_body_size max_app inline_factor =
  (max_app + (1 :num)) * inline_factor
mk_config_def=∀(max_body_size :num) (inline_factor :num).
  mk_config max_body_size inline_factor =
  <|inline_max_body_size := max_body_size; inline_factor := inline_factor;
    initial_inline_factor := inline_factor;
    val_approx_spt := (LN :val_approx sptree$num_map)|>
default_config_def=∀(max_app :num).
  default_config max_app =
  mk_config (default_max_body_size max_app default_inline_factor)
    default_inline_factor
dec_inline_factor_def=∀(c :config).
  dec_inline_factor c = c with inline_factor := c.inline_factor DIV (2 :num)
reset_inline_factor_def=∀(c :config).
  reset_inline_factor c = c with inline_factor := c.initial_inline_factor
inline_max_body_size_type=:config -> num
inline_factor_type=:config -> num
initial_inline_factor_type=:config -> num
val_approx_spt_type=:config -> val_approx sptree$num_map
