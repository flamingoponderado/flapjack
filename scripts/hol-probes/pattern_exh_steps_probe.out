exh_steps=exh_steps ([] :pat list list) = (1 :num) ∧ (∀(rows :pat list list) (r :pat list). exh_steps (r::rows) = if NULL r then (1 :num) else case col_ctors (r::rows) of (NONE :ctor list option) => (1 :num) + exh_steps (default_mat (r::rows)) | SOME cs => (1 :num) + exh_steps_list (spec_mats cs (r::rows))) ∧ exh_steps_list ([] :pat list list list) = (0 :num) ∧ ∀(ms :pat list list list) (m :pat list list). exh_steps_list (m::ms) = exh_steps m + exh_steps_list ms
exh_steps_examples=[(1 :num); (1 :num); (2 :num); (3 :num); (3 :num)]
pand=(∀(y :pmatchResult). pand PMatchSuccess y = y) ∧ (∀(y :pmatchResult). pand PMatchFailure y = if y = PTypeFailure then PTypeFailure else PMatchFailure) ∧ ∀(y :pmatchResult). pand PTypeFailure y = PTypeFailure
pmatch_result_type=:pmatchResult
pmatch_result_cases=∀(a :pmatchResult). a = PMatchSuccess ∨ a = PMatchFailure ∨ a = PTypeFailure
pmatch_result_distinct=PMatchSuccess ≠ PMatchFailure ∧ PMatchSuccess ≠ PTypeFailure ∧ PMatchFailure ≠ PTypeFailure
pand_simps=∀(x :pmatchResult) (y :pmatchResult). pand PMatchSuccess y = y ∧ pand x PMatchSuccess = x ∧ pand PTypeFailure y = PTypeFailure ∧ pand x PTypeFailure = PTypeFailure
pand_type=∀(x :pmatchResult) (y :pmatchResult). pand x y = PTypeFailure ⇔ x = PTypeFailure ∨ y = PTypeFailure
pand_success=∀(x :pmatchResult) (y :pmatchResult). pand x y = PMatchSuccess ⇔ x = PMatchSuccess ∧ y = PMatchSuccess
pand_assoc=∀(x :pmatchResult) (y :pmatchResult) (z :pmatchResult). pand (pand x y) z = pand x (pand y z)
exh_rows_eq=exh_rows (rows :(pat # α) list) ⇔ exh_all [or_rows rows]
exh_mats_append=∀(xs :pat list list list) (ys :pat list list list). exh_mats (xs ++ ys) ⇔ exh_mats xs ∧ exh_mats ys
exh_all_thm=∀(ms :pat list list list). exh_all ms ⇔ exh_mats ms
exh_steps_list_append=∀(xs :pat list list list) (ys :pat list list list). exh_steps_list (xs ++ ys) = exh_steps_list xs + exh_steps_list ys
exh_all=(exh_all ([] :pat list list list) ⇔ T) ∧ (∀(ms :pat list list list). exh_all (([] :pat list list)::ms) ⇔ F) ∧ ∀(rows :pat list list) (r :pat list) (ms :pat list list list). exh_all ((r::rows)::ms) ⇔ if NULL r then exh_all ms else case col_ctors (r::rows) of (NONE :ctor list option) => exh_all (default_mat (r::rows)::ms) | SOME cs => exh_all (spec_mats cs (r::rows) ++ ms)
exh_all_examples=[T; F; T; T; T]
term_constructor_type=:num option -> term list -> term
litv_constructor_type=:lit -> term
term_cases=∀(tt :term). (∃(o' :num option) (l :term list). tt = Term o' l) ∨ (∃(l :lit). tt = (Litv l :term)) ∨ (∃(n :num). tt = RefPtr n) ∨ tt = Other
term_distinct=(∀(a1 :term list) (a0 :num option) (a :lit). Term a0 a1 ≠ (Litv a :term)) ∧ (∀(a1 :term list) (a0 :num option) (a :num). Term a0 a1 ≠ RefPtr a) ∧ (∀(a1 :term list) (a0 :num option). Term a0 a1 ≠ Other) ∧ (∀(a' :num) (a :lit). (Litv a :term) ≠ RefPtr a') ∧ (∀(a :lit). (Litv a :term) ≠ Other) ∧ ∀(a :num). RefPtr a ≠ Other
is_sibling=(∀(x :α). is_sibling x (NONE :α list option) ⇔ T) ∧ ∀(x :α) (l :α list). is_sibling x (SOME l) ⇔ MEM x l
pmatch=(∀(t :term) (refs :num |-> term). (pmatch refs Any t :pmatchResult) = PMatchSuccess) ∧ (∀(refs :num |-> term) (l' :lit) (l :lit). (pmatch refs (Lit l :pat) (Litv l' :term) :pmatchResult) = if ¬lit_same_type l l' then PTypeFailure else if l = l' then PMatchSuccess else PMatchFailure) ∧ (∀(targs :term list) (tag :num) (t :num) (siblings :(num # num) list option) (refs :num |-> term) (pargs :pat list). (pmatch refs (Cons (SOME (tag,siblings)) pargs) (Term (SOME t) targs) :pmatchResult) = if tag = t ∧ LENGTH pargs = LENGTH targs then (pmatch_list refs pargs targs :pmatchResult) else if is_sibling (t,LENGTH targs) siblings then PMatchFailure else PTypeFailure) ∧ (∀(targs :term list) (refs :num |-> term) (pargs :pat list). (pmatch refs (Cons (NONE :(num # (num # num) list option) option) pargs) (Term (NONE :num option) targs) :pmatchResult) = (pmatch_list refs pargs targs :pmatchResult)) ∧ (∀(refs :num |-> term) (r :num) (p :pat). (pmatch refs (Ref p) (RefPtr r) :pmatchResult) = case FLOOKUP refs r of (NONE :term option) => PTypeFailure | SOME v => (pmatch refs p v :pmatchResult)) ∧ (∀(t :term) (refs :num |-> term) (p2 :pat) (p1 :pat). (pmatch refs (Or p1 p2 :pat) t :pmatchResult) = case (pmatch refs p1 t :pmatchResult) of PMatchSuccess => (case (pmatch refs p2 t :pmatchResult) of PMatchSuccess => PMatchSuccess | PMatchFailure => PMatchSuccess | PTypeFailure => PTypeFailure) | PMatchFailure => (pmatch refs p2 t :pmatchResult) | PTypeFailure => PTypeFailure) ∧ (∀(v9 :pat list) (v30 :num # (num # num) list option) (v21 :term list) (refs :num |-> term). (pmatch refs (Cons (SOME v30) v9) (Term (NONE :num option) v21) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v28 :num) (v21 :term list) (refs :num |-> term). (pmatch refs (Cons (NONE :(num # (num # num) list option) option) v9) (Term (SOME v28) v21) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (v22 :lit) (refs :num |-> term). (pmatch refs (Cons v8 v9) (Litv v22 :term) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (v23 :num) (refs :num |-> term). (pmatch refs (Cons v8 v9) (RefPtr v23) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (refs :num |-> term). (pmatch refs (Cons v8 v9) Other :pmatchResult) = PTypeFailure) ∧ (∀(v39 :term list) (v38 :num option) (v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) (Term v38 v39) :pmatchResult) = PTypeFailure) ∧ (∀(v41 :num) (v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) (RefPtr v41) :pmatchResult) = PTypeFailure) ∧ (∀(v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) Other :pmatchResult) = PTypeFailure) ∧ (∀(v47 :term list) (v46 :num option) (v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) (Term v46 v47) :pmatchResult) = PTypeFailure) ∧ (∀(v48 :lit) (v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) (Litv v48 :term) :pmatchResult) = PTypeFailure) ∧ (∀(v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) Other :pmatchResult) = PTypeFailure) ∧ (∀(refs :num |-> term). (pmatch_list refs ([] :pat list) ([] :term list) :pmatchResult) = PMatchSuccess) ∧ (∀(v63 :term list) (v62 :term) (refs :num |-> term). (pmatch_list refs ([] :pat list) (v62::v63) :pmatchResult) = PTypeFailure) ∧ (∀(v59 :pat list) (v58 :pat) (refs :num |-> term). (pmatch_list refs (v58::v59) ([] :term list) :pmatchResult) = PTypeFailure) ∧ ∀(ts :term list) (t :term) (refs :num |-> term) (ps :pat list) (p :pat). (pmatch_list refs (p::ps) (t::ts) :pmatchResult) = case (pmatch refs p t :pmatchResult) of PMatchSuccess => (pmatch_list refs ps ts :pmatchResult) | PMatchFailure => (case (pmatch_list refs ps ts :pmatchResult) of PMatchSuccess => PMatchFailure | PMatchFailure => PMatchFailure | PTypeFailure => PTypeFailure) | PTypeFailure => PTypeFailure
pmatch_any=∀(refs :num |-> term) (v :term). (pmatch refs Any v :pmatchResult) = PMatchSuccess
pmatch_list_nil=∀(refs :num |-> term) (v :term) (vs :term list) (p :pat) (ps :pat list). (pmatch_list refs ([] :pat list) ([] :term list) :pmatchResult) = PMatchSuccess ∧ (pmatch_list refs ([] :pat list) (v::vs) :pmatchResult) = PTypeFailure ∧ (pmatch_list refs (p::ps) ([] :term list) :pmatchResult) = PTypeFailure
pmatch_list_cons=∀(refs :num |-> term) (p :pat) (ps :pat list) (v :term) (vs :term list). (pmatch_list refs (p::ps) (v::vs) :pmatchResult) = pand (pmatch refs p v :pmatchResult) (pmatch_list refs ps vs :pmatchResult)
pmatch_comp_length=∀(ps :pat list) (vs :term list). (pmatch_list (refs :num |-> term) ps vs :pmatchResult) ≠ PTypeFailure ⇒ LENGTH vs = LENGTH ps
pmatch_exh_length=∀(refs :num |-> term) (ps :pat list) (vs :term list). (pmatch_list refs ps vs :pmatchResult) ≠ PTypeFailure ⇒ LENGTH ps = LENGTH vs
pmatch_list_append=∀(ps :pat list) (us :term list) (qs :pat list) (ws :term list) (refs :num |-> term). LENGTH ps = LENGTH us ⇒ (pmatch_list refs (ps ++ qs) (us ++ ws) :pmatchResult) = pand (pmatch_list refs ps us :pmatchResult) (pmatch_list refs qs ws :pmatchResult)
length_anys=∀(n :num). LENGTH (anys n) = n
pmatch_list_anys=∀(n :num) (vs :term list) (refs :num |-> term). (pmatch_list refs (anys n) vs :pmatchResult) = if LENGTH vs = n then PMatchSuccess else PTypeFailure
mem_ctor_nub=∀(l :α list) (x :α). MEM x (ctor_nub l) ⇔ MEM x l
mem_ctor_keep=∀(xs :α list) (ys :α list) (x :α). MEM x (ctor_keep xs ys) ⇔ MEM x xs ∧ MEM x ys
mem_tag_ctors=∀(sibs :(num # num) list) (t :num) (a :num). MEM (TagC t a) (tag_ctors sibs) ⇔ MEM (t,a) sibs
mem_spec_mats=∀(cs :ctor list) (c :ctor) (rows :pat list list). MEM c cs ⇒ MEM (spec_mat c rows) (spec_mats cs rows)
mem_add_head=∀(yss :α list list) (x :α) (ys :α list). MEM ys (add_head x yss) ⇔ ∃(zs :α list). MEM zs yss ∧ ys = x::zs
mem_mk_prods=∀(xs :α list) (yss :α list list) (zs :α list). MEM zs (mk_prods xs yss) ⇔ ∃(x :α) (ys :α list). MEM x xs ∧ MEM ys yss ∧ zs = x::ys
mem_mk_refs=∀(ps :pat list) (q :pat). MEM q (mk_refs ps) ⇔ ∃(p :pat). MEM p ps ∧ q = Ref p
mem_mk_conses=∀(pss :pat list list) (t :(num # (num # num) list option) option) (q :pat). MEM q (mk_conses t pss) ⇔ ∃(ps :pat list). MEM ps pss ∧ q = Cons t ps
mem_mk_rows=∀(ps :α list) (r :α list). MEM r (mk_rows ps) ⇔ ∃(p :α). MEM p ps ∧ r = [p]
length_expand_list=∀(ps :pat list) (qs :pat list). MEM qs (expand_list ps) ⇒ LENGTH qs = LENGTH ps
expand_thm=(∀(p :pat) (q :pat) (refs :num |-> term) (v :term). MEM q (expand p) ∧ (pmatch refs p v :pmatchResult) ≠ PTypeFailure ⇒ (pmatch refs q v :pmatchResult) ≠ PTypeFailure ∧ ((pmatch refs q v :pmatchResult) = PMatchSuccess ⇒ (pmatch refs p v :pmatchResult) = PMatchSuccess)) ∧ ∀(ps :pat list) (qs :pat list) (refs :num |-> term) (vs :term list). MEM qs (expand_list ps) ∧ (pmatch_list refs ps vs :pmatchResult) ≠ PTypeFailure ⇒ (pmatch_list refs qs vs :pmatchResult) ≠ PTypeFailure ∧ ((pmatch_list refs qs vs :pmatchResult) = PMatchSuccess ⇒ (pmatch_list refs ps vs :pmatchResult) = PMatchSuccess)
dest_val=dest_val (refs :num |-> term) (Term (SOME (t :num)) (vs :term list)) = SOME (TagC t (LENGTH vs),vs) ∧ dest_val refs (Term (NONE :num option) vs) = SOME (TupC (LENGTH vs),vs) ∧ dest_val refs (RefPtr (r :num)) = (case FLOOKUP refs r of (NONE :term option) => (NONE :(ctor # term list) option) | SOME w => SOME (RefC,[w])) ∧ dest_val refs (Litv (l :lit) :term) = (NONE :(ctor # term list) option) ∧ dest_val refs Other = (NONE :(ctor # term list) option)
dest_val_eq_some=∀(refs :num |-> term) (v :term) (c :ctor) (as :term list). dest_val refs v = SOME (c,as) ⇔ (∃(t :num). v = Term (SOME t) as ∧ c = TagC t (LENGTH as)) ∨ v = Term (NONE :num option) as ∧ c = TupC (LENGTH as) ∨ ∃(r :num) (w :term). v = RefPtr r ∧ FLOOKUP refs r = SOME w ∧ as = [w] ∧ c = RefC
length_dest_val=∀(refs :num |-> term) (v :term) (c :ctor) (as :term list). dest_val refs v = SOME (c,as) ⇒ LENGTH as = ctor_arity c
ctors_of_thm=∀(p :pat) (xs :ctor list) (refs :num |-> term) (v :term). ctors_of p = SOME xs ∧ (pmatch refs p v :pmatchResult) ≠ PTypeFailure ⇒ ∃(c :ctor) (as :term list). dest_val refs v = SOME (c,as) ∧ MEM c xs
col_ctors_thm=∀(M :pat list list) (cs :ctor list) (refs :num |-> term) (v :term) (vs :term list). col_ctors M = SOME cs ∧ EVERY (λ(r :pat list). (pmatch_list refs r (v::vs) :pmatchResult) ≠ PTypeFailure) M ⇒ ∃(c :ctor) (as :term list). dest_val refs v = SOME (c,as) ∧ MEM c cs
spec_row_thm=∀(c :ctor) (r :pat list) (row :pat list) (refs :num |-> term) (v :term) (vs :term list) (as :term list). dest_val refs v = SOME (c,as) ∧ MEM row (spec_row c r) ⇒ (pmatch_list refs row (as ++ vs) :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
spec_mat_mem=∀(M :pat list list) (c :ctor) (as :term list) (refs :num |-> term) (v :term) (vs :term list) (row :pat list). dest_val refs v = SOME (c,as) ∧ MEM row (spec_mat c M) ⇒ ∃(r :pat list). MEM r M ∧ (pmatch_list refs row (as ++ vs) :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
default_row_thm=∀(r :pat list) (row :pat list) (refs :num |-> term) (v :term) (vs :term list). MEM row (default_row r) ⇒ (pmatch_list refs row vs :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
default_mat_mem=∀(M :pat list list) (refs :num |-> term) (v :term) (vs :term list) (row :pat list). MEM row (default_mat M) ⇒ ∃(r :pat list). MEM r M ∧ (pmatch_list refs row vs :pmatchResult) = (pmatch_list refs r (v::vs) :pmatchResult)
exh_matrix_thm=(∀(M :pat list list) (refs :num |-> term) (vs :term list). exh_matrix M ∧ EVERY (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) ≠ PTypeFailure) M ⇒ EXISTS (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) = PMatchSuccess) M) ∧ ∀(ms :pat list list list) (m :pat list list) (refs :num |-> term) (vs :term list). exh_mats ms ∧ MEM m ms ∧ EVERY (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) ≠ PTypeFailure) m ⇒ EXISTS (λ(r :pat list). (pmatch_list refs r vs :pmatchResult) = PMatchSuccess) m
match_def=(∀(v :term) (refs :num |-> term). match refs ([] :(pat # num) list) v = SOME MatchFailure) ∧ ∀(v :term) (rows :(pat # num) list) (refs :num |-> term) (p :pat) (e :num). match refs ((p,e)::rows) v = case (pmatch refs p v :pmatchResult) of PMatchSuccess => (case match refs rows v of (NONE :matchResult option) => (NONE :matchResult option) | SOME v' => SOME (MatchSuccess e)) | PMatchFailure => match refs rows v | PTypeFailure => (NONE :matchResult option)
match_no_ptypefailure=∀(refs :num |-> term) (v :term) (rows :(pat # num) list). match refs rows v ≠ (NONE :matchResult option) ⇒ EVERY (λ((p :pat),(e :num)). (pmatch refs p v :pmatchResult) ≠ PTypeFailure) rows
match_exists=∀(refs :num |-> term) (v :term) (rows :(pat # num) list). match refs rows v ≠ (NONE :matchResult option) ∧ EXISTS (λ((p :pat),(e :num)). (pmatch refs p v :pmatchResult) = PMatchSuccess) rows ⇒ match refs rows v ≠ SOME MatchFailure
match_result_type=:num -> matchResult
match_result_cases=∀(mm :matchResult). (∃(n :num). mm = MatchSuccess n) ∨ mm = MatchFailure
match_result_distinct=∀(a :num). MatchSuccess a ≠ MatchFailure
or_rows_ok=∀(refs :num |-> term) (v :term) (rows :(pat # α) list). EVERY (λ((p :pat),(e :α)). (pmatch refs p v :pmatchResult) ≠ PTypeFailure) rows ⇒ EVERY (λ(r :pat list). (pmatch_list refs r [v] :pmatchResult) ≠ PTypeFailure) (or_rows rows)
or_rows_hit=∀(refs :num |-> term) (v :term) (rows :(pat # α) list). EVERY (λ((p :pat),(e :α)). (pmatch refs p v :pmatchResult) ≠ PTypeFailure) rows ∧ EXISTS (λ(r :pat list). (pmatch_list refs r [v] :pmatchResult) = PMatchSuccess) (or_rows rows) ⇒ EXISTS (λ((p :pat),(e :α)). (pmatch refs p v :pmatchResult) = PMatchSuccess) rows
exh_rows_thm=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ∧ exh_rows rows ⇒ match refs rows v ≠ SOME MatchFailure
pat_weight=pat_weight Any = (0 :num) ∧ (∀(l :lit). pat_weight (Lit l :pat) = (0 :num)) ∧ (∀(p :pat) (q :pat). pat_weight (Or p q :pat) = (1 :num) + pat_weight p + pat_weight q) ∧ (∀(p :pat). pat_weight (Ref p) = (1 :num) + pat_weight p) ∧ (∀(t :(num # (num # num) list option) option) (ps :pat list). pat_weight (Cons t ps) = (1 :num) + pats_weight ps) ∧ pats_weight ([] :pat list) = (0 :num) ∧ ∀(p :pat) (ps :pat list). pats_weight (p::ps) = pat_weight p + pats_weight ps
mat_weight=mat_weight ([] :pat list list) = (0 :num) ∧ ∀(r :pat list) (rows :pat list list). mat_weight (r::rows) = pats_weight r + mat_weight rows
mat_len=mat_len ([] :α list list) = (0 :num) ∧ ∀(r :α list) (rows :α list list). mat_len (r::rows) = LENGTH r + mat_len rows
mats_weight=mats_weight ([] :pat list list list) = (0 :num) ∧ ∀(m :pat list list) (ms :pat list list list). mats_weight (m::ms) = MAX (mat_weight m) (mats_weight ms)
mats_len=mats_len ([] :α list list list) = (0 :num) ∧ ∀(m :α list list) (ms :α list list list). mats_len (m::ms) = MAX (mat_len m) (mats_len ms)
pats_weight_append=∀(xs :pat list) (ys :pat list). pats_weight (xs ++ ys) = pats_weight xs + pats_weight ys
pats_weight_anys=∀(n :num). pats_weight (anys n) = (0 :num)
mat_weight_append=∀(xs :pat list list) (ys :pat list list). mat_weight (xs ++ ys) = mat_weight xs + mat_weight ys
mat_len_append=∀(xs :α list list) (ys :α list list). mat_len (xs ++ ys) = mat_len xs + mat_len ys
mat_weight_spec_row=∀(c :ctor) (r :pat list). mat_weight (spec_row c r) ≤ pats_weight r
mat_weight_spec_mat=∀(c :ctor) (rows :pat list list). mat_weight (spec_mat c rows) ≤ mat_weight rows
mat_weight_spec_row_less=∀(c :ctor) (p :pat) (r :pat list). ctors_of p ≠ (NONE :ctor list option) ⇒ mat_weight (spec_row c (p::r)) < pats_weight (p::r)
mat_weight_spec_mat_less=∀(c :ctor) (rows :pat list list) (cs :ctor list). col_ctors rows = SOME cs ⇒ mat_weight (spec_mat c rows) < mat_weight rows
mat_weight_default_mat=∀(rows :pat list list). mat_weight (default_mat rows) ≤ mat_weight rows
mat_len_default_mat=∀(rows :pat list list). mat_len (default_mat rows) ≤ mat_len rows
mats_weight_spec_mats=∀(cs :ctor list) (rows :pat list list) (ds :ctor list). col_ctors rows = SOME ds ⇒ mats_weight (spec_mats cs rows) < mat_weight rows
mat_len_default_mat_less=∀(r :pat list) (rows :pat list list). r ≠ ([] :pat list) ⇒ mat_len (default_mat (r::rows)) < mat_len (r::rows)
