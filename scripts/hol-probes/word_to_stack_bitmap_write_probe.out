bw_source_bits_to_word_bit=⊢ ∀bs i. i < dimindex (:α) ∧ i < LENGTH bs ⇒ (bits_to_word bs ' i ⇔ bs❲i❳)
bw_source_bits_to_word_miss=⊢ ∀bs i. i < dimindex (:α) ∧ LENGTH bs ≤ i ⇒ ¬bits_to_word bs ' i
bw_source_shift_shift_lemma=⊢ ¬word_msb w ⇒ w ≪ 1 ⋙ 1 = w
bw_source_word_or_eq_0=⊢ w ‖ v = 0w ⇔ w = 0w ∧ v = 0w
bw_source_GENLIST_bits_to_word_alt=⊢ LENGTH (xs ++ ys) ≤ dimindex (:α) ⇒ GENLIST (λi. bits_to_word (xs ++ ys) ' i) (LENGTH xs) = xs
bw_source_bit_length_bits_to_word=⊢ ∀qs. LENGTH qs + 1 < dimindex (:α) ⇒ bit_length (bits_to_word (qs ++ [T])) = LENGTH qs + 1
bw_source_GENLIST_bits_to_word=⊢ LENGTH qs' + 1 < dimindex (:α) ⇒ GENLIST (λi. bits_to_word (qs' ++ [T]) ' i) (LENGTH qs') = qs'
bw_source_read_bitmap_word_list=⊢ 8 ≤ dimindex (:α) ⇒ read_bitmap (word_list (qs ++ [T]) (dimindex (:α) − 1) ++ xs) = SOME qs
bw_full=⊢ 8 ≤ dimindex (:α) ⇒ read_bitmap (write_bitmap names k f') = SOME (GENLIST (λx. MEM x (MAP (λ(r,y). f' − 1 − (r DIV 2 − k)) (toAList names))) f')
