inst_select_Loop_helper_typed=∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (prog :α prog) (exit_names :sptree$num_set) (res :α result option) (rst :(α, γ, 'ffi) state) (c :α asm_config) (temp :num) (loc :α word_loc sptree$num_map). (∀(st :(α, γ, 'ffi) state) (res :α result option) (rst :(α, γ, 'ffi) state) (loc :α word_loc sptree$num_map). evaluate (prog,st) = (res,rst) ∧ res ≠ SOME (Error :α result) ∧ locals_rel temp st.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate (inst_select c temp prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc') ∧ evaluate ((Loop names prog exit_names :α prog),s) = (res,rst) ∧ res ≠ SOME (Error :α result) ∧ every_var (λ(x :num). x < temp) prog ∧ every_name (λ(x :num). x < temp) (names,(LN :sptree$num_set)) ∧ every_name (λ(x :num). x < temp) (exit_names,(LN :sptree$num_set)) ∧ locals_rel temp s.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate ((Loop names (inst_select c temp prog) exit_names :α prog),s with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc'
inst_select_thm_typed=∀(c :α asm_config) (temp :num) (prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state) (loc :α word_loc sptree$num_map). evaluate (prog,st) = (res,rst) ∧ every_var (λ(x :num). x < temp) prog ∧ res ≠ SOME (Error :α result) ∧ locals_rel temp st.locals loc ⇒ ∃(loc' :α word_loc sptree$num_map). evaluate (inst_select c temp prog,st with locals := loc) = (res,rst with locals := loc') ∧ case res of (NONE :α result option) => locals_rel temp rst.locals loc' | SOME (Result v8 v9) => rst.locals = loc' | SOME (Exception v10 v11) => rst.locals = loc' | SOME (Break v12 :α result) => locals_rel temp rst.locals loc' | SOME (Continue v13 :α result) => locals_rel temp rst.locals loc' | SOME (TimeOut :α result) => rst.locals = loc' | SOME (NotEnoughSpace :α result) => rst.locals = loc' | SOME (FinalFFI v14 :α result) => rst.locals = loc' | SOME (Error :α result) => rst.locals = loc'
binary_branch_exp_def_typed=(∀(exps :α exp list). binary_branch_exp (Op Sub exps) ⇔ EVERY (λ(a :α exp). binary_branch_exp a) exps) ∧ (∀(xs :α exp list). binary_branch_exp (Op Add xs) ⇔ LENGTH xs = (2 :num) ∧ EVERY (λ(a :α exp). binary_branch_exp a) xs) ∧ (∀(xs :α exp list). binary_branch_exp (Op And xs) ⇔ LENGTH xs = (2 :num) ∧ EVERY (λ(a :α exp). binary_branch_exp a) xs) ∧ (∀(xs :α exp list). binary_branch_exp (Op Or xs) ⇔ LENGTH xs = (2 :num) ∧ EVERY (λ(a :α exp). binary_branch_exp a) xs) ∧ (∀(xs :α exp list). binary_branch_exp (Op Xor xs) ⇔ LENGTH xs = (2 :num) ∧ EVERY (λ(a :α exp). binary_branch_exp a) xs) ∧ (∀(exp :α exp). binary_branch_exp (Load exp :α exp) ⇔ binary_branch_exp exp) ∧ (∀(shift :ast$shift) (nexp :α exp) (exp :α exp). binary_branch_exp (Shift shift exp nexp :α exp) ⇔ binary_branch_exp exp ∧ binary_branch_exp nexp) ∧ (∀(v :α word). binary_branch_exp (Const v :α exp) ⇔ T) ∧ (∀(v1 :num). binary_branch_exp (Var v1 :α exp) ⇔ T) ∧ ∀(v2 :store_name). binary_branch_exp (Lookup v2 :α exp) ⇔ T
pull_ops_simp_def_typed=(∀(op :binop). pull_ops_simp op ([] :α exp list) = ([] :α exp list)) ∧ ∀(op :binop) (x :α exp) (xs :α exp list). pull_ops_simp op (x::xs) = case x of (Const v9 :α exp) => x::pull_ops_simp op xs | (Var v10 :α exp) => x::pull_ops_simp op xs | (Lookup v11 :α exp) => x::pull_ops_simp op xs | (Load v12 :α exp) => x::pull_ops_simp op xs | Op op' ls => if op = op' then ls ++ pull_ops_simp op xs else x::pull_ops_simp op xs | (Shift v15 v16 v17 :α exp) => x::pull_ops_simp op xs
evaluate_three_to_two_reg_prog_typed=evaluate ((prog :α prog),(s :(α, β, γ) state)) = ((res :α result option),(s' :(α, β, γ) state)) ∧ res ≠ SOME (Error :α result) ∧ every_inst (distinct_tar_reg :α inst -> bool) prog ⇒ evaluate (three_to_two_reg_prog (t :bool) prog,s) = (res,s')
three_to_two_reg_Loop_typed=∀(s :(α, γ, 'ffi) state) (names :sptree$num_set) (prog :α prog) (exit_names :sptree$num_set) (res :α result option) (s' :(α, γ, 'ffi) state). (∀(v :(α, γ, 'ffi) state) (res :α result option) (s' :(α, γ, 'ffi) state). evaluate (prog,v) = (res,s') ∧ res ≠ SOME (Error :α result) ⇒ evaluate (three_to_two_reg prog,v) = (res,s')) ∧ evaluate ((Loop names prog exit_names :α prog),s) = (res,s') ∧ res ≠ SOME (Error :α result) ⇒ evaluate ((Loop names (three_to_two_reg prog) exit_names :α prog),s) = (res,s')
three_to_two_reg_correct_typed=∀(prog :α prog) (s :(α, β, γ) state) (res :α result option) (s' :(α, β, γ) state). every_inst (distinct_tar_reg :α inst -> bool) prog ∧ evaluate (prog,s) = (res,s') ∧ res ≠ SOME (Error :α result) ⇒ evaluate (three_to_two_reg prog,s) = (res,s')
