ci_statement=∀s1 r s2 t1 k off jump i. evaluate (Inst i,s1) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s1 t1 ∧ reg_bound (Inst i) k ⇒ ∃ck t2. evaluate (comp jump off k (Inst i),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
ci_types=s1:(α, β, γ) stackSem$state;r:α stackSem$result option;s2:(α, β, γ) stackSem$state;t1:(α, β, γ) stackSem$state;k:num;off:α word # α word;jump:bool;i:α inst
ci_proved=T
