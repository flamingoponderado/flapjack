tokcheck_def_typed=∀(pt :(α, β, γ) parsetree) (tok :α). tokcheck pt tok ⇔ OPTION_BIND (destLf pt) (destTOK :(α, β) symbol -> α option) = SOME tok
Long_Short_def_typed=(∀(s :mlstring). Long_Short End s = (Short s :(mlstring, mlstring) id)) ∧ ∀(x :mlstring) (xs :path) (s :mlstring). Long_Short (Mod x xs :path) s = Long x (Long_Short xs s)
ptree_UQTyop_def_typed=ptree_UQTyop (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :mlstring option) ∧ ptree_UQTyop (Nd (nt :(MMLnonT + num) # α) (args :(token, MMLnonT, α) parsetree list)) = if FST nt ≠ mkNT nUQTyOp then (NONE :mlstring option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :mlstring option) | [pt] => OPTION_BIND (destLf pt) (λ(lf :(token, MMLnonT) symbol). OPTION_BIND (destTOK lf :token option) (λ(tk :token). OPTION_CHOICE (destSymbolT tk) (destAlphaT tk))) | pt::v6::v7 => (NONE :mlstring option)
ptree_TyvarN_def_typed=ptree_TyvarN (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :mlstring option) ∧ ptree_TyvarN (Nd (nt :(MMLnonT + num) # α) (args :(token, MMLnonT, α) parsetree list)) = if FST nt ≠ mkNT nTyvarN then (NONE :mlstring option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :mlstring option) | [tyv] => destTyvarPT tyv | tyv::v6::v7 => (NONE :mlstring option)
ptree_Tyop_def_typed=ptree_Tyop (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :(mlstring, mlstring) id option) ∧ ptree_Tyop (Nd (nt :(MMLnonT + num) # α) (args :(token, MMLnonT, α) parsetree list)) = if FST nt ≠ mkNT nTyOp then (NONE :(mlstring, mlstring) id option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :(mlstring, mlstring) id option) | [pt] => OPTION_CHOICE (OPTION_BIND (OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, MMLnonT) symbol -> token option)) destLongidT) (λ((xs :path),(s :mlstring)). SOME (Long_Short xs s))) (OPTION_BIND (ptree_UQTyop pt) (λ(nm :mlstring). SOME (Short nm :(mlstring, mlstring) id))) | pt::v6::v7 => (NONE :(mlstring, mlstring) id option)
ptree_V_def_typed=ptree_V (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :mlstring option) ∧ ptree_V (Nd (nt :(MMLnonT + num) # α) (subs :(token, MMLnonT, α) parsetree list)) = OPTION_IGNORE_BIND (OPTION_GUARD (FST nt = mkNT nV)) (case subs of ([] :(token, MMLnonT, α) parsetree list) => (NONE :mlstring option) | [pt] => OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, MMLnonT) symbol -> token option)) (λ(t :token). OPTION_CHOICE (destAlphaT t) (destSymbolT t)) | pt::v6::v7 => (NONE :mlstring option))
ptree_FQV_def_typed=ptree_FQV (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :(mlstring, mlstring) id option) ∧ ptree_FQV (Nd (nt :(MMLnonT + num) # α) (args :(token, MMLnonT, α) parsetree list)) = if FST nt ≠ mkNT nFQV then (NONE :(mlstring, mlstring) id option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :(mlstring, mlstring) id option) | [pt] => OPTION_CHOICE (OPTION_MAP (Short :mlstring -> (mlstring, mlstring) id) (ptree_V pt)) (OPTION_BIND (OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, MMLnonT) symbol -> token option)) destLongidT) (λ((xs :path),(s :mlstring)). SOME (Long_Short xs s))) | pt::v6::v7 => (NONE :(mlstring, mlstring) id option)
tuplify_def_typed=tuplify ([] :ast_t list) = (NONE :ast_t option) ∧ tuplify [(ty :ast_t)] = SOME ty ∧ tuplify ((v :ast_t)::(v4 :ast_t)::(v5 :ast_t list)) = SOME (Attup (v::v4::v5))
ptree_UQConstructorName_def_typed=ptree_UQConstructorName (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :mlstring option) ∧ ptree_UQConstructorName (Nd (nm :(MMLnonT + num) # α) (args :(token, MMLnonT, α) parsetree list)) = if FST nm ≠ mkNT nUQConstructorName then (NONE :mlstring option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :mlstring option) | [pt] => OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, MMLnonT) symbol -> token option)) destAlphaT | pt::v6::v7 => (NONE :mlstring option)
ptree_ConstructorName_def_typed=∀(ast :(token, MMLnonT, α) parsetree). ptree_ConstructorName ast = case ast of Lf v => (NONE :(mlstring, mlstring) id option) | Nd nt args => if FST nt ≠ mkNT nConstructorName then (NONE :(mlstring, mlstring) id option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :(mlstring, mlstring) id option) | [pt] => OPTION_CHOICE (OPTION_BIND (ptree_UQConstructorName pt) (λ(s :mlstring). SOME (Short s :(mlstring, mlstring) id))) (OPTION_BIND (OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, MMLnonT) symbol -> token option)) destLongidT) (λ((xs :path),(s :mlstring)). SOME (Long_Short xs s))) | pt::v6::v7 => (NONE :(mlstring, mlstring) id option)
ptree_OpID_def_typed=ptree_OpID (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :exp option) ∧ ptree_OpID (Nd (nt :(MMLnonT + num) # α) (subs :(token, MMLnonT, α) parsetree list)) = if FST nt ≠ mkNT nOpID then (NONE :exp option) else case subs of ([] :(token, MMLnonT, α) parsetree list) => (NONE :exp option) | [Lf (TK tk,v17)] => OPTION_CHOICE (OPTION_CHOICE (OPTION_CHOICE (OPTION_BIND (destAlphaT tk) (λ(s :mlstring). ifM (isConstructor (explode s)) (SOME (Con (SOME (Short s :(mlstring, mlstring) id)) ([] :exp list))) (SOME (Var (Short s :(mlstring, mlstring) id))))) (OPTION_BIND (destSymbolT tk) (λ(s :mlstring). ifM (isSymbolicConstructor (explode s)) (SOME (Con (SOME (Short s :(mlstring, mlstring) id)) ([] :exp list))) (SOME (Var (Short s :(mlstring, mlstring) id)))))) (OPTION_BIND (destLongidT tk) (λ((path :path),(s :mlstring)). ifM (isConstructor (explode s)) (SOME (Con (SOME (Long_Short path s)) ([] :exp list))) (SOME (Var (Long_Short path s)))))) (if tk = StarT then ifM (isSymbolicConstructor "*") (SOME (Con (SOME (Short «*» :(mlstring, mlstring) id)) ([] :exp list))) (SOME (Var (Short «*» :(mlstring, mlstring) id))) else if tk = EqualsT then SOME (Var (Short «=» :(mlstring, mlstring) id)) else (NONE :exp option)) | [Lf ((NT v21 :(token, MMLnonT) symbol),v17)] => (NONE :exp option) | Lf v7::v12::v13 => (NONE :exp option) | Nd v8 v9::v3 => (NONE :exp option)
EtoPat_def_typed=EtoPat (Con (x :(mlstring, mlstring) id option) (args :exp list)) = (if NULL args then SOME (Pcon x ([] :pat list)) else (NONE :pat option)) ∧ EtoPat (Var (Short (n' :mlstring) :(mlstring, mlstring) id)) = SOME (Pvar n') ∧ EtoPat (Var (Long (str :mlstring) (n :(mlstring, mlstring) id))) = SOME (Pcon (SOME (Long str n)) ([] :pat list)) ∧ EtoPat (Raise (v :exp)) = (NONE :pat option) ∧ EtoPat (Handle (v1 :exp) (v2 :(pat # exp) list)) = (NONE :pat option) ∧ EtoPat (Lit (v3 :lit)) = (NONE :pat option) ∧ EtoPat (Fun (v7 :mlstring) (v8 :exp)) = (NONE :pat option) ∧ EtoPat (App (v9 :op) (v10 :exp list)) = (NONE :pat option) ∧ EtoPat (Log (v11 :lop) (v12 :exp) (v13 :exp)) = (NONE :pat option) ∧ EtoPat (If (v14 :exp) (v15 :exp) (v16 :exp)) = (NONE :pat option) ∧ EtoPat (Mat (v17 :exp) (v18 :(pat # exp) list)) = (NONE :pat option) ∧ EtoPat (Let (v19 :mlstring option) (v20 :exp) (v21 :exp)) = (NONE :pat option) ∧ EtoPat (Letrec (v22 :(mlstring # mlstring # exp) list) (v23 :exp)) = (NONE :pat option) ∧ EtoPat (Tannot (v24 :exp) (v25 :ast_t)) = (NONE :pat option) ∧ EtoPat (Lannot (v26 :exp) (v27 :locs)) = (NONE :pat option)
Papply_def_typed=∀(pat :pat) (arg :pat). Papply pat arg = case pat of Pany => pat | Pvar v9 => pat | Plit v10 => pat | Pcon cn args => Pcon cn (args ++ [arg]) | Pref v13 => pat | Pas v14 v15 => pat | Ptannot v16 v17 => pat
maybe_handleRef_def_typed=maybe_handleRef (Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) [(pat :pat)]) = Pref pat ∧ maybe_handleRef Pany = Pany ∧ maybe_handleRef (Pvar (v :mlstring)) = Pvar v ∧ maybe_handleRef (Plit (v1 :lit)) = Plit v1 ∧ maybe_handleRef (Pcon (NONE :(mlstring, mlstring) id option) (v3 :pat list)) = Pcon (NONE :(mlstring, mlstring) id option) v3 ∧ maybe_handleRef (Pcon (SOME (Short «» :(mlstring, mlstring) id)) v3) = Pcon (SOME (Short «» :(mlstring, mlstring) id)) v3 ∧ maybe_handleRef (Pcon (SOME (Short «R» :(mlstring, mlstring) id)) v3) = Pcon (SOME (Short «R» :(mlstring, mlstring) id)) v3 ∧ maybe_handleRef (Pcon (SOME (Short «Re» :(mlstring, mlstring) id)) v3) = Pcon (SOME (Short «Re» :(mlstring, mlstring) id)) v3 ∧ maybe_handleRef (Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) ([] :pat list)) = Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) ([] :pat list) ∧ maybe_handleRef (Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) ((v53 :pat)::(v57 :pat)::(v58 :pat list))) = Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) (v53::v57::v58) ∧ maybe_handleRef (Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING #"f" (STRING (v49 :char) (v50 :string)))))) :(mlstring, mlstring) id)) v3) = Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING #"f" (STRING v49 v50))))) :(mlstring, mlstring) id)) v3 ∧ maybe_handleRef (Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING (v46 :char) (v43 :string))))) :(mlstring, mlstring) id)) v3) = (if v46 = #"f" then case v43 of ("" :string) => (case v3 of ([] :pat list) => Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) ([] :pat list) | [pat] => Pref pat | pat::v59::v60 => Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) (pat::v59::v60)) | STRING v51 v52 => Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING #"f" (STRING v51 v52))))) :(mlstring, mlstring) id)) v3 else Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING v46 v43)))) :(mlstring, mlstring) id)) v3) ∧ maybe_handleRef (Pcon (SOME (Short (implode (STRING #"R" (STRING (v39 :char) (v36 :string)))) :(mlstring, mlstring) id)) v3) = (if v39 = #"e" then case v36 of ("" :string) => Pcon (SOME (Short «Re» :(mlstring, mlstring) id)) v3 | "f" => (case v3 of ([] :pat list) => Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) ([] :pat list) | [pat] => Pref pat | pat::v59::v60 => Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) (pat::v59::v60)) | STRING #"f" (STRING v51 v52) => Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING #"f" (STRING v51 v52))))) :(mlstring, mlstring) id)) v3 | STRING v46 v45 => Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING v46 v45)))) :(mlstring, mlstring) id)) v3 else Pcon (SOME (Short (implode (STRING #"R" (STRING v39 v36))) :(mlstring, mlstring) id)) v3) ∧ maybe_handleRef (Pcon (SOME (Short (implode (STRING (v32 :char) (v29 :string))) :(mlstring, mlstring) id)) v3) = (if v32 = #"R" then case v29 of ("" :string) => Pcon (SOME (Short «R» :(mlstring, mlstring) id)) v3 | "e" => Pcon (SOME (Short «Re» :(mlstring, mlstring) id)) v3 | "ef" => (case v3 of ([] :pat list) => Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) ([] :pat list) | [pat] => Pref pat | pat::v59::v60 => Pcon (SOME (Short «Ref» :(mlstring, mlstring) id)) (pat::v59::v60)) | STRING #"e" (STRING #"f" (STRING v51 v52)) => Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING #"f" (STRING v51 v52))))) :(mlstring, mlstring) id)) v3 | STRING #"e" (STRING v46 v45) => Pcon (SOME (Short (implode (STRING #"R" (STRING #"e" (STRING v46 v45)))) :(mlstring, mlstring) id)) v3 | STRING v39 v38 => Pcon (SOME (Short (implode (STRING #"R" (STRING v39 v38))) :(mlstring, mlstring) id)) v3 else Pcon (SOME (Short (implode (STRING v32 v29)) :(mlstring, mlstring) id)) v3) ∧ maybe_handleRef (Pcon (SOME (Long (v21 :mlstring) (v22 :(mlstring, mlstring) id))) v3) = Pcon (SOME (Long v21 v22)) v3 ∧ maybe_handleRef (Pref (v4 :pat)) = Pref v4 ∧ maybe_handleRef (Pas (v5 :pat) (v6 :mlstring)) = Pas v5 v6 ∧ maybe_handleRef (Ptannot (v7 :pat) (v8 :ast_t)) = Ptannot v7 v8
ptree_Eliteral_def_typed=ptree_Eliteral (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :exp option) ∧ ptree_Eliteral (Nd (nt :(MMLnonT + num) # α) (subs :(token, MMLnonT, α) parsetree list)) = OPTION_IGNORE_BIND (OPTION_GUARD (LENGTH subs = (1 :num) ∧ FST nt = mkNT nEliteral)) (OPTION_BIND (destLf (HD subs)) (λ(lf :(token, MMLnonT) symbol). OPTION_BIND (destTOK lf :token option) (λ(t :token). OPTION_CHOICE (OPTION_CHOICE (OPTION_CHOICE (OPTION_CHOICE (OPTION_BIND (destIntT t) (λ(i :int). SOME (Lit (IntLit i)))) (OPTION_BIND (destCharT t) (λ(c :char). SOME (Lit (Char c))))) (OPTION_BIND (destStringT t) (λ(s :mlstring). SOME (Lit (StrLit s))))) (OPTION_BIND (destWordT t) (λ(n :num). SOME (Lit (Word64 (n2w n :word64)))))) (OPTION_BIND (destFFIT t) (λ(s :mlstring). SOME (App (FFI s) ([] :exp list)))))))
ptree_Op_def_typed=(ptree_Op (Lf (v0 :(token, MMLnonT) symbol # β)) :(α, mlstring) id option) = (NONE :(α, mlstring) id option) ∧ (ptree_Op (Nd (nt :(MMLnonT + num) # β) (subs :(token, MMLnonT, β) parsetree list)) :(α, mlstring) id option) = if FST nt = mkNT nMultOps then if tokcheckl subs [StarT] then SOME (Short «*» :(α, mlstring) id) else if tokcheckl subs [AlphaT «mod»] then SOME (Short «mod» :(α, mlstring) id) else if tokcheckl subs [AlphaT «div»] then SOME (Short «div» :(α, mlstring) id) else (singleSymP (validMultSym ∘ explode) subs :(α, mlstring) id option) else if FST nt = mkNT nAddOps then (singleSymP (validAddSym ∘ explode) subs :(α, mlstring) id option) else if FST nt = mkNT nListOps then (singleSymP (validListSym ∘ explode) subs :(α, mlstring) id option) else if FST nt = mkNT nRelOps then OPTION_CHOICE (singleSymP (validRelSym ∘ explode) subs :(α, mlstring) id option) (OPTION_IGNORE_BIND (OPTION_GUARD (tokcheckl subs [EqualsT])) (SOME (Short «=» :(α, mlstring) id))) else if FST nt = mkNT nCompOps then if tokcheckl subs [SymbolT «:=»] then SOME (Short «:=» :(α, mlstring) id) else if tokcheckl subs [AlphaT «o»] then SOME (Short «o» :(α, mlstring) id) else (NONE :(α, mlstring) id option) else (NONE :(α, mlstring) id option)
mk_binop_def_typed=∀(a_op :(mlstring, mlstring) id) (a1 :exp) (a2 :exp). mk_binop a_op a1 a2 = if a_op = (Short «::» :(mlstring, mlstring) id) then Con (SOME (Short «::» :(mlstring, mlstring) id)) [a1; a2] else App Opapp [App Opapp [Var a_op; a1]; a2]
bind_loc_def_typed=bind_loc (Lannot (e :exp) (l :locs)) (l' :locs) = Lannot e l ∧ bind_loc (Raise (v2 :exp)) l = Lannot (Raise v2) l ∧ bind_loc (Handle (v3 :exp) (v4 :(pat # exp) list)) l = Lannot (Handle v3 v4) l ∧ bind_loc (Lit (v5 :lit)) l = Lannot (Lit v5) l ∧ bind_loc (Con (v6 :(mlstring, mlstring) id option) (v7 :exp list)) l = Lannot (Con v6 v7) l ∧ bind_loc (Var (v8 :(mlstring, mlstring) id)) l = Lannot (Var v8) l ∧ bind_loc (Fun (v9 :mlstring) (v10 :exp)) l = Lannot (Fun v9 v10) l ∧ bind_loc (App (v11 :op) (v12 :exp list)) l = Lannot (App v11 v12) l ∧ bind_loc (Log (v13 :lop) (v14 :exp) (v15 :exp)) l = Lannot (Log v13 v14 v15) l ∧ bind_loc (If (v16 :exp) (v17 :exp) (v18 :exp)) l = Lannot (If v16 v17 v18) l ∧ bind_loc (Mat (v19 :exp) (v20 :(pat # exp) list)) l = Lannot (Mat v19 v20) l ∧ bind_loc (Let (v21 :mlstring option) (v22 :exp) (v23 :exp)) l = Lannot (Let v21 v22 v23) l ∧ bind_loc (Letrec (v24 :(mlstring # mlstring # exp) list) (v25 :exp)) l = Lannot (Letrec v24 v25) l ∧ bind_loc (Tannot (v26 :exp) (v27 :ast_t)) l = Lannot (Tannot v26 v27) l
strip_loc_expr_def_typed=(∀(l :locs) (e :exp). strip_loc_expr (Lannot e l) = case strip_loc_expr e of (e0,v1) => (e0,SOME l)) ∧ (∀(v :exp). strip_loc_expr (Raise v) = (Raise v,(NONE :locs option))) ∧ (∀(v3 :(pat # exp) list) (v2 :exp). strip_loc_expr (Handle v2 v3) = (Handle v2 v3,(NONE :locs option))) ∧ (∀(v4 :lit). strip_loc_expr (Lit v4) = (Lit v4,(NONE :locs option))) ∧ (∀(v6 :exp list) (v5 :(mlstring, mlstring) id option). strip_loc_expr (Con v5 v6) = (Con v5 v6,(NONE :locs option))) ∧ (∀(v7 :(mlstring, mlstring) id). strip_loc_expr (Var v7) = (Var v7,(NONE :locs option))) ∧ (∀(v9 :exp) (v8 :mlstring). strip_loc_expr (Fun v8 v9) = (Fun v8 v9,(NONE :locs option))) ∧ (∀(v11 :exp list) (v10 :op). strip_loc_expr (App v10 v11) = (App v10 v11,(NONE :locs option))) ∧ (∀(v14 :exp) (v13 :exp) (v12 :lop). strip_loc_expr (Log v12 v13 v14) = (Log v12 v13 v14,(NONE :locs option))) ∧ (∀(v17 :exp) (v16 :exp) (v15 :exp). strip_loc_expr (If v15 v16 v17) = (If v15 v16 v17,(NONE :locs option))) ∧ (∀(v19 :(pat # exp) list) (v18 :exp). strip_loc_expr (Mat v18 v19) = (Mat v18 v19,(NONE :locs option))) ∧ (∀(v22 :exp) (v21 :exp) (v20 :mlstring option). strip_loc_expr (Let v20 v21 v22) = (Let v20 v21 v22,(NONE :locs option))) ∧ (∀(v24 :exp) (v23 :(mlstring # mlstring # exp) list). strip_loc_expr (Letrec v23 v24) = (Letrec v23 v24,(NONE :locs option))) ∧ ∀(v26 :ast_t) (v25 :exp). strip_loc_expr (Tannot v25 v26) = (Tannot v25 v26,(NONE :locs option))
mkAst_App_def_typed=∀(a1 :exp) (a2 :exp). mkAst_App a1 a2 = (let ((a10 :exp),(loc1 :locs option)) = strip_loc_expr a1 in dest_Conk a10 (λ(nm_opt :(mlstring, mlstring) id option) (args :exp list). if nm_opt = SOME (Short «Ref» :(mlstring, mlstring) id) ∧ NULL args then App Opref [a2] else (let ((a2' :exp),(loc2 :locs option)) = strip_loc_expr a2 in optLannot (merge_locsopt loc1 loc2) (Con nm_opt (args ++ [a2'])))) (case a10 of Raise v28 => App Opapp [a1; a2] | Handle v29 v30 => App Opapp [a1; a2] | Lit v31 => App Opapp [a1; a2] | Con v32 v33 => App Opapp [a1; a2] | Var v34 => App Opapp [a1; a2] | Fun v35 v36 => App Opapp [a1; a2] | App opn args => (case destFFIop opn of (NONE :mlstring option) => App Opapp [a1; a2] | SOME s => App opn (args ++ [a2])) | Log v39 v40 v41 => App Opapp [a1; a2] | If v42 v43 v44 => App Opapp [a1; a2] | Mat v45 v46 => App Opapp [a1; a2] | Let v47 v48 v49 => App Opapp [a1; a2] | Letrec v50 v51 => App Opapp [a1; a2] | Tannot v52 v53 => App Opapp [a1; a2] | Lannot v54 v55 => App Opapp [a1; a2]))
dePat_def_typed=dePat (Pvar (v :mlstring)) (b :exp) = (v,b) ∧ dePat Pany b = («»,Mat (Var (Short «» :(mlstring, mlstring) id)) [(Pany,b)]) ∧ dePat (Plit (v4 :lit)) b = («»,Mat (Var (Short «» :(mlstring, mlstring) id)) [(Plit v4,b)]) ∧ dePat (Pcon (v5 :(mlstring, mlstring) id option) (v6 :pat list)) b = («»,Mat (Var (Short «» :(mlstring, mlstring) id)) [(Pcon v5 v6,b)]) ∧ dePat (Pref (v7 :pat)) b = («»,Mat (Var (Short «» :(mlstring, mlstring) id)) [(Pref v7,b)]) ∧ dePat (Pas (v8 :pat) (v9 :mlstring)) b = («»,Mat (Var (Short «» :(mlstring, mlstring) id)) [(Pas v8 v9,b)]) ∧ dePat (Ptannot (v10 :pat) (v11 :ast_t)) b = («»,Mat (Var (Short «» :(mlstring, mlstring) id)) [(Ptannot v10 v11,b)])
mkFun_def_typed=∀(p :pat) (b :exp). mkFun p b = UNCURRY Fun (dePat p b)
letFromPat_def_typed=∀(p :pat) (rhs :exp) (body :exp). letFromPat p rhs body = case p of Pany => Let (NONE :mlstring option) rhs body | Pvar v => Let (SOME v) rhs body | Plit v11 => Mat rhs [(p,body)] | Pcon v12 v13 => Mat rhs [(p,body)] | Pref v14 => Mat rhs [(p,body)] | Pas v15 v16 => Mat rhs [(p,body)] | Ptannot v17 v18 => Mat rhs [(p,body)]
ptree_StructName_def_typed=ptree_StructName (Lf (v0 :(token, MMLnonT) symbol # α)) = (NONE :mlstring option) ∧ ptree_StructName (Nd (nm :(MMLnonT + num) # α) (args :(token, MMLnonT, α) parsetree list)) = if FST nm ≠ mkNT nStructName then (NONE :mlstring option) else case args of ([] :(token, MMLnonT, α) parsetree list) => (NONE :mlstring option) | [pt] => OPTION_BIND (OPTION_BIND (destLf pt) (destTOK :(token, MMLnonT) symbol -> token option)) destAlphaT | pt::v6::v7 => (NONE :mlstring option)
