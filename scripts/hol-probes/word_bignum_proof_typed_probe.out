code_subset_refl_typed=∀(c1 :α # (β # γ) list). code_subset c1 c1
code_subset_trans_typed=∀(c1 :α # (β # γ) list) (c2 :δ # (β # γ) list) (c3 :ε # (β # γ) list). code_subset c1 c2 ∧ code_subset c2 c3 ⇒ code_subset c1 c3
compile_IMP_code_subset_typed=∀(prog :α mini) (n :num) (l :num) (i :num) (cs :num # (α mini # num # α prog) list) (p1 :α prog) (l1 :num) (i1 :num) (cs1 :num # (α mini # num # α prog) list). compile n l i cs prog = (p1,l1,i1,cs1) ⇒ code_subset cs cs1 ∧ i ≤ i1
has_compiled_lemma_typed=state_rel (s1 :α state) (t1 :(α, β, γ) wordSem$state) (cs2 :δ # (α mini # num # α prog) list) (t0 :(α, β, γ) wordSem$state) (frame :(α word # α word_loc -> bool) -> bool) ∧ has_compiled (p :α mini) (cs :num # (α mini # num # α prog) list) = (INL (x :num) :num + num) ∧ code_subset cs cs2 ⇒ ∃(cs0 :ε) (p1 :α prog) (l1 :num) (i1 :num) (cs' :num # (α mini # num # α prog) list) (cs1 :num # (α mini # num # α prog) list). compile x (2 :num) (1 :num) cs' p = (p1,l1,i1,cs1) ∧ code_subset cs1 cs2 ∧ lookup x t1.code = SOME ((1 :num),Seq p1 (Return (0 :num) [(0 :num)] :α prog))
state_rel_IN_FDOM_typed=state_rel (s1 :α state) (t1 :(α, β, γ) wordSem$state) (cs2 :δ # (α mini # num # α prog) list) (t0 :(α, β, γ) wordSem$state) (frame :(α word # α word_loc -> bool) -> bool) ∧ (r :num) ∈ FDOM s1.regs ⇒ Temp (n2w r :word5) ∈ FDOM t1.store ∧ t1.store⟨Temp (n2w r :word5)⟩ = Word s1.regs⟨r⟩
compile_exp_thm_typed=state_rel (s1 :α state) (t1 :(α, β, γ) wordSem$state) (cs2 :δ # (α mini # num # α prog) list) (t0 :(α, β, γ) wordSem$state) (frame :(α word # α word_loc -> bool) -> bool) ∧ eval_exp_pre s1 (x :α exp) ∧ good_dimindex (:α) ⇒ (word_exp t1 (compile_exp x) :α word_loc option) = SOME (Word (eval_exp s1 x))
evaluate_SeqTemp_typed=evaluate (SeqTemp (i :num) (r :num) (p :α prog),(t :(α, β, γ) wordSem$state)) = if Temp (n2w r :word5) ∈ FDOM t.store then evaluate (p,set_var i t.store⟨Temp (n2w r :word5)⟩ t) else evaluate (SeqTemp i r p,t)
evaluate_SeqTempImm_typed=evaluate (SeqTempImm (i :num) (ri :α reg_imm) (p :α prog),(t :(α, β, γ) wordSem$state)) = if ∀(r :num). ri = (Reg r :α reg_imm) ⇒ Temp (n2w r :word5) ∈ FDOM t.store then evaluate (p,set_var i (case ri of (Reg r :α reg_imm) => t.store⟨Temp (n2w r :word5)⟩ | Imm w => Word w) t) else evaluate (SeqTempImm i ri p,t)
evaluate_SeqTempImmNot_typed=evaluate (SeqTempImmNot (i :num) (ri :α reg_imm) (p :α prog),(t :(α, β, γ) wordSem$state)) = if ∀(r :num). ri = (Reg r :α reg_imm) ⇒ Temp (n2w r :word5) ∈ FDOM t.store ∧ ∃(w :α word). t.store⟨Temp (n2w r :word5)⟩ = Word w then evaluate (p,set_var i (case ri of (Reg r :α reg_imm) => (case t.store⟨Temp (n2w r :word5)⟩ of Word w => Word (¬w) | (Loc v1 v2 :α word_loc) => (ARB :α word_loc)) | Imm w => Word (¬w)) t) else evaluate (SeqTempImmNot i ri p,t)
LESS_LENGTH_IMP_APPEND_typed=∀(xs :α list) (n :num). n < LENGTH xs ⇒ ∃(ys :α list) (z :α) (zs :α list). xs = ys ++ z::zs ∧ LENGTH ys = n
shift_eq_bytes_in_word_typed=good_dimindex (:α) ⇒ (w :α word) ≪ (shift (:α) MOD dimword (:α)) = w * (bytes_in_word :α word)
b2w_if_typed=(b2w (b :bool) :α word) = if b then (1w :α word) else (0w :α word)
b2n_if_typed=b2n (b :bool) = if ¬b then (0 :num) else (1 :num)
list_update_alist_insert_typed=∀(xs :num list) (ys :α list) (t :α sptree$num_map). LENGTH xs = LENGTH ys ⇒ list_update xs ys t = alist_insert xs ys t
domain_list_update_typed=∀(xs :num list) (ys :α list) (x :num) (t :α sptree$num_map). x ∈ (domain (list_update xs ys t) :num -> bool) ⇔ MEM x xs ∨ x ∈ (domain t :num -> bool)
list_store_FUPDATE_typed=∀(save_regs :num list) (st :store_name |-> α word_loc) (ys :α word_loc list). ¬MEM (h :num) save_regs ∧ h < (max_var_name :num) ∧ EVERY (λ(n :num). n < max_var_name) save_regs ⇒ list_store save_regs ys st⟨Temp (n2w h :word5) ↦ Word (v :α word)⟩ = (list_store save_regs ys st)⟨Temp (n2w h :word5) ↦ Word v⟩
FLOOKUP_list_store_ignore_typed=∀(save_regs :num list) (vals :α list) (st :store_name |-> α). EVERY (λ(n :num). n < (max_var_name :num)) save_regs ⇒ FLOOKUP (list_store save_regs vals st) TempIn1 = FLOOKUP st TempIn1 ∧ FLOOKUP (list_store save_regs vals st) TempIn2 = FLOOKUP st TempIn2 ∧ FLOOKUP (list_store save_regs vals st) TempOut = FLOOKUP st TempOut ∧ ∀(n :store_name). (∀(r :word5). n ≠ Temp r) ⇒ FLOOKUP (list_store save_regs vals st) n = FLOOKUP st n
copy_vars_const_typed=∀(save_regs :num list) (s2 :α state) (s3 :α state). copy_vars save_regs (s1 :α state).regs s2 = SOME s3 ⇒ s3.clock = s2.clock ∧ s3.arrays = s2.arrays
lookup_list_update_ADD_2_typed=∀(save_regs :num list) (ws :α list). lookup (0 :num) (list_update (MAP (λ(n :num). n + (2 :num)) save_regs) ws (l :α sptree$num_map)) = lookup (0 :num) l
copy_vars_ignore_typed=∀(save_regs :num list) (regs :num |-> α word) (s2 :α state) (s3 :α state). copy_vars save_regs regs s2 = SOME s3 ∧ ¬MEM (a :num) save_regs ∧ a < (max_var_name :num) ∧ EVERY (λ(n :num). n < max_var_name) save_regs ⇒ s3.regs⟨a⟩ = s2.regs⟨a⟩
copy_vars_IMP_typed=∀(save_regs :num list) (s2 :α state) (s3 :α state). copy_vars save_regs (s1 :α state).regs s2 = SOME s3 ⇒ ∃(vals :α word list). LIST_REL (λ(n :num) (v :α word). FLOOKUP s1.regs n = SOME v) save_regs vals
LIST_REL_lemma_typed=∀(xs :α list) (ys :β list). (∀(x :α) (y :β). MEM x xs ∧ MEM y ys ⇒ (P :α -> β -> bool) x y ⇒ (Q :α -> β -> bool) x y) ⇒ LIST_REL P xs ys ⇒ LIST_REL Q xs ys
compile_LESS_mini_size_typed=∀(k :num) (l1 :num) (l2 :num) (yy5 :num # (α mini # num # α prog) list) (code :α mini) (xx1 :α prog) (xx2 :num) (xx3 :num) (xx5 :num # (α mini # num # α prog) list). compile k l1 l2 yy5 code = (xx1,xx2,xx3,xx5) ⇒ ∀(x :α mini # num # α prog). MEM x (SND xx5) ∧ ¬MEM x (SND yy5) ⇒ mini_size (K (0 :num) :α -> num) (FST x) < mini_size (K (0 :num) :α -> num) code
MEM_compile_typed=∀(k :num) (l1 :num) (l2 :num) (yy5 :num # (α mini # num # α prog) list) (code :α mini) (xx1 :α prog) (xx2 :num) (xx3 :num) (xx5 :num # (α mini # num # α prog) list). good_code yy5 ∧ compile k l1 l2 yy5 code = (xx1,xx2,xx3,xx5) ⇒ good_code xx5
loop_app_EQ_typed=(loop_app (f :β -> α state + α state) (g :β -> bool) (x :β) = ((INR (t :α state) :α state + α state),T) ⇔ f x = (INR t :α state + α state) ∧ g x) ∧ (loop_app f g x = ((INL t :α state + α state),T) ⇔ ∃(x' :α state). f x = (INL x' :α state + α state) ∧ dec_clock x' = t ∧ g x ∧ x'.clock ≠ (0 :num))
true_pres_typed=mc_single_mul_pre ((r0 :α word),(r1 :α word),(r2 :α word)) ∧ mc_mul_by_single2_pre ((r6 :α word),(r7 :α word),(r8 :α word)) ∧ mc_cmp3_pre (r1,r2,(r3 :α word),(r9 :α word),(r10 :α word),(r11 :α word)) ∧ mc_cmp_mul2_pre (r6,r7,r8,r9,r10,r11) ∧ mc_cmp2_pre (r0,r2,r10,r11) ∧ mc_adj_cmp_pre (r0,r3,r8) ∧ mc_idiv_mod_header_pre (r6,r11) ∧ mc_iadd1_pre (r1,r2,(xs :α word list),(ys :α word list)) ∧ mc_iadd2_pre (r1,r2,r3,(r4 :α word),xs,ys) ∧ mc_iadd3_pre (r1,xs,ys) ∧ mc_isub_flip_pre (r1,r2) ∧ mc_imul1_pre (r10,r11) ∧ mc_sub1_pre r6 ∧ mc_cmp2_pre (r0,r2,r10,r11)
dec_clock_thm_typed=dec_clock (s :α state) = clock_write (s.clock − (1 :num)) s
array_write_cancel_typed=array_write (n :address) ((s :α state).arrays n) s = s
reg_write_cancel_typed=((n :num) ∈ FDOM (s :α state).regs ⇒ reg_write n (SOME s.regs⟨n⟩) s = s) ∧ (n ∉ FDOM s.regs ⇒ reg_write n (NONE :α word option) s = s)
state_eq_lemma_typed=(s0 :α state) = (s1 :α state) ⇔ s0.clock = s1.clock ∧ FDOM s0.regs = FDOM s1.regs ∧ (∀(n :num). n ∈ FDOM s0.regs ⇒ s0.regs⟨n⟩ = s1.regs⟨n⟩) ∧ ∀(n :address). s0.arrays n = s1.arrays n
clock_write_simp_typed=(clock_write (n :num) (s :α state)).regs = s.regs ∧ (clock_write n s).arrays = s.arrays ∧ (clock_write n s).clock = n
dec_clock_write_simp_typed=(dec_clock (s :α state)).regs = s.regs ∧ (dec_clock s).arrays = s.arrays ∧ (dec_clock s).clock = s.clock − (1 :num)
reg_write_simp_typed=(reg_write (n :num) (NONE :α word option) (s :α state)).regs = s.regs \\ n ∧ (reg_write n (SOME (w :α word)) s).regs = s.regs⟨n ↦ w⟩ ∧ (reg_write n (v :α word option) s).arrays = s.arrays ∧ (reg_write n v s).clock = s.clock
array_write_simp_typed=(array_write (n :address) (w :α word list) (s :α state)).regs = s.regs ∧ (array_write n w s).arrays = s.arrays⦇n ↦ w⦈ ∧ (array_write n w s).clock = s.clock
delete_vars_simp_typed=∀(vs :num list). (delete_vars vs (s :α state)).clock = s.clock ∧ (delete_vars vs s).arrays = s.arrays ∧ FLOOKUP (delete_vars vs s).regs (n :num) = (if MEM n vs then (NONE :α word option) else FLOOKUP s.regs n) ∧ (n ∈ FDOM (delete_vars vs s).regs ⇔ if MEM n vs then F else n ∈ FDOM s.regs)
reg_read_lemma1_typed=∀(v :α word) (n :num). FLOOKUP (s :α state).regs n = SOME v ⇒ (n ∈ FDOM s.regs ⇔ T)
reg_read_lemma2_typed=∀(v :α word) (n :num). FLOOKUP (s :α state).regs n = SOME v ⇒ s.regs⟨n⟩ = v
array_read_lemma_typed=∀(v :α word list) (n :address). (s :α state).arrays n = v ⇒ s.arrays n = v
clock_read_lemma_typed=(s :α state).clock = (l :num) ⇒ s.clock = l
i2mw_NOT_NIL_typed=SND (i2mw (i2 :int) :bool # α word list) ≠ ([] :α word list) ⇔ i2 ≠ (0 :int)
mw_ok_SND_i2mw_typed=mw_ok (SND (i2mw (fg :int) :bool # α word list))
