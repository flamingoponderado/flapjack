state_orac_states_typed=(∀(f :α -> β -> α # γ) (st :α) (progs :num -> β). state_orac_states f st progs (0 :num) = st) ∧ ∀(f :α -> β -> α # γ) (st :α) (progs :num -> β) (n :num). state_orac_states f st progs (SUC n) = FST (f (state_orac_states f st progs n) (progs n))
state_orac_states_inv_typed=(P :α -> bool) (st :α) ∧ (∀(st :α) (prog :β) (st' :α) (prog' :γ). (f_inc :α -> β -> α # γ) st prog = (st',prog') ∧ P st ⇒ P st') ⇒ P (state_orac_states f_inc st (orac :num -> β) (i :num))
oracle_monotonic_state_with_inv_init_typed=∀(P :α -> bool) (n_f :α -> num). (f_inc :α -> γ -> α # β) (st0 :α) (prog0 :γ) = ((st :α),(prog :β)) ∧ P st0 ∧ (St :num -> bool) ⊆ (f :δ # β -> num -> bool) ((cfg :δ),prog) ∧ FST (FST ((orac :num -> (α # δ) # γ) (0 :num))) = st ∧ (∀(st :α) (prog :γ) (st' :α) (prog' :β). f_inc st prog = (st',prog') ∧ P st ⇒ P st' ∧ n_f st ≤ n_f st' ∧ ∀(cfg :δ) (x :num). x ∈ f (cfg,prog') ⇒ n_f st ≤ x ∧ x < n_f st') ∧ is_state_oracle f_inc orac ⇒ oracle_monotonic f $< St (state_co f_inc orac)
oracle_monotonic_state_typed=∀(n_f :α -> num). (∀(x :num). x ∈ (St :num -> bool) ⇒ x < n_f (FST (FST ((orac :num -> (α # β) # γ) (0 :num))))) ∧ (∀(st :α) (prog :γ) (st' :α) (prog' :δ). (f_inc :α -> γ -> α # δ) st prog = (st',prog') ⇒ n_f st ≤ n_f st' ∧ ∀(cfg :β) (x :num). x ∈ (f :β # δ -> num -> bool) (cfg,prog') ⇒ n_f st ≤ x ∧ x < n_f st') ∧ is_state_oracle f_inc orac ⇒ oracle_monotonic f $< St (state_co f_inc orac)
oracle_monotonic_state_init_typed=∀(n_f :α -> num). (f_inc :α -> γ -> α # β) (st0 :α) (prog0 :γ) = ((st :α),(prog :β)) ∧ (St :num -> bool) ⊆ (f :δ # β -> num -> bool) ((cfg :δ),prog) ∧ FST (FST ((orac :num -> (α # δ) # γ) (0 :num))) = st ∧ (∀(st :α) (prog :γ) (st' :α) (prog' :β). f_inc st prog = (st',prog') ⇒ n_f st ≤ n_f st' ∧ ∀(cfg :δ) (x :num). x ∈ f (cfg,prog') ⇒ n_f st ≤ x ∧ x < n_f st') ∧ is_state_oracle f_inc orac ⇒ oracle_monotonic f $< St (state_co f_inc orac)
state_co_progs_typed=∀(f :β -> γ -> β # α) (st :β) (orac :num -> γ). state_co_progs f st orac = (let (states :num -> β) = state_orac_states f st orac in λ(i :num). SND (f (states i) (orac i)))
add_state_co_typed=∀(f :α -> γ -> α # δ) (st :α) (mk :(num -> δ) -> num -> β) (progs :num -> γ). add_state_co f st mk progs = (let (states :num -> α) = state_orac_states f st progs; (next_progs :num -> δ) = state_co_progs f st progs; (next_orac :num -> β) = mk next_progs in λ(i :num). (states i,next_orac i))
syntax_to_full_oracle_typed=∀(mk :(γ -> β) -> γ -> α) (progs :γ -> β) (i :γ). syntax_to_full_oracle mk progs i = (mk progs i,progs i)
state_oracle_example=(state_orac_states (λ(s :num) (p :num). ((2 :num) * s + p,s + p)) (3 :num) (λ(n :num). n + (1 :num)) (3 :num),state_co_progs (λ(s :num) (p :num). ((2 :num) * s + p,s + p)) (3 :num) (λ(n :num). n + (1 :num)) (2 :num),add_state_co (λ(s :num) (p :num). ((2 :num) * s + p,s + p)) (3 :num) (λ(xs :num -> num) (i :num). xs i + (10 :num)) (λ(n :num). n + (1 :num)) (2 :num)) = ((35 :num),(19 :num),(16 :num),(29 :num))
