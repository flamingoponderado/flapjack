build_rec_env_help_lem_typed=∀(funs :(mlstring # α # β) list) (env :v environment) (funs' :(mlstring # mlstring # exp) list). FOLDR (λ((f :mlstring),(x :α),(e :β)) (env' :(mlstring # v) list). (f,(Recclosure env funs' f :v))::env') (env' :(mlstring # v) list) funs = MAP (λ((fn :mlstring),(n :α),(e :β)). (fn,(Recclosure env funs' fn :v))) funs ++ env'
do_app_add_to_clock_typed=do_app (s :(γ, 'ffi) state) (op :op) (es :v list) = SOME ((t :(γ, 'ffi) state),(r :(v, v) result)) ⇒ do_app (s with clock := s.clock + (k :num)) op es = SOME (t with clock := t.clock + k,r)
do_app_add_to_clock_NONE_typed=do_app (s :(γ, 'ffi) state) (op :op) (es :v list) = (NONE :((γ, 'ffi) state # (v, v) result) option) ⇒ do_app (s with clock := s.clock + (k :num)) op es = (NONE :((γ, 'ffi) state # (v, v) result) option)
check_type_LIST_REL_same_typed=LIST_REL (vr :v -> v -> bool) (vs1 :v list) (vs2 :v list) ∧ EVERY (check_type (ty :prim_type) :semanticPrimitives$v -> bool) (MAP flat_to_v vs1) ∧ simple_val_rel vr ⇒ vs2 = vs1
evaluate_decs_add_to_clock_initial_state_typed=(r :v error_result option) ≠ SOME (Rabort Rtimeout_error :v error_result) ∧ (evaluate_decs (initial_state (ffi :β ffi_state) (k :num) (ec :α install_config)) (decs :exp list) :(α, β) state # v error_result option) = ((s' :(α, β) state),r) ⇒ (evaluate_decs (initial_state ffi ((ck :num) + k) ec) decs :(α, β) state # v error_result option) = (s' with clock := s'.clock + ck,r)
evaluate_decs_add_to_clock_initial_state_io_events_mono_typed=(evaluate_decs (initial_state (ffi :β ffi_state) (k :num) (ec :α install_config)) (prog :exp list) :(α, β) state # v error_result option) = ((s' :(α, β) state),(r :v error_result option)) ⇒ s'.ffi.io_events ≼ (FST (evaluate_decs (initial_state ffi (k + (ck :num)) ec) prog :(α, β) state # v error_result option)).ffi.io_events
initial_state_with_clock_typed=initial_state (ffi :β ffi_state) (k :num) (ec :α install_config) with clock := (initial_state ffi k ec).clock + (ck :num) = initial_state ffi (k + ck) ec
