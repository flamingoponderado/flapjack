arith_keys_eq_typed=∀(a1 :α arith) (a2 :α arith). can_mem_arith a1 ∧ arithToNumList a1 = arithToNumList a2 ⇒ can_mem_arith a2 ∧ arithReads a2 = arithReads a1 ∧ ∀(s :(α, γ, 'ffi) state) (w :α word_loc). evaluate ((Inst (Arith a1 :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a1) w s) ⇒ evaluate ((Inst (Arith a2 :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a2) w s)
canonicalRegs_correct_typed=∀(data :knowledge) (r :num) (s :(α, β, γ) state). data_inv data s ⇒ get_var (canonicalRegs data r) s = get_var r s
canonicalRegs_correct_bis_typed=∀(data :knowledge) (r :num) (s :(α, β, γ) state). data_inv data s ⇒ (lookup (canonicalRegs data r) s.locals :α word_loc option) = (lookup r s.locals :α word_loc option)
comp_correct_typed=∀(v :α prog) (v1 :(α, β, γ) state) (res :α result option) (s' :(α, β, γ) state) (data :knowledge) (p' :α prog) (data' :knowledge). evaluate (v,v1) = (res,s') ∧ flat_exp_conventions v ∧ data_inv data v1 ∧ res ≠ SOME (Error :α result) ∧ word_cse data v = (data',p') ⇒ evaluate (p',v1) = (res,s') ∧ (res = (NONE :α result option) ⇒ data_inv data' s')
word_common_subexp_elim_correct_typed=evaluate ((p :α prog),(s :(α, β, γ) state)) = ((res :α result option),(s1 :(α, β, γ) state)) ∧ flat_exp_conventions p ∧ res ≠ SOME (Error :α result) ⇒ evaluate (word_common_subexp_elim p,s) = (res,s1)
every_inst_distinct_tar_reg_word_common_subexp_elim_typed=every_inst (distinct_tar_reg :α inst -> bool) (p :α prog) ⇒ every_inst (distinct_tar_reg :α inst -> bool) (word_common_subexp_elim p)
full_inst_ok_less_word_common_subexp_elim_typed=full_inst_ok_less (ac :α asm_config) (p :α prog) ⇒ full_inst_ok_less ac (word_common_subexp_elim p)
pre_alloc_conventions_word_common_subexp_elim_typed=pre_alloc_conventions (p :α prog) ⇒ pre_alloc_conventions (word_common_subexp_elim p)
word_cse_every_inst_distinct_tar_reg_typed=∀(p :α prog) (data :knowledge) (data' :knowledge) (q :α prog). every_inst (distinct_tar_reg :α inst -> bool) p ∧ word_cse data p = (data',q) ⇒ every_inst (distinct_tar_reg :α inst -> bool) q
word_cse_every_inst_two_reg_typed=∀(p :α prog) (data :knowledge) (data' :knowledge) (q :α prog). every_inst (two_reg_inst :α inst -> bool) p ∧ word_cse data p = (data',q) ⇒ every_inst (two_reg_inst :α inst -> bool) q
word_cse_full_inst_ok_less_typed=∀(p :α prog) (data :knowledge) (c :α asm_config) (data' :knowledge) (q :α prog). full_inst_ok_less c p ∧ word_cse data p = (data',q) ⇒ full_inst_ok_less c q
word_cse_pre_alloc_conventions_typed=∀(p :α prog) (data :knowledge) (data' :knowledge) (q :α prog). pre_alloc_conventions p ∧ word_cse data p = (data',q) ⇒ pre_alloc_conventions q
canonicalArith_correct_typed=∀(data :knowledge) (s :(α, β, γ) state) (a :α arith). data_inv data s ⇒ inst (Arith (canonicalArith data a) :α inst) s = inst (Arith a :α inst) s
data_inv_locals_typed=∀(s :(α, β, γ) state). s with locals := s.locals = s
data_inv_memory_typed=∀(data :knowledge) (s :(α, β, γ) state) (m :α word -> α word_loc). data_inv data s ⇒ data_inv (data with loads_mem := (empty :(num list, num) balanced_map)) (s with memory := m)
data_inv_set_var_typed=∀(data :knowledge) (s :(α, β, γ) state) (n :num) (v :α word_loc). (lookup n data.to_canonical :num option) = (NONE :num option) ⇒ (data_inv data (set_var n v s) ⇔ data_inv data s)
data_inv_state_agree_typed=∀(data :knowledge) (s1 :(α, γ, 'ffi) state) (s2 :(α, γ, 'ffi) state). data_inv data s1 ∧ s2.locals = s1.locals ∧ s2.store = s1.store ∧ s2.memory = s1.memory ∧ s2.mdomain = s1.mdomain ∧ (s2.be ⇔ s1.be) ⇒ data_inv data s2
data_inv_unset_var_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (n :num). (lookup n data.to_canonical :num option) = (NONE :num option) ⇒ (data_inv data (unset_var n s) ⇔ data_inv data s)
not_seen_data_inv_alist_insert_typed=∀(data :knowledge) (s :(α, β, γ) state) (l :α word_loc sptree$num_map) (r :num) (v :α word_loc). (lookup r data.to_canonical :num option) = (NONE :num option) ⇒ data_inv data (s with locals := l) ⇒ data_inv data (s with locals := (insert r v l :α word_loc sptree$num_map))
wf_data_untracked_typed=∀(data :knowledge) (n :num). wf_data (:α) data ∧ (lookup n data.to_canonical :num option) = (NONE :num option) ⇒ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ r ≠ n ∧ v ≠ n) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ r ≠ n ∧ v ≠ n) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.instrs_mem :num option) = SOME v ⇒ v ≠ n) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ ¬MEM n (arithReads a) ∧ can_mem_arith a) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ src ≠ n) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ v ≠ n) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.loads_mem :num option) = SOME v ⇒ v ≠ n) ∧ ∀(op :memop) (a :num) (ofs :α word) (v :num). (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ a ≠ n
data_inv_insert_to_canonical_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num). data_inv data s ∧ (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y (insert x y data.to_canonical :num sptree$num_map) :num option) = SOME y ∧ ODD x ∧ ODD y ∧ get_var x s = get_var y s ⇒ data_inv (data with to_canonical := (insert x y data.to_canonical :num sptree$num_map)) s
data_inv_insert_to_latest_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :num) (y :num). data_inv data s ∧ x ∈ (domain data.to_canonical :num -> bool) ∧ y ∈ (domain data.to_canonical :num -> bool) ∧ get_var x s = get_var y s ⇒ data_inv (data with to_latest := (insert x y data.to_latest :num sptree$num_map)) s
data_inv_merge_l_typed=∀(d1 :knowledge) (d2 :knowledge) (s :(α, γ, 'ffi) state). wf_data (:α) d1 ∧ wf_data (:α) d2 ∧ sem_inv d1 s ⇒ data_inv (merge_data d1 d2) s
data_inv_merge_r_typed=∀(d1 :knowledge) (d2 :knowledge) (s :(α, γ, 'ffi) state). wf_data (:α) d1 ∧ wf_data (:α) d2 ∧ sem_inv d2 s ⇒ data_inv (merge_data d1 d2) s
data_inv_register_read_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num). data_inv data s ⇒ data_inv (register_read data r) s
data_inv_register_reads_typed=∀(rs :num list) (data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ⇒ data_inv (register_reads data rs) s
data_inv_set_fp_var_typed=∀(data :knowledge) (v :num) (x :word64) (s :(α, γ, 'ffi) state). data_inv data (set_fp_var v x s) ⇔ data_inv data s
data_inv_set_store_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (x :store_name) (w :α word_loc). data_inv data s ∧ x ≠ CurrHeap ∧ ALOOKUP data.gets_mem x = (NONE :num option) ⇒ data_inv data (set_store x w s)
data_inv_set_vars_typed=∀(xs :num list) (ys :α word_loc list) (data :knowledge) (s :(α, γ, 'ffi) state). EVERY (λ(x :num). (lookup x data.to_canonical :num option) = (NONE :num option)) xs ⇒ (data_inv data (set_vars xs ys s) ⇔ data_inv data s)
empty_data_loads_wipe_typed=empty_data with loads_mem := (empty :(num list, num) balanced_map) = empty_data
evaluate_Move1_typed=∀(pri :num) (r :num) (k :num) (w :α word_loc) (s :(α, γ, 'ffi) state). get_var k s = SOME w ⇒ evaluate ((Move pri [(r,k)] :α prog),s) = ((NONE :α result option),set_var r w s)
lookup_empty_data_typed=(lookup (r :num) empty_data.to_canonical :num option) = (NONE :num option)
evaluate_arith_set_var_typed=∀(a :α arith) (r :num) (u :α word_loc) (w :α word_loc) (s :(α, β, γ) state). can_mem_arith a ∧ ¬MEM r (arithReads a) ⇒ (evaluate ((Inst (Arith a :α inst) :α prog),set_var r u s) = ((NONE :α result option),set_var (firstRegOfArith a) w (set_var r u s)) ⇔ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s))
add_to_data_Arith_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (a :α arith) (a' :α arith) (r :num) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ a' = canonicalArith data a ∧ can_mem_arith a' ∧ ¬MEM r (arithReads a') ∧ r = firstRegOfArith a ∧ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var r w s) ∧ add_to_data (register_reads data (arithReads a')) r (Arith a' :α inst) (Arith a :α inst) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_data_LocValue_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (l :num) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ l ∈ (domain s.code :num -> bool) ∧ add_to_data_aux data r [(48 :num); l] (LocValue r l :α prog) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r (Loc l (0 :num) :α word_loc) s) ∧ data_inv data' (set_var r (Loc l (0 :num) :α word_loc) s)
add_to_data_OpCurrHeap_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (b :binop) (r1 :num) (r2 :num) (r2' :num) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r1 data.to_canonical :num option) = (NONE :num option) ∧ r2' = canonicalRegs' r1 data r2 ∧ ¬EVEN r2 ∧ r2 ≠ r1 ∧ (word_exp s (Op b [(Var r2 :α exp); (Lookup CurrHeap :α exp)]) :α word_loc option) = SOME w ∧ add_to_data_aux (register_read data r2') r1 (OpCurrHeapToNumList b r2') (OpCurrHeap b r1 r2 :α prog) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r1 w s) ∧ data_inv data' (set_var r1 w s)
add_to_data_aux_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (i :num list) (p :α prog) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_data_aux data r i p = (data',p') ∧ evaluate (p,s) = ((NONE :α result option),set_var r w s) ∧ (∀(v :num). (lookup listCmp i data.instrs_mem :num option) = SOME v ⇒ get_var v s = SOME w) ∧ (¬EVEN r ⇒ data_inv (data with <|instrs_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).instrs_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>) (set_var r w s)) ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_data_const_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (w :α word) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ ¬EVEN r ∧ add_to_data_const data r w = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r (Word w) s) ∧ data_inv data' (set_var r (Word w) s)
add_to_load_aux_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (r :num) (i :num list) (p :α prog) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_load_aux data r i p = (data',p') ∧ evaluate (p,s) = ((NONE :α result option),set_var r w s) ∧ (∀(v :num). (lookup listCmp i data.loads_mem :num option) = SOME v ⇒ get_var v s = SOME w) ∧ (¬EVEN r ⇒ data_inv (data with <|loads_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).loads_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>) (set_var r w s)) ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
add_to_load_correct_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (op :memop) (r :num) (a :num) (a' :num) (ofs :α word) (w :α word_loc) (data' :knowledge) (p' :α prog). data_inv data s ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ a' = canonicalRegs' r data a ∧ ¬is_store op ∧ ¬EVEN r ∧ ¬EVEN a ∧ a ≠ r ∧ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s) ∧ add_to_load_aux (register_read data a') r (loadToNumList op a' ofs) (Inst (Mem op r (Addr a ofs)) :α prog) = (data',p') ⇒ evaluate (p',s) = ((NONE :α result option),set_var r w s) ∧ data_inv data' (set_var r w s)
in_names_set_def_typed=∀(a :α arith) (tc :num sptree$num_map). in_names_set a tc ⇔ EVERY (λ(r :num). (lookup r tc :num option) = SOME r) (arithReads a)
insert_eq_typed=∀(n1 :num) (n2 :α) (v1 :β) (v2 :β) (l :β sptree$num_map). (insert n1 v1 l :β sptree$num_map) = (insert n1 v2 l :β sptree$num_map) ⇔ v1 = v2
bm_inter_eq_acc_thm_typed=∀(m2 :(num list, α) balanced_map) (m1 :(num list, α) balanced_map) (acc :(num list, α) balanced_map). invariant listCmp m2 ∧ invariant listCmp m1 ∧ invariant listCmp acc ⇒ invariant listCmp (bm_inter_eq_acc m2 m1 acc) ∧ ∀(ks :num list -> bool). FLOOKUP (to_fmap listCmp (bm_inter_eq_acc m2 m1 acc)) ks = case FLOOKUP (to_fmap listCmp m1) ks of (NONE :α option) => FLOOKUP (to_fmap listCmp acc) ks | SOME v => if FLOOKUP (to_fmap listCmp m2) ks = SOME v then SOME v else FLOOKUP (to_fmap listCmp acc) ks
lookup_bm_inter_eq_typed=∀(m1 :(num list, α) balanced_map) (m2 :(num list, α) balanced_map) (k :num list) (v :α). invariant listCmp m1 ∧ invariant listCmp m2 ⇒ ((lookup listCmp k (bm_inter_eq m1 m2) :α option) = SOME v ⇔ (lookup listCmp k m1 :α option) = SOME v ∧ (lookup listCmp k m2 :α option) = SOME v)
invariant_bm_inter_eq_typed=∀(m1 :(num list, α) balanced_map) (m2 :(num list, α) balanced_map). invariant listCmp m1 ∧ invariant listCmp m2 ⇒ invariant listCmp (bm_inter_eq m1 m2)
arithOpToNum_eq_typed=∀(op1 :binop) (op2 :binop). arithOpToNum op1 = arithOpToNum op2 ⇔ op1 = op2
memOpToNum_eq_typed=∀(op1 :memop) (op2 :memop). memOpToNum op1 = memOpToNum op2 ⇔ op1 = op2
shiftToNum_eq_typed=∀(s1 :ast$shift) (s2 :ast$shift). shiftToNum s1 = shiftToNum s2 ⇔ s1 = s2
wordToNum_unique_typed=∀(c1 :α word) (c2 :α word). wordToNum c1 = wordToNum c2 ⇔ c1 = c2
firstRegOfArith_canonicalArith_typed=∀(data :knowledge) (a :α arith). firstRegOfArith (canonicalArith data a) = firstRegOfArith a
invariant_listCmp_empty_typed=invariant listCmp (empty :(num list, α) balanced_map)
lookup_insert_listCmp_typed=∀(k :num list) (i :num list) (v :α) (m :(num list, α) balanced_map). invariant listCmp m ⇒ invariant listCmp (insert listCmp i v m :(num list, α) balanced_map) ∧ (lookup listCmp k (insert listCmp i v m :(num list, α) balanced_map) :α option) = if k = i then SOME v else (lookup listCmp k m :α option)
lookup_listCmp_empty_typed=(lookup listCmp (k :num list) (empty :(num list, α) balanced_map) :α option) = (NONE :α option)
lookup_register_read_typed=(lookup (x :num) (register_read (data :knowledge) (r :num)).to_canonical :num option) = if x = r ∧ ¬EVEN r ∧ (lookup r data.to_canonical :num option) = (NONE :num option) then SOME r else (lookup x data.to_canonical :num option)
lookup_register_reads_typed=∀(rs :num list) (data :knowledge) (x :num). (lookup x (register_reads data rs).to_canonical :num option) = if MEM x rs ∧ ¬EVEN x ∧ (lookup x data.to_canonical :num option) = (NONE :num option) then SOME x else (lookup x data.to_canonical :num option)
register_read_simps_typed=(register_read (data :knowledge) (r :num)).instrs_mem = data.instrs_mem ∧ (register_read data r).to_latest = data.to_latest ∧ (register_read data r).gets_mem = data.gets_mem ∧ (register_read data r).loads_mem = data.loads_mem
register_reads_simps_typed=∀(rs :num list) (data :knowledge). (register_reads data rs).instrs_mem = data.instrs_mem ∧ (register_reads data rs).to_latest = data.to_latest ∧ (register_reads data rs).gets_mem = data.gets_mem ∧ (register_reads data rs).loads_mem = data.loads_mem
antisym_listCmp_typed=∀(x :num list) (y :num list). listCmp x y = Greater ⇔ listCmp y x = Less
good_cmp_listCmp_typed=good_cmp listCmp
listCmpEq_correct_typed=∀(L1 :num list) (L2 :num list). listCmp L1 L2 = Equal ⇔ L1 = L2
TotOrd_listCmp_typed=TotOrd listCmp
transit_listCmp_typed=∀(x :num list) (y :num list) (z :num list). listCmp x y = Less ∧ listCmp y z = Less ⇒ listCmp x z = Less
evaluate_load_any_dest_typed=∀(op :memop) (r0 :num) (a :num) (ofs :α word) (w :α word_loc) (s :(α, β, γ) state) (r :num). ¬is_store op ∧ evaluate ((Inst (Mem op r0 (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r0 w s) ⇒ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s)
evaluate_load_set_var_typed=∀(op :memop) (r :num) (a :num) (ofs :α word) (n :num) (u :α word_loc) (w :α word_loc) (s :(α, β, γ) state). ¬is_store op ∧ a ≠ n ⇒ (evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),set_var n u s) = ((NONE :α result option),set_var r w (set_var n u s)) ⇔ evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s))
MEM_FST_reduc_typed=∀(moves :(α # β) list) (r :α) (p_2 :β). MEM (r,p_2) moves ⇒ MEM r (MAP (FST :α # β -> α) moves)
canonicalMoveRegs_lemma_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state) (rs :(num # num) list) (vs :α word_loc list). data_inv data s ∧ ALL_DISTINCT (MAP (FST :num # num -> num) rs) ∧ get_vars (MAP (SND :num # num -> num) rs) s = SOME vs ⇒ data_inv (canonicalMoveRegs data rs) (set_vars (MAP (FST :num # num -> num) rs) vs s)
data_inv_clock_typed=∀(data :knowledge) (s :(α, β, γ) state) (c :num) (td :num). data_inv data s ⇒ data_inv data (s with <|clock := c; termdep := td|>)
get_set_vars_lemma_typed=∀(xs :num list) (xs' :α word_loc list) (x :num) (y :num) (s :(α, β, γ) state). ¬MEM x xs ∧ ¬MEM y xs ⇒ get_var x s = get_var y s ⇒ get_var x (set_vars xs xs' s) = get_var y (set_vars xs xs' s)
lookup_map_insert0_typed=∀(xs :(num # α) list) (r :num). (lookup r (map_insert xs (m :α sptree$num_map)) :α option) = case ALOOKUP xs r of (NONE :α option) => (lookup r m :α option) | SOME r' => SOME r'
data_inv_def_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state). data_inv data s ⇔ wf_data (:α) data ∧ sem_inv data s
data_inv_empty_typed=∀(s :(α, β, γ) state). data_inv empty_data s
sem_inv_def_typed=∀(data :knowledge) (s :(α, γ, 'ffi) state). sem_inv data s ⇔ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ get_var r s = get_var v s) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ get_var r s = get_var v s) ∧ (∀(n :num) (c :α word) (v :num). (lookup listCmp (instToNumList (Const n c :α inst)) data.instrs_mem :num option) = SOME v ⇒ (lookup v s.locals :α word_loc option) = SOME (Word c)) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ ∃(w :α word_loc). get_var v s = SOME w ∧ evaluate ((Inst (Arith a :α inst) :α prog),s) = ((NONE :α result option),set_var (firstRegOfArith a) w s)) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ ∃(w :α word_loc). (word_exp s (Op op [(Var src :α exp); (Lookup CurrHeap :α exp)]) :α word_loc option) = SOME w ∧ get_var v s = SOME w) ∧ (∀(l :num) (v :num). (lookup listCmp [(48 :num); l] data.instrs_mem :num option) = SOME v ⇒ (lookup v s.locals :α word_loc option) = SOME (Loc l (0 :num) :α word_loc)) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ ∃(w :α word_loc). FLOOKUP s.store x = SOME w ∧ get_var v s = SOME w) ∧ ∀(op :memop) (a :num) (ofs :α word) (v :num). ¬is_store op ∧ (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ ∃(w :α word_loc). get_var v s = SOME w ∧ ∀(r :num). evaluate ((Inst (Mem op r (Addr a ofs)) :α prog),s) = ((NONE :α result option),set_var r w s)
wf_data_def_typed=∀(data :knowledge). wf_data (:α) data ⇔ (∀(r :num) (v :num). (lookup r data.to_canonical :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v ∧ ODD r ∧ ODD v) ∧ (∀(r :num) (v :num). (lookup r data.to_latest :num option) = SOME v ⇒ r ∈ (domain data.to_canonical :num -> bool) ∧ v ∈ (domain data.to_canonical :num -> bool)) ∧ (∀(k :num list) (v :num). (lookup listCmp k data.instrs_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(a :α arith) (v :num). (lookup listCmp (instToNumList (Arith a :α inst)) data.instrs_mem :num option) = SOME v ⇒ in_names_set a data.to_canonical ∧ can_mem_arith a) ∧ (∀(op :binop) (src :num) (v :num). (lookup listCmp (OpCurrHeapToNumList op src) data.instrs_mem :num option) = SOME v ⇒ (lookup src data.to_canonical :num option) = SOME src) ∧ (∀(x :store_name) (v :num). ALOOKUP data.gets_mem x = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ ALL_DISTINCT (MAP (FST :store_name # num -> store_name) data.gets_mem) ∧ invariant listCmp data.instrs_mem ∧ (∀(k :num list) (v :num). (lookup listCmp k data.loads_mem :num option) = SOME v ⇒ (lookup v data.to_canonical :num option) = SOME v) ∧ (∀(op :memop) (a :num) (ofs :α word) (v :num). (lookup listCmp (loadToNumList op a ofs) data.loads_mem :num option) = SOME v ⇒ (lookup a data.to_canonical :num option) = SOME a) ∧ invariant listCmp data.loads_mem
wf_data_empty_typed=wf_data (:α) empty_data
wf_data_insert_to_canonical_typed=∀(data :knowledge) (x :num) (y :num). wf_data (:α) data ∧ (lookup x data.to_canonical :num option) = (NONE :num option) ∧ (lookup y (insert x y data.to_canonical :num sptree$num_map) :num option) = SOME y ∧ ODD x ∧ ODD y ⇒ wf_data (:α) (data with to_canonical := (insert x y data.to_canonical :num sptree$num_map))
wf_data_insert_to_latest_typed=∀(data :knowledge) (x :num) (y :num). wf_data (:α) data ∧ x ∈ (domain data.to_canonical :num -> bool) ∧ y ∈ (domain data.to_canonical :num -> bool) ⇒ wf_data (:α) (data with to_latest := (insert x y data.to_latest :num sptree$num_map))
wf_data_invalidate_typed=∀(data :knowledge) (r :num). wf_data (:α) data ⇒ wf_data (:α) (invalidate_data data r)
wf_data_invalidate_regs_typed=∀(rs :num list) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (invalidate_regs data rs)
wf_data_loads_wipe_typed=∀(data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (data with loads_mem := (empty :(num list, num) balanced_map))
wf_data_merge_typed=∀(d1 :knowledge) (d2 :knowledge). wf_data (:α) d1 ∧ wf_data (:α) d2 ⇒ wf_data (:α) (merge_data d1 d2)
wf_data_register_read_typed=∀(data :knowledge) (r :num). wf_data (:α) data ⇒ wf_data (:α) (register_read data r)
wf_data_register_reads_typed=∀(rs :num list) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (register_reads data rs)
wf_add_to_data_aux_typed=∀(data :knowledge) (r :num) (i :num list) (p :α prog) (data' :knowledge) (p' :α prog). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_data_aux data r i p = (data',p') ∧ (¬EVEN r ⇒ wf_data (:α) (data with <|instrs_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).instrs_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>)) ⇒ wf_data (:α) data'
wf_add_to_data_const_typed=∀(data :knowledge) (r :num) (w :α word) (data' :knowledge) (p' :α prog). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ ¬EVEN r ∧ add_to_data_const data r w = (data',p') ⇒ wf_data (:α) data'
wf_add_to_load_aux_typed=∀(data :knowledge) (r :num) (i :num list) (p :α prog) (data' :knowledge) (p' :α prog). wf_data (:α) data ∧ (lookup r data.to_canonical :num option) = (NONE :num option) ∧ add_to_load_aux data r i p = (data',p') ∧ (¬EVEN r ⇒ wf_data (:α) (data with <|loads_mem := (insert listCmp i r (data with to_canonical := (insert r r data.to_canonical :num sptree$num_map)).loads_mem :(num list, num) balanced_map); to_canonical := (insert r r data.to_canonical :num sptree$num_map)|>)) ⇒ wf_data (:α) data'
wf_canonicalMoveRegs_typed=∀(data :knowledge) (rs :(num # num) list). wf_data (:α) data ⇒ wf_data (:α) (canonicalMoveRegs data rs)
word_cse_wf_data_typed=∀(p :α prog) (data :knowledge). wf_data (:α) data ⇒ wf_data (:α) (FST (word_cse data p))
