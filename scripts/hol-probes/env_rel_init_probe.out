nsAll_nsMap_typed=∀(f :α -> β) (n :(γ, δ, α) namespace) (P :(γ, δ) id -> β -> bool). nsAll P (nsMap f n) ⇔ nsAll (λ(x :(γ, δ) id) (y :α). P x (f y)) n
