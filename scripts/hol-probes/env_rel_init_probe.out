tenv_to_ienv_replay_typed=∀(tenv :type_env). probe_tenv_to_ienv tenv = <|inf_v := nsMap (λ((tvs :num),(t :t)). (tvs,unconvert_t t)) tenv.v; inf_c := tenv.c; inf_t := tenv.t|>
lift_ienv_typed=∀(mn :mlstring) (ienv :inf_env). lift_ienv mn ienv = <|inf_v := nsLift mn ienv.inf_v; inf_c := nsLift mn ienv.inf_c; inf_t := nsLift mn ienv.inf_t|>
extend_dec_ienv_typed=∀(ienv' :inf_env) (ienv :inf_env). extend_dec_ienv ienv' ienv = <|inf_v := nsAppend ienv'.inf_v ienv.inf_v; inf_c := nsAppend ienv'.inf_c ienv.inf_c; inf_t := nsAppend ienv'.inf_t ienv.inf_t|>
tenv_to_ienv_lift_replay_typed=∀(mn :mlstring) (tenv :type_env). probe_tenv_to_ienv (tenvLift mn tenv) = lift_ienv mn (probe_tenv_to_ienv tenv)
tenv_to_ienv_extend_replay_typed=∀(tenv1 :type_env) (tenv2 :type_env). probe_tenv_to_ienv (extend_dec_tenv tenv2 tenv1) = extend_dec_ienv (probe_tenv_to_ienv tenv2) (probe_tenv_to_ienv tenv1)
check_freevars_to_check_t_replay_typed=∀(t :t) (z :α). check_freevars (n :num) ([] :mlstring list) t ⇒ check_t n (∅ :num -> bool) (unconvert_t t)
Saved definition ____ "probe_convert_t_def"
Saved induction _____ "probe_convert_t_ind"
convert_t_replay_typed=(∀(n :num). probe_convert_t (Infer_Tvar_db n) = Tvar_db n) ∧ ∀(ts :infer_t list) (tc :num). probe_convert_t (Infer_Tapp ts tc) = Tapp (MAP (λ(a :infer_t). probe_convert_t a) ts) tc
infer_deBruijn_inc_typed=(∀(n :num) (m :num). infer_deBruijn_inc n (Infer_Tvar_db m) = Infer_Tvar_db (m + n)) ∧ (∀(ts :infer_t list) (tn :num) (n :num). infer_deBruijn_inc n (Infer_Tapp ts tn) = Infer_Tapp (MAP (λ(a :infer_t). infer_deBruijn_inc n a) ts) tn) ∧ ∀(n :num) (m :num). infer_deBruijn_inc n (Infer_Tuvar m) = Infer_Tuvar m
convert_inc_replay_typed=∀(t :infer_t) (tvs :num) (tvs' :num). check_t tvs' (∅ :num -> bool) t ⇒ probe_convert_t (infer_deBruijn_inc tvs t) = deBruijn_inc (0 :num) tvs (probe_convert_t t)
inc_convert_t_replay_typed=(∀(t :infer_t) (tvs' :num) (tvs :num). check_t tvs' (∅ :num -> bool) t ⇒ deBruijn_inc tvs' tvs (probe_convert_t t) = probe_convert_t t) ∧ ∀(ts :infer_t list) (tvs' :num) (tvs :num). EVERY (check_t tvs' (∅ :num -> bool)) ts ⇒ MAP (deBruijn_inc tvs' tvs ∘ probe_convert_t) ts = MAP probe_convert_t ts
deBruijn_subst_convert_replay_typed=(∀(t :infer_t). check_t (n :num) (∅ :num -> bool) t ⇒ deBruijn_subst (0 :num) (MAP probe_convert_t (subst :infer_t list)) (probe_convert_t t) = probe_convert_t (infer_deBruijn_subst subst t)) ∧ ∀(ts :infer_t list). EVERY (check_t n (∅ :num -> bool)) ts ⇒ MAP (deBruijn_subst (0 :num) (MAP probe_convert_t subst) ∘ probe_convert_t) ts = MAP (probe_convert_t ∘ infer_deBruijn_subst subst) ts
convert_t_subst_replay_typed=(∀(t :t) (tvs :mlstring list) (ts' :infer_t list). LENGTH tvs = LENGTH ts' ∧ check_freevars (0 :num) tvs t ⇒ probe_convert_t (infer_type_subst (ZIP (tvs,ts')) t) = type_subst (alist_to_fmap (ZIP (tvs,MAP probe_convert_t ts'))) t) ∧ ∀(ts :t list) (tvs :mlstring list) (ts' :infer_t list). LENGTH tvs = LENGTH ts' ∧ EVERY (check_freevars (0 :num) tvs) ts ⇒ MAP probe_convert_t (MAP (infer_type_subst (ZIP (tvs,ts'))) ts) = MAP (type_subst (alist_to_fmap (ZIP (tvs,MAP probe_convert_t ts')))) ts
db_subst_infer_subst_swap3_replay_typed=∀(t :t) (tvs :num) (s :num |-> infer_t) (subst :infer_t list). t_wfs s ∧ check_freevars tvs ([] :mlstring list) t ⇒ probe_convert_t (t_walkstar s (infer_deBruijn_subst subst (unconvert_t t))) = deBruijn_subst (0 :num) (MAP (probe_convert_t ∘ t_walkstar s) subst) t
check_convert_freevars_replay_typed=∀(tvs :num) (uvs :num -> bool) (t :infer_t). check_t tvs uvs t ⇒ uvs = (∅ :num -> bool) ⇒ check_freevars tvs ([] :mlstring list) (probe_convert_t t)
check_t_to_check_freevars_replay_typed=∀(tvs :num) (n :num -> bool) (t :infer_t). check_t tvs (∅ :num -> bool) t ⇒ check_freevars tvs ([] :mlstring list) (probe_convert_t t)
check_t_empty_unconvert_convert_id_replay_typed=∀(t :infer_t) (n :num). check_t n (∅ :num -> bool) t ⇒ unconvert_t (probe_convert_t t) = t
check_freevars_empty_convert_unconvert_id_replay_typed=∀(t :t). check_freevars (n :num) ([] :mlstring list) t ⇒ probe_convert_t (unconvert_t t) = t
unconvert_db_subst_replay_typed=∀(t :t) (subst :t list) (fvs :α) (l :num). check_freevars l ([] :mlstring list) t ⇒ unconvert_t (deBruijn_subst (0 :num) subst t) = infer_deBruijn_subst (MAP unconvert_t subst) (unconvert_t t)
infer_type_subst_nil_replay_typed=(∀(t :t). check_freevars (n :num) ([] :mlstring list) t ⇒ infer_type_subst ([] :(mlstring # infer_t) list) t = unconvert_t t) ∧ ∀(ts :t list). EVERY (check_freevars n ([] :mlstring list)) ts ⇒ MAP (infer_type_subst ([] :(mlstring # infer_t) list)) ts = MAP unconvert_t ts
db_subst_inc_id_typed=∀(inst :infer_t list) (t :infer_t). infer_deBruijn_subst inst (infer_deBruijn_inc (LENGTH inst) t) = t
infer_deBruijn_subst_twice_typed=(∀(t :infer_t). check_t (LENGTH (subst2 :infer_t list)) (uvs :num -> bool) t ⇒ infer_deBruijn_subst (subst1 :infer_t list) (infer_deBruijn_subst subst2 t) = infer_deBruijn_subst (MAP (infer_deBruijn_subst subst1) subst2) t) ∧ ∀(ts :infer_t list). EVERY (check_t (LENGTH subst2) uvs) ts ⇒ MAP (infer_deBruijn_subst subst1 ∘ infer_deBruijn_subst subst2) ts = MAP (infer_deBruijn_subst (MAP (infer_deBruijn_subst subst1) subst2)) ts
check_t_more2_typed=(∀(t :infer_t) (tvs :num) (uvs :num -> bool). check_t tvs uvs t ⇒ ∀(tvs' :num). check_t (tvs' + tvs) uvs t) ∧ ∀(ts :infer_t list) (tvs :num) (uvs :num -> bool). EVERY (check_t tvs uvs) ts ⇒ ∀(tvs' :num). EVERY (check_t (tvs' + tvs) uvs) ts
deBruijn_subst_nothing_typed=(∀(t :t). deBruijn_subst (0 :num) ([] :t list) t = t) ∧ ∀(ts :t list). MAP (deBruijn_subst (0 :num) ([] :t list)) ts = ts
Saved definition ____ "probe_tscheme_approx_def"
tscheme_approx_replay_typed=∀(max_tvs :num) (s :num |-> infer_t) (tvs :num) (t :infer_t) (tvs' :num) (t' :infer_t). probe_tscheme_approx max_tvs s (tvs,t) (tvs',t') ⇔ ∃(subst' :infer_t list). LENGTH subst' = tvs' ∧ EVERY (check_t (max_tvs + tvs) (FDOM s)) subst' ∧ ∀(subst :infer_t list). LENGTH subst = tvs ⇒ t_walkstar s (infer_deBruijn_subst subst t) = t_walkstar s (infer_deBruijn_subst (MAP (infer_deBruijn_subst subst) subst') t')
Saved definition ____ "probe_env_rel_sound_def"
env_rel_sound_replay_typed=∀(s :num |-> infer_t) (ienv :inf_env) (tenv :type_env) (tenvE :tenv_val_exp). probe_env_rel_sound s ienv tenv tenvE ⇔ ienv.inf_t = tenv.t ∧ ienv.inf_c = tenv.c ∧ ∀(x :(mlstring, mlstring) id) (ts :num # infer_t). nsLookup ienv.inf_v x = SOME ts ⇒ ∃(tvs' :num) (t' :t). check_freevars (tvs' + num_tvs tenvE) ([] :mlstring list) t' ∧ lookup_var x tenvE tenv = SOME (tvs',t') ∧ probe_tscheme_approx (num_tvs tenvE) s ts (tvs',unconvert_t t')
Saved definition ____ "probe_env_rel_complete_def"
env_rel_complete_replay_typed=∀(s :num |-> infer_t) (ienv :inf_env) (tenv :type_env) (tenvE :tenv_val_exp). probe_env_rel_complete s ienv tenv tenvE ⇔ ienv.inf_t = tenv.t ∧ ienv.inf_c = tenv.c ∧ ∀(x :(mlstring, mlstring) id) (tvs :num) (t :t). lookup_var x tenvE tenv = SOME (tvs,t) ⇒ (∃(n :num). check_freevars n ([] :mlstring list) t) ∧ ∃(tvs' :num) (t' :infer_t). nsLookup ienv.inf_v x = SOME (tvs',t') ∧ probe_tscheme_approx (num_tvs tenvE) s (tvs,unconvert_t t) (tvs',t')
Saved definition ____ "probe_env_rel_def"
env_rel_replay_typed=∀(tenv :type_env) (ienv :inf_env). probe_env_rel tenv ienv ⇔ ienv_ok (∅ :num -> bool) ienv ∧ tenv_ok tenv ∧ (∀(x :mlstring list). nsLookupMod ienv.inf_v x = (NONE :(mlstring, mlstring, num # infer_t) namespace option) ⇔ nsLookupMod tenv.v x = (NONE :(mlstring, mlstring, num # t) namespace option)) ∧ probe_env_rel_sound (FEMPTY :num |-> infer_t) ienv tenv Empty ∧ probe_env_rel_complete (FEMPTY :num |-> infer_t) ienv tenv Empty
tscheme_approx_refl_replay_typed=∀(max_tvs :num) (s :num |-> infer_t) (tvs :num) (t :infer_t). probe_tscheme_approx max_tvs s (tvs,t) (tvs,t)
tscheme_approx_trans_replay_typed=probe_tscheme_approx (max_tvs :num) (s :num |-> infer_t) ((tvs1 :num),(t1 :infer_t)) ((tvs2 :num),(t2 :infer_t)) ∧ probe_tscheme_approx (0 :num) s (tvs2,t2) ((tvs3 :num),(t3 :infer_t)) ⇒ probe_tscheme_approx max_tvs s (tvs1,t1) (tvs3,t3)
tscheme_inst_to_approx_replay_typed=tscheme_inst ((tvs :num),(t :t)) ((tvs' :num),(t' :t)) ⇒ probe_tscheme_approx (0 :num) (FEMPTY :num |-> infer_t) (tvs,unconvert_t t) (tvs',unconvert_t t')
type_config_ok_replay_typed=probe_env_rel prim_tenv init_config ∧ inf_set_tids_ienv prim_type_ids init_config
lookup_varE_empty_replay_typed=∀(x :(mlstring, mlstring) id). lookup_varE x Empty = (NONE :(num # t) option)
init_config_tenv_to_ienv_replay_typed=init_config = probe_tenv_to_ienv prim_tenv
