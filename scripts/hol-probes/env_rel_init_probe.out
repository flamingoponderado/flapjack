infer_st_axiom_typed=∀(f :num -> (num |-> infer_t) -> num -> α). ∃(fn :infer_st -> α). ∀(a0 :num) (a1 :num |-> infer_t) (a2 :num). fn (infer_st a0 a1 a2) = f a0 a1 a2
init_infer_state_typed=∀(st :infer_st). init_infer_state st = st with <|next_uvar := (0 :num); subst := (FEMPTY :num |-> infer_t)|>
init_state_typed=(init_state :infer_st -> (unit, α) exc # infer_st) = (λ(st :infer_st). ((M_success () :(unit, α) exc),init_infer_state st))
fresh_uvar_typed=(fresh_uvar :infer_st -> (infer_t, α) exc # infer_st) = (λ(s :infer_st). ((M_success (Infer_Tuvar s.next_uvar) :(infer_t, α) exc),s with next_uvar := s.next_uvar + (1 :num)))
n_fresh_uvar_typed=∀(n :num). (n_fresh_uvar n :infer_st -> (infer_t list, α) exc # infer_st) = if n = (0 :num) then (st_ex_return ([] :infer_t list) :infer_st -> (infer_t list, α) exc # infer_st) else st_ex_bind (fresh_uvar :infer_st -> (infer_t, α) exc # infer_st) (λ(v :infer_t). st_ex_bind (n_fresh_uvar (n − (1 :num)) :infer_st -> (infer_t list, α) exc # infer_st) (λ(vs :infer_t list). (st_ex_return (v::vs) :infer_st -> (infer_t list, α) exc # infer_st)))
n_fresh_id_typed=∀(n :num). (n_fresh_id n :infer_st -> (num list, α) exc # infer_st) = (λ(s :infer_st). ((M_success (GENLIST (λ(x :num). s.next_id + x) n) :(num list, α) exc),s with next_id := s.next_id + n))
get_next_uvar_typed=(get_next_uvar :infer_st -> (num, α) exc # infer_st) = (λ(st :infer_st). ((M_success st.next_uvar :(num, α) exc),st))
add_constraint_typed=∀(l :loc_err_info) (t1 :infer_t) (t2 :infer_t). add_constraint l t1 t2 = (λ(st :infer_st). case t_unify st.subst t1 t2 of (NONE :(num |-> infer_t) option) => ((M_failure (l.loc,concat [«Type mismatch between »; inf_type_to_string l.err (t_walkstar st.subst t1); « and »; inf_type_to_string l.err (t_walkstar st.subst t2)]) :(unit, locs option # mlstring) exc),st) | SOME s => ((M_success () :(unit, locs option # mlstring) exc),st with subst := s))
add_constraints_typed=(∀(l :loc_err_info). add_constraints l ([] :infer_t list) ([] :infer_t list) = (st_ex_return () :infer_st -> (unit, locs option # mlstring) exc # infer_st)) ∧ (∀(ts2 :infer_t list) (ts1 :infer_t list) (t2 :infer_t) (t1 :infer_t) (l :loc_err_info). add_constraints l (t1::ts1) (t2::ts2) = st_ex_bind (add_constraint l t1 t2) (λ(() :unit). st_ex_bind (add_constraints l ts1 ts2) (λ(() :unit). (st_ex_return () :infer_st -> (unit, locs option # mlstring) exc # infer_st)))) ∧ (∀(v9 :infer_t) (v10 :infer_t list) (l :loc_err_info). add_constraints l ([] :infer_t list) (v9::v10) = (failwith l «Internal error: Bad call to add_constraints» :infer_st -> (unit, locs option # mlstring) exc # infer_st)) ∧ ∀(v6 :infer_t list) (v5 :infer_t) (l :loc_err_info). add_constraints l (v5::v6) ([] :infer_t list) = (failwith l «Internal error: Bad call to add_constraints» :infer_st -> (unit, locs option # mlstring) exc # infer_st)
apply_subst_typed=∀(t :infer_t). (apply_subst t :infer_st -> (infer_t, α) exc # infer_st) = st_ex_bind (read :infer_st -> (infer_st, α) exc # infer_st) (λ(st :infer_st). (st_ex_return (t_walkstar st.subst t) :infer_st -> (infer_t, α) exc # infer_st))
