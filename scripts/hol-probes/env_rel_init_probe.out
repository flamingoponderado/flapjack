type_es_length_typed=∀(tenv :type_env) (tenvE :tenv_val_exp) (es :exp list) (ts :t list). type_es tenv tenvE es ts ⇒ LENGTH es = LENGTH ts
type_d_canon_rules_typed=(∀(n :num) (tvs :num) (tenv :type_env) (p :pat) (e :exp) (t :t) (bindings :(mlstring # t) list) (locs :locs). is_value e ∧ ALL_DISTINCT (pat_bindings p) ∧ type_p tvs tenv p t bindings ∧ type_e tenv (bind_tvar tvs Empty) e t ∧ (∀(tvs' :num) (bindings' :(mlstring # t) list) (t' :t). type_p tvs' tenv p t' bindings' ∧ type_e tenv (bind_tvar tvs' Empty) e t' ∧ EVERY (λ((k :mlstring),(t :t)). set_tids_subset (count n) t) bindings' ⇒ LIST_REL tscheme_inst (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs' bindings')) (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs bindings))) ⇒ type_d_canon n tenv (Dlet locs p e) (0 :num) <|v := (alist_to_ns (tenv_add_tvs tvs bindings) :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(n :num) (tenv :type_env) (p :pat) (e :exp) (t :t) (bindings :(mlstring # t) list) (locs :locs). (¬is_value e ∧ type_pe_determ_canon n tenv Empty p e) ∧ ALL_DISTINCT (pat_bindings p) ∧ type_p (0 :num) tenv p t bindings ∧ type_e tenv Empty e t ⇒ type_d_canon n tenv (Dlet locs p e) (0 :num) <|v := (alist_to_ns (tenv_add_tvs (0 :num) bindings) :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(n :num) (tenv :type_env) (funs :(mlstring # mlstring # exp) list) (bindings :(mlstring # t) list) (tvs :num) (locs :locs). type_funs tenv (bind_var_list (0 :num) bindings (bind_tvar tvs Empty)) funs bindings ∧ (∀(tvs' :num) (bindings' :(mlstring # t) list). type_funs tenv (bind_var_list (0 :num) bindings' (bind_tvar tvs' Empty)) funs bindings' ∧ EVERY (λ((k :mlstring),(t :t)). set_tids_subset (count n) t) bindings' ⇒ LIST_REL tscheme_inst (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs' bindings')) (MAP (SND :mlstring # num # t -> num # t) (tenv_add_tvs tvs bindings))) ⇒ type_d_canon n tenv (Dletrec locs funs) (0 :num) <|v := (alist_to_ns (tenv_add_tvs tvs bindings) :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(n :num) (type_identities :num list) (tenv :type_env) (tdefs :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (locs :locs). FOLDR MAX (0 :num) (Tlist_num::Tbool_num::prim_type_nums) < n ∧ type_identities = GENLIST (λ(i :num). i + n) (LENGTH tdefs) ∧ check_ctor_tenv (nsAppend tenvT tenv.t) tdefs ∧ tenvT = (alist_to_ns (MAP2 (λ((tvs :mlstring list),(tn :mlstring),(ctors :(mlstring # ast_t list) list)) (i :num). (tn,tvs,Tapp (MAP Tvar tvs) i)) tdefs type_identities :(mlstring # mlstring list # t) list) :(mlstring, mlstring, mlstring list # t) namespace) ⇒ type_d_canon n tenv (Dtype locs tdefs) (LENGTH tdefs) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (build_ctor_tenv (nsAppend tenvT tenv.t) tdefs type_identities :(mlstring, mlstring, mlstring list # t list # num) namespace); t := tenvT|>) ∧ (∀(n :num) (tenv :type_env) (tvs :mlstring list) (tn :mlstring) (t :ast_t) (locs :locs). check_freevars_ast tvs t ∧ check_type_names tenv.t t ∧ ALL_DISTINCT tvs ⇒ type_d_canon n tenv (Dtabbrev locs tvs tn t) (0 :num) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsSing tn (tvs,type_name_subst tenv.t t) :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(n :num) (tenv :type_env) (cn :mlstring) (ts :ast_t list) (locs :locs). EVERY (check_freevars_ast ([] :mlstring list)) ts ∧ EVERY (check_type_names tenv.t) ts ⇒ type_d_canon n tenv (Dexn locs cn ts) (0 :num) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsSing cn (([] :mlstring list),MAP (type_name_subst tenv.t) ts,Texn_num) :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ (∀(n :num) (tenv :type_env) (mn :mlstring) (ds :dec list) (decls :num) (tenv' :type_env). type_ds_canon n tenv ds decls tenv' ⇒ type_d_canon n tenv (Dmod mn ds) decls (tenvLift mn tenv')) ∧ (∀(n :num) (tenv :type_env) (lds :dec list) (ds :dec list) (decls1 :num) (decls2 :num) (tenv1 :type_env) (tenv2 :type_env). type_ds_canon n tenv lds decls1 tenv1 ∧ type_ds_canon (n + decls1) (extend_dec_tenv tenv1 tenv) ds decls2 tenv2 ⇒ type_d_canon n tenv (Dlocal lds ds) (decls1 + decls2) tenv2) ∧ (∀(n :num) (tenv :type_env). T ⇒ type_ds_canon n tenv ([] :dec list) (0 :num) <|v := (nsEmpty :(mlstring, mlstring, num # t) namespace); c := (nsEmpty :(mlstring, mlstring, mlstring list # t list # num) namespace); t := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|>) ∧ ∀(n :num) (tenv :type_env) (d :dec) (ds :dec list) (tenv1 :type_env) (tenv2 :type_env) (decls1 :num) (decls2 :num). type_d_canon n tenv d decls1 tenv1 ∧ type_ds_canon (n + decls1) (extend_dec_tenv tenv1 tenv) ds decls2 tenv2 ⇒ type_ds_canon n tenv (d::ds) (decls1 + decls2) (extend_dec_tenv tenv2 tenv1)
good_remap_typed=∀(f :num -> num). good_remap f ⇔ MAP f (Tlist_num::Tbool_num::prim_type_nums) = Tlist_num::Tbool_num::prim_type_nums
sing_renum_typed=∀(m :α) (n :α). sing_renum m n = (λ(x :α). if x = m then n else x)
sing_renum_NOT_tscheme_inst_replay_typed=∀(t :t). (m :num) ∈ set_tids t ∧ m ≠ (n :num) ⇒ ts_tid_rename (sing_renum m n) t ≠ t ∧ ∀(tvs :num) (tvs' :num). ¬tscheme_inst (tvs,ts_tid_rename (sing_renum m n) t) (tvs',t) ∧ ¬tscheme_inst (tvs',t) (tvs,ts_tid_rename (sing_renum m n) t)
type_pe_bindings_tids_replay_typed=prim_tids T (tids :num -> bool) ∧ set_tids_tenv tids (tenv :type_env) ∧ type_p (tvs :num) tenv (p :pat) (t :t) (bindings :(mlstring # t) list) ∧ type_e tenv (bind_tvar tvs Empty) (e :exp) t ∧ (∀(tvs' :num) (bindings' :(mlstring # t) list) (t' :t). type_p tvs' tenv p t' bindings' ∧ type_e tenv (bind_tvar tvs' Empty) e t' ⇒ LIST_REL tscheme_inst (MAP (SND :mlstring # num # t -> num # t) (MAP (λ((n :mlstring),(t :t)). (n,tvs',t)) bindings')) (MAP (SND :mlstring # num # t -> num # t) (MAP (λ((n :mlstring),(t :t)). (n,tvs,t)) bindings))) ⇒ ∀(p_1 :mlstring) (p_2 :t). MEM (p_1,p_2) bindings ⇒ set_tids_subset tids p_2
type_funs_bindings_tids_typed=type_funs (tenv :type_env) (bind_var_list (0 :num) (bindings :(mlstring # t) list) (bind_tvar (tvs :num) Empty)) (funs :(mlstring # mlstring # exp) list) bindings ∧ set_tids_tenv (tids :num -> bool) tenv ∧ prim_tids T tids ∧ (∀(tvs' :num) (bindings' :(mlstring # t) list). type_funs tenv (bind_var_list (0 :num) bindings' (bind_tvar tvs' Empty)) funs bindings' ⇒ LIST_REL tscheme_inst (MAP (λ(x :mlstring # t). (tvs',SND x)) bindings') (MAP (λ(x :mlstring # t). (tvs,SND x)) bindings)) ⇒ EVERY (set_tids_subset tids ∘ (SND :mlstring # t -> t)) bindings
type_pe_bindings_tids_0_typed=prim_tids T (tids :num -> bool) ∧ set_tids_tenv tids (tenv :type_env) ∧ type_p (0 :num) tenv (p :pat) (t :t) (bindings :(mlstring # t) list) ∧ type_e tenv Empty (e :exp) t ∧ type_pe_determ tenv Empty p e ⇒ ∀(p_1 :mlstring) (p_2 :t). MEM (p_1,p_2) bindings ⇒ set_tids_subset tids p_2
sing_renum_NOTIN_ID_typed=∀(t :t). (m :num) ∉ set_tids t ⇒ ts_tid_rename (sing_renum m (n :num)) t = t
sing_renum_IN_NOT_ID_typed=∀(t :t). (m :num) ∈ set_tids t ∧ m ≠ (n :num) ⇒ ts_tid_rename (sing_renum m n) t ≠ t
sing_renum_NOTIN_tenv_ID_typed=set_tids_tenv (tids :num -> bool) (tenv :type_env) ∧ (m :num) ∉ tids ⇒ tenv_equiv (remap_tenv (sing_renum m (n :num)) tenv) tenv
extend_bij_typed=∀(f :num -> num) (g :num -> num) (ids :num -> bool) (n :num) (v :num). extend_bij f g ids n v = if v ∈ ids then n + g v else f v
extend_bij_id_typed=extend_bij (f :num -> num) f (s :num -> bool) (0 :num) = f ∧ extend_bij f (g :num -> num) (∅ :num -> bool) (n :num) = f
extend_bij_compose_typed=extend_bij (extend_bij (f :num -> num) (g :num -> num) (ids :num -> bool) (n :num)) (h :num -> num) (jds :num -> bool) (n + (m :num)) = extend_bij f (extend_bij g h jds m) (ids ∪ jds) n
BIJ_extend_bij_typed=DISJOINT (tids :num -> bool) (ids :num -> bool) ∧ BIJ (f :num -> num) tids (count (n :num)) ∧ BIJ (g :num -> num) ids (count (CARD ids)) ⇒ BIJ (extend_bij f g ids n) (tids ∪ ids) (count (n + CARD ids))
good_remap_extend_bij_replay_typed=good_remap (f :num -> num) ∧ prim_tids F (ids :num -> bool) ⇒ good_remap (extend_bij f (g :num -> num) ids (n :num))
check_freevars_ts_tid_rename_replay_typed=∀(ts :num) (ls :mlstring list) (t :t). check_freevars ts ls (ts_tid_rename (f :num -> num) t) ⇔ check_freevars ts ls t
ts_tid_rename_type_subst_replay_typed=∀(s :mlstring |-> t) (t :t) (f :num -> num). ts_tid_rename f (type_subst s t) = type_subst (ts_tid_rename f o_f s) (ts_tid_rename f t)
check_type_names_ts_tid_rename_replay_typed=∀(tenvt :(mlstring, mlstring, mlstring list # t) namespace) (t :ast_t). check_type_names tenvt t ⇔ check_type_names (nsMap (λ((ls :mlstring list),(t :t)). (ls,ts_tid_rename (f :num -> num) t)) tenvt) t
ts_tid_rename_type_name_subst_replay_typed=∀(tenvt :(mlstring, mlstring, mlstring list # t) namespace) (t :ast_t) (f :num -> num) (tenv :α). good_remap f ∧ check_type_names tenvt t ⇒ ts_tid_rename f (type_name_subst tenvt t) = type_name_subst (nsMap (λ((ls :mlstring list),(t :t)). (ls,ts_tid_rename f t)) tenvt) t
set_tids_tenv_remap_typed=set_tids_tenv (tids :num -> bool) (tenv :type_env) ⇒ set_tids_tenv (IMAGE (f :num -> num) tids) (remap_tenv f tenv)
set_tids_tenv_remap_replay_typed=probe_set_tids_tenv (tids :num -> bool) (tenv :type_env) ⇒ probe_set_tids_tenv (IMAGE (f :num -> num) tids) (remap_tenv f tenv)
remap_tenv_extend_dec_tenv_replay_typed=remap_tenv (f :num -> num) (extend_dec_tenv (t :type_env) (t' :type_env)) = extend_dec_tenv (remap_tenv f t) (remap_tenv f t')
set_tids_tenv_extend_dec_tenv_replay_typed=∀(s :num -> bool) (t :type_env) (s' :num -> bool) (t' :type_env). probe_set_tids_tenv (s' ∪ s) t' ∧ probe_set_tids_tenv (s' ∪ s) t ⇒ probe_set_tids_tenv (s' ∪ s) (extend_dec_tenv t' t)
set_tids_subset_mono_replay_typed=∀(tids :num -> bool) (t :t) (tids' :num -> bool). set_tids_subset tids t ∧ tids ⊆ tids' ⇒ set_tids_subset tids' t
set_tids_tenv_mono_replay_typed=probe_set_tids_tenv (tids :num -> bool) (tenv :type_env) ∧ tids ⊆ (tids' :num -> bool) ⇒ probe_set_tids_tenv tids' tenv
