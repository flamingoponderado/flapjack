nsMap_nsAppend_typed=∀(n1 :(α, β, γ) namespace) (n2 :(α, β, γ) namespace) (f :γ -> δ). nsMap f (nsAppend n1 n2) = nsAppend (nsMap f n1) (nsMap f n2)
