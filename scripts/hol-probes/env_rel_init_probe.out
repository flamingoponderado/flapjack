tenv_to_ienv_replay_typed=∀(tenv :type_env). probe_tenv_to_ienv tenv = <|inf_v := nsMap (λ((tvs :num),(t :t)). (tvs,unconvert_t t)) tenv.v; inf_c := tenv.c; inf_t := tenv.t|>
lift_ienv_typed=∀(mn :mlstring) (ienv :inf_env). lift_ienv mn ienv = <|inf_v := nsLift mn ienv.inf_v; inf_c := nsLift mn ienv.inf_c; inf_t := nsLift mn ienv.inf_t|>
loc_err_info_axiom_typed=∀(f :locs option -> (mlstring, mlstring, mlstring list # t) namespace -> α). ∃(fn :loc_err_info -> α). ∀(a0 :locs option) (a1 :(mlstring, mlstring, mlstring list # t) namespace). fn (loc_err_info a0 a1) = f a0 a1
failwith_typed=∀(l :loc_err_info) (msg :α). (failwith l msg :β -> (γ, locs option # α) exc # β) = (λ(s :β). ((M_failure (l.loc,msg) :(γ, locs option # α) exc),s))
guard_typed=∀(P :bool) (l :loc_err_info) (msg :β). (guard P l msg :α -> (unit, locs option # β) exc # α) = if P then (st_ex_return () :α -> (unit, locs option # β) exc # α) else (failwith l msg :α -> (unit, locs option # β) exc # α)
bind_guard_typed=st_ex_bind (guard (b :bool) (l :loc_err_info) (x :γ) :α -> (unit, locs option # γ) exc # α) (g :unit -> α -> (β, locs option # γ) exc # α) = (λ(s :α). if b then g () s else ((M_failure (l.loc,x) :(β, locs option # γ) exc),s))
ignore_bind_guard_typed=st_ex_ignore_bind (guard (b :bool) (l :loc_err_info) (x :γ) :α -> (unit, locs option # γ) exc # α) (g :α -> (β, locs option # γ) exc # α) = (λ(s :α). if b then g s else ((M_failure (l.loc,x) :(β, locs option # γ) exc),s))
st_ex_bind_pair_typed=st_ex_bind (x :α -> (δ # ε, γ) exc # α) (f :δ # ε -> α -> (β, γ) exc # α) = (λ(s :α). case x s of ((M_success (y,z) :(δ # ε, γ) exc),s) => f (y,z) s | ((M_failure x :(δ # ε, γ) exc),s) => ((M_failure x :(β, γ) exc),s))
st_ex_bind_triple_typed=st_ex_bind (x :α -> (δ # ε # ζ, γ) exc # α) (f :δ # ε # ζ -> α -> (β, γ) exc # α) = (λ(s :α). case x s of ((M_success (y,z,q) :(δ # ε # ζ, γ) exc),s) => f (y,z,q) s | ((M_failure x :(δ # ε # ζ, γ) exc),s) => ((M_failure x :(β, γ) exc),s))
infer_read_typed=(read :α -> (α, β) exc # α) = (λ(s :α). ((M_success s :(α, β) exc),s))
infer_write_typed=∀(v :α). (write v :α -> (unit, β) exc # α) = (λ(s :α). ((M_success () :(unit, β) exc),v))
lookup_st_ex_typed=∀(l :loc_err_info) (err :mlstring) (id :(mlstring, mlstring) id) (ienv :(mlstring, mlstring, α) namespace) (st :β). lookup_st_ex l err id ienv st = case nsLookup ienv id of (NONE :α option) => ((M_failure (l.loc,concat [«Undefined »; err; «: »; id_to_string id]) :(α, locs option # mlstring) exc),st) | SOME v => ((M_success v :(α, locs option # mlstring) exc),st)
find_dup_typed=find_dup ([] :α list) = (NONE :α option) ∧ ∀(x :α) (xs :α list). find_dup (x::xs) = if MEM x xs then SOME x else find_dup xs
check_dups_typed=(∀(l :loc_err_info) (f :γ -> β). (check_dups l f ([] :γ list) :α -> (unit, locs option # β) exc # α) = (st_ex_return () :α -> (unit, locs option # β) exc # α)) ∧ ∀(l :loc_err_info) (f :γ -> β) (h :γ) (t :γ list). (check_dups l f (h::t) :α -> (unit, locs option # β) exc # α) = if MEM h t then (failwith l (f h) :α -> (unit, locs option # β) exc # α) else (check_dups l f t :α -> (unit, locs option # β) exc # α)
check_dups_eq_find_dup_typed=∀(xs :α list). st_ex_ignore_bind (check_dups (l :loc_err_info) (f :α -> δ) xs :β -> (unit, locs option # δ) exc # β) (g :β -> (γ, locs option # δ) exc # β) = (λ(s :β). case find_dup xs of (NONE :α option) => g s | SOME x => ((M_failure (l.loc,f x) :(γ, locs option # δ) exc),s))
type_name_check_subst_typed=(∀(l :loc_err_info) (err_string_f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (tv :mlstring). (type_name_check_subst l err_string_f tenvT fvs (Atvar tv) :α -> (t, locs option # mlstring) exc # α) = st_ex_ignore_bind (guard (MEM tv fvs) l (err_string_f tv) :α -> (unit, locs option # mlstring) exc # α) (st_ex_return (Tvar tv) :α -> (t, locs option # mlstring) exc # α)) ∧ (∀(l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (ts :ast_t list). (type_name_check_subst l f tenvT fvs (Attup ts) :α -> (t, locs option # mlstring) exc # α) = st_ex_bind (type_name_check_subst_list l f tenvT fvs ts :α -> (t list, locs option # mlstring) exc # α) (λ(ts' :t list). (st_ex_return (Ttup ts') :α -> (t, locs option # mlstring) exc # α))) ∧ (∀(l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (t1 :ast_t) (t2 :ast_t). (type_name_check_subst l f tenvT fvs (Atfun t1 t2) :α -> (t, locs option # mlstring) exc # α) = st_ex_bind (type_name_check_subst l f tenvT fvs t1 :α -> (t, locs option # mlstring) exc # α) (λ(t1' :t). st_ex_bind (type_name_check_subst l f tenvT fvs t2 :α -> (t, locs option # mlstring) exc # α) (λ(t2' :t). (st_ex_return (Tfn t1' t2') :α -> (t, locs option # mlstring) exc # α)))) ∧ (∀(l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (ts :ast_t list) (tc :(mlstring, mlstring) id). (type_name_check_subst l f tenvT fvs (Atapp ts tc) :α -> (t, locs option # mlstring) exc # α) = st_ex_bind (type_name_check_subst_list l f tenvT fvs ts :α -> (t list, locs option # mlstring) exc # α) (λ(ts' :t list). st_ex_bind (lookup_st_ex l «type constructor» tc tenvT :α -> (mlstring list # t, locs option # mlstring) exc # α) (λ((tvs' :mlstring list),(t' :t)). st_ex_ignore_bind (guard (LENGTH tvs' = LENGTH ts) l (concat [«Type constructor »; id_to_string tc; « given »; (toString (LENGTH ts) :mlstring); « arguments, but expected »; (toString (LENGTH tvs') :mlstring)]) :α -> (unit, locs option # mlstring) exc # α) (st_ex_return (type_subst (alist_to_fmap (ZIP (tvs',ts'))) t') :α -> (t, locs option # mlstring) exc # α)))) ∧ (∀(l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list). (type_name_check_subst_list l f tenvT fvs ([] :ast_t list) :α -> (t list, locs option # mlstring) exc # α) = (st_ex_return ([] :t list) :α -> (t list, locs option # mlstring) exc # α)) ∧ ∀(l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (t :ast_t) (ts :ast_t list). (type_name_check_subst_list l f tenvT fvs (t::ts) :α -> (t list, locs option # mlstring) exc # α) = st_ex_bind (type_name_check_subst l f tenvT fvs t :α -> (t, locs option # mlstring) exc # α) (λ(t' :t). st_ex_bind (type_name_check_subst_list l f tenvT fvs ts :α -> (t list, locs option # mlstring) exc # α) (λ(ts' :t list). (st_ex_return (t'::ts') :α -> (t list, locs option # mlstring) exc # α)))
type_name_check_sub_typed=(∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (tv :mlstring). (type_name_check_sub l tenvT fvs (Atvar tv) :α -> (t, locs option # (mlstring + mlstring)) exc # α) = (λ(s :α). if MEM tv fvs then ((M_success (Tvar tv) :(t, locs option # (mlstring + mlstring)) exc),s) else ((M_failure (l.loc,(INR tv :mlstring + mlstring)) :(t, locs option # (mlstring + mlstring)) exc),s))) ∧ (∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (ts :ast_t list). (type_name_check_sub l tenvT fvs (Attup ts) :α -> (t, locs option # (mlstring + mlstring)) exc # α) = (λ(s :α). case type_name_check_sub_list l tenvT fvs ts s of ((M_success ts' :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_success (Ttup ts') :(t, locs option # (mlstring + mlstring)) exc),s) | ((M_failure x :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s))) ∧ (∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (t1 :ast_t) (t2 :ast_t). (type_name_check_sub l tenvT fvs (Atfun t1 t2) :α -> (t, locs option # (mlstring + mlstring)) exc # α) = (λ(s :α). case type_name_check_sub l tenvT fvs t1 s of ((M_success t1' :(t, locs option # (mlstring + mlstring)) exc),s) => (case type_name_check_sub l tenvT fvs t2 s of ((M_success t2' :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_success (Tfn t1' t2') :(t, locs option # (mlstring + mlstring)) exc),s) | ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s)) | ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s))) ∧ (∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (ts :ast_t list) (tc :(mlstring, mlstring) id). (type_name_check_sub l tenvT fvs (Atapp ts tc) :α -> (t, locs option # (mlstring + mlstring)) exc # α) = (λ(s :α). case type_name_check_sub_list l tenvT fvs ts s of ((M_success ts' :(t list, locs option # (mlstring + mlstring)) exc),s) => (case case nsLookup tenvT tc of (NONE :(mlstring list # t) option) => ((M_failure (l.loc,(INL (concat [«Undefined »; «type constructor»; «: »; id_to_string tc]) :mlstring + mlstring)) :(mlstring list # t, locs option # (mlstring + mlstring)) exc),s) | SOME v => ((M_success v :(mlstring list # t, locs option # (mlstring + mlstring)) exc),s) of ((M_success (y,z) :(mlstring list # t, locs option # (mlstring + mlstring)) exc),s) => if LENGTH y = LENGTH ts then ((M_success (type_subst (alist_to_fmap (ZIP (y,ts'))) z) :(t, locs option # (mlstring + mlstring)) exc),s) else ((M_failure (l.loc,(INL (concat [«Type constructor »; id_to_string tc; « given »; (toString (LENGTH ts) :mlstring); « arguments, but expected »; (toString (LENGTH y) :mlstring)]) :mlstring + mlstring)) :(t, locs option # (mlstring + mlstring)) exc),s) | ((M_failure x :(mlstring list # t, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s)) | ((M_failure x :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s))) ∧ (∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list). (type_name_check_sub_list l tenvT fvs ([] :ast_t list) :α -> (t list, locs option # (mlstring + mlstring)) exc # α) = (λ(s :α). ((M_success ([] :t list) :(t list, locs option # (mlstring + mlstring)) exc),s))) ∧ ∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list) (t :ast_t) (ts :ast_t list). (type_name_check_sub_list l tenvT fvs (t::ts) :α -> (t list, locs option # (mlstring + mlstring)) exc # α) = (λ(s :α). case type_name_check_sub l tenvT fvs t s of ((M_success t' :(t, locs option # (mlstring + mlstring)) exc),s) => (case type_name_check_sub_list l tenvT fvs ts s of ((M_success ts' :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_success (t'::ts') :(t list, locs option # (mlstring + mlstring)) exc),s) | ((M_failure x :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t list, locs option # (mlstring + mlstring)) exc),s)) | ((M_failure x :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_failure x :(t list, locs option # (mlstring + mlstring)) exc),s))
to_type_name_check_sub_typed=(∀(t :ast_t) (l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list). (type_name_check_subst l f tenvT fvs t :α -> (t, locs option # mlstring) exc # α) = (λ(s :α). case type_name_check_sub l tenvT fvs t s of ((M_success y :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_success y :(t, locs option # mlstring) exc),s) | ((M_failure (x,(INL r' :mlstring + mlstring)) :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_failure (x,r') :(t, locs option # mlstring) exc),s) | ((M_failure (x,(INR r :mlstring + mlstring)) :(t, locs option # (mlstring + mlstring)) exc),s) => ((M_failure (x,f r) :(t, locs option # mlstring) exc),s))) ∧ ∀(t :ast_t list) (l :loc_err_info) (f :mlstring -> mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (fvs :mlstring list). (type_name_check_subst_list l f tenvT fvs t :α -> (t list, locs option # mlstring) exc # α) = (λ(s :α). case type_name_check_sub_list l tenvT fvs t s of ((M_success y :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_success y :(t list, locs option # mlstring) exc),s) | ((M_failure (x,(INL r' :mlstring + mlstring)) :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_failure (x,r') :(t list, locs option # mlstring) exc),s) | ((M_failure (x,(INR r :mlstring + mlstring)) :(t list, locs option # (mlstring + mlstring)) exc),s) => ((M_failure (x,f r) :(t list, locs option # mlstring) exc),s))
type_name_check_sub_unbound_eval=type_name_check_sub <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) ([] :mlstring list) (Atvar «a») (7 :num) = ((M_failure ((NONE :locs option),(INR «a» :mlstring + mlstring)) :(t, locs option # (mlstring + mlstring)) exc),(7 :num))
type_name_check_sub_missing_eval=type_name_check_sub <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) ([] :mlstring list) (Atapp ([] :ast_t list) (Short «missing» :(mlstring, mlstring) id)) (7 :num) = ((M_failure ((NONE :locs option),(INL «Undefined type constructor: missing» :mlstring + mlstring)) :(t, locs option # (mlstring + mlstring)) exc),(7 :num))
type_name_check_sub_success_eval=type_name_check_sub <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) [«a»] (Attup [Atvar «a»; Atvar «a»]) (7 :num) = ((M_success (Tapp [Tvar «a»; Tvar «a»] (9 :num)) :(t, locs option # (mlstring + mlstring)) exc),(7 :num))
check_ctor_types_typed=(∀(tvs :mlstring list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (l :loc_err_info). (check_ctor_types l tenvT tvs ([] :(mlstring # ast_t list) list) :α -> (unit, locs option # mlstring) exc # α) = (st_ex_return () :α -> (unit, locs option # mlstring) exc # α)) ∧ ∀(tvs :mlstring list) (ts :ast_t list) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (l :loc_err_info) (ctors :(mlstring # ast_t list) list) (cn :mlstring). (check_ctor_types l tenvT tvs ((cn,ts)::ctors) :α -> (unit, locs option # mlstring) exc # α) = st_ex_ignore_bind (type_name_check_subst_list l (λ(tv :mlstring). concat [«Unbound type variable »; tv; « in type definition with constructor »; cn]) tenvT tvs ts :α -> (t list, locs option # mlstring) exc # α) (check_ctor_types l tenvT tvs ctors :α -> (unit, locs option # mlstring) exc # α)
check_ctors_typed=(∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (l :loc_err_info). (check_ctors l tenvT ([] :(mlstring list # mlstring # (mlstring # ast_t list) list) list) :α -> (unit, locs option # mlstring) exc # α) = (st_ex_return () :α -> (unit, locs option # mlstring) exc # α)) ∧ ∀(tvs :mlstring list) (tn :mlstring) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (l :loc_err_info) (ctors :(mlstring # ast_t list) list). (check_ctors l tenvT ((tvs,tn,ctors)::tds) :α -> (unit, locs option # mlstring) exc # α) = st_ex_ignore_bind (check_dups l (λ(n :mlstring). concat [«Duplicate constructor »; n; « in the definition of type »; tn]) (MAP (FST :mlstring # ast_t list -> mlstring) ctors) :α -> (unit, locs option # mlstring) exc # α) (st_ex_ignore_bind (check_dups l (λ(n :mlstring). concat [«Duplicate type variable binding »; n; « in the definition of type »; tn]) tvs :α -> (unit, locs option # mlstring) exc # α) (st_ex_ignore_bind (check_ctor_types l tenvT tvs ctors :α -> (unit, locs option # mlstring) exc # α) (check_ctors l tenvT tds :α -> (unit, locs option # mlstring) exc # α)))
check_type_definition_typed=∀(l :loc_err_info) (tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list). (check_type_definition l tenvT tds :α -> (unit, locs option # mlstring) exc # α) = st_ex_ignore_bind (check_dups l (λ(n :mlstring). concat [«Duplicate type constructor »; n; « in a mutually recursive type definition»]) (MAP ((FST :mlstring # (mlstring # ast_t list) list -> mlstring) ∘ (SND :mlstring list # mlstring # (mlstring # ast_t list) list -> mlstring # (mlstring # ast_t list) list)) tds) :α -> (unit, locs option # mlstring) exc # α) (check_ctors l tenvT tds :α -> (unit, locs option # mlstring) exc # α)
check_type_definition_dup_ctor_eval=check_type_definition <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) [([«a»; «a»],«t»,[(«C»,([] :ast_t list)); («C»,([] :ast_t list))])] (7 :num) = ((M_failure ((NONE :locs option),«Duplicate constructor C in the definition of type t») :(unit, locs option # mlstring) exc),(7 :num))
check_type_definition_dup_type_eval=check_type_definition <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) [(([] :mlstring list),«t»,([] :(mlstring # ast_t list) list)); (([] :mlstring list),«t»,([] :(mlstring # ast_t list) list))] (7 :num) = ((M_failure ((NONE :locs option),«Duplicate type constructor t in a mutually recursive type definition») :(unit, locs option # mlstring) exc),(7 :num))
check_type_definition_unbound_eval=check_type_definition <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) [(([] :mlstring list),«t»,[(«C»,[Atvar «a»])])] (7 :num) = ((M_failure ((NONE :locs option),«Unbound type variable a in type definition with constructor C») :(unit, locs option # mlstring) exc),(7 :num))
type_name_check_unbound_eval=type_name_check_subst <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (λ(x :mlstring). x) (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) ([] :mlstring list) (Atvar «a») (7 :num) = ((M_failure ((NONE :locs option),«a») :(t, locs option # mlstring) exc),(7 :num))
type_name_check_tuple_eval=type_name_check_subst <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (λ(x :mlstring). x) (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) [«a»] (Attup [Atvar «a»; Atvar «a»]) (7 :num) = ((M_success (Tapp [Tvar «a»; Tvar «a»] (9 :num)) :(t, locs option # mlstring) exc),(7 :num))
type_name_check_unknown_ctor_eval=type_name_check_subst <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (λ(x :mlstring). x) (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace) ([] :mlstring list) (Atapp ([] :ast_t list) (Short «missing» :(mlstring, mlstring) id)) (7 :num) = ((M_failure ((NONE :locs option),«Undefined type constructor: missing») :(t, locs option # mlstring) exc),(7 :num))
type_name_check_duplicate_param_eval=type_name_check_subst <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (λ(x :mlstring). x) (nsBind «pair» ([«x»; «x»],Tvar «x») (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)) [«a»; «b»] (Atapp [Atvar «a»; Atvar «b»] (Short «pair» :(mlstring, mlstring) id)) (7 :num) = ((M_success (Tvar «a») :(t, locs option # mlstring) exc),(7 :num))
type_name_check_arity_eval=type_name_check_subst <|loc := (NONE :locs option); err := (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)|> (λ(x :mlstring). x) (nsBind «pair» ([«x»; «y»],Tvar «x») (nsEmpty :(mlstring, mlstring, mlstring list # t) namespace)) ([] :mlstring list) (Atapp ([] :ast_t list) (Short «pair» :(mlstring, mlstring) id)) (7 :num) = ((M_failure ((NONE :locs option),«Type constructor pair given 0 arguments, but expected 2») :(t, locs option # mlstring) exc),(7 :num))
id_to_string_typed=(∀(s :mlstring). id_to_string (Short s :(mlstring, mlstring) id) = s) ∧ ∀(x :mlstring) (id :(mlstring, mlstring) id). id_to_string (Long x id) = concat [x; «.»; id_to_string id]
infer_st_axiom_typed=∀(f :num -> (num |-> infer_t) -> num -> α). ∃(fn :infer_st -> α). ∀(a0 :num) (a1 :num |-> infer_t) (a2 :num). fn (infer_st a0 a1 a2) = f a0 a1 a2
init_infer_state_typed=∀(st :infer_st). init_infer_state st = st with <|next_uvar := (0 :num); subst := (FEMPTY :num |-> infer_t)|>
init_state_typed=(init_state :infer_st -> (unit, α) exc # infer_st) = (λ(st :infer_st). ((M_success () :(unit, α) exc),init_infer_state st))
fresh_uvar_typed=(fresh_uvar :infer_st -> (infer_t, α) exc # infer_st) = (λ(s :infer_st). ((M_success (Infer_Tuvar s.next_uvar) :(infer_t, α) exc),s with next_uvar := s.next_uvar + (1 :num)))
n_fresh_uvar_typed=∀(n :num). (n_fresh_uvar n :infer_st -> (infer_t list, α) exc # infer_st) = if n = (0 :num) then (st_ex_return ([] :infer_t list) :infer_st -> (infer_t list, α) exc # infer_st) else st_ex_bind (fresh_uvar :infer_st -> (infer_t, α) exc # infer_st) (λ(v :infer_t). st_ex_bind (n_fresh_uvar (n − (1 :num)) :infer_st -> (infer_t list, α) exc # infer_st) (λ(vs :infer_t list). (st_ex_return (v::vs) :infer_st -> (infer_t list, α) exc # infer_st)))
n_fresh_id_typed=∀(n :num). (n_fresh_id n :infer_st -> (num list, α) exc # infer_st) = (λ(s :infer_st). ((M_success (GENLIST (λ(x :num). s.next_id + x) n) :(num list, α) exc),s with next_id := s.next_id + n))
get_next_uvar_typed=(get_next_uvar :infer_st -> (num, α) exc # infer_st) = (λ(st :infer_st). ((M_success st.next_uvar :(num, α) exc),st))
add_constraint_typed=∀(l :loc_err_info) (t1 :infer_t) (t2 :infer_t). add_constraint l t1 t2 = (λ(st :infer_st). case t_unify st.subst t1 t2 of (NONE :(num |-> infer_t) option) => ((M_failure (l.loc,concat [«Type mismatch between »; inf_type_to_string l.err (t_walkstar st.subst t1); « and »; inf_type_to_string l.err (t_walkstar st.subst t2)]) :(unit, locs option # mlstring) exc),st) | SOME s => ((M_success () :(unit, locs option # mlstring) exc),st with subst := s))
add_constraints_typed=(∀(l :loc_err_info). add_constraints l ([] :infer_t list) ([] :infer_t list) = (st_ex_return () :infer_st -> (unit, locs option # mlstring) exc # infer_st)) ∧ (∀(ts2 :infer_t list) (ts1 :infer_t list) (t2 :infer_t) (t1 :infer_t) (l :loc_err_info). add_constraints l (t1::ts1) (t2::ts2) = st_ex_bind (add_constraint l t1 t2) (λ(() :unit). st_ex_bind (add_constraints l ts1 ts2) (λ(() :unit). (st_ex_return () :infer_st -> (unit, locs option # mlstring) exc # infer_st)))) ∧ (∀(v9 :infer_t) (v10 :infer_t list) (l :loc_err_info). add_constraints l ([] :infer_t list) (v9::v10) = (failwith l «Internal error: Bad call to add_constraints» :infer_st -> (unit, locs option # mlstring) exc # infer_st)) ∧ ∀(v6 :infer_t list) (v5 :infer_t) (l :loc_err_info). add_constraints l (v5::v6) ([] :infer_t list) = (failwith l «Internal error: Bad call to add_constraints» :infer_st -> (unit, locs option # mlstring) exc # infer_st)
apply_subst_typed=∀(t :infer_t). (apply_subst t :infer_st -> (infer_t, α) exc # infer_st) = st_ex_bind (read :infer_st -> (infer_st, α) exc # infer_st) (λ(st :infer_st). (st_ex_return (t_walkstar st.subst t) :infer_st -> (infer_t, α) exc # infer_st))
apply_subst_list_typed=∀(ts :infer_t list). (apply_subst_list ts :infer_st -> (infer_t list, α) exc # infer_st) = st_ex_bind (read :infer_st -> (infer_st, α) exc # infer_st) (λ(st :infer_st). (st_ex_return (MAP (t_walkstar st.subst) ts) :infer_st -> (infer_t list, α) exc # infer_st))
extend_dec_ienv_typed=∀(ienv' :inf_env) (ienv :inf_env). extend_dec_ienv ienv' ienv = <|inf_v := nsAppend ienv'.inf_v ienv.inf_v; inf_c := nsAppend ienv'.inf_c ienv.inf_c; inf_t := nsAppend ienv'.inf_t ienv.inf_t|>
nsLookup_nsMap_typed=∀(n :(α, β, γ) namespace) (x :(α, β) id) (f :γ -> δ). nsLookup (nsMap f n) x = OPTION_MAP f (nsLookup n x)
nsLookupMod_nsMap_typed=∀(n :(α, β, γ) namespace) (x :α list) (f :γ -> δ). nsLookupMod (nsMap f n) x = OPTION_MAP (nsMap f :(α, β, γ) namespace -> (α, β, δ) namespace) (nsLookupMod n x)
nsAll_nsMap_typed=∀(f :α -> β) (n :(γ, δ, α) namespace) (P :(γ, δ) id -> β -> bool). nsAll P (nsMap f n) ⇔ nsAll (λ(x :(γ, δ) id) (y :α). P x (f y)) n
nsMap_I_typed=∀(ns :(α, β, γ) namespace). nsMap (I :γ -> γ) ns = ns
nsMap_compose_typed=∀(g :α -> β) (e :(γ, δ, α) namespace) (f :β -> ε). nsMap f (nsMap g e) = nsMap (f ∘ g) e
nsMap_nsAppend_typed=∀(n1 :(α, β, γ) namespace) (n2 :(α, β, γ) namespace) (f :γ -> δ). nsMap f (nsAppend n1 n2) = nsAppend (nsMap f n1) (nsMap f n2)
nsAll_nsLift_typed=∀(R :(α, β) id -> γ -> bool) (mn :α) (e :(α, β, γ) namespace). nsAll R (nsLift mn e) ⇔ nsAll (λ(id :(α, β) id). R (Long mn id)) e
nsAll2_nsLift_typed=∀(R :(α, β) id -> γ -> δ -> bool) (mn :α) (e1 :(α, β, γ) namespace) (e2 :(α, β, δ) namespace). nsAll2 R (nsLift mn e1) (nsLift mn e2) ⇔ nsAll2 (λ(id :(α, β) id). R (Long mn id)) e1 e2
ienv_ok_lift_typed=∀(mn :mlstring) (ienv :inf_env) (n :num -> bool). ienv_ok n ienv ⇒ ienv_ok n (lift_ienv mn ienv)
ienv_ok_extend_dec_ienv_typed=∀(e1 :inf_env) (e2 :inf_env) (n :num -> bool). ienv_ok n e1 ∧ ienv_ok n e2 ⇒ ienv_ok n (extend_dec_ienv e1 e2)
infer_type_subst_empty_check_typed=(∀(t :t). check_freevars (0 :num) ([] :mlstring list) t ⇒ check_t (0 :num) (∅ :num -> bool) (infer_type_subst ([] :(mlstring # infer_t) list) t)) ∧ ∀(ts :t list). EVERY (check_freevars (0 :num) ([] :mlstring list)) ts ⇒ EVERY (check_t (0 :num) (∅ :num -> bool)) (MAP (infer_type_subst ([] :(mlstring # infer_t) list)) ts)
check_freevars_more_typed=∀(a :num) (b :mlstring list) (c :t). check_freevars a b c ⇒ ∀(b' :mlstring list). set b ⊆ set b' ⇒ check_freevars a b' c
check_t_infer_type_subst_dbs_typed=∀(m :num) (w :mlstring list) (t :t) (n :num) (u :num -> bool) (ls :mlstring list). check_freevars m w t ∧ m + LENGTH ls ≤ n ∧ (ls = ([] :mlstring list) ⇒ (0 :num) < m) ⇒ check_t n u (infer_type_subst (ZIP (ls,MAP Infer_Tvar_db (COUNT_LIST (LENGTH ls)))) t)
extend_dec_tenv_ok_typed=∀(tenv :type_env) (tenv' :type_env). tenv_ok tenv ∧ tenv_ok tenv' ⇒ tenv_ok (extend_dec_tenv tenv tenv')
tenv_abbrev_ok_lookup_typed=∀(tenvT :(α, β, mlstring list # t) namespace) (tn :(α, β) id) (tvs :mlstring list) (t :t). tenv_abbrev_ok tenvT ∧ nsLookup tenvT tn = SOME (tvs,t) ⇒ check_freevars (0 :num) tvs t
check_freevars_add_typed=∀(tvs :num) (tvs' :mlstring list) (t :t). check_freevars tvs tvs' t ⇒ ∀(tvs'' :num). tvs'' ≥ tvs ⇒ check_freevars tvs'' tvs' t
check_freevars_subst_single_typed=∀(dbmax :num) (tvs :mlstring list) (t :t) (tvs' :mlstring list) (ts :t list). LENGTH tvs = LENGTH ts ∧ check_freevars dbmax tvs t ∧ EVERY (check_freevars dbmax tvs') ts ⇒ check_freevars dbmax tvs' (type_subst (alist_to_fmap (ZIP (tvs,ts))) t)
check_freevars_type_name_subst_typed=∀(tvs :mlstring list) (t :ast_t) (dbmax :num) (tenvT :(mlstring, mlstring, mlstring list # t) namespace). tenv_abbrev_ok tenvT ∧ check_type_names tenvT t ∧ check_freevars_ast tvs t ⇒ check_freevars dbmax tvs (type_name_subst tenvT t)
type_p_freevars_typed=(∀(tvs :num) (tenvC :type_env) (p :pat) (t :t) (env' :(mlstring # t) list). type_p tvs tenvC p t env' ⇒ check_freevars tvs ([] :mlstring list) t ∧ EVERY (check_freevars tvs ([] :mlstring list)) (MAP (SND :mlstring # t -> t) env')) ∧ ∀(tvs :num) (tenvC :type_env) (ps :pat list) (ts :t list) (env' :(mlstring # t) list). type_ps tvs tenvC ps ts env' ⇒ EVERY (check_freevars tvs ([] :mlstring list)) ts ∧ EVERY (check_freevars tvs ([] :mlstring list)) (MAP (SND :mlstring # t -> t) env')
tenv_val_exp_ok_bvl_funs_typed=∀(funs :(mlstring # mlstring # exp) list) (env :(mlstring # t) list) (tenv :type_env) (bindings :(mlstring # t) list) (tenv_val :α) (tenvE :tenv_val_exp). type_funs tenv (bind_var_list (0 :num) bindings tenvE) funs env ∧ tenv_val_exp_ok tenvE ⇒ tenv_val_exp_ok (bind_var_list (0 :num) env tenvE)
num_tvs_bind_var_list_typed=∀(tvs :num) (env :(mlstring # t) list) (tenvE :tenv_val_exp). num_tvs (bind_var_list tvs env tenvE) = num_tvs tenvE
tenv_val_exp_ok_bvl_typed=∀(tenvE :tenv_val_exp) (env :(mlstring # t) list). tenv_val_exp_ok tenvE ∧ EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) (MAP (SND :mlstring # t -> t) env) ⇒ tenv_val_exp_ok (bind_var_list (0 :num) env tenvE)
deBruijn_subst_check_freevars_typed=∀(tvs :num) (tvs' :mlstring list) (t :t) (ts :t list) (n :α). check_freevars tvs tvs' t ∧ EVERY (check_freevars tvs tvs') ts ⇒ check_freevars tvs tvs' (deBruijn_subst (0 :num) ts t)
deBruijn_subst_check_freevars2_typed=∀(tvs :num) (tvs' :mlstring list) (t :t) (ts :t list) (n :α) (tvs'' :β). check_freevars (LENGTH ts) tvs' t ∧ EVERY (check_freevars tvs tvs') ts ⇒ check_freevars tvs tvs' (deBruijn_subst (0 :num) ts t)
check_freevars_subst_inc_typed=∀(tvs :num) (tvs2 :mlstring list) (t :t). check_freevars tvs tvs2 t ⇒ ∀(tvs' :num) (targs :t list) (tvs1 :num). tvs = LENGTH targs + tvs' ∧ EVERY (check_freevars (tvs1 + tvs') tvs2) targs ⇒ check_freevars (tvs1 + tvs') tvs2 (deBruijn_subst (0 :num) targs (deBruijn_inc (LENGTH targs) tvs1 t))
tveLookup_freevars_subst_typed=∀(tenvE :tenv_val_exp) (targs :t list) (n :mlstring) (t :t) (inc :num). EVERY (check_freevars (inc + num_tvs tenvE) ([] :mlstring list)) targs ∧ tveLookup n inc tenvE = SOME (LENGTH targs,t) ∧ tenv_val_exp_ok tenvE ⇒ check_freevars (inc + num_tvs tenvE) ([] :mlstring list) (deBruijn_subst (0 :num) targs t)
type_e_freevars_typed=(∀(tenv :type_env) (tenvE :tenv_val_exp) (e :exp) (t :t). type_e tenv tenvE e t ⇒ tenv_val_exp_ok tenvE ∧ tenv_val_ok tenv.v ⇒ check_freevars (num_tvs tenvE) ([] :mlstring list) t) ∧ (∀(tenv :type_env) (tenvE :tenv_val_exp) (es :exp list) (ts :t list). type_es tenv tenvE es ts ⇒ tenv_val_exp_ok tenvE ∧ tenv_val_ok tenv.v ⇒ EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) ts) ∧ ∀(tenv :type_env) (tenvE :tenv_val_exp) (funs :(mlstring # mlstring # exp) list) (env :(mlstring # t) list). type_funs tenv tenvE funs env ⇒ tenv_val_exp_ok tenvE ∧ tenv_val_ok tenv.v ⇒ EVERY (check_freevars (num_tvs tenvE) ([] :mlstring list)) (MAP (SND :mlstring # t -> t) env)
check_ctor_tenv_ok_typed=∀(tenvT :(mlstring, mlstring, mlstring list # t) namespace) (tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (tis :α list). LENGTH tds = LENGTH tis ∧ check_ctor_tenv tenvT tds ∧ tenv_abbrev_ok tenvT ⇒ tenv_ctor_ok (build_ctor_tenv tenvT tds tis :(β, mlstring, mlstring list # t list # α) namespace)
type_d_canon_tenv_ok_typed=(∀(check :num) (tenv :type_env) (d :dec) (tdecs :num) (tenv' :type_env). type_d_canon check tenv d tdecs tenv' ⇒ tenv_ok tenv ⇒ tenv_ok tenv') ∧ ∀(check :num) (tenv :type_env) (d :dec list) (tdecs :num) (tenv' :type_env). type_ds_canon check tenv d tdecs tenv' ⇒ tenv_ok tenv ⇒ tenv_ok tenv'
inf_set_tids_extend_dec_ienv_replay_typed=inf_set_tids_ienv (count (n :num)) (ienv2 :inf_env) ∧ inf_set_tids_ienv (count (m :num)) (ienv :inf_env) ∧ m ≤ n ⇒ inf_set_tids_ienv (count n) (extend_dec_ienv ienv2 ienv)
type_p_pat_bindings_replay_typed=(∀(tvs :num) (tenv :type_env) (p :pat) (t :t) (new_bindings :(mlstring # t) list). type_p tvs tenv p t new_bindings ⇒ MAP (FST :mlstring # t -> mlstring) new_bindings = pat_bindings p) ∧ ∀(tvs :num) (tenv :type_env) (ps :pat list) (ts :t list) (new_bindings :(mlstring # t) list). type_ps tvs tenv ps ts new_bindings ⇒ MAP (FST :mlstring # t -> mlstring) new_bindings = pats_bindings ps
t_vars_check_t_replay_typed=(∀(t :infer_t). ¬check_t (0 :num) (∅ :num -> bool) t ∧ check_t (0 :num) (s :num -> bool) t ⇒ ∃(n' :num). n' ∈ s ∧ n' ∈ t_vars t) ∧ ∀(ts :infer_t list) (x :infer_t). MEM x ts ⇒ ¬check_t (0 :num) (∅ :num -> bool) x ∧ check_t (0 :num) s x ⇒ ∃(n' :num). n' ∈ s ∧ n' ∈ t_vars x
t_walkstar_diff_replay_typed=t_wfs (s1 :num |-> infer_t) ∧ t_wfs (s2 :num |-> infer_t) ∧ t_walkstar s1 (Infer_Tuvar (n :num)) ≠ t_walkstar s2 (Infer_Tuvar n) ⇒ (∀(t :infer_t). n ∈ t_vars t ⇒ t_walkstar s1 t ≠ t_walkstar s2 t) ∧ ∀(ts :infer_t list) (x :infer_t). MEM x ts ⇒ n ∈ t_vars x ⇒ t_walkstar s1 x ≠ t_walkstar s2 x
unconvert_type_subst_replay_typed=(∀(t :t) (subst :(mlstring # t) list) (fvs :mlstring list). check_freevars (0 :num) fvs t ∧ set fvs ⊆ set (MAP (FST :mlstring # t -> mlstring) subst) ⇒ unconvert_t (type_subst (alist_to_fmap subst) t) = infer_type_subst (MAP (λ((x :mlstring),(y :t)). (x,unconvert_t y)) subst) t) ∧ ∀(ts :t list) (subst :(mlstring # t) list) (fvs :mlstring list). EVERY (check_freevars (0 :num) fvs) ts ∧ set fvs ⊆ set (MAP (FST :mlstring # t -> mlstring) subst) ⇒ MAP (unconvert_t ∘ type_subst (alist_to_fmap subst)) ts = MAP (infer_type_subst (MAP (λ((x :mlstring),(y :t)). (x,unconvert_t y)) subst)) ts
env_rel_binding_lemma_replay_typed=∀(t' :t) (fvs :mlstring list) (fvs' :mlstring list) (subst :infer_t list). check_freevars (0 :num) fvs' t' ∧ set fvs' ⊆ set fvs ∧ ALL_DISTINCT fvs' ⇒ infer_deBruijn_subst subst (infer_type_subst (ZIP (fvs',MAP Infer_Tvar_db (COUNT_LIST (LENGTH fvs')))) t') = infer_deBruijn_subst (GENLIST (λ(n :num). infer_deBruijn_subst subst (case find_index fvs❲n❳ fvs' (0 :num) of (NONE :num option) => Infer_Tapp ([] :infer_t list) (arb :num) | SOME t => Infer_Tvar_db t)) (LENGTH fvs)) (infer_type_subst (ZIP (fvs,GENLIST (λ(x :num). Infer_Tvar_db x) (LENGTH fvs))) t')
env_rel_binding_lemma2_replay_typed=∀(t' :t) (fvs :mlstring list) (fvs' :mlstring list) (subst :infer_t list). check_freevars (0 :num) fvs' t' ∧ set fvs' ⊆ set fvs ∧ ALL_DISTINCT fvs' ⇒ infer_deBruijn_subst subst (infer_type_subst (ZIP (fvs,GENLIST (λ(x :num). Infer_Tvar_db x) (LENGTH fvs))) t') = infer_deBruijn_subst (GENLIST (λ(n :num). infer_deBruijn_subst subst (case find_index fvs'❲n❳ fvs (0 :num) of (NONE :num option) => Infer_Tapp ([] :infer_t list) (TC_int :num) | SOME t => Infer_Tvar_db t)) (LENGTH fvs')) (infer_type_subst (ZIP (fvs',MAP Infer_Tvar_db (COUNT_LIST (LENGTH fvs')))) t')
infer_type_subst_check_t_less_replay_typed=LENGTH (ls :infer_t list) = LENGTH (tvs :mlstring list) ∧ EVERY (check_t (n :num) (∅ :num -> bool)) ls ⇒ (∀(t :t). check_freevars n tvs t ⇒ check_t n (∅ :num -> bool) (infer_type_subst (ZIP (tvs,ls)) t)) ∧ ∀(ts :t list). EVERY (check_freevars n tvs) ts ⇒ EVERY (check_t n (∅ :num -> bool)) (MAP (infer_type_subst (ZIP (tvs,ls))) ts)
check_freevars_deBruijn_inc_replay_typed=∀(tvs :num) (tvs' :mlstring list) (t :t). check_freevars tvs tvs' t ⇒ ∀(n :num) (n' :num). check_freevars (n + tvs) tvs' (deBruijn_inc n' n t)
tenv_to_ienv_lift_replay_typed=∀(mn :mlstring) (tenv :type_env). probe_tenv_to_ienv (tenvLift mn tenv) = lift_ienv mn (probe_tenv_to_ienv tenv)
tenv_to_ienv_extend_replay_typed=∀(tenv1 :type_env) (tenv2 :type_env). probe_tenv_to_ienv (extend_dec_tenv tenv2 tenv1) = extend_dec_ienv (probe_tenv_to_ienv tenv2) (probe_tenv_to_ienv tenv1)
check_freevars_to_check_t_replay_typed=∀(t :t) (z :α). check_freevars (n :num) ([] :mlstring list) t ⇒ check_t n (∅ :num -> bool) (unconvert_t t)
