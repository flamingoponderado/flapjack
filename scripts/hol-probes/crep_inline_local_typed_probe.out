evaluate_locals_same_fdom_prime_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ∧ (r = (NONE :α result option) ∨ (∃(n :num). r = SOME (Break n :α result)) ∨ ∃(n :num). r = SOME (Continue n :α result)) ⇒ FDOM s.locals = FDOM s'.locals
not_has_return_not_evaluate_return_prime_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state) (retv :α word_lab list). ¬has_return p ∧ (evaluate (p,s) :α result option # (α, β) state) = (r,s') ⇒ r ≠ SOME (Return retv :α result)
opt_mmap_update_list_locals_not_vars_eval_eq_prime_typed=∀(es :α crepLang$exp list) (vs :num list) (ws :β) (vals :α word_lab list) (s :(α, γ) state) (locs :num |-> α word_lab). (∀(x :num). MEM x vs ⇒ ¬MEM x (FLAT (MAP (var_cexp :α crepLang$exp -> num list) es))) ∧ LENGTH vs = LENGTH vals ⇒ OPT_MMAP (eval (s with locals := locs |++ ZIP (vs,vals)) :α crepLang$exp -> α word_lab option) es = OPT_MMAP (eval (s with locals := locs) :α crepLang$exp -> α word_lab option) es
FDIFF_fupdate_list_empty_flookup_var_typed=∀(fm :α |-> β) (zs :α list) (val :β) (val2 :γ) (fm' :α |-> β) (x :α) (v :β). FDIFF (fm |++ ZIP (zs,REPLICATE (LENGTH zs) val)) (FDOM ((FEMPTY :α |-> γ) |++ ZIP (zs,REPLICATE (LENGTH zs) val2))) ⊑ fm' ∧ FLOOKUP fm x = SOME v ∧ ¬MEM x zs ⇒ FLOOKUP fm' x = SOME v
FDIFF_fupdate_list_empty_flookup_typed=∀(xs :α list) (fm :α |-> β) (zs :α list) (val :β) (val2 :γ) (fm' :α |-> β) (vs :β list). FDIFF (fm |++ ZIP (zs,REPLICATE (LENGTH zs) val)) (FDOM ((FEMPTY :α |-> γ) |++ ZIP (zs,REPLICATE (LENGTH zs) val2))) ⊑ fm' ∧ OPT_MMAP (FLOOKUP fm) xs = SOME vs ∧ (∀(x :α). MEM x xs ⇒ ¬MEM x zs) ⇒ OPT_MMAP (FLOOKUP fm') xs = SOME vs
FOLDL_res_var_ZIP_lookup_var_typed=∀(l :α |-> β) (ns :α list) (l' :α |-> β) (l1 :α |-> β) (x :α) (v :β). FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) l (ZIP (ns,MAP (FLOOKUP l') ns)) ⊑ l1 ∧ FLOOKUP l x = SOME v ∧ ¬MEM x ns ⇒ FLOOKUP l1 x = SOME v
FOLDL_res_var_ZIP_lookup_typed=∀(l :α |-> β) (ns :α list) (l' :α |-> β) (l1 :α |-> β) (xs :α list) (vs :β list). FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) l (ZIP (ns,MAP (FLOOKUP l') ns)) ⊑ l1 ∧ OPT_MMAP (FLOOKUP l) xs = SOME vs ∧ (∀(x :α). MEM x xs ⇒ ¬MEM x ns) ⇒ OPT_MMAP (FLOOKUP l1) xs = SOME vs
submap_finish_flookup_typed=∀(fm :α |-> β) (q :α list) (l :β list) (fm' :α |-> β) (ns :α list). (∀(x :α) (y :β). ¬MEM x q ∧ ¬MEM x ns ∧ FLOOKUP fm x = SOME y ⇒ FLOOKUP fm' x = SOME y) ∧ (∀(x :α). MEM x q ⇒ ¬MEM x ns) ∧ ALL_DISTINCT q ∧ OPT_MMAP (FLOOKUP fm') q = SOME l ⇒ fm |++ ZIP (q,l) ⊑ FOLDL (res_var :(α |-> β) -> α # β option -> (α |-> β)) fm' (ZIP (ns,MAP (FLOOKUP fm) ns))
