ri_find_name_def_typed=(∀(f :num sptree$num_map) (r :num). ri_find_name f (Reg r :α reg_imm) = (Reg (find_name f r) :α reg_imm)) ∧ ∀(f :num sptree$num_map) (w :α word). ri_find_name f (Imm w) = Imm w
inst_find_name_def_typed=∀(f :num sptree$num_map) (i :α inst). inst_find_name f i = case i of (Skip :α inst) => (Skip :α inst) | Const r w => Const (find_name f r) w | (Arith (Binop bop d r' ri) :α inst) => (Arith (Binop bop (find_name f d) (find_name f r') (ri_find_name f ri)) :α inst) | (Arith (Shift sop d' r'' ri' :α arith) :α inst) => (Arith (Shift sop (find_name f d') (find_name f r'') (ri_find_name f ri') :α arith) :α inst) | (Arith (Div r1 r2 r3 :α arith) :α inst) => (Arith (Div (find_name f r1) (find_name f r2) (find_name f r3) :α arith) :α inst) | (Arith (LongMul r1'⁴' r2'⁴' r3'⁴' r4'³' :α arith) :α inst) => (Arith (LongMul (find_name f r1'⁴') (find_name f r2'⁴') (find_name f r3'⁴') (find_name f r4'³') :α arith) :α inst) | (Arith (LongDiv r1'⁵' r2'⁵' r3'⁵' r4'⁴' r5 :α arith) :α inst) => (Arith (LongDiv (find_name f r1'⁵') (find_name f r2'⁵') (find_name f r3'⁵') (find_name f r4'⁴') (find_name f r5) :α arith) :α inst) | (Arith (AddCarry r1' r2' r3' r4 :α arith) :α inst) => (Arith (AddCarry (find_name f r1') (find_name f r2') (find_name f r3') (find_name f r4) :α arith) :α inst) | (Arith (AddOverflow r1'' r2'' r3'' r4' :α arith) :α inst) => (Arith (AddOverflow (find_name f r1'') (find_name f r2'') (find_name f r3'') (find_name f r4') :α arith) :α inst) | (Arith (SubOverflow r1'³' r2'³' r3'³' r4'' :α arith) :α inst) => (Arith (SubOverflow (find_name f r1'³') (find_name f r2'³') (find_name f r3'³') (find_name f r4'') :α arith) :α inst) | Mem mop r'³' (Addr a w') => Mem mop (find_name f r'³') (Addr (find_name f a) w') | (FP (FPLess r'⁴' f1 f2) :α inst) => (FP (FPLess (find_name f r'⁴') f1 f2) :α inst) | (FP (FPLessEqual r'⁵' f1' f2') :α inst) => (FP (FPLessEqual (find_name f r'⁵') f1' f2') :α inst) | (FP (FPEqual r'⁶' f1'' f2'') :α inst) => (FP (FPEqual (find_name f r'⁶') f1'' f2'') :α inst) | (FP (FPAbs v133 v134) :α inst) => (FP (FPAbs v133 v134) :α inst) | (FP (FPNeg v135 v136) :α inst) => (FP (FPNeg v135 v136) :α inst) | (FP (FPSqrt v137 v138) :α inst) => (FP (FPSqrt v137 v138) :α inst) | (FP (FPAdd v139 v140 v141) :α inst) => (FP (FPAdd v139 v140 v141) :α inst) | (FP (FPSub v142 v143 v144) :α inst) => (FP (FPSub v142 v143 v144) :α inst) | (FP (FPMul v145 v146 v147) :α inst) => (FP (FPMul v145 v146 v147) :α inst) | (FP (FPDiv v148 v149 v150) :α inst) => (FP (FPDiv v148 v149 v150) :α inst) | (FP (FPFma v151 v152 v153) :α inst) => (FP (FPFma v151 v152 v153) :α inst) | (FP (FPMov v154 v155) :α inst) => (FP (FPMov v154 v155) :α inst) | (FP (FPMovToReg r1'⁶' r2'⁶' d'') :α inst) => (FP (FPMovToReg (find_name f r1'⁶') (find_name f r2'⁶') d'') :α inst) | (FP (FPMovFromReg d'³' r1'⁷' r2'⁷') :α inst) => (FP (FPMovFromReg d'³' (find_name f r1'⁷') (find_name f r2'⁷')) :α inst) | (FP (FPToInt v162 v163) :α inst) => (FP (FPToInt v162 v163) :α inst) | (FP (FPFromInt v164 v165) :α inst) => (FP (FPFromInt v164 v165) :α inst)
dest_find_name_def_typed=dest_find_name (f :num sptree$num_map) (INR (r :num) :α + num) = (INR (find_name f r) :α + num) ∧ dest_find_name f (INL (v2 :α) :α + num) = (INL v2 :α + num)
