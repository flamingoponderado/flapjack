make_init_def_statement=∀code coracle regs save_regs s. make_init code coracle regs save_regs s = <|regs := FEMPTY |++ MAP (λr. (r,read_reg r s)) regs; fp_regs := FEMPTY; memory := s.mem; mdomain := s.mem_domain; sh_mdomain := s.shared_mem_domain; use_stack := F; use_store := F; use_alloc := F; compile := (λc p. s.compile c (MAP prog_to_section p)); compile_oracle := coracle; code_buffer := s.code_buffer; clock := s.clock; code := code; ffi := s.ffi; ffi_save_regs := save_regs; be := s.be|>
make_init_semantics_statement=halt_assum (:'ffi # γ) code ∧ state_rel (make_init code coracle regs save_regs s) s ∧ loc_to_pc start 0 s.code = SOME s.pc ∧ semantics start (make_init code coracle regs save_regs s) ≠ Fail ⇒ semantics s = semantics start (make_init code coracle regs save_regs s)
memory_assumption_def_statement=∀rnames bitmaps data_sp t. memory_assumption rnames bitmaps data_sp t ⇔ ∃ptr2 ptr3 ptr4 bitmap_ptr. read_reg (find_name rnames 2) t = Word ptr2 ∧ read_reg (find_name rnames 3) t = Word ptr3 ∧ read_reg (find_name rnames 4) t = Word ptr4 ∧ t.mem ptr2 = Word bitmap_ptr ∧ t.mem (ptr2 + bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) ∧ t.mem (ptr2 + 2w * bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w data_sp + bytes_in_word * n2w (LENGTH bitmaps)) ∧ t.mem (ptr2 + 3w * bytes_in_word) = Word t.code_buffer.position ∧ t.mem (ptr2 + 4w * bytes_in_word) = Word (t.code_buffer.position + n2w t.code_buffer.space_left) ∧ t.code_buffer.buffer = [] ∧ ptr2 ≤₊ ptr4 ∧ byte_aligned ptr2 ∧ byte_aligned ptr4 ∧ byte_aligned bitmap_ptr ∧ 1024w * bytes_in_word ≤₊ ptr4 − ptr2 ∧ (word_list bitmap_ptr (MAP Word bitmaps) * word_list_exists (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) data_sp * word_list_exists ptr2 (w2n (-1w * ptr2 + ptr4) DIV w2n bytes_in_word)) (fun2set (t.mem,t.mem_domain))
halt_assum_lemma_statement=halt_assum (:'ffi # γ) (fromAList (compile f (compile jump off gen max_heap k l code)))
FLOOKUP_regs_statement=∀regs n v f s. FLOOKUP (FEMPTY |++ MAP (λr. (r,read_reg r s)) regs) n = SOME v ⇒ read_reg n s = v
state_rel_make_init_statement=state_rel (make_init code coracle regs save_regs s) s ⇔ (∀n prog. lookup n code = SOME prog ⇒ call_args prog s.ptr_reg s.len_reg s.ptr2_reg s.len2_reg s.link_reg ∧ ∃pc. code_installed pc (append (FST (flatten T prog n (next_lab prog 2) [] []))) s.code ∧ loc_to_pc n 0 s.code = SOME pc) ∧ ¬s.failed ∧ s.compile_oracle = (λn. (λ(c,p,_0). (c,MAP prog_to_section p)) (coracle n)) ∧ (∀k. (λ(c,ps,_1). EVERY (λ(n,p). call_args p s.ptr_reg s.len_reg s.ptr2_reg s.len2_reg s.link_reg ∧ EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p)) ps ∧ ALL_DISTINCT (MAP FST ps)) (coracle k)) ∧ s.link_reg ≠ s.len_reg ∧ s.link_reg ≠ s.ptr_reg ∧ s.link_reg ≠ s.len2_reg ∧ s.link_reg ≠ s.ptr2_reg ∧ s.link_reg ∉ save_regs ∧ domain code = set (MAP Section_num s.code) ∧ EVERY sec_labels_ok s.code ∧ (∀k i n. k ∈ save_regs ⇒ s.io_regs n i k = NONE) ∧ (∀k n. k ∈ save_regs ⇒ s.cc_regs n k = NONE) ∧ (∀x. x ∈ s.mem_domain ⇒ w2n x MOD (dimindex (:α) DIV 8) = 0) ∧ (∀x. x ∈ s.shared_mem_domain ⇒ w2n x MOD (dimindex (:α) DIV 8) = 0) ∧ good_dimindex (:α)
