make_init_def_statement=∀code coracle regs save_regs s. make_init code coracle regs save_regs s = <|regs := FEMPTY |++ MAP (λr. (r,read_reg r s)) regs; fp_regs := FEMPTY; memory := s.mem; mdomain := s.mem_domain; sh_mdomain := s.shared_mem_domain; use_stack := F; use_store := F; use_alloc := F; compile := (λc p. s.compile c (MAP prog_to_section p)); compile_oracle := coracle; code_buffer := s.code_buffer; clock := s.clock; code := code; ffi := s.ffi; ffi_save_regs := save_regs; be := s.be|>
make_init_def_statement_typed=∀(code :α prog sptree$num_map) (coracle :num -> γ # (num # α prog) list # α word list) (regs :num list) (save_regs :num -> bool) (s :(α, γ, 'ffi) labSem$state). (make_init code coracle regs save_regs s :(α, γ, 'ffi) stackSem$state) = <|regs := (FEMPTY :num |-> α word_loc) |++ MAP (λ(r :num). (r,(read_reg r s :α word_loc))) regs; fp_regs := (FEMPTY :num |-> word64); memory := s.mem; mdomain := s.mem_domain; sh_mdomain := s.shared_mem_domain; use_stack := F; use_store := F; use_alloc := F; compile := (λ(c :γ) (p :(num # α prog) list). (s.compile c (MAP (prog_to_section :num # α prog -> α sec) p) :(word8 list # γ) option)); compile_oracle := coracle; code_buffer := s.code_buffer; clock := s.clock; code := code; ffi := s.ffi; ffi_save_regs := save_regs; be := s.be|>
make_init_def_statement_types=(code :α prog sptree$num_map)::α prog sptree$num_map;(coracle :num -> γ # (num # α prog) list # α word list)::num -> γ # (num # α prog) list # α word list;(regs :num list)::num list;(save_regs :num -> bool)::num -> bool;(s :(α, γ, 'ffi) labSem$state)::(α, γ, 'ffi) labSem$state;
make_init_semantics_statement=halt_assum (:'ffi # γ) code ∧ state_rel (make_init code coracle regs save_regs s) s ∧ loc_to_pc start 0 s.code = SOME s.pc ∧ semantics start (make_init code coracle regs save_regs s) ≠ Fail ⇒ semantics s = semantics start (make_init code coracle regs save_regs s)
make_init_semantics_statement_typed=halt_assum (:'ffi # γ) (code :α prog sptree$num_map) ∧ (state_rel (make_init code (coracle :num -> γ # (num # α prog) list # α word list) (regs :num list) (save_regs :num -> bool) (s :(α, γ, 'ffi) labSem$state) :(α, γ, 'ffi) stackSem$state) s :bool) ∧ loc_to_pc (start :num) (0 :num) s.code = SOME s.pc ∧ (semantics start (make_init code coracle regs save_regs s :(α, γ, 'ffi) stackSem$state) :behaviour) ≠ Fail ⇒ (semantics s :behaviour) = (semantics start (make_init code coracle regs save_regs s :(α, γ, 'ffi) stackSem$state) :behaviour)
make_init_semantics_statement_types=(start :num)::num;(s :(α, γ, 'ffi) labSem$state)::(α, γ, 'ffi) labSem$state;(save_regs :num -> bool)::num -> bool;(regs :num list)::num list;(coracle :num -> γ # (num # α prog) list # α word list)::num -> γ # (num # α prog) list # α word list;(code :α prog sptree$num_map)::α prog sptree$num_map;
memory_assumption_def_statement=∀rnames bitmaps data_sp t. memory_assumption rnames bitmaps data_sp t ⇔ ∃ptr2 ptr3 ptr4 bitmap_ptr. read_reg (find_name rnames 2) t = Word ptr2 ∧ read_reg (find_name rnames 3) t = Word ptr3 ∧ read_reg (find_name rnames 4) t = Word ptr4 ∧ t.mem ptr2 = Word bitmap_ptr ∧ t.mem (ptr2 + bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) ∧ t.mem (ptr2 + 2w * bytes_in_word) = Word (bitmap_ptr + bytes_in_word * n2w data_sp + bytes_in_word * n2w (LENGTH bitmaps)) ∧ t.mem (ptr2 + 3w * bytes_in_word) = Word t.code_buffer.position ∧ t.mem (ptr2 + 4w * bytes_in_word) = Word (t.code_buffer.position + n2w t.code_buffer.space_left) ∧ t.code_buffer.buffer = [] ∧ ptr2 ≤₊ ptr4 ∧ byte_aligned ptr2 ∧ byte_aligned ptr4 ∧ byte_aligned bitmap_ptr ∧ 1024w * bytes_in_word ≤₊ ptr4 − ptr2 ∧ (word_list bitmap_ptr (MAP Word bitmaps) * word_list_exists (bitmap_ptr + bytes_in_word * n2w (LENGTH bitmaps)) data_sp * word_list_exists ptr2 (w2n (-1w * ptr2 + ptr4) DIV w2n bytes_in_word)) (fun2set (t.mem,t.mem_domain))
memory_assumption_def_statement_typed=∀(rnames :num sptree$num_map) (bitmaps :α word list) (data_sp :num) (t :(α, β, γ) labSem$state). memory_assumption rnames bitmaps data_sp t ⇔ ∃(ptr2 :α word) (ptr3 :α word) (ptr4 :α word) (bitmap_ptr :α word). (read_reg (find_name rnames (2 :num)) t :α word_loc) = Word ptr2 ∧ (read_reg (find_name rnames (3 :num)) t :α word_loc) = Word ptr3 ∧ (read_reg (find_name rnames (4 :num)) t :α word_loc) = Word ptr4 ∧ (t.mem ptr2 :α word_loc) = Word bitmap_ptr ∧ (t.mem (ptr2 + (bytes_in_word :α word)) :α word_loc) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ (t.mem (ptr2 + (2w :α word) * (bytes_in_word :α word)) :α word_loc) = Word (bitmap_ptr + (bytes_in_word :α word) * (n2w data_sp :α word) + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) ∧ (t.mem (ptr2 + (3w :α word) * (bytes_in_word :α word)) :α word_loc) = Word t.code_buffer.position ∧ (t.mem (ptr2 + (4w :α word) * (bytes_in_word :α word)) :α word_loc) = Word (t.code_buffer.position + (n2w t.code_buffer.space_left :α word)) ∧ t.code_buffer.buffer = ([] :word8 list) ∧ ptr2 ≤₊ ptr4 ∧ byte_aligned ptr2 ∧ byte_aligned ptr4 ∧ byte_aligned bitmap_ptr ∧ (1024w :α word) * (bytes_in_word :α word) ≤₊ ptr4 − ptr2 ∧ ((word_list bitmap_ptr (MAP (Word :α word -> α word_loc) bitmaps) :(α word # α word_loc -> bool) -> bool) * (word_list_exists (bitmap_ptr + (bytes_in_word :α word) * (n2w (LENGTH bitmaps) :α word)) data_sp :(α word # α word_loc -> bool) -> bool) * (word_list_exists ptr2 (w2n (-(1w :α word) * ptr2 + ptr4) DIV w2n (bytes_in_word :α word)) :(α word # α word_loc -> bool) -> bool)) (fun2set (t.mem,t.mem_domain))
memory_assumption_def_statement_types=(rnames :num sptree$num_map)::num sptree$num_map;(bitmaps :α word list)::α word list;(data_sp :num)::num;(t :(α, β, γ) labSem$state)::(α, β, γ) labSem$state;
halt_assum_lemma_statement=halt_assum (:'ffi # γ) (fromAList (compile f (compile jump off gen max_heap k l code)))
halt_assum_lemma_statement_typed=halt_assum (:'ffi # γ) (fromAList (compile (f :num sptree$num_map) (compile (jump :bool) (off :α word # α word) (gen :bool) (max_heap :num) (k :num) (l :num) (code :(num # α prog) list) :(num # α prog) list) :(num # α prog) list))
halt_assum_lemma_statement_types=(code :(num # α prog) list)::(num # α prog) list;(l :num)::num;(k :num)::num;(max_heap :num)::num;(gen :bool)::bool;(off :α word # α word)::α word # α word;(jump :bool)::bool;(f :num sptree$num_map)::num sptree$num_map;
FLOOKUP_regs_statement=∀regs n v f s. FLOOKUP (FEMPTY |++ MAP (λr. (r,read_reg r s)) regs) n = SOME v ⇒ read_reg n s = v
FLOOKUP_regs_statement_typed=∀(regs :num list) (n :num) (v :α word_loc) (f :β) (s :(α, γ, δ) labSem$state). FLOOKUP ((FEMPTY :num |-> α word_loc) |++ MAP (λ(r :num). (r,(read_reg r s :α word_loc))) regs) n = SOME v ⇒ (read_reg n s :α word_loc) = v
FLOOKUP_regs_statement_types=(regs :num list)::num list;(n :num)::num;(v :α word_loc)::α word_loc;(f :β)::β;(s :(α, γ, δ) labSem$state)::(α, γ, δ) labSem$state;
state_rel_make_init_statement=state_rel (make_init code coracle regs save_regs s) s ⇔ (∀n prog. lookup n code = SOME prog ⇒ call_args prog s.ptr_reg s.len_reg s.ptr2_reg s.len2_reg s.link_reg ∧ ∃pc. code_installed pc (append (FST (flatten T prog n (next_lab prog 2) [] []))) s.code ∧ loc_to_pc n 0 s.code = SOME pc) ∧ ¬s.failed ∧ s.compile_oracle = (λn. (λ(c,p,_0). (c,MAP prog_to_section p)) (coracle n)) ∧ (∀k. (λ(c,ps,_1). EVERY (λ(n,p). call_args p s.ptr_reg s.len_reg s.ptr2_reg s.len2_reg s.link_reg ∧ EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p)) ps ∧ ALL_DISTINCT (MAP FST ps)) (coracle k)) ∧ s.link_reg ≠ s.len_reg ∧ s.link_reg ≠ s.ptr_reg ∧ s.link_reg ≠ s.len2_reg ∧ s.link_reg ≠ s.ptr2_reg ∧ s.link_reg ∉ save_regs ∧ domain code = set (MAP Section_num s.code) ∧ EVERY sec_labels_ok s.code ∧ (∀k i n. k ∈ save_regs ⇒ s.io_regs n i k = NONE) ∧ (∀k n. k ∈ save_regs ⇒ s.cc_regs n k = NONE) ∧ (∀x. x ∈ s.mem_domain ⇒ w2n x MOD (dimindex (:α) DIV 8) = 0) ∧ (∀x. x ∈ s.shared_mem_domain ⇒ w2n x MOD (dimindex (:α) DIV 8) = 0) ∧ good_dimindex (:α)
state_rel_make_init_statement_typed=(state_rel (make_init (code :α prog sptree$num_map) (coracle :num -> γ # (num # α prog) list # α word list) (regs :num list) (save_regs :num -> bool) (s :(α, γ, 'ffi) labSem$state) :(α, γ, 'ffi) stackSem$state) s :bool) ⇔ (∀(n :num) (prog :α prog). (lookup n code :α prog option) = SOME prog ⇒ call_args prog s.ptr_reg s.len_reg s.ptr2_reg s.len2_reg s.link_reg ∧ ∃(pc :num). code_installed pc (append (FST (flatten T prog n (next_lab prog (2 :num)) ([] :num list) ([] :num list)))) s.code ∧ loc_to_pc n (0 :num) s.code = SOME pc) ∧ ¬s.failed ∧ s.compile_oracle = (λ(n :num). (λ((c :γ),(p :(num # α prog) list),(_0 :α word list)). (c,MAP (prog_to_section :num # α prog -> α sec) p)) (coracle n)) ∧ (∀(k :num). (λ((c :γ),(ps :(num # α prog) list),(_1 :α word list)). EVERY (λ((n :num),(p :α prog)). call_args p s.ptr_reg s.len_reg s.ptr2_reg s.len2_reg s.link_reg ∧ EVERY (λ((l1 :num),(l2 :num)). l1 = n ∧ l2 ≠ (0 :num) ∧ l2 ≠ (1 :num)) (extract_labels p) ∧ ALL_DISTINCT (extract_labels p)) ps ∧ ALL_DISTINCT (MAP (FST :num # α prog -> num) ps)) (coracle k)) ∧ s.link_reg ≠ s.len_reg ∧ s.link_reg ≠ s.ptr_reg ∧ s.link_reg ≠ s.len2_reg ∧ s.link_reg ≠ s.ptr2_reg ∧ s.link_reg ∉ save_regs ∧ (domain code :num -> bool) = set (MAP (Section_num :α sec -> num) s.code) ∧ EVERY (sec_labels_ok :α sec -> bool) s.code ∧ (∀(k :num) (i :ffiname) (n :num). k ∈ save_regs ⇒ s.io_regs n i k = (NONE :α word option)) ∧ (∀(k :num) (n :num). k ∈ save_regs ⇒ s.cc_regs n k = (NONE :α word option)) ∧ (∀(x :α word). x ∈ s.mem_domain ⇒ w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num)) ∧ (∀(x :α word). x ∈ s.shared_mem_domain ⇒ w2n x MOD (dimindex (:α) DIV (8 :num)) = (0 :num)) ∧ good_dimindex (:α)
state_rel_make_init_statement_types=(s :(α, γ, 'ffi) labSem$state)::(α, γ, 'ffi) labSem$state;(save_regs :num -> bool)::num -> bool;(regs :num list)::num list;(coracle :num -> γ # (num # α prog) list # α word list)::num -> γ # (num # α prog) list # α word list;(code :α prog sptree$num_map)::α prog sptree$num_map;
