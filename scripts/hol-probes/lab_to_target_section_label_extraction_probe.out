section_labels_line_get_code_labels=∀(pos :num) (lines :α line list) (aux :(num # num) list) (new_pos :num)
    (labs :(num # num) list).
  section_labels pos lines aux = (new_pos,labs) ⇒
  (0 :num) INSERT set (MAP (FST :num # num -> num) labs) =
  (0 :num) INSERT
  set (MAP (FST :num # num -> num) aux) ∪
  BIGUNION (IMAGE (line_get_code_labels :α line -> num -> bool) (set lines))
