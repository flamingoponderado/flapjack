copy_globals_replay=∀(n :num) (l1 :v list) (s :(α, β) state). lookup CopyGlobals_location s.code = SOME ((3 :num),SND CopyGlobals_code) ∧ FLOOKUP s.refs (p :num) = SOME (ValueArray (ls :v list) :v ref) ∧ FLOOKUP s.refs (p1 :num) = SOME (ValueArray l1 :v ref) ∧ p ≠ p1 ∧ n < LENGTH ls ∧ n < LENGTH l1 ⇒ ∃(c :num). (evaluate ([SND CopyGlobals_code],[(RefPtr (b1 :bool) p1 :v); (RefPtr (b :bool) p :v); (Number ((&n) :int) :v)],inc_clock c s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [Unit] :(v list, exn_or_ret) result),s with refs := s.refs⟨p1 ↦ (ValueArray (TAKE (SUC n) ls ++ DROP (SUC n) l1) :v ref)⟩)
copy_globals_generalized=∀(ls :v list) (n :num) (l1 :v list) (s :(α, β) state). lookup CopyGlobals_location s.code = SOME ((3 :num),SND CopyGlobals_code) ∧ FLOOKUP s.refs (p :num) = SOME (ValueArray ls :v ref) ∧ FLOOKUP s.refs (p1 :num) = SOME (ValueArray l1 :v ref) ∧ p ≠ p1 ∧ n < LENGTH ls ∧ n < LENGTH l1 ⇒ ∃(c :num). (evaluate ([SND CopyGlobals_code],[(RefPtr (b1 :bool) p1 :v); (RefPtr (b :bool) p :v); (Number ((&n) :int) :v)],inc_clock c s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [Unit] :(v list, exn_or_ret) result),s with refs := s.refs⟨p1 ↦ (ValueArray (TAKE (SUC n) ls ++ DROP (SUC n) l1) :v ref)⟩)
alloc_global_replay=FLOOKUP (s :(α, β) state).refs (p :num) = SOME (ValueArray ((Number ((&SUC (n :num)) :int) :v)::(ls :v list)) :v ref) ∧ n ≤ LENGTH ls ∧ s.global = SOME p ∧ lookup CopyGlobals_location s.code = SOME ((3 :num),SND CopyGlobals_code) ⇒ ∃(p1 :num) (c :num) (extra :num). (p1 ≠ p ⇒ p1 ∉ FDOM s.refs) ∧ n + (k :num) + (1 :num) ≤ LENGTH ls + extra ∧ (evaluate ([SND AllocGlobal_code],[(Number ((&k) :int) :v)],inc_clock c s) :(v list, exn_or_ret) result # (α, β) state) = ((Rval [Unit] :(v list, exn_or_ret) result),s with <|global := SOME p1; refs := s.refs⟨p1 ↦ (ValueArray ((Number ((&SUC (n + k)) :int) :v)::ls ++ REPLICATE extra (Number (0 :int) :v)) :v ref); p ↦ (ValueArray ((Number ((&SUC (n + k)) :int) :v)::ls) :v ref)⟩|>)
