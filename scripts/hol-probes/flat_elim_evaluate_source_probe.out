evaluate_keep_flat_state_rel_eq_lemma_typed=∀(env :v environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate env state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ (domain (find_lookupsL exprL) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ flat_state_rel reachable state removed_state ∧ (domain (find_env_globals env) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ EVERY ($¬ ∘ v_has_Eval ∘ (SND :mlstring # v -> v)) env.v ∧ EVERY ($¬ ∘ has_Eval) exprL ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). (evaluate env removed_state exprL :(γ, 'ffi) state # (v list, v) result) = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state ∧ (domain (find_sem_prim_res_globals result) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ EVERY ($¬ ∘ v_has_Eval) (result_vs result)
evaluate_sing_keep_flat_state_rel_eq_typed=∀(env :α environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (expr :exp) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate (env with v := ([] :(mlstring # v) list)) state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ flat_state_rel reachable state removed_state ∧ exprL = [expr] ∧ keep reachable expr ∧ (domain (find_lookups expr) :num -> bool) ⊆ (domain reachable :num -> bool) ∧ ¬has_Eval expr ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). (evaluate (env with v := ([] :(mlstring # v) list)) removed_state exprL :(γ, 'ffi) state # (v list, v) result) = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state
evaluate_dec_flat_state_rel_typed=∀(state :(γ, 'ffi) state) (dec :exp) (new_state :(γ, 'ffi) state) (result :v error_result option) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). evaluate_dec state dec = (new_state,result) ∧ decs_closed reachable [dec] ∧ flat_state_rel reachable state removed_state ∧ keep reachable dec ∧ ¬has_Eval_dec dec ∧ result ≠ SOME (Rabort Rtype_error :v error_result) ⇒ ∃(new_removed_state :(γ, 'ffi) state). evaluate_dec removed_state dec = (new_removed_state,result) ∧ flat_state_rel reachable new_state new_removed_state
evaluate_flat_state_rel_lemma_typed=∀(env :v environment) (state :(γ, 'ffi) state) (exprL :exp list) (new_state :(γ, 'ffi) state) (result :(v list, v) result) (reachable :sptree$num_set) (removed_state :(γ, 'ffi) state). (evaluate env state exprL :(γ, 'ffi) state # (v list, v) result) = (new_state,result) ∧ EVERY is_pure exprL ∧ EVERY ($¬ ∘ v_has_Eval ∘ (SND :mlstring # v -> v)) env.v ∧ EVERY ($¬ ∘ has_Eval) exprL ∧ EVERY (λ(e :exp). isEmpty (inter (find_loc e) reachable)) exprL ∧ flat_state_rel reachable state removed_state ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(values :v list). flat_state_rel reachable new_state removed_state ∧ result = (Rval values :(v list, v) result) ∧ EVERY ($¬ ∘ v_has_Eval) values
evaluate_sing_notKeep_flat_state_rel_typed=∀(env :α environment) (state :(β, γ) state) (exprL :exp list) (new_state :(β, γ) state) (result :(v list, v) result) (expr :exp) (reachable :sptree$num_set) (removed_state :(β, γ) state). (evaluate (env with v := ([] :(mlstring # v) list)) state exprL :(β, γ) state # (v list, v) result) = (new_state,result) ∧ exprL = [expr] ∧ ¬has_Eval expr ∧ ¬keep reachable expr ∧ flat_state_rel reachable state removed_state ∧ result ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ flat_state_rel reachable new_state removed_state ∧ ∃(value :v). result = (Rval [value] :(v list, v) result)
