fix_clock_evaluate_typed=fix_clock (s1 :α state) (evaluate s1 (env :v sem_env) (e :exp list)) = evaluate s1 env e ∧ fix_clock s1 (evaluate_decs s1 env (ds :dec list)) = evaluate_decs s1 env ds
full_evaluate_def_typed=(∀(st :'ffi state) (env :v sem_env). evaluate st env ([] :exp list) = (st,(Rval ([] :v list) :(v list, v) result))) ∧ (∀(st :'ffi state) (es :exp list) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env (e1::e2::es) = case evaluate st env [e1] of (st',(Rval v1 :(v list, v) result)) => (case evaluate st' env (e2::es) of (st'',(Rval vs :(v list, v) result)) => (st'',(Rval (HD v1::vs) :(v list, v) result)) | (st'',(Rerr v8 :(v list, v) result)) => (st'',(Rerr v8 :(v list, v) result))) | (st',(Rerr v10 :(v list, v) result)) => (st',(Rerr v10 :(v list, v) result))) ∧ (∀(st :'ffi state) (l :lit) (env :v sem_env). evaluate st env [Lit l] = (st,(Rval [Litv l] :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Raise e] = case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => (st',(Rerr (Rraise (HD v)) :(v list, v) result)) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (pes :(pat # exp) list) (env :v sem_env) (e :exp). evaluate st env [Handle e pes] = case evaluate st env [e] of (st',(Rval v7 :(v list, v) result)) => (st',(Rval v7 :(v list, v) result)) | (st',(Rerr (Rraise v) :(v list, v) result)) => if can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) v then evaluate_match st' env v pes v else (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (st',(Rerr (Rabort v12 :v error_result) :(v list, v) result)) => (st',(Rerr (Rabort v12 :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (es :exp list) (env :v sem_env) (cn :(mlstring, mlstring) id option). evaluate st env [Con cn es] = if do_con_check env.c cn (LENGTH es) then case evaluate st env (REVERSE es) of (st',(Rval vs :(v list, v) result)) => (case build_conv env.c cn (REVERSE vs) of (NONE :v option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME v => (st',(Rval [v] :(v list, v) result))) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (n :(mlstring, mlstring) id) (env :v sem_env). evaluate st env [Var n] = case nsLookup env.v n of (NONE :v option) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME v => (st,(Rval [v] :(v list, v) result))) ∧ (∀(x :mlstring) (st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Fun x e] = (st,(Rval [Closure env x e] :(v list, v) result))) ∧ (∀(st :'ffi state) (op :op) (es :exp list) (env :v sem_env). evaluate st env [App op es] = case evaluate st env (REVERSE es) of (st',(Rval vs :(v list, v) result)) => (case getOpClass op of EvalOp => (case (do_eval_res (REVERSE vs) st' :'ffi state # (v sem_env # dec list, v) result) of (st1,(Rval (env1,decs) :(v sem_env # dec list, v) result)) => if st1.clock = (0 :num) then (st1,(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else (case evaluate_decs (dec_clock st1) env1 decs of (st2,(Rval env2 :(v sem_env, v) result)) => (case declare_env st2.eval_state ((env2 +++ env1) :v sem_env) of (NONE :(v # eval_state option) option) => (st2,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (x,es2) => (st2 with eval_state := reset_env_generation st'.eval_state es2,(Rval [x] :(v list, v) result))) | (st2,(Rerr (Rraise v7) :(v sem_env, v) result)) => (st2 with eval_state := reset_env_generation st'.eval_state st2.eval_state,(Rerr (Rraise v7) :(v list, v) result)) | (st2,(Rerr (Rabort a :v error_result) :(v sem_env, v) result)) => (st2,(Rerr (Rabort a :v error_result) :(v list, v) result))) | (st1,(Rerr e :(v sem_env # dec list, v) result)) => (st1,(Rerr e :(v list, v) result))) | FunApp => (case do_opapp (REVERSE vs) of (NONE :(v sem_env # exp) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if st'.clock = (0 :num) then (st',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else evaluate (dec_clock st') env' [e]) | Force => (case dest_thunk (REVERSE vs) st'.refs of BadRef => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | NotThunk => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | IsThunk Evaluated v => (st',(Rval [v] :(v list, v) result)) | IsThunk NotEvaluated v => case do_opapp [v; Conv (NONE :stamp option) ([] :v list)] of (NONE :(v sem_env # exp) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if st'.clock = (0 :num) then (st',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else case evaluate (dec_clock st') env' [e] of (st2,(Rval vs2 :(v list, v) result)) => (case update_thunk (REVERSE vs) st2.refs vs2 of (NONE :v store_v list option) => (st2,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME refs => (st2 with refs := refs,(Rval vs2 :(v list, v) result))) | (st2,(Rerr e :(v list, v) result)) => (st2,(Rerr e :(v list, v) result))) | Simple => case do_app (st'.refs,st'.ffi) op (REVERSE vs) of (NONE :((v store_v list # 'ffi ffi_state) # (v, v) result) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME ((refs,ffi),r) => (st' with <|refs := refs; ffi := ffi|>,list_result r)) | (st',(Rerr v14 :(v list, v) result)) => (st',(Rerr v14 :(v list, v) result))) ∧ (∀(st :'ffi state) (lop :lop) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env [Log lop e1 e2] = case evaluate st env [e1] of (st',(Rval v1 :(v list, v) result)) => (case do_log lop (HD v1) e2 of (NONE :exp_or_val option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (Exp e) => evaluate st' env [e] | SOME (Val v) => (st',(Rval [v] :(v list, v) result))) | (st',(Rerr v9 :(v list, v) result)) => (st',(Rerr v9 :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (e3 :exp) (e2 :exp) (e1 :exp). evaluate st env [If e1 e2 e3] = case evaluate st env [e1] of (st',(Rval v :(v list, v) result)) => (case do_if (HD v) e2 e3 of (NONE :exp option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME e => evaluate st' env [e]) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (pes :(pat # exp) list) (env :v sem_env) (e :exp). evaluate st env [Mat e pes] = case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => if can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) (HD v) then evaluate_match st' env (HD v) pes bind_exn_v else (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(xo :mlstring option) (st :'ffi state) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env [Let xo e1 e2] = case evaluate st env [e1] of (st',(Rval v :(v list, v) result)) => evaluate st' (env with v := nsOptBind xo (HD v) env.v) [e2] | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (funs :(mlstring # mlstring # exp) list) (env :v sem_env) (e :exp). evaluate st env [Letrec funs e] = if ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) then evaluate st (env with v := build_rec_env funs env env.v) [e] else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(t :ast_t) (st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Tannot e t] = evaluate st env [e]) ∧ (∀(st :'ffi state) (l :locs) (env :v sem_env) (e :exp). evaluate st env [Lannot e l] = evaluate st env [e]) ∧ (∀(v :v) (st :'ffi state) (err_v :v) (env :v sem_env). evaluate_match st env v ([] :(pat # exp) list) err_v = (st,(Rerr (Rraise err_v) :(v list, v) result))) ∧ (∀(v :v) (st :'ffi state) (pes :(pat # exp) list) (p :pat) (err_v :v) (env :v sem_env) (e :exp). evaluate_match st env v ((p,e)::pes) err_v = if ALL_DISTINCT (pat_bindings p) then case pmatch env.c st.refs p v ([] :(mlstring # v) list) of (No_match :(mlstring # v) list match_result) => evaluate_match st env v pes err_v | (Match_type_error :(mlstring # v) list match_result) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | Match env_v' => evaluate st (env with v := nsAppend (alist_to_ns env_v' :(mlstring, mlstring, v) namespace) env.v) [e] else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env). evaluate_decs st env ([] :dec list) = (st,(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (ds :dec list) (d2 :dec) (d1 :dec). evaluate_decs st env (d1::d2::ds) = case evaluate_decs st env [d1] of (st1,(Rval env1 :(v sem_env, v) result)) => (case evaluate_decs st1 ((env1 +++ env) :v sem_env) (d2::ds) of (st2,r) => (st2,combine_dec_result env1 r)) | (st1,(Rerr v7 :(v sem_env, v) result)) => (st1,(Rerr v7 :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (p :pat) (locs :locs) (env :v sem_env) (e :exp). evaluate_decs st env [Dlet locs p e] = if ALL_DISTINCT (pat_bindings p) ∧ every_exp (one_con_check env.c) e then case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => (st',case pmatch env.c st'.refs p (HD v) ([] :(mlstring # v) list) of (No_match :(mlstring # v) list match_result) => (Rerr (Rraise bind_exn_v) :(v sem_env, v) result) | (Match_type_error :(mlstring # v) list match_result) => (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result) | Match new_vals => (Rval <|v := (alist_to_ns new_vals :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result)) | (st',(Rerr err :(v list, v) result)) => (st',(Rerr err :(v sem_env, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (locs :locs) (funs :(mlstring # mlstring # exp) list) (env :v sem_env). evaluate_decs st env [Dletrec locs funs] = (st,if ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) ∧ EVERY (λ((f :mlstring),(n :mlstring),(e :exp)). every_exp (one_con_check env.c) e) funs then (Rval <|v := build_rec_env funs env (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result) else (Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result))) ∧ (∀(tds :(mlstring list # mlstring # (mlstring # ast_t list) list) list) (st :'ffi state) (locs :locs) (env :v sem_env). evaluate_decs st env [Dtype locs tds] = if EVERY check_dup_ctors tds then (st with next_type_stamp := st.next_type_stamp + LENGTH tds,(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := build_tdefs st.next_type_stamp tds|> :(v sem_env, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result))) ∧ (∀(tvs :mlstring list) (tn :mlstring) (t :ast_t) (st :'ffi state) (locs :locs) (env :v sem_env). evaluate_decs st env [Dtabbrev locs tvs tn t] = (st,(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (n :mlstring) (env :v sem_env). evaluate_decs st env [Denv n] = case declare_env st.eval_state env of (NONE :(v # eval_state option) option) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v sem_env, v) result)) | SOME (x,es') => (st with eval_state := es',(Rval <|v := (nsSing n x :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(ts :ast_t list) (st :'ffi state) (locs :locs) (env :v sem_env) (cn :mlstring). evaluate_decs st env [Dexn locs cn ts] = (st with next_exn_stamp := st.next_exn_stamp + (1 :num),(Rval <|v := (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsSing cn (LENGTH ts,ExnStamp st.next_exn_stamp) :(mlstring, mlstring, num # stamp) namespace)|> :(v sem_env, v) result))) ∧ (∀(st :'ffi state) (mn :mlstring) (env :v sem_env) (ds :dec list). evaluate_decs st env [Dmod mn ds] = case evaluate_decs st env ds of (st',r) => (st',case r of (Rval env' :(v sem_env, v) result) => (Rval <|v := nsLift mn env'.v; c := nsLift mn env'.c|> :(v sem_env, v) result) | (Rerr err :(v sem_env, v) result) => (Rerr err :(v sem_env, v) result))) ∧ ∀(st :'ffi state) (lds :dec list) (env :v sem_env) (ds :dec list). evaluate_decs st env [Dlocal lds ds] = case evaluate_decs st env lds of (st1,(Rval env1 :(v sem_env, v) result)) => evaluate_decs st1 ((env1 +++ env) :v sem_env) ds | (st1,(Rerr v7 :(v sem_env, v) result)) => (st1,(Rerr v7 :(v sem_env, v) result))
dec_clock_def_typed=∀(s :α state). dec_clock s = s with clock := s.clock − (1 :num)
fix_clock_def_typed=∀(s :γ state) (s' :α state) (res :β). fix_clock s (s',res) = (s' with clock := if s'.clock ≤ s.clock then s'.clock else s.clock,res)
fix_clock_do_eval_res_typed=fix_clock (s :α state) (do_eval_res (vs :v list) s :α state # (v sem_env # dec list, β) result) = (do_eval_res vs s :α state # (v sem_env # dec list, β) result)
list_result_def_typed=(∀(v :α). list_result (Rval v :(α, β) result) = (Rval [v] :(α list, β) result)) ∧ ∀(e :β error_result). list_result (Rerr e :(α, β) result) = (Rerr e :(α list, β) result)
sing_env_def_typed=∀(n :mlstring) (v :v). sing_env n v = <|v := nsBind n v (nsEmpty :(mlstring, mlstring, v) namespace); c := (nsEmpty :(mlstring, mlstring, num # stamp) namespace)|>
do_eval_res_def_typed=∀(vs :v list) (s :α state). (do_eval_res vs s :α state # (v sem_env # dec list, β) result) = case do_eval vs s.eval_state of (NONE :(v sem_env # dec list # eval_state option) option) => (s,(Rerr (Rabort Rtype_error :β error_result) :(v sem_env # dec list, β) result)) | SOME (env1,decs,es1) => (s with eval_state := es1,(Rval (env1,decs) :(v sem_env # dec list, β) result))
