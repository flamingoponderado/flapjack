=> (st',(Rerr v8 :(v list, v) result)) else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(st :'ffi state) (n :(mlstring, mlstring) id) (env :v sem_env). evaluate st env [Var n] = case nsLookup env.v n of (NONE :v option) => (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME v => (st,(Rval [v] :(v list, v) result))) ∧ (∀(x :mlstring) (st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Fun x e] = (st,(Rval [Closure env x e] :(v list, v) result))) ∧ (∀(st :'ffi state) (op :op) (es :exp list) (env :v sem_env). evaluate st env [App op es] = case evaluate st env (REVERSE es) of (st',(Rval vs :(v list, v) result)) => (case getOpClass op of EvalOp => (case (do_eval_res (REVERSE vs) st' :'ffi state # (v sem_env # dec list, v) result) of (st1,(Rval (env1,decs) :(v sem_env # dec list, v) result)) => if st1.clock = (0 :num) then (st1,(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else (case evaluate_decs (dec_clock st1) env1 decs of (st2,(Rval env2 :(v sem_env, v) result)) => (case declare_env st2.eval_state ((env2 +++ env1) :v sem_env) of (NONE :(v # eval_state option) option) => (st2,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (x,es2) => (st2 with eval_state := reset_env_generation st'.eval_state es2,(Rval [x] :(v list, v) result))) | (st2,(Rerr (Rraise v7) :(v sem_env, v) result)) => (st2 with eval_state := reset_env_generation st'.eval_state st2.eval_state,(Rerr (Rraise v7) :(v list, v) result)) | (st2,(Rerr (Rabort a :v error_result) :(v sem_env, v) result)) => (st2,(Rerr (Rabort a :v error_result) :(v list, v) result))) | (st1,(Rerr e :(v sem_env # dec list, v) result)) => (st1,(Rerr e :(v list, v) result))) | FunApp => (case do_opapp (REVERSE vs) of (NONE :(v sem_env # exp) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if st'.clock = (0 :num) then (st',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else evaluate (dec_clock st') env' [e]) | Force => (case dest_thunk (REVERSE vs) st'.refs of BadRef => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | NotThunk => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | IsThunk Evaluated v => (st',(Rval [v] :(v list, v) result)) | IsThunk NotEvaluated v => case do_opapp [v; Conv (NONE :stamp option) ([] :v list)] of (NONE :(v sem_env # exp) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (env',e) => if st'.clock = (0 :num) then (st',(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)) else case evaluate (dec_clock st') env' [e] of (st2,(Rval vs2 :(v list, v) result)) => (case update_thunk (REVERSE vs) st2.refs vs2 of (NONE :v store_v list option) => (st2,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME refs => (st2 with refs := refs,(Rval vs2 :(v list, v) result))) | (st2,(Rerr e :(v list, v) result)) => (st2,(Rerr e :(v list, v) result))) | Simple => case do_app (st'.refs,st'.ffi) op (REVERSE vs) of (NONE :((v store_v list # 'ffi ffi_state) # (v, v) result) option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME ((refs,ffi),r) => (st' with <|refs := refs; ffi := ffi|>,list_result r)) | (st',(Rerr v14 :(v list, v) result)) => (st',(Rerr v14 :(v list, v) result))) ∧ (∀(st :'ffi state) (lop :lop) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env [Log lop e1 e2] = case evaluate st env [e1] of (st',(Rval v1 :(v list, v) result)) => (case do_log lop (HD v1) e2 of (NONE :exp_or_val option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME (Exp e) => evaluate st' env [e] | SOME (Val v) => (st',(Rval [v] :(v list, v) result))) | (st',(Rerr v9 :(v list, v) result)) => (st',(Rerr v9 :(v list, v) result))) ∧ (∀(st :'ffi state) (env :v sem_env) (e3 :exp) (e2 :exp) (e1 :exp). evaluate st env [If e1 e2 e3] = case evaluate st env [e1] of (st',(Rval v :(v list, v) result)) => (case do_if (HD v) e2 e3 of (NONE :exp option) => (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | SOME e => evaluate st' env [e]) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (pes :(pat # exp) list) (env :v sem_env) (e :exp). evaluate st env [Mat e pes] = case evaluate st env [e] of (st',(Rval v :(v list, v) result)) => if can_pmatch_all env.c st'.refs (MAP (FST :pat # exp -> pat) pes) (HD v) then evaluate_match st' env (HD v) pes bind_exn_v else (st',(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result)) | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(xo :mlstring option) (st :'ffi state) (env :v sem_env) (e2 :exp) (e1 :exp). evaluate st env [Let xo e1 e2] = case evaluate st env [e1] of (st',(Rval v :(v list, v) result)) => evaluate st' (env with v := nsOptBind xo (HD v) env.v) [e2] | (st',(Rerr v8 :(v list, v) result)) => (st',(Rerr v8 :(v list, v) result))) ∧ (∀(st :'ffi state) (funs :(mlstring # mlstring # exp) list) (env :v sem_env) (e :exp). evaluate st env [Letrec funs e] = if ALL_DISTINCT (MAP (λ((x :mlstring),(y :mlstring),(z :exp)). x) funs) then evaluate st (env with v := build_rec_env funs env env.v) [e] else (st,(Rerr (Rabort Rtype_error :v error_result) :(v list, v) result))) ∧ (∀(t :ast_t) (st :'ffi state) (env :v sem_env) (e :exp). evaluate st env [Tannot e t] = evaluate st env [e]) ∧ (∀(st :'ffi state) (l :locs) (env :v sem_env) (e :exp). evaluate st env [Lannot e l] = evaluate st env [e]) ∧ (∀(v :v) (st :'ffi state) (err_v :v) (env :v sem_env). evaluate_match st env v ([] :(pat # exp) list) err_v = (st,(Rerr (Rraise err_v) :(v list, v) result))) ∧ ∀(v :v) (st :'ffi state) (pes :(pat # exp) list) (p :pat) (err_v :v) (env :v sem_env) (e :exp). evaluate_match st env v ((p,e)::pes) err_v = if ALL_DISTINCT (pat_bindings p) then case pmatch env.c st.refs p v ([] :(mlstring # v) list) of (No_match 