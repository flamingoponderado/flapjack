evaluate_BignumHalt_typed=(state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(α, β) dataSem$state) (t :(γ, α, β) wordSem$state) (NONE :(v # γ word_loc) list option) (locs :(num # num) list) :bool) ∧ (get_var (reg :num) t :γ word_loc option) = SOME (Word (w :γ word)) ⇒ ∃(r :(γ, α, β) wordSem$state). (evaluate ((BignumHalt reg :γ wordLang$prog),t) :γ result option # (γ, α, β) wordSem$state) = (if ((w ' (0 :num)) :bool) then (SOME (NotEnoughSpace :γ result),r) else ((NONE :γ result option),t)) ∧ r.ffi = s.ffi ∧ t.ffi = s.ffi
do_app_safe_for_space_allowed_op_typed=(do_app (op :closLang$op) (xs :v list) (s :(α, β) dataSem$state) :(v # (α, β) dataSem$state, v) semanticPrimitives$result) = (Rval ((r :v),(s1 :(α, β) dataSem$state)) :(v # (α, β) dataSem$state, v) semanticPrimitives$result) ∧ s1.safe_for_space ⇒ allowed_op op (LENGTH xs)
InstallCode_code_thm_typed=∀(t :(α, γ, 'ffi) wordSem$state) (c :data_to_word$config) (hv1 :v) (v1 :β) (q1 :word8 list) (a1 :α word_loc) (a2 :α word_loc) (ret_val :α word_loc) (bptr :α word_loc) (s1 :δ) (vars :(v # α word_loc) list) (sp :num) (refs :v ref sptree$num_map) (ts :num). memory_rel c t.be ts refs sp t.store t.memory t.mdomain ((hv1,a1)::vars) ∧ (lookup InstallCode_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(InstallCode_code c :α wordLang$prog)) ∧ (lookup InstallData_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(InstallData_code c :α wordLang$prog)) ∧ FLOOKUP t.store BitmapBuffer = SOME bptr ∧ v_to_bytes hv1 = SOME q1 ∧ LENGTH q1 ≤ t.code_buffer.space_left ∧ LENGTH q1 < t.clock ∧ (get_var (0 :num) t :α word_loc option) = SOME ret_val ∧ (get_var (2 :num) t :α word_loc option) = SOME a1 ∧ (get_var (4 :num) t :α word_loc option) = SOME a2 ∧ (get_var (6 :num) t :α word_loc option) = SOME (Word (t.code_buffer.position + (n2w (LENGTH t.code_buffer.buffer) :α word))) ∧ good_dimindex (:α) ⇒ ∃(lsz :num option) (smx :num option). (evaluate ((InstallCode_code c :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = case (evaluate ((InstallData_code c :α wordLang$prog),t with <|locals := fromList2 [ret_val; bptr; a2; Word (t.code_buffer.position + (n2w (LENGTH t.code_buffer.buffer + LENGTH q1) :α word))]; locals_size := lsz; clock := t.clock − LENGTH q1 − (1 :num); code_buffer := t.code_buffer with <|buffer := t.code_buffer.buffer ++ q1; space_left := t.code_buffer.space_left − LENGTH q1|>; stack_max := smx|>) :α result option # (α, γ, 'ffi) wordSem$state) of (res,s) => if bad_fun_return res then (SOME (Error :α result),s) else (res,s)
InstallData_code_thm_typed=∀(t :(α, γ, 'ffi) wordSem$state) (c :data_to_word$config) (hv2 :v) (v1 :β) (q2 :word64 list) (a1 :α word_loc) (a2 :α word_loc) (ret_val :α word_loc) (s1 :δ) (vars :(v # α word_loc) list) (sp :num) (refs :v ref sptree$num_map) (ts :num). memory_rel c t.be ts refs sp t.store t.memory t.mdomain ((hv2,a2)::vars) ∧ (lookup InstallData_location t.code :(num # α wordLang$prog) option) = SOME ((4 :num),(InstallData_code c :α wordLang$prog)) ∧ (lookup Install_location t.code :(num # α wordLang$prog) option) = SOME ((3 :num),(Install_code c :α wordLang$prog)) ∧ v_to_words hv2 = SOME q2 ∧ LENGTH q2 ≤ t.data_buffer.space_left ∧ LENGTH q2 < t.clock ∧ (get_var (0 :num) t :α word_loc option) = SOME ret_val ∧ (get_var (2 :num) t :α word_loc option) = SOME (Word (t.data_buffer.position + (bytes_in_word :α word) * (n2w (LENGTH t.data_buffer.buffer) :α word))) ∧ (get_var (4 :num) t :α word_loc option) = SOME a2 ∧ (get_var (6 :num) t :α word_loc option) = SOME a1 ∧ good_dimindex (:α) ⇒ ∃(smx :num option) (lsz :num option). (evaluate ((InstallData_code c :α wordLang$prog),t) :α result option # (α, γ, 'ffi) wordSem$state) = case (evaluate ((Install_code c :α wordLang$prog),t with <|locals := fromList2 [ret_val; Word (t.data_buffer.position + (bytes_in_word :α word) * (n2w (LENGTH t.data_buffer.buffer) :α word) + (bytes_in_word :α word) * (n2w (LENGTH q2) :α word)); a1]; clock := t.clock − LENGTH q2 − (1 :num); data_buffer := t.data_buffer with <|buffer := t.data_buffer.buffer ++ MAP (w2w_upper :word64 -> α word) q2; space_left := t.data_buffer.space_left − LENGTH q2|>; locals_size := lsz; stack_max := smx|>) :α result option # (α, γ, 'ffi) wordSem$state) of (res,s) => if bad_fun_return res then (SOME (Error :α result),s) else (res,s)
assign_Install_typed=(op :closLang$op) = Install ⇒ (state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (NONE :(v # α word_loc) list option) (locs :(num # num) list) :bool) ∧ (op_requires_names op ⇎ (names_opt :sptree$num_set option) = (NONE :sptree$num_set option)) ∧ cut_state_opt names_opt s = SOME (x :(γ, 'ffi) dataSem$state) ∧ (get_vars (args :num list) s.locals :v list option) = SOME (vals :v list) ∧ t.termdep > (1 :num) ∧ (do_app op vals x :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) = (Rval ((v :v),(s2 :(γ, 'ffi) dataSem$state)) :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) ⇒ ∃(q :α result option) (r :(α, γ, 'ffi) wordSem$state). (evaluate (FST (assign c (n :num) (l :num) (dest :num) op args names_opt :α wordLang$prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (q,r) ∧ (q = SOME (NotEnoughSpace :α result) ⇒ r.ffi = t.ffi ∧ option_le r.stack_max s2.stack_max ∧ (c.gc_kind ≠ None ⇒ ¬s2.safe_for_space)) ∧ (q ≠ SOME (NotEnoughSpace :α result) ⇒ (state_rel c l1 l2 (set_var dest v s2) r (NONE :(v # α word_loc) list option) locs :bool) ∧ q = (NONE :α result option))
CopyByteAdd_thm_typed=∀(be :bool) (n :α word) (a1 :α word) (a2 :α word) (m :α word -> α word_loc) (dm :α word -> bool) (ret_val :α word_loc) (l1 :num) (l2 :num) (s :(α, γ, 'ffi) wordSem$state) (m1 :α word -> α word_loc). word_copy_fwd be n a1 a2 m dm = SOME m1 ∧ s.memory = m ∧ s.mdomain = dm ∧ (s.be ⇔ be) ∧ good_dimindex (:α) ∧ (lookup ByteCopyAdd_location s.code :(num # α wordLang$prog) option) = SOME ((5 :num),(ByteCopyAdd_code :α wordLang$prog)) ∧ w2n n DIV (4 :num) ≤ s.clock ∧ (get_var (0 :num) s :α word_loc option) = SOME (Loc l1 l2 :α word_loc) ∧ (get_var (2 :num) s :α word_loc option) = SOME (Word n) ∧ (get_var (4 :num) s :α word_loc option) = SOME (Word a1) ∧ (get_var (6 :num) s :α word_loc option) = SOME (Word a2) ∧ (get_var (8 :num) s :α word_loc option) = SOME ret_val ⇒ (evaluate ((ByteCopyAdd_code :α wordLang$prog),s) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [ret_val] :α result),s with <|clock := s.clock − w2n n DIV (4 :num); memory := m1; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); stack_max := if n <₊ (4w :α word) then s.stack_max else OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack :num option) (lookup ByteCopyAdd_location s.stack_size :num option))|>)
CopyByteSub_thm_typed=∀(be :bool) (n :α word) (a1 :α word) (a2 :α word) (m :α word -> α word_loc) (dm :α word -> bool) (ret_val :α word_loc) (l1 :num) (l2 :num) (s :(α, γ, 'ffi) wordSem$state) (m1 :α word -> α word_loc). word_copy_bwd be n a1 a2 m dm = SOME m1 ∧ s.memory = m ∧ s.mdomain = dm ∧ (s.be ⇔ be) ∧ good_dimindex (:α) ∧ (lookup ByteCopySub_location s.code :(num # α wordLang$prog) option) = SOME ((5 :num),(ByteCopySub_code :α wordLang$prog)) ∧ w2n n DIV (4 :num) ≤ s.clock ∧ (get_var (0 :num) s :α word_loc option) = SOME (Loc l1 l2 :α word_loc) ∧ (get_var (2 :num) s :α word_loc option) = SOME (Word n) ∧ (get_var (4 :num) s :α word_loc option) = SOME (Word a1) ∧ (get_var (6 :num) s :α word_loc option) = SOME (Word a2) ∧ (get_var (8 :num) s :α word_loc option) = SOME ret_val ⇒ (evaluate ((ByteCopySub_code :α wordLang$prog),s) :α result option # (α, γ, 'ffi) wordSem$state) = (SOME (Result (Loc l1 l2 :α word_loc) [ret_val] :α result),s with <|clock := s.clock − w2n n DIV (4 :num); memory := m1; locals := (LN :α word_loc sptree$num_map); locals_size := SOME (0 :num); stack_max := if n <₊ (4w :α word) then s.stack_max else OPTION_MAP2 MAX s.stack_max (OPTION_MAP2 $+ (stack_size s.stack :num option) (lookup ByteCopySub_location s.stack_size :num option))|>)
assign_CopyByte_typed=(∃(new_flag :bool). (op :closLang$op) = MemOp (CopyByte new_flag) ∧ ¬new_flag) ⇒ (state_rel (c :data_to_word$config) (l1 :num) (l2 :num) (s :(γ, 'ffi) dataSem$state) (t :(α, γ, 'ffi) wordSem$state) (NONE :(v # α word_loc) list option) (locs :(num # num) list) :bool) ∧ (op_requires_names op ⇎ (names_opt :sptree$num_set option) = (NONE :sptree$num_set option)) ∧ cut_state_opt names_opt s = SOME (x :(γ, 'ffi) dataSem$state) ∧ (get_vars (args :num list) s.locals :v list option) = SOME (vals :v list) ∧ t.termdep > (1 :num) ∧ (do_app op vals x :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) = (Rval ((v :v),(s2 :(γ, 'ffi) dataSem$state)) :(v # (γ, 'ffi) dataSem$state, v) semanticPrimitives$result) ⇒ ∃(q :α result option) (r :(α, γ, 'ffi) wordSem$state). (evaluate (FST (assign c (n :num) (l :num) (dest :num) op args names_opt :α wordLang$prog # num),t) :α result option # (α, γ, 'ffi) wordSem$state) = (q,r) ∧ (q = SOME (NotEnoughSpace :α result) ⇒ r.ffi = t.ffi ∧ option_le r.stack_max s2.stack_max ∧ (c.gc_kind ≠ None ⇒ ¬s2.safe_for_space)) ∧ (q ≠ SOME (NotEnoughSpace :α result) ⇒ (state_rel c l1 l2 (set_var dest v s2) r (NONE :(v # α word_loc) list option) locs :bool) ∧ q = (NONE :α result option))
