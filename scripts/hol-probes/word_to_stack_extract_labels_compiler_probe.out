elc_word_to_stack_lab_pres=⊢ ∀ac perf p bs kf. extract_labels p = extract_labels (FST (comp ac perf p bs kf))
elc_compile_word_to_stack_lab_pres=⊢ ∀p perf b q r. compile_word_to_stack ac perf k p b = (q,r) ∧ EVERY (λ(l,m,e). EVERY (λ(l1,l2). l1 = l ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels e) ∧ ALL_DISTINCT (extract_labels e)) p ⇒ EVERY (λ(l,e). EVERY (λ(l1,l2). l1 = l ∧ l2 ≠ 0 ∧ l2 ≠ 1) (extract_labels e) ∧ ALL_DISTINCT (extract_labels e)) q
elc_word_to_stack_compile_lab_pres=⊢ EVERY (λ(n,m,p). (let labs = extract_labels p in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) labs ∧ ALL_DISTINCT labs)) prog ⇒ (let (bytes,c,f,p) = compile asm_conf F prog in MAP FST p = raise_stub_location::store_consts_stub_location::MAP FST prog ∧ EVERY (λ(n,p). (let labs = extract_labels p in EVERY (λ(l1,l2). l1 = n ∧ l2 ≠ 0 ∧ l2 ≠ 1) labs ∧ ALL_DISTINCT labs)) p)
