pattern_cons_type=:(num # (num # num) list option) option -> pat list -> pat
pattern_lit_type=:lit -> pat
pattern_pos_type=:num -> position -> position
pattern_test_type=:position -> dTest -> dGuard
pattern_if_type=:dGuard -> dTree -> dTree -> dTree
exh_tag_ctor_type=:num -> num -> ctor
exh_ctor_arity=(∀(t :num) (a :num). ctor_arity (TagC t a) = a) ∧ (∀(a :num). ctor_arity (TupC a) = a) ∧ ctor_arity RefC = (1 :num)
exh_anys=anys (0 :num) = ([] :pat list) ∧ ∀(n :num). anys (SUC n) = Any::anys n
exh_add_head=(∀(x :α). add_head x ([] :α list list) = ([] :α list list)) ∧ ∀(x :α) (ys :α list) (yss :α list list). add_head x (ys::yss) = (x::ys)::add_head x yss
exh_mk_prods=(∀(ys :α list list). mk_prods ([] :α list) ys = ([] :α list list)) ∧ ∀(x :α) (xs :α list) (ys :α list list). mk_prods (x::xs) ys = add_head x ys ++ mk_prods xs ys
exh_mk_refs=mk_refs ([] :pat list) = ([] :pat list) ∧ ∀(p :pat) (ps :pat list). mk_refs (p::ps) = Ref p::mk_refs ps
exh_mk_conses=(∀(t :(num # (num # num) list option) option). mk_conses t ([] :pat list list) = ([] :pat list)) ∧ ∀(t :(num # (num # num) list option) option) (ps :pat list) (pss :pat list list). mk_conses t (ps::pss) = (Cons t ps :pat)::mk_conses t pss
exh_expand=expand Any = [Any] ∧ (∀(l :lit). expand (Lit l :pat) = [(Lit l :pat)]) ∧ (∀(p :pat) (q :pat). expand (Or p q :pat) = expand p ++ expand q) ∧ (∀(p :pat). expand (Ref p) = mk_refs (expand p)) ∧ (∀(t :(num # (num # num) list option) option) (ps :pat list). expand (Cons t ps :pat) = mk_conses t (expand_list ps)) ∧ expand_list ([] :pat list) = [([] :pat list)] ∧ ∀(p :pat) (ps :pat list). expand_list (p::ps) = mk_prods (expand p) (expand_list ps)
exh_mk_rows=mk_rows ([] :α list) = ([] :α list list) ∧ ∀(p :α) (ps :α list). mk_rows (p::ps) = [p]::mk_rows ps
exh_or_rows=or_rows ([] :(pat # α) list) = ([] :pat list list) ∧ ∀(rows :(pat # α) list) (p :pat) (e :α). or_rows ((p,e)::rows) = mk_rows (expand p) ++ or_rows rows
exh_tag_ctors=tag_ctors ([] :(num # num) list) = ([] :ctor list) ∧ ∀(t :num) (sibs :(num # num) list) (a :num). tag_ctors ((t,a)::sibs) = TagC t a::tag_ctors sibs
exh_ctor_nub=ctor_nub ([] :α list) = ([] :α list) ∧ ∀(x :α) (xs :α list). ctor_nub (x::xs) = if MEM x xs then ctor_nub xs else x::ctor_nub xs
exh_ctors_of=ctors_of Any = (NONE :ctor list option) ∧ ctors_of (Lit (v0 :lit) :pat) = (NONE :ctor list option) ∧ ctors_of (Or (v1 :pat) (v2 :pat) :pat) = (NONE :ctor list option) ∧ ctors_of (Ref (v3 :pat)) = SOME [RefC] ∧ ctors_of (Cons (NONE :(num # (num # num) list option) option) (qs :pat list) :pat) = SOME [TupC (LENGTH qs)] ∧ ctors_of (Cons (SOME ((t :num),(NONE :(num # num) list option))) qs :pat) = (NONE :ctor list option) ∧ ctors_of (Cons (SOME (t,SOME (sibs :(num # num) list))) qs :pat) = SOME (ctor_nub (TagC t (LENGTH qs)::tag_ctors sibs))
exh_ctor_keep=(∀(ys :α list). ctor_keep ([] :α list) ys = ([] :α list)) ∧ ∀(x :α) (xs :α list) (ys :α list). ctor_keep (x::xs) ys = if MEM x ys then x::ctor_keep xs ys else ctor_keep xs ys
exh_ctor_inter=ctor_inter (NONE :α list option) (ys' :α list option) = ys' ∧ ctor_inter (SOME (v2 :α list)) (NONE :α list option) = SOME v2 ∧ ctor_inter (SOME (xs :α list)) (SOME (ys :α list)) = SOME (ctor_keep xs ys)
exh_col_ctors=col_ctors ([] :pat list list) = (NONE :ctor list option) ∧ (∀(rows :pat list list). col_ctors (([] :pat list)::rows) = col_ctors rows) ∧ ∀(v0 :pat list) (rows :pat list list) (p :pat). col_ctors ((p::v0)::rows) = ctor_inter (ctors_of p) (col_ctors rows)
exh_spec_row=spec_row (c :ctor) ([] :pat list) = ([] :pat list list) ∧ spec_row c (Any::(rest :pat list)) = [anys (ctor_arity c) ++ rest] ∧ spec_row c ((Cons (NONE :(num # (num # num) list option) option) (qs :pat list) :pat)::rest) = (if c = TupC (LENGTH qs) then [qs ++ rest] else ([] :pat list list)) ∧ spec_row c ((Cons (SOME (ts :num # (num # num) list option)) qs :pat)::rest) = (if c = TagC (FST ts) (LENGTH qs) then [qs ++ rest] else ([] :pat list list)) ∧ spec_row c (Ref (q :pat)::rest) = (if c = RefC then [q::rest] else ([] :pat list list)) ∧ spec_row c ((Lit (l :lit) :pat)::rest) = ([] :pat list list) ∧ spec_row c ((Or (p :pat) q :pat)::rest) = ([] :pat list list)
exh_spec_mat=(∀(c :ctor). spec_mat c ([] :pat list list) = ([] :pat list list)) ∧ ∀(c :ctor) (r :pat list) (rows :pat list list). spec_mat c (r::rows) = spec_row c r ++ spec_mat c rows
exh_spec_mats=(∀(rows :pat list list). spec_mats ([] :ctor list) rows = ([] :pat list list list)) ∧ ∀(c :ctor) (cs :ctor list) (rows :pat list list). spec_mats (c::cs) rows = spec_mat c rows::spec_mats cs rows
exh_default_row=default_row (Any::(rest :pat list)) = [rest] ∧ default_row ([] :pat list) = ([] :pat list list) ∧ default_row ((Cons (v4 :(num # (num # num) list option) option) (v5 :pat list) :pat)::(v1 :pat list)) = ([] :pat list list) ∧ default_row ((Or (v6 :pat) (v7 :pat) :pat)::v1) = ([] :pat list list) ∧ default_row ((Lit (v8 :lit) :pat)::v1) = ([] :pat list list) ∧ default_row (Ref (v9 :pat)::v1) = ([] :pat list list)
exh_default_mat=default_mat ([] :pat list list) = ([] :pat list list) ∧ ∀(r :pat list) (rows :pat list list). default_mat (r::rows) = default_row r ++ default_mat rows
exh_matrix=(exh_matrix ([] :pat list list) ⇔ F) ∧ (∀(rows :pat list list) (r :pat list). exh_matrix (r::rows) ⇔ if NULL r then T else case col_ctors (r::rows) of (NONE :ctor list option) => exh_matrix (default_mat (r::rows)) | SOME cs => exh_mats (spec_mats cs (r::rows))) ∧ (exh_mats ([] :pat list list list) ⇔ T) ∧ ∀(ms :pat list list list) (m :pat list list). exh_mats (m::ms) ⇔ exh_matrix m ∧ exh_mats ms
exh_rows=∀(rows :(pat # α) list). exh_rows rows ⇔ exh_matrix (or_rows rows)
pure_cc=∀(f :β -> δ) (cc :α -> δ -> γ). pure_cc f cc = (λ(cfg :α) (prog :β). (let (prog1 :δ) = f prog in cc cfg prog1))
pure_co=∀(f :β -> γ). (pure_co f :α # β -> α # γ) = (I :α -> α) ## f
snd_pure_co=SND (pure_co (co :γ -> α) (x :β # γ)) = co (SND x)
fst_pure_co=FST (pure_co (co :γ -> β) (x :α # γ)) = FST x
pure_co_comp=(pure_co (f :δ -> γ) :β # δ -> β # γ) ∘ (pure_co (g :ε -> δ) :β # ε -> β # δ) ∘ (co :α -> β # ε) = (pure_co (f ∘ g) :β # ε -> β # γ) ∘ co
pure_co_id=(pure_co (I :β -> β) :α # β -> α # β) = (I :α # β -> α # β)
pure_cc_id=(pure_cc (I :β -> β) :(α -> β -> γ) -> α -> β -> γ) = (I :(α -> β -> γ) -> α -> β -> γ)
install_relation=∀(pat_cfg :config) (ic1 :α install_config) (ic2 :α install_config). install_conf_rel pat_cfg ic1 ic2 ⇔ ic2.compile_oracle = (pure_co (MAP (compile_dec pat_cfg)) :α # exp list -> α # exp list) ∘ ic1.compile_oracle ∧ ic1.compile = pure_cc (MAP (compile_dec pat_cfg)) ic2.compile
compile_exp_con_clause=∀(xs :exp list) (ts :(num # num option) option) (t :tra) (cfg :config). compile_exp cfg (Con t ts xs :exp) = (let ((i :num),(sg :bool),(ys :exp list)) = compile_exps cfg (REVERSE xs) in (i,sg,(Con t ts (REVERSE ys) :exp)))
compile_exp_app_clause=∀(xs :exp list) (t :tra) (op :op) (cfg :config). compile_exp cfg (App t op xs :exp) = (let ((i :num),(sg :bool),(ys :exp list)) = compile_exps cfg (REVERSE xs) in (i,sg ∨ op_sets_globals op,(App t op (REVERSE ys) :exp)))
compile_exp_letrec_clause=∀(x :exp) (t :mlstring) (fs :(mlstring # mlstring # exp) list) (cfg :config). compile_exp cfg (Letrec t fs x :exp) = (let (ys :(mlstring # mlstring # num # bool # exp) list) = MAP (λ((a :mlstring),(b :mlstring),(c :exp)). (a,b,compile_exp cfg c)) fs; ((i :num),(sgx :bool),(y :exp)) = compile_exp cfg x; (j :num) = MAX_LIST (MAP (λ((_6 :mlstring),(_7 :mlstring),(j :num),(_8 :bool),(_9 :exp)). j) ys); (sgfs :bool) = EXISTS (λ((_2 :mlstring),(_3 :mlstring),(_4 :num),(sg :bool),(_5 :exp)). sg) ys; (fs2 :(mlstring # mlstring # exp) list) = MAP (λ((a :mlstring),(b :mlstring),(_0 :num),(_1 :bool),(exp :exp)). (a,b,exp)) ys in (MAX i j,sgfs ∨ sgx,(Letrec t fs2 y :exp)))
encode_pat_pcon_clause=∀(stmp :(num # (num # (num # num) list) option) option) (ps :flatLang$pat list). encode_pat (Pcon stmp ps) = (Cons (case stmp of (NONE :(num # (num # (num # num) list) option) option) => (NONE :(num # (num # num) list option) option) | SOME (i,(NONE :(num # (num # num) list) option)) => SOME (i,(NONE :(num # num) list option)) | SOME (i,SOME (ty,ctors)) => SOME (i,SOME ctors)) (MAP (λ(a :flatLang$pat). encode_pat a) ps) :pat)
compile_pats=∀(cfg :config) (naive :bool) (t :tra) (i :num) (v :exp) (default_x :exp) (ps :(flatLang$pat # exp) list). compile_pats cfg naive t i v default_x ps = (let (branches :exp list) = MAP (compile_pat_rhs t i v) ps in if naive then naive_pattern_matches t v (ZIP (MAP (FST :flatLang$pat # exp -> flatLang$pat) ps,branches)) default_x else (let (pats :(pat # num) list) = MAPi (λ(j :num) ((p :flatLang$pat),(_0 :exp)). (encode_pat p,j)) ps; (dt :dTree) = comp pats in decode_dtree t (fromList branches :exp sptree$num_map) v default_x dt))
compile_exp_all=(∀(vid :mlstring) (t :tra) (cfg :config). compile_exp cfg (Var_local t vid) = (dec_name_to_num vid,F,Var_local t vid)) ∧ (∀(x :exp) (t :tra) (cfg :config). compile_exp cfg (Raise t x :exp) = (let ((i :num),(sg :bool),(y :exp)) = compile_exp cfg x in (i,sg,(Raise t y :exp)))) ∧ (∀(x :exp) (t :tra) (ps :(flatLang$pat # exp) list) (cfg :config). compile_exp cfg (Handle t x ps :exp) = (let ((i :num),(sgx :bool),(y :exp)) = compile_exp cfg x; ((j :num),(sgp :bool),(ps2 :(flatLang$pat # exp) list)) = compile_match cfg ps; (k :num) = MAX i j + (2 :num); (nm :mlstring) = enc_num_to_name k; (v :exp) = Var_local t nm; (r :exp) = (Raise t v :exp); (exp :exp) = compile_pats cfg sgp t k v r ps2 in (k,sgx ∨ sgp,(Handle t y [((Pvar nm :flatLang$pat),exp)] :exp)))) ∧ (∀(xs :exp list) (ts :(num # num option) option) (t :tra) (cfg :config). compile_exp cfg (Con t ts xs :exp) = (let ((i :num),(sg :bool),(ys :exp list)) = compile_exps cfg (REVERSE xs) in (i,sg,(Con t ts (REVERSE ys) :exp)))) ∧ (∀(x :exp) (vs :mlstring) (t :mlstring) (cfg :config). compile_exp cfg (Fun t vs x :exp) = (let ((i :num),(sg :bool),(y :exp)) = compile_exp cfg x in (i,sg,(Fun t vs y :exp)))) ∧ (∀(xs :exp list) (t :tra) (op :op) (cfg :config). compile_exp cfg (App t op xs :exp) = (let ((i :num),(sg :bool),(ys :exp list)) = compile_exps cfg (REVERSE xs) in (i,sg ∨ op_sets_globals op,(App t op (REVERSE ys) :exp)))) ∧ (∀(x :exp) (t :tra) (ps :(flatLang$pat # exp) list) (cfg :config). compile_exp cfg (Mat t x ps :exp) = (let ((i :num),(sgx :bool),(y :exp)) = compile_exp cfg x; ((j :num),(sgp :bool),(ps2 :(flatLang$pat # exp) list)) = compile_match cfg ps; (k :num) = MAX i j + (2 :num); (nm :mlstring) = enc_num_to_name k; (v :exp) = Var_local t nm; (r :exp) = (Raise t (Con t (SOME (bind_tag,(NONE :num option))) ([] :exp list) :exp) :exp); (exp :exp) = compile_pats cfg sgp t k v r ps2 in (k,sgx ∨ sgp,(Let t (SOME nm) y exp :exp)))) ∧ (∀(x2 :exp) (x1 :exp) (v :mlstring option) (t :tra) (cfg :config). compile_exp cfg (Let t v x1 x2 :exp) = (let ((i :num),(sg1 :bool),(y1 :exp)) = compile_exp cfg x1; ((j :num),(sg2 :bool),(y2 :exp)) = compile_exp cfg x2; (k :num) = case v of (NONE :mlstring option) => (0 :num) | SOME vid => dec_name_to_num vid in (MAX i (MAX j k),sg1 ∨ sg2,(Let t v y1 y2 :exp)))) ∧ (∀(x :exp) (t :mlstring) (fs :(mlstring # mlstring # exp) list) (cfg :config). compile_exp cfg (Letrec t fs x :exp) = (let (ys :(mlstring # mlstring # num # bool # exp) list) = MAP (λ((a :mlstring),(b :mlstring),(c :exp)). (a,b,compile_exp cfg c)) fs; ((i :num),(sgx :bool),(y :exp)) = compile_exp cfg x; (j :num) = MAX_LIST (MAP (λ((_6 :mlstring),(_7 :mlstring),(j :num),(_8 :bool),(_9 :exp)). j) ys); (sgfs :bool) = EXISTS (λ((_2 :mlstring),(_3 :mlstring),(_4 :num),(sg :bool),(_5 :exp)). sg) ys; (fs2 :(mlstring # mlstring # exp) list) = MAP (λ((a :mlstring),(b :mlstring),(_0 :num),(_1 :bool),(exp :exp)). (a,b,exp)) ys in (MAX i j,sgfs ∨ sgx,(Letrec t fs2 y :exp)))) ∧ (∀(x3 :exp) (x2 :exp) (x1 :exp) (t :tra) (cfg :config). compile_exp cfg (If t x1 x2 x3 :exp) = (let ((i :num),(sg1 :bool),(y1 :exp)) = compile_exp cfg x1; ((j :num),(sg2 :bool),(y2 :exp)) = compile_exp cfg x2; ((k :num),(sg3 :bool),(y3 :exp)) = compile_exp cfg x3 in (MAX i (MAX j k),sg1 ∨ sg2 ∨ sg3,SmartIf t y1 y2 y3))) ∧ (∀(v11 :lit) (v10 :tra) (cfg :config). compile_exp cfg (Lit v10 v11 :exp) = ((0 :num),F,(Lit v10 v11 :exp))) ∧ (∀(cfg :config). compile_exps cfg ([] :exp list) = ((0 :num),F,([] :exp list))) ∧ (∀(xs :exp list) (x :exp) (cfg :config). compile_exps cfg (x::xs) = (let ((i :num),(sgx :bool),(y :exp)) = compile_exp cfg x; ((j :num),(sgy :bool),(ys :exp list)) = compile_exps cfg xs in (MAX i j,sgx ∨ sgy,y::ys))) ∧ (∀(cfg :config). compile_match cfg ([] :(flatLang$pat # exp) list) = ((0 :num),F,([] :(flatLang$pat # exp) list))) ∧ ∀(x :exp) (ps :(flatLang$pat # exp) list) (p :flatLang$pat) (cfg :config). compile_match cfg ((p,x)::ps) = (let ((i :num),(sgx :bool),(y :exp)) = compile_exp cfg x; (j :num) = max_dec_name (pat_bindings p); ((k :num),(sgp :bool),(ps2 :(flatLang$pat # exp) list)) = compile_match cfg ps in (MAX i (MAX j k),sgx ∨ sgp,(p,y)::ps2))
compile_dec=∀(cfg :config) (exp :exp). compile_dec cfg exp = SND (SND (compile_exp cfg exp))
flat_evaluate_nil=∀(s :(γ, 'ffi) state) (env :v environment). (evaluate env s ([] :exp list) :(γ, 'ffi) state # (v list, v) result) = (s,(Rval ([] :v list) :(v list, v) result))
flat_evaluate_dec=∀(s :(γ, 'ffi) state) (e :exp). evaluate_dec s e = case (evaluate <|v := ([] :(mlstring # v) list)|> s [e] :(γ, 'ffi) state # (v list, v) result) of (s',(Rval [Unitv] :(v list, v) result)) => (s',(NONE :v error_result option)) | (s',(Rval x :(v list, v) result)) => (s',SOME (Rabort Rtype_error :v error_result)) | (s',(Rerr e :(v list, v) result)) => (s',SOME e)
flat_evaluate_decs_nil=∀(s :(γ, 'ffi) state). (evaluate_decs s ([] :exp list) :(γ, 'ffi) state # v error_result option) = (s,(NONE :v error_result option))
flat_evaluate_decs_cons=∀(s :(γ, 'ffi) state) (ds :exp list) (d :exp). (evaluate_decs s (d::ds) :(γ, 'ffi) state # v error_result option) = case evaluate_dec s d of (s',(NONE :v error_result option)) => (evaluate_decs s' ds :(γ, 'ffi) state # v error_result option) | (s',SOME e) => (s',SOME e)
comp_is_const_row=(is_const_row ((Cons (v0 :(num # (num # num) list option) option) (pats :pat list) :pat),(x :α)) ⇔ NULL pats) ∧ (is_const_row (Any,(v2 :α)) ⇔ F) ∧ (is_const_row ((Or (v7 :pat) (v8 :pat) :pat),v2) ⇔ F) ∧ (is_const_row ((Lit (v9 :lit) :pat),v2) ⇔ F) ∧ (is_const_row (Ref (v10 :pat),v2) ⇔ F)
comp_is_any=(is_Any Any ⇔ T) ∧ (∀(p2 :pat) (p1 :pat). is_Any (Or p1 p2 :pat) ⇔ is_Any p1 ∨ is_Any p2) ∧ (∀(v1 :pat list) (v :(num # (num # num) list option) option). is_Any (Cons v v1 :pat) ⇔ F) ∧ (∀(v4 :lit). is_Any (Lit v4 :pat) ⇔ F) ∧ ∀(v5 :pat). is_Any (Ref v5) ⇔ F
comp_is_or_row=(is_Or_row ((Or (p1 :pat) (p2 :pat) :pat),(v0 :α)) ⇔ T) ∧ (is_Or_row (Any,(v2 :α)) ⇔ F) ∧ (is_Or_row ((Cons (v5 :(num # (num # num) list option) option) (v6 :pat list) :pat),v2) ⇔ F) ∧ (is_Or_row ((Lit (v9 :lit) :pat),v2) ⇔ F) ∧ (is_Or_row (Ref (v10 :pat),v2) ⇔ F)
comp_take_until_any=take_until_Any ([] :(pat # α) list) = ([] :(pat # α) list) ∧ ∀(xs :(pat # α) list) (x :α) (p :pat). take_until_Any ((p,x)::xs) = if is_Any p then [(p,x)] else (p,x)::take_until_Any xs
comp_move_const_up=∀(rows :(pat # α) list). move_const_up rows = (let (new_rows :(pat # α) list) = take_until_Any rows in if (5 :num) ≤ LENGTH new_rows ∨ EXISTS (is_Or_row :pat # α -> bool) new_rows then new_rows else FILTER (is_const_row :pat # α -> bool) new_rows ++ FILTER (λ(x :pat # α). ¬is_const_row x) new_rows)
comp_insert_any=insert_Any ([] :(pat # α) list) = ([] :(pat # α) list) ∧ (∀(x :α) (p :pat). insert_Any [(p,x)] = [(Any,x)]) ∧ ∀(x :pat # α) (v3 :(pat # α) list) (v2 :pat # α). insert_Any (x::v2::v3) = x::insert_Any (v2::v3)
comp_is_true=(is_True True ⇔ T) ∧ (is_True (PosTest (v :position) (v1 :dTest)) ⇔ F) ∧ (is_True (Not (v2 :dGuard) :dGuard) ⇔ F) ∧ (is_True (Conj (v3 :dGuard) (v4 :dGuard)) ⇔ F) ∧ (is_True (Disj (v5 :dGuard) (v6 :dGuard)) ⇔ F)
comp_mk_disj=∀(p :dGuard) (q :dGuard). mk_Disj p q = if is_True p ∨ is_True q then True else Disj p q
comp_mk_conj=∀(p :dGuard) (q :dGuard). mk_Conj p q = if is_True p then q else if is_True q then p else Conj p q
comp_mk_if=∀(g :dGuard) (p :dTree) (q :dTree). mk_If g p q = if is_True g then p else (If g p q :dTree)
comp_get_pos=get_pos ([] :num list) = EmptyPos ∧ ∀(n :num) (ns :num list). get_pos (n::ns) = Pos n (get_pos ns)
comp_pat_to_guard=(∀(l :num list). pat_to_guard l Any = True) ∧ (∀(r :lit) (l :num list). pat_to_guard l (Lit r :pat) = PosTest (get_pos (REVERSE l)) (LitEq r)) ∧ (∀(pats :pat list) (l :num list). pat_to_guard l (Cons (NONE :(num # (num # num) list option) option) pats :pat) = pats_to_guard l (0 :num) pats) ∧ (∀(v0 :(num # num) list option) (t :num) (pats :pat list) (l :num list). pat_to_guard l (Cons (SOME (t,v0)) pats :pat) = mk_Conj (PosTest (get_pos (REVERSE l)) (TagLenEq t (LENGTH pats) :dTest)) (pats_to_guard l (0 :num) pats)) ∧ (∀(p2 :pat) (p1 :pat) (l :num list). pat_to_guard l (Or p1 p2 :pat) = mk_Disj (pat_to_guard l p1) (pat_to_guard l p2)) ∧ (∀(p :pat) (l :num list). pat_to_guard l (Ref p) = pat_to_guard ((0 :num)::l) p) ∧ (∀(l :num list) (k :num). pats_to_guard l k ([] :pat list) = True) ∧ (∀(p :pat) (l :num list) (k :num). pats_to_guard l k [p] = pat_to_guard (k::l) p) ∧ ∀(v20 :pat list) (v19 :pat) (p :pat) (l :num list) (k :num). pats_to_guard l k (p::v19::v20) = mk_Conj (pat_to_guard (k::l) p) (pats_to_guard l (k + (1 :num)) (v19::v20))
comp_pats_to_code=pats_to_code ([] :(pat # num) list) = Fail ∧ ∀(x :num) (rows :(pat # num) list) (p :pat). pats_to_code ((p,x)::rows) = mk_If (pat_to_guard ([] :num list) p) (Leaf x) (pats_to_code rows)
comp_definition=∀(rows :(pat # num) list). comp rows = (let (rows0 :(pat # num) list) = move_const_up rows; (rows1 :(pat # num) list) = if exh_rows rows0 then insert_Any rows0 else rows0 in pats_to_code rows1)
decs_semantics=install_conf_rel (cfg :config) (ic1 :α install_config) (ic2 :α install_config) ∧ semantics ic1 (ffi :β ffi_state) (prog :exp list) ≠ Fail ⇒ semantics ic1 ffi prog = semantics ic2 ffi (MAP (compile_dec (cfg1 :config)) prog)
basic_values=(∀(l :lit) (v :v). simple_basic_val_rel (Litv l :v) v ⇔ v = (Litv l :v)) ∧ (∀(b :bool) (i :num) (v :v). simple_basic_val_rel (Loc b i :v) v ⇔ v = (Loc b i :v)) ∧ (∀(stmp :(num # num option) option) (vs1 :v list) (v :v). simple_basic_val_rel (Conv stmp vs1) v ⇔ ∃(vs2 :v list). v = Conv stmp vs2) ∧ (∀(vs1 :v list) (v :v). simple_basic_val_rel (Vectorv vs1) v ⇔ ∃(vs2 :v list). v = Vectorv vs2) ∧ (∀(vs :v environment) (nm :mlstring) (exp :exp) (v :v). simple_basic_val_rel (Closure vs nm exp :v) v ⇔ F) ∧ ∀(vs :v environment) (exps :(mlstring # mlstring # exp) list) (nm :mlstring) (v :v). simple_basic_val_rel (Recclosure vs exps nm :v) v ⇔ F
value_contents=(∀(v0 :lit). v_container_xs (Litv v0 :v) = ([] :v list)) ∧ (∀(v1 :bool) (v2 :num). v_container_xs (Loc v1 v2 :v) = ([] :v list)) ∧ (∀(v3 :(num # num option) option) (vs :v list). v_container_xs (Conv v3 vs) = vs) ∧ (∀(vs :v list). v_container_xs (Vectorv vs) = vs) ∧ (∀(vs :v environment) (nm :mlstring) (exp :exp). v_container_xs (Closure vs nm exp :v) = ([] :v list)) ∧ ∀(vs :v environment) (exps :(mlstring # mlstring # exp) list) (nm :mlstring). v_container_xs (Recclosure vs exps nm :v) = ([] :v list)
store_relation=(sv_rel (R :α -> β -> bool) (Refv (v1 :α)) (Refv (v2 :β)) ⇔ R v1 v2) ∧ (sv_rel R (W8array (w1 :word8 list) :α store_v) (W8array (w2 :word8 list) :β store_v) ⇔ w1 = w2) ∧ (sv_rel R (Varray (vs1 :α list)) (Varray (vs2 :β list)) ⇔ LIST_REL R vs1 vs2) ∧ (sv_rel R (Thunk (m1 :thunk_mode) v1) (Thunk (m2 :thunk_mode) v2) ⇔ m1 = m2 ∧ R v1 v2) ∧ (sv_rel R (Refv (v7 :α)) (W8array (v18 :word8 list) :β store_v) ⇔ F) ∧ (sv_rel R (Refv v7) (Varray (v19 :β list)) ⇔ F) ∧ (sv_rel R (Refv v7) (Thunk (v20 :thunk_mode) (v21 :β)) ⇔ F) ∧ (sv_rel R (W8array (v8 :word8 list) :α store_v) (Refv (v27 :β)) ⇔ F) ∧ (sv_rel R (W8array v8 :α store_v) (Varray (v29 :β list)) ⇔ F) ∧ (sv_rel R (W8array v8 :α store_v) (Thunk (v30 :thunk_mode) (v31 :β)) ⇔ F) ∧ (sv_rel R (Varray (v9 :α list)) (Refv (v37 :β)) ⇔ F) ∧ (sv_rel R (Varray v9) (W8array (v38 :word8 list) :β store_v) ⇔ F) ∧ (sv_rel R (Varray v9) (Thunk (v40 :thunk_mode) (v41 :β)) ⇔ F) ∧ (sv_rel R (Thunk (v10 :thunk_mode) (v11 :α)) (Refv (v47 :β)) ⇔ F) ∧ (sv_rel R (Thunk v10 v11) (W8array (v48 :word8 list) :β store_v) ⇔ F) ∧ (sv_rel R (Thunk v10 v11) (Varray (v49 :β list)) ⇔ F)
value_relation_rules=(∀(v :v) (v' :v). simple_basic_val_rel v v' ∧ LIST_REL v_rel (v_container_xs v) (v_container_xs v') ⇒ v_rel v v') ∧ (∀(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). env_rel N env1 env2 ∧ FST (compile_exp cfg x) < N ⇒ v_rel (Closure env1 n x :v) (Closure env2 n (SND (SND (compile_exp cfg x))) :v)) ∧ (∀(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). env_rel N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs ⇒ v_rel (Recclosure env1 fs x :v) (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v)) ∧ ∀(N :num) (env1 :v environment) (env2 :v environment). ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env1.v env2.v ⇒ env_rel N env1 env2
value_relation_induction=∀(v_rel' :v -> v -> bool) (env_rel' :num -> v environment -> v environment -> bool). (∀(v :v) (v' :v). simple_basic_val_rel v v' ∧ LIST_REL v_rel' (v_container_xs v) (v_container_xs v') ⇒ v_rel' v v') ∧ (∀(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). env_rel' N env1 env2 ∧ FST (compile_exp cfg x) < N ⇒ v_rel' (Closure env1 n x :v) (Closure env2 n (SND (SND (compile_exp cfg x))) :v)) ∧ (∀(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). env_rel' N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs ⇒ v_rel' (Recclosure env1 fs x :v) (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v)) ∧ (∀(N :num) (env1 :v environment) (env2 :v environment). ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel' env1.v env2.v ⇒ env_rel' N env1 env2) ⇒ (∀(a0 :v) (a1 :v). v_rel a0 a1 ⇒ v_rel' a0 a1) ∧ ∀(a2 :num) (a3 :v environment) (a4 :v environment). env_rel a2 a3 a4 ⇒ env_rel' a2 a3 a4
value_relation_cases=(∀(a0 :v) (a1 :v). v_rel a0 a1 ⇔ simple_basic_val_rel a0 a1 ∧ LIST_REL v_rel (v_container_xs a0) (v_container_xs a1) ∨ (∃(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). a0 = (Closure env1 n x :v) ∧ a1 = (Closure env2 n (SND (SND (compile_exp cfg x))) :v) ∧ env_rel N env1 env2 ∧ FST (compile_exp cfg x) < N) ∨ ∃(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). a0 = (Recclosure env1 fs x :v) ∧ a1 = (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v) ∧ env_rel N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs) ∧ ∀(a2 :num) (a3 :v environment) (a4 :v environment). env_rel a2 a3 a4 ⇔ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < a2) v_rel a3.v a4.v
value_rule_basic=∀(v :v) (v' :v). simple_basic_val_rel v v' ∧ LIST_REL v_rel (v_container_xs v) (v_container_xs v') ⇒ v_rel v v'
value_rule_closure=∀(N :num) (env1 :v environment) (n :mlstring) (x :exp) (env2 :v environment) (cfg :config). env_rel N env1 env2 ∧ FST (compile_exp cfg x) < N ⇒ v_rel (Closure env1 n x :v) (Closure env2 n (SND (SND (compile_exp cfg x))) :v)
value_rule_recclosure=∀(N :num) (env1 :v environment) (fs :(mlstring # mlstring # exp) list) (x :mlstring) (env2 :v environment) (cfg :config). env_rel N env1 env2 ∧ EVERY (λ((n :mlstring),(m :mlstring),(e :exp)). FST (compile_exp cfg e) < N) fs ⇒ v_rel (Recclosure env1 fs x :v) (Recclosure env2 (MAP (λ((n :mlstring),(m :mlstring),(e :exp)). (n,m,SND (SND (compile_exp cfg e)))) fs) x :v)
value_rule_env=∀(N :num) (env1 :v environment) (env2 :v environment). ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env1.v env2.v ⇒ env_rel N env1 env2
state_relation=∀(cfg :config) (s :(γ, 'ffi) state) (t :(γ, 'ffi) state). state_rel cfg s t ⇔ t.clock = s.clock ∧ LIST_REL (sv_rel v_rel) s.refs t.refs ∧ t.ffi = s.ffi ∧ LIST_REL (OPTREL v_rel) s.globals t.globals ∧ install_conf_rel cfg s.eval_config t.eval_config
state_relation_clock=∀(cfg :config) (s :(α, β) state) (t :(α, β) state). state_rel cfg s t ⇒ t.clock = s.clock
initial_states=install_conf_rel (cfg :config) (ic1 :α install_config) (ic2 :α install_config) ⇒ state_rel cfg (initial_state (ffi :β ffi_state) (k :num) ic1) (initial_state ffi k ic2)
match_relation=(match_rel (N :num) (Match (env1 :(mlstring # v) list)) (Match (env2 :(mlstring # v) list)) ⇔ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env1 env2) ∧ (match_rel N (No_match :(mlstring # v) list match_result) (No_match :(mlstring # v) list match_result) ⇔ T) ∧ (match_rel N (Match_type_error :(mlstring # v) list match_result) (Match_type_error :(mlstring # v) list match_result) ⇔ T) ∧ (match_rel N (No_match :(mlstring # v) list match_result) (Match_type_error :(mlstring # v) list match_result) ⇔ F) ∧ (match_rel N (No_match :(mlstring # v) list match_result) (Match (v7 :(mlstring # v) list)) ⇔ F) ∧ (match_rel N (Match_type_error :(mlstring # v) list match_result) (No_match :(mlstring # v) list match_result) ⇔ F) ∧ (match_rel N (Match_type_error :(mlstring # v) list match_result) (Match (v9 :(mlstring # v) list)) ⇔ F) ∧ (match_rel N (Match (v5 :(mlstring # v) list)) (No_match :(mlstring # v) list match_result) ⇔ F) ∧ (match_rel N (Match v5) (Match_type_error :(mlstring # v) list match_result) ⇔ F)
match_relation_simp=(match_rel (N :num) (Match_type_error :(mlstring # v) list match_result) (e :(mlstring # v) list match_result) ⇔ e = (Match_type_error :(mlstring # v) list match_result)) ∧ (match_rel N e (Match_type_error :(mlstring # v) list match_result) ⇔ e = (Match_type_error :(mlstring # v) list match_result)) ∧ (match_rel N (No_match :(mlstring # v) list match_result) e ⇔ e = (No_match :(mlstring # v) list match_result)) ∧ (match_rel N e (No_match :(mlstring # v) list match_result) ⇔ e = (No_match :(mlstring # v) list match_result))
match_relation_cases=match_rel (N :num) (e :(mlstring # v) list match_result) (e' :(mlstring # v) list match_result) ⇒ e = (No_match :(mlstring # v) list match_result) ∧ e = e' ∨ e = (Match_type_error :(mlstring # v) list match_result) ∧ e = e' ∨ ∃(env1 :(mlstring # v) list) (env2 :(mlstring # v) list). e = Match env1 ∧ e' = Match env2 ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env1 env2
max_add_less=MAX (i :num) (j :num) + (k :num) < (l :num) ⇔ i + k < l ∧ j + k < l
less_max_add=(l :num) < MAX (i :num) (j :num) + (k :num) ⇔ l < i + k ∨ l < j + k
max_add_le=MAX (i :num) (j :num) + (k :num) ≤ (l :num) ⇔ i + k ≤ l ∧ j + k ≤ l
environment_relation_mono=env_rel (i :num) (env1 :v environment) (env2 :v environment) ∧ (j :num) ≤ i ⇒ env_rel j env1 env2
environment_relation_lookup=env_rel (N :num) (env1 :v environment) (env2 :v environment) ∧ dec_name_to_num (n :mlstring) < N ⇒ OPTREL v_rel (ALOOKUP env1.v n) (ALOOKUP env2.v n)
alookup_map_3=(∀(x :α # β). MEM x (xs :(α # β) list) ⇒ FST ((f :α # β -> α # γ) x) = FST x) ⇒ ALOOKUP (MAP f xs) (x :α) = OPTION_MAP (λ(y :β). SND (f (x,y))) (ALOOKUP xs x)
lookup_map_same=(∀(x :α). MEM x (xs :α list) ⇒ FST ((f :α -> β # γ) x) = FST ((g :α -> β # δ) x) ∧ ((P :β -> bool) (FST (g x)) ⇒ (R :γ -> δ -> bool) (SND (f x)) (SND (g x)))) ⇒ ALOOKUP_rel P R (MAP f xs) (MAP g xs)
do_opapp=(do_opapp (vs1 :v list) :(v environment # exp) option) = SOME ((env1 :v environment),(exp :exp)) ∧ LIST_REL v_rel vs1 (vs2 :v list) ⇒ ∃(i :num) (sg :bool) (exp' :exp) (env2 :v environment) (cfg :config). compile_exp cfg exp = (i,sg,exp') ∧ env_rel (i + (1 :num)) env1 env2 ∧ (do_opapp vs2 :(v environment # exp) option) = SOME (env2,exp')
do_opapp_reverse=(do_opapp (REVERSE (vs1 :v list)) :(v environment # exp) option) = SOME ((env1 :v environment),(exp :exp)) ∧ LIST_REL v_rel vs1 (vs2 :v list) ⇒ ∃(i :num) (sg :bool) (exp' :exp) (env2 :v environment) (cfg :config). compile_exp cfg exp = (i,sg,exp') ∧ env_rel (i + (1 :num)) env1 env2 ∧ (do_opapp (REVERSE vs2) :(v environment # exp) option) = SOME (env2,exp')
pmatch_simulation=(∀(s :(γ, 'ffi) state) (p :flatLang$pat) (v :v) (vs :(mlstring # v) list) (r :(mlstring # v) list match_result) (s1 :(γ, 'ffi) state) (v1 :v) (vs1 :(mlstring # v) list). (pmatch s p v vs :(mlstring # v) list match_result) = r ∧ r ≠ (Match_type_error :(mlstring # v) list match_result) ∧ state_rel (cfg :config) s s1 ∧ v_rel v v1 ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < (N :num)) v_rel vs vs1 ⇒ ∃(r1 :(mlstring # v) list match_result). (pmatch s1 p v1 vs1 :(mlstring # v) list match_result) = r1 ∧ match_rel N r r1) ∧ ∀(s :(γ, 'ffi) state) (ps :flatLang$pat list) (v :v list) (vs :(mlstring # v) list) (r :(mlstring # v) list match_result) (s1 :(γ, 'ffi) state) (v1 :v list) (vs1 :(mlstring # v) list). (pmatch_list s ps v vs :(mlstring # v) list match_result) = r ∧ r ≠ (Match_type_error :(mlstring # v) list match_result) ∧ state_rel cfg s s1 ∧ LIST_REL v_rel v v1 ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel vs vs1 ⇒ ∃(r1 :(mlstring # v) list match_result). (pmatch_list s1 ps v1 vs1 :(mlstring # v) list match_result) = r1 ∧ match_rel N r r1
compile_match_pmatch_rows=∀(pats :(flatLang$pat # exp) list) (k :num) (sg :bool) (pats2 :(flatLang$pat # exp) list) (res :((mlstring # v) list # flatLang$pat # exp) match_result). compile_match (cfg :config) pats = (k,sg,pats2) ∧ state_rel (s_cfg :config) (s :(α, β) state) (t :(α, β) state) ∧ v_rel (v :v) (v' :v) ∧ k ≤ (N :num) ∧ pmatch_rows pats s v = res ⇒ case res of (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) => pmatch_rows pats2 t v' = (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) | (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) => T | Match (env,p,e) => ∃(i :num) (env' :(mlstring # v) list). i < LENGTH pats ∧ i < LENGTH pats2 ∧ (p,e) = pats❲i❳ ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < N) v_rel env env' ∧ pmatch_rows pats2 t v' = Match (env',pats2❲i❳)
compile_match_EL=∀(pats :(flatLang$pat # exp) list) (pats2 :(flatLang$pat # exp) list) (k :num) (sg :bool) (i :num). compile_match (cfg :config) pats = (k,sg,pats2) ∧ i < LENGTH pats ∧ pats❲i❳ = ((pat :flatLang$pat),(exp :exp)) ⇒ ∃(exp_i :num) (sg :bool) (exp' :exp). compile_exp cfg exp = (exp_i,sg,exp') ∧ pats2❲i❳ = (pat,exp') ∧ exp_i ≤ k ∧ max_dec_name (pat_bindings pat) ≤ k
pmatch_list_length=∀(xs :flatLang$pat list) (ys :v list) (env :(mlstring # v) list) (env' :(mlstring # v) list) (s :(α, β) state). (pmatch_list s xs ys env :(mlstring # v) list match_result) = Match env' ⇒ LENGTH xs = LENGTH ys
pmatch_list_append=(pmatch_list (s :(α, β) state) ((xs :flatLang$pat list) ++ (ys :flatLang$pat list)) (vs :v list) (pre_bindings :(mlstring # v) list) :(mlstring # v) list match_result) = Match (bindings :(mlstring # v) list) ⇔ ∃(vs1 :v list) (vs2 :v list) (bindings1 :(mlstring # v) list). vs = vs1 ++ vs2 ∧ (pmatch_list s xs vs1 pre_bindings :(mlstring # v) list match_result) = Match bindings1 ∧ (pmatch_list s ys vs2 bindings1 :(mlstring # v) list match_result) = Match bindings
compile_pat_bindings_simulation=∀(t :tra) (i :num) (n_bindings :(flatLang$pat # num # exp) list) (exp :exp) (exp2 :exp) (spt :sptree$num_set) (s :(α, β) state) (vs :v list) (pre_bindings :(mlstring # v) list) (bindings :(mlstring # v) list) (env :v environment) (s2 :(α, β) state) (res :(v list, v) result) (vset :γ). compile_pat_bindings t i n_bindings exp = (spt,exp2) ∧ (pmatch_list s (MAP (FST :flatLang$pat # num # exp -> flatLang$pat) n_bindings) vs pre_bindings :(mlstring # v) list match_result) = Match bindings ∧ (evaluate env s [exp2] :(α, β) state # (v list, v) result) = (s2,res) ∧ LIST_REL (λ((_0 :flatLang$pat),(k :num),(v_exp :exp)) (v :v). ∀(env2 :v environment). k ∈ (domain spt :num -> bool) ∧ ALOOKUP_rel ((λ(k :num). k > (j :num) ∧ k < i) ∘ dec_name_to_num) ($= :v -> v -> bool) env2.v env.v ⇒ pure_eval_to s env2 v_exp v) n_bindings vs ∧ EVERY ((λ(k :num). k < j) ∘ dec_name_to_num ∘ (FST :mlstring # v -> mlstring)) pre_bindings ∧ j < i ∧ ALOOKUP_rel ((λ(k :num). k < j) ∘ dec_name_to_num) ($= :v -> v -> bool) env.v (pre_bindings ++ (base_vs :(mlstring # v) list)) ∧ EVERY (λ((p :flatLang$pat),(k :num),(_1 :exp)). EVERY (λ(nm :mlstring). dec_name_to_num nm < j) (pat_bindings p) ∧ j < k ∧ k < i) n_bindings ⇒ ∃(env2 :v environment). (evaluate env2 s [exp] :(α, β) state # (v list, v) result) = (s2,res) ∧ ALOOKUP_rel ((λ(k :num). k < j) ∘ dec_name_to_num) ($= :v -> v -> bool) env2.v (bindings ++ base_vs)
evaluate_compile_pat_rhs=(evaluate ((env3 :γ environment) with v updated_by (f :(mlstring # γ) list -> (mlstring # v) list)) (s :(α, β) state) [compile_pat_rhs (tr :tra) (N :num) (Var_local tr (enc_num_to_name N)) ((p :flatLang$pat),(exp :exp))] :(α, β) state # (v list, v) result) = ((t :(α, β) state),(res :(v list, v) result)) ∧ (pmatch s p (v :v) ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match (bindings :(mlstring # v) list) ∧ env_rel (M :num) (env1 :v environment) (env2 :v environment) ∧ ALOOKUP_rel (λ(x :mlstring). dec_name_to_num x < M) v_rel (l_bindings :(mlstring # v) list) bindings ∧ f env3.v = (enc_num_to_name N,v)::env2.v ∧ N ≤ M ∧ max_dec_name (pat_bindings p) < N − (1 :num) ⇒ ∃(ext_env :v environment). (evaluate ext_env s [exp] :(α, β) state # (v list, v) result) = (t,res) ∧ env_rel (N − (1 :num)) (env1 with v := l_bindings ++ env1.v) ext_env
evaluate_Bool=(evaluate (env :v environment) (s :(α, β) state) [Bool (t :tra) (b :bool)] :(α, β) state # (v list, v) result) = (s,(Rval [(Boolv b :v)] :(v list, v) result))
evaluate_SmartIf=(evaluate (env :v environment) (s :(α, β) state) [SmartIf (t :tra) (x :exp) (y :exp) (z :exp)] :(α, β) state # (v list, v) result) = (evaluate env s [(If t x y z :exp)] :(α, β) state # (v list, v) result)
naive_pattern_match_correct=∀(t :tra) (mats :(flatLang$pat # exp) list) (vs :v list) (bindings :(mlstring # v) list) (exp :exp) (res :(mlstring # v) list match_result). LIST_REL (pure_eval_to (s :(α, β) state) (env :v environment)) (MAP (SND :flatLang$pat # exp -> exp) mats) vs ∧ (pmatch_list s (MAP (FST :flatLang$pat # exp -> flatLang$pat) mats) vs bindings :(mlstring # v) list match_result) = res ∧ res ≠ (Match_type_error :(mlstring # v) list match_result) ∧ naive_pattern_match t mats = exp ⇒ pure_eval_to s env exp (Boolv (res ≠ (No_match :(mlstring # v) list match_result)) :v)
naive_pattern_matches_correct=∀(t :tra) (x :exp) (mats :(flatLang$pat # exp) list) (dflt :exp) (exp :exp) (v :v) (res :((mlstring # v) list # flatLang$pat # exp) match_result). naive_pattern_matches t x mats dflt = exp ∧ pure_eval_to (s :(α, β) state) (env :v environment) x v ∧ pmatch_rows mats s v = res ∧ res ≠ (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) ⇒ (evaluate env s [exp] :(α, β) state # (v list, v) result) = case res of (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) => (evaluate env s [dflt] :(α, β) state # (v list, v) result) | (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) => (evaluate env s [dflt] :(α, β) state # (v list, v) result) | Match (v4,v8,exp) => (evaluate env s [exp] :(α, β) state # (v list, v) result)
evaluate_compile_pats=pmatch_rows (pats :(flatLang$pat # exp) list) (s :(α, β) state) (v :v) ≠ (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) ∧ pure_eval_to s (env :v environment) (exp :exp) v ⇒ (evaluate env s [compile_pats (cfg :config) (naive :bool) (t :tra) (N :num) exp (default_x :exp) pats] :(α, β) state # (v list, v) result) = (evaluate env s [case pmatch_rows pats s v of (No_match :((mlstring # v) list # flatLang$pat # exp) match_result) => default_x | (Match_type_error :((mlstring # v) list # flatLang$pat # exp) match_result) => default_x | Match (env',p',e') => compile_pat_rhs t N exp (p',e')] :(α, β) state # (v list, v) result)
pattern_match=(∀(t :term) (refs :num |-> term). (pmatch refs Any t :pmatchResult) = PMatchSuccess) ∧ (∀(refs :num |-> term) (l' :lit) (l :lit). (pmatch refs (Lit l :pat) (Litv l' :term) :pmatchResult) = if ¬lit_same_type l l' then PTypeFailure else if l = l' then PMatchSuccess else PMatchFailure) ∧ (∀(targs :term list) (tag :num) (t :num) (siblings :(num # num) list option) (refs :num |-> term) (pargs :pat list). (pmatch refs (Cons (SOME (tag,siblings)) pargs :pat) (Term (SOME t) targs) :pmatchResult) = if tag = t ∧ LENGTH pargs = LENGTH targs then (pmatch_list refs pargs targs :pmatchResult) else if is_sibling (t,LENGTH targs) siblings then PMatchFailure else PTypeFailure) ∧ (∀(targs :term list) (refs :num |-> term) (pargs :pat list). (pmatch refs (Cons (NONE :(num # (num # num) list option) option) pargs :pat) (Term (NONE :num option) targs) :pmatchResult) = (pmatch_list refs pargs targs :pmatchResult)) ∧ (∀(refs :num |-> term) (r :num) (p :pat). (pmatch refs (Ref p) (RefPtr r) :pmatchResult) = case FLOOKUP refs r of (NONE :term option) => PTypeFailure | SOME v => (pmatch refs p v :pmatchResult)) ∧ (∀(t :term) (refs :num |-> term) (p2 :pat) (p1 :pat). (pmatch refs (Or p1 p2 :pat) t :pmatchResult) = case (pmatch refs p1 t :pmatchResult) of PMatchSuccess => (case (pmatch refs p2 t :pmatchResult) of PMatchSuccess => PMatchSuccess | PMatchFailure => PMatchSuccess | PTypeFailure => PTypeFailure) | PMatchFailure => (pmatch refs p2 t :pmatchResult) | PTypeFailure => PTypeFailure) ∧ (∀(v9 :pat list) (v30 :num # (num # num) list option) (v21 :term list) (refs :num |-> term). (pmatch refs (Cons (SOME v30) v9 :pat) (Term (NONE :num option) v21) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v28 :num) (v21 :term list) (refs :num |-> term). (pmatch refs (Cons (NONE :(num # (num # num) list option) option) v9 :pat) (Term (SOME v28) v21) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (v22 :lit) (refs :num |-> term). (pmatch refs (Cons v8 v9 :pat) (Litv v22 :term) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (v23 :num) (refs :num |-> term). (pmatch refs (Cons v8 v9 :pat) (RefPtr v23) :pmatchResult) = PTypeFailure) ∧ (∀(v9 :pat list) (v8 :(num # (num # num) list option) option) (refs :num |-> term). (pmatch refs (Cons v8 v9 :pat) Other :pmatchResult) = PTypeFailure) ∧ (∀(v39 :term list) (v38 :num option) (v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) (Term v38 v39) :pmatchResult) = PTypeFailure) ∧ (∀(v41 :num) (v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) (RefPtr v41) :pmatchResult) = PTypeFailure) ∧ (∀(v12 :lit) (refs :num |-> term). (pmatch refs (Lit v12 :pat) Other :pmatchResult) = PTypeFailure) ∧ (∀(v47 :term list) (v46 :num option) (v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) (Term v46 v47) :pmatchResult) = PTypeFailure) ∧ (∀(v48 :lit) (v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) (Litv v48 :term) :pmatchResult) = PTypeFailure) ∧ (∀(v13 :pat) (refs :num |-> term). (pmatch refs (Ref v13) Other :pmatchResult) = PTypeFailure) ∧ (∀(refs :num |-> term). (pmatch_list refs ([] :pat list) ([] :term list) :pmatchResult) = PMatchSuccess) ∧ (∀(v63 :term list) (v62 :term) (refs :num |-> term). (pmatch_list refs ([] :pat list) (v62::v63) :pmatchResult) = PTypeFailure) ∧ (∀(v59 :pat list) (v58 :pat) (refs :num |-> term). (pmatch_list refs (v58::v59) ([] :term list) :pmatchResult) = PTypeFailure) ∧ ∀(ts :term list) (t :term) (refs :num |-> term) (ps :pat list) (p :pat). (pmatch_list refs (p::ps) (t::ts) :pmatchResult) = case (pmatch refs p t :pmatchResult) of PMatchSuccess => (pmatch_list refs ps ts :pmatchResult) | PMatchFailure => (case (pmatch_list refs ps ts :pmatchResult) of PMatchSuccess => PMatchFailure | PMatchFailure => PMatchFailure | PTypeFailure => PTypeFailure) | PTypeFailure => PTypeFailure
pattern_match_rows=(∀(v :term) (refs :num |-> term). match refs ([] :(pat # num) list) v = SOME MatchFailure) ∧ ∀(v :term) (rows :(pat # num) list) (refs :num |-> term) (p :pat) (e :num). match refs ((p,e)::rows) v = case (pmatch refs p v :pmatchResult) of PMatchSuccess => (case match refs rows v of (NONE :matchResult option) => (NONE :matchResult option) | SOME v' => SOME (MatchSuccess e)) | PMatchFailure => match refs rows v | PTypeFailure => (NONE :matchResult option)
pattern_dt_test=dt_test (TagLenEq (t :num) (l :num) :dTest) (Term (SOME (c :num)) (args :term list)) = SOME (t = c ∧ l = LENGTH args) ∧ dt_test (LitEq (l1 :lit)) (Litv (l2 :lit) :term) = (if lit_same_type l1 l2 then SOME (l1 = l2) else (NONE :bool option)) ∧ dt_test (TagLenEq (v11 :num) (v12 :num) :dTest) (Term (NONE :num option) (v4 :term list)) = (NONE :bool option) ∧ dt_test (LitEq (v13 :lit)) (Term (v3 :num option) v4) = (NONE :bool option) ∧ dt_test (TagLenEq (v19 :num) (v20 :num) :dTest) (Litv (v5 :lit) :term) = (NONE :bool option) ∧ dt_test (v0 :dTest) (RefPtr (v6 :num)) = (NONE :bool option) ∧ dt_test v0 Other = (NONE :bool option)
pattern_app_pos=(∀(v :term) (refs :num |-> term). app_pos refs EmptyPos v = SOME v) ∧ (∀(refs :num |-> term) (r :num) (pos :position). app_pos refs (Pos (0 :num) pos) (RefPtr r) = case FLOOKUP refs r of (NONE :term option) => (NONE :term option) | SOME v => app_pos refs pos v) ∧ (∀(xs :term list) (x :term) (refs :num |-> term) (pos :position) (c :num option). app_pos refs (Pos (0 :num) pos) (Term c (x::xs)) = app_pos refs pos x) ∧ (∀(xs :term list) (x :term) (refs :num |-> term) (pos :position) (n :num) (c :num option). app_pos refs (Pos (SUC n) pos) (Term c (x::xs)) = app_pos refs (Pos n pos) (Term c xs)) ∧ (∀(v11 :num option) (v1 :position) (refs :num |-> term). app_pos refs (Pos (0 :num) v1) (Term v11 ([] :term list)) = (NONE :term option)) ∧ (∀(v13 :lit) (v1 :position) (refs :num |-> term). app_pos refs (Pos (0 :num) v1) (Litv v13 :term) = (NONE :term option)) ∧ (∀(v1 :position) (refs :num |-> term). app_pos refs (Pos (0 :num) v1) Other = (NONE :term option)) ∧ (∀(v9 :num) (v23 :num option) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) (Term v23 ([] :term list)) = (NONE :term option)) ∧ (∀(v9 :num) (v25 :lit) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) (Litv v25 :term) = (NONE :term option)) ∧ (∀(v9 :num) (v26 :num) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) (RefPtr v26) = (NONE :term option)) ∧ ∀(v9 :num) (v1 :position) (refs :num |-> term). app_pos refs (Pos (SUC v9) v1) Other = (NONE :term option)
pattern_eval_guard=(∀(refs :num |-> term) (v :term). dt_eval_guard refs v True = SOME T) ∧ (∀(refs :num |-> term) (v :term) (pos :position) (test :dTest). dt_eval_guard refs v (PosTest pos test) = case app_pos refs pos v of (NONE :term option) => (NONE :bool option) | SOME x => dt_test test x) ∧ (∀(refs :num |-> term) (v :term) (g :dGuard). dt_eval_guard refs v (Not g :dGuard) = case dt_eval_guard refs v g of (NONE :bool option) => (NONE :bool option) | SOME b => SOME (¬b)) ∧ (∀(refs :num |-> term) (v :term) (g1 :dGuard) (g2 :dGuard). dt_eval_guard refs v (Conj g1 g2) = case dt_eval_guard refs v g1 of (NONE :bool option) => (NONE :bool option) | SOME T => dt_eval_guard refs v g2 | SOME F => SOME F) ∧ ∀(refs :num |-> term) (v :term) (g1 :dGuard) (g2 :dGuard). dt_eval_guard refs v (Disj g1 g2) = case dt_eval_guard refs v g1 of (NONE :bool option) => (NONE :bool option) | SOME T => SOME T | SOME F => dt_eval_guard refs v g2
pattern_eval_tree=(∀(v0 :term) (refs :num |-> term) (k :num). dt_eval refs v0 (Leaf k) = SOME (MatchSuccess k)) ∧ (∀(v1 :term) (refs :num |-> term). dt_eval refs v1 Fail = SOME MatchFailure) ∧ (∀(v2 :term) (refs :num |-> term). dt_eval refs v2 TypeFail = (NONE :matchResult option)) ∧ ∀(v :term) (refs :num |-> term) (guard :dGuard) (dt2 :dTree) (dt1 :dTree). dt_eval refs v (If guard dt1 dt2 :dTree) = case dt_eval_guard refs v guard of (NONE :bool option) => (NONE :matchResult option) | SOME b => dt_eval refs v (if b then dt1 else dt2)
encode_val=(∀(l :lit). encode_val (Litv l :v) = (Litv l :term)) ∧ (∀(xs :v list) (stmp :(num # num option) option). encode_val (Conv stmp xs) = Term (case stmp of (NONE :(num # num option) option) => (NONE :num option) | SOME (i,v2) => SOME i) (MAP (λ(a :v). encode_val a) xs)) ∧ (∀(v0 :bool) (n :num). encode_val (Loc v0 n :v) = RefPtr n) ∧ (∀(v7 :exp) (v6 :mlstring) (v5 :v environment). encode_val (Closure v5 v6 v7 :v) = Other) ∧ (∀(v9 :(mlstring # mlstring # exp) list) (v8 :v environment) (v10 :mlstring). encode_val (Recclosure v8 v9 v10 :v) = Other) ∧ ∀(v13 :v list). encode_val (Vectorv v13) = Other
encode_refs=∀(s :(α, β) state). encode_refs s = FUN_FMAP (λ(i :num). encode_val (case s.refs❲i❳ of Refv v => v | (W8array v2 :v store_v) => (ARB :v) | Varray v4 => (ARB :v) | Thunk v6 v7 => (ARB :v))) (count (LENGTH s.refs) ∩ {i | ∃(v :v). s.refs❲i❳ = Refv v})
decode_pos_simulation=∀(pos :position) (exp :exp) (x :v). app_pos (encode_refs (s :(α, β) state)) pos (encode_val x) = SOME (enc_y :term) ∧ pure_eval_to s (env :v environment) exp x ⇒ ∃(y :v). enc_y = encode_val y ∧ pure_eval_to s env (decode_pos (tr :tra) exp pos) y
decode_test_simulation=dt_test (test :dTest) (enc_v :term) = SOME (b :bool) ∧ pure_eval_to (s :(α, β) state) (env :v environment) (x :exp) (v :v) ∧ enc_v = encode_val v ⇒ pure_eval_to s env (decode_test (tr :tra) test x) (Boolv b :v)
decode_guard_simulation=∀(b :bool). dt_eval_guard (encode_refs (s :(α, β) state)) (encode_val (y :v)) (gd :dGuard) = SOME b ∧ pure_eval_to s (env :v environment) (x :exp) y ⇒ pure_eval_to s env (decode_guard (tr :tra) x gd) (Boolv b :v)
simp_guard_thm=∀(gd :dGuard) (x :bool). dt_eval_guard (r :num |-> term) (v :term) gd = SOME x ⇒ dt_eval_guard r v (simp_guard gd) = SOME x
decode_dtree_simulation=dt_eval (encode_refs (s :(α, β) state)) (encode_val (y :v)) (dtree :dTree) = SOME (v :matchResult) ∧ pure_eval_to s (env :v environment) (x :exp) y ⇒ (evaluate env s [decode_dtree (tr :tra) (exps :exp sptree$num_map) x (default_x :exp) dtree] :(α, β) state # (v list, v) result) = (evaluate env s [case v of MatchSuccess i => (case lookup i exps of (NONE :exp option) => default_x | SOME exp => exp) | MatchFailure => default_x] :(α, β) state # (v list, v) result)
encode_pat_match_simulation=(∀(s :(γ, 'ffi) state) (pat :flatLang$pat) (v :v) (pre_bindings :(mlstring # v) list) (res :(mlstring # v) list match_result). (pmatch s pat v pre_bindings :(mlstring # v) list match_result) = res ∧ res ≠ (Match_type_error :(mlstring # v) list match_result) ⇒ (pmatch (encode_refs s) (encode_pat pat) (encode_val v) :pmatchResult) = if res = (No_match :(mlstring # v) list match_result) then PMatchFailure else PMatchSuccess) ∧ ∀(s :(γ, 'ffi) state) (ps :flatLang$pat list) (vs :v list) (pre_bindings :(mlstring # v) list) (res :(mlstring # v) list match_result). (pmatch_list s ps vs pre_bindings :(mlstring # v) list match_result) = res ∧ res ≠ (Match_type_error :(mlstring # v) list match_result) ⇒ (pmatch_list (encode_refs s) (MAP encode_pat ps) (MAP encode_val vs) :pmatchResult) = if res = (No_match :(mlstring # v) list match_result) then PMatchFailure else PMatchSuccess
pmatch_rows_encode=∀(pats :(flatLang$pat # α) list) (j_offs :num). pmatch_rows pats (s :(β, γ) state) (v :v) ≠ (Match_type_error :((mlstring # v) list # flatLang$pat # α) match_result) ⇒ case match (encode_refs s) (MAPi (λ(j :num) ((p :flatLang$pat),(_0 :α)). (encode_pat p,j + j_offs)) pats) (encode_val v) of (NONE :matchResult option) => F | SOME (MatchSuccess n) => ∃(i :num) (env :(mlstring # v) list). n = i + j_offs ∧ i < LENGTH pats ∧ (pmatch s (FST pats❲i❳) v ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match env ∧ pmatch_rows pats s v = Match (env,pats❲i❳) | SOME MatchFailure => pmatch_rows pats s v = (No_match :((mlstring # v) list # flatLang$pat # α) match_result)
pattern_is_any_match=∀(p :pat). is_Any p ⇒ (pmatch (refs :num |-> term) p (v :term) :pmatchResult) ≠ PMatchFailure
pattern_match_append=∀(xs :(pat # num) list) (ys :(pat # num) list) (refs :num |-> term) (v :term). match refs (xs ++ ys) v = case match refs xs v of (NONE :matchResult option) => (NONE :matchResult option) | SOME (MatchSuccess e) => if match refs ys v ≠ (NONE :matchResult option) then SOME (MatchSuccess e) else (NONE :matchResult option) | SOME MatchFailure => match refs ys v
pattern_match_take_until_any=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ match refs (take_until_Any rows) v = match refs rows v
pattern_match_insert_any=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ match refs (insert_Any rows) v ≠ (NONE :matchResult option) ∧ (match refs rows v ≠ SOME MatchFailure ⇒ match refs (insert_Any rows) v = match refs rows v)
pattern_comp_correct=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ⇒ dt_eval refs v (comp rows) = match refs rows v
pattern_filter_safe=∀(xs :(pat # num) list). match (refs :num |-> term) xs (v :term) ≠ (NONE :matchResult option) ⇒ match refs (FILTER (P :pat # num -> bool) xs) v ≠ (NONE :matchResult option)
pattern_const_row=(∀(t :num option). (v :term) ≠ Term t ([] :term list)) ∧ is_const_row ((p_1 :pat),(p_2 :α)) ∧ (pmatch (refs :num |-> term) p_1 v :pmatchResult) ≠ PTypeFailure ⇒ (pmatch refs p_1 v :pmatchResult) = PMatchFailure
pattern_move_const_up=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ⇒ match refs (move_const_up rows) v = match refs rows v
pattern_non_const_row=¬is_const_row ((p :pat),(x :α)) ∧ ¬is_Or_row (p,x) ∧ ¬is_Any p ⇒ (pmatch (refs :num |-> term) p (Term (t :num option) ([] :term list)) :pmatchResult) ≠ PMatchSuccess
pattern_take_until_any_prefix=∀(rows :(pat # num) list). EVERY (λ((x :pat),(y :num)). ¬is_Any x) (TL (REVERSE (take_until_Any rows)))
pattern_walk=(∀(x :term) (refs :num |-> term). walk ([] :num list) x refs = SOME x) ∧ ∀(n :num) (ns :num list) (x :term) (refs :num |-> term). walk (n::ns) x refs = case x of Term t xs => if n < LENGTH xs then walk ns xs❲n❳ refs else (NONE :term option) | (Litv v6 :term) => (NONE :term option) | RefPtr p => if n ≠ (0 :num) then (NONE :term option) else (case FLOOKUP refs p of (NONE :term option) => (NONE :term option) | SOME y => walk ns y refs) | Other => (NONE :term option)
pattern_walk_append=∀(xs :num list) (ys :num list) (v :term) (refs :num |-> term). walk (xs ++ ys) v refs = case walk xs v refs of (NONE :term option) => (NONE :term option) | SOME v => walk ys v refs
pattern_walk_position=∀(l :num list) (v :term) (refs :num |-> term) (x :term). walk l v refs = SOME x ⇒ app_pos refs (get_pos l) v = SOME x
pattern_match_list_length=∀(ps :pat list) (vs :term list). (pmatch_list (refs :num |-> term) ps vs :pmatchResult) ≠ PTypeFailure ⇒ LENGTH vs = LENGTH ps
pattern_guard_correct=(∀(l :num list) (p :pat) (x :term). (pmatch (refs :num |-> term) p x :pmatchResult) ≠ PTypeFailure ∧ walk (REVERSE l) (v :term) refs = SOME x ⇒ dt_eval_guard refs v (pat_to_guard l p) = SOME ((pmatch refs p x :pmatchResult) = PMatchSuccess)) ∧ ∀(l :num list) (k :num) (ps :pat list) (xs :term list) (ys :term list). (pmatch_list refs ps xs :pmatchResult) ≠ PTypeFailure ∧ LENGTH ys = k ∧ walk_list (REVERSE l) v refs = SOME (ys ++ xs) ∧ LENGTH xs = LENGTH ps ⇒ dt_eval_guard refs v (pats_to_guard l k ps) = SOME ((pmatch_list refs ps xs :pmatchResult) = PMatchSuccess)
pattern_code_correct=∀(rows :(pat # num) list). match (refs :num |-> term) rows (v :term) ≠ (NONE :matchResult option) ⇒ dt_eval refs v (pats_to_code rows) = match refs rows v
pattern_walk_list=∀(ns :num list) (x :term) (refs :num |-> term). walk_list ns x refs = case walk ns x refs of (NONE :term option) => (NONE :term list option) | SOME (Term v6 vs) => SOME vs | SOME (Litv v8 :term) => (NONE :term list option) | SOME (RefPtr v9) => (NONE :term list option) | SOME Other => (NONE :term list option)
pattern_exh_dest_val=dest_val (refs :num |-> term) (Term (SOME (t :num)) (vs :term list)) = SOME (TagC t (LENGTH vs),vs) ∧ dest_val refs (Term (NONE :num option) vs) = SOME (TupC (LENGTH vs),vs) ∧ dest_val refs (RefPtr (r :num)) = (case FLOOKUP refs r of (NONE :term option) => (NONE :(ctor # term list) option) | SOME w => SOME (RefC,[w])) ∧ dest_val refs (Litv (l :lit) :term) = (NONE :(ctor # term list) option) ∧ dest_val refs Other = (NONE :(ctor # term list) option)
pattern_exh_rows_sound=match (refs :num |-> term) (rows :(pat # num) list) (v :term) ≠ (NONE :matchResult option) ∧ exh_rows rows ⇒ match refs rows v ≠ SOME MatchFailure
flat_selected_pattern_match=pmatch_rows (pes :(flatLang$pat # α) list) (s :(β, γ) state) (v :v) = Match ((env' :(mlstring # v) list),(p' :flatLang$pat),(e' :α)) ⇒ (pmatch s p' v ([] :(mlstring # v) list) :(mlstring # v) list match_result) = Match env' ∧ MEM (p',e') pes
flat_compile_exps_evaluate=(∀(env1 :v environment) (s1 :(γ, 'ffi) state) (xs :exp list) (t1 :(γ, 'ffi) state) (r1 :(v list, v) result) (i :num) (sg :bool) (ys :exp list) (N :num) (env2 :v environment) (s2 :(γ, 'ffi) state) (cfg :config). (evaluate env1 s1 xs :(γ, 'ffi) state # (v list, v) result) = (t1,r1) ∧ compile_exps cfg xs = (i,sg,ys) ∧ env_rel N env1 env2 ∧ state_rel (s_cfg :config) s1 s2 ∧ i < N ∧ r1 ≠ (Rerr (Rabort Rtype_error :v error_result) :(v list, v) result) ⇒ ∃(t2 :(γ, 'ffi) state) (r2 :(v list, v) result). result_rel (LIST_REL v_rel) v_rel r1 r2 ∧ state_rel s_cfg t1 t2 ∧ (evaluate env2 s2 ys :(γ, 'ffi) state # (v list, v) result) = (t2,r2)) ∧ ∀(s1 :(γ, 'ffi) state) (decs :exp list) (s2 :(γ, 'ffi) state) (t1 :(γ, 'ffi) state) (cfg :config) (decs' :exp list) (res :v error_result option). (evaluate_decs s1 decs :(γ, 'ffi) state # v error_result option) = (t1,res) ∧ decs' = MAP (compile_dec cfg) decs ∧ state_rel s_cfg s1 s2 ∧ res ≠ SOME (Rabort Rtype_error :v error_result) ⇒ ∃(t2 :(γ, 'ffi) state) (res' :v error_result option). (evaluate_decs s2 decs' :(γ, 'ffi) state # v error_result option) = (t2,res') ∧ OPTREL (exc_rel v_rel) res res' ∧ state_rel s_cfg t1 t2
flat_evaluate_length=∀(env :v environment) (s :(γ, 'ffi) state) (ls :exp list) (s' :(γ, 'ffi) state) (vs :v list). (evaluate env s ls :(γ, 'ffi) state # (v list, v) result) = (s',(Rval vs :(v list, v) result)) ⇒ LENGTH vs = LENGTH ls
flat_value_to_bytes_relation=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(x :v) (y :v) (ws :word8 list). vr x y ∧ v_to_bytes x = SOME ws ⇒ v_to_bytes y = SOME ws
flat_value_to_words_relation=simple_val_rel (vr :v -> v -> bool) ⇒ ∀(x :v) (y :v) (ws :word64 list). vr x y ∧ v_to_words x = SOME ws ⇒ v_to_words y = SOME ws
flat_do_eval_simulation=(do_eval (xs :v list) (s :(α, β) state).eval_config :(exp list # α install_config # v) option) = SOME ((decs :exp list),(eval_config :α install_config),(rv :v)) ∧ state_rel (cfg :config) s (t :(α, β) state) ∧ LIST_REL v_rel xs (ys :v list) ⇒ ∃(rv' :v) (decs' :exp list) (eval_config' :α install_config). (do_eval ys t.eval_config :(exp list # α install_config # v) option) = SOME (decs',eval_config',rv') ∧ state_rel cfg (s with eval_config := eval_config) (t with eval_config := eval_config') ∧ v_rel rv rv' ∧ decs' = MAP (compile_dec cfg) decs
