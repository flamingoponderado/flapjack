cc_skip=∀s1 r s2 t1 k off jump. evaluate (Skip,s1) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s1 t1 ∧ reg_bound Skip k ⇒ ∃ck t2. evaluate (comp jump off k Skip,t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
cc_skip_types=s1:(α, β, γ) stackSem$state;r:α stackSem$result option;s2:(α, β, γ) stackSem$state;t1:(α, β, γ) stackSem$state;k:num;off:α word # α word;jump:bool
cc_skip_proved=T
cc_halt=∀s1 r s2 t1 k off jump n. evaluate (Halt n,s1) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s1 t1 ∧ reg_bound (Halt n) k ⇒ ∃ck t2. evaluate (comp jump off k (Halt n),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
cc_halt_types=s1:(α, β, γ) stackSem$state;r:α stackSem$result option;s2:(α, β, γ) stackSem$state;t1:(α, β, γ) stackSem$state;k:num;off:α word # α word;jump:bool;n:num
cc_halt_proved=T
cc_alloc=∀s1 r s2 t1 k off jump n. evaluate (Alloc n,s1) = (r,s2) ∧ r ≠ SOME Error ∧ state_rel jump off k s1 t1 ∧ reg_bound (Alloc n) k ⇒ ∃ck t2. evaluate (comp jump off k (Alloc n),t1 with clock := ck + t1.clock) = (r,t2) ∧ case r of NONE => state_rel jump off k s2 t2 | SOME (Result v8) => state_rel jump off k s2 t2 | SOME (Exception v9) => state_rel jump off k s2 t2 | SOME (Break v10) => state_rel jump off k s2 t2 | SOME (Continue v11) => state_rel jump off k s2 t2 | SOME (Halt v12) => t2.ffi = s2.ffi | SOME TimeOut => t2.ffi = s2.ffi | SOME (FinalFFI v13) => t2.ffi = s2.ffi | SOME Error => state_rel jump off k s2 t2
cc_alloc_types=s1:(α, β, γ) stackSem$state;r:α stackSem$result option;s2:(α, β, γ) stackSem$state;t1:(α, β, γ) stackSem$state;k:num;off:α word # α word;jump:bool;n:num
cc_alloc_proved=T
