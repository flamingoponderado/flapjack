domain_def_typed=domain (LN :α num_map) = (∅ :num -> bool) ∧ (∀(v0 :α). domain ⦕ 0 ↦ v0 ⦖ = {(0 :num)}) ∧ (∀(t1 :α num_map) (t2 :α num_map). domain (BN t1 t2) = IMAGE (λ(n :num). (2 :num) * n + (2 :num)) (domain t1) ∪ IMAGE (λ(n :num). (2 :num) * n + (1 :num)) (domain t2)) ∧ ∀(t1 :α num_map) (v1 :α) (t2 :α num_map). domain (BS t1 v1 t2) = {(0 :num)} ∪ IMAGE (λ(n :num). (2 :num) * n + (2 :num)) (domain t1) ∪ IMAGE (λ(n :num). (2 :num) * n + (1 :num)) (domain t2)
domain_fromList_typed=∀*(l :α list) . domain (fromList (l :α list)) = count (LENGTH l)
MEM_toListA_typed=∀(t :α num_map) (acc :α list) (x :α). MEM x (toListA acc t) ⇔ MEM x acc ∨ ∃(k :num). lookup k t = SOME x
MEM_toList_typed=∀(x :α) (t :α num_map). MEM x (toList t) ⇔ ∃(k :num). lookup k t = SOME x
domain_lookup_typed=∀(t :α num_map) (k :num). k ∈ domain t ⇔ ∃(v :α). lookup k t = SOME v
spt_typed=LN::α num_map; LS::α -> α num_map; BN::α num_map -> α num_map -> α num_map; BS::α num_map -> α -> α num_map -> α num_map
lookup_def_typed=(∀(k :num). lookup k (LN :α num_map) = (NONE :α option)) ∧ (∀(k :num) (a :α). lookup k ⦕ 0 ↦ a ⦖ = if k = (0 :num) then SOME a else (NONE :α option)) ∧ (∀(t2 :α num_map) (t1 :α num_map) (k :num). lookup k (BN t1 t2) = if k = (0 :num) then (NONE :α option) else lookup ((k − (1 :num)) DIV (2 :num)) (if EVEN k then t1 else t2)) ∧ ∀(t2 :α num_map) (t1 :α num_map) (k :num) (a :α). lookup k (BS t1 a t2) = if k = (0 :num) then SOME a else lookup ((k − (1 :num)) DIV (2 :num)) (if EVEN k then t1 else t2)
insert_def_typed=(∀(k :num) (a :α). insert k a (LN :α num_map) = if k = (0 :num) then ⦕ 0 ↦ a ⦖ else if EVEN k then BN (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α num_map)) (LN :α num_map) else BN (LN :α num_map) (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α num_map))) ∧ (∀(k :num) (a' :α) (a :α). insert k a ⦕ 0 ↦ a' ⦖ = if k = (0 :num) then ⦕ 0 ↦ a ⦖ else if EVEN k then BS (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α num_map)) a' (LN :α num_map) else BS (LN :α num_map) a' (insert ((k − (1 :num)) DIV (2 :num)) a (LN :α num_map))) ∧ (∀(t2 :α num_map) (t1 :α num_map) (k :num) (a :α). insert k a (BN t1 t2) = if k = (0 :num) then BS t1 a t2 else if EVEN k then BN (insert ((k − (1 :num)) DIV (2 :num)) a t1) t2 else BN t1 (insert ((k − (1 :num)) DIV (2 :num)) a t2)) ∧ ∀(t2 :α num_map) (t1 :α num_map) (k :num) (a' :α) (a :α). insert k a (BS t1 a' t2) = if k = (0 :num) then BS t1 a t2 else if EVEN k then BS (insert ((k − (1 :num)) DIV (2 :num)) a t1) a' t2 else BS t1 a' (insert ((k − (1 :num)) DIV (2 :num)) a t2)
mk_BN_def_typed=∀*(v7 :α num_map) (v6 :α) (v5 :α num_map) (v4 :α num_map) (v3 :α num_map) (t2 :α num_map) (v2 :α) (v19 :α num_map) (v18 :α) (v17 :α num_map) (v16 :α num_map) (v15 :α num_map) (v14 :α) . isEmpty (mk_BN (LN :α num_map) (LN :α num_map)) ∧ mk_BN (LN :α num_map) ⦕ 0 ↦ (v14 :α) ⦖ = ⦕ 1 ↦ v14 ⦖ ∧ mk_BN (LN :α num_map) (BN (v15 :α num_map) (v16 :α num_map)) = BN (LN :α num_map) (BN v15 v16) ∧ mk_BN (LN :α num_map) (BS (v17 :α num_map) (v18 :α) (v19 :α num_map)) = BN (LN :α num_map) (BS v17 v18 v19) ∧ mk_BN ⦕ 0 ↦ (v2 :α) ⦖ (t2 :α num_map) = BN ⦕ 0 ↦ v2 ⦖ t2 ∧ mk_BN (BN (v3 :α num_map) (v4 :α num_map)) t2 = BN (BN v3 v4) t2 ∧ mk_BN (BS (v5 :α num_map) (v6 :α) (v7 :α num_map)) t2 = BN (BS v5 v6 v7) t2
mk_BS_def_typed=∀*(v9 :α num_map) (v8 :α) (v7 :α num_map) (v6 :α num_map) (v5 :α num_map) (v4 :α) (t1 :α num_map) (v21 :α num_map) (v20 :α) (v19 :α num_map) (v18 :α num_map) (v17 :α num_map) (v16 :α) (x :α) . mk_BS (LN :α num_map) (x :α) (LN :α num_map) = ⦕ 0 ↦ x ⦖ ∧ mk_BS ⦕ 0 ↦ (v16 :α) ⦖ x (LN :α num_map) = ⦕ 0 ↦ x; 2 ↦ v16 ⦖ ∧ mk_BS (BN (v17 :α num_map) (v18 :α num_map)) x (LN :α num_map) = BS (BN v17 v18) x (LN :α num_map) ∧ mk_BS (BS (v19 :α num_map) (v20 :α) (v21 :α num_map)) x (LN :α num_map) = BS (BS v19 v20 v21) x (LN :α num_map) ∧ mk_BS (t1 :α num_map) x ⦕ 0 ↦ (v4 :α) ⦖ = BS t1 x ⦕ 0 ↦ v4 ⦖ ∧ mk_BS t1 x (BN (v5 :α num_map) (v6 :α num_map)) = BS t1 x (BN v5 v6) ∧ mk_BS t1 x (BS (v7 :α num_map) (v8 :α) (v9 :α num_map)) = BS t1 x (BS v7 v8 v9)
union_def_typed=(∀(t :α num_map). union (LN :α num_map) t = t) ∧ (∀(a :α) (t :α num_map). union ⦕ 0 ↦ a ⦖ t = case t of (LN :α num_map) => ⦕ 0 ↦ a ⦖ | ⦕ 0 ↦ b ⦖ => ⦕ 0 ↦ a ⦖ | BN t1 t2 => BS t1 a t2 | BS t1' v4 t2' => BS t1' a t2') ∧ (∀(t1 :α num_map) (t2 :α num_map) (t :α num_map). union (BN t1 t2) t = case t of (LN :α num_map) => BN t1 t2 | ⦕ 0 ↦ a ⦖ => BS t1 a t2 | BN t1' t2' => BN (union t1 t1') (union t2 t2') | BS t1'' a'' t2'' => BS (union t1 t1'') a'' (union t2 t2'')) ∧ ∀(t1 :α num_map) (a :α) (t2 :α num_map) (t :α num_map). union (BS t1 a t2) t = case t of (LN :α num_map) => BS t1 a t2 | ⦕ 0 ↦ a' ⦖ => BS t1 a t2 | BN t1' t2' => BS (union t1 t1') a (union t2 t2') | BS t1'' a'³' t2'' => BS (union t1 t1'') a (union t2 t2'')
fromAList_def_typed=isEmpty (fromAList ([] :(num # α) list)) ∧ ∀(y :α) (xs :(num # α) list) (x :num). fromAList ((x,y)::xs) = insert x y (fromAList xs)
size_def_typed=size (LN :α num_map) = (0 :num) ∧ (∀(a :α). size ⦕ 0 ↦ a ⦖ = (1 :num)) ∧ (∀(t1 :α num_map) (t2 :α num_map). size (BN t1 t2) = size t1 + size t2) ∧ ∀(t1 :α num_map) (a :α) (t2 :α num_map). size (BS t1 a t2) = size t1 + size t2 + (1 :num)
delete_def_typed=(∀(k :num). isEmpty (delete k (LN :α num_map))) ∧ (∀(k :num) (a :α). delete k ⦕ 0 ↦ a ⦖ = if k = (0 :num) then (LN :α num_map) else ⦕ 0 ↦ a ⦖) ∧ (∀(k :num) (t1 :α num_map) (t2 :α num_map). delete k (BN t1 t2) = if k = (0 :num) then BN t1 t2 else if EVEN k then mk_BN (delete ((k − (1 :num)) DIV (2 :num)) t1) t2 else mk_BN t1 (delete ((k − (1 :num)) DIV (2 :num)) t2)) ∧ ∀(k :num) (t1 :α num_map) (a :α) (t2 :α num_map). delete k (BS t1 a t2) = if k = (0 :num) then BN t1 t2 else if EVEN k then mk_BS (delete ((k − (1 :num)) DIV (2 :num)) t1) a t2 else mk_BS t1 a (delete ((k − (1 :num)) DIV (2 :num)) t2)
fromList_def_typed=∀(l :α list). fromList l = SND (FOLDL (λ((i :num),(t :α num_map)) (a :α). (i + (1 :num),insert i a t)) ((0 :num),(LN :α num_map)) l)
lookup_mk_wf_typed=∀(x :num) (t :α num_map). lookup x (mk_wf t) = lookup x t
domain_inter_typed=∀*(t2 :β num_map) (t1 :α num_map) . domain (inter (t1 :α num_map) (t2 :β num_map)) = domain t1 ∩ domain t2
domain_union_typed=∀*(t2 :α num_map) (t1 :α num_map) . domain (union (t1 :α num_map) (t2 :α num_map)) = domain t1 ∪ domain t2
lookup_inter_typed=∀(m1 :α num_map) (m2 :β num_map) (k :num). lookup k (inter m1 m2) = case (lookup k m1,lookup k m2) of ((NONE :α option),v4) => (NONE :α option) | (SOME v,(NONE :β option)) => (NONE :α option) | (SOME v,SOME w) => SOME v
lookup_union_typed=∀(m1 :α num_map) (m2 :α num_map) (k :num). lookup k (union m1 m2) = case lookup k m1 of (NONE :α option) => lookup k m2 | SOME v => SOME v
wf_def_typed=(wf (LN :α num_map) ⇔ T) ∧ (∀(a :α). wf ⦕ 0 ↦ a ⦖ ⇔ T) ∧ (∀(t1 :α num_map) (t2 :α num_map). wf (BN t1 t2) ⇔ wf t1 ∧ wf t2 ∧ ¬(isEmpty t1 ∧ isEmpty t2)) ∧ ∀(t1 :α num_map) (a :α) (t2 :α num_map). wf (BS t1 a t2) ⇔ wf t1 ∧ wf t2 ∧ ¬(isEmpty t1 ∧ isEmpty t2)
filter_v_def_typed=(∀(f :α -> bool). isEmpty (filter_v f (LN :α num_map))) ∧ (∀(f :α -> bool) (x :α). filter_v f ⦕ 0 ↦ x ⦖ = if f x then ⦕ 0 ↦ x ⦖ else (LN :α num_map)) ∧ (∀(f :α -> bool) (l :α num_map) (r :α num_map). filter_v f (BN l r) = mk_BN (filter_v f l) (filter_v f r)) ∧ ∀(f :α -> bool) (l :α num_map) (x :α) (r :α num_map). filter_v f (BS l x r) = if f x then mk_BS (filter_v f l) x (filter_v f r) else mk_BN (filter_v f l) (filter_v f r)
lookup_filter_v_typed=∀(k :num) (t :α num_map) (f :α -> bool). lookup k (filter_v f t) = case lookup k t of (NONE :α option) => (NONE :α option) | SOME v => if f v then SOME v else (NONE :α option)
lrnext_def_typed=∀(n :num). sptree$lrnext n = if n = (0 :num) then (1 :num) else (2 :num) * sptree$lrnext ((n − (1 :num)) DIV (2 :num))
toAList_def_typed=(toAList :α num_map -> (num # α) list) = foldi (λ(k :num) (v :α) (a :(num # α) list). (k,v)::a) (0 :num) ([] :(num # α) list)
foldi_def_typed=(∀(f :num -> β -> α -> α) (i :num) (acc :α). foldi f i acc (LN :β num_map) = acc) ∧ (∀(f :num -> β -> α -> α) (i :num) (acc :α) (a :β). foldi f i acc ⦕ 0 ↦ a ⦖ = f i a acc) ∧ (∀(f :num -> β -> α -> α) (i :num) (acc :α) (t1 :β num_map) (t2 :β num_map). foldi f i acc (BN t1 t2) = (let (inc :num) = sptree$lrnext i in foldi f (i + inc) (foldi f (i + (2 :num) * inc) acc t1) t2)) ∧ ∀(f :num -> β -> α -> α) (i :num) (acc :α) (t1 :β num_map) (a :β) (t2 :β num_map). foldi f i acc (BS t1 a t2) = (let (inc :num) = sptree$lrnext i in foldi f (i + inc) (f i a (foldi f (i + (2 :num) * inc) acc t1)) t2)
foldi_FOLDR_toAList_typed=∀(f :num -> α -> β -> β) (a :β) (t :α num_map). foldi f (0 :num) a t = FOLDR (UNCURRY f) a (toAList t)
insert_unchanged_typed=∀*(y :α) . ∀(t :α num_map) (x :num). lookup x t = SOME (y :α) ⇒ insert x y t = t
inter_eq_def_typed=(∀(t :α num_map). isEmpty (inter_eq (LN :α num_map) t)) ∧ (∀(a :α) (t :α num_map). inter_eq ⦕ 0 ↦ a ⦖ t = case t of (LN :α num_map) => (LN :α num_map) | ⦕ 0 ↦ b ⦖ => if a = b then ⦕ 0 ↦ a ⦖ else (LN :α num_map) | BN t1 t2 => (LN :α num_map) | BS t1' b' t2' => if a = b' then ⦕ 0 ↦ a ⦖ else (LN :α num_map)) ∧ (∀(t1 :α num_map) (t2 :α num_map) (t :α num_map). inter_eq (BN t1 t2) t = case t of (LN :α num_map) => (LN :α num_map) | ⦕ 0 ↦ a ⦖ => (LN :α num_map) | BN t1' t2' => mk_BN (inter_eq t1 t1') (inter_eq t2 t2') | BS t1'' a'' t2'' => mk_BN (inter_eq t1 t1'') (inter_eq t2 t2'')) ∧ ∀(t1 :α num_map) (a :α) (t2 :α num_map) (t :α num_map). inter_eq (BS t1 a t2) t = case t of (LN :α num_map) => (LN :α num_map) | ⦕ 0 ↦ a' ⦖ => if a' = a then ⦕ 0 ↦ a ⦖ else (LN :α num_map) | BN t1' t2' => mk_BN (inter_eq t1 t1') (inter_eq t2 t2') | BS t1'' a'³' t2'' => if a'³' = a then mk_BS (inter_eq t1 t1'') a (inter_eq t2 t2'') else mk_BN (inter_eq t1 t1'') (inter_eq t2 t2'')
lookup_inter_eq_typed=∀(m1 :α num_map) (m2 :α num_map) (k :num). lookup k (inter_eq m1 m2) = case lookup k m1 of (NONE :α option) => (NONE :α option) | SOME v => if lookup k m2 = SOME v then SOME v else (NONE :α option)
domain_map_typed=∀*(f :α -> β) . ∀(s :α num_map). domain (map (f :α -> β) s) = domain s
lookup_map_typed=∀*(f :α -> β) . ∀(s :α num_map) (x :num). lookup x (map (f :α -> β) s) = OPTION_MAP f (lookup x s)
map_def_typed=(∀(f :β -> α). isEmpty (map f (LN :β num_map))) ∧ (∀(f :β -> α) (a :β). map f ⦕ 0 ↦ a ⦖ = ⦕ 0 ↦ f a ⦖) ∧ (∀(f :β -> α) (t1 :β num_map) (t2 :β num_map). map f (BN t1 t2) = BN (map f t1) (map f t2)) ∧ ∀(f :β -> α) (t1 :β num_map) (a :β) (t2 :β num_map). map f (BS t1 a t2) = BS (map f t1) (f a) (map f t2)
map_fromAList_typed=∀*(ls :(num # β) list) (f :β -> α) . map (f :β -> α) (fromAList (ls :(num # β) list)) = fromAList (MAP (λ((k :num),(v :β)). (k,f v)) ls)
map_insert_typed=∀(f :α -> β) (x :num) (y :α) (z :α num_map). map f (insert x y z) = insert x (f y) (map f z)
map_union_typed=∀*(f :α -> β) . ∀(t1 :α num_map) (t2 :α num_map). map (f :α -> β) (union t1 t2) = union (map f t1) (map f t2)
wf_map_typed=∀(t :α num_map) (f :α -> β). wf (map f t) ⇔ wf t
mapi_def_typed=∀(f :num -> β -> α) (pt :β num_map). mapi f pt = mapi0 f (0 :num) pt
mapi0_def_typed=(∀(f :num -> β -> α) (i :num). isEmpty (mapi0 f i (LN :β num_map))) ∧ (∀(f :num -> β -> α) (i :num) (a :β). mapi0 f i ⦕ 0 ↦ a ⦖ = ⦕ 0 ↦ f i a ⦖) ∧ (∀(f :num -> β -> α) (i :num) (t1 :β num_map) (t2 :β num_map). mapi0 f i (BN t1 t2) = (let (inc :num) = sptree$lrnext i in mk_BN (mapi0 f (i + (2 :num) * inc) t1) (mapi0 f (i + inc) t2))) ∧ ∀(f :num -> β -> α) (i :num) (t1 :β num_map) (a :β) (t2 :β num_map). mapi0 f i (BS t1 a t2) = (let (inc :num) = sptree$lrnext i in mk_BS (mapi0 f (i + (2 :num) * inc) t1) (f i a) (mapi0 f (i + inc) t2))
lookup_mapi_typed=∀*(pt :β num_map) (f :num -> β -> α) (k :num) . lookup (k :num) (mapi (f :num -> β -> α) (pt :β num_map)) = OPTION_MAP (f k) (lookup k pt)
lookup_mapi0_typed=∀*(f :num -> α -> β) . ∀(pt :α num_map) (i :num) (k :num). lookup k (mapi0 (f :num -> α -> β) i pt) = case lookup k pt of (NONE :α option) => (NONE :β option) | SOME v => SOME (f (spt_acc i k) v)
wf_mapi_typed=∀*(pt :β num_map) (f :num -> β -> α) . wf (mapi (f :num -> β -> α) (pt :β num_map))
wf_mk_BN_typed=∀*(t2 :α num_map) (t1 :α num_map) . wf (t1 :α num_map) ∧ wf (t2 :α num_map) ⇒ wf (mk_BN t1 t2)
wf_mk_BS_typed=∀*(a :α) (t2 :α num_map) (t1 :α num_map) . wf (t1 :α num_map) ∧ wf (t2 :α num_map) ⇒ wf (mk_BS t1 (a :α) t2)
subspt_def_typed=∀(sp1 :α num_map) (sp2 :α num_map). subspt sp1 sp2 ⇔ ∀(k :num). k ∈ domain sp1 ⇒ k ∈ domain sp2 ∧ lookup k sp2 = lookup k sp1
subspt_FOLDL_union_typed=∀(ls :α num_map list) (t :α num_map). subspt t (FOLDL (union :α num_map -> α num_map -> α num_map) t ls)
subspt_lookup_typed=∀(t1 :α num_map) (t2 :α num_map). subspt t1 t2 ⇔ ∀(x :num) (y :α). lookup x t1 = SOME y ⇒ lookup x t2 = SOME y
subspt_trans_typed=∀*(sp3 :α num_map) (sp2 :α num_map) (sp1 :α num_map) . subspt (sp1 :α num_map) (sp2 :α num_map) ∧ subspt sp2 (sp3 :α num_map) ⇒ subspt sp1 sp3
subspt_union_typed=∀*(t :α num_map) (s :α num_map) . subspt (s :α num_map) (union s (t :α num_map))
ALL_DISTINCT_MAP_FST_toAList_typed=∀(t :α num_map). ALL_DISTINCT (MAP (FST :num # α -> num) (toAList t))
domain_difference_typed=∀(t1 :α num_map) (t2 :β num_map). domain (difference t1 t2) = domain t1 DIFF domain t2
domain_fromAList_typed=∀(ls :(num # α) list). domain (fromAList ls) = set (MAP (FST :num # α -> num) ls)
domain_insert_typed=∀*(t :α num_map) (v :α) (k :num) . domain (insert (k :num) (v :α) (t :α num_map)) = k INSERT domain t
MEM_toAList_typed=∀(t :α num_map) (k :num) (v :α). MEM (k,v) (toAList t) ⇔ lookup k t = SOME v
insert_union_typed=∀(k :num) (v :α) (s :α num_map). insert k v s = union (insert k v (LN :α num_map)) s
union_assoc_typed=∀(t1 :α num_map) (t2 :α num_map) (t3 :α num_map). union t1 (union t2 t3) = union (union t1 t2) t3
union_insert_LN_typed=∀(x :num) (y :α) (t2 :α num_map). union (insert x y (LN :α num_map)) t2 = insert x y t2
union_num_set_sym_typed=∀(t1 :num_set) (t2 :num_set). union t1 t2 = union t2 t1
spt_eq_thm_typed=∀(t1 :α num_map) (t2 :α num_map). wf t1 ∧ wf t2 ⇒ (t1 = t2 ⇔ ∀(n :num). lookup n t1 = lookup n t2)
insert_notEmpty_typed=∀*(t :α num_map) (a :α) (k :num) . insert (k :num) (a :α) (t :α num_map) ≠ (LN :α num_map)
lookup_difference_typed=∀(m1 :α num_map) (m2 :β num_map) (k :num). lookup k (difference m1 m2) = if lookup k m2 = (NONE :β option) then lookup k m1 else (NONE :α option)
wf_delete_typed=∀(t :α num_map) (k :num). wf t ⇒ wf (delete k t)
wf_difference_typed=∀(t1 :α num_map) (t2 :β num_map). wf t1 ∧ wf t2 ⇒ wf (difference t1 t2)
wf_fromAList_typed=∀(ls :(num # α) list). wf (fromAList ls)
wf_insert_typed=∀(k :num) (a :α) (t :α num_map). wf t ⇒ wf (insert k a t)
wf_inter_typed=∀(m1 :α num_map) (m2 :β num_map). wf (inter m1 m2)
wf_union_typed=∀(m1 :α num_map) (m2 :α num_map). wf m1 ∧ wf m2 ⇒ wf (union m1 m2)
inter_def_typed=(∀(t :β num_map). isEmpty (inter (LN :α num_map) t)) ∧ (∀(a :α) (t :β num_map). inter ⦕ 0 ↦ a ⦖ t = case t of (LN :β num_map) => (LN :α num_map) | ⦕ 0 ↦ b ⦖ => ⦕ 0 ↦ a ⦖ | BN t1 t2 => (LN :α num_map) | BS t1' v4 t2' => ⦕ 0 ↦ a ⦖) ∧ (∀(t1 :α num_map) (t2 :α num_map) (t :β num_map). inter (BN t1 t2) t = case t of (LN :β num_map) => (LN :α num_map) | ⦕ 0 ↦ a ⦖ => (LN :α num_map) | BN t1' t2' => mk_BN (inter t1 t1') (inter t2 t2') | BS t1'' a'' t2'' => mk_BN (inter t1 t1'') (inter t2 t2'')) ∧ ∀(t1 :α num_map) (a :α) (t2 :α num_map) (t :β num_map). inter (BS t1 a t2) t = case t of (LN :β num_map) => (LN :α num_map) | ⦕ 0 ↦ a' ⦖ => ⦕ 0 ↦ a ⦖ | BN t1' t2' => mk_BN (inter t1 t1') (inter t2 t2') | BS t1'' a'³' t2'' => mk_BS (inter t1 t1'') a (inter t2 t2'')
mk_wf_def_typed=isEmpty (mk_wf (LN :α num_map)) ∧ (∀(x :α). mk_wf ⦕ 0 ↦ x ⦖ = ⦕ 0 ↦ x ⦖) ∧ (∀(t1 :α num_map) (t2 :α num_map). mk_wf (BN t1 t2) = mk_BN (mk_wf t1) (mk_wf t2)) ∧ ∀(t1 :α num_map) (x :α) (t2 :α num_map). mk_wf (BS t1 x t2) = mk_BS (mk_wf t1) x (mk_wf t2)
toList_def_typed=∀(m :α num_map). toList m = toListA ([] :α list) m
toListA_def_typed=(∀(acc :α list). toListA acc (LN :α num_map) = acc) ∧ (∀(acc :α list) (a :α). toListA acc ⦕ 0 ↦ a ⦖ = a::acc) ∧ (∀(acc :α list) (t1 :α num_map) (t2 :α num_map). toListA acc (BN t1 t2) = toListA (toListA acc t2) t1) ∧ ∀(acc :α list) (t1 :α num_map) (a :α) (t2 :α num_map). toListA acc (BS t1 a t2) = toListA (a::toListA acc t2) t1
