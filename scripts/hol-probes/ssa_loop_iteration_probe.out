loop_helper_full=⊢ ∀st cst ssa_refreshed na_refreshed names body exit_names lt body' ssa' na'.
    word_state_eq_rel st cst ∧ strong_locals_rel (option_lookup ssa_refreshed) (domain names) st.locals cst.locals ∧ (∀v. v ∈ domain names ⇒ option_lookup ssa_refreshed v ∈ domain cst.locals) ∧ ssa_map_ok na_refreshed ssa_refreshed ∧ is_alloc_var na_refreshed ∧ every_var (λx. x < na_refreshed) body ∧ INJ (option_lookup ssa_refreshed) (domain names) 𝕌(:num) ∧ INJ (option_lookup ssa_refreshed) (domain exit_names) 𝕌(:num) ∧ domain names ⊆ domain ssa_refreshed ∧ domain exit_names ⊆ domain ssa_refreshed ∧ EVERY (λx. x < na_refreshed) (MAP FST (toAList names)) ∧ EVERY (λx. x < na_refreshed) (MAP FST (toAList exit_names)) ∧ lt_ok lt ∧ ssa_cc_trans body (inter ssa_refreshed names) na_refreshed ((ssa_refreshed,names,exit_names)::lt) = (body',ssa',na') ∧
    (∀st' cst' ssa'' na'' lt'.
       word_state_eq_rel st' cst' ∧ ssa_locals_rel na'' ssa'' st'.locals cst'.locals ∧ is_alloc_var na'' ∧ every_var (λx. x < na'') body ∧ ssa_map_ok na'' ssa'' ∧ lt_ok lt' ⇒
       ∃perm'. (let (res,rst) = evaluate (body,st' with permute := perm') in res = SOME Error ∨ (let (prog',ssaB,naB) = ssa_cc_trans body ssa'' na'' lt'; (res',rcst) = evaluate (prog',cst') in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of NONE => ssa_locals_rel naB ssaB rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n) => (case LLOOKUP lt' n of NONE => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names) rst.locals rcst.locals) | SOME (Continue n') => (case LLOOKUP lt' n' of NONE => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names) rst.locals rcst.locals) | SOME TimeOut => rst.locals = rcst.locals | SOME NotEnoughSpace => rst.locals = rcst.locals | SOME (FinalFFI v18) => rst.locals = rcst.locals | SOME Error => rst.locals = rcst.locals))) ⇒
    (let
       back_moves = ssa_reconcile ssa' ssa_refreshed names;
       body_final = if back_moves = Skip then body' else Seq body' back_moves;
       ssa_names = apply_nummap_key (option_lookup ssa_refreshed) names;
       ssa_exit = apply_nummap_key (option_lookup ssa_refreshed) exit_names
     in
       ∀res' rcst. evaluate (Loop ssa_names body_final ssa_exit,cst) = (res',rcst) ⇒ ∃perm'. (λ(res,rst). res = SOME Error ∨ res = res' ∧ word_state_eq_rel rst rcst ∧ case res of NONE => ssa_locals_rel na' (inter ssa_refreshed exit_names) rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n) => (case LLOOKUP lt n of NONE => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names) rst.locals rcst.locals) | SOME (Continue n') => (case LLOOKUP lt n' of NONE => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names) rst.locals rcst.locals) | SOME TimeOut => rst.locals = rcst.locals | SOME NotEnoughSpace => rst.locals = rcst.locals | SOME (FinalFFI v18) => rst.locals = rcst.locals | SOME Error => rst.locals = rcst.locals) (evaluate (Loop names body exit_names,st with permute := perm')))
loop_case_full=⊢ (∀st cst ssa na lt.
     word_state_eq_rel st cst ∧ ssa_locals_rel na ssa st.locals cst.locals ∧ is_alloc_var na ∧ every_var (λx. x < na) body ∧ ssa_map_ok na ssa ∧ lt_ok lt ⇒
     ∃perm'. (let (res,rst) = evaluate (body,st with permute := perm') in if res = SOME Error then T else (let (prog',ssa',na') = ssa_cc_trans body ssa na lt; (res',rcst) = evaluate (prog',cst) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of NONE => ssa_locals_rel na' ssa' rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n) => (case LLOOKUP lt n of NONE => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names) rst.locals rcst.locals) | SOME (Continue n') => (case LLOOKUP lt n' of NONE => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names) rst.locals rcst.locals) | SOME TimeOut => rst.locals = rcst.locals | SOME NotEnoughSpace => rst.locals = rcst.locals | SOME (FinalFFI v18) => rst.locals = rcst.locals | SOME Error => rst.locals = rcst.locals))) ⇒
  ∀st cst ssa na lt.
    word_state_eq_rel st cst ∧ ssa_locals_rel na ssa st.locals cst.locals ∧ is_alloc_var na ∧ every_var (λx. x < na) (Loop names body exit_names) ∧ ssa_map_ok na ssa ∧ lt_ok lt ⇒
    ∃perm'. (let (res,rst) = evaluate (Loop names body exit_names,st with permute := perm') in if res = SOME Error then T else (let (prog',ssa',na') = ssa_cc_trans (Loop names body exit_names) ssa na lt; (res',rcst) = evaluate (prog',cst) in res = res' ∧ word_state_eq_rel rst rcst ∧ case res of NONE => ssa_locals_rel na' ssa' rst.locals rcst.locals | SOME (Result v12 v13) => rst.locals = rcst.locals | SOME (Exception v14 v15) => rst.locals = rcst.locals | SOME (Break n) => (case LLOOKUP lt n of NONE => T | SOME (tgt_ssa,v3,exit_names) => strong_locals_rel (option_lookup tgt_ssa) (domain exit_names) rst.locals rcst.locals) | SOME (Continue n') => (case LLOOKUP lt n' of NONE => T | SOME (tgt_ssa,names,v4) => strong_locals_rel (option_lookup tgt_ssa) (domain names) rst.locals rcst.locals) | SOME TimeOut => rst.locals = rcst.locals | SOME NotEnoughSpace => rst.locals = rcst.locals | SOME (FinalFFI v18) => rst.locals = rcst.locals | SOME Error => rst.locals = rcst.locals))
