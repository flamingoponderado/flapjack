MAP_FST_compile_typed=MAP (FST :α # num # closLang$exp -> α) (compile (p :(α # num # closLang$exp) list)) = MAP (FST :α # num # closLang$exp -> α) p
semantics_annotate_typed=semantics (ffi :'ffi ffi_state) (max_app :num) (alist_to_fmap (prog :(num # num # closLang$exp) list)) (co :num -> α # closLang$exp list # (num # num # closLang$exp) list) (pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) (cc :α -> closLang$exp list # (num # num # closLang$exp) list -> (word8 list # word64 list # α) option)) (xs :closLang$exp list) ≠ Fail ⇒ every_Fn_vs_NONE xs ∧ every_Fn_vs_NONE (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) prog) ∧ (∀(n :num). every_Fn_vs_NONE (FST (SND (co n))) ∧ every_Fn_vs_NONE (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) (SND (SND (co n))))) ⇒ semantics ffi max_app (alist_to_fmap (compile prog)) ((pure_co (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) :α # closLang$exp list # (num # num # closLang$exp) list -> α # closLang$exp list # (num # num # closLang$exp) list) ∘ co) cc (annotate (0 :num) xs) = semantics ffi max_app (alist_to_fmap prog) co (pure_cc (compile_inc :closLang$exp list # (num # num # closLang$exp) list -> closLang$exp list # (num # num # closLang$exp) list) cc) xs
shift_obeys_max_app_typed=∀(xs :closLang$exp list) (m :num) (l :num) (i :num sptree$num_map). EVERY (obeys_max_app (n :num)) xs ⇒ EVERY (obeys_max_app n) (shift xs m l i)
alt_free_obeys_max_app_typed=∀(xs :closLang$exp list) (m :α) (l :β) (i :γ). EVERY (obeys_max_app (n :num)) xs ⇒ EVERY (obeys_max_app n) (FST (alt_free xs))
annotate_obeys_max_app_typed=∀(n :num) (xs :closLang$exp list). EVERY (obeys_max_app (m :num)) xs ⇒ EVERY (obeys_max_app m) (annotate n xs)
obeys_max_app_ann_typed=∀(xs :(α # num # closLang$exp) list). EVERY (obeys_max_app (m :num)) (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :α # num # closLang$exp -> num # closLang$exp)) xs) ⇒ EVERY (obeys_max_app m) (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :α # num # closLang$exp -> num # closLang$exp)) (compile xs))
shift_no_Labels_typed=∀(xs :closLang$exp list) (m :num) (l :num) (i :num sptree$num_map). EVERY no_Labels xs ⇒ EVERY no_Labels (shift xs m l i)
alt_free_no_Labels_typed=∀(xs :closLang$exp list) (m :α) (l :β) (i :γ). EVERY no_Labels xs ⇒ EVERY no_Labels (FST (alt_free xs))
annotate_no_Labels_typed=∀(n :num) (xs :closLang$exp list). EVERY no_Labels xs ⇒ EVERY no_Labels (annotate n xs)
no_Labels_ann_typed=∀(xs :(α # num # closLang$exp) list). EVERY no_Labels (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :α # num # closLang$exp -> num # closLang$exp)) xs) ⇒ EVERY no_Labels (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :α # num # closLang$exp -> num # closLang$exp)) (compile xs))
app_call_dests_def_typed=(∀(opt :bool option). app_call_dests opt ([] :closLang$exp list) = (∅ :num -> bool)) ∧ (∀(y :closLang$exp) (xs :closLang$exp list) (x :closLang$exp) (opt :bool option). app_call_dests opt (x::y::xs) = (let (c1 :num -> bool) = app_call_dests opt [x]; (c2 :num -> bool) = app_call_dests opt (y::xs) in c1 ∪ c2)) ∧ (∀(v0 :tra) (v :num) (opt :bool option). app_call_dests opt [(Var v0 v :closLang$exp)] = (∅ :num -> bool)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (v1 :tra) (opt :bool option). app_call_dests opt [(If v1 x1 x2 x3 :closLang$exp)] = (let (c1 :num -> bool) = app_call_dests opt [x1]; (c2 :num -> bool) = app_call_dests opt [x2]; (c3 :num -> bool) = app_call_dests opt [x3] in c1 ∪ c2 ∪ c3)) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (v2 :tra) (opt :bool option). app_call_dests opt [(Let v2 xs x2 :closLang$exp)] = (let (c1 :num -> bool) = app_call_dests opt xs; (c2 :num -> bool) = app_call_dests opt [x2] in c1 ∪ c2)) ∧ (∀(x1 :closLang$exp) (v3 :tra) (opt :bool option). app_call_dests opt [(Raise v3 x1 :closLang$exp)] = app_call_dests opt [x1]) ∧ (∀(x1 :closLang$exp) (v4 :tra) (opt :bool option). app_call_dests opt [Tick v4 x1] = app_call_dests opt [x1]) ∧ (∀(xs :closLang$exp list) (v5 :tra) (opt :bool option) (op :closLang$op). app_call_dests opt [Op v5 op xs] = app_call_dests opt xs) ∧ (∀(xs :closLang$exp list) (x1 :closLang$exp) (v6 :tra) (opt :bool option) (loc_opt :num option). app_call_dests opt [(App v6 loc_opt x1 xs :closLang$exp)] = (let (ll :num -> bool) = if opt = SOME T then (∅ :num -> bool) else case loc_opt of (NONE :num option) => (∅ :num -> bool) | SOME n => {n}; (c1 :num -> bool) = app_call_dests opt [x1]; (c2 :num -> bool) = app_call_dests opt xs in ll ∪ c1 ∪ c2)) ∧ (∀(x1 :closLang$exp) (vs :num list option) (v7 :mlstring) (opt :bool option) (num_args :num) (loc_opt :num option). app_call_dests opt [Fn v7 loc_opt vs num_args x1] = (let (c1 :num -> bool) = app_call_dests opt [x1] in c1)) ∧ (∀(x1 :closLang$exp) (vs :num list option) (v8 :mlstring list) (opt :bool option) (loc_opt :num option) (fns :(num # closLang$exp) list). app_call_dests opt [(Letrec v8 loc_opt vs fns x1 :closLang$exp)] = (let (c1 :num -> bool) = app_call_dests opt (MAP (SND :num # closLang$exp -> closLang$exp) fns); (c2 :num -> bool) = app_call_dests opt [x1] in c1 ∪ c2)) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (v9 :tra) (opt :bool option). app_call_dests opt [(Handle v9 x1 x2 :closLang$exp)] = (let (c1 :num -> bool) = app_call_dests opt [x1]; (c2 :num -> bool) = app_call_dests opt [x2] in c1 ∪ c2)) ∧ ∀(xs :closLang$exp list) (v10 :tra) (ticks :num) (opt :bool option) (dest :num). app_call_dests opt [Call v10 ticks dest xs] = if opt = SOME F then app_call_dests opt xs else dest INSERT app_call_dests opt xs
app_call_dests_append_typed=∀(l1 :closLang$exp list) (l2 :closLang$exp list). app_call_dests (opt :bool option) (l1 ++ l2) = app_call_dests opt l1 ∪ app_call_dests opt l2
call_dests_shift_typed=∀(a :closLang$exp list) (b :num) (c :num) (d :num sptree$num_map). app_call_dests (opt :bool option) (shift a b c d) = app_call_dests opt a
code_locs_shift_typed=∀(xs :closLang$exp list) (k1 :num) (k2 :num) (k3 :num sptree$num_map). code_locs (shift xs k1 k2 k3) = code_locs xs
code_locs_alt_free_typed=∀(xs :closLang$exp list) (r1 :closLang$exp list) (r2 :db_var_set). alt_free xs = (r1,r2) ⇒ set (code_locs r1) ⊆ set (code_locs xs)
code_locs_annotate_typed=∀(n :num) (xs :closLang$exp list). set (code_locs (annotate n xs)) ⊆ set (code_locs xs)
annotate_code_locs_typed=∀(n :num) (ls :closLang$exp list). set (code_locs (annotate n ls)) ⊆ set (code_locs ls) ∧ (ALL_DISTINCT (code_locs ls) ⇒ ALL_DISTINCT (code_locs (annotate n ls)))
HD_annotate_SING_typed=[HD (annotate (x :num) [(y :closLang$exp)])] = annotate x [y]
every_Fn_SOME_ann_typed=∀(xs :(α # num # closLang$exp) list). every_Fn_SOME (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :α # num # closLang$exp -> num # closLang$exp)) xs) ⇒ every_Fn_SOME (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :α # num # closLang$exp -> num # closLang$exp)) (compile xs))
