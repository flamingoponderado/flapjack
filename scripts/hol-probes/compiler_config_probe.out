compiler_config_axiom=⊢ ∀(f :inf_env -> backend$config -> α asm_config -> bool -> bool -> bool -> bool -> bool -> β). ∃(fn :α config -> β). ∀(a0 :inf_env) (a1 :backend$config) (a2 :α asm_config) (a3 :bool) (a4 :bool) (a5 :bool) (a6 :bool) (a7 :bool). fn (config a0 a1 a2 a3 a4 a5 a6 a7 :α config) = f a0 a1 a2 a3 a4 a5 a6 a7
compiler_read_limits_replay=⊢ ∀(cc :α config) (mc :(α, β, γ) machine_config) (ms :β). probe_read_limits cc mc ms = probe_backend_read_limits cc.asm_config cc.backend_config mc ms
