conditional_branch_definition_BEQ=∀rs1 rs2 offs. dfn'BEQ (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) = if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
conditional_branch_definition_BNE=∀rs1 rs2 offs. dfn'BNE (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) ≠ if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
conditional_branch_definition_BLT=∀rs1 rs2 offs. dfn'BLT (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) < if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
conditional_branch_definition_BGE=∀rs1 rs2 offs. dfn'BGE (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) ≥ if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
conditional_branch_definition_BLTU=∀rs1 rs2 offs. dfn'BLTU (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) <₊ if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
conditional_branch_definition_BGEU=∀rs1 rs2 offs. dfn'BGEU (rs1,rs2,offs) = (λstate. (let (v,s) = in32BitMode () state; (v0,s0) = in32BitMode () s in if (if v then sw2sw ((31 >< 0) (GPR rs1 s)) else GPR rs1 s) ≥₊ if v0 then sw2sw ((31 >< 0) (GPR rs2 s0)) else GPR rs2 s0 then branchTo (PC s0 + sw2sw offs ≪ 1) s0 else s0))
