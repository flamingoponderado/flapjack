compile_prog_def=∀(max_app :num) (prog :(num # num # closLang$exp) list). compile_prog max_app prog = (let ((new_exps :exp list),(aux :(num # num # exp) list)) = compile_exps max_app (MAP ((SND :num # closLang$exp -> closLang$exp) ∘ (SND :num # num # closLang$exp -> num # closLang$exp)) prog) ([] :(num # num # exp) list) in (MAP2 (λ((loc :num),(args :num),(_0 :closLang$exp)) (exp :exp). (loc + num_stubs max_app,args,exp)) prog new_exps :(num # num # exp) list) ++ aux)
compile_prog_type=:num -> (num # num # closLang$exp) list -> (num # num # exp) list
