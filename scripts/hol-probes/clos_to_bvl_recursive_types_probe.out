compile_exp_sing_def=(∀(v :num) (t :tra) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Var t v :closLang$exp) aux = ((Var v :exp),aux)) ∧ (∀(x3 :closLang$exp) (x2 :closLang$exp) (x1 :closLang$exp) (t :tra) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (If t x1 x2 x3 :closLang$exp) aux = (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux; ((c2 :exp),(aux2 :(num # num # exp) list)) = compile_exp_sing max_app x2 aux1; ((c3 :exp),(aux3 :(num # num # exp) list)) = compile_exp_sing max_app x3 aux2 in ((If c1 c2 c3 :exp),aux3))) ∧ (∀(xs :closLang$exp list) (x2 :closLang$exp) (t :tra) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Let t xs x2 :closLang$exp) aux = (let ((c1 :exp list),(aux1 :(num # num # exp) list)) = compile_exp_list max_app xs aux; ((c2 :exp),(aux2 :(num # num # exp) list)) = compile_exp_sing max_app x2 aux1 in ((Let c1 c2 :exp),aux2))) ∧ (∀(x1 :closLang$exp) (t :tra) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Raise t x1 :closLang$exp) aux = (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux in ((Raise c1 :exp),aux1))) ∧ (∀(x1 :closLang$exp) (t :tra) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Tick t x1 :closLang$exp) aux = (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux in ((Tick c1 :exp),aux1))) ∧ (∀(xs :closLang$exp list) (t :tra) (op :op) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Op t op xs :closLang$exp) aux = (let ((c1 :exp list),(aux1 :(num # num # exp) list)) = compile_exp_list max_app xs aux in (if op = Install then (Call (0 :num) (NONE :num option) [(Op Install c1 :exp)] :exp) else if op = (ThunkOp ForceThunk :op) then (Let c1 (Force (num_stubs max_app − (2 :num)) (0 :num) :exp) :exp) else (Op (compile_op op) c1 :exp),aux1))) ∧ (∀(xs2 :closLang$exp list) (x1 :closLang$exp) (t :tra) (max_app :num) (loc_opt :num option) (aux :(num # num # exp) list). compile_exp_sing max_app (App t loc_opt x1 xs2 :closLang$exp) aux = (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux; ((c2 :exp list),(aux2 :(num # num # exp) list)) = compile_exp_list max_app xs2 aux1 in ((case loc_opt of (NONE :num option) => (Let (c2 ++ [c1]) (mk_cl_call (Var (LENGTH c2) :exp) (GENLIST Var (LENGTH c2))) :exp) | SOME loc => (Call (LENGTH c2 − (1 :num)) (SOME (loc + num_stubs max_app)) (c2 ++ [c1]) :exp)),aux2))) ∧ (∀(x1 :closLang$exp) (vs_opt :num list option) (t :mlstring) (num_args :num) (max_app :num) (loc_opt :num option) (aux :(num # num # exp) list). compile_exp_sing max_app (Fn t loc_opt vs_opt num_args x1) aux = (let (loc :num) = case loc_opt of (NONE :num option) => (0 :num) | SOME n => n; (vs :num list) = case vs_opt of (NONE :num list option) => ([] :num list) | SOME vs => vs; ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux; (c2 :exp) = (Let (GENLIST Var num_args ++ free_let (Var num_args :exp) (LENGTH vs)) c1 :exp) in ((Op (BlockOp (Cons closure_tag :block_op)) (REVERSE (mk_label (loc + num_stubs max_app)::mk_const (num_args − (1 :num))::MAP Var vs)) :exp),(loc + num_stubs max_app,num_args + (1 :num),c2)::aux1))) ∧ (∀(x1 :closLang$exp) (vsopt :num list option) (t :mlstring list) (max_app :num) (loc_opt :num option) (fns :(num # closLang$exp) list) (aux :(num # num # exp) list). compile_exp_sing max_app (Letrec t loc_opt vsopt fns x1 :closLang$exp) aux = (let (loc :num) = case loc_opt of (NONE :num option) => (0 :num) | SOME n => n; (vs :num list) = case vsopt of (NONE :num list option) => ([] :num list) | SOME x => x in case fns of ([] :(num # closLang$exp) list) => compile_exp_sing max_app x1 aux | [(num_args,exp)] => (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app exp aux; (c3 :exp) = (Let (GENLIST Var num_args ++ [(Var num_args :exp)] ++ free_let (Var num_args :exp) (LENGTH vs)) c1 :exp); ((c2 :exp),(aux2 :(num # num # exp) list)) = compile_exp_sing max_app x1 ((loc + num_stubs max_app,num_args + (1 :num),c3)::aux1); (c4 :exp) = (Op (BlockOp (Cons closure_tag :block_op)) (REVERSE (mk_label (loc + num_stubs max_app)::mk_const (num_args − (1 :num))::MAP Var vs)) :exp) in ((Let [c4] c2 :exp),aux2)) | v2::v6::v7 => (let (fns_l :num) = LENGTH fns; (l :num) = fns_l + LENGTH vs; ((cs :exp list),(aux1 :(num # num # exp) list)) = compile_exp_list max_app (MAP (SND :num # closLang$exp -> closLang$exp) fns) aux; (cs1 :(num # exp) list) = (MAP2 (code_for_recc_case l) (MAP (FST :num # closLang$exp -> num) fns) cs :(num # exp) list); ((n2 :num),(aux2 :(num # num # exp) list)) = build_aux (loc + num_stubs max_app) cs1 aux1; ((c3 :exp),(aux3 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux2; (c4 :exp) = build_recc_lets (MAP (FST :num # closLang$exp -> num) fns) vs (loc + num_stubs max_app) fns_l c3 in (c4,aux3)))) ∧ (∀(x2 :closLang$exp) (x1 :closLang$exp) (t :tra) (max_app :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Handle t x1 x2 :closLang$exp) aux = (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x1 aux; ((c2 :exp),(aux2 :(num # num # exp) list)) = compile_exp_sing max_app x2 aux1 in ((Handle c1 c2 :exp),aux2))) ∧ (∀(xs :closLang$exp list) (ticks :num) (t :tra) (max_app :num) (dest :num) (aux :(num # num # exp) list). compile_exp_sing max_app (Call t ticks dest xs :closLang$exp) aux = (let ((c1 :exp list),(aux1 :(num # num # exp) list)) = compile_exp_list max_app xs aux in ((Call ticks (SOME (dest + num_stubs max_app)) c1 :exp),aux1))) ∧ (∀(max_app :num) (aux :(num # num # exp) list). compile_exp_list max_app ([] :closLang$exp list) aux = (([] :exp list),aux)) ∧ ∀(xs :closLang$exp list) (x :closLang$exp) (max_app :num) (aux :(num # num # exp) list). compile_exp_list max_app (x::xs) aux = (let ((c1 :exp),(aux1 :(num # num # exp) list)) = compile_exp_sing max_app x aux; ((c2 :exp list),(aux2 :(num # num # exp) list)) = compile_exp_list max_app xs aux1 in (c1::c2,aux2))
