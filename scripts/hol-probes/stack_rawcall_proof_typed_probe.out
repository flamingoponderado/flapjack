stack_alloc_stack_asm_convs_typed=(EVERY (λ((n :num),(p :α prog)). stack_asm_name (c :α asm_config) p) (compile (prog :(num # α prog) list) :(num # α prog) list) ⇔ EVERY (λ((n :num),(p :α prog)). stack_asm_name c p) prog) ∧ (EVERY (λ((n :num),(p :α prog)). stack_asm_remove c p) (compile prog :(num # α prog) list) ⇔ EVERY (λ((n :num),(p :α prog)). stack_asm_remove c p) prog)
stack_asm_name_comp_typed=∀(i :num sptree$num_map) (p :α prog). ((stack_asm_name (c :α asm_config) (comp i p :α prog) ⇔ stack_asm_name c p) ∧ (stack_asm_name c (comp_top i p) ⇔ stack_asm_name c p)) ∧ (stack_asm_remove c (comp i p :α prog) ⇔ stack_asm_remove c p) ∧ (stack_asm_remove c (comp_top i p) ⇔ stack_asm_remove c p)
comp_correct_typed=∀(p :α prog) (s :(α, γ, β) state) (t :(α, γ, β) state) (i :num sptree$num_map) (r :α result option) (s1 :(α, γ, β) state). (evaluate (p,s) :α result option # (α, γ, β) state) = (r,s1) ∧ r ≠ SOME (Error :α result) ∧ state_rel i s t ⇒ (∃(ck :num) (t1 :(α, γ, β) state) (k1 :num). state_rel i s1 t1 ∧ (evaluate (comp_top i p,t with clock := t.clock + ck) :α result option # (α, γ, β) state) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME (TimeOut :α result) ∧ r ≠ SOME (Halt (Word (2w :α word)) :α result) ⇒ k1 = t1.stack_space)) ∧ ∃(ck :num) (t1 :(α, γ, β) state) (k1 :num). state_rel i s1 t1 ∧ (evaluate ((comp i p :α prog),t with clock := t.clock + ck) :α result option # (α, γ, β) state) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME (TimeOut :α result) ∧ r ≠ SOME (Halt (Word (2w :α word)) :α result) ⇒ k1 = t1.stack_space)
comp_LN_typed=∀(i :num sptree$num_map) (b :α prog). comp_top (LN :num sptree$num_map) b = b ∧ (comp (LN :num sptree$num_map) b :α prog) = b
comp_seq_neq_IMP_typed=comp_seq (p1 :α prog) (p2 :α prog) (i :num sptree$num_map) (default :α prog) ≠ default ⇒ ∃(k :num) (dest :num). p1 = (StackFree k :α prog) ∧ p2 = (Call (NONE :(α prog # num # num # num) option) (INL dest :num + num) (NONE :(α prog # num # num) option) :α prog)
domain_fromAList_compile_typed=(domain (fromAList (compile (code :(num # α prog) list) :(num # α prog) list)) :num -> bool) = (domain (fromAList code) :num -> bool)
lookup_collect_info_typed=∀(xs :(num # α prog) list) (n :num) (rest :num sptree$num_map). ALL_DISTINCT (MAP (FST :num # α prog -> num) xs) ⇒ (lookup n (collect_info xs rest) :num option) = case ALOOKUP xs n of (NONE :α prog option) => (lookup n rest :num option) | SOME body => (lookup n (collect_info [(n,body)] rest) :num option)
state_ok_collect_info_typed=ALL_DISTINCT (MAP (FST :num # α prog -> num) (code :(num # α prog) list)) ⇒ state_ok (collect_info code (LN :num sptree$num_map)) (fromAList code)
compile_semantics_typed=ALL_DISTINCT (MAP (FST :num # α prog -> num) (code :(num # α prog) list)) ∧ (s :(α, β, γ) state).use_stack ∧ s.code = fromAList code ∧ (semantics (start :num) s :behaviour) ≠ Fail ⇒ (semantics start (s with code := fromAList (compile code :(num # α prog) list)) :behaviour) = (semantics start s :behaviour)
call_arg_comp_typed=∀(i :num sptree$num_map) (p :α prog). (alloc_arg (comp i p :α prog) ⇔ alloc_arg p) ∧ (alloc_arg (comp_top i p) ⇔ alloc_arg p)
call_args_comp_typed=∀(i :num sptree$num_map) (p :α prog). (call_args (comp i p :α prog) (r1 :num) (r2 :num) (r3 :num) (r4 :num) (r5 :num) ⇔ call_args p r1 r2 r3 r4 r5) ∧ (call_args (comp_top i p) r1 r2 r3 r4 r5 ⇔ call_args p r1 r2 r3 r4 r5)
MAP_FST_compile_typed=MAP (FST :num # α prog -> num) (compile (code :(num # α prog) list) :(num # α prog) list) = MAP (FST :num # α prog -> num) code
reg_bound_comp_typed=∀(i :num sptree$num_map) (p :α prog). (reg_bound (comp i p :α prog) (s :num) ⇔ reg_bound p s) ∧ (reg_bound (comp_top i p) s ⇔ reg_bound p s)
stack_alloc_call_args_typed=EVERY (λ(p :α prog). call_args p (1 :num) (2 :num) (3 :num) (4 :num) (0 :num)) (MAP (SND :num # α prog -> α prog) (compile (prog1 :(num # α prog) list) :(num # α prog) list)) ⇔ EVERY (λ(p :α prog). call_args p (1 :num) (2 :num) (3 :num) (4 :num) (0 :num)) (MAP (SND :num # α prog -> α prog) prog1)
stack_rawcall_reg_bound_typed=EVERY (λ(p :α prog). reg_bound p (sp :num)) (MAP (SND :num # α prog -> α prog) (compile (prog1 :(num # α prog) list) :(num # α prog) list)) ⇔ EVERY (λ(p :α prog). reg_bound p sp) (MAP (SND :num # α prog -> α prog) prog1)
extract_labels_comp_typed=∀(i :num sptree$num_map) (p :α prog). extract_labels (comp i p :α prog) = extract_labels p ∧ extract_labels (comp_top i p) = extract_labels p
stack_get_handler_labels_comp_typed=∀(i :num sptree$num_map) (p :α prog) (k :num). stack_get_handler_labels k (comp i p :α prog) = stack_get_handler_labels k p ∧ stack_get_handler_labels k (comp_top i p) = stack_get_handler_labels k p
evaluate_comp_Inst_typed=(evaluate ((Inst (i :α inst) :α prog),(s :(α, β, γ) state)) :α result option # (α, β, γ) state) = ((r :α result option),(s1 :(α, β, γ) state)) ∧ r ≠ SOME (Error :α result) ∧ state_rel (i' :num sptree$num_map) s (t :(α, β, γ) state) ⇒ ∃(ck :num) (t1 :(α, β, γ) state) (k1 :num). state_rel i' s1 t1 ∧ (evaluate ((comp i' (Inst i :α prog) :α prog),t with clock := ck + t.clock) :α result option # (α, β, γ) state) = (r,t1 with stack_space := k1) ∧ (r ≠ SOME (TimeOut :α result) ∧ r ≠ SOME (Halt (Word (2w :α word)) :α result) ⇒ k1 = t1.stack_space)
get_labels_comp_typed=∀(i :num sptree$num_map) (e :α prog). get_labels (comp i e :α prog) = get_labels e ∧ get_labels (comp_top i e) = get_labels e
state_ok_def_typed=∀(i :num sptree$num_map) (code :α prog sptree$num_map). state_ok i code ⇔ ∀(n :num) (v :num). (lookup n i :num option) = SOME v ⇒ ∃(p :α prog). (lookup n code :α prog option) = SOME (Seq (StackAlloc v :α prog) p)
state_rel_def_typed=∀(i :num sptree$num_map) (s :(α, β, γ) state) (t :(α, β, γ) state). state_rel i s t ⇔ ∃(c :α prog sptree$num_map). (domain c :num -> bool) = (domain s.code :num -> bool) ∧ t = s with code := c ∧ state_ok i s.code ∧ ∀(n :num) (b :α prog). (lookup n s.code :α prog option) = SOME b ⇒ ∃(i :num sptree$num_map). state_ok i s.code ∧ (lookup n c :α prog option) = SOME (comp_top i b)
