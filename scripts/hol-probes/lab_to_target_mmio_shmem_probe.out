mmio_pcs_min_index_APPEND_thm=EVERY (λ(x :ffiname). ∀(s :mlstring). x ≠ ExtCall s) (l :ffiname list) ∧
EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) (ffis :ffiname list) ⇒
mmio_pcs_min_index (ffis ++ l) = SOME (LENGTH ffis)
mmio_pcs_min_index_APPEND_thm_types=(ffis :ffiname list)::ffiname list;(l :ffiname list)::ffiname list;
mmio_pcs_min_index_APPEND_thm_hypotheses=0
mmio_pcs_min_index_get_shmem_info_ok=all_enc_ok (c :α asm_config) (labs :num sptree$num_map sptree$num_map)
  (ffis' :ffiname list) (p' :num) (code2 :α sec list) ∧ enc_ok c ∧
EVERY (λ(x :ffiname). ∃(s :mlstring). x = ExtCall s) (ffis :ffiname list) ∧
get_shmem_info code2 (p :num) ffis ([] :shmem_info_num list) =
((new_ffi_names :ffiname list),(new_shmem_info :shmem_info_num list)) ⇒
mmio_pcs_min_index new_ffi_names = SOME (LENGTH ffis)
