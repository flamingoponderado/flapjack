OPT_MMAP_EQ_SOME_MONO_typed=OPT_MMAP (f :β -> α option) (xs :β list) = SOME (y :α list) ⇒ (∀(x :β) (z :α). MEM x xs ⇒ f x = SOME z ⇒ (g :β -> α option) x = SOME z) ⇒ OPT_MMAP g xs = SOME y
dest_2exp_bound_typed=∀(n :num) (w :α word) (m :num). dest_2exp n w = SOME m ⇒ m ≤ n + w2n (word_log2 w)
dest_2exp_bound_prime_typed=∀(n :β) (w :α word) (m :num). dest_2exp (0 :num) w = SOME m ⇒ m < dimindex (:α)
dest_const_thm_typed=dest_const (exp :α crepLang$exp) = SOME (v :α word) ⇒ exp = (Const v :α crepLang$exp)
eval_mul_const_typed=(eval (s :(α, β) state) (exp :α crepLang$exp) :α word_lab option) = SOME (Word (w :α word) :α word_lab) ⇒ (eval s (mul_const exp (c :α word)) :α word_lab option) = SOME (Word (w * c) :α word_lab)
lookup_code_typed=(lookup_code (FMAP_MAP2 (λ((s :δ),(n :β list),(p :α crepLang$prog)). (n,simp_prog p)) (c :δ |-> β list # α crepLang$prog)) (fname :δ) (args :γ list) (len :ε) :(α crepLang$prog # (β |-> γ)) option) = OPTION_MAP ((simp_prog :α crepLang$prog -> α crepLang$prog) ## (I :(β |-> γ) -> (β |-> γ))) (lookup_code c fname args len :(α crepLang$prog # (β |-> γ)) option)
opt_mmap_simp_exp_correct_typed=OPT_MMAP (eval (s :(α, β) state) :α crepLang$exp -> α word_lab option) (es :α crepLang$exp list) = SOME (vs :α word_lab list) ⇒ OPT_MMAP (eval (mapc (f :mlstring # num list # α crepLang$prog -> num list # α crepLang$prog) s) :α crepLang$exp -> α word_lab option) (MAP (simp_exp :α crepLang$exp -> α crepLang$exp) es) = SOME vs
sh_mem_op_code_typed=(sh_mem_op (op :memop) (p :num) (addr :β word) (mapc (f :mlstring # num list # β crepLang$prog -> num list # β crepLang$prog) (s :(β, γ) state)) :α result option # (β, γ) state) = ((I :α result option -> α result option) ## (λ(s :(β, γ) state). mapc f s)) (sh_mem_op op p addr s :α result option # (β, γ) state)
simp_exp_correct_typed=(eval (s :(α, β) state) (exp :α crepLang$exp) :α word_lab option) = SOME (v :α word_lab) ⇒ (eval (mapc (f :mlstring # num list # α crepLang$prog -> num list # α crepLang$prog) s) (simp_exp exp) :α word_lab option) = SOME v
simp_exp_correct1_typed=∀(s :(α, β) state) (exp :α crepLang$exp) (v :γ). (eval s exp :α word_lab option) ≠ (NONE :α word_lab option) ⇒ (eval (mapc (f :mlstring # num list # α crepLang$prog -> num list # α crepLang$prog) s) (simp_exp exp) :α word_lab option) = (eval s exp :α word_lab option)
simp_prog_correct_typed=∀(p :α crepLang$prog) (s :(α, β) state) (r :α result option) (s' :(α, β) state). (evaluate (p,s) :α result option # (α, β) state) = (r,s') ⇒ r ≠ SOME (Error :α result) ⇒ (evaluate (simp_prog p,mapcs s) :α result option # (α, β) state) = (r,mapcs s')
