app_int=SOME (Number (15 :int) :v)
app_byte_length=SOME (Number (3 :int) :v)
app_byte_deref=SOME (Number ((&w2n (2w :word8)) :int) :v)
app_byte_update=case if ∃(w :word8). (255 :int) = ((&w2n w) :int) then (Rval (Block (0 :num) ([] :v list),<|globals := [SOME (Number (10 :int) :v); SOME (Number (20 :int) :v)]; refs := (FEMPTY :num |-> v ref)⟨(3 :num) ↦ (ByteArray T [(255w :word8); (4w :word8)] :v ref); (3 :num) ↦ (ByteArray T [(3w :word8); (4w :word8)] :v ref); (2 :num) ↦ (ByteArray F [(1w :word8); (2w :word8); (3w :word8)] :v ref)⟩|>) :(v # (unit, unit) state, v) result) else (Rerr (Rabort Rtype_error :v error_result) :(v # (unit, unit) state, v) result) of (Rval (v6,s) :(v # (unit, unit) state, v) result) => FLOOKUP s.refs (3 :num) | (Rerr v3 :(v # (unit, unit) state, v) result) => (NONE :v ref option)
app_byte_bounds=SOME (Block (1 :num) ([] :v list))
app_ffi_bad_buffers=T
app_thunk_update=SOME (Thunk Evaluated (Number (7 :int) :v) :v ref)
app_thunk_bad_flag=T
evaluate_type=:bvl$exp list # v list # (α, β) state -> (v list, v) result # (α, β) state
evaluate_final=(∀(s :(γ, 'ffi) state) (env :v list). evaluate (([] :bvl$exp list),env,s) = ((Rval ([] :v list) :(v list, v) result),s)) ∧ (∀(y :bvl$exp) (xs :bvl$exp list) (x :bvl$exp) (s :(γ, 'ffi) state) (env :v list). evaluate (x::y::xs,env,s) = case evaluate ([x],env,s) of ((Rval v1 :(v list, v) result),s1) => (case evaluate (y::xs,env,s1) of ((Rval vs :(v list, v) result),s2) => ((Rval (HD v1::vs) :(v list, v) result),s2) | ((Rerr v8 :(v list, v) result),s2) => ((Rerr v8 :(v list, v) result),s2)) | ((Rerr v10 :(v list, v) result),s1) => ((Rerr v10 :(v list, v) result),s1)) ∧ (∀(s :(γ, 'ffi) state) (n :num) (env :v list). evaluate ([(Var n :bvl$exp)],env,s) = if n < LENGTH env then ((Rval [env❲n❳] :(v list, v) result),s) else ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s)) ∧ (∀(x3 :bvl$exp) (x2 :bvl$exp) (x1 :bvl$exp) (s :(γ, 'ffi) state) (env :v list). evaluate ([(If x1 x2 x3 :bvl$exp)],env,s) = case evaluate ([x1],env,s) of ((Rval vs :(v list, v) result),s1) => if (Boolv T :v) = HD vs then evaluate ([x2],env,s1) else if (Boolv F :v) = HD vs then evaluate ([x3],env,s1) else ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s1) | ((Rerr v7 :(v list, v) result),s1) => ((Rerr v7 :(v list, v) result),s1)) ∧ (∀(xs :bvl$exp list) (x2 :bvl$exp) (s :(γ, 'ffi) state) (env :v list). evaluate ([(Let xs x2 :bvl$exp)],env,s) = case evaluate (xs,env,s) of ((Rval vs :(v list, v) result),s1) => evaluate ([x2],vs ++ env,s1) | ((Rerr v7 :(v list, v) result),s1) => ((Rerr v7 :(v list, v) result),s1)) ∧ (∀(x1 :bvl$exp) (s :(γ, 'ffi) state) (env :v list). evaluate ([(Raise x1 :bvl$exp)],env,s) = case evaluate ([x1],env,s) of ((Rval vs :(v list, v) result),s') => ((Rerr (Rraise (HD vs)) :(v list, v) result),s') | ((Rerr v7 :(v list, v) result),s') => ((Rerr v7 :(v list, v) result),s')) ∧ (∀(x2 :bvl$exp) (x1 :bvl$exp) (s1 :(γ, 'ffi) state) (env :v list). evaluate ([(Handle x1 x2 :bvl$exp)],env,s1) = case evaluate ([x1],env,s1) of ((Rval v7 :(v list, v) result),s) => ((Rval v7 :(v list, v) result),s) | ((Rerr (Rraise v) :(v list, v) result),s) => evaluate ([x2],v::env,s) | ((Rerr (Rabort v12 :v error_result) :(v list, v) result),s) => ((Rerr (Rabort v12 :v error_result) :(v list, v) result),s)) ∧ (∀(xs :bvl$exp list) (s :(γ, 'ffi) state) (op :closLang$op) (env :v list). evaluate ([(Op op xs :bvl$exp)],env,s) = case evaluate (xs,env,s) of ((Rval vs :(v list, v) result),s') => (case (do_app op (REVERSE vs) s' :(v # (γ, 'ffi) state, v) result) of (Rval (v3,v4) :(v # (γ, 'ffi) state, v) result) => ((Rval [v3] :(v list, v) result),v4) | (Rerr err :(v # (γ, 'ffi) state, v) result) => ((Rerr err :(v list, v) result),s')) | ((Rerr v10 :(v list, v) result),s') => ((Rerr v10 :(v list, v) result),s')) ∧ (∀(x :bvl$exp) (s :(γ, 'ffi) state) (env :v list). evaluate ([(Tick x :bvl$exp)],env,s) = if s.clock = (0 :num) then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s) else evaluate ([x],env,dec_clock (1 :num) s)) ∧ (∀(s :(γ, 'ffi) state) (n :num) (force_loc :num) (env :v list). evaluate ([(Force force_loc n :bvl$exp)],env,s) = if ¬(n < LENGTH env) then ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) else (let (thunk_v :v) = env❲n❳ in case (dest_thunk thunk_v s.refs :dest_thunk_ret) of BadRef => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | NotThunk => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | (IsThunk Evaluated v :dest_thunk_ret) => ((Rval [v] :(v list, v) result),s) | (IsThunk NotEvaluated v :dest_thunk_ret) => case (find_code (SOME force_loc) [thunk_v; v] s.code :(v list # bvl$exp) option) of (NONE :(v list # bvl$exp) option) => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME (args,exp) => if s.clock = (0 :num) then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with clock := (0 :num)) else evaluate ([exp],args,dec_clock (1 :num) s))) ∧ ∀(xs :bvl$exp list) (ticks :num) (s1 :(γ, 'ffi) state) (env :v list) (dest :num option). evaluate ([(Call ticks dest xs :bvl$exp)],env,s1) = case evaluate (xs,env,s1) of ((Rval vs :(v list, v) result),s) => (case (find_code dest vs s.code :(v list # bvl$exp) option) of (NONE :(v list # bvl$exp) option) => ((Rerr (Rabort Rtype_error :v error_result) :(v list, v) result),s) | SOME (args,exp) => if s.clock < ticks + (1 :num) then ((Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result),s with clock := (0 :num)) else evaluate ([exp],args,dec_clock (ticks + (1 :num)) s)) | ((Rerr v8 :(v list, v) result),s) => ((Rerr v8 :(v list, v) result),s)
evaluate_clock=∀(xs :bvl$exp list) (env :v list) (s1 :(α, β) state) (vs :(v list, v) result) (s2 :(α, β) state). evaluate (xs,env,s1) = (vs,s2) ⇒ s2.clock ≤ s1.clock
fix_clock_evaluate=fix_clock (s :(α, β) state) (evaluate ((xs :bvl$exp list),(env :v list),s)) = evaluate (xs,env,s)
bvl_evaluate_length=∀(xs :bvl$exp list) (s :v list) (env :(α, β) state). case evaluate (xs,s,env) of ((Rval res :(v list, v) result),s1) => LENGTH xs = LENGTH res | ((Rerr v7 :(v list, v) result),s1) => T
bvl_evaluate_imp_length=evaluate ((xs :bvl$exp list),(s :v list),(env :(α, β) state)) = ((Rval (res :v list) :(v list, v) result),(s1 :(α, β) state)) ⇒ LENGTH xs = LENGTH res
bvl_evaluate_sing=evaluate ([(x :bvl$exp)],(env :v list),(s :(α, β) state)) = ((Rval (a :v list) :(v list, v) result),(p1 :(α, β) state)) ⇒ ∃(d1 :v). a = [d1]
bvl_evaluate_cons=evaluate ((x :bvl$exp)::(xs :bvl$exp list),(env :v list),(s :(α, β) state)) = case evaluate ([x],env,s) of ((Rval v :(v list, v) result),s2) => (case evaluate (xs,env,s2) of ((Rval vs :(v list, v) result),s1) => ((Rval (HD v::vs) :(v list, v) result),s1) | ((Rerr v8 :(v list, v) result),s1) => ((Rerr v8 :(v list, v) result),s1)) | ((Rerr v10 :(v list, v) result),s2) => ((Rerr v10 :(v list, v) result),s2)
bvl_evaluate_append=∀(xs :bvl$exp list) (env :v list) (s :(α, β) state) (ys :bvl$exp list). evaluate (xs ++ ys,env,s) = case evaluate (xs,env,s) of ((Rval vs :(v list, v) result),s2) => (case evaluate (ys,env,s2) of ((Rval ws :(v list, v) result),s1) => ((Rval (vs ++ ws) :(v list, v) result),s1) | ((Rerr v7 :(v list, v) result),s1) => ((Rerr v7 :(v list, v) result),s1)) | ((Rerr v9 :(v list, v) result),s2) => ((Rerr v9 :(v list, v) result),s2)
bvl_evaluate_snoc=∀(xs :bvl$exp list) (env :v list) (s :(α, β) state) (x :bvl$exp). evaluate (SNOC x xs,env,s) = case evaluate (xs,env,s) of ((Rval vs :(v list, v) result),s2) => (case evaluate ([x],env,s2) of ((Rval v :(v list, v) result),s1) => ((Rval (vs ++ v) :(v list, v) result),s1) | ((Rerr v8 :(v list, v) result),s1) => ((Rerr v8 :(v list, v) result),s1)) | ((Rerr v10 :(v list, v) result),s2) => ((Rerr v10 :(v list, v) result),s2)
eval_var=(Rval [(Number (7 :int) :v)] :(v list, v) result)
eval_let=(Rval [(Number (9 :int) :v)] :(v list, v) result)
eval_handle=(Rval [(Number (7 :int) :v)] :(v list, v) result)
eval_op_reverse=(Rval [Block (4 :num) [(Number (9 :int) :v); (Number (7 :int) :v)]] :(v list, v) result)
eval_tick_timeout=(Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result)
eval_call=(Rval [(Number (7 :int) :v)] :(v list, v) result)
eval_call_clock=(1 :num)
eval_force_evaluated=(Rval [(Number (7 :int) :v)] :(v list, v) result)
