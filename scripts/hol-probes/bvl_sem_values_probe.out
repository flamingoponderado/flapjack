value_array_type=:α list -> α ref
byte_array_type=:bool -> word8 list -> α ref
thunk_type=:thunk_mode -> α -> α ref
mut_block_type=:num -> bool -> α list -> α -> α list -> α ref
number_type=:int -> v
word_type=:word64 -> v
block_type=:num -> v list -> v
code_ptr_type=:num -> v
ref_ptr_type=:bool -> num -> v
bool_value=∀(b :bool). (Boolv b :v) = Block (bool_to_tag b) ([] :v list)
unit_value=Unit = Block tuple_tag ([] :v list)
value_to_list=(∀(tag :num). v_to_list (Block tag ([] :v list)) = if tag = nil_tag then SOME ([] :v list) else (NONE :v list option)) ∧ (∀(tag :num) (h :v) (bt :v). v_to_list (Block tag [h; bt]) = if tag = cons_tag then case v_to_list bt of (NONE :v list option) => (NONE :v list option) | SOME t => SOME (h::t) else (NONE :v list option)) ∧ (∀(v :int). v_to_list (Number v :v) = (NONE :v list option)) ∧ (∀(v1 :word64). v_to_list (Word64 v1 :v) = (NONE :v list option)) ∧ (∀(v2 :num) (v14 :v). v_to_list (Block v2 [v14]) = (NONE :v list option)) ∧ (∀(v23 :v list) (v22 :v) (v2 :num) (v18 :v) (v14 :v). v_to_list (Block v2 (v14::v18::v22::v23)) = (NONE :v list option)) ∧ (∀(v4 :num). v_to_list (CodePtr v4) = (NONE :v list option)) ∧ ∀(v6 :num) (v5 :bool). v_to_list (RefPtr v5 v6 :v) = (NONE :v list option)
list_to_value=list_to_v ([] :v list) = Block nil_tag ([] :v list) ∧ ∀(v :v) (vs :v list). list_to_v (v::vs) = Block cons_tag [v; list_to_v vs]
is_closure=∀(t1 :num) (l1 :α list). (isClos t1 l1 :bool) ⇔ (t1 = closure_tag ∨ t1 = partial_app_tag) ∧ l1 ≠ ([] :α list)
int_app=do_int_app (Const (n' :int)) ([] :v list) = SOME (Number n' :v) ∧ do_int_app Add [(Number (n1 :int) :v); (Number (n2 :int) :v)] = SOME (Number (n1 + n2) :v) ∧ do_int_app Sub [(Number n1 :v); (Number n2 :v)] = SOME (Number (n1 − n2) :v) ∧ do_int_app Mult [(Number n1 :v); (Number n2 :v)] = SOME (Number (n1 * n2) :v) ∧ do_int_app Div [(Number n1 :v); (Number n2 :v)] = (if n2 = (0 :int) then (NONE :v option) else SOME (Number (n1 / n2) :v)) ∧ do_int_app Mod [(Number n1 :v); (Number n2 :v)] = (if n2 = (0 :int) then (NONE :v option) else SOME (Number (n1 % n2) :v)) ∧ do_int_app Less [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 < n2) :v) ∧ do_int_app LessEq [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 ≤ n2) :v) ∧ do_int_app Greater [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 > n2) :v) ∧ do_int_app GreaterEq [(Number n1 :v); (Number n2 :v)] = SOME (Boolv (n1 ≥ n2) :v) ∧ do_int_app (LessConstSmall (n :num)) [(Number (i :int) :v)] = (if (0 :int) ≤ i ∧ i ≤ (1000000 :int) ∧ n < (1000000 :num) then SOME (Boolv (i < ((&n) :int)) :v) else (NONE :v option)) ∧ do_int_app Add ([] :v list) = (NONE :v option) ∧ do_int_app Sub ([] :v list) = (NONE :v option) ∧ do_int_app Mult ([] :v list) = (NONE :v option) ∧ do_int_app Div ([] :v list) = (NONE :v option) ∧ do_int_app Mod ([] :v list) = (NONE :v option) ∧ do_int_app Less ([] :v list) = (NONE :v option) ∧ do_int_app LessEq ([] :v list) = (NONE :v option) ∧ do_int_app Greater ([] :v list) = (NONE :v option) ∧ do_int_app GreaterEq ([] :v list) = (NONE :v option) ∧ do_int_app (LessConstSmall (v7 :num)) ([] :v list) = (NONE :v option) ∧ do_int_app (Const (v28 :int)) [(Number (v14 :int) :v)] = (NONE :v option) ∧ do_int_app Add [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Sub [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Mult [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Div [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Mod [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Less [(Number v14 :v)] = (NONE :v option) ∧ do_int_app LessEq [(Number v14 :v)] = (NONE :v option) ∧ do_int_app Greater [(Number v14 :v)] = (NONE :v option) ∧ do_int_app GreaterEq [(Number v14 :v)] = (NONE :v option) ∧ do_int_app (op :int_op) [(Word64 (v15 :word64) :v)] = (NONE :v option) ∧ do_int_app op [Block (v16 :num) (v17 :v list)] = (NONE :v option) ∧ do_int_app op [CodePtr (v18 :num)] = (NONE :v option) ∧ do_int_app op [(RefPtr (v19 :bool) (v20 :num) :v)] = (NONE :v option) ∧ do_int_app (Const (v64 :int)) [(Number (v46 :int) :v); (Number (v32 :int) :v)] = (NONE :v option) ∧ do_int_app (LessConstSmall (v65 :num)) [(Number v46 :v); (Number v32 :v)] = (NONE :v option) ∧ do_int_app op ((Number v46 :v)::(Number v32 :v)::(v60 :v)::(v61 :v list)) = (NONE :v option) ∧ do_int_app op ((Word64 (v47 :word64) :v)::(Number v32 :v)::(v11 :v list)) = (NONE :v option) ∧ do_int_app op (Block (v48 :num) (v49 :v list)::(Number v32 :v)::v11) = (NONE :v option) ∧ do_int_app op (CodePtr (v50 :num)::(Number v32 :v)::v11) = (NONE :v option) ∧ do_int_app op ((RefPtr (v51 :bool) (v52 :num) :v)::(Number v32 :v)::v11) = (NONE :v option) ∧ do_int_app op ((v2 :v)::(Word64 (v33 :word64) :v)::v11) = (NONE :v option) ∧ do_int_app op (v2::Block (v34 :num) (v35 :v list)::v11) = (NONE :v option) ∧ do_int_app op (v2::CodePtr (v36 :num)::v11) = (NONE :v option) ∧ do_int_app op (v2::(RefPtr (v37 :bool) (v38 :num) :v)::v11) = (NONE :v option)
add_args=add_args (Closure (loc_opt :num option) (args :closSem$v list) (env :closSem$v list) (num_args :num) (exp :closLang$exp) :closSem$v) (args' :closSem$v list) = SOME (Closure loc_opt (args' ++ args) env num_args exp :closSem$v) ∧ add_args (Recclosure loc_opt args env (funs :(num # closLang$exp) list) (i :num) :closSem$v) args' = SOME (Recclosure loc_opt (args' ++ args) env funs i :closSem$v) ∧ add_args (Number (v3 :int) :closSem$v) (v1 :closSem$v list) = (NONE :closSem$v option) ∧ add_args (Word64 (v4 :word64) :closSem$v) v1 = (NONE :closSem$v option) ∧ add_args (Block (v5 :num) (v6 :closSem$v list)) v1 = (NONE :closSem$v option) ∧ add_args (ByteVector (v7 :word8 list)) v1 = (NONE :closSem$v option) ∧ add_args (RefPtr (v8 :bool) (v9 :num) :closSem$v) v1 = (NONE :closSem$v option)
get_num_args=get_num_args (Closure (loc_opt :num option) (args :closSem$v list) (env :closSem$v list) (num_args :num) (exp :closLang$exp) :closSem$v) = SOME num_args ∧ get_num_args (Recclosure loc_opt args env (funs :(num # closLang$exp) list) (i :num) :closSem$v) = SOME (FST funs❲i❳) ∧ get_num_args (Number (v :int) :closSem$v) = (NONE :num option) ∧ get_num_args (Word64 (v1 :word64) :closSem$v) = (NONE :num option) ∧ get_num_args (Block (v2 :num) (v3 :closSem$v list)) = (NONE :num option) ∧ get_num_args (ByteVector (v4 :word8 list)) = (NONE :num option) ∧ get_num_args (RefPtr (v5 :bool) (v6 :num) :closSem$v) = (NONE :num option)
int_app_type=:int_op -> v list -> v option
negative_div=SOME (Number (-(4 :int)) :v)
negative_mod=SOME (Number (2 :int) :v)
negative_divisor_div=SOME (Number (-(4 :int)) :v)
negative_divisor_mod=SOME (Number (-(2 :int)) :v)
zero_div=(NONE :v option)
list_roundtrip=SOME [(Number (1 :int) :v); (Number (2 :int) :v)]
bad_list=(NONE :v list option)
