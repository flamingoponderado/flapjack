do_app_const=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((res :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ s2.clock = s1.clock ∧ (op ≠ Install ⇒ s2.code = s1.code ∧ s2.compile = s1.compile ∧ s2.compile_oracle = s1.compile_oracle)
bvl_do_app_err=(do_app (op :closLang$op) (vs :v list) (s :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ⇒ e = (Rabort Rtype_error :v error_result) ∨ ∃(i :mlstring) (x :final_event). op = (FFI i :closLang$op) ∧ e = (Rabort (Rffi_error x) :v error_result)
bvl_do_app_change_clock=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((res :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ (do_app op args (s1 with clock := (ck :num)) :(v # (α, β) state, v) result) = (Rval (res,s2 with clock := ck) :(v # (α, β) state, v) result)
bvl_do_app_change_clock_err=(do_app (op :closLang$op) (args :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rerr (e :v error_result) :(v # (α, β) state, v) result) ⇒ (do_app op args (s1 with clock := (ck :num)) :(v # (α, β) state, v) result) = (Rerr e :(v # (α, β) state, v) result)
bvl_do_app_io_events_mono=(do_app (op :closLang$op) (vs :v list) (s1 :(α, β) state) :(v # (α, β) state, v) result) = (Rval ((x :v),(s2 :(α, β) state)) :(v # (α, β) state, v) result) ⇒ s1.ffi.io_events ≼ s2.ffi.io_events
bvl_inc_clock=∀(ck :num) (s :(α, β) state). inc_clock ck s = s with clock := s.clock + ck
bvl_evaluate_add_clock=∀(exps :bvl$exp list) (env :v list) (s1 :(α, β) state) (res :(v list, v) result) (s2 :(α, β) state). evaluate (exps,env,s1) = (res,s2) ∧ res ≠ (Rerr (Rabort Rtimeout_error :v error_result) :(v list, v) result) ⇒ ∀(ck :num). evaluate (exps,env,inc_clock ck s1) = (res,inc_clock ck s2)
bvl_find_code_every=(find_code (dest :num option) (a :v list) (r :(γ, 'ffi) state).code :(v list # bvl$exp) option) = SOME ((q :v list),(t :bvl$exp)) ⇒ EVERY (P :v -> bool) a ⇒ EVERY P q
do_app_type=:closLang$op -> v list -> (α, β) state -> (v # (α, β) state, v) result
copy_array=∀(src :α list) (srcoff :int) (len :int) (d :(α list # int) option). copy_array (src,srcoff) len d = if srcoff < (0 :int) ∨ len < (0 :int) ∨ LENGTH src < Num (ABS (I (srcoff + len))) then (NONE :α list option) else (let (copied :α list) = TAKE (Num (ABS (I len))) (DROP (Num (ABS (I srcoff))) src) in case d of (NONE :(α list # int) option) => SOME copied | SOME (dst,dstoff) => if dstoff < (0 :int) ∨ LENGTH dst < Num (ABS (I (dstoff + len))) then (NONE :α list option) else SOME (TAKE (Num (ABS (I dstoff))) dst ++ copied ++ DROP (Num (ABS (I (dstoff + len)))) dst))
copy_array_type=:α list # int -> int -> (α list # int) option -> α list option
xor_bytes=(∀(bs2 :word8 list). xor_bytes ([] :word8 list) bs2 = SOME bs2) ∧ (∀(v3 :word8 list) (v2 :word8). xor_bytes (v2::v3) ([] :word8 list) = (NONE :word8 list option)) ∧ ∀(bs2 :word8 list) (bs1 :word8 list) (b2 :word8) (b1 :word8). xor_bytes (b1::bs1) (b2::bs2) = case xor_bytes bs1 bs2 of (NONE :word8 list option) => (NONE :word8 list option) | SOME rest => SOME ((b1 ⊕ b2)::rest)
xor_bytes_type=:word8 list -> word8 list -> word8 list option
str_cmp=(str_cmp F Lt (i :mlstring) (j :mlstring) ⇔ i < j) ∧ (str_cmp F Leq i j ⇔ i ≤ j) ∧ (str_cmp F Gt i j ⇔ i > j) ∧ (str_cmp F Geq i j ⇔ i ≥ j) ∧ (str_cmp T Lt i j ⇔ fast_lt i j) ∧ (str_cmp T Leq i j ⇔ fast_le i j) ∧ (str_cmp T Gt i j ⇔ fast_gt i j) ∧ (str_cmp T Geq i j ⇔ fast_ge i j)
str_cmp_type=:bool -> opb -> mlstring -> mlstring -> bool
mlstring_compare_aux=∀(start :num) (s2 :mlstring) (s1 :mlstring) (ord :ordering) (len :num). compare_aux s1 s2 ord start len = if len = (0 :num) then ord else if char_lt (strsub s2 start) (strsub s1 start) then Greater else if char_lt (strsub s1 start) (strsub s2 start) then Less else compare_aux s1 s2 ord (start + (1 :num)) (len − (1 :num))
mlstring_compare=∀(s1 :mlstring) (s2 :mlstring). compare s1 s2 = if strlen s1 < strlen s2 then compare_aux s1 s2 Less (0 :num) (strlen s1) else if strlen s2 < strlen s1 then compare_aux s1 s2 Greater (0 :num) (strlen s2) else compare_aux s1 s2 Equal (0 :num) (strlen s2)
mlstring_fast_lt=∀(s1 :mlstring) (s2 :mlstring). fast_lt s1 s2 ⇔ if strlen s1 = strlen s2 then s1 < s2 else strlen s1 < strlen s2
mlstring_fast_le=∀(s1 :mlstring) (s2 :mlstring). fast_le s1 s2 ⇔ if strlen s1 = strlen s2 then s1 ≤ s2 else strlen s1 ≤ strlen s2
mlstring_fast_gt=∀(s1 :mlstring) (s2 :mlstring). fast_gt s1 s2 ⇔ if strlen s1 = strlen s2 then s1 > s2 else strlen s1 > strlen s2
mlstring_fast_ge=∀(s1 :mlstring) (s2 :mlstring). fast_ge s1 s2 ⇔ if strlen s1 = strlen s2 then s1 ≥ s2 else strlen s1 ≥ strlen s2
copy_array_inplace=SOME [(9 :num); (2 :num); (3 :num); (9 :num)]
copy_array_bounds=(NONE :num list option)
xor_bytes_prefix=SOME [(3w :word8) ⊕ (5w :word8); (7w :word8)]
xor_bytes_short=(NONE :word8 list option)
str_cmp_fast=T
str_cmp_lex=F
v_to_bytes=∀(lv :v). v_to_bytes lv = some(ns :word8 list). v_to_list lv = SOME (MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns)
v_to_words=∀(lv :v). v_to_words lv = some(ns :word64 list). v_to_list lv = SOME (MAP Word64 ns)
v_to_bytes_type=:v -> word8 list option
v_to_words_type=:v -> word64 list option
do_install=∀(vs :v list) (s :(γ, 'ffi) state). (do_install vs s :(v # (γ, 'ffi) state, α) result) = case vs of ([] :v list) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | [v1] => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | [v1; v2] => (case (v_to_bytes v1,v_to_words v2) of ((NONE :word8 list option),v5) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | (SOME bytes,(NONE :word64 list option)) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | (SOME bytes,SOME data) => (let ((cfg :γ),(progs :(num # num # bvl$exp) list)) = (s.compile_oracle (0 :num) :γ # (num # num # bvl$exp) list); (new_oracle :num -> γ # (num # num # bvl$exp) list) = shift_seq (1 :num) s.compile_oracle in if DISJOINT (domain s.code :num -> bool) (set (MAP (FST :num # num # bvl$exp -> num) progs)) ∧ ALL_DISTINCT (MAP (FST :num # num # bvl$exp -> num) progs) then case (s.compile cfg progs,progs) of (v2,([] :(num # num # bvl$exp) list)) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | ((NONE :(word8 list # word64 list # γ) option),v6::v7) => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) | (SOME (bytes',data',cfg'),(k,prog)::v7) => if bytes = bytes' ∧ data = data' ∧ FST (new_oracle (0 :num)) = cfg' then (let (s' :(γ, 'ffi) state) = s with <|code := union s.code (fromAList progs); compile_oracle := new_oracle|> in (Rval (CodePtr k,s') :(v # (γ, 'ffi) state, α) result)) else (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result) else (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result))) | v1::v2::v19::v20 => (Rerr (Rabort Rtype_error :α error_result) :(v # (γ, 'ffi) state, α) result)
do_install_type=:v list -> (α, β) state -> (v # (α, β) state, γ) result
install_words=some(ns :word64 list). [(Word64 (1w :word64) :v); (Word64 (2w :word64) :v)] = MAP Word64 ns
install_bytes=some(ns :word8 list). [(Number (1 :int) :v); (Number (255 :int) :v)] = MAP (Number ∘ $& ∘ (w2n :word8 -> num)) ns
install_bad_arity=(Rerr (Rabort Rtype_error :α error_result) :(v # (unit, unit) state, α) result)
