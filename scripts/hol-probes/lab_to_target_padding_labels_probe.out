pad_section_labels=∀(nop :word8 list) (lines :α line list) (aux :α line list) (pos :num)
    (labs :(num # num) list).
  lab_len_pos_ok (pos + (SUM (MAP (line_len :α line -> num) aux) :num)) lines ∧
  lab_len_pos_ok pos (REVERSE aux) ∧ EVERY (label_zero :α line -> bool) aux ∧
  (¬NULL lines ∧ is_Label (HD lines) ∧ line_len (HD lines) = (1 :num) ⇒
   ¬NULL aux ∧ ¬is_Label (HD aux)) ⇒
  section_labels pos (pad_section nop lines aux) labs =
  section_labels pos (REVERSE aux ++ lines) labs
pad_section_labels_types=(nop :word8 list)::word8 list;(lines :α line list)::α line list;(aux :α line list)::α line list;(pos :num)::num;(labs :(num # num) list)::(num # num) list;
pad_section_labels_hypotheses=0
empty_arbitrary_acc=T
even_zero_label=T
odd_asm_empty_nop=T
odd_labasm_wide_nop=T
successive_boundaries=T
