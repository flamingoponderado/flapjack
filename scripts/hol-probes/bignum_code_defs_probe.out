mc_sub_loop2_corr_thm=Corr mc_sub_loop2_code s (INR ((λ(l,r1,r3,r8,r9,r10,xs,zs). delete_vars [] (clock_write l (reg_write 1 (SOME r1) (reg_write 3 (SOME r3) (reg_write 8 (SOME r8) (reg_write 9 (SOME r9) (reg_write 10 (SOME r10) (array_write In1 xs (array_write Out zs s))))))))) (mc_sub_loop2 (s.clock − 1,s.regs⟨1⟩,s.regs⟨3⟩,s.regs⟨8⟩,s.regs⟨9⟩,s.regs⟨10⟩,s.arrays In1,s.arrays Out)))) ((1 ∈ FDOM s.regs ∧ 3 ∈ FDOM s.regs ∧ 8 ∈ FDOM s.regs ∧ 9 ∈ FDOM s.regs ∧ 10 ∈ FDOM s.regs ∧ mc_sub_loop2_pre (s.clock − 1,s.regs⟨1⟩,s.regs⟨3⟩,s.regs⟨8⟩,s.regs⟨9⟩,s.regs⟨10⟩,s.arrays In1,s.arrays Out)) ∧ s.clock ≠ 0)
mc_sub_loop_corr_thm=Corr mc_sub_loop_code s (INR ((λ(l,r1,r2,r8,r9,r10,xs,ys,zs). delete_vars [3] (clock_write l (reg_write 1 (SOME r1) (reg_write 2 (SOME r2) (reg_write 8 (SOME r8) (reg_write 9 (SOME r9) (reg_write 10 (SOME r10) (array_write In1 xs (array_write In2 ys (array_write Out zs s)))))))))) (mc_sub_loop (s.clock,s.regs⟨1⟩,s.regs⟨2⟩,s.regs⟨8⟩,s.regs⟨9⟩,s.regs⟨10⟩,s.arrays In1,s.arrays In2,s.arrays Out)))) (1 ∈ FDOM s.regs ∧ 2 ∈ FDOM s.regs ∧ 8 ∈ FDOM s.regs ∧ 9 ∈ FDOM s.regs ∧ 10 ∈ FDOM s.regs ∧ mc_sub_loop_pre (s.clock,s.regs⟨1⟩,s.regs⟨2⟩,s.regs⟨8⟩,s.regs⟨9⟩,s.regs⟨10⟩,s.arrays In1,s.arrays In2,s.arrays Out))
mc_top_two_corr_thm=Corr mc_top_two_code s (INR ((λ(l,r0,r1,r8,r9,r11,ys). delete_vars [2; 4; 3] (clock_write l (reg_write 0 (SOME r0) (reg_write 1 (SOME r1) (reg_write 8 (SOME r8) (reg_write 9 (SOME r9) (reg_write 11 (SOME r11) (array_write In2 ys s)))))))) (mc_top_two (s.clock − 1,s.regs⟨0⟩,s.regs⟨1⟩,s.regs⟨3⟩,s.regs⟨8⟩,s.regs⟨9⟩,s.regs⟨11⟩,s.arrays In2)))) ((0 ∈ FDOM s.regs ∧ 1 ∈ FDOM s.regs ∧ 3 ∈ FDOM s.regs ∧ 8 ∈ FDOM s.regs ∧ 9 ∈ FDOM s.regs ∧ 11 ∈ FDOM s.regs ∧ mc_top_two_pre (s.clock − 1,s.regs⟨0⟩,s.regs⟨1⟩,s.regs⟨3⟩,s.regs⟨8⟩,s.regs⟨9⟩,s.regs⟨11⟩,s.arrays In2)) ∧ s.clock ≠ 0)
