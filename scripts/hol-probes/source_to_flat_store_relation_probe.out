store_relation_rules=(∀(genv :global_env) (v :semanticPrimitives$v) (v' :v). (v_rel genv v v' :bool) ⇒ sv_rel genv (Refv v) (Refv v')) ∧ (∀(genv :global_env) (w :word8 list). sv_rel genv (W8array w :semanticPrimitives$v store_v) (W8array w :v store_v)) ∧ (∀(genv :global_env) (vs :semanticPrimitives$v list) (vs' :v list). LIST_REL (v_rel genv :semanticPrimitives$v -> v -> bool) vs vs' ⇒ sv_rel genv (Varray vs) (Varray vs')) ∧ ∀(genv :global_env) (m :thunk_mode) (v :semanticPrimitives$v) (v' :v). (v_rel genv v v' :bool) ⇒ sv_rel genv (Thunk m v) (Thunk m v')
store_relation_cases=∀(a0 :global_env) (a1 :semanticPrimitives$v store_v) (a2 :v store_v). sv_rel a0 a1 a2 ⇔ (∃(v :semanticPrimitives$v) (v' :v). a1 = Refv v ∧ a2 = Refv v' ∧ (v_rel a0 v v' :bool)) ∨ (∃(w :word8 list). a1 = (W8array w :semanticPrimitives$v store_v) ∧ a2 = (W8array w :v store_v)) ∨ (∃(vs :semanticPrimitives$v list) (vs' :v list). a1 = Varray vs ∧ a2 = Varray vs' ∧ LIST_REL (v_rel a0 :semanticPrimitives$v -> v -> bool) vs vs') ∨ ∃(m :thunk_mode) (v :semanticPrimitives$v) (v' :v). a1 = Thunk m v ∧ a2 = Thunk m v' ∧ (v_rel a0 v v' :bool)
state_relation_rule=∀(genv :global_env) (s :α semanticPrimitives$state) (s' :(β, α) flatSem$state). ¬NULL s'.refs ∧ LIST_REL (sv_rel genv :semanticPrimitives$v store_v -> v store_v -> bool) s.refs (TL s'.refs) ∧ s.clock = s'.clock ∧ s.ffi = s'.ffi ⇒ s_rel genv s s'
state_relation_cases=∀(a0 :global_env) (a1 :α semanticPrimitives$state) (a2 :(β, α) flatSem$state). s_rel a0 a1 a2 ⇔ ¬NULL a2.refs ∧ LIST_REL (sv_rel a0 :semanticPrimitives$v store_v -> v store_v -> bool) a1.refs (TL a2.refs) ∧ a1.clock = a2.clock ∧ a1.ffi = a2.ffi
