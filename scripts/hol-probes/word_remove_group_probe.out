word_remove_correct_statement=∀prog st res rst. evaluate (prog,st) = (res,rst) ∧ st.compile = (λcfg. c cfg ∘ MAP (I ## I ## remove_must_terminate)) ∧ res ≠ SOME Error ⇒ ∃clk. evaluate (remove_must_terminate prog,compile_state clk c st) = (res,compile_state 0 c rst)
word_remove_correct_hypotheses=0
word_remove_correct_typed=∀(prog :α prog) (st :(α, β, γ) state) (res :α result option) (rst :(α, β, γ) state). evaluate (prog,st) = (res,rst) ∧ st.compile = (λ(cfg :β). (c :β -> (num # num # α prog) list -> (word8 list # α word list # β) option) cfg ∘ MAP ((I :num -> num) ## (I :num -> num) ## (remove_must_terminate :α prog -> α prog))) ∧ res ≠ SOME (Error :α result) ⇒ ∃(clk :num). evaluate (remove_must_terminate prog,compile_state clk c st) = (res,compile_state (0 :num) c rst)
sptree_domain_map_statement=∀s. domain (map f s) = domain s
sptree_domain_map_hypotheses=0
sptree_map_insert_statement=∀f x y z. map f (insert x y z) = insert x (f y) (map f z)
sptree_map_insert_hypotheses=0
sptree_map_fromAList_statement=map f (fromAList ls) = fromAList (MAP (λ(k,v). (k,f v)) ls)
sptree_map_fromAList_hypotheses=0
sptree_map_union_statement=∀t1 t2. map f (union t1 t2) = union (map f t1) (map f t2)
sptree_map_union_hypotheses=0
