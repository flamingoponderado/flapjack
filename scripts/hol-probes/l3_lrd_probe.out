lrd_definition=∀aq rl rd rs1. dfn'LR_D (aq,rl,rd,rs1) = (λstate. (let (v,s) = in32BitMode () state in if v then signalException Illegal_Instr s else (let v = GPR rs1 s in if (2 >< 0) v ≠ 0w then signalAddressException (AMO_Misaligned,v) s else (let (v0,s) = translateAddr (v,Data,Read) s in case v0 of NONE => signalAddressException (Load_Fault,v) s | SOME pAddr => write'ReserveLoad (SOME v) (write'GPR (rawReadData pAddr s,rd) s)))))
