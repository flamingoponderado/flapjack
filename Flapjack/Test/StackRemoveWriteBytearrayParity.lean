import Flapjack.Compiler.Backend.StackRemove.Proofs.WriteBytearray

namespace Flapjack.Test.StackRemoveWriteBytearrayParity
open Flapjack

private def encode {width : Nat} [NeZero width] : WordLocW width → Nat × (Nat × Nat)
  | .word word => (0,word.toNat,0)
  | .loc first second => (1,first,second)

private def observe {width : Nat} [NeZero width]
    (address : BitVec width) (bytes : List (BitVec 8))
    (source memory : BitVec width → WordLocW width)
    (sourceDomain domain : BitVec width → Bool) (be : Bool) :
    Option (List Nat) × List ((Nat × (Nat × Nat)) × (Nat × (Nat × Nat))) :=
  ((readBytearrayWordHOL address bytes.length
      (memLoadByteAuxExact source sourceDomain be)).map (List.map BitVec.toNat),
    ([0,1,7,8,9,16,1180591620717411303427] : List (BitVec width)).map fun point =>
      (encode (writeBytearrayExact address bytes source sourceDomain be point),
       encode (writeBytearrayExact address bytes memory domain be point)))

