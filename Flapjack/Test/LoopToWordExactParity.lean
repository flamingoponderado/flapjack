/-- Probe live set `insert 3 () (insert 5 () LN)` over `unit spt`. -/
def probeLive : Spt Unit := sptInsert 3 () (sptInsert 5 () .ln)

def originalFindHit : Nat := 9
def originalFindMiss : Nat := 0
def originalFindImm : WordRegImm (BitVec 64) := .imm 5
def originalFindReg : WordRegImm (BitVec 64) := .reg 9
def originalToNumSetZero : Option Unit := none
def originalToNumSetTwo : Option Unit := some ()
def originalToNumSetThree : Option Unit := some ()
def originalFromNumSet : List Nat := [3, 1]
def originalCutsetZero : Option Unit := some ()
def originalCutsetFive : Option Unit := none
def originalCutsetAbsent : Option Unit := none

#guard findVarHOL probeContext 5 == originalFindHit
#guard findVarHOL probeContext 4 == originalFindMiss
#guard findRegImmHOL (width := 64) probeContext (.imm (5 : BitVec 64)) == originalFindImm
#guard findRegImmHOL (width := 64) probeContext (.reg 5) == originalFindReg
#guard (sptLookup 0 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetZero
#guard (sptLookup 2 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetTwo
#guard (sptLookup 3 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetThree
