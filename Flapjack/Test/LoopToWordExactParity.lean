example : localsRelHOL (width := 64) localsRelProbeContext
    (LoopSemStateFiniteExact.sptAlistInsert [0] [.word 9] localsRelProbeSource)
    (LoopSemStateFiniteExact.sptAlistInsert [4] [.word 9] localsRelProbeTarget) := by
