import Flapjack.Pancake.LoopToWord

/-!
# Original-domain parity for the exact `loop_to_word` context definitions

The original definitions are `find_var_def`, `find_reg_imm_def`,
`toNumSet_def`, `fromNumSet_def`, and `mk_new_cutset_def` at
`cakeml/pancake/loop_to_wordScript.sml:10-53`. The expected observations are
direct HOL-EVAL results from
`scripts/hol-probes/loop_to_word_defs_probeScript.sml`, checked in at
`scripts/hol-probes/loop_to_word_defs_probe.out` and regenerated by
`scripts/hol-probes/regenerate.sh`.
-/

namespace Flapjack.Test.LoopToWordExactParity

open Flapjack Flapjack.LoopToWord

/-- Probe context `insert 3 7 (insert 5 9 LN)` over `num |-> num` spt. -/
def probeContext : Spt Nat := sptInsert 3 7 (sptInsert 5 9 .ln)

/-- Probe live set `insert 3 () (insert 5 () LN)` over `unit spt`. -/
def probeLive : Spt Unit := sptInsert 3 () (sptInsert 5 () .ln)

def originalFindHit : Nat := 9
def originalFindMiss : Nat := 0
def originalFindImm : WordRegImm (BitVec 64) := .imm 5
def originalFindReg : WordRegImm (BitVec 64) := .reg 9
def originalToNumSetZero : Option Unit := none
def originalToNumSetTwo : Option Unit := some ()
def originalToNumSetThree : Option Unit := some ()
def originalFromNumSet : List Nat := [3, 1]
def originalCutsetZero : Option Unit := some ()
def originalCutsetFive : Option Unit := none
def originalCutsetAbsent : Option Unit := none

#guard findVarHOL probeContext 5 == originalFindHit
#guard findVarHOL probeContext 4 == originalFindMiss
#guard findRegImmHOL (width := 64) probeContext (.imm (5 : BitVec 64)) == originalFindImm
#guard findRegImmHOL (width := 64) probeContext (.reg 5) == originalFindReg
#guard (sptLookup 0 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetZero
#guard (sptLookup 2 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetTwo
#guard (sptLookup 3 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetThree
#guard fromNumSetHOL (sptInsert 3 () (sptInsert 1 () (.ln : Spt Unit))) ==
  originalFromNumSet
#guard (sptLookup 0 (mkNewCutsetHOL probeContext probeLive) : Option Unit) ==
  originalCutsetZero
#guard (sptLookup 5 (mkNewCutsetHOL probeContext probeLive) : Option Unit) ==
  originalCutsetFive
#guard (sptLookup 2 (mkNewCutsetHOL probeContext probeLive) : Option Unit) ==
  originalCutsetAbsent

def runChecks : IO Bool := do
  let checks :=
    [ ("LoopToWord find_var hit returns the stored register",
        findVarHOL probeContext 5 == originalFindHit),
      ("LoopToWord find_var miss returns 0",
        findVarHOL probeContext 4 == originalFindMiss),
      ("LoopToWord find_reg_imm leaves an immediate unchanged",
        findRegImmHOL (width := 64) probeContext (.imm (5 : BitVec 64)) == originalFindImm),
      ("LoopToWord find_reg_imm maps a register through find_var",
        findRegImmHOL (width := 64) probeContext (.reg 5) == originalFindReg),
      ("LoopToWord toNumSet does not contain 0",
        (sptLookup 0 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetZero),
      ("LoopToWord toNumSet contains 2",
        (sptLookup 2 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetTwo),
      ("LoopToWord toNumSet contains 3",
        (sptLookup 3 (toNumSetHOL [1, 2, 3]) : Option Unit) == originalToNumSetThree),
      ("LoopToWord fromNumSet enumerates the tree in spt order",
        fromNumSetHOL (sptInsert 3 () (sptInsert 1 () (.ln : Spt Unit))) ==
          originalFromNumSet),
      ("LoopToWord mk_new_cutset always contains 0",
        (sptLookup 0 (mkNewCutsetHOL probeContext probeLive) : Option Unit) ==
          originalCutsetZero),
      ("LoopToWord mk_new_cutset maps 5 to 9 so 5 is absent",
        (sptLookup 5 (mkNewCutsetHOL probeContext probeLive) : Option Unit) ==
          originalCutsetFive),
      ("LoopToWord mk_new_cutset leaves an unmapped key absent",
        (sptLookup 2 (mkNewCutsetHOL probeContext probeLive) : Option Unit) ==
          originalCutsetAbsent) ]
  let results ← checks.mapM fun (name, ok) => do
    if ok then
      IO.println s!"PASS {name}"
      pure true
    else
      IO.println s!"FAIL {name}"
      pure false
  pure (results.all id)

end Flapjack.Test.LoopToWordExactParity
