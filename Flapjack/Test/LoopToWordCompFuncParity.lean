import Flapjack.Pancake.LoopToWord.CompFuncExact

/-!
# Original HOL parity for the exact `loop_to_word$comp_func` / `compile_prog` / `compile`

The original definitions are `comp_func_def`, `compile_prog_def`, and
`compile_def` at `cakeml/pancake/loop_to_wordScript.sml:164-177`. The expected
observations are the direct HOL-EVAL results from
`scripts/hol-probes/loop_to_word_comp_func_probeScript.sml`, checked in at
`scripts/hol-probes/loop_to_word_comp_func_probe.out` and regenerated by
`scripts/hol-probes/regenerate.sh`.

Unlike the `comp` probe, this exercises the whole per-function compiler: the
extra temporaries from `difference (acc_vars body LN) (toNumSet params)`, the
dense context from `make_ctxt 2 (params ++ vs) LN`, and the per-entry
`LENGTH params + 1` of `compile_prog`. The rows are replayed here through the
tagged exact `loopToWordCompFuncHOL` / `loopToWordCompileProgHOL` /
`loopToWordCompileHOL` over the exact `HolLoopProg` and `WordLangProgHOL`
carriers, using the same program and parameter inputs as the probe.

The `comp_func` temporaries are pinned by a kernel `decide +kernel` computation
of the concrete `difference (acc_vars body LN) (toNumSet params)` list, so the
`comp` body itself is reduced over a literal context (no `sptDifference`
unfolding inside `simp`).
-/

namespace Flapjack.Test.LoopToWordCompFuncParity

open Flapjack Flapjack.LoopToWord

/-- `comp_func 3 [4;5] Skip`: no new temporaries, no emitted code. -/
theorem compFuncSkip :
    loopToWordCompFuncHOL (width := 8) 3 [4, 5] (.skip : HolLoopProg 8) =
      .skip := by
  simp [loopToWordCompFuncHOL, accVarsHOL, sptDifference, fromNumSetHOL,
    toNumSetHOL, makeCtxtHOL, Flapjack.LoopToWord.compHOL.eq_def]

/-- `comp_func 6 [7] (Assign 7 (Var 7))`: the assigned key is already a
parameter, so the dense context maps `7` to register `2`. -/
theorem compFuncParamAssign :
    loopToWordCompFuncHOL (width := 8) 6 [7]
      (.assign 7 (.var 7) : HolLoopProg 8) =
        .assign 2 (.var 2) := by
  simp [loopToWordCompFuncHOL, accVarsHOL, sptDifference, sptMkBN,
    fromNumSetHOL, toNumSetHOL, makeCtxtHOL, Flapjack.LoopToWord.compHOL.eq_def,
    compExpHOL, findVarHOL, sptInsert, sptLookup, sptFoldi, sptToAList]

/-- `comp_func 20 [] (Assign 9 (Var 9))`: `acc_vars` introduces the fresh
temporary `9`, which `make_ctxt 2 [9] LN` maps to register `2`. -/
theorem compFuncNewTemp :
    loopToWordCompFuncHOL (width := 8) 20 []
      (.assign 9 (.var 9) : HolLoopProg 8) =
        .assign 2 (.var 2) := by
  have hvs : fromNumSetHOL
      (sptDifference (accVarsHOL (.assign 9 (.var 9) : HolLoopProg 8)
        (.ln : Spt Unit)) (toNumSetHOL ([] : List Nat))) = [9] := by
    decide +kernel
  simp only [loopToWordCompFuncHOL]
  rw [hvs]
  simp [makeCtxtHOL, Flapjack.LoopToWord.compHOL.eq_def, compExpHOL, findVarHOL,
    sptInsert, sptLookup]

/-- The compiled code list of the probe. -/
def probeCode : List (Nat × List Nat × HolLoopProg 8) :=
  [(3, [4, 5], .skip), (6, [7], .assign 7 (.var 7)), (20, [], .assign 9 (.var 9))]

/-- `compile_prog` maps each entry to `(name, LENGTH params + 1, comp_func ...)`. -/
theorem compileProgCode :
    loopToWordCompileProgHOL (width := 8) probeCode =
      [(3, 3, .skip), (6, 2, .assign 2 (.var 2)), (20, 1, .assign 2 (.var 2))] := by
  simp [loopToWordCompileProgHOL, probeCode, compFuncSkip, compFuncParamAssign,
    compFuncNewTemp]

/-- `compile p = compile_prog p`. -/
theorem compileCode :
    loopToWordCompileHOL (width := 8) probeCode =
      [(3, 3, .skip), (6, 2, .assign 2 (.var 2)), (20, 1, .assign 2 (.var 2))] := by
  simp [loopToWordCompileHOL, compileProgCode]

def runChecks : IO Bool := do
  IO.println "PASS LoopToWord exact comp_func/compile_prog/compile HOL EVAL rows (5 rows)"
  pure true

end Flapjack.Test.LoopToWordCompFuncParity
