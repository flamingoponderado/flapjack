import Flapjack.Compiler.Backend.Semantics.WordSem.Inst

/-!
Direct HOL oracle rows for wordSem `inst_def`
(`scripts/hol-probes/word_sem_inst_probe.out`, generated by
`word_sem_inst_probeScript.sml` from
`cakeml/compiler/backend/semantics/wordSemScript.sml:716-939`).  The HOL probe
updates fields of a free state `s`; the Lean rows update the same fields of
a concrete base state `s0`.  Each row is a kernel-checked theorem about the
noncomputable `inst`.  It is proved by unfolding `inst`, rewriting the
binary64 operations through their proven computable `roundTiesToEven`
equivalences, and evaluating in the kernel.  HOL prints some results as
unreduced `n2w` literals (for example `0x10000000000000000w`, which is `0w` at
64 bits); the rows keep them verbatim as `BitVec.ofNat 64`.
-/

namespace Flapjack.Test.WordSemInstParity

open Flapjack
