    (13, .word 0x8000000000000000), (14, .word 0x8000000000000000), (15, .word 4),
    (20, .word 1), (21, .word 0), (22, .word 3), (23, .word 5),
    (30, .word 16), (31, .word 0xAB), (32, .loc 1 2)]
  localsSize := none
  fpRegs := HolFiniteMapExact.empty
  store := HolFiniteMapExact.empty
  stack := []
  stackLimit := 0
  stackMax := none
  stackSize := .ln
  memory := fun a => if a = 16 then .word 0x1122334455667788 else .loc 0 0
  mdomain := fun a => decide (a = 16)
  shMdomain := fun _ => false
  permute := fun _ i => i
  compile := fun _ _ => none
  compileOracle := fun _ => ((), [])
  codeBuffer := { position := 0, buffer := [], spaceLeft := 0 }
  dataBuffer := { position := 0, buffer := [], spaceLeft := 0 }
  gcFun := fun _ => none
  handler := 0
  clock := 0
  termdep := 0
  code := .ln
  be := false
  ffi := { oracle := fun _ state _ _ => .ret state [], ffiState := (), ioEvents := [] }

