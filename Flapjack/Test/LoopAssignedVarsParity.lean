module

public import Flapjack.Pancake.LoopLive

-- Checks below run compiled code from these modules.
public meta import Flapjack.Pancake.LoopLive
@[expose] public section

/-!
# Original-domain parity for `assigned_vars`

`loopAssignedVars` is the Lean counterpart of
`cakeml/pancake/loopLangScript.sml:94-115`.  Expected observations are from
the checked-in HOL probe output generated by
`loop_lang_assigned_vars_probeScript.sml`.
-/

namespace Flapjack.Test.LoopAssignedVarsParity

open Flapjack

def originalSkip : List Nat := []
def originalAssign : List Nat := [7]
def originalSequence : List Nat := [7, 8]
def originalLongDiv : List Nat := [1, 2]
def originalLoadByte : List Nat := [9]

def probeSkip : LoopProg Nat := .skip
def probeAssign : LoopProg Nat := .assign 7 (.const 1)
def probeSequence : LoopProg Nat :=
  .seq (.assign 7 (.const 1)) (.load32 0 8)
def probeLongDiv : LoopProg Nat := .arith (.longDiv 1 2 3 4 5)
def probeLoadByte : LoopProg Nat := .loadByte 4 9

#guard loopAssignedVars probeSkip == originalSkip
#guard loopAssignedVars probeAssign == originalAssign
#guard loopAssignedVars probeSequence == originalSequence
#guard loopAssignedVars probeLongDiv == originalLongDiv
#guard loopAssignedVars probeLoadByte == originalLoadByte

/-! Cake `crep_to_loopProofScript.sml:355` `assigned_vars_MAPi_Assign` with
    HOL's `MAPi (λn. Assign (n + offset))` rendered by `List.mapIdx`.  Expected
    observations are the `avma_*` rows of
    `scripts/hol-probes/crep_to_loop_assigned_vars_mapidx_probe.out`. -/

def probeMapIdxAssign : LoopProg (BitVec 64) :=
  loopNestedSeq
    (([.const 0, .const 1, .const 2] : List (LoopExp (BitVec 64))).mapIdx
      (fun n e => .assign (n + 7) e))

def checkBool (name : String) (value : Bool) : IO Bool := do
  if value then
    IO.println s!"PASS {name}"
    pure true
  else
    IO.println s!"FAIL {name}"
    pure false

def survivesAppendGuard : Bool :=
  (([.assign 3 (.const 0)] : List (LoopProg Nat)) ++
    ([.assign 4 (.const 1)] : List (LoopProg Nat))).length == 2

def cutSetsAppendGuard : Bool :=
  loopCutSets [9]
      (loopNestedSeq
        (([.assign 3 (.const 0)] : List (LoopProg Nat)) ++
          [.assign 4 (.const 1)])) ==
    [3, 4, 9]

def assignedVarsSplitGuard : Bool :=
  loopAssignedVars
      (loopNestedSeq
        (([.assign 3 (.const 0)] : List (LoopProg Nat)) ++
          [.assign 4 (.const 1)])) ==
    [3, 4]

def compSyntaxOkGuard : Bool :=
  loopCutSets [9]
      (loopNestedSeq (([.assign 3 (.const 0)] : List (LoopProg Nat)) ++
        [.assign 4 (.const 1)])) ==
    [3, 4, 9]

def cutSetsSubsetGuard : Bool :=
  (loopCutSets [2, 5]
      (loopNestedSeq ([.assign 3 (.const 0)] : List (LoopProg Nat)))).contains 2

def cutSetsExtraGuard : Bool :=
  (loopCutSets [2, 5] (.assign 3 (.const 0) : LoopProg Nat)).contains 3 &&
    (loopCutSets [2, 5] (.assign 3 (.const 0) : LoopProg Nat)).contains 2

def check (name : String) (actual expected : List Nat) : IO Bool := do
  if actual == expected then
    IO.println s!"PASS {name}"
    pure true
  else
    IO.println s!"FAIL {name}: expected {repr expected}, got {repr actual}"
    pure false

end Flapjack.Test.LoopAssignedVarsParity
