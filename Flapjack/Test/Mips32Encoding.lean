import Flapjack.Compiler.Encoders.Mips32.Target

/-! MIPS32 encoder fixtures. Each row is one instruction form the MIPS32 backend emits,
paired with the little-endian bytes LLVM's MIPS assembler produces for the same line of
`scripts/mips32/encoder-fixtures.s` (`llvm-mc -triple=mipsel-linux-gnu -mcpu=mips32r2`);
`scripts/mips32/check-encoder-fixtures.py` re-derives the bytes with `llvm-mc`. The check
also runs Ziren's `decode` on every fixture word. -/
namespace Flapjack.Test.Mips32Encoding
open ZirenDet.Isa Flapjack.Mips32 Flapjack.Compiler.Encoders.Mips32

def fixtures : List (Insn × List Nat) :=
  [ (.addu 3 4 5, [0x21, 0x18, 0x85, 0x00]),
    (.subu 3 4 5, [0x23, 0x18, 0x85, 0x00]),
    (.and 3 4 5, [0x24, 0x18, 0x85, 0x00]),
    (.or 3 4 5, [0x25, 0x18, 0x85, 0x00]),
    (.xor 3 4 5, [0x26, 0x18, 0x85, 0x00]),
    (.nor 3 4 0, [0x27, 0x18, 0x80, 0x00]),
    (.slt 1 4 5, [0x2a, 0x08, 0x85, 0x00]),
    (.sltu 1 4 5, [0x2b, 0x08, 0x85, 0x00]),
    (.sll 3 4 7, [0xc0, 0x19, 0x04, 0x00]),
    (.srl 3 4 7, [0xc2, 0x19, 0x04, 0x00]),
    (.sra 3 4 7, [0xc3, 0x19, 0x04, 0x00]),
    (.rotr 3 4 7, [0xc2, 0x19, 0x24, 0x00]),
    (.sllv 3 4 5, [0x04, 0x18, 0xa4, 0x00]),
    (.srlv 3 4 5, [0x06, 0x18, 0xa4, 0x00]),
    (.srav 3 4 5, [0x07, 0x18, 0xa4, 0x00]),
    (.rotrv 3 4 5, [0x46, 0x18, 0xa4, 0x00]),
    (.jr 9, [0x08, 0x00, 0x20, 0x01]),
    (.jalr 31 1, [0x09, 0xf8, 0x20, 0x00]),
    (.mfhi 3, [0x10, 0x18, 0x00, 0x00]),
    (.mflo 3, [0x12, 0x18, 0x00, 0x00]),
    (.multu 4 5, [0x19, 0x00, 0x85, 0x00]),
    (.div 4 5, [0x1a, 0x00, 0x85, 0x00]),
    (.bal 2, [0x02, 0x00, 0x11, 0x04]),
    (.beq 4 5 (-4), [0xfc, 0xff, 0x85, 0x10]),
    (.bne 4 5 4, [0x04, 0x00, 0x85, 0x14]),
    (.addiu 3 4 (-2), [0xfe, 0xff, 0x83, 0x24]),
    (.slti 1 4 (-2), [0xfe, 0xff, 0x81, 0x28]),
    (.sltiu 1 4 (-2), [0xfe, 0xff, 0x81, 0x2c]),
    (.andi 3 4 0xfff0, [0xf0, 0xff, 0x83, 0x30]),
    (.ori 3 4 0xfff0, [0xf0, 0xff, 0x83, 0x34]),
    (.xori 3 4 0xfff0, [0xf0, 0xff, 0x83, 0x38]),
    (.lui 3 0x1234, [0x34, 0x12, 0x03, 0x3c]),
    (.lbu 3 4 (-4), [0xfc, 0xff, 0x83, 0x90]),
    (.lhu 3 4 6, [0x06, 0x00, 0x83, 0x94]),
    (.lw 3 4 8, [0x08, 0x00, 0x83, 0x8c]),
    (.sb 3 4 (-4), [0xfc, 0xff, 0x83, 0xa0]),
    (.sh 3 4 6, [0x06, 0x00, 0x83, 0xa4]),
    (.sw 3 4 8, [0x08, 0x00, 0x83, 0xac]),
    (nop, [0x00, 0x00, 0x00, 0x00]) ]

def failures : List String :=
  fixtures.filterMap fun (i, expected) =>
    let bytes := (mips32Encode i).map BitVec.toNat
    if bytes != expected then some s!"{repr i}: encoded {bytes}, expected {expected}"
    else if decode (encodeInsn i) != some i then some s!"{repr i}: Ziren decode differs"
    else none

def runChecks : IO Bool := do
  match failures with
  | [] =>
    IO.println s!"PASS {fixtures.length} MIPS32 encoder fixtures (llvm-mc bytes, Ziren decode)"
    pure true
  | errors =>
    for e in errors do IO.eprintln s!"FAIL MIPS32 encoding {e}"
    pure false

end Flapjack.Test.Mips32Encoding
