module

public import Flapjack.HolRef

@[expose] public section

namespace Flapjack

/-- The list-size function generated by HOL's list datatype. Its source
equations are recorded by `listSizeHOL_thm`; there is no separately named
source definition. -/
def listSizeHOL {α : Type} (f : α → Nat) : List α → Nat
  | [] => 0
  | x :: xs => 1 + f x + listSizeHOL f xs

/-- Equations for HOL's generated list-size function. -/
@[hol "HOL/src/list/src/listScript.sml" "list_size_thm"]
theorem listSizeHOL_thm {α : Type} :
    (∀ f : α → Nat, listSizeHOL f [] = 0) ∧
      ∀ (f : α → Nat) x xs, listSizeHOL f (x :: xs) = 1 + f x + listSizeHOL f xs :=
  ⟨fun _ => rfl, fun _ _ _ => rfl⟩

end Flapjack
