import Flapjack.Misc.BinaryIeee

/-!
# HOL `machine_ieee` binary64 encoding and exact lifted operations

A rendering of the `fp64` encoding that `machine_ieeeLib.mk_fp_encoding`
generates in `HOL/src/floating-point/machine_ieeeScript.sml` (bead
`flapjack-h29l.6.1`).  For binary64 the significand width is `t = 52` and the
exponent width `w = 11`.  `fp64_to_float` extracts the sign (bit 63), exponent
(bits 62-52) and significand (bits 51-0).  `float_to_fp64` concatenates them
back.  The comparison and sign operations are the `binary_ieee` ones composed
with these encodings.

The machine definitions are generated by `machine_ieeeLib` at the reviewed
`("fp64", 52, 11, SOME "double")` call (`machine_ieeeScript.sml:16`), which
`scripts/check-hol-refs.py` resolves for these generated names.  All
declarations here are tagged after comparison with the generated definitions
captured by `machine_ieee_fp64_probe`.  The codecs, `fp64_abs` and
`fp64_negate` are real-free; the comparisons and NaN predicates go through
`float_value`, so they carry `reals_as_rational_cuts`.
-/

namespace Flapjack

/-- Source comparison: HOL revision `a390cbabd3a4521bab4ee20281e3e42933a8a3ae`,
`machine_ieeeScript.sml:13-16` selects `(fp64,52,11)`;
`machine_ieeeLib.sml:49-66` extracts `(63,63)`, `(62,52)`, `(51,0)`.
Lean `extractLsb'` uses lower bound and length, giving the same 1/11/52 fields.
No real, rounding, flags, or NaN canonicalization is involved.
HOL `fp64_to_float w = <| Sign := (63 >< 63) w; Exponent := (62 >< 52) w;
    Significand := (51 >< 0) w |>`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_to_float_def" 16]
def holFp64ToFloat (w : BitVec 64) : HolFloat 52 11 :=
  { sign := w.extractLsb' 63 1, exponent := w.extractLsb' 52 11,
    significand := w.extractLsb' 0 52 }

/-- Source comparison at the same HOL revision: `machine_ieeeLib.sml:68-78`
concatenates Sign, Exponent, Significand in that order. Lean's associativity
changes only grouping; the fields remain exactly 1/11/52 bits. The cast proves
only the total width is 64. No field or payload bits are changed.
HOL `float_to_fp64 x = x.Sign @@ x.Exponent @@ x.Significand`; the
    concatenation is exactly 64 bits wide. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "float_to_fp64_def" 16]
def holFloatToFp64 (x : HolFloat 52 11) : BitVec 64 :=
  (x.sign ++ x.exponent ++ x.significand).cast (by decide)

/-- HOL `fp64_lessThan a b = float_less_than (fp64_to_float a) (fp64_to_float b)`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_lessThan_def" 16
  (reals_as_rational_cuts)]
def holFp64LessThan (a b : BitVec 64) : Bool :=
  holFloatLessThan (holFp64ToFloat a) (holFp64ToFloat b)

/-- HOL `fp64_lessEqual a b = float_less_equal (fp64_to_float a) (fp64_to_float b)`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_lessEqual_def" 16
  (reals_as_rational_cuts)]
def holFp64LessEqual (a b : BitVec 64) : Bool :=
  holFloatLessEqual (holFp64ToFloat a) (holFp64ToFloat b)

/-- HOL `fp64_greaterThan a b = float_greater_than (fp64_to_float a)
    (fp64_to_float b)`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_greaterThan_def" 16
  (reals_as_rational_cuts)]
def holFp64GreaterThan (a b : BitVec 64) : Bool :=
  holFloatGreaterThan (holFp64ToFloat a) (holFp64ToFloat b)

/-- HOL `fp64_greaterEqual a b = float_greater_equal (fp64_to_float a)
    (fp64_to_float b)`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_greaterEqual_def" 16
  (reals_as_rational_cuts)]
def holFp64GreaterEqual (a b : BitVec 64) : Bool :=
  holFloatGreaterEqual (holFp64ToFloat a) (holFp64ToFloat b)

/-- HOL `fp64_equal a b = float_equal (fp64_to_float a) (fp64_to_float b)`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_equal_def" 16
  (reals_as_rational_cuts)]
def holFp64Equal (a b : BitVec 64) : Bool :=
  holFloatEqual (holFp64ToFloat a) (holFp64ToFloat b)

/-- Source comparison at the same HOL revision: `machine_ieeeLib.sml:147-171,
432` composes the codecs with `float_abs` without flags;
`binary_ieeeScript.sml:157-159` sets only Sign to zero. Thus signed zeros,
infinities, and NaN payloads receive the same sign-only transformation.
This records source correspondence, not an arithmetic or oracle-completeness theorem.
HOL `fp64_abs = float_to_fp64 o float_abs o fp64_to_float`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_abs_def" 16]
def holFp64Abs (a : BitVec 64) : BitVec 64 :=
  holFloatToFp64 (holFloatAbs (holFp64ToFloat a))

/-- Source comparison at the same HOL revision: `machine_ieeeLib.sml:147-171,
431` composes the codecs with `float_negate` without flags;
`binary_ieeeScript.sml:153-155` complements the one-bit Sign. Exponent and
significand (including NaN payload and signaling bit) are unchanged.
HOL `fp64_negate = float_to_fp64 o float_negate o fp64_to_float`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_negate_def" 16]
def holFp64Negate (a : BitVec 64) : BitVec 64 :=
  holFloatToFp64 (holFloatNegate (holFp64ToFloat a))

/-- HOL `fp64_isNan = float_is_nan o fp64_to_float`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_isNan_def" 16
  (reals_as_rational_cuts)]
def holFp64IsNan (a : BitVec 64) : Bool :=
  holFloatIsNan (holFp64ToFloat a)

/-- HOL `fp64_isSignallingNan = float_is_signalling o fp64_to_float`. -/
@[hol "HOL/src/floating-point/machine_ieeeScript.sml" "fp64_isSignallingNan_def" 16
  (reals_as_rational_cuts)]
def holFp64IsSignalling (a : BitVec 64) : Bool :=
  holFloatIsSignalling (holFp64ToFloat a)

end Flapjack
