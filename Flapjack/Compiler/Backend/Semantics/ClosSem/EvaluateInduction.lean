module

public import Flapjack.Compiler.Backend.Semantics.ClosSem.EvaluateClock

@[expose] public section

/-! The HOL-shaped induction principle for the closure evaluator.

HOL's `closSemTheory.evaluate_ind` is generated by the mutual `Define` of
`evaluate` and `evaluate_app`, so it has one hypothesis per clause, and each
recursive-call induction hypothesis is guarded by that clause's own side
conditions. Lean cannot derive an `induct` principle for the clock/weight
strong recursion here, so this module proves the same clause-shaped principle
once and the closProps proofs reuse it. It mirrors the auto-generated
`evaluate_ind`, so it carries no `@[hol]` source citation. -/
namespace Flapjack.Compiler.Backend.ClosSem
open Flapjack.SemanticPrimitivesHOL

private structure ClosSemEvaluateCases {C F : Type}
    (P0 : State C F → List Value → List ClosLang.Exp → Prop)
    (P1 : Option Nat → Value → List Value → State C F → Prop) : Prop where
  ExpsNil : ∀ (s : State C F) (env : List Value), P0 s env []
  ExpsCons : ∀ (s : State C F) (env : List Value) (x y : ClosLang.Exp)
    (xs : List ClosLang.Exp)
    (_ih : (∀ (v4 : Result (List Value) Value) (s1 : State C F) (v1 : List Value),
      evaluate [x] env s = (v4, s1) ∧ v4 = .val v1 → P0 s1 env (y :: xs)) ∧
      P0 s env [x]),
    P0 s env (x :: y :: xs)
  Var : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra) (index : Nat),
    P0 s env [.var trace index]
  If : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (condition yes no : ClosLang.Exp)
    (_ih : (∀ (v2' : Result (List Value) Value) (s1 : State C F) (vs : List Value),
      evaluate [condition] env s = (v2', s1) ∧ v2' = .val vs ∧
        boolValue true ≠ headValue vs ∧ boolValue false = headValue vs →
        P0 s1 env [no]) ∧
      (∀ (v2' : Result (List Value) Value) (s1 : State C F) (vs : List Value),
      evaluate [condition] env s = (v2', s1) ∧ v2' = .val vs ∧
        boolValue true = headValue vs → P0 s1 env [yes]) ∧
      P0 s env [condition]),
    P0 s env [.ifThenElse trace condition yes no]
  Let : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (bindings : List ClosLang.Exp) (body : ClosLang.Exp)
    (_ih : (∀ (v2 : Result (List Value) Value) (s1 : State C F) (vs : List Value),
      evaluate bindings env s = (v2, s1) ∧ v2 = .val vs → P0 s1 (vs ++ env) [body]) ∧
      P0 s env bindings),
    P0 s env [.«let» trace bindings body]
  Raise : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (body : ClosLang.Exp)
    (_ih : P0 s env [body]), P0 s env [.raise trace body]
  Handle : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (body handler : ClosLang.Exp)
    (_ih : (∀ (v3 : Result (List Value) Value) (s1 : State C F) (v8 : ErrorResult Value)
      (value : Value),
      evaluate [body] env s = (v3, s1) ∧ v3 = .err v8 ∧ v8 = .raise value →
        P0 s1 (value :: env) [handler]) ∧
      P0 s env [body]),
    P0 s env [.handle trace body handler]
  Op : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (op : ClosLang.Op) (args : List ClosLang.Exp)
    (_ih : (∀ (v8 : Result (List Value) Value) (s' : State C F) (vs : List Value)
      (v : Result (List ClosLang.Exp) Value) (s'' : State C F)
      (es : List ClosLang.Exp),
      evaluate args env s = (v8, s') ∧ v8 = .val vs ∧ op = .install ∧
        doInstall vs.reverse s' = (v, s'') ∧ v = .val es → P0 s'' [] es) ∧
      (∀ (v8 : Result (List Value) Value) (s' : State C F) (vs : List Value)
        (mode : Flapjack.AstHOL.ThunkMode) (value : Value),
      evaluate args env s = (v8, s') ∧ v8 = .val vs ∧ op ≠ .install ∧
        op = .thunkOp .forceThunk ∧ destThunk vs s'.refs = .isThunk mode value ∧
        mode = .notEvaluated → P0 s' [value] [appUnit (.var .none 0)]) ∧
      P0 s env args),
    P0 s env [.op trace op args]
  Fn : ∀ (s : State C F) (env : List Value)
    (name : Flapjack.Basis.Pure.MlString.MlString) (location : Option Nat)
    (selected : Option (List Nat)) (arity : Nat) (body : ClosLang.Exp),
    P0 s env [.fn name location selected arity body]
  Letrec : ∀ (s : State C F) (env : List Value)
    (names : List Flapjack.Basis.Pure.MlString.MlString)
    (location : Option Nat) (selected : Option (List Nat))
    (functions : List (Nat × ClosLang.Exp)) (body : ClosLang.Exp)
    (_ih : (∀ (buildRec : List Value → List Value) (envDelta : Option (List Value))
      (ed : List Value),
      functions.all (fun (arity, _) => arity ≤ s.maxApp && arity != 0) = true ∧
      buildRec = (fun values => (List.range functions.length).map
        (fun i => Value.recclosure location [] values functions i)) ∧
      envDelta = (match selected with
        | none => some (buildRec env)
        | some names => (lookupVars names env).map buildRec) ∧
      envDelta = some ed → P0 s (ed ++ env) [body])),
    P0 s env [.letrec names location selected functions body]
  App : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (location : Option Nat) (function : ClosLang.Exp) (args : List ClosLang.Exp)
    (_ih : (∀ (v3 : Result (List Value) Value) (s1 : State C F) (y2 : List Value)
      (v2 : Result (List Value) Value) (s2 : State C F) (y1 : List Value),
      args.length > 0 ∧ evaluate args env s = (v3, s1) ∧ v3 = .val y2 ∧
        evaluate [function] env s1 = (v2, s2) ∧ v2 = .val y1 →
        P1 location (headValue y1) y2 s2) ∧
      (∀ (v3 : Result (List Value) Value) (s1 : State C F) (y2 : List Value),
      args.length > 0 ∧ evaluate args env s = (v3, s1) ∧ v3 = .val y2 →
        P0 s1 env [function]) ∧
      (args.length > 0 → P0 s env args)),
    P0 s env [.app trace location function args]
  Tick : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (body : ClosLang.Exp)
    (_ih : (s.clock ≠ 0 → P0 (decClock 1 s) env [body])),
    P0 s env [.tick trace body]
  Call : ∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
    (ticks location : Nat) (args : List ClosLang.Exp)
    (_ih : (∀ (v3 : Result (List Value) Value) (s1 : State C F) (vs : List Value)
      (pair : List Value × ClosLang.Exp) (callArgs : List Value)
      (body : ClosLang.Exp),
      evaluate args env s = (v3, s1) ∧ v3 = .val vs ∧
        findCode location vs s1.code = some pair ∧ pair = (callArgs, body) ∧
        ¬(s1.clock < ticks + 1) → P0 (decClock (ticks + 1) s1) callArgs [body]) ∧
      P0 s env args),
    P0 s env [.call trace ticks location args]
  AppNil : ∀ (location : Option Nat) (f : Value) (s : State C F), P1 location f [] s
  AppCons : ∀ (location : Option Nat) (f : Value) (arg : Value) (rest : List Value)
    (s : State C F)
    (_ih : (∀ (kind : AppKind) (body : ClosLang.Exp) (callEnv restArgs : List Value)
      (v3 : Result (List Value) Value) (s1 : State C F) (v7 : List Value) (v : Value)
      (v12 : List Value),
      destClosure s.maxApp location f (arg :: rest) = some kind ∧
        kind = .fullApp body callEnv restArgs ∧
        ¬(s.clock < (arg :: rest).length - restArgs.length) ∧
        evaluate [body] callEnv
          (decClock ((arg :: rest).length - restArgs.length) s) = (v3, s1) ∧
        v3 = .val v7 ∧ v7 = v :: v12 ∧ v12 = [] →
        P1 location v restArgs s1) ∧
      (∀ (kind : AppKind) (body : ClosLang.Exp) (callEnv restArgs : List Value),
      destClosure s.maxApp location f (arg :: rest) = some kind ∧
        kind = .fullApp body callEnv restArgs ∧
        ¬(s.clock < (arg :: rest).length - restArgs.length) →
        P0 (decClock ((arg :: rest).length - restArgs.length) s) callEnv [body])),
    P1 location f (arg :: rest) s

mutual
private theorem goExp {C F : Type}
    {P0 : State C F → List Value → List ClosLang.Exp → Prop}
    {P1 : Option Nat → Value → List Value → State C F → Prop}
    (H : ClosSemEvaluateCases P0 P1)
    (state : State C F) (env : List Value) (exprs : List ClosLang.Exp) :
    P0 state env exprs := by
  cases exprs with
  | nil => exact H.ExpsNil state env
  | cons first rest =>
    cases rest with
    | cons second tail =>
      apply H.ExpsCons state env first second tail
      refine ⟨?_, goExp H state env [first]⟩
      intro v4 s1 v1 ⟨run, _⟩
      have bound : s1.clock ≤ state.clock := by
        simpa only [run] using evaluate_clock_le [first] env state
      exact goExp H s1 env (second :: tail)
    | nil =>
      cases first with
      | var trace index => exact H.Var state env trace index
      | fn name location selected arity body =>
        exact H.Fn state env name location selected arity body
      | raise trace body =>
        exact H.Raise state env trace body (goExp H state env [body])
      | handle trace body handler =>
        apply H.Handle state env trace body handler
        refine ⟨?_, goExp H state env [body]⟩
        intro v3 s1 v8 value ⟨run, _, _⟩
        have bound : s1.clock ≤ state.clock := by
          simpa only [run] using evaluate_clock_le [body] env state
        exact goExp H s1 (value :: env) [handler]
      | «let» trace bindings body =>
        apply H.Let state env trace bindings body
        refine ⟨?_, goExp H state env bindings⟩
        intro v2 s1 vs ⟨run, _⟩
        have bound : s1.clock ≤ state.clock := by
          simpa only [run] using evaluate_clock_le bindings env state
        exact goExp H s1 (vs ++ env) [body]
      | ifThenElse trace condition yes no =>
        apply H.If state env trace condition yes no
        refine ⟨?_, ?_, goExp H state env [condition]⟩
        · intro v2' s1 vs ⟨run, _, _, _⟩
          have bound : s1.clock ≤ state.clock := by
            simpa only [run] using evaluate_clock_le [condition] env state
          exact goExp H s1 env [no]
        · intro v2' s1 vs ⟨run, _, _⟩
          have bound : s1.clock ≤ state.clock := by
            simpa only [run] using evaluate_clock_le [condition] env state
          exact goExp H s1 env [yes]
      | op trace op args =>
        apply H.Op state env trace op args
        refine ⟨?_, ?_, goExp H state env args⟩
        · intro v8 s' vs v s'' es ⟨run, _, _, installRun, installedEq⟩
          have bound : s'.clock ≤ state.clock := by
            simpa only [run] using evaluate_clock_le args env state
          have successRun : doInstall vs.reverse s' = (.val es, s'') := by
            rw [installedEq] at installRun
            exact installRun
          have clockDrop := doInstall_success_clock vs.reverse s' s'' es successRun
          have installSmaller : s''.clock < s'.clock := by
            obtain ⟨posClock, clockEq⟩ := clockDrop
            omega
          exact goExp H s'' [] es
        · intro v8 s' vs mode value ⟨run, _, _, _, _, _⟩
          have bound : s'.clock ≤ state.clock := by
            simpa only [run] using evaluate_clock_le args env state
          exact goExp H s' [value] [appUnit (.var .none 0)]
      | letrec names location selected functions body =>
        apply H.Letrec state env names location selected functions body
        intro buildRec envDelta ed ⟨_, _, _, _⟩
        exact goExp H state (ed ++ env) [body]
      | app trace location function args =>
        apply H.App state env trace location function args
        refine ⟨?_, ?_, ?_⟩
        · intro v3 s1 y2 v2 s2 y1 ⟨_, runArgs, _, runFun, _⟩
          have argsBound : s1.clock ≤ state.clock := by
            simpa only [runArgs] using evaluate_clock_le args env state
          have funBound : s2.clock ≤ s1.clock := by
            simpa only [runFun] using evaluate_clock_le [function] env s1
          exact goApp H location (headValue y1) y2 s2
        · intro v3 s1 y2 ⟨_, runArgs, _⟩
          have bound : s1.clock ≤ state.clock := by
            simpa only [runArgs] using evaluate_clock_le args env state
          exact goExp H s1 env [function]
        · intro _
          exact goExp H state env args
      | tick trace body =>
        apply H.Tick state env trace body
        intro nonzero
        exact goExp H (decClock 1 state) env [body]
      | call trace ticks location args =>
        apply H.Call state env trace ticks location args
        refine ⟨?_, goExp H state env args⟩
        intro v3 s1 vs pair callArgs body ⟨run, _, _, _, enough⟩
        have bound : s1.clock ≤ state.clock := by
          simpa only [run] using evaluate_clock_le args env state
        exact goExp H (decClock (ticks + 1) s1) callArgs [body]
termination_by (state.clock, expsWeight exprs, 0)
decreasing_by
  all_goals try simp only [Prod.lex_def]
  all_goals try (have := expWeight_pos first)
  all_goals try simp_all [expsWeight, expWeight, decClock, appUnit]
  all_goals try exact opWeight_gt trace op args
  all_goals try omega

private theorem goApp {C F : Type}
    {P0 : State C F → List Value → List ClosLang.Exp → Prop}
    {P1 : Option Nat → Value → List Value → State C F → Prop}
    (H : ClosSemEvaluateCases P0 P1)
    (location : Option Nat) (function : Value) (args : List Value)
    (state : State C F) :
    P1 location function args state := by
  cases args with
  | nil => exact H.AppNil location function state
  | cons arg rest =>
    apply H.AppCons location function arg rest state
    refine ⟨?_, ?_⟩
    · intro kind body callEnv restArgs v3 s1 v7 v v12
        ⟨destRun, kindEq, enough, evalRun, _, _, _⟩
      have costPos : 0 < (arg :: rest).length - restArgs.length := by
        have remaining := destClosure_full_remaining_lt state.maxApp location function
          (arg :: rest) callEnv restArgs body (by simpa only [kindEq] using destRun)
        omega
      have startBound : (decClock ((arg :: rest).length - restArgs.length) state).clock <
          state.clock := by
        simp only [decClock]
        omega
      have runBound : s1.clock ≤
          (decClock ((arg :: rest).length - restArgs.length) state).clock := by
        simpa only [evalRun] using evaluate_clock_le [body] callEnv
          (decClock ((arg :: rest).length - restArgs.length) state)
      exact goApp H location v restArgs s1
    · intro kind body callEnv restArgs ⟨destRun, kindEq, enough⟩
      have costPos : 0 < (arg :: rest).length - restArgs.length := by
        have remaining := destClosure_full_remaining_lt state.maxApp location function
          (arg :: rest) callEnv restArgs body (by simpa only [kindEq] using destRun)
        omega
      exact goExp H (decClock ((arg :: rest).length - restArgs.length) state) callEnv [body]
termination_by (state.clock, 0, args.length)
decreasing_by
  all_goals try simp_wf
  all_goals try simp only [Prod.lex_def, decClock]
  all_goals try simp_all
  all_goals try omega
end

/-- HOL-shaped mutual induction principle for `evaluate` and `evaluate_app`.

This mirrors the auto-generated `closSemTheory.evaluate_ind`: one hypothesis per
clause, each recursive-call induction hypothesis guarded by the clause's own
side conditions. It is Flapjack infrastructure, so it is not tagged. -/
theorem evaluateInd {C F : Type}
    (P0 : State C F → List Value → List ClosLang.Exp → Prop)
    (P1 : Option Nat → Value → List Value → State C F → Prop) :
    (∀ (s : State C F) (env : List Value), P0 s env []) ∧
    (∀ (s : State C F) (env : List Value) (x y : ClosLang.Exp) (xs : List ClosLang.Exp)
      (_ih : (∀ (v4 : Result (List Value) Value) (s1 : State C F) (v1 : List Value),
        evaluate [x] env s = (v4, s1) ∧ v4 = .val v1 → P0 s1 env (y :: xs)) ∧
        P0 s env [x]),
      P0 s env (x :: y :: xs)) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra) (index : Nat),
      P0 s env [.var trace index]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (condition yes no : ClosLang.Exp)
      (_ih : (∀ (v2' : Result (List Value) Value) (s1 : State C F) (vs : List Value),
        evaluate [condition] env s = (v2', s1) ∧ v2' = .val vs ∧
          boolValue true ≠ headValue vs ∧ boolValue false = headValue vs →
          P0 s1 env [no]) ∧
        (∀ (v2' : Result (List Value) Value) (s1 : State C F) (vs : List Value),
        evaluate [condition] env s = (v2', s1) ∧ v2' = .val vs ∧
          boolValue true = headValue vs → P0 s1 env [yes]) ∧
        P0 s env [condition]),
      P0 s env [.ifThenElse trace condition yes no]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (bindings : List ClosLang.Exp) (body : ClosLang.Exp)
      (_ih : (∀ (v2 : Result (List Value) Value) (s1 : State C F) (vs : List Value),
        evaluate bindings env s = (v2, s1) ∧ v2 = .val vs → P0 s1 (vs ++ env) [body]) ∧
        P0 s env bindings),
      P0 s env [.«let» trace bindings body]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (body : ClosLang.Exp)
      (_ih : P0 s env [body]), P0 s env [.raise trace body]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (body handler : ClosLang.Exp)
      (_ih : (∀ (v3 : Result (List Value) Value) (s1 : State C F) (v8 : ErrorResult Value)
        (value : Value),
        evaluate [body] env s = (v3, s1) ∧ v3 = .err v8 ∧ v8 = .raise value →
          P0 s1 (value :: env) [handler]) ∧
        P0 s env [body]),
      P0 s env [.handle trace body handler]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (op : ClosLang.Op) (args : List ClosLang.Exp)
      (_ih : (∀ (v8 : Result (List Value) Value) (s' : State C F) (vs : List Value)
        (v : Result (List ClosLang.Exp) Value) (s'' : State C F)
        (es : List ClosLang.Exp),
        evaluate args env s = (v8, s') ∧ v8 = .val vs ∧ op = .install ∧
          doInstall vs.reverse s' = (v, s'') ∧ v = .val es → P0 s'' [] es) ∧
        (∀ (v8 : Result (List Value) Value) (s' : State C F) (vs : List Value)
          (mode : Flapjack.AstHOL.ThunkMode) (value : Value),
        evaluate args env s = (v8, s') ∧ v8 = .val vs ∧ op ≠ .install ∧
          op = .thunkOp .forceThunk ∧ destThunk vs s'.refs = .isThunk mode value ∧
          mode = .notEvaluated → P0 s' [value] [appUnit (.var .none 0)]) ∧
        P0 s env args),
      P0 s env [.op trace op args]) ∧
    (∀ (s : State C F) (env : List Value)
      (name : Flapjack.Basis.Pure.MlString.MlString) (location : Option Nat)
      (selected : Option (List Nat)) (arity : Nat) (body : ClosLang.Exp),
      P0 s env [.fn name location selected arity body]) ∧
    (∀ (s : State C F) (env : List Value)
      (names : List Flapjack.Basis.Pure.MlString.MlString)
      (location : Option Nat) (selected : Option (List Nat))
      (functions : List (Nat × ClosLang.Exp)) (body : ClosLang.Exp)
      (_ih : (∀ (buildRec : List Value → List Value) (envDelta : Option (List Value))
        (ed : List Value),
        functions.all (fun (arity, _) => arity ≤ s.maxApp && arity != 0) = true ∧
        buildRec = (fun values => (List.range functions.length).map
          (fun i => Value.recclosure location [] values functions i)) ∧
        envDelta = (match selected with
          | none => some (buildRec env)
          | some names => (lookupVars names env).map buildRec) ∧
        envDelta = some ed → P0 s (ed ++ env) [body])),
      P0 s env [.letrec names location selected functions body]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (location : Option Nat) (function : ClosLang.Exp) (args : List ClosLang.Exp)
      (_ih : (∀ (v3 : Result (List Value) Value) (s1 : State C F) (y2 : List Value)
        (v2 : Result (List Value) Value) (s2 : State C F) (y1 : List Value),
        args.length > 0 ∧ evaluate args env s = (v3, s1) ∧ v3 = .val y2 ∧
          evaluate [function] env s1 = (v2, s2) ∧ v2 = .val y1 →
          P1 location (headValue y1) y2 s2) ∧
        (∀ (v3 : Result (List Value) Value) (s1 : State C F) (y2 : List Value),
        args.length > 0 ∧ evaluate args env s = (v3, s1) ∧ v3 = .val y2 →
          P0 s1 env [function]) ∧
        (args.length > 0 → P0 s env args)),
      P0 s env [.app trace location function args]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (body : ClosLang.Exp)
      (_ih : (s.clock ≠ 0 → P0 (decClock 1 s) env [body])),
      P0 s env [.tick trace body]) ∧
    (∀ (s : State C F) (env : List Value) (trace : BackendCommon.Tra)
      (ticks location : Nat) (args : List ClosLang.Exp)
      (_ih : (∀ (v3 : Result (List Value) Value) (s1 : State C F) (vs : List Value)
        (pair : List Value × ClosLang.Exp) (callArgs : List Value)
        (body : ClosLang.Exp),
        evaluate args env s = (v3, s1) ∧ v3 = .val vs ∧
          findCode location vs s1.code = some pair ∧ pair = (callArgs, body) ∧
          ¬(s1.clock < ticks + 1) → P0 (decClock (ticks + 1) s1) callArgs [body]) ∧
        P0 s env args),
      P0 s env [.call trace ticks location args]) ∧
    (∀ (location : Option Nat) (f : Value) (s : State C F), P1 location f [] s) ∧
    (∀ (location : Option Nat) (f : Value) (arg : Value) (rest : List Value)
      (s : State C F)
      (_ih : (∀ (kind : AppKind) (body : ClosLang.Exp) (callEnv restArgs : List Value)
        (v3 : Result (List Value) Value) (s1 : State C F) (v7 : List Value) (v : Value)
        (v12 : List Value),
        destClosure s.maxApp location f (arg :: rest) = some kind ∧
          kind = .fullApp body callEnv restArgs ∧
          ¬(s.clock < (arg :: rest).length - restArgs.length) ∧
          evaluate [body] callEnv
            (decClock ((arg :: rest).length - restArgs.length) s) = (v3, s1) ∧
          v3 = .val v7 ∧ v7 = v :: v12 ∧ v12 = [] →
          P1 location v restArgs s1) ∧
        (∀ (kind : AppKind) (body : ClosLang.Exp) (callEnv restArgs : List Value),
        destClosure s.maxApp location f (arg :: rest) = some kind ∧
          kind = .fullApp body callEnv restArgs ∧
          ¬(s.clock < (arg :: rest).length - restArgs.length) →
          P0 (decClock ((arg :: rest).length - restArgs.length) s) callEnv [body])),
      P1 location f (arg :: rest) s) →
    (∀ (s : State C F) (env : List Value) (es : List ClosLang.Exp), P0 s env es) ∧
    (∀ (location : Option Nat) (f : Value) (args : List Value) (s : State C F),
      P1 location f args s) := by
  rintro ⟨hExpsNil, hExpsCons, hVar, hIf, hLet, hRaise, hHandle, hOp, hFn, hLetrec,
    hApp, hTick, hCall, hAppNil, hAppCons⟩
  let H : ClosSemEvaluateCases P0 P1 :=
    ⟨hExpsNil, hExpsCons, hVar, hIf, hLet, hRaise, hHandle, hOp, hFn, hLetrec,
      hApp, hTick, hCall, hAppNil, hAppCons⟩
  exact ⟨goExp H, goApp H⟩

end Flapjack.Compiler.Backend.ClosSem
