import Flapjack.Compiler.Backend.DataToWord.Proofs.Total
import Flapjack.Compiler.Backend.WordBignum.Proofs.GenerateTotal
import Flapjack.Compiler.Backend.BviToData.Proofs.CompileAgreement
import Flapjack.Misc.Sptree.ToAList
import Mathlib.Data.List.Nodup

/-! The executable 64-bit code relation for the data-to-word proof. -/
namespace Flapjack.Compiler.Backend.DataToWord.Proofs.Gc
open Flapjack

/-- A total view of the executed 64-bit traversal. The fallback is unreachable
by `compileControl64_succeeds`; it does not claim correspondence to HOL's
unrestricted `comp`. -/
def compileControl64 (conf : Config) (secn label : Nat) (program : DataLang.Prog) :
    WordLangProgHOL (BitVec 64) × Nat :=
  (compileControl? (width := 64) conf secn label program).getD (.skip, label)

/-- The total view returns exactly the production traversal's result. -/
theorem compileControl64_checked (conf : Config) (secn label : Nat) (program : DataLang.Prog) :
    compileControl? (width := 64) conf secn label program =
      some (compileControl64 conf secn label program) := by
  obtain ⟨result, run⟩ := compileControl64_succeeds conf secn label program
  simp [compileControl64, run]

/-- Executed 64-bit function lowering, including the reserved extra argument. -/
def compilePart64 (conf : Config) (entry : Nat × Nat × DataLang.Prog) :
    Nat × Nat × WordLangProgHOL (BitVec 64) :=
  let (name, args, body) := entry
  (name, args + 1, (compileControl64 conf name 2 body).1)

/-- The configured driver's monadic function traversal is this total map. -/
theorem compileParts64_checked (conf : Config) (entries : List (Nat × Nat × DataLang.Prog)) :
    (entries.mapM fun (name, args, body) => do
      let (body, _) ← compileControl? (width := 64) conf name 2 body
      pure (name, args + 1, body)) = some (entries.map (compilePart64 conf)) := by
  induction entries with
  | nil => rfl
  | cons entry entries ih =>
    obtain ⟨name, args, body⟩ := entry
    simp only [List.mapM_cons, List.map_cons, ih]
    simp [compileControl64_checked, compilePart64]

/-- The configured BVI-to-word traversal returns the same functions as the
source-shaped BVI-to-data map followed by the executed 64-bit word map. -/
theorem compileBviParts64_checked (fuel : Nat) (conf : Config) (entries : List (Nat × Nat × Bvi.Exp)) :
    (entries.mapM fun (name, args, body) => do
      let body ← BviToData.compileExpBounded fuel args body
      let (body, _) ← compileControl? (width := 64) conf name 2 body
      pure (name, args + 1, body)) =
      some ((BviToData.compileProg entries).map (compilePart64 conf)) := by
  induction entries with
  | nil => rfl
  | cons entry entries ih =>
    obtain ⟨name, args, body⟩ := entry
    simp only [BviToData.compileProg, List.map_cons] at ih ⊢
    simp only [List.mapM_cons, ih]
    simp [BviToData.compileExpBounded_agrees_all, compileControl64_checked,
      compilePart64, BviToData.compilePart]

/-- The fixed and bignum stubs generated by the executed 64-bit driver. -/
def runtimeStubs64 (conf : Config) : List (Nat × Nat × WordLangProgHOL (BitVec 64)) :=
  (fixedStubs? (width := 64) conf).getD [] ++
    (WordBignum.generateStubs 64 bignumLocation).getD []

/-- Both components of the total stub view are the results of production
generation; their availability is proved independently of configuration. -/
theorem runtimeStubs64_checked (conf : Config) :
    (do
      let fixed ← fixedStubs? (width := 64) conf
      let bignum ← WordBignum.generateStubs 64 bignumLocation
      pure (fixed ++ bignum)) = some (runtimeStubs64 conf) := by
  obtain ⟨fixed, hf⟩ := fixedStubs64_succeeds conf
  obtain ⟨bignum, hb⟩ := WordBignum.generateStubs_succeeds 64 bignumLocation
  simp [runtimeStubs64, hf, hb]

/-- Code-domain, stub-lookup and compiled-function conditions using the
executed 64-bit compiler. This is a 64-bit proof-side candidate for the HOL
code relation: equivalence of the executed traversal and stub generator to
their HOL counterparts remains unproved, so it carries no HOL attribute. -/
def codeRel64 (conf : Config) (source : Spt (Nat × DataLang.Prog))
    (target : Spt (Nat × WordLangProgHOL (BitVec 64))) : Prop :=
  (∀ name, sptDomain target name ↔ sptDomain source name ∨
    name ∈ (runtimeStubs64 conf).map Prod.fst) ∧
  (∀ name arity body, (name, arity, body) ∈ runtimeStubs64 conf →
    sptLookup name target = some (arity, body)) ∧
  ∀ name arity body, sptLookup name source = some (arity, body) →
    sptLookup name target = some (arity + 1, (compileControl64 conf name 2 body).1)

/-- The driver's stub prefix followed by compiled source entries. -/
def emittedCode64 (conf : Config) (source : Spt (Nat × DataLang.Prog)) :
    List (Nat × Nat × WordLangProgHOL (BitVec 64)) :=
  runtimeStubs64 conf ++ (sptToAList source).map (compilePart64 conf)

/-- With distinct emitted labels, installing the executed stub prefix and
compiled source entries establishes the 64-bit code relation. -/
theorem codeRel64_emitted (conf : Config) (source : Spt (Nat × DataLang.Prog))
    (distinct : ((emittedCode64 conf source).map Prod.fst).Nodup) :
    codeRel64 conf source (sptFromAList (emittedCode64 conf source)) := by
  have lookupEntry : ∀ name arity body, (name, arity, body) ∈ emittedCode64 conf source →
      sptLookup name (sptFromAList (emittedCode64 conf source)) = some (arity, body) := by
    intro name arity body member
    rw [sptLookup_sptFromAList]
    apply sptAListLookup_eq_of_mem_unique name (arity, body) _ member
    intro other otherMember
    have same : (name, other) = (name, arity, body) :=
      List.inj_on_of_nodup_map distinct otherMember member rfl
    exact congrArg Prod.snd same
  have partNames : ((sptToAList source).map (compilePart64 conf)).map Prod.fst =
      (sptToAList source).map Prod.fst := by
    rw [List.map_map]
    apply List.map_congr_left
    intro entry _
    obtain ⟨name, args, body⟩ := entry
    rfl
  constructor
  · intro name
    rw [sptDomainFromAList]
    simp only [emittedCode64, List.map_append, List.mem_append, partNames]
    rw [sptMemMapFstToAList]
    exact or_comm
  constructor
  · intro name arity body member
    exact lookupEntry name arity body (List.mem_append_left _ member)
  · intro name arity body found
    apply lookupEntry
    apply List.mem_append_right
    apply List.mem_map.mpr
    exact ⟨(name, arity, body), (sptMemToAList source name (arity, body)).mpr found, rfl⟩

/-- The production-ordered stub prefix and function list establish the code
relation for the source tree built from that same list, provided all emitted
labels are distinct. No sorting or canonical source enumeration is required. -/
theorem codeRel64_of_entries (conf : Config) (entries : List (Nat × Nat × DataLang.Prog))
    (distinct : ((runtimeStubs64 conf ++ entries.map (compilePart64 conf)).map Prod.fst).Nodup) :
    codeRel64 conf (sptFromAList entries)
      (sptFromAList (runtimeStubs64 conf ++ entries.map (compilePart64 conf))) := by
  let output := runtimeStubs64 conf ++ entries.map (compilePart64 conf)
  have lookupEntry : ∀ name arity body, (name, arity, body) ∈ output →
      sptLookup name (sptFromAList output) = some (arity, body) := by
    intro name arity body member
    rw [sptLookup_sptFromAList]
    apply sptAListLookup_eq_of_mem_unique name (arity, body) _ member
    intro other otherMember
    have same : (name, other) = (name, arity, body) :=
      List.inj_on_of_nodup_map distinct otherMember member rfl
    exact congrArg Prod.snd same
  have partNames : (entries.map (compilePart64 conf)).map Prod.fst = entries.map Prod.fst := by
    rw [List.map_map]
    apply List.map_congr_left
    intro entry _
    obtain ⟨name, args, body⟩ := entry
    rfl
  constructor
  · intro name
    change sptDomain (sptFromAList output) name ↔ _
    rw [sptDomainFromAList, sptDomainFromAList]
    simp only [output, List.map_append, List.mem_append, partNames]
    exact or_comm
  constructor
  · intro name arity body member
    exact lookupEntry name arity body (List.mem_append_left _ member)
  · intro name arity body found
    rw [sptLookup_sptFromAList] at found
    have member := sptAListLookup_mem name entries (arity, body) found
    apply lookupEntry
    apply List.mem_append_right
    exact List.mem_map.mpr ⟨(name, arity, body), member, rfl⟩

end Flapjack.Compiler.Backend.DataToWord.Proofs.Gc
