import Flapjack.Compiler.Backend.DataToWord.Proofs.Correct.LessConst
import Flapjack.Compiler.Backend.DataToWord.Proofs.Correct.BoolTest

/-! Immediate byte values in the 64-bit simulation. -/
namespace Flapjack.Compiler.Backend.DataToWord.Proofs.Correct
open Flapjack Gc

/-- Every source byte fits the immediate integer representation. -/
theorem byte_small64 (byte : BitVec 8) : smallInt 64 (Int.ofNat byte.toNat) := by
  have bound := byte.isLt
  norm_num [smallInt] at bound ⊢
  omega

/-- The 64-bit tagged integer encoding of a byte is its zero-extended
bit pattern shifted by two bits. -/
theorem smallnum_byte64 (byte : BitVec 8) :
    (smallnum (Int.ofNat byte.toNat) : BitVec 64) = byte.setWidth 64 <<< 2 := by
  have nonnegative : ¬ ((byte.toNat : Int) < 0) := Int.not_lt.mpr (Int.natCast_nonneg _)
  simp [smallnum_eq_inlined, BitVec.ofNat_mul, nonnegative]
  bv_decide

/-- Equality and unsigned order of tagged bytes agree with their original
8-bit values. -/
theorem byte64_cmp (x y : BitVec 8) :
    ((smallnum (Int.ofNat x.toNat) : BitVec 64) = smallnum (Int.ofNat y.toNat) ↔ x = y) ∧
    ((smallnum (Int.ofNat x.toNat) : BitVec 64).ult (smallnum (Int.ofNat y.toNat)) = x.ult y) := by
  simp only [smallnum_byte64]
  constructor <;> bv_decide

/-- The expression emitted for an 8-bit binary operation. -/
def byteOpExpr64 (op : BackendCommon.Opw) (left right : Nat) : WordLangExpHOL (BitVec 64) :=
  let (binop, carried) := match lookupWordOp op with
    | .bitwise b => (b, false)
    | .carried b => (b, true)
  let value := WordLangExpHOL.op binop [.var (adjustVar left), .var (adjustVar right)]
  if carried then .shift .lsr (.shift .lsl value (.const 54)) (.const 54) else value

/-- Each generated byte operation produces the tagged result of the same
8-bit operation, including modular carry and borrow. -/
theorem byteOpExpr64_run {C F : Type} (target : WordSemStateFiniteExact 64 C F)
    (op : BackendCommon.Opw) (left right : Nat) (x y : BitVec 8)
    (leftRun : WordSemStateFiniteExact.getVar (adjustVar left) target = some (.word (smallnum (Int.ofNat x.toNat))))
    (rightRun : WordSemStateFiniteExact.getVar (adjustVar right) target = some (.word (smallnum (Int.ofNat y.toNat)))) :
    WordSemStateFiniteExact.wordExp target (byteOpExpr64 op left right) =
      some (.word (smallnum (Int.ofNat (ClosSem.applyWordOp op x y).toNat))) := by
  simp only [smallnum_byte64] at leftRun rightRun ⊢
  cases op <;> simp [byteOpExpr64, lookupWordOp, WordSemStateFiniteExact.wordExp, leftRun, rightRun,
    wordOpHOL, wordOp, theWords, wordShiftHOL, ClosSem.applyWordOp, AndOp.and, OrOp.or] <;> bv_decide

/-- Binary byte operations compile to the matching immediate operation and
preserve the 64-bit state relation. -/
theorem assignByteOp64 {C F : Type} (conf : Config) (secn label l1 l2 : Nat)
    (source : DataSem.State C F) (target : WordSemStateFiniteExact 64 C F)
    (locs : List (Nat × Nat)) (related : stateRel64 conf l1 l2 source target none locs)
    (dest left right : Nat) (op : BackendCommon.Opw) (x y : BitVec 8)
    (leftRun : DataSem.getVar left source.locals = some (.number (Int.ofNat x.toNat)))
    (rightRun : DataSem.getVar right source.locals = some (.number (Int.ofNat y.toNat))) :
    continues64 conf secn label l1 l2 (.assign dest (.wordOp (.wordOpw .w8 op)) [left, right] none) source target locs := by
  let operation := ClosLang.Op.wordOp (.wordOpw .w8 op)
  let args : List DataSem.Value := [.number (Int.ofNat x.toNat), .number (Int.ofNat y.toNat)]
  let middle := DataSem.doStack operation args (DataSem.doLimSafe source operation args)
  have middleRel : stateRel64 conf l1 l2 middle target none locs :=
    stateRel64_afterDoStack conf l1 l2 source target locs related operation args
  have leftWord := stateRel64_getSmallNumber conf l1 l2 source target locs related left _ leftRun (byte_small64 x)
  have rightWord := stateRel64_getSmallNumber conf l1 l2 source target locs related right _ rightRun (byte_small64 y)
  have run := byteOpExpr64_run target op left right x y leftWord rightWord
  let result := ClosSem.applyWordOp op x y
  refine ⟨DataSem.setVar dest (.number (Int.ofNat result.toNat)) middle,
    WordSemStateFiniteExact.setVar (adjustVar dest) (.word (smallnum (Int.ofNat result.toNat))) target, ?_, ?_, ?_⟩
  · simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, leftRun, rightRun,
      DataSem.cutStateOpt, DataSem.doApp, DataSem.doSpace, DataSpace.opSpaceReq, DataSem.doAppAux,
      DataSem.applyNonFfi, DataSem.doWordApp, DataSem.doWordAppIntegral, ClosSem.intToByte_toNat,
      DataSem.installSfs, operation, args, middle, result]
  · simp only [compileControl64, compileControl?, Option.getD_some]
    change WordSemStateFiniteExact.evaluate (.assign (adjustVar dest) (byteOpExpr64 op left right)) target = _
    change WordSemStateFiniteExact.wordExp target (byteOpExpr64 op left right) =
      some (.word (smallnum (Int.ofNat result.toNat))) at run
    simp only [WordSemStateFiniteExact.evaluate, run]
  · exact stateRel64_setSmallInt conf l1 l2 middle target locs middleRel dest _ (byte_small64 result)

/-- Source safety supplies two well-formed byte operands. -/
theorem assignByteOp64_of_safe {C F : Type} (conf : Config) (secn label l1 l2 : Nat)
    (source : DataSem.State C F) (target : WordSemStateFiniteExact 64 C F)
    (locs : List (Nat × Nat)) (related : stateRel64 conf l1 l2 source target none locs)
    (dest left right : Nat) (op : BackendCommon.Opw)
    (safe : (DataSem.evaluate (.assign dest (.wordOp (.wordOpw .w8 op)) [left, right] none) source).1 ≠
      some (.err (.abort .typeError))) :
    continues64 conf secn label l1 l2 (.assign dest (.wordOp (.wordOpw .w8 op)) [left, right] none) source target locs := by
  cases leftRun : DataSem.getVar left source.locals with
  | none => simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, leftRun] at safe
  | some first =>
    cases rightRun : DataSem.getVar right source.locals with
    | none => simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, leftRun, rightRun] at safe
    | some second =>
      cases first <;> cases second <;>
        simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, leftRun, rightRun,
          DataSem.cutStateOpt, DataSem.doApp, DataSem.doSpace, DataSpace.opSpaceReq, DataSem.doAppAux,
          DataSem.applyNonFfi, DataSem.doWordApp, DataSem.doWordAppIntegral, DataSem.doStack, DataSem.doLimSafe] at safe
      case number.number a b =>
        cases xa : ClosSem.intToByte a with
        | none => simp [xa] at safe
        | some x =>
          cases yb : ClosSem.intToByte b with
          | none => simp [xa, yb] at safe
          | some y =>
            have aEq := (ClosSem.intToByte_iff a x).mp xa
            have bEq := (ClosSem.intToByte_iff b y).mp yb
            subst a
            subst b
            exact assignByteOp64 conf secn label l1 l2 source target locs related dest left right op x y leftRun rightRun

end Flapjack.Compiler.Backend.DataToWord.Proofs.Correct
