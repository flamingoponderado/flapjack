import Flapjack.Compiler.Backend.DataToWord.Proofs.Correct.Word8

/-! Byte shifts and rotates in the 64-bit simulation. -/
namespace Flapjack.Compiler.Backend.DataToWord.Proofs.Correct
open Flapjack Gc Flapjack.SemanticPrimitivesHOL

/-- Logical and arithmetic byte shifts saturate at the byte width. -/
theorem byteShift_clamp (shift : Shift) (x : BitVec 8) (amount : Nat) (notRotate : shift ≠ .ror) :
    shift8Lookup shift x amount = shift8Lookup shift x (min amount 8) := by
  by_cases small : amount < 8
  · simp [Nat.min_eq_left (Nat.le_of_lt small)]
  · have large : 8 ≤ amount := by omega
    cases shift with
    | lsl => simp [shift8Lookup, Nat.min_eq_right large, BitVec.shiftLeft_eq_zero large]
    | lsr => simp [shift8Lookup, Nat.min_eq_right large, BitVec.ushiftRight_eq_zero large,
        BitVec.ushiftRight_eq_zero (show 8 ≤ 8 by decide)]
    | asr =>
      simp only [shift8Lookup, Nat.min_eq_right large]
      apply BitVec.eq_of_getLsbD_eq
      intro index bound
      simp only [BitVec.getLsbD_sshiftRight]
      have first : ¬ amount + index < 8 := by omega
      simp [first]
    | ror => exact False.elim (notRotate rfl)

/-- A byte rotate depends only on its count modulo eight. -/
theorem byteRotate_mod (x : BitVec 8) (amount : Nat) :
    shift8Lookup .ror x amount = shift8Lookup .ror x (amount % 8) := by
  simp [shift8Lookup, BitVec.rotateRight_mod_eq_rotateRight]

/-- The exact expression emitted by 64-bit data-to-word byte shifts. -/
def byteShiftExpr64 (shift : Shift) (amount src : Nat) : WordLangExpHOL (BitVec 64) :=
  let src := adjustVar src
  let count := min amount 8
  match shift with
  | .lsl => shiftN .lsr (shiftN .lsl (.var src) (54 + count)) 54
  | .lsr => shiftN .lsl (shiftN .lsr (.var src) (count + 2)) 2
  | .asr => shiftN .lsl (shiftN .lsr (shiftN .asr (shiftN .lsl (.var src) 54) count) 56) 2
  | .ror =>
    let n := amount % 8
    .op .or [shiftN .lsl (shiftVar .lsr src (n + 2)) 2,
      shiftN .lsr (shiftVar .lsl src (62 - n)) 54]

/-- The generated expression computes the encoded source byte shift,
including arbitrary shift counts and rotation modulo eight. -/
theorem byteShiftExpr64_run {C F : Type} (target : WordSemStateFiniteExact 64 C F)
    (shift : Shift) (amount src : Nat) (x : BitVec 8)
    (sourceRun : WordSemStateFiniteExact.getVar (adjustVar src) target = some (.word (smallnum (Int.ofNat x.toNat)))) :
    WordSemStateFiniteExact.wordExp target (byteShiftExpr64 shift amount src) =
      some (.word (smallnum (Int.ofNat (shift8Lookup shift x amount).toNat))) := by
  simp only [smallnum_byte64] at sourceRun ⊢
  cases shift with
  | lsl | lsr | asr =>
    rw [byteShift_clamp _ x amount (by decide)]
    generalize countEq : min amount 8 = count
    have countBound : count ≤ 8 := by omega
    interval_cases count <;>
      simp [byteShiftExpr64, countEq, shift8Lookup, shiftN, WordSemStateFiniteExact.wordExp,
        sourceRun, wordShiftHOL] <;> bv_decide
  | ror =>
    rw [byteRotate_mod x amount]
    generalize countEq : amount % 8 = count
    have countBound : count < 8 := by omega
    interval_cases count <;>
      simp [byteShiftExpr64, countEq, shift8Lookup, shiftN, shiftVar, WordSemStateFiniteExact.wordExp,
        sourceRun, wordShiftHOL, wordOpHOL, wordOp, theWords, OrOp.or] <;> bv_decide

/-- The generated byte-shift expression simulates the source operation. -/
theorem assignByteShift64 {C F : Type} (conf : Config) (secn label l1 l2 : Nat)
    (source : DataSem.State C F) (target : WordSemStateFiniteExact 64 C F)
    (locs : List (Nat × Nat)) (related : stateRel64 conf l1 l2 source target none locs)
    (dest src : Nat) (shift : Shift) (amount : Nat) (x : BitVec 8)
    (sourceRun : DataSem.getVar src source.locals = some (.number (Int.ofNat x.toNat))) :
    continues64 conf secn label l1 l2 (.assign dest (.wordOp (.wordShift .w8 shift amount)) [src] none) source target locs := by
  let operation := ClosLang.Op.wordOp (.wordShift .w8 shift amount)
  let args : List DataSem.Value := [.number (Int.ofNat x.toNat)]
  let middle := DataSem.doStack operation args (DataSem.doLimSafe source operation args)
  have middleRel : stateRel64 conf l1 l2 middle target none locs :=
    stateRel64_afterDoStack conf l1 l2 source target locs related operation args
  have sourceWord := stateRel64_getSmallNumber conf l1 l2 source target locs related src _ sourceRun (byte_small64 x)
  have run := byteShiftExpr64_run target shift amount src x sourceWord
  let result := shift8Lookup shift x amount
  refine ⟨DataSem.setVar dest (.number (Int.ofNat result.toNat)) middle,
    WordSemStateFiniteExact.setVar (adjustVar dest) (.word (smallnum (Int.ofNat result.toNat))) target, ?_, ?_, ?_⟩
  · simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, sourceRun,
      DataSem.cutStateOpt, DataSem.doApp, DataSem.doSpace, DataSpace.opSpaceReq, DataSem.doAppAux,
      DataSem.applyNonFfi, DataSem.doWordApp, DataSem.doWordAppIntegral, ClosSem.intToByte_toNat,
      DataSem.installSfs, operation, args, middle, result]
  · simp only [compileControl64, compileControl?, Option.getD_some]
    change WordSemStateFiniteExact.evaluate (.assign (adjustVar dest) (byteShiftExpr64 shift amount src)) target = _
    change WordSemStateFiniteExact.wordExp target (byteShiftExpr64 shift amount src) =
      some (.word (smallnum (Int.ofNat result.toNat))) at run
    simp only [WordSemStateFiniteExact.evaluate, run]
  · exact stateRel64_setSmallInt conf l1 l2 middle target locs middleRel dest _ (byte_small64 result)

/-- Source safety ensures the operand is a byte. -/
theorem assignByteShift64_of_safe {C F : Type} (conf : Config) (secn label l1 l2 : Nat)
    (source : DataSem.State C F) (target : WordSemStateFiniteExact 64 C F)
    (locs : List (Nat × Nat)) (related : stateRel64 conf l1 l2 source target none locs)
    (dest src : Nat) (shift : Shift) (amount : Nat)
    (safe : (DataSem.evaluate (.assign dest (.wordOp (.wordShift .w8 shift amount)) [src] none) source).1 ≠
      some (.err (.abort .typeError))) :
    continues64 conf secn label l1 l2 (.assign dest (.wordOp (.wordShift .w8 shift amount)) [src] none) source target locs := by
  cases sourceRun : DataSem.getVar src source.locals with
  | none => simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, sourceRun] at safe
  | some value =>
    cases value <;>
      simp [DataSem.evaluate, DataLang.opRequiresNames, DataLang.opSpaceReset, DataSem.getVars, sourceRun,
        DataSem.cutStateOpt, DataSem.doApp, DataSem.doSpace, DataSpace.opSpaceReq, DataSem.doAppAux,
        DataSem.applyNonFfi, DataSem.doWordApp, DataSem.doWordAppIntegral, DataSem.doStack, DataSem.doLimSafe] at safe
    case number i =>
      cases decoded : ClosSem.intToByte i with
      | none => simp [decoded] at safe
      | some x =>
        have eq := (ClosSem.intToByte_iff i x).mp decoded
        subst i
        exact assignByteShift64 conf secn label l1 l2 source target locs related dest src shift amount x sourceRun

end Flapjack.Compiler.Backend.DataToWord.Proofs.Correct
