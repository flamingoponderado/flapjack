module

public import Flapjack.Compiler.Backend.DataToWord.Proofs.Memory.Relation.StringCompare
public import Flapjack.Compiler.Backend.DataToWord.Stubs
public import Flapjack.Compiler.Backend.DataToWord.Proofs.Gc.StateRelation
public import Flapjack.Compiler.Backend.Semantics.WordSem.Evaluate

@[expose] public section

namespace Flapjack.Compiler.Backend.DataToWord.Proofs.Assign
open Flapjack Flapjack.Compiler.Backend Flapjack.Compiler.Backend.DataToWord
open Flapjack.Compiler.Backend.DataToWord.Proofs.Memory
open Flapjack.Compiler.Backend.DataToWord.Proofs.Gc

namespace StringCmpLoopWitness

/-- Canonical finite-map roundtrip for the word-state fields. -/
theorem holFmapAsFiniteSupportWitness {width : Nat} [NeZero width] {C F : Type} :
    (∀ (state : WordSemStateBroad width C F) (h : state.FiniteSupport),
      (WordSemStateBroad.ofBroad state h).toBroad = state) ∧
    (∀ state : WordSemStateFiniteExact width C F,
      WordSemStateBroad.ofBroad state.toBroad state.toBroad_finiteSupport = state) :=
  WordSemStateExact.holFmapAsFiniteSupportWitness

end StringCmpLoopWitness

/-- The generated byte-comparison loop implements the original word-level loop.
The evaluator inherits the real-model assumption in `docs/SOUNDNESS.md` item 8. -/
@[hol "cakeml/compiler/backend/proofs/data_to_word_assignProofScript.sml" "evaluate_StringCmpLoop"
  (fmap_as_finite_support := [fpRegs, store]) (words_as_type_indexed_bitvec)]
theorem evaluateStringCmpLoop {width : Nat} [NeZero width] {C F : Type}
    (a1 a2 r1 r2 len : BitVec width) (be : Bool) (ck : Nat)
    (dm : BitVec width → Bool) (m : BitVec width → WordLocW width) (l1 l2 : Nat)
    (t1 : WordSemStateFiniteExact width C F) (x1 x2 : BitVec width)
    (premises : wordStrCmpLoop a1 a2 r1 r2 len dm m be ck = some (x1,x2) ∧
      t1.memory = m ∧ t1.mdomain = dm ∧ be = t1.be ∧ ck < t1.clock ∧ goodDimindex width ∧
      sptLookup stringCmpLoopLocation t1.code = some (6,stringCmpLoopCode) ∧
      WordSemStateFiniteExact.getVar 0 t1 = some (.loc l1 l2) ∧
      WordSemStateFiniteExact.getVar 2 t1 = some (.word a1) ∧
      WordSemStateFiniteExact.getVar 4 t1 = some (.word a2) ∧
      WordSemStateFiniteExact.getVar 6 t1 = some (.word len) ∧
      WordSemStateFiniteExact.getVar 8 t1 = some (.word r1) ∧
      WordSemStateFiniteExact.getVar 10 t1 = some (.word r2)) :
    ∃ clock maxStack,
      WordSemStateFiniteExact.evaluate stringCmpLoopCode t1 =
        (some (.result (.loc l1 l2) [.word x1,.word x2]),
          {t1 with clock := clock, stackMax := maxStack, locals := .ln, localsSize := some 0}) ∧
      (maxStack ≠ t1.stackMax → maxStack = Option.map₂ max t1.stackMax
        (Option.map₂ (· + ·) (wordSemStackSize t1.stack) (sptLookup stringCmpLoopLocation t1.stackSize))) := by
  induction ck generalizing a1 a2 r1 r2 len be dm m l1 l2 t1 x1 x2 with
  | zero => simp [wordStrCmpLoop] at premises
  | succ ck ih =>
    obtain ⟨loop, hmem, hdom, hbe, hclock, good, hcode, h0, h2, h4, h6, h8, h10⟩ := premises
    change sptLookup 0 t1.locals = some (.loc l1 l2) at h0
    change sptLookup 2 t1.locals = some (.word a1) at h2
    change sptLookup 4 t1.locals = some (.word a2) at h4
    change sptLookup 6 t1.locals = some (.word len) at h6
    change sptLookup 8 t1.locals = some (.word r1) at h8
    change sptLookup 10 t1.locals = some (.word r2) at h10
    by_cases hlen : len = wordSemBytesInWord
    · simp [wordStrCmpLoop, hlen] at loop
      obtain ⟨rfl,rfl⟩ := loop
      refine ⟨t1.clock, t1.stackMax, ?_, by simp⟩
      simp [stringCmpLoopCode, WordSemStateFiniteExact.evaluate, WordSemStateFiniteExact.getVarImm,
        WordSemStateFiniteExact.getVar, WordSemStateFiniteExact.getVars, WordSemStateFiniteExact.flushState, wordSemWordCmp, h0,h6,h8,h10,
        hlen, wordSemBytesInWord, Compiler.Encoders.Asm.wordCmpHOL]
    · simp only [wordStrCmpLoop, if_neg hlen] at loop
      cases read1 : memLoadByteAuxExact m dm be a1 with
      | none => simp [read1] at loop
      | some b1 =>
        cases read2 : memLoadByteAuxExact m dm be a2 with
        | none => simp [read1, read2] at loop
        | some b2 =>
          simp only [read1, read2] at loop
          by_cases bytesEq : b1 = b2
          · subst b2
            simp only at loop
            let size := sptLookup stringCmpLoopLocation t1.stackSize
            let next := WordSemStateFiniteExact.callEnv
              [.loc l1 l2, .word (a1 + 1), .word (a2 + 1), .word (len - 1), .word r1, .word r2] size
              {t1 with clock := t1.clock - 1}
            have nextPremises : wordStrCmpLoop (a1 + 1) (a2 + 1) r1 r2 (len - 1) dm m be ck = some (x1,x2) ∧
                next.memory = m ∧ next.mdomain = dm ∧ be = next.be ∧ ck < next.clock ∧ goodDimindex width ∧
                sptLookup stringCmpLoopLocation next.code = some (6,stringCmpLoopCode) ∧
                WordSemStateFiniteExact.getVar 0 next = some (.loc l1 l2) ∧
                WordSemStateFiniteExact.getVar 2 next = some (.word (a1 + 1)) ∧
                WordSemStateFiniteExact.getVar 4 next = some (.word (a2 + 1)) ∧
                WordSemStateFiniteExact.getVar 6 next = some (.word (len - 1)) ∧
                WordSemStateFiniteExact.getVar 8 next = some (.word r1) ∧
                WordSemStateFiniteExact.getVar 10 next = some (.word r2) := by
              refine ⟨loop, ?_, ?_, ?_, ?_, good, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
              · simpa [next, WordSemStateFiniteExact.callEnv] using hmem
              · simpa [next, WordSemStateFiniteExact.callEnv] using hdom
              · simpa [next, WordSemStateFiniteExact.callEnv] using hbe
              · simp only [next, WordSemStateFiniteExact.callEnv]; omega
              · simpa [next, WordSemStateFiniteExact.callEnv] using hcode
              all_goals simp [next, WordSemStateFiniteExact.callEnv, WordSemStateFiniteExact.getVar,
                sptFromList2, sptInsert, sptLookup]
            obtain ⟨outClock, outMax, nextRun, stackBound⟩ :=
              ih (a1 + 1) (a2 + 1) r1 r2 (len - 1) be dm m l1 l2 next x1 x2 nextPremises
            have resultEq : WordSemStateFiniteExact.evaluate stringCmpLoopCode next =
                (some (.result (.loc l1 l2) [.word x1,.word x2]),
                  {t1 with clock := outClock, stackMax := outMax, locals := .ln, localsSize := some 0}) := by
              simpa [next, WordSemStateFiniteExact.callEnv] using nextRun
            refine ⟨outClock, outMax, ?_, ?_⟩
            · have testFalse : Compiler.Encoders.Asm.wordCmpHOL .equal len (BitVec.ofNat width (width / 8)) = false := by
                change (len == BitVec.ofNat width (width / 8)) = false
                simpa [wordSemBytesInWord] using hlen
              simp only [stringCmpLoopCode, WordSemStateFiniteExact.evaluate, WordSemStateFiniteExact.getVarImm,
                WordSemStateFiniteExact.getVar, wordSemWordCmp, h6, testFalse]
              simp [wordListSeq, WordSemStateFiniteExact.evaluate, WordSemStateFiniteExact.fixClock,
                WordSemStateFiniteExact.getVarImm, WordSemStateFiniteExact.getVars, wordSemWordCmp,
                WordSemStateFiniteExact.inst, WordSemStateFiniteExact.wordExp,
                WordSemStateFiniteExact.getVar, WordSemStateFiniteExact.setVar,
                sptLookup_sptInsert_same, sptLookup_sptInsert_ne, theWords, wordOpHOL, wordOp,
                h0,h2,h4, hmem,hdom, ← hbe,read1,read2]
              simp [Compiler.Encoders.Asm.wordCmpHOL, sptLookup_sptInsert_same, sptLookup_sptInsert_ne,
                h0,h2,h4,h6,h8,h10]
              have clockPositive : t1.clock ≠ 0 := by omega
              simp [wordSemBadDestArgs, wordSemAddRetLoc, wordSemFindCode, hcode, clockPositive,
                WordSemStateFiniteExact.decClock, wordSemBadFunReturn]
              simp only [next, WordSemStateFiniteExact.callEnv, size, hmem, hdom, ← hbe, BitVec.ofNat_eq_ofNat] at resultEq
              simp only [WordSemStateFiniteExact.callEnv]
              simp only [resultEq]
              rfl
            · simp only [next, WordSemStateFiniteExact.callEnv, size] at stackBound
              have optMax (a b : Option Nat) : wordSemOptionMax a b = Option.map₂ max a b := by
                cases a <;> cases b <;> rfl
              have optAdd (a b : Option Nat) : wordSemOptionAdd a b = Option.map₂ (· + ·) a b := by
                cases a <;> cases b <;> rfl
              have idem (a b : Option Nat) : Option.map₂ max (Option.map₂ max a b) b = Option.map₂ max a b := by
                cases a <;> cases b <;> simp [Option.map₂]
              rw [optMax, optAdd, idem] at stackBound
              intro _
              by_contra hn
              exact hn (stackBound hn)
          · simp [bytesEq] at loop
            obtain ⟨rfl,rfl⟩ := loop
            have castNe : b1.setWidth width ≠ b2.setWidth width := by
              intro heq
              have natEq := congrArg BitVec.toNat heq
              have wge : 8 ≤ width := by rcases good with hw | hw <;> omega
              simp only [BitVec.toNat_setWidth_of_le wge] at natEq
              exact bytesEq (BitVec.eq_of_toNat_eq natEq)
            have testFalse : Compiler.Encoders.Asm.wordCmpHOL .equal len (BitVec.ofNat width (width / 8)) = false := by
              change (len == BitVec.ofNat width (width / 8)) = false
              simpa [wordSemBytesInWord] using hlen
            have byteTest : (b1.setWidth width == b2.setWidth width) = false := by simpa using castNe
            refine ⟨t1.clock, t1.stackMax, ?_, by simp⟩
            simp only [stringCmpLoopCode, WordSemStateFiniteExact.evaluate, WordSemStateFiniteExact.getVarImm,
              WordSemStateFiniteExact.getVar, wordSemWordCmp, h6, testFalse]
            simp [wordListSeq, WordSemStateFiniteExact.evaluate, WordSemStateFiniteExact.fixClock, WordSemStateFiniteExact.getVarImm,
              WordSemStateFiniteExact.getVars, WordSemStateFiniteExact.flushState, wordSemWordCmp,
              WordSemStateFiniteExact.inst, WordSemStateFiniteExact.wordExp,
              WordSemStateFiniteExact.getVar, WordSemStateFiniteExact.setVar,
              sptLookup_sptInsert_same, sptLookup_sptInsert_ne,
              theWords, wordOpHOL, wordOp, h0,h2,h4,
              Compiler.Encoders.Asm.wordCmpHOL,
              hmem, hdom, ← hbe, read1, read2]
            simp [byteTest]

end Flapjack.Compiler.Backend.DataToWord.Proofs.Assign
