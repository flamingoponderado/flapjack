module

public import Flapjack.Compiler.Backend.FlatPattern.Proofs.ValueRelationRules

@[expose] public section

/-! Induction in the source shape for the flat-pattern mutual relation. -/
namespace Flapjack.Compiler.Backend.FlatPattern
open Flapjack.Compiler.Backend.FlatSem Flapjack.Compiler.Backend.FlatProps

/-- The induction theorem generated by HOL’s mutual relation. -/
@[hol "cakeml/compiler/backend/proofs/flat_patternProofScript.sml" "v_rel_ind"]
theorem valueEnvRel_source_induction
    (P : Value → Value → Prop) (Q : Nat → Environment Value → Environment Value → Prop)
    (basic : ∀ left right, simpleBasicValRel left right ∧
      List.Forall₂ P (valueContainerXs left) (valueContainerXs right) → P left right)
    (closure : ∀ n left name body right cfg, Q n left right ∧ (compileExp cfg body).1 < n →
      P (.closure left name body) (.closure right name (compileExp cfg body).2.2))
    (recclosure : ∀ n left funs name right cfg, Q n left right ∧
      (∀ entry ∈ funs, (compileExp cfg entry.2.2).1 < n) →
      P (.recclosure left funs name)
        (.recclosure right (funs.map fun (f, x, body) => (f, x, (compileExp cfg body).2.2)) name))
    (env : ∀ n left right,
      aLookupRel (fun name => decNameToNum name < n) P left.v right.v → Q n left right) :
    (∀ left right, ValueRel left right → P left right) ∧
      ∀ n left right, EnvRel n left right → Q n left right := by
  have basicStep {left right : Value} (shape : simpleBasicValRel left right)
      (_ : List.Forall₂ ValueRel (valueContainerXs left) (valueContainerXs right))
      (ih : List.Forall₂ P (valueContainerXs left) (valueContainerXs right)) : P left right :=
    basic left right ⟨shape, ih⟩
  have closureStep {n : Nat} {left : Environment Value} {name : Flapjack.AstHOL.VarN}
      {body : FlatLang.Exp} {right : Environment Value} {cfg : Config}
      (_ : EnvRel n left right) (bound : (compileExp cfg body).1 < n) (ih : Q n left right) :
      P (.closure left name body) (.closure right name (compileDec cfg body)) :=
    closure n left name body right cfg ⟨ih, bound⟩
  have recclosureStep {n : Nat} {left : Environment Value}
      {funs : List (Flapjack.AstHOL.VarN × Flapjack.AstHOL.VarN × FlatLang.Exp)}
      {name : Flapjack.AstHOL.VarN} {right : Environment Value} {cfg : Config}
      (_ : EnvRel n left right) (bounds : ∀ entry ∈ funs, (compileExp cfg entry.2.2).1 < n)
      (ih : Q n left right) :
      P (.recclosure left funs name)
        (.recclosure right (funs.map fun (f, x, body) => (f, x, compileDec cfg body)) name) :=
    recclosure n left funs name right cfg ⟨ih, bounds⟩
  have envStep {n : Nat} {left right : Environment Value}
      (domain : ∀ name, decNameToNum name < n →
        (holALookup left.v name).isSome = (holALookup right.v name).isSome)
      (_ : ∀ name v v', decNameToNum name < n → holALookup left.v name = some v →
        holALookup right.v name = some v' → ValueRel v v')
      (ih : ∀ name v v', decNameToNum name < n → holALookup left.v name = some v →
        holALookup right.v name = some v' → P v v') : Q n left right := by
    apply env n left right
    intro name bound
    have same := domain name bound
    cases leftEq : holALookup left.v name with
    | none =>
      cases rightEq : holALookup right.v name with
      | none => trivial
      | some value => simp [leftEq, rightEq] at same
    | some value =>
      cases rightEq : holALookup right.v name with
      | none => simp [leftEq, rightEq] at same
      | some value' => exact ih name value value' bound leftEq rightEq
  have listStep {a b : Value} {xs ys : List Value}
      (_ : ValueRel a b) (_ : List.Forall₂ ValueRel xs ys)
      (head : P a b) (tail : List.Forall₂ P xs ys) : List.Forall₂ P (a :: xs) (b :: ys) :=
    .cons head tail
  refine ⟨?_, ?_⟩
  · intro left right related
    exact ValueRel.rec (motive_1 := fun left right _ => P left right)
      (motive_2 := fun n left right _ => Q n left right)
      (motive_3 := fun xs ys _ => List.Forall₂ P xs ys)
      basicStep closureStep recclosureStep envStep .nil listStep related
  · intro n left right related
    exact EnvRel.rec (motive_1 := fun left right _ => P left right)
      (motive_2 := fun n left right _ => Q n left right)
      (motive_3 := fun xs ys _ => List.Forall₂ P xs ys)
      basicStep closureStep recclosureStep envStep .nil listStep related

/-- The cases theorem generated by HOL’s mutual relation. -/
@[hol "cakeml/compiler/backend/proofs/flat_patternProofScript.sml" "v_rel_cases"]
theorem valueEnvRel_source_cases :
    (∀ left right, ValueRel left right ↔
      (simpleBasicValRel left right ∧
        List.Forall₂ ValueRel (valueContainerXs left) (valueContainerXs right)) ∨
      (∃ n env1 name body env2 cfg,
        left = .closure env1 name body ∧ right = .closure env2 name (compileExp cfg body).2.2 ∧
        EnvRel n env1 env2 ∧ (compileExp cfg body).1 < n) ∨
      (∃ n env1 funs name env2 cfg,
        left = .recclosure env1 funs name ∧
        right = .recclosure env2 (funs.map fun (f, x, body) => (f, x, (compileExp cfg body).2.2)) name ∧
        EnvRel n env1 env2 ∧ ∀ entry ∈ funs, (compileExp cfg entry.2.2).1 < n)) ∧
    (∀ n left right, EnvRel n left right ↔
      aLookupRel (fun name => decNameToNum name < n) ValueRel left.v right.v) := by
  constructor
  · intro left right
    constructor
    · intro related
      cases related with
      | basic shape contents => exact .inl ⟨shape, contents⟩
      | @closure n env1 name body env2 cfg env bound =>
        exact .inr (.inl ⟨n, env1, name, body, env2, cfg, rfl, rfl, env, bound⟩)
      | @recclosure n env1 funs name env2 cfg env bounds =>
        exact .inr (.inr ⟨n, env1, funs, name, env2, cfg, rfl, rfl, env, bounds⟩)
    · rintro (⟨shape, contents⟩ | ⟨n, env1, name, body, env2, cfg, rfl, rfl, env, bound⟩ |
        ⟨n, env1, funs, name, env2, cfg, rfl, rfl, env, bounds⟩)
      · exact .basic shape contents
      · exact .closure env bound
      · exact .recclosure env bounds
  · exact envRel_iff_lookup

end Flapjack.Compiler.Backend.FlatPattern
