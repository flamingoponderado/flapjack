public import Flapjack.Compiler.Backend.ClosToBvl.Proofs.CallOracle
public import Flapjack.Compiler.Backend.ClosToBvl.Proofs.IncrementalAddresses
public import Flapjack.Compiler.Backend.ClosToBvl.WholeProgram
public import Flapjack.Compiler.Backend.ClosAnnotate.Original
import Flapjack.Compiler.Backend.ClosToBvl.Proofs.NumberOracle
import Flapjack.Compiler.Backend.ClosToBvl.Proofs.KnownAddresses
import Flapjack.Compiler.Backend.ClosToBvl.Proofs.CallAddresses
import Flapjack.Compiler.Backend.ClosToBvl.Proofs.AnnotationAddresses
import Flapjack.Compiler.Backend.ClosToBvl.Proofs.IncrementalOracle
import Flapjack.Compiler.Backend.ClosToBvl.Proofs.MtiInvariants
@[expose] public section

/-! Label ordering for the complete incremental BVL oracle. -/
namespace Flapjack.Compiler.Backend.ClosToBvl
open Flapjack ClosLang ClosProps BackendProps

/-- The compiled BVL oracle produces increasing labels above the shifted initial counter. -/
@[hol "cakeml/compiler/backend/proofs/clos_to_bvlProofScript.sml" "syntax_oracle_ok_bvl_FST_monotonic"]
theorem syntaxOracleOk_bvlFst_monotonic {α : Type} (c c' : Config) (es : List ClosLang.Exp)
    (co : Nat → (Nat × Spt ClosKnown.ValApprox × NumSet × α) × ClosSem.Program)
    (prog : List (Nat × Nat × Bvl.Exp) × Spt Flapjack.Basis.Pure.MlString.MlString)
    (h : syntaxOracleOkCommon c c' es co ∧ compileSource c es = (c', prog)) :
    oracleMonotonic
      (fun entry : α × List (Nat × Nat × Bvl.Exp) => {x | x ∈ entry.2.map Prod.fst})
      (· < ·) {x | x < (co 0).1.1 + numStubs c.maxApp}
      (pureCo (compileInc c.maxApp) ∘ pureCo ClosAnnotate.compileIncSource ∘
        stateCo (ClosCall.condCallCompileInc c.doCall)
        (ClosKnown.knownCo c.knownConf
          (stateCo (ClosNumber.ignoreTable ClosNumber.compileInc)
            (pureCo (ClosMti.condCompileInc c.doMti c.maxApp) ∘ co)))) := by
  let mco := pureCo (ClosMti.condCompileInc c.doMti c.maxApp) ∘ co
  let nco := stateCo (ClosNumber.ignoreTable ClosNumber.compileInc) mco
  let kco := ClosKnown.knownCo c.knownConf nco
  let aco := stateCo (ClosCall.condCallCompileInc c.doCall) kco
  let qco := pureCo ClosAnnotate.compileIncSource ∘ aco
  let start : Set Nat := {x | x < (co 0).1.1 + numStubs c.maxApp}
  have horacle := h.1
  simp only [syntaxOracleOkCommon] at horacle
  have empty : ∀ i, (mco i).2.2 = [] := by
    intro i
    have h := horacle.1 i
    cases hen : c.doMti <;>
      simp [mco, pureCo, Function.comp_def, ClosMti.condCompileInc, ClosMti.compileInc, hen, h]
  have state : isStateOracle (ClosNumber.ignoreTable ClosNumber.compileInc) mco := by
    exact horacle.2.2.2.2.2.2.2.2
  have initial : (mco 0).1.1 = (co 0).1.1 := rfl
  have orderedN := renumberCodeLocs_monotonic_req mco start (numStubs c.maxApp)
    ⟨state, by simp [start, initial], empty⟩
  have extractN : ∀ i, canExtract (nco i).2.1 := by
    intro i
    exact (numberCompileInc_req (mco i).1.1 (mco i).2 (empty i)).2.2
  have extractK : ∀ i, canExtract (kco i).2.1 := by
    intro i
    exact (knownCo_req nco i c.knownConf (extractN i)).2.1
  have extractA : ∀ i, canExtract (aco i).2.1 := by
    intro i
    exact (condCallCompileInc_req (kco i).2 c.doCall (kco i).1.1 (extractK i)).2.1
  have orderedK := subsetReqOrac_to_oracle [Nat.succ] (numStubs c.maxApp + ·) (· < ·) start
    nco kco [Nat.succ] ⟨by intro i; exact (knownCo_req nco i c.knownConf (extractN i)).2.2, orderedN⟩
  have orderedA := subsetReqOrac_to_oracle [] (numStubs c.maxApp + ·) (· < ·) start
    kco aco [Nat.succ] ⟨by intro i; exact (condCallCompileInc_req (kco i).2 c.doCall (kco i).1.1 (extractK i)).2.2, orderedK⟩
  have orderedQ := subsetReqOrac_to_oracle [] (numStubs c.maxApp + ·) (· < ·) start
    aco qco [] ⟨by intro i; exact (annotateCompileInc_req (aco i).2 (extractA i)).2.2, orderedA⟩
  exact compileInc_monotonic c.maxApp start qco orderedQ
/-- Each phase preserves distinctness of the labels generated by incremental compilation. -/
@[hol "cakeml/compiler/backend/proofs/clos_to_bvlProofScript.sml" "compile_inc_phases_all_distinct"]
theorem compileInc_phases_allDistinct {α : Type}
    (orac : Nat → (Nat × Spt ClosKnown.ValApprox × α) × ClosSem.Program) (i maxApp : Nat)
    (dc : Bool) (cSt : NumSet) (kc : Option ClosKnown.Config) :
    (orac i).2.2 = [] →
    ((compileInc maxApp (ClosAnnotate.compileIncSource
      (ClosCall.condCallCompileInc dc cSt
        (ClosKnown.knownCo kc (stateCo (ClosNumber.ignoreTable ClosNumber.compileInc) orac) i).2).2)).map
      Prod.fst).Nodup := by
  intro empty
  let nco := stateCo (ClosNumber.ignoreTable ClosNumber.compileInc) orac
  let kn := ClosKnown.knownCo kc nco i
  let called := (ClosCall.condCallCompileInc dc cSt kn.2).2
  have numbered := numberCompileInc_req (orac i).1.1 (orac i).2 empty
  have numberDist : (reqCompileIncAddrs [Nat.succ] (nco i).2).Nodup := numbered.1
  have numberExt : canExtract (nco i).2.1 := numbered.2.2
  have known := knownCo_req nco i kc numberExt
  have call := condCallCompileInc_req kn.2 dc cSt known.2.1
  have ann := annotateCompileInc_req called call.2.1
  exact (compileInc_reqAddrs (ClosAnnotate.compileIncSource called) maxApp).1
    (ann.1 (call.1 (known.1 numberDist)))

end Flapjack.Compiler.Backend.ClosToBvl
