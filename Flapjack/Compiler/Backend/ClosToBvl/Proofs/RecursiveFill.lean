module

public import Flapjack.Compiler.Backend.ClosToBvl.Proofs.RecursiveSteps
public import Flapjack.FiniteMap.MapKeys

@[expose] public section

/-! Repeated writes in generated recursive closure construction. -/
namespace Flapjack.Compiler.Backend.ClosToBvl
open Flapjack.SemanticPrimitivesHOL

/-- Closure blocks generated by the remaining reversed arities. The index
counts remaining writes, matching `reccLetsHOL`. -/
def recursiveBlocks (base ptr : Nat) : List Nat → Nat → List BvlSem.Value
  | _, 0 => []
  | [], _ + 1 => []
  | arity :: rest, index + 1 =>
    recursiveBlocks base ptr rest index ++
      [.block 30 [.codePtr (base + 2 * index), .number (Int.ofNat (arity - 1)), .refPtr true ptr]]

/-- Updating the last placeholder exposes one new completed array entry. -/
theorem set_last_placeholder {α : Type} (count : Nat) (zero value : α) (suffix : List α) :
    (List.replicate (count + 1) zero ++ suffix).set count value =
      List.replicate count zero ++ value :: suffix := by
  induction count with
  | zero => simp
  | succ count ih =>
    simp only [List.replicate_succ, List.cons_append, List.set_cons_succ]
    exact congrArg (List.cons zero) ih

/-- Replacing the same finite-map key twice keeps only the last value. -/
theorem updateEq_twice_same {α β : Type} [DecidableEq α] (map : HolFiniteMapExact α β)
    (key : α) (first last : β) :
    (map.updateEq (key, first)).updateEq (key, last) = map.updateEq (key, last) := by
  apply HolFiniteMapExact.ext_lookup
  intro query
  by_cases equal : query = key <;> simp [HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL, equal]

/-- Replacing a map entry by its existing value is the identity. -/
theorem updateEq_existing {α β : Type} [DecidableEq α] (map : HolFiniteMapExact α β)
    (key : α) (value : β) (found : map.lookup key = some value) :
    map.updateEq (key, value) = map := by
  apply HolFiniteMapExact.ext_lookup
  intro query
  by_cases equal : query = key
  · subst query; simp [HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL, found]
  · simp [HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL, equal]

/-- The recursive write loop replaces all remaining placeholders, keeps the
already completed suffix and captured values, and enters the body with the
new closure blocks in the corresponding environment order. -/
theorem evaluate_reccLets_fill {C F : Type} (count : Nat) (arities : List Nat)
    (state : BvlSem.State C F) (env : List BvlSem.Value)
    (ptr base previousLabel : Nat) (previousArity : Int)
    (finished captured : List BvlSem.Value) (body : Bvl.Exp)
    (arityLength : arities.length = count)
    (lookup : state.refs.lookup ptr = some (.valueArray (List.replicate count (.number 0) ++ finished ++ captured)))
    (labels : ∀ index, index < count → ∃ entry, sptLookup (base + 2 * index) state.code = some entry) :
    let oldClosure := BvlSem.Value.block 30 [.codePtr previousLabel, .number previousArity, .refPtr true ptr]
    let blocks := recursiveBlocks base ptr arities count
    let next := { state with refs := state.refs.updateEq (ptr, .valueArray (blocks ++ finished ++ captured)) }
    BvlSem.evaluate [reccLetsHOL base arities count body] (oldClosure :: env) state =
      BvlSem.evaluate [body] (blocks ++ oldClosure :: env) next := by
  induction count generalizing arities state env previousLabel previousArity finished with
  | zero =>
    have unchanged : state.refs.updateEq (ptr, .valueArray (finished ++ captured)) = state.refs := by
      apply updateEq_existing
      simpa using lookup
    simp [reccLetsHOL, recursiveBlocks, unchanged]
  | succ count ih =>
    cases arities with
    | nil => simp at arityLength
    | cons arity rest =>
      have restLength : rest.length = count := by simp at arityLength; omega
      let oldClosure := BvlSem.Value.block 30 [.codePtr previousLabel, .number previousArity, .refPtr true ptr]
      let block := BvlSem.Value.block 30 [.codePtr (base + 2 * count),
        .number (Int.ofNat (arity - 1)), .refPtr true ptr]
      let current := List.replicate (count + 1) (BvlSem.Value.number 0) ++ finished ++ captured
      have currentLookup : state.refs.lookup ptr = some (.valueArray current) := lookup
      have indexBound : count < current.length := by simp [current]; omega
      have label := labels count (by omega)
      have write := evaluate_reccLet state env ptr (base + 2 * count) arity count previousLabel previousArity
        current label currentLookup indexBound
      have step : BvlSem.evaluate [reccLetsHOL base (arity :: rest) (count + 1) body]
          (oldClosure :: env) state =
          BvlSem.evaluate [reccLetsHOL base rest count body] (block :: oldClosure :: env)
            { state with refs := state.refs.updateEq (ptr, .valueArray (current.set count block)) } := by
        change BvlSem.evaluate [.let [reccLet (base + 2 * count) arity count]
          (reccLetsHOL base rest count body)] (oldClosure :: env) state = _
        rw [BvlSem.evaluate, BvlSem.fixClock_evaluate, write]
        rfl
      have setEq : current.set count block = List.replicate count (.number 0) ++ (block :: finished) ++ captured := by
        simpa [current, List.append_assoc] using
          set_last_placeholder count (BvlSem.Value.number 0) block (finished ++ captured)
      let nextState := { state with refs := state.refs.updateEq (ptr, .valueArray (current.set count block)) }
      have nextLookup : nextState.refs.lookup ptr = some (.valueArray
          (List.replicate count (.number 0) ++ (block :: finished) ++ captured)) := by
        simp [nextState, HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL, setEq]
      have nextLabels : ∀ index, index < count → ∃ entry, sptLookup (base + 2 * index) nextState.code = some entry := by
        intro index bound
        exact labels index (by omega)
      have nextRun := ih rest nextState (oldClosure :: env) (base + 2 * count) (Int.ofNat (arity - 1))
        (block :: finished) restLength nextLookup nextLabels
      change BvlSem.evaluate [reccLetsHOL base (arity :: rest) (count + 1) body] (oldClosure :: env) state = _
      rw [step]
      simpa [recursiveBlocks, block, oldClosure, nextState, updateEq_twice_same, List.append_assoc] using nextRun

/-- Remaining reversed arities produce blocks in source order, with labels
matching their zero-based positions. -/
theorem recursiveBlocks_reverse (base ptr : Nat) (arities : List Nat) :
    recursiveBlocks base ptr arities arities.length =
      arities.reverse.zipIdx.map (fun (arity, index) =>
        BvlSem.Value.block 30 [.codePtr (base + 2 * index), .number (Int.ofNat (arity - 1)), .refPtr true ptr]) := by
  induction arities with
  | nil => rfl
  | cons arity rest ih =>
    simp [recursiveBlocks, ih, List.reverse_cons, List.zipIdx_append]

/-- The indexed source-order blocks agree with the recursive write layout. -/
private theorem recursiveBlocks_zipWith (base ptr : Nat) (arities : List Nat) (last : Nat) :
    (List.range (arities.length + 1)).zipWith
      (fun n arity => BvlSem.Value.block 30 [.codePtr (base + 2*n), .number (Int.ofNat (arity-1)), .refPtr true ptr])
      (arities ++ [last]) =
    recursiveBlocks base ptr arities.reverse arities.length ++
      [.block 30 [.codePtr (base + 2*arities.length), .number (Int.ofNat (last-1)), .refPtr true ptr]] := by
  have h := recursiveBlocks_reverse base ptr arities.reverse
  simp only [List.length_reverse, List.reverse_reverse] at h
  rw [h, List.range_succ, List.zipWith_append (by simp)]
  simp only [List.zipWith_cons_cons, List.zipWith_nil_left, List.append_cancel_right_eq]
  rw [List.zipWith_comm, ← List.map_uncurry_zip_eq_zipWith, List.zipIdx_eq_zip_range']
  simp [← List.range_eq_range']


namespace RecursiveFillCarrier
/-- Canonical BVL reference-map state representation roundtrip. -/
theorem holFmapAsFiniteSupportWitness {C F : Type} :
    (∀ s : BvlSem.StateBroad C F, (BvlSem.State.ofBroad s).toBroad = s) ∧
    (∀ s : BvlSem.State C F, BvlSem.State.ofBroad s.toBroad = s) :=
  BvlSem.holFmapAsFiniteSupportWitness
end RecursiveFillCarrier

/-- The recursive writes construct the source's indexed closure environment and array. -/
@[hol "cakeml/compiler/backend/proofs/clos_to_bvlProofScript.sml" "evaluate_recc_Lets"
  (fmap_as_finite_support := [refs])]
theorem evaluateReccLets {α C F : Type} (ll : List (Nat × α)) (n7 ns rr : Nat)
    (env : List BvlSem.Value) (t : Flapjack.Compiler.Backend.BvlSem.State C F) (ys : List BvlSem.Value)
    (c8 : List Bvl.Exp) (x x' : Nat × α) (ck : Nat)
    (labels : ∀ n ∈ List.range ll.length, sptDomain t.code (n7 + ns + 2*n)) :
    let block := fun n arity => BvlSem.Value.block 30
      [.codePtr (n7 + ns + 2*n), .number (Int.ofNat (arity - 1)), .refPtr true rr]
    let zeroes := (ll.map Prod.fst).map (fun _ => BvlSem.Value.number 0)
    let initial := zeroes ++ [.block 30 [.codePtr (n7 + (ns + 2*ll.length)), .number (Int.ofNat (x'.1 - 1)), .refPtr true rr]] ++ ys
    let body := @Flapjack.holHd Bvl.Exp ⟨.var 0⟩ c8
    BvlSem.evaluate [reccLetsHOL (n7 + ns) (ll.map Prod.fst).reverse ll.length body]
      (.block 30 [.codePtr (n7 + (ns + 2*ll.length)), .number (Int.ofNat (x.1 - 1)), .refPtr true rr] :: env) { t with refs := t.refs.updateEq (rr, .valueArray initial), clock := ck } =
    BvlSem.evaluate [body]
      ((List.range (ll.length + 1)).zipWith block (ll.map Prod.fst ++ [x.1]) ++ env)
      { t with refs := t.refs.updateEq (rr, .valueArray
          ((List.range (ll.length + 1)).zipWith block (ll.map Prod.fst ++ [x'.1]) ++ ys)), clock := ck } := by
  let block := fun n arity => BvlSem.Value.block 30
    [.codePtr (n7 + ns + 2*n), .number (Int.ofNat (arity - 1)), .refPtr true rr]
  let zeros := List.replicate ll.length (BvlSem.Value.number 0)
  let state := { t with refs := t.refs.updateEq (rr, .valueArray (zeros ++ [block ll.length x'.1] ++ ys)), clock := ck }
  have lookup : state.refs.lookup rr = some (.valueArray (zeros ++ [block ll.length x'.1] ++ ys)) := by
    simp [state, HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL]
  have domain : ∀ i, i < ll.length → ∃ entry, sptLookup (n7 + ns + 2*i) state.code = some entry := by
    intro i bound
    have h := labels i (List.mem_range.mpr bound)
    simp only [sptDomain] at h
    cases e : sptLookup (n7 + ns + 2*i) t.code with
    | none => simp [e] at h
    | some entry => exact ⟨entry, rfl⟩
  have run := evaluate_reccLets_fill ll.length (ll.map Prod.fst).reverse state env rr (n7 + ns)
    (n7 + ns + 2*ll.length) (Int.ofNat (x.1-1)) [block ll.length x'.1] ys
    (@Flapjack.holHd Bvl.Exp ⟨.var 0⟩ c8) (by simp) lookup domain
  have bx := recursiveBlocks_zipWith (n7+ns) rr (ll.map Prod.fst) x.1
  have bx' := recursiveBlocks_zipWith (n7+ns) rr (ll.map Prod.fst) x'.1
  simp only [List.length_map] at bx bx'
  simp only [bx, bx']
  simpa [state, zeros, block, List.map_map, Function.comp_def, List.map_const', List.length_map, updateEq_twice_same, List.append_assoc, Nat.add_assoc] using run

/-- The recursive write loop's block list is the same target layout used by
the closure-value relation, for the compiled source function order. -/
theorem recursiveBlocks_eq_recursiveValues (functions : List (Nat × ClosLang.Exp)) (base ptr : Nat) :
    recursiveBlocks base ptr (functions.map Prod.fst).reverse functions.length =
      recursiveValues (recursiveEntries functions base) ptr := by
  have h := recursiveBlocks_reverse base ptr (functions.map Prod.fst).reverse
  simp only [List.length_reverse, List.length_map, List.reverse_reverse] at h
  rw [h]
  simp [recursiveValues, recursiveEntries, ← List.map_zipIdx, List.map_map, Function.comp_def]

/-- The generated recursive-closure builder allocates and fills its shared
array, then enters the body with exactly the generated closure blocks followed
by the original environment. All generated labels must be installed. -/
theorem evaluate_buildReccLets {C F : Type} (arities indices : List Nat)
    (env : List BvlSem.Value) (state : BvlSem.State C F) (captured : List BvlSem.Value)
    (base : Nat) (body : Bvl.Exp) (nonempty : arities ≠ [])
    (lookup : ClosSem.lookupVars indices env = some captured)
    (labels : ∀ index, index < arities.length → ∃ entry, sptLookup (base + 2 * index) state.code = some entry) :
    let ptr := BvlSem.leastUnusedRef state.refs
    let blocks := recursiveBlocks base ptr arities.reverse arities.length
    let next := { state with refs := state.refs.updateEq (ptr, .valueArray (blocks ++ captured)) }
    BvlSem.evaluate [buildReccLetsHOL arities indices base arities.length body] env state =
      BvlSem.evaluate [body] (blocks ++ env) next := by
  have positive : 0 < arities.length := List.length_pos_iff.mpr nonempty
  let ptr := BvlSem.leastUnusedRef state.refs
  let index := arities.length - 1
  have indexBound : index < arities.length := by dsimp [index]; omega
  cases reverseEq : arities.reverse with
  | nil =>
    have empty : arities = [] := by simpa using congrArg List.reverse reverseEq
    contradiction
  | cons lastArity remaining =>
    have restLength : remaining.length = index := by
      have h := congrArg List.length reverseEq
      simp only [List.length_reverse, List.length_cons] at h
      dsimp [index]
      omega
    let block := BvlSem.Value.block 30 [.codePtr (base + 2 * index),
      .number (Int.ofNat (lastArity - 1)), .refPtr true ptr]
    let initial := List.replicate arities.length (BvlSem.Value.number 0) ++ captured
    let allocated := { state with refs := state.refs.updateEq (ptr, .valueArray initial) }
    let firstState := { allocated with refs := allocated.refs.updateEq (ptr, .valueArray (initial.set index block)) }
    have firstRun := evaluate_recursiveArray_first arities indices env state captured (base + 2 * index)
      lastArity index nonempty indexBound lookup (labels index indexBound)
    change BvlSem.evaluate [.let [.op (.memOp .ref)
      (((arities.map fun _ => mkConst 0) ++ indices.map Bvl.Exp.var).reverse)]
        (reccLet0 (base + 2 * index) lastArity index)] env state = (.val [block], firstState) at firstRun
    have lengthEq : arities.length = index + 1 := by dsimp [index]; omega
    have initialSet : initial.set index block = List.replicate index (.number 0) ++ [block] ++ captured := by
      simpa [initial, lengthEq, List.append_assoc] using
        set_last_placeholder index (BvlSem.Value.number 0) block captured
    have firstLookup : firstState.refs.lookup ptr = some (.valueArray
        (List.replicate index (.number 0) ++ [block] ++ captured)) := by
      simp [firstState, allocated, HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL, initialSet]
    have remainingLabels : ∀ i, i < index → ∃ entry, sptLookup (base + 2 * i) firstState.code = some entry := by
      intro i bound
      exact labels i (by omega)
    have loop := evaluate_reccLets_fill index remaining firstState env ptr base (base + 2 * index)
      (Int.ofNat (lastArity - 1)) [block] captured body restLength firstLookup remainingLabels
    have blocksEq : recursiveBlocks base ptr arities.reverse arities.length =
        recursiveBlocks base ptr remaining index ++ [block] := by
      rw [reverseEq, lengthEq]
      rfl
    change BvlSem.evaluate [buildReccLetsHOL arities indices base arities.length body] env state = _
    rw [buildReccLetsHOL]
    simp only [reverseEq, Flapjack.holHd, List.tail_cons]
    change BvlSem.evaluate [.let [.let [.op (.memOp .ref)
      (((arities.map fun _ => mkConst 0) ++ indices.map Bvl.Exp.var).reverse)]
        (reccLet0 (base + 2 * index) lastArity index)]
      (reccLetsHOL base remaining index body)] env state = _
    rw [BvlSem.evaluate, BvlSem.fixClock_evaluate, firstRun]
    have blocksEq' : recursiveBlocks base ptr (lastArity :: remaining) arities.length =
        recursiveBlocks base ptr remaining index ++ [block] := by
      simpa [reverseEq] using blocksEq
    simpa [blocksEq', ptr, block, firstState, allocated, updateEq_twice_same, List.append_assoc] using loop

/-- The generated builder reaches precisely the shared-array and environment
layout used by the recursive-closure value relation. -/
theorem evaluate_buildReccLets_functions {C F : Type} (functions : List (Nat × ClosLang.Exp))
    (indices : List Nat) (env : List BvlSem.Value) (state : BvlSem.State C F)
    (captured : List BvlSem.Value) (base : Nat) (body : Bvl.Exp) (nonempty : functions ≠ [])
    (lookup : ClosSem.lookupVars indices env = some captured)
    (labels : ∀ index, index < functions.length → ∃ entry, sptLookup (base + 2 * index) state.code = some entry) :
    let ptr := BvlSem.leastUnusedRef state.refs
    let blocks := recursiveValues (recursiveEntries functions base) ptr
    let next := { state with refs := state.refs.updateEq (ptr, .valueArray (blocks ++ captured)) }
    BvlSem.evaluate [buildReccLetsHOL (functions.map Prod.fst) indices base functions.length body] env state =
      BvlSem.evaluate [body] (blocks ++ env) next := by
  have aritiesNonempty : functions.map Prod.fst ≠ [] := by
    intro empty
    have h := congrArg List.length empty
    simp only [List.length_map, List.length_nil, List.length_eq_zero_iff] at h
    exact nonempty h
  have run := evaluate_buildReccLets (functions.map Prod.fst) indices env state captured base body
    aritiesNonempty lookup (by simpa using labels)
  simpa [recursiveBlocks_eq_recursiveValues] using run

end Flapjack.Compiler.Backend.ClosToBvl
