module

public import Flapjack.Compiler.Backend.ClosKnown.Proofs.InlinePureEvaluation
public import Flapjack.Compiler.Backend.ClosKnown.Proofs.TicksEvaluate
public import Flapjack.Compiler.Backend.Semantics.ClosProps.EvaluateAppend

-- Proofs below unfold private helpers of these modules.
import all Flapjack.Compiler.Backend.Semantics.ClosSem.EvaluateExact
import all Flapjack.Compiler.Backend.Semantics.ClosSem.EvaluateFuel
@[expose] public section


/-! Evaluation of the let-binding generated by closure inlining. -/
namespace Flapjack.Compiler.Backend.ClosKnown.InlineLetEvaluation
open ClosSem ClosProps
open Flapjack.SemanticPrimitivesHOL

/-- An error in the argument list is propagated by the generated let,
regardless of whether the function expression is omitted. -/
theorem inlineLetArgsError {C F : Type} (trace : BackendCommon.Tra) (dropFn : Bool)
    (args : List ClosLang.Exp) (fn body : ClosLang.Exp) (env : List ClosSem.Value)
    (s next : State C F) (error : ErrorResult ClosSem.Value)
    (run : evaluate args env s = (.err error, next)) :
    evaluate [.let trace (if dropFn then args else args ++ [fn]) body] env s = (.err error, next) := by
  cases dropFn with
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte]
    rw [evaluate, fixClock_evaluate, evaluateAppend, run]
  | true =>
    simp only [↓reduceIte]
    rw [evaluate, fixClock_evaluate, run]

/-- If the function expression is retained and fails, the generated let
propagates its error after evaluating the arguments. -/
theorem inlineLetFunctionError {C F : Type} (trace : BackendCommon.Tra)
    (args : List ClosLang.Exp) (fn body : ClosLang.Exp) (env values : List ClosSem.Value)
    (s middle next : State C F) (error : ErrorResult ClosSem.Value)
    (argsRun : evaluate args env s = (.val values, middle))
    (fnRun : evaluate [fn] env middle = (.err error, next)) :
    evaluate [.let trace (args ++ [fn]) body] env s = (.err error, next) := by
  rw [evaluate, fixClock_evaluate, evaluateAppend, argsRun]
  simp [fnRun]

/-- Successful evaluations of the arguments and function produce the same
body evaluation as the generated let. If the function is omitted, its target
evaluation must leave the state unchanged. -/
theorem inlineLetSuccess {C F : Type} (trace : BackendCommon.Tra) (dropFn : Bool)
    (args : List ClosLang.Exp) (fn body : ClosLang.Exp) (env values : List ClosSem.Value)
    (fnValue : ClosSem.Value) (s middle next final : State C F)
    (result : Result (List ClosSem.Value) ClosSem.Value)
    (argsRun : evaluate args env s = (.val values, middle))
    (fnRun : evaluate [fn] env middle = (.val [fnValue], next))
    (omittedState : dropFn = true → next = middle)
    (bodyRun : evaluate [body] (values ++ (if dropFn then env else fnValue :: env)) next = (result, final)) :
    evaluate [.let trace (if dropFn then args else args ++ [fn]) body] env s = (result, final) := by
  cases dropFn with
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte] at bodyRun ⊢
    rw [evaluate, fixClock_evaluate, evaluateAppend, argsRun]
    simpa [fnRun, List.append_assoc] using bodyRun
  | true =>
    have eq := omittedState rfl
    subst next
    simp only [↓reduceIte] at bodyRun ⊢
    rw [evaluate, fixClock_evaluate, argsRun]
    simpa using bodyRun

end Flapjack.Compiler.Backend.ClosKnown.InlineLetEvaluation
