import Flapjack.Compiler.Backend.Bvi.Syntax
import Flapjack.Compiler.Backend.ClosLang.GeneratedSize

/-! HOL-generated sizes for BVI expressions and expression lists. -/
namespace Flapjack.Compiler.Backend.Bvi
open Flapjack

mutual
/-- The size generated by HOL for the BVI expression datatype. HOL generates
this function from the datatype, so it has no source declaration to tag. -/
def expSizeHOL : Exp → Nat
  | .var n => 1 + n
  | .ifThenElse a b c => 1 + (expSizeHOL a + (expSizeHOL b + expSizeHOL c))
  | .let xs body => 1 + (expListSizeHOL xs + expSizeHOL body)
  | .raise body | .tick body => 1 + expSizeHOL body
  | .call ticks dest args handler =>
      1 + (ticks + (optionSizeHOL id dest + (expListSizeHOL args + expOptionSizeHOL handler)))
  | .force location index => 1 + (location + index)
  | .op op args => 1 + (ClosLang.opSizeHOL op + expListSizeHOL args)
  | .letCall rets ticks dest args body =>
      1 + (rets + (ticks + (dest + (expListSizeHOL args + expSizeHOL body))))
  | .return args => 1 + expListSizeHOL args

/-- The optional-expression component of HOL’s generated size. -/
def expOptionSizeHOL : Option Exp → Nat
  | none => 0
  | some value => 1 + expSizeHOL value

/-- The expression-list component of HOL’s generated size. -/
def expListSizeHOL : List Exp → Nat
  | [] => 0
  | value :: rest => 1 + (expSizeHOL value + expListSizeHOL rest)
end

end Flapjack.Compiler.Backend.Bvi
