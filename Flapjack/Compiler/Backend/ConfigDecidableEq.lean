      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, reduceCtorEq] at h
      obtain ⟨h0, h1⟩ := h
      rw [Exp.eq_of_beqDecList x0 _ h0, Exp.eq_of_beqDec x1 _ h1]
  | .raise x0, b, h => by
      cases b <;> simp only [Exp.beqDec, reduceCtorEq] at h
      rw [Exp.eq_of_beqDec x0 _ h]
  | .handle x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, reduceCtorEq] at h
      obtain ⟨h0, h1⟩ := h
      rw [Exp.eq_of_beqDec x0 _ h0, Exp.eq_of_beqDec x1 _ h1]
  | .tick x0, b, h => by
      cases b <;> simp only [Exp.beqDec, reduceCtorEq] at h
      rw [Exp.eq_of_beqDec x0 _ h]
  | .call x0 x1 x2, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, h2⟩ := h
      rw [Exp.eq_of_beqDecList x2 _ h2]
