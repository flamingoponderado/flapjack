      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl⟩ := h
      rfl
  | .op x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1⟩ := h
