end Flapjack.Compiler.Backend.Bvl

namespace Flapjack.Compiler.Backend.Bvi

mutual
/-- Structural Boolean equality on `Exp`, used to decide `=`. -/
def Exp.beqDec : Exp → Exp → Bool
  | .var x0, .var y0 => decide (x0 = y0)
  | .ifThenElse x0 x1 x2, .ifThenElse y0 y1 y2 => Exp.beqDec x0 y0 && (Exp.beqDec x1 y1 && (Exp.beqDec x2 y2))
  | .«let» x0 x1, .«let» y0 y1 => Exp.beqDecList x0 y0 && (Exp.beqDec x1 y1)
  | .raise x0, .raise y0 => Exp.beqDec x0 y0
  | .tick x0, .tick y0 => Exp.beqDec x0 y0
  | .call x0 x1 x2 x3, .call y0 y1 y2 y3 => decide (x0 = y0) && (decide (x1 = y1) && (Exp.beqDecList x2 y2 && (Exp.beqDecOpt x3 y3)))
  | .force x0 x1, .force y0 y1 => decide (x0 = y0) && (decide (x1 = y1))
  | .op x0 x1, .op y0 y1 => decide (x0 = y0) && (Exp.beqDecList x1 y1)
  | .letCall x0 x1 x2 x3 x4, .letCall y0 y1 y2 y3 y4 => decide (x0 = y0) && (decide (x1 = y1) && (decide (x2 = y2) && (Exp.beqDecList x3 y3 && (Exp.beqDec x4 y4))))
  | .«return» x0, .«return» y0 => Exp.beqDecList x0 y0
  | _, _ => false
def Exp.beqDecList : List Exp → List Exp → Bool
  | [], [] => true
  | x :: xs, y :: ys => Exp.beqDec x y && Exp.beqDecList xs ys
  | _, _ => false
def Exp.beqDecOpt : Option Exp → Option Exp → Bool
  | none, none => true
  | some x, some y => Exp.beqDec x y
  | _, _ => false
end

mutual
theorem Exp.beqDec_refl : (a : Exp) → Exp.beqDec a a = true
  | .var x0 => by simp [Exp.beqDec]
  | .ifThenElse x0 x1 x2 => by simp [Exp.beqDec, Exp.beqDec_refl x0, Exp.beqDec_refl x1, Exp.beqDec_refl x2]
  | .«let» x0 x1 => by simp [Exp.beqDec, Exp.beqDecList_refl x0, Exp.beqDec_refl x1]
  | .raise x0 => by simp [Exp.beqDec, Exp.beqDec_refl x0]
  | .tick x0 => by simp [Exp.beqDec, Exp.beqDec_refl x0]
  | .call x0 x1 x2 x3 => by simp [Exp.beqDec, Exp.beqDecList_refl x2, Exp.beqDecOpt_refl x3]
  | .force x0 x1 => by simp [Exp.beqDec]
  | .op x0 x1 => by simp [Exp.beqDec, Exp.beqDecList_refl x1]
  | .letCall x0 x1 x2 x3 x4 => by simp [Exp.beqDec, Exp.beqDecList_refl x3, Exp.beqDec_refl x4]
  | .«return» x0 => by simp [Exp.beqDec, Exp.beqDecList_refl x0]
theorem Exp.beqDecList_refl : (as : List Exp) → Exp.beqDecList as as = true
  | [] => by simp [Exp.beqDecList]
  | x :: xs => by simp [Exp.beqDecList, Exp.beqDec_refl x, Exp.beqDecList_refl xs]
theorem Exp.beqDecOpt_refl : (a : Option Exp) → Exp.beqDecOpt a a = true
  | none => by simp [Exp.beqDecOpt]
  | some x => by simp [Exp.beqDecOpt, Exp.beqDec_refl x]
end

mutual
theorem Exp.eq_of_beqDec : (a b : Exp) → Exp.beqDec a b = true → a = b
  | .var x0, b, h => by
      cases b <;> simp only [Exp.beqDec, decide_eq_true_eq, reduceCtorEq] at h
      rw [h]
  | .ifThenElse x0 x1 x2, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, reduceCtorEq] at h
      obtain ⟨h0, h1, h2⟩ := h
      rw [Exp.eq_of_beqDec x0 _ h0, Exp.eq_of_beqDec x1 _ h1, Exp.eq_of_beqDec x2 _ h2]
  | .«let» x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, reduceCtorEq] at h
      obtain ⟨h0, h1⟩ := h
      rw [Exp.eq_of_beqDecList x0 _ h0, Exp.eq_of_beqDec x1 _ h1]
  | .raise x0, b, h => by
      cases b <;> simp only [Exp.beqDec, reduceCtorEq] at h
      rw [Exp.eq_of_beqDec x0 _ h]
  | .tick x0, b, h => by
      cases b <;> simp only [Exp.beqDec, reduceCtorEq] at h
      rw [Exp.eq_of_beqDec x0 _ h]
  | .call x0 x1 x2 x3, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, h2, h3⟩ := h
      rw [Exp.eq_of_beqDecList x2 _ h2, Exp.eq_of_beqDecOpt x3 _ h3]
  | .force x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl⟩ := h
      rfl
  | .op x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1⟩ := h
      rw [Exp.eq_of_beqDecList x1 _ h1]
  | .letCall x0 x1 x2 x3 x4, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, rfl, h3, h4⟩ := h
      rw [Exp.eq_of_beqDecList x3 _ h3, Exp.eq_of_beqDec x4 _ h4]
  | .«return» x0, b, h => by
      cases b <;> simp only [Exp.beqDec, reduceCtorEq] at h
      rw [Exp.eq_of_beqDecList x0 _ h]
theorem Exp.eq_of_beqDecList : (as bs : List Exp) → Exp.beqDecList as bs = true → as = bs
  | [], bs, h => by cases bs <;> simp_all [Exp.beqDecList]
  | x :: xs, bs, h => by
      cases bs with
      | nil => simp [Exp.beqDecList] at h
      | cons y ys =>
          simp only [Exp.beqDecList, Bool.and_eq_true] at h
          rw [Exp.eq_of_beqDec x y h.1, Exp.eq_of_beqDecList xs ys h.2]
theorem Exp.eq_of_beqDecOpt : (a b : Option Exp) → Exp.beqDecOpt a b = true → a = b
  | none, b, h => by cases b <;> simp_all [Exp.beqDecOpt]
  | some x, b, h => by
      cases b with
      | none => simp [Exp.beqDecOpt] at h
      | some y =>
          simp only [Exp.beqDecOpt] at h
          rw [Exp.eq_of_beqDec x y h]
end

instance : DecidableEq Exp := fun a b =>
  decidable_of_iff (Exp.beqDec a b = true)
    ⟨Exp.eq_of_beqDec a b, fun h => h ▸ Exp.beqDec_refl a⟩

end Flapjack.Compiler.Backend.Bvi

namespace Flapjack.Compiler.Backend.ClosKnown

mutual
/-- Structural Boolean equality on `ValApprox`, used to decide `=`. -/
def ValApprox.beqDec : ValApprox → ValApprox → Bool
  | .closNoInline x0 x1, .closNoInline y0 y1 => decide (x0 = y0) && (decide (x1 = y1))
  | .clos x0 x1 x2 x3, .clos y0 y1 y2 y3 => decide (x0 = y0) && (decide (x1 = y1) && (decide (x2 = y2) && (decide (x3 = y3))))
  | .tuple x0 x1, .tuple y0 y1 => decide (x0 = y0) && (ValApprox.beqDecList x1 y1)
  | .int x0, .int y0 => decide (x0 = y0)
  | .other, .other => true
  | .impossible, .impossible => true
  | _, _ => false
def ValApprox.beqDecList : List ValApprox → List ValApprox → Bool
  | [], [] => true
  | x :: xs, y :: ys => ValApprox.beqDec x y && ValApprox.beqDecList xs ys
  | _, _ => false
end

mutual
theorem ValApprox.beqDec_refl : (a : ValApprox) → ValApprox.beqDec a a = true
  | .closNoInline x0 x1 => by simp [ValApprox.beqDec]
  | .clos x0 x1 x2 x3 => by simp [ValApprox.beqDec]
  | .tuple x0 x1 => by simp [ValApprox.beqDec, ValApprox.beqDecList_refl x1]
  | .int x0 => by simp [ValApprox.beqDec]
  | .other => by simp [ValApprox.beqDec]
  | .impossible => by simp [ValApprox.beqDec]
theorem ValApprox.beqDecList_refl : (as : List ValApprox) → ValApprox.beqDecList as as = true
  | [] => by simp [ValApprox.beqDecList]
  | x :: xs => by simp [ValApprox.beqDecList, ValApprox.beqDec_refl x, ValApprox.beqDecList_refl xs]
end

mutual
theorem ValApprox.eq_of_beqDec : (a b : ValApprox) → ValApprox.beqDec a b = true → a = b
  | .closNoInline x0 x1, b, h => by
      cases b <;> simp only [ValApprox.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl⟩ := h
      rfl
  | .clos x0 x1 x2 x3, b, h => by
      cases b <;> simp only [ValApprox.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, rfl, rfl⟩ := h
      rfl
  | .tuple x0 x1, b, h => by
      cases b <;> simp only [ValApprox.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1⟩ := h
      rw [ValApprox.eq_of_beqDecList x1 _ h1]
  | .int x0, b, h => by
      cases b <;> simp only [ValApprox.beqDec, decide_eq_true_eq, reduceCtorEq] at h
      rw [h]
  | .other, b, h => by
      cases b <;> simp_all [ValApprox.beqDec]
  | .impossible, b, h => by
      cases b <;> simp_all [ValApprox.beqDec]
theorem ValApprox.eq_of_beqDecList : (as bs : List ValApprox) → ValApprox.beqDecList as bs = true → as = bs
  | [], bs, h => by cases bs <;> simp_all [ValApprox.beqDecList]
  | x :: xs, bs, h => by
      cases bs with
      | nil => simp [ValApprox.beqDecList] at h
      | cons y ys =>
          simp only [ValApprox.beqDecList, Bool.and_eq_true] at h
          rw [ValApprox.eq_of_beqDec x y h.1, ValApprox.eq_of_beqDecList xs ys h.2]
end

instance : DecidableEq ValApprox := fun a b =>
  decidable_of_iff (ValApprox.beqDec a b = true)
    ⟨ValApprox.eq_of_beqDec a b, fun h => h ▸ ValApprox.beqDec_refl a⟩

end Flapjack.Compiler.Backend.ClosKnown

