import Flapjack.Compiler.Backend.Backend

/-!
# Decidable equality for the backend configuration

Computable `DecidableEq` instances for `Backend.Config` and every nested pass
configuration, so a concrete compiler artifact
`Option (List (BitVec 8) × List (BitVec 64) × Backend.Config)` can be compared
whole, metadata included (issue #1226).

Lean's `DecidableEq` deriving handler rejects nested inductives, so the nested
syntax and namespace carriers (`ClosLang.Const`, `ClosLang.Exp`, `Bvl.Exp`,
`Bvi.Exp`, `ClosKnown.ValApprox`, `NamespaceHOL.Namespace`) get a structural
Boolean equality `beqDec` with soundness (`eq_of_beqDec`) and reflexivity
(`beqDec_refl`) proofs, from which the instance is built by `decidable_of_iff`.
The remaining configuration records are derived. The helper functions and lemmas
in this module were generated by a script and have no HOL counterpart. This is
Flapjack infrastructure; nothing here carries an `@[hol]` tag.
-/

namespace Flapjack.Compiler.Backend.ClosLang

mutual
def Const.beqDec : Const → Const → Bool
  | .constCons n xs, .constCons m ys => decide (n = m) && Const.beqDecList xs ys
  | .constInt i, .constInt j => decide (i = j)
  | .constStr s, .constStr t => decide (s = t)
  | .constWord64 w, .constWord64 v => decide (w = v)
  | _, _ => false
def Const.beqDecList : List Const → List Const → Bool
  | [], [] => true
  | x :: xs, y :: ys => Const.beqDec x y && Const.beqDecList xs ys
  | _, _ => false
end

mutual
theorem Const.beqDec_refl : (a : Const) → Const.beqDec a a = true
  | .constCons n xs => by simp [Const.beqDec, Const.beqDecList_refl xs]
  | .constInt _ | .constStr _ | .constWord64 _ => by simp [Const.beqDec]
theorem Const.beqDecList_refl : (as : List Const) → Const.beqDecList as as = true
  | [] => by simp [Const.beqDecList]
  | x :: xs => by simp [Const.beqDecList, Const.beqDec_refl x, Const.beqDecList_refl xs]
end

mutual
theorem Const.eq_of_beqDec : (a b : Const) → Const.beqDec a b = true → a = b
  | .constCons n xs, b, h => by
      cases b <;> simp only [Const.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h⟩ := h
      rw [Const.eq_of_beqDecList xs _ h]
  | .constInt _, b, h | .constStr _, b, h | .constWord64 _, b, h => by
      cases b <;> simp_all [Const.beqDec]
theorem Const.eq_of_beqDecList : (as bs : List Const) → Const.beqDecList as bs = true → as = bs
  | [], bs, h => by cases bs <;> simp_all [Const.beqDecList]
  | x :: xs, bs, h => by
      cases bs with
      | nil => simp [Const.beqDecList] at h
      | cons y ys =>
          simp only [Const.beqDecList, Bool.and_eq_true] at h
          rw [Const.eq_of_beqDec x y h.1, Const.eq_of_beqDecList xs ys h.2]
end

instance : DecidableEq Const := fun a b =>
  decidable_of_iff (Const.beqDec a b = true)
    ⟨Const.eq_of_beqDec a b, fun h => h ▸ Const.beqDec_refl a⟩

deriving instance DecidableEq for ConstPart
deriving instance DecidableEq for IntOp
deriving instance DecidableEq for WordOp
deriving instance DecidableEq for BlockOp
deriving instance DecidableEq for GlobOp
deriving instance DecidableEq for MemOp
deriving instance DecidableEq for Op

end Flapjack.Compiler.Backend.ClosLang


namespace Flapjack.NamespaceHOL

variable {M N V : Type} [DecidableEq M] [DecidableEq N] [DecidableEq V]

mutual
/-- Structural Boolean equality on `Namespace`, used to decide `=`. -/
def Namespace.beqDec : Namespace M N V → Namespace M N V → Bool
  | .bind xs ms, .bind ys ns => decide (xs = ys) && Namespace.beqDecPairs ms ns
def Namespace.beqDecPairs :
    List (M × Namespace M N V) → List (M × Namespace M N V) → Bool
  | [], [] => true
  | (m, x) :: xs, (n, y) :: ys => decide (m = n) && (Namespace.beqDec x y && Namespace.beqDecPairs xs ys)
  | _, _ => false
end

mutual
theorem Namespace.beqDec_refl : (a : Namespace M N V) → Namespace.beqDec a a = true
  | .bind xs ms => by simp [Namespace.beqDec, Namespace.beqDecPairs_refl ms]
theorem Namespace.beqDecPairs_refl :
    (as : List (M × Namespace M N V)) → Namespace.beqDecPairs as as = true
  | [] => by simp [Namespace.beqDecPairs]
  | (_, x) :: xs => by
      simp [Namespace.beqDecPairs, Namespace.beqDec_refl x, Namespace.beqDecPairs_refl xs]
end

mutual
theorem Namespace.eq_of_beqDec :
    (a b : Namespace M N V) → Namespace.beqDec a b = true → a = b
  | .bind xs ms, .bind ys ns, h => by
      simp only [Namespace.beqDec, Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨rfl, h⟩ := h
      rw [Namespace.eq_of_beqDecPairs ms ns h]
theorem Namespace.eq_of_beqDecPairs : (as bs : List (M × Namespace M N V)) →
    Namespace.beqDecPairs as bs = true → as = bs
  | [], bs, h => by cases bs <;> simp_all [Namespace.beqDecPairs]
  | (m, x) :: xs, bs, h => by
      cases bs with
      | nil => simp [Namespace.beqDecPairs] at h
      | cons q ys =>
          obtain ⟨n, y⟩ := q
          simp only [Namespace.beqDecPairs, Bool.and_eq_true, decide_eq_true_eq] at h
          obtain ⟨rfl, h1, h2⟩ := h
          rw [Namespace.eq_of_beqDec x y h1, Namespace.eq_of_beqDecPairs xs ys h2]
end

instance : DecidableEq (Namespace M N V) := fun a b =>
  decidable_of_iff (Namespace.beqDec a b = true)
    ⟨Namespace.eq_of_beqDec a b, fun h => h ▸ Namespace.beqDec_refl a⟩

end Flapjack.NamespaceHOL

namespace Flapjack.Compiler.Backend.ClosLang

mutual
/-- Structural Boolean equality on `Exp`, used to decide `=`. -/
def Exp.beqDec : Exp → Exp → Bool
  | .var x0 x1, .var y0 y1 => decide (x0 = y0) && (decide (x1 = y1))
  | .ifThenElse x0 x1 x2 x3, .ifThenElse y0 y1 y2 y3 => decide (x0 = y0) && (Exp.beqDec x1 y1 && (Exp.beqDec x2 y2 && (Exp.beqDec x3 y3)))
  | .«let» x0 x1 x2, .«let» y0 y1 y2 => decide (x0 = y0) && (Exp.beqDecList x1 y1 && (Exp.beqDec x2 y2))
  | .raise x0 x1, .raise y0 y1 => decide (x0 = y0) && (Exp.beqDec x1 y1)
  | .handle x0 x1 x2, .handle y0 y1 y2 => decide (x0 = y0) && (Exp.beqDec x1 y1 && (Exp.beqDec x2 y2))
  | .tick x0 x1, .tick y0 y1 => decide (x0 = y0) && (Exp.beqDec x1 y1)
  | .call x0 x1 x2 x3, .call y0 y1 y2 y3 => decide (x0 = y0) && (decide (x1 = y1) && (decide (x2 = y2) && (Exp.beqDecList x3 y3)))
  | .app x0 x1 x2 x3, .app y0 y1 y2 y3 => decide (x0 = y0) && (decide (x1 = y1) && (Exp.beqDec x2 y2 && (Exp.beqDecList x3 y3)))
  | .fn x0 x1 x2 x3 x4, .fn y0 y1 y2 y3 y4 => decide (x0 = y0) && (decide (x1 = y1) && (decide (x2 = y2) && (decide (x3 = y3) && (Exp.beqDec x4 y4))))
  | .letrec x0 x1 x2 x3 x4, .letrec y0 y1 y2 y3 y4 => decide (x0 = y0) && (decide (x1 = y1) && (decide (x2 = y2) && (Exp.beqDecPairs x3 y3 && (Exp.beqDec x4 y4))))
  | .op x0 x1 x2, .op y0 y1 y2 => decide (x0 = y0) && (decide (x1 = y1) && (Exp.beqDecList x2 y2))
  | _, _ => false
def Exp.beqDecList : List Exp → List Exp → Bool
  | [], [] => true
  | x :: xs, y :: ys => Exp.beqDec x y && Exp.beqDecList xs ys
  | _, _ => false
def Exp.beqDecPairs : List (Nat × Exp) → List (Nat × Exp) → Bool
  | [], [] => true
  | (n, x) :: xs, (m, y) :: ys => decide (n = m) && (Exp.beqDec x y && Exp.beqDecPairs xs ys)
  | _, _ => false
end

mutual
theorem Exp.beqDec_refl : (a : Exp) → Exp.beqDec a a = true
  | .var x0 x1 => by simp [Exp.beqDec]
  | .ifThenElse x0 x1 x2 x3 => by simp [Exp.beqDec, Exp.beqDec_refl x1, Exp.beqDec_refl x2, Exp.beqDec_refl x3]
  | .«let» x0 x1 x2 => by simp [Exp.beqDec, Exp.beqDecList_refl x1, Exp.beqDec_refl x2]
  | .raise x0 x1 => by simp [Exp.beqDec, Exp.beqDec_refl x1]
  | .handle x0 x1 x2 => by simp [Exp.beqDec, Exp.beqDec_refl x1, Exp.beqDec_refl x2]
  | .tick x0 x1 => by simp [Exp.beqDec, Exp.beqDec_refl x1]
  | .call x0 x1 x2 x3 => by simp [Exp.beqDec, Exp.beqDecList_refl x3]
  | .app x0 x1 x2 x3 => by simp [Exp.beqDec, Exp.beqDec_refl x2, Exp.beqDecList_refl x3]
  | .fn x0 x1 x2 x3 x4 => by simp [Exp.beqDec, Exp.beqDec_refl x4]
  | .letrec x0 x1 x2 x3 x4 => by simp [Exp.beqDec, Exp.beqDecPairs_refl x3, Exp.beqDec_refl x4]
  | .op x0 x1 x2 => by simp [Exp.beqDec, Exp.beqDecList_refl x2]
theorem Exp.beqDecList_refl : (as : List Exp) → Exp.beqDecList as as = true
  | [] => by simp [Exp.beqDecList]
  | x :: xs => by simp [Exp.beqDecList, Exp.beqDec_refl x, Exp.beqDecList_refl xs]
theorem Exp.beqDecPairs_refl : (as : List (Nat × Exp)) → Exp.beqDecPairs as as = true
  | [] => by simp [Exp.beqDecPairs]
  | (_, x) :: xs => by simp [Exp.beqDecPairs, Exp.beqDec_refl x, Exp.beqDecPairs_refl xs]
end

mutual
theorem Exp.eq_of_beqDec : (a b : Exp) → Exp.beqDec a b = true → a = b
  | .var x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl⟩ := h
      rfl
  | .ifThenElse x0 x1 x2 x3, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1, h2, h3⟩ := h
      rw [Exp.eq_of_beqDec x1 _ h1, Exp.eq_of_beqDec x2 _ h2, Exp.eq_of_beqDec x3 _ h3]
  | .«let» x0 x1 x2, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1, h2⟩ := h
      rw [Exp.eq_of_beqDecList x1 _ h1, Exp.eq_of_beqDec x2 _ h2]
  | .raise x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1⟩ := h
      rw [Exp.eq_of_beqDec x1 _ h1]
  | .handle x0 x1 x2, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1, h2⟩ := h
      rw [Exp.eq_of_beqDec x1 _ h1, Exp.eq_of_beqDec x2 _ h2]
  | .tick x0 x1, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, h1⟩ := h
      rw [Exp.eq_of_beqDec x1 _ h1]
  | .call x0 x1 x2 x3, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, rfl, h3⟩ := h
      rw [Exp.eq_of_beqDecList x3 _ h3]
  | .app x0 x1 x2 x3, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, h2, h3⟩ := h
      rw [Exp.eq_of_beqDec x2 _ h2, Exp.eq_of_beqDecList x3 _ h3]
  | .fn x0 x1 x2 x3 x4, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, rfl, rfl, h4⟩ := h
      rw [Exp.eq_of_beqDec x4 _ h4]
  | .letrec x0 x1 x2 x3 x4, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, rfl, h3, h4⟩ := h
      rw [Exp.eq_of_beqDecPairs x3 _ h3, Exp.eq_of_beqDec x4 _ h4]
  | .op x0 x1 x2, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, decide_eq_true_eq, reduceCtorEq] at h
      obtain ⟨rfl, rfl, h2⟩ := h
      rw [Exp.eq_of_beqDecList x2 _ h2]
theorem Exp.eq_of_beqDecList : (as bs : List Exp) → Exp.beqDecList as bs = true → as = bs
  | [], bs, h => by cases bs <;> simp_all [Exp.beqDecList]
  | x :: xs, bs, h => by
      cases bs with
      | nil => simp [Exp.beqDecList] at h
      | cons y ys =>
          simp only [Exp.beqDecList, Bool.and_eq_true] at h
          rw [Exp.eq_of_beqDec x y h.1, Exp.eq_of_beqDecList xs ys h.2]
theorem Exp.eq_of_beqDecPairs : (as bs : List (Nat × Exp)) → Exp.beqDecPairs as bs = true → as = bs
  | [], bs, h => by cases bs <;> simp_all [Exp.beqDecPairs]
  | (n, x) :: xs, bs, h => by
      cases bs with
      | nil => simp [Exp.beqDecPairs] at h
      | cons q ys =>
          obtain ⟨m, y⟩ := q
          simp only [Exp.beqDecPairs, Bool.and_eq_true, decide_eq_true_eq] at h
          obtain ⟨rfl, h1, h2⟩ := h
          rw [Exp.eq_of_beqDec x y h1, Exp.eq_of_beqDecPairs xs ys h2]
end

instance : DecidableEq Exp := fun a b =>
  decidable_of_iff (Exp.beqDec a b = true)
    ⟨Exp.eq_of_beqDec a b, fun h => h ▸ Exp.beqDec_refl a⟩

end Flapjack.Compiler.Backend.ClosLang

namespace Flapjack.Compiler.Backend.Bvl

mutual
/-- Structural Boolean equality on `Exp`, used to decide `=`. -/
def Exp.beqDec : Exp → Exp → Bool
  | .var x0, .var y0 => decide (x0 = y0)
  | .ifThenElse x0 x1 x2, .ifThenElse y0 y1 y2 => Exp.beqDec x0 y0 && (Exp.beqDec x1 y1 && (Exp.beqDec x2 y2))
  | .«let» x0 x1, .«let» y0 y1 => Exp.beqDecList x0 y0 && (Exp.beqDec x1 y1)
  | .raise x0, .raise y0 => Exp.beqDec x0 y0
  | .handle x0 x1, .handle y0 y1 => Exp.beqDec x0 y0 && (Exp.beqDec x1 y1)
  | .tick x0, .tick y0 => Exp.beqDec x0 y0
  | .call x0 x1 x2, .call y0 y1 y2 => decide (x0 = y0) && (decide (x1 = y1) && (Exp.beqDecList x2 y2))
  | .force x0 x1, .force y0 y1 => decide (x0 = y0) && (decide (x1 = y1))
  | .op x0 x1, .op y0 y1 => decide (x0 = y0) && (Exp.beqDecList x1 y1)
  | _, _ => false
def Exp.beqDecList : List Exp → List Exp → Bool
  | [], [] => true
  | x :: xs, y :: ys => Exp.beqDec x y && Exp.beqDecList xs ys
  | _, _ => false
end

mutual
theorem Exp.beqDec_refl : (a : Exp) → Exp.beqDec a a = true
  | .var x0 => by simp [Exp.beqDec]
  | .ifThenElse x0 x1 x2 => by simp [Exp.beqDec, Exp.beqDec_refl x0, Exp.beqDec_refl x1, Exp.beqDec_refl x2]
  | .«let» x0 x1 => by simp [Exp.beqDec, Exp.beqDecList_refl x0, Exp.beqDec_refl x1]
  | .raise x0 => by simp [Exp.beqDec, Exp.beqDec_refl x0]
  | .handle x0 x1 => by simp [Exp.beqDec, Exp.beqDec_refl x0, Exp.beqDec_refl x1]
  | .tick x0 => by simp [Exp.beqDec, Exp.beqDec_refl x0]
  | .call x0 x1 x2 => by simp [Exp.beqDec, Exp.beqDecList_refl x2]
  | .force x0 x1 => by simp [Exp.beqDec]
  | .op x0 x1 => by simp [Exp.beqDec, Exp.beqDecList_refl x1]
theorem Exp.beqDecList_refl : (as : List Exp) → Exp.beqDecList as as = true
  | [] => by simp [Exp.beqDecList]
  | x :: xs => by simp [Exp.beqDecList, Exp.beqDec_refl x, Exp.beqDecList_refl xs]
end

mutual
theorem Exp.eq_of_beqDec : (a b : Exp) → Exp.beqDec a b = true → a = b
  | .var x0, b, h => by
      cases b <;> simp only [Exp.beqDec, decide_eq_true_eq, reduceCtorEq] at h
      rw [h]
  | .ifThenElse x0 x1 x2, b, h => by
      cases b <;> simp only [Exp.beqDec, Bool.and_eq_true, reduceCtorEq] at h
      obtain ⟨h0, h1, h2⟩ := h
