    (distinct : (codeLocations source).Nodup) (fresh : LabelsFresh (codeLocations source) initial)
    (initialWf : wellFormed initial) (locations : everyFnLocationSome source) (annotations : everyFnVarsNone source) :
    GrowingExprsSimFromBelowWithCoveredOpenClockAndResultWf (F := F) passFuel relationFuel limit compiler final source target := by
  apply callsListBounded_withCoveredOpenClockAndResultWf_from_annotated_induction passFuel relationFuel traversalFuel limit compiler
    source target initial final run distinct fresh initialWf locations annotations
  intro depth _ expression output before after traversal expressionDistinct expressionFresh beforeWf expressionLocations expressionAnnotations
  exact callsFuel_withCoveredOpenClockAndResultWf_clock_induction passFuel relationFuel compiler limit depth expression output before after
    traversal expressionDistinct expressionFresh beforeWf expressionLocations expressionAnnotations

/-- Related closure applications satisfy the result-preserving simulation
without a separate body-evaluation assumption. This is Flapjack-specific
infrastructure. -/
theorem growingAppSimClockBelowWithOpenClockAndResultWf {C F : Type}
    (passFuel relationFuel limit : Nat) (compiler : ClosSem.Compiler C) (location : Option Nat) :
    GrowingAppSimClockBelowWithOpenClockAndResultWf (F := F) passFuel relationFuel limit compiler location := by
  apply growingAppSimClockBelowWithCoveredOpenClockAndResultWf_of_traversals passFuel relationFuel limit compiler location
  intro callerClock _ depth before after body converted traversal distinct fresh well locations annotations
  exact callsFuel_withCoveredOpenClockAndResultWf_clock_induction passFuel relationFuel compiler callerClock depth body converted before after
    traversal distinct fresh well locations annotations

/-- Ordering conditions on oracle locations used to recover the open-set
and freshness components of incremental readiness. These are Flapjack-specific
projections of the oracle invariant, not a port of `code_inv`. -/
def OracleLocationsOrdered {C F : Type} (g : State) (allowed : Set Nat)
    (source : ClosSem.State C F) : Prop :=
  (∀ earlier later x y, earlier < later → x ∈ codeLocations (source.compileOracle earlier).2.1 →
    y ∈ codeLocations (source.compileOracle later).2.1 → x < y) ∧
  (∀ index x y, (sptDomain g.1 x ∨ x ∈ allowed) →
    y ∈ codeLocations (source.compileOracle index).2.1 → x < y)

/-- Oracle ordering excludes currently open locations from every future
program. This is Flapjack-specific invariant infrastructure. -/
theorem oracleLocationsAvoid_of_ordered {C F : Type} (g : State) (allowed : Set Nat)
    (source : ClosSem.State C F) (ordered : OracleLocationsOrdered g allowed source) :
    OracleLocationsAvoid allowed source := by
  intro index loc member openLoc
  have lt := ordered.2 index loc loc (Or.inr openLoc) member
  omega

/-- An ordered oracle and a target code domain contained in the compiler's
emitted labels provide the remaining freshness and disjointness components of
incremental readiness. This is Flapjack-specific invariant infrastructure. -/
theorem incrementalInstallReady_of_ordered {C F : Type} (g : State) (allowed : Set Nat)
    (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (well : wellFormed g) (included : codeIncludes g.2 target.code)
    (codeDomain : ∀ key value, target.code.lookup key = some value → key ∈ g.2.map Prod.fst)
    (known : g.1 = (source.compileOracle 0).1.1)
    (auxEmpty : ∀ index, (source.compileOracle index).2.2 = [])
    (distinct : ∀ index, (codeLocations (source.compileOracle index).2.1).Nodup)
    (locations : ∀ index, everyFnLocationSome (source.compileOracle index).2.1)
    (annotations : ∀ index, everyFnVarsNone (source.compileOracle index).2.1)
    (ordered : OracleLocationsOrdered g allowed source) :
    IncrementalInstallReady g source target ∧ OracleLocationsAvoid allowed source := by
  constructor
  · refine ⟨well, included, known, auxEmpty, distinct, ?_, ?_, locations, annotations⟩
    · intro earlier later earlierLt loc laterMember earlierMember
      have lt := ordered.1 earlier later loc loc earlierLt earlierMember laterMember
      omega
    · intro index loc member
      cases lookup : target.code.lookup (loc + 1) with
      | none => rfl
      | some value =>
        have label : loc + 1 ∈ g.2.map Prod.fst := codeDomain _ _ lookup
        have knownLabel : loc + 1 ∈ Set.image Nat.succ (sptDomain g.1) := by
          rw [← well.1]
          exact label
        obtain ⟨other, otherKnown, equal⟩ := knownLabel
        have same : other = loc := by omega
        subst other
        have lt := ordered.2 index loc loc (Or.inl otherKnown) member
        omega
  · exact oracleLocationsAvoid_of_ordered g allowed source ordered

/-- HOL-shaped association-list map lookup agrees with the logical
association lookup used by code inclusion. This is Flapjack-specific
representation infrastructure. -/
theorem alistToFmap_lookup_logical {K V : Type} (entries : List (K × V)) (key : K) :
    (HolFiniteMapExact.alistToFmap entries).lookup key = logicalAssocLookup key entries := by
  classical
  induction entries with
  | nil => simp [HolFiniteMapExact.alistToFmap, logicalAssocLookup_nil, HolFiniteMapExact.empty]
  | cons entry rest ih =>
    rcases entry with ⟨other, value⟩
    by_cases equal : key = other
    · subst key
      rw [HolFiniteMapExact.lookup_alistToFmap_head, (logicalAssocLookup_cons other other value rest).1 rfl]
    · rw [HolFiniteMapExact.lookup_alistToFmap_tail _ _ key equal,
        (logicalAssocLookup_cons key other value rest).2 equal, ih]

/-- A code map built from the emitted association list has no entries outside
that list's labels. This is Flapjack-specific representation infrastructure. -/
theorem alistToFmap_codeDomain {K V : Type} (entries : List (K × V)) (key : K) (value : V)
    (lookup : (HolFiniteMapExact.alistToFmap entries).lookup key = some value) :
    key ∈ entries.map Prod.fst := by
  classical
  induction entries with
  | nil => simp [HolFiniteMapExact.alistToFmap, HolFiniteMapExact.empty] at lookup
  | cons entry rest ih =>
    rcases entry with ⟨other, otherValue⟩
    by_cases equal : key = other
    · simp [equal]
    · have restLookup : (HolFiniteMapExact.alistToFmap rest).lookup key = some value := by
        rw [HolFiniteMapExact.lookup_alistToFmap_tail (other, otherValue) rest key equal] at lookup
        exact lookup
      simp only [List.map_cons, List.mem_cons]
      exact Or.inr (ih restLookup)

/-- The exact association-list map satisfies code inclusion and the code
bound needed by the ordered-oracle readiness construction. This is
Flapjack-specific representation infrastructure. -/
theorem alistToFmap_codeIncludes_and_domain {K V : Type} (entries : List (K × V)) :
    codeIncludes entries (HolFiniteMapExact.alistToFmap entries) ∧
    (∀ key value, (HolFiniteMapExact.alistToFmap entries).lookup key = some value → key ∈ entries.map Prod.fst) := by
  constructor
  · intro key value lookup
    rw [alistToFmap_lookup_logical]
    exact lookup
  · exact alistToFmap_codeDomain entries

/-- When target code is exactly the association-list map, the ordered oracle
and source syntax conditions establish incremental readiness and open-location
avoidance. This is Flapjack-specific infrastructure; it does not assert the
remaining clauses of HOL's `code_inv`. -/
theorem incrementalInstallReady_of_ordered_alistCode {C F : Type} (g : State) (allowed : Set Nat)
    (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (well : wellFormed g) (code : target.code = HolFiniteMapExact.alistToFmap g.2)
    (known : g.1 = (source.compileOracle 0).1.1)
    (auxEmpty : ∀ index, (source.compileOracle index).2.2 = [])
    (distinct : ∀ index, (codeLocations (source.compileOracle index).2.1).Nodup)
    (locations : ∀ index, everyFnLocationSome (source.compileOracle index).2.1)
    (annotations : ∀ index, everyFnVarsNone (source.compileOracle index).2.1)
    (ordered : OracleLocationsOrdered g allowed source) :
    IncrementalInstallReady g source target ∧ OracleLocationsAvoid allowed source := by
  apply incrementalInstallReady_of_ordered g allowed source target well ?_ ?_ known auxEmpty distinct locations annotations ordered
  · rw [code]
    exact (alistToFmap_codeIncludes_and_domain g.2).1
  · rw [code]
    exact (alistToFmap_codeIncludes_and_domain g.2).2

/-- The ordered-location projection is exactly the existing backend oracle
monotonicity predicate instantiated with closure-call locations and the union
of known and open locations. This is Flapjack-specific infrastructure. -/
theorem oracleLocationsOrdered_iff_oracleMonotonic {C F : Type} (g : State) (allowed : Set Nat)
    (source : ClosSem.State C F) :
    OracleLocationsOrdered g allowed source ↔
      BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
        (sptDomain g.1 ∪ allowed) source.compileOracle := by
  constructor
  · intro ordered
    constructor
    · exact ordered.1
    · intro index x y member later
      apply ordered.2 index x y ?_ later
      exact member
  · intro ordered
    constructor
    · exact ordered.1
    · intro index x y member later
      apply ordered.2 index x y ?_ later
      exact member

/-- A source-shaped oracle-monotonicity hypothesis supplies the ordering used
by incremental readiness. This is Flapjack-specific infrastructure. -/
theorem incrementalInstallReady_of_oracleMonotonic {C F : Type} (g : State) (allowed : Set Nat)
    (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (well : wellFormed g) (code : target.code = HolFiniteMapExact.alistToFmap g.2)
    (known : g.1 = (source.compileOracle 0).1.1)
    (auxEmpty : ∀ index, (source.compileOracle index).2.2 = [])
    (distinct : ∀ index, (codeLocations (source.compileOracle index).2.1).Nodup)
    (locations : ∀ index, everyFnLocationSome (source.compileOracle index).2.1)
    (annotations : ∀ index, everyFnVarsNone (source.compileOracle index).2.1)
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      (sptDomain g.1 ∪ allowed) source.compileOracle) :
    IncrementalInstallReady g source target ∧ OracleLocationsAvoid allowed source := by
  apply incrementalInstallReady_of_ordered_alistCode g allowed source target well code known auxEmpty distinct locations annotations
  exact (oracleLocationsOrdered_iff_oracleMonotonic g allowed source).2 ordered

/-- Closure-call source syntax requires function locations, absent
free-variable annotations, and distinct code locations. -/
@[hol "cakeml/compiler/backend/proofs/clos_callProofScript.sml" "syntax_ok_def"]
def syntaxOk (expressions : List ClosLang.Exp) : Prop :=
  everyFnLocationSome expressions ∧ everyFnVarsNone expressions ∧ (codeLocations expressions).Nodup

/-- Source-shaped syntax and oracle monotonicity conditions establish the
readiness projections used by the incremental simulation. This is
Flapjack-specific infrastructure; the remaining `code_inv` clauses are not
asserted here. -/
theorem incrementalInstallReady_of_syntax_and_oracleMonotonic {C F : Type}
    (g : State) (allowed : Set Nat) (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (well : wellFormed g) (code : target.code = HolFiniteMapExact.alistToFmap g.2)
    (known : g.1 = (source.compileOracle 0).1.1)
    (syntaxOracle : ∀ index, syntaxOk (source.compileOracle index).2.1 ∧ (source.compileOracle index).2.2 = [])
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      (sptDomain g.1 ∪ allowed) source.compileOracle) :
    IncrementalInstallReady g source target ∧ OracleLocationsAvoid allowed source := by
  apply incrementalInstallReady_of_oracleMonotonic g allowed source target well code known
  · intro index; exact (syntaxOracle index).2
  · intro index; exact (syntaxOracle index).1.2.2
  · intro index; exact (syntaxOracle index).1.1
  · intro index; exact (syntaxOracle index).1.2.1
  · exact ordered

/-- Fuel-indexed specialization of the source code-invariant clauses for a
known compiler state. The incremental pass is Flapjack's bounded, totalized
adapter, so this is not tagged as HOL's `code_inv`. -/
def IncrementalCodeInv {C F : Type} (fuel : Nat) (g : State) (allowed : Set Nat)
    (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F) : Prop :=
  source.code = HolFiniteMapExact.empty ∧
  source.compile = compileIncFuelCallback fuel target.compile ∧
  target.compileOracle = compileIncFuelOracle fuel source.compileOracle ∧
  wellFormed g ∧ g.1 = (source.compileOracle 0).1.1 ∧
  BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
    (sptDomain g.1 ∪ allowed) source.compileOracle ∧
  target.code = HolFiniteMapExact.alistToFmap g.2 ∧
  ∀ index, syntaxOk (source.compileOracle index).2.1 ∧ (source.compileOracle index).2.2 = []

/-- The source-shaped, fuel-indexed code invariant provides the readiness
and open-location conditions consumed by the closed simulation. This is
Flapjack-specific infrastructure. -/
theorem IncrementalCodeInv.ready {C F : Type} {fuel : Nat} {g : State} {allowed : Set Nat}
    {source : ClosSem.State (NumSet × C) F} {target : ClosSem.State C F}
    (inv : IncrementalCodeInv fuel g allowed source target) :
    IncrementalInstallReady g source target ∧ OracleLocationsAvoid allowed source := by
  obtain ⟨_, _, _, well, known, ordered, code, syntaxOracle⟩ := inv
  exact incrementalInstallReady_of_syntax_and_oracleMonotonic g allowed source target well code known syntaxOracle ordered

/-- The production list traversal simulates a non-type-error source run
under the fuel-indexed code invariant. The conclusion retains the weaker
readiness invariant; preservation of the complete source-shaped invariant
remains to be proved. This is Flapjack-specific simulation infrastructure,
not a port of HOL's `calls_correct`. -/
theorem callsListBounded_sim_of_IncrementalCodeInv {C F : Type}
    (passFuel relationFuel traversalFuel : Nat) (compiler : ClosSem.Compiler C)
    (sourceExps targetExps : List ClosLang.Exp) (initial passFinal g : State) (allowed : Set Nat)
    (sourceEnv targetEnv : List ClosSem.Value)
    (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (result : SemanticPrimitivesHOL.Result (List ClosSem.Value) ClosSem.Value)
    (final : ClosSem.State (NumSet × C) F)
    (passRun : callsListBounded traversalFuel sourceExps initial = some (targetExps, passFinal))
    (distinct : (codeLocations sourceExps).Nodup) (fresh : LabelsFresh (codeLocations sourceExps) initial)
    (initialWf : wellFormed initial) (locations : everyFnLocationSome sourceExps) (annotations : everyFnVarsNone sourceExps)
    (growth : stateExtends passFinal g)
    (coverage : ∀ loc ∈ codeLocations sourceExps, ¬ sptDomain passFinal.1 loc → loc ∈ allowed)
    (run : evaluate sourceExps sourceEnv source = (result, final)) (notType : result ≠ .err (.abort .typeError))
    (envs : EnvRelFuel relationFuel g allowed target.code sourceEnv targetEnv 0 (targetExps.map (0, ·)))
    (envWf : ValuesWellFormedFuel relationFuel g allowed target.code sourceEnv)
    (sourceWf : StateWellFormedFuel relationFuel g allowed target.code source)
    (states : StateRelFuel relationFuel g allowed source target) (inv : IncrementalCodeInv passFuel g allowed source target)
    (disjoint : Disjoint allowed (sptDomain g.1)) (targetCompiler : target.compile = compiler) :
    ∃ extraClock finalG finalAllowed targetResult targetFinal,
      stateExtends g finalG ∧ allowed ⊆ finalAllowed ∧
      Disjoint finalAllowed (sptDomain finalG.1) ∧ OracleLocationsAvoid finalAllowed final ∧
      evaluate targetExps targetEnv { target with clock := target.clock + extraClock } = (targetResult, targetFinal) ∧
      resultRel (List.Forall₂ (ValueRelFuel relationFuel finalG finalAllowed targetFinal.code))
        (ValueRelFuel relationFuel finalG finalAllowed targetFinal.code) result targetResult ∧
      ResultWellFormedFuel relationFuel finalG finalAllowed targetFinal.code result ∧
      StateRelFuel relationFuel finalG finalAllowed final targetFinal ∧
      StateWellFormedFuel relationFuel finalG finalAllowed targetFinal.code final ∧
      IncrementalInstallReady finalG final targetFinal ∧
      final.compile = compileIncFuelCallback passFuel compiler ∧ targetFinal.compile = compiler ∧
      targetFinal.compileOracle = compileIncFuelOracle passFuel final.compileOracle ∧
      (∀ key entry, target.code.lookup key = some entry → targetFinal.code.lookup key = some entry) := by
  have ⟨ready, avoids⟩ := inv.ready
  have sourceCompiler : source.compile = compileIncFuelCallback passFuel compiler := by
    simpa [targetCompiler] using inv.2.1
  have oracle := inv.2.2.1
  exact callsListBounded_withCoveredOpenClockAndResultWf passFuel relationFuel traversalFuel (source.clock + 1) compiler
    sourceExps targetExps initial passFinal passRun distinct fresh initialWf locations annotations
    g growth allowed sourceEnv targetEnv source target result final coverage (by omega) run notType envs envWf sourceWf
    states ready disjoint avoids sourceCompiler targetCompiler oracle

/-- Related closure application simulates a non-type-error source run under
the fuel-indexed code invariant. The conclusion retains readiness rather than
the complete source-shaped invariant. This is Flapjack-specific simulation
infrastructure, not a port of HOL's `calls_correct`. -/
theorem evaluateApp_sim_of_IncrementalCodeInv {C F : Type}
    (passFuel relationFuel : Nat) (compiler : ClosSem.Compiler C) (location : Option Nat)
    (g : State) (allowed : Set Nat) (function targetFunction : ClosSem.Value) (args targetArgs : List ClosSem.Value)
    (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (result : SemanticPrimitivesHOL.Result (List ClosSem.Value) ClosSem.Value)
    (final : ClosSem.State (NumSet × C) F)
    (run : evaluateApp location function args source = (result, final)) (notType : result ≠ .err (.abort .typeError))
    (functions : ValueRelFuel relationFuel g allowed target.code function targetFunction)
    (arguments : List.Forall₂ (ValueRelFuel relationFuel g allowed target.code) args targetArgs)
    (functionWf : ValueWellFormedFuel relationFuel g allowed target.code function)
    (argsWf : ValuesWellFormedFuel relationFuel g allowed target.code args)
    (sourceWf : StateWellFormedFuel relationFuel g allowed target.code source)
    (states : StateRelFuel relationFuel g allowed source target) (inv : IncrementalCodeInv passFuel g allowed source target)
    (disjoint : Disjoint allowed (sptDomain g.1)) (targetCompiler : target.compile = compiler) :
    ∃ extraClock finalG finalAllowed targetResult targetFinal,
      stateExtends g finalG ∧ allowed ⊆ finalAllowed ∧
      Disjoint finalAllowed (sptDomain finalG.1) ∧ OracleLocationsAvoid finalAllowed final ∧
      evaluateApp location targetFunction targetArgs { target with clock := target.clock + extraClock } = (targetResult, targetFinal) ∧
      resultRel (List.Forall₂ (ValueRelFuel relationFuel finalG finalAllowed targetFinal.code))
        (ValueRelFuel relationFuel finalG finalAllowed targetFinal.code) result targetResult ∧
      ResultWellFormedFuel relationFuel finalG finalAllowed targetFinal.code result ∧
      StateRelFuel relationFuel finalG finalAllowed final targetFinal ∧
      StateWellFormedFuel relationFuel finalG finalAllowed targetFinal.code final ∧
      IncrementalInstallReady finalG final targetFinal ∧
      final.compile = compileIncFuelCallback passFuel compiler ∧ targetFinal.compile = compiler ∧
      targetFinal.compileOracle = compileIncFuelOracle passFuel final.compileOracle ∧
      (∀ key entry, target.code.lookup key = some entry → targetFinal.code.lookup key = some entry) := by
  have ⟨ready, avoids⟩ := inv.ready
  have sourceCompiler : source.compile = compileIncFuelCallback passFuel compiler := by
    simpa [targetCompiler] using inv.2.1
  have oracle := inv.2.2.1
  exact growingAppSimClockBelowWithOpenClockAndResultWf passFuel relationFuel (source.clock + 1) compiler location
    g allowed function targetFunction args targetArgs source target result final (by omega) run notType functions arguments
    functionWf argsWf sourceWf states ready disjoint avoids sourceCompiler targetCompiler oracle

/-- If a label is absent from a list, adding that list in front of an
association-list map leaves its lookup unchanged. This is Flapjack-specific
map infrastructure. -/
theorem alistToFmap_append_lookup_of_not_mem {V : Type} (front back : List (Nat × V)) (key : Nat)
    (absent : key ∉ front.map Prod.fst) :
    (HolFiniteMapExact.alistToFmap (front ++ back)).lookup key =
      (HolFiniteMapExact.alistToFmap back).lookup key := by
  induction front with
  | nil => rfl
  | cons entry rest ih =>
    have different : key ≠ entry.1 := by
      intro equal
      apply absent
      simp [equal]
    have tailAbsent : key ∉ rest.map Prod.fst := by
      intro member
      apply absent
      simp [member]
    rw [List.cons_append, HolFiniteMapExact.lookup_alistToFmap_tail entry (rest ++ back) key different]
    exact ih tailAbsent

/-- Installing distinct generated entries in an association-list code map
produces the same lookups as prepending those entries to the code list. This
is Flapjack-specific map infrastructure used to preserve exact target code. -/
theorem updateListEq_alistToFmap_lookup {V : Type} (oldEntries newEntries : List (Nat × V))
    (distinct : (newEntries.map Prod.fst).Nodup) (key : Nat) :
    ((HolFiniteMapExact.alistToFmap oldEntries).updateListEq newEntries).lookup key =
      (HolFiniteMapExact.alistToFmap (newEntries ++ oldEntries)).lookup key := by
  by_cases member : key ∈ newEntries.map Prod.fst
  · obtain ⟨⟨label, value⟩, entryMember, equal⟩ := List.mem_map.mp member
    dsimp at equal
    subst label
    have newLookup := logicalAssocLookup_of_mem newEntries key value distinct entryMember
    have combinedLookup := logicalAssocLookup_append_hit newEntries oldEntries key value newLookup
    rw [alistToFmap_lookup_logical, combinedLookup]
    exact lookup_updateListEq_of_mem_unique (HolFiniteMapExact.alistToFmap oldEntries) newEntries distinct key value entryMember
  · rw [alistToFmap_append_lookup_of_not_mem newEntries oldEntries key member,
      HolFiniteMapExact.lookup_updateListEq]
    exact FLOOKUP_FUPDATE_LIST_HOL_not_mem (HolFiniteMapExact.alistToFmap oldEntries).lookup newEntries key member

/-- Finite-support maps are equal when all their lookups agree. This is
Flapjack-specific representation infrastructure. -/
theorem holFiniteMapExact_eq_of_lookup {K V : Type} (left right : HolFiniteMapExact K V)
    (same : ∀ key, left.lookup key = right.lookup key) : left = right := by
  cases left with
  | mk leftLookup leftSupport =>
    cases right with
    | mk rightLookup rightSupport =>
      have equal : leftLookup = rightLookup := funext same
      cases equal
      rfl

/-- Installing distinct generated entries in an association-list map yields
the map of the generated entries followed by the old entries. This is
Flapjack-specific map infrastructure. -/
theorem updateListEq_alistToFmap {V : Type} (oldEntries newEntries : List (Nat × V))
    (distinct : (newEntries.map Prod.fst).Nodup) :
    (HolFiniteMapExact.alistToFmap oldEntries).updateListEq newEntries =
      HolFiniteMapExact.alistToFmap (newEntries ++ oldEntries) := by
  apply holFiniteMapExact_eq_of_lookup
  exact updateListEq_alistToFmap_lookup oldEntries newEntries distinct

/-- A successful incremental compilation preserves the exact association-list
code-map shape when its generated labels are distinct. This is Flapjack-specific
infrastructure for preserving the code invariant. -/
theorem compileIncFuel_install_exactCode (fuel : Nat) (g : State) (program : ClosSem.Program)
    (nextKnown : NumSet) (converted : ClosSem.Program)
    (run : compileIncFuel? fuel g.1 program = some (nextKnown, converted))
    (distinct : (codeLocations program.1).Nodup) :
    (HolFiniteMapExact.alistToFmap g.2).updateListEq converted.2 =
      HolFiniteMapExact.alistToFmap (converted.2 ++ g.2) := by
  exact updateListEq_alistToFmap g.2 converted.2 (compileIncFuel_generated fuel g.1 program nextKnown converted run distinct).1

/-- A non-type-error installation starting from the source-shaped invariant
preserves the exact target code-map clause for the newly emitted compiler
state. This does not yet prove the remaining final code-invariant clauses.
This is Flapjack-specific simulation infrastructure. -/
theorem doInstall_nonType_exactCode {C F : Type} (fuel relationFuel : Nat) (g : State)
    (allowed : Set Nat) (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (sourceValues targetValues : List ClosSem.Value)
    (result : SemanticPrimitivesHOL.Result (List ClosLang.Exp) ClosSem.Value)
    (final : ClosSem.State (NumSet × C) F)
    (states : StateRelFuel relationFuel g allowed source target)
    (values : List.Forall₂ (ValueRelFuel relationFuel g allowed target.code) sourceValues targetValues)
    (inv : IncrementalCodeInv fuel g allowed source target)
    (run : doInstall sourceValues source = (result, final)) (notType : result ≠ .err (.abort .typeError)) :
    ∃ expressions converted nextKnown targetFinal,
      compileIncFuel? fuel g.1 (expressions, []) = some (nextKnown, converted) ∧
      doInstall targetValues target =
        (if source.clock = 0 then .err (.abort .timeoutError) else .val converted.1, targetFinal) ∧
      result = (if source.clock = 0 then .err (.abort .timeoutError) else .val expressions) ∧
      expressions = (source.compileOracle 0).2.1 ∧
      targetFinal.code = HolFiniteMapExact.alistToFmap (converted.2 ++ g.2) := by
  have ⟨ready, _⟩ := inv.ready
  obtain ⟨expressions, converted, nextKnown, targetFinal, passRun, targetRun, resultEq, exprEq,
    _, codeEq, _, _, _, _, _, _⟩ :=
    doInstall_nonType_incremental fuel relationFuel g allowed target.compile source target sourceValues targetValues
      result final states values ready.well.2 inv.2.1 rfl inv.2.2.1 (ready.auxEmpty 0)
      (ready.distinct 0) (ready.fresh 0) run notType
  have passRun' : compileIncFuel? fuel g.1 (expressions, []) = some (nextKnown, converted) := by
    simpa [ready.known] using passRun
  have distinct : (codeLocations expressions).Nodup := by simpa [exprEq] using ready.distinct 0
  refine ⟨expressions, converted, nextKnown, targetFinal, passRun', targetRun, resultEq, exprEq, ?_⟩
  rw [codeEq, inv.2.2.2.2.2.2.1]
  exact compileIncFuel_install_exactCode fuel g (expressions, []) nextKnown converted passRun' distinct

/-- Every location known after an incremental pass was previously known or
occurs in the compiled program. This is Flapjack-specific infrastructure for
preserving the oracle ordering invariant. -/
theorem compileIncFuel_known_origin (fuel : Nat) (known : NumSet) (program : ClosSem.Program)
    (nextKnown : NumSet) (converted : ClosSem.Program)
    (run : compileIncFuel? fuel known program = some (nextKnown, converted)) :
    ∀ loc, sptDomain nextKnown loc → sptDomain known loc ∨ loc ∈ codeLocations program.1 := by
  have traversal := compileIncFuel_traversal fuel known program nextKnown converted run
  have origins := callsListBounded_knownBound fuel program.1 (known, []) (nextKnown, converted.2) converted.1 traversal
  have labels := callsListBounded_labelsBound fuel program.1 (known, []) (nextKnown, converted.2) converted.1 traversal
  intro loc knownLoc
  rcases origins loc knownLoc with old | generated
  · exact Or.inl old
  · rcases labels (loc + 1) generated with old | ⟨origin, member, equal⟩
    · simp at old
    · have same : origin = loc := by omega
      subst origin
      exact Or.inr member

/-- After an oracle shift, incremental compilation preserves ordering for
its new known locations and the open locations introduced by the current
program. This is Flapjack-specific invariant infrastructure. -/
theorem oracleLocationsOrdered_after_compile {C F : Type} (fuel : Nat) (g : State) (allowed : Set Nat)
    (source final : ClosSem.State C F) (program : ClosSem.Program) (nextKnown : NumSet)
    (converted : ClosSem.Program)
    (ordered : OracleLocationsOrdered g allowed source)
    (programEq : program.1 = (source.compileOracle 0).2.1)
    (pass : compileIncFuel? fuel g.1 program = some (nextKnown, converted))
    (shift : final.compileOracle = holShiftSeq 1 source.compileOracle) :
    OracleLocationsOrdered (nextKnown, converted.2 ++ g.2)
      (allowed ∪ {loc | loc ∈ codeLocations program.1 ∧ ¬ sptDomain nextKnown loc}) final := by
  have origin := compileIncFuel_known_origin fuel g.1 program nextKnown converted pass
  constructor
  · intro earlier later x y before xMember yMember
    have xOriginal : x ∈ codeLocations (source.compileOracle (earlier + 1)).2.1 := by
      simpa [shift, holShiftSeq] using xMember
    have yOriginal : y ∈ codeLocations (source.compileOracle (later + 1)).2.1 := by
      simpa [shift, holShiftSeq] using yMember
    exact ordered.1 (earlier + 1) (later + 1) x y (by omega) xOriginal yOriginal
  · intro index x y first yMember
    have yOriginal : y ∈ codeLocations (source.compileOracle (index + 1)).2.1 := by
      simpa [shift, holShiftSeq] using yMember
    have currentBefore : x ∈ codeLocations program.1 → x < y := by
      intro member
      apply ordered.1 0 (index + 1) x y (by omega) ?_ yOriginal
      simpa [programEq] using member
    rcases first with newKnown | oldOpen | ⟨current, _⟩
    · rcases origin x newKnown with oldKnown | current
      · exact ordered.2 (index + 1) x y (Or.inl oldKnown) yOriginal
      · exact currentBefore current
    · exact ordered.2 (index + 1) x y (Or.inr oldOpen) yOriginal
    · exact currentBefore current

/-- A non-type-error installation preserves the fuel-indexed source-shaped
code invariant, with precisely the newly open locations added to the old open
set. This is Flapjack-specific infrastructure; it is not HOL's unbounded
`code_inv` theorem. -/
theorem doInstall_nonType_preserves_IncrementalCodeInv {C F : Type} (fuel relationFuel : Nat) (g : State)
    (allowed : Set Nat) (source : ClosSem.State (NumSet × C) F) (target : ClosSem.State C F)
    (sourceValues targetValues : List ClosSem.Value)
    (result : SemanticPrimitivesHOL.Result (List ClosLang.Exp) ClosSem.Value)
    (final : ClosSem.State (NumSet × C) F)
    (states : StateRelFuel relationFuel g allowed source target)
    (values : List.Forall₂ (ValueRelFuel relationFuel g allowed target.code) sourceValues targetValues)
    (inv : IncrementalCodeInv fuel g allowed source target)
    (sourceWf : StateWellFormedFuel relationFuel g allowed target.code source)
    (disjoint : Disjoint allowed (sptDomain g.1))
    (run : doInstall sourceValues source = (result, final)) (notType : result ≠ .err (.abort .typeError)) :
    ∃ expressions converted nextKnown targetFinal,
      compileIncFuel? fuel g.1 (expressions, []) = some (nextKnown, converted) ∧
      doInstall targetValues target =
        (if source.clock = 0 then .err (.abort .timeoutError) else .val converted.1, targetFinal) ∧
      result = (if source.clock = 0 then .err (.abort .timeoutError) else .val expressions) ∧
      stateExtends g (nextKnown, converted.2 ++ g.2) ∧
      Disjoint (allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc}) (sptDomain nextKnown) ∧
      StateRelFuel relationFuel (nextKnown, converted.2 ++ g.2)
        (allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc}) final targetFinal ∧
      StateWellFormedFuel relationFuel (nextKnown, converted.2 ++ g.2)
        (allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc}) targetFinal.code final ∧
      IncrementalCodeInv fuel (nextKnown, converted.2 ++ g.2)
        (allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc}) final targetFinal := by
  have ⟨ready, avoids⟩ := inv.ready
  have savedInv := inv
  obtain ⟨_, sourceCompiler, targetOracle, _, _, ordered, _, _⟩ := inv
  obtain ⟨expressions, converted, nextKnown, targetFinal, passRun, targetRun, resultEq, exprEq,
    _, extended, newReady, finalStates, finalCompiler, targetCompiler, finalOracle, codeGrowth⟩ :=
    doInstall_nonType_ready fuel relationFuel g allowed target.compile source target sourceValues targetValues
      result final ready states values sourceCompiler rfl targetOracle run notType
  obtain ⟨otherExpressions, otherConverted, otherKnown, otherTarget, otherPass, otherRun, _, otherExprEq, exactCode⟩ :=
    doInstall_nonType_exactCode fuel relationFuel g allowed source target sourceValues targetValues result final
      states values savedInv run notType
  have sameExpr : otherExpressions = expressions := otherExprEq.trans exprEq.symm
  rw [sameExpr] at otherPass
  have samePass : (otherKnown, otherConverted) = (nextKnown, converted) := Option.some.inj (otherPass.symm.trans passRun)
  cases samePass
  have sameTarget : otherTarget = targetFinal := congrArg Prod.snd (otherRun.symm.trans targetRun)
  subst otherTarget
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, finalEq, _⟩ :=
    doInstall_nonType_parts sourceValues source final result run notType
  have ordered' : OracleLocationsOrdered (nextKnown, converted.2 ++ g.2)
      (allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc}) final :=
    oracleLocationsOrdered_after_compile fuel g allowed source final (expressions, []) nextKnown converted
      ((oracleLocationsOrdered_iff_oracleMonotonic g allowed source).2 ordered) exprEq passRun (by simpa using congrArg ClosSem.State.compileOracle finalEq)
  have sourceAvoids : ∀ loc ∈ codeLocations expressions, loc ∉ allowed := by
    intro loc member
    apply avoids 0 loc
    simpa [exprEq] using member
  have oldDisjoint : Disjoint allowed (sptDomain nextKnown) :=
    compileIncFuel_disjoint_known fuel g.1 (expressions, []) nextKnown converted allowed passRun disjoint sourceAvoids
  have finalDisjoint : Disjoint (allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc}) (sptDomain nextKnown) := by
    apply Set.disjoint_left.mpr
    intro loc member known
    rcases member with old | ⟨_, unknown⟩
    · exact Set.disjoint_left.mp oldDisjoint old known
    · exact unknown known
  have allowedGrowth : allowed ⊆ allowed ∪ {loc | loc ∈ codeLocations expressions ∧ ¬ sptDomain nextKnown loc} := Set.subset_union_left
  have finalStates' := stateRelFuel_mono finalStates (stateExtends_refl _ newReady.well.2) allowedGrowth
  have installedWf := doInstall_wellFormedFuel sourceValues source final result sourceWf (ready.auxEmpty 0) run
  have finalWf := stateWellFormedFuel_mono installedWf extended allowedGrowth codeGrowth
  refine ⟨expressions, converted, nextKnown, targetFinal, passRun, targetRun, resultEq, extended,
    finalDisjoint, finalStates', finalWf, ?_⟩
  refine ⟨finalStates.2.2.2.2.2, ?_, finalOracle, newReady.well, newReady.known, ?_, exactCode, ?_⟩
  · simpa [targetCompiler] using finalCompiler
  · exact (oracleLocationsOrdered_iff_oracleMonotonic _ _ _).1 ordered'
  · intro index
    exact ⟨⟨newReady.locations index, newReady.annotations index, newReady.distinct index⟩, newReady.auxEmpty index⟩

/-- A finite source-oracle advance preserves closure-call syntax and ordering
relative to the same initial locations. This is Flapjack-specific invariant
infrastructure; it does not account for newly introduced known or open
locations. -/
theorem oracleSyntaxAndOrder_of_advance {C : Type} (initial : Set Nat)
    (oracle next : ClosSem.CompileOracle C)
    (syntaxOracle : ∀ index, syntaxOk (oracle index).2.1 ∧ (oracle index).2.2 = [])
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·) initial oracle)
    (advance : OracleAdvance oracle next) :
    (∀ index, syntaxOk (next index).2.1 ∧ (next index).2.2 = []) ∧
    BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·) initial next := by
  obtain ⟨offset, rfl⟩ := advance
  constructor
  · intro index
    simpa [holShiftSeq] using syntaxOracle (index + offset)
  · constructor
    · intro earlier later x y before xMember yMember
      apply ordered.1 (earlier + offset) (later + offset) x y (by omega)
      · simpa [holShiftSeq] using xMember
      · simpa [holShiftSeq] using yMember
    · intro index x y initialMember yMember
      apply ordered.2 (index + offset) x y initialMember
      simpa [holShiftSeq] using yMember

/-- Any source expression evaluation preserves syntax and ordering of the
remaining oracle relative to the original initial set, including error cases.
This is Flapjack-specific invariant infrastructure. -/
theorem evaluate_oracleSyntaxAndOrder {C F : Type} (initial : Set Nat)
    (expressions : List ClosLang.Exp) (env : List ClosSem.Value)
    (source final : ClosSem.State C F) (result : SemanticPrimitivesHOL.Result (List ClosSem.Value) ClosSem.Value)
    (run : evaluate expressions env source = (result, final))
    (syntaxOracle : ∀ index, syntaxOk (source.compileOracle index).2.1 ∧ (source.compileOracle index).2.2 = [])
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      initial source.compileOracle) :
    (∀ index, syntaxOk (final.compileOracle index).2.1 ∧ (final.compileOracle index).2.2 = []) ∧
    BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      initial final.compileOracle := by
  exact oracleSyntaxAndOrder_of_advance initial source.compileOracle final.compileOracle syntaxOracle ordered
    ((evaluate_oracle_advance (C := C) (F := F)).1 expressions env source final result run)

/-- Closure application also preserves syntax and ordering of the remaining
source oracle relative to the original initial set. This is Flapjack-specific
invariant infrastructure. -/
theorem evaluateApp_oracleSyntaxAndOrder {C F : Type} (initial : Set Nat)
    (location : Option Nat) (function : ClosSem.Value) (args : List ClosSem.Value)
    (source final : ClosSem.State C F) (result : SemanticPrimitivesHOL.Result (List ClosSem.Value) ClosSem.Value)
    (run : evaluateApp location function args source = (result, final))
    (syntaxOracle : ∀ index, syntaxOk (source.compileOracle index).2.1 ∧ (source.compileOracle index).2.2 = [])
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      initial source.compileOracle) :
    (∀ index, syntaxOk (final.compileOracle index).2.1 ∧ (final.compileOracle index).2.2 = []) ∧
    BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      initial final.compileOracle := by
  apply oracleSyntaxAndOrder_of_advance initial source.compileOracle final.compileOracle syntaxOracle ordered
  exact (evaluate_oracle_advance (C := C) (F := F)).2 (source.clock + 1) location function args source final result (by omega) run

/-- Locations appearing in oracle entries consumed before an offset. This
Flapjack-specific set supports arbitrary finite oracle advances. -/
def OraclePastLocations {C : Type} (oracle : ClosSem.CompileOracle C) (offset : Nat) : Set Nat :=
  {loc | ∃ index, index < offset ∧ loc ∈ codeLocations (oracle index).2.1}

/-- After advancing an ordered oracle, every original initial location and
every location in the consumed prefix precedes every remaining oracle
location. This is Flapjack-specific invariant infrastructure. -/
theorem oracleMonotonic_after_prefix {C : Type} (initial : Set Nat) (oracle : ClosSem.CompileOracle C)
    (offset : Nat)
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·) initial oracle) :
    BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      (initial ∪ OraclePastLocations oracle offset) (holShiftSeq offset oracle) := by
  constructor
  · intro earlier later x y before xMember yMember
    apply ordered.1 (earlier + offset) (later + offset) x y (by omega)
    · simpa [holShiftSeq] using xMember
    · simpa [holShiftSeq] using yMember
  · intro index x y member yMember
    have later : y ∈ codeLocations (oracle (index + offset)).2.1 := by simpa [holShiftSeq] using yMember
    rcases member with original | ⟨past, before, pastMember⟩
    · exact ordered.2 (index + offset) x y original later
    · exact ordered.1 past (index + offset) x y (by omega) pastMember later

/-- Any finite advance preserves oracle ordering when the initial set is
expanded by locations from the consumed prefix. This is Flapjack-specific
invariant infrastructure. -/
theorem oracleMonotonic_of_advance_with_prefix {C : Type} (initial : Set Nat)
    (oracle next : ClosSem.CompileOracle C)
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·) initial oracle)
    (advance : OracleAdvance oracle next) :
    ∃ offset, next = holShiftSeq offset oracle ∧
      BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
        (initial ∪ OraclePastLocations oracle offset) next := by
  obtain ⟨offset, equal⟩ := advance
  refine ⟨offset, equal, ?_⟩
  rw [equal]
  exact oracleMonotonic_after_prefix initial oracle offset ordered

/-- Source evaluation retains oracle ordering above both the original set and
the locations in the oracle prefix that evaluation consumed. This is
Flapjack-specific invariant infrastructure. -/
theorem evaluate_oracleMonotonic_with_consumed_prefix {C F : Type} (initial : Set Nat)
    (expressions : List ClosLang.Exp) (env : List ClosSem.Value)
    (source final : ClosSem.State C F) (result : SemanticPrimitivesHOL.Result (List ClosSem.Value) ClosSem.Value)
    (run : evaluate expressions env source = (result, final))
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      initial source.compileOracle) :
    ∃ offset, final.compileOracle = holShiftSeq offset source.compileOracle ∧
      BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
        (initial ∪ OraclePastLocations source.compileOracle offset) final.compileOracle := by
  exact oracleMonotonic_of_advance_with_prefix initial source.compileOracle final.compileOracle ordered
    ((evaluate_oracle_advance (C := C) (F := F)).1 expressions env source final result run)

/-- Closure application preserves ordering above the original locations and
the consumed source-oracle prefix. This is Flapjack-specific invariant
infrastructure. -/
theorem evaluateApp_oracleMonotonic_with_consumed_prefix {C F : Type} (initial : Set Nat)
    (location : Option Nat) (function : ClosSem.Value) (args : List ClosSem.Value)
    (source final : ClosSem.State C F) (result : SemanticPrimitivesHOL.Result (List ClosSem.Value) ClosSem.Value)
    (run : evaluateApp location function args source = (result, final))
    (ordered : BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
      initial source.compileOracle) :
    ∃ offset, final.compileOracle = holShiftSeq offset source.compileOracle ∧
      BackendProps.oracleMonotonic (fun entry => {loc | loc ∈ codeLocations entry.2.1}) (· < ·)
        (initial ∪ OraclePastLocations source.compileOracle offset) final.compileOracle := by
  apply oracleMonotonic_of_advance_with_prefix initial source.compileOracle final.compileOracle ordered
  exact (evaluate_oracle_advance (C := C) (F := F)).2 (source.clock + 1) location function args source final result (by omega) run

