module

public import Flapjack.Compiler.Backend.ClosCall.Proofs.Length
public import Flapjack.Compiler.Backend.ClosCall.Proofs.TotalCorrespondence
public import Flapjack.Compiler.Backend.Semantics.ClosProps.CodeLocations

@[expose] public section

/-! Origins of labels generated by direct-call conversion. -/
namespace Flapjack.Compiler.Backend.ClosCall
open ClosLang ClosProps

/-- Every output label is either an existing label or the successor of an
input closure location. This predicate is Flapjack proof infrastructure. -/
def LabelsBound (initial final : State) (locations : List Nat) : Prop :=
  ∀ label ∈ final.2.map Prod.fst,
    label ∈ initial.2.map Prod.fst ∨ ∃ loc ∈ locations, label = loc + 1

private theorem labelsBound_refl (state : State) (locations : List Nat) :
    LabelsBound state state locations := by
  intro label member
  exact Or.inl member

private theorem labelsBound_mono {initial final : State} {small large : List Nat}
    (bound : LabelsBound initial final small) (sub : ∀ x ∈ small, x ∈ large) :
    LabelsBound initial final large := by
  intro label member
  rcases bound label member with old | ⟨loc, inSmall, eq⟩
  · exact Or.inl old
  · exact Or.inr ⟨loc, sub loc inSmall, eq⟩

private theorem labelsBound_append {s0 s1 s2 : State} {xs ys : List Nat}
    (first : LabelsBound s0 s1 xs) (second : LabelsBound s1 s2 ys) :
    LabelsBound s0 s2 (xs ++ ys) := by
  intro label member
  rcases second label member with inFirst | ⟨loc, inY, eq⟩
  · rcases first label inFirst with old | ⟨loc, inX, eq⟩
    · exact Or.inl old
    · exact Or.inr ⟨loc, List.mem_append_left _ inX, eq⟩
  · exact Or.inr ⟨loc, List.mem_append_right _ inY, eq⟩

/-- Flapjack bookkeeping for labels emitted by code lists; no separate HOL theorem. -/
theorem codeList_bound (loc : Nat) (fns : List (Nat × Exp)) (state : State) :
    LabelsBound state (codeList loc fns state)
      ((List.range fns.length).map (fun i => loc + 2 * i)) := by
  intro label member
  rw [codeList_labels] at member
  simp only [List.mem_append, List.mem_reverse, List.mem_map, List.mem_range] at member ⊢
  rcases member with ⟨i, bound, rfl⟩ | old
  · right
    refine ⟨loc + 2 * i, ⟨i, bound, rfl⟩, ?_⟩
    omega
  · exact Or.inl old

mutual
/-- Every label emitted by a successful expression traversal originates in
the incoming code or at an input closure location. The fuel condition makes
this an executable-pass invariant rather than an exact HOL theorem port. -/
private theorem callsFuel_labelsBound (fuel : Nat) (e : Exp) (initial final : State) (out : Exp)
    (run : callsFuel fuel e initial = some (out, final)) :
    LabelsBound initial final (codeLocationsExp e) := by
  cases fuel with
  | zero => simp [callsFuel] at run
  | succ fuel =>
    cases e with
    | var tr n => simp [callsFuel] at run; obtain ⟨_, rfl⟩ := run; exact labelsBound_refl _ _
    | ifThenElse tr x y z =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure,
        Option.some.injEq, Prod.mk.injEq] at run
      obtain ⟨⟨x', s1⟩, hx, ⟨y', s2⟩, hy, ⟨z', s3⟩, hz, _, rfl⟩ := run
      simpa only [codeLocationsExp] using labelsBound_append
        (labelsBound_append (callsFuel_labelsBound fuel x initial s1 x' hx)
          (callsFuel_labelsBound fuel y s1 s2 y' hy))
        (callsFuel_labelsBound fuel z s2 s3 z' hz)
    | «let» tr xs body =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure,
        Option.some.injEq, Prod.mk.injEq] at run
      obtain ⟨⟨xs', s1⟩, hx, ⟨body', s2⟩, hb, _, rfl⟩ := run
      simpa only [codeLocationsExp] using labelsBound_append
        (callsListFuel_labelsBound fuel xs initial s1 xs' hx)
        (callsFuel_labelsBound fuel body s1 s2 body' hb)
    | raise tr x | tick tr x =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure,
        Option.some.injEq, Prod.mk.injEq] at run
      obtain ⟨⟨x', s1⟩, hx, _, rfl⟩ := run
      exact callsFuel_labelsBound fuel x initial s1 x' hx
    | handle tr x y =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure,
        Option.some.injEq, Prod.mk.injEq] at run
      obtain ⟨⟨x', s1⟩, hx, ⟨y', s2⟩, hy, _, rfl⟩ := run
      exact labelsBound_append (callsFuel_labelsBound fuel x initial s1 x' hx)
        (callsFuel_labelsBound fuel y s1 s2 y' hy)
    | call tr ticks dest xs | op tr dest xs =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure,
        Option.some.injEq, Prod.mk.injEq] at run
      obtain ⟨⟨xs', s1⟩, hx, _, rfl⟩ := run
      exact callsListFuel_labelsBound fuel xs initial s1 xs' hx
    | app tr loc x xs =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure] at run
      obtain ⟨⟨xs', s1⟩, hx, ⟨x', s2⟩, hy, rest⟩ := run
      have endState : s2 = final := by
        cases loc <;> simp only at rest
        all_goals repeat' split at rest
        all_goals simp_all only [Option.some.injEq, Prod.mk.injEq]
      subst final
      apply labelsBound_mono (labelsBound_append
        (callsListFuel_labelsBound fuel xs initial s1 xs' hx)
        (callsFuel_labelsBound fuel x s1 s2 x' hy))
      simp [codeLocationsExp, List.mem_append, or_comm]
    | fn name loc ws arity body =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure] at run
      obtain ⟨⟨body', s1⟩, hb, closed, _, rest⟩ := run
      cases closed with
      | false =>
        simp only [Bool.false_eq_true, ↓reduceIte, Option.bind_eq_some_iff,
          Option.some.injEq, Prod.mk.injEq] at rest
        obtain ⟨⟨body'', s2⟩, hb', _, rfl⟩ := rest
        apply labelsBound_mono (callsFuel_labelsBound fuel body initial s2 body'' hb')
        simp only [codeLocationsExp, List.mem_append, List.mem_singleton]
        aesop
      | true =>
        simp only [↓reduceIte, Option.some.injEq, Prod.mk.injEq] at rest
        obtain ⟨_, rfl⟩ := rest
        have before : LabelsBound initial s1 (codeLocationsExp body) := by
          simpa only [LabelsBound, insertEach] using
            callsFuel_labelsBound fuel body (insertEach (loc.getD 0) 1 initial) s1 body' hb
        intro label member
        simp only [List.map_cons, List.mem_cons] at member
        rcases member with eq | old
        · right
          exact ⟨loc.getD 0, by simp [codeLocationsExp], eq⟩
        · rcases before label old with existing | ⟨origin, mem, eq⟩
          · exact Or.inl existing
          · exact Or.inr ⟨origin, by simp [codeLocationsExp, mem], eq⟩
    | letrec names loc ws fns body =>
      simp only [callsFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure] at run
      obtain ⟨⟨bodies, s1⟩, hb, closed, _, rest⟩ := run
      cases closed with
      | false =>
        simp only [Bool.false_eq_true, ↓reduceIte, Option.bind_eq_some_iff,
          Option.some.injEq, Prod.mk.injEq] at rest
        obtain ⟨⟨bodies', s2⟩, hb', ⟨body', s3⟩, he, _, rfl⟩ := rest
        have bounds := labelsBound_append
          (callsListFuel_labelsBound fuel (fns.map Prod.snd) initial s2 bodies' hb')
          (callsFuel_labelsBound fuel body s2 s3 body' he)
        apply labelsBound_mono bounds
        simp only [← codeLocationsFuns_map, codeLocationsExp, List.mem_append]
        aesop
      | true =>
        simp only [↓reduceIte, Option.bind_eq_some_iff, Option.some.injEq,
          Prod.mk.injEq] at rest
        obtain ⟨⟨body', s2⟩, he, _, rfl⟩ := rest
        have before : LabelsBound initial s1 (codeLocationsFuns fns) := by
          simpa only [LabelsBound, insertEach, ← codeLocationsFuns_map] using
            callsListFuel_labelsBound fuel (fns.map Prod.snd)
              (insertEach (loc.getD 0) fns.length initial) s1 bodies hb
        have generated := codeList_bound (loc.getD 0) ((fns.map Prod.fst).zip bodies) s1
        rw [convertedFunctions_length fuel fns
          (insertEach (loc.getD 0) fns.length initial) s1 bodies hb] at generated
        simpa only [codeLocationsExp] using labelsBound_append
          (labelsBound_append before generated)
          (callsFuel_labelsBound fuel body _ s2 body' he)
termination_by fuel

/-- The list traversal obeys the same label-origin invariant. -/
private theorem callsListFuel_labelsBound (fuel : Nat) (es : List Exp) (initial final : State)
    (out : List Exp) (run : callsListFuel fuel es initial = some (out, final)) :
    LabelsBound initial final (codeLocations es) := by
  cases es with
  | nil => simp [callsListFuel] at run; obtain ⟨_, rfl⟩ := run; exact labelsBound_refl _ _
  | cons e es =>
    cases fuel with
    | zero => simp [callsListFuel] at run
    | succ fuel =>
      simp only [callsListFuel, Bind.bind, Option.bind_eq_some_iff, Pure.pure,
        Option.some.injEq, Prod.mk.injEq] at run
      obtain ⟨⟨e', s1⟩, he, ⟨es', s2⟩, hs, _, rfl⟩ := run
      exact labelsBound_append (callsFuel_labelsBound fuel e initial s1 e' he)
        (callsListFuel_labelsBound fuel es s1 s2 es' hs)
termination_by fuel
end

/-- The production retry wrapper satisfies the same origin bound. -/
private theorem callsListBounded_labelsBound (fuel : Nat) (es : List Exp) (initial final : State)
    (out : List Exp) (run : callsListBounded fuel es initial = some (out, final)) :
    LabelsBound initial final (codeLocations es) := by
  unfold callsListBounded at run
  cases first : callsListFuel fuel es initial with
  | some result =>
    simp only [first, Option.some.injEq] at run
    subst result
    exact callsListFuel_labelsBound fuel es initial final out first
  | none =>
    simp only [first] at run
    exact callsListFuel_labelsBound _ es initial final out run

/-- Every emitted auxiliary label is old or the successor of an input
closure location. -/
@[hol "cakeml/compiler/backend/proofs/clos_callProofScript.sml" "calls_add_SUC_code_locs"]
theorem calls_addSucc_codeLocations (xs : List Exp) (initial : State) (ys : List Exp)
    (final : State) (run : calls xs initial = (ys, final)) :
    {x | x ∈ final.2.map Prod.fst} ⊆
      {x | x ∈ initial.2.map Prod.fst} ∪ Nat.succ '' {x | x ∈ codeLocations xs} := by
  have bounded := callsListBounded_correct 0 xs initial
  change callsSingList xs initial = (ys, final) at run
  rw [run] at bounded
  have bound := callsListBounded_labelsBound 0 xs initial final ys bounded
  intro label member
  rcases bound label member with old | ⟨loc, inLocations, eq⟩
  · exact Or.inl old
  · exact Or.inr ⟨loc, inLocations, by simpa [Nat.succ_eq_add_one] using eq.symm⟩


end Flapjack.Compiler.Backend.ClosCall
