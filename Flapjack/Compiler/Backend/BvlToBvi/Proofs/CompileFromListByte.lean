import Flapjack.Compiler.Backend.BvlToBvi.Proofs.FromListByteStub

/-! Byte-list to byte-array lowering in BVL-to-BVI simulation. -/
namespace Flapjack.Compiler.Backend.BvlToBvi.Proofs
open Flapjack.Compiler.Backend.BvlSem (Value)

/-- Evaluate a head and a tail, allowing the tail to change state. -/
theorem evaluate_cons_threaded {C F : Type} (first : Bvi.Exp) (rest : List Bvi.Exp) (env : List Value)
    (state middle final : BviSem.BviState C F) (value : Value) (values : List Value)
    (headRun : BviSem.evaluate [first] env state = (.val [value], middle))
    (tailRun : BviSem.evaluate rest env middle = (.val values, final)) :
    BviSem.evaluate (first :: rest) env state = (.val (value :: values), final) := by
  change BviSem.evaluateTuple (first :: rest, env, state) = _
  rw [BviSem.evaluateCons]
  simp [BviSem.evaluateTuple, headRun, tailRun, Flapjack.holHd]

/-- The generated byte-list body allocates and fills a fresh array. Untagged
pending BVI evaluator and dispatcher correspondence review. -/
theorem evaluate_fromListByteBody {C F : Type} (value : Value) (bytes : List (BitVec 8))
    (env : List Value) (state : BviSem.BviState C F)
    (lengthCode : sptLookup listLengthLocation state.code = some listLengthCode)
    (writerCode : sptLookup fromListByteLocation state.code = some fromListByteCode)
    (decode : BvlSem.valueToList value = some (bytes.map (fun byte => .number byte.toNat))) :
    ∃ clock, BviSem.evaluate [.call 0 (some fromListByteLocation)
      [.var 0, .op (.intOp (.const 0)) [],
        .op (.memOp (.refByte true)) [.op (.intOp (.const 0)) [],
          .call 0 (some listLengthLocation) [.var 0, .op (.intOp (.const 0)) []] none]] none]
      (value :: env) (BviProps.incClock clock state) =
      (.val [.refPtr true (BvlSem.leastUnusedRef state.refs)],
        { state with refs := state.refs.updateEq (BvlSem.leastUnusedRef state.refs, .byteArray true bytes) }) := by
  let ptr := BvlSem.leastUnusedRef state.refs
  let zeros : List (BitVec 8) := List.replicate bytes.length 0
  let allocated : BviSem.BviState C F := { state with refs := state.refs.updateEq (ptr, .byteArray true zeros) }
  have arrayLookup : allocated.refs.lookup ptr = some (.byteArray true ([] ++ zeros)) := by
    simp [allocated, HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL]
  have arrayCode : sptLookup fromListByteLocation allocated.code = some fromListByteCode := by simpa [allocated] using writerCode
  obtain ⟨writerClock, writerRun⟩ := evaluate_fromListByte bytes [] zeros ptr true true allocated (by simp [zeros]) arrayLookup arrayCode
  have writerResult : BviSem.evaluate [fromListByteCode.2]
      [BvlSem.listToValue (bytes.map (fun b => .number b.toNat)), .number 0, .refPtr true ptr]
      (BviProps.incClock writerClock allocated) =
      (.val [.refPtr true ptr], { state with refs := state.refs.updateEq (ptr, .byteArray true bytes) }) := by
    simpa [allocated, zeros, updateEq_overwrite] using writerRun
  have valueEq := valueToList_inverse value _ decode
  rw [valueEq] at writerResult
  obtain ⟨lengthClock, lengthRun⟩ := evaluate_listLength_call value (bytes.map (fun b => .number b.toNat)) env state lengthCode decode
  let extra := writerClock + 1
  let start := BviProps.incClock (extra + lengthClock) state
  let middle := BviProps.incClock extra state
  let allocatedMiddle := BviProps.incClock extra allocated
  have shifted := BviProps.evaluate_inv_clock
    [.call 0 (some listLengthLocation) [.var 0, .op (.intOp (.const 0)) []] none]
    (value :: env) (BviProps.incClock lengthClock state) state (.val [.number (Int.ofNat bytes.length)]) extra
    (by simpa using lengthRun) (by simp)
  rw [BviProps.incClock_add] at shifted
  have lengthShifted : BviSem.evaluate [.call 0 (some listLengthLocation)
      [.var 0, .op (.intOp (.const 0)) []] none] (value :: env) start =
      (.val [.number (Int.ofNat bytes.length)], middle) := by simpa [start, middle] using shifted
  let zero : Bvi.Exp := .op (.intOp (.const 0)) []
  let lengthExp : Bvi.Exp := .call 0 (some listLengthLocation) [.var 0, zero] none
  let allocate : Bvi.Exp := .op (.memOp (.refByte true)) [zero, lengthExp]
  have zeroStart : BviSem.evaluate [zero] (value :: env) start = (.val [.number 0], start) := by
    apply evaluate_smallConst
    decide
  have varStart : BviSem.evaluate [.var 0] (value :: env) start = (.val [value], start) := by simp [BviSem.evaluate]
  have zeroMiddle : BviSem.evaluate [zero] (value :: env) middle = (.val [.number 0], middle) := by
    apply evaluate_smallConst
    decide
  have allocArgs : BviSem.evaluate [zero, lengthExp] (value :: env) start =
      (.val [.number 0, .number (Int.ofNat bytes.length)], middle) := by
    exact evaluate_pair_threaded _ _ _ _ _ _ _ _ zeroStart lengthShifted
  have allocRun : BviSem.evaluate [allocate] (value :: env) start = (.val [.refPtr true ptr], allocatedMiddle) := by
    dsimp [allocate]
    rw [BviSem.evaluate, BviSem.fixClock_evaluate, allocArgs]
    have nonnegative : ¬ ((bytes.length : Nat) : Int) < 0 := Int.not_lt.mpr (Int.natCast_nonneg _)
    simp [BviSem.doApp, BviSem.doAppFallback, BviSem.doAppAux, ClosSem.intToByte,
      middle, allocatedMiddle, allocated, BviProps.incClock, ptr, zeros, nonnegative]
  have argsRun : BviSem.evaluate [.var 0, zero, allocate] (value :: env) start =
      (.val [value, .number 0, .refPtr true ptr], allocatedMiddle) := by
    have restRun := evaluate_pair_threaded zero allocate (value :: env) start start allocatedMiddle (.number 0) (.refPtr true ptr) zeroStart allocRun
    exact evaluate_cons_threaded _ _ _ _ _ _ _ _ varStart restRun
  refine ⟨extra + lengthClock, ?_⟩
  change BviSem.evaluate [.call 0 (some fromListByteLocation) [.var 0, zero, allocate] none] (value :: env) start = _
  rw [BviSem.evaluate, BviSem.fixClock_evaluate, argsRun]
  have code : sptLookup fromListByteLocation allocatedMiddle.code = some fromListByteCode := by
    simpa [allocatedMiddle, allocated, BviProps.incClock] using writerCode
  have nonzero : allocatedMiddle.clock ≠ 0 := by simp [allocatedMiddle, BviProps.incClock, extra]
  have clocks : BviSem.decClock 1 allocatedMiddle = BviProps.incClock writerClock allocated := by
    simp [allocatedMiddle, BviProps.incClock, BviSem.decClock, extra]
  simp only [BvlSem.findCode, code, fromListByteCode, List.length_cons, List.length_nil, ite_true,
    Nat.zero_add, Nat.lt_one_iff, nonzero, if_false, BviSem.fixClock_evaluate]
  have finalRun := writerResult
  simp [fromListByteCode] at finalRun
  simp [clocks, finalRun, ptr]

/-- A successful source byte-list conversion identifies its input and bytes. -/
theorem fromListByte_shape {C F : Type} (args : List Value) (source next : BvlSem.State C F)
    (value : Value) (run : BvlSem.applyMemory .fromListByte args source = some (value, next)) :
    ∃ input bytes, args = [input] ∧ BvlSem.valueToList input = some (bytes.map (fun b => .number b.toNat)) ∧
      value = .refPtr true (BvlSem.leastUnusedRef source.refs) ∧
      next = { source with refs := source.refs.updateEq (BvlSem.leastUnusedRef source.refs, .byteArray true bytes) } := by
  cases args with
  | nil => simp [BvlSem.applyMemory] at run
  | cons input rest =>
    cases rest with
    | cons second tail => simp [BvlSem.applyMemory] at run
    | nil =>
      cases decode : BvlSem.valueToList input with
      | none => simp [BvlSem.applyMemory, decode] at run
      | some values =>
        cases bytesRun : BvlSem.byteNumbers values with
        | none => simp [BvlSem.applyMemory, decode, bytesRun] at run
        | some bytes =>
          simp [BvlSem.applyMemory, decode, bytesRun] at run
          have valuesEq := (BvlSem.byteNumbers_eq_some values bytes).1 bytesRun
          exact ⟨input, bytes, rfl, by simpa [valuesEq] using decode, run.1.symm, run.2.symm⟩

/-- Byte-list to byte-array conversion satisfies pass simulation given operand
simulation. Untagged pending BVI evaluator and dispatcher review. -/
theorem simulation_fromListByte {C F : Type} (arguments : List Bvl.Exp)
    (env : List Value) (source : BvlSem.State (Nat × C) F)
    (argsIH : simulation arguments env source) :
    simulation [.op (.memOp .fromListByte) arguments] env source := by
  cases argsRun : BvlSem.evaluate arguments env source with
  | mk argsResult middle =>
    cases argsResult with
    | err error => exact simulation_op_error (.memOp .fromListByte) arguments env source middle error argsIH argsRun
    | val values =>
      intro n res next target n2 ys aux relocate run notTypeError compiled related sourceOk envOk installed handlers global
      rw [BvlSem.evaluate, BvlSem.fixClock_evaluate, argsRun] at run
      cases application : BvlSem.applyMemory .fromListByte values.reverse middle with
      | none =>
        simp [BvlSem.doApp, application] at run
        exact (notTypeError run.1.symm).elim
      | some pair =>
        rcases pair with ⟨result, last⟩
        obtain ⟨input, bytes, argsEq, decode, resultEq, lastEq⟩ := fromListByte_shape values.reverse middle last result application
        subst result
        subst last
        simp [BvlSem.doApp, application] at run
        rcases run with ⟨rfl, rfl⟩
        have valuesEq : values = [input] := by simpa using congrArg List.reverse argsEq
        rcases argsCompile : compileListSource n arguments with ⟨argsCode, argsAux, finalName⟩
        have valuesLength := BvlSem.evaluate_length arguments env source middle values argsRun
        have codeLength := compileListSource_length n arguments
        rw [argsCompile] at codeLength
        have codeNonempty : argsCode ≠ [] := by intro eq; simp [eq, valuesEq] at codeLength valuesLength; omega
        have lowered : compileOp (.memOp .fromListByte) argsCode =
            .let argsCode (.call 0 (some fromListByteLocation)
              [.var 0, .op (.intOp (.const 0)) [],
                .op (.memOp (.refByte true)) [.op (.intOp (.const 0)) [],
                  .call 0 (some listLengthLocation) [.var 0, .op (.intOp (.const 0)) []] none]] none) := by
          cases argsCode with
          | nil => exact (codeNonempty rfl).elim
          | cons head tail => rfl
        have nilRight : smartAppend argsAux .nil = argsAux := by cases argsAux <;> rfl
        simp [compileListSource, compileSingSource, argsCompile, nilRight, lowered] at compiled
        rcases compiled with ⟨rfl, rfl, rfl⟩
        have shape : BvlHandle.Proofs.handleOk arguments := by simpa [BvlHandle.Proofs.handleOk] using handlers
        obtain ⟨targetNext, midRelocate, clock, targetArgs, relatedNext, envEq, refsEq⟩ :=
          argsIH n (.val values) middle target finalName argsCode argsAux relocate argsRun (by simp)
            argsCompile related sourceOk envOk installed shape global
        have preserved := evaluateOk arguments env source (.val values) middle argsRun sourceOk envOk
        have growth := BvlProps.evaluateRefsSubset arguments env source middle (.val values) argsRun
        have inputOk : bvOk middle.refs input := by
          apply (bvOkList_iff _ _).1 preserved.2.1 input
          simp [valuesEq]
        obtain ⟨extended, keyEq, agree, relatedAlloc⟩ :=
          stateRel_allocateFresh midRelocate middle targetNext (BvlSem.leastUnusedRef middle.refs)
            (BvlSem.leastUnusedRef targetNext.refs) (.byteArray true bytes) relatedNext preserved.1
            (BvlSem.leastUnusedRef_unused middle.refs) (BvlSem.leastUnusedRef_unused targetNext.refs)
        have envChange := adjustMap_eq_of_ok midRelocate extended env middle.refs preserved.2.2 agree
        have inputChange := adjustBv_eq_of_ok midRelocate input extended middle.refs inputOk agree
        have targetDecode : BvlSem.valueToList (adjustBv extended input) =
            some (bytes.map (fun b => .number b.toNat)) := by
          simpa [decode, List.map_map, Function.comp_def, adjustBv] using valueToList_adjust extended input
        have lengthCode : sptLookup listLengthLocation targetNext.code = some listLengthCode := relatedNext.2.2.2.2.2.2.2.2.1
        have writerCode : sptLookup fromListByteLocation targetNext.code = some fromListByteCode := relatedNext.2.2.2.2.2.2.2.2.2.1
        obtain ⟨extra, bodyRun⟩ := evaluate_fromListByteBody (adjustBv extended input) bytes
          (env.map (adjustBv extended)) targetNext lengthCode writerCode targetDecode
        have shifted := BviProps.evaluate_inv_clock argsCode (env.map (adjustBv midRelocate))
          (BviProps.incClock clock target) targetNext (.val (values.map (adjustBv midRelocate))) extra
          (by simpa [mapSimulationResult] using targetArgs) (by simp)
        rw [BviProps.incClock_add, envChange] at shifted
        refine ⟨{ targetNext with refs := targetNext.refs.updateEq (BvlSem.leastUnusedRef targetNext.refs, .byteArray true bytes) },
          extended, extra + clock, ?_, ?_, envEq.trans envChange, ?_⟩
        · rw [BviSem.evaluate, BviSem.fixClock_evaluate, shifted]
          simp only [valuesEq, List.map_cons, List.map_nil, List.cons_append, List.nil_append, mapSimulationResult]
          rw [inputChange]
          simpa [adjustBv, keyEq] using bodyRun
        · simpa [adjustRef] using relatedAlloc
        · intro key present
          exact (refsEq key present).trans (agree key (growth key present))

end Flapjack.Compiler.Backend.BvlToBvi.Proofs
