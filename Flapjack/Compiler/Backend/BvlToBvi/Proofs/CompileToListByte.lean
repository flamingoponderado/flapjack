import Flapjack.Compiler.Backend.BvlToBvi.Proofs.ToListByteStub

/-! Byte-array to byte-list lowering in BVL-to-BVI simulation. -/
namespace Flapjack.Compiler.Backend.BvlToBvi.Proofs
open Flapjack.Compiler.Backend.BvlSem (Value)

/-- The generated byte-array reader invokes the stub with an empty list and
the length of the array. Untagged pending evaluator and dispatcher review. -/
theorem evaluate_toListByteBody {C F : Type} (bytes : List (BitVec 8))
    (ptr : Nat) (flag mutableRef : Bool) (env : List Value) (state : BviSem.BviState C F)
    (lookup : state.refs.lookup ptr = some (.byteArray mutableRef bytes))
    (code : sptLookup toListByteLocation state.code = some toListByteCode) :
    ∃ clock, BviSem.evaluate [.call 0 (some toListByteLocation)
      [.op (.blockOp (.cons 0)) [], .op (.memOp .lengthByte) [.var 0], .var 0] none]
      (.refPtr flag ptr :: env) (BviProps.incClock clock state) =
      (.val [BvlSem.listToValue (bytes.map (fun b => .number b.toNat))], state) := by
  obtain ⟨clock, stubRun⟩ := evaluate_toListByte bytes [] ptr flag mutableRef state (by simpa using lookup) code
  refine ⟨clock + 1, ?_⟩
  let start := BviProps.incClock (clock + 1) state
  let input : List Value := .refPtr flag ptr :: env
  let empty : Bvi.Exp := .op (.blockOp (.cons 0)) []
  let lengthExp : Bvi.Exp := .op (.memOp .lengthByte) [.var 0]
  have startLookup : start.refs.lookup ptr = some (.byteArray mutableRef bytes) := by
    simpa [start, BviProps.incClock] using lookup
  have startCode : sptLookup toListByteLocation start.code = some toListByteCode := by
    simpa [start, BviProps.incClock] using code
  have emptyRun : BviSem.evaluate [empty] input start = (.val [BvlSem.listToValue []], start) := by
    simp [empty, BviSem.evaluate, BviSem.fixClock, BviSem.doApp, BviSem.doAppFallback,
      BviSem.doAppAux, BvlSem.doApp, BvlSem.applyBlock, BvlSem.listToValue, BackendCommon.nilTag,
      BviSem.fromBvl_toBvl]
  have lengthRun : BviSem.evaluate [lengthExp] input start = (.val [.number bytes.length], start) := by
    simp [lengthExp, input, BviSem.evaluate, BviSem.fixClock, BviSem.doApp, BviSem.doAppFallback,
      BviSem.doAppAux, BvlSem.doApp, BvlSem.applyMemory, BviSem.toBvl, BviSem.fromBvl, startLookup]
  have argsRun : BviSem.evaluate [empty, lengthExp, .var 0] input start =
      (.val [BvlSem.listToValue [], .number bytes.length, .refPtr flag ptr], start) := by
    apply evaluate_readOnly
    constructor
    · exact emptyRun
    constructor
    · exact lengthRun
    simp [input, BviSem.evaluate]
  have nonzero : start.clock ≠ 0 := by simp [start, BviProps.incClock]
  have clocks : BviSem.decClock 1 start = BviProps.incClock clock state := by
    simp [start, BviSem.decClock, BviProps.incClock]
  change BviSem.evaluate [.call 0 (some toListByteLocation) [empty, lengthExp, .var 0] none] input start = _
  rw [BviSem.evaluate, BviSem.fixClock_evaluate, argsRun]
  simp only [BvlSem.findCode, startCode, toListByteCode, List.length_cons, List.length_nil, ite_true,
    Nat.zero_add, Nat.lt_one_iff, nonzero, if_false, BviSem.fixClock_evaluate]
  simp [toListByteCode] at stubRun
  simp [clocks, stubRun]

/-- A successful source conversion reads one byte-array reference. -/
theorem toListByte_shape {C F : Type} (args : List Value) (source next : BvlSem.State C F)
    (value : Value) (run : BvlSem.applyMemory .toListByte args source = some (value, next)) :
    ∃ flag ptr mutableRef bytes, args = [.refPtr flag ptr] ∧
      source.refs.lookup ptr = some (.byteArray mutableRef bytes) ∧
      value = BvlSem.listToValue (bytes.map (fun b => .number b.toNat)) ∧ next = source := by
  cases args with
  | nil => simp [BvlSem.applyMemory] at run
  | cons input rest =>
    cases rest with
    | cons second tail => simp [BvlSem.applyMemory] at run
    | nil =>
      cases input with
      | refPtr flag ptr =>
        cases lookup : source.refs.lookup ptr with
        | none => simp [BvlSem.applyMemory, lookup] at run
        | some cell =>
          cases cell with
          | byteArray mutableRef bytes =>
            simp [BvlSem.applyMemory, lookup] at run
            exact ⟨flag, ptr, mutableRef, bytes, rfl, lookup, run.1.symm, run.2.symm⟩
          | _ => simp [BvlSem.applyMemory, lookup] at run
      | _ => simp [BvlSem.applyMemory] at run

/-- Byte-array to byte-list conversion satisfies pass simulation given
operand simulation. Untagged pending evaluator and dispatcher review. -/
theorem simulation_toListByte {C F : Type} (arguments : List Bvl.Exp)
    (env : List Value) (source : BvlSem.State (Nat × C) F)
    (argsIH : simulation arguments env source) :
    simulation [.op (.memOp .toListByte) arguments] env source := by
  cases argsRun : BvlSem.evaluate arguments env source with
  | mk argsResult middle =>
    cases argsResult with
    | err error => exact simulation_op_error (.memOp .toListByte) arguments env source middle error argsIH argsRun
    | val values =>
      intro n res next target n2 ys aux relocate run notTypeError compiled related sourceOk envOk installed handlers global
      rw [BvlSem.evaluate, BvlSem.fixClock_evaluate, argsRun] at run
      cases application : BvlSem.applyMemory .toListByte values.reverse middle with
      | none =>
        simp [BvlSem.doApp, application] at run
        exact (notTypeError run.1.symm).elim
      | some pair =>
        rcases pair with ⟨result, last⟩
        obtain ⟨flag, ptr, mutableRef, bytes, argsEq, lookup, resultEq, lastEq⟩ :=
          toListByte_shape values.reverse middle last result application
        subst result
        subst last
        simp [BvlSem.doApp, application] at run
        rcases run with ⟨rfl, rfl⟩
        have valuesEq : values = [.refPtr flag ptr] := by simpa using congrArg List.reverse argsEq
        rcases argsCompile : compileListSource n arguments with ⟨argsCode, argsAux, finalName⟩
        have valuesLength := BvlSem.evaluate_length arguments env source middle values argsRun
        have codeLength := compileListSource_length n arguments
        rw [argsCompile] at codeLength
        have codeNonempty : argsCode ≠ [] := by intro eq; simp [eq, valuesEq] at codeLength valuesLength; omega
        have lowered : compileOp (.memOp .toListByte) argsCode =
            .let argsCode (.call 0 (some toListByteLocation)
              [.op (.blockOp (.cons 0)) [], .op (.memOp .lengthByte) [.var 0], .var 0] none) := by
          cases argsCode with
          | nil => exact (codeNonempty rfl).elim
          | cons head tail => rfl
        have nilRight : smartAppend argsAux .nil = argsAux := by cases argsAux <;> rfl
        simp [compileListSource, compileSingSource, argsCompile, nilRight, lowered] at compiled
        rcases compiled with ⟨rfl, rfl, rfl⟩
        have shape : BvlHandle.Proofs.handleOk arguments := by simpa [BvlHandle.Proofs.handleOk] using handlers
        obtain ⟨targetNext, midRelocate, clock, targetArgs, relatedNext, envEq, refsEq⟩ :=
          argsIH n (.val values) middle target finalName argsCode argsAux relocate argsRun (by simp)
            argsCompile related sourceOk envOk installed shape global
        have targetLookup := stateRel_byteArray midRelocate middle targetNext mutableRef bytes ptr relatedNext lookup
        have targetCode : sptLookup toListByteLocation targetNext.code = some toListByteCode := relatedNext.2.2.2.2.2.2.2.2.2.2.1
        obtain ⟨extra, bodyRun⟩ := evaluate_toListByteBody bytes (midRelocate ptr) flag mutableRef
          (env.map (adjustBv midRelocate)) targetNext targetLookup targetCode
        have shifted := BviProps.evaluate_inv_clock argsCode (env.map (adjustBv midRelocate))
          (BviProps.incClock clock target) targetNext (.val (values.map (adjustBv midRelocate))) extra
          (by simpa [mapSimulationResult] using targetArgs) (by simp)
        rw [BviProps.incClock_add] at shifted
        refine ⟨targetNext, midRelocate, extra + clock, ?_, relatedNext, envEq, refsEq⟩
        rw [BviSem.evaluate, BviSem.fixClock_evaluate, shifted]
        simp only [valuesEq, List.map_cons, List.map_nil, List.cons_append, List.nil_append, mapSimulationResult, adjustBv]
        simpa [listToValue_adjust, List.map_map, Function.comp_def, adjustBv] using bodyRun

end Flapjack.Compiler.Backend.BvlToBvi.Proofs
