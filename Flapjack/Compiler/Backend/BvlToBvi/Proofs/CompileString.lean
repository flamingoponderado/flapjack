module

public import Flapjack.Compiler.Backend.BvlToBvi.Proofs.FromListByteStub
public import Flapjack.Compiler.Backend.BvlToBvi.Proofs.CompileInt

@[expose] public section

/-! Correctness of BVI byte writes generated for a HOL string. -/

namespace Flapjack.Compiler.Backend.BvlToBvi.Proofs
open Flapjack.Compiler.Backend.BvlSem (Value)

/-- A single generated byte write evaluates at the indexed destination. -/
private theorem writeChar {C F : Type} (byte : BitVec 8) (ptr index : Nat)
    (flag : Bool) (bytes : List (BitVec 8)) (env : List Value)
    (state : BviSem.BviState C F)
    (lookup : state.refs.lookup ptr = some (.byteArray true bytes))
    (bound : index < bytes.length) :
    BviSem.evaluate [.op (.memOp .updateByte)
      [.op (.intOp (.const (Int.ofNat byte.toNat))) [], compileInt (Int.ofNat index), .var 0]]
      (.refPtr flag ptr :: env) state =
        (.val [BvlSem.unitValue],
          { state with refs := state.refs.updateEq (ptr, .byteArray true (bytes.set index byte)) }) := by
  have small : BackendCommon.smallEnoughInt (Int.ofNat byte.toNat) = true := by
    have h := byte.isLt
    simp [BackendCommon.smallEnoughInt]
    omega
  have charRun := evaluate_smallConst (Int.ofNat byte.toNat) (.refPtr flag ptr :: env) state small
  have indexRun := evaluate_compileInt (Int.ofNat index) (.refPtr flag ptr :: env) state
  have argsRun : BviSem.evaluate
      [.op (.intOp (.const (Int.ofNat byte.toNat))) [], compileInt (Int.ofNat index), .var 0]
      (.refPtr flag ptr :: env) state =
      (.val [.number (Int.ofNat byte.toNat), .number (Int.ofNat index), .refPtr flag ptr], state) := by
    apply evaluate_readOnly
    constructor
    · exact charRun
    constructor
    · exact indexRun
    simp [BviSem.evaluate]
  rw [BviSem.evaluate, BviSem.fixClock_evaluate, argsRun]
  have notNegative : ¬ (index : Int) < 0 := Int.not_lt.mpr (Int.natCast_nonneg index)
  have notBound : ¬ bytes.length ≤ index := Nat.not_le_of_gt bound
  simp [BviSem.doApp, BviSem.doAppFallback, BviSem.doAppAux, BvlSem.doApp, BvlSem.applyMemory,
    BviSem.toBvl, BviSem.fromBvl, lookup, notNegative, notBound, ClosSem.intToByte_toNat]

/-- The source induction generalizes over the prefix already written. -/
private theorem writeChars {C F : Type} (str before old : List (BitVec 8))
    (ptr : Nat) (flag : Bool) (env : List Value) (state : BviSem.BviState C F)
    (lengths : str.length = old.length)
    (lookup : state.refs.lookup ptr = some (.byteArray true (before ++ old))) :
    BviSem.evaluate ((str.zipIdx before.length).map fun (byte, index) =>
        .op (.memOp .updateByte)
          [.op (.intOp (.const (Int.ofNat byte.toNat))) [], compileInt (Int.ofNat index), .var 0])
      (.refPtr flag ptr :: env) state =
      (.val (List.replicate str.length BvlSem.unitValue),
        { state with refs := state.refs.updateEq (ptr, .byteArray true (before ++ str)) }) := by
  induction str generalizing before old state with
  | nil =>
    cases old with
    | nil =>
      have same := updateEq_existing state.refs ptr (.byteArray true (before ++ [])) lookup
      simp only [List.append_nil] at same
      simp [BviSem.evaluate, same]
    | cons byte rest => simp at lengths
  | cons byte rest ih =>
    cases old with
    | nil => simp at lengths
    | cons oldByte oldRest =>
      have lengths' : rest.length = oldRest.length := by simpa using lengths
      let updated : BviSem.BviState C F :=
        { state with refs := state.refs.updateEq (ptr, .byteArray true (before ++ byte :: oldRest)) }
      have setEq : (before ++ oldByte :: oldRest).set before.length byte = before ++ byte :: oldRest := by
        simp [List.set_append_right]
      have one := writeChar byte ptr before.length flag (before ++ oldByte :: oldRest) env state lookup (by simp)
      rw [setEq] at one
      have lookup' : updated.refs.lookup ptr = some (.byteArray true ((before ++ [byte]) ++ oldRest)) := by
        simp [updated, HolFiniteMapExact.lookup_updateEq, FUPDATE_HOL, List.append_assoc]
      have next := ih (before ++ [byte]) oldRest updated lengths' lookup'
      simp only [List.zipIdx_cons, List.map_cons]
      change BviSem.evaluateTuple ([_], _, _) = _ at one
      change BviSem.evaluateTuple (_ :: _, _, _) = _
      rw [BviSem.evaluateCons, one]
      simp only [BviSem.evaluateTuple]
      simp only [List.length_append, List.length_cons, List.length_nil] at next
      rw [show BviSem.evaluate _ _ _ = _ from next]
      simp only [List.length_cons, List.replicate_succ]
      simp [updated, List.append_assoc, updateEq_overwrite, Flapjack.holHd]

namespace CompileStringCarrier
/-- Canonical BVI reference-map state roundtrip. -/
theorem holFmapAsFiniteSupportWitness {C F : Type} :
    (∀ s : BviSem.BviStateBroad C F, (BviSem.BviState.ofBroad s).toBroad = s) ∧
      (∀ s : BviSem.BviState C F, BviSem.BviState.ofBroad s.toBroad = s) :=
  BviSem.holFmapAsFiniteSupportWitness
end CompileStringCarrier

/-- Writing the characters of a string fills the byte array and returns units. -/
@[hol "cakeml/compiler/backend/proofs/bvl_to_bviProofScript.sml" "compile_string_thm"
  (fmap_as_finite_support := [refs])]
theorem compileStringThm {C F : Type} (str : List Flapjack.Basis.Pure.MlString.HolChar)
    (ls : List (BitVec 8)) (ptr : Nat) (state : BviSem.BviState C F)
    (env : List Value) (flag : Bool)
    (premises : state.refs.lookup ptr = some (.byteArray true ls) ∧ str.length = ls.length) :
    BviSem.evaluate (str.mapIdx fun n c =>
        .op (.memOp .updateByte)
          [.op (.intOp (.const (Int.ofNat c.toNat))) [], compileInt (Int.ofNat n), .var 0])
      (.refPtr flag ptr :: env) state =
      (.val (List.replicate ls.length BvlSem.unitValue),
        { state with refs := state.refs.updateEq (ptr, .byteArray true
          (str.map fun c => BitVec.ofNat 8 c.toNat)) }) := by
  have result := writeChars str [] ls ptr flag env state premises.2 (by simpa using premises.1)
  simpa [List.mapIdx_eq_zipIdx_map, ← premises.2] using result

/-- A nonempty concatenation keeps its head when more elements are appended. -/
@[hol "cakeml/compiler/backend/proofs/bvl_to_bviProofScript.sml" "HD_APPEND3"]
theorem holHd_append_three {α : Type} [Nonempty α] (l₁ l₂ l₃ : List α)
    (nonempty : 0 < (l₁ ++ l₂).length) :
    Flapjack.holHd (l₁ ++ l₂ ++ l₃) = Flapjack.holHd (l₁ ++ l₂) := by
  cases l₁ with
  | nil =>
    cases l₂ with
    | nil => simp at nonempty
    | cons head tail => rfl
  | cons head tail => rfl

end Flapjack.Compiler.Backend.BvlToBvi.Proofs
