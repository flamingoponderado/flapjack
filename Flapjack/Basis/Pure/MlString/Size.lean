module

public import Flapjack.Basis.Pure.MlString
public import Flapjack.Misc.List.Size

@[expose] public section

namespace Flapjack

/-- HOL character size is zero and is registered as the character TypeBase size. -/
@[hol "HOL/src/string/stringScript.sml" "char_size_def"]
def holCharSize (_ : Basis.Pure.MlString.HolChar) : Nat := 0

/-- The size function generated by `Datatype: mlstring = implode string` in
`cakeml/basis/pure/mlstringScript.sml`. It has no separate source declaration;
the `mlstring_size_def_typed` HOL capture and Pancake generated-size parity
test record its equations. -/
def mlstringSizeHOL : Basis.Pure.MlString.MlString → Nat
  | .implode data => 1 + listSizeHOL holCharSize data

end Flapjack
