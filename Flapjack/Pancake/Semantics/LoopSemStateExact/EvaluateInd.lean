import Flapjack.Pancake.Semantics.LoopSemStateExact.Evaluate

/-!
# HOL `loopSem$evaluate_ind` over the exact evaluator

`cakeml/pancake/semantics/loopSemScript.sml:497` rebinds

```
Theorem evaluate_ind[allow_rebind] = REWRITE_RULE [fix_clock_evaluate] evaluate_ind;
```

so the per-constructor statement is generated by HOL's `tdefn` and is not
textually present in the source.  It is captured verbatim in
`scripts/hol-probes/loop_sem_evaluate_ind_probe.out`, and the Lean statement
below follows that capture conjunct by conjunct over the exact carriers
`HolLoopProg`, `LoopSemStateFiniteExact` and `LoopResultExact`.

It is proved by well-founded induction on the lexicographic measure
`(s.clock, sizeOf p)` used by the tagged `evaluate`.  The ingredients are
the tagged `evaluate_clock` (the property behind `fix_clock_evaluate`) and
`cutRes_none_clock` (a successful `cut_res` decrements the clock).
-/

namespace Flapjack
namespace LoopSemStateFiniteExact

namespace LoopEvaluateIndFiniteSupport

/-- Same-module re-export of the canonical finite-support witness for
`LoopSemStateFiniteExact`, used by the `fmap_as_finite_support := [globals]`
qualified `evaluate_ind` port below. -/
theorem holFmapAsFiniteSupportWitness {width : Nat} [NeZero width] {F : Type} :
    (∀ (state : LoopSemStateBroad width F) (h : state.FiniteSupport),
        (LoopSemStateBroad.ofBroad state h).toBroad = state) ∧
    (∀ state : LoopSemStateFiniteExact width F,
        LoopSemStateBroad.ofBroad state.toBroad state.toBroad_finiteSupport = state) :=
  LoopEvaluateFiniteSupport.holFmapAsFiniteSupportWitness

end LoopEvaluateIndFiniteSupport

/-- Exact port of HOL `loopSem$evaluate_ind` (`loopSemScript.sml:497`,
`REWRITE_RULE [fix_clock_evaluate] evaluate_ind`), clause for clause as printed
in `scripts/hol-probes/loop_sem_evaluate_ind_probe.out`: the same 24 conjuncts in
HOL's order, the same binders, and the same guard equations.  HOL `∧`-chained
guards are curried arrows.  The carriers are rendered as follows:

* `lookup` is `sptLookup`, `get_var_imm` is `getVarImm`, `word_cmp` is
  `wordCmpHOL`, and `b ⇔ word_cmp cmp x y` is `b = wordCmpHOL cmp x y` over
  `Bool`;
* `cut_res` is `cutRes`, `get_vars` is `getVars`, `find_code` is `findCode`,
  `set_vars`/`set_var` are `setVars`/`setVar`, and `dec_clock` is `decClock`;
* `ALL_DISTINCT` is `List.Nodup`, and HOL `evaluate (p, s)` is `evaluate p s`.

Qualifiers: the motive's `LoopSemStateFiniteExact` HOL `|->` field `globals` is
the canonical `HolFiniteMapExact` carrier, with the same-module witness
`LoopEvaluateIndFiniteSupport.holFmapAsFiniteSupportWitness`.  `locals`/`code`
are sptree `Spt` fields and are not named.  HOL's type-indexed word is
`BitVec width` with `[NeZero width]`. -/
@[hol "cakeml/pancake/semantics/loopSemScript.sml" "evaluate_ind" 497
  (fmap_as_finite_support := [globals]) (words_as_type_indexed_bitvec)]
theorem evaluate_induct {width : Nat} [NeZero width] {F : Type}
    (P : HolLoopProg width × LoopSemStateFiniteExact width F → Prop)
    (hskip : ∀ s, P (.skip, s))
    (hfail : ∀ s, P (.fail, s))
    (hassign : ∀ v exp s, P (.assign v exp, s))
    (hprimitive : ∀ lhss pop rhss s, P (.primitive lhss pop rhss, s))
    (harith : ∀ arith s, P (.arith arith, s))
    (hstore : ∀ exp v s, P (.store exp v, s))
    (hsetGlobal : ∀ dst exp s, P (.setGlobal dst exp, s))
    (hload32 : ∀ a v s, P (.load32 a v, s))
    (hloadByte : ∀ a v s, P (.loadByte a v, s))
    (hstore32 : ∀ a w s, P (.store32 a w, s))
    (hstoreByte : ∀ a w s, P (.storeByte a w, s))
    (hseq : ∀ c1 c2 s,
        (∀ res s1, (res, s1) = evaluate c1 s → res = none → P (c2, s1)) →
        P (c1, s) → P (.seq c1 c2, s))
    (hif : ∀ cmp r1 ri c1 c2 live_out s,
        (∀ (v2 v3 : Option (WordLocW width)) (v5 : WordLocW width) (x : BitVec width)
            (v13 : WordLocW width) (y : BitVec width) (b : Bool),
          (sptLookup r1 s.locals, getVarImm ri s) = (v2, v3) → v2 = some v5 →
          v5 = .word x → v3 = some v13 → v13 = .word y →
          b = Compiler.Encoders.Asm.wordCmpHOL cmp x y →
          P (if b then c1 else c2, s)) →
        P (.ite cmp r1 ri c1 c2 live_out, s))
    (hmark : ∀ p s, P (p, s) → P (.mark p, s))
    (hbreak : ∀ k s, P (.break k, s))
    (hcontinue : ∀ k s, P (.continue k, s))
    (hloop : ∀ live_in body live_out s,
        (∀ v4 s' v s'' v3 v12,
          cutRes live_in (none, s) = (v4, s') → v4 = none →
          evaluate body s' = (v, s'') → v = some v3 → v3 = .continue v12 → v12 = 0 →
          P (.loop live_in body live_out, s'')) →
        (∀ v4 s' v s'',
          cutRes live_in (none, s) = (v4, s') → v4 = none →
          evaluate body s' = (v, s'') → v = none →
          P (.loop live_in body live_out, s'')) →
        (∀ v4 s', cutRes live_in (none, s) = (v4, s') → v4 = none → P (body, s')) →
        P (.loop live_in body live_out, s))
    (hraise : ∀ n s, P (.raise n, s))
    (hreturn : ∀ ns s, P (.return ns, s))
    (hshMem : ∀ op v ad s, P (.shMem op v ad, s))
    (htick : ∀ s, P (.tick, s))
    (hlocValue : ∀ r l1 s, P (.locValue r l1, s))
    (hcall : ∀ ret dest argvars handler s,
        (∀ argvals (v7 : Spt (WordLocW width) × HolLoopProg width) env prog
            (v6 : List Nat × NumSet) ns live v9 s' v8 st v11 retvs
            (v : Nat × HolLoopProg width × HolLoopProg width × NumSet) v1
            (v2 : HolLoopProg width × HolLoopProg width × NumSet) v3
            (v4 : HolLoopProg width × NumSet) r live_out,
          getVars argvars s = some argvals →
          findCode dest argvals s.code = some v7 → v7 = (env, prog) →
          ret = some v6 → v6 = (ns, live) → ns.Nodup →
          cutRes live (none, s) = (v9, s') → v9 = none →
          evaluate prog { s' with locals := env } = (v8, st) → v8 = some v11 →
          v11 = .result retvs → retvs.length = ns.length → handler = some v →
          v = (v1, v2) → v2 = (v3, v4) → v4 = (r, live_out) →
          P (r, setVars ns retvs { st with locals := s'.locals })) →
        (∀ argvals (v7 : Spt (WordLocW width) × HolLoopProg width) env prog
            (v6 : List Nat × NumSet) ns live v9 s' v8 st v11 exn
            (v : Nat × HolLoopProg width × HolLoopProg width × NumSet) n
            (v2 : HolLoopProg width × HolLoopProg width × NumSet) h
            (v4 : HolLoopProg width × NumSet) v5 live_out,
          getVars argvars s = some argvals →
          findCode dest argvals s.code = some v7 → v7 = (env, prog) →
          ret = some v6 → v6 = (ns, live) → ns.Nodup →
          cutRes live (none, s) = (v9, s') → v9 = none →
          evaluate prog { s' with locals := env } = (v8, st) → v8 = some v11 →
          v11 = .exception exn → handler = some v → v = (n, v2) → v2 = (h, v4) →
          v4 = (v5, live_out) →
          P (h, setVar n exn { st with locals := s'.locals })) →
        (∀ argvals (v7 : Spt (WordLocW width) × HolLoopProg width) env prog
            (v6 : List Nat × NumSet) ns live v9 s',
          getVars argvars s = some argvals →
          findCode dest argvals s.code = some v7 → v7 = (env, prog) →
          ret = some v6 → v6 = (ns, live) → ns.Nodup →
          cutRes live (none, s) = (v9, s') → v9 = none →
          P (prog, { s' with locals := env })) →
        (∀ argvals (v7 : Spt (WordLocW width) × HolLoopProg width) env prog,
          getVars argvars s = some argvals →
          findCode dest argvals s.code = some v7 → v7 = (env, prog) →
          ret = none → handler = none → s.clock ≠ 0 →
          P (prog, { decClock s with locals := env })) →
        P (.call ret dest argvars handler, s))
    (hffi : ∀ ffi_index ptr1 len1 ptr2 len2 cutset s,
        P (.ffi ffi_index ptr1 len1 ptr2 len2 cutset, s)) :
    ∀ v v1, P (v, v1) := by
  have key : ∀ (x : Nat × Nat) (p : HolLoopProg width) (s : LoopSemStateFiniteExact width F),
      (s.clock, sizeOf p) = x → P (p, s) := by
    intro x
    induction x using (Prod.lex Nat.lt_wfRel Nat.lt_wfRel).wf.induction with
    | h x ih0 =>
      intro p s hx
      have ih : ∀ (p' : HolLoopProg width) (s' : LoopSemStateFiniteExact width F),
          Prod.Lex (· < ·) (· < ·) (s'.clock, sizeOf p') (s.clock, sizeOf p) → P (p', s') :=
        fun p' s' hlt => ih0 _ (hx ▸ hlt) p' s' rfl
      clear ih0 hx
      cases p with
      | skip => exact hskip s
      | fail => exact hfail s
      | assign v exp => exact hassign v exp s
      | primitive lhss pop rhss => exact hprimitive lhss pop rhss s
      | arith a => exact harith a s
      | store exp v => exact hstore exp v s
      | setGlobal dst exp => exact hsetGlobal dst exp s
      | load32 a v => exact hload32 a v s
      | loadByte a v => exact hloadByte a v s
      | store32 a w => exact hstore32 a w s
      | storeByte a w => exact hstoreByte a w s
      | seq c1 c2 =>
          refine hseq c1 c2 s ?_ ?_
          · intro res s1 heq _
            have hclk := evaluate_clock c1 s res s1 heq.symm
            exact ih c2 s1 (lexLt hclk (by simp +arith))
          · exact ih c1 s (lexLt (Nat.le_refl _) (by simp +arith))
      | ite cmp r1 ri c1 c2 live_out =>
          refine hif cmp r1 ri c1 c2 live_out s ?_
          intro v2 v3 v5 x v13 y b _ _ _ _ _ _
          cases b
          · exact ih c2 s (lexLt (Nat.le_refl _) (by simp +arith))
          · exact ih c1 s (lexLt (Nat.le_refl _) (by simp +arith))
      | mark p => exact hmark p s (ih p s (lexLt (Nat.le_refl _) (by simp +arith)))
      | «break» k => exact hbreak k s
      | «continue» k => exact hcontinue k s
      | loop live_in body live_out =>
          refine hloop live_in body live_out s ?_ ?_ ?_
          · intro v4 s' v s'' v3 v12 hcut hv4 heval _ _ _
            subst hv4
            have h1 := cutRes_none_clock hcut
            have h2 := evaluate_clock body s' v s'' heval
            exact ih _ s'' (lexLtClock (by omega))
          · intro v4 s' v s'' hcut hv4 heval _
            subst hv4
            have h1 := cutRes_none_clock hcut
            have h2 := evaluate_clock body s' v s'' heval
            exact ih _ s'' (lexLtClock (by omega))
          · intro v4 s' hcut hv4
            subst hv4
            exact ih body s' (lexLtClock (cutRes_none_clock hcut))
      | «raise» n => exact hraise n s
      | «return» ns => exact hreturn ns s
      | shMem op v ad => exact hshMem op v ad s
      | tick => exact htick s
      | locValue r l1 => exact hlocValue r l1 s
      | call ret dest argvars handler =>
          refine hcall ret dest argvars handler s ?_ ?_ ?_ ?_
          · intro argvals v7 env prog v6 ns live v9 s' v8 st v11 retvs v v1 v2 v3 v4 r
              live_out _ _ _ _ _ _ hcut hv9 heval _ _ _ _ _ _ _
            subst hv9
            have h1 := cutRes_none_clock hcut
            have h2 := evaluate_clock prog _ v8 st heval
            exact ih r _ (lexLtClock (by simp only [setVars] at h2 ⊢; omega))
          · intro argvals v7 env prog v6 ns live v9 s' v8 st v11 exn v n v2 h v4 v5
              live_out _ _ _ _ _ _ hcut hv9 heval _ _ _ _ _ _
            subst hv9
            have h1 := cutRes_none_clock hcut
            have h2 := evaluate_clock prog _ v8 st heval
            exact ih h _ (lexLtClock (by simp only [setVar] at h2 ⊢; omega))
          · intro argvals v7 env prog v6 ns live v9 s' _ _ _ _ _ _ hcut hv9
            subst hv9
            have h1 := cutRes_none_clock hcut
            exact ih prog _ (lexLtClock h1)
          · intro argvals v7 env prog _ _ _ _ _ hclock
            exact ih prog _ (lexLtClock (by simp only [decClock]; omega))
      | ffi ffi_index ptr1 len1 ptr2 len2 cutset => exact hffi ffi_index ptr1 len1 ptr2 len2 cutset s
  intro v v1
  exact key _ v v1 rfl

end LoopSemStateFiniteExact
end Flapjack
