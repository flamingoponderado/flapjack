import Flapjack.Pancake.CrepToLoop.ContextExact
import Flapjack.HolRef

/-!
# crep_to_loop `compile_prog_distinct_params`

Exact positive-width port of `crep_to_loopProofScript.sml:3987-4008` over the
HOL-shaped `compileProgHOLExact` input and output carriers. This is separate
from the production-carrier analogue and from the similarly named Pan-to-Crep
theorem.
-/

namespace Flapjack

open Flapjack.Basis.Pure.MlString

/-- Exact HOL `compile_prog_distinct_params` (`crep_to_loopProofScript.sml:3987`)
    over `compileProgHOLExact`. The input `EVERY` condition is retained even
    though the output parameter lists are generated by `GENLIST I`, as in the
    HOL theorem. `compileProgHOLExact` is the reviewed `compile_prog_def` port;
    its second output field is the range of the input parameter-list length. -/
@[hol "cakeml/pancake/proofs/crep_to_loopProofScript.sml"
  "compile_prog_distinct_params" (words_as_type_indexed_bitvec)]
theorem crepToLoopCompileProgDistinctParamsExact {width : Nat} [NeZero width] :
    ∀ (prog : List (MlString × List Nat × CrepProgHOL width))
      (c : Flapjack.Compiler.Encoders.Asm.AsmArchitecture),
      (∀ entry ∈ prog, entry.2.1.Nodup) →
      ∀ entry ∈ compileProgHOLExact c prog, entry.2.1.Nodup := by
  intro prog c _hin entry hout
  unfold compileProgHOLExact at hout
  obtain ⟨i, hi, hget⟩ := List.getElem_of_mem hout
  have hparams := congrArg
    (fun compiled : Nat × List Nat × HolLoopProg width => compiled.2.1) hget
  simp at hparams
  rw [← hparams]
  exact List.nodup_range

end Flapjack
