module

public import Flapjack.AstHOL.LitOp
public import Flapjack.Basis.Pure.MlString.Size

@[expose] public section

namespace Flapjack.AstHOL

/-- HOL's automatically generated `lit_size` for `ast$lit`. There is no
separate source declaration to tag; its complete typed equations and concrete
evaluations are captured in `flat_elim_value_globals_probe.out`. This is a
prerequisite for the original generated flat-value size and theorems using
that size, rather than Lean's different `sizeOf`. -/
def litSizeHOL : Lit → Nat
  | .intLit _ => 1
  | .char c => 1 + holCharSize c
  | .strLit s => 1 + mlstringSizeHOL s
  | .word8 w => 1 + w.toNat
  | .word64 w => 1 + w.toNat
  | .float64 w => 1 + w.toNat

/-! These are the sizes generated by HOL for the fields of `ast$op`. Their
typed equations are captured alongside `ast_op_size_def_typed` in the same
probe. They are used to reconstruct HOL's generated flat-expression size. -/

def shiftSizeHOL (_ : Shift) : Nat := 0
def arithSizeHOL (_ : Arith) : Nat := 0
def wordSizeSizeHOL (_ : WordSize) : Nat := 0
def thunkModeSizeHOL (_ : ThunkMode) : Nat := 0
def opbSizeHOL (_ : Opb) : Nat := 0

def thunkOpSizeHOL : ThunkOp → Nat
  | .allocThunk mode => 1 + thunkModeSizeHOL mode
  | .updateThunk mode => 1 + thunkModeSizeHOL mode
  | .forceThunk => 0

def testSizeHOL : Test → Nat
  | .equal => 0
  | .compare op => 1 + opbSizeHOL op
  | .altCompare op => 1 + opbSizeHOL op

def primTypeSizeHOL : PrimType → Nat
  | .wordT width => 1 + wordSizeSizeHOL width
  | _ => 0

/-- The automatically generated HOL `ast$op_size`, including its field sizes.
The datatype-generated equations have no source declaration to tag. -/
def opSizeHOL : Op → Nat
  | .arith op ty => 1 + (arithSizeHOL op + primTypeSizeHOL ty)
  | .fromTo src dst => 1 + (primTypeSizeHOL src + primTypeSizeHOL dst)
  | .shift width op amount => 1 + (wordSizeSizeHOL width + (shiftSizeHOL op + amount))
  | .test op ty => 1 + (testSizeHOL op + primTypeSizeHOL ty)
  | .thunkOp op => 1 + thunkOpSizeHOL op
  | .ffi name => 1 + mlstringSizeHOL name
  | _ => 0

end Flapjack.AstHOL
